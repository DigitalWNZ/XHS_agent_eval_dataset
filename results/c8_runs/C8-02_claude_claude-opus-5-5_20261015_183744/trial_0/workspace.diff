--- /dev/null
+++ b/swscale-impl/src/kernels.zig
@@ -0,0 +1,1511 @@
+// kernels.zig — per-row conversion / filtering kernels.
+
+const std = @import("std");
+const Filter = @import("main.zig").Filter;
+const vec = @import("vec.zig");
+const N = vec.N;
+const VI32 = vec.VI32;
+const VU8 = vec.VU8;
+const splat = vec.splat;
+
+const RGB24 = 5;
+const BGR24 = 6;
+const RGBA = 7;
+const BGRA = 8;
+
+inline fn clipU8(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+// ── YUV -> RGB tables (port of ff_yuv2rgb_c_init_tables, 24/32 bpp) ────────
+
+fn roundToInt16(f: i64) i32 {
+    const r: i64 = (f + (1 << 15)) >> 16;
+    if (r < -0x7FFF) return -0x8000;
+    if (r > 0x7FFF) return 0x7FFF;
+    return @intCast(r);
+}
+
+pub const YuvTables = struct {
+    // packed (table) path: value = clip((K + (Y + off) * cy) >> 16)
+    cy: i32,
+    K: i32,
+    rv: [256]i32,
+    gu: [256]i32,
+    gv: [256]i32,
+    bu: [256]i32,
+    // raw coefficients for vector evaluation of the offsets
+    crv: i32,
+    cbu: i32,
+    cgu: i32,
+    cgv: i32,
+    yoffs: i32,
+    // full-chroma path
+    y_coeff: i32,
+    y_offset: i32,
+    v2r: i32,
+    v2g: i32,
+    u2g: i32,
+    u2b: i32,
+
+    pub fn init(fullRange: bool) YuvTables {
+        var t: YuvTables = undefined;
+        var crv: i64 = 104597;
+        var cbu: i64 = 132201;
+        var cgu: i64 = -25675;
+        var cgv: i64 = -53279;
+        var cy: i64 = 1 << 16;
+        var oy: i64 = 0;
+        if (!fullRange) {
+            cy = @divTrunc(cy * 255, 219);
+            oy = 16 << 16;
+        } else {
+            crv = @divTrunc(crv * 224, 255);
+            cbu = @divTrunc(cbu * 224, 255);
+            cgu = @divTrunc(cgu * 224, 255);
+            cgv = @divTrunc(cgv * 224, 255);
+        }
+        t.y_coeff = roundToInt16(cy * (1 << 13));
+        t.y_offset = roundToInt16(oy * (1 << 9));
+        t.v2r = roundToInt16(crv * (1 << 13));
+        t.v2g = roundToInt16(cgv * (1 << 13));
+        t.u2g = roundToInt16(cgu * (1 << 13));
+        t.u2b = roundToInt16(cbu * (1 << 13));
+        crv = @divTrunc(crv * (1 << 16) + 0x8000, cy);
+        cbu = @divTrunc(cbu * (1 << 16) + 0x8000, cy);
+        cgu = @divTrunc(cgu * (1 << 16) + 0x8000, cy);
+        cgv = @divTrunc(cgv * (1 << 16) + 0x8000, cy);
+        const yoffs: i64 = (if (fullRange) @as(i64, 384) else 326) + 512;
+        const yb0: i64 = -(384 << 16) - 512 * cy - oy;
+        t.cy = @intCast(cy);
+        t.K = @intCast(yb0 + 0x8000);
+        t.crv = @intCast(crv);
+        t.cbu = @intCast(cbu);
+        t.cgu = @intCast(cgu);
+        t.cgv = @intCast(cgv);
+        t.yoffs = @intCast(yoffs);
+        for (0..256) |i| {
+            const ii: i64 = @intCast(i);
+            t.rv[i] = @intCast(yoffs - (crv >> 9) + ((ii * crv) >> 16));
+            t.gu[i] = @intCast(yoffs - (cgu >> 9) + ((ii * cgu) >> 16));
+            t.gv[i] = @intCast(-(cgv >> 9) + ((ii * cgv) >> 16));
+            t.bu[i] = @intCast(yoffs - (cbu >> 9) + ((ii * cbu) >> 16));
+        }
+        return t;
+    }
+
+    inline fn val(t: *const YuvTables, idx: i32) u8 {
+        return clipU8((t.K +% idx *% t.cy) >> 16);
+    }
+};
+
+inline fn chanOffsets(df: c_int) [4]usize {
+    return switch (df) {
+        RGB24 => .{ 0, 1, 2, 3 },
+        BGR24 => .{ 2, 1, 0, 3 },
+        RGBA => .{ 0, 1, 2, 3 },
+        else => .{ 2, 1, 0, 3 },
+    };
+}
+
+inline fn clampIdx(v: i32) usize {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+/// Table-path pixel write; Y unclipped, U/V clipped to 0..255 as in the tables.
+inline fn putTab(t: *const YuvTables, d: [*]u8, off: [4]usize, bpp: usize, Y: i32, U: i32, V: i32) void {
+    const ui = clampIdx(U);
+    const vi = clampIdx(V);
+    d[off[0]] = t.val(Y + t.rv[vi]);
+    d[off[1]] = t.val(Y + t.gu[ui] + t.gv[vi]);
+    d[off[2]] = t.val(Y + t.bu[ui]);
+    if (bpp == 4) d[3] = 255;
+}
+
+/// Vector evaluation of the table path for N pixels (U/V per pixel).
+inline fn tabVec(t: *const YuvTables, Y: VI32, Uin: VI32, Vin: VI32) [4]VU8 {
+    const U = @min(@max(Uin, splat(0)), splat(255));
+    const V = @min(@max(Vin, splat(0)), splat(255));
+    const cy = splat(t.cy);
+    const rv = splat(t.yoffs - (t.crv >> 9)) + ((V * splat(t.crv)) >> splat(16));
+    const gu = splat(t.yoffs - (t.cgu >> 9)) + ((U * splat(t.cgu)) >> splat(16));
+    const gv = splat(-(t.cgv >> 9)) + ((V * splat(t.cgv)) >> splat(16));
+    const bu = splat(t.yoffs - (t.cbu >> 9)) + ((U * splat(t.cbu)) >> splat(16));
+    const yc = Y * cy + splat(t.K);
+    return .{
+        vec.clampU8((yc + rv * cy) >> splat(16)),
+        vec.clampU8((yc + (gu + gv) * cy) >> splat(16)),
+        vec.clampU8((yc + bu * cy) >> splat(16)),
+        @splat(255),
+    };
+}
+
+/// Same, but U/V given for N/2 pixel pairs (computed once per pair).
+inline fn tabVecHalf(t: *const YuvTables, Y: VI32, Uin: @Vector(N / 2, i32), Vin: @Vector(N / 2, i32)) [4]VU8 {
+    const H = @Vector(N / 2, i32);
+    const U = @min(@max(Uin, @as(H, @splat(0))), @as(H, @splat(255)));
+    const V = @min(@max(Vin, @as(H, @splat(0))), @as(H, @splat(255)));
+    const cy: H = @splat(t.cy);
+    const s16: H = @splat(16);
+    const rv = @as(H, @splat(t.yoffs - (t.crv >> 9))) + ((V * @as(H, @splat(t.crv))) >> s16);
+    const gu = @as(H, @splat(t.yoffs - (t.cgu >> 9))) + ((U * @as(H, @splat(t.cgu))) >> s16);
+    const gv = @as(H, @splat(-(t.cgv >> 9))) + ((V * @as(H, @splat(t.cgv))) >> s16);
+    const bu = @as(H, @splat(t.yoffs - (t.cbu >> 9))) + ((U * @as(H, @splat(t.cbu))) >> s16);
+    const tr = dupH(rv * cy);
+    const tg = dupH((gu + gv) * cy);
+    const tb = dupH(bu * cy);
+    const yc = Y * splat(t.cy) + splat(t.K);
+    return .{
+        vec.clampU8((yc + tr) >> splat(16)),
+        vec.clampU8((yc + tg) >> splat(16)),
+        vec.clampU8((yc + tb) >> splat(16)),
+        @splat(255),
+    };
+}
+
+inline fn dupH(v: @Vector(N / 2, i32)) VI32 {
+    return @shuffle(i32, v, undefined, vec.dupMask());
+}
+
+inline fn orderCh(comptime df: c_int, ch: [4]VU8) [4]VU8 {
+    return if (df == RGB24 or df == RGBA) ch else .{ ch[2], ch[1], ch[0], ch[3] };
+}
+
+const U16x = @Vector(N, u16);
+const I16x = @Vector(N, i16);
+
+inline fn dupH16(v: @Vector(N / 2, i16)) I16x {
+    return @shuffle(i16, v, undefined, vec.dupMask());
+}
+
+/// Exact 16-bit evaluation of clip((Y*cy + C) >> 16) for 8-bit Y:
+/// = Y + (C >> 16) + ((Y*c') >> 16) + carry((Y*c') & 0xFFFF + (C & 0xFFFF)), c' = cy - 65536.
+inline fn chan16(base: I16x, alx: I16x, ch: I16x, nclx: I16x) VU8 {
+    // carry(al + cl >= 65536)  <=>  al > ~cl (unsigned)  <=>  (al ^ 0x8000) > (~cl ^ 0x8000) (signed)
+    const carry = alx > nclx;
+    const out = base +% ch +% @select(i16, carry, @as(I16x, @splat(1)), @as(I16x, @splat(0)));
+    return @intCast(@min(@max(out, @as(I16x, @splat(0))), @as(I16x, @splat(255))));
+}
+
+fn yuv2rgbRow8T(comptime df: c_int, tp: *const YuvTables, dst: [*]u8, dst2: ?[*]u8, py: [*]const u8, py2: ?[*]const u8, pu: [*]const u8, pv: [*]const u8, w: usize) void {
+    const bpp: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    const off = comptime chanOffsets(df);
+    const t = tp.*; // local copy: keeps constants out of the aliasing loop
+    const H = @Vector(N / 2, i32);
+    const cyH: H = @splat(t.cy);
+    const s16: H = @splat(16);
+    const cfrac: u16 = @intCast(t.cy - 65536);
+    var i: usize = 0;
+    while (i + N <= w) : (i += N) {
+        const hu: @Vector(N / 2, u8) = (pu + i / 2)[0 .. N / 2].*;
+        const hv: @Vector(N / 2, u8) = (pv + i / 2)[0 .. N / 2].*;
+        const U: H = hu;
+        const V: H = hv;
+        const rv = @as(H, @splat(t.yoffs - (t.crv >> 9))) + ((V * @as(H, @splat(t.crv))) >> s16);
+        const gu = @as(H, @splat(t.yoffs - (t.cgu >> 9))) + ((U * @as(H, @splat(t.cgu))) >> s16);
+        const gv = @as(H, @splat(-(t.cgv >> 9))) + ((V * @as(H, @splat(t.cgv))) >> s16);
+        const bu = @as(H, @splat(t.yoffs - (t.cbu >> 9))) + ((U * @as(H, @splat(t.cbu))) >> s16);
+        const K: H = @splat(t.K);
+        const C = [3]H{ rv * cyH + K, (gu + gv) * cyH + K, bu * cyH + K };
+        var ch: [3]I16x = undefined;
+        var nclx: [3]I16x = undefined;
+        inline for (0..3) |q| {
+            ch[q] = dupH16(@truncate(C[q] >> s16));
+            // (~cl) ^ 0x8000 == cl ^ 0x7FFF
+            nclx[q] = dupH16(@truncate((C[q] & @as(H, @splat(0xFFFF))) ^ @as(H, @splat(0x7FFF))));
+        }
+        inline for (0..2) |row| {
+            const yp: ?[*]const u8 = if (row == 0) py else py2;
+            if (yp) |q| {
+                const yb: VU8 = q[i..][0..N].*;
+                const Y: U16x = yb;
+                // Y*c' = P*256 + Q with P = Y*(c'>>8), Q = Y*(c'&255), all in 16 bits
+                const P = Y *% @as(U16x, @splat(cfrac >> 8));
+                const Q = Y *% @as(U16x, @splat(cfrac & 255));
+                const ah: U16x = (P +% (Q >> @splat(8))) >> @splat(8);
+                const al: U16x = (P << @splat(8)) +% Q;
+                const base: I16x = @bitCast(Y +% ah);
+                const alx: I16x = @bitCast(al ^ @as(U16x, @splat(0x8000)));
+                const px: [4]VU8 = .{ chan16(base, alx, ch[0], nclx[0]), chan16(base, alx, ch[1], nclx[1]), chan16(base, alx, ch[2], nclx[2]), @splat(255) };
+                const dp = if (row == 0) dst else dst2.?;
+                vec.storeBpp(bpp, dp + i * bpp, orderCh(df, px));
+            }
+        }
+    }
+    while (i < w) : (i += 1) {
+        putTab(&t, dst + i * bpp, off, bpp, py[i], pu[i / 2], pv[i / 2]);
+        if (py2) |q| putTab(&t, dst2.? + i * bpp, off, bpp, q[i], pu[i / 2], pv[i / 2]);
+    }
+}
+
+pub fn yuv2rgbRow8(t: *const YuvTables, df: c_int, dst: [*]u8, dst2: ?[*]u8, py: [*]const u8, py2: ?[*]const u8, pu: [*]const u8, pv: [*]const u8, w: usize) void {
+    switch (df) {
+        inline RGB24, BGR24, RGBA, BGRA => |f| yuv2rgbRow8T(f, t, dst, dst2, py, py2, pu, pv, w),
+        else => unreachable,
+    }
+}
+
+// ── RGB -> YUV ─────────────────────────────────────────────────────────────
+
+pub const Rgb2Yuv = struct {
+    ry: i32,
+    gy: i32,
+    by: i32,
+    ru: i32,
+    gu: i32,
+    bu: i32,
+    rv: i32,
+    gv: i32,
+    bv: i32,
+    pub fn init() Rgb2Yuv {
+        const S: f64 = 32768.0;
+        return .{
+            .by = @intFromFloat(0.114 * 219.0 / 255.0 * S + 0.5),
+            .bv = -@as(i32, @intFromFloat(0.081 * 224.0 / 255.0 * S + 0.5)),
+            .bu = @intFromFloat(0.500 * 224.0 / 255.0 * S + 0.5),
+            .gy = @intFromFloat(0.587 * 219.0 / 255.0 * S + 0.5),
+            .gv = -@as(i32, @intFromFloat(0.419 * 224.0 / 255.0 * S + 0.5)),
+            .gu = -@as(i32, @intFromFloat(0.331 * 224.0 / 255.0 * S + 0.5)),
+            .ry = @intFromFloat(0.299 * 219.0 / 255.0 * S + 0.5),
+            .rv = @intFromFloat(0.500 * 224.0 / 255.0 * S + 0.5),
+            .ru = -@as(i32, @intFromFloat(0.169 * 224.0 / 255.0 * S + 0.5)),
+        };
+    }
+};
+
+inline fn rgbOffsets(f: c_int) [3]usize {
+    return switch (f) {
+        RGB24, RGBA => .{ 0, 1, 2 },
+        else => .{ 2, 1, 0 },
+    };
+}
+
+inline fn rgbVec(comptime f: c_int, p: [*]const u8) [3]VI32 {
+    const bpp: usize = comptime if (f == RGB24 or f == BGR24) 3 else 4;
+    const ch = vec.deint(bpp, p);
+    const o = comptime rgbOffsets(f);
+    return .{ ch[o[0]], ch[o[1]], ch[o[2]] };
+}
+
+fn rgbToYT(comptime f: c_int, comptime x2: bool, tp: *const Rgb2Yuv, dst: [*]u16, src: [*]const u8, w: usize) void {
+    const t = tp.*;
+    const o = comptime rgbOffsets(f);
+    const bpp: usize = comptime if (f == RGB24 or f == BGR24) 3 else 4;
+    var i: usize = 0;
+    while (i + N <= w) : (i += N) {
+        const c = rgbVec(f, src + i * bpp);
+        const y = (c[0] * splat(t.ry) + c[1] * splat(t.gy) + c[2] * splat(t.by) + splat((32 << 14) + (1 << 8))) >> splat(9);
+        dst[i..][0..N].* = @as(@Vector(N, u16), @intCast(if (x2) y << splat(1) else y));
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = src[i * bpp + o[0]];
+        const g: i32 = src[i * bpp + o[1]];
+        const b: i32 = src[i * bpp + o[2]];
+        const y: i32 = (t.ry * r + t.gy * g + t.by * b + (32 << 14) + (1 << 8)) >> 9;
+        dst[i] = @intCast(if (x2) y * 2 else y);
+    }
+}
+
+pub fn rgbToY(f: c_int, t: *const Rgb2Yuv, dst: [*]u16, src: [*]const u8, w: usize) void {
+    switch (f) {
+        inline RGB24, BGR24, RGBA, BGRA => |ff| rgbToYT(ff, false, t, dst, src, w),
+        else => unreachable,
+    }
+}
+
+/// rgbToY followed by the identity horizontal filter (value * 2), written as i16.
+pub fn rgbToYx2(f: c_int, t: *const Rgb2Yuv, dst: []i16, src: [*]const u8) void {
+    const d: [*]u16 = @ptrCast(dst.ptr);
+    switch (f) {
+        inline RGB24, BGR24, RGBA, BGRA => |ff| rgbToYT(ff, true, t, d, src, dst.len),
+        else => unreachable,
+    }
+}
+
+/// Point-sampled RGB -> Y line: dst[i] = 2 * Y14(src[pos[i]]) (== rgbToY + hscale16 point).
+fn pointYT(comptime f: c_int, t: *const Rgb2Yuv, dst: []i16, src: [*]const u8, pos: []const i32) void {
+    const o = comptime rgbOffsets(f);
+    const bpp: usize = comptime if (f == RGB24 or f == BGR24) 3 else 4;
+    for (dst, 0..) |*d, i| {
+        const p = src + @as(usize, @intCast(pos[i])) * bpp;
+        const r: i32 = p[o[0]];
+        const g: i32 = p[o[1]];
+        const b: i32 = p[o[2]];
+        d.* = @intCast(((t.ry * r + t.gy * g + t.by * b + (32 << 14) + (1 << 8)) >> 9) * 2);
+    }
+}
+
+pub fn pointY(f: c_int, t: *const Rgb2Yuv, dst: []i16, src: [*]const u8, pos: []const i32) void {
+    switch (f) {
+        inline RGB24, BGR24, RGBA, BGRA => |ff| pointYT(ff, t, dst, src, pos),
+        else => unreachable,
+    }
+}
+
+pub fn pointA(dst: []i16, src: [*]const u8, pos: []const i32) void {
+    for (dst, 0..) |*d, i| {
+        const a: i32 = src[@as(usize, @intCast(pos[i])) * 4 + 3];
+        d.* = @intCast(((a << 6) | (a >> 2)) * 2);
+    }
+}
+
+fn pointUVT(comptime f: c_int, comptime half: bool, t: *const Rgb2Yuv, du: []i16, dv: []i16, src: [*]const u8, pos: []const i32) void {
+    const o = comptime rgbOffsets(f);
+    const bpp: usize = comptime if (f == RGB24 or f == BGR24) 3 else 4;
+    for (du, dv, 0..) |*u, *v, i| {
+        const pi: usize = @intCast(pos[i]);
+        if (half) {
+            const p = src + 2 * pi * bpp;
+            const r: i32 = @as(i32, p[o[0]]) + p[bpp + o[0]];
+            const g: i32 = @as(i32, p[o[1]]) + p[bpp + o[1]];
+            const b: i32 = @as(i32, p[o[2]]) + p[bpp + o[2]];
+            u.* = @intCast(((t.ru * r + t.gu * g + t.bu * b + (256 << 15) + (1 << 9)) >> 10) * 2);
+            v.* = @intCast(((t.rv * r + t.gv * g + t.bv * b + (256 << 15) + (1 << 9)) >> 10) * 2);
+        } else {
+            const p = src + pi * bpp;
+            const r: i32 = p[o[0]];
+            const g: i32 = p[o[1]];
+            const b: i32 = p[o[2]];
+            u.* = @intCast(((t.ru * r + t.gu * g + t.bu * b + (256 << 14) + (1 << 8)) >> 9) * 2);
+            v.* = @intCast(((t.rv * r + t.gv * g + t.bv * b + (256 << 14) + (1 << 8)) >> 9) * 2);
+        }
+    }
+}
+
+pub fn pointUV(f: c_int, half: bool, t: *const Rgb2Yuv, du: []i16, dv: []i16, src: [*]const u8, pos: []const i32) void {
+    switch (f) {
+        inline RGB24, BGR24, RGBA, BGRA => |ff| if (half) pointUVT(ff, true, t, du, dv, src, pos) else pointUVT(ff, false, t, du, dv, src, pos),
+        else => unreachable,
+    }
+}
+
+pub fn rgbaToA(dst: [*]u16, src: [*]const u8, w: usize) void {
+    for (0..w) |i| {
+        const a: u16 = src[i * 4 + 3];
+        dst[i] = (a << 6) | (a >> 2);
+    }
+}
+
+fn rgbToUVT(comptime f: c_int, tp: *const Rgb2Yuv, du: [*]u16, dv: [*]u16, src: [*]const u8, w: usize) void {
+    const t = tp.*;
+    const o = comptime rgbOffsets(f);
+    const bpp: usize = comptime if (f == RGB24 or f == BGR24) 3 else 4;
+    var i: usize = 0;
+    const rnd = splat((256 << 14) + (1 << 8));
+    while (i + N <= w) : (i += N) {
+        const c = rgbVec(f, src + i * bpp);
+        const u = (c[0] * splat(t.ru) + c[1] * splat(t.gu) + c[2] * splat(t.bu) + rnd) >> splat(9);
+        const v = (c[0] * splat(t.rv) + c[1] * splat(t.gv) + c[2] * splat(t.bv) + rnd) >> splat(9);
+        du[i..][0..N].* = @as(@Vector(N, u16), @intCast(u));
+        dv[i..][0..N].* = @as(@Vector(N, u16), @intCast(v));
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = src[i * bpp + o[0]];
+        const g: i32 = src[i * bpp + o[1]];
+        const b: i32 = src[i * bpp + o[2]];
+        du[i] = @intCast((t.ru * r + t.gu * g + t.bu * b + (256 << 14) + (1 << 8)) >> 9);
+        dv[i] = @intCast((t.rv * r + t.gv * g + t.bv * b + (256 << 14) + (1 << 8)) >> 9);
+    }
+}
+
+pub fn rgbToUV(f: c_int, t: *const Rgb2Yuv, du: [*]u16, dv: [*]u16, src: [*]const u8, w: usize) void {
+    switch (f) {
+        RGB24 => rgbToUVT(RGB24, t, du, dv, src, w),
+        BGR24 => rgbToUVT(BGR24, t, du, dv, src, w),
+        RGBA => rgbToUVT(RGBA, t, du, dv, src, w),
+        else => rgbToUVT(BGRA, t, du, dv, src, w),
+    }
+}
+
+fn evenMask() @Vector(N, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [N]i32 = undefined;
+    for (0..N / 2) |i| {
+        m[i] = @intCast(2 * i);
+        m[N / 2 + i] = ~@as(i32, @intCast(2 * i));
+    }
+    return m;
+}
+fn oddMask() @Vector(N, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [N]i32 = undefined;
+    for (0..N / 2) |i| {
+        m[i] = @intCast(2 * i + 1);
+        m[N / 2 + i] = ~@as(i32, @intCast(2 * i + 1));
+    }
+    return m;
+}
+
+fn rgbToUVHalfT(comptime f: c_int, comptime x2: bool, tp: *const Rgb2Yuv, du: [*]u16, dv: [*]u16, src: [*]const u8, w: usize) void {
+    const t = tp.*;
+    const o = comptime rgbOffsets(f);
+    const bpp: usize = comptime if (f == RGB24 or f == BGR24) 3 else 4;
+    var i: usize = 0;
+    const rnd = splat((256 << 15) + (1 << 9));
+    while (i + N <= w) : (i += N) {
+        const c0 = rgbVec(f, src + 2 * i * bpp);
+        const c1 = rgbVec(f, src + (2 * i + N) * bpp);
+        var s: [3]VI32 = undefined;
+        inline for (0..3) |q| {
+            s[q] = @shuffle(i32, c0[q], c1[q], evenMask()) + @shuffle(i32, c0[q], c1[q], oddMask());
+        }
+        const u = (s[0] * splat(t.ru) + s[1] * splat(t.gu) + s[2] * splat(t.bu) + rnd) >> splat(10);
+        const v = (s[0] * splat(t.rv) + s[1] * splat(t.gv) + s[2] * splat(t.bv) + rnd) >> splat(10);
+        du[i..][0..N].* = @as(@Vector(N, u16), @intCast(if (x2) u << splat(1) else u));
+        dv[i..][0..N].* = @as(@Vector(N, u16), @intCast(if (x2) v << splat(1) else v));
+    }
+    while (i < w) : (i += 1) {
+        const p = src + 2 * i * bpp;
+        const r: i32 = @as(i32, p[o[0]]) + p[bpp + o[0]];
+        const g: i32 = @as(i32, p[o[1]]) + p[bpp + o[1]];
+        const b: i32 = @as(i32, p[o[2]]) + p[bpp + o[2]];
+        const uu: i32 = (t.ru * r + t.gu * g + t.bu * b + (256 << 15) + (1 << 9)) >> 10;
+        const vv: i32 = (t.rv * r + t.gv * g + t.bv * b + (256 << 15) + (1 << 9)) >> 10;
+        du[i] = @intCast(if (x2) uu * 2 else uu);
+        dv[i] = @intCast(if (x2) vv * 2 else vv);
+    }
+}
+
+pub fn rgbToUVHalf(f: c_int, t: *const Rgb2Yuv, du: [*]u16, dv: [*]u16, src: [*]const u8, w: usize) void {
+    switch (f) {
+        inline RGB24, BGR24, RGBA, BGRA => |ff| rgbToUVHalfT(ff, false, t, du, dv, src, w),
+        else => unreachable,
+    }
+}
+
+pub fn rgbToUVHalfx2(f: c_int, t: *const Rgb2Yuv, du: []i16, dv: []i16, src: [*]const u8) void {
+    switch (f) {
+        inline RGB24, BGR24, RGBA, BGRA => |ff| rgbToUVHalfT(ff, true, t, @ptrCast(du.ptr), @ptrCast(dv.ptr), src, du.len),
+        else => unreachable,
+    }
+}
+
+pub fn bgr24ToYv12Rows(t: *const Rgb2Yuv, s1: [*]const u8, s2: [*]const u8, y1: [*]u8, y2: [*]u8, du: [*]u8, dv: [*]u8, w: usize) void {
+    for (0..w / 2) |i| {
+        const b11: i32 = s1[6 * i + 0];
+        const g11: i32 = s1[6 * i + 1];
+        const r11: i32 = s1[6 * i + 2];
+        const b12: i32 = s1[6 * i + 3];
+        const g12: i32 = s1[6 * i + 4];
+        const r12: i32 = s1[6 * i + 5];
+        const b21: i32 = s2[6 * i + 0];
+        const g21: i32 = s2[6 * i + 1];
+        const r21: i32 = s2[6 * i + 2];
+        const b22: i32 = s2[6 * i + 3];
+        const g22: i32 = s2[6 * i + 4];
+        const r22: i32 = s2[6 * i + 5];
+        y1[2 * i + 0] = @truncate(@as(u32, @bitCast(((t.ry * r11 + t.gy * g11 + t.by * b11) >> 15) + 16)));
+        y1[2 * i + 1] = @truncate(@as(u32, @bitCast(((t.ry * r12 + t.gy * g12 + t.by * b12) >> 15) + 16)));
+        y2[2 * i + 0] = @truncate(@as(u32, @bitCast(((t.ry * r21 + t.gy * g21 + t.by * b21) >> 15) + 16)));
+        y2[2 * i + 1] = @truncate(@as(u32, @bitCast(((t.ry * r22 + t.gy * g22 + t.by * b22) >> 15) + 16)));
+        const bx = (b11 + b12 + b21 + b22) >> 2;
+        const gx = (g11 + g12 + g21 + g22) >> 2;
+        const rx = (r11 + r12 + r21 + r22) >> 2;
+        du[i] = @truncate(@as(u32, @bitCast(((t.ru * rx + t.gu * gx + t.bu * bx) >> 15) + 128)));
+        dv[i] = @truncate(@as(u32, @bitCast(((t.rv * rx + t.gv * gx + t.bv * bx) >> 15) + 128)));
+    }
+}
+
+// ── simple byte movers ─────────────────────────────────────────────────────
+
+pub fn interleave(d: [*]u8, a: [*]const u8, b: [*]const u8, n: usize) void {
+    for (0..n) |i| {
+        d[2 * i] = a[i];
+        d[2 * i + 1] = b[i];
+    }
+}
+
+pub fn deinterleave(a: [*]u8, b: [*]u8, s: [*]const u8, n: usize) void {
+    for (0..n) |i| {
+        a[i] = s[2 * i];
+        b[i] = s[2 * i + 1];
+    }
+}
+
+fn rgbShuffleT(comptime sf: c_int, comptime df: c_int, d: [*]u8, s: [*]const u8, w: usize) void {
+    const so = comptime rgbOffsets(sf);
+    const do_ = comptime rgbOffsets(df);
+    const sb: usize = comptime if (sf == RGB24 or sf == BGR24) 3 else 4;
+    const db: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    var i: usize = 0;
+    if (sb == 3 and db == 4) {
+        const alpha: @Vector(16, u8) = @splat(255);
+        while (i + 18 <= w) : (i += 16) {
+            inline for (0..4) |q| {
+                const ch: @Vector(16, u8) = s[i * 3 + q * 12 ..][0..16].*;
+                const part: @Vector(16, u8) = @shuffle(u8, ch, alpha, m34(0, so, do_));
+                d[i * 4 + q * 16 ..][0..16].* = part;
+            }
+        }
+    }
+    if (sb == 4 and db == 3) {
+        // 4 pixels per 16-byte chunk -> 12 bytes; overlapping 16-byte stores (tail kept inside the row)
+        while (i + 16 + 2 <= w) : (i += 16) {
+            inline for (0..4) |q| {
+                const ch: @Vector(16, u8) = s[i * 4 + q * 16 ..][0..16].*;
+                const part: @Vector(16, u8) = @shuffle(u8, ch, ch, m43(so, do_));
+                d[i * 3 + q * 12 ..][0..16].* = part;
+            }
+        }
+    }
+    while (i + N <= w) : (i += N) {
+        const c = vec.deint(sb, s + i * sb);
+        var o: [4]VU8 = undefined;
+        o[do_[0]] = c[so[0]];
+        o[do_[1]] = c[so[1]];
+        o[do_[2]] = c[so[2]];
+        o[3] = if (sb == 4) c[3] else @splat(255);
+        vec.storeBpp(db, d + i * db, o);
+    }
+    while (i < w) : (i += 1) {
+        const sp = s + i * sb;
+        const dp = d + i * db;
+        dp[do_[0]] = sp[so[0]];
+        dp[do_[1]] = sp[so[1]];
+        dp[do_[2]] = sp[so[2]];
+        if (db == 4) dp[3] = if (sb == 4) sp[3] else 255;
+    }
+}
+
+fn m43(comptime so: [3]usize, comptime do_: [3]usize) @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..4) |p| {
+        for (0..3) |c| m[p * 3 + do_[c]] = @intCast(p * 4 + so[c]);
+    }
+    for (12..16) |q| m[q] = 0;
+    return m;
+}
+
+fn m34(comptime q: usize, comptime so: [3]usize, comptime do_: [3]usize) @Vector(16, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [16]i32 = undefined;
+    for (0..4) |p| {
+        const px = q * 4 + p;
+        for (0..3) |c| m[p * 4 + do_[c]] = @intCast(px * 3 + so[c]);
+        m[p * 4 + 3] = ~@as(i32, 0);
+    }
+    return m;
+}
+
+pub fn rgbShuffle(sf: c_int, df: c_int, d: [*]u8, s: [*]const u8, w: usize) void {
+    switch (sf) {
+        inline RGB24, BGR24, RGBA, BGRA => |a| switch (df) {
+            inline RGB24, BGR24, RGBA, BGRA => |b| rgbShuffleT(a, b, d, s, w),
+            else => unreachable,
+        },
+        else => unreachable,
+    }
+}
+
+// ── range conversion ───────────────────────────────────────────────────────
+
+pub fn lumRangeToJpeg(l: []i16) void {
+    for (l) |*v| {
+        const x: i32 = @min(@as(i32, v.*), 30189);
+        v.* = @truncate((x * 19077 - 39057361) >> 14);
+    }
+}
+
+pub fn lumRangeFromJpeg(l: []i16) void {
+    for (l) |*v| {
+        const x: i32 = v.*;
+        v.* = @truncate((x * 14071 + 33561947) >> 14);
+    }
+}
+
+// ── horizontal scalers ─────────────────────────────────────────────────────
+
+fn hscaleN(comptime T: type, comptime n: usize, comptime sh: u5, dst: []i16, src: [*]const T, f: *const Filter, start: usize) void {
+    for (dst, start..) |*d, i| {
+        const p: usize = @intCast(f.pos[i]);
+        const c = f.coef[i * n ..][0..n];
+        var val: i32 = 0;
+        inline for (0..n) |j| val += @as(i32, src[p + j]) * c[j];
+        d.* = @truncate(@min(val >> sh, 32767));
+    }
+}
+
+fn evenM8() @Vector(8, i32) {
+    var m: [8]i32 = undefined;
+    for (0..8) |i| m[i] = @intCast(2 * i);
+    return m;
+}
+fn oddM8() @Vector(8, i32) {
+    var m: [8]i32 = undefined;
+    for (0..8) |i| m[i] = @intCast(2 * i + 1);
+    return m;
+}
+inline fn madd(a: @Vector(16, i16), b: @Vector(16, i16)) @Vector(8, i32) {
+    const p = @as(@Vector(16, i32), a) * @as(@Vector(16, i32), b);
+    return @shuffle(i32, p, undefined, evenM8()) + @shuffle(i32, p, undefined, oddM8());
+}
+inline fn gather8(src: [*]const u8, pos: [*]const i32, comptime scale: usize, off: usize) @Vector(8, u32) {
+    var a: [8]u32 = undefined;
+    inline for (0..8) |q| a[q] = @as(*align(1) const u32, @ptrCast(src + @as(usize, @intCast(pos[q])) * scale + off)).*;
+    return a;
+}
+
+
+fn unpLo() @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..2) |l| for (0..4) |i| {
+        m[l * 8 + 2 * i] = @intCast(l * 8 + i);
+        m[l * 8 + 2 * i + 1] = ~@as(i32, @intCast(l * 8 + i));
+    };
+    return m;
+}
+fn unpHi() @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..2) |l| for (0..4) |i| {
+        m[l * 8 + 2 * i] = @intCast(l * 8 + 4 + i);
+        m[l * 8 + 2 * i + 1] = ~@as(i32, @intCast(l * 8 + 4 + i));
+    };
+    return m;
+}
+fn catM() @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..8) |i| {
+        m[i] = @intCast(i);
+        m[8 + i] = ~@as(i32, @intCast(i));
+    }
+    return m;
+}
+/// Permuted order produced by pmFilt: position p holds pixel unperm(p); the map is an involution.
+fn unpermM() @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..16) |k| {
+        m[k] = @intCast(if (k < 4) k else if (k < 8) k + 4 else if (k < 12) k - 4 else k);
+    }
+    return m;
+}
+pub inline fn unperm(v: VU8) VU8 {
+    return @shuffle(u8, v, undefined, unpermM());
+}
+inline fn pairCoef(c0: i16, c1: i16) @Vector(16, i16) {
+    const p: u32 = @as(u32, @as(u16, @bitCast(c0))) | (@as(u32, @as(u16, @bitCast(c1))) << 16);
+    return @bitCast(@as(@Vector(8, u32), @splat(p)));
+}
+/// sum_j rows[j][i..i+16] * c[j] in permuted lane order (see unperm).
+inline fn pmFilt(comptime T: usize, rows: [T][*]const i16, cps: [(T + 1) / 2]@Vector(16, i16), i: usize) VI32 {
+    var lo: @Vector(8, i32) = @splat(0);
+    var hi: @Vector(8, i32) = @splat(0);
+    inline for (0..(T + 1) / 2) |p| {
+        const a: @Vector(16, i16) = rows[2 * p][i..][0..16].*;
+        const b: @Vector(16, i16) = if (2 * p + 1 < T) rows[2 * p + 1][i..][0..16].* else @splat(0);
+        lo += madd(@shuffle(i16, a, b, unpLo()), cps[p]);
+        hi += madd(@shuffle(i16, a, b, unpHi()), cps[p]);
+    }
+    return @shuffle(i32, lo, hi, catM());
+}
+inline fn mkCps(comptime T: usize, f: []const i16) [(T + 1) / 2]@Vector(16, i16) {
+    var c: [(T + 1) / 2]@Vector(16, i16) = undefined;
+    inline for (0..(T + 1) / 2) |p| c[p] = pairCoef(f[2 * p], if (2 * p + 1 < T) f[2 * p + 1] else 0);
+    return c;
+}
+inline fn mkRows(comptime T: usize, r: []const [*]const i16) [T][*]const i16 {
+    var o: [T][*]const i16 = undefined;
+    inline for (0..T) |j| o[j] = r[j];
+    return o;
+}
+
+inline fn gather8q(src: [*]const u8, pos: [*]const i32, off: usize) @Vector(8, u64) {
+    var a: [8]u64 = undefined;
+    inline for (0..8) |q| a[q] = @as(*align(1) const u64, @ptrCast(src + @as(usize, @intCast(pos[q])) * 2 + off)).*;
+    return a;
+}
+fn even16() @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..16) |i| m[i] = @intCast(2 * i);
+    return m;
+}
+fn odd16() @Vector(16, i32) {
+    var m: [16]i32 = undefined;
+    for (0..16) |i| m[i] = @intCast(2 * i + 1);
+    return m;
+}
+inline fn madd32(a: @Vector(32, i16), b: @Vector(32, i16)) @Vector(16, i32) {
+    const p = @as(@Vector(32, i32), a) * @as(@Vector(32, i32), b);
+    return @shuffle(i32, p, undefined, even16()) + @shuffle(i32, p, undefined, odd16());
+}
+
+// ── block patterns: source offsets of 8 consecutive outputs relative to the first ──
+// ids 0..127: steps in {0,1} (bit k = step from output k to k+1); 128: stride 2; 129: stride 3.
+pub const PAT_NONE: u8 = 255;
+
+pub fn patternId(d: [8]i32) u8 {
+    var id: u8 = 0;
+    var ok01 = true;
+    for (0..7) |q| {
+        const st = d[q + 1] - d[q];
+        if (st == 1) id |= @as(u8, 1) << @intCast(q) else if (st != 0) ok01 = false;
+    }
+    if (ok01) return id;
+    var s2 = true;
+    var s3 = true;
+    for (0..8) |q| {
+        if (d[q] != 2 * @as(i32, @intCast(q))) s2 = false;
+        if (d[q] != 3 * @as(i32, @intCast(q))) s3 = false;
+    }
+    if (s2) return 128;
+    if (s3) return 129;
+    return PAT_NONE;
+}
+
+fn patOff(comptime id: u8) [8]usize {
+    var d: [8]usize = undefined;
+    d[0] = 0;
+    if (id < 128) {
+        for (0..7) |q| d[q + 1] = d[q] + ((id >> q) & 1);
+    } else {
+        const s: usize = if (id == 128) 2 else 3;
+        for (0..8) |q| d[q] = s * q;
+    }
+    return d;
+}
+
+/// bytes that must be readable from the block's first position
+pub fn windowBytes(id: u8, es: usize, G: usize, groups: usize) usize {
+    const last: usize = if (id < 128) @popCount(id) else if (id == 128) 14 else 21;
+    _ = G;
+    const span = (last + groups * 8) * es; // generous: covers all groups' taps
+    return if (span <= 32) 32 else 64;
+}
+
+fn winSize(comptime id: u8, comptime es: usize, comptime groups: usize) usize {
+    const last: usize = if (id < 128) @popCount(id) else if (id == 128) 14 else 21;
+    const span = (last + groups * 8) * es;
+    return if (span <= 32) 32 else 64;
+}
+
+/// Build the dword-per-output vector (bytes [4*o .. 4*o+3] = source bytes at off_o*es + gbyte ...)
+fn patMask(comptime id: u8, comptime es: usize, comptime bytesPer: usize, comptime gbyte: usize) @Vector(8 * bytesPer, i32) {
+    @setEvalBranchQuota(100000);
+    const d = patOff(id);
+    var m: [8 * bytesPer]i32 = undefined;
+    for (0..8) |o| {
+        for (0..bytesPer) |q| m[o * bytesPer + q] = @intCast(d[o] * es + gbyte + q);
+    }
+    return m;
+}
+
+inline fn blockAcc(comptime T: type, comptime groups: usize, comptime wide: bool, comptime id: ?u8, bytes: [*]const u8, pos: [*]const i32, cp: [*]const i16) @Vector(8, i32) {
+    const V8 = @Vector(8, i32);
+    const es: usize = @sizeOf(T);
+    var acc: V8 = @splat(0);
+    var c = cp;
+    const base: [*]const u8 = bytes + @as(usize, @intCast(pos[0])) * es;
+    const W: u32 = comptime if (id) |pid| @intCast(winSize(pid, es, groups)) else 1;
+    const win: @Vector(W, u8) = if (id != null) base[0..W].* else @splat(0);
+    inline for (0..groups) |g| {
+        if (T == u16 and wide) {
+            const raw: @Vector(64, u8) = if (id) |pid| @shuffle(u8, win, undefined, patMask(pid, 2, 8, g * 8)) else @bitCast(gather8q(bytes, pos, g * 8));
+            const v: @Vector(32, i16) = @bitCast(raw);
+            const cv: @Vector(32, i16) = c[0..32].*;
+            const p = madd32(v, cv);
+            acc += @shuffle(i32, p, undefined, evenM8()) + @shuffle(i32, p, undefined, oddM8());
+            c += 32;
+        } else if (T == u16) {
+            const raw: @Vector(32, u8) = if (id) |pid| @shuffle(u8, win, undefined, patMask(pid, 2, 4, g * 4)) else @bitCast(gather8(bytes, pos, 2, g * 4));
+            const v: @Vector(16, i16) = @bitCast(raw);
+            const cv: @Vector(16, i16) = c[0..16].*;
+            acc += madd(v, cv);
+            c += 16;
+        } else {
+            const raw: @Vector(32, u8) = if (id) |pid| @shuffle(u8, win, undefined, patMask(pid, 1, 4, g * 4)) else @bitCast(gather8(bytes, pos, 1, g * 4));
+            const v: @Vector(8, u32) = @bitCast(raw);
+            const mk: @Vector(8, u32) = @splat(0x00FF00FF);
+            const lo: @Vector(16, i16) = @bitCast(v & mk);
+            const hi: @Vector(16, i16) = @bitCast((v >> @splat(8)) & mk);
+            const c0: @Vector(16, i16) = c[0..16].*;
+            const c1: @Vector(16, i16) = c[16..32].*;
+            acc += madd(lo, c0) + madd(hi, c1);
+            c += 32;
+        }
+    }
+    return acc;
+}
+
+// point-filter block patterns: 0..127 steps {0,1}; 128..255 steps {1,2}; 256 stride 3
+pub const PPAT_NONE: u16 = 0xFFFF;
+
+pub fn pointPatternId(d: [8]i32) u16 {
+    var m01: u16 = 0;
+    var m12: u16 = 0;
+    var ok01 = true;
+    var ok12 = true;
+    var s3 = true;
+    for (0..7) |q| {
+        const st = d[q + 1] - d[q];
+        if (st == 1) m01 |= @as(u16, 1) << @intCast(q) else if (st != 0) ok01 = false;
+        if (st == 2) m12 |= @as(u16, 1) << @intCast(q) else if (st != 1) ok12 = false;
+        if (st != 3) s3 = false;
+    }
+    if (ok01) return m01;
+    if (ok12) return 128 + m12;
+    if (s3) return 256;
+    return PPAT_NONE;
+}
+
+pub fn pointWindow(es: usize) usize {
+    return if (es == 2) 64 else 32;
+}
+
+fn ppOff(comptime id: u16) [8]usize {
+    var d: [8]usize = undefined;
+    d[0] = 0;
+    for (0..7) |q| {
+        const st: usize = if (id < 128) ((id >> q) & 1) else if (id < 256) 1 + (((id - 128) >> q) & 1) else 3;
+        d[q + 1] = d[q] + st;
+    }
+    return d;
+}
+
+fn ppMask(comptime id: u16, comptime es: usize) @Vector(16, i32) {
+    @setEvalBranchQuota(100000);
+    const d = ppOff(id);
+    var m: [16]i32 = undefined;
+    for (0..8) |o| {
+        m[2 * o] = @intCast(d[o] * es);
+        m[2 * o + 1] = if (es == 2) @intCast(d[o] * es + 1) else ~@as(i32, 0);
+    }
+    return m;
+}
+
+inline fn pointBlock(comptime T: type, comptime id: u16, comptime sh: u5, dst: [*]i16, base: [*]const u8) void {
+    const es: usize = @sizeOf(T);
+    const W: u32 = comptime @intCast(pointWindow(es));
+    const win: @Vector(W, u8) = base[0..W].*;
+    const z: @Vector(16, u8) = @splat(0);
+    const raw: @Vector(16, u8) = @shuffle(u8, win, z, ppMask(id, es));
+    const v: @Vector(8, u16) = @bitCast(raw);
+    const x: @Vector(8, i32) = v;
+    dst[0..8].* = @as(@Vector(8, i16), @intCast((x << @splat(14)) >> @splat(sh)));
+}
+
+fn pointVec(comptime T: type, comptime sh: u5, dst: []i16, src: [*]const T, f: *const Filter) void {
+    const bytes: [*]const u8 = @ptrCast(src);
+    const es: usize = @sizeOf(T);
+    var b: usize = 0;
+    while (b * 8 < f.pvecN) : (b += 1) {
+        const i = b * 8;
+        const id = f.ppat[b];
+        if (id == PPAT_NONE) {
+            inline for (0..8) |o| dst[i + o] = @intCast((@as(i32, src[@intCast(f.pos[i + o])]) << 14) >> sh);
+        } else {
+            const base = bytes + @as(usize, @intCast(f.pos[i])) * es;
+            switch (id) {
+                inline 0...256 => |pid| pointBlock(T, pid, sh, dst.ptr + i, base),
+                else => unreachable,
+            }
+        }
+    }
+    for (dst[f.pvecN..], f.pvecN..) |*d, i| d.* = @intCast((@as(i32, src[@intCast(f.pos[i])]) << 14) >> sh);
+}
+
+fn hscaleVecG(comptime T: type, comptime groups: usize, comptime wide: bool, comptime sh: u5, dst: []i16, src: [*]const T, f: *const Filter) usize {
+    const V8 = @Vector(8, i32);
+    const bytes: [*]const u8 = @ptrCast(src);
+    const per: usize = groups * (if (T == u16 and !wide) @as(usize, 16) else 32);
+    var i: usize = 0;
+    var b: usize = 0;
+    while (i < f.vecN) : ({
+        i += 8;
+        b += 1;
+    }) {
+        const cp = f.cpk.ptr + b * per;
+        const pos = f.pos.ptr + i;
+        const acc: V8 = if (groups <= 2) switch (f.pat[b]) {
+            inline 0...129 => |pid| blockAcc(T, groups, wide, @as(u8, pid), bytes, pos, cp),
+            else => blockAcc(T, groups, wide, null, bytes, pos, cp),
+        } else blockAcc(T, groups, wide, null, bytes, pos, cp);
+        dst[i..][0..8].* = @as(@Vector(8, i16), @truncate(@min(acc >> @splat(sh), @as(V8, @splat(32767)))));
+    }
+    return i;
+}
+
+fn hscaleVec(comptime T: type, comptime sh: u5, dst: []i16, src: [*]const T, f: *const Filter) usize {
+    if (f.vecN == 0) return 0;
+    return switch (f.groups) {
+        inline 1...6 => |g| if (f.wide) hscaleVecG(T, g, true, sh, dst, src, f) else hscaleVecG(T, g, false, sh, dst, src, f),
+        else => 0,
+    };
+}
+
+fn hscaleAny(comptime T: type, comptime sh: u5, dst: []i16, src: [*]const T, f: *const Filter) void {
+    switch (f.kind) {
+        .identity => {
+            // coefficient is exactly 1<<14 at pos i
+            var i: usize = 0;
+            const W = @Vector(N, i32);
+            while (i + N <= dst.len) : (i += N) {
+                const v: @Vector(N, T) = src[i..][0..N].*;
+                const x: W = v;
+                dst[i..][0..N].* = @as(@Vector(N, i16), @intCast((x << @splat(14)) >> @splat(sh)));
+            }
+            while (i < dst.len) : (i += 1) dst[i] = @intCast((@as(i32, src[i]) << 14) >> sh);
+        },
+        .point => pointVec(T, sh, dst, src, f),
+        .general => switch (f.size) {
+            inline 1...12 => |n| {
+                const done = hscaleVec(T, sh, dst, src, f);
+                hscaleN(T, n, sh, dst[done..], src, f, done);
+            },
+            else => {
+                const n = f.size;
+                for (dst, 0..) |*d, i| {
+                    const p: usize = @intCast(f.pos[i]);
+                    var val: i32 = 0;
+                    for (0..n) |j| val += @as(i32, src[p + j]) * f.coef[i * n + j];
+                    d.* = @truncate(@min(val >> sh, 32767));
+                }
+            },
+        },
+    }
+}
+
+pub fn hscale8(dst: []i16, src: [*]const u8, f: *const Filter) void {
+    hscaleAny(u8, 7, dst, src, f);
+}
+
+pub fn hscale16(dst: []i16, src: [*]const u16, f: *const Filter) void {
+    hscaleAny(u16, 13, dst, src, f);
+}
+
+// ── vertical scalers / planar output ───────────────────────────────────────
+
+pub fn plane1(d: [*]u8, s: [*]const i16, w: usize) void {
+    var i: usize = 0;
+    const I = @Vector(32, i16);
+    while (i + 32 <= w) : (i += 32) {
+        // (x + 64) >> 7 with a saturating add: only x > 32703 saturates, and those clip to 255 anyway
+        const x: I = s[i..][0..32].*;
+        const y = (x +| @as(I, @splat(64))) >> @splat(7);
+        const o: @Vector(32, u8) = @intCast(@min(@max(y, @as(I, @splat(0))), @as(I, @splat(255))));
+        d[i..][0..32].* = o;
+    }
+    while (i < w) : (i += 1) d[i] = clipU8((@as(i32, s[i]) + 64) >> 7);
+}
+
+fn planeXT(comptime T: usize, d: [*]u8, rows_: []const [*]const i16, f: []const i16, w: usize) void {
+    const rows = mkRows(T, rows_);
+    const cps = mkCps(T, f);
+    var i: usize = 0;
+    while (i + N <= w) : (i += N) {
+        const acc = splat(64 << 12) + pmFilt(T, rows, cps, i);
+        d[i..][0..N].* = unperm(vec.clampU8(acc >> splat(19)));
+    }
+    while (i < w) : (i += 1) {
+        var val: i32 = 64 << 12;
+        for (rows, f[0..T]) |r, c| val += @as(i32, r[i]) * c;
+        d[i] = clipU8(val >> 19);
+    }
+}
+
+pub fn planeX(d: [*]u8, rows: []const [*]const i16, f: []const i16, w: usize) void {
+    switch (rows.len) {
+        inline 2...12 => |T| return planeXT(T, d, rows, f, w),
+        else => {},
+    }
+    var i: usize = 0;
+    while (i + N <= w) : (i += N) {
+        var acc = splat(64 << 12);
+        for (rows, f) |r, c| acc += vec.loadI16(r + i) * splat(c);
+        d[i..][0..N].* = vec.clampU8(acc >> splat(19));
+    }
+    while (i < w) : (i += 1) {
+        var val: i32 = 64 << 12;
+        for (rows, f) |r, c| val += @as(i32, r[i]) * c;
+        d[i] = clipU8(val >> 19);
+    }
+}
+
+fn nv12cXT(comptime T: usize, d: [*]u8, us_: []const [*]const i16, vs_: []const [*]const i16, f: []const i16, w: usize, swap: bool) void {
+    const us = mkRows(T, us_);
+    const vs = mkRows(T, vs_);
+    const cps = mkCps(T, f);
+    var i: usize = 0;
+    while (i + N <= w) : (i += N) {
+        const uu = unperm(vec.clampU8((splat(64 << 12) + pmFilt(T, us, cps, i)) >> splat(19)));
+        const vv = unperm(vec.clampU8((splat(64 << 12) + pmFilt(T, vs, cps, i)) >> splat(19)));
+        const out: @Vector(2 * N, u8) = if (swap) @shuffle(u8, vv, uu, ilvMask()) else @shuffle(u8, uu, vv, ilvMask());
+        d[2 * i ..][0 .. 2 * N].* = out;
+    }
+    while (i < w) : (i += 1) {
+        var u: i32 = 64 << 12;
+        var v: i32 = 64 << 12;
+        for (us, vs, f[0..T]) |ru, rv, c| {
+            u += @as(i32, ru[i]) * c;
+            v += @as(i32, rv[i]) * c;
+        }
+        if (swap) {
+            d[2 * i] = clipU8(v >> 19);
+            d[2 * i + 1] = clipU8(u >> 19);
+        } else {
+            d[2 * i] = clipU8(u >> 19);
+            d[2 * i + 1] = clipU8(v >> 19);
+        }
+    }
+}
+
+pub fn nv12cX(d: [*]u8, us: []const [*]const i16, vs: []const [*]const i16, f: []const i16, w: usize, swap: bool) void {
+    switch (us.len) {
+        inline 2...12 => |T| return nv12cXT(T, d, us, vs, f, w, swap),
+        else => {},
+    }
+    var i: usize = 0;
+    while (i + N <= w) : (i += N) {
+        var u = splat(64 << 12);
+        var v = splat(64 << 12);
+        for (us, vs, f) |ru, rv, c| {
+            u += vec.loadI16(ru + i) * splat(c);
+            v += vec.loadI16(rv + i) * splat(c);
+        }
+        const uu = vec.clampU8(u >> splat(19));
+        const vv = vec.clampU8(v >> splat(19));
+        const out: @Vector(2 * N, u8) = if (swap) @shuffle(u8, vv, uu, ilvMask()) else @shuffle(u8, uu, vv, ilvMask());
+        d[2 * i ..][0 .. 2 * N].* = out;
+    }
+    while (i < w) : (i += 1) {
+        var u: i32 = 64 << 12;
+        var v: i32 = 64 << 12;
+        for (us, vs, f) |ru, rv, c| {
+            u += @as(i32, ru[i]) * c;
+            v += @as(i32, rv[i]) * c;
+        }
+        if (swap) {
+            d[2 * i] = clipU8(v >> 19);
+            d[2 * i + 1] = clipU8(u >> 19);
+        } else {
+            d[2 * i] = clipU8(u >> 19);
+            d[2 * i + 1] = clipU8(v >> 19);
+        }
+    }
+}
+
+fn ilvMask() @Vector(2 * N, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [2 * N]i32 = undefined;
+    for (0..N) |i| {
+        m[2 * i] = @intCast(i);
+        m[2 * i + 1] = ~@as(i32, @intCast(i));
+    }
+    return m;
+}
+
+// ── packed RGB output ──────────────────────────────────────────────────────
+
+pub const PackedArgs = struct {
+    tabs: *const YuvTables,
+    df: c_int,
+    dst: [*]u8,
+    dw: usize,
+    lum: []const [*]const i16,
+    lf: []const i16,
+    u: []const [*]const i16,
+    v: []const [*]const i16,
+    cf: []const i16,
+    alp: ?[]const [*]const i16,
+};
+
+inline fn fu16(x: i16) u32 {
+    return @as(u16, @bitCast(x));
+}
+
+fn twoTap(f: []const i16) bool {
+    return f.len == 2 and fu16(f[0]) + fu16(f[1]) == 4096 and fu16(f[1]) <= 4096;
+}
+
+fn packedHalfT(comptime df: c_int, a: PackedArgs) void {
+    const t = a.tabs;
+    const off = comptime chanOffsets(df);
+    const bpp: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    const n = (a.dw + 1) >> 1;
+    const H = @Vector(N / 2, i32);
+    const l0 = a.lum[0];
+    const uu0 = a.u[0];
+    const vv0 = a.v[0];
+    var i: usize = 0; // chroma index; output pixels 2i, 2i+1
+    if (a.lum.len == 1 and (a.cf.len == 1 or twoTap(a.cf))) {
+        const uvalpha: u32 = if (a.cf.len == 1) 0 else fu16(a.cf[1]);
+        if (uvalpha < 2048) {
+            while (i + N / 2 <= n) : (i += N / 2) {
+                const Y = (vec.loadI16(l0 + 2 * i) + splat(64)) >> splat(7);
+                const U = (loadH(uu0 + i) + @as(H, @splat(64))) >> @splat(7);
+                const V = (loadH(vv0 + i) + @as(H, @splat(64))) >> @splat(7);
+                vec.storeBpp(bpp, a.dst + 2 * i * bpp, orderCh(df, tabVecHalf(t, Y, U, V)));
+            }
+            while (i < n) : (i += 1) {
+                const Y1 = (@as(i32, l0[2 * i]) + 64) >> 7;
+                const Y2 = (@as(i32, l0[2 * i + 1]) + 64) >> 7;
+                const U = (@as(i32, uu0[i]) + 64) >> 7;
+                const V = (@as(i32, vv0[i]) + 64) >> 7;
+                putTab(t, a.dst + 2 * i * bpp, off, bpp, Y1, U, V);
+                putTab(t, a.dst + (2 * i + 1) * bpp, off, bpp, Y2, U, V);
+            }
+        } else {
+            const uu1 = a.u[1];
+            const vv1 = a.v[1];
+            while (i + N / 2 <= n) : (i += N / 2) {
+                const Y = (vec.loadI16(l0 + 2 * i) + splat(64)) >> splat(7);
+                const U = (loadH(uu0 + i) + loadH(uu1 + i) + @as(H, @splat(128))) >> @splat(8);
+                const V = (loadH(vv0 + i) + loadH(vv1 + i) + @as(H, @splat(128))) >> @splat(8);
+                vec.storeBpp(bpp, a.dst + 2 * i * bpp, orderCh(df, tabVecHalf(t, Y, U, V)));
+            }
+            while (i < n) : (i += 1) {
+                const Y1 = (@as(i32, l0[2 * i]) + 64) >> 7;
+                const Y2 = (@as(i32, l0[2 * i + 1]) + 64) >> 7;
+                const U = (@as(i32, uu0[i]) + uu1[i] + 128) >> 8;
+                const V = (@as(i32, vv0[i]) + vv1[i] + 128) >> 8;
+                putTab(t, a.dst + 2 * i * bpp, off, bpp, Y1, U, V);
+                putTab(t, a.dst + (2 * i + 1) * bpp, off, bpp, Y2, U, V);
+            }
+        }
+    } else if (twoTap(a.lf) and twoTap(a.cf)) {
+        const ya: i32 = a.lf[1];
+        const ya1: i32 = 4096 - ya;
+        const ca: i32 = a.cf[1];
+        const ca1: i32 = 4096 - ca;
+        const l1 = a.lum[1];
+        const uu1 = a.u[1];
+        const vv1 = a.v[1];
+        while (i + N / 2 <= n) : (i += N / 2) {
+            const Y = (vec.loadI16(l0 + 2 * i) * splat(ya1) + vec.loadI16(l1 + 2 * i) * splat(ya)) >> splat(19);
+            const U = (loadH(uu0 + i) * @as(H, @splat(ca1)) + loadH(uu1 + i) * @as(H, @splat(ca))) >> @splat(19);
+            const V = (loadH(vv0 + i) * @as(H, @splat(ca1)) + loadH(vv1 + i) * @as(H, @splat(ca))) >> @splat(19);
+            vec.storeBpp(bpp, a.dst + 2 * i * bpp, orderCh(df, tabVecHalf(t, Y, U, V)));
+        }
+        while (i < n) : (i += 1) {
+            const Y1 = (@as(i32, l0[2 * i]) * ya1 + @as(i32, l1[2 * i]) * ya) >> 19;
+            const Y2 = (@as(i32, l0[2 * i + 1]) * ya1 + @as(i32, l1[2 * i + 1]) * ya) >> 19;
+            const U = (@as(i32, uu0[i]) * ca1 + @as(i32, uu1[i]) * ca) >> 19;
+            const V = (@as(i32, vv0[i]) * ca1 + @as(i32, vv1[i]) * ca) >> 19;
+            putTab(t, a.dst + 2 * i * bpp, off, bpp, Y1, U, V);
+            putTab(t, a.dst + (2 * i + 1) * bpp, off, bpp, Y2, U, V);
+        }
+    } else {
+        while (i + N / 2 <= n) : (i += N / 2) {
+            var Y = splat(1 << 18);
+            var U: H = @splat(1 << 18);
+            var V: H = @splat(1 << 18);
+            for (a.lum, a.lf) |r, c| Y += vec.loadI16(r + 2 * i) * splat(c);
+            for (a.u, a.v, a.cf) |ru, rv, c| {
+                U += loadH(ru + i) * @as(H, @splat(c));
+                V += loadH(rv + i) * @as(H, @splat(c));
+            }
+            vec.storeBpp(bpp, a.dst + 2 * i * bpp, orderCh(df, tabVecHalf(t, Y >> splat(19), U >> @splat(19), V >> @splat(19))));
+        }
+        while (i < n) : (i += 1) {
+            var Y1: i32 = 1 << 18;
+            var Y2: i32 = 1 << 18;
+            var U: i32 = 1 << 18;
+            var V: i32 = 1 << 18;
+            for (a.lum, a.lf) |r, c| {
+                Y1 += @as(i32, r[2 * i]) * c;
+                Y2 += @as(i32, r[2 * i + 1]) * c;
+            }
+            for (a.u, a.v, a.cf) |ru, rv, c| {
+                U += @as(i32, ru[i]) * c;
+                V += @as(i32, rv[i]) * c;
+            }
+            putTab(t, a.dst + 2 * i * bpp, off, bpp, Y1 >> 19, U >> 19, V >> 19);
+            putTab(t, a.dst + (2 * i + 1) * bpp, off, bpp, Y2 >> 19, U >> 19, V >> 19);
+        }
+    }
+}
+
+inline fn loadH(p: [*]const i16) @Vector(N / 2, i32) {
+    const v: @Vector(N / 2, i16) = p[0 .. N / 2].*;
+    return v;
+}
+
+fn dupPermM() @Vector(N, i32) {
+    var m: [N]i32 = undefined;
+    for (0..N) |p| {
+        const k: usize = if (p < 4) p else if (p < 8) p + 4 else if (p < 12) p - 4 else p;
+        m[p] = @intCast(k / 2);
+    }
+    return m;
+}
+
+/// X-path half-chroma output with T luma taps via pmaddwd (permuted lane order), no alpha.
+fn packedHalfPM(comptime df: c_int, comptime T: usize, a: PackedArgs) void {
+    const bpp: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    const off = comptime chanOffsets(df);
+    const lr = mkRows(T, a.lum);
+    const lc = mkCps(T, a.lf);
+    const tt = a.tabs.*;
+    const H = @Vector(N / 2, i32);
+    const n = (a.dw + 1) >> 1;
+    var i: usize = 0;
+    while (i + N / 2 <= n) : (i += N / 2) {
+        const Y = (splat(1 << 18) + pmFilt(T, lr, lc, 2 * i)) >> splat(19);
+        var U: H = @splat(1 << 18);
+        var V: H = @splat(1 << 18);
+        for (a.u, a.v, a.cf) |ru, rv, c| {
+            U += loadH(ru + i) * @as(H, @splat(c));
+            V += loadH(rv + i) * @as(H, @splat(c));
+        }
+        U >>= @splat(19);
+        V >>= @splat(19);
+        // table evaluation with chroma duplicated into the permuted pixel order
+        const Uc = @min(@max(U, @as(H, @splat(0))), @as(H, @splat(255)));
+        const Vc = @min(@max(V, @as(H, @splat(0))), @as(H, @splat(255)));
+        const cy: H = @splat(tt.cy);
+        const s16: H = @splat(16);
+        const rv = @as(H, @splat(tt.yoffs - (tt.crv >> 9))) + ((Vc * @as(H, @splat(tt.crv))) >> s16);
+        const gu = @as(H, @splat(tt.yoffs - (tt.cgu >> 9))) + ((Uc * @as(H, @splat(tt.cgu))) >> s16);
+        const gv = @as(H, @splat(-(tt.cgv >> 9))) + ((Vc * @as(H, @splat(tt.cgv))) >> s16);
+        const bu = @as(H, @splat(tt.yoffs - (tt.cbu >> 9))) + ((Uc * @as(H, @splat(tt.cbu))) >> s16);
+        const tr = @shuffle(i32, rv * cy, undefined, dupPermM());
+        const tg = @shuffle(i32, (gu + gv) * cy, undefined, dupPermM());
+        const tb = @shuffle(i32, bu * cy, undefined, dupPermM());
+        const yc = Y * splat(tt.cy) + splat(tt.K);
+        const ch: [4]VU8 = .{
+            unperm(vec.clampU8((yc + tr) >> splat(16))),
+            unperm(vec.clampU8((yc + tg) >> splat(16))),
+            unperm(vec.clampU8((yc + tb) >> splat(16))),
+            @splat(255),
+        };
+        vec.storeBpp(bpp, a.dst + 2 * i * bpp, orderCh(df, ch));
+    }
+    while (i < n) : (i += 1) {
+        var Y1: i32 = 1 << 18;
+        var Y2: i32 = 1 << 18;
+        var U: i32 = 1 << 18;
+        var V: i32 = 1 << 18;
+        for (a.lum, a.lf) |r, c| {
+            Y1 += @as(i32, r[2 * i]) * c;
+            Y2 += @as(i32, r[2 * i + 1]) * c;
+        }
+        for (a.u, a.v, a.cf) |ru, rv, c| {
+            U += @as(i32, ru[i]) * c;
+            V += @as(i32, rv[i]) * c;
+        }
+        putTab(&tt, a.dst + 2 * i * bpp, off, bpp, Y1 >> 19, U >> 19, V >> 19);
+        putTab(&tt, a.dst + (2 * i + 1) * bpp, off, bpp, Y2 >> 19, U >> 19, V >> 19);
+    }
+}
+
+pub fn packedHalf(a: PackedArgs) void {
+    const oneTap = a.lum.len == 1 and (a.cf.len == 1 or twoTap(a.cf));
+    const twoTapBoth = twoTap(a.lf) and twoTap(a.cf);
+    if (a.alp == null and !oneTap and !twoTapBoth and a.lum.len >= 2 and a.lum.len <= 6) {
+        switch (a.df) {
+            inline RGB24, BGR24, RGBA, BGRA => |df| switch (a.lum.len) {
+                inline 2...6 => |T| return packedHalfPM(df, T, a),
+                else => unreachable,
+            },
+            else => unreachable,
+        }
+    }
+    switch (a.df) {
+        inline RGB24, BGR24, RGBA, BGRA => |df| packedHalfT(df, a),
+        else => unreachable,
+    }
+}
+
+inline fn clip30(x: i32) i32 {
+    if (x < 0) return 0;
+    if (x > (1 << 30) - 1) return (1 << 30) - 1;
+    return x;
+}
+
+inline fn putFull(t: *const YuvTables, d: [*]u8, off: [4]usize, bpp: usize, Yin: i32, U: i32, V: i32, A: i32) void {
+    var Y = Yin -% t.y_offset;
+    Y = Y *% t.y_coeff;
+    Y +%= 1 << 21;
+    const R = clip30(Y +% V *% t.v2r);
+    const G = clip30(Y +% V *% t.v2g +% U *% t.u2g);
+    const B = clip30(Y +% U *% t.u2b);
+    d[off[0]] = @intCast(R >> 22);
+    d[off[1]] = @intCast(G >> 22);
+    d[off[2]] = @intCast(B >> 22);
+    if (bpp == 4) d[3] = @intCast(A);
+}
+
+inline fn clipA(a: i32) i32 {
+    return if (a & 0x100 != 0) std.math.clamp(a, 0, 255) else a;
+}
+
+inline fn fullVec(t: *const YuvTables, Yin: VI32, U: VI32, V: VI32) [3]VU8 {
+    const Y = (Yin -% splat(t.y_offset)) *% splat(t.y_coeff) +% splat(1 << 21);
+    const lo = splat(0);
+    const hi = splat((1 << 30) - 1);
+    const R = @min(@max(Y +% V *% splat(t.v2r), lo), hi);
+    const G = @min(@max(Y +% V *% splat(t.v2g) +% U *% splat(t.u2g), lo), hi);
+    const B = @min(@max(Y +% U *% splat(t.u2b), lo), hi);
+    return .{
+        @intCast(R >> splat(22)),
+        @intCast(G >> splat(22)),
+        @intCast(B >> splat(22)),
+    };
+}
+
+inline fn storeFull(comptime df: c_int, d: [*]u8, rgb: [3]VU8, A: VU8) void {
+    const bpp: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    const ch: [4]VU8 = .{ rgb[0], rgb[1], rgb[2], A };
+    vec.storeBpp(bpp, d, orderCh(df, ch));
+}
+
+inline fn clipAV(a: VI32) VU8 {
+    return vec.clampU8(a);
+}
+
+fn packedFullT(comptime df: c_int, a: PackedArgs) void {
+    const t = a.tabs;
+    const off = comptime chanOffsets(df);
+    const bpp: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    const n = a.dw;
+    const l0 = a.lum[0];
+    const uu0 = a.u[0];
+    const vv0 = a.v[0];
+    const opaque_: VU8 = @splat(255);
+    var i: usize = 0;
+    if (a.lum.len == 1 and (a.cf.len == 1 or twoTap(a.cf))) {
+        const uvalpha: u32 = if (a.cf.len == 1) 0 else fu16(a.cf[1]);
+        if (uvalpha < 2048) {
+            while (i + N <= n) : (i += N) {
+                const Y = vec.loadI16(l0 + i) * splat(4);
+                const U = (vec.loadI16(uu0 + i) - splat(128 << 7)) * splat(4);
+                const V = (vec.loadI16(vv0 + i) - splat(128 << 7)) * splat(4);
+                const A: VU8 = if (a.alp) |al| clipAV((vec.loadI16(al[0] + i) + splat(64)) >> splat(7)) else opaque_;
+                storeFull(df, a.dst + i * bpp, fullVec(t, Y, U, V), A);
+            }
+            while (i < n) : (i += 1) {
+                const Y = @as(i32, l0[i]) * 4;
+                const U = (@as(i32, uu0[i]) - (128 << 7)) * 4;
+                const V = (@as(i32, vv0[i]) - (128 << 7)) * 4;
+                const A: i32 = if (a.alp) |al| clipA((@as(i32, al[0][i]) + 64) >> 7) else 255;
+                putFull(t, a.dst + i * bpp, off, bpp, Y, U, V, A);
+            }
+        } else {
+            const uu1 = a.u[1];
+            const vv1 = a.v[1];
+            while (i + N <= n) : (i += N) {
+                const Y = vec.loadI16(l0 + i) * splat(4);
+                const U = (vec.loadI16(uu0 + i) + vec.loadI16(uu1 + i) - splat(128 << 8)) * splat(2);
+                const V = (vec.loadI16(vv0 + i) + vec.loadI16(vv1 + i) - splat(128 << 8)) * splat(2);
+                const A: VU8 = if (a.alp) |al| clipAV((vec.loadI16(al[0] + i) + splat(64)) >> splat(7)) else opaque_;
+                storeFull(df, a.dst + i * bpp, fullVec(t, Y, U, V), A);
+            }
+            while (i < n) : (i += 1) {
+                const Y = @as(i32, l0[i]) * 4;
+                const U = (@as(i32, uu0[i]) + uu1[i] - (128 << 8)) * 2;
+                const V = (@as(i32, vv0[i]) + vv1[i] - (128 << 8)) * 2;
+                const A: i32 = if (a.alp) |al| clipA((@as(i32, al[0][i]) + 64) >> 7) else 255;
+                putFull(t, a.dst + i * bpp, off, bpp, Y, U, V, A);
+            }
+        }
+    } else if (twoTap(a.lf) and twoTap(a.cf)) {
+        const ya: i32 = a.lf[1];
+        const ya1: i32 = 4096 - ya;
+        const ca: i32 = a.cf[1];
+        const ca1: i32 = 4096 - ca;
+        const l1 = a.lum[1];
+        const uu1 = a.u[1];
+        const vv1 = a.v[1];
+        while (i + N <= n) : (i += N) {
+            const Y = (vec.loadI16(l0 + i) * splat(ya1) + vec.loadI16(l1 + i) * splat(ya)) >> splat(10);
+            const U = (vec.loadI16(uu0 + i) * splat(ca1) + vec.loadI16(uu1 + i) * splat(ca) - splat(128 << 19)) >> splat(10);
+            const V = (vec.loadI16(vv0 + i) * splat(ca1) + vec.loadI16(vv1 + i) * splat(ca) - splat(128 << 19)) >> splat(10);
+            const A: VU8 = if (a.alp) |al| clipAV((vec.loadI16(al[0] + i) * splat(ya1) + vec.loadI16(al[1] + i) * splat(ya) + splat(1 << 18)) >> splat(19)) else opaque_;
+            storeFull(df, a.dst + i * bpp, fullVec(t, Y, U, V), A);
+        }
+        while (i < n) : (i += 1) {
+            const Y = (@as(i32, l0[i]) * ya1 + @as(i32, l1[i]) * ya) >> 10;
+            const U = (@as(i32, uu0[i]) * ca1 + @as(i32, uu1[i]) * ca - (128 << 19)) >> 10;
+            const V = (@as(i32, vv0[i]) * ca1 + @as(i32, vv1[i]) * ca - (128 << 19)) >> 10;
+            const A: i32 = if (a.alp) |al| clipA((@as(i32, al[0][i]) * ya1 + @as(i32, al[1][i]) * ya + (1 << 18)) >> 19) else 255;
+            putFull(t, a.dst + i * bpp, off, bpp, Y, U, V, A);
+        }
+    } else {
+        while (i + N <= n) : (i += N) {
+            var Y = splat(1 << 9);
+            var U = splat((1 << 9) - (128 << 19));
+            var V = splat((1 << 9) - (128 << 19));
+            for (a.lum, a.lf) |r, c| Y += vec.loadI16(r + i) * splat(c);
+            for (a.u, a.v, a.cf) |ru, rv, c| {
+                U += vec.loadI16(ru + i) * splat(c);
+                V += vec.loadI16(rv + i) * splat(c);
+            }
+            var A: VU8 = opaque_;
+            if (a.alp) |al| {
+                var av = splat(1 << 18);
+                for (al, a.lf) |r, c| av += vec.loadI16(r + i) * splat(c);
+                A = clipAV(av >> splat(19));
+            }
+            storeFull(df, a.dst + i * bpp, fullVec(t, Y >> splat(10), U >> splat(10), V >> splat(10)), A);
+        }
+        while (i < n) : (i += 1) {
+            var Y: i32 = 1 << 9;
+            var U: i32 = (1 << 9) - (128 << 19);
+            var V: i32 = (1 << 9) - (128 << 19);
+            for (a.lum, a.lf) |r, c| Y += @as(i32, r[i]) * c;
+            for (a.u, a.v, a.cf) |ru, rv, c| {
+                U += @as(i32, ru[i]) * c;
+                V += @as(i32, rv[i]) * c;
+            }
+            var A: i32 = 255;
+            if (a.alp) |al| {
+                A = 1 << 18;
+                for (al, a.lf) |r, c| A += @as(i32, r[i]) * c;
+                A = clipA(A >> 19);
+            }
+            putFull(t, a.dst + i * bpp, off, bpp, Y >> 10, U >> 10, V >> 10, A);
+        }
+    }
+}
+
+/// Vertical-filtered full-chroma output for T luma taps and Tc chroma taps (no alpha).
+fn packedFullPM(comptime df: c_int, comptime T: usize, comptime Tc: usize, comptime rnd: i32, a: PackedArgs) void {
+    const t = a.tabs;
+    const off = comptime chanOffsets(df);
+    const bpp: usize = comptime if (df == RGB24 or df == BGR24) 3 else 4;
+    const lr = mkRows(T, a.lum);
+    const lc = mkCps(T, a.lf);
+    const ur = mkRows(Tc, a.u);
+    const vr = mkRows(Tc, a.v);
+    const cc = mkCps(Tc, a.cf);
+    const tt = t.*;
+    var i: usize = 0;
+    while (i + N <= a.dw) : (i += N) {
+        const Y = (splat(rnd) + pmFilt(T, lr, lc, i)) >> splat(10);
+        const U = (splat(rnd - (128 << 19)) + pmFilt(Tc, ur, cc, i)) >> splat(10);
+        const V = (splat(rnd - (128 << 19)) + pmFilt(Tc, vr, cc, i)) >> splat(10);
+        const rgb = fullVec(&tt, Y, U, V);
+        storeFull(df, a.dst + i * bpp, .{ unperm(rgb[0]), unperm(rgb[1]), unperm(rgb[2]) }, @splat(255));
+    }
+    while (i < a.dw) : (i += 1) {
+        var Y: i32 = rnd;
+        var U: i32 = rnd - (128 << 19);
+        var V: i32 = rnd - (128 << 19);
+        for (a.lum, a.lf) |r, c| Y += @as(i32, r[i]) * c;
+        for (a.u, a.v, a.cf) |ru, rv, c| {
+            U += @as(i32, ru[i]) * c;
+            V += @as(i32, rv[i]) * c;
+        }
+        putFull(t, a.dst + i * bpp, off, bpp, Y >> 10, U >> 10, V >> 10, 255);
+    }
+}
+
+pub fn packedFull(a: PackedArgs) void {
+    // The 1-tap special cases (yuv2rgb_full_1) round differently; keep those in packedFullT.
+    const oneTap = a.lum.len == 1 and (a.cf.len == 1 or twoTap(a.cf));
+    if (a.alp == null and !oneTap and a.lum.len >= 2 and a.lum.len <= 6 and a.cf.len == a.lum.len) {
+        switch (a.df) {
+            inline RGB24, BGR24, RGBA, BGRA => |df| switch (a.lum.len) {
+                inline 2...6 => |T| {
+                    // yuv2rgb_full_2 (bilinear pair) has no rounding term; the X variant adds 1<<9
+                    if (T == 2 and twoTap(a.lf) and twoTap(a.cf)) return packedFullPM(df, 2, 2, 0, a);
+                    return packedFullPM(df, T, T, 1 << 9, a);
+                },
+                else => unreachable,
+            },
+            else => unreachable,
+        }
+    }
+    switch (a.df) {
+        inline RGB24, BGR24, RGBA, BGRA => |df| packedFullT(df, a),
+        else => unreachable,
+    }
+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,805 @@
+// main.zig — swscale-compatible scaler / pixel-format converter.
+//
+// Mirrors the arithmetic of FFmpeg's scalar libswscale (as configured by the
+// reference: SWS_POINT / SWS_BILINEAR / SWS_BICUBIC, default BT.601 tables) so
+// that output tracks the reference bit-for-bit where possible.
+
+const std = @import("std");
+const k = @import("kernels.zig");
+
+const YUV420P = 0;
+const YUV422P = 1;
+const YUV444P = 2;
+const NV12 = 3;
+const NV21 = 4;
+const RGB24 = 5;
+const BGR24 = 6;
+const RGBA = 7;
+const BGRA = 8;
+const GRAY8 = 9;
+
+const SWS_POINT = 0x10;
+const SWS_BILINEAR = 2;
+const SWS_BICUBIC = 4;
+
+const alloc = std.heap.c_allocator;
+
+fn isRGB(f: c_int) bool {
+    return f >= RGB24 and f <= BGRA;
+}
+fn hasAlpha(f: c_int) bool {
+    return f == RGBA or f == BGRA;
+}
+fn chrHSub(f: c_int) u5 {
+    return switch (f) {
+        YUV420P, YUV422P, NV12, NV21 => 1,
+        else => 0,
+    };
+}
+fn chrVSub(f: c_int) u5 {
+    return switch (f) {
+        YUV420P, NV12, NV21 => 1,
+        else => 0,
+    };
+}
+fn ceilShr(a: i32, s: u5) i32 {
+    return -((-a) >> s);
+}
+
+// ── filter construction (port of initFilter) ───────────────────────────────
+
+pub const FilterKind = enum { identity, point, general };
+
+pub const Filter = struct {
+    kind: FilterKind = .general,
+    size: usize,
+    pos: []i32,
+    coef: []i16,
+    // vector layout (see kernels.hscaleVec): groups of G taps per output
+    G: usize = 0,
+    wide: bool = false,
+    groups: usize = 0,
+    vecN: usize = 0,
+    cpk: []i16 = &.{},
+    pat: []u8 = &.{}, // per 8-output block: kernels.PAT_NONE or a pattern id
+    ppat: []u16 = &.{}, // point filters: per-block pattern (kernels.pointPatternId)
+    pvecN: usize = 0,
+};
+
+fn packPoint(f: *Filter, dstW: usize, srcW: usize, es: usize) !void {
+    if (f.kind != .point) return;
+    const blocks = dstW / 8;
+    const pp = try alloc.alloc(u16, blocks);
+    for (0..blocks) |b| {
+        var d: [8]i32 = undefined;
+        for (0..8) |o| d[o] = f.pos[b * 8 + o] - f.pos[b * 8];
+        const id = k.pointPatternId(d);
+        const p0: usize = @intCast(f.pos[b * 8]);
+        pp[b] = if (id != k.PPAT_NONE and p0 * es + k.pointWindow(es) <= srcW * es) id else k.PPAT_NONE;
+    }
+    f.ppat = pp;
+    f.pvecN = blocks * 8;
+}
+
+/// Pack coefficients for the vector H-scaler. G = taps fetched per dword
+/// (4 for 8-bit sources, 2 for 16-bit ones).
+fn packFilter(f: *Filter, dstW: usize, srcW: usize, G0: usize, src16: bool) !void {
+    if (f.kind != .general) return;
+    // 16-bit sources: one 64-bit load fetches 4 taps when the filter is long enough
+    const wide = src16 and f.size > 2;
+    const G: usize = if (wide) 4 else G0;
+    const groups = (f.size + G - 1) / G;
+    var vecN: usize = 0;
+    while (vecN + 8 <= dstW) : (vecN += 8) {
+        var ok = true;
+        for (vecN..vecN + 8) |i| {
+            if (@as(usize, @intCast(f.pos[i])) + groups * G > srcW) ok = false;
+        }
+        if (!ok) break;
+    }
+    const blocks = vecN / 8;
+    const cpk = try alloc.alloc(i16, blocks * groups * 8 * G);
+    @memset(cpk, 0);
+    for (0..blocks) |b| {
+        for (0..groups) |g| {
+            const base = (b * groups + g) * 8 * G;
+            for (0..8) |o| {
+                const i = b * 8 + o;
+                for (0..G) |t| {
+                    const j = g * G + t;
+                    const cval: i16 = if (j < f.size) f.coef[i * f.size + j] else 0;
+                    if (G == 2 or wide) {
+                        cpk[base + o * G + t] = cval;
+                    } else {
+                        // lo pairs (taps 0,2) then hi pairs (taps 1,3)
+                        const half: usize = t & 1;
+                        const slot: usize = t >> 1;
+                        cpk[base + half * 16 + o * 2 + slot] = cval;
+                    }
+                }
+            }
+        }
+    }
+    const pat = try alloc.alloc(u8, blocks);
+    const es: usize = if (src16) 2 else 1;
+    for (0..blocks) |b| {
+        var d: [8]i32 = undefined;
+        for (0..8) |o| d[o] = f.pos[b * 8 + o] - f.pos[b * 8];
+        const id = k.patternId(d);
+        const p0: usize = @intCast(f.pos[b * 8]);
+        const need = if (id == k.PAT_NONE) 0 else k.windowBytes(id, es, G, groups);
+        pat[b] = if (id != k.PAT_NONE and p0 * es + need <= srcW * es) id else k.PAT_NONE;
+    }
+    f.pat = pat;
+    f.G = G;
+    f.wide = wide;
+    f.groups = groups;
+    f.vecN = vecN;
+    f.cpk = cpk;
+}
+
+fn av_log2(v: u32) i32 {
+    if (v == 0) return 0;
+    return 31 - @as(i32, @clz(v));
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    const half = b >> 1;
+    return if (a >= 0) @divTrunc(a + half, b) else @divTrunc(a - half, b);
+}
+
+fn absi(a: i64) i64 {
+    return if (a < 0) -a else a;
+}
+
+fn initFilter(xInc: i32, srcW: i32, dstW: i32, one: i64, flags: u32, srcPos: i32, dstPos: i32) !Filter {
+    const dW: usize = @intCast(dstW);
+    const fone: i64 = @as(i64, 1) << @intCast(54 - @min(av_log2(@intCast(@divTrunc(srcW, dstW))), 8));
+    var filterSize: usize = 0;
+    const pos = try alloc.alloc(i32, dW + 3);
+    var filter: []i64 = undefined;
+
+    if (absi(@as(i64, xInc) - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, dW);
+        for (0..dW) |i| {
+            filter[i] = fone;
+            pos[i] = @intCast(i);
+        }
+    } else if (flags & SWS_POINT != 0) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, dW);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * xInc) >> 8) - ((@as(i64, srcPos) * 0x8000) >> 7);
+        for (0..dW) |i| {
+            const xx: i64 = (xDstInSrc - 0 + (1 << 15)) >> 16;
+            pos[i] = @intCast(xx);
+            filter[i] = fone;
+            xDstInSrc += xInc;
+        }
+    } else {
+        const sizeFactor: i64 = if (flags & SWS_BICUBIC != 0) 4 else 2;
+        var fs: i64 = undefined;
+        if (xInc <= 1 << 16) {
+            fs = 1 + sizeFactor;
+        } else {
+            fs = 1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW);
+        }
+        fs = @min(fs, srcW - 2);
+        fs = @max(fs, 1);
+        filterSize = @intCast(fs);
+        filter = try alloc.alloc(i64, dW * filterSize);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * xInc) >> 7) - ((@as(i64, srcPos) * 0x10000) >> 7);
+        for (0..dW) |i| {
+            var xx: i64 = @divTrunc(xDstInSrc - (fs - 2) * (1 << 16), 1 << 17);
+            pos[i] = @intCast(xx);
+            for (0..filterSize) |j| {
+                var d: i64 = absi(xx * (1 << 17) - xDstInSrc) << 13;
+                var coeff: i64 = 0;
+                if (xInc > 1 << 16) d = @divTrunc(d * dstW, srcW);
+                if (flags & SWS_BICUBIC != 0) {
+                    const B: i64 = 0;
+                    const C: i64 = @intFromFloat(0.6 * @as(f64, 1 << 24));
+                    if (d >= @as(i64, 1) << 31) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < @as(i64, 1) << 30) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * filterSize + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * @as(i64, xInc);
+        }
+    }
+
+    // no src/dst filter vectors: filter2 == filter
+    const filter2Size = filterSize;
+    const filter2 = filter;
+
+    // reduce filter size (step 1)
+    var minFilterSize: usize = 0;
+    const cutLimit: f64 = 0.002 * @as(f64, @floatFromInt(fone));
+    var ii: isize = @as(isize, @intCast(dW)) - 1;
+    while (ii >= 0) : (ii -= 1) {
+        const i: usize = @intCast(ii);
+        var min: usize = filter2Size;
+        var cutOff: i64 = 0;
+        for (0..filter2Size) |_| {
+            cutOff += absi(filter2[i * filter2Size]);
+            if (@as(f64, @floatFromInt(cutOff)) > cutLimit) break;
+            if (i < dW - 1 and pos[i] >= pos[i + 1]) break;
+            var kk: usize = 1;
+            while (kk < filter2Size) : (kk += 1) filter2[i * filter2Size + kk - 1] = filter2[i * filter2Size + kk];
+            filter2[i * filter2Size + kk - 1] = 0;
+            pos[i] += 1;
+        }
+        cutOff = 0;
+        var j: usize = filter2Size - 1;
+        while (j > 0) : (j -= 1) {
+            cutOff += absi(filter2[i * filter2Size + j]);
+            if (@as(f64, @floatFromInt(cutOff)) > cutLimit) break;
+            min -= 1;
+        }
+        if (min > minFilterSize) minFilterSize = min;
+    }
+
+    const outSize = minFilterSize; // filterAlign == 1
+    const f3 = try alloc.alloc(i64, dW * outSize);
+    defer alloc.free(f3);
+    for (0..dW) |i| {
+        for (0..outSize) |j| {
+            f3[i * outSize + j] = if (j >= filter2Size) 0 else filter2[i * filter2Size + j];
+        }
+    }
+    alloc.free(filter);
+
+    // fix borders
+    for (0..dW) |i| {
+        if (pos[i] < 0) {
+            var j: usize = 1;
+            while (j < outSize) : (j += 1) {
+                const left: usize = @intCast(@max(@as(i32, @intCast(j)) + pos[i], 0));
+                f3[i * outSize + left] += f3[i * outSize + j];
+                f3[i * outSize + j] = 0;
+            }
+            pos[i] = 0;
+        }
+        const fsz: i32 = @intCast(outSize);
+        if (pos[i] + fsz > srcW) {
+            const shift: i32 = pos[i] + @min(fsz - srcW, 0);
+            var acc: i64 = 0;
+            var jj: i32 = fsz - 1;
+            while (jj >= 0) : (jj -= 1) {
+                const ju: usize = @intCast(jj);
+                if (pos[i] + jj >= srcW) {
+                    acc += f3[i * outSize + ju];
+                    f3[i * outSize + ju] = 0;
+                }
+            }
+            jj = fsz - 1;
+            while (jj >= 0) : (jj -= 1) {
+                const ju: usize = @intCast(jj);
+                if (jj < shift) {
+                    f3[i * outSize + ju] = 0;
+                } else {
+                    f3[i * outSize + ju] = f3[i * outSize + @as(usize, @intCast(jj - shift))];
+                }
+            }
+            pos[i] -= shift;
+            f3[i * outSize + @as(usize, @intCast(srcW - 1 - pos[i]))] += acc;
+        }
+    }
+
+    const coef = try alloc.alloc(i16, outSize * (dW + 3));
+    @memset(coef, 0);
+    for (0..dW) |i| {
+        var err: i64 = 0;
+        var sum: i64 = 0;
+        for (0..outSize) |j| sum += f3[i * outSize + j];
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        for (0..outSize) |j| {
+            const v: i64 = f3[i * outSize + j] + err;
+            const intV: i64 = roundedDiv(v, sum);
+            coef[i * outSize + j] = @truncate(intV);
+            err = v - intV * sum;
+        }
+    }
+    pos[dW] = pos[dW - 1];
+    pos[dW + 1] = pos[dW - 1];
+    pos[dW + 2] = pos[dW - 1];
+    var kind: FilterKind = .general;
+    if (outSize == 1) {
+        kind = .point;
+        var ident = true;
+        for (0..dW) |i| {
+            if (coef[i] != one) kind = .general;
+            if (pos[i] != @as(i32, @intCast(i))) ident = false;
+        }
+        if (kind == .point and ident) kind = .identity;
+    }
+    return .{ .kind = kind, .size = outSize, .pos = pos, .coef = coef };
+}
+
+fn freeFilter(f: *Filter) void {
+    if (f.cpk.len != 0) alloc.free(f.cpk);
+    if (f.pat.len != 0) alloc.free(f.pat);
+    if (f.ppat.len != 0) alloc.free(f.ppat);
+    alloc.free(f.pos);
+    alloc.free(f.coef);
+}
+
+// ── context ────────────────────────────────────────────────────────────────
+
+const Mode = enum { generic, yuv2rgb, rgb2rgb, bgr24toyv12, planar2nv, nv2planar, copy };
+const RangeConv = enum { none, to_jpeg, from_jpeg };
+
+pub const Ctx = struct {
+    sw: i32,
+    sh: i32,
+    sf: c_int,
+    dw: i32,
+    dh: i32,
+    df: c_int,
+    mode: Mode = .generic,
+
+    tabs: k.YuvTables = undefined,
+    rgb2yuv: k.Rgb2Yuv = undefined,
+
+    // generic
+    hLum: Filter = undefined,
+    hChr: Filter = undefined,
+    vLum: Filter = undefined,
+    vChr: Filter = undefined,
+    chrSrcHSub: u5 = 0,
+    chrSrcVSub: u5 = 0,
+    chrDstHSub: u5 = 0,
+    chrDstVSub: u5 = 0,
+    chrSrcW: i32 = 0,
+    chrSrcH: i32 = 0,
+    chrDstW: i32 = 0,
+    chrDstH: i32 = 0,
+    fullChr: bool = false,
+    needsChr: bool = false,
+    needAlpha: bool = false,
+    range: RangeConv = .none,
+
+    lumBuf: []i16 = &.{},
+    chrUBuf: []i16 = &.{},
+    chrVBuf: []i16 = &.{},
+    alpBuf: []i16 = &.{},
+    lumStride: usize = 0,
+    chrStride: usize = 0,
+    needLum: []bool = &.{},
+    needChr: []bool = &.{},
+    tmp16a: []u16 = &.{},
+    tmp16b: []u16 = &.{},
+    tmp8a: []u8 = &.{},
+    tmp8b: []u8 = &.{},
+    lumRows: [][*]const i16 = &.{},
+    chrURows: [][*]const i16 = &.{},
+    chrVRows: [][*]const i16 = &.{},
+    alpRows: [][*]const i16 = &.{},
+};
+
+fn setupGeneric(c: *Ctx, algo: c_int) !void {
+    const flags: u32 = switch (algo) {
+        0 => SWS_POINT,
+        2 => SWS_BICUBIC,
+        else => SWS_BILINEAR,
+    };
+    const sw = c.sw;
+    const sh = c.sh;
+    const dw = c.dw;
+    const dh = c.dh;
+    const srcRGB = isRGB(c.sf);
+    const dstRGB = isRGB(c.df);
+
+    c.chrSrcHSub = chrHSub(c.sf);
+    c.chrSrcVSub = chrVSub(c.sf);
+    c.chrDstHSub = chrHSub(c.df);
+    c.chrDstVSub = chrVSub(c.df);
+    if (dstRGB) {
+        if (dw & 1 != 0) c.fullChr = true;
+        if (c.chrSrcHSub == 0 and c.chrSrcVSub == 0) c.fullChr = true;
+        if (!c.fullChr) c.chrDstHSub = 1;
+    }
+    if (srcRGB and (dw >> c.chrDstHSub) <= (sw >> 1)) c.chrSrcHSub = 1;
+    c.chrSrcW = ceilShr(sw, c.chrSrcHSub);
+    c.chrSrcH = ceilShr(sh, c.chrSrcVSub);
+    c.chrDstW = ceilShr(dw, c.chrDstHSub);
+    c.chrDstH = ceilShr(dh, c.chrDstVSub);
+
+    const lumXInc: i32 = @intCast(@divTrunc((@as(i64, sw) << 16) + (dw >> 1), dw));
+    const lumYInc: i32 = @intCast(@divTrunc((@as(i64, sh) << 16) + (dh >> 1), dh));
+    const chrXInc: i32 = @intCast(@divTrunc((@as(i64, c.chrSrcW) << 16) + (c.chrDstW >> 1), c.chrDstW));
+    const chrYInc: i32 = @intCast(@divTrunc((@as(i64, c.chrSrcH) << 16) + (c.chrDstH >> 1), c.chrDstH));
+
+    c.needsChr = !(c.sf == GRAY8 or c.df == GRAY8);
+    c.needAlpha = hasAlpha(c.sf) and hasAlpha(c.df);
+    const srcRange = c.sf == GRAY8;
+    const dstRange = c.df == GRAY8;
+    if (srcRange != dstRange and !dstRGB) c.range = if (srcRange) .from_jpeg else .to_jpeg;
+
+    c.hLum = try initFilter(lumXInc, sw, dw, 1 << 14, flags, 128, 128);
+    c.hChr = try initFilter(chrXInc, c.chrSrcW, c.chrDstW, 1 << 14, flags, 128, 128);
+    c.vLum = try initFilter(lumYInc, sh, dh, 1 << 12, flags, 128, 128);
+    c.vChr = try initFilter(chrYInc, c.chrSrcH, c.chrDstH, 1 << 12, flags, 128, 128);
+    const G: usize = if (srcRGB) 2 else 4;
+    try packFilter(&c.hLum, @intCast(dw), @intCast(sw), G, srcRGB);
+    try packFilter(&c.hChr, @intCast(c.chrDstW), @intCast(c.chrSrcW), G, srcRGB);
+    const es: usize = if (srcRGB) 2 else 1;
+    try packPoint(&c.hLum, @intCast(dw), @intCast(sw), es);
+    try packPoint(&c.hChr, @intCast(c.chrDstW), @intCast(c.chrSrcW), es);
+
+    const shu: usize = @intCast(sh);
+    const chu: usize = @intCast(c.chrSrcH);
+    c.lumStride = (@as(usize, @intCast(dw)) + 31) & ~@as(usize, 15);
+    c.chrStride = (@as(usize, @intCast(c.chrDstW)) + 31) & ~@as(usize, 15);
+    c.lumBuf = try alloc.alloc(i16, c.lumStride * shu);
+    c.chrUBuf = try alloc.alloc(i16, c.chrStride * chu);
+    c.chrVBuf = try alloc.alloc(i16, c.chrStride * chu);
+    if (c.needAlpha) c.alpBuf = try alloc.alloc(i16, c.lumStride * shu);
+    if (!c.needsChr) {
+        @memset(c.chrUBuf, 1 << 14);
+        @memset(c.chrVBuf, 1 << 14);
+    }
+    c.needLum = try alloc.alloc(bool, shu);
+    c.needChr = try alloc.alloc(bool, chu);
+    @memset(c.needLum, false);
+    @memset(c.needChr, false);
+    for (0..@intCast(dh)) |y| {
+        const p: usize = @intCast(c.vLum.pos[y]);
+        for (0..c.vLum.size) |j| c.needLum[p + j] = true;
+    }
+    for (0..@intCast(c.chrDstH)) |y| {
+        const p: usize = @intCast(c.vChr.pos[y]);
+        for (0..c.vChr.size) |j| c.needChr[p + j] = true;
+    }
+    const swu: usize = @intCast(sw);
+    c.tmp16a = try alloc.alloc(u16, swu * 2 + 64);
+    c.tmp16b = try alloc.alloc(u16, swu * 2 + 64);
+    c.tmp8a = try alloc.alloc(u8, swu + 64);
+    c.tmp8b = try alloc.alloc(u8, swu + 64);
+    c.lumRows = try alloc.alloc([*]const i16, 64);
+    c.chrURows = try alloc.alloc([*]const i16, 64);
+    c.chrVRows = try alloc.alloc([*]const i16, 64);
+    c.alpRows = try alloc.alloc([*]const i16, 64);
+}
+
+fn create(src_w: c_int, src_h: c_int, src_fmt: c_int, dst_w: c_int, dst_h: c_int, dst_fmt: c_int, algo: c_int) !*Ctx {
+    const c = try alloc.create(Ctx);
+    c.* = .{ .sw = src_w, .sh = src_h, .sf = src_fmt, .dw = dst_w, .dh = dst_h, .df = dst_fmt };
+    const srcFull = src_fmt == GRAY8;
+    c.tabs = k.YuvTables.init(srcFull);
+    c.rgb2yuv = k.Rgb2Yuv.init();
+
+    const unscaled = src_w == dst_w and src_h == dst_h;
+    const sameRange = (src_fmt == GRAY8) == (dst_fmt == GRAY8);
+    if (unscaled and (sameRange or isRGB(dst_fmt))) {
+        if (src_fmt == YUV420P and (dst_fmt == NV12 or dst_fmt == NV21)) c.mode = .planar2nv;
+        if (dst_fmt == YUV420P and (src_fmt == NV12 or src_fmt == NV21)) c.mode = .nv2planar;
+        if ((src_fmt == YUV420P or src_fmt == YUV422P) and isRGB(dst_fmt) and (dst_h & 1) == 0) c.mode = .yuv2rgb;
+        if (src_fmt == BGR24 and dst_fmt == YUV420P and (dst_w & 1) == 0) c.mode = .bgr24toyv12;
+        if (isRGB(src_fmt) and isRGB(dst_fmt)) c.mode = .rgb2rgb;
+        if (src_fmt == dst_fmt) c.mode = .copy;
+    }
+    if (c.mode == .generic) try setupGeneric(c, algo);
+    return c;
+}
+
+export fn swscale_create(src_w: c_int, src_h: c_int, src_fmt: c_int, dst_w: c_int, dst_h: c_int, dst_fmt: c_int, algo: c_int) ?*anyopaque {
+    if (src_fmt < 0 or src_fmt > 9 or dst_fmt < 0 or dst_fmt > 9) return null;
+    if (src_w < 1 or src_h < 1 or dst_w < 1 or dst_h < 1) return null;
+    if (algo < 0 or algo > 2) return null;
+    const c = create(src_w, src_h, src_fmt, dst_w, dst_h, dst_fmt, algo) catch return null;
+    return @ptrCast(c);
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    const c: *Ctx = @ptrCast(@alignCast(handle orelse return));
+    if (c.mode == .generic) {
+        freeFilter(&c.hLum);
+        freeFilter(&c.hChr);
+        freeFilter(&c.vLum);
+        freeFilter(&c.vChr);
+        alloc.free(c.lumBuf);
+        alloc.free(c.chrUBuf);
+        alloc.free(c.chrVBuf);
+        if (c.needAlpha) alloc.free(c.alpBuf);
+        alloc.free(c.needLum);
+        alloc.free(c.needChr);
+        alloc.free(c.tmp16a);
+        alloc.free(c.tmp16b);
+        alloc.free(c.tmp8a);
+        alloc.free(c.tmp8b);
+        alloc.free(c.lumRows);
+        alloc.free(c.chrURows);
+        alloc.free(c.chrVRows);
+        alloc.free(c.alpRows);
+    }
+    alloc.destroy(c);
+}
+
+fn rowPtr(p: [*]const u8, stride: c_int, y: usize) [*]const u8 {
+    return p + @as(usize, @intCast(stride)) * y;
+}
+fn rowPtrM(p: [*]u8, stride: c_int, y: usize) [*]u8 {
+    return p + @as(usize, @intCast(stride)) * y;
+}
+
+fn bppRGB(f: c_int) usize {
+    return if (f == RGB24 or f == BGR24) 3 else 4;
+}
+
+fn planeBytes(f: c_int, w: usize, plane: usize) usize {
+    return switch (f) {
+        YUV420P, YUV422P => if (plane == 0) w else (w + 1) / 2,
+        NV12, NV21 => if (plane == 0) w else ((w + 1) / 2) * 2,
+        RGB24, BGR24 => w * 3,
+        RGBA, BGRA => w * 4,
+        else => w,
+    };
+}
+fn planeRows(f: c_int, h: usize, plane: usize) usize {
+    if (plane == 0) return h;
+    return switch (f) {
+        YUV420P, NV12, NV21 => (h + 1) / 2,
+        else => h,
+    };
+}
+fn planeCount(f: c_int) usize {
+    return switch (f) {
+        YUV420P, YUV422P, YUV444P => 3,
+        NV12, NV21 => 2,
+        else => 1,
+    };
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const c: *Ctx = @ptrCast(@alignCast(handle orelse return -1));
+    const w: usize = @intCast(c.sw);
+    const h: usize = @intCast(c.sh);
+    switch (c.mode) {
+        .copy => {
+            for (0..planeCount(c.sf)) |p| {
+                const s = src_data[p] orelse return -1;
+                const d = dst_data[p] orelse return -1;
+                const n = planeBytes(c.sf, w, p);
+                for (0..planeRows(c.sf, h, p)) |y| {
+                    @memcpy(rowPtrM(d, dst_stride[p], y)[0..n], rowPtr(s, src_stride[p], y)[0..n]);
+                }
+            }
+        },
+        .planar2nv => {
+            const sy = src_data[0] orelse return -1;
+            const su = src_data[1] orelse return -1;
+            const sv = src_data[2] orelse return -1;
+            const dy = dst_data[0] orelse return -1;
+            const duv = dst_data[1] orelse return -1;
+            for (0..h) |y| @memcpy(rowPtrM(dy, dst_stride[0], y)[0..w], rowPtr(sy, src_stride[0], y)[0..w]);
+            const cw = (w + 1) / 2;
+            const swap = c.df == NV21;
+            for (0..(h + 1) / 2) |y| {
+                const a = rowPtr(if (swap) sv else su, src_stride[if (swap) 2 else 1], y);
+                const b = rowPtr(if (swap) su else sv, src_stride[if (swap) 1 else 2], y);
+                k.interleave(rowPtrM(duv, dst_stride[1], y), a, b, cw);
+            }
+        },
+        .nv2planar => {
+            const sy = src_data[0] orelse return -1;
+            const suv = src_data[1] orelse return -1;
+            const dy = dst_data[0] orelse return -1;
+            const du = dst_data[1] orelse return -1;
+            const dv = dst_data[2] orelse return -1;
+            for (0..h) |y| @memcpy(rowPtrM(dy, dst_stride[0], y)[0..w], rowPtr(sy, src_stride[0], y)[0..w]);
+            const cw = (w + 1) / 2;
+            const swap = c.sf == NV21;
+            for (0..(h + 1) / 2) |y| {
+                const a = rowPtrM(if (swap) dv else du, dst_stride[if (swap) 2 else 1], y);
+                const b = rowPtrM(if (swap) du else dv, dst_stride[if (swap) 1 else 2], y);
+                k.deinterleave(a, b, rowPtr(suv, src_stride[1], y), cw);
+            }
+        },
+        .rgb2rgb => {
+            const s = src_data[0] orelse return -1;
+            const d = dst_data[0] orelse return -1;
+            for (0..h) |y| {
+                k.rgbShuffle(c.sf, c.df, rowPtrM(d, dst_stride[0], y), rowPtr(s, src_stride[0], y), w);
+            }
+        },
+        .bgr24toyv12 => {
+            const s = src_data[0] orelse return -1;
+            const dy = dst_data[0] orelse return -1;
+            const du = dst_data[1] orelse return -1;
+            const dv = dst_data[2] orelse return -1;
+            var y: usize = 0;
+            while (y < h) : (y += 2) {
+                k.bgr24ToYv12Rows(&c.rgb2yuv, rowPtr(s, src_stride[0], y), rowPtr(s, src_stride[0], y + 1), rowPtrM(dy, dst_stride[0], y), rowPtrM(dy, dst_stride[0], y + 1), rowPtrM(du, dst_stride[1], y / 2), rowPtrM(dv, dst_stride[2], y / 2), w);
+            }
+        },
+        .yuv2rgb => {
+            const sy = src_data[0] orelse return -1;
+            const su = src_data[1] orelse return -1;
+            const sv = src_data[2] orelse return -1;
+            const d = dst_data[0] orelse return -1;
+            const is422 = c.sf == YUV422P;
+            var y: usize = 0;
+            while (y < h) : (y += 2) {
+                const d1 = rowPtrM(d, dst_stride[0], y);
+                const d2 = rowPtrM(d, dst_stride[0], y + 1);
+                const y1 = rowPtr(sy, src_stride[0], y);
+                const y2 = rowPtr(sy, src_stride[0], y + 1);
+                if (is422) {
+                    k.yuv2rgbRow8(&c.tabs, c.df, d1, null, y1, null, rowPtr(su, src_stride[1], y), rowPtr(sv, src_stride[2], y), w);
+                    k.yuv2rgbRow8(&c.tabs, c.df, d2, null, y2, null, rowPtr(su, src_stride[1], y + 1), rowPtr(sv, src_stride[2], y + 1), w);
+                } else {
+                    k.yuv2rgbRow8(&c.tabs, c.df, d1, d2, y1, y2, rowPtr(su, src_stride[1], y / 2), rowPtr(sv, src_stride[2], y / 2), w);
+                }
+            }
+        },
+        .generic => processGeneric(c, src_data, src_stride, dst_data, dst_stride) catch return -1,
+    }
+    return 0;
+}
+
+fn rangeConv(c: *Ctx, line: []i16) void {
+    switch (c.range) {
+        .none => {},
+        .to_jpeg => k.lumRangeToJpeg(line),
+        .from_jpeg => k.lumRangeFromJpeg(line),
+    }
+}
+
+fn processGeneric(
+    c: *Ctx,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) !void {
+    const sw: usize = @intCast(c.sw);
+    const dw: usize = @intCast(c.dw);
+    const cdw: usize = @intCast(c.chrDstW);
+    const csw: usize = @intCast(c.chrSrcW);
+    const srcRGB = isRGB(c.sf);
+    const s0 = src_data[0] orelse return error.Bad;
+
+    // ── horizontal pass: luma (and alpha) ──
+    for (c.needLum, 0..) |need, y| {
+        if (!need) continue;
+        const line = c.lumBuf[y * c.lumStride ..][0..dw];
+        const row = rowPtr(s0, src_stride[0], y);
+        if (srcRGB and c.hLum.kind == .identity and c.range == .none) {
+            k.rgbToYx2(c.sf, &c.rgb2yuv, line, row);
+            if (c.needAlpha) {
+                k.rgbaToA(c.tmp16b.ptr, row, sw);
+                k.hscale16(c.alpBuf[y * c.lumStride ..][0..dw], c.tmp16b.ptr, &c.hLum);
+            }
+        } else if (srcRGB) {
+            k.rgbToY(c.sf, &c.rgb2yuv, c.tmp16a.ptr, row, sw);
+            k.hscale16(line, c.tmp16a.ptr, &c.hLum);
+            if (c.needAlpha) {
+                k.rgbaToA(c.tmp16b.ptr, row, sw);
+                k.hscale16(c.alpBuf[y * c.lumStride ..][0..dw], c.tmp16b.ptr, &c.hLum);
+            }
+        } else {
+            k.hscale8(line, row, &c.hLum);
+        }
+        rangeConv(c, line);
+    }
+    // ── horizontal pass: chroma ──
+    if (c.needsChr) {
+        for (c.needChr, 0..) |need, y| {
+            if (!need) continue;
+            const lu = c.chrUBuf[y * c.chrStride ..][0..cdw];
+            const lv = c.chrVBuf[y * c.chrStride ..][0..cdw];
+            if (srcRGB) {
+                const row = rowPtr(s0, src_stride[0], y);
+                if (c.chrSrcHSub != 0 and c.hChr.kind == .identity) {
+                    k.rgbToUVHalfx2(c.sf, &c.rgb2yuv, lu, lv, row);
+                    continue;
+                }
+                if (c.chrSrcHSub != 0) {
+                    k.rgbToUVHalf(c.sf, &c.rgb2yuv, c.tmp16a.ptr, c.tmp16b.ptr, row, csw);
+                } else {
+                    k.rgbToUV(c.sf, &c.rgb2yuv, c.tmp16a.ptr, c.tmp16b.ptr, row, csw);
+                }
+                k.hscale16(lu, c.tmp16a.ptr, &c.hChr);
+                k.hscale16(lv, c.tmp16b.ptr, &c.hChr);
+            } else if (c.sf == NV12 or c.sf == NV21) {
+                const s1 = src_data[1] orelse return error.Bad;
+                const row = rowPtr(s1, src_stride[1], y);
+                if (c.sf == NV12) k.deinterleave(c.tmp8a.ptr, c.tmp8b.ptr, row, csw) else k.deinterleave(c.tmp8b.ptr, c.tmp8a.ptr, row, csw);
+                k.hscale8(lu, c.tmp8a.ptr, &c.hChr);
+                k.hscale8(lv, c.tmp8b.ptr, &c.hChr);
+            } else {
+                const s1 = src_data[1] orelse return error.Bad;
+                const s2 = src_data[2] orelse return error.Bad;
+                k.hscale8(lu, rowPtr(s1, src_stride[1], y), &c.hChr);
+                k.hscale8(lv, rowPtr(s2, src_stride[2], y), &c.hChr);
+            }
+        }
+    }
+
+    // ── vertical pass + output ──
+    const d0 = dst_data[0] orelse return error.Bad;
+    const dh: usize = @intCast(c.dh);
+    const lsz = c.vLum.size;
+    const csz = c.vChr.size;
+    for (0..dh) |y| {
+        const lp: usize = @intCast(c.vLum.pos[y]);
+        for (0..lsz) |j| c.lumRows[j] = c.lumBuf[(lp + j) * c.lumStride ..].ptr;
+        if (c.needAlpha) {
+            for (0..lsz) |j| c.alpRows[j] = c.alpBuf[(lp + j) * c.lumStride ..].ptr;
+        }
+        const lf = c.vLum.coef[y * lsz ..][0..lsz];
+        const cy = y >> c.chrDstVSub;
+        const cp: usize = @intCast(c.vChr.pos[cy]);
+        for (0..csz) |j| {
+            c.chrURows[j] = c.chrUBuf[(cp + j) * c.chrStride ..].ptr;
+            c.chrVRows[j] = c.chrVBuf[(cp + j) * c.chrStride ..].ptr;
+        }
+        const cf = c.vChr.coef[cy * csz ..][0..csz];
+        const drow = rowPtrM(d0, dst_stride[0], y);
+
+        if (isRGB(c.df)) {
+            const out = k.PackedArgs{
+                .tabs = &c.tabs,
+                .df = c.df,
+                .dst = drow,
+                .dw = dw,
+                .lum = c.lumRows[0..lsz],
+                .lf = lf,
+                .u = c.chrURows[0..csz],
+                .v = c.chrVRows[0..csz],
+                .cf = cf,
+                .alp = if (c.needAlpha) c.alpRows[0..lsz] else null,
+            };
+            if (c.fullChr) k.packedFull(out) else k.packedHalf(out);
+        } else {
+            // luma plane
+            if (lsz == 1) k.plane1(drow, c.lumRows[0], dw) else k.planeX(drow, c.lumRows[0..lsz], lf, dw);
+            if (c.df == GRAY8) continue;
+            const mask: usize = (@as(usize, 1) << c.chrDstVSub) - 1;
+            if (y & mask != 0) continue;
+            const d1 = dst_data[1] orelse return error.Bad;
+            const r1 = rowPtrM(d1, dst_stride[1], cy);
+            if (c.df == NV12 or c.df == NV21) {
+                k.nv12cX(r1, c.chrURows[0..csz], c.chrVRows[0..csz], cf, cdw, c.df == NV21);
+            } else {
+                const d2 = dst_data[2] orelse return error.Bad;
+                const r2 = rowPtrM(d2, dst_stride[2], cy);
+                if (csz == 1) {
+                    k.plane1(r1, c.chrURows[0], cdw);
+                    k.plane1(r2, c.chrVRows[0], cdw);
+                } else {
+                    k.planeX(r1, c.chrURows[0..csz], cf, cdw);
+                    k.planeX(r2, c.chrVRows[0..csz], cf, cdw);
+                }
+            }
+        }
+    }
+}
diff --git a/swscale-impl/src/vec.zig b/swscale-impl/src/vec.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/vec.zig
@@ -0,0 +1,133 @@
+// vec.zig — small @Vector helpers (pack/unpack of interleaved pixels).
+
+pub const N = 16;
+pub const VU8 = @Vector(N, u8);
+pub const VI16 = @Vector(N, i16);
+pub const VI32 = @Vector(N, i32);
+
+fn deintMask(comptime stride: usize, comptime c: usize) @Vector(N, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [N]i32 = undefined;
+    for (0..N) |i| m[i] = @intCast(stride * i + c);
+    return m;
+}
+
+pub inline fn load(p: [*]const u8) VU8 {
+    return p[0..N].*;
+}
+
+pub inline fn loadI16(p: [*]const i16) VI32 {
+    const v: VI16 = p[0..N].*;
+    return v;
+}
+
+/// Load N pixels of a 3- or 4-byte packed format and split into channels.
+pub inline fn deint(comptime bpp: usize, p: [*]const u8) [bpp]VU8 {
+    const v: @Vector(N * bpp, u8) = p[0 .. N * bpp].*;
+    var out: [bpp]VU8 = undefined;
+    inline for (0..bpp) |c| out[c] = @shuffle(u8, v, undefined, deintMask(bpp, c));
+    return out;
+}
+
+fn concatMask(comptime n: usize) @Vector(2 * n, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [2 * n]i32 = undefined;
+    for (0..n) |i| {
+        m[i] = @intCast(i);
+        m[n + i] = ~@as(i32, @intCast(i));
+    }
+    return m;
+}
+
+fn int3Mask() @Vector(3 * N, i32) {
+    @setEvalBranchQuota(100000);
+    // source: ab = a(0..N) ++ b(N..2N) as vector 1; c as vector 2 (padded to 2N)
+    var m: [3 * N]i32 = undefined;
+    for (0..N) |i| {
+        m[3 * i + 0] = @intCast(i);
+        m[3 * i + 1] = @intCast(N + i);
+        m[3 * i + 2] = ~@as(i32, @intCast(i));
+    }
+    return m;
+}
+
+fn int3Part(comptime q: usize) @Vector(N, i32) {
+    @setEvalBranchQuota(100000);
+    const full: [3 * N]i32 = int3Mask();
+    var m: [N]i32 = undefined;
+    for (0..N) |i| m[i] = full[q * N + i];
+    return m;
+}
+
+fn int4Part(comptime q: usize) @Vector(N, i32) {
+    @setEvalBranchQuota(100000);
+    const full: [4 * N]i32 = int4Mask();
+    var m: [N]i32 = undefined;
+    for (0..N) |i| m[i] = full[q * N + i];
+    return m;
+}
+
+fn int4Mask() @Vector(4 * N, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [4 * N]i32 = undefined;
+    for (0..N) |i| {
+        m[4 * i + 0] = @intCast(i);
+        m[4 * i + 1] = @intCast(N + i);
+        m[4 * i + 2] = ~@as(i32, @intCast(i));
+        m[4 * i + 3] = ~@as(i32, @intCast(N + i));
+    }
+    return m;
+}
+
+pub inline fn store3(p: [*]u8, a: VU8, b: VU8, c: VU8) void {
+    const ab: @Vector(2 * N, u8) = @shuffle(u8, a, b, concatMask(N));
+    inline for (0..3) |q| {
+        const part: VU8 = @shuffle(u8, ab, c, int3Part(q));
+        p[q * N ..][0..N].* = part;
+    }
+}
+
+pub inline fn store4(p: [*]u8, a: VU8, b: VU8, c: VU8, d: VU8) void {
+    const ab: @Vector(2 * N, u8) = @shuffle(u8, a, b, concatMask(N));
+    const cd: @Vector(2 * N, u8) = @shuffle(u8, c, d, concatMask(N));
+    inline for (0..4) |q| {
+        const part: VU8 = @shuffle(u8, ab, cd, int4Part(q));
+        p[q * N ..][0..N].* = part;
+    }
+}
+
+pub inline fn storeBpp(comptime bpp: usize, p: [*]u8, ch: [4]VU8) void {
+    if (bpp == 3) store3(p, ch[0], ch[1], ch[2]) else store4(p, ch[0], ch[1], ch[2], ch[3]);
+}
+
+pub inline fn splat(x: i32) VI32 {
+    return @splat(x);
+}
+
+pub inline fn clampU8(v: VI32) VU8 {
+    return @intCast(@min(@max(v, splat(0)), splat(255)));
+}
+
+/// Duplicate each of the first N/2 lanes: [a0,a0,a1,a1,...]
+pub inline fn dup2(v: VI32) VI32 {
+    return @shuffle(i32, v, undefined, dupMask());
+}
+
+pub inline fn loadHalfI16(p: [*]const i16) VI32 {
+    const v: @Vector(N / 2, i16) = p[0 .. N / 2].*;
+    const w: @Vector(N / 2, i32) = v;
+    return @shuffle(i32, w, undefined, dupMask());
+}
+
+pub inline fn loadHalfU8(p: [*]const u8) VI32 {
+    const v: @Vector(N / 2, u8) = p[0 .. N / 2].*;
+    const w: @Vector(N / 2, i32) = v;
+    return @shuffle(i32, w, undefined, dupMask());
+}
+
+pub fn dupMask() @Vector(N, i32) {
+    @setEvalBranchQuota(100000);
+    var m: [N]i32 = undefined;
+    for (0..N) |i| m[i] = @intCast(i / 2);
+    return m;
+}
