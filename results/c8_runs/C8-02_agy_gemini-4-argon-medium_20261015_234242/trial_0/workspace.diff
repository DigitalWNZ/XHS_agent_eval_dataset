+fn unscaledRgbToRgb(
+    comptime src_fmt: c_int,
+    comptime dst_fmt: c_int,
+    w: usize,
+    h: usize,
+    ps: [*]const u8,
+    ss: usize,
+    pd: [*]u8,
+    sd: usize,
+) void {
+    const s_step: usize = if (src_fmt == PIXFMT_RGB24 or src_fmt == PIXFMT_BGR24) 3 else 4;
+    const d_step: usize = if (dst_fmt == PIXFMT_RGB24 or dst_fmt == PIXFMT_BGR24) 3 else 4;
+    const s_bgr = (src_fmt == PIXFMT_BGR24 or src_fmt == PIXFMT_BGRA);
+    const d_bgr = (dst_fmt == PIXFMT_BGR24 or dst_fmt == PIXFMT_BGRA);
+    const s_alpha = isAlpha(src_fmt);
+    const d_alpha = isAlpha(dst_fmt);
+
+    for (0..h) |y| {
+        const s_row = ps + y * ss;
+        const d_row = pd + y * sd;
+        var x: usize = 0;
+        while (x + 16 <= w) : (x += 16) {
+            const px = loadRgb16(src_fmt, s_row + x * s_step);
+            storeRgb16(dst_fmt, d_row + x * d_step, px.r, px.g, px.b, px.a);
+        }
+        while (x < w) : (x += 1) {
+            const sp = s_row + x * s_step;
+            const dp = d_row + x * d_step;
+            const r = if (s_bgr) sp[2] else sp[0];
+            const g = sp[1];
+            const b = if (s_bgr) sp[0] else sp[2];
+            const a: u8 = if (s_alpha) sp[3] else 255;
+            dp[0] = if (d_bgr) b else r;
+            dp[1] = g;
+            dp[2] = if (d_bgr) r else b;
+            if (d_alpha) dp[3] = a;
+        }
+    }
+}
