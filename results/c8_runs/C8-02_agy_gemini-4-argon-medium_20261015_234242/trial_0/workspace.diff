+    if (!isAnyRGB(ctx.src_fmt) or !isAnyRGB(ctx.dst_fmt)) return false;
+
+    const srcW: usize = @intCast(ctx.src_w);
+    const dstW: usize = @intCast(ctx.dst_w);
+    const dstH: usize = @intCast(ctx.dst_h);
+    const s_fmt = ctx.src_fmt;
+    const d_fmt = ctx.dst_fmt;
+    const ps = src_data[0].?;
+    const ss: usize = @intCast(src_stride[0]);
+    const pd = dst_data[0].?;
+    const sd: usize = @intCast(dst_stride[0]);
+    const h_lum = ctx.h_lum.?;
+    const h_chr = ctx.h_chr.?;
+    const v_lum = ctx.v_lum.?;
