+        var ptrs_g: [64][*]const i16 = undefined;
+        var ptrs_b: [64][*]const i16 = undefined;
+        var ptrs_a: [64][*]const i16 = undefined;
+        const d_step: usize = if (d_fmt == PIXFMT_RGB24 or d_fmt == PIXFMT_BGR24) 3 else 4;
+        const d_bgr = (d_fmt == PIXFMT_BGR24 or d_fmt == PIXFMT_BGRA);
