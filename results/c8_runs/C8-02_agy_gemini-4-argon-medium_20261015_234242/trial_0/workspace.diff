+fn writeFullPixel(dst_fmt: c_int, dest: [*]u8, y_in: i32, u_in: i32, v_in: i32, a_in: u8, has_alpha: bool) void {
+    var Y: i32 = y_in - YUV2RGB_Y_OFFSET;
+    Y = Y * YUV2RGB_Y_COEFF + (1 << 21);
+    var R: i32 = Y +% v_in *% YUV2RGB_V2R_COEFF;
+    var G: i32 = Y +% v_in *% YUV2RGB_V2G_COEFF +% u_in *% YUV2RGB_U2G_COEFF;
+    var B: i32 = Y +% u_in *% YUV2RGB_U2B_COEFF;
+    if (((R | G | B) & @as(i32, @bitCast(@as(u32, 0xC0000000)))) != 0) {
+        R = clipUintp2_30(R);
+        G = clipUintp2_30(G);
+        B = clipUintp2_30(B);
+    }
+    const r8: u8 = @intCast(R >> 22);
+    const g8: u8 = @intCast(G >> 22);
+    const b8: u8 = @intCast(B >> 22);
+    const a8: u8 = if (has_alpha) a_in else 255;
+
+    switch (dst_fmt) {
+        PIXFMT_RGB24 => {
+            dest[0] = r8;
+            dest[1] = g8;
+            dest[2] = b8;
+        },
+        PIXFMT_BGR24 => {
+            dest[0] = b8;
+            dest[1] = g8;
+            dest[2] = r8;
+        },
+        PIXFMT_RGBA => {
+            dest[0] = r8;
+            dest[1] = g8;
+            dest[2] = b8;
+            dest[3] = a8;
+        },
+        PIXFMT_BGRA => {
+            dest[0] = b8;
+            dest[1] = g8;
+            dest[2] = r8;
+            dest[3] = a8;
+        },
+        else => unreachable,
+    }
+}
