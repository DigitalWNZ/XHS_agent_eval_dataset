+const std = @import("std");
+
+const PIXFMT_YUV420P = 0;
+const PIXFMT_YUV422P = 1;
+const PIXFMT_YUV444P = 2;
+const PIXFMT_NV12 = 3;
+const PIXFMT_NV21 = 4;
+const PIXFMT_RGB24 = 5;
+const PIXFMT_BGR24 = 6;
+const PIXFMT_RGBA = 7;
+const PIXFMT_BGRA = 8;
+const PIXFMT_GRAY8 = 9;
+const PIXFMT_COUNT = 10;
+
+const ALGO_NEAREST = 0;
+const ALGO_BILINEAR = 1;
+const ALGO_BICUBIC = 2;
+const ALGO_COUNT = 3;
+
+const RY: i32 = 8414;
+const GY: i32 = 16519;
+const BY: i32 = 3208;
+const RU: i32 = -4865;
+const GU: i32 = -9528;
+const BU: i32 = 14393;
+const RV: i32 = 14393;
+const GV: i32 = -12061;
+const BV: i32 = -2332;
+const RGB2YUV_SHIFT = 15;
+
+// YUV2RGB full constants (from ff_yuv2rgb_c_init_tables with SWS_CS_DEFAULT)
+const YUV2RGB_Y_COEFF: i32 = 9539;
+const YUV2RGB_Y_OFFSET: i32 = 8192;
+const YUV2RGB_V2R_COEFF: i32 = 13075;
+const YUV2RGB_V2G_COEFF: i32 = -6660;
+const YUV2RGB_U2G_COEFF: i32 = -3209;
+const YUV2RGB_U2B_COEFF: i32 = 16525;
+
+// YUV2RGB table constants
+const YUVRGB_HEADROOM: usize = 512;
+const TABLE_PLANE_SIZE: usize = 1024 + 2 * YUVRGB_HEADROOM;
+const YOFFS: usize = 326 + YUVRGB_HEADROOM;
+
+fn clipU8(v: i32) u8 {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return @intCast(v);
+}
+
+fn clipUintp2_30(v: i32) i32 {
+    if (v < 0) return 0;
+    if (v >= (1 << 30)) return (1 << 30) - 1;
+    return v;
+}
+
+fn isAnyRGB(fmt: c_int) bool {
+    return fmt == PIXFMT_RGB24 or fmt == PIXFMT_BGR24 or fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+fn isPlanarYUV(fmt: c_int) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P or fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+fn isSemiPlanarYUV(fmt: c_int) bool {
+    return fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+fn isGray(fmt: c_int) bool {
+    return fmt == PIXFMT_GRAY8;
+}
+
+fn isAlpha(fmt: c_int) bool {
+    return fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+fn getSubSample(fmt: c_int, h_sub: *u5, v_sub: *u5) void {
+    switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => {
+            h_sub.* = 1;
+            v_sub.* = 1;
+        },
+        PIXFMT_YUV422P => {
+            h_sub.* = 1;
+            v_sub.* = 0;
+        },
+        else => {
+            h_sub.* = 0;
+            v_sub.* = 0;
+        },
+    }
+}
+
+fn ceilRshift(a: i32, b: u5) i32 {
+    return -((-(a)) >> b);
+}
+
+fn avLog2(v_in: u32) u32 {
+    if (v_in == 0) return 0;
+    return 31 - @clz(v_in);
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    if (a > 0) {
+        return @divTrunc(a + (b >> 1), b);
+    } else {
+        return @divTrunc(a - (b >> 1), b);
+    }
+}
+
+const FilterData = struct {
+    filter: []i16,
+    filter_soa: []i16,
+    filter_pos: []i32,
+    filter_size: usize,
+
+    fn deinit(self: *FilterData, alloc: std.mem.Allocator) void {
+        alloc.free(self.filter);
+        alloc.free(self.filter_soa);
+        alloc.free(self.filter_pos);
+    }
+};
+
+fn initFilter(
+    alloc: std.mem.Allocator,
+    xInc: i32,
+    srcW: i32,
+    dstW: i32,
+    filterAlign: usize,
+    one: i64,
+    algo: c_int,
+    srcPos: i32,
+    dstPos: i32,
+) !FilterData {
+    const dstW_u: usize = @intCast(dstW);
+    var filter_pos = try alloc.alloc(i32, dstW_u + 3);
+    errdefer alloc.free(filter_pos);
+    @memset(filter_pos, 0);
+
+    const ratio: u32 = @intCast(@divTrunc(srcW, dstW));
+    const log2_ratio: u32 = @min(avLog2(ratio), 8);
+    const fone: i64 = @as(i64, 1) << @intCast(54 - log2_ratio);
+
+    var filterSize: usize = 1;
+    var filter: []i64 = &.{};
+
+    if (@abs(xInc - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, dstW_u * filterSize);
+        for (0..dstW_u) |i| {
+            filter[i] = fone;
+            filter_pos[i] = @intCast(i);
+        }
+    } else if (algo == ALGO_NEAREST) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, dstW_u * filterSize);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * @as(i64, xInc)) >> 8) - ((@as(i64, srcPos) * 0x8000) >> 7);
+        for (0..dstW_u) |i| {
+            const xx: i32 = @intCast((xDstInSrc - ((@as(i64, @intCast(filterSize)) - 1) << 15) + (1 << 15)) >> 16);
+            filter_pos[i] = xx;
+            filter[i] = fone;
+            xDstInSrc += xInc;
+        }
+    } else {
+        const sizeFactor: i32 = if (algo == ALGO_BICUBIC) 4 else 2;
+        if (xInc <= (1 << 16)) {
+            filterSize = @intCast(1 + sizeFactor);
+        } else {
+            filterSize = @intCast(1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW));
+        }
+        if (filterSize > @as(usize, @intCast(@max(1, srcW - 2)))) {
+            filterSize = @intCast(@max(1, srcW - 2));
+        }
+        if (filterSize < 1) filterSize = 1;
+
+        filter = try alloc.alloc(i64, dstW_u * filterSize);
+        @memset(filter, 0);
+
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * @as(i64, xInc)) >> 7) - ((@as(i64, srcPos) * 0x10000) >> 7);
+        for (0..dstW_u) |i| {
+            var xx: i32 = @intCast(@divTrunc(xDstInSrc - (@as(i64, @intCast(filterSize)) - 2) * (1 << 16), 1 << 17));
+            filter_pos[i] = xx;
+            for (0..filterSize) |j| {
+                const diff: i64 = @intCast(@abs((@as(i64, xx) * (1 << 17)) - xDstInSrc));
+                var d: i64 = diff << 13;
+                if (xInc > (1 << 16)) {
+                    d = @divTrunc(d * dstW, srcW);
+                }
+                var coeff: i64 = 0;
+                if (algo == ALGO_BICUBIC) {
+                    const B: i64 = 0;
+                    const C: i64 = @intFromFloat(0.6 * @as(f64, @floatFromInt(1 << 24)));
+                    if (d >= (1 << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (1 << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * filterSize + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * @as(i64, xInc);
+        }
+    }
+    defer alloc.free(filter);
+
+    const filter2Size = filterSize;
+    var filter2 = try alloc.alloc(i64, dstW_u * filter2Size);
+    defer alloc.free(filter2);
+    @memcpy(filter2, filter);
+
+    const cutoff_limit: i64 = @intFromFloat(0.002 * @as(f64, @floatFromInt(fone)));
+    var minFilterSize: usize = 0;
+    {
+        var i_rev: usize = dstW_u;
+        while (i_rev > 0) {
+            i_rev -= 1;
+            const i = i_rev;
+            var min: usize = filter2Size;
+            var cutOff: i64 = 0;
+            for (0..filter2Size) |_| {
+                cutOff += @intCast(@abs(filter2[i * filter2Size]));
+                if (cutOff > cutoff_limit) break;
+                if (i < dstW_u - 1 and filter_pos[i] >= filter_pos[i + 1]) break;
+                for (1..filter2Size) |k| {
+                    filter2[i * filter2Size + k - 1] = filter2[i * filter2Size + k];
+                }
+                filter2[i * filter2Size + filter2Size - 1] = 0;
+                filter_pos[i] += 1;
+            }
+            cutOff = 0;
+            var j_rev: usize = filter2Size - 1;
+            while (j_rev > 0) : (j_rev -= 1) {
+                cutOff += @intCast(@abs(filter2[i * filter2Size + j_rev]));
+                if (cutOff > cutoff_limit) break;
+                min -= 1;
+            }
+            if (min > minFilterSize) minFilterSize = min;
+        }
+    }
+    if (minFilterSize == 0) minFilterSize = 1;
+    filterSize = (minFilterSize + (filterAlign - 1)) & (~(filterAlign - 1));
+
+    var filter_reduced = try alloc.alloc(i64, dstW_u * filterSize);
+    defer alloc.free(filter_reduced);
+    for (0..dstW_u) |i| {
+        for (0..filterSize) |j| {
+            if (j >= filter2Size) {
+                filter_reduced[i * filterSize + j] = 0;
+            } else {
+                filter_reduced[i * filterSize + j] = filter2[i * filter2Size + j];
+            }
+        }
+    }
+
+    // Fix borders
+    for (0..dstW_u) |i| {
+        if (filter_pos[i] < 0) {
+            for (1..filterSize) |j| {
+                const left: usize = @intCast(@max(@as(i32, @intCast(j)) + filter_pos[i], 0));
+                filter_reduced[i * filterSize + left] += filter_reduced[i * filterSize + j];
+                filter_reduced[i * filterSize + j] = 0;
+            }
+            filter_pos[i] = 0;
+        }
+        if (filter_pos[i] + @as(i32, @intCast(filterSize)) > srcW) {
+            const shift: i32 = filter_pos[i] + @min(@as(i32, @intCast(filterSize)) - srcW, 0);
+            var acc: i64 = 0;
+            var j_rev: usize = filterSize;
+            while (j_rev > 0) {
+                j_rev -= 1;
+                if (filter_pos[i] + @as(i32, @intCast(j_rev)) >= srcW) {
+                    acc += filter_reduced[i * filterSize + j_rev];
+                    filter_reduced[i * filterSize + j_rev] = 0;
+                }
+            }
+            j_rev = filterSize;
+            while (j_rev > 0) {
+                j_rev -= 1;
+                if (@as(i32, @intCast(j_rev)) < shift) {
+                    filter_reduced[i * filterSize + j_rev] = 0;
+                } else {
+                    const src_idx: usize = @intCast(@as(i32, @intCast(j_rev)) - shift);
+                    filter_reduced[i * filterSize + j_rev] = filter_reduced[i * filterSize + src_idx];
+                }
+            }
+            filter_pos[i] -= shift;
+            const tail_idx: usize = @intCast(srcW - 1 - filter_pos[i]);
+            filter_reduced[i * filterSize + tail_idx] += acc;
+        }
+    }
+
+    var out_filter = try alloc.alloc(i16, filterSize * (dstW_u + 3));
+    errdefer alloc.free(out_filter);
+    @memset(out_filter, 0);
+
+    for (0..dstW_u) |i| {
+        var err_acc: i64 = 0;
+        var sum: i64 = 0;
+        for (0..filterSize) |j| {
+            sum += filter_reduced[i * filterSize + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        for (0..filterSize) |j| {
+            const v: i64 = filter_reduced[i * filterSize + j] + err_acc;
+            const intV: i64 = roundedDiv(v, sum);
+            out_filter[i * filterSize + j] = @intCast(intV);
+            err_acc = v - intV * sum;
+        }
+    }
+
+    const padded_w = (dstW_u + 7) & ~@as(usize, 7);
+    var filter_soa = try alloc.alloc(i16, padded_w * filterSize);
+    @memset(filter_soa, 0);
+    var blk: usize = 0;
+    while (blk < padded_w) : (blk += 8) {
+        for (0..filterSize) |j| {
+            for (0..8) |lane| {
+                if (blk + lane < dstW_u) {
+                    filter_soa[blk * filterSize + j * 8 + lane] = out_filter[(blk + lane) * filterSize + j];
+                }
+            }
+        }
+    }
+
+    return FilterData{
+        .filter = out_filter,
+        .filter_soa = filter_soa,
+        .filter_pos = filter_pos,
+        .filter_size = filterSize,
+    };
+}
+
+const Yuv2RgbTables = struct {
+    y_table: [TABLE_PLANE_SIZE]u8,
+    off_rV: [256 + 2 * YUVRGB_HEADROOM]usize,
+    off_gU: [256 + 2 * YUVRGB_HEADROOM]usize,
+    off_bU: [256 + 2 * YUVRGB_HEADROOM]usize,
+    off_gV: [256 + 2 * YUVRGB_HEADROOM]isize,
+
+    fn init() Yuv2RgbTables {
+        @setEvalBranchQuota(20000);
+        var t: Yuv2RgbTables = undefined;
+        const cy: i64 = 76309;
+        const oy: i64 = 16 << 16;
+        const crv: i64 = 89830;
+        const cbu: i64 = 113537;
+        const cgu: i64 = -22049;
+        const cgv: i64 = -45756;
+
+        var yb: i64 = -(384 << 16) - @as(i64, @intCast(YUVRGB_HEADROOM)) * cy - oy;
+        for (0..TABLE_PLANE_SIZE) |i| {
+            t.y_table[i] = clipU8(@intCast((yb + 0x8000) >> 16));
+            yb += cy;
+        }
+
+        const base_r: isize = @as(isize, @intCast(YOFFS)) - @as(isize, @intCast(crv >> 9));
+        const base_g: isize = @as(isize, @intCast(YOFFS)) - @as(isize, @intCast(cgu >> 9));
+        const base_b: isize = @as(isize, @intCast(YOFFS)) - @as(isize, @intCast(cbu >> 9));
+        const off_gv_base: isize = -@as(isize, @intCast(cgv >> 9));
+
+        for (0..(256 + 2 * YUVRGB_HEADROOM)) |i| {
+            const idx_val: i32 = @as(i32, @intCast(i)) - @as(i32, @intCast(YUVRGB_HEADROOM));
+            const c_u8: i64 = @intCast(clipU8(idx_val));
+            t.off_rV[i] = @intCast(base_r + @as(isize, @intCast((c_u8 * crv) >> 16)));
+            t.off_gU[i] = @intCast(base_g + @as(isize, @intCast((c_u8 * cgu) >> 16)));
+            t.off_bU[i] = @intCast(base_b + @as(isize, @intCast((c_u8 * cbu) >> 16)));
+            t.off_gV[i] = off_gv_base + @as(isize, @intCast((c_u8 * cgv) >> 16));
+        }
+        return t;
+    }
+};
+
+const global_yuv2rgb_tables = Yuv2RgbTables.init();
+
+const SwsContext = struct {
+    src_w: i32,
+    src_h: i32,
+    src_fmt: c_int,
+    dst_w: i32,
+    dst_h: i32,
+    dst_fmt: c_int,
+    algo: c_int,
+
+    src_range: u1,
+    dst_range: u1,
+    full_chr_h_int: bool,
+    need_alpha: bool,
+    needs_hcscale: bool,
+    src_bpc: u8,
+
+    chr_src_h_sub: u5,
+    chr_src_v_sub: u5,
+    chr_dst_h_sub: u5,
+    chr_dst_v_sub: u5,
+
+    chr_src_w: i32,
+    chr_src_h: i32,
+    chr_dst_w: i32,
+    chr_dst_h: i32,
+
+    h_lum: ?FilterData,
+    h_chr: ?FilterData,
+    v_lum: ?FilterData,
+    v_chr: ?FilterData,
+
+    // Scratch buffers for general scaling pipeline
+    conv_y_buf: []u8,
+    conv_u_buf: []u8,
+    conv_v_buf: []u8,
+    conv_a_buf: []u8,
+
+    // Ring buffers of horizontally scaled lines
+    lum_buf_lines: usize,
+    chr_buf_lines: usize,
+    lum_ring: []i16,
+    chr_u_ring: []i16,
+    chr_v_ring: []i16,
+    alp_ring: []i16,
+    lum_ring_y: []i32,
+    chr_ring_y: []i32,
+};
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w < 1 or src_h < 1 or dst_w < 1 or dst_h < 1) return null;
+    if (src_fmt < 0 or src_fmt >= PIXFMT_COUNT or dst_fmt < 0 or dst_fmt >= PIXFMT_COUNT) return null;
+    if (algo < 0 or algo >= ALGO_COUNT) return null;
+
+    const alloc = std.heap.c_allocator;
+    const ctx = alloc.create(SwsContext) catch return null;
+    errdefer alloc.destroy(ctx);
+
+    const src_range: u1 = if (src_fmt == PIXFMT_GRAY8) 1 else 0;
+    const dst_range: u1 = if (dst_fmt == PIXFMT_GRAY8) 1 else 0;
+
+    var chr_src_h_sub: u5 = 0;
+    var chr_src_v_sub: u5 = 0;
+    var chr_dst_h_sub: u5 = 0;
+    var chr_dst_v_sub: u5 = 0;
+    getSubSample(src_fmt, &chr_src_h_sub, &chr_src_v_sub);
+    getSubSample(dst_fmt, &chr_dst_h_sub, &chr_dst_v_sub);
+
+    var full_chr_h_int = false;
+    if (isAnyRGB(dst_fmt)) {
+        if ((dst_w & 1) != 0) {
+            full_chr_h_int = true;
+        }
+        if (chr_src_h_sub == 0 and chr_src_v_sub == 0) {
+            full_chr_h_int = true;
+        }
+    }
+
+    if (isAnyRGB(dst_fmt) and !full_chr_h_int) {
+        chr_dst_h_sub = 1;
+    }
+
+    if (isAnyRGB(src_fmt) and ((dst_w >> chr_dst_h_sub) <= (src_w >> 1))) {
+        chr_src_h_sub = 1;
+    }
+
+    const chr_src_w = ceilRshift(src_w, chr_src_h_sub);
+    const chr_src_h = ceilRshift(src_h, chr_src_v_sub);
+    const chr_dst_w = ceilRshift(dst_w, chr_dst_h_sub);
+    const chr_dst_h = ceilRshift(dst_h, chr_dst_v_sub);
+
+    const src_bpc: u8 = if (isAnyRGB(src_fmt)) 16 else 8;
+    const need_alpha = isAlpha(src_fmt) and isAlpha(dst_fmt);
+    const needs_hcscale = !(isGray(src_fmt) or isGray(dst_fmt));
+
+    const lum_x_inc: i32 = @intCast(@divTrunc((@as(i64, src_w) << 16) + (dst_w >> 1), dst_w));
+    const lum_y_inc: i32 = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+    const chr_x_inc: i32 = @intCast(@divTrunc((@as(i64, chr_src_w) << 16) + (chr_dst_w >> 1), chr_dst_w));
+    const chr_y_inc: i32 = @intCast(@divTrunc((@as(i64, chr_src_h) << 16) + (chr_dst_h >> 1), chr_dst_h));
+
+    var h_lum = initFilter(alloc, lum_x_inc, src_w, dst_w, 1, 1 << 14, algo, 128, 128) catch return null;
+    errdefer h_lum.deinit(alloc);
+    var h_chr = initFilter(alloc, chr_x_inc, chr_src_w, chr_dst_w, 1, 1 << 14, algo, 128, 128) catch return null;
+    errdefer h_chr.deinit(alloc);
+    var v_lum = initFilter(alloc, lum_y_inc, src_h, dst_h, 1, 1 << 12, algo, 128, 128) catch return null;
+    errdefer v_lum.deinit(alloc);
+    var v_chr = initFilter(alloc, chr_y_inc, chr_src_h, chr_dst_h, 1, 1 << 12, algo, 128, 128) catch return null;
+    errdefer v_chr.deinit(alloc);
+
+    const src_w_u: usize = @intCast(src_w);
+    const dst_w_u: usize = @intCast(dst_w);
+    const chr_dst_w_u: usize = @intCast(chr_dst_w);
+
+    const lum_buf_lines: usize = v_lum.filter_size + 4;
+    const chr_buf_lines: usize = v_chr.filter_size + 4;
+
+    const conv_y_buf = alloc.alloc(u8, src_w_u * 2 + 16) catch return null;
+    errdefer alloc.free(conv_y_buf);
+    const conv_u_buf = alloc.alloc(u8, src_w_u * 2 + 16) catch return null;
+    errdefer alloc.free(conv_u_buf);
+    const conv_v_buf = alloc.alloc(u8, src_w_u * 2 + 16) catch return null;
+    errdefer alloc.free(conv_v_buf);
+    const conv_a_buf = alloc.alloc(u8, src_w_u * 2 + 16) catch return null;
+    errdefer alloc.free(conv_a_buf);
+
+    const lum_ring = alloc.alloc(i16, lum_buf_lines * dst_w_u) catch return null;
+    errdefer alloc.free(lum_ring);
+    const chr_u_ring = alloc.alloc(i16, chr_buf_lines * chr_dst_w_u) catch return null;
+    errdefer alloc.free(chr_u_ring);
+    const chr_v_ring = alloc.alloc(i16, chr_buf_lines * chr_dst_w_u) catch return null;
+    errdefer alloc.free(chr_v_ring);
+    const alp_ring = alloc.alloc(i16, if (need_alpha) lum_buf_lines * dst_w_u else 1) catch return null;
+    errdefer alloc.free(alp_ring);
+    const lum_ring_y = alloc.alloc(i32, lum_buf_lines) catch return null;
+    errdefer alloc.free(lum_ring_y);
+    const chr_ring_y = alloc.alloc(i32, chr_buf_lines) catch return null;
+    errdefer alloc.free(chr_ring_y);
+
+    @memset(lum_ring, 1 << 14);
+    @memset(chr_u_ring, 1 << 14);
+    @memset(chr_v_ring, 1 << 14);
+    @memset(alp_ring, 1 << 14);
+
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .src_range = src_range,
+        .dst_range = dst_range,
+        .full_chr_h_int = full_chr_h_int,
+        .need_alpha = need_alpha,
+        .needs_hcscale = needs_hcscale,
+        .src_bpc = src_bpc,
+        .chr_src_h_sub = chr_src_h_sub,
+        .chr_src_v_sub = chr_src_v_sub,
+        .chr_dst_h_sub = chr_dst_h_sub,
+        .chr_dst_v_sub = chr_dst_v_sub,
+        .chr_src_w = chr_src_w,
+        .chr_src_h = chr_src_h,
+        .chr_dst_w = chr_dst_w,
+        .chr_dst_h = chr_dst_h,
+        .h_lum = h_lum,
+        .h_chr = h_chr,
+        .v_lum = v_lum,
+        .v_chr = v_chr,
+        .conv_y_buf = conv_y_buf,
+        .conv_u_buf = conv_u_buf,
+        .conv_v_buf = conv_v_buf,
+        .conv_a_buf = conv_a_buf,
+        .lum_buf_lines = lum_buf_lines,
+        .chr_buf_lines = chr_buf_lines,
+        .lum_ring = lum_ring,
+        .chr_u_ring = chr_u_ring,
+        .chr_v_ring = chr_v_ring,
+        .alp_ring = alp_ring,
+        .lum_ring_y = lum_ring_y,
+        .chr_ring_y = chr_ring_y,
+    };
+
+    return @ptrCast(ctx);
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        const alloc = std.heap.c_allocator;
+        if (ctx.h_lum) |*f| f.deinit(alloc);
+        if (ctx.h_chr) |*f| f.deinit(alloc);
+        if (ctx.v_lum) |*f| f.deinit(alloc);
+        if (ctx.v_chr) |*f| f.deinit(alloc);
+        alloc.free(ctx.conv_y_buf);
+        alloc.free(ctx.conv_u_buf);
+        alloc.free(ctx.conv_v_buf);
+        alloc.free(ctx.conv_a_buf);
+        alloc.free(ctx.lum_ring);
+        alloc.free(ctx.chr_u_ring);
+        alloc.free(ctx.chr_v_ring);
+        alloc.free(ctx.alp_ring);
+        alloc.free(ctx.lum_ring_y);
+        alloc.free(ctx.chr_ring_y);
+        alloc.destroy(ctx);
+    }
+}
+
+fn copyPlane(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, row_bytes: usize, rows: usize) void {
+    if (src_stride == dst_stride and src_stride == row_bytes) {
+        @memcpy(dst[0..(row_bytes * rows)], src[0..(row_bytes * rows)]);
+    } else {
+        for (0..rows) |y| {
+            @memcpy(dst[y * dst_stride ..][0..row_bytes], src[y * src_stride ..][0..row_bytes]);
+        }
+    }
+}
+
+inline fn writeRgbPairTable(
+    comptime dst_fmt: c_int,
+    dst: [*]u8,
+    x2: usize,
+    y1: i32,
+    y2: i32,
+    u_val: i32,
+    v_val: i32,
+    a1: u8,
+    a2: u8,
+) void {
+    const t = &global_yuv2rgb_tables;
+    const u_idx: usize = @intCast(u_val + @as(i32, @intCast(YUVRGB_HEADROOM)));
+    const v_idx: usize = @intCast(v_val + @as(i32, @intCast(YUVRGB_HEADROOM)));
+    const r_base = t.off_rV[v_idx];
+    const g_base: usize = @intCast(@as(isize, @intCast(t.off_gU[u_idx])) + t.off_gV[v_idx]);
+    const b_base = t.off_bU[u_idx];
+
+    const y1_u: usize = @intCast(y1);
+    const y2_u: usize = @intCast(y2);
+
+    const r1 = t.y_table[r_base + y1_u];
+    const g1 = t.y_table[g_base + y1_u];
+    const b1 = t.y_table[b_base + y1_u];
+
+    const r2 = t.y_table[r_base + y2_u];
+    const g2 = t.y_table[g_base + y2_u];
+    const b2 = t.y_table[b_base + y2_u];
+
+    switch (dst_fmt) {
+        PIXFMT_RGB24 => {
+            const o = x2 * 3;
+            dst[o + 0] = r1;
+            dst[o + 1] = g1;
+            dst[o + 2] = b1;
+            dst[o + 3] = r2;
+            dst[o + 4] = g2;
+            dst[o + 5] = b2;
+        },
+        PIXFMT_BGR24 => {
+            const o = x2 * 3;
+            dst[o + 0] = b1;
