+fn chrConvertRange(ctx: *SwsContext, dstU: []i16, dstV: []i16) void {
+    if (ctx.src_range == ctx.dst_range or isAnyRGB(ctx.dst_fmt)) return;
+    if (ctx.src_range != 0) {
+        for (dstU, dstV) |*u, *v| {
+            u.* = @intCast((@as(i32, u.*) * 1799 + 4081085) >> 11);
+            v.* = @intCast((@as(i32, v.*) * 1799 + 4081085) >> 11);
+        }
+    } else {
+        for (dstU, dstV) |*u, *v| {
+            const u_clamped: i32 = @min(@as(i32, u.*), 30775);
+            const v_clamped: i32 = @min(@as(i32, v.*), 30775);
+            u.* = @intCast((u_clamped * 4663 - 9289992) >> 12);
+            v.* = @intCast((v_clamped * 4663 - 9289992) >> 12);
