+                    const xC2: usize = @as(usize, @intCast(h_chr.filter_pos[i])) * 2;
+                    const spL = s_row + xL * s_step;
+                    const sp0 = s_row + xC2 * s_step;
+                    const sp1 = s_row + (xC2 + 1) * s_step;
