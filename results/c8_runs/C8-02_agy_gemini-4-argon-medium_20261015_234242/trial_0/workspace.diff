+        for (0..dstH) |dstY| {
+            const firstSrcY: i32 = @max(1 - @as(i32, @intCast(v_lum.filter_size)), v_lum.filter_pos[dstY]);
+            const lastSrcY: i32 = @min(ctx.src_h, firstSrcY + @as(i32, @intCast(v_lum.filter_size))) - 1;
