+            2 => hScaleRowComptime(16, 2, dst, dstW, src_bytes, filter, filter_soa, filter_pos),
+            3 => hScaleRowComptime(16, 3, dst, dstW, src_bytes, filter, filter_soa, filter_pos),
+            4 => hScaleRowComptime(16, 4, dst, dstW, src_bytes, filter, filter_soa, filter_pos),
