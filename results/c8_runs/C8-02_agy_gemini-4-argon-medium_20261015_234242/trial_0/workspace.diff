+fn deinterleaveRgbRow(comptime src_fmt: c_int, s_row: [*]const u8, r_out: [*]u8, g_out: [*]u8, b_out: [*]u8, a_out: [*]u8, w: usize, need_alpha: bool) void {
+    const step: usize = if (src_fmt == PIXFMT_RGB24 or src_fmt == PIXFMT_BGR24) 3 else 4;
+    const is_bgr = (src_fmt == PIXFMT_BGR24 or src_fmt == PIXFMT_BGRA);
+    var x: usize = 0;
+    while (x + 16 <= w) : (x += 16) {
+        const px = loadRgb16(src_fmt, s_row + x * step);
+        r_out[x..][0..16].* = px.r;
+        g_out[x..][0..16].* = px.g;
+        b_out[x..][0..16].* = px.b;
+        if (need_alpha) {
+            a_out[x..][0..16].* = px.a;
+        }
+    }
+    while (x < w) : (x += 1) {
+        const p = s_row + x * step;
+        r_out[x] = if (is_bgr) p[2] else p[0];
+        g_out[x] = p[1];
+        b_out[x] = if (is_bgr) p[0] else p[2];
+        if (need_alpha) {
+            a_out[x] = p[3];
+        }
+    }
+}
+
+fn tryScaledRgbToRgbSpecial(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
