+                const slot: usize = @as(usize, @intCast(sy)) % ctx.lum_buf_lines;
+                if (ctx.lum_ring_y[slot] != sy) {
+                    const s_row = ps + @as(usize, @intCast(sy)) * ss;
+                    const r_buf = ctx.conv_y_buf.ptr;
+                    const g_buf = ctx.conv_u_buf.ptr;
+                    const b_buf = ctx.conv_v_buf.ptr;
+                    const a_buf = ctx.conv_a_buf.ptr;
+                    switch (s_fmt) {
+                        PIXFMT_RGB24 => deinterleaveRgbRow(PIXFMT_RGB24, s_row, r_buf, g_buf, b_buf, a_buf, srcW, false),
+                        PIXFMT_BGR24 => deinterleaveRgbRow(PIXFMT_BGR24, s_row, r_buf, g_buf, b_buf, a_buf, srcW, false),
+                        PIXFMT_RGBA => deinterleaveRgbRow(PIXFMT_RGBA, s_row, r_buf, g_buf, b_buf, a_buf, srcW, ctx.need_alpha),
+                        PIXFMT_BGRA => deinterleaveRgbRow(PIXFMT_BGRA, s_row, r_buf, g_buf, b_buf, a_buf, srcW, ctx.need_alpha),
+                        else => unreachable,
+                    }
