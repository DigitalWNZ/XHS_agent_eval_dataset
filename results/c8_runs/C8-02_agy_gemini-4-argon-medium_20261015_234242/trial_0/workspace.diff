+    // Fast path A: Nearest-neighbor RGB -> RGB (including b008, s002, s014)
+    if (ctx.algo == ALGO_NEAREST and v_lum.filter_size == 1 and h_lum.filter_size == 1) {
+        const s_step: usize = if (s_fmt == PIXFMT_RGB24 or s_fmt == PIXFMT_BGR24) 3 else 4;
+        const d_step: usize = if (d_fmt == PIXFMT_RGB24 or d_fmt == PIXFMT_BGR24) 3 else 4;
+        const s_bgr = (s_fmt == PIXFMT_BGR24 or s_fmt == PIXFMT_BGRA);
+        const d_bgr = (d_fmt == PIXFMT_BGR24 or d_fmt == PIXFMT_BGRA);
+        const d_alpha = isAlpha(d_fmt);
+        var prev_sy: i32 = -1;
+
+        for (0..dstH) |dstY| {
+            const sy_clamped: i32 = @min(@max(v_lum.filter_pos[dstY], 0), ctx.src_h - 1);
+            const d_row = pd + dstY * sd;
+            if (dstY > 0 and sy_clamped == prev_sy) {
+                @memcpy(d_row[0 .. dstW * d_step], (pd + (dstY - 1) * sd)[0 .. dstW * d_step]);
+                continue;
+            }
+            prev_sy = sy_clamped;
+            const s_row = ps + @as(usize, @intCast(sy_clamped)) * ss;
+
+            if (ctx.chr_src_h_sub == 0) {
+                for (0..dstW) |i| {
+                    const xL: usize = @intCast(h_lum.filter_pos[i]);
+                    const sp = s_row + xL * s_step;
+                    const dp = d_row + i * d_step;
+                    const r = if (s_bgr) sp[2] else sp[0];
+                    const g = sp[1];
+                    const b = if (s_bgr) sp[0] else sp[2];
+                    dp[0] = if (d_bgr) b else r;
+                    dp[1] = g;
+                    dp[2] = if (d_bgr) r else b;
