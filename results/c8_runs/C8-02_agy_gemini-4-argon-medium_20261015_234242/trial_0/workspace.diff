+    } else {
+        // lumRangeToJpeg_c
+        for (dst) |*v| {
+            const val: i32 = @min(@as(i32, v.*), 30189);
+            v.* = @intCast((val * 19077 - 39057361) >> 14);
+        }
+    }
+}
