+    const sh15: @Vector(8, u5) = @splat(15);
+
+    var x: usize = 0;
+    while (x + 16 <= w) : (x += 16) {
+        const px = loadRgb16(src_fmt, s_row + x * step);
+        const r_lo: @Vector(8, i32) = @intCast(@shuffle(u8, px.r, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 }));
+        const r_hi: @Vector(8, i32) = @intCast(@shuffle(u8, px.r, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 }));
+        const g_lo: @Vector(8, i32) = @intCast(@shuffle(u8, px.g, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 }));
+        const g_hi: @Vector(8, i32) = @intCast(@shuffle(u8, px.g, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 }));
+        const b_lo: @Vector(8, i32) = @intCast(@shuffle(u8, px.b, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 }));
+        const b_hi: @Vector(8, i32) = @intCast(@shuffle(u8, px.b, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 }));
+
+        const y_lo: @Vector(8, u8) = @intCast((r_lo * ry_v + g_lo * gy_v + b_lo * by_v + y_bias) >> sh15);
+        const y_hi: @Vector(8, u8) = @intCast((r_hi * ry_v + g_hi * gy_v + b_hi * by_v + y_bias) >> sh15);
+        y_dst[x..][0..16].* = @shuffle(u8, y_lo, y_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+
+        const even_mask = [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 };
+        const odd_mask = [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 };
+        const r_ev: @Vector(8, i16) = @intCast(@shuffle(u8, px.r, undefined, even_mask));
+        const r_od: @Vector(8, i16) = @intCast(@shuffle(u8, px.r, undefined, odd_mask));
+        const g_ev: @Vector(8, i16) = @intCast(@shuffle(u8, px.g, undefined, even_mask));
+        const g_od: @Vector(8, i16) = @intCast(@shuffle(u8, px.g, undefined, odd_mask));
+        const b_ev: @Vector(8, i16) = @intCast(@shuffle(u8, px.b, undefined, even_mask));
+        const b_od: @Vector(8, i16) = @intCast(@shuffle(u8, px.b, undefined, odd_mask));
+
+        const cx = x >> 1;
+        r2_dst[cx..][0..8].* = r_ev + r_od;
+        g2_dst[cx..][0..8].* = g_ev + g_od;
+        b2_dst[cx..][0..8].* = b_ev + b_od;
+    }
+    while (x < w) : (x += 2) {
+        const p0 = s_row + x * step;
+        const p1 = s_row + (x + 1) * step;
+        const r0: i32 = if (is_bgr) p0[2] else p0[0];
+        const g0: i32 = p0[1];
+        const b0: i32 = if (is_bgr) p0[0] else p0[2];
+        const r1: i32 = if (is_bgr) p1[2] else p1[0];
+        const g1: i32 = p1[1];
+        const b1: i32 = if (is_bgr) p1[0] else p1[2];
+
+        y_dst[x + 0] = @intCast((RY * r0 + GY * g0 + BY * b0 + 540928) >> 15);
+        y_dst[x + 1] = @intCast((RY * r1 + GY * g1 + BY * b1 + 540928) >> 15);
+        const cx = x >> 1;
+        r2_dst[cx] = @intCast(r0 + r1);
+        g2_dst[cx] = @intCast(g0 + g1);
+        b2_dst[cx] = @intCast(b0 + b1);
+    }
+}
+
+fn unscaledRgbToYuv420Bilinear(
+    comptime src_fmt: c_int,
+    comptime dst_fmt: c_int,
+    ctx: *SwsContext,
+    w: usize,
+    h: usize,
+    ps: [*]const u8,
+    ss: usize,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) void {
+    const cw = w >> 1;
+    const ch = h >> 1;
+    const py = dst_data[0].?;
+    const sy: usize = @intCast(dst_stride[0]);
+
+    const r2_ring = ctx.lum_ring.ptr;
+    const g2_ring = ctx.chr_u_ring.ptr;
+    const b2_ring = ctx.chr_v_ring.ptr;
+
+    var next_row: usize = 0;
+    const ru_v: @Vector(8, i32) = @splat(RU);
+    const gu_v: @Vector(8, i32) = @splat(GU);
+    const bu_v: @Vector(8, i32) = @splat(BU);
+    const rv_v: @Vector(8, i32) = @splat(RV);
+    const gv_v: @Vector(8, i32) = @splat(GV);
+    const bv_v: @Vector(8, i32) = @splat(BV);
+    const uv_bias: @Vector(8, i32) = @splat((2048 << 15) + (1 << 18));
+    const sh19: @Vector(8, u5) = @splat(19);
+    const three16: @Vector(8, i16) = @splat(3);
+
+    for (0..ch) |cy| {
+        const max_needed = @min(h - 1, 2 * cy + 2);
+        while (next_row <= max_needed) : (next_row += 1) {
+            const slot = next_row & 3;
+            computeLumaAndHorizPairsRow(
+                src_fmt,
+                ps + next_row * ss,
+                py + next_row * sy,
+                r2_ring + slot * cw,
+                g2_ring + slot * cw,
+                b2_ring + slot * cw,
+                w,
+            );
+        }
+
+        const y0: usize = if (cy == 0) 0 else 2 * cy - 1;
+        const y1: usize = 2 * cy;
+        const y2: usize = 2 * cy + 1;
+        const y3: usize = @min(h - 1, 2 * cy + 2);
+
+        const s0 = y0 & 3;
+        const s1 = y1 & 3;
+        const s2 = y2 & 3;
+        const s3 = y3 & 3;
+
+        const r_p0 = r2_ring + s0 * cw;
+        const r_p1 = r2_ring + s1 * cw;
+        const r_p2 = r2_ring + s2 * cw;
+        const r_p3 = r2_ring + s3 * cw;
+
+        const g_p0 = g2_ring + s0 * cw;
+        const g_p1 = g2_ring + s1 * cw;
+        const g_p2 = g2_ring + s2 * cw;
+        const g_p3 = g2_ring + s3 * cw;
+
+        const b_p0 = b2_ring + s0 * cw;
+        const b_p1 = b2_ring + s1 * cw;
+        const b_p2 = b2_ring + s2 * cw;
+        const b_p3 = b2_ring + s3 * cw;
+
+        if (dst_fmt == PIXFMT_YUV420P) {
+            const u_row = dst_data[1].? + cy * @as(usize, @intCast(dst_stride[1]));
+            const v_row = dst_data[2].? + cy * @as(usize, @intCast(dst_stride[2]));
+            var i: usize = 0;
+            while (i + 8 <= cw) : (i += 8) {
+                const R16 = @as(@Vector(8, i16), r_p0[i..][0..8].*) + (@as(@Vector(8, i16), r_p1[i..][0..8].*) + @as(@Vector(8, i16), r_p2[i..][0..8].*)) * three16 + @as(@Vector(8, i16), r_p3[i..][0..8].*);
+                const G16 = @as(@Vector(8, i16), g_p0[i..][0..8].*) + (@as(@Vector(8, i16), g_p1[i..][0..8].*) + @as(@Vector(8, i16), g_p2[i..][0..8].*)) * three16 + @as(@Vector(8, i16), g_p3[i..][0..8].*);
+                const B16 = @as(@Vector(8, i16), b_p0[i..][0..8].*) + (@as(@Vector(8, i16), b_p1[i..][0..8].*) + @as(@Vector(8, i16), b_p2[i..][0..8].*)) * three16 + @as(@Vector(8, i16), b_p3[i..][0..8].*);
+                const R: @Vector(8, i32) = @intCast(R16);
+                const G: @Vector(8, i32) = @intCast(G16);
+                const B: @Vector(8, i32) = @intCast(B16);
+                u_row[i..][0..8].* = clampU8Vec8((R * ru_v + G * gu_v + B * bu_v + uv_bias) >> sh19);
+                v_row[i..][0..8].* = clampU8Vec8((R * rv_v + G * gv_v + B * bv_v + uv_bias) >> sh19);
+            }
+            while (i < cw) : (i += 1) {
+                const R: i32 = @as(i32, r_p0[i]) + 3 * (@as(i32, r_p1[i]) + @as(i32, r_p2[i])) + @as(i32, r_p3[i]);
+                const G: i32 = @as(i32, g_p0[i]) + 3 * (@as(i32, g_p1[i]) + @as(i32, g_p2[i])) + @as(i32, g_p3[i]);
+                const B: i32 = @as(i32, b_p0[i]) + 3 * (@as(i32, b_p1[i]) + @as(i32, b_p2[i])) + @as(i32, b_p3[i]);
+                u_row[i] = clipU8((RU * R + GU * G + BU * B + (2048 << 15) + (1 << 18)) >> 19);
+                v_row[i] = clipU8((RV * R + GV * G + BV * B + (2048 << 15) + (1 << 18)) >> 19);
+            }
+        } else {
+            const uv_row = dst_data[1].? + cy * @as(usize, @intCast(dst_stride[1]));
+            var i: usize = 0;
+            while (i + 8 <= cw) : (i += 8) {
+                const R16 = @as(@Vector(8, i16), r_p0[i..][0..8].*) + (@as(@Vector(8, i16), r_p1[i..][0..8].*) + @as(@Vector(8, i16), r_p2[i..][0..8].*)) * three16 + @as(@Vector(8, i16), r_p3[i..][0..8].*);
+                const G16 = @as(@Vector(8, i16), g_p0[i..][0..8].*) + (@as(@Vector(8, i16), g_p1[i..][0..8].*) + @as(@Vector(8, i16), g_p2[i..][0..8].*)) * three16 + @as(@Vector(8, i16), g_p3[i..][0..8].*);
+                const B16 = @as(@Vector(8, i16), b_p0[i..][0..8].*) + (@as(@Vector(8, i16), b_p1[i..][0..8].*) + @as(@Vector(8, i16), b_p2[i..][0..8].*)) * three16 + @as(@Vector(8, i16), b_p3[i..][0..8].*);
+                const R: @Vector(8, i32) = @intCast(R16);
+                const G: @Vector(8, i32) = @intCast(G16);
+                const B: @Vector(8, i32) = @intCast(B16);
+                const u8_v = clampU8Vec8((R * ru_v + G * gu_v + B * bu_v + uv_bias) >> sh19);
+                const v8_v = clampU8Vec8((R * rv_v + G * gv_v + B * bv_v + uv_bias) >> sh19);
+                const interleave_mask = [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) };
+                if (dst_fmt == PIXFMT_NV12) {
+                    uv_row[2 * i ..][0..16].* = @shuffle(u8, u8_v, v8_v, interleave_mask);
+                } else {
+                    uv_row[2 * i ..][0..16].* = @shuffle(u8, v8_v, u8_v, interleave_mask);
+                }
+            }
+            while (i < cw) : (i += 1) {
+                const R: i32 = @as(i32, r_p0[i]) + 3 * (@as(i32, r_p1[i]) + @as(i32, r_p2[i])) + @as(i32, r_p3[i]);
+                const G: i32 = @as(i32, g_p0[i]) + 3 * (@as(i32, g_p1[i]) + @as(i32, g_p2[i])) + @as(i32, g_p3[i]);
+                const B: i32 = @as(i32, b_p0[i]) + 3 * (@as(i32, b_p1[i]) + @as(i32, b_p2[i])) + @as(i32, b_p3[i]);
+                const u_val = clipU8((RU * R + GU * G + BU * B + (2048 << 15) + (1 << 18)) >> 19);
+                const v_val = clipU8((RV * R + GV * G + BV * B + (2048 << 15) + (1 << 18)) >> 19);
+                if (dst_fmt == PIXFMT_NV12) {
+                    uv_row[2 * i + 0] = u_val;
+                    uv_row[2 * i + 1] = v_val;
+                } else {
+                    uv_row[2 * i + 0] = v_val;
+                    uv_row[2 * i + 1] = u_val;
+                }
+            }
+        }
+    }
+}
+
+fn tryUnscaledSpecial(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) bool {
+    if (ctx.src_w != ctx.dst_w or ctx.src_h != ctx.dst_h) return false;
+    if (ctx.src_range != ctx.dst_range and !isAnyRGB(ctx.dst_fmt)) return false;
+
+    const w: usize = @intCast(ctx.src_w);
+    const h: usize = @intCast(ctx.src_h);
+    const s_fmt = ctx.src_fmt;
+    const d_fmt = ctx.dst_fmt;
+
+    // 1. Same format copy
+    if (s_fmt == d_fmt) {
+        const s0 = src_data[0] orelse return false;
+        const d0 = dst_data[0] orelse return false;
+        const ss0: usize = @intCast(src_stride[0]);
+        const ds0: usize = @intCast(dst_stride[0]);
+        if (s_fmt == PIXFMT_YUV420P or s_fmt == PIXFMT_YUV422P or s_fmt == PIXFMT_YUV444P) {
+            const cw: usize = @intCast(ctx.chr_src_w);
+            const ch: usize = @intCast(ctx.chr_src_h);
+            copyPlane(s0, ss0, d0, ds0, w, h);
+            copyPlane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), cw, ch);
+            copyPlane(src_data[2].?, @intCast(src_stride[2]), dst_data[2].?, @intCast(dst_stride[2]), cw, ch);
+            return true;
+        } else if (s_fmt == PIXFMT_NV12 or s_fmt == PIXFMT_NV21) {
+            const cw2: usize = @as(usize, @intCast(ctx.chr_src_w)) * 2;
+            const ch: usize = @intCast(ctx.chr_src_h);
+            copyPlane(s0, ss0, d0, ds0, w, h);
+            copyPlane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), cw2, ch);
+            return true;
+        } else {
+            const bpp: usize = switch (s_fmt) {
+                PIXFMT_RGB24, PIXFMT_BGR24 => 3,
+                PIXFMT_RGBA, PIXFMT_BGRA => 4,
+                else => 1,
+            };
+            copyPlane(s0, ss0, d0, ds0, w * bpp, h);
+            return true;
+        }
+    }
+
+    // 2. YUV420P -> NV12 / NV21
+    if (s_fmt == PIXFMT_YUV420P and (d_fmt == PIXFMT_NV12 or d_fmt == PIXFMT_NV21)) {
+        copyPlane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+        const cw: usize = w >> 1;
+        const ch: usize = h >> 1;
+        const pu = if (d_fmt == PIXFMT_NV12) src_data[1].? else src_data[2].?;
+        const pv = if (d_fmt == PIXFMT_NV12) src_data[2].? else src_data[1].?;
+        const su: usize = @intCast(if (d_fmt == PIXFMT_NV12) src_stride[1] else src_stride[2]);
+        const sv: usize = @intCast(if (d_fmt == PIXFMT_NV12) src_stride[2] else src_stride[1]);
+        const pd = dst_data[1].?;
+        const sd: usize = @intCast(dst_stride[1]);
+        for (0..ch) |y| {
+            const u_row = pu + y * su;
+            const v_row = pv + y * sv;
+            const d_row = pd + y * sd;
+            var x: usize = 0;
+            while (x + 16 <= cw) : (x += 16) {
+                const u_v: @Vector(16, u8) = u_row[x..][0..16].*;
+                const v_v: @Vector(16, u8) = v_row[x..][0..16].*;
+                d_row[2 * x ..][0..16].* = @shuffle(u8, u_v, v_v, [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) });
+                d_row[2 * x + 16 ..][0..16].* = @shuffle(u8, u_v, v_v, [16]i32{ 8, ~@as(i32, 8), 9, ~@as(i32, 9), 10, ~@as(i32, 10), 11, ~@as(i32, 11), 12, ~@as(i32, 12), 13, ~@as(i32, 13), 14, ~@as(i32, 14), 15, ~@as(i32, 15) });
+            }
+            while (x < cw) : (x += 1) {
+                d_row[2 * x + 0] = u_row[x];
+                d_row[2 * x + 1] = v_row[x];
+            }
+        }
+        return true;
+    }
+
+    // 3. NV12 / NV21 -> YUV420P
+    if ((s_fmt == PIXFMT_NV12 or s_fmt == PIXFMT_NV21) and d_fmt == PIXFMT_YUV420P) {
+        copyPlane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+        const cw: usize = w >> 1;
+        const ch: usize = h >> 1;
+        const ps = src_data[1].?;
+        const ss: usize = @intCast(src_stride[1]);
+        const pu = if (s_fmt == PIXFMT_NV12) dst_data[1].? else dst_data[2].?;
+        const pv = if (s_fmt == PIXFMT_NV12) dst_data[2].? else dst_data[1].?;
+        const su: usize = @intCast(if (s_fmt == PIXFMT_NV12) dst_stride[1] else dst_stride[2]);
+        const sv: usize = @intCast(if (s_fmt == PIXFMT_NV12) dst_stride[2] else dst_stride[1]);
+        for (0..ch) |y| {
+            const s_row = ps + y * ss;
+            const u_row = pu + y * su;
+            const v_row = pv + y * sv;
+            var x: usize = 0;
+            while (x + 16 <= cw) : (x += 16) {
+                const s_lo: @Vector(16, u8) = s_row[2 * x ..][0..16].*;
+                const s_hi: @Vector(16, u8) = s_row[2 * x + 16 ..][0..16].*;
+                u_row[x..][0..16].* = @shuffle(u8, s_lo, s_hi, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) });
+                v_row[x..][0..16].* = @shuffle(u8, s_lo, s_hi, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) });
+            }
+            while (x < cw) : (x += 1) {
+                u_row[x] = s_row[2 * x + 0];
+                v_row[x] = s_row[2 * x + 1];
+            }
+        }
+        return true;
+    }
+
+    // 4. YUV420P -> RGB24/BGR24/RGBA/BGRA (when h is even)
+    if (s_fmt == PIXFMT_YUV420P and isAnyRGB(d_fmt) and (h & 1) == 0) {
+        const py = src_data[0].?;
+        const pu = src_data[1].?;
+        const pv = src_data[2].?;
+        const sy: usize = @intCast(src_stride[0]);
+        const su: usize = @intCast(src_stride[1]);
+        const sv: usize = @intCast(src_stride[2]);
+        const pd = dst_data[0].?;
+        const sd: usize = @intCast(dst_stride[0]);
+        switch (d_fmt) {
+            PIXFMT_RGB24 => unscaledYuv420pToRgb(PIXFMT_RGB24, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            PIXFMT_BGR24 => unscaledYuv420pToRgb(PIXFMT_BGR24, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            PIXFMT_RGBA => unscaledYuv420pToRgb(PIXFMT_RGBA, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            PIXFMT_BGRA => unscaledYuv420pToRgb(PIXFMT_BGRA, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            else => unreachable,
+        }
+        return true;
+    }
+
+    // 5. YUV422P -> RGB24/BGR24/RGBA/BGRA (when h is even)
+    if (s_fmt == PIXFMT_YUV422P and isAnyRGB(d_fmt) and (h & 1) == 0) {
+        const py = src_data[0].?;
+        const pu = src_data[1].?;
+        const pv = src_data[2].?;
+        const sy: usize = @intCast(src_stride[0]);
+        const su: usize = @intCast(src_stride[1]);
+        const sv: usize = @intCast(src_stride[2]);
+        const pd = dst_data[0].?;
+        const sd: usize = @intCast(dst_stride[0]);
+        switch (d_fmt) {
+            PIXFMT_RGB24 => unscaledYuv422pToRgb(PIXFMT_RGB24, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            PIXFMT_BGR24 => unscaledYuv422pToRgb(PIXFMT_BGR24, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            PIXFMT_RGBA => unscaledYuv422pToRgb(PIXFMT_RGBA, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            PIXFMT_BGRA => unscaledYuv422pToRgb(PIXFMT_BGRA, w, h, py, sy, pu, su, pv, sv, pd, sd),
+            else => unreachable,
+        }
+        return true;
+    }
+
+    // 6. BGR24 -> YUV420P (bgr24ToYv12Wrapper when w is even)
+    if (s_fmt == PIXFMT_BGR24 and d_fmt == PIXFMT_YUV420P and (w & 1) == 0) {
+        const ps = src_data[0].?;
+        const ss: usize = @intCast(src_stride[0]);
+        const py = dst_data[0].?;
+        const pu = dst_data[1].?;
+        const pv = dst_data[2].?;
+        const sy: usize = @intCast(dst_stride[0]);
+        const su: usize = @intCast(dst_stride[1]);
+        const sv: usize = @intCast(dst_stride[2]);
+        const cw = w >> 1;
+        var y: usize = 0;
+        while (y < h) : (y += 2) {
+            const s1 = ps + y * ss;
+            const s2 = ps + (y + 1) * ss;
+            const y1 = py + y * sy;
+            const y2 = py + (y + 1) * sy;
+            const ud = pu + (y >> 1) * su;
+            const vd = pv + (y >> 1) * sv;
+            for (0..cw) |i| {
+                const b11: i32 = s1[6 * i + 0];
+                const g11: i32 = s1[6 * i + 1];
+                const r11: i32 = s1[6 * i + 2];
+                const b12: i32 = s1[6 * i + 3];
+                const g12: i32 = s1[6 * i + 4];
+                const r12: i32 = s1[6 * i + 5];
+                const b21: i32 = s2[6 * i + 0];
+                const g21: i32 = s2[6 * i + 1];
+                const r21: i32 = s2[6 * i + 2];
+                const b22: i32 = s2[6 * i + 3];
+                const g22: i32 = s2[6 * i + 4];
+                const r22: i32 = s2[6 * i + 5];
+
+                y1[2 * i + 0] = @intCast(((RY * r11 + GY * g11 + BY * b11) >> RGB2YUV_SHIFT) + 16);
+                y1[2 * i + 1] = @intCast(((RY * r12 + GY * g12 + BY * b12) >> RGB2YUV_SHIFT) + 16);
+                y2[2 * i + 0] = @intCast(((RY * r21 + GY * g21 + BY * b21) >> RGB2YUV_SHIFT) + 16);
+                y2[2 * i + 1] = @intCast(((RY * r22 + GY * g22 + BY * b22) >> RGB2YUV_SHIFT) + 16);
+
+                const bx = (b11 + b12 + b21 + b22) >> 2;
+                const gx = (g11 + g12 + g21 + g22) >> 2;
+                const rx = (r11 + r12 + r21 + r22) >> 2;
+
+                ud[i] = @intCast(((RU * rx + GU * gx + BU * bx) >> RGB2YUV_SHIFT) + 128);
+                vd[i] = @intCast(((RV * rx + GV * gx + BV * bx) >> RGB2YUV_SHIFT) + 128);
+            }
+        }
+        return true;
+    }
+
+    // 6b. Fused SIMD RGB24/BGR24/RGBA/BGRA -> YUV420P/NV12/NV21 (for bilinear, even w & h)
+    if (isAnyRGB(s_fmt) and (d_fmt == PIXFMT_YUV420P or d_fmt == PIXFMT_NV12 or d_fmt == PIXFMT_NV21) and
+        ctx.algo == ALGO_BILINEAR and (w & 1) == 0 and (h & 1) == 0 and h >= 4)
+    {
+        const ps = src_data[0].?;
+        const ss: usize = @intCast(src_stride[0]);
+        switch (s_fmt) {
+            PIXFMT_RGB24 => switch (d_fmt) {
+                PIXFMT_YUV420P => unscaledRgbToYuv420Bilinear(PIXFMT_RGB24, PIXFMT_YUV420P, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV12 => unscaledRgbToYuv420Bilinear(PIXFMT_RGB24, PIXFMT_NV12, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV21 => unscaledRgbToYuv420Bilinear(PIXFMT_RGB24, PIXFMT_NV21, ctx, w, h, ps, ss, dst_data, dst_stride),
+                else => unreachable,
+            },
+            PIXFMT_BGR24 => switch (d_fmt) {
+                PIXFMT_NV12 => unscaledRgbToYuv420Bilinear(PIXFMT_BGR24, PIXFMT_NV12, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV21 => unscaledRgbToYuv420Bilinear(PIXFMT_BGR24, PIXFMT_NV21, ctx, w, h, ps, ss, dst_data, dst_stride),
+                else => unreachable,
+            },
+            PIXFMT_RGBA => switch (d_fmt) {
+                PIXFMT_YUV420P => unscaledRgbToYuv420Bilinear(PIXFMT_RGBA, PIXFMT_YUV420P, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV12 => unscaledRgbToYuv420Bilinear(PIXFMT_RGBA, PIXFMT_NV12, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV21 => unscaledRgbToYuv420Bilinear(PIXFMT_RGBA, PIXFMT_NV21, ctx, w, h, ps, ss, dst_data, dst_stride),
+                else => unreachable,
+            },
+            PIXFMT_BGRA => switch (d_fmt) {
+                PIXFMT_YUV420P => unscaledRgbToYuv420Bilinear(PIXFMT_BGRA, PIXFMT_YUV420P, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV12 => unscaledRgbToYuv420Bilinear(PIXFMT_BGRA, PIXFMT_NV12, ctx, w, h, ps, ss, dst_data, dst_stride),
+                PIXFMT_NV21 => unscaledRgbToYuv420Bilinear(PIXFMT_BGRA, PIXFMT_NV21, ctx, w, h, ps, ss, dst_data, dst_stride),
+                else => unreachable,
+            },
+            else => unreachable,
+        }
+        return true;
+    }
+
+    // 7. RGB/BGR/RGBA/BGRA <-> RGB/BGR/RGBA/BGRA
+    if (isAnyRGB(s_fmt) and isAnyRGB(d_fmt)) {
+        const ps = src_data[0].?;
+        const ss: usize = @intCast(src_stride[0]);
+        const pd = dst_data[0].?;
+        const sd: usize = @intCast(dst_stride[0]);
+        switch (s_fmt) {
+            PIXFMT_RGB24 => switch (d_fmt) {
+                PIXFMT_BGR24 => unscaledRgbToRgb(PIXFMT_RGB24, PIXFMT_BGR24, w, h, ps, ss, pd, sd),
+                PIXFMT_RGBA => unscaledRgbToRgb(PIXFMT_RGB24, PIXFMT_RGBA, w, h, ps, ss, pd, sd),
+                PIXFMT_BGRA => unscaledRgbToRgb(PIXFMT_RGB24, PIXFMT_BGRA, w, h, ps, ss, pd, sd),
+                else => unreachable,
+            },
+            PIXFMT_BGR24 => switch (d_fmt) {
+                PIXFMT_RGB24 => unscaledRgbToRgb(PIXFMT_BGR24, PIXFMT_RGB24, w, h, ps, ss, pd, sd),
+                PIXFMT_RGBA => unscaledRgbToRgb(PIXFMT_BGR24, PIXFMT_RGBA, w, h, ps, ss, pd, sd),
+                PIXFMT_BGRA => unscaledRgbToRgb(PIXFMT_BGR24, PIXFMT_BGRA, w, h, ps, ss, pd, sd),
+                else => unreachable,
+            },
+            PIXFMT_RGBA => switch (d_fmt) {
+                PIXFMT_RGB24 => unscaledRgbToRgb(PIXFMT_RGBA, PIXFMT_RGB24, w, h, ps, ss, pd, sd),
+                PIXFMT_BGR24 => unscaledRgbToRgb(PIXFMT_RGBA, PIXFMT_BGR24, w, h, ps, ss, pd, sd),
+                PIXFMT_BGRA => unscaledRgbToRgb(PIXFMT_RGBA, PIXFMT_BGRA, w, h, ps, ss, pd, sd),
+                else => unreachable,
+            },
+            PIXFMT_BGRA => switch (d_fmt) {
+                PIXFMT_RGB24 => unscaledRgbToRgb(PIXFMT_BGRA, PIXFMT_RGB24, w, h, ps, ss, pd, sd),
+                PIXFMT_BGR24 => unscaledRgbToRgb(PIXFMT_BGRA, PIXFMT_BGR24, w, h, ps, ss, pd, sd),
+                PIXFMT_RGBA => unscaledRgbToRgb(PIXFMT_BGRA, PIXFMT_RGBA, w, h, ps, ss, pd, sd),
+                else => unreachable,
+            },
+            else => unreachable,
+        }
+        return true;
+    }
+
+    // 8. GRAY8 -> RGB24/BGR24/RGBA/BGRA (palToRgbWrapper)
+    if (s_fmt == PIXFMT_GRAY8 and isAnyRGB(d_fmt)) {
+        const ps = src_data[0].?;
+        const ss: usize = @intCast(src_stride[0]);
+        const pd = dst_data[0].?;
+        const sd: usize = @intCast(dst_stride[0]);
+        const d_step: usize = if (d_fmt == PIXFMT_RGB24 or d_fmt == PIXFMT_BGR24) 3 else 4;
+        const ff16: @Vector(16, u8) = @splat(255);
+        for (0..h) |y| {
+            const s_row = ps + y * ss;
+            const d_row = pd + y * sd;
+            var x: usize = 0;
+            while (x + 16 <= w) : (x += 16) {
+                const v16: @Vector(16, u8) = s_row[x..][0..16].*;
+                if (d_step == 3) {
+                    storeRgb16(PIXFMT_RGB24, d_row + x * 3, v16, v16, v16, ff16);
+                } else {
+                    storeRgb16(PIXFMT_RGBA, d_row + x * 4, v16, v16, v16, ff16);
+                }
+            }
+            while (x < w) : (x += 1) {
+                const v = s_row[x];
+                if (d_step == 3) {
+                    d_row[3 * x + 0] = v;
+                    d_row[3 * x + 1] = v;
+                    d_row[3 * x + 2] = v;
+                } else {
+                    d_row[4 * x + 0] = v;
+                    d_row[4 * x + 1] = v;
+                    d_row[4 * x + 2] = v;
+                    d_row[4 * x + 3] = 255;
+                }
+            }
+        }
+        return true;
+    }
+
+    return false;
+}
+
+fn convertLumRowComptime(comptime src_fmt: c_int, s0: [*]const u8, dst16: [*]i16, w: usize) void {
+    const step: usize = if (src_fmt == PIXFMT_RGB24 or src_fmt == PIXFMT_BGR24) 3 else 4;
+    const is_bgr = (src_fmt == PIXFMT_BGR24 or src_fmt == PIXFMT_BGRA);
+    const ry_v: @Vector(8, i32) = @splat(RY);
+    const gy_v: @Vector(8, i32) = @splat(GY);
+    const by_v: @Vector(8, i32) = @splat(BY);
+    const y_bias: @Vector(8, i32) = @splat((32 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7)));
+    const sh9: @Vector(8, u5) = @splat(RGB2YUV_SHIFT - 6);
+
+    var i: usize = 0;
+    while (i + 16 <= w) : (i += 16) {
+        const px = loadRgb16(src_fmt, s0 + i * step);
+        const r_lo: @Vector(8, i32) = @intCast(@shuffle(u8, px.r, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 }));
+        const r_hi: @Vector(8, i32) = @intCast(@shuffle(u8, px.r, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 }));
+        const g_lo: @Vector(8, i32) = @intCast(@shuffle(u8, px.g, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 }));
+        const g_hi: @Vector(8, i32) = @intCast(@shuffle(u8, px.g, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 }));
+        const b_lo: @Vector(8, i32) = @intCast(@shuffle(u8, px.b, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 }));
+        const b_hi: @Vector(8, i32) = @intCast(@shuffle(u8, px.b, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 }));
+
+        const y_lo: @Vector(8, i16) = @intCast((r_lo * ry_v + g_lo * gy_v + b_lo * by_v + y_bias) >> sh9);
+        const y_hi: @Vector(8, i16) = @intCast((r_hi * ry_v + g_hi * gy_v + b_hi * by_v + y_bias) >> sh9);
+        dst16[i..][0..8].* = y_lo;
+        dst16[i + 8 ..][0..8].* = y_hi;
+    }
+    while (i < w) : (i += 1) {
+        const p = s0 + i * step;
+        const r: i32 = if (is_bgr) p[2] else p[0];
+        const g: i32 = p[1];
+        const b: i32 = if (is_bgr) p[0] else p[2];
+        const y_val = (RY * r + GY * g + BY * b + (32 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6);
+        dst16[i] = @intCast(y_val);
+    }
+}
+
+fn convertLumRow(ctx: *SwsContext, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int, src_y: usize) [*]const u8 {
+    const w: usize = @intCast(ctx.src_w);
+    const s_fmt = ctx.src_fmt;
+    const s0 = src_data[0].? + src_y * @as(usize, @intCast(src_stride[0]));
+
+    if (!isAnyRGB(s_fmt)) {
+        return s0;
+    }
+
+    const dst16: [*]i16 = @ptrCast(@alignCast(ctx.conv_y_buf.ptr));
+    switch (s_fmt) {
+        PIXFMT_RGB24 => convertLumRowComptime(PIXFMT_RGB24, s0, dst16, w),
+        PIXFMT_BGR24 => convertLumRowComptime(PIXFMT_BGR24, s0, dst16, w),
+        PIXFMT_RGBA => convertLumRowComptime(PIXFMT_RGBA, s0, dst16, w),
+        PIXFMT_BGRA => convertLumRowComptime(PIXFMT_BGRA, s0, dst16, w),
+        else => unreachable,
+    }
+
+    if (ctx.need_alpha) {
+        const dstA16: [*]i16 = @ptrCast(@alignCast(ctx.conv_a_buf.ptr));
+        for (0..w) |i| {
+            const a: i16 = s0[4 * i + 3];
+            dstA16[i] = (a << 6) | (a >> 2);
+        }
+    }
+
+    return ctx.conv_y_buf.ptr;
+}
+
+const ChrRowPtrs = struct {
+    u: [*]const u8,
+    v: [*]const u8,
+};
+
+fn convertChrRowRgbHalfComptime(comptime src_fmt: c_int, s0: [*]const u8, dstU16: [*]i16, dstV16: [*]i16, cw: usize) void {
+    const step: usize = if (src_fmt == PIXFMT_RGB24 or src_fmt == PIXFMT_BGR24) 3 else 4;
+    const is_bgr = (src_fmt == PIXFMT_BGR24 or src_fmt == PIXFMT_BGRA);
+    const ru_v: @Vector(8, i32) = @splat(RU);
+    const gu_v: @Vector(8, i32) = @splat(GU);
+    const bu_v: @Vector(8, i32) = @splat(BU);
+    const rv_v: @Vector(8, i32) = @splat(RV);
+    const gv_v: @Vector(8, i32) = @splat(GV);
+    const bv_v: @Vector(8, i32) = @splat(BV);
+    const uv_bias: @Vector(8, i32) = @splat((256 << RGB2YUV_SHIFT) + (1 << (RGB2YUV_SHIFT - 6)));
+    const sh10: @Vector(8, u5) = @splat(RGB2YUV_SHIFT - 5);
+    const even_mask = [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 };
+    const odd_mask = [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 };
+
+    var i: usize = 0;
+    while (i + 8 <= cw) : (i += 8) {
+        const px = loadRgb16(src_fmt, s0 + (2 * i) * step);
+        const r: @Vector(8, i32) = @as(@Vector(8, i32), @intCast(@shuffle(u8, px.r, undefined, even_mask))) + @as(@Vector(8, i32), @intCast(@shuffle(u8, px.r, undefined, odd_mask)));
+        const g: @Vector(8, i32) = @as(@Vector(8, i32), @intCast(@shuffle(u8, px.g, undefined, even_mask))) + @as(@Vector(8, i32), @intCast(@shuffle(u8, px.g, undefined, odd_mask)));
+        const b: @Vector(8, i32) = @as(@Vector(8, i32), @intCast(@shuffle(u8, px.b, undefined, even_mask))) + @as(@Vector(8, i32), @intCast(@shuffle(u8, px.b, undefined, odd_mask)));
+        dstU16[i..][0..8].* = @as(@Vector(8, i16), @intCast((r * ru_v + g * gu_v + b * bu_v + uv_bias) >> sh10));
+        dstV16[i..][0..8].* = @as(@Vector(8, i16), @intCast((r * rv_v + g * gv_v + b * bv_v + uv_bias) >> sh10));
+    }
+    while (i < cw) : (i += 1) {
+        const p0 = s0 + (2 * i) * step;
+        const p1 = s0 + (2 * i + 1) * step;
+        const r: i32 = @as(i32, if (is_bgr) p0[2] else p0[0]) + @as(i32, if (is_bgr) p1[2] else p1[0]);
+        const g: i32 = @as(i32, p0[1]) + @as(i32, p1[1]);
+        const b: i32 = @as(i32, if (is_bgr) p0[0] else p0[2]) + @as(i32, if (is_bgr) p1[0] else p1[2]);
+        dstU16[i] = @intCast((RU * r + GU * g + BU * b + (256 << RGB2YUV_SHIFT) + (1 << (RGB2YUV_SHIFT - 6))) >> (RGB2YUV_SHIFT - 5));
+        dstV16[i] = @intCast((RV * r + GV * g + BV * b + (256 << RGB2YUV_SHIFT) + (1 << (RGB2YUV_SHIFT - 6))) >> (RGB2YUV_SHIFT - 5));
+    }
+}
+
+fn convertChrRow(ctx: *SwsContext, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int, chr_y: usize) ChrRowPtrs {
+    const cw: usize = @intCast(ctx.chr_src_w);
+    const s_fmt = ctx.src_fmt;
+
+    if (s_fmt == PIXFMT_YUV420P or s_fmt == PIXFMT_YUV422P or s_fmt == PIXFMT_YUV444P) {
+        return .{
+            .u = src_data[1].? + chr_y * @as(usize, @intCast(src_stride[1])),
+            .v = src_data[2].? + chr_y * @as(usize, @intCast(src_stride[2])),
+        };
+    }
+
+    if (s_fmt == PIXFMT_NV12 or s_fmt == PIXFMT_NV21) {
+        const s1 = src_data[1].? + chr_y * @as(usize, @intCast(src_stride[1]));
+        const u_dst = ctx.conv_u_buf.ptr;
+        const v_dst = ctx.conv_v_buf.ptr;
+        var i: usize = 0;
+        if (s_fmt == PIXFMT_NV12) {
+            while (i + 16 <= cw) : (i += 16) {
+                const s_lo: @Vector(16, u8) = s1[2 * i ..][0..16].*;
+                const s_hi: @Vector(16, u8) = s1[2 * i + 16 ..][0..16].*;
+                u_dst[i..][0..16].* = @shuffle(u8, s_lo, s_hi, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) });
+                v_dst[i..][0..16].* = @shuffle(u8, s_lo, s_hi, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) });
+            }
+            while (i < cw) : (i += 1) {
+                u_dst[i] = s1[2 * i + 0];
+                v_dst[i] = s1[2 * i + 1];
+            }
+        } else {
+            while (i + 16 <= cw) : (i += 16) {
+                const s_lo: @Vector(16, u8) = s1[2 * i ..][0..16].*;
+                const s_hi: @Vector(16, u8) = s1[2 * i + 16 ..][0..16].*;
+                v_dst[i..][0..16].* = @shuffle(u8, s_lo, s_hi, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) });
+                u_dst[i..][0..16].* = @shuffle(u8, s_lo, s_hi, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) });
+            }
+            while (i < cw) : (i += 1) {
+                v_dst[i] = s1[2 * i + 0];
+                u_dst[i] = s1[2 * i + 1];
+            }
+        }
+        return .{ .u = u_dst, .v = v_dst };
+    }
+
+    // Packed RGB
+    const s0 = src_data[0].? + (chr_y << ctx.chr_src_v_sub) * @as(usize, @intCast(src_stride[0]));
+    const dstU16: [*]i16 = @ptrCast(@alignCast(ctx.conv_u_buf.ptr));
+    const dstV16: [*]i16 = @ptrCast(@alignCast(ctx.conv_v_buf.ptr));
+    const step: usize = if (s_fmt == PIXFMT_RGB24 or s_fmt == PIXFMT_BGR24) 3 else 4;
+    const is_bgr = (s_fmt == PIXFMT_BGR24 or s_fmt == PIXFMT_BGRA);
+
+    if (ctx.chr_src_h_sub != 0) {
+        switch (s_fmt) {
+            PIXFMT_RGB24 => convertChrRowRgbHalfComptime(PIXFMT_RGB24, s0, dstU16, dstV16, cw),
+            PIXFMT_BGR24 => convertChrRowRgbHalfComptime(PIXFMT_BGR24, s0, dstU16, dstV16, cw),
+            PIXFMT_RGBA => convertChrRowRgbHalfComptime(PIXFMT_RGBA, s0, dstU16, dstV16, cw),
+            PIXFMT_BGRA => convertChrRowRgbHalfComptime(PIXFMT_BGRA, s0, dstU16, dstV16, cw),
+            else => unreachable,
+        }
+    } else {
+        for (0..cw) |i| {
+            const p = s0 + i * step;
+            const r: i32 = if (is_bgr) p[2] else p[0];
+            const g: i32 = p[1];
+            const b: i32 = if (is_bgr) p[0] else p[2];
+            dstU16[i] = @intCast((RU * r + GU * g + BU * b + (256 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6));
+            dstV16[i] = @intCast((RV * r + GV * g + BV * b + (256 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6));
+        }
+    }
+
+    return .{ .u = ctx.conv_u_buf.ptr, .v = ctx.conv_v_buf.ptr };
+}
+
+fn hScaleRowComptime(
+    comptime src_bpc: u8,
+    comptime fsize: usize,
+    dst: []i16,
+    dstW: usize,
+    src_bytes: [*]const u8,
+    filter: []const i16,
