+fn hScaleRgb3Comptime(
+    comptime fsize: usize,
+    dstR: []i16,
+    dstG: []i16,
+    dstB: []i16,
+    dstW: usize,
+    srcR: [*]const u8,
+    srcG: [*]const u8,
+    srcB: [*]const u8,
+    filter: []const i16,
+    filter_pos: []const i32,
+) void {
+    const max15: @Vector(8, i32) = @splat((1 << 15) - 1);
+    const sh: @Vector(8, u5) = @splat(7);
+    var i: usize = 0;
+    while (i + 8 <= dstW) : (i += 8) {
+        const p0: usize = @intCast(filter_pos[i + 0]);
+        const p1: usize = @intCast(filter_pos[i + 1]);
+        const p2: usize = @intCast(filter_pos[i + 2]);
+        const p3: usize = @intCast(filter_pos[i + 3]);
+        const p4: usize = @intCast(filter_pos[i + 4]);
+        const p5: usize = @intCast(filter_pos[i + 5]);
+        const p6: usize = @intCast(filter_pos[i + 6]);
+        const p7: usize = @intCast(filter_pos[i + 7]);
+        const fb = filter.ptr + i * fsize;
+        var accR: @Vector(8, i32) = @splat(0);
+        var accG: @Vector(8, i32) = @splat(0);
+        var accB: @Vector(8, i32) = @splat(0);
+        inline for (0..fsize) |j| {
+            const f_vec: @Vector(8, i32) = .{
+                fb[0 * fsize + j], fb[1 * fsize + j], fb[2 * fsize + j], fb[3 * fsize + j],
+                fb[4 * fsize + j], fb[5 * fsize + j], fb[6 * fsize + j], fb[7 * fsize + j],
+            };
+            const r_vec: @Vector(8, i32) = .{
+                srcR[p0 + j], srcR[p1 + j], srcR[p2 + j], srcR[p3 + j],
+                srcR[p4 + j], srcR[p5 + j], srcR[p6 + j], srcR[p7 + j],
+            };
+            const g_vec: @Vector(8, i32) = .{
+                srcG[p0 + j], srcG[p1 + j], srcG[p2 + j], srcG[p3 + j],
+                srcG[p4 + j], srcG[p5 + j], srcG[p6 + j], srcG[p7 + j],
+            };
+            const b_vec: @Vector(8, i32) = .{
+                srcB[p0 + j], srcB[p1 + j], srcB[p2 + j], srcB[p3 + j],
+                srcB[p4 + j], srcB[p5 + j], srcB[p6 + j], srcB[p7 + j],
+            };
+            accR += r_vec * f_vec;
+            accG += g_vec * f_vec;
+            accB += b_vec * f_vec;
+        }
+        dstR[i..][0..8].* = @as(@Vector(8, i16), @intCast(@min(accR >> sh, max15)));
+        dstG[i..][0..8].* = @as(@Vector(8, i16), @intCast(@min(accG >> sh, max15)));
+        dstB[i..][0..8].* = @as(@Vector(8, i16), @intCast(@min(accB >> sh, max15)));
+    }
+    while (i < dstW) : (i += 1) {
+        const src_pos: usize = @intCast(filter_pos[i]);
+        var vr: i32 = 0;
+        var vg: i32 = 0;
+        var vb: i32 = 0;
+        inline for (0..fsize) |j| {
+            const fc: i32 = filter[i * fsize + j];
+            vr += @as(i32, srcR[src_pos + j]) * fc;
+            vg += @as(i32, srcG[src_pos + j]) * fc;
+            vb += @as(i32, srcB[src_pos + j]) * fc;
+        }
+        dstR[i] = @intCast(@min(vr >> 7, (1 << 15) - 1));
+        dstG[i] = @intCast(@min(vg >> 7, (1 << 15) - 1));
+        dstB[i] = @intCast(@min(vb >> 7, (1 << 15) - 1));
