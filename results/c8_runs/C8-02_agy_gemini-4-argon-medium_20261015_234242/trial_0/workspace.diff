+fn lumConvertRange(ctx: *SwsContext, dst: []i16) void {
+    if (ctx.src_range == ctx.dst_range or isAnyRGB(ctx.dst_fmt)) return;
+    if (ctx.src_range != 0) {
+        // lumRangeFromJpeg_c
+        for (dst) |*v| {
+            const val: i32 = v.*;
+            v.* = @intCast((val * 14071 + 33561947) >> 14);
