diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,62 @@
+WITH candidates AS (
+  SELECT wordid
+  FROM senses
+  GROUP BY wordid
+  HAVING COUNT(*) >= 2
+),
+top_words AS (
+  SELECT 
+    s.wordid AS word_id,
+    COUNT(DISTINCT s.synsetid) AS total_synsets,
+    COUNT(*) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids
+  FROM senses s
+  JOIN synsets syn ON syn.synsetid = s.synsetid
+  WHERE s.wordid IN (SELECT wordid FROM candidates)
+  GROUP BY s.wordid
+  HAVING total_synsets >= 2
+    AND distinct_domains >= 2 
+    AND total_senses >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    word_id ASC
+  LIMIT 500
+),
+top_synsets AS (
+  SELECT wordid, synsetid, sense_cnt
+  FROM (
+    SELECT
+      s.wordid,
+      s.synsetid,
+      COUNT(*) AS sense_cnt,
+      ROW_NUMBER() OVER (
+        PARTITION BY s.wordid 
+        ORDER BY COUNT(*) DESC, s.synsetid ASC
+      ) AS rn
+    FROM senses s
+    JOIN top_words tw ON s.wordid = tw.word_id
+    GROUP BY s.wordid, s.synsetid
+  )
+  WHERE rn = 1
+)
+SELECT
+  tw.word_id,
+  w.word,
+  tw.total_synsets,
+  tw.total_senses,
+  tw.distinct_domains,
+  tw.distinct_posids,
+  ts.synsetid AS top_synsetid,
+  ts.sense_cnt AS top_synset_sense_count
+FROM top_words tw
+JOIN top_synsets ts ON tw.word_id = ts.wordid
+JOIN words w ON tw.word_id = w.wordid
+ORDER BY
+  tw.total_senses DESC,
+  tw.total_synsets DESC,
+  tw.distinct_domains DESC,
+  tw.word_id ASC
+LIMIT 500;
