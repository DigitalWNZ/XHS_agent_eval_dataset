+                ydst1[2 * i + 1] = @intCast(((RY * r12 + GY * g12 + BY * b12) >> 15) + 16);
+                ydst2[2 * i + 0] = @intCast(((RY * r21 + GY * g21 + BY * b21) >> 15) + 16);
+                ydst2[2 * i + 1] = @intCast(((RY * r22 + GY * g22 + BY * b22) >> 15) + 16);
+
+                const bx: i32 = (b11 + b12 + b21 + b22) >> 2;
+                const gx: i32 = (g11 + g12 + g21 + g22) >> 2;
+                const rx: i32 = (r11 + r12 + r21 + r22) >> 2;
