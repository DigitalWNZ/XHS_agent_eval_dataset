+                },
+                PIXFMT_RGBA => switch (df) {
+                    PIXFMT_RGB24 => convertRgbToRgbRowFmt(PIXFMT_RGBA, PIXFMT_RGB24, s, d, w),
+                    PIXFMT_BGR24 => convertRgbToRgbRowFmt(PIXFMT_RGBA, PIXFMT_BGR24, s, d, w),
+                    PIXFMT_BGRA => convertRgbToRgbRowFmt(PIXFMT_RGBA, PIXFMT_BGRA, s, d, w),
+                    else => unreachable,
+                },
+                PIXFMT_BGRA => switch (df) {
+                    PIXFMT_RGB24 => convertRgbToRgbRowFmt(PIXFMT_BGRA, PIXFMT_RGB24, s, d, w),
+                    PIXFMT_BGR24 => convertRgbToRgbRowFmt(PIXFMT_BGRA, PIXFMT_BGR24, s, d, w),
+                    PIXFMT_RGBA => convertRgbToRgbRowFmt(PIXFMT_BGRA, PIXFMT_RGBA, s, d, w),
+                    else => unreachable,
+                },
+                else => unreachable,
+            }
+            s = ptrAdd(s, src_st);
+            d = ptrAdd(d, dst_st);
+        }
+        return true;
+    }
+
+    // 7. Fused unscaled RGB/BGR/RGBA/BGRA -> Planar/SemiPlanar YUV (b001, b003, etc.)
+    if (isAnyRGB(sf) and isPlanarYUV(df) and ctx.h_chr.size == 1) {
