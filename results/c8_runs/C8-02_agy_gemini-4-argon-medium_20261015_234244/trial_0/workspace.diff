+        var src1 = src_data[0].?;
+        var src2 = ptrAdd(src1, src_stride[0]);
+        var ydst1 = dst_data[0].?;
+        var ydst2 = ptrAdd(ydst1, dst_stride[0]);
+        var udst = dst_data[1].?;
+        var vdst = dst_data[2].?;
+        var y: usize = 0;
+        while (y < h) : (y += 2) {
+            var i: usize = 0;
+            while (i + 8 <= cw) : (i += 8) {
