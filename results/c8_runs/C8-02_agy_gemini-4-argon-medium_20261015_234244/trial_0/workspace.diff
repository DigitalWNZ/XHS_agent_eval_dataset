+                    dst_uv_ptr[2 * i + 16 ..][0..16].* = hi;
+                }
+                while (i < chrDstW) : (i += 1) {
+                    var u_val: i32 = 64 << 11;
+                    var v_val: i32 = 64 << 11;
+                    for (0..u_vChrFilterSize) |j| {
+                        const row_idx: usize = @intCast(@max(0, firstChrSrcY + @as(i32, @intCast(j))));
+                        const slot = row_idx & chr_ring_mask;
+                        const c_coeff: i32 = f_coeffs[j];
+                        u_val += @as(i32, ctx.chr_u_ring[slot * ctx.chr_ring_stride + i]) * c_coeff;
+                        v_val += @as(i32, ctx.chr_v_ring[slot * ctx.chr_ring_stride + i]) * c_coeff;
+                    }
+                    if (!swapped) {
+                        dst_uv_ptr[2 * i + 0] = clipU8(u_val >> 18);
+                        dst_uv_ptr[2 * i + 1] = clipU8(v_val >> 18);
+                    } else {
+                        dst_uv_ptr[2 * i + 0] = clipU8(v_val >> 18);
+                        dst_uv_ptr[2 * i + 1] = clipU8(u_val >> 18);
+                    }
+                }
+            } else {
+                const dst_u_ptr = ptrAdd(dst_data[1].?, chrDstY * dst_stride[1]);
+                const dst_v_ptr = ptrAdd(dst_data[2].?, chrDstY * dst_stride[2]);
+                var i: usize = 0;
+                while (i + 16 <= chrDstW) : (i += 16) {
+                    var u_acc: @Vector(16, i16) = bias16;
+                    var v_acc: @Vector(16, i16) = bias16;
+                    for (0..u_vChrFilterSize) |j| {
+                        const row_idx: usize = @intCast(@max(0, firstChrSrcY + @as(i32, @intCast(j))));
+                        const slot = row_idx & chr_ring_mask;
+                        const c_vec: @Vector(16, i16) = @splat(f_coeffs[j] << 2);
+                        const u_row: @Vector(16, i16) = @as(@Vector(16, i16), ctx.chr_u_ring[slot * ctx.chr_ring_stride + i ..][0..16].*) << @splat(1);
+                        const v_row: @Vector(16, i16) = @as(@Vector(16, i16), ctx.chr_v_ring[slot * ctx.chr_ring_stride + i ..][0..16].*) << @splat(1);
+                        u_acc += mulHi16(u_row, c_vec);
+                        v_acc += mulHi16(v_row, c_vec);
+                    }
+                    dst_u_ptr[i..][0..16].* = @as(@Vector(16, u8), @intCast(@max(@as(@Vector(16, i16), @splat(0)), @min(@as(@Vector(16, i16), @splat(255)), u_acc >> @splat(5)))));
+                    dst_v_ptr[i..][0..16].* = @as(@Vector(16, u8), @intCast(@max(@as(@Vector(16, i16), @splat(0)), @min(@as(@Vector(16, i16), @splat(255)), v_acc >> @splat(5)))));
+                }
+                while (i < chrDstW) : (i += 1) {
+                    var u_val: i32 = 64 << 11;
+                    var v_val: i32 = 64 << 11;
+                    for (0..u_vChrFilterSize) |j| {
+                        const row_idx: usize = @intCast(@max(0, firstChrSrcY + @as(i32, @intCast(j))));
+                        const slot = row_idx & chr_ring_mask;
+                        const c_coeff: i32 = f_coeffs[j];
+                        u_val += @as(i32, ctx.chr_u_ring[slot * ctx.chr_ring_stride + i]) * c_coeff;
+                        v_val += @as(i32, ctx.chr_v_ring[slot * ctx.chr_ring_stride + i]) * c_coeff;
+                    }
+                    dst_u_ptr[i] = clipU8(u_val >> 18);
+                    dst_v_ptr[i] = clipU8(v_val >> 18);
+                }
+            }
+        }
+        return true;
+    }
+
+    return false;
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+    if (src_data[0] == null or dst_data[0] == null) return -1;
+
+    if (tryUnscaled(ctx, src_data, src_stride, dst_data, dst_stride)) {
+        return 0;
+    }
+
+    // General scaled/converted pipeline matching FFmpeg swscale()
+    const dstW: usize = @intCast(ctx.dst_w);
+    const dstH: usize = @intCast(ctx.dst_h);
+    const srcW: usize = @intCast(ctx.src_w);
+    const srcH: i32 = ctx.src_h;
+    const chrSrcW: usize = @intCast(ctx.chr_src_w);
+    const chrSrcH: i32 = ctx.chr_src_h;
+    const chrDstW: usize = @intCast(ctx.chr_dst_w);
+
+    const vLumFilterSize: i32 = @intCast(ctx.v_lum.size);
+    const vChrFilterSize: i32 = @intCast(ctx.v_chr.size);
+    const u_vLumFilterSize: usize = ctx.v_lum.size;
+    const u_vChrFilterSize: usize = ctx.v_chr.size;
+
+    const do_range_conv = (ctx.src_range != ctx.dst_range) and !isAnyRGB(ctx.dst_fmt);
+
+    if (!ctx.needs_hcscale) {
+        @memset(ctx.chr_u_ring, 1 << 14);
+        @memset(ctx.chr_v_ring, 1 << 14);
+    }
+
+    var lastInLumBuf: i32 = -1;
+    var lastInChrBuf: i32 = -1;
+
+    for (0..dstH) |dstY_u| {
+        const dstY: i32 = @intCast(dstY_u);
+        const chrDstY: i32 = dstY >> ctx.chr_dst_v_sub;
+        const u_chrDstY: usize = @intCast(chrDstY);
+
+        const firstLumSrcY: i32 = @max(1 - vLumFilterSize, ctx.v_lum.pos[dstY_u]);
+        const firstLumSrcY2: i32 = @max(
+            1 - vLumFilterSize,
+            ctx.v_lum.pos[@intCast(@min(dstY | ((@as(i32, 1) << ctx.chr_dst_v_sub) - 1), ctx.dst_h - 1))],
+        );
+        const firstChrSrcY: i32 = @max(1 - vChrFilterSize, ctx.v_chr.pos[u_chrDstY]);
+
+        const lastLumSrcY2: i32 = @min(srcH, firstLumSrcY2 + vLumFilterSize) - 1;
+        const lastChrSrcY: i32 = @min(chrSrcH, firstChrSrcY + vChrFilterSize) - 1;
