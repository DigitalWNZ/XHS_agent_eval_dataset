+inline fn evalYTable16Limited(d: @Vector(16, i16)) @Vector(16, u8) {
+    const x: @Vector(16, u16) = @intCast(@max(@as(@Vector(16, i16), @splat(17)), @min(@as(@Vector(16, i16), @splat(237)), d)) - @as(@Vector(16, i16), @splat(17)));
