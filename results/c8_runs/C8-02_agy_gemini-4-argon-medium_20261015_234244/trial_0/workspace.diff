+        const c3_lo = @shuffle(u8, p0, p1, [8]i32{ 3, 7, 11, 15, -4, -8, -12, -16 });
+        const c3_hi = @shuffle(u8, p2, p3, [8]i32{ 3, 7, 11, 15, -4, -8, -12, -16 });
