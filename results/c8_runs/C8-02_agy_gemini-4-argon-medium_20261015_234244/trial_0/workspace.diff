+const std = @import("std");
+
+pub const PIXFMT_YUV420P: i32 = 0;
+pub const PIXFMT_YUV422P: i32 = 1;
+pub const PIXFMT_YUV444P: i32 = 2;
+pub const PIXFMT_NV12: i32 = 3;
+pub const PIXFMT_NV21: i32 = 4;
+pub const PIXFMT_RGB24: i32 = 5;
+pub const PIXFMT_BGR24: i32 = 6;
+pub const PIXFMT_RGBA: i32 = 7;
+pub const PIXFMT_BGRA: i32 = 8;
+pub const PIXFMT_GRAY8: i32 = 9;
+
+pub const ALGO_NEAREST: i32 = 0;
+pub const ALGO_BILINEAR: i32 = 1;
+pub const ALGO_BICUBIC: i32 = 2;
+
+const TABLE_HEADROOM: usize = 512;
+const TABLE_LUMA_HEADROOM: usize = 512;
+const TABLE_PLANE_SIZE: usize = 1024 + 2 * TABLE_LUMA_HEADROOM;
+const CHROMA_TABLE_SIZE: usize = 256 + 2 * TABLE_HEADROOM;
+
+// RGB2YUV fixed-point coefficients (RGB2YUV_SHIFT = 15)
+const RY: i32 = 8414;
+const GY: i32 = 16519;
+const BY: i32 = 3208;
+const RU: i32 = -4865;
+const GU: i32 = -9528;
+const BU: i32 = 14392;
+const RV: i32 = 14392;
+const GV: i32 = -12061;
+const BV: i32 = -2332;
+
+fn isAnyRGB(fmt: i32) bool {
+    return fmt == PIXFMT_RGB24 or fmt == PIXFMT_BGR24 or fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+fn isAlpha(fmt: i32) bool {
+    return fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+fn isGray(fmt: i32) bool {
+    return fmt == PIXFMT_GRAY8;
+}
+
+fn isPlanarYUV(fmt: i32) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P or fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+fn isSemiPlanarYUV(fmt: i32) bool {
+    return fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+fn getSubSample(fmt: i32, h_sub: *u5, v_sub: *u5) void {
+    switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => {
+            h_sub.* = 1;
+            v_sub.* = 1;
+        },
+        PIXFMT_YUV422P => {
+            h_sub.* = 1;
+            v_sub.* = 0;
+        },
+        else => {
+            h_sub.* = 0;
+            v_sub.* = 0;
+        },
+    }
+}
+
+fn ceilRshift(a: i32, b: u5) i32 {
+    return -((-(a)) >> b);
+}
+
+fn avLog2(v_in: u32) u32 {
+    if (v_in == 0) return 0;
+    return 31 - @clz(v_in);
+}
+
+fn clipU8(a: i32) u8 {
+    if (a < 0) return 0;
+    if (a > 255) return 255;
+    return @intCast(a);
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    if (a > 0) {
+        return @divTrunc(a + @divTrunc(b, 2), b);
+    } else {
+        return @divTrunc(a - @divTrunc(b, 2), b);
+    }
+}
+
+const Filter = struct {
+    coeffs: []i16,
+    pos: []i32,
+    size: usize,
+};
+
+fn buildFilter(
+    alloc: std.mem.Allocator,
+    xInc: i32,
+    srcW: i32,
+    dstW: i32,
+    filterAlign: usize,
+    one: i64,
+    algo: i32,
+    srcPos: i32,
+    dstPos: i32,
+) !Filter {
+    const u_dstW: usize = @intCast(dstW);
+    const ratio: u32 = @intCast(@divTrunc(srcW, dstW));
+    const log_ratio: u32 = @min(avLog2(ratio), 8);
+    const fone: i64 = @as(i64, 1) << @as(u6, @intCast(54 - log_ratio));
+
+    var filterPos = try alloc.alloc(i32, u_dstW + 3);
+    errdefer alloc.free(filterPos);
+
+    var filterSize: usize = 1;
+    var filter: []i64 = undefined;
+
+    if (@abs(xInc - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, u_dstW * filterSize);
+        @memset(filter, 0);
+        for (0..u_dstW) |i| {
+            filter[i * filterSize] = fone;
+            filterPos[i] = @intCast(i);
+        }
+    } else if (algo == ALGO_NEAREST) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, u_dstW * filterSize);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * @as(i64, xInc)) >> 8) - ((@as(i64, srcPos) * 0x8000) >> 7);
+        for (0..u_dstW) |i| {
+            const xx: i32 = @intCast((xDstInSrc - ((@as(i64, @intCast(filterSize)) - 1) << 15) + (1 << 15)) >> 16);
+            filterPos[i] = xx;
+            filter[i] = fone;
+            xDstInSrc += xInc;
+        }
