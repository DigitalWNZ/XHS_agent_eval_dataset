+fn convertLumLineFmt(comptime fmt: i32, src_row: [*]const u8, width: usize, dst: []i16) void {
+    const rnd: i32 = (32 << 14) + (1 << 8);
+    const bpp: usize = if (fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA) 4 else 3;
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const rgba = loadRgb16Fmt(fmt, src_row + i * bpp);
+        const r: @Vector(16, u16) = @intCast(rgba.r);
+        const g: @Vector(16, u16) = @intCast(rgba.g);
+        const b: @Vector(16, u16) = @intCast(rgba.b);
+        const low_part = (r * @as(@Vector(16, u16), @splat(7)) +
+            (g << @splat(2)) +
+            b * @as(@Vector(16, u16), @splat(100)) +
+            @as(@Vector(16, u16), @splat(16440))) >> @splat(2);
+        const y_val: @Vector(16, u16) = low_part + (r << @splat(6)) + (g << @splat(7));
+        dst[i..][0..16].* = @bitCast(y_val);
+    }
+    while (i < width) : (i += 1) {
+        const c0: i32 = src_row[bpp * i + 0];
+        const c1: i32 = src_row[bpp * i + 1];
+        const c2: i32 = src_row[bpp * i + 2];
+        const r = if (fmt == PIXFMT_RGB24 or fmt == PIXFMT_RGBA) c0 else c2;
+        const g = c1;
+        const b = if (fmt == PIXFMT_RGB24 or fmt == PIXFMT_RGBA) c2 else c0;
+        dst[i] = @intCast((RY * r + GY * g + BY * b + rnd) >> 9);
+    }
+}
+
+// Input line conversion functions
+fn convertLumLine(ctx: *const SwsContext, src_row: [*]const u8, width: usize, dst: []i16) void {
+    switch (ctx.src_fmt) {
+        PIXFMT_RGB24 => convertLumLineFmt(PIXFMT_RGB24, src_row, width, dst),
+        PIXFMT_BGR24 => convertLumLineFmt(PIXFMT_BGR24, src_row, width, dst),
+        PIXFMT_RGBA => convertLumLineFmt(PIXFMT_RGBA, src_row, width, dst),
+        PIXFMT_BGRA => convertLumLineFmt(PIXFMT_BGRA, src_row, width, dst),
+        else => unreachable,
+    }
+}
+
+fn convertAlpLine(src_row: [*]const u8, width: usize, dst: []i16) void {
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const rgba = loadRgb16Fmt(PIXFMT_RGBA, src_row + i * 4);
+        const a: @Vector(16, u16) = @intCast(rgba.a);
+        const res: @Vector(16, u16) = (a << @splat(6)) | (a >> @splat(2));
+        dst[i..][0..16].* = @bitCast(res);
+    }
+    while (i < width) : (i += 1) {
+        const a: u16 = src_row[4 * i + 3];
+        dst[i] = @bitCast((a << 6) | (a >> 2));
+    }
+}
+
+fn convertChrLineRGBFmt(
+    comptime fmt: i32,
+    comptime h_sub: bool,
+    src_row: [*]const u8,
+    width: usize,
+    dstU: []i16,
+    dstV: []i16,
+) void {
+    const bpp: usize = if (fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA) 4 else 3;
+    if (h_sub) {
+        const rnd: i32 = (256 << 15) + (1 << 9);
+        const step: usize = bpp * 2;
+        const mask_ff: @Vector(8, u16) = @splat(0x00ff);
+        var i: usize = 0;
+        while (i + 8 <= width) : (i += 8) {
+            const rgba = loadRgb16Fmt(fmt, src_row + i * step);
+            const rw: @Vector(8, u16) = @bitCast(rgba.r);
+            const gw: @Vector(8, u16) = @bitCast(rgba.g);
+            const bw: @Vector(8, u16) = @bitCast(rgba.b);
+
+            const r: @Vector(8, i32) = @intCast((rw & mask_ff) + (rw >> @splat(8)));
+            const g: @Vector(8, i32) = @intCast((gw & mask_ff) + (gw >> @splat(8)));
+            const b: @Vector(8, i32) = @intCast((bw & mask_ff) + (bw >> @splat(8)));
+
+            const u_val = (r * @as(@Vector(8, i32), @splat(RU)) +
+                g * @as(@Vector(8, i32), @splat(GU)) +
+                b * @as(@Vector(8, i32), @splat(BU)) +
+                @as(@Vector(8, i32), @splat(rnd))) >> @splat(10);
+            const v_val = (r * @as(@Vector(8, i32), @splat(RV)) +
+                g * @as(@Vector(8, i32), @splat(GV)) +
+                b * @as(@Vector(8, i32), @splat(BV)) +
+                @as(@Vector(8, i32), @splat(rnd))) >> @splat(10);
+
+            dstU[i..][0..8].* = @as(@Vector(8, i16), @intCast(u_val));
+            dstV[i..][0..8].* = @as(@Vector(8, i16), @intCast(v_val));
+        }
+        while (i < width) : (i += 1) {
+            const c0: i32 = @as(i32, src_row[step * i + 0]) + @as(i32, src_row[step * i + bpp + 0]);
+            const c1: i32 = @as(i32, src_row[step * i + 1]) + @as(i32, src_row[step * i + bpp + 1]);
+            const c2: i32 = @as(i32, src_row[step * i + 2]) + @as(i32, src_row[step * i + bpp + 2]);
+            const r = if (fmt == PIXFMT_RGB24 or fmt == PIXFMT_RGBA) c0 else c2;
+            const g = c1;
+            const b = if (fmt == PIXFMT_RGB24 or fmt == PIXFMT_RGBA) c2 else c0;
+            dstU[i] = @intCast((RU * r + GU * g + BU * b + rnd) >> 10);
+            dstV[i] = @intCast((RV * r + GV * g + BV * b + rnd) >> 10);
+        }
+    } else {
+        const rnd: i32 = (256 << 14) + (1 << 8);
+        var i: usize = 0;
+        while (i + 16 <= width) : (i += 16) {
+            const rgba = loadRgb16Fmt(fmt, src_row + i * bpp);
+            const r16: @Vector(16, i16) = @as(@Vector(16, i16), @intCast(rgba.r)) << @splat(7);
+            const g16: @Vector(16, i16) = @as(@Vector(16, i16), @intCast(rgba.g)) << @splat(7);
+            const b16: @Vector(16, i16) = @as(@Vector(16, i16), @intCast(rgba.b)) << @splat(7);
+            const u_val = mulHi16(r16, @splat(@as(i16, @intCast(RU * 2)))) +
+                mulHi16(g16, @splat(@as(i16, @intCast(GU * 2)))) +
+                mulHi16(b16, @splat(@as(i16, @intCast(BU * 2)))) +
+                @as(@Vector(16, i16), @splat((128 << 6) + 2));
+            const v_val = mulHi16(r16, @splat(@as(i16, @intCast(RV * 2)))) +
+                mulHi16(g16, @splat(@as(i16, @intCast(GV * 2)))) +
+                mulHi16(b16, @splat(@as(i16, @intCast(BV * 2)))) +
+                @as(@Vector(16, i16), @splat((128 << 6) + 2));
+            dstU[i..][0..16].* = u_val;
+            dstV[i..][0..16].* = v_val;
+        }
+        while (i < width) : (i += 1) {
+            const c0: i32 = src_row[bpp * i + 0];
+            const c1: i32 = src_row[bpp * i + 1];
+            const c2: i32 = src_row[bpp * i + 2];
+            const r = if (fmt == PIXFMT_RGB24 or fmt == PIXFMT_RGBA) c0 else c2;
+            const g = c1;
+            const b = if (fmt == PIXFMT_RGB24 or fmt == PIXFMT_RGBA) c2 else c0;
+            dstU[i] = @intCast((RU * r + GU * g + BU * b + rnd) >> 9);
+            dstV[i] = @intCast((RV * r + GV * g + BV * b + rnd) >> 9);
+        }
+    }
+}
+
+fn convertChrLineRGB(ctx: *const SwsContext, src_row: [*]const u8, width: usize, dstU: []i16, dstV: []i16) void {
+    if (ctx.chr_src_h_sub != 0) {
+        switch (ctx.src_fmt) {
+            PIXFMT_RGB24 => convertChrLineRGBFmt(PIXFMT_RGB24, true, src_row, width, dstU, dstV),
+            PIXFMT_BGR24 => convertChrLineRGBFmt(PIXFMT_BGR24, true, src_row, width, dstU, dstV),
+            PIXFMT_RGBA => convertChrLineRGBFmt(PIXFMT_RGBA, true, src_row, width, dstU, dstV),
+            PIXFMT_BGRA => convertChrLineRGBFmt(PIXFMT_BGRA, true, src_row, width, dstU, dstV),
+            else => unreachable,
+        }
+    } else {
+        switch (ctx.src_fmt) {
+            PIXFMT_RGB24 => convertChrLineRGBFmt(PIXFMT_RGB24, false, src_row, width, dstU, dstV),
+            PIXFMT_BGR24 => convertChrLineRGBFmt(PIXFMT_BGR24, false, src_row, width, dstU, dstV),
+            PIXFMT_RGBA => convertChrLineRGBFmt(PIXFMT_RGBA, false, src_row, width, dstU, dstV),
+            PIXFMT_BGRA => convertChrLineRGBFmt(PIXFMT_BGRA, false, src_row, width, dstU, dstV),
+            else => unreachable,
+        }
+    }
+}
+
+fn lumRangeToJpeg(dst: []i16, width: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const v_in: @Vector(16, i32) = @as(@Vector(16, i16), dst[i..][0..16].*);
+        const v = @min(v_in, @as(@Vector(16, i32), @splat(30189)));
+        const res = (v * @as(@Vector(16, i32), @splat(19077)) - @as(@Vector(16, i32), @splat(39057361))) >> @splat(14);
+        dst[i..][0..16].* = @as(@Vector(16, i16), @intCast(res));
+    }
+    while (i < width) : (i += 1) {
+        const v: i32 = @min(@as(i32, dst[i]), 30189);
+        dst[i] = @intCast((v * 19077 - 39057361) >> 14);
+    }
+}
+
+fn lumRangeFromJpeg(dst: []i16, width: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const v: @Vector(16, i32) = @as(@Vector(16, i16), dst[i..][0..16].*);
+        const res = (v * @as(@Vector(16, i32), @splat(14071)) + @as(@Vector(16, i32), @splat(33561947))) >> @splat(14);
+        dst[i..][0..16].* = @as(@Vector(16, i16), @intCast(res));
+    }
+    while (i < width) : (i += 1) {
+        const v: i32 = dst[i];
+        dst[i] = @intCast((v * 14071 + 33561947) >> 14);
+    }
+}
+
+fn chrRangeToJpeg(dstU: []i16, dstV: []i16, width: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const u_in: @Vector(16, i32) = @as(@Vector(16, i16), dstU[i..][0..16].*);
+        const v_in: @Vector(16, i32) = @as(@Vector(16, i16), dstV[i..][0..16].*);
+        const u = @min(u_in, @as(@Vector(16, i32), @splat(30775)));
+        const v = @min(v_in, @as(@Vector(16, i32), @splat(30775)));
+        const ru = (u * @as(@Vector(16, i32), @splat(4663)) - @as(@Vector(16, i32), @splat(9289992))) >> @splat(12);
+        const rv = (v * @as(@Vector(16, i32), @splat(4663)) - @as(@Vector(16, i32), @splat(9289992))) >> @splat(12);
+        dstU[i..][0..16].* = @as(@Vector(16, i16), @intCast(ru));
+        dstV[i..][0..16].* = @as(@Vector(16, i16), @intCast(rv));
+    }
+    while (i < width) : (i += 1) {
+        const u: i32 = @min(@as(i32, dstU[i]), 30775);
