+        var s_y = src_data[0].?;
+        var d_y = dst_data[0].?;
+        const src_st: isize = src_stride[0];
+        const dst_y_st: isize = dst_stride[0];
+        for (0..h) |_| {
+            switch (sf) {
+                PIXFMT_RGB24 => convertRgbToYRowFmt(PIXFMT_RGB24, s_y, d_y, w),
+                PIXFMT_BGR24 => convertRgbToYRowFmt(PIXFMT_BGR24, s_y, d_y, w),
+                PIXFMT_RGBA => convertRgbToYRowFmt(PIXFMT_RGBA, s_y, d_y, w),
+                PIXFMT_BGRA => convertRgbToYRowFmt(PIXFMT_BGRA, s_y, d_y, w),
+                else => unreachable,
+            }
+            s_y = ptrAdd(s_y, src_st);
+            d_y = ptrAdd(d_y, dst_y_st);
+        }
+
+        const chrDstW: usize = @intCast(ctx.chr_dst_w);
+        const chrDstH: usize = @intCast(ctx.chr_dst_h);
+        const chrSrcW: usize = @intCast(ctx.chr_src_w);
+        const chrSrcH: i32 = ctx.chr_src_h;
+        const vChrFilterSize: i32 = @intCast(ctx.v_chr.size);
+        const u_vChrFilterSize: usize = ctx.v_chr.size;
+        const chr_ring_mask = ctx.chr_ring_size - 1;
+        var lastInChrBuf: i32 = -1;
+
+        for (0..chrDstH) |u_chrDstY| {
+            const chrDstY: isize = @intCast(u_chrDstY);
+            const firstChrSrcY: i32 = @max(1 - vChrFilterSize, ctx.v_chr.pos[u_chrDstY]);
+            const lastChrSrcY: i32 = @min(chrSrcH, firstChrSrcY + vChrFilterSize) - 1;
+            if (firstChrSrcY > lastInChrBuf) {
+                lastInChrBuf = firstChrSrcY - 1;
+            }
+            while (lastInChrBuf < lastChrSrcY) {
+                lastInChrBuf += 1;
+                const csy: i32 = @max(0, lastInChrBuf);
+                const ring_slot: usize = @as(usize, @intCast(lastInChrBuf)) & chr_ring_mask;
+                const dst_u_line = ctx.chr_u_ring[ring_slot * ctx.chr_ring_stride ..][0..chrDstW];
+                const dst_v_line = ctx.chr_v_ring[ring_slot * ctx.chr_ring_stride ..][0..chrDstW];
+                const src_row = ptrAdd(src_data[0].?, @as(isize, csy) * src_st);
+                convertChrLineRGB(ctx, src_row, chrSrcW, dst_u_line, dst_v_line);
+            }
+
+            const f_coeffs = ctx.v_chr.coeffs[u_chrDstY * u_vChrFilterSize ..][0..u_vChrFilterSize];
+            const bias16: @Vector(16, i16) = @splat(@as(i16, @intCast(16 + (u_vChrFilterSize >> 1))));
+            if (isSemiPlanarYUV(df)) {
+                const dst_uv_ptr = ptrAdd(dst_data[1].?, chrDstY * dst_stride[1]);
+                const swapped = (df == PIXFMT_NV21);
+                var i: usize = 0;
+                while (i + 16 <= chrDstW) : (i += 16) {
+                    var u_acc: @Vector(16, i16) = bias16;
+                    var v_acc: @Vector(16, i16) = bias16;
+                    for (0..u_vChrFilterSize) |j| {
+                        const row_idx: usize = @intCast(@max(0, firstChrSrcY + @as(i32, @intCast(j))));
+                        const slot = row_idx & chr_ring_mask;
+                        const c_vec: @Vector(16, i16) = @splat(f_coeffs[j] << 2);
+                        const u_row: @Vector(16, i16) = @as(@Vector(16, i16), ctx.chr_u_ring[slot * ctx.chr_ring_stride + i ..][0..16].*) << @splat(1);
