+                        const row_idx: usize = @intCast(@max(0, firstLumSrcY + @as(i32, @intCast(j))));
+                        const slot = row_idx % ctx.lum_ring_size;
+                        const lc: i32 = l_coeffs[j];
+                        Y1 += @as(i32, ctx.lum_ring[slot * ctx.lum_ring_stride + 2 * i]) * lc;
+                        Y2 += @as(i32, ctx.lum_ring[slot * ctx.lum_ring_stride + 2 * i + 1]) * lc;
+                    }
+                    for (0..u_vChrFilterSize) |j| {
+                        const row_idx: usize = @intCast(@max(0, firstChrSrcY + @as(i32, @intCast(j))));
+                        const slot = row_idx % ctx.chr_ring_size;
+                        const cc: i32 = c_coeffs[j];
+                        U += @as(i32, ctx.chr_u_ring[slot * ctx.chr_ring_stride + i]) * cc;
+                        V += @as(i32, ctx.chr_v_ring[slot * ctx.chr_ring_stride + i]) * cc;
+                    }
+                    Y1 >>= 19;
+                    Y2 >>= 19;
+                    U >>= 19;
+                    V >>= 19;
+                    var A1: u32 = 255;
+                    var A2: u32 = 255;
+                    if (hasAlpha) {
+                        var a1_acc: i32 = 1 << 18;
+                        var a2_acc: i32 = 1 << 18;
+                        for (0..u_vLumFilterSize) |j| {
+                            const row_idx: usize = @intCast(@max(0, firstLumSrcY + @as(i32, @intCast(j))));
+                            const slot = row_idx % ctx.lum_ring_size;
+                            const lc: i32 = l_coeffs[j];
+                            a1_acc += @as(i32, ctx.alp_ring[slot * ctx.lum_ring_stride + 2 * i]) * lc;
+                            a2_acc += @as(i32, ctx.alp_ring[slot * ctx.lum_ring_stride + 2 * i + 1]) * lc;
+                        }
+                        A1 = clipU8(a1_acc >> 19);
+                        A2 = clipU8(a2_acc >> 19);
+                    }
+                    writeRgbPair(ctx, dst_ptr, i, Y1, Y2, U, V, A1, A2, hasAlpha);
+                }
+            }
+        }
+    }
+
+    return 0;
+}
