+                    const u_clamped: @Vector(16, u8) = @intCast(@max(@as(@Vector(16, i16), @splat(0)), @min(@as(@Vector(16, i16), @splat(255)), u_acc >> @splat(5))));
+                    const v_clamped: @Vector(16, u8) = @intCast(@max(@as(@Vector(16, i16), @splat(0)), @min(@as(@Vector(16, i16), @splat(255)), v_acc >> @splat(5))));
