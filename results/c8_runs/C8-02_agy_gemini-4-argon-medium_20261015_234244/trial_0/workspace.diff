+        const c1_lo = @shuffle(u8, p0, p1, [8]i32{ 1, 4, 7, 10, -2, -5, -8, -11 });
+        const c1_hi = @shuffle(u8, p2, p3, [8]i32{ 1, 4, 7, 10, -6, -9, -12, -15 });
