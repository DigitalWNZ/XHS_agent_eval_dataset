+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (@as(i64, 1) << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (@as(i64, 1) << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * filterSize + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * @as(i64, xInc);
+        }
+    }
+
+    const filter2Size = filterSize;
+    var filter2 = try alloc.alloc(i64, u_dstW * filter2Size);
+    defer alloc.free(filter2);
+    @memcpy(filter2, filter);
+    alloc.free(filter);
+
+    var minFilterSize: usize = 0;
+    const cutoff_limit: f64 = 0.002 * @as(f64, @floatFromInt(fone));
+    var i_rev: isize = @as(isize, @intCast(u_dstW)) - 1;
+    while (i_rev >= 0) : (i_rev -= 1) {
+        const i: usize = @intCast(i_rev);
+        var min: usize = filter2Size;
+        var cutOff: i64 = 0;
+
+        for (0..filter2Size) |_| {
+            cutOff += @intCast(@abs(filter2[i * filter2Size]));
+            if (@as(f64, @floatFromInt(cutOff)) > cutoff_limit) break;
+            if (i < u_dstW - 1 and filterPos[i] >= filterPos[i + 1]) break;
+            for (1..filter2Size) |k| {
+                filter2[i * filter2Size + k - 1] = filter2[i * filter2Size + k];
+            }
+            filter2[i * filter2Size + filter2Size - 1] = 0;
+            filterPos[i] += 1;
+        }
+
+        cutOff = 0;
+        var j_rev: isize = @as(isize, @intCast(filter2Size)) - 1;
+        while (j_rev > 0) : (j_rev -= 1) {
+            const j: usize = @intCast(j_rev);
+            cutOff += @intCast(@abs(filter2[i * filter2Size + j]));
+            if (@as(f64, @floatFromInt(cutOff)) > cutoff_limit) break;
+            min -= 1;
+        }
+
+        if (min > minFilterSize) minFilterSize = min;
+    }
+
+    filterSize = (minFilterSize + (filterAlign - 1)) & (~(filterAlign - 1));
+    filter = try alloc.alloc(i64, u_dstW * filterSize);
+    defer alloc.free(filter);
+
+    for (0..u_dstW) |i| {
+        for (0..filterSize) |j| {
+            if (j >= filter2Size) {
+                filter[i * filterSize + j] = 0;
+            } else {
+                filter[i * filterSize + j] = filter2[i * filter2Size + j];
+            }
+        }
+    }
+
+    // fix borders
+    for (0..u_dstW) |i| {
+        if (filterPos[i] < 0) {
+            for (1..filterSize) |j| {
+                const left_i32 = @max(@as(i32, @intCast(j)) + filterPos[i], 0);
+                const left: usize = @intCast(left_i32);
+                filter[i * filterSize + left] += filter[i * filterSize + j];
+                filter[i * filterSize + j] = 0;
+            }
+            filterPos[i] = 0;
+        }
+
+        if (filterPos[i] + @as(i32, @intCast(filterSize)) > srcW) {
+            const shift: i32 = filterPos[i] + @min(@as(i32, @intCast(filterSize)) - srcW, 0);
+            var acc: i64 = 0;
+            var j_rev: isize = @as(isize, @intCast(filterSize)) - 1;
+            while (j_rev >= 0) : (j_rev -= 1) {
+                const j: usize = @intCast(j_rev);
+                if (filterPos[i] + @as(i32, @intCast(j)) >= srcW) {
+                    acc += filter[i * filterSize + j];
+                    filter[i * filterSize + j] = 0;
+                }
+            }
+            j_rev = @as(isize, @intCast(filterSize)) - 1;
+            while (j_rev >= 0) : (j_rev -= 1) {
+                const j: usize = @intCast(j_rev);
+                if (@as(i32, @intCast(j)) < shift) {
+                    filter[i * filterSize + j] = 0;
+                } else {
+                    const src_j: usize = @intCast(@as(i32, @intCast(j)) - shift);
+                    filter[i * filterSize + j] = filter[i * filterSize + src_j];
+                }
+            }
+            filterPos[i] -= shift;
+            const idx_add: usize = @intCast(srcW - 1 - filterPos[i]);
+            filter[i * filterSize + idx_add] += acc;
+        }
+    }
+
+    var outFilter = try alloc.alloc(i16, filterSize * (u_dstW + 3));
+    @memset(outFilter, 0);
+
+    for (0..u_dstW) |i| {
+        var err: i64 = 0;
+        var sum: i64 = 0;
+        for (0..filterSize) |j| {
+            sum += filter[i * filterSize + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        for (0..filterSize) |j| {
+            const v: i64 = filter[i * filterSize + j] + err;
+            const intV: i64 = roundedDiv(v, sum);
+            outFilter[i * filterSize + j] = @intCast(intV);
+            err = v - intV * sum;
+        }
+    }
+
+    filterPos[u_dstW + 0] = filterPos[u_dstW - 1];
+    filterPos[u_dstW + 1] = filterPos[u_dstW - 1];
+    filterPos[u_dstW + 2] = filterPos[u_dstW - 1];
+    for (0..filterSize) |i| {
+        const k = (u_dstW - 1) * filterSize + i;
+        outFilter[k + 1 * filterSize] = outFilter[k];
+        outFilter[k + 2 * filterSize] = outFilter[k];
+        outFilter[k + 3 * filterSize] = outFilter[k];
+    }
+
+    return Filter{
+        .coeffs = outFilter,
+        .pos = filterPos,
+        .size = filterSize,
+    };
+}
+
+fn roundToInt16(f: i64) i16 {
+    const r: i32 = @intCast((f + (1 << 15)) >> 16);
+    if (r < -0x7FFF) return @bitCast(@as(u16, 0x8000));
+    if (r > 0x7FFF) return 0x7FFF;
+    return @intCast(r);
+}
+
+fn clipUintp2_30(a: i32) i32 {
+    if ((a & ~@as(i32, (1 << 30) - 1)) != 0) {
+        return (~a) >> 31 & ((1 << 30) - 1);
+    }
+    return a;
+}
+
+const SwsContext = struct {
+    src_w: i32,
+    src_h: i32,
+    src_fmt: i32,
+    dst_w: i32,
+    dst_h: i32,
+    dst_fmt: i32,
+    algo: i32,
+
+    src_range: i32,
+    dst_range: i32,
+    full_chr_h_int: bool,
+
+    chr_src_h_sub: u5,
+    chr_src_v_sub: u5,
+    chr_dst_h_sub: u5,
+    chr_dst_v_sub: u5,
+    chr_src_w: i32,
+    chr_src_h: i32,
+    chr_dst_w: i32,
+    chr_dst_h: i32,
+    need_alpha: bool,
+    needs_hcscale: bool,
+    src_bpc: i32,
+
+    yuv2rgb_y_coeff: i32,
+    yuv2rgb_y_offset: i32,
+    yuv2rgb_v2r_coeff: i32,
+    yuv2rgb_v2g_coeff: i32,
+    yuv2rgb_u2g_coeff: i32,
+    yuv2rgb_u2b_coeff: i32,
+
+    // YUV2RGB tables (8-bit and 32-bit)
+    y_table8: [TABLE_PLANE_SIZE]u8,
+    y_table32: [TABLE_PLANE_SIZE * 3]u32,
+    rV_off: [CHROMA_TABLE_SIZE]isize,
+    gU_off: [CHROMA_TABLE_SIZE]isize,
+    bU_off: [CHROMA_TABLE_SIZE]isize,
+    gV_off: [CHROMA_TABLE_SIZE]isize,
+
+    // Filters for general scaling
+    h_lum: Filter,
+    h_chr: Filter,
+    v_lum: Filter,
+    v_chr: Filter,
+
+    // Scratch buffers for general scaling
+    lum_conv_buf: []i16,
+    alp_conv_buf: []i16,
+    chr_u_conv_buf: []i16,
+    chr_v_conv_buf: []i16,
+
+    lum_ring: []i16,
+    alp_ring: []i16,
+    chr_u_ring: []i16,
+    chr_v_ring: []i16,
+    lum_ring_size: usize,
+    chr_ring_size: usize,
+    lum_ring_stride: usize,
+    chr_ring_stride: usize,
+
+    fn initTables(self: *SwsContext) void {
+        const isRgb = (self.dst_fmt == PIXFMT_BGRA or self.dst_fmt == PIXFMT_BGR24);
+        const bpp: i32 = if (self.dst_fmt == PIXFMT_RGBA or self.dst_fmt == PIXFMT_BGRA) 32 else 24;
+        const fullRange = (self.src_range != 0);
+        const yoffs: isize = (if (fullRange) @as(isize, 384) else @as(isize, 326)) + @as(isize, TABLE_LUMA_HEADROOM);
+
+        var crv: i64 = 104597;
+        var cbu: i64 = 132201;
+        var cgu: i64 = -25675;
+        var cgv: i64 = -53279;
+        var cy: i64 = 1 << 16;
+        var oy: i64 = 0;
+
+        if (!fullRange) {
+            cy = @divTrunc(cy * 255, 219);
+            oy = 16 << 16;
+        } else {
+            crv = @divTrunc(crv * 224, 255);
+            cbu = @divTrunc(cbu * 224, 255);
+            cgu = @divTrunc(cgu * 224, 255);
+            cgv = @divTrunc(cgv * 224, 255);
+        }
+
+        const contrast: i64 = 1 << 16;
+        const saturation: i64 = 1 << 16;
+        cy = (cy * contrast) >> 16;
+        crv = (crv * contrast * saturation) >> 32;
+        cbu = (cbu * contrast * saturation) >> 32;
+        cgu = (cgu * contrast * saturation) >> 32;
+        cgv = (cgv * contrast * saturation) >> 32;
+
+        self.yuv2rgb_y_coeff = roundToInt16(cy * (1 << 13));
+        self.yuv2rgb_y_offset = roundToInt16(oy * (1 << 9));
+        self.yuv2rgb_v2r_coeff = roundToInt16(crv * (1 << 13));
+        self.yuv2rgb_v2g_coeff = roundToInt16(cgv * (1 << 13));
+        self.yuv2rgb_u2g_coeff = roundToInt16(cgu * (1 << 13));
+        self.yuv2rgb_u2b_coeff = roundToInt16(cbu * (1 << 13));
+
+        crv = @divTrunc((crv * (1 << 16)) + 0x8000, @max(cy, 1));
+        cbu = @divTrunc((cbu * (1 << 16)) + 0x8000, @max(cy, 1));
+        cgu = @divTrunc((cgu * (1 << 16)) + 0x8000, @max(cy, 1));
+        cgv = @divTrunc((cgv * (1 << 16)) + 0x8000, @max(cy, 1));
+
+        // Populate 24-bit y_table8
+        var yb: i64 = -(384 << 16) - @as(i64, TABLE_LUMA_HEADROOM) * cy - oy;
+        for (0..TABLE_PLANE_SIZE) |i| {
+            self.y_table8[i] = clipU8(@intCast((yb + 0x8000) >> 16));
+            yb += cy;
+        }
+
+        // Populate 32-bit y_table32
+        const rbase: u5 = if (isRgb) 16 else 0;
+        const gbase: u5 = 8;
+        const bbase: u5 = if (isRgb) 0 else 16;
+        const needAlpha = isAlpha(self.src_fmt);
+        const abase: u5 = 24;
+        yb = -(384 << 16) - @as(i64, TABLE_LUMA_HEADROOM) * cy - oy;
+        for (0..TABLE_PLANE_SIZE) |i| {
+            const yval: u32 = clipU8(@intCast((yb + 0x8000) >> 16));
+            self.y_table32[i] = (yval << rbase) + (if (needAlpha) @as(u32, 0) else (@as(u32, 255) << abase));
+            self.y_table32[i + TABLE_PLANE_SIZE] = yval << gbase;
+            self.y_table32[i + 2 * TABLE_PLANE_SIZE] = yval << bbase;
+            yb += cy;
+        }
+
+        const off_rV: isize = @intCast(-(crv >> 9));
+        const off_gU: isize = @intCast(-(cgu >> 9));
+        const off_bU: isize = @intCast(-(cbu >> 9));
+        const off_gV: isize = @intCast(-(cgv >> 9));
+
+        const gU_plane_off: isize = if (bpp == 32) @as(isize, TABLE_PLANE_SIZE) else 0;
+        const bU_plane_off: isize = if (bpp == 32) @as(isize, 2 * TABLE_PLANE_SIZE) else 0;
+
+        for (0..CHROMA_TABLE_SIZE) |i| {
+            const c_idx: i64 = @intCast(clipU8(@as(i32, @intCast(i)) - @as(i32, TABLE_HEADROOM)));
+            self.rV_off[i] = yoffs + off_rV + @as(isize, @intCast((c_idx * crv) >> 16));
+            self.gU_off[i] = yoffs + gU_plane_off + off_gU + @as(isize, @intCast((c_idx * cgu) >> 16));
+            self.bU_off[i] = yoffs + bU_plane_off + off_bU + @as(isize, @intCast((c_idx * cbu) >> 16));
+            self.gV_off[i] = off_gV + @as(isize, @intCast((c_idx * cgv) >> 16));
+        }
+    }
+};
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w < 1 or src_h < 1 or dst_w < 1 or dst_h < 1) return null;
+    if (src_fmt < 0 or src_fmt > 9 or dst_fmt < 0 or dst_fmt > 9) return null;
+    if (algo < 0 or algo > 2) return null;
+
+    const alloc = std.heap.c_allocator;
+    const ctx = alloc.create(SwsContext) catch return null;
+    errdefer alloc.destroy(ctx);
+
+    const src_range: i32 = if (src_fmt == PIXFMT_GRAY8) 1 else 0;
+    const dst_range: i32 = if (dst_fmt == PIXFMT_GRAY8) 1 else 0;
+
+    var chr_src_h_sub: u5 = 0;
+    var chr_src_v_sub: u5 = 0;
+    var chr_dst_h_sub: u5 = 0;
+    var chr_dst_v_sub: u5 = 0;
+    getSubSample(src_fmt, &chr_src_h_sub, &chr_src_v_sub);
+    getSubSample(dst_fmt, &chr_dst_h_sub, &chr_dst_v_sub);
+
+    var full_chr_h_int: bool = false;
+    if (isAnyRGB(dst_fmt)) {
+        if ((dst_w & 1) != 0) {
+            full_chr_h_int = true;
+        }
+        if (chr_src_h_sub == 0 and chr_src_v_sub == 0) {
+            full_chr_h_int = true;
+        }
+    }
+
+    if (isAnyRGB(dst_fmt) and !full_chr_h_int) {
+        chr_dst_h_sub = 1;
+    }
+    if (isAnyRGB(src_fmt) and ((dst_w >> chr_dst_h_sub) <= (src_w >> 1))) {
+        chr_src_h_sub = 1;
+    }
+
+    const chr_src_w = ceilRshift(src_w, chr_src_h_sub);
+    const chr_src_h = ceilRshift(src_h, chr_src_v_sub);
+    const chr_dst_w = ceilRshift(dst_w, chr_dst_h_sub);
+    const chr_dst_h = ceilRshift(dst_h, chr_dst_v_sub);
+
+    const lumXInc: i32 = @intCast(@divTrunc((@as(i64, src_w) << 16) + (dst_w >> 1), dst_w));
+    const lumYInc: i32 = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+    const chrXInc: i32 = @intCast(@divTrunc((@as(i64, chr_src_w) << 16) + (chr_dst_w >> 1), chr_dst_w));
+    const chrYInc: i32 = @intCast(@divTrunc((@as(i64, chr_src_h) << 16) + (chr_dst_h >> 1), chr_dst_h));
+
+    const h_lum = buildFilter(alloc, lumXInc, src_w, dst_w, 1, 1 << 14, algo, 128, 128) catch return null;
+    errdefer {
+        alloc.free(h_lum.coeffs);
+        alloc.free(h_lum.pos);
+    }
+    const h_chr = buildFilter(alloc, chrXInc, chr_src_w, chr_dst_w, 1, 1 << 14, algo, 128, 128) catch return null;
+    errdefer {
+        alloc.free(h_chr.coeffs);
+        alloc.free(h_chr.pos);
+    }
+    const v_lum = buildFilter(alloc, lumYInc, src_h, dst_h, 1, 1 << 12, algo, 128, 128) catch return null;
+    errdefer {
+        alloc.free(v_lum.coeffs);
+        alloc.free(v_lum.pos);
+    }
+    const v_chr = buildFilter(alloc, chrYInc, chr_src_h, chr_dst_h, 1, 1 << 12, algo, 128, 128) catch return null;
+    errdefer {
+        alloc.free(v_chr.coeffs);
+        alloc.free(v_chr.pos);
+    }
+
+    const u_src_w: usize = @intCast(src_w);
+    const u_chr_src_w: usize = @intCast(chr_src_w);
+    const u_dst_w: usize = @intCast(dst_w);
+    const u_chr_dst_w: usize = @intCast(chr_dst_w);
+
+    const lum_ring_size = std.math.ceilPowerOfTwo(usize, v_lum.size + 4) catch return null;
+    const chr_ring_size = std.math.ceilPowerOfTwo(usize, v_chr.size + 4) catch return null;
+    const lum_ring_stride = (u_dst_w + 15) & ~@as(usize, 15);
+    const chr_ring_stride = (u_chr_dst_w + 15) & ~@as(usize, 15);
+
+    const lum_conv_buf = alloc.alloc(i16, u_src_w + 16) catch return null;
+    errdefer alloc.free(lum_conv_buf);
+    const alp_conv_buf = alloc.alloc(i16, u_src_w + 16) catch return null;
+    errdefer alloc.free(alp_conv_buf);
+    const chr_u_conv_buf = alloc.alloc(i16, u_chr_src_w + 16) catch return null;
+    errdefer alloc.free(chr_u_conv_buf);
+    const chr_v_conv_buf = alloc.alloc(i16, u_chr_src_w + 16) catch return null;
+    errdefer alloc.free(chr_v_conv_buf);
+
+    const lum_ring = alloc.alloc(i16, lum_ring_size * lum_ring_stride) catch return null;
+    errdefer alloc.free(lum_ring);
+    const alp_ring = alloc.alloc(i16, lum_ring_size * lum_ring_stride) catch return null;
+    errdefer alloc.free(alp_ring);
+    const chr_u_ring = alloc.alloc(i16, chr_ring_size * chr_ring_stride) catch return null;
+    errdefer alloc.free(chr_u_ring);
+    const chr_v_ring = alloc.alloc(i16, chr_ring_size * chr_ring_stride) catch return null;
+    errdefer alloc.free(chr_v_ring);
+
+    @memset(lum_ring, 1 << 14);
+    @memset(alp_ring, 1 << 14);
+    @memset(chr_u_ring, 1 << 14);
+    @memset(chr_v_ring, 1 << 14);
+
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .src_range = src_range,
+        .dst_range = dst_range,
+        .full_chr_h_int = full_chr_h_int,
+        .chr_src_h_sub = chr_src_h_sub,
+        .chr_src_v_sub = chr_src_v_sub,
+        .chr_dst_h_sub = chr_dst_h_sub,
+        .chr_dst_v_sub = chr_dst_v_sub,
+        .chr_src_w = chr_src_w,
+        .chr_src_h = chr_src_h,
+        .chr_dst_w = chr_dst_w,
+        .chr_dst_h = chr_dst_h,
+        .need_alpha = isAlpha(src_fmt) and isAlpha(dst_fmt),
+        .needs_hcscale = !(isGray(src_fmt) or isGray(dst_fmt)),
+        .src_bpc = if (isAnyRGB(src_fmt)) 16 else 8,
+        .yuv2rgb_y_coeff = 0,
+        .yuv2rgb_y_offset = 0,
+        .yuv2rgb_v2r_coeff = 0,
+        .yuv2rgb_v2g_coeff = 0,
+        .yuv2rgb_u2g_coeff = 0,
+        .yuv2rgb_u2b_coeff = 0,
+        .y_table8 = undefined,
+        .y_table32 = undefined,
+        .rV_off = undefined,
+        .gU_off = undefined,
+        .bU_off = undefined,
+        .gV_off = undefined,
+        .h_lum = h_lum,
+        .h_chr = h_chr,
+        .v_lum = v_lum,
+        .v_chr = v_chr,
+        .lum_conv_buf = lum_conv_buf,
+        .alp_conv_buf = alp_conv_buf,
+        .chr_u_conv_buf = chr_u_conv_buf,
+        .chr_v_conv_buf = chr_v_conv_buf,
+        .lum_ring = lum_ring,
+        .alp_ring = alp_ring,
+        .chr_u_ring = chr_u_ring,
+        .chr_v_ring = chr_v_ring,
+        .lum_ring_size = lum_ring_size,
+        .chr_ring_size = chr_ring_size,
+        .lum_ring_stride = lum_ring_stride,
+        .chr_ring_stride = chr_ring_stride,
+    };
+
+    ctx.initTables();
+
+    return @ptrCast(ctx);
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const alloc = std.heap.c_allocator;
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        alloc.free(ctx.h_lum.coeffs);
+        alloc.free(ctx.h_lum.pos);
+        alloc.free(ctx.h_chr.coeffs);
+        alloc.free(ctx.h_chr.pos);
+        alloc.free(ctx.v_lum.coeffs);
+        alloc.free(ctx.v_lum.pos);
+        alloc.free(ctx.v_chr.coeffs);
+        alloc.free(ctx.v_chr.pos);
+        alloc.free(ctx.lum_conv_buf);
+        alloc.free(ctx.alp_conv_buf);
+        alloc.free(ctx.chr_u_conv_buf);
+        alloc.free(ctx.chr_v_conv_buf);
+        alloc.free(ctx.lum_ring);
+        alloc.free(ctx.alp_ring);
+        alloc.free(ctx.chr_u_ring);
+        alloc.free(ctx.chr_v_ring);
+        alloc.destroy(ctx);
+    }
+}
+
+fn copyPlane(src: [*]const u8, src_stride: isize, dst: [*]u8, dst_stride: isize, width_bytes: usize, height: usize) void {
+    if (src_stride == dst_stride and src_stride == @as(isize, @intCast(width_bytes))) {
+        @memcpy(dst[0 .. width_bytes * height], src[0 .. width_bytes * height]);
+    } else {
+        var s = src;
+        var d = dst;
+        for (0..height) |_| {
+            @memcpy(d[0..width_bytes], s[0..width_bytes]);
+            s = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s))) + src_stride)));
+            d = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d))) + dst_stride)));
+        }
+    }
+}
+
+fn fillPlaneVal(dst: [*]u8, dst_stride: isize, width_bytes: usize, height: usize, val: u8) void {
+    var d = dst;
+    for (0..height) |_| {
+        @memset(d[0..width_bytes], val);
+        d = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d))) + dst_stride)));
+    }
+}
+
+fn ptrAdd(p: anytype, offset: isize) @TypeOf(p) {
+    return @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(p))) + offset)));
+}
