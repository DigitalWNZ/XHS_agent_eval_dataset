+inline fn storeRgb16Fmt(
+    comptime fmt: i32,
+    dst: [*]u8,
+    r: @Vector(16, u8),
+    g: @Vector(16, u8),
+    b: @Vector(16, u8),
+    a: @Vector(16, u8),
