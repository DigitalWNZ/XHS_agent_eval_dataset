+            fs_i32 = 1 + sizeFactor;
+        } else {
+            fs_i32 = 1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW);
+        }
+        fs_i32 = @min(fs_i32, srcW - 2);
+        fs_i32 = @max(fs_i32, 1);
+        filterSize = @intCast(fs_i32);
+
+        filter = try alloc.alloc(i64, u_dstW * filterSize);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * @as(i64, xInc)) >> 7) - ((@as(i64, srcPos) * 0x10000) >> 7);
+        for (0..u_dstW) |i| {
+            var xx: i32 = @intCast(@divTrunc(xDstInSrc - (@as(i64, @intCast(filterSize)) - 2) * (1 << 16), 1 << 17));
+            filterPos[i] = xx;
+            for (0..filterSize) |j| {
+                const diff: i64 = @intCast(@abs((@as(i64, xx) * (1 << 17)) - xDstInSrc));
+                var d: i64 = diff << 13;
+                if (xInc > (1 << 16)) {
+                    d = @divTrunc(d * dstW, srcW);
+                }
+                var coeff: i64 = 0;
+                if (algo == ALGO_BICUBIC) {
