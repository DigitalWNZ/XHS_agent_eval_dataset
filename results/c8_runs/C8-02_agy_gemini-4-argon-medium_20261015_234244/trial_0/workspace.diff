+
+                    const offs2 = computeChromaOffsets8(pu_2[i..][0..8].*, pv_2[i..][0..8].*);
+                    const y2_16: @Vector(16, i16) = @intCast(@as(@Vector(16, u8), py_2[2 * i ..][0..16].*));
+                    const r2 = evalYTable16Limited(y2_16 + offs2.dr16);
+                    const g2 = evalYTable16Limited(y2_16 + offs2.dg16);
+                    const b2 = evalYTable16Limited(y2_16 + offs2.db16);
+                    storeRgbRow16Dynamic(df, dst_2 + 2 * i * dbpp, r2, g2, b2, a_vec);
+                }
+            }
+            while (i < pairs) : (i += 1) {
+                writeRgbPair(ctx, dst_1, i, py_1[2 * i], py_1[2 * i + 1], pu_1[i], pv_1[i], 255, 255, false);
+                writeRgbPair(ctx, dst_2, i, py_2[2 * i], py_2[2 * i + 1], pu_2[i], pv_2[i], 255, 255, false);
