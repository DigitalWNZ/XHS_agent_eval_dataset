+            src1 = ptrAdd(src1, src_stride[0] * 2);
+            src2 = ptrAdd(src2, src_stride[0] * 2);
+            ydst1 = ptrAdd(ydst1, dst_stride[0] * 2);
+            ydst2 = ptrAdd(ydst2, dst_stride[0] * 2);
+            udst = ptrAdd(udst, dst_stride[1]);
+            vdst = ptrAdd(vdst, dst_stride[2]);
+        }
+        return true;
+    }
