+
+                const r2: @Vector(16, i32) = @intCast(row2.r);
+                const g2: @Vector(16, i32) = @intCast(row2.g);
+                const b2: @Vector(16, i32) = @intCast(row2.b);
+                const y2_val = ((r2 * @as(@Vector(16, i32), @splat(RY)) +
+                    g2 * @as(@Vector(16, i32), @splat(GY)) +
+                    b2 * @as(@Vector(16, i32), @splat(BY))) >> @splat(15)) + @as(@Vector(16, i32), @splat(16));
+                ydst2[2 * i ..][0..16].* = @as(@Vector(16, u8), @intCast(y2_val));
