+
+                    const r2 = evalYTable16Limited(y2_16 + offs.dr16);
+                    const g2 = evalYTable16Limited(y2_16 + offs.dg16);
+                    const b2 = evalYTable16Limited(y2_16 + offs.db16);
+                    storeRgbRow16Dynamic(df, dst_2 + 2 * i * dbpp, r2, g2, b2, a_vec);
+                }
+            } else {
+                while (i + 8 <= pairs) : (i += 8) {
+                    const offs1 = computeChromaOffsets8(pu_1[i..][0..8].*, pv_1[i..][0..8].*);
+                    const y1_16: @Vector(16, i16) = @intCast(@as(@Vector(16, u8), py_1[2 * i ..][0..16].*));
+                    const r1 = evalYTable16Limited(y1_16 + offs1.dr16);
+                    const g1 = evalYTable16Limited(y1_16 + offs1.dg16);
+                    const b1 = evalYTable16Limited(y1_16 + offs1.db16);
