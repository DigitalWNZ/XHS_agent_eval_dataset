+                    PIXFMT_RGBA => convertRgbToRgbRowFmt(PIXFMT_BGR24, PIXFMT_RGBA, s, d, w),
+                    PIXFMT_BGRA => convertRgbToRgbRowFmt(PIXFMT_BGR24, PIXFMT_BGRA, s, d, w),
