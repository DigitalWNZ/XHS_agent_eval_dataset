+                const gx = (@shuffle(i32, g_sum, undefined, even_mask) + @shuffle(i32, g_sum, undefined, odd_mask)) >> @splat(2);
+                const bx = (@shuffle(i32, b_sum, undefined, even_mask) + @shuffle(i32, b_sum, undefined, odd_mask)) >> @splat(2);
