diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,47 @@
+WITH valid_words AS (
+  SELECT wordid
+  FROM senses
+  GROUP BY wordid
+  HAVING COUNT(DISTINCT synsetid) >= 2
+),
+synset_counts AS (
+  SELECT
+    s.wordid,
+    s.synsetid,
+    COUNT(*) AS sense_cnt,
+    syn.domainid,
+    syn.posid
+  FROM senses s
+  JOIN valid_words vw ON s.wordid = vw.wordid
+  JOIN synsets syn ON s.synsetid = syn.synsetid
+  GROUP BY s.wordid, s.synsetid
+),
+word_aggregates AS (
+  SELECT
+    wordid,
+    COUNT(*) AS total_synsets,
+    SUM(sense_cnt) AS total_senses,
+    COUNT(DISTINCT domainid) AS distinct_domains,
+    COUNT(DISTINCT posid) AS distinct_posids
+  FROM synset_counts
+  GROUP BY wordid
+  HAVING distinct_domains >= 2
+),
+top500 AS (
+  SELECT *
+  FROM word_aggregates
+  ORDER BY total_senses DESC, total_synsets DESC, distinct_domains DESC, wordid ASC
+  LIMIT 500
+)
+SELECT
+  t.wordid AS word_id,
+  w.word AS word,
+  t.total_synsets,
+  t.total_senses,
+  t.distinct_domains,
+  t.distinct_posids,
+  (SELECT sc.synsetid FROM synset_counts sc WHERE sc.wordid = t.wordid ORDER BY sc.sense_cnt DESC, sc.synsetid ASC LIMIT 1) AS top_synsetid,
+  (SELECT sc.sense_cnt FROM synset_counts sc WHERE sc.wordid = t.wordid ORDER BY sc.sense_cnt DESC, sc.synsetid ASC LIMIT 1) AS top_synset_sense_count
+FROM top500 t
+JOIN words w ON w.wordid = t.wordid
+ORDER BY t.total_senses DESC, t.total_synsets DESC, t.distinct_domains DESC, t.wordid ASC;
