--- /dev/null
+++ b/swscale-impl/src/filter.zig
@@ -0,0 +1,297 @@
+// filter.zig — scaler coefficient generation, following libswscale's initFilter()
+// (filterAlign = 1, no user src/dst vectors) so that positions, sizes and rounding
+// of the fixed-point taps come out identical.
+
+const std = @import("std");
+
+pub const ALGO_NEAREST = 0;
+pub const ALGO_BILINEAR = 1;
+pub const ALGO_BICUBIC = 2;
+
+pub const Filter = struct {
+    size: usize,
+    pos: []i32, // dstW entries
+    coef: []i16, // dstW * size entries
+    identity: bool,
+    // vector layout: outputs padded to a multiple of 8, taps grouped in pairs;
+    // cpair[(blk*np + q)*8 + t] holds taps (2q, 2q+1) of output blk*8+t as two i16.
+    np: usize = 0,
+    pos_pad: []i32 = &.{},
+    pat: []u8 = &.{}, // per 8-output block: index+1 into PATTERNS, 0 = irregular
+    cpair: []u32 = &.{},
+
+    pub fn deinit(self: *Filter, a: std.mem.Allocator) void {
+        a.free(self.pos);
+        a.free(self.coef);
+        if (self.pos_pad.len > 0) a.free(self.pos_pad);
+        if (self.cpair.len > 0) a.free(self.cpair);
+        if (self.pat.len > 0) a.free(self.pat);
+    }
+
+    pub fn prepVec(self: *Filter, a: std.mem.Allocator) !void {
+        const dw = self.pos.len;
+        const nb = (dw + 7) / 8;
+        const np = (self.size + 1) / 2;
+        self.np = np;
+        self.pos_pad = try a.alloc(i32, nb * 8);
+        self.cpair = try a.alloc(u32, nb * np * 8);
+        self.pat = try a.alloc(u8, nb);
+        for (0..nb) |b| {
+            self.pat[b] = 0;
+            if (b * 8 + 8 > dw) continue;
+            const p0 = self.pos[b * 8];
+            for (PATTERNS, 0..) |pt, pi| {
+                var ok = true;
+                for (0..8) |t| {
+                    if (self.pos[b * 8 + t] - p0 != pt[t]) ok = false;
+                }
+                if (ok and @as(usize, pt[7]) + 2 * np + 1 <= 32) {
+                    self.pat[b] = @intCast(pi + 1);
+                    break;
+                }
+            }
+        }
+        for (0..nb * 8) |i| {
+            const ii = @min(i, dw - 1);
+            self.pos_pad[i] = self.pos[ii];
+            for (0..np) |q| {
+                var lo: i16 = 0;
+                var hi: i16 = 0;
+                if (i < dw) {
+                    lo = self.coef[i * self.size + 2 * q];
+                    if (2 * q + 1 < self.size) hi = self.coef[i * self.size + 2 * q + 1];
+                }
+                const v: u32 = @as(u32, @as(u16, @bitCast(lo))) | (@as(u32, @as(u16, @bitCast(hi))) << 16);
+                self.cpair[((i / 8) * np + q) * 8 + (i % 8)] = v;
+            }
+        }
+    }
+};
+
+fn avLog2(v: u32) i32 {
+    if (v == 0) return 0;
+    return 31 - @as(i32, @clz(v));
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    return if (a >= 0) @divTrunc(a + (b >> 1), b) else @divTrunc(a - (b >> 1), b);
+}
+
+pub fn localPos(chr_subsample: u5, pos_in: i32) i32 {
+    var pos = pos_in;
+    if (pos == -1 or pos <= -513) pos = (@as(i32, 128) << chr_subsample) - 128;
+    pos += 128;
+    return pos >> chr_subsample;
+}
+
+pub fn initFilter(a: std.mem.Allocator, xInc: i64, srcW_: i32, dstW_: i32, one: i64, algo: i32, srcPos: i32, dstPos: i32) !Filter {
+    const srcW: i64 = srcW_;
+    const dstW: usize = @intCast(dstW_);
+    const fone: i64 = @as(i64, 1) << @intCast(54 - @min(avLog2(@intCast(@divTrunc(srcW_, dstW_))), 8));
+
+    const pos = try a.alloc(i32, dstW);
+    errdefer a.free(pos);
+    var filterSize: usize = 1;
+    var filter: []i64 = undefined;
+
+    if (@abs(xInc - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try a.alloc(i64, dstW);
+        for (0..dstW) |i| {
+            filter[i] = fone;
+            pos[i] = @intCast(i);
+        }
+    } else if (algo == ALGO_NEAREST) {
+        filterSize = 1;
+        filter = try a.alloc(i64, dstW);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * xInc) >> 8) - ((@as(i64, srcPos) * 0x8000) >> 7);
+        for (0..dstW) |i| {
+            const xx: i64 = (xDstInSrc + (1 << 15)) >> 16;
+            pos[i] = @intCast(xx);
+            filter[i] = fone;
+            xDstInSrc += xInc;
+        }
+    } else {
+        const sizeFactor: i64 = if (algo == ALGO_BICUBIC) 4 else 2;
+        var fs: i64 = undefined;
+        if (xInc <= 1 << 16) {
+            fs = 1 + sizeFactor;
+        } else {
+            fs = 1 + @divTrunc(sizeFactor * srcW + @as(i64, @intCast(dstW)) - 1, @as(i64, @intCast(dstW)));
+        }
+        fs = @min(fs, srcW - 2);
+        fs = @max(fs, 1);
+        filterSize = @intCast(fs);
+        filter = try a.alloc(i64, dstW * filterSize);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * xInc) >> 7) - ((@as(i64, srcPos) * 0x10000) >> 7);
+        const B: i64 = 0;
+        const C: i64 = @intFromFloat(0.6 * @as(f64, 1 << 24));
+        for (0..dstW) |i| {
+            var xx: i64 = @divTrunc(xDstInSrc - (fs - 2) * (1 << 16), 1 << 17);
+            pos[i] = @intCast(xx);
+            for (0..filterSize) |j| {
+                var d: i64 = @as(i64, @intCast(@abs(xx * (1 << 17) - xDstInSrc))) << 13;
+                if (xInc > 1 << 16) d = @divTrunc(d * @as(i64, @intCast(dstW)), srcW);
+                var coeff: i64 = 0;
+                if (algo == ALGO_BICUBIC) {
+                    if (d >= @as(i64, 1) << 31) {
+                        coeff = 0;
+                    } else {
+                        const dd = (d * d) >> 30;
+                        const ddd = (dd * d) >> 30;
+                        if (d < @as(i64, 1) << 30) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * filterSize + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * xInc;
+        }
+    }
+    defer a.free(filter);
+
+    // step 1: find the reduced size, shifting near-zero leading taps away
+    const f2 = filterSize;
+    const cutLimit: f64 = 0.002 * @as(f64, @floatFromInt(fone));
+    var minFilterSize: usize = 0;
+    var ii: isize = @as(isize, @intCast(dstW)) - 1;
+    while (ii >= 0) : (ii -= 1) {
+        const i: usize = @intCast(ii);
+        var min: usize = f2;
+        var cutOff: i64 = 0;
+        const row = filter[i * f2 .. (i + 1) * f2];
+        for (0..f2) |_| {
+            cutOff += @intCast(@abs(row[0]));
+            if (@as(f64, @floatFromInt(cutOff)) > cutLimit) break;
+            if (i < dstW - 1 and pos[i] >= pos[i + 1]) break;
+            var k: usize = 1;
+            while (k < f2) : (k += 1) row[k - 1] = row[k];
+            row[f2 - 1] = 0;
+            pos[i] += 1;
+        }
+        cutOff = 0;
+        var j: usize = f2 - 1;
+        while (j > 0) : (j -= 1) {
+            cutOff += @intCast(@abs(row[j]));
+            if (@as(f64, @floatFromInt(cutOff)) > cutLimit) break;
+            min -= 1;
+        }
+        if (min > minFilterSize) minFilterSize = min;
+    }
+
+    const fsz = minFilterSize;
+    const f3 = try a.alloc(i64, dstW * fsz);
+    defer a.free(f3);
+    for (0..dstW) |i| {
+        for (0..fsz) |j| {
+            f3[i * fsz + j] = if (j >= f2) 0 else filter[i * f2 + j];
+        }
+    }
+
+    // fix borders
+    for (0..dstW) |i| {
+        const row = f3[i * fsz .. (i + 1) * fsz];
+        if (pos[i] < 0) {
+            var j: usize = 1;
+            while (j < fsz) : (j += 1) {
+                const left: usize = @intCast(@max(@as(i64, @intCast(j)) + pos[i], 0));
+                row[left] += row[j];
+                row[j] = 0;
+            }
+            pos[i] = 0;
+        }
+        if (@as(i64, pos[i]) + @as(i64, @intCast(fsz)) > srcW) {
+            const shift: i64 = @as(i64, pos[i]) + @min(@as(i64, @intCast(fsz)) - srcW, 0);
+            var acc: i64 = 0;
+            var j: isize = @as(isize, @intCast(fsz)) - 1;
+            while (j >= 0) : (j -= 1) {
+                if (@as(i64, pos[i]) + j >= srcW) {
+                    acc += row[@intCast(j)];
+                    row[@intCast(j)] = 0;
+                }
+            }
+            j = @as(isize, @intCast(fsz)) - 1;
+            while (j >= 0) : (j -= 1) {
+                if (j < shift) {
+                    row[@intCast(j)] = 0;
+                } else {
+                    row[@intCast(j)] = row[@intCast(j - shift)];
+                }
+            }
+            pos[i] -= @intCast(shift);
+            row[@intCast(srcW - 1 - pos[i])] += acc;
+        }
+    }
+
+    // normalize
+    const coef = try a.alloc(i16, dstW * fsz);
+    for (0..dstW) |i| {
+        const row = f3[i * fsz .. (i + 1) * fsz];
+        var sum: i64 = 0;
+        for (row) |v| sum += v;
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        var err: i64 = 0;
+        for (0..fsz) |j| {
+            const v = row[j] + err;
+            const intV = roundedDiv(v, sum);
+            coef[i * fsz + j] = @truncate(intV);
+            err = v - intV * sum;
+        }
+    }
+
+    var identity = fsz == 1 and dstW_ == srcW_;
+    if (identity) {
+        for (0..dstW) |i| {
+            if (pos[i] != @as(i32, @intCast(i)) or coef[i] != one) {
+                identity = false;
+                break;
+            }
+        }
+    }
+    return .{ .size = fsz, .pos = pos, .coef = coef, .identity = identity };
+}
+
+fn genPatterns() [][8]u8 {
+    @setEvalBranchQuota(100000);
+    const ratios = [_][2]u32{ .{ 1, 1 }, .{ 2, 1 }, .{ 3, 1 }, .{ 1, 2 }, .{ 2, 3 }, .{ 4, 3 }, .{ 3, 2 }, .{ 3, 4 } };
+    var out: [64][8]u8 = undefined;
+    var n: usize = 0;
+    for (ratios) |r| {
+        for (0..r[1]) |ph| {
+            var d: [8]u8 = undefined;
+            for (0..8) |t| d[t] = @intCast((t * r[0] + ph) / r[1] - ph / r[1]);
+            var dup = false;
+            for (out[0..n]) |e| {
+                if (std.mem.eql(u8, &e, &d)) dup = true;
+            }
+            if (!dup) {
+                out[n] = d;
+                n += 1;
+            }
+        }
+    }
+    return out[0..n];
+}
+
+pub const PATTERNS: []const [8]u8 = blk: {
+    const p = genPatterns();
+    var arr: [p.len][8]u8 = undefined;
+    for (p, 0..) |e, i| arr[i] = e;
+    const final = arr;
+    break :blk &final;
+};
