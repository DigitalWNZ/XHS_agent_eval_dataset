diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,57 @@
+WITH multi_words AS (
+  SELECT wordid
+  FROM senses
+  GROUP BY wordid
+  HAVING COUNT(*) >= 2
+),
+word_stats AS (
+  SELECT
+    s.wordid,
+    COUNT(DISTINCT s.synsetid) AS total_synsets,
+    COUNT(*) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids
+  FROM senses s
+  CROSS JOIN multi_words mw ON s.wordid = mw.wordid
+  CROSS JOIN synsets syn ON s.synsetid = syn.synsetid
+  GROUP BY s.wordid
+  HAVING total_synsets >= 2
+    AND distinct_domains >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    s.wordid ASC
+  LIMIT 500
+),
+top_synset AS (
+  SELECT
+    ws.wordid,
+    ws.synsetid AS top_synsetid,
+    MAX(ws.cnt) AS top_synset_sense_count
+  FROM (
+    SELECT s.wordid, s.synsetid, COUNT(*) AS cnt
+    FROM senses s
+    CROSS JOIN word_stats wstat ON s.wordid = wstat.wordid
+    GROUP BY s.wordid, s.synsetid
+    ORDER BY s.wordid, cnt DESC, s.synsetid ASC
+  ) ws
+  GROUP BY ws.wordid
+)
+SELECT
+  ws.wordid AS word_id,
+  w.word AS word,
+  ws.total_synsets,
+  ws.total_senses,
+  ws.distinct_domains,
+  ws.distinct_posids,
+  ts.top_synsetid,
+  ts.top_synset_sense_count
+FROM word_stats ws
+CROSS JOIN top_synset ts ON ws.wordid = ts.wordid
+CROSS JOIN words w ON ws.wordid = w.wordid
+ORDER BY
+  ws.total_senses DESC,
+  ws.total_synsets DESC,
+  ws.distinct_domains DESC,
+  word_id ASC;
