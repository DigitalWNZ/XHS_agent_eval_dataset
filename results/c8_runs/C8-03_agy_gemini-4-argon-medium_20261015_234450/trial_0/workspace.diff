diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,57 @@
+WITH word_counts AS MATERIALIZED (
+  SELECT wordid, COUNT(*) AS total_senses
+  FROM senses
+  GROUP BY wordid
+  HAVING total_senses >= 2
+),
+cand_words AS MATERIALIZED (
+  SELECT wordid
+  FROM word_counts
+  WHERE total_senses >= COALESCE(
+    (SELECT total_senses FROM word_counts ORDER BY total_senses DESC LIMIT 1 OFFSET 600),
+    2
+  )
+),
+cand_senses AS MATERIALIZED (
+  SELECT s.wordid, s.synsetid, COUNT(*) AS syn_sense_cnt
+  FROM senses s
+  CROSS JOIN cand_words cw ON s.wordid = cw.wordid
+  GROUP BY s.wordid, s.synsetid
+),
+word_stats AS MATERIALIZED (
+  SELECT
+    cs.wordid,
+    COUNT(*) AS total_synsets,
+    SUM(cs.syn_sense_cnt) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids,
+    cs.synsetid AS top_synsetid,
+    cs.syn_sense_cnt AS top_synset_sense_count,
+    MAX((cs.syn_sense_cnt << 30) - cs.synsetid)
+  FROM synsets syn
+  CROSS JOIN cand_senses cs ON syn.synsetid = cs.synsetid
+  GROUP BY cs.wordid
+  HAVING total_synsets >= 2 AND distinct_domains >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    cs.wordid ASC
+  LIMIT 500
+)
+SELECT
+  ws.wordid AS word_id,
+  w.word AS word,
+  ws.total_synsets,
+  ws.total_senses,
+  ws.distinct_domains,
+  ws.distinct_posids,
+  ws.top_synsetid,
+  ws.top_synset_sense_count
+FROM words w
+CROSS JOIN word_stats ws ON w.wordid = ws.wordid
+ORDER BY
+  ws.total_senses DESC,
+  ws.total_synsets DESC,
+  ws.distinct_domains DESC,
+  word_id ASC;
