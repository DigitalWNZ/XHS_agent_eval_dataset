diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,61 @@
+WITH multi_words AS (
+  SELECT wordid
+  FROM senses
+  GROUP BY wordid
+  HAVING COUNT(*) >= 2
+),
+top_words AS (
+  SELECT 
+    s.wordid,
+    COUNT(DISTINCT s.synsetid) AS total_synsets,
+    COUNT(*) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids
+  FROM senses s
+  CROSS JOIN multi_words m ON s.wordid = m.wordid
+  CROSS JOIN synsets syn ON s.synsetid = syn.synsetid
+  GROUP BY s.wordid
+  HAVING total_synsets >= 2
+    AND distinct_domains >= 2 
+    AND total_senses >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    s.wordid ASC
+  LIMIT 500
+),
+ranked_synsets AS (
+  SELECT wordid, synsetid, cnt
+  FROM (
+    SELECT 
+      s.wordid,
+      s.synsetid,
+      COUNT(*) AS cnt,
+      ROW_NUMBER() OVER (
+        PARTITION BY s.wordid 
+        ORDER BY COUNT(*) DESC, s.synsetid ASC
+      ) AS rn
+    FROM senses s
+    JOIN top_words t ON s.wordid = t.wordid
+    GROUP BY s.wordid, s.synsetid
+  )
+  WHERE rn = 1
+)
+SELECT 
+  t.wordid AS word_id,
+  w.word,
+  t.total_synsets,
+  t.total_senses,
+  t.distinct_domains,
+  t.distinct_posids,
+  r.synsetid AS top_synsetid,
+  r.cnt AS top_synset_sense_count
+FROM words w
+CROSS JOIN top_words t ON w.wordid = t.wordid
+CROSS JOIN ranked_synsets r ON t.wordid = r.wordid
+ORDER BY
+  t.total_senses DESC,
+  t.total_synsets DESC,
+  t.distinct_domains DESC,
+  word_id ASC;
