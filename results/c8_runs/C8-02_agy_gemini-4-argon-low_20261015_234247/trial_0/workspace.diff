+    if (c.dst_bpp == 32) {
+        const d32: [*]u32 = @ptrCast(@alignCast(dest));
+        const r32: [*]const u32 = @ptrCast(@alignCast(r_ptr));
+        const g32: [*]const u32 = @ptrCast(@alignCast(g_ptr));
+        const b32: [*]const u32 = @ptrCast(@alignCast(b_ptr));
+        const r1 = @as([*]const u32, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(r32))) + @as(isize, Y1) * 4))))[0];
