+
+            if (need_lum_conv) {
+                lum_convert_row(c, c.conv_lum_mem, src_row0, src_w);
+                hScale16To15(hout_lum_row, dst_w, @ptrCast(c.conv_lum_mem.ptr), c.h_lum_filter, c.h_lum_filter_pos, h_lum_fsize);
