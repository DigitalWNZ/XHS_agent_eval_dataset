+    ctx.need_alpha = isALPHA(src_fmt) and isALPHA(dst_fmt);
+    ctx.needs_hcscale = !(isGray(src_fmt) or isGray(dst_fmt));
+
+    init_rgb2yuv_table(ctx);
+    init_palettes(ctx);
+    if (!isYUV(dst_fmt) and !isGray(dst_fmt)) {
