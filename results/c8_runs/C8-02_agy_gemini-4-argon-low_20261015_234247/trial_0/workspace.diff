+// ── General Scaled / Filtered Pipeline ──────────────────────────────────────
+
+fn lum_convert_row(c: *const SwsContext, dst: []i16, src: [*]const u8, width: usize) void {
+    const ry = c.input_rgb2yuv_table[RY_IDX];
+    const gy = c.input_rgb2yuv_table[GY_IDX];
+    const by = c.input_rgb2yuv_table[BY_IDX];
+    switch (c.src_fmt) {
+        PIXFMT_RGB24 => {
+            for (0..width) |i| {
+                const r: i32 = src[3 * i + 0];
+                const g: i32 = src[3 * i + 1];
+                const b: i32 = src[3 * i + 2];
+                dst[i] = @intCast((ry * r + gy * g + by * b + (32 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6));
+            }
+        },
+        PIXFMT_BGR24 => {
+            for (0..width) |i| {
+                const b: i32 = src[3 * i + 0];
+                const g: i32 = src[3 * i + 1];
+                const r: i32 = src[3 * i + 2];
+                dst[i] = @intCast((ry * r + gy * g + by * b + (32 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6));
+            }
+        },
+        PIXFMT_RGBA => {
+            for (0..width) |i| {
+                const r: i32 = src[4 * i + 0];
+                const g: i32 = src[4 * i + 1];
+                const b: i32 = src[4 * i + 2];
+                dst[i] = @intCast((ry * r + gy * g + by * b + (32 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6));
+            }
+        },
+        PIXFMT_BGRA => {
+            for (0..width) |i| {
+                const b: i32 = src[4 * i + 0];
+                const g: i32 = src[4 * i + 1];
+                const r: i32 = src[4 * i + 2];
+                dst[i] = @intCast((ry * r + gy * g + by * b + (32 << (RGB2YUV_SHIFT - 1)) + (1 << (RGB2YUV_SHIFT - 7))) >> (RGB2YUV_SHIFT - 6));
+            }
+        },
+        else => {},
+    }
+}
+
+fn alp_convert_row(dst: []i16, src: [*]const u8, width: usize) void {
+    for (0..width) |i| {
+        const a: i16 = src[4 * i + 3];
+        dst[i] = (a << 6) | (a >> 2);
+    }
+}
+
+fn chr_convert_row(c: *const SwsContext, dst_u: []i16, dst_v: []i16, src0: [*]const u8, src1: ?[*]const u8, width: usize) void {
+    const ru = c.input_rgb2yuv_table[RU_IDX];
