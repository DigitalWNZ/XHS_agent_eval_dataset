+    ctx.flags = flags;
+    ctx.chr_src_w = ceil_rshift(src_w, ctx.chr_src_h_sub);
+    ctx.chr_src_h = ceil_rshift(src_h, ctx.chr_src_v_sub);
+    ctx.chr_dst_w = ceil_rshift(dst_w, ctx.chr_dst_h_sub);
+    ctx.chr_dst_h = ceil_rshift(dst_h, ctx.chr_dst_v_sub);
+
+    ctx.lum_x_inc = @intCast(@divTrunc((@as(i64, src_w) << 16) + (dst_w >> 1), dst_w));
+    ctx.lum_y_inc = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+    ctx.chr_x_inc = @intCast(@divTrunc((@as(i64, ctx.chr_src_w) << 16) + (ctx.chr_dst_w >> 1), ctx.chr_dst_w));
+    ctx.chr_y_inc = @intCast(@divTrunc((@as(i64, ctx.chr_src_h) << 16) + (ctx.chr_dst_h >> 1), ctx.chr_dst_h));
