+        } else if ((src_fmt == PIXFMT_NV12 or src_fmt == PIXFMT_NV21) and dst_fmt == PIXFMT_YUV420P) {
+            ctx.unscaled_kind = .nv12_to_planar;
+        } else if (src_fmt == PIXFMT_YUV420P and isAnyRGB(dst_fmt) and (dst_h & 1) == 0) {
+            ctx.unscaled_kind = .yuv420p_to_rgb;
+        } else if (src_fmt == PIXFMT_YUV422P and isAnyRGB(dst_fmt) and (dst_h & 1) == 0) {
+            ctx.unscaled_kind = .yuv422p_to_rgb;
+        } else if (src_fmt == PIXFMT_BGR24 and dst_fmt == PIXFMT_YUV420P and (dst_w & 1) == 0) {
+            ctx.unscaled_kind = .bgr24_to_yv12;
+        } else if (isAnyRGB(src_fmt) and isAnyRGB(dst_fmt) and src_fmt != dst_fmt) {
+            ctx.unscaled_kind = .rgb_to_rgb;
+        } else if (usePal(src_fmt) and isAnyRGB(dst_fmt)) {
+            ctx.unscaled_kind = .pal_to_rgb;
+        } else if (src_fmt == dst_fmt or
+            (isPlanarYUV(src_fmt) and isGray(dst_fmt)) or
+            (isPlanarYUV(dst_fmt) and isGray(src_fmt)) or
+            (isGray(dst_fmt) and isGray(src_fmt)) or
+            (isPlanarYUV(src_fmt) and isPlanarYUV(dst_fmt) and
+                ctx.chr_dst_h_sub == ctx.chr_src_h_sub and
+                ctx.chr_dst_v_sub == ctx.chr_src_v_sub and
+                !isSemiPlanarYUV(src_fmt) and !isSemiPlanarYUV(dst_fmt)))
+        {
+            if (isPacked(src_fmt)) {
+                ctx.unscaled_kind = .packed_copy;
+            } else {
+                ctx.unscaled_kind = .planar_copy;
+            }
+        }
+    }
+
+    if (ctx.unscaled_kind != .none) {
+        return @ptrCast(ctx);
+    }
+
+    // Initialize filters for scaled path
+    initFilter(&ctx.h_lum_filter, &ctx.h_lum_filter_pos, &ctx.h_lum_filter_size, ctx.lum_x_inc, src_w, dst_w, 1, 1 << 14, flags, get_local_pos(0, 0), get_local_pos(0, 0)) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    initFilter(&ctx.h_chr_filter, &ctx.h_chr_filter_pos, &ctx.h_chr_filter_size, ctx.chr_x_inc, ctx.chr_src_w, ctx.chr_dst_w, 1, 1 << 14, flags, get_local_pos(ctx.chr_src_h_sub, -513), get_local_pos(ctx.chr_dst_h_sub, -513)) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    initFilter(&ctx.v_lum_filter, &ctx.v_lum_filter_pos, &ctx.v_lum_filter_size, ctx.lum_y_inc, src_h, dst_h, 1, 1 << 12, flags, get_local_pos(0, 0), get_local_pos(0, 0)) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    initFilter(&ctx.v_chr_filter, &ctx.v_chr_filter_pos, &ctx.v_chr_filter_size, ctx.chr_y_inc, ctx.chr_src_h, ctx.chr_dst_h, 1, 1 << 12, flags, get_local_pos(ctx.chr_src_v_sub, -513), get_local_pos(ctx.chr_dst_v_sub, -513)) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+
+    const hout_elems: usize = @intCast((dst_w + 31) & ~@as(i32, 15));
+    ctx.hout_line_elems = hout_elems;
+    ctx.lum_buf_lines = @intCast(src_h);
+    ctx.chr_buf_lines = @intCast(ctx.chr_src_h);
+
+    ctx.hout_lum_mem = allocator.alloc(i16, ctx.lum_buf_lines * hout_elems) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    ctx.hout_chr_u_mem = allocator.alloc(i16, ctx.chr_buf_lines * hout_elems) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    ctx.hout_chr_v_mem = allocator.alloc(i16, ctx.chr_buf_lines * hout_elems) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    @memset(ctx.hout_lum_mem, 1 << 14);
+    @memset(ctx.hout_chr_u_mem, 1 << 14);
+    @memset(ctx.hout_chr_v_mem, 1 << 14);
+
+    if (ctx.need_alpha) {
+        ctx.hout_alp_mem = allocator.alloc(i16, ctx.lum_buf_lines * hout_elems) catch {
+            swscale_destroy(ctx);
+            return null;
+        };
+        @memset(ctx.hout_alp_mem, 1 << 14);
+    }
+
+    const conv_elems: usize = @intCast((src_w + 31) & ~@as(i32, 15));
+    ctx.conv_lum_mem = allocator.alloc(i16, conv_elems) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    ctx.conv_chr_u_mem = allocator.alloc(i16, conv_elems) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    ctx.conv_chr_v_mem = allocator.alloc(i16, conv_elems) catch {
+        swscale_destroy(ctx);
+        return null;
+    };
+    if (ctx.need_alpha) {
+        ctx.conv_alp_mem = allocator.alloc(i16, conv_elems) catch {
+            swscale_destroy(ctx);
+            return null;
+        };
+    }
+
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+    const src = [4]?[*]const u8{ src_data[0], src_data[1], src_data[2], src_data[3] };
+    const s_str = [4]i32{ src_stride[0], src_stride[1], src_stride[2], src_stride[3] };
+    const dst = [4]?[*]u8{ dst_data[0], dst_data[1], dst_data[2], dst_data[3] };
+    const d_str = [4]i32{ dst_stride[0], dst_stride[1], dst_stride[2], dst_stride[3] };
+
+    switch (ctx.unscaled_kind) {
+        .planar_to_nv12 => run_planar_to_nv12(ctx, src, s_str, dst, d_str),
+        .nv12_to_planar => run_nv12_to_planar(ctx, src, s_str, dst, d_str),
+        .planar_copy => run_planar_copy(ctx, src, s_str, dst, d_str),
+        .packed_copy => run_packed_copy(ctx, src, s_str, dst, d_str),
+        .bgr24_to_yv12 => run_bgr24_to_yv12(ctx, src, s_str, dst, d_str),
+        .pal_to_rgb => run_pal_to_rgb(ctx, src, s_str, dst, d_str),
+        .rgb_to_rgb => run_rgb_to_rgb(ctx, src, s_str, dst, d_str),
+        .yuv420p_to_rgb => run_yuv2rgb_unscaled(ctx, src, s_str, dst, d_str, false),
+        .yuv422p_to_rgb => run_yuv2rgb_unscaled(ctx, src, s_str, dst, d_str, true),
+        .none => run_scaled_pipeline(ctx, src, s_str, dst, d_str),
+    }
+
+    return 0;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        if (ctx.yuv_table_mem) |m| allocator.free(m);
+        if (ctx.h_lum_filter.len > 0) allocator.free(ctx.h_lum_filter);
+        if (ctx.h_lum_filter_pos.len > 0) allocator.free(ctx.h_lum_filter_pos);
+        if (ctx.h_chr_filter.len > 0) allocator.free(ctx.h_chr_filter);
+        if (ctx.h_chr_filter_pos.len > 0) allocator.free(ctx.h_chr_filter_pos);
+        if (ctx.v_lum_filter.len > 0) allocator.free(ctx.v_lum_filter);
+        if (ctx.v_lum_filter_pos.len > 0) allocator.free(ctx.v_lum_filter_pos);
+        if (ctx.v_chr_filter.len > 0) allocator.free(ctx.v_chr_filter);
+        if (ctx.v_chr_filter_pos.len > 0) allocator.free(ctx.v_chr_filter_pos);
+        if (ctx.hout_lum_mem.len > 0) allocator.free(ctx.hout_lum_mem);
+        if (ctx.hout_chr_u_mem.len > 0) allocator.free(ctx.hout_chr_u_mem);
+        if (ctx.hout_chr_v_mem.len > 0) allocator.free(ctx.hout_chr_v_mem);
+        if (ctx.hout_alp_mem.len > 0) allocator.free(ctx.hout_alp_mem);
+        if (ctx.conv_lum_mem.len > 0) allocator.free(ctx.conv_lum_mem);
+        if (ctx.conv_chr_u_mem.len > 0) allocator.free(ctx.conv_chr_u_mem);
+        if (ctx.conv_chr_v_mem.len > 0) allocator.free(ctx.conv_chr_v_mem);
+        if (ctx.conv_alp_mem.len > 0) allocator.free(ctx.conv_alp_mem);
+        allocator.destroy(ctx);
+    }
+}
