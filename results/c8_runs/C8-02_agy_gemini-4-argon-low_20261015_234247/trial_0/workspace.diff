+        const g1 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(g_ptr))) + @as(isize, Y1)))))[0];
+        const b1 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(b_ptr))) + @as(isize, Y1)))))[0];
+        const r2 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(r_ptr))) + @as(isize, Y2)))))[0];
+        const g2 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(g_ptr))) + @as(isize, Y2)))))[0];
+        const b2 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(b_ptr))) + @as(isize, Y2)))))[0];
+        if (c.dst_fmt == PIXFMT_RGB24) {
+            dest[6 * i + 0] = r1;
+            dest[6 * i + 1] = g1;
+            dest[6 * i + 2] = b1;
+            dest[6 * i + 3] = r2;
+            dest[6 * i + 4] = g2;
+            dest[6 * i + 5] = b2;
+        } else {
+            dest[6 * i + 0] = b1;
+            dest[6 * i + 1] = g1;
+            dest[6 * i + 2] = r1;
+            dest[6 * i + 3] = b2;
+            dest[6 * i + 4] = g2;
+            dest[6 * i + 5] = r2;
+        }
+    }
