+inline fn yuv2rgb_write_full_px(c: *const SwsContext, dest: [*]u8, Y_in: i32, A: u8, U: i32, V: i32, has_alpha: bool) void {
+    var Y = Y_in - c.yuv2rgb_y_offset;
+    Y *%= c.yuv2rgb_y_coeff;
+    Y +%= 1 << 21;
+    var R: i32 = Y +% V *% c.yuv2rgb_v2r_coeff;
+    var G: i32 = Y +% V *% c.yuv2rgb_v2g_coeff +% U *% c.yuv2rgb_u2g_coeff;
+    var B: i32 = Y +% U *% c.yuv2rgb_u2b_coeff;
+    if (((R | G | B) & @as(i32, @bitCast(@as(u32, 0xC0000000)))) != 0) {
+        R = clip_uintp2_30(R);
+        G = clip_uintp2_30(G);
+        B = clip_uintp2_30(B);
+    }
+    switch (c.dst_fmt) {
+        PIXFMT_RGB24 => {
+            dest[0] = @intCast(@as(u32, @bitCast(R)) >> 22);
+            dest[1] = @intCast(@as(u32, @bitCast(G)) >> 22);
+            dest[2] = @intCast(@as(u32, @bitCast(B)) >> 22);
+        },
+        PIXFMT_BGR24 => {
+            dest[0] = @intCast(@as(u32, @bitCast(B)) >> 22);
+            dest[1] = @intCast(@as(u32, @bitCast(G)) >> 22);
+            dest[2] = @intCast(@as(u32, @bitCast(R)) >> 22);
+        },
+        PIXFMT_RGBA => {
+            dest[0] = @intCast(@as(u32, @bitCast(R)) >> 22);
+            dest[1] = @intCast(@as(u32, @bitCast(G)) >> 22);
+            dest[2] = @intCast(@as(u32, @bitCast(B)) >> 22);
+            dest[3] = if (has_alpha) A else 255;
+        },
+        PIXFMT_BGRA => {
+            dest[0] = @intCast(@as(u32, @bitCast(B)) >> 22);
+            dest[1] = @intCast(@as(u32, @bitCast(G)) >> 22);
+            dest[2] = @intCast(@as(u32, @bitCast(R)) >> 22);
+            dest[3] = if (has_alpha) A else 255;
+        },
+        else => {},
+    }
+}
