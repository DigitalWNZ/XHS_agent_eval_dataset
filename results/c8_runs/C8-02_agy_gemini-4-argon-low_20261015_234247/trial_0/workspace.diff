+                    } else {
+                        hScale16To15(hout_u_row, chr_dst_w, @ptrCast(c.conv_chr_u_mem.ptr), c.h_chr_filter, c.h_chr_filter_pos, h_chr_fsize);
+                        hScale16To15(hout_v_row, chr_dst_w, @ptrCast(c.conv_chr_v_mem.ptr), c.h_chr_filter, c.h_chr_filter_pos, h_chr_fsize);
+                    }
+                } else {
+                    hScale8To15(hout_u_row, chr_dst_w, src_row1.?, c.h_chr_filter, c.h_chr_filter_pos, h_chr_fsize);
+                    hScale8To15(hout_v_row, chr_dst_w, src_row2.?, c.h_chr_filter, c.h_chr_filter_pos, h_chr_fsize);
+                }
+
+                if (c.src_range != c.dst_range and !isAnyRGB(c.dst_fmt)) {
+                    if (c.src_range != 0) {
+                        chrRangeFromJpeg(hout_u_row, hout_v_row, chr_dst_w);
+                    } else {
+                        chrRangeToJpeg(hout_u_row, hout_v_row, chr_dst_w);
+                    }
+                }
+            }
+        }
+
+        // Gather vertical filter line pointers
+        for (0..v_lum_fsize) |j| {
+            const sy: usize = @intCast(first_lum_src_y + @as(i32, @intCast(j)));
+            lum_lines_buf[j] = c.hout_lum_mem.ptr + sy * c.hout_line_elems;
+            if (c.need_alpha) {
+                alp_lines_buf[j] = c.hout_alp_mem.ptr + sy * c.hout_line_elems;
+            }
+        }
+        for (0..v_chr_fsize) |j| {
+            const cy: usize = @intCast(first_chr_src_y + @as(i32, @intCast(j)));
+            u_lines_buf[j] = c.hout_chr_u_mem.ptr + cy * c.hout_line_elems;
+            v_lines_buf[j] = c.hout_chr_v_mem.ptr + cy * c.hout_line_elems;
+        }
+
+        // Vertical scale output
+        if (isPlanarYUV(c.dst_fmt) or isGray(c.dst_fmt)) {
+            const dst_row0 = @as([*]u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(dst[0].?))) + @as(isize, dst_y) * @as(isize, dst_stride[0])))));
+            const v_lum_f = c.v_lum_filter.ptr + dst_y_u * v_lum_fsize;
+            if (v_lum_fsize == 1) {
+                yuv2plane1_8(lum_lines_buf[0], dst_row0, dst_w, &sws_pb_64, 0);
+            } else {
+                yuv2planeX_8(v_lum_f, v_lum_fsize, lum_lines_buf[0..v_lum_fsize], dst_row0, dst_w, &sws_pb_64, 0);
+            }
