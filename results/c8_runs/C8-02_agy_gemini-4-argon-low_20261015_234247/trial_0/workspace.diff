+    const full_chr = (c.flags & SWS_FULL_CHR_H_INT) != 0;
+    const has_alpha = c.need_alpha;
+    const step: usize = if (c.dst_bpp == 24) 3 else 4;
+
+    if (lum_fsize == 1 and chr_fsize <= 2 and (chr_fsize == 1 or (chr_filter[0] + chr_filter[1] == 4096 and chr_filter[1] <= 4096))) {
+        const uvalpha: i32 = if (chr_fsize == 1) 0 else chr_filter[1];
+        const buf0 = lum_lines[0];
+        const ubuf0 = u_lines[0];
+        const vbuf0 = v_lines[0];
+        const abuf0 = if (has_alpha) alp_lines[0] else buf0;
+
+        if (full_chr) {
+            var d = dest;
+            if (uvalpha < 2048) {
+                for (0..dst_w) |i| {
+                    const Y: i32 = @as(i32, buf0[i]) * 4;
+                    const U: i32 = (@as(i32, ubuf0[i]) - (128 << 7)) * 4;
+                    const V: i32 = (@as(i32, vbuf0[i]) - (128 << 7)) * 4;
