+fn hScale8To15(dst: []i16, dst_w: usize, src: [*]const u8, filter: []const i16, filter_pos: []const i32, filter_size: usize) void {
+    for (0..dst_w) |i| {
+        const src_pos: usize = @intCast(filter_pos[i]);
+        var val: i32 = 0;
+        for (0..filter_size) |j| {
+            val += @as(i32, src[src_pos + j]) * @as(i32, filter[i * filter_size + j]);
+        }
+        dst[i] = @intCast(@min(val >> 7, (1 << 15) - 1));
+    }
