+                    const V: i32 = (@as(i32, vbuf0[i]) + 64) >> 7;
+                    const A1: u32 = if (has_alpha) clip_uint8((@as(i32, abuf0[2 * i + 0]) * 255 + 16384) >> 15) else 0;
+                    const A2: u32 = if (has_alpha) clip_uint8((@as(i32, abuf0[2 * i + 1]) * 255 + 16384) >> 15) else 0;
