+    lum_filter: [*]const i16,
+    lum_lines: []const [*]const i16,
+    lum_fsize: usize,
+    chr_filter: [*]const i16,
+    u_lines: []const [*]const i16,
+    v_lines: []const [*]const i16,
+    chr_fsize: usize,
+    alp_lines: []const [*]const i16,
+    dest: [*]u8,
+    dst_w: usize,
