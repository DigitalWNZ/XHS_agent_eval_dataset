+// ── Unscaled Special Converters ─────────────────────────────────────────────
+
+fn copyPlane(src: [*]const u8, src_stride: i32, src_slice_y: i32, src_slice_h: i32, width: i32, dst: [*]u8, dst_stride: i32) void {
+    const w: usize = @intCast(width);
+    const h: usize = @intCast(src_slice_h);
+    var s_ptr = src;
+    var d_ptr = @as([*]u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(dst))) + @as(isize, src_slice_y) * @as(isize, dst_stride)))));
+    if (dst_stride == src_stride and src_stride > 0 and src_stride == width) {
+        @memcpy(d_ptr[0 .. h * w], s_ptr[0 .. h * w]);
+    } else {
+        for (0..h) |_| {
+            @memcpy(d_ptr[0..w], s_ptr[0..w]);
+            s_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s_ptr))) + @as(isize, src_stride))));
+            d_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d_ptr))) + @as(isize, dst_stride))));
+        }
+    }
+}
+
+fn fillPlane(plane: [*]u8, stride: i32, length: i32, height: i32, y: i32, val: u8) void {
+    const w: usize = @intCast(length);
+    const h: usize = @intCast(height);
+    var d_ptr = @as([*]u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(plane))) + @as(isize, y) * @as(isize, stride)))));
+    for (0..h) |_| {
+        @memset(d_ptr[0..w], val);
+        d_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d_ptr))) + @as(isize, stride))));
+    }
+}
+
+fn interleaveBytes(src1: [*]const u8, src2: [*]const u8, dest: [*]u8, width: i32, height: i32, src1_stride: i32, src2_stride: i32, dst_stride: i32) void {
+    const w: usize = @intCast(width);
+    const h: usize = @intCast(height);
+    var s1 = src1;
+    var s2 = src2;
+    var d = dest;
+    for (0..h) |_| {
+        for (0..w) |x| {
+            d[2 * x + 0] = s1[x];
+            d[2 * x + 1] = s2[x];
+        }
+        s1 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s1))) + @as(isize, src1_stride))));
+        s2 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s2))) + @as(isize, src2_stride))));
+        d = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d))) + @as(isize, dst_stride))));
+    }
+}
+
+fn deinterleaveBytes(src: [*]const u8, dst1: [*]u8, dst2: [*]u8, width: i32, height: i32, src_stride: i32, dst1_stride: i32, dst2_stride: i32) void {
+    const w: usize = @intCast(width);
+    const h: usize = @intCast(height);
+    var s = src;
+    var d1 = dst1;
+    var d2 = dst2;
+    for (0..h) |_| {
+        for (0..w) |x| {
+            d1[x] = s[2 * x + 0];
+            d2[x] = s[2 * x + 1];
+        }
+        s = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s))) + @as(isize, src_stride))));
+        d1 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d1))) + @as(isize, dst1_stride))));
+        d2 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d2))) + @as(isize, dst2_stride))));
+    }
+}
+
+fn run_planar_to_nv12(c: *const SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    copyPlane(src[0].?, src_stride[0], 0, c.src_h, c.src_w, dst[0].?, dst_stride[0]);
+    if (c.dst_fmt == PIXFMT_NV12) {
+        interleaveBytes(src[1].?, src[2].?, dst[1].?, c.chr_src_w, @divTrunc(c.src_h + 1, 2), src_stride[1], src_stride[2], dst_stride[1]);
+    } else {
+        interleaveBytes(src[2].?, src[1].?, dst[1].?, c.chr_src_w, @divTrunc(c.src_h + 1, 2), src_stride[2], src_stride[1], dst_stride[1]);
+    }
+}
+
+fn run_nv12_to_planar(c: *const SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    copyPlane(src[0].?, src_stride[0], 0, c.src_h, c.src_w, dst[0].?, dst_stride[0]);
+    if (c.src_fmt == PIXFMT_NV12) {
+        deinterleaveBytes(src[1].?, dst[1].?, dst[2].?, c.chr_src_w, @divTrunc(c.src_h + 1, 2), src_stride[1], dst_stride[1], dst_stride[2]);
+    } else {
+        deinterleaveBytes(src[1].?, dst[2].?, dst[1].?, c.chr_src_w, @divTrunc(c.src_h + 1, 2), src_stride[1], dst_stride[2], dst_stride[1]);
+    }
+}
+
+fn run_planar_copy(c: *const SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    for (0..4) |plane| {
+        if (dst[plane] == null) break;
+        const length = if (plane == 0 or plane == 3) c.src_w else ceil_rshift(c.src_w, c.chr_dst_h_sub);
+        const height = if (plane == 0 or plane == 3) c.src_h else ceil_rshift(c.src_h, c.chr_dst_v_sub);
+        if (plane == 1 and dst[2] == null) continue;
+        if (src[plane] == null or (plane == 1 and src[2] == null)) {
+            fillPlane(dst[plane].?, dst_stride[plane], length, height, 0, if (plane == 3) 255 else 128);
+        } else {
+            copyPlane(src[plane].?, src_stride[plane], 0, height, length, dst[plane].?, dst_stride[plane]);
+        }
+    }
+}
+
+fn run_packed_copy(c: *const SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    const length = c.src_w * ((c.src_bpp + 7) >> 3);
+    copyPlane(src[0].?, src_stride[0], 0, c.src_h, length, dst[0].?, dst_stride[0]);
+}
+
+fn run_bgr24_to_yv12(c: *const SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    const ry = c.input_rgb2yuv_table[RY_IDX];
+    const gy = c.input_rgb2yuv_table[GY_IDX];
+    const by = c.input_rgb2yuv_table[BY_IDX];
+    const ru = c.input_rgb2yuv_table[RU_IDX];
+    const gu = c.input_rgb2yuv_table[GU_IDX];
+    const bu = c.input_rgb2yuv_table[BU_IDX];
+    const rv = c.input_rgb2yuv_table[RV_IDX];
+    const gv = c.input_rgb2yuv_table[GV_IDX];
+    const bv = c.input_rgb2yuv_table[BV_IDX];
+
+    const chrom_width: usize = @intCast(c.src_w >> 1);
+    const height: usize = @intCast(c.src_h);
+    var src1 = src[0].?;
+    var src2 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(src1))) + @as(isize, src_stride[0])))));
+    var ydst1 = dst[0].?;
+    var ydst2 = @as([*]u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(ydst1))) + @as(isize, dst_stride[0])))));
+    var udst = dst[1].?;
+    var vdst = dst[2].?;
+
+    var y: usize = 0;
+    while (y < height) : (y += 2) {
+        for (0..chrom_width) |i| {
+            const b11: i32 = src1[6 * i + 0];
+            const g11: i32 = src1[6 * i + 1];
+            const r11: i32 = src1[6 * i + 2];
+            const b12: i32 = src1[6 * i + 3];
+            const g12: i32 = src1[6 * i + 4];
+            const r12: i32 = src1[6 * i + 5];
+            const b21: i32 = src2[6 * i + 0];
+            const g21: i32 = src2[6 * i + 1];
+            const r21: i32 = src2[6 * i + 2];
+            const b22: i32 = src2[6 * i + 3];
+            const g22: i32 = src2[6 * i + 4];
+            const r22: i32 = src2[6 * i + 5];
+
+            const Y11: u8 = @truncate(@as(u32, @bitCast(((ry * r11 + gy * g11 + by * b11) >> RGB2YUV_SHIFT) + 16)));
+            const Y12: u8 = @truncate(@as(u32, @bitCast(((ry * r12 + gy * g12 + by * b12) >> RGB2YUV_SHIFT) + 16)));
+            const Y21: u8 = @truncate(@as(u32, @bitCast(((ry * r21 + gy * g21 + by * b21) >> RGB2YUV_SHIFT) + 16)));
+            const Y22: u8 = @truncate(@as(u32, @bitCast(((ry * r22 + gy * g22 + by * b22) >> RGB2YUV_SHIFT) + 16)));
+
+            const bx: i32 = (b11 + b12 + b21 + b22) >> 2;
+            const gx: i32 = (g11 + g12 + g21 + g22) >> 2;
+            const rx: i32 = (r11 + r12 + r21 + r22) >> 2;
+
+            const U: u8 = @truncate(@as(u32, @bitCast(((ru * rx + gu * gx + bu * bx) >> RGB2YUV_SHIFT) + 128)));
+            const V: u8 = @truncate(@as(u32, @bitCast(((rv * rx + gv * gx + bv * bx) >> RGB2YUV_SHIFT) + 128)));
+
+            ydst1[2 * i + 0] = Y11;
+            ydst1[2 * i + 1] = Y12;
+            ydst2[2 * i + 0] = Y21;
+            ydst2[2 * i + 1] = Y22;
+            udst[i] = U;
+            vdst[i] = V;
+        }
+        src1 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(src1))) + 2 * @as(isize, src_stride[0]))));
+        src2 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(src2))) + 2 * @as(isize, src_stride[0]))));
+        ydst1 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(ydst1))) + 2 * @as(isize, dst_stride[0]))));
+        ydst2 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(ydst2))) + 2 * @as(isize, dst_stride[0]))));
+        udst = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(udst))) + @as(isize, dst_stride[1]))));
+        vdst = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(vdst))) + @as(isize, dst_stride[2]))));
+    }
+}
+
+fn run_pal_to_rgb(c: *const SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    const w: usize = @intCast(c.src_w);
+    const h: usize = @intCast(c.src_h);
+    var s_ptr = src[0].?;
+    var d_ptr = dst[0].?;
+    const pal8: [*]const u8 = @ptrCast(&c.pal_rgb);
+    if (c.dst_bpp == 32) {
+        for (0..h) |_| {
+            var d32: [*]u32 = @ptrCast(@alignCast(d_ptr));
+            for (0..w) |i| {
+                d32[i] = c.pal_rgb[s_ptr[i]];
+            }
+            s_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s_ptr))) + @as(isize, src_stride[0]))));
+            d_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d_ptr))) + @as(isize, dst_stride[0]))));
+        }
+    } else {
+        for (0..h) |_| {
+            for (0..w) |i| {
+                const v = s_ptr[i];
+                d_ptr[3 * i + 0] = pal8[4 * @as(usize, v) + 0];
+                d_ptr[3 * i + 1] = pal8[4 * @as(usize, v) + 1];
+                d_ptr[3 * i + 2] = pal8[4 * @as(usize, v) + 2];
+            }
+            s_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s_ptr))) + @as(isize, src_stride[0]))));
+            d_ptr = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d_ptr))) + @as(isize, dst_stride[0]))));
+        }
+    }
+}
