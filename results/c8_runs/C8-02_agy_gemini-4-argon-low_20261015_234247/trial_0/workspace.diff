+fn run_scaled_pipeline(c: *SwsContext, src: [4]?[*]const u8, src_stride: [4]i32, dst: [4]?[*]u8, dst_stride: [4]i32) void {
+    const dst_w: usize = @intCast(c.dst_w);
+    const dst_h: usize = @intCast(c.dst_h);
+    const src_w: usize = @intCast(c.src_w);
+    const chr_src_w: usize = @intCast(c.chr_src_w);
+    const chr_dst_w: usize = @intCast(c.chr_dst_w);
+
+    const v_lum_fsize: usize = @intCast(c.v_lum_filter_size);
+    const v_chr_fsize: usize = @intCast(c.v_chr_filter_size);
+    const h_lum_fsize: usize = @intCast(c.h_lum_filter_size);
+    const h_chr_fsize: usize = @intCast(c.h_chr_filter_size);
+
+    const need_lum_conv = isAnyRGB(c.src_fmt);
+    const need_chr_conv = isAnyRGB(c.src_fmt) or isSemiPlanarYUV(c.src_fmt) or c.src_fmt == PIXFMT_GRAY8;
+
+    // We pre-allocated hout_lum_mem with `c.src_h` lines and hout_chr_u_mem/v_mem with `c.chr_src_h` lines!
+    // Wait: let's check how much memory `src_h` lines of `dst_w` i16 is:
+    // At most 2160 * 3840 * 2 = 16 MB, allocated ONCE in swscale_create!
+    // And in swscale_process, we just track `last_in_lum_buf` and `last_in_chr_buf`!
+    // No ring buffer rotation needed at all! Line `y` is simply at `hout_lum_mem[y * hout_line_elems ..]`!
+    var last_in_lum_buf: i32 = -1;
+    var last_in_chr_buf: i32 = -1;
+
+    var lum_lines_buf: [64][*]const i16 = undefined;
+    var u_lines_buf: [64][*]const i16 = undefined;
+    var v_lines_buf: [64][*]const i16 = undefined;
+    var alp_lines_buf: [64][*]const i16 = undefined;
+
+    for (0..dst_h) |dst_y_u| {
+        const dst_y: i32 = @intCast(dst_y_u);
+        const chr_dst_y: i32 = dst_y >> c.chr_dst_v_sub;
+
+        const first_lum_src_y: i32 = @max(1 - c.v_lum_filter_size, c.v_lum_filter_pos[dst_y_u]);
+        const last_lum_src_y: i32 = @min(c.src_h, first_lum_src_y + c.v_lum_filter_size) - 1;
+
+        const first_chr_src_y: i32 = @max(1 - c.v_chr_filter_size, c.v_chr_filter_pos[@intCast(chr_dst_y)]);
+        const last_chr_src_y: i32 = @min(c.chr_src_h, first_chr_src_y + c.v_chr_filter_size) - 1;
+
+        while (last_in_lum_buf < last_lum_src_y) {
+            last_in_lum_buf += 1;
+            const sy: usize = @intCast(last_in_lum_buf);
+            const src_row0 = @as([*]const u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(src[0].?))) + @as(isize, last_in_lum_buf) * @as(isize, src_stride[0])))));
