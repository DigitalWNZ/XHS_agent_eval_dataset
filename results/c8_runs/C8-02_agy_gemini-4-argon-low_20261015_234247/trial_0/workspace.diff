+        const b1 = @as([*]const u32, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(b32))) + @as(isize, Y1) * 4))))[0];
+        const r2 = @as([*]const u32, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(r32))) + @as(isize, Y2) * 4))))[0];
+        const g2 = @as([*]const u32, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(g32))) + @as(isize, Y2) * 4))))[0];
+        const b2 = @as([*]const u32, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(b32))) + @as(isize, Y2) * 4))))[0];
+        if (has_alpha) {
+            d32[2 * i + 0] = r1 + g1 + b1 + (A1 << 24);
+            d32[2 * i + 1] = r2 + g2 + b2 + (A2 << 24);
