+const std = @import("std");
+const allocator = std.heap.c_allocator;
+
+pub const PIXFMT_YUV420P = 0;
+pub const PIXFMT_YUV422P = 1;
+pub const PIXFMT_YUV444P = 2;
+pub const PIXFMT_NV12 = 3;
+pub const PIXFMT_NV21 = 4;
+pub const PIXFMT_RGB24 = 5;
+pub const PIXFMT_BGR24 = 6;
+pub const PIXFMT_RGBA = 7;
+pub const PIXFMT_BGRA = 8;
+pub const PIXFMT_GRAY8 = 9;
+
+pub const ALGO_NEAREST = 0;
+pub const ALGO_BILINEAR = 1;
+pub const ALGO_BICUBIC = 2;
+
+const SWS_POINT: i32 = 0x10;
+const SWS_BILINEAR: i32 = 2;
+const SWS_BICUBIC: i32 = 4;
+const SWS_FULL_CHR_H_INT: i32 = 0x2000;
+
+const YUVRGB_TABLE_HEADROOM = 512;
+const YUVRGB_TABLE_LUMA_HEADROOM = 512;
+const TABLE_PLANE_SIZE = 1024 + 2 * YUVRGB_TABLE_LUMA_HEADROOM;
+const RGB2YUV_SHIFT = 15;
+
+const RY_IDX = 0;
+const GY_IDX = 1;
+const BY_IDX = 2;
+const RU_IDX = 3;
+const GU_IDX = 4;
+const BU_IDX = 5;
+const RV_IDX = 6;
+const GV_IDX = 7;
+const BV_IDX = 8;
+
+const BY_COEFF: i32 = @intFromFloat(0.114 * 219.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5);
+const BV_COEFF: i32 = -@as(i32, @intFromFloat(0.081 * 224.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5));
+const BU_COEFF: i32 = @intFromFloat(0.500 * 224.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5);
+const GY_COEFF: i32 = @intFromFloat(0.587 * 219.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5);
+const GV_COEFF: i32 = -@as(i32, @intFromFloat(0.419 * 224.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5));
+const GU_COEFF: i32 = -@as(i32, @intFromFloat(0.331 * 224.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5));
+const RY_COEFF: i32 = @intFromFloat(0.299 * 219.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5);
+const RV_COEFF: i32 = @intFromFloat(0.500 * 224.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5);
+const RU_COEFF: i32 = -@as(i32, @intFromFloat(0.169 * 224.0 / 255.0 * @as(f64, 1 << RGB2YUV_SHIFT) + 0.5));
+
+const sws_pb_64 = [8]u8{ 64, 64, 64, 64, 64, 64, 64, 64 };
+
+inline fn clip_uint8(a: i32) u8 {
+    if ((a & (~@as(i32, 0xFF))) != 0) {
+        return if (a < 0) 0 else 255;
+    }
+    return @intCast(a);
+}
+
+inline fn clip_uintp2_30(a: i32) i32 {
+    if ((a & ~@as(i32, (1 << 30) - 1)) != 0) {
+        return (~a) >> 31 & ((1 << 30) - 1);
+    }
+    return a;
+}
+
+inline fn ceil_rshift(a: i32, b: u5) i32 {
+    return -((-(a)) >> b);
+}
+
+inline fn rounded_div(a: i64, b: i64) i64 {
+    return if (a >= 0) @divTrunc(a + (b >> 1), b) else @divTrunc(a - (b >> 1), b);
+}
+
+fn av_log2(v: u32) i32 {
+    return @intCast(31 - @clz(v | 1));
+}
+
+fn isAnyRGB(fmt: i32) bool {
+    return fmt == PIXFMT_RGB24 or fmt == PIXFMT_BGR24 or fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+fn isYUV(fmt: i32) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P or fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+fn isPlanarYUV(fmt: i32) bool {
+    return isYUV(fmt);
+}
+
+fn isSemiPlanarYUV(fmt: i32) bool {
+    return fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+fn isGray(fmt: i32) bool {
+    return fmt == PIXFMT_GRAY8;
+}
+
+fn isALPHA(fmt: i32) bool {
+    return fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+fn usePal(fmt: i32) bool {
+    return fmt == PIXFMT_GRAY8;
+}
+
+fn isPacked(fmt: i32) bool {
+    return isAnyRGB(fmt) or fmt == PIXFMT_GRAY8;
+}
+
+fn alphaless_fmt(fmt: i32) i32 {
+    return switch (fmt) {
+        PIXFMT_RGBA => PIXFMT_RGB24,
+        PIXFMT_BGRA => PIXFMT_BGR24,
+        else => -1,
+    };
+}
+
+fn get_bpp(fmt: i32) i32 {
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => 12,
+        PIXFMT_YUV422P => 16,
+        PIXFMT_YUV444P, PIXFMT_RGB24, PIXFMT_BGR24 => 24,
+        PIXFMT_RGBA, PIXFMT_BGRA => 32,
+        PIXFMT_GRAY8 => 8,
+        else => 8,
+    };
+}
+
+fn get_chroma_sub_sample(fmt: i32, h_sub: *u5, v_sub: *u5) void {
+    switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => {
+            h_sub.* = 1;
+            v_sub.* = 1;
+        },
+        PIXFMT_YUV422P => {
+            h_sub.* = 1;
+            v_sub.* = 0;
+        },
+        else => {
+            h_sub.* = 0;
+            v_sub.* = 0;
+        },
+    }
+}
+
+fn get_local_pos(chr_subsample: u5, pos_in: i32) i32 {
+    var pos = pos_in;
+    if (pos == -1 or pos <= -513) {
+        pos = (@as(i32, 128) << chr_subsample) - 128;
+    }
+    pos += 128;
+    return pos >> chr_subsample;
+}
+
+fn roundToInt16(f: i64) i16 {
+    const r: i32 = @intCast((f + (1 << 15)) >> 16);
+    if (r < -0x7FFF) return @bitCast(@as(u16, 0x8000));
+    if (r > 0x7FFF) return 0x7FFF;
+    return @intCast(r);
+}
+
+const UnscaledKind = enum {
+    none,
+    planar_copy,
+    packed_copy,
+    planar_to_nv12,
+    nv12_to_planar,
+    yuv420p_to_rgb,
+    yuv422p_to_rgb,
+    bgr24_to_yv12,
+    rgb_to_rgb,
+    pal_to_rgb,
+};
+
+pub const SwsContext = struct {
+    src_w: i32 = 0,
+    src_h: i32 = 0,
+    src_fmt: i32 = 0,
+    dst_w: i32 = 0,
+    dst_h: i32 = 0,
+    dst_fmt: i32 = 0,
+    algo: i32 = 0,
+    flags: i32 = 0,
+
+    src_range: i32 = 0,
+    dst_range: i32 = 0,
+    src_bpc: i32 = 0,
+    dst_bpc: i32 = 0,
+    src_bpp: i32 = 0,
+    dst_bpp: i32 = 0,
+
+    chr_src_h_sub: u5 = 0,
+    chr_src_v_sub: u5 = 0,
+    chr_dst_h_sub: u5 = 0,
+    chr_dst_v_sub: u5 = 0,
+
+    chr_src_w: i32 = 0,
+    chr_src_h: i32 = 0,
+    chr_dst_w: i32 = 0,
+    chr_dst_h: i32 = 0,
+
+    lum_x_inc: i32 = 0,
+    lum_y_inc: i32 = 0,
+    chr_x_inc: i32 = 0,
+    chr_y_inc: i32 = 0,
+
+    need_alpha: bool = false,
+    needs_hcscale: bool = false,
+    unscaled_kind: UnscaledKind = .none,
+
+    // Color tables
+    input_rgb2yuv_table: [16]i32 = [_]i32{0} ** 16,
+    pal_yuv: [256]u32 = [_]u32{0} ** 256,
+    pal_rgb: [256]u32 = [_]u32{0} ** 256,
+
+    yuv2rgb_y_coeff: i32 = 0,
+    yuv2rgb_y_offset: i32 = 0,
+    yuv2rgb_v2r_coeff: i32 = 0,
+    yuv2rgb_v2g_coeff: i32 = 0,
+    yuv2rgb_u2g_coeff: i32 = 0,
+    yuv2rgb_u2b_coeff: i32 = 0,
+
+    yuv_table_mem: ?[]u8 = null,
+    table_rV: [256 + 2 * YUVRGB_TABLE_HEADROOM][*]const u8 = undefined,
+    table_gU: [256 + 2 * YUVRGB_TABLE_HEADROOM][*]const u8 = undefined,
+    table_bU: [256 + 2 * YUVRGB_TABLE_HEADROOM][*]const u8 = undefined,
+    table_gV: [256 + 2 * YUVRGB_TABLE_HEADROOM]i32 = [_]i32{0} ** (256 + 2 * YUVRGB_TABLE_HEADROOM),
+
+    // Filters
+    h_lum_filter: []i16 = &[_]i16{},
+    h_lum_filter_pos: []i32 = &[_]i32{},
+    h_lum_filter_size: i32 = 0,
+
+    h_chr_filter: []i16 = &[_]i16{},
+    h_chr_filter_pos: []i32 = &[_]i32{},
+    h_chr_filter_size: i32 = 0,
+
+    v_lum_filter: []i16 = &[_]i16{},
+    v_lum_filter_pos: []i32 = &[_]i32{},
+    v_lum_filter_size: i32 = 0,
+
+    v_chr_filter: []i16 = &[_]i16{},
+    v_chr_filter_pos: []i32 = &[_]i32{},
+    v_chr_filter_size: i32 = 0,
+
+    lum_buf_lines: usize = 0,
+    chr_buf_lines: usize = 0,
+    lum_buf_mask: usize = 0,
+    chr_buf_mask: usize = 0,
+    h_lum_is_1tap_identity: bool = false,
+    h_chr_is_1tap_identity: bool = false,
+    hout_line_elems: usize = 0,
+    hout_lum_mem: []i16 = &[_]i16{},
+    hout_chr_u_mem: []i16 = &[_]i16{},
+    hout_chr_v_mem: []i16 = &[_]i16{},
+    hout_alp_mem: []i16 = &[_]i16{},
+
+    conv_lum_mem: []i16 = &[_]i16{},
+    conv_chr_u_mem: []i16 = &[_]i16{},
+    conv_chr_v_mem: []i16 = &[_]i16{},
+    conv_alp_mem: []i16 = &[_]i16{},
+};
+
+fn initFilter(
+    out_filter: *[]i16,
+    out_filter_pos: *[]i32,
+    out_filter_size: *i32,
+    x_inc: i32,
+    src_w: i32,
+    dst_w: i32,
+    filter_align: i32,
+    one: i64,
+    flags: i32,
+    src_pos: i32,
+    dst_pos: i32,
+) !void {
+    const fone: i64 = @as(i64, 1) << @intCast(54 - @min(av_log2(@intCast(@divTrunc(src_w, dst_w))), 8));
+    var filter_pos = try allocator.alloc(i32, @intCast(dst_w + 3));
+    errdefer allocator.free(filter_pos);
+
+    var filter_size: i32 = 0;
+    var filter: []i64 = &[_]i64{};
+
+    if (@abs(x_inc - 0x10000) < 10 and src_pos == dst_pos) {
+        filter_size = 1;
+        filter = try allocator.alloc(i64, @intCast(dst_w * filter_size));
+        @memset(filter, 0);
+        var i: i32 = 0;
+        while (i < dst_w) : (i += 1) {
+            filter[@intCast(i * filter_size)] = fone;
+            filter_pos[@intCast(i)] = i;
+        }
+    } else if ((flags & SWS_POINT) != 0) {
+        filter_size = 1;
+        filter = try allocator.alloc(i64, @intCast(dst_w * filter_size));
+        var x_dst_in_src: i64 = ((@as(i64, dst_pos) * @as(i64, x_inc)) >> 8) - ((@as(i64, src_pos) * 0x8000) >> 7);
+        var i: i32 = 0;
+        while (i < dst_w) : (i += 1) {
+            const xx: i32 = @intCast((x_dst_in_src - ((@as(i64, filter_size) - 1) << 15) + (1 << 15)) >> 16);
+            filter_pos[@intCast(i)] = xx;
+            filter[@intCast(i)] = fone;
+            x_dst_in_src += x_inc;
+        }
+    } else {
+        const size_factor: i32 = if ((flags & SWS_BICUBIC) != 0) 4 else 2;
+        if (x_inc <= (1 << 16)) {
+            filter_size = 1 + size_factor;
+        } else {
+            filter_size = 1 + @divTrunc(size_factor * src_w + dst_w - 1, dst_w);
+        }
+        filter_size = @min(filter_size, src_w - 2);
+        filter_size = @max(filter_size, 1);
+
+        filter = try allocator.alloc(i64, @intCast(dst_w * filter_size));
+        var x_dst_in_src: i64 = ((@as(i64, dst_pos) * @as(i64, x_inc)) >> 7) - ((@as(i64, src_pos) * 0x10000) >> 7);
+        var i: i32 = 0;
+        while (i < dst_w) : (i += 1) {
+            var xx: i32 = @intCast(@divTrunc(x_dst_in_src - (@as(i64, filter_size) - 2) * (1 << 16), 1 << 17));
+            filter_pos[@intCast(i)] = xx;
+            var j: i32 = 0;
+            while (j < filter_size) : (j += 1) {
+                const diff: i64 = @intCast(@abs((@as(i64, xx) * (1 << 17)) - x_dst_in_src));
+                var d: i64 = diff << 13;
+                if (x_inc > (1 << 16)) {
+                    d = @divTrunc(d * dst_w, src_w);
+                }
+                var coeff: i64 = 0;
+                if ((flags & SWS_BICUBIC) != 0) {
+                    const B: i64 = 0;
+                    const C: i64 = @intFromFloat(0.6 * @as(f64, 1 << 24));
+                    if (d >= (@as(i64, 1) << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (@as(i64, 1) << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (@as(i64, 1) << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[@intCast(i * filter_size + j)] = coeff;
+                xx += 1;
+            }
+            x_dst_in_src += 2 * @as(i64, x_inc);
+        }
+    }
+    defer allocator.free(filter);
+
+    const filter2_size = filter_size;
+    var filter2 = try allocator.alloc(i64, @intCast(dst_w * filter2_size));
+    defer allocator.free(filter2);
+    @memcpy(filter2, filter);
+
+    var min_filter_size: i32 = 0;
+    const cutoff_limit: i64 = @intFromFloat(0.002 * @as(f64, @floatFromInt(fone)));
+    var i: i32 = dst_w - 1;
+    while (i >= 0) : (i -= 1) {
+        var min: i32 = filter2_size;
+        var cut_off: i64 = 0;
+        var j: i32 = 0;
+        while (j < filter2_size) : (j += 1) {
+            const idx: usize = @intCast(i * filter2_size);
+            cut_off += @intCast(@abs(filter2[idx]));
+            if (cut_off > cutoff_limit) break;
+            if (i < dst_w - 1 and filter_pos[@intCast(i)] >= filter_pos[@intCast(i + 1)]) break;
+            var k: i32 = 1;
+            while (k < filter2_size) : (k += 1) {
+                filter2[@intCast(i * filter2_size + k - 1)] = filter2[@intCast(i * filter2_size + k)];
+            }
+            filter2[@intCast(i * filter2_size + filter2_size - 1)] = 0;
+            filter_pos[@intCast(i)] += 1;
+        }
+
+        cut_off = 0;
+        j = filter2_size - 1;
+        while (j > 0) : (j -= 1) {
+            cut_off += @intCast(@abs(filter2[@intCast(i * filter2_size + j)]));
+            if (cut_off > cutoff_limit) break;
+            min -= 1;
+        }
+        if (min > min_filter_size) min_filter_size = min;
+    }
+
+    filter_size = (min_filter_size + (filter_align - 1)) & (~(filter_align - 1));
+    var filter_reduced = try allocator.alloc(i64, @intCast(dst_w * filter_size));
+    defer allocator.free(filter_reduced);
+    out_filter_size.* = filter_size;
+
+    i = 0;
+    while (i < dst_w) : (i += 1) {
+        var j: i32 = 0;
+        while (j < filter_size) : (j += 1) {
+            if (j >= filter2_size) {
+                filter_reduced[@intCast(i * filter_size + j)] = 0;
+            } else {
+                filter_reduced[@intCast(i * filter_size + j)] = filter2[@intCast(i * filter2_size + j)];
+            }
+        }
+    }
+
+    // Fix borders
+    i = 0;
+    while (i < dst_w) : (i += 1) {
+        const ui: usize = @intCast(i);
+        if (filter_pos[ui] < 0) {
+            var j: i32 = 1;
+            while (j < filter_size) : (j += 1) {
+                const left = @max(j + filter_pos[ui], 0);
+                filter_reduced[@intCast(i * filter_size + left)] += filter_reduced[@intCast(i * filter_size + j)];
+                filter_reduced[@intCast(i * filter_size + j)] = 0;
+            }
+            filter_pos[ui] = 0;
+        }
+
+        if (filter_pos[ui] + filter_size > src_w) {
+            const shift = filter_pos[ui] + @min(filter_size - src_w, 0);
+            var acc: i64 = 0;
+            var j: i32 = filter_size - 1;
+            while (j >= 0) : (j -= 1) {
+                if (filter_pos[ui] + j >= src_w) {
+                    acc += filter_reduced[@intCast(i * filter_size + j)];
+                    filter_reduced[@intCast(i * filter_size + j)] = 0;
+                }
+            }
+            j = filter_size - 1;
+            while (j >= 0) : (j -= 1) {
+                if (j < shift) {
+                    filter_reduced[@intCast(i * filter_size + j)] = 0;
+                } else {
+                    filter_reduced[@intCast(i * filter_size + j)] = filter_reduced[@intCast(i * filter_size + j - shift)];
+                }
+            }
+            filter_pos[ui] -= shift;
+            filter_reduced[@intCast(i * filter_size + src_w - 1 - filter_pos[ui])] += acc;
+        }
+    }
+
+    var final_filter = try allocator.alloc(i16, @intCast(filter_size * (dst_w + 3)));
+    @memset(final_filter, 0);
+
+    i = 0;
+    while (i < dst_w) : (i += 1) {
+        var err_acc: i64 = 0;
+        var sum: i64 = 0;
+        var j: i32 = 0;
+        while (j < filter_size) : (j += 1) {
+            sum += filter_reduced[@intCast(i * filter_size + j)];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        j = 0;
+        while (j < filter_size) : (j += 1) {
+            const v: i64 = filter_reduced[@intCast(i * filter_size + j)] + err_acc;
+            const int_v: i32 = @intCast(rounded_div(v, sum));
+            final_filter[@intCast(i * filter_size + j)] = @intCast(int_v);
+            err_acc = v - @as(i64, int_v) * sum;
+        }
+    }
+
+    filter_pos[@intCast(dst_w + 0)] = filter_pos[@intCast(dst_w - 1)];
+    filter_pos[@intCast(dst_w + 1)] = filter_pos[@intCast(dst_w - 1)];
+    filter_pos[@intCast(dst_w + 2)] = filter_pos[@intCast(dst_w - 1)];
+    i = 0;
+    while (i < filter_size) : (i += 1) {
+        const k: usize = @intCast((dst_w - 1) * filter_size + i);
+        const fsz: usize = @intCast(filter_size);
+        final_filter[k + 1 * fsz] = final_filter[k];
+        final_filter[k + 2 * fsz] = final_filter[k];
+        final_filter[k + 3 * fsz] = final_filter[k];
+    }
+
+    out_filter.* = final_filter;
+    out_filter_pos.* = filter_pos;
+}
+
+fn fill_table(table: *[256 + 2 * YUVRGB_TABLE_HEADROOM][*]const u8, elemsize: isize, inc: i64, y_tab: [*]const u8) void {
+    const base_offset: isize = -elemsize * @as(isize, @intCast(inc >> 9));
+    for (0..(256 + 2 * YUVRGB_TABLE_HEADROOM)) |idx| {
+        const i: i32 = @as(i32, @intCast(idx)) - YUVRGB_TABLE_HEADROOM;
+        const cb: i64 = @as(i64, clip_uint8(i)) * inc;
+        const off: isize = base_offset + elemsize * @as(isize, @intCast(cb >> 16));
+        table[idx] = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(y_tab))) + off)));
+    }
+}
+
+fn fill_gv_table(table: *[256 + 2 * YUVRGB_TABLE_HEADROOM]i32, elemsize: i32, inc: i64) void {
+    const off: i32 = -@as(i32, @intCast(inc >> 9));
+    for (0..(256 + 2 * YUVRGB_TABLE_HEADROOM)) |idx| {
+        const i: i32 = @as(i32, @intCast(idx)) - YUVRGB_TABLE_HEADROOM;
+        const cb: i64 = @as(i64, clip_uint8(i)) * inc;
+        table[idx] = elemsize * (off + @as(i32, @intCast(cb >> 16)));
+    }
+}
+
+fn init_yuv2rgb_tables(c: *SwsContext) !void {
+    const is_rgb = c.dst_fmt == PIXFMT_BGRA or c.dst_fmt == PIXFMT_BGR24;
+    const bpp = c.dst_bpp;
+    const full_range = c.src_range != 0;
+    const yoffs: usize = (if (full_range) @as(usize, 384) else @as(usize, 326)) + YUVRGB_TABLE_LUMA_HEADROOM;
+
+    // Default ITU-R Rec. 624-4 / SMPTE 170M coeffs: { 104597, 132201, 25675, 53279 }
+    var crv: i64 = 104597;
+    var cbu: i64 = 132201;
+    var cgu: i64 = -25675;
+    var cgv: i64 = -53279;
+    var cy: i64 = 1 << 16;
+    var oy: i64 = 0;
+
+    if (!full_range) {
+        cy = @divTrunc(cy * 255, 219);
+        oy = 16 << 16;
+    } else {
+        crv = @divTrunc(crv * 224, 255);
+        cbu = @divTrunc(cbu * 224, 255);
+        cgu = @divTrunc(cgu * 224, 255);
+        cgv = @divTrunc(cgv * 224, 255);
+    }
+
+    const contrast: i64 = 1 << 16;
+    const saturation: i64 = 1 << 16;
+    cy = (cy * contrast) >> 16;
+    crv = (crv * contrast * saturation) >> 32;
+    cbu = (cbu * contrast * saturation) >> 32;
+    cgu = (cgu * contrast * saturation) >> 32;
+    cgv = (cgv * contrast * saturation) >> 32;
+
+    c.yuv2rgb_y_coeff = roundToInt16(cy * (1 << 13));
+    c.yuv2rgb_y_offset = roundToInt16(oy * (1 << 9));
+    c.yuv2rgb_v2r_coeff = roundToInt16(crv * (1 << 13));
+    c.yuv2rgb_v2g_coeff = roundToInt16(cgv * (1 << 13));
+    c.yuv2rgb_u2g_coeff = roundToInt16(cgu * (1 << 13));
+    c.yuv2rgb_u2b_coeff = roundToInt16(cbu * (1 << 13));
+
+    const max_cy = @max(cy, 1);
+    crv = @divTrunc((crv * (1 << 16)) + 0x8000, max_cy);
+    cbu = @divTrunc((cbu * (1 << 16)) + 0x8000, max_cy);
+    cgu = @divTrunc((cgu * (1 << 16)) + 0x8000, max_cy);
+    cgv = @divTrunc((cgv * (1 << 16)) + 0x8000, max_cy);
+
+    if (bpp == 24) {
+        const mem = try allocator.alloc(u8, TABLE_PLANE_SIZE);
+        c.yuv_table_mem = mem;
+        var yb: i64 = -(384 << 16) - YUVRGB_TABLE_LUMA_HEADROOM * cy - oy;
+        for (0..TABLE_PLANE_SIZE) |i| {
+            mem[i] = clip_uint8(@intCast((yb + 0x8000) >> 16));
+            yb += cy;
+        }
+        fill_table(&c.table_rV, 1, crv, mem.ptr + yoffs);
+        fill_table(&c.table_gU, 1, cgu, mem.ptr + yoffs);
+        fill_table(&c.table_bU, 1, cbu, mem.ptr + yoffs);
+        fill_gv_table(&c.table_gV, 1, cgv);
+    } else if (bpp == 32) {
+        const rbase: u5 = if (is_rgb) 16 else 0;
+        const gbase: u5 = 8;
+        const bbase: u5 = if (is_rgb) 0 else 16;
+        const need_alpha = isALPHA(c.src_fmt);
+        const abase: u5 = 24;
+        const mem = try allocator.alignedAlloc(u8, 4, TABLE_PLANE_SIZE * 3 * 4);
+        c.yuv_table_mem = mem;
+        var y_table32: [*]u32 = @ptrCast(mem.ptr);
+        var yb: i64 = -(384 << 16) - YUVRGB_TABLE_LUMA_HEADROOM * cy - oy;
+        for (0..TABLE_PLANE_SIZE) |i| {
+            const yval: u32 = clip_uint8(@intCast((yb + 0x8000) >> 16));
+            y_table32[i] = (yval << rbase) + (if (need_alpha) @as(u32, 0) else (@as(u32, 255) << abase));
+            y_table32[i + TABLE_PLANE_SIZE] = yval << gbase;
+            y_table32[i + 2 * TABLE_PLANE_SIZE] = yval << bbase;
+            yb += cy;
+        }
+        const y_tab8: [*]const u8 = @ptrCast(y_table32);
+        fill_table(&c.table_rV, 4, crv, y_tab8 + yoffs * 4);
+        fill_table(&c.table_gU, 4, cgu, y_tab8 + (yoffs + TABLE_PLANE_SIZE) * 4);
+        fill_table(&c.table_bU, 4, cbu, y_tab8 + (yoffs + 2 * TABLE_PLANE_SIZE) * 4);
+        fill_gv_table(&c.table_gV, 4, cgv);
+    }
+}
+
+fn init_rgb2yuv_table(c: *SwsContext) void {
+    c.input_rgb2yuv_table[BY_IDX] = BY_COEFF;
+    c.input_rgb2yuv_table[BV_IDX] = BV_COEFF;
+    c.input_rgb2yuv_table[BU_IDX] = BU_COEFF;
+    c.input_rgb2yuv_table[GY_IDX] = GY_COEFF;
+    c.input_rgb2yuv_table[GV_IDX] = GV_COEFF;
+    c.input_rgb2yuv_table[GU_IDX] = GU_COEFF;
+    c.input_rgb2yuv_table[RY_IDX] = RY_COEFF;
+    c.input_rgb2yuv_table[RV_IDX] = RV_COEFF;
+    c.input_rgb2yuv_table[RU_IDX] = RU_COEFF;
+}
+
+fn init_palettes(c: *SwsContext) void {
+    for (0..256) |idx| {
+        const i: i32 = @intCast(idx);
+        const r = i;
+        const g = i;
+        const b = i;
+        const a: u32 = 0xFF;
+        const y: u32 = clip_uint8((RY_COEFF * r + GY_COEFF * g + BY_COEFF * b + (33 << (RGB2YUV_SHIFT - 1))) >> RGB2YUV_SHIFT);
+        const u: u32 = clip_uint8((RU_COEFF * r + GU_COEFF * g + BU_COEFF * b + (257 << (RGB2YUV_SHIFT - 1))) >> RGB2YUV_SHIFT);
+        const v: u32 = clip_uint8((RV_COEFF * r + GV_COEFF * g + BV_COEFF * b + (257 << (RGB2YUV_SHIFT - 1))) >> RGB2YUV_SHIFT);
+        c.pal_yuv[idx] = y + (u << 8) + (v << 16) + (a << 24);
+
+        const ur: u32 = @intCast(i);
+        c.pal_rgb[idx] = ur + (ur << 8) + (ur << 16) + (a << 24);
+    }
+}
