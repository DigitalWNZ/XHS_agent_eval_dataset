+                        yuv2nv12cX(c.dst_fmt, &sws_pb_64, v_chr_f, v_chr_fsize, u_lines_buf[0..v_chr_fsize], v_lines_buf[0..v_chr_fsize], dst_row1, chr_dst_w);
+                    } else {
+                        const dst_row2 = @as([*]u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(dst[2].?))) + @as(isize, chr_dst_y) * @as(isize, dst_stride[2])))));
+                        if (v_chr_fsize == 1) {
+                            yuv2plane1_8(u_lines_buf[0], dst_row1, chr_dst_w, &sws_pb_64, 0);
+                            yuv2plane1_8(v_lines_buf[0], dst_row2, chr_dst_w, &sws_pb_64, 3);
+                        } else {
+                            yuv2planeX_8(v_chr_f, v_chr_fsize, u_lines_buf[0..v_chr_fsize], dst_row1, chr_dst_w, &sws_pb_64, 0);
+                            yuv2planeX_8(v_chr_f, v_chr_fsize, v_lines_buf[0..v_chr_fsize], dst_row2, chr_dst_w, &sws_pb_64, 3);
+                        }
+                    }
+                }
+            }
+        } else {
+            const dst_row0 = @as([*]u8, @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(dst[0].?))) + @as(isize, dst_y) * @as(isize, dst_stride[0])))));
+            const chr_y_u: usize = @intCast(chr_dst_y);
+            const v_lum_f = c.v_lum_filter.ptr + dst_y_u * v_lum_fsize;
+            const v_chr_f = c.v_chr_filter.ptr + chr_y_u * v_chr_fsize;
