+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w < 1 or src_h < 1 or dst_w < 1 or dst_h < 1) return null;
+    if (src_fmt < 0 or src_fmt >= 10 or dst_fmt < 0 or dst_fmt >= 10) return null;
+
+    var ctx = allocator.create(SwsContext) catch return null;
+    ctx.* = .{};
+
+    ctx.src_w = src_w;
+    ctx.src_h = src_h;
+    ctx.src_fmt = src_fmt;
+    ctx.dst_w = dst_w;
+    ctx.dst_h = dst_h;
+    ctx.dst_fmt = dst_fmt;
+    ctx.algo = algo;
+
+    var flags: i32 = switch (algo) {
+        ALGO_NEAREST => SWS_POINT,
+        ALGO_BICUBIC => SWS_BICUBIC,
+        else => SWS_BILINEAR,
+    };
+
+    ctx.src_range = if (src_fmt == PIXFMT_GRAY8) 1 else 0;
+    ctx.dst_range = if (dst_fmt == PIXFMT_GRAY8) 1 else 0;
+    ctx.src_bpp = get_bpp(src_fmt);
+    ctx.dst_bpp = get_bpp(dst_fmt);
+
+    ctx.src_bpc = if (isAnyRGB(src_fmt)) 16 else 8;
+    ctx.dst_bpc = 8;
+
+    get_chroma_sub_sample(src_fmt, &ctx.chr_src_h_sub, &ctx.chr_src_v_sub);
+    get_chroma_sub_sample(dst_fmt, &ctx.chr_dst_h_sub, &ctx.chr_dst_v_sub);
+
+    if (isAnyRGB(dst_fmt) and (flags & SWS_FULL_CHR_H_INT) == 0) {
+        if ((dst_w & 1) != 0 or (ctx.chr_src_h_sub == 0 and ctx.chr_src_v_sub == 0)) {
+            flags |= SWS_FULL_CHR_H_INT;
+        }
+    }
+    if (isAnyRGB(dst_fmt) and (flags & SWS_FULL_CHR_H_INT) == 0) {
+        ctx.chr_dst_h_sub = 1;
+    }
