diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1 @@
+WITH ws AS (SELECT wordid, synsetid, COUNT(*) AS c FROM senses GROUP BY wordid, synsetid), agg AS (SELECT ws.wordid, COUNT(*) AS total_synsets, SUM(ws.c) AS total_senses, COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids, MAX(ws.c) AS mc FROM ws JOIN synsets syn ON syn.synsetid = ws.synsetid GROUP BY ws.wordid HAVING COUNT(*) >= 2 AND COUNT(DISTINCT syn.domainid) >= 2 AND SUM(ws.c) >= 2), top AS (SELECT a.*, (SELECT MIN(ws.synsetid) FROM ws WHERE ws.wordid = a.wordid AND ws.c = a.mc) AS top_synsetid FROM agg a ORDER BY a.total_senses DESC, a.total_synsets DESC, a.distinct_domains DESC, a.wordid ASC LIMIT 500) SELECT t.wordid AS word_id, w.word AS word, t.total_synsets, t.total_senses, t.distinct_domains, t.distinct_posids, t.top_synsetid, t.mc AS top_synset_sense_count FROM top t JOIN words w ON w.wordid = t.wordid ORDER BY t.total_senses DESC, t.total_synsets DESC, t.distinct_domains DESC, t.wordid ASC;
