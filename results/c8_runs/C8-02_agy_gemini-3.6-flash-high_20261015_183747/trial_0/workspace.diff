+import sys, os, subprocess
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv420p")][0]
+ref = open("/tmp/ref_yuv420.raw", "rb").read()
+
+w, h = 640, 480
+ref_y = ref[:w*h]
+ref_u = ref[w*h:w*h + (w//2)*(h//2)]
+ref_v = ref[w*h + (w//2)*(h//2):]
+
+wl_bgr = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24 640x480")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_bgr, 1, "/tmp/ref_bgr640.raw"))
+bgr = open("/tmp/ref_bgr640.raw", "rb").read()
+
+rgb = bytearray(w * h * 3)
+for i in range(w * h):
+    rgb[i*3 + 0] = bgr[i*3 + 2]
+    rgb[i*3 + 1] = bgr[i*3 + 1]
+    rgb[i*3 + 2] = bgr[i*3 + 0]
+
+ry, gy, by = 8423, 16531, 3212
+ru, gu, bu = -4866, -9528, 14394
+rv, gv, bv = 14394, -12061, -2333
+
+for y_off in [524288, 524288+16384, 524288+32768, 524288+33024, 557312]:
+    y_cand = bytearray(w * h)
+    for i in range(w * h):
+        r, g, b = rgb[i*3], rgb[i*3+1], rgb[i*3+2]
+        y_cand[i] = max(0, min(255, (ry*r + gy*g + by*b + y_off) >> 15))
+    py = workloads.psnr(ref_y, y_cand)
+    print(f"y_off={y_off} -> Y PSNR={py:.2f}")
+
+for uv_off in [8388608+256, 8388608+512, 8388608+1024, 8388608+2048]:
+    u_cand = bytearray((w//2)*(h//2))
+    v_cand = bytearray((w//2)*(h//2))
+    for cy in range(h // 2):
+        y0, y1 = cy * 2, cy * 2 + 1
+        for cx in range(w // 2):
+            x0, x1 = cx * 2, cx * 2 + 1
+            p00 = (y0*w+x0)*3; p01 = (y0*w+x1)*3
+            p10 = (y1*w+x0)*3; p11 = (y1*w+x1)*3
+            r0 = int(rgb[p00]) + int(rgb[p01]); g0 = int(rgb[p00+1]) + int(rgb[p01+1]); b0 = int(rgb[p00+2]) + int(rgb[p01+2])
+            r1 = int(rgb[p10]) + int(rgb[p11]); g1 = int(rgb[p10+1]) + int(rgb[p11+1]); b1 = int(rgb[p10+2]) + int(rgb[p11+2])
+            
+            du0 = (ru*r0 + gu*g0 + bu*b0 + uv_off) >> 10
+            du1 = (ru*r1 + gu*g1 + bu*b1 + uv_off) >> 10
+            dv0 = (rv*r0 + gv*g0 + bv*b0 + uv_off) >> 10
+            dv1 = (rv*r1 + gv*g1 + bv*b1 + uv_off) >> 10
+            
+            val_u = (du0 + du1 + 128) >> 8
+            val_v = (dv0 + dv1 + 128) >> 8
+            u_cand[cy*(w//2)+cx] = max(0, min(255, val_u))
+            v_cand[cy*(w//2)+cx] = max(0, min(255, val_v))
+            
+    pu = workloads.psnr(ref_u, u_cand)
+    pv = workloads.psnr(ref_v, v_cand)
+    print(f"uv_off={uv_off} -> U PSNR={pu:.2f}, V PSNR={pv:.2f}")
