+
+wl_bgr = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_bgr, 1, "/tmp/ref_bgr.raw"))
+ref_bgr = open("/tmp/ref_bgr.raw", "rb").read()
+
+w, h = 640, 480
+y_size = w * h
+u_size = (w // 2) * (h // 2)
+
+ref_y = ref_yuv420[:y_size]
+ref_u = ref_yuv420[y_size:y_size+u_size]
+ref_v = ref_yuv420[y_size+u_size:]
+
+# Get 2x2 block 0 RGBs:
+# row 0, col 0 and 1; row 1, col 0 and 1
+r00, g00, b00 = ref_bgr[2], ref_bgr[1], ref_bgr[0]
+r01, g01, b01 = ref_bgr[5], ref_bgr[4], ref_bgr[3]
+
+r10, g10, b10 = ref_bgr[w*3 + 2], ref_bgr[w*3 + 1], ref_bgr[w*3 + 0]
+r11, g11, b11 = ref_bgr[w*3 + 5], ref_bgr[w*3 + 4], ref_bgr[w*3 + 3]
+
