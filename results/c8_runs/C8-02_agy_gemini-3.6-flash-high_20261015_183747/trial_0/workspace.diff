+++ b/swscale-impl/scratch/test_uv_weights.c
@@ -0,0 +1,78 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+#define RU -4900
+#define GU -9550
+#define BU 14420
+#define RV 14379
+#define GV -12081
+#define BV -2300
+
+static inline uint8_t clamp_u8(int v) {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *rgb = malloc(w * h * 3);
+    uint8_t *ref_u = malloc(w * h / 4);
+    uint8_t *ref_v = malloc(w * h / 4);
+    
+    FILE *f_rgb = fopen("/tmp/src_rgb24.raw", "rb");
+    FILE *f_ref = fopen("/tmp/ref.raw", "rb");
+    if (!f_rgb || !f_ref) {
+        printf("Files missing\n");
+        return 1;
+    }
+    fread(rgb, 1, w * h * 3, f_rgb);
+    fseek(f_ref, w * h, SEEK_SET);
+    fread(ref_u, 1, w * h / 4, f_ref);
+    fread(ref_v, 1, w * h / 4, f_ref);
+
+    uint8_t *my_u = malloc(w * h / 4);
+    uint8_t *my_v = malloc(w * h / 4);
+
+    // Test different row weights w0, w1 for row0 and row1 (summing 1024 or 256 or 1.0)
+    for (int w0 = 0; w0 <= 8; w0++) {
+        for (int w1 = 0; w1 <= 8; w1++) {
+            if (w0 + w1 == 0) continue;
+            for (int shift = 0; shift <= 16; shift++) {
+                for (int add = 0; add <= 65536; add += 256) {
+                    double sse_u = 0;
+                    for (int y = 0; y < h; y += 2) {
+                        const uint8_t *s0 = rgb + y * w * 3;
+                        const uint8_t *s1 = rgb + (y + 1) * w * 3;
+                        for (int x = 0; x < w; x += 2) {
+                            int r0 = s0[x * 3 + 0] + s0[(x + 1) * 3 + 0];
+                            int g0 = s0[x * 3 + 1] + s0[(x + 1) * 3 + 1];
+                            int b0 = s0[x * 3 + 2] + s0[(x + 1) * 3 + 2];
+
+                            int r1 = s1[x * 3 + 0] + s1[(x + 1) * 3 + 0];
+                            int g1 = s1[x * 3 + 1] + s1[(x + 1) * 3 + 1];
+                            int b1 = s1[x * 3 + 2] + s1[(x + 1) * 3 + 2];
+
+                            int r = w0 * r0 + w1 * r1;
+                            int g = w0 * g0 + w1 * g1;
+                            int b = w0 * b0 + w1 * b1;
+
+                            int u_val = clamp_u8((RU * r + GU * g + BU * b + add) >> shift);
+                            double d = u_val - ref_u[(y / 2) * (w / 2) + x / 2];
+                            sse_u += d * d;
+                        }
+                    }
+                    if (sse_u == 0) {
+                        printf("FOUND 100.0 dB U! w0=%d, w1=%d, shift=%d, add=%d\n", w0, w1, shift, add);
+                        goto done;
+                    }
+                }
+            }
+        }
+    }
+    printf("Search finished.\n");
+done:
+    return 0;
+}
