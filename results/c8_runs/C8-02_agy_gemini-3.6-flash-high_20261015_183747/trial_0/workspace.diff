+ref_near = open("/tmp/ref_near.raw", "rb").read()
+
+# Let's check what xInc and yIncFFmpeg used!
+# xInc = (720 << 16) / 360 = 131072.
+# In FFmpeg initFilter for nearest neighbor or scaling:
+# pos = (dx * xInc) >> 16 + offset.
+# Let's check initFilter in FFmpeg source code or test different offsets in Python!
+
+# First, let's dump the src image 720x576:
+# We can run driver with src=720x576, dst=720x576
+wl_720 = dict(wl_near)
+wl_720["dst_w"], wl_720["dst_h"] = 720, 576
