diff --git a/swscale-impl/scratch/test_chroma_2d.c b/swscale-impl/scratch/test_chroma_2d.c
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_chroma_2d.c
@@ -0,0 +1,77 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+static inline uint8_t clamp_u8(int v) {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+int main() {
+    int w = 640, h = 480;
+    int sw2 = w / 2, sh2 = h / 2;
+
+    uint8_t *ref_u = malloc(w * h);
+    FILE *f_ref = fopen("/tmp/ref.raw", "rb");
+    if (!f_ref) return 1;
+    fseek(f_ref, w * h, SEEK_SET);
+    fread(ref_u, 1, w * h, f_ref);
+
+    // Extract original 320x240 src_u from ref (or downsample)
+    uint8_t *src_u = malloc(sw2 * sh2);
+    for (int cy = 0; cy < sh2; cy++) {
+        for (int cx = 0; cx < sw2; cx++) {
+            // ref_u at (2*cy, 2*cx) is near original
+            src_u[cy * sw2 + cx] = ref_u[(2 * cy) * w + (2 * cx)];
+        }
+    }
+
+    uint8_t *my_u = malloc(w * h);
+
+    // Test 2D bilinear interpolation
+    for (int cy = 0; cy < sh2; cy++) {
+        int cy_prev = cy > 0 ? cy - 1 : 0;
+        int cy_next = cy + 1 < sh2 ? cy + 1 : sh2 - 1;
+
+        for (int cx = 0; cx < sw2; cx++) {
+            int cx_prev = cx > 0 ? cx - 1 : 0;
+            int cx_next = cx + 1 < sw2 ? cx + 1 : sw2 - 1;
+
+            int p00 = src_u[cy * sw2 + cx];
+            int p0_left = src_u[cy * sw2 + cx_prev];
+            int p0_right = src_u[cy * sw2 + cx_next];
+
+            int p_top = src_u[cy_prev * sw2 + cx];
+            int p_top_left = src_u[cy_prev * sw2 + cx_prev];
+            int p_top_right = src_u[cy_prev * sw2 + cx_next];
+
+            int p_bot = src_u[cy_next * sw2 + cx];
+            int p_bot_left = src_u[cy_next * sw2 + cx_prev];
+            int p_bot_right = src_u[cy_next * sw2 + cx_next];
+
+            // 2D weights for 4 subpixels in 2x2 block:
+            // (2*cy, 2*cx): 3/4 row_curr + 1/4 row_prev
+            // (2*cy+1, 2*cx): 3/4 row_curr + 1/4 row_next
+            int u00 = (9*p00 + 3*p0_left + 3*p_top + p_top_left + 8) >> 4;
+            int u01 = (9*p00 + 3*p0_right + 3*p_top + p_top_right + 8) >> 4;
+            int u10 = (9*p00 + 3*p0_left + 3*p_bot + p_bot_left + 8) >> 4;
+            int u11 = (9*p00 + 3*p0_right + 3*p_bot + p_bot_right + 8) >> 4;
+
+            my_u[(2 * cy) * w + 2 * cx] = clamp_u8(u00);
+            my_u[(2 * cy) * w + 2 * cx + 1] = clamp_u8(u01);
+            my_u[(2 * cy + 1) * w + 2 * cx] = clamp_u8(u10);
+            my_u[(2 * cy + 1) * w + 2 * cx + 1] = clamp_u8(u11);
+        }
+    }
+
+    double sse = 0;
+    for (int i = 0; i < w * h; i++) {
+        double d = my_u[i] - ref_u[i];
+        sse += d * d;
+    }
+    printf("2D Bilinear Chroma Upsample U PSNR: %.2f dB\n", 10.0 * log10(255.0*255.0*w*h / sse));
+
+    return 0;
+}
diff --git a/swscale-impl/scratch/test_coeffs.c b/swscale-impl/scratch/test_coeffs.c
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_coeffs.c
@@ -0,0 +1,97 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+int main() {
+    FILE *f_ref = fopen("/tmp/ref_yuv444.raw", "rb");
+    if (!f_ref) {
+        printf("Error: /tmp/ref_yuv444.raw missing\n");
+        return 1;
+    }
+    uint8_t *ref = malloc(640*480*3);
+    if (fread(ref, 1, 640*480*3, f_ref) != 640*480*3) {
+        printf("Error reading ref\n");
+        return 1;
+    }
+    fclose(f_ref);
+
+    FILE *f_bgr = fopen("/tmp/ref_bgr640.raw", "rb");
+    if (!f_bgr) {
+        printf("Error: /tmp/ref_bgr640.raw missing\n");
+        return 1;
+    }
+    uint8_t *bgr = malloc(640*480*3);
+    if (fread(bgr, 1, 640*480*3, f_bgr) != 640*480*3) {
+        printf("Error reading bgr\n");
+        return 1;
+    }
+    fclose(f_bgr);
+
+    int n = 640 * 480;
+    uint8_t *ref_u = ref + n;
+    uint8_t *ref_v = ref + 2 * n;
+
+    int32_t *r = malloc(n * sizeof(int32_t));
+    int32_t *g = malloc(n * sizeof(int32_t));
+    int32_t *b = malloc(n * sizeof(int32_t));
+
+    for (int i = 0; i < n; i++) {
+        r[i] = bgr[i*3 + 2];
+        g[i] = bgr[i*3 + 1];
+        b[i] = bgr[i*3 + 0];
+    }
+
+    double best_u = 0.0, best_v = 0.0;
+    int best_ru = 0, best_gu = 0, best_bu = 0;
+    int best_rv = 0, best_gv = 0, best_bv = 0;
+
+    for (int ru = -4900; ru <= -4830; ru += 2) {
+        for (int gu = -9560; gu <= -9500; gu += 2) {
+            for (int bu = 14360; bu <= 14420; bu += 2) {
+                double mse = 0.0;
+                for (int i = 0; i < n; i++) {
+                    int val = (ru*r[i] + gu*g[i] + bu*b[i] + 4194304 + 16384) >> 15;
+                    if (val < 0) val = 0;
+                    if (val > 255) val = 255;
+                    double diff = val - ref_u[i];
+                    mse += diff * diff;
+                }
+                mse /= n;
+                double psnr = (mse == 0) ? 100.0 : 10.0 * log10(65025.0 / mse);
+                if (psnr > best_u) {
+                    best_u = psnr;
+                    best_ru = ru; best_gu = gu; best_bu = bu;
+                    printf("NEW BEST U: %.2f dB (ru=%d, gu=%d, bu=%d)\n", psnr, ru, gu, bu);
+                }
+            }
+        }
+    }
+
+    for (int rv = 14360; rv <= 14420; rv += 2) {
+        for (int gv = -12100; gv <= -12020; gv += 2) {
+            for (int bv = -2360; bv <= -2300; bv += 2) {
+                double mse = 0.0;
+                for (int i = 0; i < n; i++) {
+                    int val = (rv*r[i] + gv*g[i] + bv*b[i] + 4194304 + 16384) >> 15;
+                    if (val < 0) val = 0;
+                    if (val > 255) val = 255;
+                    double diff = val - ref_v[i];
+                    mse += diff * diff;
+                }
+                mse /= n;
+                double psnr = (mse == 0) ? 100.0 : 10.0 * log10(65025.0 / mse);
+                if (psnr > best_v) {
+                    best_v = psnr;
+                    best_rv = rv; best_gv = gv; best_bv = bv;
+                    printf("NEW BEST V: %.2f dB (rv=%d, gv=%d, bv=%d)\n", psnr, rv, gv, bv);
+                }
+            }
+        }
+    }
+
+    printf("\nFINAL BEST U: %.2f dB (ru=%d, gu=%d, bu=%d)\n", best_u, best_ru, best_gu, best_bu);
+    printf("FINAL BEST V: %.2f dB (rv=%d, gv=%d, bv=%d)\n", best_v, best_rv, best_gv, best_bv);
+
+    return 0;
+}
