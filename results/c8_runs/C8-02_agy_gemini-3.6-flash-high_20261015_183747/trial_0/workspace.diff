+import sys, os, subprocess
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv444p")][0]
+ref = open("/tmp/ref_yuv444.raw", "rb").read() if os.path.exists("/tmp/ref_yuv444.raw") else None
+
+if not ref:
+    subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, "/tmp/ref_yuv444.raw"))
+    ref = open("/tmp/ref_yuv444.raw", "rb").read()
+
+w, h = 640, 480
+ref_y = ref[:w*h]
+ref_u = ref[w*h:2*w*h]
+ref_v = ref[2*w*h:]
+
+wl_rgb = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24 640x480")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_rgb, 1, "/tmp/ref_bgr640.raw"))
+bgr = open("/tmp/ref_bgr640.raw", "rb").read()
+
+rgb = bytearray(w * h * 3)
+for i in range(w * h):
+    rgb[i*3 + 0] = bgr[i*3 + 2]
+    rgb[i*3 + 1] = bgr[i*3 + 1]
+    rgb[i*3 + 2] = bgr[i*3 + 0]
+
+best_psnr_u = 0.0
+best_params_u = None
+
+for d_ru in range(-10, 11):
+    for d_gu in range(-10, 11):
+        for d_bu in range(-10, 11):
+            ru = -4866 + d_ru
+            gu = -9528 + d_gu
+            bu = 14394 + d_bu
+            
+            u_cand = bytearray(w * h)
+            for i in range(w * h):
+                r, g, b = int(rgb[i*3]), int(rgb[i*3+1]), int(rgb[i*3+2])
+                val = (ru*r + gu*g + bu*b + 4194304 + 16384) >> 15
+                u_cand[i] = max(0, min(255, val))
+                
+            pu = workloads.psnr(ref_u, u_cand)
+            if pu > best_psnr_u:
+                best_psnr_u = pu
+                best_params_u = (ru, gu, bu)
+                print(f"New best U PSNR: {pu:.2f} dB with ru={ru}, gu={gu}, bu={bu}")
+
+print(f"BEST U: {best_psnr_u:.2f} dB with {best_params_u}")
