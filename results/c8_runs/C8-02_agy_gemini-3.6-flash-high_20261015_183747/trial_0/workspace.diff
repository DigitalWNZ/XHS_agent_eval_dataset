+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv444p")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, "/tmp/ref_yuv444.raw"))
+ref = open("/tmp/ref_yuv444.raw", "rb").read()
+
+w, h = 640, 480
+ref_u = np.frombuffer(ref[w*h:2*w*h], dtype=np.uint8).astype(np.float64)
+ref_v = np.frombuffer(ref[2*w*h:], dtype=np.uint8).astype(np.float64)
+
+wl_rgb = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24 640x480")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_rgb, 1, "/tmp/ref_bgr640.raw"))
+bgr = np.frombuffer(open("/tmp/ref_bgr640.raw", "rb").read(), dtype=np.uint8).reshape((w*h, 3))
+
+r = bgr[:, 2].astype(np.int32)
+g = bgr[:, 1].astype(np.int32)
+b = bgr[:, 0].astype(np.int32)
+
+def calc_psnr(ref_arr, cand_arr):
+    mse = np.mean((ref_arr - cand_arr) ** 2)
+    if mse == 0: return 100.0
+    return min(100.0, 10.0 * np.log10(65025.0 / mse))
+
+best_u, best_params_u = 0.0, None
+best_v, best_params_v = 0.0, None
+
+for ru in range(-4880, -4850):
+    for gu in range(-9540, -9510):
+        for bu in range(14380, 14410):
+            val_u = np.clip((ru * r + gu * g + bu * b + 4194304 + 16384) >> 15, 0, 255).astype(np.float64)
+            pu = calc_psnr(ref_u, val_u)
+            if pu > best_u:
+                best_u = pu
+                best_params_u = (ru, gu, bu)
+
+for rv in range(14380, 14410):
+    for gv in range(-12080, -12040):
+        for bv in range(-2350, -2310):
+            val_v = np.clip((rv * r + gv * g + bv * b + 4194304 + 16384) >> 15, 0, 255).astype(np.float64)
+            pv = calc_psnr(ref_v, val_v)
+            if pv > best_v:
+                best_v = pv
+                best_params_v = (rv, gv, bv)
+
+print(f"BEST U: {best_u:.2f} dB with {best_params_u}")
+print(f"BEST V: {best_v:.2f} dB with {best_params_v}")
