+++ b/swscale-impl/solve_matrix.py
@@ -0,0 +1,41 @@
+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c000_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640)).astype(float)
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320)).astype(float)
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320)).astype(float)
+
+u_up = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1)
+v_up = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1)
+
+def psnr(a, b):
+    mse = np.mean((a.astype(float) - b.astype(float))**2)
+    if mse == 0: return 100.0
+    return 10.0 * np.log10(255.0**2 / mse)
+
+# Let's test integer fixed point with different shifts and rounding
+for shift in [13, 14, 15, 16]:
+    scale = 1 << shift
+    cy = int(round(1.1643835616438356 * scale))
+    crv = int(round(1.596027397260274 * scale))
+    cbu = int(round(2.017232142857143 * scale))
+    cgu = int(round(0.391762290094914 * scale))
+    cgv = int(round(0.812967647237771 * scale))
+    
+    y_scaled = cy * (src_y - 16) + (scale >> 1)
+    
+    r = np.clip((y_scaled + crv * (v_up - 128)) / scale, 0, 255).astype(np.uint8)
+    g = np.clip((y_scaled - cgu * (u_up - 128) - cgv * (v_up - 128)) / scale, 0, 255).astype(np.uint8)
+    b = np.clip((y_scaled + cbu * (u_up - 128)) / scale, 0, 255).astype(np.uint8)
+    
+    cand = np.stack([r, g, b], axis=-1)
+    print(f"Shift {shift} PSNR:", psnr(cand, ref_rgb))
