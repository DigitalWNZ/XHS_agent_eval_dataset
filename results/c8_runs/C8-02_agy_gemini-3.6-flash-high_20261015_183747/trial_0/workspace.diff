+            const r01: i32 = ps0[(x + 1) * 4 + 2]; const g01: i32 = ps0[(x + 1) * 4 + 1]; const b01: i32 = ps0[(x + 1) * 4 + 0];
+            const r10: i32 = ps1[x * 4 + 2]; const g10: i32 = ps1[x * 4 + 1]; const b10: i32 = ps1[x * 4 + 0];
+            const r11: i32 = ps1[(x + 1) * 4 + 2]; const g11: i32 = ps1[(x + 1) * 4 + 1]; const b11: i32 = ps1[(x + 1) * 4 + 0];
+
+            py0[x] = rgb_to_y(r00, g00, b00); py0[x + 1] = rgb_to_y(r01, g01, b01);
+            py1[x] = rgb_to_y(r10, g10, b10); py1[x + 1] = rgb_to_y(r11, g11, b11);
+
+            const r0 = r00 + r01; const g0 = g00 + g01; const b0 = b00 + b01;
+            const r1 = r10 + r11; const g1 = g10 + g11; const b1 = b10 + b11;
+
+            const du0 = (RU * r0 + GU * g0 + BU * b0 + 8388608 + 256) >> 9;
+            const du1 = (RU * r1 + GU * g1 + BU * b1 + 8388608 + 256) >> 9;
+            const dv0 = (RV * r0 + GV * g0 + BV * b0 + 8388608 + 256) >> 9;
+            const dv1 = (RV * r1 + GV * g1 + BV * b1 + 8388608 + 256) >> 9;
+
+            pu[x / 2] = clamp_u8((du0 + du1 + 128) >> 8);
+            pv[x / 2] = clamp_u8((dv0 + dv1 + 128) >> 8);
+        }
+    }
+}
+
+// ── GRAY8 Conversions ───────────────────────────────────────────────────────
+
+pub fn gray8_to_rgb24(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        const ps = src + y * src_stride; const pd = dst + y * dst_stride;
+        for (0..width) |x| {
+            const val = ps[x]; pd[x * 3 + 0] = val; pd[x * 3 + 1] = val; pd[x * 3 + 2] = val;
+        }
+    }
+}
+
+pub fn gray8_to_rgba(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        const ps = src + y * src_stride; const pd = dst + y * dst_stride;
+        for (0..width) |x| {
+            const val = ps[x]; pd[x * 4 + 0] = val; pd[x * 4 + 1] = val; pd[x * 4 + 2] = val; pd[x * 4 + 3] = 255;
+        }
+    }
+}
+
+pub fn gray8_to_yuv420p(src: [*]const u8, src_stride: usize, dst_y: [*]u8, dst_u: [*]u8, dst_v: [*]u8, dy_stride: usize, du_stride: usize, dv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src + y * src_stride)[0..width]);
+    }
+    for (0..height / 2) |y| {
+        @memset((dst_u + y * du_stride)[0 .. width / 2], 128);
+        @memset((dst_v + y * dv_stride)[0 .. width / 2], 128);
+    }
+}
+
+pub fn rgb24_to_gray8(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        const ps = src + y * src_stride; const pd = dst + y * dst_stride;
+        for (0..width) |x| {
+            const r: i32 = ps[x * 3 + 0]; const g: i32 = ps[x * 3 + 1]; const b: i32 = ps[x * 3 + 2];
+            pd[x] = clamp_u8((19595 * r + 38470 * g + 7471 * b + 32768) >> 16);
+        }
+    }
+}
+
+pub fn rgba_to_gray8(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        const ps = src + y * src_stride; const pd = dst + y * dst_stride;
+        for (0..width) |x| {
+            const r: i32 = ps[x * 4 + 0]; const g: i32 = ps[x * 4 + 1]; const b: i32 = ps[x * 4 + 2];
+            pd[x] = clamp_u8((19595 * r + 38470 * g + 7471 * b + 32768) >> 16);
+        }
+    }
+}
+
+// ── YUV Planar <-> Semi-Planar Conversions ─────────────────────────────────
+
+pub fn yuv420p_to_nv12(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst_y: [*]u8, dst_uv: [*]u8, dy_stride: usize, duv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src_y + y * sy_stride)[0..width]);
+    }
+    for (0..height / 2) |y| {
+        const pu = src_u + y * su_stride; const pv = src_v + y * sv_stride; const puv = dst_uv + y * duv_stride;
+        for (0..width / 2) |x| {
+            puv[x * 2 + 0] = pu[x]; puv[x * 2 + 1] = pv[x];
+        }
+    }
+}
+
+pub fn nv12_to_yuv420p(src_y: [*]const u8, src_uv: [*]const u8, sy_stride: usize, suv_stride: usize, dst_y: [*]u8, dst_u: [*]u8, dst_v: [*]u8, dy_stride: usize, du_stride: usize, dv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src_y + y * sy_stride)[0..width]);
+    }
+    for (0..height / 2) |y| {
+        const puv = src_uv + y * suv_stride; const pu = dst_u + y * du_stride; const pv = dst_v + y * dv_stride;
+        for (0..width / 2) |x| {
+            pu[x] = puv[x * 2 + 0]; pv[x] = puv[x * 2 + 1];
+        }
+    }
+}
+
+pub fn nv21_to_yuv420p(src_y: [*]const u8, src_vu: [*]const u8, sy_stride: usize, svu_stride: usize, dst_y: [*]u8, dst_u: [*]u8, dst_v: [*]u8, dy_stride: usize, du_stride: usize, dv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src_y + y * sy_stride)[0..width]);
+    }
+    for (0..height / 2) |y| {
+        const pvu = src_vu + y * svu_stride; const pu = dst_u + y * du_stride; const pv = dst_v + y * dv_stride;
+        for (0..width / 2) |x| {
+            pv[x] = pvu[x * 2 + 0]; pu[x] = pvu[x * 2 + 1];
+        }
+    }
+}
+
+pub fn yuv420p_to_yuv444p(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst_y: [*]u8, dst_u: [*]u8, dst_v: [*]u8, dy_stride: usize, du_stride: usize, dv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src_y + y * sy_stride)[0..width]);
+    }
+
+    const sw2 = width / 2; const sh2 = height / 2;
+    for (0..sh2) |cy| {
+        const cy_prev = if (cy == 0) 0 else cy - 1;
+        const cy_next = if (cy + 1 < sh2) cy + 1 else sh2 - 1;
+
+        const pu0 = src_u + cy * su_stride;
+        const pu_t = src_u + cy_prev * su_stride;
+        const pu_b = src_u + cy_next * su_stride;
+
+        const pv0 = src_v + cy * sv_stride;
+        const pv_t = src_v + cy_prev * sv_stride;
+        const pv_b = src_v + cy_next * sv_stride;
+
+        const du0 = dst_u + (cy * 2) * du_stride; const du1 = dst_u + (cy * 2 + 1) * du_stride;
+        const dv0 = dst_v + (cy * 2) * dv_stride; const dv1 = dst_v + (cy * 2 + 1) * dv_stride;
+
+        for (0..sw2) |cx| {
+            const cx_prev = if (cx == 0) 0 else cx - 1;
+            const cx_next = if (cx + 1 < sw2) cx + 1 else sw2 - 1;
+
+            // U subpixels
+            const u_curr: i32 = pu0[cx]; const u_l: i32 = pu0[cx_prev]; const u_r: i32 = pu0[cx_next];
+            const u_t: i32 = pu_t[cx]; const u_tl: i32 = pu_t[cx_prev]; const u_tr: i32 = pu_t[cx_next];
+            const u_b: i32 = pu_b[cx]; const u_bl: i32 = pu_b[cx_prev]; const u_br: i32 = pu_b[cx_next];
+
+            du0[cx * 2 + 0] = clamp_u8((9 * u_curr + 3 * u_l + 3 * u_t + u_tl + 8) >> 4);
+            du0[cx * 2 + 1] = clamp_u8((9 * u_curr + 3 * u_r + 3 * u_t + u_tr + 8) >> 4);
+            du1[cx * 2 + 0] = clamp_u8((9 * u_curr + 3 * u_l + 3 * u_b + u_bl + 8) >> 4);
+            du1[cx * 2 + 1] = clamp_u8((9 * u_curr + 3 * u_r + 3 * u_b + u_br + 8) >> 4);
+
+            // V subpixels
+            const v_curr: i32 = pv0[cx]; const v_l: i32 = pv0[cx_prev]; const v_r: i32 = pv0[cx_next];
+            const v_t: i32 = pv_t[cx]; const v_tl: i32 = pv_t[cx_prev]; const v_tr: i32 = pv_t[cx_next];
+            const v_b: i32 = pv_b[cx]; const v_bl: i32 = pv_b[cx_prev]; const v_br: i32 = pv_b[cx_next];
+
+            dv0[cx * 2 + 0] = clamp_u8((9 * v_curr + 3 * v_l + 3 * v_t + v_tl + 8) >> 4);
+            dv0[cx * 2 + 1] = clamp_u8((9 * v_curr + 3 * v_r + 3 * v_t + v_tr + 8) >> 4);
+            dv1[cx * 2 + 0] = clamp_u8((9 * v_curr + 3 * v_l + 3 * v_b + v_bl + 8) >> 4);
+            dv1[cx * 2 + 1] = clamp_u8((9 * v_curr + 3 * v_r + 3 * v_b + v_br + 8) >> 4);
+        }
+    }
+}
+
+pub fn yuv422p_to_yuv420p(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst_y: [*]u8, dst_u: [*]u8, dst_v: [*]u8, dy_stride: usize, du_stride: usize, dv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src_y + y * sy_stride)[0..width]);
+    }
+    const sh2 = height / 2;
+    for (0..sh2) |y| {
+        const y0 = if (y == 0) 0 else 2 * y - 1;
+        const y1 = 2 * y;
+        const y2 = 2 * y + 1;
+        const y3 = if (2 * y + 2 < height) 2 * y + 2 else height - 1;
+
+        const pu0 = src_u + y0 * su_stride; const pu1 = src_u + y1 * su_stride;
+        const pu2 = src_u + y2 * su_stride; const pu3 = src_u + y3 * su_stride;
+
+        const pv0 = src_v + y0 * sv_stride; const pv1 = src_v + y1 * sv_stride;
+        const pv2 = src_v + y2 * sv_stride; const pv3 = src_v + y3 * sv_stride;
+
+        const du = dst_u + y * du_stride; const dv = dst_v + y * dv_stride;
+        for (0..width / 2) |x| {
+            const u_val = (@as(i32, pu0[x]) + 3 * @as(i32, pu1[x]) + 3 * @as(i32, pu2[x]) + pu3[x] + 4) >> 3;
+            const v_val = (@as(i32, pv0[x]) + 3 * @as(i32, pv1[x]) + 3 * @as(i32, pv2[x]) + pv3[x] + 4) >> 3;
+            du[x] = clamp_u8(u_val);
+            dv[x] = clamp_u8(v_val);
+        }
+    }
+}
+
+pub fn yuv444p_to_yuv420p(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst_y: [*]u8, dst_u: [*]u8, dst_v: [*]u8, dy_stride: usize, du_stride: usize, dv_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        @memcpy((dst_y + y * dy_stride)[0..width], (src_y + y * sy_stride)[0..width]);
+    }
+    const sh2 = height / 2;
+    const sw2 = width / 2;
+    for (0..sh2) |y| {
+        const y0 = if (y == 0) 0 else 2 * y - 1;
+        const y1 = 2 * y;
+        const y2 = 2 * y + 1;
+        const y3 = if (2 * y + 2 < height) 2 * y + 2 else height - 1;
+
+        const pu0 = src_u + y0 * su_stride; const pu1 = src_u + y1 * su_stride;
+        const pu2 = src_u + y2 * su_stride; const pu3 = src_u + y3 * su_stride;
+
+        const pv0 = src_v + y0 * sv_stride; const pv1 = src_v + y1 * sv_stride;
+        const pv2 = src_v + y2 * sv_stride; const pv3 = src_v + y3 * sv_stride;
+
+        const du = dst_u + y * du_stride; const dv = dst_v + y * dv_stride;
+        for (0..sw2) |x| {
+            const x0 = if (x == 0) 0 else 2 * x - 1;
+            const x1 = 2 * x;
+            const x2 = 2 * x + 1;
+            const x3 = if (2 * x + 2 < width) 2 * x + 2 else width - 1;
+
+            const su0 = @as(i32, pu0[x0]) + 3 * @as(i32, pu0[x1]) + 3 * @as(i32, pu0[x2]) + pu0[x3];
+            const su1 = @as(i32, pu1[x0]) + 3 * @as(i32, pu1[x1]) + 3 * @as(i32, pu1[x2]) + pu1[x3];
+            const su2 = @as(i32, pu2[x0]) + 3 * @as(i32, pu2[x1]) + 3 * @as(i32, pu2[x2]) + pu2[x3];
+            const su3 = @as(i32, pu3[x0]) + 3 * @as(i32, pu3[x1]) + 3 * @as(i32, pu3[x2]) + pu3[x3];
+
+            const sv0 = @as(i32, pv0[x0]) + 3 * @as(i32, pv0[x1]) + 3 * @as(i32, pv0[x2]) + pv0[x3];
+            const sv1 = @as(i32, pv1[x0]) + 3 * @as(i32, pv1[x1]) + 3 * @as(i32, pv1[x2]) + pv1[x3];
+            const sv2 = @as(i32, pv2[x0]) + 3 * @as(i32, pv2[x1]) + 3 * @as(i32, pv2[x2]) + pv2[x3];
+            const sv3 = @as(i32, pv3[x0]) + 3 * @as(i32, pv3[x1]) + 3 * @as(i32, pv3[x2]) + pv3[x3];
+
+            const u_val = (su0 + 3 * su1 + 3 * su2 + su3 + 32) >> 6;
+            const v_val = (sv0 + 3 * sv1 + 3 * sv2 + sv3 + 32) >> 6;
+
+            du[x] = clamp_u8(u_val);
+            dv[x] = clamp_u8(v_val);
+        }
+    }
+}
+
+// ── Packed RGB / BGR / RGBA / BGRA Swaps ────────────────────────────────────
+
+pub fn rgb24_to_bgr24(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    for (0..height) |y| {
+        const ps = src + y * src_stride; const pd = dst + y * dst_stride;
+        for (0..width) |x| {
+            pd[x * 3 + 0] = ps[x * 3 + 2]; pd[x * 3 + 1] = ps[x * 3 + 1]; pd[x * 3 + 2] = ps[x * 3 + 0];
+        }
+    }
+}
