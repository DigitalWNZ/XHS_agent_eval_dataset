diff --git a/swscale-impl/scratch/test_bilinear_chroma.py b/swscale-impl/scratch/test_bilinear_chroma.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_bilinear_chroma.py
@@ -0,0 +1,68 @@
+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("yuv420p->yuv444p")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, "/tmp/ref_yuv444.raw"))
+ref = open("/tmp/ref_yuv444.raw", "rb").read()
+
+# Get source yuv420p image from driver
+wl_420 = [w for w in workloads.correctness_workloads() if w["label"].startswith("yuv420p->gray8")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_420, 1, "/tmp/ref_420.raw"))
+
+# Source 420 chroma size: 320x240
+# Wait, let's get source 420 U and V planes using driver yuv420p->yuv420p scale or reading:
+# For yuv420p->yuv420p (640x480->640x480), ref_420 is Y(640x480), U(320x240), V(320x240)
+wl_420_420 = [w for w in workloads.correctness_workloads() if w["label"].startswith("yuv420p->nv12")][0]
+# In yuv420p->nv12: Y is 640x480, UV is 320x240 interleaved
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_420_420, 1, "/tmp/ref_nv12.raw"))
+ref_nv12 = open("/tmp/ref_nv12.raw", "rb").read()
+
+w, h = 640, 480
+y_size = w * h
+u_size = w * h
+
+ref_u = ref[y_size:y_size+u_size]
+
+# Extract U from nv12
+uv_src = ref_nv12[y_size:]
+src_u = np.frombuffer(uv_src[0::2], dtype=np.uint8).reshape((240, 320))
+
+# Let's test bilinear scaling 320x240 -> 640x480
+# In FFmpeg, xInc = (320 << 16) / 640 = 32768 = 0.5 src pixels per dst pixel.
+# yInc = (240 << 16) / 480 = 32768.
+# Coordinate mapping in swscale for chroma upscale:
+# dx * xInc = dx * 32768.
+# dy * yInc = dy * 32768.
+
+dst_u = np.zeros((480, 640), dtype=np.uint8)
+xInc = (320 << 16) // 640
+yInc = (240 << 16) // 480
+
+for dy in range(480):
+    y_src = dy * yInc
+    sy0 = y_src >> 16
+    sy1 = min(sy0 + 1, 239)
+    frac_y = (y_src & 0xFFFF) >> 2 # 14-bit
+    wy0 = 16384 - frac_y
+    wy1 = frac_y
+    for dx in range(640):
+        x_src = dx * xInc
+        sx0 = x_src >> 16
+        sx1 = min(sx0 + 1, 319)
+        frac_x = (x_src & 0xFFFF) >> 2 # 14-bit
+        wx0 = 16384 - frac_x
+        wx1 = frac_x
+        
+        p00 = src_u[sy0, sx0]
+        p01 = src_u[sy0, sx1]
+        p10 = src_u[sy1, sx0]
+        p11 = src_u[sy1, sx1]
+        
+        val = (p00 * wx0 * wy0 + p01 * wx1 * wy0 + p10 * wx0 * wy1 + p11 * wx1 * wy1 + (1 << 27)) >> 28
+        dst_u[dy, dx] = max(0, min(255, val))
+
+print("Bilinear 420->444 U PSNR:", workloads.psnr(ref_u, dst_u.tobytes()))
+print("Ref U row 0 x=0..7:", list(ref_u[:8]))
+print("Dst U row 0 x=0..7:", list(dst_u[0, :8]))
