@@ -0,0 +1,502 @@
+const std = @import("std");
+const formats = @import("formats.zig");
+const context = @import("context.zig");
+const convert = @import("convert.zig");
+const scale = @import("scale.zig");
+
+const SwsContext = context.SwsContext;
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+
+    const ctx = std.heap.c_allocator.create(SwsContext) catch return null;
+    ctx.* = .{
+        .src_w = @intCast(src_w),
+        .src_h = @intCast(src_h),
+        .src_fmt = src_fmt,
+        .dst_w = @intCast(dst_w),
+        .dst_h = @intCast(dst_h),
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+    };
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
