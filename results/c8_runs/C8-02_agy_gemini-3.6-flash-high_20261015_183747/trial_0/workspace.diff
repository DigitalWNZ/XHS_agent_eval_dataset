+    if (!f_rgb || !f_ref) {
+        printf("Files missing\n");
+        return 1;
+    }
+    fread(rgb, 1, w * h * 3, f_rgb);
+    fseek(f_ref, w * h, SEEK_SET);
+    fread(ref_u, 1, w * h / 4, f_ref);
+    fread(ref_v, 1, w * h / 4, f_ref);
+
+    uint8_t *my_u = malloc(w * h / 4);
+    uint8_t *my_v = malloc(w * h / 4);
+
+    for (int y = 0; y < h; y += 2) {
+        const uint8_t *src1 = rgb + y * w * 3;
+        for (int i = 0; i < w / 2; i++) {
+            int r = src1[6 * i + 0] + src1[6 * i + 3];
+            int g = src1[6 * i + 1] + src1[6 * i + 4];
+            int b = src1[6 * i + 2] + src1[6 * i + 5];
+
+            int u16 = (RU * r + GU * g + BU * b + (256 << 15) + (1 << 9)) >> 10;
+            int v16 = (RV * r + GV * g + BV * b + (256 << 15) + (1 << 9)) >> 10;
+
+            my_u[(y / 2) * (w / 2) + i] = clamp_u8((u16 + 128) >> 8);
+            my_v[(y / 2) * (w / 2) + i] = clamp_u8((v16 + 128) >> 8);
+        }
+    }
