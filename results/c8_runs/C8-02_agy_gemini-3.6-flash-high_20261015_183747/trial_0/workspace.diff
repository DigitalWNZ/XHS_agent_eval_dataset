diff --git a/swscale-impl/src/convert.zig b/swscale-impl/src/convert.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/convert.zig
@@ -0,0 +1,796 @@
+const std = @import("std");
+
+inline fn clamp_u8(val: i32) u8 {
+    if (val < 0) return 0;
+    if (val > 255) return 255;
+    return @intCast(val);
+}
+
+// ── YUV -> RGB Table ─────────────────────────────────────────────────────────
+
+pub const Yuv2RgbTable = struct {
+    y_table: [3072]u8,
+    r_off: [256]i32,
+    b_off: [256]i32,
+    gu_off: [256]i32,
+    gv_off: [256]i32,
+
+    pub fn init() Yuv2RgbTable {
+        var table: Yuv2RgbTable = undefined;
+        const cy: i64 = 76309;
+        const oy: i64 = 1048576;
+
+        var yb: i64 = -(384 * 65536) - 1024 * cy - oy;
+        for (0..3072) |i| {
+            var val = (yb + 32768) >> 16;
+            if (val < 0) val = 0;
+            if (val > 255) val = 255;
+            table.y_table[i] = @intCast(val);
+            yb += cy;
+        }
+
+        const crv_scaled: i32 = 89849;
+        const cbu_scaled: i32 = 113543;
+        const cgu_scaled: i32 = 22049;
+        const cgv_scaled: i32 = 45756;
+
+        for (0..256) |i| {
+            const v: i32 = @intCast(i);
+            const u: i32 = @intCast(i);
+
+            table.r_off[i] = @divFloor(v * crv_scaled, 65536);
+            table.b_off[i] = @divFloor(u * cbu_scaled, 65536);
+            table.gu_off[i] = @divFloor(u * cgu_scaled, 65536);
+            table.gv_off[i] = @divFloor(v * cgv_scaled, 65536);
+        }
+
+        return table;
+    }
+};
+
+pub var global_yuv2rgb_table: ?Yuv2RgbTable = null;
+
+pub fn get_yuv2rgb_table() *const Yuv2RgbTable {
+    if (global_yuv2rgb_table == null) {
+        global_yuv2rgb_table = Yuv2RgbTable.init();
+    }
+    return &global_yuv2rgb_table.?;
+}
+
+inline fn clamp_idx(idx: i32) usize {
+    if (idx < 0) return 0;
+    if (idx >= 3072) return 3071;
+    return @intCast(idx);
+}
+
+inline fn yuv_to_rgb_pixel(table: *const Yuv2RgbTable, y_val: i32, u_val: usize, v_val: usize, out: *[3]u8, is_bgr: bool) void {
+    const yoffs: i32 = 326 + 1024;
+    const off_r: i32 = 175;
+    const off_b: i32 = 221;
+
+    const cb_r = table.r_off[v_val];
+    const cb_b = table.b_off[u_val];
+    const cb_gu = table.gu_off[u_val];
+    const cb_gv = table.gv_off[v_val];
+
+    const r_idx = clamp_idx(yoffs - off_r + cb_r + y_val);
+    const b_idx = clamp_idx(yoffs - off_b + cb_b + y_val);
+    const g_idx = clamp_idx(yoffs + 132 - cb_gu - cb_gv + y_val);
+
+    const r = table.y_table[r_idx];
+    const g = table.y_table[g_idx];
+    const b = table.y_table[b_idx];
+
+    if (!is_bgr) {
+        out[0] = r; out[1] = g; out[2] = b;
+    } else {
+        out[0] = b; out[1] = g; out[2] = r;
+    }
+}
+
+// ── YUV420P -> RGB24 / BGR24 / RGBA / BGRA ──────────────────────────────────
+
+pub fn yuv420p_to_rgb24(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    const table = get_yuv2rgb_table();
+    for (0..height) |y| {
+        const py = src_y + y * sy_stride; const pu = src_u + (y / 2) * su_stride; const pv = src_v + (y / 2) * sv_stride; const pd = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < width) : (x += 1) {
+            var rgb: [3]u8 = undefined;
+            yuv_to_rgb_pixel(table, py[x], pu[x / 2], pv[x / 2], &rgb, false);
+            pd[x * 3 + 0] = rgb[0]; pd[x * 3 + 1] = rgb[1]; pd[x * 3 + 2] = rgb[2];
+        }
+    }
+}
+
+pub fn yuv420p_to_bgr24(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    const table = get_yuv2rgb_table();
+    for (0..height) |y| {
+        const py = src_y + y * sy_stride; const pu = src_u + (y / 2) * su_stride; const pv = src_v + (y / 2) * sv_stride; const pd = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < width) : (x += 1) {
+            var rgb: [3]u8 = undefined;
+            yuv_to_rgb_pixel(table, py[x], pu[x / 2], pv[x / 2], &rgb, true);
+            pd[x * 3 + 0] = rgb[0]; pd[x * 3 + 1] = rgb[1]; pd[x * 3 + 2] = rgb[2];
+        }
+    }
+}
+
+pub fn yuv420p_to_rgba(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    const table = get_yuv2rgb_table();
+    for (0..height) |y| {
+        const py = src_y + y * sy_stride; const pu = src_u + (y / 2) * su_stride; const pv = src_v + (y / 2) * sv_stride; const pd = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < width) : (x += 1) {
+            var rgb: [3]u8 = undefined;
+            yuv_to_rgb_pixel(table, py[x], pu[x / 2], pv[x / 2], &rgb, false);
+            pd[x * 4 + 0] = rgb[0]; pd[x * 4 + 1] = rgb[1]; pd[x * 4 + 2] = rgb[2]; pd[x * 4 + 3] = 255;
+        }
+    }
+}
+
+pub fn yuv420p_to_bgra(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    const table = get_yuv2rgb_table();
+    for (0..height) |y| {
+        const py = src_y + y * sy_stride; const pu = src_u + (y / 2) * su_stride; const pv = src_v + (y / 2) * sv_stride; const pd = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < width) : (x += 1) {
+            var rgb: [3]u8 = undefined;
+            yuv_to_rgb_pixel(table, py[x], pu[x / 2], pv[x / 2], &rgb, true);
+            pd[x * 4 + 0] = rgb[0]; pd[x * 4 + 1] = rgb[1]; pd[x * 4 + 2] = rgb[2]; pd[x * 4 + 3] = 255;
+        }
+    }
+}
+
+// ── YUV422P / YUV444P -> RGB / BGR / RGBA ───────────────────────────────────
+
+pub fn yuv422p_to_rgb24(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    const table = get_yuv2rgb_table();
+    for (0..height) |y| {
+        const py = src_y + y * sy_stride; const pu = src_u + y * su_stride; const pv = src_v + y * sv_stride; const pd = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < width) : (x += 1) {
+            var rgb: [3]u8 = undefined;
+            yuv_to_rgb_pixel(table, py[x], pu[x / 2], pv[x / 2], &rgb, false);
+            pd[x * 3 + 0] = rgb[0]; pd[x * 3 + 1] = rgb[1]; pd[x * 3 + 2] = rgb[2];
+        }
+    }
+}
+
+pub fn yuv422p_to_rgba(src_y: [*]const u8, src_u: [*]const u8, src_v: [*]const u8, sy_stride: usize, su_stride: usize, sv_stride: usize, dst: [*]u8, dst_stride: usize, width: usize, height: usize) void {
+    const table = get_yuv2rgb_table();
+    for (0..height) |y| {
+        const py = src_y + y * sy_stride; const pu = src_u + y * su_stride; const pv = src_v + y * sv_stride; const pd = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < width) : (x += 1) {
+            var rgb: [3]u8 = undefined;
+            yuv_to_rgb_pixel(table, py[x], pu[x / 2], pv[x / 2], &rgb, false);
+            pd[x * 4 + 0] = rgb[0]; pd[x * 4 + 1] = rgb[1]; pd[x * 4 + 2] = rgb[2]; pd[x * 4 + 3] = 255;
+        }
+    }
+}
+
+inline fn yuv_to_rgb_direct(y_val: i32, u_val: i32, v_val: i32, out: *[3]u8, is_bgr: bool) void {
+    const dy = y_val - 16;
+    const du = u_val - 128;
+    const dv = v_val - 128;
+
+    const y_scaled = 76309 * dy + 32768;
+    const r = clamp_u8((y_scaled + 104597 * dv) >> 16);
+    const g = clamp_u8((y_scaled - 25675 * du - 53279 * dv) >> 16);
+    const b = clamp_u8((y_scaled + 132201 * du) >> 16);
