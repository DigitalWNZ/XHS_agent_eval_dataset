diff --git a/swscale-impl/scratch/test_rgb420_formula.c b/swscale-impl/scratch/test_rgb420_formula.c
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_rgb420_formula.c
@@ -0,0 +1,136 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+#define RY 8403
+#define GY 16521
+#define BY 3214
+#define RU -4900
+#define GU -9550
+#define BU 14420
+#define RV 14379
+#define GV -12081
+#define BV -2300
+
+static inline uint8_t clamp_u8(int v) {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *rgb = malloc(w * h * 3);
+    uint8_t *ref_u = malloc(w * h / 4);
+    uint8_t *ref_v = malloc(w * h / 4);
+    
+    FILE *f_rgb = fopen("/tmp/src_rgb24.raw", "rb");
+    FILE *f_ref = fopen("/tmp/ref.raw", "rb");
+    if (!f_rgb || !f_ref) {
+        printf("Files missing\n");
+        return 1;
+    }
+    fread(rgb, 1, w * h * 3, f_rgb);
+    fseek(f_ref, w * h, SEEK_SET);
+    fread(ref_u, 1, w * h / 4, f_ref);
+    fread(ref_v, 1, w * h / 4, f_ref);
+
+    uint8_t *my_u = malloc(w * h / 4);
+    uint8_t *my_v = malloc(w * h / 4);
+
+    // Formula 1: ff_rgb24toyv12_c (avg RGB then shift)
+    for (int y = 0; y < h; y += 2) {
+        for (int x = 0; x < w; x += 2) {
+            int r00 = rgb[(y*w + x)*3 + 0], g00 = rgb[(y*w + x)*3 + 1], b00 = rgb[(y*w + x)*3 + 2];
+            int r01 = rgb[(y*w + x+1)*3 + 0], g01 = rgb[(y*w + x+1)*3 + 1], b01 = rgb[(y*w + x+1)*3 + 2];
+            int r10 = rgb[((y+1)*w + x)*3 + 0], g10 = rgb[((y+1)*w + x)*3 + 1], b10 = rgb[((y+1)*w + x)*3 + 2];
+            int r11 = rgb[((y+1)*w + x+1)*3 + 0], g11 = rgb[((y+1)*w + x+1)*3 + 1], b11 = rgb[((y+1)*w + x+1)*3 + 2];
+
+            int rx = (r00 + r01 + r10 + r11) >> 2;
+            int gx = (g00 + g01 + g10 + g11) >> 2;
+            int bx = (b00 + b01 + b10 + b11) >> 2;
+
+            my_u[(y/2)*(w/2) + x/2] = clamp_u8(((RU*rx + GU*gx + BU*bx + 4194304 + 16384) >> 15));
+            my_v[(y/2)*(w/2) + x/2] = clamp_u8(((RV*rx + GV*gx + BV*bx + 4194304 + 16384) >> 15));
+        }
+    }
+
+    double sse_u = 0, sse_v = 0;
+    for (int i = 0; i < w * h / 4; i++) {
+        double du = my_u[i] - ref_u[i];
+        sse_u += du * du;
+        double dv = my_v[i] - ref_v[i];
+        sse_v += dv * dv;
+    }
+
+    printf("Formula 1 (avg then shift+rnd): U PSNR: %.2f dB, V PSNR: %.2f dB\n",
+        sse_u == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_u),
+        sse_v == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_v));
+
+    // Formula 2: truncating shift without + 16384
+    for (int y = 0; y < h; y += 2) {
+        for (int x = 0; x < w; x += 2) {
+            int r00 = rgb[(y*w + x)*3 + 0], g00 = rgb[(y*w + x)*3 + 1], b00 = rgb[(y*w + x)*3 + 2];
+            int r01 = rgb[(y*w + x+1)*3 + 0], g01 = rgb[(y*w + x+1)*3 + 1], b01 = rgb[(y*w + x+1)*3 + 2];
+            int r10 = rgb[((y+1)*w + x)*3 + 0], g10 = rgb[((y+1)*w + x)*3 + 1], b10 = rgb[((y+1)*w + x)*3 + 2];
+            int r11 = rgb[((y+1)*w + x+1)*3 + 0], g11 = rgb[((y+1)*w + x+1)*3 + 1], b11 = rgb[((y+1)*w + x+1)*3 + 2];
+
+            int rx = (r00 + r01 + r10 + r11) >> 2;
+            int gx = (g00 + g01 + g10 + g11) >> 2;
+            int bx = (b00 + b01 + b10 + b11) >> 2;
+
+            my_u[(y/2)*(w/2) + x/2] = clamp_u8(((RU*rx + GU*gx + BU*bx) >> 15) + 128);
+            my_v[(y/2)*(w/2) + x/2] = clamp_u8(((RV*rx + GV*gx + BV*bx) >> 15) + 128);
+        }
+    }
+
+    sse_u = 0; sse_v = 0;
+    for (int i = 0; i < w * h / 4; i++) {
+        double du = my_u[i] - ref_u[i];
+        sse_u += du * du;
+        double dv = my_v[i] - ref_v[i];
+        sse_v += dv * dv;
+    }
+
+    printf("Formula 2 (truncating shift): U PSNR: %.2f dB, V PSNR: %.2f dB\n",
+        sse_u == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_u),
+        sse_v == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_v));
+
+    // Formula 3: sum of 4 UV pixels computed individually then >> 2
+    for (int y = 0; y < h; y += 2) {
+        for (int x = 0; x < w; x += 2) {
+            int r00 = rgb[(y*w + x)*3 + 0], g00 = rgb[(y*w + x)*3 + 1], b00 = rgb[(y*w + x)*3 + 2];
+            int r01 = rgb[(y*w + x+1)*3 + 0], g01 = rgb[(y*w + x+1)*3 + 1], b01 = rgb[(y*w + x+1)*3 + 2];
+            int r10 = rgb[((y+1)*w + x)*3 + 0], g10 = rgb[((y+1)*w + x)*3 + 1], b10 = rgb[((y+1)*w + x)*3 + 2];
+            int r11 = rgb[((y+1)*w + x+1)*3 + 0], g11 = rgb[((y+1)*w + x+1)*3 + 1], b11 = rgb[((y+1)*w + x+1)*3 + 2];
+
+            int u00 = clamp_u8((RU*r00 + GU*g00 + BU*b00 + 4194304 + 16384) >> 15);
+            int u01 = clamp_u8((RU*r01 + GU*g01 + BU*b01 + 4194304 + 16384) >> 15);
+            int u10 = clamp_u8((RU*r10 + GU*g10 + BU*b10 + 4194304 + 16384) >> 15);
+            int u11 = clamp_u8((RU*r11 + GU*g11 + BU*b11 + 4194304 + 16384) >> 15);
+
+            int v00 = clamp_u8((RV*r00 + GV*g00 + BV*b00 + 4194304 + 16384) >> 15);
+            int v01 = clamp_u8((RV*r01 + GV*g01 + BV*b01 + 4194304 + 16384) >> 15);
+            int v10 = clamp_u8((RV*r10 + GV*g10 + BV*b10 + 4194304 + 16384) >> 15);
+            int v11 = clamp_u8((RV*r11 + GV*g11 + BV*b11 + 4194304 + 16384) >> 15);
+
+            my_u[(y/2)*(w/2) + x/2] = (u00 + u01 + u10 + u11 + 2) >> 2;
+            my_v[(y/2)*(w/2) + x/2] = (v00 + v01 + v10 + v11 + 2) >> 2;
+        }
+    }
+
+    sse_u = 0; sse_v = 0;
+    for (int i = 0; i < w * h / 4; i++) {
+        double du = my_u[i] - ref_u[i];
+        sse_u += du * du;
+        double dv = my_v[i] - ref_v[i];
+        sse_v += dv * dv;
+    }
+
+    printf("Formula 3 (convert then avg 4 UV): U PSNR: %.2f dB, V PSNR: %.2f dB\n",
+        sse_u == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_u),
+        sse_v == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_v));
+
+    return 0;
+}
