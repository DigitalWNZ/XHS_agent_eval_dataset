diff --git a/swscale-impl/scratch/find_uv_formula.py b/swscale-impl/scratch/find_uv_formula.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/find_uv_formula.py
@@ -0,0 +1,88 @@
+import sys, os, subprocess
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl_yuv420 = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv420p")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_yuv420, 1, "/tmp/ref_yuv420.raw"))
+ref_yuv420 = open("/tmp/ref_yuv420.raw", "rb").read()
+
+wl_bgr = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_bgr, 1, "/tmp/ref_bgr.raw"))
+ref_bgr = open("/tmp/ref_bgr.raw", "rb").read()
+
+w, h = 640, 480
+y_size = w * h
+u_size = (w // 2) * (h // 2)
+
+ref_u = ref_yuv420[y_size:y_size+u_size]
+ref_v = ref_yuv420[y_size+u_size:]
+
+# Parse RGB
+rgb = bytearray(w * h * 3)
+for i in range(w * h):
+    rgb[i*3 + 0] = ref_bgr[i*3 + 2] # R
+    rgb[i*3 + 1] = ref_bgr[i*3 + 1] # G
+    rgb[i*3 + 2] = ref_bgr[i*3 + 0] # B
+
+ru, gu, bu = -4866, -9528, 14394
+rv, gv, bv = 14394, -12061, -2333
+
+def calc_u(r, g, b):
+    return max(0, min(255, (ru*r + gu*g + bu*b + 4194304 + 16384) >> 15))
+
+def calc_v(r, g, b):
+    return max(0, min(255, (rv*r + gv*g + bv*b + 4194304 + 16384) >> 15))
+
+# Let's test different U,V generation pipelines on 100 chroma samples
+# Candidate 1: 2x2 sum of R, G, B with 15-bit shift (FFmpeg's rgb24ToUV_half_c on row0 and row1 + vChrFilter)
+def gen_uv_ffmpeg(rgb, w, h):
+    u_out = bytearray((w//2)*(h//2))
+    v_out = bytearray((w//2)*(h//2))
+    for cy in range(h // 2):
+        y0 = cy * 2
+        y1 = cy * 2 + 1
+        for cx in range(w // 2):
+            x0 = cx * 2
+            x1 = cx * 2 + 1
+            
+            # Row 0 sum
+            r0 = rgb[(y0*w + x0)*3 + 0] + rgb[(y0*w + x1)*3 + 0]
+            g0 = rgb[(y0*w + x0)*3 + 1] + rgb[(y0*w + x1)*3 + 1]
+            b0 = rgb[(y0*w + x0)*3 + 2] + rgb[(y0*w + x1)*3 + 2]
+            
+            # Row 1 sum
+            r1 = rgb[(y1*w + x0)*3 + 0] + rgb[(y1*w + x1)*3 + 0]
+            g1 = rgb[(y1*w + x0)*3 + 1] + rgb[(y1*w + x1)*3 + 1]
+            b1 = rgb[(y1*w + x0)*3 + 2] + rgb[(y1*w + x1)*3 + 2]
+            
+            # FFmpeg rgb24ToUV_half_c:
+            # dstU_row0 = (ru*r0 + gu*g0 + bu*b0 + (256<<15) + (1<<8)) >> 10
+            # dstU_row1 = (ru*r1 + gu*g1 + bu*b1 + (256<<15) + (1<<8)) >> 10
+            # vChrFilter averages row0 and row1 (scale 4096 = 1<<12)
+            # yuv2plane1_8_c: (val + dither) >> 7
+            
+            du0 = (ru*r0 + gu*g0 + bu*b0 + 8388608 + 256) >> 10
+            du1 = (ru*r1 + gu*g1 + bu*b1 + 8388608 + 256) >> 10
+            
+            dv0 = (rv*r0 + gv*g0 + bv*b0 + 8388608 + 256) >> 10
+            dv1 = (rv*r1 + gv*g1 + bv*b1 + 8388608 + 256) >> 10
+            
+            # Average du0 and du1 with filter sum 4096:
+            # val = (du0 * 2048 + du1 * 2048) >> 12 = (du0 + du1) >> 1
+            # yuv2plane1_8_c: val >> 7
+            
+            val_u = ((du0 + du1) * 2048) >> 19 # = (du0 + du1) >> 8
+            val_v = ((dv0 + dv1) * 2048) >> 19 # = (dv0 + dv1) >> 8
+            
+            u_out[cy*(w//2) + cx] = max(0, min(255, val_u))
+            v_out[cy*(w//2) + cx] = max(0, min(255, val_v))
+    return u_out, v_out
+
+u_c1, v_c1 = gen_uv_ffmpeg(rgb, w, h)
+
+print("FFmpeg formula PSNR U:", workloads.psnr(ref_u, u_c1))
+print("FFmpeg formula PSNR V:", workloads.psnr(ref_v, v_c1))
+
+print("First 10 Ref U:", list(ref_u[:10]))
+print("First 10 C1  U:", list(u_c1[:10]))
