+    rgb[i*3 + 0] = bgr[i*3 + 2]
+    rgb[i*3 + 1] = bgr[i*3 + 1]
+    rgb[i*3 + 2] = bgr[i*3 + 0]
+
+ry, gy, by = 8423, 16531, 3212
+
+dither_8x8 = [
+    [  36, 68,  60, 92,  34, 66,  58, 90 ],
+    [ 100,  4, 124, 28,  98,  2, 122, 26 ],
+    [  52, 84,  44, 76,  50, 82,  42, 74 ],
+    [ 116, 20, 108, 12, 114, 18, 106, 10 ],
+    [  32, 64,  56, 88,  38, 70,  62, 94 ],
+    [  96,  0, 120, 24, 102,  6, 126, 30 ],
+    [  48, 80,  40, 72,  54, 86,  46, 78 ],
+    [ 112, 16, 104,  8, 118, 22, 110, 14 ]
+]
+
+y_cand = bytearray(w * h)
+for y in range(h):
+    d_row = dither_8x8[y & 7]
+    for x in range(w):
+        r, g, b = int(rgb[(y*w+x)*3]), int(rgb[(y*w+x)*3+1]), int(rgb[(y*w+x)*3+2])
+        dith = d_row[x & 7]
+        
+        # dst = (ry*r + gy*g + by*b + 524288 + 256 + 256 * dith) >> 15
+        val = (ry*r + gy*g + by*b + 524288 + 256 + 256 * dith) >> 15
+        y_cand[y*w + x] = max(0, min(255, val))
+
+py = workloads.psnr(ref_y, y_cand)
+print(f"Y PSNR with correct 15-bit dither: {py:.2f} dB")
