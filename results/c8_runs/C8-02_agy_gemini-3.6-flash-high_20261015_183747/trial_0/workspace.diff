+++ b/swscale-impl/scratch/test_box_filter.py
@@ -0,0 +1,42 @@
+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("gray8->gray8 1280x720->640x360")][0]
+ref_path = "/tmp/ref_down.raw"
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path))
+ref = open(ref_path, "rb").read()
+
+wl_src = dict(wl)
+wl_src["dst_w"], wl_src["dst_h"] = 1280, 720
+wl_src["scaling"] = False
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_src, 1, "/tmp/src_1280.raw"))
+src = open("/tmp/src_1280.raw", "rb").read()
+
+src_img = np.frombuffer(src, dtype=np.uint8).reshape((720, 1280)).astype(np.int32)
+ref_img = np.frombuffer(ref, dtype=np.uint8).reshape((360, 640))
+
+xInc = (1280 << 16) // 640
+yInc = (720 << 16) // 360
+
+h_dst = np.zeros((720, 640), dtype=np.int32)
+for dy in range(720):
+    for dx in range(640):
+        xDstInSrc = dx * xInc + (xInc >> 1) - (1 << 15)
+        if xDstInSrc < 0: xDstInSrc = 0
+        sx0 = xDstInSrc >> 16
+        h_dst[dy, dx] = (src_img[dy, sx0] + src_img[dy, min(1279, sx0 + 1)] + 1) >> 1
+
+v_dst = np.zeros((360, 640), dtype=np.uint8)
+for dx in range(640):
+    for dy in range(360):
+        yDstInSrc = dy * yInc + (yInc >> 1) - (1 << 15)
+        if yDstInSrc < 0: yDstInSrc = 0
+        sy0 = yDstInSrc >> 16
+        v = (h_dst[sy0, dx] + h_dst[min(719, sy0 + 1), dx] + 1) >> 1
+        v_dst[dy, dx] = max(0, min(255, v))
+
+print("Box filter PSNR with +1 rounding:", workloads.psnr(ref, v_dst.tobytes()))
+print("Ref row 0 0..7:", list(ref_img[0, :8]))
+print("Dst row 0 0..7:", list(v_dst[0, :8]))
