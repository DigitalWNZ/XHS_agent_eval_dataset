@@ -0,0 +1,50 @@
+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c000_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640))
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+u_up = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1)
+v_up = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1)
+
+# Let's collect unique (Y, U, V) tuples and their corresponding (R_ref, G_ref, B_ref)
+y_flat = src_y.ravel()
+u_flat = u_up.ravel()
+v_flat = v_up.ravel()
+r_flat = ref_rgb[:, :, 0].ravel()
+g_flat = ref_rgb[:, :, 1].ravel()
+b_flat = ref_rgb[:, :, 2].ravel()
+
+# Check if mapping from (Y, U, V) -> (R, G, B) is a 1-to-1 function!
+yuv = np.stack([y_flat, u_flat, v_flat], axis=1)
+rgb = np.stack([r_flat, g_flat, b_flat], axis=1)
+
+# Find unique YUVs and check if R, G, B is uniquely determined by (Y, U, V)
+unique_yuv, indices = np.unique(yuv, axis=0, return_index=True)
+print("Total pixels:", len(y_flat), "Unique (Y, U, V) tuples:", len(unique_yuv))
+
+# Check consistency
+dict_map = {}
+consistent = True
+for i in range(len(y_flat)):
+    key = (y_flat[i], u_flat[i], v_flat[i])
+    val = (r_flat[i], g_flat[i], b_flat[i])
+    if key in dict_map:
+        if dict_map[key] != val:
+            consistent = False
+            print(f"Inconsistency at key {key}: prev {dict_map[key]}, new {val}")
+            break
+    else:
+        dict_map[key] = val
+
+print("Is (Y, U, V) -> (R, G, B) completely deterministic and consistent?", consistent)
