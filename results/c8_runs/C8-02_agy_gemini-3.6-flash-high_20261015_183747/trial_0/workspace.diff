diff --git a/swscale-impl/scratch/test_ffmpeg_pipeline.c b/swscale-impl/scratch/test_ffmpeg_pipeline.c
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_ffmpeg_pipeline.c
@@ -0,0 +1,81 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+#define RU -4900
+#define GU -9550
+#define BU 14420
+#define RV 14379
+#define GV -12081
+#define BV -2300
+
+static inline uint8_t clamp_u8(int v) {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *rgb = malloc(w * h * 3);
+    uint8_t *ref_u = malloc(w * h / 4);
+    uint8_t *ref_v = malloc(w * h / 4);
+    
+    FILE *f_rgb = fopen("/tmp/src_rgb24.raw", "rb");
+    FILE *f_ref = fopen("/tmp/ref.raw", "rb");
+    if (!f_rgb || !f_ref) {
+        printf("Files missing\n");
+        return 1;
+    }
+    fread(rgb, 1, w * h * 3, f_rgb);
+    fseek(f_ref, w * h, SEEK_SET);
+    fread(ref_u, 1, w * h / 4, f_ref);
+    fread(ref_v, 1, w * h / 4, f_ref);
+
+    double best_psnr_u = 0, best_psnr_v = 0;
+    int best_add = 0, best_shift = 0;
+
+    for (int add_uv = 0; add_uv <= 65536; add_uv += 64) {
+        for (int shift_uv = 10; shift_uv <= 24; shift_uv++) {
+            double sse_u = 0, sse_v = 0;
+            for (int y = 0; y < h; y += 2) {
+                const uint8_t *s0 = rgb + y * w * 3;
+                const uint8_t *s1 = rgb + (y + 1) * w * 3;
+                for (int x = 0; x < w; x += 2) {
+                    int r0 = s0[x * 3 + 0] + s0[(x + 1) * 3 + 0];
+                    int g0 = s0[x * 3 + 1] + s0[(x + 1) * 3 + 1];
+                    int b0 = s0[x * 3 + 2] + s0[(x + 1) * 3 + 2];
+
+                    int r1 = s1[x * 3 + 0] + s1[(x + 1) * 3 + 0];
+                    int g1 = s1[x * 3 + 1] + s1[(x + 1) * 3 + 1];
+                    int b1 = s1[x * 3 + 2] + s1[(x + 1) * 3 + 2];
+
+                    int u0 = (RU * r0 + GU * g0 + BU * b0 + (256 << 15) + (1 << 9)) >> 10;
+                    int u1 = (RU * r1 + GU * g1 + BU * b1 + (256 << 15) + (1 << 9)) >> 10;
+
+                    int v0 = (RV * r0 + GV * g0 + BV * b0 + (256 << 15) + (1 << 9)) >> 10;
+                    int v1 = (RV * r1 + GV * g1 + BV * b1 + (256 << 15) + (1 << 9)) >> 10;
+
+                    int u_val = clamp_u8((u0 * 2048 + u1 * 2048 + add_uv) >> shift_uv);
+                    int v_val = clamp_u8((v0 * 2048 + v1 * 2048 + add_uv) >> shift_uv);
+
+                    double du = u_val - ref_u[(y / 2) * (w / 2) + x / 2];
+                    double dv = v_val - ref_v[(y / 2) * (w / 2) + x / 2];
+                    sse_u += du * du;
+                    sse_v += dv * dv;
+                }
+            }
+            double psnr_u = sse_u == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_u);
+            double psnr_v = sse_v == 0 ? 100.0 : 10.0 * log10(255.0*255.0*(w*h/4) / sse_v);
+            if (psnr_u + psnr_v > best_psnr_u + best_psnr_v) {
+                best_psnr_u = psnr_u;
+                best_psnr_v = psnr_v;
+                best_add = add_uv;
+                best_shift = shift_uv;
+            }
+        }
+    }
+    printf("BEST MATCH: add_uv=%d, shift_uv=%d -> U: %.2f dB, V: %.2f dB\n", best_add, best_shift, best_psnr_u, best_psnr_v);
+    return 0;
+}
