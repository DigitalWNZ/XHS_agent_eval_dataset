@@ -0,0 +1,57 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+int main() {
+    FILE *f_ref = fopen("/tmp/ref_yuv444.raw", "rb");
+    uint8_t *ref = malloc(640*480*3);
+    fread(ref, 1, 640*480*3, f_ref);
+    fclose(f_ref);
+
+    FILE *f_bgr = fopen("/tmp/ref_bgr640.raw", "rb");
+    uint8_t *bgr = malloc(640*480*3);
+    fread(bgr, 1, 640*480*3, f_bgr);
+    fclose(f_bgr);
+
+    int n = 640 * 480;
+    uint8_t *ref_y = ref;
+
+    int32_t *r = malloc(n * sizeof(int32_t));
+    int32_t *g = malloc(n * sizeof(int32_t));
+    int32_t *b = malloc(n * sizeof(int32_t));
+
+    for (int i = 0; i < n; i++) {
+        r[i] = bgr[i*3 + 2];
+        g[i] = bgr[i*3 + 1];
+        b[i] = bgr[i*3 + 0];
+    }
+
+    double best_y = 0.0;
+    int best_ry = 0, best_gy = 0, best_by = 0;
+
+    for (int ry = 8400; ry <= 8450; ry++) {
+        for (int gy = 16500; gy <= 16550; gy++) {
+            for (int by = 3200; by <= 3230; by++) {
+                double mse = 0.0;
+                for (int i = 0; i < n; i++) {
+                    int val = (ry*r[i] + gy*g[i] + by*b[i] + 524288 + 16384) >> 15;
+                    if (val < 0) val = 0;
+                    if (val > 255) val = 255;
+                    double diff = val - ref_y[i];
+                    mse += diff * diff;
+                }
+                mse /= n;
+                double psnr = (mse == 0) ? 100.0 : 10.0 * log10(65025.0 / mse);
+                if (psnr > best_y) {
+                    best_y = psnr;
+                    best_ry = ry; best_gy = gy; best_by = by;
+                    printf("NEW BEST Y: %.2f dB (ry=%d, gy=%d, by=%d)\n", psnr, ry, gy, by);
+                }
+            }
+        }
+    }
+
+    printf("\nFINAL BEST Y: %.2f dB (ry=%d, gy=%d, by=%d)\n", best_y, best_ry, best_gy, best_by);
+    return 0;
+}
