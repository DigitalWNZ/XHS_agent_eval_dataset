+        if np.array_equal(src_img[sy, sx], ref_img[0, 0]):
+            print(f"Ref (0,0) found at src ({sx}, {sy})!")
+
+# Find where ref_img[0,1] occurs in src_img around (0,0):
+print("Ref img (0,1):", ref_img[0, 1])
+for sy in range(10):
+    for sx in range(10):
+        if np.array_equal(src_img[sy, sx], ref_img[0, 1]):
+            print(f"Ref (0,1) found at src ({sx}, {sy})!")
