+
+static inline uint8_t clamp_u8(int v) {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *rgb = malloc(w * h * 3);
+    uint8_t *ref_u = malloc(w * h / 4);
+    uint8_t *ref_v = malloc(w * h / 4);
