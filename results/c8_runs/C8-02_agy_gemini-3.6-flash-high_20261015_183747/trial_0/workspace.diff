+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c013_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/nv12_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640))
+
+with open("/tmp/nv12_uv.raw", "rb") as f:
+    src_uv = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 640))
+
+u_plane = src_uv[:, 0::2]
+v_plane = src_uv[:, 1::2]
+
+u_up = np.repeat(np.repeat(u_plane, 2, axis=0), 2, axis=1)
+v_up = np.repeat(np.repeat(v_plane, 2, axis=0), 2, axis=1)
+
+def psnr(a, b):
+    mse = np.mean((a.astype(float) - b.astype(float))**2)
+    if mse == 0: return 100.0
+    return 10.0 * np.log10(255.0**2 / mse)
+
+cy = 76309
+oy = 1048576
+
+table_plane_size = 1024 + 2 * 1024
+y_table = np.zeros(table_plane_size, dtype=np.uint8)
+yb = -(384 * 65536) - 1024 * cy - oy
+for i in range(table_plane_size):
+    y_table[i] = np.clip((yb + 32768) >> 16, 0, 255)
+    yb += cy
+
+yoffs = 326 + 1024
+
+crv_scaled = 89849
+cbu_scaled = 113543
+cgu_scaled = 22049
+cgv_scaled = 45756
+
+off_r = 175
+off_b = 221
+
+cb_r = (v_up.astype(np.int32) * crv_scaled) >> 16
+cb_b = (u_up.astype(np.int32) * cbu_scaled) >> 16
+cb_gu = (u_up.astype(np.int32) * cgu_scaled) >> 16
+cb_gv = (v_up.astype(np.int32) * cgv_scaled) >> 16
+
+y_val = src_y.astype(np.int32)
+
+idx_r = np.clip(yoffs - off_r + cb_r + y_val, 0, table_plane_size - 1)
+idx_b = np.clip(yoffs - off_b + cb_b + y_val, 0, table_plane_size - 1)
+idx_g = np.clip(yoffs + 132 - cb_gu - cb_gv + y_val, 0, table_plane_size - 1)
+
+r_cand = y_table[idx_r]
+g_cand = y_table[idx_g]
+b_cand = y_table[idx_b]
+
+cand = np.stack([r_cand, g_cand, b_cand], axis=-1)
+
+print("NV12 (interleaved 0::2, 1::2) PSNR:", psnr(cand, ref_rgb))
