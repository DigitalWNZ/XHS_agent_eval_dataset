@@ -0,0 +1,47 @@
+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("gray8->gray8 1280x720->640x360")][0]
+ref_path = "/tmp/ref_down.raw"
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path))
+ref = open(ref_path, "rb").read()
+
+wl_src = dict(wl)
+wl_src["dst_w"], wl_src["dst_h"] = 1280, 720
+wl_src["scaling"] = False
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_src, 1, "/tmp/src_1280.raw"))
+src = open("/tmp/src_1280.raw", "rb").read()
+
+src_img = np.frombuffer(src, dtype=np.uint8).reshape((720, 1280))
+ref_img = np.frombuffer(ref, dtype=np.uint8).reshape((360, 640))
+
+# Test 1D horizontal scaling on row 0:
+src_row0 = src_img[0, :30].astype(np.float64)
+ref_row0 = ref_img[0, :15].astype(np.float64)
+
+print("Src row 0:", list(src_row0[:16]))
+print("Ref row 0:", list(ref_row0[:8]))
+
+# Test 3-tap / 4-tap filter with xInc = 2:
+# For dx = 0: x_center = 0.5 * 2 = 1.0 (or offset)
+for offset in [-1.0, -0.5, 0.0, 0.5, 1.0]:
+    for w0 in range(0, 1024, 64):
+        for w1 in range(0, 2048, 64):
+            w2 = 4096 - w0 - w1
+            if w2 < 0: continue
+            
+            # Predict ref_row0[0..5]:
+            pred = []
+            for dx in range(6):
+                center = dx * 2 + offset
+                sx0 = max(0, int(center))
+                sx1 = min(1279, sx0 + 1)
+                sx2 = min(1279, sx0 + 2)
+                
+                v = (src_row0[sx0] * w0 + src_row0[sx1] * w1 + src_row0[sx2] * w2 + 2048) / 4096
+                pred.append(round(v))
+                
+            if np.array_equal(pred, ref_row0[:6]):
+                print(f"MATCH! offset={offset}, weights=[{w0}, {w1}, {w2}]/4096")
diff --git a/swscale-impl/scratch/test_3tap_downscale.py b/swscale-impl/scratch/test_3tap_downscale.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_3tap_downscale.py
@@ -0,0 +1,58 @@
+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("gray8->gray8 1280x720->640x360")][0]
+ref_path = "/tmp/ref_down.raw"
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path))
+ref = open(ref_path, "rb").read()
+
+wl_src = dict(wl)
+wl_src["dst_w"], wl_src["dst_h"] = 1280, 720
+wl_src["scaling"] = False
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_src, 1, "/tmp/src_1280.raw"))
+src = open("/tmp/src_1280.raw", "rb").read()
+
+src_img = np.frombuffer(src, dtype=np.uint8).reshape((720, 1280)).astype(np.float64)
+ref_img = np.frombuffer(ref, dtype=np.uint8).reshape((360, 640))
+
+# Test with centered coordinate x_src = dx * xInc + (xInc >> 1) - (1 << 15)
+h_dst = np.zeros((720, 640), dtype=np.float64)
+for dy in range(720):
+    for dx in range(640):
+        # x_src in 16.16 fixed point:
+        x_src = dx * 131072 + 65536 - 32768 # = dx * 131072 + 32768
+        sx0 = x_src >> 16
+        sx1 = min(1279, sx0 + 1)
+        sx2 = min(1279, sx0 + 2)
+        frac = (x_src & 0xFFFF) / 65536.0
+        
+        # weights:
+        w0 = 1024 * (1.0 - frac)
+        w1 = 2048
+        w2 = 1024 * frac
+        w_sum = w0 + w1 + w2
+        
+        h_dst[dy, dx] = (w0 * src_img[dy, sx0] + w1 * src_img[dy, sx1] + w2 * src_img[dy, sx2]) / w_sum
+
+v_dst = np.zeros((360, 640), dtype=np.uint8)
+for dx in range(640):
+    for dy in range(360):
+        y_src = dy * 131072 + 65536 - 32768
+        sy0 = y_src >> 16
+        sy1 = min(719, sy0 + 1)
+        sy2 = min(719, sy0 + 2)
+        frac = (y_src & 0xFFFF) / 65536.0
+        
+        w0 = 1024 * (1.0 - frac)
+        w1 = 2048
+        w2 = 1024 * frac
+        w_sum = w0 + w1 + w2
+        
+        v = (w0 * h_dst[sy0, dx] + w1 * h_dst[sy1, dx] + w2 * h_dst[sy2, dx]) / w_sum
+        v_dst[dy, dx] = max(0, min(255, int(round(v))))
+
+print("Centered 3-tap 2D Bilinear Downscale PSNR:", workloads.psnr(ref, v_dst.tobytes()))
+print("Ref row 0 0..7:", list(ref_img[0, :8]))
+print("Dst row 0 0..7:", list(v_dst[0, :8]))
