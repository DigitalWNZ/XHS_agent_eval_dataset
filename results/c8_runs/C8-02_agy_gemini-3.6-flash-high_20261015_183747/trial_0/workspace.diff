@@ -0,0 +1,54 @@
+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c000_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640))
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+u_up = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1).astype(np.int32)
+v_up = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1).astype(np.int32)
+
+cy = 76309
+oy = 1048576
+
+y_table = np.zeros(4096, dtype=np.uint8)
+yb = -(384 * 65536) - 1024 * cy - oy
+for i in range(4096):
+    y_table[i] = np.clip((yb + 32768) >> 16, 0, 255)
+    yb += cy
+
+crv_scaled = ((104597 * 65536) + 32768) // cy
+cbu_scaled = ((132201 * 65536) + 32768) // cy
+cgu_scaled = ((25675 * 65536) + 32768) // cy
+cgv_scaled = ((53279 * 65536) + 32768) // cy
+
+cb_r = (v_up - 128) * crv_scaled
+cb_b = (u_up - 128) * cbu_scaled
+cb_g = -((u_up - 128) * cgu_scaled + (v_up - 128) * cgv_scaled)
+
+def test_offs(cb, target, name):
+    best_psnr, best_off = 0, 0
+    ref_f = target.astype(float)
+    for off in range(100, 2000):
+        idx = np.clip(off + (cb >> 16) + src_y.astype(np.int32), 0, 4095)
+        cand_f = y_table[idx].astype(float)
+        mse = np.mean((cand_f - ref_f)**2)
+        p = 100.0 if mse == 0 else 10.0 * np.log10(255.0**2 / mse)
+        if p > best_psnr:
+            best_psnr = p
+            best_off = off
+    print(f"Best {name} PSNR: {best_psnr:.2f} dB at offset: {best_off}")
+    return best_off
+
+test_offs(cb_r, ref_rgb[:, :, 0], "R")
+test_offs(cb_g, ref_rgb[:, :, 1], "G")
+test_offs(cb_b, ref_rgb[:, :, 2], "B")
