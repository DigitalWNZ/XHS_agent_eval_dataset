+++ b/swscale-impl/search_offsets.py
@@ -0,0 +1,50 @@
+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c000_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640))
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+u_up = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1).astype(np.int32)
+v_up = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1).astype(np.int32)
+
+y_val = src_y.astype(np.int32)
+
+def psnr(a, b):
+    mse = np.mean((a.astype(float) - b.astype(float))**2)
+    if mse == 0: return 100.0
+    return 10.0 * np.log10(255.0**2 / mse)
+
+# Search for exact integer constant offset for R, G, B
+CY = 76309
+CRV = 104597
+CBU = 132201
+CGU = 25675
+CGV = 53279
+
+for off_r in range(-200000, 100000, 1000):
+    r_val = np.clip((CY * (y_val - 16) + CRV * (v_up - 128) + off_r) >> 16, 0, 255).astype(np.uint8)
+    p = psnr(r_val, ref_rgb[:, :, 0])
+    if p > 60.0:
+        print(f"R PSNR {p:.2f} dB at off_r = {off_r}")
+
+for off_g in range(-200000, 100000, 1000):
+    g_val = np.clip((CY * (y_val - 16) - CGU * (u_up - 128) - CGV * (v_up - 128) + off_g) >> 16, 0, 255).astype(np.uint8)
+    p = psnr(g_val, ref_rgb[:, :, 1])
+    if p > 60.0:
+        print(f"G PSNR {p:.2f} dB at off_g = {off_g}")
+
+for off_b in range(-200000, 100000, 1000):
+    b_val = np.clip((CY * (y_val - 16) + CBU * (u_up - 128) + off_b) >> 16, 0, 255).astype(np.uint8)
+    p = psnr(b_val, ref_rgb[:, :, 2])
+    if p > 60.0:
+        print(f"B PSNR {p:.2f} dB at off_b = {off_b}")
