+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("yuv420p->yuv444p")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, "/tmp/ref_yuv444.raw"))
+ref = open("/tmp/ref_yuv444.raw", "rb").read()
+
+wl_420_420 = [w for w in workloads.correctness_workloads() if w["label"].startswith("yuv420p->nv12")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_420_420, 1, "/tmp/ref_nv12.raw"))
+ref_nv12 = open("/tmp/ref_nv12.raw", "rb").read()
+
+w, h = 640, 480
+y_size = w * h
+u_size = w * h
+
+ref_u = ref[y_size:y_size+u_size]
+
+uv_src = ref_nv12[y_size:]
+src_u = np.frombuffer(uv_src[0::2], dtype=np.uint8).reshape((240, 320)).astype(np.int32)
+
+h_u = np.zeros((240, 640), dtype=np.int32)
+for cy in range(240):
+    for cx in range(320):
+        p_curr = src_u[cy, cx]
+        p_left = src_u[cy, max(0, cx - 1)]
+        p_right = src_u[cy, min(319, cx + 1)]
+        
+        h_u[cy, 2 * cx]     = (3 * p_curr + p_left + 1) >> 2
+        h_u[cy, 2 * cx + 1] = (3 * p_curr + p_right + 2) >> 2
+
+dst_u = np.zeros((480, 640), dtype=np.uint8)
+for cx in range(640):
+    for cy in range(240):
+        p_curr = h_u[cy, cx]
+        p_top  = h_u[max(0, cy - 1), cx]
+        p_bot  = h_u[min(239, cy + 1), cx]
+        
+        v0 = (3 * p_curr + p_top + 1) >> 2
+        v1 = (3 * p_curr + p_bot + 2) >> 2
+        
+        dst_u[2 * cy, cx]     = max(0, min(255, v0))
+        dst_u[2 * cy + 1, cx] = max(0, min(255, v1))
+
+print("Exact Integer 2x Chroma PSNR U:", workloads.psnr(ref_u, dst_u.tobytes()))
+print("Ref U row 0 x=0..7:", list(ref_u[:8]))
+print("Dst U row 0 x=0..7:", list(dst_u[0, :8]))
