+++ b/swscale-impl/find_yuv2rgb.py
@@ -0,0 +1,62 @@
+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c000_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640)).astype(float)
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320)).astype(float)
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320)).astype(float)
+
+def psnr(a, b):
+    mse = np.mean((a.astype(float) - b.astype(float))**2)
+    if mse == 0: return 100.0
+    return 10.0 * np.log10(255.0**2 / mse)
+
+# Chroma upsampling 1: Nearest 2x2 (box)
+u_near = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1)
+v_near = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1)
+
+# Chroma upsampling 2: Bilinear 2x using FFmpeg's vertical/horizontal filter alignment
+# In FFmpeg, vertical 2x bilinear chroma filter for line y:
+# even line y: 3/4 * C[y/2] + 1/4 * C[y/2 - 1] (or 3/4 * C[y/2] + 1/4 * C[y/2 + 1])
+# odd line y:  1/4 * C[y/2] + 3/4 * C[y/2 + 1]
+
+def upsample_chroma_bilinear(c):
+    h, w = c.shape
+    # Horizontal 2x bilinear
+    ch = np.zeros((h, w * 2), dtype=float)
+    ch[:, 0::2] = c
+    ch[:, 1::2] = 0.5 * c + 0.5 * np.roll(c, -1, axis=1)
+    ch[:, -1] = c[:, -1]
+    
+    # Vertical 2x bilinear
+    cv = np.zeros((h * 2, w * 2), dtype=float)
+    # FFmpeg chroma vertical filter (centered / top-left aligned)
+    cv[0::2, :] = ch
+    cv[1::2, :] = 0.5 * ch + 0.5 * np.roll(ch, -1, axis=0)
+    cv[-1, :] = ch[-1, :]
+    return cv
+
+u_bi = upsample_chroma_bilinear(src_u)
+v_bi = upsample_chroma_bilinear(src_v)
+
+for name, u_up, v_up in [("nearest", u_near, v_near), ("bilinear", u_bi, v_bi)]:
+    Y_lim = (src_y - 16.0) * (255.0 / 219.0)
+    U_diff = u_up - 128.0
+    V_diff = v_up - 128.0
+
+    # Integer fixed point BT.601 (CY=76309, CRV=104597, CBU=132201, CGU=25675, CGV=53279)
+    y_scaled = 76309 * (src_y - 16) + 32768
+    r_int = np.clip(np.floor((y_scaled + 104597 * V_diff) / 65536.0), 0, 255).astype(np.uint8)
+    g_int = np.clip(np.floor((y_scaled - 25675 * U_diff - 53279 * V_diff) / 65536.0), 0, 255).astype(np.uint8)
+    b_int = np.clip(np.floor((y_scaled + 132201 * U_diff) / 65536.0), 0, 255).astype(np.uint8)
+
+    rgb_int = np.stack([r_int, g_int, b_int], axis=-1)
+    print(f"BT.601 int ({name}) PSNR:", psnr(rgb_int, ref_rgb))
diff --git a/swscale-impl/fit_exact.py b/swscale-impl/fit_exact.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/fit_exact.py
@@ -0,0 +1,45 @@
+import sys
+sys.path.insert(0, '/app')
+import numpy as np
+
+with open("/tmp/c000_ref.raw", "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640))
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+u_up = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1)
+v_up = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1)
+
+y_flat = src_y.ravel().astype(float)
+u_flat = u_up.ravel().astype(float)
+v_flat = v_up.ravel().astype(float)
+
+r_flat = ref_rgb[:, :, 0].ravel().astype(float)
+g_flat = ref_rgb[:, :, 1].ravel().astype(float)
+b_flat = ref_rgb[:, :, 2].ravel().astype(float)
+
+# Linear regression for unclipped pixels
+# R = a_r * Y + b_r * V + c_r
+mask_r = (r_flat > 0) & (r_flat < 255)
+A_r = np.stack([y_flat[mask_r] - 16, v_flat[mask_r] - 128, np.ones(np.sum(mask_r))], axis=1)
+coeffs_r, _, _, _ = np.linalg.lstsq(A_r, r_flat[mask_r], rcond=None)
+print("R coeffs (Y-16, V-128, 1):", coeffs_r)
+
+# B = a_b * Y + b_b * U + c_b
+mask_b = (b_flat > 0) & (b_flat < 255)
+A_b = np.stack([y_flat[mask_b] - 16, u_flat[mask_b] - 128, np.ones(np.sum(mask_b))], axis=1)
+coeffs_b, _, _, _ = np.linalg.lstsq(A_b, b_flat[mask_b], rcond=None)
+print("B coeffs (Y-16, U-128, 1):", coeffs_b)
+
+# G = a_g * Y + b_g * U + c_g * V + d_g
+mask_g = (g_flat > 0) & (g_flat < 255)
+A_g = np.stack([y_flat[mask_g] - 16, u_flat[mask_g] - 128, v_flat[mask_g] - 128, np.ones(np.sum(mask_g))], axis=1)
+coeffs_g, _, _, _ = np.linalg.lstsq(A_g, g_flat[mask_g], rcond=None)
+print("G coeffs (Y-16, U-128, V-128, 1):", coeffs_g)
