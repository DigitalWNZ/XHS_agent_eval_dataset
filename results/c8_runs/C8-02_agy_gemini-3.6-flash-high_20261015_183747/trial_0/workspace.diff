+print(f" (0,0): R={r00}, G={g00}, B={b00}")
+print(f" (0,1): R={r01}, G={g01}, B={b01}")
+print(f" (1,0): R={r10}, G={g10}, B={b10}")
+print(f" (1,1): R={r11}, G={g11}, B={b11}")
+
+print(f"\nRef Y(0,0)={ref_y[0]}, Y(0,1)={ref_y[1]}, Y(1,0)={ref_y[w]}, Y(1,1)={ref_y[w+1]}")
+print(f"Ref U(0,0)={ref_u[0]}, V(0,0)={ref_v[0]}")
+
+# Let's test Y formula:
+# ry, gy, by = 8423, 16531, 3212 (with 15-bit shift, limited range)
+# Lim Y = (8423*R + 16531*G + 3212*B + 524288 + 16384) >> 15
+def calc_y(r, g, b):
+    return (8423*r + 16531*g + 3212*b + 524288 + 16384) >> 15
+
+print(f"\nCalc Y(0,0)={calc_y(r00,g00,b00)}, Y(0,1)={calc_y(r01,g01,b01)}, Y(1,0)={calc_y(r10,g10,b10)}, Y(1,1)={calc_y(r11,g11,b11)}")
+
+# Let's test U and V formulas for 2x2 block!
+ru, gu, bu = -4866, -9528, 14394
+rv, gv, bv = 14394, -12061, -2333
+
+def calc_u(r, g, b):
+    return (ru*r + gu*g + bu*b + 4194304 + 16384) >> 15
+
+def calc_v(r, g, b):
+    return (rv*r + gv*g + bv*b + 4194304 + 16384) >> 15
+
+# Options for chroma downsampling:
+# Option A: Average RGB 4 pixels then calc U,V
+r_avg = (r00 + r01 + r10 + r11 + 2) // 4
+g_avg = (g00 + g01 + g10 + g11 + 2) // 4
+b_avg = (b00 + b01 + b10 + b11 + 2) // 4
+print(f"Option A (RGB 2x2 avg -> U,V): U={calc_u(r_avg, g_avg, b_avg)}, V={calc_v(r_avg, g_avg, b_avg)}")
+
+# Option B: Average 2 pixels in row 0 only (like rgb24ToUV_half)
+r_row0 = (r00 + r01 + 1) // 2
+g_row0 = (g00 + g01 + 1) // 2
+b_row0 = (b00 + b01 + 1) // 2
+print(f"Option B (Row 0 2-px avg -> U,V): U={calc_u(r_row0, g_row0, b_row0)}, V={calc_v(r_row0, g_row0, b_row0)}")
+
+# Option C: Calc U,V for 4 pixels individually then average U,V
+u00, u01, u10, u11 = calc_u(r00,g00,b00), calc_u(r01,g01,b01), calc_u(r10,g10,b10), calc_u(r11,g11,b11)
+v00, v01, v10, v11 = calc_v(r00,g00,b00), calc_v(r01,g01,b01), calc_v(r10,g10,b10), calc_v(r11,g11,b11)
+u_avg4 = (u00 + u01 + u10 + u11 + 2) // 4
+v_avg4 = (v00 + v01 + v10 + v11 + 2) // 4
+print(f"Option C (Calc 4 U,V -> avg U,V): U={u_avg4}, V={v_avg4}")
+
+# Option D: Option B on row 0 and row 1 then average row 0 and row 1 U,V
+u_r0 = calc_u(r_row0, g_row0, b_row0)
+v_r0 = calc_v(r_row0, g_row0, b_row0)
+r_row1 = (r10 + r11 + 1) // 2
+g_row1 = (g10 + g11 + 1) // 2
+b_row1 = (b10 + b11 + 1) // 2
+u_r1 = calc_u(r_row1, g_row1, b_row1)
+v_r1 = calc_v(r_row1, g_row1, b_row1)
+u_avg2x2 = (u_r0 + u_r1 + 1) // 2
+v_avg2x2 = (v_r0 + v_r1 + 1) // 2
+print(f"Option D (Row 0 avg U + Row 1 avg U -> avg): U={u_avg2x2}, V={v_avg2x2}")
+
