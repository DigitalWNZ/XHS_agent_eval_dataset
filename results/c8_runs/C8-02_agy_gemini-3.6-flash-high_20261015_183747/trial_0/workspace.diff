+import sys, os, subprocess
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv420p")][0]
+ref = open("/tmp/ref_yuv420.raw", "rb").read()
+
+w, h = 640, 480
+ref_u = ref[w*h:w*h + (w//2)*(h//2)]
+ref_v = ref[w*h + (w//2)*(h//2):]
+
+wl_rgb = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24 640x480")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_rgb, 1, "/tmp/ref_bgr640.raw"))
+bgr = open("/tmp/ref_bgr640.raw", "rb").read()
+
+rgb = bytearray(w * h * 3)
+for i in range(w * h):
+    rgb[i*3 + 0] = bgr[i*3 + 2]
+    rgb[i*3 + 1] = bgr[i*3 + 1]
+    rgb[i*3 + 2] = bgr[i*3 + 0]
+
+ru, gu, bu = -4866, -9528, 14394
+rv, gv, bv = 14394, -12061, -2333
+
+for off_out in range(0, 131072, 8192):
+    u_cand = bytearray((w//2)*(h//2))
+    v_cand = bytearray((w//2)*(h//2))
+    for cy in range(h // 2):
+        y0, y1 = cy * 2, cy * 2 + 1
+        for cx in range(w // 2):
+            x0, x1 = cx * 2, cx * 2 + 1
+            p00 = (y0*w+x0)*3
+            p01 = (y0*w+x1)*3
+            p10 = (y1*w+x0)*3
+            p11 = (y1*w+x1)*3
+            
+            rx = int(rgb[p00]) + int(rgb[p01]) + int(rgb[p10]) + int(rgb[p11])
+            gx = int(rgb[p00+1]) + int(rgb[p01+1]) + int(rgb[p10+1]) + int(rgb[p11+1])
+            bx = int(rgb[p00+2]) + int(rgb[p01+2]) + int(rgb[p10+2]) + int(rgb[p11+2])
+            
+            u_cand[cy*(w//2)+cx] = max(0, min(255, (ru*rx + gu*gx + bu*bx + 16777216 + off_out) >> 17))
+            v_cand[cy*(w//2)+cx] = max(0, min(255, (rv*rx + gv*gx + bv*bx + 16777216 + off_out) >> 17))
+            
+    pu = workloads.psnr(ref_u, u_cand)
+    pv = workloads.psnr(ref_v, v_cand)
+    print(f"off_out={off_out} -> PSNR U={pu:.2f}, V={pv:.2f}")
diff --git a/swscale-impl/scratch/test_dither.py b/swscale-impl/scratch/test_dither.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_dither.py
@@ -0,0 +1,70 @@
+import sys, os, subprocess
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv420p")][0]
+ref = open("/tmp/ref_yuv420.raw", "rb").read()
+
+w, h = 640, 480
+ref_u = ref[w*h:w*h + (w//2)*(h//2)]
+ref_v = ref[w*h + (w//2)*(h//2):]
+
+wl_rgb = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24 640x480")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_rgb, 1, "/tmp/ref_bgr640.raw"))
+bgr = open("/tmp/ref_bgr640.raw", "rb").read()
+
+rgb = bytearray(w * h * 3)
+for i in range(w * h):
+    rgb[i*3 + 0] = bgr[i*3 + 2]
+    rgb[i*3 + 1] = bgr[i*3 + 1]
+    rgb[i*3 + 2] = bgr[i*3 + 0]
+
+ru, gu, bu = -4866, -9528, 14394
+rv, gv, bv = 14394, -12061, -2333
+
+dither_8x8 = [
+    [  36, 68,  60, 92,  34, 66,  58, 90 ],
+    [ 100,  4, 124, 28,  98,  2, 122, 26 ],
+    [  52, 84,  44, 76,  50, 82,  42, 74 ],
+    [ 116, 20, 108, 12, 114, 18, 106, 10 ],
+    [  32, 64,  56, 88,  38, 70,  62, 94 ],
+    [  96,  0, 120, 24, 102,  6, 126, 30 ],
+    [  48, 80,  40, 72,  54, 86,  46, 78 ],
+    [ 112, 16, 104,  8, 118, 22, 110, 14 ]
+]
+
+u_cand = bytearray((w//2)*(h//2))
+v_cand = bytearray((w//2)*(h//2))
+for cy in range(h // 2):
+    y0, y1 = cy * 2, cy * 2 + 1
+    d_row = dither_8x8[cy & 7]
+    for cx in range(w // 2):
+        x0, x1 = cx * 2, cx * 2 + 1
+        p00 = (y0*w+x0)*3
+        p01 = (y0*w+x1)*3
+        p10 = (y1*w+x0)*3
+        p11 = (y1*w+x1)*3
+        
+        r0 = int(rgb[p00]) + int(rgb[p01]); g0 = int(rgb[p00+1]) + int(rgb[p01+1]); b0 = int(rgb[p00+2]) + int(rgb[p01+2])
+        r1 = int(rgb[p10]) + int(rgb[p11]); g1 = int(rgb[p10+1]) + int(rgb[p11+1]); b1 = int(rgb[p10+2]) + int(rgb[p11+2])
+        
+        du0 = (ru*r0 + gu*g0 + bu*b0 + 8388608 + 256) >> 10
+        du1 = (ru*r1 + gu*g1 + bu*b1 + 8388608 + 256) >> 10
+        dv0 = (rv*r0 + gv*g0 + bv*b0 + 8388608 + 256) >> 10
+        dv1 = (rv*r1 + gv*g1 + bv*b1 + 8388608 + 256) >> 10
+        
+        dith = d_row[cx & 7]
+        # vChrFilter sum = 4096 (2048 * du0 + 2048 * du1)
+        # yuv2planeX_8_c: (dith << 12 + du0 * 2048 + du1 * 2048) >> 19
+        # = (dith + du0 / 2 + du1 / 2) >> 7
+        
+        val_u = (du0 * 2048 + du1 * 2048 + (dith << 12)) >> 19
+        val_v = (dv0 * 2048 + dv1 * 2048 + (dith << 12)) >> 19
+        
+        u_cand[cy*(w//2)+cx] = max(0, min(255, val_u))
+        v_cand[cy*(w//2)+cx] = max(0, min(255, val_v))
+
+pu = workloads.psnr(ref_u, u_cand)
+pv = workloads.psnr(ref_v, v_cand)
+print(f"WITH DITHERING: PSNR U={pu:.2f}, V={pv:.2f}")
