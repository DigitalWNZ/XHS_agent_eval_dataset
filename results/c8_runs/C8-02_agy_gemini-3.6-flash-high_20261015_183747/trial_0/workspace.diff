+#include <stdint.h>
+#include <math.h>
+
+static inline uint8_t clamp_u8(int v) {
+    if (v < 0) return 0;
+    if (v > 255) return 255;
+    return (uint8_t)v;
+}
+
+int main() {
+    int w = 640, h = 480;
+    int npix = w * h;
+
+    uint8_t *yuv = malloc(npix * 3);
+    uint8_t *ref = malloc(npix * 3);
+
+    FILE *f_yuv = fopen("/tmp/src_444_yuv.raw", "rb");
+    FILE *f_ref = fopen("/tmp/ref_444_rgb.raw", "rb");
+    if (!f_yuv || !f_ref) {
+        printf("Files missing\n");
+        return 1;
+    }
+    fread(yuv, 1, npix * 3, f_yuv);
+    fread(ref, 1, npix * 3, f_ref);
+
+    uint8_t *py = yuv;
+    uint8_t *pu = yuv + npix;
+    uint8_t *pv = yuv + npix * 2;
+
+    // Search YUV->RGB coefficients
+    // R = (cy*(Y-16) + crv*(V-128) + add) >> shift
+    // G = (cy*(Y-16) - cgu*(U-128) - cgv*(V-128) + add) >> shift
+    // B = (cy*(Y-16) + cbu*(U-128) + add) >> shift
+
+    int best_cy = 0, best_crv = 0, best_cbu = 0, best_cgu = 0, best_cgv = 0;
+    double best_psnr_r = 0, best_psnr_g = 0, best_psnr_b = 0;
+
+    int cy = 76309;
+    for (int crv = 100000; crv <= 110000; crv += 1) {
+        double sse_r = 0;
+        for (int i = 0; i < npix; i++) {
+            int y_val = py[i], v_val = pv[i];
+            int r_val = clamp_u8((cy * (y_val - 16) + crv * (v_val - 128) + 32768) >> 16);
+            double d = r_val - ref[i * 3 + 0];
+            sse_r += d * d;
+        }
+        double psnr = sse_r == 0 ? 100.0 : 10.0 * log10(255.0 * 255.0 * npix / sse_r);
+        if (psnr > best_psnr_r) {
+            best_psnr_r = psnr;
+            best_crv = crv;
+            printf("NEW BEST R: %.2f dB (crv=%d)\n", psnr, crv);
+            if (psnr == 100.0) break;
+        }
+    }
+
+    for (int cbu = 120000; cbu <= 140000; cbu += 1) {
+        double sse_b = 0;
+        for (int i = 0; i < npix; i++) {
+            int y_val = py[i], u_val = pu[i];
+            int b_val = clamp_u8((cy * (y_val - 16) + cbu * (u_val - 128) + 32768) >> 16);
+            double d = b_val - ref[i * 3 + 2];
+            sse_b += d * d;
+        }
+        double psnr = sse_b == 0 ? 100.0 : 10.0 * log10(255.0 * 255.0 * npix / sse_b);
+        if (psnr > best_psnr_b) {
+            best_psnr_b = psnr;
+            best_cbu = cbu;
+            printf("NEW BEST B: %.2f dB (cbu=%d)\n", psnr, cbu);
+            if (psnr == 100.0) break;
+        }
+    }
+
+    for (int cgu = 20000; cgu <= 30000; cgu += 1) {
+        for (int cgv = 40000; cgv <= 60000; cgv += 10) {
+            double sse_g = 0;
+            for (int i = 0; i < npix; i++) {
+                int y_val = py[i], u_val = pu[i], v_val = pv[i];
+                int g_val = clamp_u8((cy * (y_val - 16) - cgu * (u_val - 128) - cgv * (v_val - 128) + 32768) >> 16);
+                double d = g_val - ref[i * 3 + 1];
+                sse_g += d * d;
+            }
+            double psnr = sse_g == 0 ? 100.0 : 10.0 * log10(255.0 * 255.0 * npix / sse_g);
+            if (psnr > best_psnr_g) {
+                best_psnr_g = psnr;
+                best_cgu = cgu; best_cgv = cgv;
+                printf("NEW BEST G: %.2f dB (cgu=%d, cgv=%d)\n", psnr, cgu, cgv);
+                if (psnr == 100.0) goto done_g;
+            }
+        }
+    }
+done_g:
+
+    printf("FINAL BEST YUV->RGB: R=%.2f dB (crv=%d), G=%.2f dB (cgu=%d, cgv=%d), B=%.2f dB (cbu=%d)\n",
+        best_psnr_r, best_crv, best_psnr_g, best_cgu, best_cgv, best_psnr_b, best_cbu);
+
+    return 0;
+}
