+import sys
+sys.path.insert(0, '/app')
+import subprocess
+import os
+import numpy as np
+import workloads
+
+DRIVER = "/app/driver"
+BASELINE = "/app/libswscale_public_baseline.so"
+
+def get_ref_frame(wl):
+    out = "/tmp/ref_frame.raw"
+    if os.path.exists(out):
+        os.remove(out)
+    argv = workloads.driver_argv(DRIVER, BASELINE, wl, 1, out)
+    p = subprocess.run(argv, capture_output=True, text=True)
+    if p.returncode != 0 or not os.path.exists(out):
+        print("Driver failed:", p.stderr)
+        return None
+    with open(out, "rb") as f:
+        return f.read()
+
+# Let's test a simple scaling function for RGB24 / RGBA / GRAY8 / YUV420P in numpy
+def scale_nearest(src, src_w, src_h, dst_w, dst_h, channels):
+    xInc = (src_w << 16) // dst_w
+    yInc = (src_h << 16) // dst_h
+    x_idx = np.clip(((np.arange(dst_w, dtype=np.int64) * xInc + 32768) >> 16), 0, src_w - 1)
+    y_idx = np.clip(((np.arange(dst_h, dtype=np.int64) * yInc + 32768) >> 16), 0, src_h - 1)
+    src_grid = src.reshape((src_h, src_w, channels))
+    dst_grid = src_grid[y_idx[:, None], x_idx[None, :]]
+    return dst_grid.reshape(-1)
+
+# Test s002: RGB24 -> RGB24 720x576 -> 360x288 NEAREST
+wl_s002 = [w for w in workloads.correctness_workloads() if w["key"] == "s002"][0]
+ref_s002 = get_ref_frame(wl_s002)
+
+# To test scale_nearest, we need input frame. Let's see if driver can dump input frame or if we can run candidate
+print("s002 ref length:", len(ref_s002))
