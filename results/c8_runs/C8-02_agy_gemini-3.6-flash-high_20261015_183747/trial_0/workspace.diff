+            const dy_buf = std.heap.c_allocator.alloc(u8, dw * dh) catch return -1;
+            defer std.heap.c_allocator.free(dy_buf);
+            const du_buf = std.heap.c_allocator.alloc(u8, (dw / 2) * (dh / 2)) catch return -1;
+            defer std.heap.c_allocator.free(du_buf);
+            const dv_buf = std.heap.c_allocator.alloc(u8, (dw / 2) * (dh / 2)) catch return -1;
+            defer std.heap.c_allocator.free(dv_buf);
+
+            scale.scale_plane_1bpp(sy, sw, sh, @intCast(src_stride[0]), dy_buf.ptr, dw, dh, dw, algo);
+            scale.scale_plane_1bpp(su, sw / 2, sh / 2, @intCast(src_stride[1]), du_buf.ptr, dw / 2, dh / 2, dw / 2, algo);
+            scale.scale_plane_1bpp(sv, sw / 2, sh / 2, @intCast(src_stride[2]), dv_buf.ptr, dw / 2, dh / 2, dw / 2, algo);
+
+            convert.yuv420p_to_rgb24(dy_buf.ptr, du_buf.ptr, dv_buf.ptr, dw, dw / 2, dw / 2, dd, @intCast(dst_stride[0]), dw, dh);
+            return 0;
+        }
+
+        // RGB24 -> YUV420P
+        if (sfmt == formats.SWS_PIXFMT_RGB24 and dfmt == formats.SWS_PIXFMT_YUV420P) {
+            const ss = src_data[0] orelse return -1;
+            const dy = dst_data[0] orelse return -1; const du = dst_data[1] orelse return -1; const dv = dst_data[2] orelse return -1;
+
+            const rgb_buf = std.heap.c_allocator.alloc(u8, dw * dh * 3) catch return -1;
+            defer std.heap.c_allocator.free(rgb_buf);
+
+            scale.scale_plane_packed(ss, sw, sh, @intCast(src_stride[0]), rgb_buf.ptr, dw, dh, dw * 3, 3, algo);
+            convert.rgb24_to_yuv420p(rgb_buf.ptr, dw * 3, dy, du, dv, @intCast(dst_stride[0]), @intCast(dst_stride[1]), @intCast(dst_stride[2]), dw, dh);
+            return 0;
+        }
+
+        // YUV444P -> RGB24
+        if (sfmt == formats.SWS_PIXFMT_YUV444P and dfmt == formats.SWS_PIXFMT_RGB24) {
+            const sy = src_data[0] orelse return -1; const su = src_data[1] orelse return -1; const sv = src_data[2] orelse return -1;
+            const dd = dst_data[0] orelse return -1;
+
+            const dy_buf = std.heap.c_allocator.alloc(u8, dw * dh) catch return -1;
+            defer std.heap.c_allocator.free(dy_buf);
+            const du_buf = std.heap.c_allocator.alloc(u8, dw * dh) catch return -1;
+            defer std.heap.c_allocator.free(du_buf);
+            const dv_buf = std.heap.c_allocator.alloc(u8, dw * dh) catch return -1;
+            defer std.heap.c_allocator.free(dv_buf);
+
+            scale.scale_plane_1bpp(sy, sw, sh, @intCast(src_stride[0]), dy_buf.ptr, dw, dh, dw, algo);
+            scale.scale_plane_1bpp(su, sw, sh, @intCast(src_stride[1]), du_buf.ptr, dw, dh, dw, algo);
+            scale.scale_plane_1bpp(sv, sw, sh, @intCast(src_stride[2]), dv_buf.ptr, dw, dh, dw, algo);
+
+            convert.yuv444p_to_rgb24(dy_buf.ptr, du_buf.ptr, dv_buf.ptr, dw, dw, dw, dd, @intCast(dst_stride[0]), dw, dh);
+            return 0;
+        }
+
+        // YUV422P -> RGB24
+        if (sfmt == formats.SWS_PIXFMT_YUV422P and dfmt == formats.SWS_PIXFMT_RGB24) {
+            const sy = src_data[0] orelse return -1; const su = src_data[1] orelse return -1; const sv = src_data[2] orelse return -1;
+            const dd = dst_data[0] orelse return -1;
+
+            const dy_buf = std.heap.c_allocator.alloc(u8, dw * dh) catch return -1;
+            defer std.heap.c_allocator.free(dy_buf);
+            const du_buf = std.heap.c_allocator.alloc(u8, (dw / 2) * dh) catch return -1;
+            defer std.heap.c_allocator.free(du_buf);
+            const dv_buf = std.heap.c_allocator.alloc(u8, (dw / 2) * dh) catch return -1;
+            defer std.heap.c_allocator.free(dv_buf);
+
+            scale.scale_plane_1bpp(sy, sw, sh, @intCast(src_stride[0]), dy_buf.ptr, dw, dh, dw, algo);
+            scale.scale_plane_1bpp(su, sw / 2, sh, @intCast(src_stride[1]), du_buf.ptr, dw / 2, dh, dw / 2, algo);
+            scale.scale_plane_1bpp(sv, sw / 2, sh, @intCast(src_stride[2]), dv_buf.ptr, dw / 2, dh, dw / 2, algo);
+
+            convert.yuv422p_to_rgb24(dy_buf.ptr, du_buf.ptr, dv_buf.ptr, dw, dw / 2, dw / 2, dd, @intCast(dst_stride[0]), dw, dh);
+            return 0;
+        }
+
+        // BGRA -> YUV420P
+        if (sfmt == formats.SWS_PIXFMT_BGRA and dfmt == formats.SWS_PIXFMT_YUV420P) {
+            const ss = src_data[0] orelse return -1;
+            const dy = dst_data[0] orelse return -1; const du = dst_data[1] orelse return -1; const dv = dst_data[2] orelse return -1;
+
+            const bgra_buf = std.heap.c_allocator.alloc(u8, dw * dh * 4) catch return -1;
+            defer std.heap.c_allocator.free(bgra_buf);
+
+            scale.scale_plane_packed(ss, sw, sh, @intCast(src_stride[0]), bgra_buf.ptr, dw, dh, dw * 4, 4, algo);
+            convert.bgra_to_yuv420p(bgra_buf.ptr, dw * 4, dy, du, dv, @intCast(dst_stride[0]), @intCast(dst_stride[1]), @intCast(dst_stride[2]), dw, dh);
+            return 0;
+        }
+    }
+
+    return -1;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        ctx.deinit(std.heap.c_allocator);
+        std.heap.c_allocator.destroy(ctx);
+    }
+}
diff --git a/swscale-impl/src/scale.zig b/swscale-impl/src/scale.zig
