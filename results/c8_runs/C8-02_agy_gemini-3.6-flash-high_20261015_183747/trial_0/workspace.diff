+e_shnum = struct.unpack_from("<H", data, 60)[0]
+
+for i in range(e_shnum):
+    sh_addr, sh_offset, sh_size = struct.unpack_from("<QQQ", data, e_shoff + i * e_shentsize + 16)
+    if sh_addr <= 0x92000 < sh_addr + sh_size:
+        file_off = sh_offset + (0x92000 - sh_addr)
