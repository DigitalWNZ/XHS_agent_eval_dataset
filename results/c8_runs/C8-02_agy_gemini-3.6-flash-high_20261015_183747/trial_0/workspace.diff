+import sys, os, subprocess
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl_yuv420 = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->yuv420p")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_yuv420, 1, "/tmp/ref_yuv420.raw"))
+ref_yuv420 = open("/tmp/ref_yuv420.raw", "rb").read()
+
+wl_bgr = [w for w in workloads.correctness_workloads() if w["label"].startswith("rgb24->bgr24")][0]
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl_bgr, 1, "/tmp/ref_bgr.raw"))
+ref_bgr = open("/tmp/ref_bgr.raw", "rb").read()
+
+w, h = 640, 480
+y_size = w * h
+u_size = (w // 2) * (h // 2)
+
+ref_u = ref_yuv420[y_size:y_size+u_size]
+ref_v = ref_yuv420[y_size+u_size:]
+
+rgb = bytearray(w * h * 3)
+for i in range(w * h):
+    rgb[i*3 + 0] = ref_bgr[i*3 + 2] # R
+    rgb[i*3 + 1] = ref_bgr[i*3 + 1] # G
+    rgb[i*3 + 2] = ref_bgr[i*3 + 0] # B
+
+ru, gu, bu = -4866, -9528, 14394
+rv, gv, bv = 14394, -12061, -2333
+
+def calc_u(r, g, b):
+    v = (ru*r + gu*g + bu*b + 4194304 + 16384) >> 15
+    return 0 if v < 0 else (255 if v > 255 else v)
+
+def calc_v(r, g, b):
+    v = (rv*r + gv*g + bv*b + 4194304 + 16384) >> 15
+    return 0 if v < 0 else (255 if v > 255 else v)
+
+def gen_uv_pixel_avg(rgb, w, h):
+    u_out = bytearray((w//2)*(h//2))
+    v_out = bytearray((w//2)*(h//2))
+    for cy in range(h // 2):
+        y0 = cy * 2
+        y1 = cy * 2 + 1
+        for cx in range(w // 2):
+            x0 = cx * 2
+            x1 = cx * 2 + 1
+            
+            p00 = (y0*w + x0)*3
+            p01 = (y0*w + x1)*3
+            p10 = (y1*w + x0)*3
+            p11 = (y1*w + x1)*3
+            
+            u00 = calc_u(rgb[p00], rgb[p00+1], rgb[p00+2])
+            u01 = calc_u(rgb[p01], rgb[p01+1], rgb[p01+2])
+            u10 = calc_u(rgb[p10], rgb[p10+1], rgb[p10+2])
+            u11 = calc_u(rgb[p11], rgb[p11+1], rgb[p11+2])
+            
+            v00 = calc_v(rgb[p00], rgb[p00+1], rgb[p00+2])
+            v01 = calc_v(rgb[p01], rgb[p01+1], rgb[p01+2])
+            v10 = calc_v(rgb[p10], rgb[p10+1], rgb[p10+2])
+            v11 = calc_v(rgb[p11], rgb[p11+1], rgb[p11+2])
+            
+            u_out[cy*(w//2) + cx] = (u00 + u01 + u10 + u11 + 2) >> 2
+            v_out[cy*(w//2) + cx] = (v00 + v01 + v10 + v11 + 2) >> 2
+            
+    return u_out, v_out
+
+u_p, v_p = gen_uv_pixel_avg(rgb, w, h)
+
+print("Pixel-avg PSNR U:", workloads.psnr(ref_u, u_p))
+print("Pixel-avg PSNR V:", workloads.psnr(ref_v, v_p))
+
+print("First 10 Ref U:", list(ref_u[:10]))
+print("First 10 P   U:", list(u_p[:10]))
