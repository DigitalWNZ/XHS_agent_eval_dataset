+import sys
+sys.path.insert(0, '/app')
+import subprocess
+import os
+import numpy as np
+import workloads
+
+DRIVER = "/app/driver"
+BASELINE = "/app/libswscale_public_baseline.so"
+
+wl = [w for w in workloads.correctness_workloads() if w["key"] == "c000"][0]
+
+out = "/tmp/c000_ref.raw"
+if os.path.exists(out):
+    os.remove(out)
+argv = workloads.driver_argv(DRIVER, BASELINE, wl, 1, out)
+subprocess.run(argv, capture_output=True)
+
+with open(out, "rb") as f:
+    ref_rgb = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640, 3))
+
+with open("/tmp/src_y.raw", "rb") as f:
+    src_y = np.frombuffer(f.read(), dtype=np.uint8).reshape((480, 640))
+
+with open("/tmp/src_u.raw", "rb") as f:
+    src_u = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+with open("/tmp/src_v.raw", "rb") as f:
+    src_v = np.frombuffer(f.read(), dtype=np.uint8).reshape((240, 320))
+
+# Nearest 2x2 upsample for U and V
+u_up = np.repeat(np.repeat(src_u, 2, axis=0), 2, axis=1)
+v_up = np.repeat(np.repeat(src_v, 2, axis=0), 2, axis=1)
+
+cy = 76309
+oy = 1048576
+table_plane_size = 1024 + 2 * 1024
+y_table = np.zeros(table_plane_size, dtype=np.uint8)
+yb = -(384 * 65536) - 1024 * cy - oy
+for i in range(table_plane_size):
+    y_table[i] = np.clip((yb + 32768) >> 16, 0, 255)
+    yb += cy
+
+yoffs = 326 + 1024
+
+crv_scaled = ((104597 * 65536) + 32768) // cy
+cbu_scaled = ((132201 * 65536) + 32768) // cy
+cgu_scaled = ((25675 * 65536) + 32768) // cy
+cgv_scaled = ((53279 * 65536) + 32768) // cy
+
+off_r = crv_scaled >> 9
+off_b = cbu_scaled >> 9
+off_gu = cgu_scaled >> 9
+off_gv = cgv_scaled >> 9
+
+def convert_frame(Y, U, V):
+    h, w = Y.shape
+    out = np.zeros((h, w, 3), dtype=np.uint8)
+    
+    cb_r = (V.astype(np.int32) - 128) * crv_scaled
+    cb_b = (U.astype(np.int32) - 128) * cbu_scaled
+    cb_gu = (U.astype(np.int32) - 128) * cgu_scaled
+    cb_gv = (V.astype(np.int32) - 128) * cgv_scaled
+    
+    idx_r = yoffs - off_r + (cb_r >> 16)
+    idx_b = yoffs - off_b + (cb_b >> 16)
+    idx_g = yoffs - off_gu - off_gv - (cb_gu >> 16) - (cb_gv >> 16)
+    
+    out[:, :, 0] = y_table[idx_r + Y.astype(np.int32)]
+    out[:, :, 1] = y_table[idx_g + Y.astype(np.int32)]
+    out[:, :, 2] = y_table[idx_b + Y.astype(np.int32)]
+    return out
+
+cand_rgb = convert_frame(src_y, u_up, v_up)
+
+def psnr(a, b):
+    mse = np.mean((a.astype(float) - b.astype(float))**2)
+    if mse == 0: return 100.0
+    return 10.0 * np.log10(255.0**2 / mse)
+
+print("Table PSNR:", psnr(cand_rgb, ref_rgb))
