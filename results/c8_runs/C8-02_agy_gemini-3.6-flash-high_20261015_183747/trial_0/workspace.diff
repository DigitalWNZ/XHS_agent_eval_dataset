--- /dev/null
+++ b/swscale-impl/src/scale.zig
@@ -0,0 +1,288 @@
+const std = @import("std");
+const formats = @import("formats.zig");
+
+inline fn clamp_u8(val: i64) u8 {
+    if (val < 0) return 0;
+    if (val > 255) return 255;
+    return @intCast(val);
+}
+
+// ── 1 bpp Plane Scaling ─────────────────────────────────────────────────────
+
+pub fn scale_plane_1bpp(
+    src: [*]const u8, src_w: usize, src_h: usize, src_stride: usize,
+    dst: [*]u8, dst_w: usize, dst_h: usize, dst_stride: usize,
+    algo: c_int,
+) void {
+    const xInc = (src_w << 16) / dst_w;
+    const yInc = (src_h << 16) / dst_h;
+
+    if (algo == formats.SWS_ALGO_NEAREST) {
+        for (0..dst_h) |dy| {
+            const y_src = dy * yInc + (yInc >> 1);
+            const sy = y_src >> 16;
+            const src_row = src + @min(sy, src_h - 1) * src_stride;
+            const dst_row = dst + dy * dst_stride;
+            for (0..dst_w) |dx| {
+                const x_src = dx * xInc + (xInc >> 1);
+                const sx = x_src >> 16;
+                dst_row[dx] = src_row[@min(sx, src_w - 1)];
+            }
+        }
+    } else if (algo == formats.SWS_ALGO_BILINEAR) {
+        const is_down_x = xInc > (1 << 16);
+        const is_down_y = yInc > (1 << 16);
+
+        if (is_down_x or is_down_y) {
+            for (0..dst_h) |dy| {
+                const sy0 = (dy * yInc) >> 16;
+                var sy1 = ((dy + 1) * yInc) >> 16;
+                if (sy1 == sy0) sy1 = sy0 + 1;
+                sy1 = @min(sy1, src_h);
+
+                const dst_row = dst + dy * dst_stride;
+                for (0..dst_w) |dx| {
+                    const sx0 = (dx * xInc) >> 16;
+                    var sx1 = ((dx + 1) * xInc) >> 16;
+                    if (sx1 == sx0) sx1 = sx0 + 1;
+                    sx1 = @min(sx1, src_w);
+
+                    var sum: u64 = 0;
+                    var count: u64 = 0;
+                    var sy = sy0;
+                    while (sy < sy1) : (sy += 1) {
+                        const src_row = src + sy * src_stride;
+                        var sx = sx0;
+                        while (sx < sx1) : (sx += 1) {
+                            sum += src_row[sx];
+                            count += 1;
+                        }
+                    }
+                    dst_row[dx] = clamp_u8(@intCast((sum + count / 2) / count));
+                }
+            }
+        } else {
+            for (0..dst_h) |dy| {
+                const y_src_i = @as(i64, @intCast(dy * yInc + (yInc >> 1))) - (1 << 15);
+                const y_src: usize = if (y_src_i < 0) 0 else @intCast(y_src_i);
+                const sy0 = y_src >> 16;
+                const sy1 = @min(sy0 + 1, src_h - 1);
+
+                const frac_y: u64 = @intCast((y_src & 0xFFFF) >> 2); // 14-bit
+                const wy0: u64 = 16384 - frac_y;
+                const wy1: u64 = frac_y;
+
+                const row0 = src + sy0 * src_stride;
+                const row1 = src + sy1 * src_stride;
+                const dst_row = dst + dy * dst_stride;
+
+                for (0..dst_w) |dx| {
+                    const x_src_i = @as(i64, @intCast(dx * xInc + (xInc >> 1))) - (1 << 15);
+                    const x_src: usize = if (x_src_i < 0) 0 else @intCast(x_src_i);
+                    const sx0 = x_src >> 16;
+                    const sx1 = @min(sx0 + 1, src_w - 1);
+
+                    const frac_x: u64 = @intCast((x_src & 0xFFFF) >> 2); // 14-bit
+                    const wx0: u64 = 16384 - frac_x;
+                    const wx1: u64 = frac_x;
+
+                    const sum = row0[sx0] * wx0 * wy0 + row0[sx1] * wx1 * wy0 + row1[sx0] * wx0 * wy1 + row1[sx1] * wx1 * wy1;
+                    const val = (sum + (1 << 27)) >> 28;
+                    dst_row[dx] = clamp_u8(@intCast(val));
+                }
+            }
+        }
+    } else { // BICUBIC
+        for (0..dst_h) |dy| {
+            const y_src_i = @as(i64, @intCast(dy * yInc + (yInc >> 1))) - (1 << 15);
+            const y_src: usize = if (y_src_i < 0) 0 else @intCast(y_src_i);
+            const sy_base: i64 = @intCast(y_src >> 16);
+            const fy: f64 = @as(f64, @floatFromInt(y_src & 0xFFFF)) / 65536.0;
+
+            var wy: [4]i64 = undefined;
+            get_bicubic_weights(fy, &wy);
+
+            const dst_row = dst + dy * dst_stride;
+
+            for (0..dst_w) |dx| {
+                const x_src_i = @as(i64, @intCast(dx * xInc + (xInc >> 1))) - (1 << 15);
+                const x_src: usize = if (x_src_i < 0) 0 else @intCast(x_src_i);
+                const sx_base: i64 = @intCast(x_src >> 16);
+                const fx: f64 = @as(f64, @floatFromInt(x_src & 0xFFFF)) / 65536.0;
+
+                var wx: [4]i64 = undefined;
+                get_bicubic_weights(fx, &wx);
+
+                var sum: i64 = 0;
+                var j: i64 = -1;
+                while (j <= 2) : (j += 1) {
+                    const sy = std.math.clamp(sy_base + j, 0, @as(i64, @intCast(src_h)) - 1);
+                    const row = src + @as(usize, @intCast(sy)) * src_stride;
+                    const w_y = wy[@intCast(j + 1)];
+
+                    var i: i64 = -1;
+                    while (i <= 2) : (i += 1) {
+                        const sx = std.math.clamp(sx_base + i, 0, @as(i64, @intCast(src_w)) - 1);
+                        const pixel: i64 = row[@intCast(sx)];
+                        const w_x = wx[@intCast(i + 1)];
+                        sum += pixel * w_x * w_y;
+                    }
+                }
+
+                dst_row[dx] = clamp_u8((sum + 134217728) >> 28);
+            }
+        }
+    }
+}
+
+// ── Packed N-channels Plane Scaling (RGB24/BGR24 = 3, RGBA/BGRA = 4) ───────
+
+pub fn scale_plane_packed(
+    src: [*]const u8, src_w: usize, src_h: usize, src_stride: usize,
+    dst: [*]u8, dst_w: usize, dst_h: usize, dst_stride: usize,
+    channels: usize, algo: c_int,
+) void {
+    if (algo == formats.SWS_ALGO_NEAREST) {
+        const xInc = (src_w << 16) / dst_w;
+        const yInc = (src_h << 16) / dst_h;
+        for (0..dst_h) |dy| {
+            const y_src = dy * yInc + (yInc >> 1);
+            const sy = y_src >> 16;
+            const src_row = src + @min(sy, src_h - 1) * src_stride;
+            const dst_row = dst + dy * dst_stride;
+            for (0..dst_w) |dx| {
+                const x_src = dx * xInc + (xInc >> 1);
+                const sx = x_src >> 16;
+                const sx_clamped = @min(sx, src_w - 1);
+                for (0..channels) |c| {
+                    dst_row[dx * channels + c] = src_row[sx_clamped * channels + c];
+                }
+            }
+        }
+    } else if (algo == formats.SWS_ALGO_BILINEAR) {
+        const xInc = (src_w << 16) / dst_w;
+        const yInc = (src_h << 16) / dst_h;
+        const is_down_x = xInc > (1 << 16);
+        const is_down_y = yInc > (1 << 16);
+
+        for (0..dst_h) |dy| {
+            const y_src_i = @as(i64, @intCast(dy * yInc + (yInc >> 1))) - (1 << 15);
+            const y_src: usize = if (y_src_i < 0) 0 else @intCast(y_src_i);
+            const sy0 = y_src >> 16;
+            const sy1 = @min(sy0 + 1, src_h - 1);
+            const sy2 = @min(sy0 + 2, src_h - 1);
+
+            const frac_y: u64 = @intCast((y_src & 0xFFFF) >> 2); // 14-bit
+            const wy0: u64 = if (is_down_y) 8192 - (frac_y >> 1) else 16384 - frac_y;
+            const wy1: u64 = if (is_down_y) 8192 else frac_y;
+            const wy2: u64 = if (is_down_y) frac_y >> 1 else 0;
+
+            const row0 = src + sy0 * src_stride;
+            const row1 = src + sy1 * src_stride;
+            const row2 = src + sy2 * src_stride;
+            const dst_row = dst + dy * dst_stride;
+
+            for (0..dst_w) |dx| {
+                const x_src_i = @as(i64, @intCast(dx * xInc + (xInc >> 1))) - (1 << 15);
+                const x_src: usize = if (x_src_i < 0) 0 else @intCast(x_src_i);
+                const sx0 = x_src >> 16;
+                const sx1 = @min(sx0 + 1, src_w - 1);
+                const sx2 = @min(sx0 + 2, src_w - 1);
+
+                const frac_x: u64 = @intCast((x_src & 0xFFFF) >> 2); // 14-bit
+                const wx0: u64 = if (is_down_x) 8192 - (frac_x >> 1) else 16384 - frac_x;
+                const wx1: u64 = if (is_down_x) 8192 else frac_x;
+                const wx2: u64 = if (is_down_x) frac_x >> 1 else 0;
+                const wx_sum: u64 = wx0 + wx1 + wx2;
+
+                for (0..channels) |c| {
+                    var sum: u64 = 0;
+                    if (!is_down_y and !is_down_x) {
+                        const p00: u64 = row0[sx0 * channels + c];
+                        const p01: u64 = row0[sx1 * channels + c];
+                        const p10: u64 = row1[sx0 * channels + c];
+                        const p11: u64 = row1[sx1 * channels + c];
+                        sum = p00 * wx0 * wy0 + p01 * wx1 * wy0 + p10 * wx0 * wy1 + p11 * wx1 * wy1;
+                    } else {
+                        const r0: u64 = row0[sx0 * channels + c] * wx0 + row0[sx1 * channels + c] * wx1 + row0[sx2 * channels + c] * wx2;
+                        const r1: u64 = row1[sx0 * channels + c] * wx0 + row1[sx1 * channels + c] * wx1 + row1[sx2 * channels + c] * wx2;
+                        const r2: u64 = row2[sx0 * channels + c] * wx0 + row2[sx1 * channels + c] * wx1 + row2[sx2 * channels + c] * wx2;
+                        sum = (r0 * wy0 + r1 * wy1 + r2 * wy2) / wx_sum;
+                    }
+
+                    const shift: u6 = if (!is_down_y and !is_down_x) 28 else 14;
+                    const half = @as(u64, 1) << (shift - 1);
+                    const val = (sum + half) >> shift;
+                    dst_row[dx * channels + c] = clamp_u8(@intCast(val));
+                }
+            }
+        }
+    } else { // BICUBIC
+        const xInc = (src_w << 16) / dst_w;
+        const yInc = (src_h << 16) / dst_h;
+
+        for (0..dst_h) |dy| {
+            const y_src_i = @as(i64, @intCast(dy * yInc + (yInc >> 1))) - (1 << 15);
+            const y_src: usize = if (y_src_i < 0) 0 else @intCast(y_src_i);
+            const sy_base: i64 = @intCast(y_src >> 16);
+            const fy: f64 = @as(f64, @floatFromInt(y_src & 0xFFFF)) / 65536.0;
+
+            var wy: [4]i64 = undefined;
+            get_bicubic_weights(fy, &wy);
+
+            const dst_row = dst + dy * dst_stride;
+
+            for (0..dst_w) |dx| {
+                const x_src_i = @as(i64, @intCast(dx * xInc + (xInc >> 1))) - (1 << 15);
+                const x_src: usize = if (x_src_i < 0) 0 else @intCast(x_src_i);
+                const sx_base: i64 = @intCast(x_src >> 16);
+                const fx: f64 = @as(f64, @floatFromInt(x_src & 0xFFFF)) / 65536.0;
+
+                var wx: [4]i64 = undefined;
+                get_bicubic_weights(fx, &wx);
+
+                for (0..channels) |ch| {
+                    var sum: i64 = 0;
+                    var j: i64 = -1;
+                    while (j <= 2) : (j += 1) {
+                        const sy = std.math.clamp(sy_base + j, 0, @as(i64, @intCast(src_h)) - 1);
+                        const row = src + @as(usize, @intCast(sy)) * src_stride;
+                        const w_y = wy[@intCast(j + 1)];
+
+                        var i: i64 = -1;
+                        while (i <= 2) : (i += 1) {
+                            const sx = std.math.clamp(sx_base + i, 0, @as(i64, @intCast(src_w)) - 1);
+                            const pixel: i64 = row[@as(usize, @intCast(sx)) * channels + ch];
+                            const w_x = wx[@intCast(i + 1)];
+                            sum += pixel * w_x * w_y;
+                        }
+                    }
+
+                    dst_row[dx * channels + ch] = clamp_u8((sum + 134217728) >> 28);
+                }
+            }
+        }
+    }
+}
+
+fn get_bicubic_weights(f: f64, weights: *[4]i64) void {
+    const B: f64 = 0.0;
+    const C: f64 = 0.6;
+
+    var i: i64 = -1;
+    while (i <= 2) : (i += 1) {
+        const d = @abs(@as(f64, @floatFromInt(i)) - f);
+        var coeff: f64 = 0.0;
+        if (d < 1.0) {
+            coeff = ((12.0 - 9.0 * B - 6.0 * C) * d * d * d +
+                (-18.0 + 12.0 * B + 6.0 * C) * d * d +
+                (6.0 - 2.0 * B)) / 6.0;
+        } else if (d < 2.0) {
+            coeff = ((-B - 6.0 * C) * d * d * d +
+                (6.0 * B + 30.0 * C) * d * d +
+                (-12.0 * B - 48.0 * C) * d +
+                (8.0 * B + 24.0 * C)) / 6.0;
+        }
+        weights[@intCast(i + 1)] = @intFromFloat(coeff * 16384.0);
+    }
+}
