@@ -0,0 +1,49 @@
+import sys, os, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wls = workloads.correctness_workloads()
+scale_wls = [w for w in wls if w["scaling"]]
+
+print(f"Testing {len(scale_wls)} scaling workloads:")
+
+def scale_plane_bilinear(src, src_w, src_h, dst_w, dst_h):
+    dst = np.zeros((dst_h, dst_w), dtype=np.uint8)
+    xInc = (src_w << 16) // dst_w
+    yInc = (src_h << 16) // dst_h
+    
+    for dy in range(dst_h):
+        y_src = dy * yInc + (yInc >> 1) - (1 << 15)
+        if y_src < 0: y_src = 0
+        sy0 = y_src >> 16
+        sy1 = min(sy0 + 1, src_h - 1)
+        frac_y = (y_src & 0xFFFF) >> 2
+        wy0 = 16384 - frac_y
+        wy1 = frac_y
+        
+        for dx in range(dst_w):
+            x_src = dx * xInc + (xInc >> 1) - (1 << 15)
+            if x_src < 0: x_src = 0
+            sx0 = x_src >> 16
+            sx1 = min(sx0 + 1, src_w - 1)
+            frac_x = (x_src & 0xFFFF) >> 2
+            wx0 = 16384 - frac_x
+            wx1 = frac_x
+            
+            p00 = int(src[sy0, sx0])
+            p01 = int(src[sy0, sx1])
+            p10 = int(src[sy1, sx0])
+            p11 = int(src[sy1, sx1])
+            
+            val = (p00 * wx0 * wy0 + p01 * wx1 * wy0 + p10 * wx0 * wy1 + p11 * wx1 * wy1 + (1 << 27)) >> 28
+            dst[dy, dx] = max(0, min(255, val))
+            
+    return dst
+
+for wl in scale_wls[:4]:
+    print(f"Workload {wl['label']}:")
+    ref_path = f"/tmp/ref_{wl['key']}.raw"
+    subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path))
+    ref = open(ref_path, "rb").read()
+    print("  Ref size:", len(ref))
