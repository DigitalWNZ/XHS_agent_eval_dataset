diff --git a/swscale-impl/scratch/test_ffmpeg_init_filter.c b/swscale-impl/scratch/test_ffmpeg_init_filter.c
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_ffmpeg_init_filter.c
@@ -0,0 +1,128 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+
+typedef struct {
+    int filterSize;
+    int32_t *filterPos;
+    int16_t *filter; // fixed point 1.14 (sum = 16384)
+} SwsFilter1D;
+
+SwsFilter1D make_bilinear_filter(int srcW, int dstW) {
+    SwsFilter1D f;
+    int xInc = (srcW << 16) / dstW;
+    int sizeFactor = 2;
+    if (xInc <= (1 << 16)) {
+        f.filterSize = 1 + sizeFactor;
+    } else {
+        f.filterSize = 1 + (sizeFactor * srcW + dstW - 1) / dstW;
+    }
+
+    f.filterPos = malloc(dstW * sizeof(int32_t));
+    f.filter = malloc(dstW * f.filterSize * sizeof(int16_t));
+
+    int64_t xDstInSrc = (int64_t)xInc / 2 - 0x8000;
+    for (int i = 0; i < dstW; i++) {
+        int xx = (xDstInSrc - (f.filterSize - 2) * (1LL << 16)) / (1 << 17);
+        f.filterPos[i] = xx;
+
+        int32_t sum = 0;
+        double float_coeffs[32];
+        double tot = 0;
+        for (int j = 0; j < f.filterSize; j++) {
+            int64_t d = llabs(((int64_t)xx * (1 << 17)) - xDstInSrc) << 13;
+            if (xInc > (1 << 16)) {
+                d = d * dstW / srcW;
+            }
+            double floatd = d * (1.0 / (1 << 30));
+            double coeff = 1.0 - floatd;
+            if (coeff < 0) coeff = 0;
+            float_coeffs[j] = coeff;
+            tot += coeff;
+            xx++;
+        }
+
+        // Normalize coeffs to 16384 (1.14 fixed point)
+        for (int j = 0; j < f.filterSize; j++) {
+            int16_t val = (int16_t)round((float_coeffs[j] / tot) * 16384.0);
+            f.filter[i * f.filterSize + j] = val;
+        }
+
+        xDstInSrc += 2LL * xInc;
+    }
+
+    return f;
+}
+
+int main() {
+    int src_w = 1280, src_h = 720;
+    int dst_w = 640, dst_h = 360;
+
+    uint8_t *src = malloc(src_w * src_h);
+    uint8_t *ref = malloc(dst_w * dst_h);
+
+    FILE *f_src = fopen("/tmp/src_gray8.raw", "rb");
+    FILE *f_ref = fopen("/tmp/ref_gray.raw", "rb");
+    if (!f_src || !f_ref) {
+        printf("Files missing\n");
+        return 1;
+    }
+    fread(src, 1, src_w * src_h, f_src);
+    fread(ref, 1, dst_w * dst_h, f_ref);
+
+    SwsFilter1D fx = make_bilinear_filter(src_w, dst_w);
+    SwsFilter1D fy = make_bilinear_filter(src_h, dst_h);
+
+    printf("Filter Size X: %d, Y: %d\n", fx.filterSize, fy.filterSize);
+
+    // Apply 2-pass filtering: H-scale then V-scale
+    int16_t *tmp = malloc(dst_w * src_h * sizeof(int16_t));
+    for (int y = 0; y < src_h; y++) {
+        const uint8_t *s_row = src + y * src_w;
+        int16_t *t_row = tmp + y * dst_w;
+        for (int dx = 0; dx < dst_w; dx++) {
+            int pos = fx.filterPos[dx];
+            const int16_t *f = fx.filter + dx * fx.filterSize;
+            int32_t sum = 0;
+            for (int j = 0; j < fx.filterSize; j++) {
+                int sx = pos + j;
+                if (sx < 0) sx = 0;
+                if (sx >= src_w) sx = src_w - 1;
+                sum += s_row[sx] * f[j];
+            }
+            t_row[dx] = (sum + 64) >> 7; // intermediate 16-bit
+        }
+    }
+
+    uint8_t *dst = malloc(dst_w * dst_h);
+    for (int dy = 0; dy < dst_h; dy++) {
+        int pos = fy.filterPos[dy];
+        const int16_t *f = fy.filter + dy * fy.filterSize;
+        uint8_t *d_row = dst + dy * dst_w;
+        for (int dx = 0; dx < dst_w; dx++) {
+            int32_t sum = 0;
+            for (int j = 0; j < fy.filterSize; j++) {
+                int sy = pos + j;
+                if (sy < 0) sy = 0;
+                if (sy >= src_h) sy = src_h - 1;
+                sum += tmp[sy * dst_w + dx] * f[j];
+            }
+            int val = (sum + 4096) >> 13;
+            if (val < 0) val = 0;
+            if (val > 255) val = 255;
+            d_row[dx] = val;
+        }
+    }
+
+    double sse = 0;
+    for (int i = 0; i < dst_w * dst_h; i++) {
+        double d = dst[i] - ref[i];
+        sse += d * d;
+    }
+
+    printf("FFmpeg Bilinear Filter Scaling PSNR: %.2f dB\n",
+        sse == 0 ? 100.0 : 10.0 * log10(255.0 * 255.0 * dst_w * dst_h / sse));
+
+    return 0;
+}
