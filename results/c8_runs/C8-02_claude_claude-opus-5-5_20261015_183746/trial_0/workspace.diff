+import sys, subprocess, tempfile
+sys.path[:0] = ['/app']
+import workloads as W
+lib = sys.argv[1]
+d = tempfile.mkdtemp()
+def frame(l, wl, out):
+    p = subprocess.run(W.driver_argv('/app/driver', l, wl, 1, out), capture_output=True)
+    return open(out,'rb').read() if p.returncode == 0 else None
+cases = []
+for (s, t) in W._PAIRS:
+    for (w, h) in [(642, 482), (96, 64), (34, 18), (1282, 722)]:
+        cases.append(W._wl('x', s, t, w, h, w, h, 1))
+    cases.append(W._wl('x', s, t, 642, 482, 642, 482, 0))
+    cases.append(W._wl('x', s, t, 642, 482, 642, 482, 2))
+    if s not in W.SUBSAMPLED and t not in W.SUBSAMPLED:
+        cases.append(W._wl('x', s, t, 643, 481, 643, 481, 1))
+for (s, t, sw, sh, dw, dh, a) in W._SCALES:
+    for (k1, k2) in [(1, 1), (0.77, 0.83), (1.3, 1.1)]:
+        nsw, nsh, ndw, ndh = [int(v * k) // 2 * 2 for v, k in ((sw, k1), (sh, k2), (dw, k2), (dh, k1))]
+        for alg in (0, 1, 2):
+            cases.append(W._wl('x', s, t, nsw, nsh, ndw, ndh, alg))
+    cases.append(W._wl('x', s, t, sw, sh, dw + 2, dh + 2, a))
+bad = 0
+for wl in cases:
+    ref = frame('/app/libswscale_public_baseline.so', wl, d + '/r'); c = frame(lib, wl, d + '/c')
+    if ref is None: continue
+    r = W.grade(ref, c, wl['dst_fmt'], wl['dst_w'], wl['dst_h'], wl['scaling']) if c else {'status': 'fail', 'min_psnr': 0}
+    if r['status'] != 'pass':
+        bad += 1
+        print('FAIL', wl['label'], r.get('min_psnr'), flush=True)
+print('cases', len(cases), 'bad', bad)
