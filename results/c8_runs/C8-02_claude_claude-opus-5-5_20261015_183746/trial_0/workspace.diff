new file mode 100644
--- /dev/null
+++ b/swscale-impl/tools/prof.py
@@ -0,0 +1,32 @@
+# usage: python3 prof.py lib.so src dst sw sh dw dh algo iters
+import sys, subprocess, re, collections, bisect
+sys.path[:0] = ['/app/performance']
+import performance, insn_pricing
+lib = sys.argv[1]; args = sys.argv[2:]
+out = '/tmp/prof.cg'
+subprocess.run(["valgrind", "--tool=callgrind", "--dump-instr=yes", "--dump-line=no", "--collect-jumps=no",
+                f"--callgrind-out-file={out}", "/app/driver", lib, *args], capture_output=True)
+parsed = performance.parse_callgrind(out, lib.split('/')[-1])
+dis = subprocess.run(["objdump", "-d", "--no-show-raw-insn", lib], capture_output=True, text=True).stdout
+syms = []; a2op = {}
+cur = None
+for line in dis.splitlines():
+    m = re.match(r"^([0-9a-f]+) <(.*)>:", line)
+    if m: syms.append((int(m.group(1), 16), m.group(2))); continue
+    g = re.match(r"\s+([0-9a-f]+):\s+(\S+)\s*(.*)", line)
+    if g: a2op[int(g.group(1), 16)] = (g.group(2), g.group(3).split("#")[0].strip())
+syms.sort(); starts = [s[0] for s in syms]
+fn = collections.Counter(); ops = collections.Counter()
+for a, v in parsed['cand_addr'].items():
+    ir = v[0]
+    e = a2op.get(a)
+    if not e: continue
+    mn, mem = insn_pricing.normalize_opcode(e[0], e[1])
+    c = insn_pricing.insn_cost(mn, mem) or 1.0
+    i = bisect.bisect_right(starts, a) - 1
+    fn[syms[i][1][:60]] += c * ir
+    ops[(mn, mem)] += c * ir
+tot = sum(fn.values())
+print('total', f"{tot:,.0f}")
+for k, v in fn.most_common(12): print(f"{v:14,.0f} {100*v/tot:5.1f}% {k}")
+for k, v in ops.most_common(25): print(f"{v:14,.0f} {100*v/tot:5.1f}% {k}")
