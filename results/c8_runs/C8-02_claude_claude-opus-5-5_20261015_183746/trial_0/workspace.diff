+import sys, subprocess, tempfile, itertools
+sys.path[:0] = ['/app']
+import workloads as W
+lib = sys.argv[1]
+d = tempfile.mkdtemp()
+def frame(l, wl, out):
+    p = subprocess.run(W.driver_argv('/app/driver', l, wl, 1, out), capture_output=True)
+    return open(out,'rb').read() if p.returncode == 0 else None
+cases = []
+fmts = range(10)
+sizes = [(2, 2), (4, 2), (8, 8), (18, 6), (34, 4)]
+for s, t in itertools.product(fmts, fmts):
+    for (w, h) in sizes:
+        cases.append(W._wl('x', s, t, w, h, w, h, 1))
+    cases.append(W._wl('x', s, t, 100, 50, 30, 20, 2))
+    cases.append(W._wl('x', s, t, 64, 48, 256, 192, 1))
+    cases.append(W._wl('x', s, t, 1200, 40, 140, 10, 2))
+    cases.append(W._wl('x', s, t, 22, 10, 100, 34, 0))
+    if s not in W.SUBSAMPLED and t not in W.SUBSAMPLED:
+        cases.append(W._wl('x', s, t, 101, 51, 77, 33, 1))
+        cases.append(W._wl('x', s, t, 33, 17, 33, 17, 2))
+pairs = set(W._PAIRS); sc = set((a[0], a[1], a[6]) for a in W._SCALES)
+def rel(wl):
+    if wl['scaling']: return (wl['src_fmt'], wl['dst_fmt'], wl['algo']) in sc or (wl['src_fmt'], wl['dst_fmt']) in [(a[0], a[1]) for a in W._SCALES]
+    return (wl['src_fmt'], wl['dst_fmt']) in pairs
+cases = [c for c in cases if rel(c)]
+bad = 0; n = 0
+for wl in cases:
+    ref = frame('/app/libswscale_public_baseline.so', wl, d + '/r')
+    if ref is None: continue
+    n += 1
+    c = frame(lib, wl, d + '/c')
+    r = W.grade(ref, c, wl['dst_fmt'], wl['dst_w'], wl['dst_h'], wl['scaling']) if c else {'status': 'fail', 'min_psnr': 0}
+    if r['status'] != 'pass':
+        bad += 1
+        print('FAIL', wl['label'], r.get('min_psnr'), flush=True)
+print('cases', n, 'bad', bad)
