+# usage: python3 chk.py <lib.so> [--measure] [keys...]   (keys: c000.. s000.. b000..)
+import sys, os, json, subprocess, tempfile
+sys.path[:0] = ['/app', '/app/performance']
+import workloads, performance
+lib = sys.argv[1]
+meas = '--measure' in sys.argv
+keys = [a for a in sys.argv[2:] if not a.startswith('--')]
+wls = workloads.correctness_workloads() + workloads.benchmark_workloads()
+if keys: wls = [w for w in wls if w['key'] in keys]
+base = json.load(open('/app/baseline-work.json'))
+d = tempfile.mkdtemp()
+def frame(l, wl, out):
+    p = subprocess.run(workloads.driver_argv('/app/driver', l, wl, 1, out), capture_output=True)
+    return open(out,'rb').read() if p.returncode == 0 else None
+bad = 0
+for wl in wls:
+    ref = frame('/app/libswscale_public_baseline.so', wl, d+'/r'); c = frame(lib, wl, d+'/c')
+    r = workloads.grade(ref, c, wl['dst_fmt'], wl['dst_w'], wl['dst_h'], wl['scaling']) if c else {'status':'fail','min_psnr':0}
+    bad += r['status'] != 'pass'
+    line = f"{wl['key']} {wl['label']:<44} {r['status']} {r.get('min_psnr')}"
+    if meas and wl['key'] in base:
+        m = workloads.measure('/app/driver', lib, wl)
+        line += f"  work {m['work']:,.0f}  ratio {base[wl['key']]/m['work']:.2f}x"
+    print(line, flush=True)
+print('bad', bad)
