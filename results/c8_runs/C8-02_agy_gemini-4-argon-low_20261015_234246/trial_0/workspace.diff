+                (dst_ptr + 3 * i + 16)[0..8].* = out1;
+            }
+            while (i < w_u) : (i += 1) {
+                dst_ptr[3 * i + 0] = src_ptr[4 * i + 0];
+                dst_ptr[3 * i + 1] = src_ptr[4 * i + 1];
+                dst_ptr[3 * i + 2] = src_ptr[4 * i + 2];
+            }
+            src_ptr = ptrAddConst(u8, src_ptr, @as(isize, src_stride[0]));
+            dst_ptr = ptrAdd(u8, dst_ptr, @as(isize, dst_stride[0]));
+        }
+    } else if ((c.src_fmt == ctx_mod.PIXFMT_BGRA and c.dst_fmt == ctx_mod.PIXFMT_RGB24) or
+        (c.src_fmt == ctx_mod.PIXFMT_RGBA and c.dst_fmt == ctx_mod.PIXFMT_BGR24))
+    {
+        for (0..h_u) |_| {
+            var i: usize = 0;
+            while (i + 8 <= w_u) : (i += 8) {
+                const v0: @Vector(16, u8) = (src_ptr + 4 * i)[0..16].*;
+                const v1: @Vector(16, u8) = (src_ptr + 4 * i + 16)[0..16].*;
+                const out0: @Vector(16, u8) = @shuffle(u8, v0, v1, @Vector(16, i32){
+                    2, 1, 0, 6, 5, 4, 10, 9, 8, 14, 13, 12, -3, -2, -1, -7,
+                });
+                const out1: @Vector(8, u8) = @shuffle(u8, v1, v1, @Vector(8, i32){
+                    5, 4, 10, 9, 8, 14, 13, 12,
+                });
+                (dst_ptr + 3 * i)[0..16].* = out0;
+                (dst_ptr + 3 * i + 16)[0..8].* = out1;
+            }
+            while (i < w_u) : (i += 1) {
+                dst_ptr[3 * i + 0] = src_ptr[4 * i + 2];
+                dst_ptr[3 * i + 1] = src_ptr[4 * i + 1];
+                dst_ptr[3 * i + 2] = src_ptr[4 * i + 0];
+            }
+            src_ptr = ptrAddConst(u8, src_ptr, @as(isize, src_stride[0]));
+            dst_ptr = ptrAdd(u8, dst_ptr, @as(isize, dst_stride[0]));
+        }
+    } else if ((c.src_fmt == ctx_mod.PIXFMT_RGBA and c.dst_fmt == ctx_mod.PIXFMT_BGRA) or
+        (c.src_fmt == ctx_mod.PIXFMT_BGRA and c.dst_fmt == ctx_mod.PIXFMT_RGBA))
+    {
+        const swap_mask = @Vector(32, i32){
+            2,  1,  0,  3,  6,  5,  4,  7,  10, 9,  8,  11, 14, 13, 12, 15,
+            18, 17, 16, 19, 22, 21, 20, 23, 26, 25, 24, 27, 30, 29, 28, 31,
+        };
+        for (0..h_u) |_| {
+            var i: usize = 0;
+            while (i + 8 <= w_u) : (i += 8) {
+                const v: @Vector(32, u8) = (src_ptr + 4 * i)[0..32].*;
+                (dst_ptr + 4 * i)[0..32].* = @shuffle(u8, v, v, swap_mask);
+            }
+            while (i < w_u) : (i += 1) {
+                const b0 = src_ptr[4 * i + 0];
+                const b1 = src_ptr[4 * i + 1];
+                const b2 = src_ptr[4 * i + 2];
+                const b3 = src_ptr[4 * i + 3];
+                dst_ptr[4 * i + 0] = b2;
+                dst_ptr[4 * i + 1] = b1;
+                dst_ptr[4 * i + 2] = b0;
+                dst_ptr[4 * i + 3] = b3;
+            }
+            src_ptr = ptrAddConst(u8, src_ptr, @as(isize, src_stride[0]));
+            dst_ptr = ptrAdd(u8, dst_ptr, @as(isize, dst_stride[0]));
+        }
+    }
+}
+
+pub fn gray8ToRgb(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+) void {
+    const w_u: usize = @intCast(c.src_w);
+    const h_u: usize = @intCast(c.src_h);
+    var src_ptr = src[0].?;
+    var dst_ptr = dst[0].?;
+    const alpha8: @Vector(8, u8) = @splat(255);
+
+    for (0..h_u) |_| {
+        if (c.dst_fmt == ctx_mod.PIXFMT_RGB24 or c.dst_fmt == ctx_mod.PIXFMT_BGR24) {
+            var i: usize = 0;
+            while (i + 8 <= w_u) : (i += 8) {
+                const v: @Vector(8, u8) = src_ptr[i..][0..8].*;
+                packRgb8Pixels24(v, v, v, dst_ptr + 3 * i, false);
+            }
+            while (i < w_u) : (i += 1) {
+                const v = src_ptr[i];
+                dst_ptr[3 * i + 0] = v;
+                dst_ptr[3 * i + 1] = v;
+                dst_ptr[3 * i + 2] = v;
+            }
+        } else {
+            var i: usize = 0;
+            while (i + 8 <= w_u) : (i += 8) {
+                const v: @Vector(8, u8) = src_ptr[i..][0..8].*;
+                packRgb8Pixels32(v, v, v, alpha8, dst_ptr + 4 * i, false);
+            }
+            while (i < w_u) : (i += 1) {
+                const v = src_ptr[i];
+                dst_ptr[4 * i + 0] = v;
+                dst_ptr[4 * i + 1] = v;
+                dst_ptr[4 * i + 2] = v;
+                dst_ptr[4 * i + 3] = 255;
+            }
+        }
+        src_ptr = ptrAddConst(u8, src_ptr, @as(isize, src_stride[0]));
+        dst_ptr = ptrAdd(u8, dst_ptr, @as(isize, dst_stride[0]));
+    }
+}
+
+pub fn packedCopy(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+) void {
+    const bpp_bytes: i32 = @divTrunc(c.src_bpp + 7, 8);
+    copyPlane(src[0].?, src_stride[0], c.src_h, c.src_w * bpp_bytes, dst[0].?, dst_stride[0]);
+}
+
+pub fn planarCopy(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+) void {
+    for (0..3) |plane| {
+        if (dst[plane] == null) continue;
+        const length = if (plane == 0) c.src_w else ctx_mod.ceilRshift(c.src_w, c.chr_dst_h_sub);
+        const height = if (plane == 0) c.src_h else ctx_mod.ceilRshift(c.src_h, c.chr_dst_v_sub);
+        if (src[plane] == null or (plane == 1 and src[2] == null)) {
+            fillPlane(dst[plane].?, dst_stride[plane], length, height, 128);
+        } else {
+            copyPlane(src[plane].?, src_stride[plane], height, length, dst[plane].?, dst_stride[plane]);
+        }
+    }
+}
