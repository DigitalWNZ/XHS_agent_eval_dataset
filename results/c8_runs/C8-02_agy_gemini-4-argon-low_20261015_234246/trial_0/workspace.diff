+fn yuv2rgb1Template(
+    c: *const SwsContext,
+    buf0: [*]const i16,
+    ubuf0: [*]const i16,
+    ubuf1: [*]const i16,
+    vbuf0: [*]const i16,
+    vbuf1: [*]const i16,
+    abuf0: ?[*]const i16,
+    dest: [*]u8,
+    dst_w: usize,
+    uvalpha: i32,
+    comptime dst_fmt: i32,
+    comptime has_alpha: bool,
