+    Y *= @as(i32, c.yuv2rgb_y_coeff);
+    Y += 1 << 21;
+    const R: i32 = @intCast(@as(u32, @bitCast(clipUintp2(Y + V * @as(i32, c.yuv2rgb_v2r_coeff), 30))) >> 22);
+    const G: i32 = @intCast(@as(u32, @bitCast(clipUintp2(Y + V * @as(i32, c.yuv2rgb_v2g_coeff) + U * @as(i32, c.yuv2rgb_u2g_coeff), 30))) >> 22);
