+pub const DEFAULT_YUV2RGB_COEFFS = [4]i32{ 104597, 132201, 25675, 53279 };
+
+pub inline fn clipUint8(a: i32) u8 {
+    if (a & (~@as(i32, 0xFF)) != 0) {
+        return if (a < 0) 0 else 255;
+    }
+    return @intCast(a);
+}
+
+pub inline fn clipUintp2(a: i32, comptime p: u5) i32 {
+    const mask: i32 = (@as(i32, 1) << p) - 1;
+    if (a & ~mask != 0) {
+        return (~a) >> 31 & mask;
+    }
+    return a;
+}
+
+pub inline fn ceilRshift(a: i32, b: u5) i32 {
+    return -((-a) >> b);
+}
+
+pub fn isYUV(fmt: i32) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P or fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+pub fn isPlanarYUV(fmt: i32) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P or fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+pub fn isSemiPlanarYUV(fmt: i32) bool {
+    return fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+pub fn isAnyRGB(fmt: i32) bool {
+    return fmt == PIXFMT_RGB24 or fmt == PIXFMT_BGR24 or fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+pub fn isALPHA(fmt: i32) bool {
+    return fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+pub fn isGray(fmt: i32) bool {
+    return fmt == PIXFMT_GRAY8;
+}
+
+pub fn isPacked(fmt: i32) bool {
+    return isAnyRGB(fmt) or fmt == PIXFMT_GRAY8;
+}
+
+pub fn formatBpp(fmt: i32) i32 {
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => 12,
+        PIXFMT_YUV422P => 16,
+        PIXFMT_YUV444P, PIXFMT_RGB24, PIXFMT_BGR24 => 24,
+        PIXFMT_RGBA, PIXFMT_BGRA => 32,
+        PIXFMT_GRAY8 => 8,
+        else => 0,
+    };
+}
+
+pub fn getChromaSubSample(fmt: i32, h_sub: *u5, v_sub: *u5) void {
+    switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => {
+            h_sub.* = 1;
+            v_sub.* = 1;
+        },
+        PIXFMT_YUV422P => {
+            h_sub.* = 1;
+            v_sub.* = 0;
+        },
+        else => {
+            h_sub.* = 0;
+            v_sub.* = 0;
+        },
+    }
+}
+
+fn roundToInt16(f: i64) i16 {
+    const r: i32 = @intCast((f + (1 << 15)) >> 16);
+    if (r < -0x7FFF) return @bitCast(@as(u16, 0x8000));
+    if (r > 0x7FFF) return 0x7FFF;
+    return @intCast(r);
+}
+
+pub const SwsContext = struct {
+    allocator: std.mem.Allocator,
+    src_w: i32,
+    src_h: i32,
+    src_fmt: i32,
+    dst_w: i32,
+    dst_h: i32,
+    dst_fmt: i32,
+    algo: i32,
+    flags: i32,
+
+    src_bpp: i32,
+    dst_bpp: i32,
+    src_bpc: i32,
+    dst_bpc: i32,
+    src_range: i32,
+    dst_range: i32,
+
+    chr_src_h_sub: u5,
+    chr_src_v_sub: u5,
+    chr_dst_h_sub: u5,
+    chr_dst_v_sub: u5,
+
+    chr_src_w: i32,
+    chr_src_h: i32,
+    chr_dst_w: i32,
+    chr_dst_h: i32,
+
+    lum_x_inc: i32,
+    lum_y_inc: i32,
+    chr_x_inc: i32,
+    chr_y_inc: i32,
+
+    need_alpha: bool,
+    needs_hcscale: bool,
+    unscaled: bool,
+
+    // YUV2RGB tables & coefficients
+    yuv2rgb_y_coeff: i16,
+    yuv2rgb_y_offset: i16,
+    yuv2rgb_v2r_coeff: i16,
+    yuv2rgb_v2g_coeff: i16,
+    yuv2rgb_u2g_coeff: i16,
+    yuv2rgb_u2b_coeff: i16,
+
+    yuv_table: ?[]u8,
+    table_rV: [TABLE_CHROMA_SIZE][*]const u8,
+    table_gU: [TABLE_CHROMA_SIZE][*]const u8,
+    table_bU: [TABLE_CHROMA_SIZE][*]const u8,
+    table_gV: [TABLE_CHROMA_SIZE]i32,
+
+    rgb2yuv_table: [9]i32,
+    pal_rgb: [256]u32,
+    pal_yuv: [256]u32,
+
+    // Scaling filters
+    h_lum_filter: []i16,
+    h_lum_filter_pos: []i32,
+    h_lum_filter_size: i32,
+
+    h_chr_filter: []i16,
+    h_chr_filter_pos: []i32,
+    h_chr_filter_size: i32,
+
+    v_lum_filter: []i16,
+    v_lum_filter_pos: []i32,
+    v_lum_filter_size: i32,
+
+    v_chr_filter: []i16,
+    v_chr_filter_pos: []i32,
+    v_chr_filter_size: i32,
+
+    // Ring buffers for scaled horizontal lines
+    lum_buf_size: usize,
+    chr_buf_size: usize,
+    line_width_alloc: usize,
+    lum_buf: []i16,
+    chr_u_buf: []i16,
+    chr_v_buf: []i16,
+    alp_buf: []i16,
+
+    // Scratch line buffers for input format conversion before hScale
+    conv_lum_line: []i16,
+    conv_chr_u_line: []i16,
+    conv_chr_v_line: []i16,
+    conv_alp_line: []i16,
+
+    pub fn initYuv2RgbTables(self: *SwsContext) !void {
+        const full_range = self.src_range != 0;
+        const is_rgb = self.dst_fmt == PIXFMT_BGRA or self.dst_fmt == PIXFMT_BGR24;
+        const bpp = self.dst_bpp;
+        const yoffs: usize = @intCast((if (full_range) @as(i32, 384) else @as(i32, 326)) + YUVRGB_TABLE_LUMA_HEADROOM);
+
+        var crv: i64 = DEFAULT_YUV2RGB_COEFFS[0];
+        var cbu: i64 = DEFAULT_YUV2RGB_COEFFS[1];
+        var cgu: i64 = -DEFAULT_YUV2RGB_COEFFS[2];
+        var cgv: i64 = -DEFAULT_YUV2RGB_COEFFS[3];
+        var cy: i64 = 1 << 16;
+        var oy: i64 = 0;
+
+        if (!full_range) {
+            cy = @divTrunc(cy * 255, 219);
+            oy = 16 << 16;
+        } else {
+            crv = @divTrunc(crv * 224, 255);
+            cbu = @divTrunc(cbu * 224, 255);
+            cgu = @divTrunc(cgu * 224, 255);
+            cgv = @divTrunc(cgv * 224, 255);
+        }
+
+        const contrast: i64 = 1 << 16;
+        const saturation: i64 = 1 << 16;
+        const brightness: i64 = 0;
+
+        cy = (cy * contrast) >> 16;
+        crv = (crv * contrast * saturation) >> 32;
+        cbu = (cbu * contrast * saturation) >> 32;
+        cgu = (cgu * contrast * saturation) >> 32;
+        cgv = (cgv * contrast * saturation) >> 32;
+        oy -= 256 * brightness;
+
+        self.yuv2rgb_y_coeff = roundToInt16(cy * (1 << 13));
+        self.yuv2rgb_y_offset = roundToInt16(oy * (1 << 9));
+        self.yuv2rgb_v2r_coeff = roundToInt16(crv * (1 << 13));
+        self.yuv2rgb_v2g_coeff = roundToInt16(cgv * (1 << 13));
+        self.yuv2rgb_u2g_coeff = roundToInt16(cgu * (1 << 13));
+        self.yuv2rgb_u2b_coeff = roundToInt16(cbu * (1 << 13));
+
+        const max_cy = if (cy > 1) cy else 1;
+        crv = @divTrunc((crv * (1 << 16)) + 0x8000, max_cy);
+        cbu = @divTrunc((cbu * (1 << 16)) + 0x8000, max_cy);
+        cgu = @divTrunc((cgu * (1 << 16)) + 0x8000, max_cy);
+        cgv = @divTrunc((cgv * (1 << 16)) + 0x8000, max_cy);
+
+        if (bpp == 24) {
+            const tab = try self.allocator.alloc(u8, TABLE_PLANE_SIZE);
+            self.yuv_table = tab;
+            var yb: i64 = -(384 << 16) - YUVRGB_TABLE_LUMA_HEADROOM * cy - oy;
+            for (0..TABLE_PLANE_SIZE) |i| {
+                tab[i] = clipUint8(@intCast((yb + 0x8000) >> 16));
+                yb += cy;
+            }
+            fillTable(&self.table_rV, 1, crv, tab.ptr + yoffs);
+            fillTable(&self.table_gU, 1, cgu, tab.ptr + yoffs);
+            fillTable(&self.table_bU, 1, cbu, tab.ptr + yoffs);
+            fillGvTable(&self.table_gV, 1, cgv);
+        } else if (bpp == 32) {
+            const rbase: u5 = if (is_rgb) 16 else 0;
+            const gbase: u5 = 8;
+            const bbase: u5 = if (is_rgb) 0 else 16;
+            const need_alpha = isALPHA(self.src_fmt);
+            const abase: u5 = 24;
+            const tab = try self.allocator.alloc(u8, TABLE_PLANE_SIZE * 3 * 4);
+            self.yuv_table = tab;
+            var y_table32: [*]u32 = @ptrCast(@alignCast(tab.ptr));
+            var yb: i64 = -(384 << 16) - YUVRGB_TABLE_LUMA_HEADROOM * cy - oy;
+            for (0..TABLE_PLANE_SIZE) |i| {
+                const yval: u32 = clipUint8(@intCast((yb + 0x8000) >> 16));
+                y_table32[i] = (yval << rbase) + (if (need_alpha) @as(u32, 0) else (@as(u32, 255) << abase));
+                y_table32[i + TABLE_PLANE_SIZE] = yval << gbase;
+                y_table32[i + 2 * TABLE_PLANE_SIZE] = yval << bbase;
+                yb += cy;
+            }
+            fillTable(&self.table_rV, 4, crv, @ptrCast(y_table32 + yoffs));
+            fillTable(&self.table_gU, 4, cgu, @ptrCast(y_table32 + yoffs + TABLE_PLANE_SIZE));
+            fillTable(&self.table_bU, 4, cbu, @ptrCast(y_table32 + yoffs + 2 * TABLE_PLANE_SIZE));
+            fillGvTable(&self.table_gV, 4, cgv);
+        }
+    }
+};
+
+fn fillTable(table: *[TABLE_CHROMA_SIZE][*]const u8, elemsize: isize, inc: i64, y_tab: [*]const u8) void {
+    const off: isize = -elemsize * @as(isize, @intCast(inc >> 9));
+    const base_addr = @intFromPtr(y_tab);
+    for (0..TABLE_CHROMA_SIZE) |i| {
+        const idx: i32 = @as(i32, @intCast(i)) - YUVRGB_TABLE_HEADROOM;
+        const cb: i64 = @as(i64, clipUint8(idx)) * inc;
+        const delta: isize = off + elemsize * @as(isize, @intCast(cb >> 16));
+        const final_addr: usize = @bitCast(@as(isize, @bitCast(base_addr)) + delta);
+        table[i] = @ptrFromInt(final_addr);
+    }
+}
+
+fn fillGvTable(table: *[TABLE_CHROMA_SIZE]i32, elemsize: i32, inc: i64) void {
+    const off: i32 = -@as(i32, @intCast(inc >> 9));
+    for (0..TABLE_CHROMA_SIZE) |i| {
+        const idx: i32 = @as(i32, @intCast(i)) - YUVRGB_TABLE_HEADROOM;
+        const cb: i64 = @as(i64, clipUint8(idx)) * inc;
+        table[i] = elemsize * (off + @as(i32, @intCast(cb >> 16)));
+    }
+}
diff --git a/swscale-impl/src/filter.zig b/swscale-impl/src/filter.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/filter.zig
@@ -0,0 +1,264 @@
+const std = @import("std");
+const ctx_mod = @import("context.zig");
+const SwsContext = ctx_mod.SwsContext;
+
+const SWS_MAX_REDUCE_CUTOFF = 0.002;
+
+inline fn avLog2(v: u32) u32 {
+    if (v == 0) return 0;
+    return 31 - @clz(v);
+}
+
+inline fn roundedDiv(a: i64, b: i64) i64 {
+    if (a > 0) {
+        return @divTrunc(a + (b >> 1), b);
+    } else {
+        return @divTrunc(a - (b >> 1), b);
+    }
+}
+
+pub fn getLocalPos(chr_subsample: u5, pos_in: i32) i32 {
+    var pos = pos_in;
+    if (pos == -1 or pos <= -513) {
+        pos = (@as(i32, 128) << chr_subsample) - 128;
+    }
+    pos += 128;
+    return pos >> chr_subsample;
+}
+
+pub fn initFilter(
+    allocator: std.mem.Allocator,
+    out_filter: *[]i16,
+    out_filter_pos: *[]i32,
+    out_filter_size: *i32,
+    x_inc: i32,
+    src_w: i32,
+    dst_w: i32,
+    filter_align: i32,
+    one: i64,
+    flags: i32,
+    src_pos: i32,
+    dst_pos: i32,
+) !void {
+    const dst_w_u: usize = @intCast(dst_w);
+    const ratio: u32 = @intCast(@divTrunc(src_w, dst_w));
+    const log2_ratio: u6 = @intCast(@min(avLog2(ratio), 8));
+    const shift_fone: u6 = 54 - log2_ratio;
+    const fone: i64 = @as(i64, 1) << shift_fone;
+
+    var filter_pos = try allocator.alloc(i32, dst_w_u + 3);
+    errdefer allocator.free(filter_pos);
+    @memset(filter_pos, 0);
+
+    var filter_size: i32 = 0;
+    var filter: []i64 = &[_]i64{};
+
+    if (@abs(x_inc - 0x10000) < 10 and src_pos == dst_pos) {
+        filter_size = 1;
+        filter = try allocator.alloc(i64, dst_w_u * @as(usize, @intCast(filter_size)));
+        @memset(filter, 0);
+        for (0..dst_w_u) |i| {
+            filter[i * @as(usize, @intCast(filter_size))] = fone;
+            filter_pos[i] = @intCast(i);
+        }
+    } else if ((flags & ctx_mod.SWS_POINT) != 0) {
+        filter_size = 1;
+        filter = try allocator.alloc(i64, dst_w_u * @as(usize, @intCast(filter_size)));
+        var x_dst_in_src: i64 = ((@as(i64, dst_pos) * @as(i64, x_inc)) >> 8) - ((@as(i64, src_pos) * 0x8000) >> 7);
+        for (0..dst_w_u) |i| {
+            const xx: i32 = @intCast((x_dst_in_src - (@as(i64, filter_size - 1) << 15) + (1 << 15)) >> 16);
+            filter_pos[i] = xx;
+            filter[i] = fone;
+            x_dst_in_src += x_inc;
+        }
+    } else {
+        var x_dst_in_src: i64 = 0;
+        var size_factor: i32 = -1;
+        if ((flags & ctx_mod.SWS_BICUBIC) != 0) {
+            size_factor = 4;
+        } else if ((flags & ctx_mod.SWS_BILINEAR) != 0) {
+            size_factor = 2;
+        } else {
+            return error.InvalidFlags;
+        }
+
+        if (x_inc <= (1 << 16)) {
+            filter_size = 1 + size_factor;
+        } else {
+            filter_size = 1 + @divTrunc(size_factor * src_w + dst_w - 1, dst_w);
+        }
+        filter_size = @min(filter_size, src_w - 2);
+        filter_size = @max(filter_size, 1);
+
+        const fs_u: usize = @intCast(filter_size);
+        filter = try allocator.alloc(i64, dst_w_u * fs_u);
+        x_dst_in_src = ((@as(i64, dst_pos) * @as(i64, x_inc)) >> 7) - ((@as(i64, src_pos) * 0x10000) >> 7);
+        for (0..dst_w_u) |i| {
+            var xx: i32 = @intCast(@divTrunc(x_dst_in_src - @as(i64, filter_size - 2) * (1 << 16), 1 << 17));
+            filter_pos[i] = xx;
+            for (0..fs_u) |j| {
+                const diff: i64 = @intCast(@abs((@as(i64, xx) * (1 << 17)) - x_dst_in_src));
+                var d: i64 = diff << 13;
+                if (x_inc > (1 << 16)) {
+                    d = @divTrunc(d * dst_w, src_w);
+                }
+                var coeff: i64 = 0;
+                if ((flags & ctx_mod.SWS_BICUBIC) != 0) {
+                    const B: i64 = 0;
+                    const C: i64 = @intFromFloat(0.6 * @as(f64, 1 << 24)); // 10066329
+                    if (d >= (@as(i64, 1) << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (@as(i64, 1) << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else if ((flags & ctx_mod.SWS_BILINEAR) != 0) {
+                    coeff = (@as(i64, 1) << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * fs_u + j] = coeff;
+                xx += 1;
+            }
+            x_dst_in_src += 2 * @as(i64, x_inc);
+        }
+    }
+
+    const filter2_size: i32 = filter_size;
+    const f2s_u: usize = @intCast(filter2_size);
+    var filter2 = filter; // since srcFilter and dstFilter are null, filter2 is identical to filter
+    defer allocator.free(filter2);
+
+    var min_filter_size: i32 = 0;
+    const cutoff_limit: i64 = @intFromFloat(SWS_MAX_REDUCE_CUTOFF * @as(f64, @floatFromInt(fone)));
+    {
+        var i_signed: i32 = dst_w - 1;
+        while (i_signed >= 0) : (i_signed -= 1) {
+            const i: usize = @intCast(i_signed);
+            var min: i32 = filter2_size;
+            var cut_off: i64 = 0;
+
+            for (0..f2s_u) |_| {
+                cut_off += @intCast(@abs(filter2[i * f2s_u]));
+                if (cut_off > cutoff_limit) break;
+                if (i_signed < dst_w - 1 and filter_pos[i] >= filter_pos[i + 1]) break;
+                for (1..f2s_u) |k| {
+                    filter2[i * f2s_u + k - 1] = filter2[i * f2s_u + k];
+                }
+                filter2[i * f2s_u + f2s_u - 1] = 0;
+                filter_pos[i] += 1;
+            }
+
+            cut_off = 0;
+            var j_signed: i32 = filter2_size - 1;
+            while (j_signed > 0) : (j_signed -= 1) {
+                const j: usize = @intCast(j_signed);
+                cut_off += @intCast(@abs(filter2[i * f2s_u + j]));
+                if (cut_off > cutoff_limit) break;
+                min -= 1;
+            }
+
+            if (min > min_filter_size) min_filter_size = min;
+        }
+    }
+
+    filter_size = (min_filter_size + (filter_align - 1)) & (~(filter_align - 1));
+    const fs_u: usize = @intCast(filter_size);
+    var filter_reduced = try allocator.alloc(i64, dst_w_u * fs_u);
+    defer allocator.free(filter_reduced);
+    out_filter_size.* = filter_size;
+
+    for (0..dst_w_u) |i| {
+        for (0..fs_u) |j| {
+            if (j >= f2s_u) {
+                filter_reduced[i * fs_u + j] = 0;
+            } else {
+                filter_reduced[i * fs_u + j] = filter2[i * f2s_u + j];
+            }
+        }
+    }
+
+    // fix borders
+    for (0..dst_w_u) |i| {
+        if (filter_pos[i] < 0) {
+            for (1..fs_u) |j| {
+                const j_i32: i32 = @intCast(j);
+                const left: usize = @intCast(@max(j_i32 + filter_pos[i], 0));
+                filter_reduced[i * fs_u + left] += filter_reduced[i * fs_u + j];
+                filter_reduced[i * fs_u + j] = 0;
+            }
+            filter_pos[i] = 0;
+        }
+
+        if (filter_pos[i] + filter_size > src_w) {
+            const shift: i32 = filter_pos[i] + @min(filter_size - src_w, 0);
+            var acc: i64 = 0;
+
+            var j_signed: i32 = filter_size - 1;
+            while (j_signed >= 0) : (j_signed -= 1) {
+                const j: usize = @intCast(j_signed);
+                if (filter_pos[i] + j_signed >= src_w) {
+                    acc += filter_reduced[i * fs_u + j];
+                    filter_reduced[i * fs_u + j] = 0;
+                }
+            }
+            j_signed = filter_size - 1;
+            while (j_signed >= 0) : (j_signed -= 1) {
+                const j: usize = @intCast(j_signed);
+                if (j_signed < shift) {
+                    filter_reduced[i * fs_u + j] = 0;
+                } else {
+                    const src_idx: usize = @intCast(j_signed - shift);
+                    filter_reduced[i * fs_u + j] = filter_reduced[i * fs_u + src_idx];
+                }
+            }
+
+            filter_pos[i] -= shift;
+            const target_idx: usize = @intCast(src_w - 1 - filter_pos[i]);
+            filter_reduced[i * fs_u + target_idx] += acc;
+        }
+    }
+
+    var final_filter = try allocator.alloc(i16, fs_u * (dst_w_u + 3));
+    @memset(final_filter, 0);
+
+    for (0..dst_w_u) |i| {
+        var err_acc: i64 = 0;
+        var sum: i64 = 0;
+        for (0..fs_u) |j| {
+            sum += filter_reduced[i * fs_u + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        for (0..fs_u) |j| {
+            const v: i64 = filter_reduced[i * fs_u + j] + err_acc;
+            const int_v: i32 = @intCast(roundedDiv(v, sum));
+            final_filter[i * fs_u + j] = @intCast(int_v);
+            err_acc = v - @as(i64, int_v) * sum;
+        }
+    }
+
+    filter_pos[dst_w_u + 0] = filter_pos[dst_w_u - 1];
+    filter_pos[dst_w_u + 1] = filter_pos[dst_w_u - 1];
+    filter_pos[dst_w_u + 2] = filter_pos[dst_w_u - 1];
+    for (0..fs_u) |i| {
+        const k = (dst_w_u - 1) * fs_u + i;
+        final_filter[k + 1 * fs_u] = final_filter[k];
+        final_filter[k + 2 * fs_u] = final_filter[k];
+        final_filter[k + 3 * fs_u] = final_filter[k];
+    }
+
+    out_filter.* = final_filter;
+    out_filter_pos.* = filter_pos;
+}
