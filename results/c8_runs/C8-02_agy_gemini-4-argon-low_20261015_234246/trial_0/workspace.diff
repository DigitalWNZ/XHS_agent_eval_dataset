+const std = @import("std");
+const ctx_mod = @import("context.zig");
+const filter_mod = @import("filter.zig");
+const unscaled_mod = @import("unscaled.zig");
+const scale_mod = @import("scale.zig");
+
+const SwsContext = ctx_mod.SwsContext;
+
+fn checkUnscaled(c: *SwsContext) bool {
+    if (c.src_w != c.dst_w or c.src_h != c.dst_h) return false;
+
+    const s = c.src_fmt;
+    const d = c.dst_fmt;
+
+    // 1. planarToNv12
+    if (s == ctx_mod.PIXFMT_YUV420P and (d == ctx_mod.PIXFMT_NV12 or d == ctx_mod.PIXFMT_NV21)) return true;
+
+    // 2. nv12ToPlanar
+    if ((s == ctx_mod.PIXFMT_NV12 or s == ctx_mod.PIXFMT_NV21) and d == ctx_mod.PIXFMT_YUV420P) return true;
+
+    // 3. yuv2rgb_unscaled (YUV420P or YUV422P -> RGB24/BGR24/RGBA/BGRA)
+    if ((s == ctx_mod.PIXFMT_YUV420P or s == ctx_mod.PIXFMT_YUV422P) and ctx_mod.isAnyRGB(d)) return true;
+
+    // 4. bgr24ToYv12 (ONLY BGR24 -> YUV420P, when width is even)
+    if (s == ctx_mod.PIXFMT_BGR24 and d == ctx_mod.PIXFMT_YUV420P and (c.src_w & 1) == 0) return true;
+
+    // 4b. Fast-path same-size RGB24/BGR24/RGBA/BGRA -> YUV420P/NV12/NV21 (when width & height are even)
+    if (ctx_mod.isAnyRGB(s) and (d == ctx_mod.PIXFMT_YUV420P or d == ctx_mod.PIXFMT_NV12 or d == ctx_mod.PIXFMT_NV21) and
+        (c.src_w & 1) == 0 and (c.src_h & 1) == 0) return true;
+
+    // 5. rgbToRgb / packedCopy
+    if (ctx_mod.isAnyRGB(s) and ctx_mod.isAnyRGB(d)) return true;
+
+    // 6. gray8ToRgb (palToRgbWrapper)
+    if (s == ctx_mod.PIXFMT_GRAY8 and ctx_mod.isAnyRGB(d)) return true;
+
+    // 7. identical formats (planarCopy / packedCopy)
+    if (s == d) return true;
+
+    return false;
+}
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+
+    const allocator = std.heap.c_allocator;
+    const c = allocator.create(SwsContext) catch return null;
+    c.* = SwsContext{
+        .allocator = allocator,
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .flags = 0,
+        .src_bpp = 0,
+        .dst_bpp = 0,
+        .src_bpc = 0,
+        .dst_bpc = 0,
+        .src_range = 0,
+        .dst_range = 0,
+        .chr_src_h_sub = 0,
+        .chr_src_v_sub = 0,
+        .chr_dst_h_sub = 0,
+        .chr_dst_v_sub = 0,
+        .chr_src_w = 0,
+        .chr_src_h = 0,
+        .chr_dst_w = 0,
+        .chr_dst_h = 0,
+        .lum_x_inc = 0,
+        .lum_y_inc = 0,
+        .chr_x_inc = 0,
+        .chr_y_inc = 0,
+        .need_alpha = false,
+        .needs_hcscale = false,
+        .unscaled = false,
+        .yuv2rgb_y_coeff = 0,
+        .yuv2rgb_y_offset = 0,
+        .yuv2rgb_v2r_coeff = 0,
+        .yuv2rgb_v2g_coeff = 0,
+        .yuv2rgb_u2g_coeff = 0,
+        .yuv2rgb_u2b_coeff = 0,
+        .yuv_table = null,
+        .table_rV = undefined,
+        .table_gU = undefined,
+        .table_bU = undefined,
+        .table_gV = undefined,
+        .rgb2yuv_table = undefined,
+        .pal_rgb = undefined,
+        .pal_yuv = undefined,
+        .h_lum_filter = &[_]i16{},
+        .h_lum_filter_pos = &[_]i32{},
+        .h_lum_filter_size = 0,
+        .h_chr_filter = &[_]i16{},
+        .h_chr_filter_pos = &[_]i32{},
+        .h_chr_filter_size = 0,
+        .v_lum_filter = &[_]i16{},
+        .v_lum_filter_pos = &[_]i32{},
+        .v_lum_filter_size = 0,
+        .v_chr_filter = &[_]i16{},
+        .v_chr_filter_pos = &[_]i32{},
+        .v_chr_filter_size = 0,
+        .lum_buf_size = 0,
+        .chr_buf_size = 0,
+        .line_width_alloc = 0,
+        .lum_buf = &[_]i16{},
+        .chr_u_buf = &[_]i16{},
+        .chr_v_buf = &[_]i16{},
+        .alp_buf = &[_]i16{},
+        .conv_lum_line = &[_]i16{},
+        .conv_chr_u_line = &[_]i16{},
+        .conv_chr_v_line = &[_]i16{},
+        .conv_alp_line = &[_]i16{},
+    };
+
+    var flags: i32 = switch (algo) {
+        ctx_mod.ALGO_NEAREST => ctx_mod.SWS_POINT,
+        ctx_mod.ALGO_BILINEAR => ctx_mod.SWS_BILINEAR,
+        ctx_mod.ALGO_BICUBIC => ctx_mod.SWS_BICUBIC,
+        else => ctx_mod.SWS_BILINEAR,
+    };
+
+    c.src_bpp = ctx_mod.formatBpp(src_fmt);
+    c.dst_bpp = ctx_mod.formatBpp(dst_fmt);
+    c.src_bpc = if (ctx_mod.isAnyRGB(src_fmt)) 16 else 8;
+    c.dst_bpc = 8;
+
+    // handle_jpeg logic in FFmpeg:
+    c.src_range = if (src_fmt == ctx_mod.PIXFMT_GRAY8) 1 else 0;
+    c.dst_range = if (dst_fmt == ctx_mod.PIXFMT_GRAY8) 1 else 0;
+    if (ctx_mod.isAnyRGB(src_fmt)) c.src_range = 0;
+    if (ctx_mod.isAnyRGB(dst_fmt)) c.dst_range = 0;
+
+    ctx_mod.getChromaSubSample(src_fmt, &c.chr_src_h_sub, &c.chr_src_v_sub);
+    ctx_mod.getChromaSubSample(dst_fmt, &c.chr_dst_h_sub, &c.chr_dst_v_sub);
+
+    if (ctx_mod.isAnyRGB(dst_fmt) and (flags & ctx_mod.SWS_FULL_CHR_H_INT) == 0) {
+        if ((dst_w & 1) != 0 or (c.chr_src_h_sub == 0 and c.chr_src_v_sub == 0)) {
+            flags |= ctx_mod.SWS_FULL_CHR_H_INT;
+        } else {
+            c.chr_dst_h_sub = 1;
+        }
+    }
+
+    if (ctx_mod.isAnyRGB(src_fmt) and (flags & ctx_mod.SWS_FULL_CHR_H_INP) == 0 and
+        (dst_w >> c.chr_dst_h_sub) <= (src_w >> 1))
+    {
+        c.chr_src_h_sub = 1;
+    }
+
+    c.flags = flags;
+    c.chr_src_w = ctx_mod.ceilRshift(src_w, c.chr_src_h_sub);
+    c.chr_src_h = ctx_mod.ceilRshift(src_h, c.chr_src_v_sub);
+    c.chr_dst_w = ctx_mod.ceilRshift(dst_w, c.chr_dst_h_sub);
+    c.chr_dst_h = ctx_mod.ceilRshift(dst_h, c.chr_dst_v_sub);
+
+    c.need_alpha = ctx_mod.isALPHA(src_fmt) and ctx_mod.isALPHA(dst_fmt);
+    c.needs_hcscale = !ctx_mod.isGray(dst_fmt) and !ctx_mod.isGray(src_fmt);
+
+    c.lum_x_inc = @intCast(@divTrunc((@as(i64, src_w) << 16) + (dst_w >> 1), dst_w));
+    c.lum_y_inc = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+    c.chr_x_inc = @intCast(@divTrunc((@as(i64, c.chr_src_w) << 16) + (c.chr_dst_w >> 1), c.chr_dst_w));
+    c.chr_y_inc = @intCast(@divTrunc((@as(i64, c.chr_src_h) << 16) + (c.chr_dst_h >> 1), c.chr_dst_h));
+
+    // Initialize RGB2YUV table (BT.601 default)
+    c.rgb2yuv_table = .{
+        ctx_mod.RY, ctx_mod.GY, ctx_mod.BY,
+        ctx_mod.RU, ctx_mod.GU, ctx_mod.BU,
+        ctx_mod.RV, ctx_mod.GV, ctx_mod.BV,
+    };
+
+    // Initialize YUV2RGB tables
+    c.initYuv2RgbTables() catch {
+        swscale_destroy(c);
+        return null;
+    };
+
+    c.unscaled = checkUnscaled(c);
+    if (!c.unscaled) {
+        const src_h_chr_pos = filter_mod.getLocalPos(c.chr_src_h_sub, -513);
+        const dst_h_chr_pos = filter_mod.getLocalPos(c.chr_dst_h_sub, -513);
+        const src_v_chr_pos = filter_mod.getLocalPos(c.chr_src_v_sub, -513);
+        const dst_v_chr_pos = filter_mod.getLocalPos(c.chr_dst_v_sub, -513);
+
+        filter_mod.initFilter(
+            allocator,
+            &c.h_lum_filter,
+            &c.h_lum_filter_pos,
+            &c.h_lum_filter_size,
+            c.lum_x_inc,
+            src_w,
+            dst_w,
+            1,
+            1 << 14,
+            flags,
+            filter_mod.getLocalPos(0, 0),
+            filter_mod.getLocalPos(0, 0),
+        ) catch {
+            swscale_destroy(c);
+            return null;
+        };
+
+        filter_mod.initFilter(
+            allocator,
+            &c.h_chr_filter,
+            &c.h_chr_filter_pos,
+            &c.h_chr_filter_size,
+            c.chr_x_inc,
+            c.chr_src_w,
+            c.chr_dst_w,
+            1,
+            1 << 14,
+            flags,
+            src_h_chr_pos,
+            dst_h_chr_pos,
+        ) catch {
+            swscale_destroy(c);
+            return null;
+        };
+
+        filter_mod.initFilter(
+            allocator,
+            &c.v_lum_filter,
+            &c.v_lum_filter_pos,
+            &c.v_lum_filter_size,
+            c.lum_y_inc,
+            src_h,
+            dst_h,
+            1,
+            1 << 12,
+            flags,
+            filter_mod.getLocalPos(0, 0),
+            filter_mod.getLocalPos(0, 0),
+        ) catch {
+            swscale_destroy(c);
+            return null;
+        };
+
+        filter_mod.initFilter(
+            allocator,
+            &c.v_chr_filter,
+            &c.v_chr_filter_pos,
+            &c.v_chr_filter_size,
+            c.chr_y_inc,
+            c.chr_src_h,
+            c.chr_dst_h,
+            1,
+            1 << 12,
+            flags,
+            src_v_chr_pos,
+            dst_v_chr_pos,
+        ) catch {
+            swscale_destroy(c);
+            return null;
+        };
