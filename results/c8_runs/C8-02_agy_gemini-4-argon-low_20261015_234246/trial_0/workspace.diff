+pub fn yuv422ToRgb(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+) void {
+    switch (c.dst_fmt) {
+        ctx_mod.PIXFMT_RGB24 => yuv422ToRgbTemplate(c, src, src_stride, dst, dst_stride, ctx_mod.PIXFMT_RGB24),
+        ctx_mod.PIXFMT_BGR24 => yuv422ToRgbTemplate(c, src, src_stride, dst, dst_stride, ctx_mod.PIXFMT_BGR24),
+        ctx_mod.PIXFMT_RGBA => yuv422ToRgbTemplate(c, src, src_stride, dst, dst_stride, ctx_mod.PIXFMT_RGBA),
+        ctx_mod.PIXFMT_BGRA => yuv422ToRgbTemplate(c, src, src_stride, dst, dst_stride, ctx_mod.PIXFMT_BGRA),
+        else => unreachable,
+    }
+}
+
+fn yuv422ToRgbTemplate(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+    comptime dst_fmt: i32,
+) void {
+    const w_u: usize = @intCast(c.dst_w);
+    const h_u: usize = @intCast(c.src_h);
+    const pairs = w_u >> 1;
+
+    const cy_vec: @Vector(8, i32) = @splat(76309);
+    const crv_vec: @Vector(8, i32) = @splat(113588);
+    const cgu_vec: @Vector(8, i32) = @splat(-27883);
+    const cgv_vec: @Vector(8, i32) = @splat(-57862);
+    const cbu_vec: @Vector(8, i32) = @splat(143574);
+    const base_y_off: i32 = -1187494;
+    const off_r_vec: @Vector(8, i32) = @splat(base_y_off - 221 * 76309);
+    const off_g_vec: @Vector(8, i32) = @splat(base_y_off + (55 + 114) * 76309);
+    const off_b_vec: @Vector(8, i32) = @splat(base_y_off - 280 * 76309);
+    const zero_vec: @Vector(8, i32) = @splat(0);
+    const max255_vec: @Vector(8, i32) = @splat(255);
+    const alpha255: @Vector(8, u8) = @splat(255);
+    const is_bgr = (dst_fmt == ctx_mod.PIXFMT_BGR24 or dst_fmt == ctx_mod.PIXFMT_BGRA);
+    const is_24 = (dst_fmt == ctx_mod.PIXFMT_RGB24 or dst_fmt == ctx_mod.PIXFMT_BGR24);
+
+    for (0..h_u) |y| {
+        const py = ptrAddConst(u8, src[0].?, @as(isize, @intCast(y)) * @as(isize, src_stride[0]));
+        const pu = ptrAddConst(u8, src[1].?, @as(isize, @intCast(y)) * @as(isize, src_stride[1]));
+        const pv = ptrAddConst(u8, src[2].?, @as(isize, @intCast(y)) * @as(isize, src_stride[2]));
+        const dst_row = ptrAdd(u8, dst[0].?, @as(isize, @intCast(y)) * @as(isize, dst_stride[0]));
+
+        var i: usize = 0;
+        while (i + 4 <= pairs) : (i += 4) {
+            const u4_u8: @Vector(4, u8) = pu[i..][0..4].*;
+            const v4_u8: @Vector(4, u8) = pv[i..][0..4].*;
+            const u8_u8: @Vector(8, u8) = @shuffle(u8, u4_u8, u4_u8, @Vector(8, i32){ 0, 0, 1, 1, 2, 2, 3, 3 });
+            const v8_u8: @Vector(8, u8) = @shuffle(u8, v4_u8, v4_u8, @Vector(8, i32){ 0, 0, 1, 1, 2, 2, 3, 3 });
+
+            const u_i32: @Vector(8, i32) = @intCast(u8_u8);
+            const v_i32: @Vector(8, i32) = @intCast(v8_u8);
+
+            const dr: @Vector(8, i32) = ((v_i32 * crv_vec) >> @splat(16)) * cy_vec + off_r_vec;
+            const dg_u: @Vector(8, i32) = (u_i32 * cgu_vec) >> @splat(16);
+            const dg_v: @Vector(8, i32) = (v_i32 * cgv_vec) >> @splat(16);
+            const dg: @Vector(8, i32) = (dg_u + dg_v) * cy_vec + off_g_vec;
+            const db: @Vector(8, i32) = ((u_i32 * cbu_vec) >> @splat(16)) * cy_vec + off_b_vec;
+
+            const y_u8: @Vector(8, u8) = py[2 * i ..][0..8].*;
+            const y_base: @Vector(8, i32) = @as(@Vector(8, i32), @intCast(y_u8)) * cy_vec;
+            const r_i32 = @min(@max((y_base + dr) >> @splat(16), zero_vec), max255_vec);
+            const g_i32 = @min(@max((y_base + dg) >> @splat(16), zero_vec), max255_vec);
+            const b_i32 = @min(@max((y_base + db) >> @splat(16), zero_vec), max255_vec);
+
+            const r_u8: @Vector(8, u8) = @intCast(r_i32);
+            const g_u8: @Vector(8, u8) = @intCast(g_i32);
+            const b_u8: @Vector(8, u8) = @intCast(b_i32);
+
+            if (is_24) {
+                packRgb8Pixels24(r_u8, g_u8, b_u8, dst_row + 6 * i, is_bgr);
+            } else {
+                packRgb8Pixels32(r_u8, g_u8, b_u8, alpha255, dst_row + 8 * i, is_bgr);
+            }
+        }
+
+        while (i < pairs) : (i += 1) {
+            const U: usize = @as(usize, pu[i]) + ctx_mod.YUVRGB_TABLE_HEADROOM;
+            const V: usize = @as(usize, pv[i]) + ctx_mod.YUVRGB_TABLE_HEADROOM;
+            const y0 = py[2 * i + 0];
+            const y1 = py[2 * i + 1];
+
+            if (dst_fmt == ctx_mod.PIXFMT_RGB24) {
+                const r = c.table_rV[V];
+                const g = ptrAddConst(u8, c.table_gU[U], @as(isize, c.table_gV[V]));
+                const b = c.table_bU[U];
+                dst_row[6 * i + 0] = r[y0];
+                dst_row[6 * i + 1] = g[y0];
+                dst_row[6 * i + 2] = b[y0];
+                dst_row[6 * i + 3] = r[y1];
+                dst_row[6 * i + 4] = g[y1];
+                dst_row[6 * i + 5] = b[y1];
+            } else if (dst_fmt == ctx_mod.PIXFMT_BGR24) {
+                const r = c.table_rV[V];
+                const g = ptrAddConst(u8, c.table_gU[U], @as(isize, c.table_gV[V]));
+                const b = c.table_bU[U];
+                dst_row[6 * i + 0] = b[y0];
+                dst_row[6 * i + 1] = g[y0];
+                dst_row[6 * i + 2] = r[y0];
+                dst_row[6 * i + 3] = b[y1];
+                dst_row[6 * i + 4] = g[y1];
+                dst_row[6 * i + 5] = r[y1];
+            } else {
+                const dst32: [*]u32 = @ptrCast(@alignCast(dst_row));
+                const r: [*]const u32 = @ptrCast(@alignCast(c.table_rV[V]));
+                const g_u8 = ptrAddConst(u8, c.table_gU[U], @as(isize, c.table_gV[V]));
+                const g: [*]const u32 = @ptrCast(@alignCast(g_u8));
+                const b: [*]const u32 = @ptrCast(@alignCast(c.table_bU[U]));
+                dst32[2 * i + 0] = r[y0] +% g[y0] +% b[y0];
+                dst32[2 * i + 1] = r[y1] +% g[y1] +% b[y1];
+            }
+        }
+    }
+}
+
+inline fn extractRgb8From24(src_ptr: [*]const u8, comptime is_bgr: bool) struct { r: @Vector(8, i32), g: @Vector(8, i32), b: @Vector(8, i32) } {
+    const v0: @Vector(16, u8) = src_ptr[0..16].*;
+    const v1: @Vector(8, u8) = src_ptr[16..24].*;
+    const v1_pad: @Vector(16, u8) = @shuffle(u8, v1, v1, @Vector(16, i32){ 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7 });
+
+    const c0_u8: @Vector(8, u8) = @shuffle(u8, v0, v1_pad, @Vector(8, i32){ 0, 3, 6, 9, 12, 15, -3, -6 });
+    const c1_u8: @Vector(8, u8) = @shuffle(u8, v0, v1_pad, @Vector(8, i32){ 1, 4, 7, 10, 13, -1, -4, -7 });
+    const c2_u8: @Vector(8, u8) = @shuffle(u8, v0, v1_pad, @Vector(8, i32){ 2, 5, 8, 11, 14, -2, -5, -8 });
+
+    const c0: @Vector(8, i32) = @intCast(c0_u8);
+    const c1: @Vector(8, i32) = @intCast(c1_u8);
+    const c2: @Vector(8, i32) = @intCast(c2_u8);
+
+    if (is_bgr) {
+        return .{ .r = c2, .g = c1, .b = c0 };
+    } else {
+        return .{ .r = c0, .g = c1, .b = c2 };
+    }
+}
+
+pub fn bgr24ToYv12(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+) void {
+    const ry = c.rgb2yuv_table[ctx_mod.RY_IDX];
+    const gy = c.rgb2yuv_table[ctx_mod.GY_IDX];
+    const by = c.rgb2yuv_table[ctx_mod.BY_IDX];
+    const ru = c.rgb2yuv_table[ctx_mod.RU_IDX];
+    const gu = c.rgb2yuv_table[ctx_mod.GU_IDX];
+    const bu = c.rgb2yuv_table[ctx_mod.BU_IDX];
+    const rv = c.rgb2yuv_table[ctx_mod.RV_IDX];
+    const gv = c.rgb2yuv_table[ctx_mod.GV_IDX];
+    const bv = c.rgb2yuv_table[ctx_mod.BV_IDX];
+
+    const ry_vec: @Vector(8, i32) = @splat(ry);
+    const gy_vec: @Vector(8, i32) = @splat(gy);
+    const by_vec: @Vector(8, i32) = @splat(by);
+    const ru4: @Vector(4, i32) = @splat(ru);
+    const gu4: @Vector(4, i32) = @splat(gu);
+    const bu4: @Vector(4, i32) = @splat(bu);
+    const rv4: @Vector(4, i32) = @splat(rv);
+    const gv4: @Vector(4, i32) = @splat(gv);
+    const bv4: @Vector(4, i32) = @splat(bv);
+
+    const chrom_width: usize = @intCast(c.src_w >> 1);
+    const height: usize = @intCast(c.src_h);
+
+    var src1 = src[0].?;
+    var src2 = ptrAddConst(u8, src1, @as(isize, src_stride[0]));
+    var ydst1 = dst[0].?;
+    var ydst2 = ptrAdd(u8, ydst1, @as(isize, dst_stride[0]));
+    var udst = dst[1].?;
+    var vdst = dst[2].?;
+
+    var y: usize = 0;
+    while (y < height) : (y += 2) {
+        var i: usize = 0;
+        while (i + 4 <= chrom_width) : (i += 4) {
+            const rgb1 = extractRgb8From24(src1 + 6 * i, true);
+            const rgb2 = extractRgb8From24(src2 + 6 * i, true);
+
+            const y1_i32 = ((rgb1.r * ry_vec + rgb1.g * gy_vec + rgb1.b * by_vec) >> @splat(ctx_mod.RGB2YUV_SHIFT)) + @as(@Vector(8, i32), @splat(16));
+            const y2_i32 = ((rgb2.r * ry_vec + rgb2.g * gy_vec + rgb2.b * by_vec) >> @splat(ctx_mod.RGB2YUV_SHIFT)) + @as(@Vector(8, i32), @splat(16));
+
+            ydst1[2 * i ..][0..8].* = @as(@Vector(8, u8), @intCast(y1_i32));
+            ydst2[2 * i ..][0..8].* = @as(@Vector(8, u8), @intCast(y2_i32));
+
+            const r_vsum = rgb1.r + rgb2.r;
+            const g_vsum = rgb1.g + rgb2.g;
+            const b_vsum = rgb1.b + rgb2.b;
+
+            const r_even = @shuffle(i32, r_vsum, r_vsum, @Vector(4, i32){ 0, 2, 4, 6 });
+            const r_odd = @shuffle(i32, r_vsum, r_vsum, @Vector(4, i32){ 1, 3, 5, 7 });
+            const rx = (r_even + r_odd) >> @splat(2);
+
+            const g_even = @shuffle(i32, g_vsum, g_vsum, @Vector(4, i32){ 0, 2, 4, 6 });
+            const g_odd = @shuffle(i32, g_vsum, g_vsum, @Vector(4, i32){ 1, 3, 5, 7 });
+            const gx = (g_even + g_odd) >> @splat(2);
+
+            const b_even = @shuffle(i32, b_vsum, b_vsum, @Vector(4, i32){ 0, 2, 4, 6 });
+            const b_odd = @shuffle(i32, b_vsum, b_vsum, @Vector(4, i32){ 1, 3, 5, 7 });
+            const bx = (b_even + b_odd) >> @splat(2);
+
+            const u_i32 = ((ru4 * rx + gu4 * gx + bu4 * bx) >> @splat(ctx_mod.RGB2YUV_SHIFT)) + @as(@Vector(4, i32), @splat(128));
+            const v_i32 = ((rv4 * rx + gv4 * gx + bv4 * bx) >> @splat(ctx_mod.RGB2YUV_SHIFT)) + @as(@Vector(4, i32), @splat(128));
+
+            udst[i..][0..4].* = @as(@Vector(4, u8), @intCast(u_i32));
+            vdst[i..][0..4].* = @as(@Vector(4, u8), @intCast(v_i32));
+        }
+
+        while (i < chrom_width) : (i += 1) {
+            const b11: i32 = src1[6 * i + 0];
+            const g11: i32 = src1[6 * i + 1];
+            const r11: i32 = src1[6 * i + 2];
+            const b12: i32 = src1[6 * i + 3];
+            const g12: i32 = src1[6 * i + 4];
+            const r12: i32 = src1[6 * i + 5];
+            const b21: i32 = src2[6 * i + 0];
+            const g21: i32 = src2[6 * i + 1];
+            const r21: i32 = src2[6 * i + 2];
+            const b22: i32 = src2[6 * i + 3];
+            const g22: i32 = src2[6 * i + 4];
+            const r22: i32 = src2[6 * i + 5];
+
+            const Y11: u8 = @truncate(@as(u32, @bitCast(((ry * r11 + gy * g11 + by * b11) >> ctx_mod.RGB2YUV_SHIFT) + 16)));
+            const Y12: u8 = @truncate(@as(u32, @bitCast(((ry * r12 + gy * g12 + by * b12) >> ctx_mod.RGB2YUV_SHIFT) + 16)));
+            const Y21: u8 = @truncate(@as(u32, @bitCast(((ry * r21 + gy * g21 + by * b21) >> ctx_mod.RGB2YUV_SHIFT) + 16)));
+            const Y22: u8 = @truncate(@as(u32, @bitCast(((ry * r22 + gy * g22 + by * b22) >> ctx_mod.RGB2YUV_SHIFT) + 16)));
+
+            const bx: i32 = (b11 + b12 + b21 + b22) >> 2;
+            const gx: i32 = (g11 + g12 + g21 + g22) >> 2;
+            const rx: i32 = (r11 + r12 + r21 + r22) >> 2;
+
+            const U: u8 = @truncate(@as(u32, @bitCast(((ru * rx + gu * gx + bu * bx) >> ctx_mod.RGB2YUV_SHIFT) + 128)));
+            const V: u8 = @truncate(@as(u32, @bitCast(((rv * rx + gv * gx + bv * bx) >> ctx_mod.RGB2YUV_SHIFT) + 128)));
+
+            ydst1[2 * i + 0] = Y11;
+            ydst1[2 * i + 1] = Y12;
+            ydst2[2 * i + 0] = Y21;
+            ydst2[2 * i + 1] = Y22;
+            udst[i] = U;
+            vdst[i] = V;
+        }
+        src1 = ptrAddConst(u8, src1, 2 * @as(isize, src_stride[0]));
+        src2 = ptrAddConst(u8, src2, 2 * @as(isize, src_stride[0]));
+        ydst1 = ptrAdd(u8, ydst1, 2 * @as(isize, dst_stride[0]));
+        ydst2 = ptrAdd(u8, ydst2, 2 * @as(isize, dst_stride[0]));
+        udst = ptrAdd(u8, udst, @as(isize, dst_stride[1]));
+        vdst = ptrAdd(u8, vdst, @as(isize, dst_stride[2]));
+    }
+}
