+        } else {
+            dest32[2 * i + 0] = r[y1_idx] +% g[y1_idx] +% b[y1_idx];
+            dest32[2 * i + 1] = r[y2_idx] +% g[y2_idx] +% b[y2_idx];
+        }
+    }
