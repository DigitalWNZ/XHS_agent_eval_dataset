+        @memset(c.chr_u_buf, 1 << 14);
+        @memset(c.chr_v_buf, 1 << 14);
+
+        if (c.need_alpha) {
+            c.alp_buf = allocator.alloc(i16, c.lum_buf_size * c.line_width_alloc) catch {
+                swscale_destroy(c);
+                return null;
+            };
+            @memset(c.alp_buf, 0);
+        }
+
+        const src_alloc_w: usize = @intCast(@max(src_w, c.chr_src_w) + 64);
+        c.conv_lum_line = allocator.alloc(i16, src_alloc_w) catch {
+            swscale_destroy(c);
+            return null;
+        };
+        c.conv_chr_u_line = allocator.alloc(i16, src_alloc_w) catch {
+            swscale_destroy(c);
+            return null;
+        };
+        c.conv_chr_v_line = allocator.alloc(i16, src_alloc_w) catch {
+            swscale_destroy(c);
+            return null;
+        };
+        c.conv_alp_line = allocator.alloc(i16, src_alloc_w) catch {
+            swscale_destroy(c);
+            return null;
+        };
+        @memset(c.conv_lum_line, 0);
+        @memset(c.conv_chr_u_line, 0);
+        @memset(c.conv_chr_v_line, 0);
+        @memset(c.conv_alp_line, 0);
+    }
+
+    return c;
+}
+
+export fn swscale_process(
+    ctx_ptr: ?*anyopaque,
+    src_in: [*c]const [*c]const u8,
+    src_stride_in: [*c]const c_int,
+    dst_in: [*c]const [*c]u8,
+    dst_stride_in: [*c]const c_int,
+) c_int {
+    if (ctx_ptr == null) return -1;
+    const c: *SwsContext = @ptrCast(@alignCast(ctx_ptr.?));
+
+    var src: [4]?[*]const u8 = .{ null, null, null, null };
+    var src_stride: [4]i32 = .{ 0, 0, 0, 0 };
+    var dst: [4]?[*]u8 = .{ null, null, null, null };
+    var dst_stride: [4]i32 = .{ 0, 0, 0, 0 };
+
+    for (0..4) |i| {
+        if (src_in[i] != null) src[i] = src_in[i];
+        src_stride[i] = src_stride_in[i];
+        if (dst_in[i] != null) dst[i] = dst_in[i];
+        dst_stride[i] = dst_stride_in[i];
+    }
+
+    if (c.unscaled) {
+        const s = c.src_fmt;
+        const d = c.dst_fmt;
+
+        if (s == d) {
+            if (ctx_mod.isPacked(s)) {
+                unscaled_mod.packedCopy(c, src, src_stride, dst, dst_stride);
+            } else {
+                unscaled_mod.planarCopy(c, src, src_stride, dst, dst_stride);
+            }
+        } else if (s == ctx_mod.PIXFMT_YUV420P and (d == ctx_mod.PIXFMT_NV12 or d == ctx_mod.PIXFMT_NV21)) {
+            unscaled_mod.planarToNv12(c, src, src_stride, dst, dst_stride);
+        } else if ((s == ctx_mod.PIXFMT_NV12 or s == ctx_mod.PIXFMT_NV21) and d == ctx_mod.PIXFMT_YUV420P) {
+            unscaled_mod.nv12ToPlanar(c, src, src_stride, dst, dst_stride);
+        } else if (s == ctx_mod.PIXFMT_YUV420P and ctx_mod.isAnyRGB(d)) {
+            unscaled_mod.yuv420ToRgb(c, src, src_stride, dst, dst_stride);
+        } else if (s == ctx_mod.PIXFMT_YUV422P and ctx_mod.isAnyRGB(d)) {
+            unscaled_mod.yuv422ToRgb(c, src, src_stride, dst, dst_stride);
+        } else if (s == ctx_mod.PIXFMT_BGR24 and d == ctx_mod.PIXFMT_YUV420P) {
+            unscaled_mod.bgr24ToYv12(c, src, src_stride, dst, dst_stride);
+        } else if (ctx_mod.isAnyRGB(s) and (d == ctx_mod.PIXFMT_YUV420P or d == ctx_mod.PIXFMT_NV12 or d == ctx_mod.PIXFMT_NV21)) {
+            unscaled_mod.rgbToYuv420OrNv12Unscaled(c, src, src_stride, dst, dst_stride);
+        } else if (ctx_mod.isAnyRGB(s) and ctx_mod.isAnyRGB(d)) {
+            unscaled_mod.rgbToRgb(c, src, src_stride, dst, dst_stride);
+        } else if (s == ctx_mod.PIXFMT_GRAY8 and ctx_mod.isAnyRGB(d)) {
+            unscaled_mod.gray8ToRgb(c, src, src_stride, dst, dst_stride);
+        }
+        return 0;
+    }
+
+    scale_mod.swscaleGeneral(c, src, src_stride, dst, dst_stride);
+    return 0;
+}
+
+export fn swscale_destroy(ctx_ptr: ?*anyopaque) void {
+    if (ctx_ptr == null) return;
+    const c: *SwsContext = @ptrCast(@alignCast(ctx_ptr.?));
+    const allocator = c.allocator;
+
+    if (c.yuv_table) |t| allocator.free(t);
+    if (c.h_lum_filter.len > 0) allocator.free(c.h_lum_filter);
+    if (c.h_lum_filter_pos.len > 0) allocator.free(c.h_lum_filter_pos);
+    if (c.h_chr_filter.len > 0) allocator.free(c.h_chr_filter);
+    if (c.h_chr_filter_pos.len > 0) allocator.free(c.h_chr_filter_pos);
+    if (c.v_lum_filter.len > 0) allocator.free(c.v_lum_filter);
+    if (c.v_lum_filter_pos.len > 0) allocator.free(c.v_lum_filter_pos);
+    if (c.v_chr_filter.len > 0) allocator.free(c.v_chr_filter);
+    if (c.v_chr_filter_pos.len > 0) allocator.free(c.v_chr_filter_pos);
+
+    if (c.lum_buf.len > 0) allocator.free(c.lum_buf);
+    if (c.chr_u_buf.len > 0) allocator.free(c.chr_u_buf);
+    if (c.chr_v_buf.len > 0) allocator.free(c.chr_v_buf);
+    if (c.alp_buf.len > 0) allocator.free(c.alp_buf);
+
+    if (c.conv_lum_line.len > 0) allocator.free(c.conv_lum_line);
+    if (c.conv_chr_u_line.len > 0) allocator.free(c.conv_chr_u_line);
+    if (c.conv_chr_v_line.len > 0) allocator.free(c.conv_chr_v_line);
+    if (c.conv_alp_line.len > 0) allocator.free(c.conv_alp_line);
+
+    allocator.destroy(c);
+}
diff --git a/swscale-impl/src/scale.zig b/swscale-impl/src/scale.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/scale.zig
@@ -0,0 +1,932 @@
+const std = @import("std");
+const ctx_mod = @import("context.zig");
+const SwsContext = ctx_mod.SwsContext;
+const clipUint8 = ctx_mod.clipUint8;
+const clipUintp2 = ctx_mod.clipUintp2;
+
+inline fn ptrAdd(comptime T: type, ptr: [*]T, offset_bytes: isize) [*]T {
+    return @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(ptr))) + offset_bytes)));
+}
+
+inline fn ptrAddConst(comptime T: type, ptr: [*]const T, offset_bytes: isize) [*]const T {
+    return @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(ptr))) + offset_bytes)));
+}
+
+// ============================================================================
+// Input conversion functions (matching libswscale/input.c)
+// ============================================================================
+
+fn rgbToY(dst_u16: [*]u16, src: [*]const u8, width: usize, fmt: i32, table: *const [9]i32) void {
+    const ry = table[ctx_mod.RY_IDX];
+    const gy = table[ctx_mod.GY_IDX];
+    const by = table[ctx_mod.BY_IDX];
+    const exact_offset: i32 = 0x80100;
+
+    switch (fmt) {
+        ctx_mod.PIXFMT_RGB24 => {
+            for (0..width) |i| {
+                const r: i32 = src[3 * i + 0];
+                const g: i32 = src[3 * i + 1];
+                const b: i32 = src[3 * i + 2];
+                dst_u16[i] = @intCast((ry * r + gy * g + by * b + exact_offset) >> 9);
+            }
+        },
+        ctx_mod.PIXFMT_BGR24 => {
+            for (0..width) |i| {
+                const b: i32 = src[3 * i + 0];
+                const g: i32 = src[3 * i + 1];
+                const r: i32 = src[3 * i + 2];
+                dst_u16[i] = @intCast((ry * r + gy * g + by * b + exact_offset) >> 9);
+            }
+        },
+        ctx_mod.PIXFMT_RGBA => {
+            for (0..width) |i| {
+                const r: i32 = src[4 * i + 0];
+                const g: i32 = src[4 * i + 1];
+                const b: i32 = src[4 * i + 2];
+                dst_u16[i] = @intCast((ry * r + gy * g + by * b + exact_offset) >> 9);
+            }
+        },
+        ctx_mod.PIXFMT_BGRA => {
+            for (0..width) |i| {
+                const b: i32 = src[4 * i + 0];
+                const g: i32 = src[4 * i + 1];
+                const r: i32 = src[4 * i + 2];
+                dst_u16[i] = @intCast((ry * r + gy * g + by * b + exact_offset) >> 9);
+            }
+        },
+        else => unreachable,
+    }
