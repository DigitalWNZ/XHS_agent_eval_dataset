+
+    switch (dst_fmt) {
+        ctx_mod.PIXFMT_RGB24 => {
+            dest[3 * i + 0] = @intCast(R);
+            dest[3 * i + 1] = @intCast(G);
+            dest[3 * i + 2] = @intCast(B);
+        },
+        ctx_mod.PIXFMT_BGR24 => {
+            dest[3 * i + 0] = @intCast(B);
+            dest[3 * i + 1] = @intCast(G);
+            dest[3 * i + 2] = @intCast(R);
+        },
+        ctx_mod.PIXFMT_RGBA => {
+            dest[4 * i + 0] = @intCast(R);
+            dest[4 * i + 1] = @intCast(G);
+            dest[4 * i + 2] = @intCast(B);
+            dest[4 * i + 3] = if (has_alpha) A else 255;
+        },
+        ctx_mod.PIXFMT_BGRA => {
+            dest[4 * i + 0] = @intCast(B);
+            dest[4 * i + 1] = @intCast(G);
+            dest[4 * i + 2] = @intCast(R);
+            dest[4 * i + 3] = if (has_alpha) A else 255;
+        },
+        else => unreachable,
+    }
+}
