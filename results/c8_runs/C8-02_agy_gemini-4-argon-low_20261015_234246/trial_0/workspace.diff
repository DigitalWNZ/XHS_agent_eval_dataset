+            const val: i32 = @intCast((@as(i64, src_u16[src_pos]) * @as(i64, filter[i])) >> sh);
+            dst[i] = @intCast(@min(val, (1 << 15) - 1));
+        }
+    } else {
+        for (0..dst_w) |i| {
+            const src_pos: usize = @intCast(filter_pos[i]);
+            var val: i64 = 0;
+            for (0..filter_size) |j| {
+                val += @as(i64, src_u16[src_pos + j]) * @as(i64, filter[i * filter_size + j]);
