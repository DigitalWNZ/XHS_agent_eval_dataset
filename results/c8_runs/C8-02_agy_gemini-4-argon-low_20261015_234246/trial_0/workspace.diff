+inline fn yuv2rgbWriteFull(
+    c: *const SwsContext,
+    dest: [*]u8,
+    i: usize,
+    Y_in: i32,
+    A: u8,
+    U: i32,
+    V: i32,
+    comptime dst_fmt: i32,
+    comptime has_alpha: bool,
