+        const r = c.table_rV[V];
+        const g = ptrAddConst(u8, c.table_gU[U], @as(isize, c.table_gV[V]));
+        const b = c.table_bU[U];
+        dest[6 * i + 0] = r[y1_idx];
+        dest[6 * i + 1] = g[y1_idx];
+        dest[6 * i + 2] = b[y1_idx];
+        dest[6 * i + 3] = r[y2_idx];
+        dest[6 * i + 4] = g[y2_idx];
+        dest[6 * i + 5] = b[y2_idx];
+    } else if (dst_fmt == ctx_mod.PIXFMT_BGR24) {
+        const r = c.table_rV[V];
+        const g = ptrAddConst(u8, c.table_gU[U], @as(isize, c.table_gV[V]));
+        const b = c.table_bU[U];
+        dest[6 * i + 0] = b[y1_idx];
+        dest[6 * i + 1] = g[y1_idx];
+        dest[6 * i + 2] = r[y1_idx];
+        dest[6 * i + 3] = b[y2_idx];
+        dest[6 * i + 4] = g[y2_idx];
+        dest[6 * i + 5] = r[y2_idx];
+    } else {
+        const dest32: [*]u32 = @ptrCast(@alignCast(dest));
+        const r: [*]const u32 = @ptrCast(@alignCast(c.table_rV[V]));
