+inline fn yuv2rgbWritePair(
+    c: *const SwsContext,
+    dest: [*]u8,
+    i: usize,
+    Y1: i32,
+    Y2: i32,
+    U_in: i32,
+    V_in: i32,
+    A1: u8,
+    A2: u8,
+    comptime dst_fmt: i32,
+    comptime has_alpha: bool,
