+            const U: i32 = (@as(i32, ubuf0[i]) + @as(i32, ubuf1[i]) - (128 << 8)) * 2;
+            const V: i32 = (@as(i32, vbuf0[i]) + @as(i32, vbuf1[i]) - (128 << 8)) * 2;
+            const A: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[i]) + 64) >> 7) else 255;
