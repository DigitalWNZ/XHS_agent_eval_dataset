+            const Y1: i32 = (@as(i32, buf0[2 * i + 0]) + 64) >> 7;
+            const Y2: i32 = (@as(i32, buf0[2 * i + 1]) + 64) >> 7;
+            const U: i32 = (@as(i32, ubuf0[i]) + 64) >> 7;
+            const V: i32 = (@as(i32, vbuf0[i]) + 64) >> 7;
+            const A1: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[2 * i + 0]) + 64) >> 7) else 255;
+            const A2: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[2 * i + 1]) + 64) >> 7) else 255;
+            yuv2rgbWritePair(c, dest, i, Y1, Y2, U, V, A1, A2, dst_fmt, has_alpha);
+        }
+    } else {
+        for (0..pairs) |i| {
+            const Y1: i32 = (@as(i32, buf0[2 * i + 0]) + 64) >> 7;
+            const Y2: i32 = (@as(i32, buf0[2 * i + 1]) + 64) >> 7;
+            const U: i32 = (@as(i32, ubuf0[i]) + @as(i32, ubuf1[i]) + 128) >> 8;
+            const V: i32 = (@as(i32, vbuf0[i]) + @as(i32, vbuf1[i]) + 128) >> 8;
+            const A1: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[2 * i + 0]) + 64) >> 7) else 255;
+            const A2: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[2 * i + 1]) + 64) >> 7) else 255;
+            yuv2rgbWritePair(c, dest, i, Y1, Y2, U, V, A1, A2, dst_fmt, has_alpha);
+        }
+    }
+}
+
+fn yuv2rgb2Template(
+    c: *const SwsContext,
+    buf0: [*]const i16,
+    buf1: [*]const i16,
+    ubuf0: [*]const i16,
+    ubuf1: [*]const i16,
+    vbuf0: [*]const i16,
+    vbuf1: [*]const i16,
+    abuf0: ?[*]const i16,
+    abuf1: ?[*]const i16,
+    dest: [*]u8,
+    dst_w: usize,
+    yalpha: i32,
+    uvalpha: i32,
+    comptime dst_fmt: i32,
+    comptime has_alpha: bool,
+) void {
+    const yalpha1: i32 = 4096 - yalpha;
+    const uvalpha1: i32 = 4096 - uvalpha;
+    const pairs = (dst_w + 1) >> 1;
+    for (0..pairs) |i| {
+        const Y1: i32 = (@as(i32, buf0[2 * i + 0]) * yalpha1 + @as(i32, buf1[2 * i + 0]) * yalpha + (1 << 18)) >> 19;
+        const Y2: i32 = (@as(i32, buf0[2 * i + 1]) * yalpha1 + @as(i32, buf1[2 * i + 1]) * yalpha + (1 << 18)) >> 19;
+        const U: i32 = (@as(i32, ubuf0[i]) * uvalpha1 + @as(i32, ubuf1[i]) * uvalpha + (1 << 18)) >> 19;
+        const V: i32 = (@as(i32, vbuf0[i]) * uvalpha1 + @as(i32, vbuf1[i]) * uvalpha + (1 << 18)) >> 19;
+        const A1: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[2 * i + 0]) * yalpha1 + @as(i32, abuf1.?[2 * i + 0]) * yalpha + (1 << 18)) >> 19) else 255;
+        const A2: u8 = if (has_alpha) clipUint8((@as(i32, abuf0.?[2 * i + 1]) * yalpha1 + @as(i32, abuf1.?[2 * i + 1]) * yalpha + (1 << 18)) >> 19) else 255;
+        yuv2rgbWritePair(c, dest, i, Y1, Y2, U, V, A1, A2, dst_fmt, has_alpha);
+    }
+}
+
+fn yuv2rgbXTemplate(
+    c: *const SwsContext,
+    lum_filter: [*]const i16,
+    lum_src: []const [*]const i16,
+    lum_filter_size: usize,
+    chr_filter: [*]const i16,
+    chr_u_src: []const [*]const i16,
+    chr_v_src: []const [*]const i16,
+    chr_filter_size: usize,
+    alp_src: ?[]const [*]const i16,
+    dest: [*]u8,
+    dst_w: usize,
+    comptime dst_fmt: i32,
+    comptime has_alpha: bool,
+) void {
+    const pairs = (dst_w + 1) >> 1;
+    for (0..pairs) |i| {
+        var Y1: i32 = 1 << 18;
+        var Y2: i32 = 1 << 18;
+        var U: i32 = 1 << 18;
+        var V: i32 = 1 << 18;
+        var A1_acc: i32 = 1 << 18;
+        var A2_acc: i32 = 1 << 18;
+
+        for (0..lum_filter_size) |j| {
+            Y1 += @as(i32, lum_src[j][2 * i + 0]) * @as(i32, lum_filter[j]);
+            Y2 += @as(i32, lum_src[j][2 * i + 1]) * @as(i32, lum_filter[j]);
+            if (has_alpha) {
+                A1_acc += @as(i32, alp_src.?[j][2 * i + 0]) * @as(i32, lum_filter[j]);
+                A2_acc += @as(i32, alp_src.?[j][2 * i + 1]) * @as(i32, lum_filter[j]);
+            }
+        }
+        for (0..chr_filter_size) |j| {
+            U += @as(i32, chr_u_src[j][i]) * @as(i32, chr_filter[j]);
+            V += @as(i32, chr_v_src[j][i]) * @as(i32, chr_filter[j]);
+        }
+        Y1 >>= 19;
+        Y2 >>= 19;
+        U >>= 19;
+        V >>= 19;
+        const A1: u8 = if (has_alpha) clipUint8(A1_acc >> 19) else 255;
+        const A2: u8 = if (has_alpha) clipUint8(A2_acc >> 19) else 255;
+        yuv2rgbWritePair(c, dest, i, Y1, Y2, U, V, A1, A2, dst_fmt, has_alpha);
+    }
+}
+
+// ============================================================================
+// Main general scaling pipeline (matching swscale() in libswscale/swscale.c)
+// ============================================================================
+
+fn scaleLineLum(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    y: i32,
+    lum_dst: [*]i16,
+    alp_dst: ?[*]i16,
+) void {
+    const src_w_u: usize = @intCast(c.src_w);
+    const dst_w_u: usize = @intCast(c.dst_w);
+    const fs_u: usize = @intCast(c.h_lum_filter_size);
+    const row_ptr = ptrAddConst(u8, src[0].?, @as(isize, y) * @as(isize, src_stride[0]));
+
+    if (ctx_mod.isAnyRGB(c.src_fmt)) {
+        const conv_u16: [*]u16 = @ptrCast(c.conv_lum_line.ptr);
+        rgbToY(conv_u16, row_ptr, src_w_u, c.src_fmt, &c.rgb2yuv_table);
+        hScale16To15(lum_dst, dst_w_u, conv_u16, c.h_lum_filter, c.h_lum_filter_pos, fs_u, 13);
+
+        if (alp_dst) |adst| {
+            rgbaToA(c.conv_alp_line.ptr, row_ptr, src_w_u);
+            const alp_u16: [*]const u16 = @ptrCast(c.conv_alp_line.ptr);
+            hScale16To15(adst, dst_w_u, alp_u16, c.h_lum_filter, c.h_lum_filter_pos, fs_u, 13);
+        }
+    } else {
+        // YUV420P, YUV422P, YUV444P, NV12, NV21, GRAY8 have 8-bit planar luma
+        hScale8To15(lum_dst, dst_w_u, row_ptr, c.h_lum_filter, c.h_lum_filter_pos, fs_u);
+    }
+
+    if (c.src_range != c.dst_range and !ctx_mod.isAnyRGB(c.dst_fmt)) {
+        if (c.dst_range != 0) {
+            lumRangeToJpeg(lum_dst, dst_w_u);
+        } else {
+            lumRangeFromJpeg(lum_dst, dst_w_u);
+        }
+    }
+}
+
+fn scaleLineChr(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    chr_y: i32,
+    u_dst: [*]i16,
+    v_dst: [*]i16,
+) void {
+    const chr_src_w_u: usize = @intCast(c.chr_src_w);
+    const chr_dst_w_u: usize = @intCast(c.chr_dst_w);
+    const fs_u: usize = @intCast(c.h_chr_filter_size);
+
+    if (ctx_mod.isAnyRGB(c.src_fmt)) {
+        const row_ptr = ptrAddConst(u8, src[0].?, @as(isize, chr_y) * @as(isize, src_stride[0]));
+        const conv_u: [*]u16 = @ptrCast(c.conv_chr_u_line.ptr);
+        const conv_v: [*]u16 = @ptrCast(c.conv_chr_v_line.ptr);
+        if (c.chr_src_h_sub > 0) {
+            rgbToUVHalf(conv_u, conv_v, row_ptr, chr_src_w_u, c.src_fmt, &c.rgb2yuv_table);
+        } else {
+            rgbToUVFull(conv_u, conv_v, row_ptr, chr_src_w_u, c.src_fmt, &c.rgb2yuv_table);
+        }
+        hScale16To15(u_dst, chr_dst_w_u, conv_u, c.h_chr_filter, c.h_chr_filter_pos, fs_u, 13);
+        hScale16To15(v_dst, chr_dst_w_u, conv_v, c.h_chr_filter, c.h_chr_filter_pos, fs_u, 13);
+    } else if (c.src_fmt == ctx_mod.PIXFMT_NV12 or c.src_fmt == ctx_mod.PIXFMT_NV21) {
+        const row_ptr = ptrAddConst(u8, src[1].?, @as(isize, chr_y) * @as(isize, src_stride[1]));
+        const conv_u: [*]u8 = @ptrCast(c.conv_chr_u_line.ptr);
+        const conv_v: [*]u8 = @ptrCast(c.conv_chr_v_line.ptr);
+        if (c.src_fmt == ctx_mod.PIXFMT_NV12) {
+            nvXXtoUV(conv_u, conv_v, row_ptr, chr_src_w_u);
+        } else {
+            nvXXtoUV(conv_v, conv_u, row_ptr, chr_src_w_u);
+        }
+        hScale8To15(u_dst, chr_dst_w_u, conv_u, c.h_chr_filter, c.h_chr_filter_pos, fs_u);
+        hScale8To15(v_dst, chr_dst_w_u, conv_v, c.h_chr_filter, c.h_chr_filter_pos, fs_u);
+    } else {
+        const u_row = ptrAddConst(u8, src[1].?, @as(isize, chr_y) * @as(isize, src_stride[1]));
+        const v_row = ptrAddConst(u8, src[2].?, @as(isize, chr_y) * @as(isize, src_stride[2]));
+        hScale8To15(u_dst, chr_dst_w_u, u_row, c.h_chr_filter, c.h_chr_filter_pos, fs_u);
+        hScale8To15(v_dst, chr_dst_w_u, v_row, c.h_chr_filter, c.h_chr_filter_pos, fs_u);
+    }
+
+    if (c.src_range != c.dst_range and !ctx_mod.isAnyRGB(c.dst_fmt)) {
+        if (c.dst_range != 0) {
+            chrRangeToJpeg(u_dst, v_dst, chr_dst_w_u);
+        } else {
+            chrRangeFromJpeg(u_dst, v_dst, chr_dst_w_u);
+        }
+    }
+}
+
+pub fn swscaleGeneral(
+    c: *SwsContext,
+    src: [4]?[*]const u8,
+    src_stride: [4]i32,
+    dst: [4]?[*]u8,
+    dst_stride: [4]i32,
+) void {
+    const dst_w_u: usize = @intCast(c.dst_w);
+    const dst_h_u: usize = @intCast(c.dst_h);
+    const chr_dst_w_u: usize = @intCast(c.chr_dst_w);
+    const v_lum_fsize: usize = @intCast(c.v_lum_filter_size);
+    const v_chr_fsize: usize = @intCast(c.v_chr_filter_size);
+    const line_stride = c.line_width_alloc;
+
+    var last_in_lum_buf: i32 = -1;
+    var last_in_chr_buf: i32 = -1;
+
+    // Temporary arrays of line pointers for vertical filter window
+    var lum_src_ptrs_buf: [64][*]const i16 = undefined;
+    var alp_src_ptrs_buf: [64][*]const i16 = undefined;
+    var chr_u_src_ptrs_buf: [64][*]const i16 = undefined;
+    var chr_v_src_ptrs_buf: [64][*]const i16 = undefined;
+
+    for (0..dst_h_u) |dst_y| {
+        const chr_dst_y: usize = dst_y >> c.chr_dst_v_sub;
+        const first_lum_src_y: i32 = c.v_lum_filter_pos[dst_y];
+        const last_lum_src_y: i32 = first_lum_src_y + c.v_lum_filter_size - 1;
+        const first_chr_src_y: i32 = c.v_chr_filter_pos[chr_dst_y];
+        const last_chr_src_y: i32 = first_chr_src_y + c.v_chr_filter_size - 1;
+
+        while (last_in_lum_buf < last_lum_src_y) {
+            last_in_lum_buf += 1;
+            const buf_idx: usize = @as(usize, @intCast(last_in_lum_buf)) % c.lum_buf_size;
+            const lum_line = c.lum_buf[buf_idx * line_stride ..].ptr;
+            const alp_line: ?[*]i16 = if (c.need_alpha) c.alp_buf[buf_idx * line_stride ..].ptr else null;
+            scaleLineLum(c, src, src_stride, last_in_lum_buf, lum_line, alp_line);
+        }
+
+        const enough_lines = (dst_y & ((@as(usize, 1) << c.chr_dst_v_sub) - 1)) == ((@as(usize, 1) << c.chr_dst_v_sub) - 1);
+        if (enough_lines and c.needs_hcscale) {
+            while (last_in_chr_buf < last_chr_src_y) {
+                last_in_chr_buf += 1;
+                const buf_idx: usize = @as(usize, @intCast(last_in_chr_buf)) % c.chr_buf_size;
+                const u_line = c.chr_u_buf[buf_idx * line_stride ..].ptr;
+                const v_line = c.chr_v_buf[buf_idx * line_stride ..].ptr;
+                scaleLineChr(c, src, src_stride, last_in_chr_buf, u_line, v_line);
+            }
+        }
+
+        // Gather vertical source line pointers for this dst_y
+        for (0..v_lum_fsize) |j| {
+            const sy: usize = @intCast(first_lum_src_y + @as(i32, @intCast(j)));
+            const buf_idx = sy % c.lum_buf_size;
+            lum_src_ptrs_buf[j] = c.lum_buf[buf_idx * line_stride ..].ptr;
+            if (c.need_alpha) {
+                alp_src_ptrs_buf[j] = c.alp_buf[buf_idx * line_stride ..].ptr;
+            }
+        }
+        for (0..v_chr_fsize) |j| {
+            const sy: usize = @intCast(first_chr_src_y + @as(i32, @intCast(j)));
+            const buf_idx = sy % c.chr_buf_size;
+            chr_u_src_ptrs_buf[j] = c.chr_u_buf[buf_idx * line_stride ..].ptr;
+            chr_v_src_ptrs_buf[j] = c.chr_v_buf[buf_idx * line_stride ..].ptr;
+        }
+
+        const lum_filter_row = c.v_lum_filter[dst_y * v_lum_fsize ..].ptr;
+        const chr_filter_row = c.v_chr_filter[chr_dst_y * v_chr_fsize ..].ptr;
+        const lum_src = lum_src_ptrs_buf[0..v_lum_fsize];
+        const alp_src: ?[]const [*]const i16 = if (c.need_alpha) alp_src_ptrs_buf[0..v_lum_fsize] else null;
+        const chr_u_src = chr_u_src_ptrs_buf[0..v_chr_fsize];
+        const chr_v_src = chr_v_src_ptrs_buf[0..v_chr_fsize];
+
+        if (ctx_mod.isPlanarYUV(c.dst_fmt) or ctx_mod.isGray(c.dst_fmt)) {
+            const y_dest = ptrAdd(u8, dst[0].?, @as(isize, @intCast(dst_y)) * @as(isize, dst_stride[0]));
+            if (v_lum_fsize == 1) {
+                yuv2plane1_8(lum_src[0], y_dest, dst_w_u);
+            } else {
+                yuv2planeX_8(lum_filter_row, v_lum_fsize, lum_src, y_dest, dst_w_u);
+            }
+
+            if (enough_lines and !ctx_mod.isGray(c.dst_fmt)) {
+                if (c.dst_fmt == ctx_mod.PIXFMT_NV12 or c.dst_fmt == ctx_mod.PIXFMT_NV21) {
+                    const uv_dest = ptrAdd(u8, dst[1].?, @as(isize, @intCast(chr_dst_y)) * @as(isize, dst_stride[1]));
+                    yuv2nv12cX(c.dst_fmt, chr_filter_row, v_chr_fsize, chr_u_src, chr_v_src, uv_dest, chr_dst_w_u);
+                } else {
+                    const u_dest = ptrAdd(u8, dst[1].?, @as(isize, @intCast(chr_dst_y)) * @as(isize, dst_stride[1]));
+                    const v_dest = ptrAdd(u8, dst[2].?, @as(isize, @intCast(chr_dst_y)) * @as(isize, dst_stride[2]));
+                    if (v_chr_fsize == 1) {
+                        yuv2plane1_8(chr_u_src[0], u_dest, chr_dst_w_u);
+                        yuv2plane1_8(chr_v_src[0], v_dest, chr_dst_w_u);
+                    } else {
+                        yuv2planeX_8(chr_filter_row, v_chr_fsize, chr_u_src, u_dest, chr_dst_w_u);
+                        yuv2planeX_8(chr_filter_row, v_chr_fsize, chr_v_src, v_dest, chr_dst_w_u);
+                    }
+                }
+            }
+        } else if (ctx_mod.isAnyRGB(c.dst_fmt)) {
+            const rgb_dest = ptrAdd(u8, dst[0].?, @as(isize, @intCast(dst_y)) * @as(isize, dst_stride[0]));
+            const full_chr = (c.flags & ctx_mod.SWS_FULL_CHR_H_INT) != 0;
+
+            const is_1tap = v_lum_fsize == 1 and
+                (v_chr_fsize == 1 or (v_chr_fsize == 2 and (@as(i32, chr_filter_row[0]) + @as(i32, chr_filter_row[1]) == 4096) and chr_filter_row[1] <= 4096));
+            const is_2tap = v_lum_fsize == 2 and (@as(i32, lum_filter_row[0]) + @as(i32, lum_filter_row[1]) == 4096) and lum_filter_row[1] <= 4096 and
+                v_chr_fsize == 2 and (@as(i32, chr_filter_row[0]) + @as(i32, chr_filter_row[1]) == 4096) and chr_filter_row[1] <= 4096;
+
+            const ubuf0 = chr_u_src[0];
+            const ubuf1 = if (v_chr_fsize > 1) chr_u_src[1] else chr_u_src[0];
+            const vbuf0 = chr_v_src[0];
+            const vbuf1 = if (v_chr_fsize > 1) chr_v_src[1] else chr_v_src[0];
+            const abuf0: ?[*]const i16 = if (c.need_alpha) alp_src.?[0] else null;
+            const abuf1: ?[*]const i16 = if (c.need_alpha and v_lum_fsize > 1) alp_src.?[1] else abuf0;
+            const uvalpha: i32 = if (v_chr_fsize == 1) 0 else chr_filter_row[1];
+
+            if (full_chr) {
+                if (is_1tap) {
+                    dispatchFull1(c, lum_src[0], ubuf0, ubuf1, vbuf0, vbuf1, abuf0, rgb_dest, dst_w_u, uvalpha);
+                } else if (is_2tap) {
+                    const yalpha: i32 = lum_filter_row[1];
+                    dispatchFull2(c, lum_src[0], lum_src[1], ubuf0, ubuf1, vbuf0, vbuf1, abuf0, abuf1, rgb_dest, dst_w_u, yalpha, uvalpha);
+                } else {
+                    dispatchFullX(c, lum_filter_row, lum_src, v_lum_fsize, chr_filter_row, chr_u_src, chr_v_src, v_chr_fsize, alp_src, rgb_dest, dst_w_u);
+                }
+            } else {
+                if (is_1tap) {
+                    dispatchHalf1(c, lum_src[0], ubuf0, ubuf1, vbuf0, vbuf1, abuf0, rgb_dest, dst_w_u, uvalpha);
+                } else if (is_2tap) {
+                    const yalpha: i32 = lum_filter_row[1];
+                    dispatchHalf2(c, lum_src[0], lum_src[1], ubuf0, ubuf1, vbuf0, vbuf1, abuf0, abuf1, rgb_dest, dst_w_u, yalpha, uvalpha);
+                } else {
+                    dispatchHalfX(c, lum_filter_row, lum_src, v_lum_fsize, chr_filter_row, chr_u_src, chr_v_src, v_chr_fsize, alp_src, rgb_dest, dst_w_u);
+                }
+            }
+        }
+    }
+}
+
+fn dispatchFull1(c: *const SwsContext, buf0: [*]const i16, ubuf0: [*]const i16, ubuf1: [*]const i16, vbuf0: [*]const i16, vbuf1: [*]const i16, abuf0: ?[*]const i16, dest: [*]u8, dst_w: usize, uvalpha: i32) void {
+    switch (c.dst_fmt) {
+        ctx_mod.PIXFMT_RGB24 => yuv2rgbFull1Template(c, buf0, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, dest, dst_w, uvalpha, ctx_mod.PIXFMT_RGB24, false),
+        ctx_mod.PIXFMT_BGR24 => yuv2rgbFull1Template(c, buf0, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, dest, dst_w, uvalpha, ctx_mod.PIXFMT_BGR24, false),
+        ctx_mod.PIXFMT_RGBA => if (c.need_alpha)
+            yuv2rgbFull1Template(c, buf0, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, dest, dst_w, uvalpha, ctx_mod.PIXFMT_RGBA, true)
+        else
+            yuv2rgbFull1Template(c, buf0, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, dest, dst_w, uvalpha, ctx_mod.PIXFMT_RGBA, false),
+        ctx_mod.PIXFMT_BGRA => if (c.need_alpha)
+            yuv2rgbFull1Template(c, buf0, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, dest, dst_w, uvalpha, ctx_mod.PIXFMT_BGRA, true)
+        else
+            yuv2rgbFull1Template(c, buf0, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, dest, dst_w, uvalpha, ctx_mod.PIXFMT_BGRA, false),
+        else => unreachable,
+    }
+}
+
+fn dispatchFull2(c: *const SwsContext, buf0: [*]const i16, buf1: [*]const i16, ubuf0: [*]const i16, ubuf1: [*]const i16, vbuf0: [*]const i16, vbuf1: [*]const i16, abuf0: ?[*]const i16, abuf1: ?[*]const i16, dest: [*]u8, dst_w: usize, yalpha: i32, uvalpha: i32) void {
+    switch (c.dst_fmt) {
+        ctx_mod.PIXFMT_RGB24 => yuv2rgbFull2Template(c, buf0, buf1, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, abuf1, dest, dst_w, yalpha, uvalpha, ctx_mod.PIXFMT_RGB24, false),
+        ctx_mod.PIXFMT_BGR24 => yuv2rgbFull2Template(c, buf0, buf1, ubuf0, ubuf1, vbuf0, vbuf1, abuf0, abuf1, dest, dst_w, yalpha, uvalpha, ctx_mod.PIXFMT_BGR24, false),
+        ctx_mod.PIXFMT_RGBA => if (c.need_alpha)
