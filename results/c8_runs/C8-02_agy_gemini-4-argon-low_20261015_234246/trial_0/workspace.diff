+fn yuv2rgbFull1Template(
+    c: *const SwsContext,
+    buf0: [*]const i16,
+    ubuf0: [*]const i16,
+    ubuf1: [*]const i16,
+    vbuf0: [*]const i16,
+    vbuf1: [*]const i16,
+    abuf0: ?[*]const i16,
