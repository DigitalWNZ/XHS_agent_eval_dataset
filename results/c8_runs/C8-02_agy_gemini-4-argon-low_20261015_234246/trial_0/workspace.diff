+        const Y: i32 = (@as(i32, buf0[i]) * yalpha1 + @as(i32, buf1[i]) * yalpha) >> 10;
+        const U: i32 = (@as(i32, ubuf0[i]) * uvalpha1 + @as(i32, ubuf1[i]) * uvalpha - (128 << 19)) >> 10;
