+
+        c.chr_u_buf = allocator.alloc(i16, c.chr_buf_size * c.line_width_alloc) catch {
+            swscale_destroy(c);
+            return null;
+        };
+        c.chr_v_buf = allocator.alloc(i16, c.chr_buf_size * c.line_width_alloc) catch {
+            swscale_destroy(c);
+            return null;
+        };
