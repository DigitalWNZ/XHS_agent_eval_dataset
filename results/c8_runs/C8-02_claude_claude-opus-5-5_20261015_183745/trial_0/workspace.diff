@@ -0,0 +1,1619 @@
+// Generic scaler: input -> 15-bit intermediate -> horizontal filter -> vertical
+// filter -> output, mirroring FFmpeg's swscale C pipeline.
+const std = @import("std");
+const m = @import("main.zig");
+const y2r = @import("yuv2rgb.zig");
+const alloc = std.heap.c_allocator;
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    return if (a >= 0) @divTrunc(a + (b >> 1), b) else @divTrunc(a - (b >> 1), b);
+}
+
+// BT.601 coefficients (ff_yuv2rgb_coeffs[SWS_CS_DEFAULT]).
+const coeffs = [4]i64{ 104597, 132201, 25675, 53279 };
+
+// Matches the reference's RGB->YUV constants (BT.601 limited, RGB2YUV_SHIFT 15).
+pub const rgb2yuv: [9]i32 = .{ 8414, 16519, 3208, -4865, -9528, 14392, 14392, -12061, -2332 };
+
+fn roundToInt16(f: i64) i32 {
+    const r: i64 = (f + (1 << 15)) >> 16;
+    if (r < -0x7FFF) return -0x8000;
+    if (r > 0x7FFF) return 0x7FFF;
+    return @intCast(r);
+}
+
+// yuv2rgb "full" output coefficients (ff_yuv2rgb_c_init_tables, limited range).
+pub const full = blk: {
+    var cy: i64 = @divTrunc((1 << 16) * 255, 219);
+    const oy: i64 = 16 << 16;
+    var crv: i64 = coeffs[0];
+    var cbu: i64 = coeffs[1];
+    var cgu: i64 = -coeffs[2];
+    var cgv: i64 = -coeffs[3];
+    cy = (cy * 65536) >> 16;
+    crv = (crv * 65536 * 65536) >> 32;
+    cbu = (cbu * 65536 * 65536) >> 32;
+    cgu = (cgu * 65536 * 65536) >> 32;
+    cgv = (cgv * 65536 * 65536) >> 32;
+    break :blk .{
+        .y_coeff = roundToInt16(cy * (1 << 13)),
+        .y_offset = roundToInt16(oy * (1 << 9)),
+        .v2r = roundToInt16(crv * (1 << 13)),
+        .v2g = roundToInt16(cgv * (1 << 13)),
+        .u2g = roundToInt16(cgu * (1 << 13)),
+        .u2b = roundToInt16(cbu * (1 << 13)),
+    };
+};
+
+pub const Filter = struct {
+    pos: []i32,
+    coef: []i16,
+    size: usize,
+    n: usize,
+    identity: bool = false,
+    // gather kernel tables (horizontal filters)
+    np: usize = 0,
+    offB: []i32 = &.{},
+    cLo: []i32 = &.{},
+    cHi: []i32 = &.{},
+    wbuf: []u16 = &.{},
+    cP: []u32 = &.{},
+    fn deinit(f: *Filter) void {
+        alloc.free(f.pos);
+        alloc.free(f.coef);
+        if (f.offB.len > 0) alloc.free(f.offB);
+        if (f.cLo.len > 0) alloc.free(f.cLo);
+        if (f.cHi.len > 0) alloc.free(f.cHi);
+        if (f.wbuf.len > 0) alloc.free(f.wbuf);
+        if (f.cP.len > 0) alloc.free(f.cP);
+    }
+    pub fn prepGather(f: *Filter, srcW: usize) !void {
+        const n = f.n;
+        const nb = (n + 7) / 8;
+        const np = (f.size + 1) / 2;
+        f.np = np;
+        f.offB = try alloc.alloc(i32, nb * 8);
+        f.wbuf = try alloc.alloc(u16, srcW + 2 * np + 64);
+        f.cLo = try alloc.alloc(i32, nb * np * 8);
+        f.cHi = try alloc.alloc(i32, nb * np * 8);
+        f.cP = try alloc.alloc(u32, nb * np * 8);
+        for (0..nb * 8) |i| {
+            const ii = @min(i, n - 1);
+            f.offB[i] = f.pos[ii] * 2;
+            for (0..np) |jj| {
+                const k = ((i / 8) * np + jj) * 8 + (i % 8);
+                const j0 = 2 * jj;
+                const j1 = 2 * jj + 1;
+                f.cLo[k] = if (i < n and j0 < f.size) f.coef[i * f.size + j0] else 0;
+                f.cHi[k] = if (i < n and j1 < f.size) f.coef[i * f.size + j1] else 0;
+                f.cP[k] = @as(u32, @as(u16, @bitCast(@as(i16, @intCast(f.cLo[k]))))) | (@as(u32, @as(u16, @bitCast(@as(i16, @intCast(f.cHi[k]))))) << 16);
+            }
+        }
+    }
+};
+
+fn ilog2(v: i64) i64 {
+    if (v <= 0) return 0;
+    return 63 - @as(i64, @clz(@as(u64, @intCast(v))));
+}
+
+// Port of FFmpeg initFilter for POINT / BILINEAR / BICUBIC, filterAlign = 1.
+pub fn initFilter(xInc: i64, srcW: i64, dstW: i64, one: i64, algo: c_int, srcPos: i64, dstPos: i64) !Filter {
+    const fone: i64 = @as(i64, 1) << @intCast(54 - @min(ilog2(@divTrunc(srcW, dstW)), 8));
+    const n: usize = @intCast(dstW);
+    const pos = try alloc.alloc(i32, n);
+    errdefer alloc.free(pos);
+    var filterSize: i64 = 1;
+    var filter: []i64 = undefined;
+
+    if (@abs(xInc - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, n);
+        for (0..n) |i| {
+            filter[i] = fone;
+            pos[i] = @intCast(i);
+        }
+    } else if (algo == 0) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, n);
+        var xDstInSrc: i64 = ((dstPos * xInc) >> 8) - ((srcPos * 0x8000) >> 7);
+        for (0..n) |i| {
+            const xx = (xDstInSrc - ((filterSize - 1) << 15) + (1 << 15)) >> 16;
+            pos[i] = @intCast(xx);
+            filter[i] = fone;
+            xDstInSrc += xInc;
+        }
+    } else {
+        const sizeFactor: i64 = if (algo == 2) 4 else 2;
+        if (xInc <= 1 << 16) {
+            filterSize = 1 + sizeFactor;
+        } else {
+            filterSize = 1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW);
+        }
+        filterSize = @min(filterSize, srcW - 2);
+        filterSize = @max(filterSize, 1);
+        const fs: usize = @intCast(filterSize);
+        filter = try alloc.alloc(i64, n * fs);
+        var xDstInSrc: i64 = ((dstPos * xInc) >> 7) - ((srcPos * 0x10000) >> 7);
+        for (0..n) |i| {
+            var xx: i64 = @divTrunc(xDstInSrc - (filterSize - 2) * (1 << 16), 1 << 17);
+            pos[i] = @intCast(xx);
+            for (0..fs) |j| {
+                var d: i64 = @as(i64, @intCast(@abs(xx * (1 << 17) - xDstInSrc))) << 13;
+                var coeff: i64 = 0;
+                if (xInc > 1 << 16) d = @divTrunc(d * dstW, srcW);
+                if (algo == 2) {
+                    const B: i64 = 0;
+                    const C: i64 = @intFromFloat(0.6 * @as(f64, 1 << 24));
+                    if (d >= @as(i64, 1) << 31) {
+                        coeff = 0;
+                    } else {
+                        const dd = (d * d) >> 30;
+                        const ddd = (dd * d) >> 30;
+                        if (d < @as(i64, 1) << 30) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * fs + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * xInc;
+        }
+    }
+    defer alloc.free(filter);
+
+    // filter2 == filter (no src/dst vectors); reduce size
+    const f2s: usize = @intCast(filterSize);
+    var minFilterSize: usize = 0;
+    var ii: isize = @as(isize, @intCast(n)) - 1;
+    const cutoffLimit: f64 = 0.002 * @as(f64, @floatFromInt(fone));
+    while (ii >= 0) : (ii -= 1) {
+        const i: usize = @intCast(ii);
+        var min: usize = f2s;
+        var cutOff: i64 = 0;
+        var j: usize = 0;
+        while (j < f2s) : (j += 1) {
+            cutOff += @intCast(@abs(filter[i * f2s]));
+            if (@as(f64, @floatFromInt(cutOff)) > cutoffLimit) break;
+            if (i < n - 1 and pos[i] >= pos[i + 1]) break;
+            var k: usize = 1;
+            while (k < f2s) : (k += 1) filter[i * f2s + k - 1] = filter[i * f2s + k];
+            filter[i * f2s + k - 1] = 0;
+            pos[i] += 1;
+        }
+        cutOff = 0;
+        var jj: usize = f2s - 1;
+        while (jj > 0) : (jj -= 1) {
+            cutOff += @intCast(@abs(filter[i * f2s + jj]));
+            if (@as(f64, @floatFromInt(cutOff)) > cutoffLimit) break;
+            min -= 1;
+        }
+        if (min > minFilterSize) minFilterSize = min;
+    }
+    const fsz: usize = minFilterSize;
+    const nf = try alloc.alloc(i64, n * fsz);
+    defer alloc.free(nf);
+    for (0..n) |i| {
+        for (0..fsz) |j| {
+            nf[i * fsz + j] = if (j >= f2s) 0 else filter[i * f2s + j];
+        }
+    }
+    const sw: i32 = @intCast(srcW);
+    const fszi: i32 = @intCast(fsz);
+    for (0..n) |i| {
+        if (pos[i] < 0) {
+            var j: usize = 1;
+            while (j < fsz) : (j += 1) {
+                const left: usize = @intCast(@max(@as(i32, @intCast(j)) + pos[i], 0));
+                nf[i * fsz + left] += nf[i * fsz + j];
+                nf[i * fsz + j] = 0;
+            }
+            pos[i] = 0;
+        }
+        if (pos[i] + fszi > sw) {
+            const shift: i32 = pos[i] + @min(fszi - sw, 0);
+            var acc: i64 = 0;
+            var j: isize = @as(isize, @intCast(fsz)) - 1;
+            while (j >= 0) : (j -= 1) {
+                const ju: usize = @intCast(j);
+                if (pos[i] + @as(i32, @intCast(j)) >= sw) {
+                    acc += nf[i * fsz + ju];
+                    nf[i * fsz + ju] = 0;
+                }
+            }
+            j = @as(isize, @intCast(fsz)) - 1;
+            while (j >= 0) : (j -= 1) {
+                const ju: usize = @intCast(j);
+                if (j < shift) {
+                    nf[i * fsz + ju] = 0;
+                } else {
+                    nf[i * fsz + ju] = nf[i * fsz + ju - @as(usize, @intCast(shift))];
+                }
+            }
+            pos[i] -= shift;
+            nf[i * fsz + @as(usize, @intCast(sw - 1 - pos[i]))] += acc;
+        }
+    }
+    const coef = try alloc.alloc(i16, n * fsz);
+    for (0..n) |i| {
+        var err: i64 = 0;
+        var sum: i64 = 0;
+        for (0..fsz) |j| sum += nf[i * fsz + j];
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        for (0..fsz) |j| {
+            const v = nf[i * fsz + j] + err;
+            const intV = roundedDiv(v, sum);
+            coef[i * fsz + j] = @intCast(intV);
+            err = v - intV * sum;
+        }
+    }
+    var ident = fsz == 1;
+    if (ident) {
+        for (0..n) |i| {
+            if (pos[i] != @as(i32, @intCast(i)) or coef[i] != 16384) ident = false;
+        }
+    }
+    return .{ .pos = pos, .coef = coef, .size = fsz, .n = n, .identity = ident };
+}
+
+fn isRGB(f: c_int) bool {
+    return f >= m.RGB24 and f <= m.BGRA;
+}
+
+fn subH(f: c_int) u5 {
+    return switch (f) {
+        m.YUV420P, m.YUV422P, m.NV12, m.NV21 => 1,
+        else => 0,
+    };
+}
+fn subV(f: c_int) u5 {
+    return switch (f) {
+        m.YUV420P, m.NV12, m.NV21 => 1,
+        else => 0,
+    };
+}
+
+inline fn rowc(p: [*]const u8, stride: isize, y: usize) [*]const u8 {
+    return p + @as(usize, @bitCast(stride * @as(isize, @intCast(y))));
+}
+inline fn rowm(p: [*]u8, stride: isize, y: usize) [*]u8 {
+    return p + @as(usize, @bitCast(stride * @as(isize, @intCast(y))));
+}
+
+inline fn clip8(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+const RgbL = struct { bpp: usize, r: usize, g: usize, b: usize, a: usize };
+fn rgbLayout(f: c_int) RgbL {
+    return switch (f) {
+        m.RGB24 => .{ .bpp = 3, .r = 0, .g = 1, .b = 2, .a = 0 },
+        m.BGR24 => .{ .bpp = 3, .r = 2, .g = 1, .b = 0, .a = 0 },
+        m.RGBA => .{ .bpp = 4, .r = 0, .g = 1, .b = 2, .a = 3 },
+        else => .{ .bpp = 4, .r = 2, .g = 1, .b = 0, .a = 3 },
+    };
+}
+
+pub const Generic = struct {
+    sw: usize,
+    sh: usize,
+    dw: usize,
+    dh: usize,
+    sf: c_int,
+    df: c_int,
+    chrSrcW: usize,
+    chrSrcH: usize,
+    chrDstW: usize,
+    chrDstH: usize,
+    chrSrcHSub: u5,
+    chrSrcVSub: u5,
+    fullChr: bool,
+    needAlpha: bool,
+    doChroma: bool,
+    lumRange: u8, // 0 none, 1 to jpeg, 2 from jpeg
+    scaled: bool,
+    fuseLum: bool,
+    vfL: bool = false,
+    vfC: bool = false,
+    vLumR: Filter = undefined,
+    vChrR: Filter = undefined,
+    inL: []u16 = &.{},
+    inU: []u16 = &.{},
+    inV: []u16 = &.{},
+    vRow: []u16 = &.{},
+    hLum: Filter,
+    vLum: Filter,
+    hChr: Filter,
+    vChr: Filter,
+    // horizontally scaled planes
+    lum: []i16,
+    chrU: []i16,
+    chrV: []i16,
+    alp: []i16,
+    lumNeed: []bool,
+    chrNeed: []bool,
+    tmp16: []u16,
+    tmpU16: []u16,
+    tmpV16: []u16,
+    tmpA16: []u16,
+    tmpU8: []u8,
+    tmpV8: []u8,
+
+    pub fn init(sw: usize, sh: usize, sf: c_int, dw: usize, dh: usize, df: c_int, algo: c_int) !*Generic {
+        const g = try alloc.create(Generic);
+        errdefer alloc.destroy(g);
+        g.sw = sw;
+        g.sh = sh;
+        g.dw = dw;
+        g.dh = dh;
+        g.sf = sf;
+        g.df = df;
+        var chrSrcHSub = subH(sf);
+        const chrSrcVSub = subV(sf);
+        var chrDstHSub = subH(df);
+        const chrDstVSub = subV(df);
+        var fullChr = false;
+        if (isRGB(df)) {
+            if ((dw & 1) != 0) fullChr = true;
+            if (chrSrcHSub == 0 and chrSrcVSub == 0) fullChr = true;
+            if (!fullChr) chrDstHSub = 1;
+        }
+        if (isRGB(sf) and ((dw >> chrDstHSub) <= (sw >> 1))) chrSrcHSub = 1;
+        g.chrSrcHSub = chrSrcHSub;
+        g.chrSrcVSub = chrSrcVSub;
+        g.fullChr = fullChr;
+        g.chrSrcW = (sw + (@as(usize, 1) << chrSrcHSub) - 1) >> chrSrcHSub;
+        g.chrSrcH = (sh + (@as(usize, 1) << chrSrcVSub) - 1) >> chrSrcVSub;
+        g.chrDstW = (dw + (@as(usize, 1) << chrDstHSub) - 1) >> chrDstHSub;
+        g.chrDstH = (dh + (@as(usize, 1) << chrDstVSub) - 1) >> chrDstVSub;
+        g.needAlpha = (sf == m.RGBA or sf == m.BGRA) and (df == m.RGBA or df == m.BGRA);
+        g.doChroma = df != m.GRAY8;
+        g.scaled = sw != dw or sh != dh;
+        const srcRange = sf == m.GRAY8;
+        const dstRange = df == m.GRAY8;
+        g.lumRange = if (srcRange == dstRange or isRGB(df)) 0 else if (srcRange) 2 else 1;
+
+        const swi: i64 = @intCast(sw);
+        const shi: i64 = @intCast(sh);
+        const dwi: i64 = @intCast(dw);
+        const dhi: i64 = @intCast(dh);
+        const lumXInc = @divTrunc((swi << 16) + (dwi >> 1), dwi);
+        const lumYInc = @divTrunc((shi << 16) + (dhi >> 1), dhi);
+        const csw: i64 = @intCast(g.chrSrcW);
+        const csh: i64 = @intCast(g.chrSrcH);
+        const cdw: i64 = @intCast(g.chrDstW);
+        const cdh: i64 = @intCast(g.chrDstH);
+        const chrXInc = @divTrunc((csw << 16) + (cdw >> 1), cdw);
+        const chrYInc = @divTrunc((csh << 16) + (cdh >> 1), cdh);
+        g.hLum = try initFilter(lumXInc, swi, dwi, 1 << 14, algo, 128, 128);
+        g.hChr = try initFilter(chrXInc, csw, cdw, 1 << 14, algo, 128, 128);
+        g.vLum = try initFilter(lumYInc, shi, dhi, 1 << 12, algo, 128, 128);
+        g.vChr = try initFilter(chrYInc, csh, cdh, 1 << 12, algo, 128, 128);
+        g.fuseLum = isRGB(sf) and !isRGB(df) and df != m.GRAY8 and g.hLum.identity and g.vLum.size == 1 and sh == dh and !g.needAlpha;
+        if (!g.hLum.identity) try g.hLum.prepGather(sw);
+        if (!g.hChr.identity) try g.hChr.prepGather(g.chrSrcW);
+
+        g.lum = try alloc.alloc(i16, sh * dw + 16);
+        g.chrU = try alloc.alloc(i16, g.chrSrcH * g.chrDstW + 16);
+        g.chrV = try alloc.alloc(i16, g.chrSrcH * g.chrDstW + 16);
+        g.alp = try alloc.alloc(i16, if (g.needAlpha) sh * dw + 16 else 16);
+        g.lumNeed = try alloc.alloc(bool, sh);
+        g.chrNeed = try alloc.alloc(bool, g.chrSrcH);
+        @memset(g.lumNeed, false);
+        @memset(g.chrNeed, false);
+        for (0..dh) |y| {
+            const p: usize = @intCast(g.vLum.pos[y]);
+            for (0..g.vLum.size) |j| if (p + j < sh) {
+                g.lumNeed[p + j] = true;
+            };
+        }
+        for (0..g.chrDstH) |y| {
+            const p: usize = @intCast(g.vChr.pos[y]);
+            for (0..g.vChr.size) |j| if (p + j < g.chrSrcH) {
+                g.chrNeed[p + j] = true;
+            };
+        }
+        const tw = sw + 64;
+        g.tmp16 = try alloc.alloc(u16, tw);
+        g.tmpU16 = try alloc.alloc(u16, tw);
+        g.tmpV16 = try alloc.alloc(u16, tw);
+        g.tmpA16 = try alloc.alloc(u16, tw);
+        g.tmpU8 = try alloc.alloc(u8, tw);
+        g.tmpV8 = try alloc.alloc(u8, tw);
+        // vertical-first mode for downscales (approximate; scaled outputs only)
+        const okL = vf_on and g.scaled and dh < sh and g.vLum.size > 1 and !g.needAlpha and g.lumRange == 0 and !g.fuseLum and maxAbsCoef(&g.vLum) < 4096;
+        const okC = vf_on and g.scaled and g.doChroma and sf != m.GRAY8 and g.chrDstH < g.chrSrcH and g.vChr.size > 1 and maxAbsCoef(&g.vChr) < 4096;
+        if (okL or okC) {
+            g.vRow = try alloc.alloc(u16, @max(sw, g.chrSrcW) + 128);
+            @memset(g.vRow, 0);
+        }
+        if (okL) {
+            g.vfL = true;
+            g.vLumR = g.vLum;
+            g.vLum = try initFilter(0x10000, dhi, dhi, 1 << 12, algo, 128, 128);
+            g.inL = try alloc.alloc(u16, sh * sw + 64);
+        }
+        if (okC) {
+            g.vfC = true;
+            g.vChrR = g.vChr;
+            g.vChr = try initFilter(0x10000, cdh, cdh, 1 << 12, algo, 128, 128);
+            g.inU = try alloc.alloc(u16, g.chrSrcH * g.chrSrcW + 64);
+            g.inV = try alloc.alloc(u16, g.chrSrcH * g.chrSrcW + 64);
+        }
+        return g;
+    }
+
+    pub fn deinit(g: *Generic) void {
+        if (g.vfL) {
+            g.vLumR.deinit();
+            alloc.free(g.inL);
+        }
+        if (g.vfC) {
+            g.vChrR.deinit();
+            alloc.free(g.inU);
+            alloc.free(g.inV);
+        }
+        if (g.vRow.len > 0) alloc.free(g.vRow);
+        g.hLum.deinit();
+        g.hChr.deinit();
+        g.vLum.deinit();
+        g.vChr.deinit();
+        alloc.free(g.lum);
+        alloc.free(g.chrU);
+        alloc.free(g.chrV);
+        alloc.free(g.alp);
+        alloc.free(g.lumNeed);
+        alloc.free(g.chrNeed);
+        alloc.free(g.tmp16);
+        alloc.free(g.tmpU16);
+        alloc.free(g.tmpV16);
+        alloc.free(g.tmpA16);
+        alloc.free(g.tmpU8);
+        alloc.free(g.tmpV8);
+        alloc.destroy(g);
+    }
+
+    pub fn process(g: *Generic, src: [4][*]const u8, ss: [4]isize, dst: [4][*]u8, ds: [4]isize) void {
+        if (g.fuseLum) {
+            switch (g.sf) {
+                inline m.RGB24, m.BGR24, m.RGBA, m.BGRA => |f| {
+                    const L = comptime rgbLayout(f);
+                    for (0..g.sh) |y| inputYDirect(L.bpp, L.r, L.g, L.b, rowm(dst[0], ds[0], y), rowc(src[0], ss[0], y), g.sw);
+                },
+                else => unreachable,
+            }
+        }
+        g.horizontal(src, ss);
+        g.vertical(dst, ds);
+    }
+
+    fn horizontal(g: *Generic, src: [4][*]const u8, ss: [4]isize) void {
+        switch (g.sf) {
+            inline m.RGB24, m.BGR24, m.RGBA, m.BGRA => |f| g.horizontalRGB(f, src, ss),
+            else => g.horizontalYUV(src, ss),
+        }
+    }
+
+    fn lumRangeConv(g: *Generic, out: []i16) void {
+        if (g.lumRange == 1) {
+            for (out[0..g.dw]) |*v| v.* = @truncate((@as(i32, @min(v.*, 30189)) * 19077 - 39057361) >> 14);
+        } else if (g.lumRange == 2) {
+            for (out[0..g.dw]) |*v| v.* = @truncate((@as(i32, v.*) * 14071 + 33561947) >> 14);
+        }
+    }
+
+    fn horizontalRGB(g: *Generic, comptime f: c_int, src: [4][*]const u8, ss: [4]isize) void {
+        const L = comptime rgbLayout(f);
+        const rowbytes = g.sw * L.bpp;
+        const pointL = g.hLum.size == 1 and !g.hLum.identity and !g.needAlpha;
+        if (g.vfL) {
+            for (0..g.sh) |y| {
+                if (!g.lumNeed[y]) continue;
+                inputYFast(L.bpp, L.r, L.g, L.b, g.inL.ptr + y * g.sw, rowc(src[0], ss[0], y), g.sw);
+            }
+            g.vfirstRun(g.inL.ptr, g.sw, &g.vLumR, g.dh, g.lum.ptr, g.dw, &g.hLum);
+        }
+        for (0..g.sh) |y| {
+            if (g.fuseLum or g.vfL) break;
+            if (!g.lumNeed[y]) continue;
+            const out = g.lum[y * g.dw ..];
+            const s = rowc(src[0], ss[0], y);
+            if (pointL) {
+                inputYPoint(L.bpp, L.r, L.g, L.b, out.ptr, s, g.hLum.pos.ptr, g.dw, rowbytes);
+                g.lumRangeConv(out);
+                continue;
+            }
+            inputY(L.bpp, L.r, L.g, L.b, g.tmp16.ptr, s, g.sw);
+            hScale(u16, 13, out.ptr, g.dw, g.tmp16.ptr, &g.hLum);
+            if (L.bpp == 4 and g.needAlpha) {
+                inputA(g.tmpA16.ptr, s, g.sw);
+                hScale(u16, 13, g.alp[y * g.dw ..].ptr, g.dw, g.tmpA16.ptr, &g.hLum);
+            }
+            g.lumRangeConv(out);
+        }
+        if (!g.doChroma) return;
+        if (g.vfC) {
+            for (0..g.chrSrcH) |y| {
+                if (!g.chrNeed[y]) continue;
+                const s = rowc(src[0], ss[0], y);
+                const ou = g.inU.ptr + y * g.chrSrcW;
+                const ov = g.inV.ptr + y * g.chrSrcW;
+                if (g.chrSrcHSub == 1) {
+                    inputUVHalfFast(L.bpp, L.r, L.g, L.b, ou, ov, s, g.chrSrcW, g.sw);
+                } else {
+                    inputUV(L.bpp, L.r, L.g, L.b, 1, ou, ov, s, g.chrSrcW);
+                }
+            }
+            g.vfirstRun(g.inU.ptr, g.chrSrcW, &g.vChrR, g.chrDstH, g.chrU.ptr, g.chrDstW, &g.hChr);
+            g.vfirstRun(g.inV.ptr, g.chrSrcW, &g.vChrR, g.chrDstH, g.chrV.ptr, g.chrDstW, &g.hChr);
+            return;
+        }
+        for (0..g.chrSrcH) |y| {
+            if (!g.chrNeed[y]) continue;
+            const s = rowc(src[0], ss[0], y);
+            const ou: [*]u16 = @ptrCast(g.chrU.ptr + y * g.chrDstW);
+            const ov: [*]u16 = @ptrCast(g.chrV.ptr + y * g.chrDstW);
+            if (g.hChr.identity) {
+                if (g.chrSrcHSub == 1) {
+                    inputUVHalf(L.bpp, L.r, L.g, L.b, 1, ou, ov, s, g.chrSrcW, g.sw);
+                } else {
+                    inputUV(L.bpp, L.r, L.g, L.b, 1, ou, ov, s, g.chrSrcW);
+                }
+                continue;
+            }
+            if (g.hChr.size == 1) {
+                inputUVPoint(L.bpp, L.r, L.g, L.b, g.chrSrcHSub == 1, ou, ov, s, g.hChr.pos.ptr, g.chrDstW, rowbytes);
+                continue;
+            }
+            if (g.chrSrcHSub == 1) {
+                inputUVHalf(L.bpp, L.r, L.g, L.b, 0, g.tmpU16.ptr, g.tmpV16.ptr, s, g.chrSrcW, g.sw);
+            } else {
+                inputUV(L.bpp, L.r, L.g, L.b, 0, g.tmpU16.ptr, g.tmpV16.ptr, s, g.chrSrcW);
+            }
+            hScale(u16, 13, g.chrU[y * g.chrDstW ..].ptr, g.chrDstW, g.tmpU16.ptr, &g.hChr);
+            hScale(u16, 13, g.chrV[y * g.chrDstW ..].ptr, g.chrDstW, g.tmpV16.ptr, &g.hChr);
+        }
+    }
+
+    fn horizontalYUV(g: *Generic, src: [4][*]const u8, ss: [4]isize) void {
+        const sf = g.sf;
+        if (g.vfL) {
+            for (0..g.sh) |y| {
+                if (!g.lumNeed[y]) continue;
+                widen7(g.inL.ptr + y * g.sw, rowc(src[0], ss[0], y), g.sw);
+            }
+            g.vfirstRun(g.inL.ptr, g.sw, &g.vLumR, g.dh, g.lum.ptr, g.dw, &g.hLum);
+        }
+        for (0..g.sh) |y| {
+            if (g.vfL) break;
+            if (!g.lumNeed[y]) continue;
+            const out = g.lum[y * g.dw ..];
+            hScale(u8, 7, out.ptr, g.dw, rowc(src[0], ss[0], y), &g.hLum);
+            g.lumRangeConv(out);
+        }
+        if (!g.doChroma) return;
+        if (g.vfC) {
+            for (0..g.chrSrcH) |y| {
+                if (!g.chrNeed[y]) continue;
+                const ou = g.inU.ptr + y * g.chrSrcW;
+                const ov = g.inV.ptr + y * g.chrSrcW;
+                if (sf == m.NV12 or sf == m.NV21) {
+                    deinterleave(rowc(src[1], ss[1], y), g.tmpU8.ptr, g.tmpV8.ptr, g.chrSrcW);
+                    const u = if (sf == m.NV12) g.tmpU8 else g.tmpV8;
+                    const v = if (sf == m.NV12) g.tmpV8 else g.tmpU8;
+                    widen7(ou, u.ptr, g.chrSrcW);
+                    widen7(ov, v.ptr, g.chrSrcW);
+                } else {
+                    widen7(ou, rowc(src[1], ss[1], y), g.chrSrcW);
+                    widen7(ov, rowc(src[2], ss[2], y), g.chrSrcW);
+                }
+            }
+            g.vfirstRun(g.inU.ptr, g.chrSrcW, &g.vChrR, g.chrDstH, g.chrU.ptr, g.chrDstW, &g.hChr);
+            g.vfirstRun(g.inV.ptr, g.chrSrcW, &g.vChrR, g.chrDstH, g.chrV.ptr, g.chrDstW, &g.hChr);
+            return;
+        }
+        for (0..g.chrSrcH) |y| {
+            if (!g.chrNeed[y]) continue;
+            const ou = g.chrU[y * g.chrDstW ..];
+            const ov = g.chrV[y * g.chrDstW ..];
+            if (sf == m.NV12 or sf == m.NV21) {
+                const s = rowc(src[1], ss[1], y);
+                deinterleave(s, g.tmpU8.ptr, g.tmpV8.ptr, g.chrSrcW);
+                const u = if (sf == m.NV12) g.tmpU8 else g.tmpV8;
+                const v = if (sf == m.NV12) g.tmpV8 else g.tmpU8;
+                hScale(u8, 7, ou.ptr, g.chrDstW, u.ptr, &g.hChr);
+                hScale(u8, 7, ov.ptr, g.chrDstW, v.ptr, &g.hChr);
+            } else if (sf == m.GRAY8) {
+                @memset(ou[0..g.chrDstW], 128 << 7);
+                @memset(ov[0..g.chrDstW], 128 << 7);
+            } else {
+                hScale(u8, 7, ou.ptr, g.chrDstW, rowc(src[1], ss[1], y), &g.hChr);
+                hScale(u8, 7, ov.ptr, g.chrDstW, rowc(src[2], ss[2], y), &g.hChr);
+            }
+        }
+    }
+
+    // Vertical filter on 15-bit input rows (result in the 14-bit domain), then horizontal filter.
+    fn vfirstRun(g: *Generic, in: [*]const u16, w: usize, vf: *const Filter, nOut: usize, out: [*]i16, outW: usize, hf: *const Filter) void {
+        const fs = vf.size;
+        var cv: [64]VH = undefined;
+        for (0..nOut) |y| {
+            const p: usize = @intCast(vf.pos[y]);
+            const c = vf.coef[y * fs ..][0..fs];
+            for (0..fs) |j| cv[j] = hspl(@as(i32, c[j]) * 8);
+            const row = g.vRow.ptr;
+            var x: usize = 0;
+            while (x + HN <= w) : (x += HN) {
+                var acc: VH = hspl(0);
+                for (0..fs) |j| {
+                    const v: VH = @bitCast(@as(@Vector(HN, u16), in[(p + j) * w + x ..][0..HN].*));
+                    acc +%= mulhi(v, cv[j]);
+                }
+                const mx: VH = @max(acc, hspl(0));
+                row[x..][0..HN].* = @bitCast(mx);
+            }
+            while (x < w) : (x += 1) {
+                var acc: i32 = 0;
+                for (0..fs) |j| acc += (@as(i32, in[(p + j) * w + x]) * (@as(i32, c[j]) * 8)) >> 16;
+                row[x] = @intCast(@max(acc, 0));
+            }
+            hScale(u16, 13, out + y * outW, outW, row, hf);
+        }
+    }
+
+    fn vertical(g: *Generic, dst: [4][*]u8, ds: [4]isize) void {
+        const df = g.df;
+        switch (df) {
+            inline m.RGB24, m.BGR24, m.RGBA, m.BGRA => |f| {
+                for (0..g.dh) |y| {
+                    if (g.scaled and !g.needAlpha and fast_on and !(g.fullChr and subH(g.sf) == 1)) {
+                        outFast(g, f, y, rowm(dst[0], ds[0], y));
+                    } else if (g.fullChr) g.outFull(f, y, rowm(dst[0], ds[0], y)) else g.outHalf(f, y, rowm(dst[0], ds[0], y));
+                }
+                return;
+            },
+            else => {},
+        }
+        if (!g.fuseLum) {
+            for (0..g.dh) |y| {
+                vPlanar(g.lum, g.dw, &g.vLum, y, rowm(dst[0], ds[0], y), g.dw);
+            }
+        }
+        if (!g.doChroma) return;
+        for (0..g.chrDstH) |y| {
+            if (df == m.NV12) {
+                vPlanarNV(g.chrU, g.chrV, g.chrDstW, &g.vChr, y, rowm(dst[1], ds[1], y), g.chrDstW);
+            } else if (df == m.NV21) {
+                vPlanarNV(g.chrV, g.chrU, g.chrDstW, &g.vChr, y, rowm(dst[1], ds[1], y), g.chrDstW);
+            } else {
+                vPlanar(g.chrU, g.chrDstW, &g.vChr, y, rowm(dst[1], ds[1], y), g.chrDstW);
+                vPlanar(g.chrV, g.chrDstW, &g.vChr, y, rowm(dst[2], ds[2], y), g.chrDstW);
+            }
+        }
+    }
+
+    const PackedSel = struct { mode: u8, yalpha: i32, uvalpha: i32 };
+    fn selectPacked(g: *Generic, y: usize) PackedSel {
+        const lsz = g.vLum.size;
+        const csz = g.vChr.size;
+        const lc = g.vLum.coef[y * lsz ..][0..lsz];
+        const cc = g.vChr.coef[y * csz ..][0..csz];
+        // vertical-first collapses the luma filter; FFmpeg's 1/2-tap shortcuts don't apply then
+        // (with 1 tap each, the 1-tap path equals FFmpeg's general path exactly)
+        if (lsz == 1 and csz == 1) return .{ .mode = '1', .yalpha = 0, .uvalpha = 0 };
+        if (g.vfL or g.vfC) return .{ .mode = 'X', .yalpha = 0, .uvalpha = 0 };
+        if (lsz == 1 and csz == 2 and @as(i32, cc[0]) + cc[1] == 4096 and cc[1] >= 0 and cc[1] <= 4096)
+            return .{ .mode = '1', .yalpha = 0, .uvalpha = cc[1] };
+        if (lsz == 2 and csz == 2 and @as(i32, lc[0]) + lc[1] == 4096 and lc[1] >= 0 and lc[1] <= 4096 and @as(i32, cc[0]) + cc[1] == 4096 and cc[1] >= 0 and cc[1] <= 4096)
+            return .{ .mode = '2', .yalpha = lc[1], .uvalpha = cc[1] };
+        return .{ .mode = 'X', .yalpha = 0, .uvalpha = 0 };
+    }
+
+    fn outFull(g: *Generic, comptime f: c_int, y: usize, d: [*]u8) void {
+        g.outFullFrom(f, y, d, 0, true);
+    }
+    fn outFullTail(g: *Generic, comptime f: c_int, y: usize, d: [*]u8, start: usize) void {
+        g.outFullFrom(f, y, d, start, false);
+    }
+    fn outFullFrom(g: *Generic, comptime f: c_int, y: usize, d: [*]u8, start: usize, vec: bool) void {
+        const L = comptime rgbLayout(f);
+        const sel = g.selectPacked(y);
+        const lsz = g.vLum.size;
+        const csz = g.vChr.size;
+        const lc = g.vLum.coef[y * lsz ..][0..lsz];
+        const cc = g.vChr.coef[y * csz ..][0..csz];
+        const lp: usize = @intCast(g.vLum.pos[y]);
+        const cp: usize = @intCast(g.vChr.pos[y]);
+        const W = g.dw;
+        const CW = g.chrDstW;
+        const l0 = g.lum.ptr + lp * W;
+        const l1 = if (lsz > 1) l0 + W else l0;
+        const a0 = if (g.needAlpha) g.alp.ptr + lp * W else g.alp.ptr;
+        const a1 = if (lsz > 1 and g.needAlpha) a0 + W else a0;
+        const cu0 = g.chrU.ptr + cp * CW;
+        const cv0 = g.chrV.ptr + cp * CW;
+        const cu1 = if (csz > 1) cu0 + CW else cu0;
+        const cv1 = if (csz > 1) cv0 + CW else cv0;
+        const hasA = L.bpp == 4 and g.needAlpha;
+        const ya = spl(sel.yalpha);
+        const ya1 = spl(4096 - sel.yalpha);
+        const uva = spl(sel.uvalpha);
+        const uva1 = spl(4096 - sel.uvalpha);
+        var i: usize = start;
+        while (vec and i + VN <= W) : (i += VN) {
+            var Y: VI = undefined;
+            var U: VI = undefined;
+            var V: VI = undefined;
+            var A: VI = spl(255);
+            switch (sel.mode) {
+                '1' => {
+                    Y = ldI16(l0 + i) * spl(4);
+                    if (sel.uvalpha < 2048) {
+                        U = (ldI16(cu0 + i) - spl(128 << 7)) * spl(4);
+                        V = (ldI16(cv0 + i) - spl(128 << 7)) * spl(4);
+                    } else {
+                        U = (ldI16(cu0 + i) + ldI16(cu1 + i) - spl(128 << 8)) * spl(2);
+                        V = (ldI16(cv0 + i) + ldI16(cv1 + i) - spl(128 << 8)) * spl(2);
+                    }
+                    if (hasA) A = clipV((ldI16(a0 + i) + spl(64)) >> @splat(7));
+                },
+                '2' => {
+                    Y = (ldI16(l0 + i) * ya1 + ldI16(l1 + i) * ya) >> @splat(10);
+                    U = (ldI16(cu0 + i) * uva1 + ldI16(cu1 + i) * uva - spl(128 << 19)) >> @splat(10);
+                    V = (ldI16(cv0 + i) * uva1 + ldI16(cv1 + i) * uva - spl(128 << 19)) >> @splat(10);
+                    if (hasA) A = clipV((ldI16(a0 + i) * ya1 + ldI16(a1 + i) * ya + spl(1 << 18)) >> @splat(19));
+                },
+                else => {
+                    Y = spl(1 << 9);
+                    U = spl((1 << 9) - (128 << 19));
+                    V = U;
+                    for (0..lsz) |j| Y +%= ldI16(g.lum.ptr + (lp + j) * W + i) *% spl(lc[j]);
+                    for (0..csz) |j| {
+                        U +%= ldI16(g.chrU.ptr + (cp + j) * CW + i) *% spl(cc[j]);
+                        V +%= ldI16(g.chrV.ptr + (cp + j) * CW + i) *% spl(cc[j]);
+                    }
+                    Y >>= @splat(10);
+                    U >>= @splat(10);
+                    V >>= @splat(10);
+                    if (hasA) {
+                        var aa: VI = spl(1 << 18);
+                        for (0..lsz) |j| aa +%= ldI16(g.alp.ptr + (lp + j) * W + i) *% spl(lc[j]);
+                        A = clipV(aa >> @splat(19));
+                    }
+                },
+            }
+            writeFullV(L, d + i * L.bpp, Y, U, V, A);
+        }
+        while (i < W) : (i += 1) {
+            var Y: i32 = undefined;
+            var U: i32 = undefined;
+            var V: i32 = undefined;
+            var A: i32 = 255;
+            switch (sel.mode) {
+                '1' => {
+                    Y = @as(i32, l0[i]) * 4;
+                    if (sel.uvalpha < 2048) {
+                        U = (@as(i32, cu0[i]) - (128 << 7)) * 4;
+                        V = (@as(i32, cv0[i]) - (128 << 7)) * 4;
+                    } else {
+                        U = (@as(i32, cu0[i]) + cu1[i] - (128 << 8)) * 2;
+                        V = (@as(i32, cv0[i]) + cv1[i] - (128 << 8)) * 2;
+                    }
+                    if (hasA) A = clip8((@as(i32, a0[i]) + 64) >> 7);
+                },
+                '2' => {
+                    Y = (@as(i32, l0[i]) * (4096 - sel.yalpha) + @as(i32, l1[i]) * sel.yalpha) >> 10;
+                    U = (@as(i32, cu0[i]) * (4096 - sel.uvalpha) + @as(i32, cu1[i]) * sel.uvalpha - (128 << 19)) >> 10;
+                    V = (@as(i32, cv0[i]) * (4096 - sel.uvalpha) + @as(i32, cv1[i]) * sel.uvalpha - (128 << 19)) >> 10;
+                    if (hasA) A = clip8((@as(i32, a0[i]) * (4096 - sel.yalpha) + @as(i32, a1[i]) * sel.yalpha + (1 << 18)) >> 19);
+                },
+                else => {
+                    Y = 1 << 9;
+                    U = (1 << 9) - (128 << 19);
+                    V = U;
+                    for (0..lsz) |j| Y +%= @as(i32, g.lum[(lp + j) * W + i]) * lc[j];
+                    for (0..csz) |j| {
+                        U +%= @as(i32, g.chrU[(cp + j) * CW + i]) * cc[j];
+                        V +%= @as(i32, g.chrV[(cp + j) * CW + i]) * cc[j];
+                    }
+                    Y >>= 10;
+                    U >>= 10;
+                    V >>= 10;
+                    if (hasA) {
+                        var aa: i32 = 1 << 18;
+                        for (0..lsz) |j| aa +%= @as(i32, g.alp[(lp + j) * W + i]) * lc[j];
+                        A = clip8(aa >> 19);
+                    }
+                },
+            }
+            writeFull(d + i * L.bpp, L, Y, U, V, A);
+        }
+    }
+
+    fn outHalf(g: *Generic, comptime f: c_int, y: usize, d: [*]u8) void {
+        g.outHalfFrom(f, y, d, 0, true);
+    }
+    fn outHalfTail(g: *Generic, comptime f: c_int, y: usize, d: [*]u8, start: usize) void {
+        g.outHalfFrom(f, y, d, start, false);
+    }
+    fn outHalfFrom(g: *Generic, comptime f: c_int, y: usize, d: [*]u8, start: usize, vec: bool) void {
+        const L = comptime rgbLayout(f);
+        const sel = g.selectPacked(y);
+        const lsz = g.vLum.size;
+        const csz = g.vChr.size;
+        const lc = g.vLum.coef[y * lsz ..][0..lsz];
+        const cc = g.vChr.coef[y * csz ..][0..csz];
+        const lp: usize = @intCast(g.vLum.pos[y]);
+        const cp: usize = @intCast(g.vChr.pos[y]);
+        const W = g.dw;
+        const CW = g.chrDstW;
+        const l0 = g.lum.ptr + lp * W;
+        const l1 = if (lsz > 1) l0 + W else l0;
+        const cu0 = g.chrU.ptr + cp * CW;
+        const cv0 = g.chrV.ptr + cp * CW;
+        const cu1 = if (csz > 1) cu0 + CW else cu0;
+        const cv1 = if (csz > 1) cv0 + CW else cv0;
+        const npair = (W + 1) >> 1;
+        const ya = spl(sel.yalpha);
+        const ya1 = spl(4096 - sel.yalpha);
+        const uva = spl(sel.uvalpha);
+        const uva1 = spl(4096 - sel.uvalpha);
+        var i: usize = start;
+        while (vec and i + VN <= W / 2) : (i += VN) {
+            var Y1: VI = undefined;
+            var Y2: VI = undefined;
+            var U: VI = undefined;
+            var V: VI = undefined;
+            switch (sel.mode) {
+                '1' => {
+                    const yy = ldPairs(l0 + 2 * i);
+                    Y1 = (yy[0] + spl(64)) >> @splat(7);
+                    Y2 = (yy[1] + spl(64)) >> @splat(7);
+                    if (sel.uvalpha < 2048) {
+                        U = (ldI16(cu0 + i) + spl(64)) >> @splat(7);
+                        V = (ldI16(cv0 + i) + spl(64)) >> @splat(7);
+                    } else {
+                        U = (ldI16(cu0 + i) + ldI16(cu1 + i) + spl(128)) >> @splat(8);
+                        V = (ldI16(cv0 + i) + ldI16(cv1 + i) + spl(128)) >> @splat(8);
+                    }
+                },
+                '2' => {
+                    const p0 = ldPairs(l0 + 2 * i);
+                    const p1 = ldPairs(l1 + 2 * i);
+                    Y1 = (p0[0] * ya1 + p1[0] * ya) >> @splat(19);
+                    Y2 = (p0[1] * ya1 + p1[1] * ya) >> @splat(19);
+                    U = (ldI16(cu0 + i) * uva1 + ldI16(cu1 + i) * uva) >> @splat(19);
+                    V = (ldI16(cv0 + i) * uva1 + ldI16(cv1 + i) * uva) >> @splat(19);
+                },
+                else => {
+                    Y1 = spl(1 << 18);
+                    Y2 = Y1;
+                    U = Y1;
+                    V = Y1;
+                    for (0..lsz) |j| {
+                        const p = ldPairs(g.lum.ptr + (lp + j) * W + 2 * i);
+                        Y1 +%= p[0] *% spl(lc[j]);
+                        Y2 +%= p[1] *% spl(lc[j]);
+                    }
+                    for (0..csz) |j| {
+                        U +%= ldI16(g.chrU.ptr + (cp + j) * CW + i) *% spl(cc[j]);
+                        V +%= ldI16(g.chrV.ptr + (cp + j) * CW + i) *% spl(cc[j]);
+                    }
+                    Y1 >>= @splat(19);
+                    Y2 >>= @splat(19);
+                    U >>= @splat(19);
+                    V >>= @splat(19);
+                },
+            }
+            const q1 = y2r.tablePixelV(VN, Y1, U, V);
+            const q2 = y2r.tablePixelV(VN, Y2, U, V);
+            const r = std.simd.interlace(.{ q1[0], q2[0] });
+            const gg = std.simd.interlace(.{ q1[1], q2[1] });
+            const b = std.simd.interlace(.{ q1[2], q2[2] });
+            storeRGB(L, d + 2 * i * L.bpp, 2 * VN, r, gg, b, @splat(255));
+        }
+        while (i < npair) : (i += 1) {
+            var Y1: i32 = undefined;
+            var Y2: i32 = undefined;
+            var U: i32 = undefined;
+            var V: i32 = undefined;
+            switch (sel.mode) {
+                '1' => {
+                    Y1 = (@as(i32, l0[2 * i]) + 64) >> 7;
+                    Y2 = (@as(i32, l0[2 * i + 1]) + 64) >> 7;
+                    if (sel.uvalpha < 2048) {
+                        U = (@as(i32, cu0[i]) + 64) >> 7;
+                        V = (@as(i32, cv0[i]) + 64) >> 7;
+                    } else {
+                        U = (@as(i32, cu0[i]) + cu1[i] + 128) >> 8;
+                        V = (@as(i32, cv0[i]) + cv1[i] + 128) >> 8;
+                    }
+                },
+                '2' => {
+                    Y1 = (@as(i32, l0[2 * i]) * (4096 - sel.yalpha) + @as(i32, l1[2 * i]) * sel.yalpha) >> 19;
+                    Y2 = (@as(i32, l0[2 * i + 1]) * (4096 - sel.yalpha) + @as(i32, l1[2 * i + 1]) * sel.yalpha) >> 19;
+                    U = (@as(i32, cu0[i]) * (4096 - sel.uvalpha) + @as(i32, cu1[i]) * sel.uvalpha) >> 19;
+                    V = (@as(i32, cv0[i]) * (4096 - sel.uvalpha) + @as(i32, cv1[i]) * sel.uvalpha) >> 19;
+                },
+                else => {
+                    Y1 = 1 << 18;
+                    Y2 = 1 << 18;
+                    U = 1 << 18;
+                    V = 1 << 18;
+                    for (0..lsz) |j| {
+                        Y1 +%= @as(i32, g.lum[(lp + j) * W + 2 * i]) * lc[j];
+                        Y2 +%= @as(i32, g.lum[(lp + j) * W + 2 * i + 1]) * lc[j];
+                    }
+                    for (0..csz) |j| {
+                        U +%= @as(i32, g.chrU[(cp + j) * CW + i]) * cc[j];
+                        V +%= @as(i32, g.chrV[(cp + j) * CW + i]) * cc[j];
+                    }
+                    Y1 >>= 19;
+                    Y2 >>= 19;
+                    U >>= 19;
+                    V >>= 19;
+                },
+            }
+            const p1 = y2r.tablePixel(Y1, U, V);
+            const p2 = y2r.tablePixel(Y2, U, V);
+            const o = d + 2 * i * L.bpp;
+            o[L.r] = p1[0];
+            o[L.g] = p1[1];
+            o[L.b] = p1[2];
+            if (L.bpp == 4) o[L.a] = 255;
+            if (2 * i + 1 < W) {
+                o[L.bpp + L.r] = p2[0];
+                o[L.bpp + L.g] = p2[1];
+                o[L.bpp + L.b] = p2[2];
+                if (L.bpp == 4) o[L.bpp + L.a] = 255;
+            }
+        }
+    }
+};
+
+const VN = 16;
+const VI = @Vector(VN, i32);
+const VU8 = @Vector(VN, u8);
+
+inline fn spl(x: i32) VI {
+    return @splat(x);
+}
+inline fn ldI16(p: [*]const i16) VI {
+    const v: @Vector(VN, i16) = p[0..VN].*;
+    return @intCast(v);
+}
+inline fn ldPairs(p: [*]const i16) [2]VI {
+    const v: @Vector(2 * VN, i16) = p[0 .. 2 * VN].*;
+    const d = std.simd.deinterlace(2, v);
+    return .{ @intCast(d[0]), @intCast(d[1]) };
+}
+inline fn clipV(v: VI) VI {
+    return @min(@max(v, spl(0)), spl(255));
+}
+inline fn toU8(v: VI) VU8 {
+    return @intCast(clipV(v));
+}
+
+inline fn storeRGB(comptime L: RgbL, d: [*]u8, comptime n: usize, r: @Vector(n, u8), g: @Vector(n, u8), b: @Vector(n, u8), a: @Vector(n, u8)) void {
+    if (L.bpp == 3) {
+        d[0 .. 3 * n].* = if (L.r == 0) std.simd.interlace(.{ r, g, b }) else std.simd.interlace(.{ b, g, r });
+    } else {
+        d[0 .. 4 * n].* = if (L.r == 0) std.simd.interlace(.{ r, g, b, a }) else std.simd.interlace(.{ b, g, r, a });
+    }
+}
+
+inline fn writeFullV(comptime L: RgbL, d: [*]u8, Yin: VI, U: VI, V: VI, A: VI) void {
+    const Y = (Yin - spl(full.y_offset)) *% spl(full.y_coeff) +% spl(1 << 21);
+    const R = Y +% V *% spl(full.v2r);
+    const G = Y +% V *% spl(full.v2g) +% U *% spl(full.u2g);
+    const B = Y +% U *% spl(full.u2b);
+    const lim = spl((1 << 30) - 1);
+    const r: VU8 = @intCast(@min(@max(R, spl(0)), lim) >> @splat(22));
+    const g: VU8 = @intCast(@min(@max(G, spl(0)), lim) >> @splat(22));
+    const b: VU8 = @intCast(@min(@max(B, spl(0)), lim) >> @splat(22));
+    storeRGB(L, d, VN, r, g, b, @intCast(A));
+}
+
+inline fn clip30(x: i32) i32 {
+    if ((x & ~@as(i32, (1 << 30) - 1)) != 0) {
+        return (~x >> 31) & ((1 << 30) - 1);
+    }
+    return x;
+}
+
+inline fn writeFull(d: [*]u8, L: RgbL, Yin: i32, U: i32, V: i32, A: i32) void {
+    var Y = Yin - full.y_offset;
+    Y *%= full.y_coeff;
+    Y +%= 1 << 21;
+    var R = Y +% V *% full.v2r;
+    var G = Y +% V *% full.v2g +% U *% full.u2g;
+    var B = Y +% U *% full.u2b;
+    if (((R | G | B) & @as(i32, @bitCast(@as(u32, 0xC0000000)))) != 0) {
+        R = clip30(R);
+        G = clip30(G);
+        B = clip30(B);
+    }
+    d[L.r] = @intCast(@as(u32, @bitCast(R)) >> 22);
+    d[L.g] = @intCast(@as(u32, @bitCast(G)) >> 22);
+    d[L.b] = @intCast(@as(u32, @bitCast(B)) >> 22);
+    if (L.bpp == 4) d[L.a] = @intCast(A);
+}
+
+// ---- input conversion (RGB -> 14-bit Y/U/V like FFmpeg input.c) ----
+
+fn inputY(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, d: [*]u16, s: [*]const u8, w: usize) void {
+    const t = rgb2yuv;
+    var i: usize = 0;
+    while (i + VN <= w) : (i += VN) {
+        const x: @Vector(VN * bpp, u8) = s[i * bpp ..][0 .. VN * bpp].*;
+        const p = std.simd.deinterlace(bpp, x);
+        const r: VI = @intCast(p[ro]);
+        const g: VI = @intCast(p[go]);
+        const b: VI = @intCast(p[bo]);
+        const y = (spl(t[0]) * r + spl(t[1]) * g + spl(t[2]) * b + spl((32 << 14) + (1 << 8))) >> @splat(9);
+        d[i..][0..VN].* = @as(@Vector(VN, u16), @intCast(y));
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = s[bpp * i + ro];
+        const g: i32 = s[bpp * i + go];
+        const b: i32 = s[bpp * i + bo];
+        d[i] = @intCast((t[0] * r + t[1] * g + t[2] * b + (32 << 14) + (1 << 8)) >> 9);
+    }
+}
+
+fn inputA(d: [*]u16, s: [*]const u8, w: usize) void {
+    for (0..w) |i| d[i] = @as(u16, s[4 * i + 3]) << 6;
+}
+
+fn inputUV(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, comptime k: u5, du: [*]u16, dv: [*]u16, s: [*]const u8, w: usize) void {
+    const t = rgb2yuv;
+    var i: usize = 0;
+    while (i + VN <= w) : (i += VN) {
+        const x: @Vector(VN * bpp, u8) = s[i * bpp ..][0 .. VN * bpp].*;
+        const p = std.simd.deinterlace(bpp, x);
+        const r: VI = @intCast(p[ro]);
+        const g: VI = @intCast(p[go]);
+        const b: VI = @intCast(p[bo]);
+        const kk = spl((256 << 14) + (1 << 8));
+        const u = (spl(t[3]) * r + spl(t[4]) * g + spl(t[5]) * b + kk) >> @splat(9);
+        const v = (spl(t[6]) * r + spl(t[7]) * g + spl(t[8]) * b + kk) >> @splat(9);
+        du[i..][0..VN].* = @as(@Vector(VN, u16), @truncate(@as(@Vector(VN, u32), @bitCast(u << @splat(k)))));
+        dv[i..][0..VN].* = @as(@Vector(VN, u16), @truncate(@as(@Vector(VN, u32), @bitCast(v << @splat(k)))));
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = s[bpp * i + ro];
+        const g: i32 = s[bpp * i + go];
+        const b: i32 = s[bpp * i + bo];
+        du[i] = @truncate(@as(u32, @bitCast(((t[3] * r + t[4] * g + t[5] * b + (256 << 14) + (1 << 8)) >> 9) << k)));
+        dv[i] = @truncate(@as(u32, @bitCast(((t[6] * r + t[7] * g + t[8] * b + (256 << 14) + (1 << 8)) >> 9) << k)));
+    }
+}
+
+fn inputUVHalf(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, comptime k: u5, du: [*]u16, dv: [*]u16, s: [*]const u8, w: usize, npx: usize) void {
+    const t = rgb2yuv;
+    var i: usize = 0;
+    while (i + VN <= w and 2 * (i + VN) <= npx) : (i += VN) {
+        const x: @Vector(2 * VN * bpp, u8) = s[2 * i * bpp ..][0 .. 2 * VN * bpp].*;
+        const p = std.simd.deinterlace(2 * bpp, x);
+        const r: VI = @as(VI, @intCast(p[ro])) + @as(VI, @intCast(p[bpp + ro]));
+        const g: VI = @as(VI, @intCast(p[go])) + @as(VI, @intCast(p[bpp + go]));
+        const b: VI = @as(VI, @intCast(p[bo])) + @as(VI, @intCast(p[bpp + bo]));
+        const kk = spl((256 << 15) + (1 << 9));
+        const u = (spl(t[3]) * r + spl(t[4]) * g + spl(t[5]) * b + kk) >> @splat(10);
+        const v = (spl(t[6]) * r + spl(t[7]) * g + spl(t[8]) * b + kk) >> @splat(10);
+        du[i..][0..VN].* = @as(@Vector(VN, u16), @truncate(@as(@Vector(VN, u32), @bitCast(u << @splat(k)))));
+        dv[i..][0..VN].* = @as(@Vector(VN, u16), @truncate(@as(@Vector(VN, u32), @bitCast(v << @splat(k)))));
+    }
+    while (i < w) : (i += 1) {
+        const p0 = 2 * bpp * i;
+        const p1 = if (2 * i + 1 < npx) p0 + bpp else p0;
+        const r: i32 = @as(i32, s[p0 + ro]) + s[p1 + ro];
+        const g: i32 = @as(i32, s[p0 + go]) + s[p1 + go];
+        const b: i32 = @as(i32, s[p0 + bo]) + s[p1 + bo];
+        du[i] = @truncate(@as(u32, @bitCast(((t[3] * r + t[4] * g + t[5] * b + (256 << 15) + (1 << 9)) >> 10) << k)));
+        dv[i] = @truncate(@as(u32, @bitCast(((t[6] * r + t[7] * g + t[8] * b + (256 << 15) + (1 << 9)) >> 10) << k)));
+    }
+}
+
+fn deinterleave(s: [*]const u8, u: [*]u8, v: [*]u8, n: usize) void {
+    var i: usize = 0;
+    while (i + 32 <= n) : (i += 32) {
+        const x: @Vector(64, u8) = s[2 * i ..][0..64].*;
+        const parts = std.simd.deinterlace(2, x);
+        u[i..][0..32].* = parts[0];
+        v[i..][0..32].* = parts[1];
+    }
+    while (i < n) : (i += 1) {
+        u[i] = s[2 * i];
+        v[i] = s[2 * i + 1];
+    }
+}
+
+// ---- horizontal scaler (hScale8To15 / hScale16To15) ----
+
+fn hScale(comptime T: type, comptime sh: u5, out: [*]i16, n: usize, src: [*]const T, f: *const Filter) void {
+    if (f.identity) {
+        var i: usize = 0;
+        while (i + VN <= n) : (i += VN) {
+            const v: @Vector(VN, T) = src[i..][0..VN].*;
+            const w: VI = @intCast(v);
+            out[i..][0..VN].* = @as(@Vector(VN, i16), @intCast(@min((w * spl(16384)) >> @splat(sh), spl(32767))));
+        }
+        while (i < n) : (i += 1) out[i] = @intCast(@min((@as(i32, src[i]) * 16384) >> sh, 32767));
+        return;
+    }
+    hScaleGather(T, sh, out, n, src, f);
+}
+
+
+fn hScaleGather(comptime T: type, comptime sh: u5, out: [*]i16, n: usize, src_in: [*]const T, f: *const Filter) void {
+    var src: [*]const u16 = undefined;
+    if (T == u8) {
+        // widen to u16 (covering all taps that may be read)
+        const last: usize = @intCast(f.pos[n - 1]);
+        const need = last + 2 * f.np + 2;
+        var i: usize = 0;
+        while (i + VN <= need) : (i += VN) {
+            const v: @Vector(VN, u8) = src_in[i..][0..VN].*;
+            f.wbuf[i..][0..VN].* = @as(@Vector(VN, u16), v);
+        }
+        while (i < need) : (i += 1) f.wbuf[i] = src_in[i];
+        src = f.wbuf.ptr;
+    } else {
+        src = src_in;
+    }
+    switch (f.np) {
+        inline 1...6 => |np| hGatherN(sh, np, out, n, @ptrCast(src), f),
+        else => {
+            const fs = f.size;
+            for (0..n) |i| {
+                const p: usize = @intCast(f.pos[i]);
+                var val: i32 = 0;
+                for (0..fs) |j| val +%= @as(i32, src[p + j]) * f.coef[i * fs + j];
+                out[i] = @truncate(@min(val >> sh, 32767));
+            }
+        },
+    }
+}
+
+const V8 = @Vector(8, i32);
+inline fn gather8(src: [*]const u8, off: V8) @Vector(8, u32) {
+    var v: @Vector(8, u32) = undefined;
+    inline for (0..8) |k| v[k] = @as(*align(1) const u32, @ptrCast(src + @as(usize, @intCast(off[k])))).*;
+    return v;
+}
+
+fn hGatherN(comptime sh: u5, comptime np: usize, out: [*]i16, n: usize, src: [*]const u8, f: *const Filter) void {
+    const nb = (n + 7) / 8;
+    const offB = f.offB.ptr;
+    const cLo = f.cLo.ptr;
+    const cHi = f.cHi.ptr;
+    if (np == 1 and pmadd_on) {
+        const cP = f.cP.ptr;
+        for (0..nb) |b| {
+            const off: V8 = offB[b * 8 ..][0..8].*;
+            const c: @Vector(8, u32) = cP[b * 8 ..][0..8].*;
+            const acc = pmadd(gather8(src, off), c);
+            const r = @min(acc >> @splat(sh), @as(V8, @splat(32767)));
+            out[b * 8 ..][0..8].* = @as(@Vector(8, i16), @truncate(r));
+        }
+        return;
+    }
+    for (0..nb) |b| {
+        const off: V8 = offB[b * 8 ..][0..8].*;
+        var acc: V8 = @splat(0);
+        inline for (0..np) |jj| {
+            const v = gather8(src, off + @as(V8, @splat(4 * jj)));
+            const lo: V8 = @bitCast(v & @as(@Vector(8, u32), @splat(0xFFFF)));
+            const hi: V8 = @bitCast(v >> @splat(16));
+            const k = (b * np + jj) * 8;
+            const cl: V8 = cLo[k..][0..8].*;
+            const ch: V8 = cHi[k..][0..8].*;
+            acc +%= lo *% cl +% hi *% ch;
+        }
+        const r = @min(acc >> @splat(sh), @as(V8, @splat(32767)));
+        out[b * 8 ..][0..8].* = @as(@Vector(8, i16), @truncate(r));
+    }
+}
+
+fn hScaleN(comptime T: type, comptime sh: u5, comptime fs: usize, out: [*]i16, n: usize, src: [*]const T, f: *const Filter) void {
+    const pos = f.pos.ptr;
+    const coef = f.coef.ptr;
+    for (0..n) |i| {
+        const p: usize = @intCast(pos[i]);
+        var val: i32 = 0;
+        inline for (0..fs) |j| val +%= @as(i32, src[p + j]) * coef[i * fs + j];
+        out[i] = @truncate(@min(val >> sh, 32767));
+    }
+}
+
+// ---- vertical scaler for planar outputs (yuv2plane1 / yuv2planeX, flat dither) ----
+
+inline fn vPlanarVec(plane: [*]const i16, W: usize, fs: usize, p: usize, c: []const i16, i: usize) VU8 {
+    if (fs == 1) return toU8((ldI16(plane + p * W + i) + spl(64)) >> @splat(7));
+    var acc: VI = spl(64 << 12);
+    for (0..fs) |j| acc +%= ldI16(plane + (p + j) * W + i) *% spl(c[j]);
+    return toU8(acc >> @splat(19));
+}
+inline fn vPlanarOne(plane: [*]const i16, W: usize, fs: usize, p: usize, c: []const i16, i: usize) u8 {
+    if (fs == 1) return clip8((@as(i32, plane[p * W + i]) + 64) >> 7);
+    var val: i32 = 64 << 12;
+    for (0..fs) |j| val +%= @as(i32, plane[(p + j) * W + i]) * c[j];
+    return clip8(val >> 19);
+}
+
+fn vPlanar(plane: []const i16, W: usize, f: *const Filter, y: usize, d: [*]u8, n: usize) void {
+    const fs = f.size;
+    const p: usize = @intCast(f.pos[y]);
+    const c = f.coef[y * fs ..][0..fs];
+    var i: usize = 0;
+    while (i + VN <= n) : (i += VN) d[i..][0..VN].* = vPlanarVec(plane.ptr, W, fs, p, c, i);
+    while (i < n) : (i += 1) d[i] = vPlanarOne(plane.ptr, W, fs, p, c, i);
+}
+
+fn vPlanarNV(pu: []const i16, pv: []const i16, W: usize, f: *const Filter, y: usize, d: [*]u8, n: usize) void {
+    const fs = f.size;
+    const p: usize = @intCast(f.pos[y]);
+    const c = f.coef[y * fs ..][0..fs];
+    var i: usize = 0;
+    while (i + VN <= n) : (i += VN) {
+        const u = vPlanarVec(pu.ptr, W, fs, p, c, i);
+        const v = vPlanarVec(pv.ptr, W, fs, p, c, i);
+        d[2 * i ..][0 .. 2 * VN].* = std.simd.interlace(.{ u, v });
+    }
+    while (i < n) : (i += 1) {
+        d[2 * i] = vPlanarOne(pu.ptr, W, fs, p, c, i);
+        d[2 * i + 1] = vPlanarOne(pv.ptr, W, fs, p, c, i);
+    }
+}
+
+// ---- fast 16-bit output path for scaled RGB destinations (approximate, well within 40 dB) ----
+
+const HN = 16;
+const VH = @Vector(HN, i16);
+const VH32 = @Vector(HN, i32);
+
+inline fn hspl(x: i32) VH {
+    return @splat(@intCast(x));
+}
+inline fn mulhi(a: VH, b: VH) VH {
+    return @truncate((@as(VH32, a) * @as(VH32, b)) >> @splat(16));
+}
+inline fn avgH(a: VH, b: VH) VH {
+    const VU = @Vector(HN, u16);
+    return @bitCast((@as(VU, @bitCast(a)) +% @as(VU, @bitCast(b))) >> @splat(1));
+}
+inline fn ldH(p: [*]const i16) VH {
+    return p[0..HN].*;
+}
+
+// Y15/U15/V15 (value << 7) -> 8-bit R,G,B using FFmpeg's full-chroma coefficients.
+inline fn yuv15ToRgb(Y: VH, U: VH, V: VH) [3]@Vector(HN, u8) {
+    const yv = mulhi(Y -% hspl(2048), hspl(2 * full.y_coeff)) +% hspl(16);
+    const uu = U -% hspl(16384);
+    const vv = V -% hspl(16384);
+    const r = yv +% mulhi(vv, hspl(2 * full.v2r));
+    const g = yv +% mulhi(vv, hspl(2 * full.v2g)) +% mulhi(uu, hspl(2 * full.u2g));
+    const b = yv +% (mulhi(uu, hspl(full.u2b)) << @splat(1));
+    const z = hspl(0);
+    const m255 = hspl(255);
+    return .{
+        @intCast(@min(@max(r >> @splat(5), z), m255)),
+        @intCast(@min(@max(g >> @splat(5), z), m255)),
+        @intCast(@min(@max(b >> @splat(5), z), m255)),
+    };
+}
+
+inline fn vBlendH(p0: [*]const i16, p1: [*]const i16, a8: VH, i: usize) VH {
+    const x0 = ldH(p0 + i);
+    return x0 +% (mulhi(ldH(p1 + i) -% x0, a8) << @splat(1));
+}
+
+inline fn vSumH(plane: [*]const i16, W: usize, p: usize, c4: []const VH, i: usize) VH {
+    var acc: VH = hspl(0);
+    for (c4, 0..) |c, j| acc +%= mulhi(ldH(plane + (p + j) * W + i), c);
+    return @min(@max(acc, hspl(-8192)), hspl(8191)) << @splat(2);
+}
+
+fn outFast(g: *Generic, comptime f: c_int, y: usize, d: [*]u8) void {
+    const L = comptime rgbLayout(f);
+    const sel = g.selectPacked(y);
+    const lsz = g.vLum.size;
+    const csz = g.vChr.size;
+    const lc = g.vLum.coef[y * lsz ..][0..lsz];
+    const cc = g.vChr.coef[y * csz ..][0..csz];
+    const lp: usize = @intCast(g.vLum.pos[y]);
+    const cp: usize = @intCast(g.vChr.pos[y]);
+    const W = g.dw;
+    const CW = g.chrDstW;
+    const l0 = g.lum.ptr + lp * W;
+    const l1 = if (lsz > 1) l0 + W else l0;
+    const cu0 = g.chrU.ptr + cp * CW;
+    const cv0 = g.chrV.ptr + cp * CW;
+    const cu1 = if (csz > 1) cu0 + CW else cu0;
+    const cv1 = if (csz > 1) cv0 + CW else cv0;
+    var lc4: [16]VH = undefined;
+    var cc4: [16]VH = undefined;
+    if (sel.mode == 'X') {
+        for (0..lsz) |j| lc4[j] = hspl(@as(i32, lc[j]) * 4);
+        for (0..csz) |j| cc4[j] = hspl(@as(i32, cc[j]) * 4);
+    }
+    const ya8 = hspl(@min(sel.yalpha * 8, 32767));
+    const uva8 = hspl(@min(sel.uvalpha * 8, 32767));
+    const full_chr = g.fullChr;
+    const step: usize = if (full_chr) HN else 2 * HN;
+    var i: usize = 0;
+    while (i + step <= W) : (i += step) {
+        // luma for `step` pixels, chroma for HN samples
+        const ci = if (full_chr) i else i / 2;
+        var U: VH = undefined;
+        var V: VH = undefined;
+        switch (sel.mode) {
+            '1' => {
+                if (sel.uvalpha < 2048) {
+                    U = ldH(cu0 + ci);
+                    V = ldH(cv0 + ci);
+                } else {
+                    U = avgH(ldH(cu0 + ci), ldH(cu1 + ci));
+                    V = avgH(ldH(cv0 + ci), ldH(cv1 + ci));
+                }
+            },
+            '2' => {
+                U = vBlendH(cu0, cu1, uva8, ci);
+                V = vBlendH(cv0, cv1, uva8, ci);
+            },
+            else => {
+                U = vSumH(g.chrU.ptr, CW, cp, cc4[0..csz], ci);
+                V = vSumH(g.chrV.ptr, CW, cp, cc4[0..csz], ci);
+            },
+        }
+        if (full_chr) {
+            const Y = switch (sel.mode) {
+                '1' => ldH(l0 + i),
+                '2' => vBlendH(l0, l1, ya8, i),
+                else => vSumH(g.lum.ptr, W, lp, lc4[0..lsz], i),
+            };
+            const q = yuv15ToRgb(Y, U, V);
+            storeRGB(L, d + i * L.bpp, HN, q[0], q[1], q[2], @splat(255));
+        } else {
+            var Ya: VH = undefined;
+            var Yb: VH = undefined;
+            switch (sel.mode) {
+                '1' => {
+                    Ya = ldH(l0 + i);
+                    Yb = ldH(l0 + i + HN);
+                },
+                '2' => {
+                    Ya = vBlendH(l0, l1, ya8, i);
+                    Yb = vBlendH(l0, l1, ya8, i + HN);
+                },
+                else => {
+                    Ya = vSumH(g.lum.ptr, W, lp, lc4[0..lsz], i);
+                    Yb = vSumH(g.lum.ptr, W, lp, lc4[0..lsz], i + HN);
+                },
+            }
+            // match FFmpeg's table converter: integer Y/U/V then exact table formula
+            const r64: VH = if (sel.mode == '2') hspl(0) else hspl(64);
+            const y8a: VI = @intCast((Ya +% r64) >> @splat(7));
+            const y8b: VI = @intCast((Yb +% r64) >> @splat(7));
+            const u8v: VI = @intCast((U +% r64) >> @splat(7));
+            const v8v: VI = @intCast((V +% r64) >> @splat(7));
+            const ya = std.simd.deinterlace(2, std.simd.join(y8a, y8b));
+            const q1 = y2r.tablePixelV(VN, ya[0], u8v, v8v);
+            const q2 = y2r.tablePixelV(VN, ya[1], u8v, v8v);
+            const rr = std.simd.interlace(.{ q1[0], q2[0] });
+            const gg = std.simd.interlace(.{ q1[1], q2[1] });
+            const bb = std.simd.interlace(.{ q1[2], q2[2] });
+            const qa = [3]@Vector(HN, u8){ std.simd.extract(rr, 0, HN), std.simd.extract(gg, 0, HN), std.simd.extract(bb, 0, HN) };
+            const qb = [3]@Vector(HN, u8){ std.simd.extract(rr, HN, HN), std.simd.extract(gg, HN, HN), std.simd.extract(bb, HN, HN) };
+            storeRGB(L, d + i * L.bpp, HN, qa[0], qa[1], qa[2], @splat(255));
+            storeRGB(L, d + (i + HN) * L.bpp, HN, qb[0], qb[1], qb[2], @splat(255));
+        }
+    }
+    if (i < W) {
+        // exact scalar path for the tail
+        if (full_chr) g.outFullTail(f, y, d, i) else g.outHalfTail(f, y, d, i / 2);
+    }
+}
+
+// Same-size RGB -> 8-bit luma, folding input, identity hScale and yuv2plane1:
+// ((S + (32<<14) + (1<<8)) >> 9 + 32) >> 6 == (S + 540928) >> 15.
+fn inputYDirect(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, d: [*]u8, s: [*]const u8, w: usize) void {
+    const t = rgb2yuv;
+    var i: usize = 0;
+    while (i + VN <= w) : (i += VN) {
+        const x: @Vector(VN * bpp, u8) = s[i * bpp ..][0 .. VN * bpp].*;
+        const p = std.simd.deinterlace(bpp, x);
+        const r: VI = @intCast(p[ro]);
+        const g: VI = @intCast(p[go]);
+        const b: VI = @intCast(p[bo]);
+        const y = (spl(t[0]) * r + spl(t[1]) * g + spl(t[2]) * b + spl(540928)) >> @splat(15);
+        d[i..][0..VN].* = toU8(y);
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = s[bpp * i + ro];
+        const g: i32 = s[bpp * i + go];
+        const b: i32 = s[bpp * i + bo];
+        d[i] = clip8((t[0] * r + t[1] * g + t[2] * b + 540928) >> 15);
+    }
+}
+
+// Point-sampled horizontal input: out = 2 * Y14 of the pixel at pos[i].
+fn inputYPoint(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, out: [*]i16, s: [*]const u8, pos: [*]const i32, n: usize, rowbytes: usize) void {
+    const t = rgb2yuv;
+    const m8: @Vector(8, u32) = @splat(0xFF);
+    var i: usize = 0;
+    while (i + 8 <= n) : (i += 8) {
+        if (@as(usize, @intCast(pos[i + 7])) * bpp + 4 > rowbytes) break;
+        const p: V8 = pos[i..][0..8].*;
+        const v = gather8(s, p * @as(V8, @splat(bpp)));
+        const r: V8 = @bitCast((v >> @splat(8 * ro)) & m8);
+        const g: V8 = @bitCast((v >> @splat(8 * go)) & m8);
+        const b: V8 = @bitCast((v >> @splat(8 * bo)) & m8);
+        const y = (@as(V8, @splat(t[0])) * r + @as(V8, @splat(t[1])) * g + @as(V8, @splat(t[2])) * b + @as(V8, @splat((32 << 14) + (1 << 8)))) >> @splat(9);
+        out[i..][0..8].* = @as(@Vector(8, i16), @truncate(y << @splat(1)));
+    }
+    while (i < n) : (i += 1) {
+        const o = @as(usize, @intCast(pos[i])) * bpp;
+        const r: i32 = s[o + ro];
+        const g: i32 = s[o + go];
+        const b: i32 = s[o + bo];
+        out[i] = @truncate(((t[0] * r + t[1] * g + t[2] * b + (32 << 14) + (1 << 8)) >> 9) << 1);
+    }
+}
+
+fn inputUVPoint(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, half: bool, du: [*]u16, dv: [*]u16, s: [*]const u8, pos: [*]const i32, n: usize, rowbytes: usize) void {
+    const t = rgb2yuv;
+    const m8: @Vector(8, u32) = @splat(0xFF);
+    const pstep: usize = if (half) 2 * bpp else bpp;
+    var i: usize = 0;
+    while (i + 8 <= n) : (i += 8) {
+        if (@as(usize, @intCast(pos[i + 7])) * pstep + pstep + 4 > rowbytes) break;
+        const p: V8 = pos[i..][0..8].*;
+        const off = p * @as(V8, @splat(@intCast(pstep)));
+        const v0 = gather8(s, off);
+        var r: V8 = @bitCast((v0 >> @splat(8 * ro)) & m8);
+        var g: V8 = @bitCast((v0 >> @splat(8 * go)) & m8);
+        var b: V8 = @bitCast((v0 >> @splat(8 * bo)) & m8);
+        var u: V8 = undefined;
+        var v: V8 = undefined;
+        if (half) {
+            const v1 = gather8(s, off + @as(V8, @splat(bpp)));
+            r += @bitCast((v1 >> @splat(8 * ro)) & m8);
+            g += @bitCast((v1 >> @splat(8 * go)) & m8);
+            b += @bitCast((v1 >> @splat(8 * bo)) & m8);
+            const k: V8 = @splat((256 << 15) + (1 << 9));
+            u = (@as(V8, @splat(t[3])) * r + @as(V8, @splat(t[4])) * g + @as(V8, @splat(t[5])) * b + k) >> @splat(10);
+            v = (@as(V8, @splat(t[6])) * r + @as(V8, @splat(t[7])) * g + @as(V8, @splat(t[8])) * b + k) >> @splat(10);
+        } else {
+            const k: V8 = @splat((256 << 14) + (1 << 8));
+            u = (@as(V8, @splat(t[3])) * r + @as(V8, @splat(t[4])) * g + @as(V8, @splat(t[5])) * b + k) >> @splat(9);
+            v = (@as(V8, @splat(t[6])) * r + @as(V8, @splat(t[7])) * g + @as(V8, @splat(t[8])) * b + k) >> @splat(9);
+        }
+        du[i..][0..8].* = @as(@Vector(8, u16), @truncate(@as(@Vector(8, u32), @bitCast(u << @splat(1)))));
+        dv[i..][0..8].* = @as(@Vector(8, u16), @truncate(@as(@Vector(8, u32), @bitCast(v << @splat(1)))));
+    }
+    while (i < n) : (i += 1) {
+        const o = @as(usize, @intCast(pos[i])) * pstep;
+        var r: i32 = s[o + ro];
+        var g: i32 = s[o + go];
+        var b: i32 = s[o + bo];
+        var u: i32 = undefined;
+        var v: i32 = undefined;
+        if (half) {
+            const o1 = if (2 * @as(usize, @intCast(pos[i])) + 1 < rowbytes / bpp) o + bpp else o;
+            r += s[o1 + ro];
+            g += s[o1 + go];
+            b += s[o1 + bo];
+            u = (t[3] * r + t[4] * g + t[5] * b + (256 << 15) + (1 << 9)) >> 10;
+            v = (t[6] * r + t[7] * g + t[8] * b + (256 << 15) + (1 << 9)) >> 10;
+        } else {
+            u = (t[3] * r + t[4] * g + t[5] * b + (256 << 14) + (1 << 8)) >> 9;
+            v = (t[6] * r + t[7] * g + t[8] * b + (256 << 14) + (1 << 8)) >> 9;
+        }
+        du[i] = @truncate(@as(u32, @bitCast(u << 1)));
+        dv[i] = @truncate(@as(u32, @bitCast(v << 1)));
+    }
+}
+
+fn maxAbsCoef(f: *const Filter) i32 {
+    var mx: i32 = 0;
+    for (f.coef) |c| mx = @max(mx, @as(i32, @intCast(@abs(c))));
+    return mx;
+}
+
+fn shl1(p: [*]u16, n: usize) void {
+    var i: usize = 0;
+    while (i + VN <= n) : (i += VN) {
+        const v: @Vector(VN, u16) = p[i..][0..VN].*;
+        p[i..][0..VN].* = v << @splat(1);
+    }
+    while (i < n) : (i += 1) p[i] <<= 1;
+}
+
+fn widen7(d: [*]u16, s: [*]const u8, n: usize) void {
+    var i: usize = 0;
+    while (i + 32 <= n) : (i += 32) {
+        const v: @Vector(32, u8) = s[i..][0..32].*;
+        d[i..][0..32].* = @as(@Vector(32, u16), v) << @splat(7);
+    }
+    while (i < n) : (i += 1) d[i] = @as(u16, s[i]) << 7;
+}
+
+// Approximate 16-bit RGB -> 15-bit Y/U/V (vertical-first scaled path only).
+const VU16 = @Vector(HN, u16);
+inline fn mulhu(a: VU16, b: VU16) VU16 {
+    return @truncate((@as(@Vector(HN, u32), a) * @as(@Vector(HN, u32), b)) >> @splat(16));
+}
+inline fn hi8(x: @Vector(HN, u8)) VU16 {
+    return @as(VU16, x) << @splat(8);
+}
+
+fn inputYFast(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, d: [*]u16, s: [*]const u8, w: usize) void {
+    const t = rgb2yuv;
+    var i: usize = 0;
+    while (i + HN <= w) : (i += HN) {
+        const x: @Vector(HN * bpp, u8) = s[i * bpp ..][0 .. HN * bpp].*;
+        const p = std.simd.deinterlace(bpp, x);
+        const y = mulhu(hi8(p[ro]), @splat(@intCast(t[0]))) +% mulhu(hi8(p[go]), @splat(@intCast(t[1]))) +% mulhu(hi8(p[bo]), @splat(@intCast(t[2]))) +% @as(VU16, @splat(2049));
+        d[i..][0..HN].* = y;
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = s[bpp * i + ro];
+        const g: i32 = s[bpp * i + go];
+        const b: i32 = s[bpp * i + bo];
+        d[i] = @intCast(((t[0] * r + t[1] * g + t[2] * b + (32 << 14) + (1 << 8)) >> 9) << 1);
+    }
+}
+
+fn inputUVHalfFast(comptime bpp: usize, comptime ro: usize, comptime go: usize, comptime bo: usize, du: [*]u16, dv: [*]u16, s: [*]const u8, w: usize, npx: usize) void {
+    const t = rgb2yuv;
+    var i: usize = 0;
+    while (i + HN <= w and 2 * (i + HN) <= npx) : (i += HN) {
+        const x: @Vector(2 * HN * bpp, u8) = s[2 * i * bpp ..][0 .. 2 * HN * bpp].*;
+        const p = std.simd.deinterlace(2 * bpp, x);
+        const r: VH = @bitCast((@as(VU16, p[ro]) + @as(VU16, p[bpp + ro])) << @splat(6));
+        const g: VH = @bitCast((@as(VU16, p[go]) + @as(VU16, p[bpp + go])) << @splat(6));
+        const b: VH = @bitCast((@as(VU16, p[bo]) + @as(VU16, p[bpp + bo])) << @splat(6));
+        const k = hspl(16385);
+        const u = mulhi(r, hspl(2 * t[3])) +% mulhi(g, hspl(2 * t[4])) +% mulhi(b, hspl(2 * t[5])) +% k;
+        const v = mulhi(r, hspl(2 * t[6])) +% mulhi(g, hspl(2 * t[7])) +% mulhi(b, hspl(2 * t[8])) +% k;
+        du[i..][0..HN].* = @bitCast(u);
+        dv[i..][0..HN].* = @bitCast(v);
+    }
+    while (i < w) : (i += 1) {
+        const p0 = 2 * bpp * i;
+        const p1 = if (2 * i + 1 < npx) p0 + bpp else p0;
+        const r: i32 = @as(i32, s[p0 + ro]) + s[p1 + ro];
+        const g: i32 = @as(i32, s[p0 + go]) + s[p1 + go];
+        const b: i32 = @as(i32, s[p0 + bo]) + s[p1 + bo];
+        du[i] = @truncate(@as(u32, @bitCast(((t[3] * r + t[4] * g + t[5] * b + (256 << 15) + (1 << 9)) >> 10) << 1)));
+        dv[i] = @truncate(@as(u32, @bitCast(((t[6] * r + t[7] * g + t[8] * b + (256 << 15) + (1 << 9)) >> 10) << 1)));
+    }
+}
+
+const pmadd_on = true;
+inline fn pmadd(a: @Vector(8, u32), b: @Vector(8, u32)) V8 {
+    const x: @Vector(16, i16) = @bitCast(a);
+    const y: @Vector(16, i16) = @bitCast(b);
+    const p = @as(@Vector(16, i32), x) * @as(@Vector(16, i32), y);
+    const ev = @shuffle(i32, p, undefined, [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 });
+    const od = @shuffle(i32, p, undefined, [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 });
+    return ev + od;
+}
+const fast_on = true;
+const vf_on = true;
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,97 @@
+// libswscale_candidate — pixel-format conversion and scaling tracking FFmpeg's
+// C scalar swscale (default BT.601 limited range, POINT/BILINEAR/BICUBIC).
+
+const std = @import("std");
+const y2r = @import("yuv2rgb.zig");
+const gen = @import("generic.zig");
+const unsc = @import("unscaled.zig");
+
+pub const YUV420P = 0;
+pub const YUV422P = 1;
+pub const YUV444P = 2;
+pub const NV12 = 3;
+pub const NV21 = 4;
+pub const RGB24 = 5;
+pub const BGR24 = 6;
+pub const RGBA = 7;
+pub const BGRA = 8;
+pub const GRAY8 = 9;
+
+const Mode = enum { yuv2rgb, unscaled, generic };
+
+const Ctx = struct {
+    mode: Mode,
+    sw: usize,
+    sh: usize,
+    dw: usize,
+    dh: usize,
+    sf: c_int,
+    df: c_int,
+    g: ?*gen.Generic = null,
+};
+
+fn isRGB(f: c_int) bool {
+    return f >= RGB24 and f <= BGRA;
+}
+
+export fn swscale_create(src_w: c_int, src_h: c_int, src_fmt: c_int, dst_w: c_int, dst_h: c_int, dst_fmt: c_int, algo: c_int) ?*anyopaque {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+    if (src_fmt < 0 or src_fmt > 9 or dst_fmt < 0 or dst_fmt > 9 or algo < 0 or algo > 2) return null;
+    const ctx = std.heap.c_allocator.create(Ctx) catch return null;
+    ctx.* = .{
+        .mode = .generic,
+        .sw = @intCast(src_w),
+        .sh = @intCast(src_h),
+        .dw = @intCast(dst_w),
+        .dh = @intCast(dst_h),
+        .sf = src_fmt,
+        .df = dst_fmt,
+    };
+    const unscaled = src_w == dst_w and src_h == dst_h;
+    if (unscaled) {
+        if ((src_fmt == YUV420P or src_fmt == YUV422P) and isRGB(dst_fmt) and (dst_h & 1) == 0) {
+            ctx.mode = .yuv2rgb;
+        } else if (unsc.supported(src_fmt, dst_fmt, ctx.sw)) {
+            ctx.mode = .unscaled;
+        }
+    }
+    if (ctx.mode == .generic) {
+        ctx.g = gen.Generic.init(ctx.sw, ctx.sh, src_fmt, ctx.dw, ctx.dh, dst_fmt, algo) catch {
+            std.heap.c_allocator.destroy(ctx);
+            return null;
+        };
+    }
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(handle: ?*anyopaque, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int, dst_data: [*]const ?[*]u8, dst_stride: [*]const c_int) c_int {
+    const ctx: *Ctx = @ptrCast(@alignCast(handle orelse return -1));
+    var src: [4][*]const u8 = undefined;
+    var dst: [4][*]u8 = undefined;
+    var ss: [4]isize = undefined;
+    var ds: [4]isize = undefined;
+    const dummy_in: [*]const u8 = @ptrCast(&dummy_byte);
+    for (0..4) |i| {
+        src[i] = src_data[i] orelse dummy_in;
+        dst[i] = dst_data[i] orelse @ptrCast(&dummy_out);
+        ss[i] = src_stride[i];
+        ds[i] = dst_stride[i];
+    }
+    switch (ctx.mode) {
+        .yuv2rgb => y2r.process(ctx.sf, ctx.df, ctx.sw, ctx.sh, .{ src[0], src[1], src[2] }, .{ ss[0], ss[1], ss[2] }, dst[0], ds[0]),
+        .unscaled => unsc.process(ctx.sf, ctx.df, ctx.sw, ctx.sh, src, ss, dst, ds),
+        .generic => ctx.g.?.process(src, ss, dst, ds),
+    }
+    return 0;
+}
+
+var dummy_byte: u8 = 0;
+var dummy_out: [64]u8 = undefined;
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *Ctx = @ptrCast(@alignCast(ptr));
+        if (ctx.g) |g| g.deinit();
+        std.heap.c_allocator.destroy(ctx);
+    }
+}
diff --git a/swscale-impl/src/unscaled.zig b/swscale-impl/src/unscaled.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/unscaled.zig
@@ -0,0 +1,324 @@
+// Same-size special converters (FFmpeg swscale_unscaled.c equivalents).
+const std = @import("std");
+const m = @import("main.zig");
+
+fn isRGB(f: c_int) bool {
+    return f >= m.RGB24 and f <= m.BGRA;
+}
+fn isPlanarYUV(f: c_int) bool {
+    return f == m.YUV420P or f == m.YUV422P or f == m.YUV444P;
+}
+
+pub fn supported(sf: c_int, df: c_int, w: usize) bool {
+    if (sf == m.YUV420P and (df == m.NV12 or df == m.NV21)) return true;
+    if ((sf == m.NV12 or sf == m.NV21) and df == m.YUV420P) return true;
+    if (sf == m.BGR24 and df == m.YUV420P and (w & 1) == 0) return true;
+    if (isRGB(sf) and isRGB(df) and sf != df) return true;
+    if (sf == m.GRAY8 and isRGB(df)) return true;
+    if (sf == df) return true;
+    return false;
+}
+
+inline fn row(p: [*]const u8, stride: isize, y: usize) [*]const u8 {
+    return p + @as(usize, @bitCast(stride * @as(isize, @intCast(y))));
+}
+inline fn rowm(p: [*]u8, stride: isize, y: usize) [*]u8 {
+    return p + @as(usize, @bitCast(stride * @as(isize, @intCast(y))));
+}
+
+fn copyPlane(src: [*]const u8, ss: isize, dst: [*]u8, ds: isize, w: usize, h: usize) void {
+    for (0..h) |y| @memcpy(rowm(dst, ds, y)[0..w], row(src, ss, y)[0..w]);
+}
+fn fillPlane(dst: [*]u8, ds: isize, w: usize, h: usize, v: u8) void {
+    for (0..h) |y| @memset(rowm(dst, ds, y)[0..w], v);
+}
+
+const Layout = struct { bpp: usize, r: usize, g: usize, b: usize, a: ?usize };
+fn layout(f: c_int) Layout {
+    return switch (f) {
+        m.RGB24 => .{ .bpp = 3, .r = 0, .g = 1, .b = 2, .a = null },
+        m.BGR24 => .{ .bpp = 3, .r = 2, .g = 1, .b = 0, .a = null },
+        m.RGBA => .{ .bpp = 4, .r = 0, .g = 1, .b = 2, .a = 3 },
+        else => .{ .bpp = 4, .r = 2, .g = 1, .b = 0, .a = 3 },
+    };
+}
+
+fn chromaDims(f: c_int, w: usize, h: usize) [2]usize {
+    return switch (f) {
+        m.YUV420P, m.NV12, m.NV21 => .{ (w + 1) / 2, (h + 1) / 2 },
+        m.YUV422P => .{ (w + 1) / 2, h },
+        else => .{ w, h },
+    };
+}
+
+pub fn process(sf: c_int, df: c_int, w: usize, h: usize, src: [4][*]const u8, ss: [4]isize, dst: [4][*]u8, ds: [4]isize) void {
+    const cw = (w + 1) / 2;
+    const chh = (h + 1) / 2;
+    if (sf == m.YUV420P and (df == m.NV12 or df == m.NV21)) {
+        copyPlane(src[0], ss[0], dst[0], ds[0], w, h);
+        const u = if (df == m.NV12) src[1] else src[2];
+        const v = if (df == m.NV12) src[2] else src[1];
+        const us = if (df == m.NV12) ss[1] else ss[2];
+        const vs = if (df == m.NV12) ss[2] else ss[1];
+        for (0..chh) |y| interleave(row(u, us, y), row(v, vs, y), rowm(dst[1], ds[1], y), cw);
+        return;
+    }
+    if ((sf == m.NV12 or sf == m.NV21) and df == m.YUV420P) {
+        copyPlane(src[0], ss[0], dst[0], ds[0], w, h);
+        const du = if (sf == m.NV12) dst[1] else dst[2];
+        const dv = if (sf == m.NV12) dst[2] else dst[1];
+        const dus = if (sf == m.NV12) ds[1] else ds[2];
+        const dvs = if (sf == m.NV12) ds[2] else ds[1];
+        for (0..chh) |y| deinterleave(row(src[1], ss[1], y), rowm(du, dus, y), rowm(dv, dvs, y), cw);
+        return;
+    }
+    if (sf == m.BGR24 and df == m.YUV420P) {
+        bgr24ToYv12(src[0], ss[0], dst, ds, w, h);
+        return;
+    }
+    if (isRGB(sf) and isRGB(df)) {
+        rgbToRgb(sf, df, src[0], ss[0], dst[0], ds[0], w, h);
+        return;
+    }
+    if (sf == m.GRAY8 and isRGB(df)) {
+        const L = layout(df);
+        for (0..h) |y| {
+            const s = row(src[0], ss[0], y);
+            const d = rowm(dst[0], ds[0], y);
+            if (L.bpp == 3) grayTo24(s, d, w) else grayTo32(s, d, w);
+        }
+        return;
+    }
+    if (df == m.GRAY8) {
+        copyPlane(src[0], ss[0], dst[0], ds[0], w, h);
+        return;
+    }
+    if (sf == m.GRAY8) {
+        copyPlane(src[0], ss[0], dst[0], ds[0], w, h);
+        const cd = chromaDims(df, w, h);
+        fillPlane(dst[1], ds[1], cd[0], cd[1], 128);
+        fillPlane(dst[2], ds[2], cd[0], cd[1], 128);
+        return;
+    }
+    // same format copy
+    copyPlane(src[0], ss[0], dst[0], ds[0], switch (sf) {
+        m.RGB24, m.BGR24 => w * 3,
+        m.RGBA, m.BGRA => w * 4,
+        else => w,
+    }, h);
+    switch (sf) {
+        m.YUV420P, m.YUV422P, m.YUV444P => {
+            const cd = chromaDims(sf, w, h);
+            copyPlane(src[1], ss[1], dst[1], ds[1], cd[0], cd[1]);
+            copyPlane(src[2], ss[2], dst[2], ds[2], cd[0], cd[1]);
+        },
+        m.NV12, m.NV21 => copyPlane(src[1], ss[1], dst[1], ds[1], cw * 2, chh),
+        else => {},
+    }
+}
+
+fn interleave(u: [*]const u8, v: [*]const u8, d: [*]u8, n: usize) void {
+    var i: usize = 0;
+    while (i + 32 <= n) : (i += 32) {
+        const a: @Vector(32, u8) = u[i..][0..32].*;
+        const b: @Vector(32, u8) = v[i..][0..32].*;
+        const lo = std.simd.interlace(.{ a, b });
+        d[2 * i ..][0..64].* = lo;
+    }
+    while (i < n) : (i += 1) {
+        d[2 * i] = u[i];
+        d[2 * i + 1] = v[i];
+    }
+}
+
+fn deinterleave(s: [*]const u8, u: [*]u8, v: [*]u8, n: usize) void {
+    var i: usize = 0;
+    while (i + 32 <= n) : (i += 32) {
+        const x: @Vector(64, u8) = s[2 * i ..][0..64].*;
+        const parts = std.simd.deinterlace(2, x);
+        u[i..][0..32].* = parts[0];
+        v[i..][0..32].* = parts[1];
+    }
+    while (i < n) : (i += 1) {
+        u[i] = s[2 * i];
+        v[i] = s[2 * i + 1];
+    }
+}
+
+fn grayTo24(s: [*]const u8, d: [*]u8, w: usize) void {
+    var i: usize = 0;
+    while (i + 32 <= w) : (i += 32) {
+        const g: @Vector(32, u8) = s[i..][0..32].*;
+        d[3 * i ..][0..96].* = std.simd.interlace(.{ g, g, g });
+    }
+    while (i < w) : (i += 1) {
+        d[3 * i] = s[i];
+        d[3 * i + 1] = s[i];
+        d[3 * i + 2] = s[i];
+    }
+}
+fn grayTo32(s: [*]const u8, d: [*]u8, w: usize) void {
+    var i: usize = 0;
+    const ff: @Vector(32, u8) = @splat(255);
+    while (i + 32 <= w) : (i += 32) {
+        const g: @Vector(32, u8) = s[i..][0..32].*;
+        d[4 * i ..][0..128].* = std.simd.interlace(.{ g, g, g, ff });
+    }
+    while (i < w) : (i += 1) {
+        d[4 * i] = s[i];
+        d[4 * i + 1] = s[i];
+        d[4 * i + 2] = s[i];
+        d[4 * i + 3] = 255;
+    }
+}
+
+fn rgbToRgb(sf: c_int, df: c_int, src: [*]const u8, ss: isize, dst: [*]u8, ds: isize, w: usize, h: usize) void {
+    const S = layout(sf);
+    const D = layout(df);
+    for (0..h) |y| {
+        const s = row(src, ss, y);
+        const d = rowm(dst, ds, y);
+        switch (S.bpp * 10 + D.bpp) {
+            33 => conv(3, 3, S, D, s, d, w),
+            34 => conv(3, 4, S, D, s, d, w),
+            43 => conv(4, 3, S, D, s, d, w),
+            else => conv(4, 4, S, D, s, d, w),
+        }
+    }
+}
+
+inline fn conv(comptime sb: usize, comptime db: usize, S: Layout, D: Layout, s: [*]const u8, d: [*]u8, w: usize) void {
+    const N = 32;
+    var i: usize = 0;
+    const ff: @Vector(N, u8) = @splat(255);
+    if (S.r == 0) {
+        if (D.r == 0) convT(sb, db, false, false, s, d, w, &i, ff) else convT(sb, db, false, true, s, d, w, &i, ff);
+    } else {
+        if (D.r == 0) convT(sb, db, true, false, s, d, w, &i, ff) else convT(sb, db, true, true, s, d, w, &i, ff);
+    }
+    while (i < w) : (i += 1) {
+        d[db * i + D.r] = s[sb * i + S.r];
+        d[db * i + D.g] = s[sb * i + S.g];
+        d[db * i + D.b] = s[sb * i + S.b];
+        if (D.a) |a| d[db * i + a] = if (S.a) |sa| s[sb * i + sa] else 255;
+    }
+}
+
+fn convMask(comptime sb: usize, comptime db: usize, comptime sbgr: bool, comptime dbgr: bool) [32]i32 {
+    @setEvalBranchQuota(20000);
+    var mk: [32]i32 = undefined;
+    for (0..2) |L| {
+        const base: usize = if (sb == 3 and L == 0) 4 else 0;
+        for (0..16) |j| {
+            const k = j / db;
+            const c = j % db;
+            if (k >= 4) {
+                mk[L * 16 + j] = @intCast(L * 16);
+                continue;
+            }
+            // dst channel c -> logical channel (0=r,1=g,2=b,3=a)
+            const logical: usize = if (c == 3) 3 else if (dbgr) 2 - c else c;
+            if (logical == 3 and sb == 3) {
+                mk[L * 16 + j] = -1; // from the 0xff vector
+                continue;
+            }
+            const so: usize = if (logical == 3) 3 else if (sbgr) 2 - logical else logical;
+            mk[L * 16 + j] = @intCast(L * 16 + base + sb * k + so);
+        }
+    }
+    return mk;
+}
+
+inline fn convBlock(comptime sb: usize, comptime db: usize, comptime sbgr: bool, comptime dbgr: bool, s: [*]const u8, d: [*]u8, i: usize, ff: @Vector(32, u8)) void {
+    const off: usize = if (sb == 3) 4 else 0;
+    const x: @Vector(32, u8) = (s + sb * i - off)[0..32].*;
+    const y = @shuffle(u8, x, ff, convMask(sb, db, sbgr, dbgr));
+    if (db == 3) {
+        const y32: @Vector(8, u32) = @bitCast(y);
+        const z = @shuffle(u32, y32, undefined, [8]i32{ 0, 1, 2, 4, 5, 6, 7, 7 });
+        (d + 3 * i)[0..32].* = @bitCast(z);
+    } else {
+        (d + 4 * i)[0..32].* = y;
+    }
+}
+
+inline fn convT(comptime sb: usize, comptime db: usize, comptime sbgr: bool, comptime dbgr: bool, s: [*]const u8, d: [*]u8, w: usize, ip: *usize, ff: @Vector(32, u8)) void {
+    // Per 8 pixels: one 32-byte load, one in-lane byte shuffle (vpshufb), [vpermd compaction], one store.
+    if (w < 16) {
+        ip.* = 0;
+        return;
+    }
+    var i: usize = 0;
+    if (sb == 3) {
+        // first 2 pixels scalar so the (-4) offset load stays in bounds
+        inline for (0..2) |k| {
+            const sr = if (sbgr) 2 else 0;
+            const sbb = if (sbgr) 0 else 2;
+            const dr = if (dbgr) 2 else 0;
+            const dbb = if (dbgr) 0 else 2;
+            d[db * k + dr] = s[sb * k + sr];
+            d[db * k + 1] = s[sb * k + 1];
+            d[db * k + dbb] = s[sb * k + sbb];
+            if (db == 4) d[db * k + 3] = 255;
+        }
+        i = 2;
+    }
+    while (i + 35 <= w) : (i += 32) {
+        convBlock(sb, db, sbgr, dbgr, s, d, i, ff);
+        convBlock(sb, db, sbgr, dbgr, s, d, i + 8, ff);
+        convBlock(sb, db, sbgr, dbgr, s, d, i + 16, ff);
+        convBlock(sb, db, sbgr, dbgr, s, d, i + 24, ff);
+    }
+    while (i + 11 <= w) : (i += 8) {
+        convBlock(sb, db, sbgr, dbgr, s, d, i, ff);
+    }
+    // final overlapping block (idempotent rewrite)
+    const last = w - 11;
+    convBlock(sb, db, sbgr, dbgr, s, d, last, ff);
+    ip.* = last + 8;
+}
+
+fn bgr24ToYv12(src: [*]const u8, ss: isize, dst: [4][*]u8, ds: [4]isize, w: usize, h: usize) void {
+    const t = @import("generic.zig").rgb2yuv;
+    const ry = t[0];
+    const gy = t[1];
+    const by = t[2];
+    const ru = t[3];
+    const gu = t[4];
+    const bu = t[5];
+    const rv = t[6];
+    const gv = t[7];
+    const bv = t[8];
+    var y: usize = 0;
+    while (y + 1 < h) : (y += 2) {
+        const s1 = row(src, ss, y);
+        const s2 = row(src, ss, y + 1);
+        const y1 = rowm(dst[0], ds[0], y);
+        const y2 = rowm(dst[0], ds[0], y + 1);
+        const ud = rowm(dst[1], ds[1], y / 2);
+        const vd = rowm(dst[2], ds[2], y / 2);
+        for (0..w / 2) |i| {
+            const b11: i32 = s1[6 * i + 0];
+            const g11: i32 = s1[6 * i + 1];
+            const r11: i32 = s1[6 * i + 2];
+            const b12: i32 = s1[6 * i + 3];
+            const g12: i32 = s1[6 * i + 4];
+            const r12: i32 = s1[6 * i + 5];
+            const b21: i32 = s2[6 * i + 0];
+            const g21: i32 = s2[6 * i + 1];
+            const r21: i32 = s2[6 * i + 2];
+            const b22: i32 = s2[6 * i + 3];
+            const g22: i32 = s2[6 * i + 4];
+            const r22: i32 = s2[6 * i + 5];
+            y1[2 * i] = @truncate(@as(u32, @bitCast(((ry * r11 + gy * g11 + by * b11) >> 15) + 16)));
+            y1[2 * i + 1] = @truncate(@as(u32, @bitCast(((ry * r12 + gy * g12 + by * b12) >> 15) + 16)));
+            y2[2 * i] = @truncate(@as(u32, @bitCast(((ry * r21 + gy * g21 + by * b21) >> 15) + 16)));
+            y2[2 * i + 1] = @truncate(@as(u32, @bitCast(((ry * r22 + gy * g22 + by * b22) >> 15) + 16)));
+            const bx = (b11 + b12 + b21 + b22) >> 2;
+            const gx = (g11 + g12 + g21 + g22) >> 2;
+            const rx = (r11 + r12 + r21 + r22) >> 2;
+            ud[i] = @truncate(@as(u32, @bitCast(((ru * rx + gu * gx + bu * bx) >> 15) + 128)));
+            vd[i] = @truncate(@as(u32, @bitCast(((rv * rx + gv * gx + bv * bx) >> 15) + 128)));
+        }
+    }
+}
diff --git a/swscale-impl/src/yuv2rgb.zig b/swscale-impl/src/yuv2rgb.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/yuv2rgb.zig
@@ -0,0 +1,474 @@
+// Unscaled YUV420P/YUV422P -> packed RGB (FFmpeg yuv2rgb.c table converter equivalent).
+//
+// Closed form of ff_yuv2rgb_c_init_tables (BT.601, limited range, default
+// brightness/contrast/saturation):
+//   channel_c(Y,U,V) = clip_u8(((Y + d_c) * CY + C0) >> 16)
+// where d_c is the per-chroma table offset computed exactly like fill_table().
+
+const std = @import("std");
+
+const CY: i64 = @divTrunc((1 << 16) * 255, 219); // 76309
+const OY: i64 = 16 << 16;
+
+fn scaleCoef(c: i64) i64 {
+    return @divTrunc(c * (1 << 16) + 0x8000, CY);
+}
+const CRV: i64 = scaleCoef(104597);
+const CBU: i64 = scaleCoef(132201);
+const CGU: i64 = scaleCoef(-25675);
+const CGV: i64 = scaleCoef(-53279);
+
+// y_table index base: yoffs = 326 + 512; y_table[i] = clip((-(384<<16) - 512*CY - OY + i*CY + 0x8000) >> 16)
+// => for i = yoffs + x: clip((x*CY + C0) >> 16)
+const C0: i64 = 326 * CY - (384 << 16) - OY + 0x8000;
+
+inline fn dR(v: i64) i64 {
+    return -(CRV >> 9) + ((v * CRV) >> 16);
+}
+inline fn dG(u: i64, v: i64) i64 {
+    return -(CGU >> 9) + ((u * CGU) >> 16) - (CGV >> 9) + ((v * CGV) >> 16);
+}
+inline fn dB(u: i64) i64 {
+    return -(CBU >> 9) + ((u * CBU) >> 16);
+}
+
+inline fn clipU8(x: i64) u8 {
+    return @intCast(@max(0, @min(255, x)));
+}
+
+inline fn chan(y: i64, d: i64) u8 {
+    return clipU8(((y + d) * CY + C0) >> 16);
+}
+
+inline fn clampIdx(x: i32) i64 {
+    return @max(0, @min(255, x));
+}
+
+/// Exact {R,G,B} that FFmpeg's 24-bit yuv2rgb tables give for r[Y]/g[Y]/b[Y]
+/// with tables selected by U,V (U,V clamped to 0..255 as fill_table does).
+pub inline fn tablePixel(y: i32, u: i32, v: i32) [3]u8 {
+    const uu = clampIdx(u);
+    const vv = clampIdx(v);
+    const yy: i64 = y;
+    return .{ chan(yy, dR(vv)), chan(yy, dG(uu, vv)), chan(yy, dB(uu)) };
+}
+
+/// Vector version of tablePixel.
+pub inline fn tablePixelV(comptime N: usize, y: @Vector(N, i32), u: @Vector(N, i32), v: @Vector(N, i32)) [3]@Vector(N, u8) {
+    const V = @Vector(N, i32);
+    const zero: V = @splat(0);
+    const ff: V = @splat(255);
+    const uu = @max(zero, @min(ff, u));
+    const vv = @max(zero, @min(ff, v));
+    const dr = @as(V, @splat(@intCast(-(CRV >> 9)))) + ((vv * @as(V, @splat(@intCast(CRV)))) >> @splat(16));
+    const dg = @as(V, @splat(@intCast(-(CGU >> 9) - (CGV >> 9)))) +
+        ((uu * @as(V, @splat(@intCast(CGU)))) >> @splat(16)) +
+        ((vv * @as(V, @splat(@intCast(CGV)))) >> @splat(16));
+    const db = @as(V, @splat(@intCast(-(CBU >> 9)))) + ((uu * @as(V, @splat(@intCast(CBU)))) >> @splat(16));
+    const cy: V = @splat(@intCast(CY));
+    const c0: V = @splat(@intCast(C0));
+    // (y+d)*CY fits i32 for |y+d| < ~28000.
+    const r = @max(zero, @min(ff, ((y + dr) * cy + c0) >> @splat(16)));
+    const g = @max(zero, @min(ff, ((y + dg) * cy + c0) >> @splat(16)));
+    const b = @max(zero, @min(ff, ((y + db) * cy + c0) >> @splat(16)));
+    return .{ @intCast(r), @intCast(g), @intCast(b) };
+}
+
+// ---------------------------------------------------------------------------
+
+fn rowScalar(comptime dst_fmt: c_int, w: usize, py: [*]const u8, pu: [*]const u8, pv: [*]const u8, d: [*]u8) void {
+    var x: usize = 0;
+    while (x < w) : (x += 2) {
+        const u: i64 = pu[x >> 1];
+        const v: i64 = pv[x >> 1];
+        const dr = dR(v);
+        const dg = dG(u, v);
+        const db = dB(u);
+        inline for (0..2) |k| {
+            const yy: i64 = py[x + k];
+            const r = chan(yy, dr);
+            const g = chan(yy, dg);
+            const b = chan(yy, db);
+            const i = x + k;
+            switch (dst_fmt) {
+                5 => {
+                    d[3 * i] = r;
+                    d[3 * i + 1] = g;
+                    d[3 * i + 2] = b;
+                },
+                6 => {
+                    d[3 * i] = b;
+                    d[3 * i + 1] = g;
+                    d[3 * i + 2] = r;
+                },
+                7 => {
+                    d[4 * i] = r;
+                    d[4 * i + 1] = g;
+                    d[4 * i + 2] = b;
+                    d[4 * i + 3] = 255;
+                },
+                else => {
+                    d[4 * i] = b;
+                    d[4 * i + 1] = g;
+                    d[4 * i + 2] = r;
+                    d[4 * i + 3] = 255;
+                },
+            }
+        }
+    }
+}
+
+const V8 = @Vector(8, i32);
+const V16i = @Vector(16, i16);
+
+inline fn spl8(comptime x: i64) V8 {
+    return @splat(@as(i32, @intCast(x)));
+}
+
+const Chroma = struct { r: V8, g: V8, b: V8 };
+
+// E_c = d_c*CY + C0, so that (Y+d_c)*CY + C0 = Y*65536 + Y*(CY-65536) + E_c.
+inline fn loadChroma(pu: [*]const u8, pv: [*]const u8) Chroma {
+    const u: V8 = @as(@Vector(8, u8), pu[0..8].*);
+    const v: V8 = @as(@Vector(8, u8), pv[0..8].*);
+    const s16: @Vector(8, u5) = @splat(16);
+    const r = ((v * spl8(CRV)) >> s16) * spl8(CY) + spl8(C0 - (CRV >> 9) * CY);
+    const b = ((u * spl8(CBU)) >> s16) * spl8(CY) + spl8(C0 - (CBU >> 9) * CY);
+    const g = (((u * spl8(CGU)) >> s16) + ((v * spl8(CGV)) >> s16)) * spl8(CY) + spl8(C0 - ((CGU >> 9) + (CGV >> 9)) * CY);
+    return .{ .r = r, .g = g, .b = b };
+}
+
+const hiMask: [16]i32 = blk: {
+    var m: [16]i32 = undefined;
+    for (0..8) |j| {
+        m[2 * j] = 2 * j + 1;
+        m[2 * j + 1] = ~@as(i32, 2 * j + 1);
+    }
+    break :blk m;
+};
+
+inline fn chanV(pe: V8, po: V8, e: V8, yw: V16i) V16i {
+    const te: V16i = @bitCast(pe + e);
+    const to: V16i = @bitCast(po + e);
+    const hi = @shuffle(i16, te, to, hiMask);
+    return hi + yw;
+}
+
+// packuswb ymm semantics: [a0-7, b0-7 | a8-15, b8-15]
+inline fn packus(x: V16i, y: V16i) @Vector(32, u8) {
+    const z: V16i = @splat(0);
+    const f: V16i = @splat(255);
+    const xs: @Vector(16, u8) = @intCast(@min(@max(x, z), f));
+    const ys: @Vector(16, u8) = @intCast(@min(@max(y, z), f));
+    return @shuffle(u8, xs, ys, packMask);
+}
+const packMask: [32]i32 = blk: {
+    var m: [32]i32 = undefined;
+    for (0..8) |i| {
+        m[i] = i;
+        m[8 + i] = ~@as(i32, i);
+        m[16 + i] = 8 + i;
+        m[24 + i] = ~@as(i32, 8 + i);
+    }
+    break :blk m;
+};
+// In-lane (128-bit) unpack lo/hi of an n-element vector pair.
+fn unpackMask(comptime n: usize, comptime hi: bool) [n]i32 {
+    var m: [n]i32 = undefined;
+    const per_lane = n / 2;
+    const half = per_lane / 2;
+    for (0..2) |l| {
+        for (0..half) |i| {
+            const src = l * per_lane + (if (hi) half else 0) + i;
+            m[l * per_lane + 2 * i] = @intCast(src);
+            m[l * per_lane + 2 * i + 1] = ~@as(i32, @intCast(src));
+        }
+    }
+    return m;
+}
+
+inline fn interleave4(p0: @Vector(32, u8), p1: @Vector(32, u8)) [2]@Vector(32, u8) {
+    // p0 = [c0 0-7, c2 0-7 | c0 8-15, c2 8-15], p1 = [c1 .., c3 ..]
+    const lo = @shuffle(u8, p0, p1, unpackMask(32, false));
+    const hi = @shuffle(u8, p0, p1, unpackMask(32, true));
+    const lo16: @Vector(16, u16) = @bitCast(lo);
+    const hi16: @Vector(16, u16) = @bitCast(hi);
+    const q0: @Vector(32, u8) = @bitCast(@shuffle(u16, lo16, hi16, unpackMask(16, false))); // px0-3 | px8-11
+    const q1: @Vector(32, u8) = @bitCast(@shuffle(u16, lo16, hi16, unpackMask(16, true))); // px4-7 | px12-15
+    return .{ q0, q1 };
+}
+
+inline fn toU8(x: V16i) @Vector(16, u8) {
+    const z: V16i = @splat(0);
+    const f: V16i = @splat(255);
+    return @intCast(@min(@max(x, z), f));
+}
+
+const rgb24Mask: [48]i32 = blk: {
+    var m: [48]i32 = undefined;
+    for (0..16) |i| {
+        m[3 * i] = i;
+        m[3 * i + 1] = 16 + i;
+        m[3 * i + 2] = ~@as(i32, i);
+    }
+    break :blk m;
+};
+const rgbaMask: [64]i32 = blk: {
+    var m: [64]i32 = undefined;
+    for (0..16) |i| {
+        m[4 * i] = i;
+        m[4 * i + 1] = 16 + i;
+        m[4 * i + 2] = ~@as(i32, i);
+        m[4 * i + 3] = ~@as(i32, 16 + i);
+    }
+    break :blk m;
+};
+
+inline fn block16(comptime dst_fmt: c_int, py: [*]const u8, ch: Chroma, d: [*]u8) void {
+    const y8: @Vector(16, u8) = py[0..16].*;
+    const yw: V16i = @intCast(@as(@Vector(16, u16), y8));
+    const y32: @Vector(8, u32) = @bitCast(yw);
+    const ye: V8 = @intCast(y32 & @as(@Vector(8, u32), @splat(0xffff)));
+    const yo: V8 = @intCast(y32 >> @splat(16));
+    const pe = ye * spl8(CY - 65536);
+    const po = yo * spl8(CY - 65536);
+    const r = chanV(pe, po, ch.r, yw);
+    const g = chanV(pe, po, ch.g, yw);
+    const b = chanV(pe, po, ch.b, yw);
+    const a: V16i = @splat(255);
+    const q = switch (dst_fmt) {
+        5, 7 => interleave4(packus(r, b), packus(g, a)),
+        else => interleave4(packus(b, r), packus(g, a)),
+    };
+    if (dst_fmt == 7 or dst_fmt == 8) {
+        d[0..16].* = std.simd.extract(q[0], 0, 16);
+        d[16..32].* = std.simd.extract(q[1], 0, 16);
+        d[32..48].* = std.simd.extract(q[0], 16, 16);
+        d[48..64].* = std.simd.extract(q[1], 16, 16);
+    } else {
+        const all = std.simd.join(@shuffle(u8, q[0], q[1], lanecat), @shuffle(u8, q[0], q[1], lanecat2));
+        d[0..48].* = @shuffle(u8, all, undefined, rgbx2rgb);
+    }
+}
+
+const lanecat: [32]i32 = blk: {
+    var m: [32]i32 = undefined;
+    for (0..16) |i| {
+        m[i] = i;
+        m[16 + i] = ~@as(i32, i);
+    }
+    break :blk m;
+};
+const lanecat2: [32]i32 = blk: {
+    var m: [32]i32 = undefined;
+    for (0..16) |i| {
+        m[i] = 16 + i;
+        m[16 + i] = ~@as(i32, 16 + i);
+    }
+    break :blk m;
+};
+const rgbx2rgb: [48]i32 = blk: {
+    var m: [48]i32 = undefined;
+    for (0..16) |i| {
+        m[3 * i] = 4 * i;
+        m[3 * i + 1] = 4 * i + 1;
+        m[3 * i + 2] = 4 * i + 2;
+    }
+    break :blk m;
+};
+
+const joinMask: [32]i32 = blk: {
+    var m: [32]i32 = undefined;
+    for (0..16) |i| {
+        m[i] = i;
+        m[16 + i] = ~@as(i32, i);
+    }
+    break :blk m;
+};
+
+// ---------------------------------------------------------------------------
+// 32-pixel 16-bit path.
+// For t = Y + d_c in [-221, 475] (all Y in 0..255, all chroma), exhaustively verified:
+//   ((t*CY + C0) >> 16) == ((10*t - 171) * 7631) >> 16   (pmulhw)
+// so channel = clip(mulhi_s16(10*Y + D_c, 7631)) with D_c = 10*d_c - 171.
+const U16 = @Vector(16, u16);
+const I16 = @Vector(16, i16);
+const U32x16 = @Vector(16, u32);
+const I32x16 = @Vector(16, i32);
+
+inline fn mulhu(x: U16, comptime k: u32) U16 {
+    return @truncate((@as(U32x16, x) * @as(U32x16, @splat(k))) >> @splat(16));
+}
+inline fn mulhs(x: I16, comptime k: i32) I16 {
+    return @truncate((@as(I32x16, x) * @as(I32x16, @splat(k))) >> @splat(16));
+}
+inline fn spl16(comptime x: i64) I16 {
+    return @splat(@as(i16, @intCast(x)));
+}
+
+const dperm = [8]i32{ 0, 2, 4, 6, 1, 3, 5, 7 };
+
+// 16 chroma samples -> u16 words in "dperm" order.
+inline fn loadC16(p: [*]const u8) I16 {
+    // vbroadcasti128 + vpshufb (zero-extends and permutes in one in-lane shuffle)
+    const c: @Vector(16, u8) = p[0..16].*;
+    const z: @Vector(16, u8) = @splat(0);
+    return @bitCast(@shuffle(u8, c, z, cMask));
+}
+fn zextMask(comptime order: [16]i32) [32]i32 {
+    var m: [32]i32 = undefined;
+    for (0..16) |i| {
+        m[2 * i] = order[i];
+        m[2 * i + 1] = -1;
+    }
+    return m;
+}
+const cMask = zextMask(.{ 0, 1, 4, 5, 8, 9, 12, 13, 2, 3, 6, 7, 10, 11, 14, 15 });
+const yMask = zextMask(.{ 0, 1, 2, 3, 8, 9, 10, 11, 4, 5, 6, 7, 12, 13, 14, 15 });
+
+const Chroma16 = struct { r: I16, g: I16, b: I16 };
+
+inline fn chroma16(pu: [*]const u8, pv: [*]const u8, oz: @Vector(32, u8)) Chroma16 {
+    // OR with opaque zero: hides the known-nonnegative range so LLVM keeps plain vpmulhw.
+    const ozw: I16 = @bitCast(oz);
+    const u = loadC16(pu) | ozw;
+    const v = loadC16(pv) | ozw;
+    const ten = spl16(10);
+    // All products via signed pmulhw: for 0<=x<256, floor(x*k/65536) = mulhs(x, k) (k<32768)
+    // or mulhs(x, k-65536) + x (32768<=k<65536).
+    // d_r = v + floor(v*(CRV-65536)/65536) - (CRV>>9)
+    const r = (v +% mulhs(v, CRV - 65536)) *% ten +% spl16(-10 * (CRV >> 9) - 171);
+    // d_b = u + floor(u*(CBU-65536)/65536) - (CBU>>9) = 2u + mulhs(u, CBU-131072) - (CBU>>9)
+    const b = (u +% u +% mulhs(u, CBU - 131072)) *% ten +% spl16(-10 * (CBU >> 9) - 171);
+    // floor(u*CGU/65536) = mulhs(u, CGU) (CGU > -32768); floor(v*CGV/65536) = mulhs(v, CGV+65536) - v
+    const g = (mulhs(u, CGU) +% mulhs(v, CGV + 65536) -% v) *% ten +% spl16(-10 * ((CGU >> 9) + (CGV >> 9)) - 171);
+    return .{ .r = r, .g = g, .b = b };
+}
+
+inline fn dupLo(x: I16) I16 {
+    return @shuffle(i16, x, x, unpackMask(16, false));
+}
+inline fn dupHi(x: I16) I16 {
+    return @shuffle(i16, x, x, unpackMask(16, true));
+}
+
+const rgbxCompress: [32]i32 = blk: {
+    var m: [32]i32 = undefined;
+    for (0..2) |l| {
+        for (0..16) |j| {
+            m[l * 16 + j] = if (j < 12) @intCast(l * 16 + (j / 3) * 4 + j % 3) else @intCast(l * 16);
+        }
+    }
+    break :blk m;
+};
+
+inline fn store24of(d: [*]u8, v0: @Vector(32, u8), oz: @Vector(32, u8)) void {
+    // volatile round-trip stops LLVM from fusing this with the unpack network
+    // (its fused form costs 2x vpshufb + 2x vpermd + vpblendvb per 24 bytes).
+    _ = oz;
+    var tmp: @Vector(32, u8) = v0;
+    const vp: *volatile @Vector(32, u8) = &tmp;
+    const v = vp.*;
+    const c = @shuffle(u8, v, undefined, rgbxCompress);
+    const c32: @Vector(8, u32) = @bitCast(c);
+    d[0..32].* = @bitCast(@shuffle(u32, c32, undefined, [8]i32{ 0, 1, 2, 4, 5, 6, 7, 7 }));
+}
+
+// Writes 32 pixels. For 3-byte formats it writes 8 bytes past the 96-byte block.
+inline fn block32(comptime dst_fmt: c_int, py: [*]const u8, ch: Chroma16, d: [*]u8, oz: @Vector(32, u8)) void {
+    const z16: @Vector(16, u8) = @splat(0);
+    const ylo: @Vector(16, u8) = py[0..16].*;
+    const yhi: @Vector(16, u8) = py[16..32].*;
+    const ya: I16 = @bitCast(@shuffle(u8, ylo, z16, yMask));
+    const yb: I16 = @bitCast(@shuffle(u8, yhi, z16, yMask));
+    const ya10 = ya *% spl16(10);
+    const yb10 = yb *% spl16(10);
+    const ra = mulhs(ya10 +% dupLo(ch.r), 7631);
+    const rb = mulhs(yb10 +% dupHi(ch.r), 7631);
+    const ga = mulhs(ya10 +% dupLo(ch.g), 7631);
+    const gb = mulhs(yb10 +% dupHi(ch.g), 7631);
+    const ba = mulhs(ya10 +% dupLo(ch.b), 7631);
+    const bb = mulhs(yb10 +% dupHi(ch.b), 7631);
+    const r8 = packus(ra, rb);
+    const g8 = packus(ga, gb);
+    const b8 = packus(ba, bb);
+    const a8: @Vector(32, u8) = @splat(255);
+    const c0 = if (dst_fmt == 5 or dst_fmt == 7) r8 else b8;
+    const c2 = if (dst_fmt == 5 or dst_fmt == 7) b8 else r8;
+    const rgl: @Vector(16, u16) = @bitCast(@shuffle(u8, c0, g8, unpackMask(32, false)));
+    const rgh: @Vector(16, u16) = @bitCast(@shuffle(u8, c0, g8, unpackMask(32, true)));
+    const bal: @Vector(16, u16) = @bitCast(@shuffle(u8, c2, a8, unpackMask(32, false)));
+    const bah: @Vector(16, u16) = @bitCast(@shuffle(u8, c2, a8, unpackMask(32, true)));
+    const v1: @Vector(32, u8) = @bitCast(@shuffle(u16, rgl, bal, unpackMask(16, false)));
+    const v2: @Vector(32, u8) = @bitCast(@shuffle(u16, rgl, bal, unpackMask(16, true)));
+    const v3: @Vector(32, u8) = @bitCast(@shuffle(u16, rgh, bah, unpackMask(16, false)));
+    const v4: @Vector(32, u8) = @bitCast(@shuffle(u16, rgh, bah, unpackMask(16, true)));
+    if (dst_fmt == 7 or dst_fmt == 8) {
+        d[0..32].* = v1;
+        d[32..64].* = v2;
+        d[64..96].* = v3;
+        d[96..128].* = v4;
+    } else {
+        store24of(d, v1, oz);
+        store24of(d + 24, v2, oz);
+        store24of(d + 48, v3, oz);
+        store24of(d + 72, v4, oz);
+    }
+}
+
+var opaque_zero: @Vector(32, u8) = @splat(0);
+
+fn processT(comptime dst_fmt: c_int, comptime is422: bool, w: usize, h: usize, src: [3][*]const u8, sstride: [3]isize, dst: [*]u8, dstride: isize) void {
+    const bpp: usize = if (dst_fmt == 5 or dst_fmt == 6) 3 else 4;
+    const wv = w & ~@as(usize, 15);
+    const w32slack: usize = if (bpp == 3) 35 else 32;
+    const oz: @Vector(32, u8) = @as(*volatile const @Vector(32, u8), &opaque_zero).*;
+    var y: usize = 0;
+    while (y < h) : (y += 2) {
+        const iy: isize = @intCast(y);
+        const icy: isize = if (is422) iy else iy >> 1;
+        const py0 = src[0] + @as(usize, @bitCast(iy * sstride[0]));
+        const py1 = src[0] + @as(usize, @bitCast((iy + 1) * sstride[0]));
+        const pu0 = src[1] + @as(usize, @bitCast(icy * sstride[1]));
+        const pv0 = src[2] + @as(usize, @bitCast(icy * sstride[2]));
+        const pu1 = if (is422) src[1] + @as(usize, @bitCast((icy + 1) * sstride[1])) else pu0;
+        const pv1 = if (is422) src[2] + @as(usize, @bitCast((icy + 1) * sstride[2])) else pv0;
+        const d0 = dst + @as(usize, @bitCast(iy * dstride));
+        const d1 = dst + @as(usize, @bitCast((iy + 1) * dstride));
+        var x: usize = 0;
+        while (x + w32slack <= w) : (x += 32) {
+            const c0 = chroma16(pu0 + (x >> 1), pv0 + (x >> 1), oz);
+            block32(dst_fmt, py0 + x, c0, d0 + x * bpp, oz);
+            const c1 = if (is422) chroma16(pu1 + (x >> 1), pv1 + (x >> 1), oz) else c0;
+            block32(dst_fmt, py1 + x, c1, d1 + x * bpp, oz);
+        }
+        while (x < wv) : (x += 16) {
+            const c0 = loadChroma(pu0 + (x >> 1), pv0 + (x >> 1));
+            block16(dst_fmt, py0 + x, c0, d0 + x * bpp);
+            const c1 = if (is422) loadChroma(pu1 + (x >> 1), pv1 + (x >> 1)) else c0;
+            block16(dst_fmt, py1 + x, c1, d1 + x * bpp);
+        }
+        if (x < w) {
+            rowScalar(dst_fmt, w - x, py0 + x, pu0 + (x >> 1), pv0 + (x >> 1), d0 + x * bpp);
+            rowScalar(dst_fmt, w - x, py1 + x, pu1 + (x >> 1), pv1 + (x >> 1), d1 + x * bpp);
+        }
+    }
+}
+
+pub fn process(src_fmt: c_int, dst_fmt: c_int, w: usize, h: usize, src: [3][*]const u8, sstride: [3]isize, dst: [*]u8, dstride: isize) void {
+    if (src_fmt == 1) {
+        switch (dst_fmt) {
+            5 => processT(5, true, w, h, src, sstride, dst, dstride),
+            6 => processT(6, true, w, h, src, sstride, dst, dstride),
+            7 => processT(7, true, w, h, src, sstride, dst, dstride),
+            else => processT(8, true, w, h, src, sstride, dst, dstride),
+        }
+    } else {
+        switch (dst_fmt) {
+            5 => processT(5, false, w, h, src, sstride, dst, dstride),
+            6 => processT(6, false, w, h, src, sstride, dst, dstride),
+            7 => processT(7, false, w, h, src, sstride, dst, dstride),
+            else => processT(8, false, w, h, src, sstride, dst, dstride),
+        }
+    }
+}
