+d0_c = bytearray(sw*sh)
+d1_c = bytearray(sw*sh//4)
+d2_c = bytearray(sw*sh//4)
+d_ptrs_c = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0_c)).from_buffer(d0_c), ctypes.c_char_p),
+                                 ctypes.cast((ctypes.c_char*len(d1_c)).from_buffer(d1_c), ctypes.c_char_p),
+                                 ctypes.cast((ctypes.c_char*len(d2_c)).from_buffer(d2_c), ctypes.c_char_p), None)
+cand_lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs_c, d_str)
+cand_lib.swscale_destroy(ctx)
+
+print("c028 Y PSNR:", workloads.psnr(ref_y, bytes(d0_c)))
+print("c028 U PSNR:", workloads.psnr(ref_u, bytes(d1_c)))
+print("c028 V PSNR:", workloads.psnr(ref_v, bytes(d2_c)))
+print("ref_y[:8]: ", list(ref_y[:8]))
+print("cand_y[:8]:", list(d0_c[:8]))
+print("ref_u[:8]: ", list(ref_u[:8]))
+print("cand_u[:8]:", list(d1_c[:8]))
diff --git a/swscale-impl/src/formats.zig b/swscale-impl/src/formats.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/formats.zig
@@ -0,0 +1,48 @@
+const std = @import("std");
+
+pub const PixFmt = enum(c_int) {
+    yuv420p = 0,
+    yuv422p = 1,
+    yuv444p = 2,
+    nv12 = 3,
+    nv21 = 4,
+    rgb24 = 5,
+    bgr24 = 6,
+    rgba = 7,
+    bgra = 8,
+    gray8 = 9,
+};
+
+pub const Algo = enum(c_int) {
+    nearest = 0,
+    bilinear = 1,
+    bicubic = 2,
+};
+
+pub fn planeCount(fmt: PixFmt) usize {
+    return switch (fmt) {
+        .yuv420p, .yuv422p, .yuv444p => 3,
+        .nv12, .nv21 => 2,
+        else => 1,
+    };
+}
+
+pub fn planeRowBytes(fmt: PixFmt, w: usize, plane: usize) usize {
+    return switch (fmt) {
+        .yuv420p, .yuv422p => if (plane == 0) w else (w + 1) / 2,
+        .yuv444p => w,
+        .nv12, .nv21 => if (plane == 0) w else ((w + 1) / 2) * 2,
+        .rgb24, .bgr24 => w * 3,
+        .rgba, .bgra => w * 4,
+        .gray8 => w,
+    };
+}
+
+pub fn planeRows(fmt: PixFmt, h: usize, plane: usize) usize {
+    if (plane == 0) return h;
+    return switch (fmt) {
+        .yuv420p, .nv12, .nv21 => (h + 1) / 2,
+        .yuv422p, .yuv444p => h,
+        else => h,
+    };
+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,547 @@
+const std = @import("std");
+const formats = @import("formats.zig");
+const simd_rgb = @import("simd_rgb.zig");
+const simd_yuv = @import("simd_yuv.zig");
+const scaler = @import("scaler.zig");
+
+const PixFmt = formats.PixFmt;
+const Algo = formats.Algo;
+
+pub const Context = struct {
+    src_w: usize,
+    src_h: usize,
+    src_fmt: PixFmt,
+    dst_w: usize,
+    dst_h: usize,
+    dst_fmt: PixFmt,
+    algo: Algo,
+    allocator: std.mem.Allocator,
+
+    // Line buffers for unscaled RGB -> YUV
+    u_buf: []i32,
+    v_buf: []i32,
+
+    // Planar intermediate buffers
+    in_y_buf: []u8,
+    in_u_buf: []u8,
+    in_v_buf: []u8,
+
+    // Scaler filters
+    h_lum_filter: ?scaler.Filter1D,
+    v_lum_filter: ?scaler.Filter1D,
+    h_chr_filter: ?scaler.Filter1D,
+    v_chr_filter: ?scaler.Filter1D,
+
+    // Intermediate buffers for scaling
+    h_buf_lum: []i32,
+    h_buf_chr: []i32,
+    scaled_lum: []u8,
+    scaled_u: []u8,
+    scaled_v: []u8,
+
+    pub fn deinit(self: *Context) void {
+        const alloc = self.allocator;
+        if (self.u_buf.len > 0) alloc.free(self.u_buf);
+        if (self.v_buf.len > 0) alloc.free(self.v_buf);
+        if (self.in_y_buf.len > 0) alloc.free(self.in_y_buf);
+        if (self.in_u_buf.len > 0) alloc.free(self.in_u_buf);
+        if (self.in_v_buf.len > 0) alloc.free(self.in_v_buf);
+        if (self.h_buf_lum.len > 0) alloc.free(self.h_buf_lum);
+        if (self.h_buf_chr.len > 0) alloc.free(self.h_buf_chr);
+        if (self.scaled_lum.len > 0) alloc.free(self.scaled_lum);
+        if (self.scaled_u.len > 0) alloc.free(self.scaled_u);
+        if (self.scaled_v.len > 0) alloc.free(self.scaled_v);
+
+        if (self.h_lum_filter) |*f| f.deinit(alloc);
+        if (self.v_lum_filter) |*f| f.deinit(alloc);
+        if (self.h_chr_filter) |*f| f.deinit(alloc);
+        if (self.v_chr_filter) |*f| f.deinit(alloc);
+
+        alloc.destroy(self);
+    }
+};
+
+export fn swscale_create(
+    src_w: c_int, src_h: c_int, src_fmt_c: c_int,
+    dst_w: c_int, dst_h: c_int, dst_fmt_c: c_int,
+    algo_c: c_int,
+) ?*anyopaque {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+    if (src_fmt_c < 0 or src_fmt_c >= 10) return null;
+    if (dst_fmt_c < 0 or dst_fmt_c >= 10) return null;
+    if (algo_c < 0 or algo_c >= 3) return null;
+
+    const alloc = std.heap.c_allocator;
+    const ctx = alloc.create(Context) catch return null;
+
+    const sw: usize = @intCast(src_w);
+    const sh: usize = @intCast(src_h);
+    const dw: usize = @intCast(dst_w);
+    const dh: usize = @intCast(dst_h);
+    const s_fmt: PixFmt = @enumFromInt(src_fmt_c);
+    const d_fmt: PixFmt = @enumFromInt(dst_fmt_c);
+    const alg: Algo = @enumFromInt(algo_c);
+
+    ctx.* = .{
+        .src_w = sw,
+        .src_h = sh,
+        .src_fmt = s_fmt,
+        .dst_w = dw,
+        .dst_h = dh,
+        .dst_fmt = d_fmt,
+        .algo = alg,
+        .allocator = alloc,
+        .u_buf = &.{},
+        .v_buf = &.{},
+        .in_y_buf = &.{},
+        .in_u_buf = &.{},
+        .in_v_buf = &.{},
+        .h_lum_filter = null,
+        .v_lum_filter = null,
+        .h_chr_filter = null,
+        .v_chr_filter = null,
+        .h_buf_lum = &.{},
+        .h_buf_chr = &.{},
+        .scaled_lum = &.{},
+        .scaled_u = &.{},
+        .scaled_v = &.{},
+    };
+
+    if (sw == dw and sh == dh) {
+        // Unscaled conversion: allocate line buffers for RGB -> YUV if needed
+        const cw = (sw + 1) / 2;
+        const ch = (sh + 1) / 2;
+        ctx.u_buf = alloc.alloc(i32, sh * cw) catch {
+            ctx.deinit();
+            return null;
+        };
+        ctx.v_buf = alloc.alloc(i32, sh * cw) catch {
+            ctx.deinit();
+            return null;
+        };
+        ctx.scaled_u = alloc.alloc(u8, cw * ch) catch {
+            ctx.deinit();
+            return null;
+        };
+        ctx.scaled_v = alloc.alloc(u8, cw * ch) catch {
+            ctx.deinit();
+            return null;
+        };
+        // For special chroma resampling in same-size (c006, c008, c011)
+        const a_val: u32 = @intCast(algo_c);
+        if (s_fmt == .yuv420p and d_fmt == .yuv444p) {
+            ctx.h_chr_filter = scaler.makeFilter(alloc, (sw + 1) / 2, sw, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, (sh + 1) / 2, sh, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, ((sh + 1) / 2) * sw) catch &.{};
+        } else if (s_fmt == .yuv422p and d_fmt == .yuv420p) {
+            ctx.h_chr_filter = scaler.makeFilter(alloc, (sw + 1) / 2, (sw + 1) / 2, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, sh, (sh + 1) / 2, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, sh * ((sw + 1) / 2)) catch &.{};
+        } else if (s_fmt == .yuv444p and d_fmt == .yuv420p) {
+            ctx.h_chr_filter = scaler.makeFilter(alloc, sw, (sw + 1) / 2, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, sh, (sh + 1) / 2, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, sh * ((sw + 1) / 2)) catch &.{};
+        }
+    } else {
+        // Scaled conversion
+        const a_val: u32 = @intCast(algo_c);
+        ctx.h_lum_filter = scaler.makeFilter(alloc, sw, dw, a_val) catch {
+            ctx.deinit();
+            return null;
+        };
+        ctx.v_lum_filter = scaler.makeFilter(alloc, sh, dh, a_val) catch {
+            ctx.deinit();
+            return null;
+        };
+
+        const is_src_rgb = (s_fmt == .rgb24 or s_fmt == .bgr24 or s_fmt == .rgba or s_fmt == .bgra);
+        const is_dst_rgb = (d_fmt == .rgb24 or d_fmt == .bgr24 or d_fmt == .rgba or d_fmt == .bgra);
+
+        if (d_fmt == .yuv420p) {
+            const chr_sw = (sw + 1) / 2;
+            const chr_sh = (sh + 1) / 2;
+            const chr_dw = (dw + 1) / 2;
+            const chr_dh = (dh + 1) / 2;
+            ctx.h_chr_filter = scaler.makeFilter(alloc, chr_sw, chr_dw, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, chr_sh, chr_dh, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, chr_sh * chr_dw) catch &.{};
+            if (is_src_rgb) {
+                ctx.in_y_buf = alloc.alloc(u8, sw * sh) catch &.{};
+                ctx.in_u_buf = alloc.alloc(u8, chr_sw * chr_sh) catch &.{};
+                ctx.in_v_buf = alloc.alloc(u8, chr_sw * chr_sh) catch &.{};
+                ctx.u_buf = alloc.alloc(i32, sh * chr_sw) catch &.{};
+                ctx.v_buf = alloc.alloc(i32, sh * chr_sw) catch &.{};
+            }
+        } else if (s_fmt == .yuv420p and is_dst_rgb) {
+            const chr_sw = (sw + 1) / 2;
+            const chr_sh = (sh + 1) / 2;
+            const chr_dw = (dw + 1) / 2;
+            ctx.h_chr_filter = scaler.makeFilter(alloc, chr_sw, chr_dw, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, chr_sh, dh, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, chr_sh * chr_dw) catch &.{};
+            ctx.scaled_lum = alloc.alloc(u8, dw * dh) catch &.{};
+            ctx.scaled_u = alloc.alloc(u8, chr_dw * dh) catch &.{};
+            ctx.scaled_v = alloc.alloc(u8, chr_dw * dh) catch &.{};
+        } else if (s_fmt == .yuv422p and is_dst_rgb) {
+            const chr_sw = (sw + 1) / 2;
+            const chr_dw = (dw + 1) / 2;
+            ctx.h_chr_filter = scaler.makeFilter(alloc, chr_sw, chr_dw, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, sh, dh, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, sh * chr_dw) catch &.{};
+            ctx.scaled_lum = alloc.alloc(u8, dw * dh) catch &.{};
+            ctx.scaled_u = alloc.alloc(u8, chr_dw * dh) catch &.{};
+            ctx.scaled_v = alloc.alloc(u8, chr_dw * dh) catch &.{};
+        } else if (s_fmt == .yuv444p and is_dst_rgb) {
+            ctx.h_chr_filter = scaler.makeFilter(alloc, sw, dw, a_val) catch null;
+            ctx.v_chr_filter = scaler.makeFilter(alloc, sh, dh, a_val) catch null;
+            ctx.h_buf_chr = alloc.alloc(i32, sh * dw) catch &.{};
+            ctx.scaled_lum = alloc.alloc(u8, dw * dh) catch &.{};
+            ctx.scaled_u = alloc.alloc(u8, dw * dh) catch &.{};
+            ctx.scaled_v = alloc.alloc(u8, dw * dh) catch &.{};
+        } else if (is_src_rgb and is_dst_rgb) {
+            if (dw <= sw / 2) {
+                const chr_sw = (sw + 1) / 2;
+                ctx.h_chr_filter = scaler.makeFilter(alloc, chr_sw, dw, a_val) catch null;
+                ctx.v_chr_filter = scaler.makeFilter(alloc, sh, dh, a_val) catch null;
+                ctx.h_buf_chr = alloc.alloc(i32, sh * dw) catch &.{};
+                ctx.in_y_buf = alloc.alloc(u8, sw * sh) catch &.{};
+                ctx.in_u_buf = alloc.alloc(u8, chr_sw * sh) catch &.{};
+                ctx.in_v_buf = alloc.alloc(u8, chr_sw * sh) catch &.{};
+            } else {
+                ctx.h_chr_filter = scaler.makeFilter(alloc, sw, dw, a_val) catch null;
+                ctx.v_chr_filter = scaler.makeFilter(alloc, sh, dh, a_val) catch null;
+                ctx.h_buf_chr = alloc.alloc(i32, sh * dw) catch &.{};
+                ctx.in_y_buf = alloc.alloc(u8, sw * sh) catch &.{};
+                ctx.in_u_buf = alloc.alloc(u8, sw * sh) catch &.{};
+                ctx.in_v_buf = alloc.alloc(u8, sw * sh) catch &.{};
+            }
+            ctx.scaled_lum = alloc.alloc(u8, dw * dh) catch &.{};
+            ctx.scaled_u = alloc.alloc(u8, dw * dh) catch &.{};
+            ctx.scaled_v = alloc.alloc(u8, dw * dh) catch &.{};
+        }
+
+        ctx.h_buf_lum = alloc.alloc(i32, sh * dw) catch {
+            ctx.deinit();
+            return null;
+        };
+    }
+
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    ctx_ptr: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx = @as(?*Context, @ptrCast(@alignCast(ctx_ptr))) orelse return -1;
+    const sw = ctx.src_w;
+    const sh = ctx.src_h;
+    const dw = ctx.dst_w;
+    const dh = ctx.dst_h;
+
+    // Check pointers
+    const s0 = src_data[0] orelse return -1;
+    const d0 = dst_data[0] orelse return -1;
+    const ss0: usize = @intCast(src_stride[0]);
+    const ds0: usize = @intCast(dst_stride[0]);
+
+    if (sw == dw and sh == dh) {
+        // === UN-SCALED CONVERSIONS ===
+        if (ctx.src_fmt == ctx.dst_fmt) {
+            const count = formats.planeCount(ctx.src_fmt);
+            var p: usize = 0;
+            while (p < count) : (p += 1) {
+                const sp = src_data[p] orelse return -1;
+                const dp = dst_data[p] orelse return -1;
+                const row_bytes = formats.planeRowBytes(ctx.src_fmt, sw, p);
+                const rows = formats.planeRows(ctx.src_fmt, sh, p);
+                simd_yuv.copy_plane(sp, @intCast(src_stride[p]), dp, @intCast(dst_stride[p]), row_bytes, rows);
+            }
+            return 0;
+        }
+
+        switch (ctx.src_fmt) {
+            .rgb24 => switch (ctx.dst_fmt) {
+                .bgr24 => simd_rgb.rgb24_to_bgr24(s0, ss0, d0, ds0, sw, sh),
+                .rgba => simd_rgb.rgb24_to_rgba(s0, ss0, d0, ds0, sw, sh),
+                .bgra => simd_rgb.rgb24_to_bgra(s0, ss0, d0, ds0, sw, sh),
+                .gray8 => simd_rgb.rgb24_to_gray8(s0, ss0, d0, ds0, sw, sh),
+                .yuv420p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.rgb_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh, @intFromEnum(ctx.src_fmt), ctx.u_buf, ctx.v_buf);
+                },
+                .yuv422p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.rgb_to_yuv422p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh, @intFromEnum(ctx.src_fmt));
+                },
+                .yuv444p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.rgb_to_yuv444p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh, @intFromEnum(ctx.src_fmt));
+                },
+                .nv12, .nv21 => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const is_nv21 = (ctx.dst_fmt == .nv21);
+                    const cw = (sw + 1) / 2;
+                    const ch = (sh + 1) / 2;
+                    const u_slice = ctx.scaled_u[0 .. cw * ch];
+                    const v_slice = ctx.scaled_v[0 .. cw * ch];
+                    simd_yuv.rgb_to_yuv420p(s0, ss0, d0, ds0, u_slice.ptr, cw, v_slice.ptr, cw, sw, sh, @intFromEnum(ctx.src_fmt), ctx.u_buf, ctx.v_buf);
+                    simd_yuv.yuv420p_to_nv12(d0, ds0, u_slice.ptr, cw, v_slice.ptr, cw, d0, ds0, d1, @intCast(dst_stride[1]), sw, sh, is_nv21);
+                },
+                else => return -1,
+            },
+            .bgr24 => switch (ctx.dst_fmt) {
+                .rgb24 => simd_rgb.rgb24_to_bgr24(s0, ss0, d0, ds0, sw, sh),
+                .rgba => simd_rgb.bgr24_to_rgba(s0, ss0, d0, ds0, sw, sh),
+                .bgra => simd_rgb.bgr24_to_bgra(s0, ss0, d0, ds0, sw, sh),
+                .gray8 => simd_rgb.rgb24_to_gray8(s0, ss0, d0, ds0, sw, sh),
+                .yuv420p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.bgr_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh, 3);
+                },
+                .nv21 => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const cw = (sw + 1) / 2;
+                    const ch = (sh + 1) / 2;
+                    const u_slice = ctx.scaled_u[0 .. cw * ch];
+                    const v_slice = ctx.scaled_v[0 .. cw * ch];
+                    simd_yuv.bgr_to_yuv420p(s0, ss0, d0, ds0, u_slice.ptr, cw, v_slice.ptr, cw, sw, sh, 3);
+                    simd_yuv.yuv420p_to_nv12(d0, ds0, u_slice.ptr, cw, v_slice.ptr, cw, d0, ds0, d1, @intCast(dst_stride[1]), sw, sh, true);
+                },
+                else => return -1,
+            },
+            .rgba => switch (ctx.dst_fmt) {
+                .rgb24 => simd_rgb.rgba_to_rgb24(s0, ss0, d0, ds0, sw, sh),
+                .bgra => simd_rgb.rgba_to_bgra(s0, ss0, d0, ds0, sw, sh),
+                .gray8 => simd_rgb.rgba_to_gray8(s0, ss0, d0, ds0, sw, sh),
+                .yuv420p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.rgb_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh, @intFromEnum(ctx.src_fmt), ctx.u_buf, ctx.v_buf);
+                },
+                else => return -1,
+            },
+            .bgra => switch (ctx.dst_fmt) {
+                .rgb24 => simd_rgb.bgra_to_rgb24(s0, ss0, d0, ds0, sw, sh),
+                .rgba => simd_rgb.rgba_to_bgra(s0, ss0, d0, ds0, sw, sh),
+                .yuv420p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.rgb_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh, @intFromEnum(ctx.src_fmt), ctx.u_buf, ctx.v_buf);
+                },
+                else => return -1,
+            },
+            .gray8 => switch (ctx.dst_fmt) {
+                .rgb24, .bgr24 => simd_rgb.gray8_to_rgb24(s0, ss0, d0, ds0, sw, sh),
+                .rgba, .bgra => simd_rgb.gray8_to_rgba(s0, ss0, d0, ds0, sw, sh),
+                .yuv420p => {
+                    const d1 = dst_data[1] orelse return -1;
+                    const d2 = dst_data[2] orelse return -1;
+                    simd_yuv.gray8_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+                },
+                else => return -1,
+            },
+            .yuv420p => switch (ctx.dst_fmt) {
+                .rgb24, .bgr24, .rgba, .bgra => {
+                    const s1 = src_data[1] orelse return -1;
+                    const s2 = src_data[2] orelse return -1;
+                    simd_yuv.yuv420p_to_rgb(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh, @intFromEnum(ctx.dst_fmt));
+                },
