+import ctypes, numpy as np, workloads
+
+ref_y, ref_u, ref_v = [open("/tmp/ref_y.raw", "rb").read() if False else None]*3
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+w = workloads.correctness_workloads()[28] # c028: bgr24 -> yuv420p
+sw, sh = w["src_w"], w["src_h"]
+s0 = bytearray((i*37) & 0xff for i in range(sw * sh * 3))
+
+ctx = lib.swscale_create(sw, sh, 6, sw, sh, 0, 1)
+s_ptrs = (ctypes.c_char_p * 4)(bytes(s0), None, None, None)
+s_str = (ctypes.c_int * 4)(sw*3, 0, 0, 0)
+d0 = bytearray(sw*sh)
+d1 = bytearray(sw*sh//4)
+d2 = bytearray(sw*sh//4)
+d_ptrs = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0)).from_buffer(d0), ctypes.c_char_p),
+                               ctypes.cast((ctypes.c_char*len(d1)).from_buffer(d1), ctypes.c_char_p),
+                               ctypes.cast((ctypes.c_char*len(d2)).from_buffer(d2), ctypes.c_char_p), None)
+d_str = (ctypes.c_int * 4)(sw, sw//2, sw//2, 0)
+lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+lib.swscale_destroy(ctx)
+
+ref_y, ref_u, ref_v = bytes(d0), bytes(d1), bytes(d2)
+
+# Implement ff_rgb24toyv12_c on BGR24:
+cand_y = bytearray(sw * sh)
+cand_u = bytearray(sw * sh // 4)
+cand_v = bytearray(sw * sh // 4)
+
+ry, gy, by = 16829, 33039, 6414
+ru, gu, bu = -9714, -19071, 28784
+rv, gv, bv = 28784, -24103, -4680
+
+for y in range(0, sh, 2):
+    for i in range(sw // 2):
+        # src1 is row y, src2 is row y+1
+        idx1 = (y * sw + 2 * i) * 3
+        idx2 = ((y + 1) * sw + 2 * i) * 3
+        b11, g11, r11 = s0[idx1:idx1+3]
+        b12, g12, r12 = s0[idx1+3:idx1+6]
+        b21, g21, r21 = s0[idx2:idx2+3]
+        b22, g22, r22 = s0[idx2+3:idx2+6]
+
+        cand_y[y * sw + 2 * i] = ((ry * r11 + gy * g11 + by * b11) >> 16) + 16
+        cand_y[y * sw + 2 * i + 1] = ((ry * r12 + gy * g12 + by * b12) >> 16) + 16
+        cand_y[(y + 1) * sw + 2 * i] = ((ry * r21 + gy * g21 + by * b21) >> 16) + 16
+        cand_y[(y + 1) * sw + 2 * i + 1] = ((ry * r22 + gy * g22 + by * b22) >> 16) + 16
+
+        bx = (b11 + b12 + b21 + b22) >> 2
+        gx = (g11 + g12 + g21 + g22) >> 2
+        rx = (r11 + r12 + r21 + r22) >> 2
+
+        U = ((ru * rx + gu * gx + bu * bx) >> 16) + 128
+        V = ((rv * rx + gv * gx + bv * bx) >> 16) + 128
+
+        # Note: in YV12, dst[1] is U, dst[2] is V (or vice versa? Let's check!)
+        cand_u[(y // 2) * (sw // 2) + i] = U
+        cand_v[(y // 2) * (sw // 2) + i] = V
+
+print("c028 with ff_rgb24toyv12_c:")
+print("Y PSNR:", workloads.psnr(ref_y, bytes(cand_y)))
+print("U PSNR:", workloads.psnr(ref_u, bytes(cand_u)))
+print("V PSNR:", workloads.psnr(ref_v, bytes(cand_v)))
+print("U PSNR if swapped:", workloads.psnr(ref_u, bytes(cand_v)))
+print("V PSNR if swapped:", workloads.psnr(ref_v, bytes(cand_u)))
