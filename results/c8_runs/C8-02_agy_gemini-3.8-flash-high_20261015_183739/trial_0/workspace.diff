+        const d_row = @as([*]u32, @ptrCast(@alignCast(dst + y * dst_stride)));
+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            const v: V = s_row[x..][0..8].*;
+            const r: V = (v & @as(V, @splat(0x000000FF))) << @as(@Vector(8, u5), @splat(16));
+            const b: V = (v & @as(V, @splat(0x00FF0000))) >> @as(@Vector(8, u5), @splat(16));
