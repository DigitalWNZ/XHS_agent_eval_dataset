+// RGB24 <-> BGR24
+pub fn rgb24_to_bgr24(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        // Process in chunks of 16 pixels (48 bytes)
+        while (x + 16 <= w) : (x += 16) {
+            const sp = s_row + x * 3;
+            const dp = d_row + x * 3;
+            var i: usize = 0;
+            while (i < 16) : (i += 1) {
+                const r = sp[i * 3 + 0];
+                const g = sp[i * 3 + 1];
+                const b = sp[i * 3 + 2];
+                dp[i * 3 + 0] = b;
+                dp[i * 3 + 1] = g;
+                dp[i * 3 + 2] = r;
+            }
+        }
+        while (x < w) : (x += 1) {
+            const r = s_row[x * 3 + 0];
+            const g = s_row[x * 3 + 1];
+            const b = s_row[x * 3 + 2];
+            d_row[x * 3 + 0] = b;
+            d_row[x * 3 + 1] = g;
+            d_row[x * 3 + 2] = r;
+        }
+    }
+}
+
+// RGB24 -> RGBA (set A=255)
+pub fn rgb24_to_rgba(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
