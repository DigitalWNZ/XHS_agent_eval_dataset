+        var cx: usize = 0;
+        while (cx < cw) : (cx += 1) {
+            const x0 = cx * 2;
+            const x1 = if (x0 + 1 < w) x0 + 1 else x0;
+            const r0: i32 = if (!is_bgr) s_row[x0 * bpp + 0] else s_row[x0 * bpp + 2];
+            const g0: i32 = s_row[x0 * bpp + 1];
