+            }
+            const shifted = sum_v >> @as(@Vector(8, u5), @splat(14));
+            var i: usize = 0;
+            while (i < 8) : (i += 1) {
+                d_row[x + i] = @truncate(@as(u32, @intCast(std.math.clamp(shifted[i], 0, 255))));
+            }
+        }
+        while (x < dst_w) : (x += 1) {
