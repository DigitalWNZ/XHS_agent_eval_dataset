+            const v15 = (28784 * r - 24103 * g - 4680 * b + (256 << 15) + 512) >> 10;
+            dy_row[x] = @truncate(@as(u32, @intCast(std.math.clamp((y15 + 32) >> 6, 0, 255))));
+            du_row[x] = @truncate(@as(u32, @intCast(std.math.clamp((u_val + 32) >> 6, 0, 255))));
+            dv_row[x] = @truncate(@as(u32, @intCast(std.math.clamp((v15 + 32) >> 6, 0, 255))));
+        }
+    }
+}
+
+pub fn yuv420p_to_yuv444p_plane(
+    src: [*]const u8, src_stride: usize, sw: usize, sh: usize,
+    dst: [*]u8, dst_stride: usize, dw: usize, dh: usize,
+    h_buf: []i32,
+) void {
+    var y: usize = 0;
+    while (y < sh) : (y += 1) {
+        const s_row = src + y * src_stride;
+        const h_row = h_buf.ptr + y * dw;
+        h_row[0] = s_row[0];
+        h_row[dw - 1] = s_row[sw - 1];
+        var x: usize = 0;
+        while (x < sw - 1) : (x += 1) {
+            h_row[2 * x + 1] = (3 * @as(i32, s_row[x]) + 1 * @as(i32, s_row[x + 1]) + 2) >> 2;
+            h_row[2 * x + 2] = (1 * @as(i32, s_row[x]) + 3 * @as(i32, s_row[x + 1]) + 2) >> 2;
+        }
+    }
+
+    const d_first = dst + 0 * dst_stride;
+    const h_first = h_buf.ptr + 0 * dw;
+    for (0..dw) |x| d_first[x] = @truncate(@as(u32, @intCast(h_first[x])));
+
+    const d_last = dst + (dh - 1) * dst_stride;
+    const h_last = h_buf.ptr + (sh - 1) * dw;
+    for (0..dw) |x| d_last[x] = @truncate(@as(u32, @intCast(h_last[x])));
+
+    var cy: usize = 0;
+    while (cy < sh - 1) : (cy += 1) {
+        const h_r0 = h_buf.ptr + cy * dw;
+        const h_r1 = h_buf.ptr + (cy + 1) * dw;
+        const d_r1 = dst + (2 * cy + 1) * dst_stride;
+        const d_r2 = dst + (2 * cy + 2) * dst_stride;
+        var x: usize = 0;
+        while (x < dw) : (x += 1) {
+            d_r1[x] = @truncate(@as(u32, @intCast(std.math.clamp((3 * h_r0[x] + 1 * h_r1[x] + 2) >> 2, 0, 255))));
+            d_r2[x] = @truncate(@as(u32, @intCast(std.math.clamp((1 * h_r0[x] + 3 * h_r1[x] + 2) >> 2, 0, 255))));
+        }
+    }
+}
+
+pub fn yuv444p_to_yuv420p_plane(
+    src: [*]const u8, src_stride: usize, sw: usize, sh: usize,
+    dst: [*]u8, dst_stride: usize, dw: usize, dh: usize,
+    h_buf: []i32,
+) void {
+    var y: usize = 0;
+    while (y < sh) : (y += 1) {
+        const s_row = src + y * src_stride;
+        const h_row = h_buf.ptr + y * dw;
+        h_row[0] = (4 * @as(i32, s_row[0]) + 3 * @as(i32, s_row[1]) + 1 * @as(i32, s_row[2]) + 4) >> 3;
+        h_row[dw - 1] = (1 * @as(i32, s_row[sw - 3]) + 3 * @as(i32, s_row[sw - 2]) + 4 * @as(i32, s_row[sw - 1]) + 4) >> 3;
+        var x: usize = 1;
+        while (x < dw - 1) : (x += 1) {
+            const p = 2 * x - 1;
+            h_row[x] = (1 * @as(i32, s_row[p]) + 3 * @as(i32, s_row[p + 1]) + 3 * @as(i32, s_row[p + 2]) + 1 * @as(i32, s_row[p + 3]) + 4) >> 3;
+        }
+    }
+
+    const d_first = dst + 0 * dst_stride;
+    const h_r0 = h_buf.ptr + 0 * dw;
+    const h_r1 = h_buf.ptr + 1 * dw;
+    const h_r2 = h_buf.ptr + 2 * dw;
+    for (0..dw) |x| {
+        d_first[x] = @truncate(@as(u32, @intCast(std.math.clamp((4 * h_r0[x] + 3 * h_r1[x] + 1 * h_r2[x] + 4) >> 3, 0, 255))));
+    }
+
+    const d_last = dst + (dh - 1) * dst_stride;
+    const h_lm2 = h_buf.ptr + (sh - 3) * dw;
+    const h_lm1 = h_buf.ptr + (sh - 2) * dw;
+    const h_l = h_buf.ptr + (sh - 1) * dw;
+    for (0..dw) |x| {
+        d_last[x] = @truncate(@as(u32, @intCast(std.math.clamp((1 * h_lm2[x] + 3 * h_lm1[x] + 4 * h_l[x] + 4) >> 3, 0, 255))));
+    }
+
+    var cy: usize = 1;
+    while (cy < dh - 1) : (cy += 1) {
+        const p = 2 * cy - 1;
+        const hr0 = h_buf.ptr + (p + 0) * dw;
+        const hr1 = h_buf.ptr + (p + 1) * dw;
+        const hr2 = h_buf.ptr + (p + 2) * dw;
+        const hr3 = h_buf.ptr + (p + 3) * dw;
+        const d_row = dst + cy * dst_stride;
+        var x: usize = 0;
+        while (x < dw) : (x += 1) {
+            d_row[x] = @truncate(@as(u32, @intCast(std.math.clamp((1 * hr0[x] + 3 * hr1[x] + 3 * hr2[x] + 1 * hr3[x] + 4) >> 3, 0, 255))));
+        }
+    }
+}
diff --git a/swscale-impl/test_all_scales.py b/swscale-impl/test_all_scales.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/test_all_scales.py
@@ -0,0 +1,94 @@
+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+def run_baseline(wl):
+    ctx = lib.swscale_create(wl["src_w"], wl["src_h"], wl["src_fmt"],
+                             wl["dst_w"], wl["dst_h"], wl["dst_fmt"],
+                             wl["algo"])
+    s_count = workloads.plane_count(wl["src_fmt"])
+    d_count = workloads.plane_count(wl["dst_fmt"])
+    s_ptrs = (ctypes.c_char_p * 4)()
+    s_str = (ctypes.c_int * 4)()
+    s_bufs = []
+    for p in range(s_count):
+        s_str[p] = workloads.plane_row_bytes(wl["src_fmt"], wl["src_w"], p)
+        rows = workloads.plane_rows(wl["src_fmt"], wl["src_h"], p)
+        b = bytearray((i*37 + p*101) & 0xff for i in range(s_str[p] * rows))
+        s_bufs.append(b)
+        s_ptrs[p] = ctypes.cast((ctypes.c_char * len(b)).from_buffer(b), ctypes.c_char_p)
+    d_ptrs = (ctypes.c_char_p * 4)()
+    d_str = (ctypes.c_int * 4)()
+    d_bufs = []
+    for p in range(d_count):
+        d_str[p] = workloads.plane_row_bytes(wl["dst_fmt"], wl["dst_w"], p)
+        rows = workloads.plane_rows(wl["dst_fmt"], wl["dst_h"], p)
+        b = bytearray(d_str[p] * rows)
+        d_bufs.append(b)
+        d_ptrs[p] = ctypes.cast((ctypes.c_char * len(b)).from_buffer(b), ctypes.c_char_p)
+    lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+    lib.swscale_destroy(ctx)
+    return s_bufs, [bytes(b) for b in d_bufs]
+
+# Verify step 447 logic on s000:
+wl = workloads.correctness_workloads()[42]
+s_bufs, d_bufs = run_baseline(wl)
+ref = d_bufs[0]
+
+sw, sh = wl["src_w"], wl["src_h"]
+dw, dh = wl["dst_w"], wl["dst_h"]
+
+src = np.frombuffer(s_bufs[0], dtype=np.uint8).reshape((sh, sw, 3))
+r = src[:, :, 0].astype(np.int32)
+g = src[:, :, 1].astype(np.int32)
+b = src[:, :, 2].astype(np.int32)
+
+lum_in = ((8404 * r + 16499 * g + 3205 * b + 524288 + 256) >> 9).astype(np.int16)
+r_h = r[:, 0::2] + r[:, 1::2]
+g_h = g[:, 0::2] + g[:, 1::2]
+b_h = b[:, 0::2] + b[:, 1::2]
+u_in = ((-4874 * r_h - 9539 * g_h + 14413 * b_h + (256 << 15) + 512) >> 9).astype(np.int16)
+v_in = ((14413 * r_h - 12073 * g_h - 2340 * b_h + (256 << 15) + 512) >> 9).astype(np.int16)
+
+lum_scaled = np.zeros((sh, dw), dtype=np.int16)
+for x in range(dw):
+    if x == 0: pos = 0; w = [8192, 6144, 2048, 0]
+    elif x == dw - 1: pos = sw - 4; w = [0, 2048, 6144, 8192]
+    else: pos = 2 * x - 1; w = [2048, 6144, 6144, 2048]
+    val = np.sum(lum_in[:, pos:pos+4] * np.array(w)[None, :], axis=1)
+    lum_scaled[:, x] = np.clip(val >> 13, 0, 32767)
+
+u_scaled = u_in
+v_scaled = v_in
+
+dst = np.zeros((dh, dw, 3), dtype=np.uint8)
+for y in range(dh):
+    if y == 0: pos = 0; w = [2048, 1536, 512, 0]
+    elif y == dh - 1: pos = sh - 4; w = [0, 512, 1536, 2048]
+    else: pos = 2 * y - 1; w = [512, 1536, 1536, 512]
+
+    w_arr = np.array(w)[:, None]
+    l_slice = lum_scaled[pos:pos+4, :]
+    u_slice = u_scaled[pos:pos+4, :]
+    v_slice = v_scaled[pos:pos+4, :]
+
+    Y = (512 + np.sum(l_slice.astype(np.int64) * w_arr, axis=0)) >> 10
+    U = (512 - (128 << 19) + np.sum(u_slice.astype(np.int64) * w_arr, axis=0)) >> 10
+    V = (512 - (128 << 19) + np.sum(v_slice.astype(np.int64) * w_arr, axis=0)) >> 10
+
+    Y = (Y - 8192) * 9539 + (1 << 21)
+    R = (Y + V * 13075) >> 22
+    G = (Y + V * (-6660) + U * (-3209)) >> 22
+    B = (Y + U * 16525) >> 22
+
+    dst[y, :, 0] = np.clip(R, 0, 255)
+    dst[y, :, 1] = np.clip(G, 0, 255)
+    dst[y, :, 2] = np.clip(B, 0, 255)
+
+print("Verified s000 PSNR:", workloads.psnr(ref, dst.tobytes()))
