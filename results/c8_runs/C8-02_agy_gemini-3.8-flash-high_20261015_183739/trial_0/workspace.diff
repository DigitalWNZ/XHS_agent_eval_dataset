+        cand_y2[(y + 1) * sw + 2 * i] = 16 + ((8404 * r21 + 16499 * g21 + 3205 * b21 + 20480) >> 15)
+        cand_y2[(y + 1) * sw + 2 * i + 1] = 16 + ((8404 * r22 + 16499 * g22 + 3205 * b22 + 20480) >> 15)
+print("c037 Y with 8404 formula:", workloads.psnr(ref_y, bytes(cand_y2)))
+
+for y in range(0, sh, 2):
+    for i in range(sw // 2):
+        idx1 = (y * sw + 2 * i) * 4
+        idx2 = ((y + 1) * sw + 2 * i) * 4
+        b11, g11, r11 = s0[idx1:idx1+3]
+        b12, g12, r12 = s0[idx1+4:idx1+7]
+        b21, g21, r21 = s0[idx2:idx2+3]
+        b22, g22, r22 = s0[idx2+4:idx2+7]
+
+        # In BGRA, bytes are B, G, R, A
+        r_h0 = r11 + r12
+        r_h1 = r21 + r22
+        g_h0 = g11 + g12
+        g_h1 = g21 + g22
+        b_h0 = b11 + b12
+        b_h1 = b21 + b22
+
+cand_u_h = (-9714 * (r[:, 0::2] + r[:, 1::2]) - 19071 * (g[:, 0::2] + g[:, 1::2]) + 28784 * (b[:, 0::2] + b[:, 1::2]) + (256 << 16) + 1024) >> 11
+cand_v_h = (28784 * (r[:, 0::2] + r[:, 1::2]) - 24103 * (g[:, 0::2] + g[:, 1::2]) - 4680 * (b[:, 0::2] + b[:, 1::2]) + (256 << 16) + 1024) >> 11
+
+for cy in range(ch):
+    if cy == 0:
+        u_slice = 4 * cand_u_h[0] + 3 * cand_u_h[1] + 1 * cand_u_h[2]
+        v_slice = 4 * cand_v_h[0] + 3 * cand_v_h[1] + 1 * cand_v_h[2]
+    elif cy == ch - 1:
+        u_slice = 1 * cand_u_h[-3] + 3 * cand_u_h[-2] + 4 * cand_u_h[-1]
+        v_slice = 1 * cand_v_h[-3] + 3 * cand_v_h[-2] + 4 * cand_v_h[-1]
+    else:
+        p = 2 * cy - 1
+        u_slice = 1 * cand_u_h[p] + 3 * cand_u_h[p+1] + 3 * cand_u_h[p+2] + 1 * cand_u_h[p+3]
+        v_slice = 1 * cand_v_h[p] + 3 * cand_v_h[p+1] + 3 * cand_v_h[p+2] + 1 * cand_v_h[p+3]
+
+    val_u = (u_slice + 32) // 8
+    val_v = (v_slice + 32) // 8
+    cand_u[cy] = np.clip((val_u + 32) >> 6, 0, 255)
+    cand_v[cy] = np.clip((val_v + 32) >> 6, 0, 255)
+
+print("c037 U PSNR with 4-tap:", workloads.psnr(ref_u, cand_u.tobytes()))
+print("c037 V PSNR with 4-tap:", workloads.psnr(ref_v, cand_v.tobytes()))
diff --git a/swscale-impl/test_direct_rgb.py b/swscale-impl/test_direct_rgb.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/test_direct_rgb.py
@@ -0,0 +1,43 @@
+import ctypes, numpy as np, workloads
+
+ref = open("/tmp/ref_s000.raw", "rb").read()
+sw, sh = 1280, 720
+dw, dh = 640, 360
+
+i = np.arange(sw * sh * 3, dtype=np.uint32)
+bytes_arr = ((i * 37) & 0xff).astype(np.uint8)
+bytes_arr[0::128] = (bytes_arr[0::128].astype(np.int32) + 0x5b) & 0xff
+src = bytes_arr.reshape((sh, sw, 3))
+
+# Direct 2-pass filtering on each of R, G, B:
+# Filter weights for bilinear downscale 2x:
+# Horizontal:
+# x=0: pos=0, w=[8192, 6144, 2048, 0]
+# x=dw-1: pos=sw-4, w=[0, 2048, 6144, 8192]
+# interior: pos=2*x-1, w=[2048, 6144, 6144, 2048]
+# sum of w = 16384 (shift 14)
+
+h_scaled = np.zeros((sh, dw, 3), dtype=np.int32)
+for x in range(dw):
+    if x == 0:
+        pos = 0; w = [8192, 6144, 2048, 0]
+    elif x == dw - 1:
+        pos = sw - 4; w = [0, 2048, 6144, 8192]
+    else:
+        pos = 2 * x - 1; w = [2048, 6144, 6144, 2048]
+    val = np.sum(src[:, pos:pos+4, :].astype(np.int32) * np.array(w)[None, :, None], axis=1)
+    h_scaled[:, x, :] = (val + 8192) >> 14
+
+dst = np.zeros((dh, dw, 3), dtype=np.uint8)
+for y in range(dh):
+    if y == 0:
+        pos = 0; w = [2048, 1536, 512, 0]; scale = 4
+    elif y == dh - 1:
+        pos = sh - 4; w = [0, 512, 1536, 2048]; scale = 4
+    else:
+        pos = 2 * y - 1; w = [512, 1536, 1536, 512]; scale = 4
+    # sum of w * scale = 16384
+    val = np.sum(h_scaled[pos:pos+4, :, :].astype(np.int32) * (np.array(w) * scale)[:, None, None], axis=0)
+    dst[y, :, :] = np.clip((val + 8192) >> 14, 0, 255).astype(np.uint8)
+
+print("Direct RGB 2-pass PSNR on s000:", workloads.psnr(ref, dst.tobytes()))
diff --git a/swscale-impl/test_exact_ytable.py b/swscale-impl/test_exact_ytable.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/test_exact_ytable.py
@@ -0,0 +1,70 @@
+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+w = workloads.correctness_workloads()[0] # c000: yuv420p -> rgb24 640x480
+sw, sh = w["src_w"], w["src_h"]
+
+s0 = bytearray((0*101 + i*37)&0xff for i in range(sw*sh))
+s1 = bytearray((1*101 + i*37)&0xff for i in range(sw*sh//4))
+s2 = bytearray((2*101 + i*37)&0xff for i in range(sw*sh//4))
+
+ctx = lib.swscale_create(sw, sh, 0, sw, sh, 5, 1)
+s_ptrs = (ctypes.c_char_p * 4)(bytes(s0), bytes(s1), bytes(s2), None)
+s_str = (ctypes.c_int * 4)(sw, sw//2, sw//2, 0)
+d0 = bytearray(sw*sh*3)
+d_ptrs = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0)).from_buffer(d0), ctypes.c_char_p), None, None, None)
+d_str = (ctypes.c_int * 4)(sw*3, 0, 0, 0)
+lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+lib.swscale_destroy(ctx)
+
+ref = bytes(d0)
+
+# Build y_table:
+cy = (65536 * 255) // 219 # 76309
+oy = 16 << 16
+
+# scale coefficients by cy:
+crv = (104597 * 65536 + 0x8000) // cy # 89849
+cbu = (132201 * 65536 + 0x8000) // cy # 113550
+cgu = (-25675 * 65536 + 0x8000) // cy # -22053
+cgv = (-53279 * 65536 + 0x8000) // cy # -45763
+
+table_plane_size = 1024 + 2 * 512
+y_table = bytearray(table_plane_size)
+yb = -(384 << 16) - 512 * cy - oy
+for i in range(table_plane_size):
+    val = (yb + 0x8000) >> 16
+    y_table[i] = max(0, min(255, val))
+    yb += cy
+
+yoffs = 326 + 512
+
+cand = bytearray(sw*sh*3)
+for y in range(sh):
+    for x in range(sw):
+        y_val = s0[y*sw + x]
+        u_val = s1[(y//2)*(sw//2) + (x//2)]
+        v_val = s2[(y//2)*(sw//2) + (x//2)]
+
+        off_r = -(crv >> 9) + ((v_val * crv) >> 16)
+        off_gu = -(cgu >> 9) + ((u_val * cgu) >> 16)
+        off_gv = -(cgv >> 9) + ((v_val * cgv) >> 16)
+        off_b = -(cbu >> 9) + ((u_val * cbu) >> 16)
+
+        idx_r = yoffs + off_r + y_val
+        idx_g = yoffs + off_gu + off_gv + y_val
+        idx_b = yoffs + off_b + y_val
+
+        cand[(y*sw + x)*3 + 0] = y_table[idx_r]
+        cand[(y*sw + x)*3 + 1] = y_table[idx_g]
+        cand[(y*sw + x)*3 + 2] = y_table[idx_b]
+
+p = workloads.psnr(ref, bytes(cand))
+print("c000 PSNR with exact y_table formula:", p)
diff --git a/swscale-impl/test_filter_maker.py b/swscale-impl/test_filter_maker.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/test_filter_maker.py
@@ -0,0 +1,118 @@
+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+def run_baseline(wl):
+    ctx = lib.swscale_create(wl["src_w"], wl["src_h"], wl["src_fmt"],
+                             wl["dst_w"], wl["dst_h"], wl["dst_fmt"],
+                             wl["algo"])
+    s_count = workloads.plane_count(wl["src_fmt"])
+    d_count = workloads.plane_count(wl["dst_fmt"])
+    s_ptrs = (ctypes.c_char_p * 4)()
+    s_str = (ctypes.c_int * 4)()
+    s_bufs = []
+    for p in range(s_count):
+        s_str[p] = workloads.plane_row_bytes(wl["src_fmt"], wl["src_w"], p)
+        rows = workloads.plane_rows(wl["src_fmt"], wl["src_h"], p)
+        b = bytearray((i*37 + p*101) & 0xff for i in range(s_str[p] * rows))
+        s_bufs.append(b)
+        s_ptrs[p] = ctypes.cast((ctypes.c_char * len(b)).from_buffer(b), ctypes.c_char_p)
+    d_ptrs = (ctypes.c_char_p * 4)()
+    d_str = (ctypes.c_int * 4)()
+    d_bufs = []
+    for p in range(d_count):
+        d_str[p] = workloads.plane_row_bytes(wl["dst_fmt"], wl["dst_w"], p)
+        rows = workloads.plane_rows(wl["dst_fmt"], wl["dst_h"], p)
+        b = bytearray(d_str[p] * rows)
+        d_bufs.append(b)
+        d_ptrs[p] = ctypes.cast((ctypes.c_char * len(b)).from_buffer(b), ctypes.c_char_p)
+    lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+    lib.swscale_destroy(ctx)
+    return s_bufs, [bytes(b) for b in d_bufs]
+
+def make_filter(src_len, dst_len, algo):
+    if algo == 0: # NEAREST
+        pos = np.zeros(dst_len, dtype=np.int32)
+        weights = np.zeros((dst_len, 1), dtype=np.int32)
+        for x in range(dst_len):
+            p = (2 * x + 1) * src_len // (2 * dst_len)
+            pos[x] = min(p, src_len - 1)
+            weights[x, 0] = 16384
+        return pos, weights, 1
+    elif algo == 1: # BILINEAR
+        if src_len <= dst_len: # upscale
+            pos = np.zeros(dst_len, dtype=np.int32)
+            weights = np.zeros((dst_len, 2), dtype=np.int32)
+            x_inc = (src_len << 16) // dst_len
+            x_dst = 0
+            for x in range(dst_len):
+                p = x_dst >> 16
+                frac = (x_dst >> 2) & 0x3fff
+                if p >= src_len - 1:
+                    p = src_len - 2
+                    frac = 16384
+                pos[x] = p
+                weights[x, 0] = 16384 - frac
+                weights[x, 1] = frac
+                x_dst += x_inc
+            return pos, weights, 2
+        else: # downscale
+            pos = np.zeros(dst_len, dtype=np.int32)
+            weights = np.zeros((dst_len, 4), dtype=np.int32)
+            for x in range(dst_len):
+                if x == 0:
+                    pos[x] = 0
+                    weights[x] = [8192, 6144, 2048, 0]
+                elif x == dst_len - 1:
+                    pos[x] = src_len - 4
+                    weights[x] = [0, 2048, 6144, 8192]
+                else:
+                    center = (x * src_len) // dst_len
+                    p = max(0, min(src_len - 4, center - 1))
+                    pos[x] = p
+                    weights[x] = [2048, 6144, 6144, 2048]
+            return pos, weights, 4
+    else: # BICUBIC
+        pos = np.zeros(dst_len, dtype=np.int32)
+        weights = np.zeros((dst_len, 4), dtype=np.int32)
+        x_inc = (src_len << 16) // dst_len
+        x_dst = 0
+        for x in range(dst_len):
+            p = (x_dst >> 16) - 1
+            p = max(0, min(src_len - 4, p))
+            pos[x] = p
+            # Mitchell bicubic coefficients
+            weights[x] = [1024, 7168, 7168, 1024]
+            x_dst += x_inc
+        return pos, weights, 4
+
+print("make_filter defined successfully")
+
+cw = workloads.correctness_workloads()
+for i, wl in enumerate(cw[42:]):
+    s_bufs, d_bufs = run_baseline(wl)
+    # Check if s005 (YUV -> YUV):
+    if wl["src_fmt"] == 0 and wl["dst_fmt"] == 0:
+        # scale planes independently:
+        sw, sh = wl["src_w"], wl["src_h"]
+        dw, dh = wl["dst_w"], wl["dst_h"]
+        # Plane 0:
+        y_in = np.frombuffer(s_bufs[0], dtype=np.uint8).reshape((sh, sw))
+        h_pos, h_w, f_h = make_filter(sw, dw, wl["algo"])
+        v_pos, v_w, f_v = make_filter(sh, dh, wl["algo"])
+        h_scaled = np.zeros((sh, dw), dtype=np.int32)
+        for x in range(dw):
+            p = h_pos[x]
+            h_scaled[:, x] = np.sum(y_in[:, p:p+f_h].astype(np.int32) * h_w[x][None, :], axis=1) >> 14
+        y_out = np.zeros((dh, dw), dtype=np.uint8)
+        for y in range(dh):
+            p = v_pos[y]
+            val = np.sum(h_scaled[p:p+f_v, :].astype(np.int32) * v_w[y][:, None], axis=0) >> 14
+            y_out[y, :] = np.clip(val, 0, 255).astype(np.uint8)
+        print(f"s{i:03d} {wl['label']} Y PSNR:", workloads.psnr(d_bufs[0], y_out.tobytes()))
