+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+w = workloads.correctness_workloads()[0] # c000: yuv420p -> rgb24 640x480
+sw, sh = w["src_w"], w["src_h"]
+
+s0 = bytearray((0*101 + i*37)&0xff for i in range(sw*sh))
+s1 = bytearray((1*101 + i*37)&0xff for i in range(sw*sh//4))
+s2 = bytearray((2*101 + i*37)&0xff for i in range(sw*sh//4))
+
+ctx = lib.swscale_create(sw, sh, 0, sw, sh, 5, 1)
+s_ptrs = (ctypes.c_char_p * 4)(bytes(s0), bytes(s1), bytes(s2), None)
+s_str = (ctypes.c_int * 4)(sw, sw//2, sw//2, 0)
+d0 = bytearray(sw*sh*3)
+d_ptrs = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0)).from_buffer(d0), ctypes.c_char_p), None, None, None)
+d_str = (ctypes.c_int * 4)(sw*3, 0, 0, 0)
+lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+lib.swscale_destroy(ctx)
+
+ref = bytes(d0)
+
+# Test candidate formula:
+cand = bytearray(sw*sh*3)
+for y in range(sh):
+    for x in range(sw):
+        y_val = s0[y*sw + x]
+        u_val = s1[(y//2)*(sw//2) + (x//2)]
+        v_val = s2[(y//2)*(sw//2) + (x//2)]
+
+        Y = (y_val - 16) * 76309
+        U = u_val - 128
+        V = v_val - 128
+
+        r = max(0, min(255, (Y + V * 104597 + 32768) >> 16))
+        g = max(0, min(255, (Y + U * (-25675) + V * (-53279) + 32768) >> 16))
+        b = max(0, min(255, (Y + U * 132201 + 32768) >> 16))
+
+        cand[(y*sw + x)*3 + 0] = r
+        cand[(y*sw + x)*3 + 1] = g
+        cand[(y*sw + x)*3 + 2] = b
+
+p = workloads.psnr(ref, bytes(cand))
+print("c000 PSNR with new formula:", p)
+print("ref[:12]: ", list(ref[:12]))
+print("cand[:12]:", list(cand[:12]))
