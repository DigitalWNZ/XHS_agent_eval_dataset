+    const f_v = v_filter.filter_size;
+    var dy: usize = 0;
+    while (dy < dst_h) : (dy += 1) {
+        const d_row = dst + dy * dst_stride;
+        const p: usize = @intCast(v_filter.pos[dy]);
+        const w_base = dy * f_v;
+
+        var x: usize = 0;
+        while (x + 8 <= dst_w) : (x += 8) {
+            var sum_v: @Vector(8, i32) = @splat(0);
+            var j: usize = 0;
+            while (j < f_v) : (j += 1) {
+                const w_splat: @Vector(8, i32) = @splat(@as(i32, v_filter.weights[w_base + j]));
+                const row_ptr = h_buf.ptr + (p + j) * dst_w + x;
+                const in_v: @Vector(8, i32) = row_ptr[0..8].*;
