+                const u_val1 = u_buf[1 * cw + cx];
+                const u_val2 = u_buf[2 * cw + cx];
+                const v_val0 = v_buf[0 * cw + cx];
+                const v_val1 = v_buf[1 * cw + cx];
+                const v_val2 = v_buf[2 * cw + cx];
+                u_sum = 4 * @as(i64, u_val0) + 3 * @as(i64, u_val1) + 1 * @as(i64, u_val2);
+                v_sum = 4 * @as(i64, v_val0) + 3 * @as(i64, v_val1) + 1 * @as(i64, v_val2);
+            } else if (cy == ch - 1) {
+                const u_val0 = u_buf[(h - 3) * cw + cx];
+                const u_val1 = u_buf[(h - 2) * cw + cx];
+                const u_val2 = u_buf[(h - 1) * cw + cx];
+                const v_val0 = v_buf[(h - 3) * cw + cx];
+                const v_val1 = v_buf[(h - 2) * cw + cx];
+                const v_val2 = v_buf[(h - 1) * cw + cx];
+                u_sum = 1 * @as(i64, u_val0) + 3 * @as(i64, u_val1) + 4 * @as(i64, u_val2);
+                v_sum = 1 * @as(i64, v_val0) + 3 * @as(i64, v_val1) + 4 * @as(i64, v_val2);
+            } else {
+                const p = 2 * cy - 1;
+                const u_val0 = u_buf[(p + 0) * cw + cx];
+                const u_val1 = u_buf[(p + 1) * cw + cx];
