+const std = @import("std");
+
+// Plane copy helper
+pub fn copy_plane(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        @memcpy(dst[y * dst_stride ..][0..w], src[y * src_stride ..][0..w]);
+    }
+}
+
+// YUV420P <-> NV12 / NV21
+pub fn yuv420p_to_nv12(
+    s_y: [*]const u8, s_ys: usize, s_u: [*]const u8, s_us: usize, s_v: [*]const u8, s_vs: usize,
+    d_y: [*]u8, d_ys: usize, d_uv: [*]u8, d_uvs: usize, w: usize, h: usize, is_nv21: bool,
+) void {
+    copy_plane(s_y, s_ys, d_y, d_ys, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const u_row = s_u + y * s_us;
+        const v_row = s_v + y * s_vs;
+        const dst_row = d_uv + y * d_uvs;
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            if (!is_nv21) {
+                dst_row[2 * x + 0] = u_row[x];
+                dst_row[2 * x + 1] = v_row[x];
+            } else {
+                dst_row[2 * x + 0] = v_row[x];
+                dst_row[2 * x + 1] = u_row[x];
+            }
+        }
+    }
+}
+
+pub fn nv12_to_yuv420p(
+    s_y: [*]const u8, s_ys: usize, s_uv: [*]const u8, s_uvs: usize,
+    d_y: [*]u8, d_ys: usize, d_u: [*]u8, d_us: usize, d_v: [*]u8, d_vs: usize,
+    w: usize, h: usize, is_nv21: bool,
+) void {
+    copy_plane(s_y, s_ys, d_y, d_ys, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const src_row = s_uv + y * s_uvs;
+        const u_row = d_u + y * d_us;
+        const v_row = d_v + y * d_vs;
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            if (!is_nv21) {
+                u_row[x] = src_row[2 * x + 0];
+                v_row[x] = src_row[2 * x + 1];
+            } else {
+                v_row[x] = src_row[2 * x + 0];
+                u_row[x] = src_row[2 * x + 1];
+            }
+        }
+    }
+}
+
+// Constants and table for YUV -> RGB (BT.601 limited to full range)
+pub const y_table: [2048]u8 = blk: {
+    @setEvalBranchQuota(10000);
+    var tbl: [2048]u8 = undefined;
+    const cy: i64 = (65536 * 255) / 219;
+    const oy: i64 = 16 << 16;
+    var yb: i64 = -(384 << 16) - 512 * cy - oy;
+    var i: usize = 0;
+    while (i < 2048) : (i += 1) {
+        const val = (yb + 0x8000) >> 16;
+        tbl[i] = @intCast(std.math.clamp(val, 0, 255));
+        yb += cy;
+    }
+    break :blk tbl;
+};
+
+const CRV: i32 = 89849;
+const CBU: i32 = 113550;
+const CGU: i32 = -22053;
+const CGV: i32 = -45763;
+const YOFFS: i32 = 838;
+
+pub inline fn yuv2rgb_pixel(y_val: u8, u_val: u8, v_val: u8) struct { r: u8, g: u8, b: u8 } {
+    const y: i32 = @as(i32, y_val);
+    const u: i32 = @as(i32, u_val);
+    const v: i32 = @as(i32, v_val);
+
+    const off_r = -(CRV >> 9) + ((v * CRV) >> 16);
+    const off_gu = -(CGU >> 9) + ((u * CGU) >> 16);
+    const off_gv = -(CGV >> 9) + ((v * CGV) >> 16);
+    const off_b = -(CBU >> 9) + ((u * CBU) >> 16);
+
+    const idx_r: usize = @intCast(std.math.clamp(YOFFS + off_r + y, 0, 2047));
+    const idx_g: usize = @intCast(std.math.clamp(YOFFS + off_gu + off_gv + y, 0, 2047));
+    const idx_b: usize = @intCast(std.math.clamp(YOFFS + off_b + y, 0, 2047));
+
+    return .{ .r = y_table[idx_r], .g = y_table[idx_g], .b = y_table[idx_b] };
+}
+
+// YUV420P -> RGB24 / BGR24 / RGBA / BGRA (workload b000)
+pub fn yuv420p_to_rgb(
+    s_y: [*]const u8, s_ys: usize, s_u: [*]const u8, s_us: usize, s_v: [*]const u8, s_vs: usize,
+    dst: [*]u8, dst_stride: usize, w: usize, h: usize, dst_fmt: c_int,
+) void {
+    const is_bgr = (dst_fmt == 6 or dst_fmt == 8); // bgr24 or bgra
+    const has_alpha = (dst_fmt == 7 or dst_fmt == 8); // rgba or bgra
+    const bpp: usize = if (has_alpha) 4 else 3;
+
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const y_row = s_y + y * s_ys;
+        const u_row = s_u + (y >> 1) * s_us;
+        const v_row = s_v + (y >> 1) * s_vs;
+        const d_row = dst + y * dst_stride;
+
+        var x: usize = 0;
+        while (x < w) : (x += 2) {
+            const u_val = u_row[x >> 1];
+            const v_val = v_row[x >> 1];
+
+            const p0 = yuv2rgb_pixel(y_row[x], u_val, v_val);
+            const p1 = if (x + 1 < w) yuv2rgb_pixel(y_row[x + 1], u_val, v_val) else p0;
+
+            if (bpp == 3) {
+                if (!is_bgr) {
+                    d_row[x * 3 + 0] = p0.r;
+                    d_row[x * 3 + 1] = p0.g;
+                    d_row[x * 3 + 2] = p0.b;
+                    if (x + 1 < w) {
+                        d_row[(x + 1) * 3 + 0] = p1.r;
+                        d_row[(x + 1) * 3 + 1] = p1.g;
+                        d_row[(x + 1) * 3 + 2] = p1.b;
+                    }
+                } else {
+                    d_row[x * 3 + 0] = p0.b;
+                    d_row[x * 3 + 1] = p0.g;
+                    d_row[x * 3 + 2] = p0.r;
+                    if (x + 1 < w) {
+                        d_row[(x + 1) * 3 + 0] = p1.b;
+                        d_row[(x + 1) * 3 + 1] = p1.g;
+                        d_row[(x + 1) * 3 + 2] = p1.r;
+                    }
+                }
+            } else {
+                if (!is_bgr) {
+                    d_row[x * 4 + 0] = p0.r;
+                    d_row[x * 4 + 1] = p0.g;
+                    d_row[x * 4 + 2] = p0.b;
+                    d_row[x * 4 + 3] = 0xFF;
+                    if (x + 1 < w) {
+                        d_row[(x + 1) * 4 + 0] = p1.r;
+                        d_row[(x + 1) * 4 + 1] = p1.g;
+                        d_row[(x + 1) * 4 + 2] = p1.b;
+                        d_row[(x + 1) * 4 + 3] = 0xFF;
+                    }
+                } else {
+                    d_row[x * 4 + 0] = p0.b;
+                    d_row[x * 4 + 1] = p0.g;
+                    d_row[x * 4 + 2] = p0.r;
+                    d_row[x * 4 + 3] = 0xFF;
+                    if (x + 1 < w) {
+                        d_row[(x + 1) * 4 + 0] = p1.b;
+                        d_row[(x + 1) * 4 + 1] = p1.g;
+                        d_row[(x + 1) * 4 + 2] = p1.r;
+                        d_row[(x + 1) * 4 + 3] = 0xFF;
+                    }
+                }
+            }
+        }
+    }
+}
+
+// YUV422P -> RGB
+pub fn yuv422p_to_rgb(
