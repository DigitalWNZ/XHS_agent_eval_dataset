+    for p in range(s_count):
+        s_str[p] = workloads.plane_row_bytes(wl["src_fmt"], wl["src_w"], p)
+        rows = workloads.plane_rows(wl["src_fmt"], wl["src_h"], p)
+        b = bytearray((i*37 + p*101) & 0xff for i in range(s_str[p] * rows))
+        s_bufs.append(b)
+        s_ptrs[p] = ctypes.cast((ctypes.c_char * len(b)).from_buffer(b), ctypes.c_char_p)
+    d_ptrs = (ctypes.c_char_p * 4)()
