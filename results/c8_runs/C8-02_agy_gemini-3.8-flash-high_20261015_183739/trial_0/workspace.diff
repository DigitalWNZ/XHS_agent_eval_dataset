+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+def run_conv(sfmt, dfmt, sw, sh, dw, dh, algo, src_planes):
+    ctx = lib.swscale_create(sw, sh, sfmt, dw, dh, dfmt, algo)
+    s_count = workloads.plane_count(sfmt)
+    d_count = workloads.plane_count(dfmt)
+    s_ptrs = (ctypes.c_char_p * 4)()
+    s_str = (ctypes.c_int * 4)()
+    for p in range(s_count):
+        s_str[p] = workloads.plane_row_bytes(sfmt, sw, p)
+        s_ptrs[p] = ctypes.cast((ctypes.c_char * len(src_planes[p])).from_buffer(src_planes[p]), ctypes.c_char_p)
+    d_ptrs = (ctypes.c_char_p * 4)()
+    d_str = (ctypes.c_int * 4)()
+    d_bufs = []
+    for p in range(d_count):
+        d_str[p] = workloads.plane_row_bytes(dfmt, dw, p)
+        rows = workloads.plane_rows(dfmt, dh, p)
+        b = bytearray(d_str[p] * rows)
+        d_bufs.append(b)
+        d_ptrs[p] = ctypes.cast((ctypes.c_char * len(b)).from_buffer(b), ctypes.c_char_p)
+    lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+    lib.swscale_destroy(ctx)
+    return d_bufs
+
+# For s004: yuv420p (1280x720) -> rgb24 (640x360) bilinear
+# Compare direct s004 vs (yuv420p 1280x720 -> yuv420p 640x360) then (yuv420p 640x360 -> rgb24 640x360)
+sw, sh, dw, dh = 1280, 720, 640, 360
+s0 = bytearray((i*37 + 0*101) & 0xff for i in range(sw * sh))
+s1 = bytearray((i*37 + 1*101) & 0xff for i in range(sw * sh // 4))
+s2 = bytearray((i*37 + 2*101) & 0xff for i in range(sw * sh // 4))
+
+ref = run_conv(0, 5, sw, sh, dw, dh, 1, [s0, s1, s2]) # direct s004
+
+# Two step: scale YUV420P first, then convert to RGB24
+scaled_yuv = run_conv(0, 0, sw, sh, dw, dh, 1, [s0, s1, s2])
+two_step = run_conv(0, 5, dw, dh, dw, dh, 1, scaled_yuv)
+
+print("s004 Two-step PSNR:", workloads.psnr(ref[0], two_step[0]))
diff --git a/swscale-impl/test_uv_ffmpeg.py b/swscale-impl/test_uv_ffmpeg.py
