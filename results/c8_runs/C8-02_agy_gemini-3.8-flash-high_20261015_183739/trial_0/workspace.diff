@@ -0,0 +1,181 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const Filter1D = struct {
+    pos: []i32,
+    weights: []i16,
+    filter_size: usize,
+
+    pub fn deinit(self: *Filter1D, allocator: Allocator) void {
+        allocator.free(self.pos);
+        allocator.free(self.weights);
+    }
+};
+
+pub fn makeFilter(allocator: Allocator, src_len: usize, dst_len: usize, algo: u32) !Filter1D {
+    var pos = try allocator.alloc(i32, dst_len);
+    errdefer allocator.free(pos);
+
+    if (algo == 0) { // NEAREST
+        var weights = try allocator.alloc(i16, dst_len);
+        var x: usize = 0;
+        while (x < dst_len) : (x += 1) {
+            const p = (2 * x + 1) * src_len / (2 * dst_len);
+            pos[x] = @intCast(std.math.clamp(p, 0, src_len - 1));
+            weights[x] = 16384;
+        }
+        return Filter1D{ .pos = pos, .weights = weights, .filter_size = 1 };
+    } else if (algo == 1) { // BILINEAR
+        if (src_len <= dst_len) { // upscale
+            var weights = try allocator.alloc(i16, dst_len * 2);
+            var x: usize = 0;
+            while (x < dst_len) : (x += 1) {
+                const center_num: i64 = (@as(i64, @intCast(2 * x + 1)) * @as(i64, @intCast(src_len)) * 32768);
+                const center_16: i64 = @divTrunc(center_num, @as(i64, @intCast(dst_len))) - 32768;
+                const p: i64 = if (center_16 >= 0) center_16 >> 16 else -1;
+                const frac_raw: i64 = if (center_16 >= 0) (center_16 >> 2) & 0x3fff else 0;
+                var p_idx: usize = 0;
+                var frac: i16 = 0;
+                if (center_16 < 0) {
+                    p_idx = 0;
+                    frac = 0;
+                } else if (p >= src_len - 1) {
+                    p_idx = if (src_len >= 2) src_len - 2 else 0;
+                    frac = 16384;
+                } else {
+                    p_idx = @intCast(p);
+                    frac = @truncate(@as(i32, @intCast(frac_raw)));
+                }
+                pos[x] = @intCast(p_idx);
+                weights[x * 2 + 0] = 16384 - frac;
+                weights[x * 2 + 1] = frac;
+            }
+            return Filter1D{ .pos = pos, .weights = weights, .filter_size = 2 };
+        } else { // downscale
+            var weights = try allocator.alloc(i16, dst_len * 4);
+            var x: usize = 0;
+            while (x < dst_len) : (x += 1) {
+                if (x == 0) {
+                    pos[x] = 0;
+                    weights[0] = 8192;
+                    weights[1] = 6144;
+                    weights[2] = 2048;
+                    weights[3] = 0;
+                } else if (x == dst_len - 1) {
+                    pos[x] = @intCast(if (src_len >= 4) src_len - 4 else 0);
+                    weights[x * 4 + 0] = 0;
+                    weights[x * 4 + 1] = 2048;
+                    weights[x * 4 + 2] = 6144;
+                    weights[x * 4 + 3] = 8192;
+                } else {
+                    const center = (x * src_len) / dst_len;
+                    const max_pos = if (src_len >= 4) src_len - 4 else 0;
+                    const p = if (center >= 1) std.math.clamp(center - 1, 0, max_pos) else 0;
+                    pos[x] = @intCast(p);
+                    weights[x * 4 + 0] = 2048;
+                    weights[x * 4 + 1] = 6144;
+                    weights[x * 4 + 2] = 6144;
+                    weights[x * 4 + 3] = 2048;
+                }
+            }
+            return Filter1D{ .pos = pos, .weights = weights, .filter_size = 4 };
+        }
+    } else { // BICUBIC
+        var weights = try allocator.alloc(i16, dst_len * 4);
+        var x: usize = 0;
+        while (x < dst_len) : (x += 1) {
+            const center_f = (@as(f64, @floatFromInt(x)) + 0.5) * (@as(f64, @floatFromInt(src_len)) / @as(f64, @floatFromInt(dst_len))) - 0.5;
+            const x0 = @as(i32, @intFromFloat(@floor(center_f)));
+            const frac = center_f - @as(f64, @floatFromInt(x0));
+            pos[x] = @intCast(std.math.clamp(x0 - 1, 0, @as(i32, @intCast(if (src_len >= 4) src_len - 4 else 0))));
+
+            const w0 = bicubic_weight(1.0 + frac);
+            const w1 = bicubic_weight(frac);
+            const w2 = bicubic_weight(1.0 - frac);
+            const w3 = bicubic_weight(2.0 - frac);
+            const sum_w = w0 + w1 + w2 + w3;
+            const iw0: i16 = @intFromFloat(@round(w0 * 16384.0 / sum_w));
+            const iw1: i16 = @intFromFloat(@round(w1 * 16384.0 / sum_w));
+            const iw2: i16 = @intFromFloat(@round(w2 * 16384.0 / sum_w));
+            const iw3: i16 = 16384 - (iw0 + iw1 + iw2);
+
+            weights[x * 4 + 0] = iw0;
+            weights[x * 4 + 1] = iw1;
+            weights[x * 4 + 2] = iw2;
+            weights[x * 4 + 3] = iw3;
+        }
+        return Filter1D{ .pos = pos, .weights = weights, .filter_size = 4 };
+    }
+}
+
+fn bicubic_weight(d_in: f64) f64 {
+    const d = @abs(d_in);
+    const B: f64 = 0.0;
+    const C: f64 = 0.6;
+    if (d < 1.0) {
+        return ((12.0 - 9.0 * B - 6.0 * C) * d * d * d + (-18.0 + 12.0 * B + 6.0 * C) * d * d + (6.0 - 2.0 * B)) / 6.0;
+    } else if (d < 2.0) {
+        return ((-B - 6.0 * C) * d * d * d + (6.0 * B + 30.0 * C) * d * d + (-12.0 * B - 48.0 * C) * d + (8.0 * B + 24.0 * C)) / 6.0;
+    }
+    return 0.0;
+}
+
+pub fn scalePlane(
+    src: [*]const u8, src_stride: usize, src_w: usize, src_h: usize,
+    dst: [*]u8, dst_stride: usize, dst_w: usize, dst_h: usize,
