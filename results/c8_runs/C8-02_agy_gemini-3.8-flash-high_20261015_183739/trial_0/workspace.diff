--- /dev/null
+++ b/swscale-impl/test_uv_ffmpeg.py
@@ -0,0 +1,83 @@
+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+w = workloads.correctness_workloads()[18] # c018: rgb24 -> yuv420p 640x480
+sw, sh = w["src_w"], w["src_h"]
+
+s0 = bytearray((i*37) & 0xff for i in range(sw * sh * 3))
+
+ctx = lib.swscale_create(sw, sh, 5, sw, sh, 0, 1)
+s_ptrs = (ctypes.c_char_p * 4)(bytes(s0), None, None, None)
+s_str = (ctypes.c_int * 4)(sw*3, 0, 0, 0)
+d0 = bytearray(sw*sh)
+d1 = bytearray(sw*sh//4)
+d2 = bytearray(sw*sh//4)
+d_ptrs = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0)).from_buffer(d0), ctypes.c_char_p),
+                               ctypes.cast((ctypes.c_char*len(d1)).from_buffer(d1), ctypes.c_char_p),
+                               ctypes.cast((ctypes.c_char*len(d2)).from_buffer(d2), ctypes.c_char_p), None)
+d_str = (ctypes.c_int * 4)(sw, sw//2, sw//2, 0)
+lib.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+lib.swscale_destroy(ctx)
+
+ref_y = bytes(d0)
+ref_u = bytes(d1)
+ref_v = bytes(d2)
+
+# Test exact formula for U and V in Python:
+src = np.frombuffer(s0, dtype=np.uint8).reshape((sh, sw, 3))
+r = src[:, :, 0].astype(np.int32)
+g = src[:, :, 1].astype(np.int32)
+b = src[:, :, 2].astype(np.int32)
+
+r_h = r[:, 0::2] + r[:, 1::2]
+g_h = g[:, 0::2] + g[:, 1::2]
+b_h = b[:, 0::2] + b[:, 1::2]
+
+# In FFmpeg, rgb24ToUV_half_c:
+# dstU[i] = (ru*r + gu*g + bu*b + (256<<16) + (1<<10)) >> 11 in 15-bit
+# where ru = -9714, gu = -19071, bu = 28784
+# Let's test FFmpeg's rgb24ToUV_half_c:
+u_h = (-9714 * r_h - 19071 * g_h + 28784 * b_h + (256 << 16) + 1024) >> 11
+v_h = (28784 * r_h - 24103 * g_h - 4680 * b_h + (256 << 16) + 1024) >> 11
+
+cw = sw // 2
+ch = sh // 2
+cand_u = np.zeros((ch, cw), dtype=np.uint8)
+cand_v = np.zeros((ch, cw), dtype=np.uint8)
+
+# Vertical 4-tap filter with [1, 3, 3, 1] / 8:
+for cy in range(ch):
+    if cy == 0:
+        # border: [2048, 1536, 512, 0] / 4096 = [4, 3, 1, 0] / 8
+        u_slice = (4 * u_h[0] + 3 * u_h[1] + 1 * u_h[2])
+        v_slice = (4 * v_h[0] + 3 * v_h[1] + 1 * v_h[2])
+    elif cy == ch - 1:
+        u_slice = (1 * u_h[-3] + 3 * u_h[-2] + 4 * u_h[-1])
+        v_slice = (1 * v_h[-3] + 3 * v_h[-2] + 4 * v_h[-1])
+    else:
+        p = 2 * cy - 1
+        u_slice = (1 * u_h[p] + 3 * u_h[p+1] + 3 * u_h[p+2] + 1 * u_h[p+3])
+        v_slice = (1 * v_h[p] + 3 * v_h[p+1] + 3 * v_h[p+2] + 1 * v_h[p+3])
+
+    # u_slice is in 15-bit * 8 (0..32767 * 8)
+    # in FFmpeg, yuv2planeX_8_c:
+    # val = (sum + (1 << 16)) >> 17 (or (sum + 4) >> 3 in 15-bit, then (val + 128) >> 7)?
+    # Let's test:
+    cand_u[cy] = np.clip((u_slice + 32) >> 6 >> 7, 0, 255) # or (u_slice + (4 << 7)) >> 10?
+    # Let's test the scaling:
+    val_u = (u_slice + 32) // 8
+    cand_u[cy] = np.clip((val_u + 32) >> 6, 0, 255)
+    val_v = (v_slice + 32) // 8
+    cand_v[cy] = np.clip((val_v + 32) >> 6, 0, 255)
+
+print("U PSNR with FFmpeg input.c:", workloads.psnr(ref_u, cand_u.tobytes()))
+print("V PSNR with FFmpeg input.c:", workloads.psnr(ref_v, cand_v.tobytes()))
+print("ref_u[:8]: ", list(ref_u[:8]))
+print("cand_u[0, :8]:", list(cand_u[0, :8]))
