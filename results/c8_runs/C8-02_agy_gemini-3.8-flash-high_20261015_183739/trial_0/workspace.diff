+        while (x < w) : (x += 1) {
+            const r: i32 = if (!is_bgr) s_row[x * bpp + 0] else s_row[x * bpp + 2];
+            const g: i32 = s_row[x * bpp + 1];
+            const b: i32 = if (!is_bgr) s_row[x * bpp + 2] else s_row[x * bpp + 0];
