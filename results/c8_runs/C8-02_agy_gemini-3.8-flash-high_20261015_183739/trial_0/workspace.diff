diff --git a/swscale-impl/build.zig b/swscale-impl/build.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/build.zig
@@ -0,0 +1,18 @@
+const std = @import("std");
+
+pub fn build(b: *std.Build) void {
+    const target = b.resolveTargetQuery(.{
+        .cpu_model = .{ .explicit = &std.Target.x86.cpu.x86_64_v3 },
+    });
+    const optimize = b.standardOptimizeOption(.{});
+
+    const lib = b.addSharedLibrary(.{
+        .name = "swscale_candidate",
+        .root_source_file = b.path("src/main.zig"),
+        .target = target,
+        .optimize = optimize,
+    });
+    lib.linkLibC();
+
+    b.installArtifact(lib);
+}
diff --git a/swscale-impl/debug_c000.py b/swscale-impl/debug_c000.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/debug_c000.py
@@ -0,0 +1,38 @@
+import ctypes, numpy as np, workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)
+]
+
+cand_lib = ctypes.CDLL("/app/swscale-impl/zig-out/lib/libswscale_candidate.so")
+cand_lib.swscale_create.restype = ctypes.c_void_p
+cand_lib.swscale_process.argtypes = lib.swscale_process.argtypes
+
+w = workloads.correctness_workloads()[0] # c000: yuv420p -> rgb24 640x480
+sw, sh = w["src_w"], w["src_h"]
+
+s0 = bytearray((0*101 + i*37)&0xff for i in range(sw*sh))
+s1 = bytearray((1*101 + i*37)&0xff for i in range(sw*sh//4))
+s2 = bytearray((2*101 + i*37)&0xff for i in range(sw*sh//4))
+
+def run(lib_obj):
+    ctx = lib_obj.swscale_create(sw, sh, 0, sw, sh, 5, 1)
+    s_ptrs = (ctypes.c_char_p * 4)(bytes(s0), bytes(s1), bytes(s2), None)
+    s_str = (ctypes.c_int * 4)(sw, sw//2, sw//2, 0)
+    d0 = bytearray(sw*sh*3)
+    d_ptrs = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0)).from_buffer(d0), ctypes.c_char_p), None, None, None)
+    d_str = (ctypes.c_int * 4)(sw*3, 0, 0, 0)
+    lib_obj.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+    lib_obj.swscale_destroy(ctx)
+    return bytes(d0)
+
+ref = run(lib)
+cand = run(cand_lib)
+
+print("ref[:12]: ", list(ref[:12]))
+print("cand[:12]:", list(cand[:12]))
+print("s0[:4]:", list(s0[:4]), "s1[:2]:", list(s1[:2]), "s2[:2]:", list(s2[:2]))
diff --git a/swscale-impl/debug_c013.py b/swscale-impl/debug_c013.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/debug_c013.py
@@ -0,0 +1,51 @@
+import ctypes, numpy as np, workloads
+
+cand_lib = ctypes.CDLL("/app/swscale-impl/zig-out/lib/libswscale_candidate.so")
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+
+w = workloads.correctness_workloads()[13] # c013: nv12 -> rgb24
+sw, sh = w["src_w"], w["src_h"]
+
+s0 = bytearray((0*101 + i*37)&0xff for i in range(sw*sh))
+s1 = bytearray((1*101 + i*37)&0xff for i in range(sw*sh//2))
+
+def run(lib_obj):
+    ctx = lib_obj.swscale_create(sw, sh, 3, sw, sh, 5, 1) # 3 = NV12, 5 = RGB24
+    s_ptrs = (ctypes.c_char_p * 4)(bytes(s0), bytes(s1), None, None)
+    s_str = (ctypes.c_int * 4)(sw, sw, 0, 0)
+    d0 = bytearray(sw*sh*3)
+    d_ptrs = (ctypes.c_char_p * 4)(ctypes.cast((ctypes.c_char*len(d0)).from_buffer(d0), ctypes.c_char_p), None, None, None)
+    d_str = (ctypes.c_int * 4)(sw*3, 0, 0, 0)
+    lib_obj.swscale_process(ctx, s_ptrs, s_str, d_ptrs, d_str)
+    lib_obj.swscale_destroy(ctx)
+    return bytes(d0)
+
+ref = run(lib)
+cand = run(cand_lib)
+
+print("c013 PSNR:", workloads.psnr(ref, cand))
+print("ref[:12]: ", list(ref[:12]))
+print("cand[:12]:", list(cand[:12]))
+
+# Find where ref and cand differ
+r_arr = np.frombuffer(ref, dtype=np.uint8)
+c_arr = np.frombuffer(cand, dtype=np.uint8)
+diff = np.where(r_arr != c_arr)[0]
+if len(diff) > 0:
+    first = diff[0]
+    print(f"First diff at byte {first}: ref={r_arr[first]} cand={c_arr[first]}")
+    # pixel row and col:
+    px = first // 3
+    y = px // sw
+    x = px % sw
+    c = first % 3
+    print(f"At y={y}, x={x}, channel={c}")
+
+mse = np.mean((r_arr.astype(float) - c_arr.astype(float))**2)
+print("MSE:", mse)
+print("max diff:", np.max(np.abs(r_arr.astype(float) - c_arr.astype(float))))
+print("ref shape:", r_arr.shape, "cand shape:", c_arr.shape)
+# print difference on later rows:
+print("Row 0 MSE:", np.mean((r_arr[:sw*3].astype(float) - c_arr[:sw*3].astype(float))**2))
+print("Row 1 MSE:", np.mean((r_arr[sw*3:sw*6].astype(float) - c_arr[sw*3:sw*6].astype(float))**2))
+print("Row 2 MSE:", np.mean((r_arr[sw*6:sw*9].astype(float) - c_arr[sw*6:sw*9].astype(float))**2))
