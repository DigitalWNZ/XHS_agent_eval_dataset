+// RGB -> YUV same size (workload b001, b003)
+pub fn rgb_to_yuv420p(
+    src: [*]const u8, src_stride: usize,
+    d_y: [*]u8, d_ys: usize, d_u: [*]u8, d_us: usize, d_v: [*]u8, d_vs: usize,
+    w: usize, h: usize, src_fmt: c_int,
+    u_buf: []i32, v_buf: []i32, // temporary line buffers: h rows * ((w+1)/2)
+) void {
+    const is_bgr = (src_fmt == 6 or src_fmt == 8);
+    const has_alpha = (src_fmt == 7 or src_fmt == 8);
+    const bpp: usize = if (has_alpha) 4 else 3;
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
