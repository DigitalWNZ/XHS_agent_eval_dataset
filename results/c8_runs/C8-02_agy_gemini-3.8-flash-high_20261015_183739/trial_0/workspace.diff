+                const v_val2 = v_buf[(p + 2) * cw + cx];
+                const v_val3 = v_buf[(p + 3) * cw + cx];
+                u_sum = 1 * @as(i64, u_val0) + 3 * @as(i64, u_val1) + 3 * @as(i64, u_val2) + 1 * @as(i64, u_val3);
+                v_sum = 1 * @as(i64, v_val0) + 3 * @as(i64, v_val1) + 3 * @as(i64, v_val2) + 1 * @as(i64, v_val3);
