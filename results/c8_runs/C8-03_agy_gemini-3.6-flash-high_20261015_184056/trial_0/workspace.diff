diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,56 @@
+WITH candidate_words AS (
+  SELECT wordid
+  FROM senses
+  GROUP BY wordid
+  HAVING COUNT(*) >= 2
+),
+top_words AS (
+  SELECT 
+    s.wordid AS word_id,
+    COUNT(DISTINCT s.synsetid) AS total_synsets,
+    COUNT(*) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids
+  FROM candidate_words cw
+  JOIN senses s ON cw.wordid = s.wordid
+  JOIN synsets syn ON s.synsetid = syn.synsetid
+  GROUP BY s.wordid
+  HAVING total_synsets >= 2
+    AND distinct_domains >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    word_id ASC
+  LIMIT 500
+),
+synset_counts AS (
+  SELECT 
+    s.wordid,
+    s.synsetid,
+    COUNT(*) AS sense_cnt,
+    ROW_NUMBER() OVER (
+      PARTITION BY s.wordid 
+      ORDER BY COUNT(*) DESC, s.synsetid ASC
+    ) AS rn
+  FROM senses s
+  JOIN top_words tw ON s.wordid = tw.word_id
+  GROUP BY s.wordid, s.synsetid
+)
+SELECT
+  tw.word_id,
+  w.word,
+  tw.total_synsets,
+  tw.total_senses,
+  tw.distinct_domains,
+  tw.distinct_posids,
+  sc.synsetid AS top_synsetid,
+  sc.sense_cnt AS top_synset_sense_count
+FROM top_words tw
+JOIN words w ON tw.word_id = w.wordid
+JOIN synset_counts sc ON tw.word_id = sc.wordid AND sc.rn = 1
+ORDER BY
+  tw.total_senses DESC,
+  tw.total_synsets DESC,
+  tw.distinct_domains DESC,
+  tw.word_id ASC;
