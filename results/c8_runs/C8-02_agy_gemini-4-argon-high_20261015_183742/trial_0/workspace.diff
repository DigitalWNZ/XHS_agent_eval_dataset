+const YUV2RGB_U2G_COEFF: i32 = -3209;
+const YUV2RGB_U2B_COEFF: i32 = 16525;
+
+const RING_SIZE: usize = 128;
+const RING_MASK: usize = RING_SIZE - 1;
+
+const FastPath = enum {
+    general,
+    copy_planar,
+    copy_packed,
+    gray_to_yuv_planar,
+    yuv420p_to_nv12,
+    yuv420p_to_nv21,
+    nv12_to_yuv420p,
+    nv21_to_yuv420p,
+    yuv420p_to_rgb,
+    yuv422p_to_rgb,
+    rgb_to_rgb,
+    bgr24_to_yuv420p_unscaled,
+    rgb_to_yuv420p_same,
+    rgb_to_nv_same,
+};
+
+const Filter = struct {
+    coeffs: []i16,
+    pos: []i32,
+    size: usize,
+
+    fn deinit(self: *Filter, alloc: std.mem.Allocator) void {
+        if (self.coeffs.len > 0) alloc.free(self.coeffs);
+        if (self.pos.len > 0) alloc.free(self.pos);
+    }
+};
+
+const SwsContext = struct {
+    src_w: usize,
+    src_h: usize,
+    src_fmt: i32,
+    dst_w: usize,
+    dst_h: usize,
+    dst_fmt: i32,
+    algo: i32,
+    flags: i32,
