+                        @memset(uv_dst[0 .. ctx.chr_dst_w * 2], 128);
+                    } else {
+                        yuv2nv12cX(ctx.dst_fmt, chr_filter, chr_u_ptrs[0..v_chr_size], chr_v_ptrs[0..v_chr_size], uv_dst, ctx.chr_dst_w);
+                    }
+                } else {
+                    const u_base = dst_data[1].?;
+                    const v_base = dst_data[2].?;
+                    const u_str: isize = @intCast(dst_stride[1]);
+                    const v_str: isize = @intCast(dst_stride[2]);
+                    const u_dst: [*]u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(u_base))) + @as(isize, @intCast(chr_dst_y)) * u_str)));
+                    const v_dst: [*]u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(v_base))) + @as(isize, @intCast(chr_dst_y)) * v_str)));
+                    if (!ctx.needs_hcscale) {
+                        @memset(u_dst[0..ctx.chr_dst_w], 128);
+                        @memset(v_dst[0..ctx.chr_dst_w], 128);
+                    } else if (v_chr_size == 1) {
+                        yuv2plane1_8(chr_u_ptrs[0], u_dst, ctx.chr_dst_w);
+                        yuv2plane1_8(chr_v_ptrs[0], v_dst, ctx.chr_dst_w);
+                    } else {
+                        yuv2planeX_8(chr_filter, chr_u_ptrs[0..v_chr_size], u_dst, ctx.chr_dst_w);
+                        yuv2planeX_8(chr_filter, chr_v_ptrs[0..v_chr_size], v_dst, ctx.chr_dst_w);
+                    }
+                }
+            }
+        } else {
+            const d_base = dst_data[0].?;
+            const d_str: isize = @intCast(dst_stride[0]);
+            const d_dst: [*]u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d_base))) + @as(isize, @intCast(dst_y)) * d_str)));
