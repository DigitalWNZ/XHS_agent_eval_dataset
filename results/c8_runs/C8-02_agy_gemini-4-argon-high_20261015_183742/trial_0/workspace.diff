+    const b_off_16: Vec16i16 = u_i16 - c190 + @as(Vec16i16, @intCast(mulhuw16(u16_v, mc.c48001)));
+    const g_off_16: Vec16i16 = c165 - u_i16 - v_i16 + @as(Vec16i16, @intCast(mulhuw16(u16_v, mc.c43486))) + @as(Vec16i16, @intCast(mulhuw16(v16_v, mc.c19779)));
