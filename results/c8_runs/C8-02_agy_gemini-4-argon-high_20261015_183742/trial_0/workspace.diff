+    const v_i16 = @min(c255, @max(zero, v_raw));
+    const mc = YuvMulConsts.load();
+    const u16_v: Vec16u16 = @as(Vec16u16, @intCast(u_i16)) | mc.mask;
+    const v16_v: Vec16u16 = @as(Vec16u16, @intCast(v_i16)) | mc.mask;
