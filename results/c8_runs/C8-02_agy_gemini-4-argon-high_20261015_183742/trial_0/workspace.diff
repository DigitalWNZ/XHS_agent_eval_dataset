+fn packedVscaleRow(
+    ctx: *const SwsContext,
+    lum_filter: []const i16,
+    lum_lines: []const [*]const i16,
+    chr_filter: []const i16,
+    chr_u_lines: []const [*]const i16,
+    chr_v_lines: []const [*]const i16,
+    alp_lines: []const [*]const i16,
