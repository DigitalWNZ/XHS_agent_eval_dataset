+
+fn ensureChrRow(ctx: *SwsContext, cy: i32, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int, u_out: *[*]const i16, v_out: *[*]const i16) void {
+    const slot: usize = @as(usize, @intCast(cy)) & RING_MASK;
+    const dst_u = ctx.chr_u_ring_buf[slot * ctx.ring_chr_stride ..][0..ctx.chr_dst_w];
+    const dst_v = ctx.chr_v_ring_buf[slot * ctx.ring_chr_stride ..][0..ctx.chr_dst_w];
+    if (ctx.chr_ring_tag[slot] == cy) {
+        u_out.* = dst_u.ptr;
+        v_out.* = dst_v.ptr;
+        return;
+    }
+    ctx.chr_ring_tag[slot] = cy;
+
+    if (ctx.src_bpc == 16) {
+        const s_base = src_data[0].?;
+        const s_str: isize = @intCast(src_stride[0]);
+        const src_row: [*]const u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s_base))) + @as(isize, cy) * s_str)));
+        rgbRowToUV(src_row, ctx.chr_u_conv_buf[0..ctx.chr_src_w], ctx.chr_v_conv_buf[0..ctx.chr_src_w], ctx.chr_src_w, ctx.src_fmt, ctx.chr_src_h_sub == 1);
