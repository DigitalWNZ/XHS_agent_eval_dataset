+    } else if (isSemiPlanarYUV(ctx.src_fmt)) {
+        const uv_base = src_data[1].?;
+        const uv_str: isize = @intCast(src_stride[1]);
+        const src_row: [*]const u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(uv_base))) + @as(isize, cy) * uv_str)));
+        const u8_u: [*]u8 = @ptrCast(ctx.chr_u_conv_buf.ptr);
+        const u8_v: [*]u8 = @ptrCast(ctx.chr_v_conv_buf.ptr);
+        const swap = ctx.src_fmt == PIXFMT_NV21;
+        for (0..ctx.chr_src_w) |x| {
+            u8_u[x] = src_row[2 * x + @intFromBool(swap)];
+            u8_v[x] = src_row[2 * x + @intFromBool(!swap)];
+        }
+        hScale8To15(dst_u, ctx.chr_dst_w, u8_u, ctx.h_chr.coeffs, ctx.h_chr.pos, ctx.h_chr.size);
+        hScale8To15(dst_v, ctx.chr_dst_w, u8_v, ctx.h_chr.coeffs, ctx.h_chr.pos, ctx.h_chr.size);
+    } else {
+        const u_base = src_data[1].?;
+        const v_base = src_data[2].?;
+        const u_str: isize = @intCast(src_stride[1]);
+        const v_str: isize = @intCast(src_stride[2]);
+        const src_u: [*]const u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(u_base))) + @as(isize, cy) * u_str)));
+        const src_v: [*]const u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(v_base))) + @as(isize, cy) * v_str)));
+        hScale8To15(dst_u, ctx.chr_dst_w, src_u, ctx.h_chr.coeffs, ctx.h_chr.pos, ctx.h_chr.size);
+        hScale8To15(dst_v, ctx.chr_dst_w, src_v, ctx.h_chr.coeffs, ctx.h_chr.pos, ctx.h_chr.size);
+    }
+    u_out.* = dst_u.ptr;
+    v_out.* = dst_v.ptr;
+}
