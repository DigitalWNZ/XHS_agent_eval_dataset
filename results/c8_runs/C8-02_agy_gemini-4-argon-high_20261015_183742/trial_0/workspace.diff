+fn ensureLumRow(ctx: *SwsContext, sy: i32, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int) [*]const i16 {
+    const slot: usize = @as(usize, @intCast(sy)) & RING_MASK;
+    const dst_slice = ctx.lum_ring_buf[slot * ctx.ring_lum_stride ..][0..ctx.dst_w];
+    if (ctx.lum_ring_tag[slot] == sy) {
+        return dst_slice.ptr;
+    }
+    ctx.lum_ring_tag[slot] = sy;
+
+    const s_base = src_data[0].?;
+    const s_str: isize = @intCast(src_stride[0]);
+    const src_row: [*]const u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s_base))) + @as(isize, sy) * s_str)));
+
+    if (ctx.src_bpc == 16) {
+        rgbRowToY(src_row, ctx.lum_conv_buf[0..ctx.src_w], ctx.src_w, ctx.src_fmt);
+        hScale16To15(dst_slice, ctx.dst_w, ctx.lum_conv_buf[0..ctx.src_w], ctx.h_lum.coeffs, ctx.h_lum.pos, ctx.h_lum.size);
