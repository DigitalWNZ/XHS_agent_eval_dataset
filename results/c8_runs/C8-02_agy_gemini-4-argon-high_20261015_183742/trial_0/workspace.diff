+fn processGeneral(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) void {
+    @memset(&ctx.lum_ring_tag, -1);
+    @memset(&ctx.chr_ring_tag, -1);
+
+    var lum_ptrs: [64][*]const i16 = undefined;
+    var alp_ptrs: [64][*]const i16 = undefined;
+    var chr_u_ptrs: [64][*]const i16 = undefined;
+    var chr_v_ptrs: [64][*]const i16 = undefined;
+
+    const v_lum_size = ctx.v_lum.size;
+    const v_chr_size = ctx.v_chr.size;
+    const src_h_i: i32 = @intCast(ctx.src_h);
+    const chr_src_h_i: i32 = @intCast(ctx.chr_src_h);
+    const is_planar_dst = isPlanarYUV(ctx.dst_fmt) or ctx.dst_fmt == PIXFMT_GRAY8;
+    const chr_skip_mask: usize = (@as(usize, 1) << ctx.chr_dst_v_sub) - 1;
+
+    if (!ctx.needs_hcscale) {
+        chr_u_ptrs[0] = ctx.chr_u_ring_buf.ptr;
+        chr_v_ptrs[0] = ctx.chr_v_ring_buf.ptr;
+    }
+
+    for (0..ctx.dst_h) |dst_y| {
+        const first_lum: i32 = @max(1 - @as(i32, @intCast(v_lum_size)), ctx.v_lum.pos[dst_y]);
+        for (0..v_lum_size) |j| {
+            const sy = @min(src_h_i - 1, @max(0, first_lum + @as(i32, @intCast(j))));
+            lum_ptrs[j] = ensureLumRow(ctx, sy, src_data, src_stride);
+            if (ctx.need_alpha) {
+                const slot: usize = @as(usize, @intCast(sy)) & RING_MASK;
+                alp_ptrs[j] = ctx.alp_ring_buf[slot * ctx.ring_lum_stride ..].ptr;
+            }
+        }
+
+        const chr_dst_y = dst_y >> ctx.chr_dst_v_sub;
+        const do_chr = ctx.needs_hcscale and (!is_planar_dst or (dst_y & chr_skip_mask) == 0);
+        if (do_chr) {
+            const first_chr: i32 = @max(1 - @as(i32, @intCast(v_chr_size)), ctx.v_chr.pos[chr_dst_y]);
+            for (0..v_chr_size) |j| {
+                const cy = @min(chr_src_h_i - 1, @max(0, first_chr + @as(i32, @intCast(j))));
+                ensureChrRow(ctx, cy, src_data, src_stride, &chr_u_ptrs[j], &chr_v_ptrs[j]);
+            }
+        }
+
+        const lum_filter = ctx.v_lum.coeffs[dst_y * v_lum_size ..][0..v_lum_size];
+        const chr_filter = ctx.v_chr.coeffs[chr_dst_y * v_chr_size ..][0..v_chr_size];
+
+        if (is_planar_dst) {
+            const y_base = dst_data[0].?;
+            const y_str: isize = @intCast(dst_stride[0]);
+            const y_dst: [*]u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(y_base))) + @as(isize, @intCast(dst_y)) * y_str)));
+
+            if (v_lum_size == 1) {
+                yuv2plane1_8(lum_ptrs[0], y_dst, ctx.dst_w);
+            } else {
+                yuv2planeX_8(lum_filter, lum_ptrs[0..v_lum_size], y_dst, ctx.dst_w);
+            }
+
+            if (ctx.dst_fmt != PIXFMT_GRAY8 and (dst_y & chr_skip_mask) == 0) {
+                if (isSemiPlanarYUV(ctx.dst_fmt)) {
+                    const uv_base = dst_data[1].?;
+                    const uv_str: isize = @intCast(dst_stride[1]);
+                    const uv_dst: [*]u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(uv_base))) + @as(isize, @intCast(chr_dst_y)) * uv_str)));
