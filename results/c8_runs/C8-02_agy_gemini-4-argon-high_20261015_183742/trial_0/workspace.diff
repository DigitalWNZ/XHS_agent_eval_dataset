+            var val: i32 = 0;
+            const f_row = filter[i * filter_size ..][0..filter_size];
+            for (0..filter_size) |j| {
+                val += @as(i32, src_ptr[pos + j]) * @as(i32, f_row[j]);
+            }
+            dst[i] = @intCast(@min(val >> 13, (1 << 15) - 1));
