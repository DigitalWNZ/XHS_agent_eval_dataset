+fn convertRgbToRgb(
+    ctx: *const SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) void {
+    const w = ctx.src_w;
+    const h = ctx.src_h;
+    const s_base = src_data[0].?;
+    const d_base = dst_data[0].?;
+    const s_str: isize = @intCast(src_stride[0]);
+    const d_str: isize = @intCast(dst_stride[0]);
+    const s_fmt = ctx.src_fmt;
+    const d_fmt = ctx.dst_fmt;
+    const swap_rb = (s_fmt == PIXFMT_RGB24 or s_fmt == PIXFMT_RGBA) != (d_fmt == PIXFMT_RGB24 or d_fmt == PIXFMT_RGBA);
+    const s_bpp: usize = if (isAlpha(s_fmt)) 4 else 3;
+    const d_bpp: usize = if (isAlpha(d_fmt)) 4 else 3;
+
+    const alpha_mask_16: Vec16u8 = .{ 0, 0, 0, 255, 0, 0, 0, 255, 0, 0, 0, 255, 0, 0, 0, 255 };
+
+    for (0..h) |y| {
+        const ps: [*]const u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(s_base))) + @as(isize, @intCast(y)) * s_str)));
+        const pd: [*]u8 = @ptrFromInt(@as(usize, @intCast(@as(isize, @intCast(@intFromPtr(d_base))) + @as(isize, @intCast(y)) * d_str)));
+
+        var x: usize = 0;
+        if (s_bpp == 3 and d_bpp == 4) {
+            // 3 -> 4 bytes per pixel (e.g. b002: RGB24 -> BGRA)
+            // Process 16 pixels (48 bytes in -> 64 bytes out)
+            while (x + 16 <= w) : (x += 16) {
+                const in0: Vec16u8 = @as(*align(1) const Vec16u8, @ptrCast(ps + x * 3 + 0)).*;
+                const in1: Vec16u8 = @as(*align(1) const Vec16u8, @ptrCast(ps + x * 3 + 16)).*;
+                const in2: Vec16u8 = @as(*align(1) const Vec16u8, @ptrCast(ps + x * 3 + 32)).*;
+
+                // 4 groups of 12 bytes:
+                // g0: bytes 0..11 of in0
+                // g1: bytes 12..15 of in0 + bytes 0..7 of in1
+                // g2: bytes 8..15 of in1 + bytes 0..3 of in2
+                // g3: bytes 4..15 of in2
+                const g0 = in0;
+                const g1 = @shuffle(u8, in0, in1, [16]i32{ 12, 13, 14, 15, -1, -2, -3, -4, -5, -6, -7, -8, 0, 0, 0, 0 });
