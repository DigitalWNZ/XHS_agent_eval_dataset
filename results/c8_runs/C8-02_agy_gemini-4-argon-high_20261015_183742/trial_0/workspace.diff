+    }
+    while (x < chr_dst_w) : (x += 1) {
+        var u: i32 = 1 << 18;
+        var v: i32 = 1 << 18;
+        for (0..fsize) |j| {
+            const c: i32 = filter[j];
+            u += @as(i32, u_lines[j][x]) * c;
+            v += @as(i32, v_lines[j][x]) * c;
+        }
+        const u8_val = clipU8(u >> 19);
+        const v8_val = clipU8(v >> 19);
+        dst[2 * x + 0] = if (swap) v8_val else u8_val;
+        dst[2 * x + 1] = if (swap) u8_val else v8_val;
+    }
+}
