+inline fn yuv32ToRgb(
+    y_lo: Vec16i16,
+    y_hi: Vec16i16,
+    u_raw: Vec16i16,
+    v_raw: Vec16i16,
+    pd: [*]u8,
+    dst_fmt: i32,
