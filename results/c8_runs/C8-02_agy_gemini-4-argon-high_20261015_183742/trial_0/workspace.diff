+            const alp_slice = ctx.alp_ring_buf[slot * ctx.ring_lum_stride ..][0..ctx.dst_w];
+            rgbRowToA(src_row, ctx.alp_conv_buf[0..ctx.src_w], ctx.src_w);
+            hScale16To15(alp_slice, ctx.dst_w, ctx.alp_conv_buf[0..ctx.src_w], ctx.h_lum.coeffs, ctx.h_lum.pos, ctx.h_lum.size);
+        }
+    } else {
+        hScale8To15(dst_slice, ctx.dst_w, src_row, ctx.h_lum.coeffs, ctx.h_lum.pos, ctx.h_lum.size);
+    }
+
+    if ((ctx.src_fmt == PIXFMT_GRAY8) != (ctx.dst_fmt == PIXFMT_GRAY8) and !isAnyRGB(ctx.dst_fmt)) {
+        if (ctx.src_fmt == PIXFMT_GRAY8) {
+            for (0..ctx.dst_w) |i| {
+                dst_slice[i] = @intCast((@as(i32, dst_slice[i]) * 14071 + 33561947) >> 14);
+            }
+        } else {
+            for (0..ctx.dst_w) |i| {
+                dst_slice[i] = @intCast((@min(@as(i32, dst_slice[i]), 30189) * 19077 - 39057361) >> 14);
+            }
+        }
+    }
