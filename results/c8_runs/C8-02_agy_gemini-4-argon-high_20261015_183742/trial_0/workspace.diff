+            const eff_chr_filter: []const i16 = if (ctx.needs_hcscale) chr_filter else &[_]i16{4096};
+            packedVscaleRow(
+                ctx,
+                lum_filter,
+                lum_ptrs[0..v_lum_size],
+                eff_chr_filter,
+                chr_u_ptrs[0..eff_v_chr_size],
+                chr_v_ptrs[0..eff_v_chr_size],
+                alp_ptrs[0..v_lum_size],
+                d_dst,
+            );
+        }
+    }
+}
