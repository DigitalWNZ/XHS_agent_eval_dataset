+
+    chr_src_h_sub: u3,
+    chr_src_v_sub: u3,
+    chr_dst_h_sub: u3,
+    chr_dst_v_sub: u3,
+    chr_src_w: usize,
+    chr_src_h: usize,
+    chr_dst_w: usize,
+    chr_dst_h: usize,
