+            switch (dst_fmt) {
+                PIXFMT_RGB24 => {
+                    storeRgb24_16(pd0 + x * 3, r0_lo, g0_lo, b0_lo);
+                    storeRgb24_16(pd0 + (x + 16) * 3, r0_hi, g0_hi, b0_hi);
+                    storeRgb24_16(pd1 + x * 3, r1_lo, g1_lo, b1_lo);
+                    storeRgb24_16(pd1 + (x + 16) * 3, r1_hi, g1_hi, b1_hi);
+                },
+                PIXFMT_BGR24 => {
+                    storeRgb24_16(pd0 + x * 3, b0_lo, g0_lo, r0_lo);
+                    storeRgb24_16(pd0 + (x + 16) * 3, b0_hi, g0_hi, r0_hi);
+                    storeRgb24_16(pd1 + x * 3, b1_lo, g1_lo, r1_lo);
+                    storeRgb24_16(pd1 + (x + 16) * 3, b1_hi, g1_hi, r1_hi);
+                },
+                PIXFMT_RGBA => {
+                    storeRgba32_16(pd0 + x * 4, r0_lo, g0_lo, b0_lo, ff_vec);
+                    storeRgba32_16(pd0 + (x + 16) * 4, r0_hi, g0_hi, b0_hi, ff_vec);
+                    storeRgba32_16(pd1 + x * 4, r1_lo, g1_lo, b1_lo, ff_vec);
+                    storeRgba32_16(pd1 + (x + 16) * 4, r1_hi, g1_hi, b1_hi, ff_vec);
+                },
+                PIXFMT_BGRA => {
+                    storeRgba32_16(pd0 + x * 4, b0_lo, g0_lo, r0_lo, ff_vec);
+                    storeRgba32_16(pd0 + (x + 16) * 4, b0_hi, g0_hi, r0_hi, ff_vec);
+                    storeRgba32_16(pd1 + x * 4, b1_lo, g1_lo, r1_lo, ff_vec);
+                    storeRgba32_16(pd1 + (x + 16) * 4, b1_hi, g1_hi, r1_hi, ff_vec);
+                },
+                else => unreachable,
+            }
+        }
+
+        while (x < w) : (x += 2) {
+            const cx = x >> 1;
+            const u_val: i32 = pu[cx];
+            const v_val: i32 = pv[cx];
+            for (0..2) |dx| {
+                if (x + dx >= w) break;
+                var r0: u8 = 0;
+                var g0: u8 = 0;
+                var b0: u8 = 0;
+                var r1: u8 = 0;
+                var g1: u8 = 0;
+                var b1: u8 = 0;
+                yuvScalarToRgb(py0[x + dx], u_val, v_val, &r0, &g0, &b0);
+                yuvScalarToRgb(py1[x + dx], u_val, v_val, &r1, &g1, &b1);
+                const ix = x + dx;
+                switch (dst_fmt) {
+                    PIXFMT_RGB24 => {
+                        pd0[ix * 3 + 0] = r0;
+                        pd0[ix * 3 + 1] = g0;
+                        pd0[ix * 3 + 2] = b0;
+                        pd1[ix * 3 + 0] = r1;
+                        pd1[ix * 3 + 1] = g1;
+                        pd1[ix * 3 + 2] = b1;
+                    },
+                    PIXFMT_BGR24 => {
+                        pd0[ix * 3 + 0] = b0;
+                        pd0[ix * 3 + 1] = g0;
+                        pd0[ix * 3 + 2] = r0;
+                        pd1[ix * 3 + 0] = b1;
+                        pd1[ix * 3 + 1] = g1;
+                        pd1[ix * 3 + 2] = r1;
+                    },
+                    PIXFMT_RGBA => {
+                        pd0[ix * 4 + 0] = r0;
+                        pd0[ix * 4 + 1] = g0;
+                        pd0[ix * 4 + 2] = b0;
+                        pd0[ix * 4 + 3] = 255;
+                        pd1[ix * 4 + 0] = r1;
+                        pd1[ix * 4 + 1] = g1;
+                        pd1[ix * 4 + 2] = b1;
+                        pd1[ix * 4 + 3] = 255;
+                    },
+                    PIXFMT_BGRA => {
+                        pd0[ix * 4 + 0] = b0;
+                        pd0[ix * 4 + 1] = g0;
+                        pd0[ix * 4 + 2] = r0;
+                        pd0[ix * 4 + 3] = 255;
+                        pd1[ix * 4 + 0] = b1;
+                        pd1[ix * 4 + 1] = g1;
+                        pd1[ix * 4 + 2] = r1;
+                        pd1[ix * 4 + 3] = 255;
+                    },
+                    else => unreachable,
+                }
+            }
+        }
+    }
