+            ctx.h_lum.deinit();
+            ctx.v_lum.deinit();
+            allocator.destroy(ctx);
+            return null;
+        };
+        ctx.v_chr = Filter1D.init(chr_src_h, chr_dst_h, chr_y_inc, 2, 1 << 12, algo) catch {
+            ctx.h_lum.deinit();
+            ctx.v_lum.deinit();
+            ctx.h_chr.deinit();
+            allocator.destroy(ctx);
+            return null;
+        };
+        ctx.has_filters = true;
+    }
