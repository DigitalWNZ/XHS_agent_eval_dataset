+    if (src_fmt < 0 or src_fmt >= SWS_PIXFMT_COUNT) return null;
+    if (dst_fmt < 0 or dst_fmt >= SWS_PIXFMT_COUNT) return null;
+    if (algo < 0 or algo >= SWS_ALGO_COUNT) return null;
+
+    const ctx = allocator.create(SwsContext) catch return null;
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .has_filters = false,
+        .h_lum = undefined,
+        .v_lum = undefined,
+        .h_chr = undefined,
+        .v_chr = undefined,
+        .scratch = &[_]u8{},
+        .gray_to_yuv_lut = undefined,
+        .yuv_to_gray_lut = undefined,
+    };
+    initGrayLuts(ctx);
+
+    const same_size = (src_w == dst_w and src_h == dst_h);
+    const max_w: usize = @intCast(@max(src_w, dst_w));
+    const max_h: usize = @intCast(@max(src_h, dst_h));
+
+    if (!same_size) {
+        const lum_x_inc: i64 = @divTrunc((@as(i64, src_w) << 16) + (@as(i64, dst_w) >> 1), @as(i64, dst_w));
+        const lum_y_inc: i64 = @divTrunc((@as(i64, src_h) << 16) + (@as(i64, dst_h) >> 1), @as(i64, dst_h));
+
+        // Determine effective chroma subsampling for scaling filters
+        var chr_src_h_sub: u3 = chrHSubSample(src_fmt);
+        const chr_src_v_sub: u3 = chrVSubSample(src_fmt);
+        var chr_dst_h_sub: u3 = chrHSubSample(dst_fmt);
+        const chr_dst_v_sub: u3 = chrVSubSample(dst_fmt);
