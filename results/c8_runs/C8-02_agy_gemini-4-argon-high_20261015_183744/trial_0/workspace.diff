+    gray_to_yuv_lut: [256]u8,
+    yuv_to_gray_lut: [256]u8,
+};
+
+fn initGrayLuts(ctx: *SwsContext) void {
+    for (0..256) |i| {
+        const y: i32 = @intCast(i);
+        // YUV -> GRAY8 (lumRangeToJpeg_c)
+        const y15: i32 = @min(y << 7, 30189);
+        const val_to_jpeg: i32 = ((y15 * 19077 - 39057361) >> 14);
+        ctx.yuv_to_gray_lut[i] = @intCast(std.math.clamp((val_to_jpeg + 64) >> 7, 0, 255));
+
+        // GRAY8 -> YUV (lumRangeFromJpeg_c)
+        const g15: i32 = y << 7;
+        const val_from_jpeg: i32 = ((g15 * 14071 + 33561947) >> 14);
+        ctx.gray_to_yuv_lut[i] = @intCast(std.math.clamp((val_from_jpeg + 64) >> 7, 0, 255));
+    }
+}
