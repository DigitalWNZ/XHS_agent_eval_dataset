+fn convertRgbToYuv420OrNv(
+    comptime src_fmt: c_int,
+    comptime dst_fmt: c_int,
+    w: usize,
+    h: usize,
+    src_base: [*]const u8,
+    src_stride: usize,
+    y_base: [*]u8,
+    y_stride: usize,
