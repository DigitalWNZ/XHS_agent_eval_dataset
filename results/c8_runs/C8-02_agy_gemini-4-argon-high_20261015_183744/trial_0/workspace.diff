+    // Allocate scratch space large enough for row buffers or intermediate planes
+    const scratch_bytes: usize = (max_w + 64) * (max_h + 64) * 4 + (max_w + 64) * 64;
+    ctx.scratch = allocator.alloc(u8, scratch_bytes) catch {
+        if (ctx.has_filters) {
+            ctx.h_lum.deinit();
+            ctx.v_lum.deinit();
+            ctx.h_chr.deinit();
+            ctx.v_chr.deinit();
+        }
+        allocator.destroy(ctx);
+        return null;
+    };
+
+    return ctx;
+}
+
+export fn swscale_destroy(ctx_ptr: ?*anyopaque) void {
+    const ptr = ctx_ptr orelse return;
+    const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+    if (ctx.has_filters) {
+        ctx.h_lum.deinit();
+        ctx.v_lum.deinit();
+        ctx.h_chr.deinit();
+        ctx.v_chr.deinit();
+    }
+    if (ctx.scratch.len > 0) {
+        allocator.free(ctx.scratch);
+    }
+    allocator.destroy(ctx);
+}
