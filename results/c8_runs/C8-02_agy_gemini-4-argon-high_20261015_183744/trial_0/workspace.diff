+inline fn isRGBFam(fmt: c_int) bool {
+    return fmt >= SWS_PIXFMT_RGB24 and fmt <= SWS_PIXFMT_BGRA;
+}
+
+inline fn isYUVFam(fmt: c_int) bool {
+    return fmt >= SWS_PIXFMT_YUV420P and fmt <= SWS_PIXFMT_NV21;
+}
+
+inline fn chrHSubSample(fmt: c_int) u3 {
+    return switch (fmt) {
+        SWS_PIXFMT_YUV420P, SWS_PIXFMT_YUV422P, SWS_PIXFMT_NV12, SWS_PIXFMT_NV21 => 1,
+        else => 0,
+    };
+}
+
+inline fn chrVSubSample(fmt: c_int) u3 {
+    return switch (fmt) {
+        SWS_PIXFMT_YUV420P, SWS_PIXFMT_NV12, SWS_PIXFMT_NV21 => 1,
+        else => 0,
+    };
+}
