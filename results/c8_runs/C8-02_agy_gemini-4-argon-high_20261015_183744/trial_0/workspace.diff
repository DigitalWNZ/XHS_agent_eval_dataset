+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
