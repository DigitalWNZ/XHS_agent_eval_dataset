+        if (isRGBFam(src_fmt) and (isYUVFam(dst_fmt) or isRGBFam(dst_fmt))) {
+            if ((dst_w >> chr_dst_h_sub) <= (src_w >> 1)) {
+                chr_src_h_sub = 1;
+            }
+        }
+
+        const chr_src_w = ceilRshift(src_w, chr_src_h_sub);
+        const chr_src_h = ceilRshift(src_h, chr_src_v_sub);
+        const chr_dst_w = ceilRshift(dst_w, chr_dst_h_sub);
+        const chr_dst_h = ceilRshift(dst_h, chr_dst_v_sub);
+
+        const chr_x_inc: i64 = @divTrunc((@as(i64, chr_src_w) << 16) + (@as(i64, chr_dst_w) >> 1), @as(i64, chr_dst_w));
+        const chr_y_inc: i64 = @divTrunc((@as(i64, chr_src_h) << 16) + (@as(i64, chr_dst_h) >> 1), @as(i64, chr_dst_h));
