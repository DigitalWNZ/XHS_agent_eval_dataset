+fn convertRgbToYuv422p(
+    comptime src_fmt: c_int,
+    w: usize,
+    h: usize,
+    src_base: [*]const u8,
+    src_stride: usize,
+    y_base: [*]u8,
+    y_stride: usize,
+    u_base: [*]u8,
+    u_stride: usize,
+    v_base: [*]u8,
+    v_stride: usize,
+    scratch: []u8,
