+        return .{
+            .m10774 = @splat(@as(*const volatile u16, &g_yuv2rgb_consts[0]).*),
+            .m24322 = @splat(@as(*const volatile u16, &g_yuv2rgb_consts[1]).*),
+            .m48032 = @splat(@as(*const volatile u16, &g_yuv2rgb_consts[2]).*),
+            .m43481 = @splat(@as(*const volatile u16, &g_yuv2rgb_consts[3]).*),
+            .m19767 = @splat(@as(*const volatile u16, &g_yuv2rgb_consts[4]).*),
