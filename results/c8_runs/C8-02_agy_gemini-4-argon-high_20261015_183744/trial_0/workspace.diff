+    const cw = (w + 1) >> 1;
+    const u15_buf: [*]i16 = @ptrCast(@alignCast(scratch.ptr));
+    const v15_buf: [*]i16 = u15_buf + cw + 32;
+
+    for (0..h) |y| {
+        convertRgbRowToYAndUv15(
+            src_fmt,
+            w,
+            src_base + y * src_stride,
+            y_base + y * y_stride,
+            u15_buf,
+            v15_buf,
+        );
+        const ud = u_base + y * u_stride;
+        const vd = v_base + y * v_stride;
+        var x: usize = 0;
+        while (x + 16 <= cw) : (x += 16) {
+            const u15_v: V16u16 = @bitCast(@as(*align(1) const V16i16, @ptrCast(u15_buf + x)).*);
+            const v15_v: V16u16 = @bitCast(@as(*align(1) const V16i16, @ptrCast(v15_buf + x)).*);
+            const c64: V16u16 = @splat(64);
+            @as(*align(1) V16u8, @ptrCast(ud + x)).* = @intCast((u15_v + c64) >> @splat(7));
+            @as(*align(1) V16u8, @ptrCast(vd + x)).* = @intCast((v15_v + c64) >> @splat(7));
+        }
