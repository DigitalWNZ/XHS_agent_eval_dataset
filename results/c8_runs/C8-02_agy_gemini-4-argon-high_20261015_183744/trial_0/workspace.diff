+        while (x < w) : (x += 1) {
+            const r: i32 = s[x * bpp + (if (is_bgr) @as(usize, 2) else 0)];
+            const g: i32 = s[x * bpp + 1];
+            const b: i32 = s[x * bpp + (if (is_bgr) @as(usize, 0) else 2)];
