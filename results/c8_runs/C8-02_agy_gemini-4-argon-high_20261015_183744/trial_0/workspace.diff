+    // Fast path for NEAREST (b008, s002, s014)
+    if (h_flt.filter_size == 1 and v_flt.filter_size == 1) {
+        for (0..dh) |y| {
+            const sy: usize = @intCast(v_flt.pos[y]);
+            const s_row = src_base + sy * src_stride;
+            const d_row = dst_base + y * dst_stride;
+            for (0..dw) |x| {
+                const sx: usize = @intCast(h_flt.pos[x]);
+                const c0 = s_row[sx * src_bpp + (if (swap_rb) @as(usize, 2) else 0)];
+                const c1 = s_row[sx * src_bpp + 1];
+                const c2 = s_row[sx * src_bpp + (if (swap_rb) @as(usize, 0) else 2)];
