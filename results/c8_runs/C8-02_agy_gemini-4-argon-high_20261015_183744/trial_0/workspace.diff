+                vd[x] = v_val;
+            } else if (dst_fmt == SWS_PIXFMT_NV12) {
+                ud[2 * x + 0] = u_val;
+                ud[2 * x + 1] = v_val;
+            } else if (dst_fmt == SWS_PIXFMT_NV21) {
