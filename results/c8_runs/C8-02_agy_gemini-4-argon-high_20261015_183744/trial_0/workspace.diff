+            return null;
+        };
+        ctx.v_lum = Filter1D.init(src_h, dst_h, lum_y_inc, 2, 1 << 12, algo) catch {
+            ctx.h_lum.deinit();
+            allocator.destroy(ctx);
+            return null;
+        };
