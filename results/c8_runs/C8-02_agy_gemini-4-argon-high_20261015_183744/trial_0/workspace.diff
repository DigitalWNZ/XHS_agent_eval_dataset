+    const hi: V8i32 = @splat(32767);
+    const ai16: V8i16 = @intCast(@max(lo, @min(hi, a)));
+    const bi16: V8i16 = @intCast(@max(lo, @min(hi, b)));
+    return @shuffle(i16, ai16, bi16, [16]i32{
+        0, 1, 2, 3, -1, -2, -3, -4,
+        4, 5, 6, 7, -5, -6, -7, -8,
+    });
