+        scalePlane2D(s0, ss0, y_scaled.ptr, dw, &ctx.h_lum, &ctx.v_lum, ctx.scratch[align_off..]);
+        scalePlane2D(u_src_ptr, u_src_stride, u_scaled.ptr, dst_cw, &ctx.h_chr, &ctx.v_chr, ctx.scratch[align_off..]);
+        scalePlane2D(v_src_ptr, v_src_stride, v_scaled.ptr, dst_cw, &ctx.h_chr, &ctx.v_chr, ctx.scratch[align_off..]);
+
+        inline for ([_]c_int{ SWS_PIXFMT_RGB24, SWS_PIXFMT_BGR24, SWS_PIXFMT_RGBA, SWS_PIXFMT_BGRA }) |df| {
+            if (dfmt == df) {
+                if (dst_cw == dw) {
+                    convertYuv444pToRgb(df, dw, dh, y_scaled.ptr, dw, u_scaled.ptr, dst_cw, v_scaled.ptr, dst_cw, d0, ds0);
+                } else {
+                    for (0..dh) |y| {
+                        convertYuv422pRowToRgb(df, dw, y_scaled.ptr + y * dw, u_scaled.ptr + y * dst_cw, v_scaled.ptr + y * dst_cw, d0 + y * ds0);
+                    }
+                }
+                return 0;
+            }
+        }
+    }
+
+    // RGB -> YUV with scaling (b007/s006, s011)
+    if (isRGBFam(sfmt) and isYUVFam(dfmt)) {
+        const src_cw = ctx.h_chr.src_len;
+        const src_ch = ctx.v_chr.src_len;
+        const dst_cw = ctx.h_chr.dst_len;
+        const dst_ch = ctx.v_chr.dst_len;
+
+        var scratch_offset: usize = 0;
+        const y_src = ctx.scratch[scratch_offset .. scratch_offset + sw * sh];
+        scratch_offset += sw * sh;
+        const u_src = ctx.scratch[scratch_offset .. scratch_offset + src_cw * src_ch];
+        scratch_offset += src_cw * src_ch;
+        const v_src = ctx.scratch[scratch_offset .. scratch_offset + src_cw * src_ch];
+        scratch_offset += src_cw * src_ch;
+        const align_off = (scratch_offset + 15) & ~@as(usize, 15);
+
+        inline for ([_]c_int{ SWS_PIXFMT_RGB24, SWS_PIXFMT_BGR24, SWS_PIXFMT_RGBA, SWS_PIXFMT_BGRA }) |sf| {
+            if (sfmt == sf) {
+                if (src_cw == sw) {
+                    convertRgbToYuv444p(sf, sw, sh, s0, ss0, y_src.ptr, sw, u_src.ptr, src_cw, v_src.ptr, src_cw);
+                } else {
+                    convertRgbToYuv422p(sf, sw, sh, s0, ss0, y_src.ptr, sw, u_src.ptr, src_cw, v_src.ptr, src_cw, ctx.scratch[align_off..]);
+                }
+            }
+        }
+
+        scalePlane2D(y_src.ptr, sw, d0, ds0, &ctx.h_lum, &ctx.v_lum, ctx.scratch[align_off..]);
+        if (dfmt == SWS_PIXFMT_NV12 or dfmt == SWS_PIXFMT_NV21) {
+            const u_dst = ctx.scratch[align_off .. align_off + dst_cw * dst_ch];
+            const v_dst = ctx.scratch[align_off + dst_cw * dst_ch .. align_off + 2 * dst_cw * dst_ch];
+            const rem_off = (align_off + 2 * dst_cw * dst_ch + 15) & ~@as(usize, 15);
+            scalePlane2D(u_src.ptr, src_cw, u_dst.ptr, dst_cw, &ctx.h_chr, &ctx.v_chr, ctx.scratch[rem_off..]);
+            scalePlane2D(v_src.ptr, src_cw, v_dst.ptr, dst_cw, &ctx.h_chr, &ctx.v_chr, ctx.scratch[rem_off..]);
+            if (dfmt == SWS_PIXFMT_NV12) {
+                interleaveChroma(false, dst_cw, dst_ch, u_dst.ptr, dst_cw, v_dst.ptr, dst_cw, dst_data[1], @intCast(dst_stride[1]));
+            } else {
+                interleaveChroma(true, dst_cw, dst_ch, u_dst.ptr, dst_cw, v_dst.ptr, dst_cw, dst_data[1], @intCast(dst_stride[1]));
+            }
+        } else {
+            scalePlane2D(u_src.ptr, src_cw, dst_data[1], @intCast(dst_stride[1]), &ctx.h_chr, &ctx.v_chr, ctx.scratch[align_off..]);
+            scalePlane2D(v_src.ptr, src_cw, dst_data[2], @intCast(dst_stride[2]), &ctx.h_chr, &ctx.v_chr, ctx.scratch[align_off..]);
+        }
+        return 0;
+    }
+
+    return -1;
+}
