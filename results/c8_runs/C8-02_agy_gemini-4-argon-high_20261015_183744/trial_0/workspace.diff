+            const ur2: V16i32 = @intCast(@as(*align(1) const V16i16, @ptrCast(urow2 + x)).*);
+            const ur3: V16i32 = @intCast(@as(*align(1) const V16i16, @ptrCast(urow3 + x)).*);
