+        }
+    } else if (fs == 4) {
+        var x: usize = 0;
+        while (x + 8 <= dw) : (x += 8) {
+            const p0 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 0])))).*;
+            const p1 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 1])))).*;
+            const p2 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 2])))).*;
+            const p3 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 3])))).*;
+            const s0_u8: V16u8 = @bitCast(@Vector(4, u32){ p0, p1, p2, p3 });
+            const m0 = madd16(@intCast(s0_u8), @as(*align(1) const V16i16, @ptrCast(coeffs + 4 * x)).*);
+
+            const p4 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 4])))).*;
+            const p5 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 5])))).*;
+            const p6 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 6])))).*;
+            const p7 = @as(*align(1) const u32, @ptrCast(src_row + @as(usize, @intCast(pos[x + 7])))).*;
+            const s1_u8: V16u8 = @bitCast(@Vector(4, u32){ p4, p5, p6, p7 });
+            const m1 = madd16(@intCast(s1_u8), @as(*align(1) const V16i16, @ptrCast(coeffs + 4 * (x + 4))).*);
+
+            const v8 = hadd32(m0, m1) >> @splat(7);
+            const lo: V8i32 = @splat(-32768);
+            const hi: V8i32 = @splat(32767);
+            @as(*align(1) V8i16, @ptrCast(dst_row + x)).* = @intCast(@max(lo, @min(hi, v8)));
+        }
+        while (x < dw) : (x += 1) {
+            const sx: usize = @intCast(pos[x]);
+            const c = coeffs + 4 * x;
+            const v: i32 = @as(i32, src_row[sx + 0]) * @as(i32, c[0]) +
+                @as(i32, src_row[sx + 1]) * @as(i32, c[1]) +
+                @as(i32, src_row[sx + 2]) * @as(i32, c[2]) +
+                @as(i32, src_row[sx + 3]) * @as(i32, c[3]);
+            dst_row[x] = @intCast(std.math.clamp(v >> 7, -32768, 32767));
+        }
+    } else if (fs == 8) {
+        var x: usize = 0;
+        while (x + 4 <= dw) : (x += 4) {
+            const p0 = @as(*align(1) const u64, @ptrCast(src_row + @as(usize, @intCast(pos[x + 0])))).*;
+            const p1 = @as(*align(1) const u64, @ptrCast(src_row + @as(usize, @intCast(pos[x + 1])))).*;
+            const s0_u8: V16u8 = @bitCast(@Vector(2, u64){ p0, p1 });
+            const m0 = madd16(@intCast(s0_u8), @as(*align(1) const V16i16, @ptrCast(coeffs + 8 * x)).*);
+
+            const p2 = @as(*align(1) const u64, @ptrCast(src_row + @as(usize, @intCast(pos[x + 2])))).*;
+            const p3 = @as(*align(1) const u64, @ptrCast(src_row + @as(usize, @intCast(pos[x + 3])))).*;
+            const s1_u8: V16u8 = @bitCast(@Vector(2, u64){ p2, p3 });
+            const m1 = madd16(@intCast(s1_u8), @as(*align(1) const V16i16, @ptrCast(coeffs + 8 * (x + 2))).*);
+
+            const h = hadd32(m0, m1);
+            const v4 = (@shuffle(i32, h, undefined, [4]i32{ 0, 2, 4, 6 }) +
+                @shuffle(i32, h, undefined, [4]i32{ 1, 3, 5, 7 })) >> @splat(7);
+            const lo: @Vector(4, i32) = @splat(-32768);
+            const hi: @Vector(4, i32) = @splat(32767);
+            @as(*align(1) @Vector(4, i16), @ptrCast(dst_row + x)).* = @intCast(@max(lo, @min(hi, v4)));
+        }
+        while (x < dw) : (x += 1) {
+            const sx: usize = @intCast(pos[x]);
+            const c = coeffs + 8 * x;
+            var v: i32 = 0;
+            for (0..8) |k| {
+                v += @as(i32, src_row[sx + k]) * @as(i32, c[k]);
+            }
+            dst_row[x] = @intCast(std.math.clamp(v >> 7, -32768, 32767));
+        }
+    } else {
+        for (0..dw) |x| {
+            const sx: usize = @intCast(pos[x]);
+            const c = coeffs + fs * x;
+            var v: i32 = 0;
+            for (0..fs) |k| {
+                v += @as(i32, src_row[sx + k]) * @as(i32, c[k]);
+            }
+            dst_row[x] = @intCast(std.math.clamp(v >> 7, -32768, 32767));
+        }
+    }
+}
+
+fn scalePlane2D(
+    src_base: [*]const u8,
+    src_stride: usize,
+    dst_base: [*]u8,
+    dst_stride: usize,
+    h_flt: *const Filter1D,
+    v_flt: *const Filter1D,
+    scratch: []u8,
+) void {
+    const dw = h_flt.dst_len;
+    const dh = v_flt.dst_len;
+    const vfs = v_flt.filter_size;
+
+    // Fast path for NEAREST (filter_size == 1 in both directions)
+    if (h_flt.filter_size == 1 and vfs == 1) {
+        for (0..dh) |y| {
+            const sy: usize = @intCast(v_flt.pos[y]);
+            const s_row = src_base + sy * src_stride;
+            const d_row = dst_base + y * dst_stride;
+            for (0..dw) |x| {
+                const sx: usize = @intCast(h_flt.pos[x]);
+                d_row[x] = s_row[sx];
+            }
+        }
+        return;
+    }
+
+    const row_stride = (dw + 15) & ~@as(usize, 15);
+    const ring_cap = vfs + 2;
+    const ring_buf: [*]i16 = @ptrCast(@alignCast(scratch.ptr));
+    const slot_row_idx = @as([*]isize, @ptrCast(@alignCast(scratch.ptr + ring_cap * row_stride * @sizeOf(i16))))[0..ring_cap];
+    @memset(slot_row_idx, -1);
+
+    var row_ptrs: [32][*]const i16 = undefined;
+
+    for (0..dh) |y| {
+        const first_sy: usize = @intCast(v_flt.pos[y]);
+        for (0..vfs) |k| {
+            const sy = first_sy + k;
+            const slot = sy % ring_cap;
+            if (slot_row_idx[slot] != @as(isize, @intCast(sy))) {
+                hScaleRowU8ToI16(
+                    src_base + sy * src_stride,
+                    ring_buf + slot * row_stride,
+                    h_flt,
+                );
+                slot_row_idx[slot] = @intCast(sy);
+            }
+            row_ptrs[k] = ring_buf + slot * row_stride;
+        }
+
+        const d_row = dst_base + y * dst_stride;
+        const vc = v_flt.coeffs.ptr + y * vfs;
+
+        var x: usize = 0;
+        while (x + 16 <= dw) : (x += 16) {
+            var acc_a: V8i32 = @splat(1 << 18);
+            var acc_b: V8i32 = @splat(1 << 18);
+            var k: usize = 0;
+            while (k + 2 <= vfs) : (k += 2) {
+                const v0: V16i16 = @as(*align(1) const V16i16, @ptrCast(row_ptrs[k] + x)).*;
+                const v1: V16i16 = @as(*align(1) const V16i16, @ptrCast(row_ptrs[k + 1] + x)).*;
+                const c_pair_i32: i32 = @as(i32, @as(u16, @bitCast(vc[k]))) | (@as(i32, vc[k + 1]) << 16);
+                const c_pair: V16i16 = @bitCast(@as(V8i32, @splat(c_pair_i32)));
+                const inter_a = @shuffle(i16, v0, v1, [16]i32{ 0, -1, 1, -2, 2, -3, 3, -4, 8, -9, 9, -10, 10, -11, 11, -12 });
+                const inter_b = @shuffle(i16, v0, v1, [16]i32{ 4, -5, 5, -6, 6, -7, 7, -8, 12, -13, 13, -14, 14, -15, 15, -16 });
+                acc_a += madd16(inter_a, c_pair);
+                acc_b += madd16(inter_b, c_pair);
+            }
+            if (k < vfs) {
+                const v0: V16i16 = @as(*align(1) const V16i16, @ptrCast(row_ptrs[k] + x)).*;
+                const c_single_i32: i32 = @as(i32, @as(u16, @bitCast(vc[k])));
+                const c_single: V16i16 = @bitCast(@as(V8i32, @splat(c_single_i32)));
+                const inter_a = @shuffle(i16, v0, v0, [16]i32{ 0, -1, 1, -2, 2, -3, 3, -4, 8, -9, 9, -10, 10, -11, 11, -12 });
+                const inter_b = @shuffle(i16, v0, v0, [16]i32{ 4, -5, 5, -6, 6, -7, 7, -8, 12, -13, 13, -14, 14, -15, 15, -16 });
+                acc_a += madd16(inter_a, c_single);
+                acc_b += madd16(inter_b, c_single);
+            }
+            const res_i16 = packssdw256(acc_a >> @splat(19), acc_b >> @splat(19));
+            const zero: V16i16 = @splat(0);
+            const max255: V16i16 = @splat(255);
+            @as(*align(1) V16u8, @ptrCast(d_row + x)).* = @intCast(@max(zero, @min(max255, res_i16)));
+        }
+        while (x < dw) : (x += 1) {
+            var acc: i32 = 1 << 18;
+            for (0..vfs) |k| {
+                acc += @as(i32, row_ptrs[k][x]) * @as(i32, vc[k]);
+            }
+            d_row[x] = @intCast(std.math.clamp(acc >> 19, 0, 255));
+        }
+    }
+}
