+            const vr2: V16i32 = @intCast(@as(*align(1) const V16i16, @ptrCast(vrow2 + x)).*);
+            const vr3: V16i32 = @intCast(@as(*align(1) const V16i16, @ptrCast(vrow3 + x)).*);
