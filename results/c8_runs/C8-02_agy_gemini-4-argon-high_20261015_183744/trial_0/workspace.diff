+fn hScaleRowU8ToI16(
+    src_row: [*]const u8,
+    dst_row: [*]i16,
+    flt: *const Filter1D,
+) void {
+    const dw = flt.dst_len;
+    const fs = flt.filter_size;
+    const pos = flt.pos;
+    const coeffs = flt.coeffs.ptr;
+
+    if (fs == 1) {
+        var x: usize = 0;
+        while (x + 8 <= dw) : (x += 8) {
+            const b0 = src_row[@intCast(pos[x + 0])];
+            const b1 = src_row[@intCast(pos[x + 1])];
+            const b2 = src_row[@intCast(pos[x + 2])];
+            const b3 = src_row[@intCast(pos[x + 3])];
+            const b4 = src_row[@intCast(pos[x + 4])];
+            const b5 = src_row[@intCast(pos[x + 5])];
+            const b6 = src_row[@intCast(pos[x + 6])];
+            const b7 = src_row[@intCast(pos[x + 7])];
+            const v_u8 = V8u8{ b0, b1, b2, b3, b4, b5, b6, b7 };
+            const v_i16: V8i16 = @as(V8i16, @intCast(v_u8)) << @splat(7);
+            @as(*align(1) V8i16, @ptrCast(dst_row + x)).* = v_i16;
+        }
+        while (x < dw) : (x += 1) {
+            const sx: usize = @intCast(pos[x]);
+            dst_row[x] = @as(i16, src_row[sx]) << 7;
+        }
+    } else if (fs == 2) {
+        var x: usize = 0;
+        while (x + 8 <= dw) : (x += 8) {
+            const p0 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 0])))).*;
+            const p1 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 1])))).*;
+            const p2 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 2])))).*;
+            const p3 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 3])))).*;
+            const p4 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 4])))).*;
+            const p5 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 5])))).*;
+            const p6 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 6])))).*;
+            const p7 = @as(*align(1) const u16, @ptrCast(src_row + @as(usize, @intCast(pos[x + 7])))).*;
+            const s_u8: V16u8 = @bitCast(V8u16{ p0, p1, p2, p3, p4, p5, p6, p7 });
+            const s_i16: V16i16 = @intCast(s_u8);
+            const c_i16: V16i16 = @as(*align(1) const V16i16, @ptrCast(coeffs + 2 * x)).*;
+            const v8: V8i32 = madd16(s_i16, c_i16) >> @splat(7);
+            @as(*align(1) V8i16, @ptrCast(dst_row + x)).* = @intCast(v8);
+        }
+        while (x < dw) : (x += 1) {
+            const sx: usize = @intCast(pos[x]);
+            const c0: i32 = coeffs[2 * x + 0];
+            const c1: i32 = coeffs[2 * x + 1];
+            const v: i32 = @as(i32, src_row[sx]) * c0 + @as(i32, src_row[sx + 1]) * c1;
