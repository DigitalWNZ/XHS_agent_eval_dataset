+            const d2 = dst + (2 * y + 2) * dst_stride;
+            var x: usize = 0;
+            while (x + 16 <= cw) : (x += 16) {
+                const a: V16u16 = @as(*align(1) const V16u8, @ptrCast(s0 + x)).*;
+                const b: V16u16 = @as(*align(1) const V16u8, @ptrCast(s1 + x)).*;
