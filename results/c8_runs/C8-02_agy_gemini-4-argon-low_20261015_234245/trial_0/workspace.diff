+        errdefer allocator.free(v_chrV_ptrs);
+        const v_alp_ptrs = try allocator.alloc([*]const i16, vLumFilter.filter_size + 2);
+        errdefer allocator.free(v_alp_ptrs);
+
+        const ctx = try allocator.create(SwsContext);
+        ctx.* = .{
+            .allocator = allocator,
+            .src_w = src_w,
+            .src_h = src_h,
+            .src_fmt = src_fmt,
+            .dst_w = dst_w,
+            .dst_h = dst_h,
+            .dst_fmt = dst_fmt,
+            .algo = algo,
+            .chrSrcHSubSample = chrSrcHSubSample,
+            .chrSrcVSubSample = chrSrcVSubSample,
+            .chrDstHSubSample = chrDstHSubSample,
+            .chrDstVSubSample = chrDstVSubSample,
+            .chrSrcW = chrSrcW,
+            .chrSrcH = chrSrcH,
+            .chrDstW = chrDstW,
+            .chrDstH = chrDstH,
+            .full_chr_h_int = full_chr_h_int,
+            .full_chr_h_inp = full_chr_h_inp,
+            .need_alpha = need_alpha,
+            .needs_hcscale = needs_hcscale,
+            .src_range = src_range,
+            .dst_range = dst_range,
