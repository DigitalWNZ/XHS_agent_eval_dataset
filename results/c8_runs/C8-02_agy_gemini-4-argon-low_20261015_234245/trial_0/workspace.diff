+
+    pub fn init(
+        allocator: std.mem.Allocator,
+        src_w: c_int,
+        src_h: c_int,
+        src_fmt: c_int,
+        dst_w: c_int,
+        dst_h: c_int,
+        dst_fmt: c_int,
+        algo: c_int,
+    ) !*SwsContext {
+        if (src_w < 1 or src_h < 1 or dst_w < 1 or dst_h < 1) return error.InvalidDimensions;
+        if (src_fmt < 0 or src_fmt >= 10 or dst_fmt < 0 or dst_fmt >= 10) return error.InvalidFormat;
+        if (algo < 0 or algo >= 3) return error.InvalidAlgo;
+
+        var chrSrcHSubSample: c_int = 0;
+        var chrSrcVSubSample: c_int = 0;
+        var chrDstHSubSample: c_int = 0;
+        var chrDstVSubSample: c_int = 0;
