+    const g_idx = g_off0 + ((u_clamped * cgu_inc) >> @splat(16)) + ((v_clamped * cgv_inc) >> @splat(16));
+    const b_idx = b_off0 + ((u_clamped * cbu_inc) >> @splat(16));
