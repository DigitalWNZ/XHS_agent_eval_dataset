+                    uvdst[2 * i + 0] = U;
+                    uvdst[2 * i + 1] = V;
+                } else {
+                    uvdst[2 * i + 0] = V;
+                    uvdst[2 * i + 1] = U;
+                }
+            }
+        }
+    }
+}
