+    var du_arr: [8]i32 = undefined;
+    var dv_arr: [8]i32 = undefined;
+    inline for (0..8) |k| {
+        du_arr[k] = @as(i32, chrDither[k & 7]) << 12;
+        dv_arr[k] = @as(i32, chrDither[(k + 3) & 7]) << 12;
+    }
+    const du_vec: V8i32 = du_arr;
+    const dv_vec: V8i32 = dv_arr;
+
+    var i: usize = 0;
+    while (i + 8 <= chrDstW) : (i += 8) {
+        var u = du_vec;
+        var v = dv_vec;
