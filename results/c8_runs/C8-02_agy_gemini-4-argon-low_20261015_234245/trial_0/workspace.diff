+            const v0: V16i32 = @intCast(@as(V16i16, s0[i..][0..16].*));
+            const v1: V16i32 = @intCast(@as(V16i16, s1[i..][0..16].*));
+            const v2: V16i32 = @intCast(@as(V16i16, s2[i..][0..16].*));
+            const v3: V16i32 = @intCast(@as(V16i16, s3[i..][0..16].*));
+            dest[i..][0..16].* = clipU8Vec16_i32((d_vec + v0 * f0 + v1 * f1 + v2 * f2 + v3 * f3) >> @splat(19));
+        }
+    } else {
+        while (i + 16 <= dstW) : (i += 16) {
+            var val = d_vec;
+            for (0..filterSize) |j| {
+                const vj: V16i32 = @intCast(@as(V16i16, src[j][i..][0..16].*));
+                const fj: V16i32 = @splat(@as(i32, filter[j]));
+                val += vj * fj;
+            }
+            dest[i..][0..16].* = clipU8Vec16_i32(val >> @splat(19));
+        }
+    }
+    while (i < dstW) : (i += 1) {
+        var val: i32 = @as(i32, dither[(i + offset) & 7]) << 12;
+        for (0..filterSize) |j| {
+            val += @as(i32, src[j][i]) * @as(i32, filter[j]);
+        }
+        dest[i] = t.clipUint8(val >> 19);
+    }
+}
+
+pub fn yuv2nv12cX(
+    dstFormat: c_int,
+    chrDither: *const [8]u8,
+    chrFilter: [*]const i16,
+    chrFilterSize: usize,
+    chrUSrc: [*]const [*]const i16,
+    chrVSrc: [*]const [*]const i16,
+    dest: [*]u8,
+    chrDstW: usize,
