+    const cy_c: i64 = @divTrunc((1 << 16) * 255, 219);
+    const crv_c: i64 = @divTrunc((@as(i64, t.YUV2RGB_COEFFS_DEFAULT[0]) << 16) + 0x8000, cy_c);
+    const cbu_c: i64 = @divTrunc((@as(i64, t.YUV2RGB_COEFFS_DEFAULT[1]) << 16) + 0x8000, cy_c);
+    const cgu_c: i64 = @divTrunc((@as(i64, -t.YUV2RGB_COEFFS_DEFAULT[2]) << 16) + 0x8000, cy_c);
+    const cgv_c: i64 = @divTrunc((@as(i64, -t.YUV2RGB_COEFFS_DEFAULT[3]) << 16) + 0x8000, cy_c);
