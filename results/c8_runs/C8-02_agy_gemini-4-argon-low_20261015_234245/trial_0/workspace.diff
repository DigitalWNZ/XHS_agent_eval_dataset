+pub fn yuv2plane1_8(src: [*]const i16, dest: [*]u8, dstW: usize, dither: *const [8]u8, offset: usize) void {
+    var d_arr: [16]i32 = undefined;
+    inline for (0..16) |k| {
+        d_arr[k] = dither[(k + offset) & 7];
+    }
+    const d_vec: V16i32 = d_arr;
+    var i: usize = 0;
+    while (i + 16 <= dstW) : (i += 16) {
+        const s: V16i16 = src[i..][0..16].*;
+        const s32: V16i32 = @intCast(s);
+        dest[i..][0..16].* = clipU8Vec16_i32((s32 + d_vec) >> @splat(7));
+    }
+    while (i < dstW) : (i += 1) {
+        const val: i32 = (@as(i32, src[i]) + @as(i32, dither[(i + offset) & 7])) >> 7;
+        dest[i] = t.clipUint8(val);
+    }
+}
