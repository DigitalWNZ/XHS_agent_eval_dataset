+        errdefer hChrFilter.deinit(allocator);
+
+        var vLumFilter = try filter_mod.initFilter(
+            allocator,
+            lumYInc,
+            src_h,
+            dst_h,
+            1,
+            1 << 12,
+            algo,
+            filter_mod.getLocalPos(0, 0),
