+        const lumYInc: i32 = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+        const chrXInc: i32 = @intCast(@divTrunc((@as(i64, chrSrcW) << 16) + (chrDstW >> 1), chrDstW));
+        const chrYInc: i32 = @intCast(@divTrunc((@as(i64, chrSrcH) << 16) + (chrDstH >> 1), chrDstH));
