+        const r32: [*]const u32 = @ptrCast(@alignCast(r_ptr));
+        const g32: [*]const u32 = @ptrCast(@alignCast(g_ptr));
+        const b32: [*]const u32 = @ptrCast(@alignCast(b_ptr));
+
+        const r_y1 = @as([*]const u32, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(r32))) + @as(isize, Y1) * 4))))[0];
+        const g_y1 = @as([*]const u32, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(g32))) + @as(isize, Y1) * 4))))[0];
+        const b_y1 = @as([*]const u32, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(b32))) + @as(isize, Y1) * 4))))[0];
+
+        const r_y2 = @as([*]const u32, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(r32))) + @as(isize, Y2) * 4))))[0];
+        const g_y2 = @as([*]const u32, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(g32))) + @as(isize, Y2) * 4))))[0];
