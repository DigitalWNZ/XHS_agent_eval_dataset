+pub fn yuv2rgb_1(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    buf0: [*]const i16,
+    ubuf: [2][*]const i16,
+    vbuf: [2][*]const i16,
+    abuf0: ?[*]const i16,
+    dest: [*]u8,
+    dstW: usize,
+    uvalpha: i32,
+    target: c_int,
+    hasAlpha: bool,
