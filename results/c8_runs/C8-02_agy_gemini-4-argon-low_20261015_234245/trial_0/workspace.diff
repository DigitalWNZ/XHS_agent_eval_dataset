+        }
+        while (i < halfW) : (i += 1) {
+            const Y1: i32 = (@as(i32, buf0[i * 2]) + 64) >> 7;
+            const Y2: i32 = (@as(i32, buf0[i * 2 + 1]) + 64) >> 7;
+            const U: i32 = (@as(i32, ubuf0[i]) + @as(i32, ubuf1[i]) + 128) >> 8;
+            const V: i32 = (@as(i32, vbuf0[i]) + @as(i32, vbuf1[i]) + 128) >> 8;
+
+            const u_idx: usize = @intCast(U + t.YUVRGB_TABLE_HEADROOM);
+            const v_idx: usize = @intCast(V + t.YUVRGB_TABLE_HEADROOM);
+            const r_ptr = tables.table_rV[v_idx];
+            const g_ptr: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(tables.table_gU[u_idx]))) + tables.table_gV[v_idx])));
+            const b_ptr = tables.table_bU[u_idx];
+
+            var A1: u32 = 0;
+            var A2: u32 = 0;
+            if (hasAlpha) {
+                const ab = abuf0.?;
+                const a1_i32: i32 = (@as(i32, ab[i * 2]) + 64) >> 7;
+                const a2_i32: i32 = (@as(i32, ab[i * 2 + 1]) + 64) >> 7;
+                A1 = t.clipUint8(a1_i32);
+                A2 = t.clipUint8(a2_i32);
+            }
+
+            yuv2rgbWrite(dest, i, Y1, Y2, A1, A2, r_ptr, g_ptr, b_ptr, target, hasAlpha);
+        }
+    }
+}
