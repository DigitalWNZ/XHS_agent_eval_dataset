+pub fn unscaledBgr24ToYuv420p(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    width: usize,
+    height: usize,
+) void {
+    const s0 = src_data[0].?;
+    const ydst0 = dst_data[0].?;
+    const udst0 = dst_data[1].?;
+    const vdst0 = dst_data[2].?;
+
+    const ry = t.INPUT_RGB2YUV_TABLE[t.RY_IDX];
+    const gy = t.INPUT_RGB2YUV_TABLE[t.GY_IDX];
+    const by = t.INPUT_RGB2YUV_TABLE[t.BY_IDX];
+    const ru = t.INPUT_RGB2YUV_TABLE[t.RU_IDX];
+    const gu = t.INPUT_RGB2YUV_TABLE[t.GU_IDX];
+    const bu = t.INPUT_RGB2YUV_TABLE[t.BU_IDX];
+    const rv = t.INPUT_RGB2YUV_TABLE[t.RV_IDX];
+    const gv = t.INPUT_RGB2YUV_TABLE[t.GV_IDX];
+    const bv = t.INPUT_RGB2YUV_TABLE[t.BV_IDX];
+
+    const chromWidth = width >> 1;
+    var y: usize = 0;
+    while (y < height) : (y += 2) {
+        const src1: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s0))) + @as(isize, @intCast(y)) * @as(isize, src_stride[0]))));
+        const src2: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(src1))) + @as(isize, src_stride[0]))));
+        const ydst1: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(ydst0))) + @as(isize, @intCast(y)) * @as(isize, dst_stride[0]))));
+        const ydst2: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(ydst1))) + @as(isize, dst_stride[0]))));
+        const udst: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(udst0))) + @as(isize, @intCast(y >> 1)) * @as(isize, dst_stride[1]))));
+        const vdst: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(vdst0))) + @as(isize, @intCast(y >> 1)) * @as(isize, dst_stride[2]))));
+
+        for (0..chromWidth) |i| {
+            const b11: i32 = src1[6 * i + 0];
+            const g11: i32 = src1[6 * i + 1];
+            const r11: i32 = src1[6 * i + 2];
+            const b12: i32 = src1[6 * i + 3];
+            const g12: i32 = src1[6 * i + 4];
+            const r12: i32 = src1[6 * i + 5];
+            const b21: i32 = src2[6 * i + 0];
+            const g21: i32 = src2[6 * i + 1];
+            const r21: i32 = src2[6 * i + 2];
+            const b22: i32 = src2[6 * i + 3];
+            const g22: i32 = src2[6 * i + 4];
+            const r22: i32 = src2[6 * i + 5];
+
+            const Y11: u8 = @intCast(((ry * r11 + gy * g11 + by * b11) >> t.RGB2YUV_SHIFT) + 16);
+            const Y12: u8 = @intCast(((ry * r12 + gy * g12 + by * b12) >> t.RGB2YUV_SHIFT) + 16);
+            const Y21: u8 = @intCast(((ry * r21 + gy * g21 + by * b21) >> t.RGB2YUV_SHIFT) + 16);
+            const Y22: u8 = @intCast(((ry * r22 + gy * g22 + by * b22) >> t.RGB2YUV_SHIFT) + 16);
+
+            const bx: i32 = (b11 + b12 + b21 + b22) >> 2;
+            const gx: i32 = (g11 + g12 + g21 + g22) >> 2;
+            const rx: i32 = (r11 + r12 + r21 + r22) >> 2;
+
+            const U: u8 = @intCast(((ru * rx + gu * gx + bu * bx) >> t.RGB2YUV_SHIFT) + 128);
+            const V: u8 = @intCast(((rv * rx + gv * gx + bv * bx) >> t.RGB2YUV_SHIFT) + 128);
+
+            ydst1[2 * i + 0] = Y11;
+            ydst1[2 * i + 1] = Y12;
+            ydst2[2 * i + 0] = Y21;
+            ydst2[2 * i + 1] = Y22;
+            udst[i] = U;
+            vdst[i] = V;
+        }
+    }
+}
+
+pub fn unscaledRgbToRgb(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    width: usize,
+    height: usize,
+    src_fmt: c_int,
+    dst_fmt: c_int,
+) void {
+    const s0 = src_data[0].?;
+    const d0 = dst_data[0].?;
+    const alpha255: V16u8 = @splat(255);
+
+    for (0..height) |y| {
+        const src: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s0))) + @as(isize, @intCast(y)) * @as(isize, src_stride[0]))));
+        const dst: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(d0))) + @as(isize, @intCast(y)) * @as(isize, dst_stride[0]))));
+
+        if (src_fmt == dst_fmt) {
+            const bpp: usize = if (src_fmt == t.PIXFMT_RGBA or src_fmt == t.PIXFMT_BGRA) 4 else 3;
+            @memcpy(dst[0 .. width * bpp], src[0 .. width * bpp]);
+        } else if ((src_fmt == t.PIXFMT_RGBA and dst_fmt == t.PIXFMT_BGRA) or
+            (src_fmt == t.PIXFMT_BGRA and dst_fmt == t.PIXFMT_RGBA))
+        {
+            var x: usize = 0;
+            while (x + 8 <= width) : (x += 8) {
+                const v: V32u8 = src[4 * x ..][0..32].*;
+                dst[4 * x ..][0..32].* = @shuffle(u8, v, undefined, [32]i32{
+                    2,  1,  0,  3,  6,  5,  4,  7,  10, 9,  8,  11, 14, 13, 12, 15,
+                    18, 17, 16, 19, 22, 21, 20, 23, 26, 25, 24, 27, 30, 29, 28, 31,
+                });
+            }
+            while (x < width) : (x += 1) {
+                dst[4 * x + 0] = src[4 * x + 2];
+                dst[4 * x + 1] = src[4 * x + 1];
+                dst[4 * x + 2] = src[4 * x + 0];
+                dst[4 * x + 3] = src[4 * x + 3];
+            }
+        } else if ((src_fmt == t.PIXFMT_RGB24 and dst_fmt == t.PIXFMT_BGR24) or
+            (src_fmt == t.PIXFMT_BGR24 and dst_fmt == t.PIXFMT_RGB24))
+        {
+            var x: usize = 0;
+            while (x + 16 <= width) : (x += 16) {
+                const rgb = loadRgb24Vec16(src + 3 * x);
+                storeRgb24Vec16(dst + 3 * x, rgb.b, rgb.g, rgb.r);
+            }
+            while (x < width) : (x += 1) {
+                dst[3 * x + 0] = src[3 * x + 2];
+                dst[3 * x + 1] = src[3 * x + 1];
+                dst[3 * x + 2] = src[3 * x + 0];
+            }
+        } else if ((src_fmt == t.PIXFMT_RGB24 and dst_fmt == t.PIXFMT_RGBA) or
+            (src_fmt == t.PIXFMT_BGR24 and dst_fmt == t.PIXFMT_BGRA))
+        {
+            var x: usize = 0;
+            while (x + 16 <= width) : (x += 16) {
+                const v0: V16u8 = src[3 * x ..][0..16].*;
+                const v1: V16u8 = src[3 * x + 16 ..][0..16].*;
+                const v2: V16u8 = src[3 * x + 32 ..][0..16].*;
+
+                // Pixels 0..3 (from v0[0..11])
+                dst[4 * x ..][0..16].* = @shuffle(u8, v0, alpha255, [16]i32{ 0, 1, 2, -1, 3, 4, 5, -1, 6, 7, 8, -1, 9, 10, 11, -1 });
+                // Pixels 4..7 (from v0[12..15] and v1[0..7])
+                const mid1 = @shuffle(u8, v0, v1, [16]i32{ 12, 13, 14, 15, -1, -2, -3, -4, -5, -6, -7, -8, 0, 0, 0, 0 });
+                dst[4 * x + 16 ..][0..16].* = @shuffle(u8, mid1, alpha255, [16]i32{ 0, 1, 2, -1, 3, 4, 5, -1, 6, 7, 8, -1, 9, 10, 11, -1 });
+                // Pixels 8..11 (from v1[8..15] and v2[0..3])
+                const mid2 = @shuffle(u8, v1, v2, [16]i32{ 8, 9, 10, 11, 12, 13, 14, 15, -1, -2, -3, -4, 0, 0, 0, 0 });
+                dst[4 * x + 32 ..][0..16].* = @shuffle(u8, mid2, alpha255, [16]i32{ 0, 1, 2, -1, 3, 4, 5, -1, 6, 7, 8, -1, 9, 10, 11, -1 });
+                // Pixels 12..15 (from v2[4..15])
+                dst[4 * x + 48 ..][0..16].* = @shuffle(u8, v2, alpha255, [16]i32{ 4, 5, 6, -1, 7, 8, 9, -1, 10, 11, 12, -1, 13, 14, 15, -1 });
+            }
+            while (x < width) : (x += 1) {
+                dst[4 * x + 0] = src[3 * x + 0];
+                dst[4 * x + 1] = src[3 * x + 1];
+                dst[4 * x + 2] = src[3 * x + 2];
+                dst[4 * x + 3] = 255;
+            }
+        } else if ((src_fmt == t.PIXFMT_RGB24 and dst_fmt == t.PIXFMT_BGRA) or
+            (src_fmt == t.PIXFMT_BGR24 and dst_fmt == t.PIXFMT_RGBA))
+        {
+            var x: usize = 0;
+            while (x + 16 <= width) : (x += 16) {
+                const v0: V16u8 = src[3 * x ..][0..16].*;
+                const v1: V16u8 = src[3 * x + 16 ..][0..16].*;
+                const v2: V16u8 = src[3 * x + 32 ..][0..16].*;
+
+                // Pixels 0..3 (from v0[0..11], R/B swapped)
+                dst[4 * x ..][0..16].* = @shuffle(u8, v0, alpha255, [16]i32{ 2, 1, 0, -1, 5, 4, 3, -1, 8, 7, 6, -1, 11, 10, 9, -1 });
+                // Pixels 4..7 (from v0[12..15] and v1[0..7], R/B swapped)
+                const mid1 = @shuffle(u8, v0, v1, [16]i32{ 12, 13, 14, 15, -1, -2, -3, -4, -5, -6, -7, -8, 0, 0, 0, 0 });
+                dst[4 * x + 16 ..][0..16].* = @shuffle(u8, mid1, alpha255, [16]i32{ 2, 1, 0, -1, 5, 4, 3, -1, 8, 7, 6, -1, 11, 10, 9, -1 });
+                // Pixels 8..11 (from v1[8..15] and v2[0..3], R/B swapped)
+                const mid2 = @shuffle(u8, v1, v2, [16]i32{ 8, 9, 10, 11, 12, 13, 14, 15, -1, -2, -3, -4, 0, 0, 0, 0 });
+                dst[4 * x + 32 ..][0..16].* = @shuffle(u8, mid2, alpha255, [16]i32{ 2, 1, 0, -1, 5, 4, 3, -1, 8, 7, 6, -1, 11, 10, 9, -1 });
+                // Pixels 12..15 (from v2[4..15], R/B swapped)
+                dst[4 * x + 48 ..][0..16].* = @shuffle(u8, v2, alpha255, [16]i32{ 6, 5, 4, -1, 9, 8, 7, -1, 12, 11, 10, -1, 15, 14, 13, -1 });
+            }
+            while (x < width) : (x += 1) {
+                dst[4 * x + 0] = src[3 * x + 2];
+                dst[4 * x + 1] = src[3 * x + 1];
+                dst[4 * x + 2] = src[3 * x + 0];
+                dst[4 * x + 3] = 255;
+            }
+        } else if ((src_fmt == t.PIXFMT_RGBA and dst_fmt == t.PIXFMT_RGB24) or
+            (src_fmt == t.PIXFMT_BGRA and dst_fmt == t.PIXFMT_BGR24))
+        {
+            var x: usize = 0;
+            while (x + 16 <= width) : (x += 16) {
+                const v0: V16u8 = src[4 * x ..][0..16].*;
+                const v1: V16u8 = src[4 * x + 16 ..][0..16].*;
+                const v2: V16u8 = src[4 * x + 32 ..][0..16].*;
+                const v3: V16u8 = src[4 * x + 48 ..][0..16].*;
+
+                // Pack 16 RGBA pixels (64 bytes) into 48 RGB24 bytes (3x 16-byte stores)
+                const out0 = @shuffle(u8, v0, v1, [16]i32{ 0, 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, -1, -2, -3, -5 });
+                const out1 = @shuffle(u8, v1, v2, [16]i32{ 5, 6, 8, 9, 10, 12, 13, 14, -1, -2, -3, -5, -6, -7, -9, -10 });
+                const out2 = @shuffle(u8, v2, v3, [16]i32{ 10, 12, 13, 14, -1, -2, -3, -5, -6, -7, -9, -10, -11, -13, -14, -15 });
+                dst[3 * x ..][0..16].* = out0;
+                dst[3 * x + 16 ..][0..16].* = out1;
+                dst[3 * x + 32 ..][0..16].* = out2;
+            }
+            while (x < width) : (x += 1) {
+                dst[3 * x + 0] = src[4 * x + 0];
+                dst[3 * x + 1] = src[4 * x + 1];
+                dst[3 * x + 2] = src[4 * x + 2];
+            }
+        } else if ((src_fmt == t.PIXFMT_RGBA and dst_fmt == t.PIXFMT_BGR24) or
+            (src_fmt == t.PIXFMT_BGRA and dst_fmt == t.PIXFMT_RGB24))
+        {
+            var x: usize = 0;
+            while (x + 16 <= width) : (x += 16) {
+                const v0: V16u8 = src[4 * x ..][0..16].*;
+                const v1: V16u8 = src[4 * x + 16 ..][0..16].*;
+                const v2: V16u8 = src[4 * x + 32 ..][0..16].*;
+                const v3: V16u8 = src[4 * x + 48 ..][0..16].*;
+
+                const out0 = @shuffle(u8, v0, v1, [16]i32{ 2, 1, 0, 6, 5, 4, 10, 9, 8, 14, 13, 12, -3, -2, -1, -7 });
+                const out1 = @shuffle(u8, v1, v2, [16]i32{ 5, 4, 10, 9, 8, 14, 13, 12, -3, -2, -1, -7, -6, -5, -11, -10 });
+                const out2 = @shuffle(u8, v2, v3, [16]i32{ 8, 14, 13, 12, -3, -2, -1, -7, -6, -5, -11, -10, -9, -15, -14, -13 });
+                dst[3 * x ..][0..16].* = out0;
+                dst[3 * x + 16 ..][0..16].* = out1;
+                dst[3 * x + 32 ..][0..16].* = out2;
+            }
+            while (x < width) : (x += 1) {
+                dst[3 * x + 0] = src[4 * x + 2];
+                dst[3 * x + 1] = src[4 * x + 1];
+                dst[3 * x + 2] = src[4 * x + 0];
+            }
+        }
+    }
+}
