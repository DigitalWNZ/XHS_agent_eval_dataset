+    const crv_inc: V8i32 = @splat(@intCast(crv_c));
+    const cgu_inc: V8i32 = @splat(@intCast(cgu_c));
+    const cgv_inc: V8i32 = @splat(@intCast(cgv_c));
+    const cbu_inc: V8i32 = @splat(@intCast(cbu_c));
