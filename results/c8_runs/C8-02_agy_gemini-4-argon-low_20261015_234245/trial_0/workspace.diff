+        }
+    } else if (filterSize == 4) {
+        const s0 = src[0];
+        const s1 = src[1];
+        const s2 = src[2];
+        const s3 = src[3];
+        const f0: V16i32 = @splat(@as(i32, filter[0]));
+        const f1: V16i32 = @splat(@as(i32, filter[1]));
+        const f2: V16i32 = @splat(@as(i32, filter[2]));
+        const f3: V16i32 = @splat(@as(i32, filter[3]));
