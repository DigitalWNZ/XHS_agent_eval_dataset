+            const fj: V8i32 = @splat(@as(i32, chrFilter[j]));
+            const uj: V8i32 = @intCast(@as(V8i16, chrUSrc[j][i..][0..8].*));
+            const vj: V8i32 = @intCast(@as(V8i16, chrVSrc[j][i..][0..8].*));
+            u += uj * fj;
+            v += vj * fj;
