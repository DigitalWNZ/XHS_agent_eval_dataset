--- /dev/null
+++ b/swscale-impl/src/yuv2rgb.zig
@@ -0,0 +1,135 @@
+const std = @import("std");
+const t = @import("tables.zig");
+
+pub const Yuv2RgbTables = struct {
+    yuvTable: ?[]u8 = null,
+    table_rV: [256 + 2 * t.YUVRGB_TABLE_HEADROOM][*]u8 = undefined,
+    table_gU: [256 + 2 * t.YUVRGB_TABLE_HEADROOM][*]u8 = undefined,
+    table_bU: [256 + 2 * t.YUVRGB_TABLE_HEADROOM][*]u8 = undefined,
+    table_gV: [256 + 2 * t.YUVRGB_TABLE_HEADROOM]isize = undefined,
+
+    yuv2rgb_y_offset: i32 = 0,
+    yuv2rgb_y_coeff: i32 = 0,
+    yuv2rgb_v2r_coeff: i32 = 0,
+    yuv2rgb_v2g_coeff: i32 = 0,
+    yuv2rgb_u2g_coeff: i32 = 0,
+    yuv2rgb_u2b_coeff: i32 = 0,
+
+    fn roundToInt16(f: i64) i16 {
+        const r: i32 = @intCast((f + (1 << 15)) >> 16);
+        if (r < -0x7FFF) return @bitCast(@as(u16, 0x8000));
+        if (r > 0x7FFF) return 0x7FFF;
+        return @intCast(r);
+    }
+
+    fn fillTable(table: *[256 + 2 * t.YUVRGB_TABLE_HEADROOM][*]u8, elemsize: isize, inc: i64, y_tab: [*]u8) void {
+        const y_table: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(y_tab))) - elemsize * @as(isize, @intCast(inc >> 9)))));
+        for (0..256 + 2 * t.YUVRGB_TABLE_HEADROOM) |i| {
+            const idx: i32 = @as(i32, @intCast(i)) - t.YUVRGB_TABLE_HEADROOM;
+            const cb: i64 = @as(i64, t.clipUint8(idx)) * inc;
+            const offset: isize = elemsize * @as(isize, @intCast(cb >> 16));
+            table[i] = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(y_table))) + offset)));
+        }
+    }
+
+    fn fillGvTable(table: *[256 + 2 * t.YUVRGB_TABLE_HEADROOM]isize, elemsize: isize, inc: i64) void {
+        const off: isize = -@as(isize, @intCast(inc >> 9));
+        for (0..256 + 2 * t.YUVRGB_TABLE_HEADROOM) |i| {
+            const idx: i32 = @as(i32, @intCast(i)) - t.YUVRGB_TABLE_HEADROOM;
+            const cb: i64 = @as(i64, t.clipUint8(idx)) * inc;
+            table[i] = elemsize * (off + @as(isize, @intCast(cb >> 16)));
+        }
+    }
+
+    pub fn init(self: *Yuv2RgbTables, allocator: std.mem.Allocator, dstFormat: c_int, fullRange: bool) !void {
+        // In FFmpeg:
+        // AV_PIX_FMT_RGB32 is BGRA on LE, AV_PIX_FMT_BGR32 is RGBA on LE.
+        // isRgb is true for AV_PIX_FMT_RGB32 (BGRA) and AV_PIX_FMT_BGR24.
+        const isRgb = (dstFormat == t.PIXFMT_BGRA or dstFormat == t.PIXFMT_BGR24);
+        const bpp = t.getBitsPerPixel(dstFormat);
+        const yoffs: usize = (if (fullRange) @as(usize, 384) else @as(usize, 326)) + t.YUVRGB_TABLE_LUMA_HEADROOM;
+        const table_plane_size: usize = 1024 + 2 * t.YUVRGB_TABLE_LUMA_HEADROOM;
+
+        const inv_table = t.YUV2RGB_COEFFS_DEFAULT;
+        var crv: i64 = inv_table[0];
+        var cbu: i64 = inv_table[1];
+        var cgu: i64 = -inv_table[2];
+        var cgv: i64 = -inv_table[3];
+        var cy: i64 = 1 << 16;
+        var oy: i64 = 0;
+
+        if (!fullRange) {
+            cy = @divTrunc(cy * 255, 219);
+            oy = 16 << 16;
+        } else {
+            crv = @divTrunc(crv * 224, 255);
+            cbu = @divTrunc(cbu * 224, 255);
+            cgu = @divTrunc(cgu * 224, 255);
+            cgv = @divTrunc(cgv * 224, 255);
+        }
+
+        const contrast: i64 = 1 << 16;
+        const saturation: i64 = 1 << 16;
+        cy = (cy * contrast) >> 16;
+        crv = (crv * contrast * saturation) >> 32;
+        cbu = (cbu * contrast * saturation) >> 32;
+        cgu = (cgu * contrast * saturation) >> 32;
+        cgv = (cgv * contrast * saturation) >> 32;
+
+        self.yuv2rgb_y_coeff = roundToInt16(cy * (1 << 13));
+        self.yuv2rgb_y_offset = roundToInt16(oy * (1 << 9));
+        self.yuv2rgb_v2r_coeff = roundToInt16(crv * (1 << 13));
+        self.yuv2rgb_v2g_coeff = roundToInt16(cgv * (1 << 13));
+        self.yuv2rgb_u2g_coeff = roundToInt16(cgu * (1 << 13));
+        self.yuv2rgb_u2b_coeff = roundToInt16(cbu * (1 << 13));
+
+        const max_cy = if (cy > 1) cy else 1;
+        crv = @divTrunc((crv * (1 << 16)) + 0x8000, max_cy);
+        cbu = @divTrunc((cbu * (1 << 16)) + 0x8000, max_cy);
+        cgu = @divTrunc((cgu * (1 << 16)) + 0x8000, max_cy);
+        cgv = @divTrunc((cgv * (1 << 16)) + 0x8000, max_cy);
+
+        if (bpp == 24) {
+            const buf = try allocator.alloc(u8, table_plane_size);
+            self.yuvTable = buf;
+            var yb: i64 = -(384 << 16) - t.YUVRGB_TABLE_LUMA_HEADROOM * cy - oy;
+            for (0..table_plane_size) |i| {
+                buf[i] = t.clipUint8(@intCast((yb + 0x8000) >> 16));
+                yb += cy;
+            }
+            fillTable(&self.table_rV, 1, crv, buf.ptr + yoffs);
+            fillTable(&self.table_gU, 1, cgu, buf.ptr + yoffs);
+            fillTable(&self.table_bU, 1, cbu, buf.ptr + yoffs);
+            fillGvTable(&self.table_gV, 1, cgv);
+        } else if (bpp == 32) {
+            const base: u5 = 0;
+            const rbase: u5 = base + (if (isRgb) @as(u5, 16) else @as(u5, 0));
+            const gbase: u5 = base + 8;
+            const bbase: u5 = base + (if (isRgb) @as(u5, 0) else @as(u5, 16));
+            const abase: u5 = (base + 24) & 31;
+
+            const buf = try allocator.alloc(u8, table_plane_size * 3 * 4);
+            self.yuvTable = buf;
+            const y_table32: [*]u32 = @ptrCast(@alignCast(buf.ptr));
+            var yb: i64 = -(384 << 16) - t.YUVRGB_TABLE_LUMA_HEADROOM * cy - oy;
+            for (0..table_plane_size) |i| {
+                const yval: u32 = t.clipUint8(@intCast((yb + 0x8000) >> 16));
+                y_table32[i] = (yval << rbase) + (@as(u32, 255) << abase);
+                y_table32[i + table_plane_size] = yval << gbase;
+                y_table32[i + 2 * table_plane_size] = yval << bbase;
+                yb += cy;
+            }
+            fillTable(&self.table_rV, 4, crv, @ptrCast(y_table32 + yoffs));
+            fillTable(&self.table_gU, 4, cgu, @ptrCast(y_table32 + yoffs + table_plane_size));
+            fillTable(&self.table_bU, 4, cbu, @ptrCast(y_table32 + yoffs + 2 * table_plane_size));
+            fillGvTable(&self.table_gV, 4, cgv);
+        }
+    }
+
+    pub fn deinit(self: *Yuv2RgbTables, allocator: std.mem.Allocator) void {
+        if (self.yuvTable) |buf| {
+            allocator.free(buf);
+            self.yuvTable = null;
+        }
+    }
+};
