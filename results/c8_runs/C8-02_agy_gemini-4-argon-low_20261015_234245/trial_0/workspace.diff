+    var i: usize = 0;
+    while (i + 8 <= width) : (i += 8) {
+        const rgba = loadRgbaVec16(src + 8 * i);
+        const r16: V16i32 = @intCast(rgba.r);
+        const g16: V16i32 = @intCast(rgba.g);
