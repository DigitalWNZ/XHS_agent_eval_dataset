+pub fn bgraToUVHalf(dstU: [*]i16, dstV: [*]i16, src: [*]const u8, width: usize) void {
+    const ru_s = t.INPUT_RGB2YUV_TABLE[t.RU_IDX];
+    const gu_s = t.INPUT_RGB2YUV_TABLE[t.GU_IDX];
+    const bu_s = t.INPUT_RGB2YUV_TABLE[t.BU_IDX];
+    const rv_s = t.INPUT_RGB2YUV_TABLE[t.RV_IDX];
+    const gv_s = t.INPUT_RGB2YUV_TABLE[t.GV_IDX];
+    const bv_s = t.INPUT_RGB2YUV_TABLE[t.BV_IDX];
+    const rnd_s: i32 = (256 << t.RGB2YUV_SHIFT) + (1 << (t.RGB2YUV_SHIFT - 6));
+
+    const ru: V8i32 = @splat(ru_s);
+    const gu: V8i32 = @splat(gu_s);
+    const bu: V8i32 = @splat(bu_s);
+    const rv: V8i32 = @splat(rv_s);
+    const gv: V8i32 = @splat(gv_s);
+    const bv: V8i32 = @splat(bv_s);
+    const rnd: V8i32 = @splat(rnd_s);
+
+    var i: usize = 0;
+    while (i + 8 <= width) : (i += 8) {
+        const bgra = loadRgbaVec16(src + 8 * i);
+        const b16: V16i32 = @intCast(bgra.r);
+        const g16: V16i32 = @intCast(bgra.g);
+        const r16: V16i32 = @intCast(bgra.b);
+        const r = @shuffle(i32, r16, undefined, [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 }) +
+            @shuffle(i32, r16, undefined, [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 });
+        const g = @shuffle(i32, g16, undefined, [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 }) +
+            @shuffle(i32, g16, undefined, [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 });
+        const b = @shuffle(i32, b16, undefined, [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 }) +
+            @shuffle(i32, b16, undefined, [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 });
+        const u_v: V8i16 = @intCast((ru * r + gu * g + bu * b + rnd) >> @splat(t.RGB2YUV_SHIFT - 5));
+        const v_v: V8i16 = @intCast((rv * r + gv * g + bv * b + rnd) >> @splat(t.RGB2YUV_SHIFT - 5));
+        dstU[i..][0..8].* = u_v;
+        dstV[i..][0..8].* = v_v;
+    }
+    while (i < width) : (i += 1) {
+        const b: i32 = @as(i32, src[8 * i + 0]) + @as(i32, src[8 * i + 4]);
+        const g: i32 = @as(i32, src[8 * i + 1]) + @as(i32, src[8 * i + 5]);
+        const r: i32 = @as(i32, src[8 * i + 2]) + @as(i32, src[8 * i + 6]);
+        dstU[i] = @intCast((ru_s * r + gu_s * g + bu_s * b + rnd_s) >> (t.RGB2YUV_SHIFT - 5));
+        dstV[i] = @intCast((rv_s * r + gv_s * g + bv_s * b + rnd_s) >> (t.RGB2YUV_SHIFT - 5));
+    }
+}
+
+pub fn nv12ToUV(dstU: [*]u8, dstV: [*]u8, src: [*]const u8, width: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const v0: V16u8 = src[2 * i ..][0..16].*;
+        const v1: V16u8 = src[2 * i + 16 ..][0..16].*;
+        dstU[i..][0..16].* = @shuffle(u8, v0, v1, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, -1, -3, -5, -7, -9, -11, -13, -15 });
+        dstV[i..][0..16].* = @shuffle(u8, v0, v1, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, -2, -4, -6, -8, -10, -12, -14, -16 });
+    }
+    while (i < width) : (i += 1) {
+        dstU[i] = src[2 * i + 0];
+        dstV[i] = src[2 * i + 1];
+    }
+}
+
+pub fn nv21ToUV(dstU: [*]u8, dstV: [*]u8, src: [*]const u8, width: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= width) : (i += 16) {
+        const v0: V16u8 = src[2 * i ..][0..16].*;
+        const v1: V16u8 = src[2 * i + 16 ..][0..16].*;
+        dstV[i..][0..16].* = @shuffle(u8, v0, v1, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, -1, -3, -5, -7, -9, -11, -13, -15 });
+        dstU[i..][0..16].* = @shuffle(u8, v0, v1, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, -2, -4, -6, -8, -10, -12, -14, -16 });
+    }
+    while (i < width) : (i += 1) {
+        dstV[i] = src[2 * i + 0];
+        dstU[i] = src[2 * i + 1];
+    }
+}
+
+pub fn hScale8To15(
+    dst: [*]i16,
+    dstW: usize,
+    src: [*]const u8,
+    filter: [*]const i16,
+    filterPos: [*]const i32,
+    filterSize: usize,
+) void {
+    const max15: V8i32 = @splat((1 << 15) - 1);
+    if (filterSize == 1) {
+        // Check if identity 1-tap (filterPos[0] == 0 and filterPos[dstW-1] == dstW-1 and filter[0] == 16384)
+        if (dstW >= 16 and filterPos[0] == 0 and filterPos[dstW - 1] == @as(i32, @intCast(dstW - 1)) and filter[0] == (1 << 14)) {
+            var i: usize = 0;
+            while (i + 16 <= dstW) : (i += 16) {
+                const s: V16u8 = src[i..][0..16].*;
+                const s16: V16i16 = @intCast(s);
+                dst[i..][0..16].* = s16 << @splat(7);
+            }
+            while (i < dstW) : (i += 1) {
+                dst[i] = @as(i16, src[i]) << 7;
+            }
+            return;
+        }
+        // Nearest-neighbor 1-tap with filter[i] == 16384
+        for (0..dstW) |i| {
+            const srcPos: usize = @intCast(filterPos[i]);
+            const val: i32 = @as(i32, src[srcPos]) * @as(i32, filter[i]);
+            dst[i] = @intCast(@min(val >> 7, (1 << 15) - 1));
+        }
+        return;
+    } else if (filterSize == 2) {
+        var i: usize = 0;
+        while (i + 16 <= dstW) : (i += 16) {
+            var s0_arr: [16]u8 = undefined;
+            var s1_arr: [16]u8 = undefined;
+            inline for (0..16) |k| {
+                const sp: usize = @intCast(filterPos[i + k]);
+                s0_arr[k] = src[sp];
+                s1_arr[k] = src[sp + 1];
+            }
+            const fl_lo: V16i32 = @intCast(@as(V16i16, filter[2 * i ..][0..16].*));
+            const fl_hi: V16i32 = @intCast(@as(V16i16, filter[2 * i + 16 ..][0..16].*));
+            const f0 = @shuffle(i32, fl_lo, fl_hi, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, -1, -3, -5, -7, -9, -11, -13, -15 });
+            const f1 = @shuffle(i32, fl_lo, fl_hi, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, -2, -4, -6, -8, -10, -12, -14, -16 });
+            const s0: V16i32 = @intCast(@as(V16u8, s0_arr));
+            const s1: V16i32 = @intCast(@as(V16u8, s1_arr));
+            const val = (s0 * f0 + s1 * f1) >> @splat(7);
+            const max15_16: V16i32 = @splat((1 << 15) - 1);
+            const out_v: V16i16 = @intCast(@min(val, max15_16));
+            dst[i..][0..16].* = out_v;
+        }
+        while (i < dstW) : (i += 1) {
+            const sp: usize = @intCast(filterPos[i]);
+            const val: i32 = @as(i32, src[sp]) * @as(i32, filter[2 * i]) + @as(i32, src[sp + 1]) * @as(i32, filter[2 * i + 1]);
+            dst[i] = @intCast(@min(val >> 7, (1 << 15) - 1));
+        }
+        return;
+    } else if (filterSize == 4) {
+        var i: usize = 0;
+        while (i + 8 <= dstW) : (i += 8) {
+            var p_arr: [8][4]u8 = undefined;
+            inline for (0..8) |k| {
+                const sp: usize = @intCast(filterPos[i + k]);
+                p_arr[k] = src[sp..][0..4].*;
+            }
+            const p_vec: @Vector(32, u8) = @bitCast(p_arr);
+            const s0_u8 = @shuffle(u8, p_vec, undefined, [8]i32{ 0, 4, 8, 12, 16, 20, 24, 28 });
+            const s1_u8 = @shuffle(u8, p_vec, undefined, [8]i32{ 1, 5, 9, 13, 17, 21, 25, 29 });
+            const s2_u8 = @shuffle(u8, p_vec, undefined, [8]i32{ 2, 6, 10, 14, 18, 22, 26, 30 });
+            const s3_u8 = @shuffle(u8, p_vec, undefined, [8]i32{ 3, 7, 11, 15, 19, 23, 27, 31 });
+            const fl_lo: V16i32 = @intCast(@as(V16i16, filter[4 * i ..][0..16].*));
+            const fl_hi: V16i32 = @intCast(@as(V16i16, filter[4 * i + 16 ..][0..16].*));
+            const f0 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 0, 4, 8, 12, -1, -5, -9, -13 });
+            const f1 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 1, 5, 9, 13, -2, -6, -10, -14 });
+            const f2 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 2, 6, 10, 14, -3, -7, -11, -15 });
+            const f3 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 3, 7, 11, 15, -4, -8, -12, -16 });
+            const s0: V8i32 = @intCast(s0_u8);
+            const s1: V8i32 = @intCast(s1_u8);
+            const s2: V8i32 = @intCast(s2_u8);
+            const s3: V8i32 = @intCast(s3_u8);
+            const val = (s0 * f0 + s1 * f1 + s2 * f2 + s3 * f3) >> @splat(7);
+            const out_v: V8i16 = @intCast(@min(val, max15));
+            dst[i..][0..8].* = out_v;
+        }
+        while (i < dstW) : (i += 1) {
+            const sp: usize = @intCast(filterPos[i]);
+            const val: i32 = @as(i32, src[sp + 0]) * @as(i32, filter[4 * i + 0]) +
+                @as(i32, src[sp + 1]) * @as(i32, filter[4 * i + 1]) +
+                @as(i32, src[sp + 2]) * @as(i32, filter[4 * i + 2]) +
+                @as(i32, src[sp + 3]) * @as(i32, filter[4 * i + 3]);
+            dst[i] = @intCast(@min(val >> 7, (1 << 15) - 1));
+        }
+        return;
+    }
+    for (0..dstW) |i| {
+        const srcPos: usize = @intCast(filterPos[i]);
+        var val: i32 = 0;
+        for (0..filterSize) |j| {
+            val += @as(i32, src[srcPos + j]) * @as(i32, filter[filterSize * i + j]);
+        }
+        dst[i] = @intCast(@min(val >> 7, (1 << 15) - 1));
+    }
+}
+
+pub fn hScale16To15(
+    dst: [*]i16,
+    dstW: usize,
+    src: [*]const u16,
+    filter: [*]const i16,
+    filterPos: [*]const i32,
+    filterSize: usize,
+) void {
+    const max15: V8i32 = @splat((1 << 15) - 1);
+    if (filterSize == 1) {
+        if (dstW >= 16 and filterPos[0] == 0 and filterPos[dstW - 1] == @as(i32, @intCast(dstW - 1)) and filter[0] == (1 << 14)) {
+            const max15_16: @Vector(16, u16) = @splat((1 << 15) - 1);
+            var i: usize = 0;
+            while (i + 16 <= dstW) : (i += 16) {
+                const s: @Vector(16, u16) = src[i..][0..16].*;
+                const out_v: V16i16 = @intCast(@min(s << @splat(1), max15_16));
+                dst[i..][0..16].* = out_v;
+            }
+            while (i < dstW) : (i += 1) {
+                const val: i32 = @as(i32, src[i]) << 1;
+                dst[i] = @intCast(@min(val, (1 << 15) - 1));
+            }
+            return;
+        }
+        for (0..dstW) |i| {
+            const srcPos: usize = @intCast(filterPos[i]);
+            const val: i32 = @as(i32, src[srcPos]) * @as(i32, filter[i]);
+            dst[i] = @intCast(@min(val >> 13, (1 << 15) - 1));
+        }
+        return;
+    } else if (filterSize == 2) {
+        var i: usize = 0;
+        while (i + 16 <= dstW) : (i += 16) {
+            var p_lo_arr: [8][2]u16 = undefined;
+            var p_hi_arr: [8][2]u16 = undefined;
+            inline for (0..8) |k| {
+                const sp_lo: usize = @intCast(filterPos[i + k]);
+                const sp_hi: usize = @intCast(filterPos[i + 8 + k]);
+                p_lo_arr[k] = src[sp_lo..][0..2].*;
+                p_hi_arr[k] = src[sp_hi..][0..2].*;
+            }
+            const p_lo: @Vector(16, u16) = @bitCast(p_lo_arr);
+            const p_hi: @Vector(16, u16) = @bitCast(p_hi_arr);
+            const s0: V16i32 = @intCast(@shuffle(u16, p_lo, p_hi, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, -1, -3, -5, -7, -9, -11, -13, -15 }));
+            const s1: V16i32 = @intCast(@shuffle(u16, p_lo, p_hi, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, -2, -4, -6, -8, -10, -12, -14, -16 }));
+
+            const fl_lo: V16i32 = @intCast(@as(V16i16, filter[2 * i ..][0..16].*));
+            const fl_hi: V16i32 = @intCast(@as(V16i16, filter[2 * i + 16 ..][0..16].*));
+            const f0 = @shuffle(i32, fl_lo, fl_hi, [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, -1, -3, -5, -7, -9, -11, -13, -15 });
+            const f1 = @shuffle(i32, fl_lo, fl_hi, [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, -2, -4, -6, -8, -10, -12, -14, -16 });
+
+            const val = (s0 * f0 + s1 * f1) >> @splat(13);
+            const max15_16: V16i32 = @splat((1 << 15) - 1);
+            const out_v: V16i16 = @intCast(@min(val, max15_16));
+            dst[i..][0..16].* = out_v;
+        }
+        while (i < dstW) : (i += 1) {
+            const sp: usize = @intCast(filterPos[i]);
+            const val: i32 = @as(i32, src[sp]) * @as(i32, filter[2 * i]) + @as(i32, src[sp + 1]) * @as(i32, filter[2 * i + 1]);
+            dst[i] = @intCast(@min(val >> 13, (1 << 15) - 1));
+        }
+        return;
+    } else if (filterSize == 4) {
+        var i: usize = 0;
+        while (i + 8 <= dstW) : (i += 8) {
+            var p_lo_arr: [4][4]u16 = undefined;
+            var p_hi_arr: [4][4]u16 = undefined;
+            inline for (0..4) |k| {
+                const sp_lo: usize = @intCast(filterPos[i + k]);
+                const sp_hi: usize = @intCast(filterPos[i + 4 + k]);
+                p_lo_arr[k] = src[sp_lo..][0..4].*;
+                p_hi_arr[k] = src[sp_hi..][0..4].*;
+            }
+            const p_lo: @Vector(16, u16) = @bitCast(p_lo_arr);
+            const p_hi: @Vector(16, u16) = @bitCast(p_hi_arr);
+            const s0: V8i32 = @intCast(@shuffle(u16, p_lo, p_hi, [8]i32{ 0, 4, 8, 12, -1, -5, -9, -13 }));
+            const s1: V8i32 = @intCast(@shuffle(u16, p_lo, p_hi, [8]i32{ 1, 5, 9, 13, -2, -6, -10, -14 }));
+            const s2: V8i32 = @intCast(@shuffle(u16, p_lo, p_hi, [8]i32{ 2, 6, 10, 14, -3, -7, -11, -15 }));
+            const s3: V8i32 = @intCast(@shuffle(u16, p_lo, p_hi, [8]i32{ 3, 7, 11, 15, -4, -8, -12, -16 }));
+
+            const fl_lo: V16i32 = @intCast(@as(V16i16, filter[4 * i ..][0..16].*));
+            const fl_hi: V16i32 = @intCast(@as(V16i16, filter[4 * i + 16 ..][0..16].*));
+            const f0 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 0, 4, 8, 12, -1, -5, -9, -13 });
+            const f1 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 1, 5, 9, 13, -2, -6, -10, -14 });
+            const f2 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 2, 6, 10, 14, -3, -7, -11, -15 });
+            const f3 = @shuffle(i32, fl_lo, fl_hi, [8]i32{ 3, 7, 11, 15, -4, -8, -12, -16 });
+
+            const val = (s0 * f0 + s1 * f1 + s2 * f2 + s3 * f3) >> @splat(13);
+            const out_v: V8i16 = @intCast(@min(val, max15));
+            dst[i..][0..8].* = out_v;
+        }
+        while (i < dstW) : (i += 1) {
+            const sp: usize = @intCast(filterPos[i]);
+            const val: i32 = @as(i32, src[sp + 0]) * @as(i32, filter[4 * i + 0]) +
+                @as(i32, src[sp + 1]) * @as(i32, filter[4 * i + 1]) +
+                @as(i32, src[sp + 2]) * @as(i32, filter[4 * i + 2]) +
+                @as(i32, src[sp + 3]) * @as(i32, filter[4 * i + 3]);
+            dst[i] = @intCast(@min(val >> 13, (1 << 15) - 1));
+        }
+        return;
+    }
+    // For RGB input in FFmpeg, sh = 13
+    for (0..dstW) |i| {
+        const srcPos: usize = @intCast(filterPos[i]);
+        var val: i32 = 0;
+        for (0..filterSize) |j| {
+            val += @as(i32, src[srcPos + j]) * @as(i32, filter[filterSize * i + j]);
+        }
+        dst[i] = @intCast(@min(val >> 13, (1 << 15) - 1));
+    }
+}
+
+pub fn lumRangeToJpeg(dst: [*]i16, width: usize) void {
+    for (0..width) |i| {
+        const v: i32 = @min(@as(i32, dst[i]), 30189);
+        dst[i] = @intCast((v * 19077 - 39057361) >> 14);
+    }
+}
+
+pub fn lumRangeFromJpeg(dst: [*]i16, width: usize) void {
+    for (0..width) |i| {
+        const v: i32 = dst[i];
+        dst[i] = @intCast((v * 14071 + 33561947) >> 14);
+    }
+}
