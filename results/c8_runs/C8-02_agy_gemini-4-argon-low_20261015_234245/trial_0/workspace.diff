+    algo: c_int,
+) ?*anyopaque {
+    const ctx = scale.SwsContext.init(
+        std.heap.c_allocator,
+        src_w,
+        src_h,
+        src_fmt,
+        dst_w,
+        dst_h,
+        dst_fmt,
+        algo,
+    ) catch return null;
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *scale.SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+    ctx.processGeneral(src_data, src_stride, dst_data, dst_stride);
+    return 0;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *scale.SwsContext = @ptrCast(@alignCast(ptr));
