+        const g: i32 = @as(i32, src[8 * i + 1]) + @as(i32, src[8 * i + 5]);
+        const b: i32 = @as(i32, src[8 * i + 2]) + @as(i32, src[8 * i + 6]);
+        dstU[i] = @intCast((ru_s * r + gu_s * g + bu_s * b + rnd_s) >> (t.RGB2YUV_SHIFT - 5));
