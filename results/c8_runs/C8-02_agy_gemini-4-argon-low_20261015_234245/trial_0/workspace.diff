+pub fn yuv2rgb_2(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    buf: [2][*]const i16,
+    ubuf: [2][*]const i16,
+    vbuf: [2][*]const i16,
+    abuf: [2]?[*]const i16,
+    dest: [*]u8,
+    dstW: usize,
+    yalpha: i32,
+    uvalpha: i32,
+    target: c_int,
+    hasAlpha: bool,
+) void {
+    const buf0 = buf[0];
+    const buf1 = buf[1];
+    const ubuf0 = ubuf[0];
+    const ubuf1 = ubuf[1];
+    const vbuf0 = vbuf[0];
+    const vbuf1 = vbuf[1];
+    const yalpha1: i32 = 4096 - yalpha;
+    const uvalpha1: i32 = 4096 - uvalpha;
+    const halfW = (dstW + 1) >> 1;
+    const is_std_range = (tables.yuv2rgb_y_offset != 0);
+    const bpp_pair: usize = if (target == t.PIXFMT_RGBA or target == t.PIXFMT_BGRA) 8 else 6;
+
+    var i: usize = 0;
+    if (is_std_range and (dstW & 1) == 0) {
+        const ya0: V16i32 = @splat(yalpha1);
+        const ya1: V16i32 = @splat(yalpha);
+        const uva0: V8i32 = @splat(uvalpha1);
+        const uva1: V8i32 = @splat(uvalpha);
+        while (i + 8 <= halfW) : (i += 8) {
+            const y0: V16i32 = @intCast(@as(V16i16, buf0[2 * i ..][0..16].*));
+            const y1: V16i32 = @intCast(@as(V16i16, buf1[2 * i ..][0..16].*));
+            const y_v = (y0 * ya0 + y1 * ya1) >> @splat(19);
+
+            const u_0: V8i32 = @intCast(@as(V8i16, ubuf0[i..][0..8].*));
+            const u_1: V8i32 = @intCast(@as(V8i16, ubuf1[i..][0..8].*));
+            const u_v = (u_0 * uva0 + u_1 * uva1) >> @splat(19);
+
+            const v0: V8i32 = @intCast(@as(V8i16, vbuf0[i..][0..8].*));
+            const v1: V8i32 = @intCast(@as(V8i16, vbuf1[i..][0..8].*));
+            const v_v = (v0 * uva0 + v1 * uva1) >> @splat(19);
+
+            var a_v: V16u8 = @splat(255);
+            if (hasAlpha) {
+                const ab0 = abuf[0].?;
+                const ab1 = abuf[1].?;
+                const a0: V16i32 = @intCast(@as(V16i16, ab0[2 * i ..][0..16].*));
+                const a1: V16i32 = @intCast(@as(V16i16, ab1[2 * i ..][0..16].*));
+                a_v = clipU8Vec16_i32((a0 * ya0 + a1 * ya1) >> @splat(19));
+            }
+            yuv2rgbVec16_std(y_v, u_v, v_v, a_v, dest + i * bpp_pair, target, hasAlpha);
+        }
+    }
+    while (i < halfW) : (i += 1) {
+        const Y1: i32 = (@as(i32, buf0[i * 2]) * yalpha1 + @as(i32, buf1[i * 2]) * yalpha) >> 19;
+        const Y2: i32 = (@as(i32, buf0[i * 2 + 1]) * yalpha1 + @as(i32, buf1[i * 2 + 1]) * yalpha) >> 19;
+        const U: i32 = (@as(i32, ubuf0[i]) * uvalpha1 + @as(i32, ubuf1[i]) * uvalpha) >> 19;
+        const V: i32 = (@as(i32, vbuf0[i]) * uvalpha1 + @as(i32, vbuf1[i]) * uvalpha) >> 19;
+
+        const u_idx: usize = @intCast(U + t.YUVRGB_TABLE_HEADROOM);
+        const v_idx: usize = @intCast(V + t.YUVRGB_TABLE_HEADROOM);
+        const r_ptr = tables.table_rV[v_idx];
+        const g_ptr: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(tables.table_gU[u_idx]))) + tables.table_gV[v_idx])));
+        const b_ptr = tables.table_bU[u_idx];
+
+        var A1: u32 = 0;
+        var A2: u32 = 0;
+        if (hasAlpha) {
+            const ab0 = abuf[0].?;
+            const ab1 = abuf[1].?;
+            var a1_i32: i32 = (@as(i32, ab0[i * 2]) * yalpha1 + @as(i32, ab1[i * 2]) * yalpha) >> 19;
+            var a2_i32: i32 = (@as(i32, ab0[i * 2 + 1]) * yalpha1 + @as(i32, ab1[i * 2 + 1]) * yalpha) >> 19;
+            if (((a1_i32 | a2_i32) & 0x100) != 0) {
+                a1_i32 = t.clipUint8(a1_i32);
+                a2_i32 = t.clipUint8(a2_i32);
+            }
+            A1 = @intCast(a1_i32);
+            A2 = @intCast(a2_i32);
+        }
+
+        yuv2rgbWrite(dest, i, Y1, Y2, A1, A2, r_ptr, g_ptr, b_ptr, target, hasAlpha);
+    }
+}
