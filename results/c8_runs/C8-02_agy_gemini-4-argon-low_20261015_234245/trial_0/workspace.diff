+        const conv_lum_buf = try allocator.alloc(i16, conv_w);
+        errdefer allocator.free(conv_lum_buf);
+        const conv_alp_buf = try allocator.alloc(i16, conv_w);
+        errdefer allocator.free(conv_alp_buf);
+        const conv_chrU_buf = try allocator.alloc(i16, conv_w);
+        errdefer allocator.free(conv_chrU_buf);
+        const conv_chrV_buf = try allocator.alloc(i16, conv_w);
+        errdefer allocator.free(conv_chrV_buf);
+
+        const v_lum_ptrs = try allocator.alloc([*]const i16, vLumFilter.filter_size + 2);
+        errdefer allocator.free(v_lum_ptrs);
+        const v_chrU_ptrs = try allocator.alloc([*]const i16, vChrFilter.filter_size + 2);
+        errdefer allocator.free(v_chrU_ptrs);
