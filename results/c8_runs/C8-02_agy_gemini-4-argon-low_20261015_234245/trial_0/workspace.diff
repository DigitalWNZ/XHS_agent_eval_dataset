+            .lum_ring = lum_ring,
+            .chrU_ring = chrU_ring,
+            .chrV_ring = chrV_ring,
+            .alp_ring = alp_ring,
+            .conv_lum_buf = conv_lum_buf,
+            .conv_alp_buf = conv_alp_buf,
+            .conv_chrU_buf = conv_chrU_buf,
+            .conv_chrV_buf = conv_chrV_buf,
+            .v_lum_ptrs = v_lum_ptrs,
+            .v_chrU_ptrs = v_chrU_ptrs,
+            .v_chrV_ptrs = v_chrV_ptrs,
+            .v_alp_ptrs = v_alp_ptrs,
+        };
+        return ctx;
+    }
+
+    pub fn deinit(self: *SwsContext) void {
+        const allocator = self.allocator;
+        self.hLumFilter.deinit(allocator);
+        self.hChrFilter.deinit(allocator);
+        self.vLumFilter.deinit(allocator);
+        self.vChrFilter.deinit(allocator);
+        self.yuv2rgb_tables.deinit(allocator);
+        self.lum_ring.deinit(allocator);
+        self.chrU_ring.deinit(allocator);
+        self.chrV_ring.deinit(allocator);
+        if (self.alp_ring) |*ar| ar.deinit(allocator);
+        allocator.free(self.conv_lum_buf);
+        allocator.free(self.conv_alp_buf);
+        allocator.free(self.conv_chrU_buf);
+        allocator.free(self.conv_chrV_buf);
+        allocator.free(self.v_lum_ptrs);
+        allocator.free(self.v_chrU_ptrs);
+        allocator.free(self.v_chrV_ptrs);
+        allocator.free(self.v_alp_ptrs);
+        allocator.destroy(self);
+    }
+
+    fn hscaleLumLine(
+        self: *SwsContext,
+        src_data: [*]const ?[*]const u8,
+        src_stride: [*]const c_int,
+        src_y: i32,
+    ) void {
+        const dst_line = self.lum_ring.getLine(src_y);
+        const s0 = src_data[0].?;
+        const offset: isize = @as(isize, src_y) * @as(isize, src_stride[0]);
+        const src_row: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s0))) + offset)));
+        const srcW: usize = @intCast(self.src_w);
+        const dstW: usize = @intCast(self.dst_w);
+
+        if (t.isAnyRGB(self.src_fmt)) {
+            if (self.src_fmt == t.PIXFMT_RGB24 and self.hLumFilter.filter_size == 1 and
+                srcW == dstW and self.hLumFilter.filter_pos[0] == 0 and self.hLumFilter.filter[0] == (1 << 14))
+            {
+                input_mod.rgb24ToY_15(dst_line, src_row, srcW);
+            } else {
+                switch (self.src_fmt) {
+                    t.PIXFMT_RGB24 => input_mod.rgb24ToY(self.conv_lum_buf.ptr, src_row, srcW),
+                    t.PIXFMT_BGR24 => input_mod.bgr24ToY(self.conv_lum_buf.ptr, src_row, srcW),
+                    t.PIXFMT_RGBA => input_mod.rgbaToY(self.conv_lum_buf.ptr, src_row, srcW),
+                    t.PIXFMT_BGRA => input_mod.bgraToY(self.conv_lum_buf.ptr, src_row, srcW),
+                    else => unreachable,
+                }
+                input_mod.hScale16To15(
+                    dst_line,
+                    dstW,
+                    @ptrCast(self.conv_lum_buf.ptr),
+                    self.hLumFilter.filter.ptr,
+                    self.hLumFilter.filter_pos.ptr,
+                    self.hLumFilter.filter_size,
+                );
+            }
+            if (self.need_alpha) {
+                const alp_line = self.alp_ring.?.getLine(src_y);
+                input_mod.rgbaToA(self.conv_alp_buf.ptr, src_row, srcW);
+                input_mod.hScale16To15(
+                    alp_line,
+                    dstW,
+                    @ptrCast(self.conv_alp_buf.ptr),
+                    self.hLumFilter.filter.ptr,
+                    self.hLumFilter.filter_pos.ptr,
+                    self.hLumFilter.filter_size,
+                );
+            }
+        } else {
+            input_mod.hScale8To15(
+                dst_line,
+                dstW,
+                src_row,
+                self.hLumFilter.filter.ptr,
+                self.hLumFilter.filter_pos.ptr,
+                self.hLumFilter.filter_size,
+            );
+        }
+
+        if (self.src_range != self.dst_range and !t.isAnyRGB(self.dst_fmt)) {
+            if (self.src_range) {
+                input_mod.lumRangeFromJpeg(dst_line, dstW);
+            } else {
+                input_mod.lumRangeToJpeg(dst_line, dstW);
+            }
+        }
+    }
+
+    fn hscaleChrLine(
+        self: *SwsContext,
+        src_data: [*]const ?[*]const u8,
+        src_stride: [*]const c_int,
+        chr_src_y: i32,
+    ) void {
+        if (!self.needs_hcscale) return;
+
+        const dstU_line = self.chrU_ring.getLine(chr_src_y);
+        const dstV_line = self.chrV_ring.getLine(chr_src_y);
+        const chrSrcW: usize = @intCast(self.chrSrcW);
+        const chrDstW: usize = @intCast(self.chrDstW);
+
+        if (t.isAnyRGB(self.src_fmt)) {
+            const s0 = src_data[0].?;
+            const offset: isize = @as(isize, chr_src_y) * @as(isize, src_stride[0]);
+            const src_row: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s0))) + offset)));
+
+            if (self.src_fmt == t.PIXFMT_RGB24 and self.chrSrcHSubSample != 0 and
+                self.hChrFilter.filter_size == 1 and chrSrcW == chrDstW and
+                self.hChrFilter.filter_pos[0] == 0 and self.hChrFilter.filter[0] == (1 << 14))
+            {
+                input_mod.rgb24ToUVHalf_15(dstU_line, dstV_line, src_row, chrSrcW);
+            } else {
+                if (self.chrSrcHSubSample != 0) {
+                    switch (self.src_fmt) {
+                        t.PIXFMT_RGB24 => input_mod.rgb24ToUVHalf(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        t.PIXFMT_BGR24 => input_mod.bgr24ToUVHalf(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        t.PIXFMT_RGBA => input_mod.rgbaToUVHalf(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        t.PIXFMT_BGRA => input_mod.bgraToUVHalf(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        else => unreachable,
+                    }
+                } else {
+                    switch (self.src_fmt) {
+                        t.PIXFMT_RGB24 => input_mod.rgb24ToUV(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        t.PIXFMT_BGR24 => input_mod.bgr24ToUV(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        t.PIXFMT_RGBA => input_mod.rgbaToUV(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        t.PIXFMT_BGRA => input_mod.bgraToUV(self.conv_chrU_buf.ptr, self.conv_chrV_buf.ptr, src_row, chrSrcW),
+                        else => unreachable,
+                    }
+                }
+                input_mod.hScale16To15(
+                    dstU_line,
+                    chrDstW,
+                    @ptrCast(self.conv_chrU_buf.ptr),
+                    self.hChrFilter.filter.ptr,
+                    self.hChrFilter.filter_pos.ptr,
+                    self.hChrFilter.filter_size,
+                );
+                input_mod.hScale16To15(
+                    dstV_line,
+                    chrDstW,
+                    @ptrCast(self.conv_chrV_buf.ptr),
+                    self.hChrFilter.filter.ptr,
+                    self.hChrFilter.filter_pos.ptr,
+                    self.hChrFilter.filter_size,
+                );
+            }
+        } else if (t.isSemiPlanarYUV(self.src_fmt)) {
+            const s1 = src_data[1].?;
+            const offset: isize = @as(isize, chr_src_y) * @as(isize, src_stride[1]);
+            const src_row: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s1))) + offset)));
+            const u_buf: [*]u8 = @ptrCast(self.conv_chrU_buf.ptr);
+            const v_buf: [*]u8 = @ptrCast(self.conv_chrV_buf.ptr);
+            if (self.src_fmt == t.PIXFMT_NV12) {
+                input_mod.nv12ToUV(u_buf, v_buf, src_row, chrSrcW);
+            } else {
+                input_mod.nv21ToUV(u_buf, v_buf, src_row, chrSrcW);
+            }
+            input_mod.hScale8To15(
+                dstU_line,
+                chrDstW,
+                u_buf,
+                self.hChrFilter.filter.ptr,
+                self.hChrFilter.filter_pos.ptr,
+                self.hChrFilter.filter_size,
+            );
+            input_mod.hScale8To15(
+                dstV_line,
+                chrDstW,
+                v_buf,
+                self.hChrFilter.filter.ptr,
+                self.hChrFilter.filter_pos.ptr,
+                self.hChrFilter.filter_size,
+            );
+        } else {
+            // Planar YUV (420P, 422P, 444P)
+            const s1 = src_data[1].?;
+            const s2 = src_data[2].?;
+            const off1: isize = @as(isize, chr_src_y) * @as(isize, src_stride[1]);
+            const off2: isize = @as(isize, chr_src_y) * @as(isize, src_stride[2]);
+            const srcU: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s1))) + off1)));
+            const srcV: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(s2))) + off2)));
+
+            input_mod.hScale8To15(
+                dstU_line,
+                chrDstW,
+                srcU,
+                self.hChrFilter.filter.ptr,
+                self.hChrFilter.filter_pos.ptr,
+                self.hChrFilter.filter_size,
+            );
+            input_mod.hScale8To15(
+                dstV_line,
+                chrDstW,
+                srcV,
+                self.hChrFilter.filter.ptr,
+                self.hChrFilter.filter_pos.ptr,
+                self.hChrFilter.filter_size,
+            );
+        }
+    }
+
+    pub fn processGeneral(
+        self: *SwsContext,
+        src_data: [*]const ?[*]const u8,
+        src_stride: [*]const c_int,
+        dst_data: [*]const ?[*]u8,
+        dst_stride: [*]const c_int,
+    ) void {
+        const dstW: usize = @intCast(self.dst_w);
+        const dstH: usize = @intCast(self.dst_h);
+
+        // Unscaled special converters
+        if (self.src_w == self.dst_w and self.src_h == self.dst_h) {
+            if ((self.src_fmt == t.PIXFMT_YUV420P or self.src_fmt == t.PIXFMT_YUV422P) and
+                t.isAnyRGB(self.dst_fmt) and (dstH & 1) == 0 and (dstW & 1) == 0)
+            {
+                unscaled_mod.unscaledYuvToRgb(&self.yuv2rgb_tables, src_data, src_stride, dst_data, dst_stride, dstW, dstH, self.src_fmt, self.dst_fmt);
+                return;
+            }
+            if (self.src_fmt == t.PIXFMT_BGR24 and self.dst_fmt == t.PIXFMT_YUV420P and (dstW & 1) == 0 and (dstH & 1) == 0) {
+                unscaled_mod.unscaledBgr24ToYuv420p(src_data, src_stride, dst_data, dst_stride, dstW, dstH);
+                return;
+            }
+            if (t.isAnyRGB(self.src_fmt) and t.isAnyRGB(self.dst_fmt)) {
+                unscaled_mod.unscaledRgbToRgb(src_data, src_stride, dst_data, dst_stride, dstW, dstH, self.src_fmt, self.dst_fmt);
+                return;
+            }
+        }
+        const chrDstW: usize = @intCast(self.chrDstW);
+        const vLumFilterSize = self.vLumFilter.filter_size;
+        const vChrFilterSize = self.vChrFilter.filter_size;
+
+        var lastInLumBuf: i32 = -1;
+        var lastInChrBuf: i32 = -1;
+
+        for (0..dstH) |dstY_usize| {
+            const dstY: i32 = @intCast(dstY_usize);
+            const chrDstY: i32 = dstY >> @intCast(self.chrDstVSubSample);
+            const chrDstY_usize: usize = @intCast(chrDstY);
+
+            const firstLumSrcY: i32 = @max(1 - @as(i32, @intCast(vLumFilterSize)), self.vLumFilter.filter_pos[dstY_usize]);
+            const dstY_paired: usize = @intCast(@min(dstY | ((@as(i32, 1) << @intCast(self.chrDstVSubSample)) - 1), self.dst_h - 1));
+            const firstLumSrcY2: i32 = @max(1 - @as(i32, @intCast(vLumFilterSize)), self.vLumFilter.filter_pos[dstY_paired]);
+            const firstChrSrcY: i32 = @max(1 - @as(i32, @intCast(vChrFilterSize)), self.vChrFilter.filter_pos[chrDstY_usize]);
+
+            const lastLumSrcY: i32 = @min(self.src_h, firstLumSrcY + @as(i32, @intCast(vLumFilterSize))) - 1;
+            _ = firstLumSrcY2;
+            const lastChrSrcY: i32 = @min(self.chrSrcH, firstChrSrcY + @as(i32, @intCast(vChrFilterSize))) - 1;
+
+            if (firstLumSrcY > lastInLumBuf) {
+                lastInLumBuf = firstLumSrcY - 1;
+            }
+            if (firstChrSrcY > lastInChrBuf) {
+                lastInChrBuf = firstChrSrcY - 1;
+            }
+
+            while (lastInLumBuf < lastLumSrcY) {
+                lastInLumBuf += 1;
+                self.hscaleLumLine(src_data, src_stride, lastInLumBuf);
+            }
+            while (lastInChrBuf < lastChrSrcY) {
+                lastInChrBuf += 1;
+                self.hscaleChrLine(src_data, src_stride, lastInChrBuf);
+            }
+
+            // Prepare vertical filter source pointers
+            for (0..vLumFilterSize) |j| {
+                const sy = firstLumSrcY + @as(i32, @intCast(j));
+                self.v_lum_ptrs[j] = self.lum_ring.getLine(sy);
+                if (self.need_alpha) {
+                    self.v_alp_ptrs[j] = self.alp_ring.?.getLine(sy);
+                }
+            }
+            if (self.needs_hcscale) {
+                for (0..vChrFilterSize) |j| {
+                    const cy = firstChrSrcY + @as(i32, @intCast(j));
+                    self.v_chrU_ptrs[j] = self.chrU_ring.getLine(cy);
+                    self.v_chrV_ptrs[j] = self.chrV_ring.getLine(cy);
+                }
+            } else {
+                // Gray input -> fill U/V lines with 128<<7 = 16384 (already initialized in ring buffer!)
+                for (0..vChrFilterSize) |j| {
+                    self.v_chrU_ptrs[j] = self.chrU_ring.lines[0];
+                    self.v_chrV_ptrs[j] = self.chrV_ring.lines[0];
+                }
+            }
+            // Ensure 2-tap pointers exist for yuv2packed1
+            if (vChrFilterSize == 1) {
+                self.v_chrU_ptrs[1] = self.v_chrU_ptrs[0];
+                self.v_chrV_ptrs[1] = self.v_chrV_ptrs[0];
+            }
+
+            const lumFilter = self.vLumFilter.filter.ptr + dstY_usize * vLumFilterSize;
+            const chrFilter = self.vChrFilter.filter.ptr + chrDstY_usize * vChrFilterSize;
+
+            if (t.isPlanarYUV(self.dst_fmt) or t.isGray(self.dst_fmt)) {
+                // Luma output
+                const d0 = dst_data[0].?;
+                const dst_off0: isize = @as(isize, dstY) * @as(isize, dst_stride[0]);
+                const dst_row0: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(d0))) + dst_off0)));
+                const lumDither = &t.SWS_PB_64;
+
+                if (vLumFilterSize == 1) {
+                    output_mod.yuv2plane1_8(self.v_lum_ptrs[0], dst_row0, dstW, lumDither, 0);
+                } else {
+                    output_mod.yuv2planeX_8(lumFilter, vLumFilterSize, self.v_lum_ptrs.ptr, dst_row0, dstW, lumDither, 0);
+                }
+
+                // Chroma output
+                if (!t.isGray(self.dst_fmt)) {
+                    const chrSkipMask: i32 = (@as(i32, 1) << @intCast(self.chrDstVSubSample)) - 1;
+                    if ((dstY & chrSkipMask) == 0) {
+                        const chrDither = &t.SWS_PB_64;
+                        if (t.isSemiPlanarYUV(self.dst_fmt)) {
+                            const d1 = dst_data[1].?;
+                            const dst_off1: isize = @as(isize, chrDstY) * @as(isize, dst_stride[1]);
+                            const dst_row1: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(d1))) + dst_off1)));
+                            output_mod.yuv2nv12cX(
+                                self.dst_fmt,
+                                chrDither,
+                                chrFilter,
+                                vChrFilterSize,
+                                self.v_chrU_ptrs.ptr,
+                                self.v_chrV_ptrs.ptr,
+                                dst_row1,
+                                chrDstW,
+                            );
+                        } else {
+                            const d1 = dst_data[1].?;
+                            const d2 = dst_data[2].?;
+                            const dst_off1: isize = @as(isize, chrDstY) * @as(isize, dst_stride[1]);
+                            const dst_off2: isize = @as(isize, chrDstY) * @as(isize, dst_stride[2]);
+                            const dst_row1: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(d1))) + dst_off1)));
+                            const dst_row2: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(d2))) + dst_off2)));
+
+                            if (vChrFilterSize == 1) {
+                                output_mod.yuv2plane1_8(self.v_chrU_ptrs[0], dst_row1, chrDstW, chrDither, 0);
+                                output_mod.yuv2plane1_8(self.v_chrV_ptrs[0], dst_row2, chrDstW, chrDither, 3);
+                            } else {
+                                output_mod.yuv2planeX_8(chrFilter, vChrFilterSize, self.v_chrU_ptrs.ptr, dst_row1, chrDstW, chrDither, 0);
+                                output_mod.yuv2planeX_8(chrFilter, vChrFilterSize, self.v_chrV_ptrs.ptr, dst_row2, chrDstW, chrDither, 3);
+                            }
+                        }
+                    }
+                }
+            } else {
+                // Packed RGB output
+                const d0 = dst_data[0].?;
+                const dst_off0: isize = @as(isize, dstY) * @as(isize, dst_stride[0]);
+                const dst_row0: [*]u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(d0))) + dst_off0)));
+
+                if (vLumFilterSize == 1 and vChrFilterSize == 1) {
+                    const ubuf = [2][*]const i16{ self.v_chrU_ptrs[0], self.v_chrU_ptrs[1] };
+                    const vbuf = [2][*]const i16{ self.v_chrV_ptrs[0], self.v_chrV_ptrs[1] };
+                    const abuf0: ?[*]const i16 = if (self.need_alpha) self.v_alp_ptrs[0] else null;
+                    if (self.full_chr_h_int) {
+                        output_mod.yuv2rgb_full_1(&self.yuv2rgb_tables, self.v_lum_ptrs[0], ubuf, vbuf, abuf0, dst_row0, dstW, 0, self.dst_fmt, self.need_alpha);
+                    } else {
+                        output_mod.yuv2rgb_1(&self.yuv2rgb_tables, self.v_lum_ptrs[0], ubuf, vbuf, abuf0, dst_row0, dstW, 0, self.dst_fmt, self.need_alpha);
+                    }
+                } else if (vLumFilterSize == 1 and vChrFilterSize == 2 and
+                    (@as(i32, chrFilter[0]) + @as(i32, chrFilter[1]) == 4096) and
+                    chrFilter[1] >= 0 and chrFilter[1] <= 4096)
+                {
+                    const chrAlpha: i32 = chrFilter[1];
+                    const ubuf = [2][*]const i16{ self.v_chrU_ptrs[0], self.v_chrU_ptrs[1] };
+                    const vbuf = [2][*]const i16{ self.v_chrV_ptrs[0], self.v_chrV_ptrs[1] };
+                    const abuf0: ?[*]const i16 = if (self.need_alpha) self.v_alp_ptrs[0] else null;
+                    if (self.full_chr_h_int) {
+                        output_mod.yuv2rgb_full_1(&self.yuv2rgb_tables, self.v_lum_ptrs[0], ubuf, vbuf, abuf0, dst_row0, dstW, chrAlpha, self.dst_fmt, self.need_alpha);
+                    } else {
+                        output_mod.yuv2rgb_1(&self.yuv2rgb_tables, self.v_lum_ptrs[0], ubuf, vbuf, abuf0, dst_row0, dstW, chrAlpha, self.dst_fmt, self.need_alpha);
+                    }
+                } else if (vLumFilterSize == 2 and vChrFilterSize == 2 and
+                    (@as(i32, lumFilter[0]) + @as(i32, lumFilter[1]) == 4096) and
+                    lumFilter[1] >= 0 and lumFilter[1] <= 4096 and
+                    (@as(i32, chrFilter[0]) + @as(i32, chrFilter[1]) == 4096) and
+                    chrFilter[1] >= 0 and chrFilter[1] <= 4096)
+                {
+                    const lumAlpha: i32 = lumFilter[1];
+                    const chrAlpha: i32 = chrFilter[1];
+                    const buf = [2][*]const i16{ self.v_lum_ptrs[0], self.v_lum_ptrs[1] };
+                    const ubuf = [2][*]const i16{ self.v_chrU_ptrs[0], self.v_chrU_ptrs[1] };
+                    const vbuf = [2][*]const i16{ self.v_chrV_ptrs[0], self.v_chrV_ptrs[1] };
+                    const abuf = [2]?[*]const i16{
+                        if (self.need_alpha) self.v_alp_ptrs[0] else null,
+                        if (self.need_alpha) self.v_alp_ptrs[1] else null,
+                    };
+                    if (self.full_chr_h_int) {
+                        output_mod.yuv2rgb_full_2(&self.yuv2rgb_tables, buf, ubuf, vbuf, abuf, dst_row0, dstW, lumAlpha, chrAlpha, self.dst_fmt, self.need_alpha);
+                    } else {
+                        output_mod.yuv2rgb_2(&self.yuv2rgb_tables, buf, ubuf, vbuf, abuf, dst_row0, dstW, lumAlpha, chrAlpha, self.dst_fmt, self.need_alpha);
+                    }
+                } else {
+                    const alp_ptrs: ?[*]const [*]const i16 = if (self.need_alpha) self.v_alp_ptrs.ptr else null;
+                    if (self.full_chr_h_int) {
+                        output_mod.yuv2rgb_full_X(
+                            &self.yuv2rgb_tables,
+                            lumFilter,
+                            self.v_lum_ptrs.ptr,
+                            vLumFilterSize,
+                            chrFilter,
+                            self.v_chrU_ptrs.ptr,
+                            self.v_chrV_ptrs.ptr,
+                            vChrFilterSize,
+                            alp_ptrs,
+                            dst_row0,
+                            dstW,
+                            self.dst_fmt,
+                            self.need_alpha,
+                        );
+                    } else {
+                        output_mod.yuv2rgb_X(
+                            &self.yuv2rgb_tables,
+                            lumFilter,
+                            self.v_lum_ptrs.ptr,
+                            vLumFilterSize,
+                            chrFilter,
+                            self.v_chrU_ptrs.ptr,
+                            self.v_chrV_ptrs.ptr,
+                            vChrFilterSize,
+                            alp_ptrs,
+                            dst_row0,
+                            dstW,
+                            self.dst_fmt,
+                            self.need_alpha,
+                        );
+                    }
+                }
+            }
+        }
+    }
+};
diff --git a/swscale-impl/src/tables.zig b/swscale-impl/src/tables.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/tables.zig
@@ -0,0 +1,135 @@
+const std = @import("std");
+
+pub const PIXFMT_YUV420P = 0;
+pub const PIXFMT_YUV422P = 1;
+pub const PIXFMT_YUV444P = 2;
+pub const PIXFMT_NV12 = 3;
+pub const PIXFMT_NV21 = 4;
+pub const PIXFMT_RGB24 = 5;
+pub const PIXFMT_BGR24 = 6;
+pub const PIXFMT_RGBA = 7;
+pub const PIXFMT_BGRA = 8;
+pub const PIXFMT_GRAY8 = 9;
+
+pub const ALGO_NEAREST = 0;
+pub const ALGO_BILINEAR = 1;
+pub const ALGO_BICUBIC = 2;
+
+pub fn isPlanarYUV(fmt: c_int) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P or fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+pub fn isSemiPlanarYUV(fmt: c_int) bool {
+    return fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+pub fn isAnyRGB(fmt: c_int) bool {
+    return fmt == PIXFMT_RGB24 or fmt == PIXFMT_BGR24 or fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+pub fn isGray(fmt: c_int) bool {
+    return fmt == PIXFMT_GRAY8;
+}
+
+pub fn isALPHA(fmt: c_int) bool {
+    return fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+pub fn isPacked(fmt: c_int) bool {
+    return isAnyRGB(fmt);
+}
+
+pub fn getChromaSubSample(fmt: c_int, h_sub: *c_int, v_sub: *c_int) void {
+    switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => {
+            h_sub.* = 1;
+            v_sub.* = 1;
+        },
+        PIXFMT_YUV422P => {
+            h_sub.* = 1;
+            v_sub.* = 0;
+        },
+        else => {
+            h_sub.* = 0;
+            v_sub.* = 0;
+        },
+    }
+}
+
+pub fn getBitsPerPixel(fmt: c_int) c_int {
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => 12,
+        PIXFMT_YUV422P => 16,
+        PIXFMT_YUV444P, PIXFMT_RGB24, PIXFMT_BGR24 => 24,
+        PIXFMT_RGBA, PIXFMT_BGRA => 32,
+        PIXFMT_GRAY8 => 8,
+        else => 0,
+    };
+}
+
+pub fn ceilRshift(a: c_int, b: c_int) c_int {
+    const shift: u5 = @intCast(b);
+    return -((-a) >> shift);
+}
+
+// Color space conversion coefficients for SWS_CS_DEFAULT (5):
+// { 104597, 132201, 25675, 53279 }
+pub const YUV2RGB_COEFFS_DEFAULT = [4]c_int{ 104597, 132201, 25675, 53279 };
+
+pub const RY_IDX = 0;
+pub const GY_IDX = 1;
+pub const BY_IDX = 2;
+pub const RU_IDX = 3;
+pub const GU_IDX = 4;
+pub const BU_IDX = 5;
+pub const RV_IDX = 6;
+pub const GV_IDX = 7;
+pub const BV_IDX = 8;
+pub const RGB2YUV_SHIFT = 15;
+
+// Precomputed input_rgb2yuv_table for SWS_CS_DEFAULT and dstRange = 0
+pub const INPUT_RGB2YUV_TABLE = [9]i32{
+    @intFromFloat(0.299 * 219.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5), // RY: 8414
+    @intFromFloat(0.587 * 219.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5), // GY: 16519
+    @intFromFloat(0.114 * 219.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5), // BY: 3208
+    -@as(i32, @intFromFloat(0.169 * 224.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5)), // RU: -4865
+    -@as(i32, @intFromFloat(0.331 * 224.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5)), // GU: -9528
+    @intFromFloat(0.500 * 224.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5), // BU: 14392
+    @intFromFloat(0.500 * 224.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5), // RV: 14392
+    -@as(i32, @intFromFloat(0.419 * 224.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5)), // GV: -12061
+    -@as(i32, @intFromFloat(0.081 * 224.0 / 255.0 * @as(f64, @floatFromInt(1 << RGB2YUV_SHIFT)) + 0.5)), // BV: -2332
+};
+
+pub const YUVRGB_TABLE_HEADROOM = 512;
+pub const YUVRGB_TABLE_LUMA_HEADROOM = 512;
+
+pub const DITHER_8X8_128 = [9][8]u8{
+    .{ 36, 68, 60, 92, 34, 66, 58, 90 },
+    .{ 100, 4, 124, 28, 98, 2, 122, 26 },
+    .{ 52, 84, 44, 76, 50, 82, 42, 74 },
+    .{ 116, 20, 108, 12, 114, 18, 106, 10 },
+    .{ 32, 64, 56, 88, 38, 70, 62, 94 },
+    .{ 96, 0, 120, 24, 102, 6, 126, 30 },
+    .{ 48, 80, 40, 72, 54, 86, 46, 78 },
+    .{ 112, 16, 104, 8, 118, 22, 110, 14 },
+    .{ 36, 68, 60, 92, 34, 66, 58, 90 },
+};
+
+pub const SWS_PB_64 = [8]u8{ 64, 64, 64, 64, 64, 64, 64, 64 };
+
+pub inline fn clipUint8(a: i32) u8 {
+    if ((a & (~@as(i32, 0xFF))) != 0) {
+        return @intCast((-a) >> 31);
+    } else {
+        return @intCast(a);
+    }
+}
+
+pub inline fn clipUintp2(a: i32, p: u5) u32 {
+    const mask: i32 = (@as(i32, 1) << p) - 1;
+    if ((a & ~mask) != 0) {
+        return @intCast(((-a) >> 31) & mask);
+    } else {
+        return @intCast(a);
+    }
+}
diff --git a/swscale-impl/src/unscaled.zig b/swscale-impl/src/unscaled.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/unscaled.zig
@@ -0,0 +1,752 @@
+const std = @import("std");
+const t = @import("tables.zig");
+const yuv2rgb = @import("yuv2rgb.zig");
+
+const V16i16 = @Vector(16, i16);
+const V8i16 = @Vector(8, i16);
+const V8i32 = @Vector(8, i32);
+const V16u8 = @Vector(16, u8);
+const V32u8 = @Vector(32, u8);
+
+inline fn clipU8Vec16(v: V16i16) V16u8 {
+    const zero: V16i16 = @splat(0);
+    const max255: V16i16 = @splat(255);
+    const clamped = @min(@max(v, zero), max255);
+    return @intCast(clamped);
+}
+
+pub fn unscaledYuvToRgb(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    width: usize,
+    height: usize,
+    src_fmt: c_int,
+    dst_fmt: c_int,
+) void {
+    const s0 = src_data[0].?;
+    const s1 = src_data[1].?;
+    const s2 = src_data[2].?;
+    const d0 = dst_data[0].?;
+    const yuv422 = (src_fmt == t.PIXFMT_YUV422P);
+
+    // SIMD path for YUV420P -> RGB24/BGR24/RGBA/BGRA (standard range)
+    // In FFmpeg:
+    // y_val = 9535 * (Y - 16) + 4096
+    // r = (y_val + 13074 * (V - 128)) >> 13
