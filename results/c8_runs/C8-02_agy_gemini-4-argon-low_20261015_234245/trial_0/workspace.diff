+pub fn yuv2rgb_X(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    lumFilter: [*]const i16,
+    lumSrc: [*]const [*]const i16,
+    lumFilterSize: usize,
+    chrFilter: [*]const i16,
+    chrUSrc: [*]const [*]const i16,
+    chrVSrc: [*]const [*]const i16,
+    chrFilterSize: usize,
+    alpSrc: ?[*]const [*]const i16,
+    dest: [*]u8,
+    dstW: usize,
+    target: c_int,
+    hasAlpha: bool,
+) void {
+    const halfW = (dstW + 1) >> 1;
+    const is_std_range = (tables.yuv2rgb_y_offset != 0);
+    const bpp_pair: usize = if (target == t.PIXFMT_RGBA or target == t.PIXFMT_BGRA) 8 else 6;
+
+    var i: usize = 0;
+    if (is_std_range and (dstW & 1) == 0) {
+        if (lumFilterSize == 4 and chrFilterSize == 4) {
+            const fl0: V16i32 = @splat(@as(i32, lumFilter[0]));
+            const fl1: V16i32 = @splat(@as(i32, lumFilter[1]));
+            const fl2: V16i32 = @splat(@as(i32, lumFilter[2]));
+            const fl3: V16i32 = @splat(@as(i32, lumFilter[3]));
+            const fc0: V8i32 = @splat(@as(i32, chrFilter[0]));
+            const fc1: V8i32 = @splat(@as(i32, chrFilter[1]));
+            const fc2: V8i32 = @splat(@as(i32, chrFilter[2]));
+            const fc3: V8i32 = @splat(@as(i32, chrFilter[3]));
+            const l0 = lumSrc[0];
+            const l1 = lumSrc[1];
+            const l2 = lumSrc[2];
+            const l3 = lumSrc[3];
+            const cu0 = chrUSrc[0];
+            const cu1 = chrUSrc[1];
+            const cu2 = chrUSrc[2];
+            const cu3 = chrUSrc[3];
+            const cv0 = chrVSrc[0];
+            const cv1 = chrVSrc[1];
+            const cv2 = chrVSrc[2];
+            const cv3 = chrVSrc[3];
+            const rnd16: V16i32 = @splat(1 << 18);
+            const rnd8: V8i32 = @splat(1 << 18);
+
+            while (i + 8 <= halfW) : (i += 8) {
+                const y_v = (rnd16 +
+                    @as(V16i32, @intCast(@as(V16i16, l0[2 * i ..][0..16].*))) * fl0 +
+                    @as(V16i32, @intCast(@as(V16i16, l1[2 * i ..][0..16].*))) * fl1 +
+                    @as(V16i32, @intCast(@as(V16i16, l2[2 * i ..][0..16].*))) * fl2 +
+                    @as(V16i32, @intCast(@as(V16i16, l3[2 * i ..][0..16].*))) * fl3) >> @splat(19);
+                const u_v = (rnd8 +
+                    @as(V8i32, @intCast(@as(V8i16, cu0[i..][0..8].*))) * fc0 +
+                    @as(V8i32, @intCast(@as(V8i16, cu1[i..][0..8].*))) * fc1 +
+                    @as(V8i32, @intCast(@as(V8i16, cu2[i..][0..8].*))) * fc2 +
+                    @as(V8i32, @intCast(@as(V8i16, cu3[i..][0..8].*))) * fc3) >> @splat(19);
+                const v_v = (rnd8 +
+                    @as(V8i32, @intCast(@as(V8i16, cv0[i..][0..8].*))) * fc0 +
+                    @as(V8i32, @intCast(@as(V8i16, cv1[i..][0..8].*))) * fc1 +
+                    @as(V8i32, @intCast(@as(V8i16, cv2[i..][0..8].*))) * fc2 +
+                    @as(V8i32, @intCast(@as(V8i16, cv3[i..][0..8].*))) * fc3) >> @splat(19);
+
+                var a_v: V16u8 = @splat(255);
+                if (hasAlpha) {
+                    const asrc = alpSrc.?;
+                    const a_i32 = rnd16 +
+                        @as(V16i32, @intCast(@as(V16i16, asrc[0][2 * i ..][0..16].*))) * fl0 +
+                        @as(V16i32, @intCast(@as(V16i16, asrc[1][2 * i ..][0..16].*))) * fl1 +
+                        @as(V16i32, @intCast(@as(V16i16, asrc[2][2 * i ..][0..16].*))) * fl2 +
+                        @as(V16i32, @intCast(@as(V16i16, asrc[3][2 * i ..][0..16].*))) * fl3;
+                    a_v = clipU8Vec16_i32(a_i32 >> @splat(19));
+                }
+                yuv2rgbVec16_std(y_v, u_v, v_v, a_v, dest + i * bpp_pair, target, hasAlpha);
+            }
+        } else {
+            while (i + 8 <= halfW) : (i += 8) {
+                var y_v: V16i32 = @splat(1 << 18);
+                var u_v: V8i32 = @splat(1 << 18);
+                var v_v: V8i32 = @splat(1 << 18);
+
+                for (0..lumFilterSize) |j| {
+                    const fl: V16i32 = @splat(@as(i32, lumFilter[j]));
+                    const yl: V16i32 = @intCast(@as(V16i16, lumSrc[j][2 * i ..][0..16].*));
+                    y_v += yl * fl;
+                }
+                for (0..chrFilterSize) |j| {
+                    const fc: V8i32 = @splat(@as(i32, chrFilter[j]));
+                    const ul: V8i32 = @intCast(@as(V8i16, chrUSrc[j][i..][0..8].*));
+                    const vl: V8i32 = @intCast(@as(V8i16, chrVSrc[j][i..][0..8].*));
+                    u_v += ul * fc;
+                    v_v += vl * fc;
+                }
+                y_v >>= @splat(19);
+                u_v >>= @splat(19);
+                v_v >>= @splat(19);
+
+                var a_v: V16u8 = @splat(255);
+                if (hasAlpha) {
+                    const asrc = alpSrc.?;
+                    var a_i32: V16i32 = @splat(1 << 18);
+                    for (0..lumFilterSize) |j| {
+                        const fl: V16i32 = @splat(@as(i32, lumFilter[j]));
+                        const al: V16i32 = @intCast(@as(V16i16, asrc[j][2 * i ..][0..16].*));
+                        a_i32 += al * fl;
+                    }
+                    a_v = clipU8Vec16_i32(a_i32 >> @splat(19));
+                }
+                yuv2rgbVec16_std(y_v, u_v, v_v, a_v, dest + i * bpp_pair, target, hasAlpha);
+            }
+        }
+    }
+    while (i < halfW) : (i += 1) {
+        var Y1: i32 = 1 << 18;
+        var Y2: i32 = 1 << 18;
+        var U: i32 = 1 << 18;
+        var V: i32 = 1 << 18;
+
+        for (0..lumFilterSize) |j| {
+            Y1 += @as(i32, lumSrc[j][i * 2]) * @as(i32, lumFilter[j]);
+            Y2 += @as(i32, lumSrc[j][i * 2 + 1]) * @as(i32, lumFilter[j]);
+        }
+        for (0..chrFilterSize) |j| {
+            U += @as(i32, chrUSrc[j][i]) * @as(i32, chrFilter[j]);
+            V += @as(i32, chrVSrc[j][i]) * @as(i32, chrFilter[j]);
+        }
+        Y1 >>= 19;
+        Y2 >>= 19;
+        U >>= 19;
+        V >>= 19;
+
+        var A1: u32 = 0;
+        var A2: u32 = 0;
+        if (hasAlpha) {
+            const asrc = alpSrc.?;
+            var a1_i32: i32 = 1 << 18;
+            var a2_i32: i32 = 1 << 18;
+            for (0..lumFilterSize) |j| {
+                a1_i32 += @as(i32, asrc[j][i * 2]) * @as(i32, lumFilter[j]);
+                a2_i32 += @as(i32, asrc[j][i * 2 + 1]) * @as(i32, lumFilter[j]);
+            }
+            a1_i32 >>= 19;
+            a2_i32 >>= 19;
+            if (((a1_i32 | a2_i32) & 0x100) != 0) {
+                a1_i32 = t.clipUint8(a1_i32);
+                a2_i32 = t.clipUint8(a2_i32);
+            }
+            A1 = @intCast(a1_i32);
+            A2 = @intCast(a2_i32);
+        }
+
+        const u_idx: usize = @intCast(U + t.YUVRGB_TABLE_HEADROOM);
+        const v_idx: usize = @intCast(V + t.YUVRGB_TABLE_HEADROOM);
+        const r_ptr = tables.table_rV[v_idx];
+        const g_ptr: [*]const u8 = @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(tables.table_gU[u_idx]))) + tables.table_gV[v_idx])));
+        const b_ptr = tables.table_bU[u_idx];
+
+        yuv2rgbWrite(dest, i, Y1, Y2, A1, A2, r_ptr, g_ptr, b_ptr, target, hasAlpha);
+    }
+}
+
+inline fn yuv2rgbWriteFull(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    dest: [*]u8,
+    Y_in: i32,
+    A: u8,
+    U: i32,
+    V: i32,
+    target: c_int,
+    hasAlpha: bool,
+) void {
+    var Y = Y_in - tables.yuv2rgb_y_offset;
+    Y *= tables.yuv2rgb_y_coeff;
+    Y += 1 << 21;
+
+    var R: i32 = @bitCast(@as(u32, @bitCast(Y)) +% @as(u32, @bitCast(V * tables.yuv2rgb_v2r_coeff)));
+    var G: i32 = @bitCast(@as(u32, @bitCast(Y)) +% @as(u32, @bitCast(V * tables.yuv2rgb_v2g_coeff)) +% @as(u32, @bitCast(U * tables.yuv2rgb_u2g_coeff)));
+    var B: i32 = @bitCast(@as(u32, @bitCast(Y)) +% @as(u32, @bitCast(U * tables.yuv2rgb_u2b_coeff)));
+
+    if (((R | G | B) & @as(i32, @bitCast(@as(u32, 0xC0000000)))) != 0) {
+        R = @intCast(t.clipUintp2(R, 30));
+        G = @intCast(t.clipUintp2(G, 30));
+        B = @intCast(t.clipUintp2(B, 30));
+    }
+
+    switch (target) {
+        t.PIXFMT_RGB24 => {
+            dest[0] = @intCast(R >> 22);
+            dest[1] = @intCast(G >> 22);
+            dest[2] = @intCast(B >> 22);
+        },
+        t.PIXFMT_RGBA => {
+            dest[0] = @intCast(R >> 22);
+            dest[1] = @intCast(G >> 22);
+            dest[2] = @intCast(B >> 22);
+            dest[3] = if (hasAlpha) A else 255;
+        },
+        t.PIXFMT_BGR24 => {
+            dest[0] = @intCast(B >> 22);
+            dest[1] = @intCast(G >> 22);
+            dest[2] = @intCast(R >> 22);
+        },
+        t.PIXFMT_BGRA => {
+            dest[0] = @intCast(B >> 22);
+            dest[1] = @intCast(G >> 22);
+            dest[2] = @intCast(R >> 22);
+            dest[3] = if (hasAlpha) A else 255;
+        },
+        else => unreachable,
+    }
+}
+
+pub fn yuv2rgb_full_1(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    buf0: [*]const i16,
+    ubuf: [2][*]const i16,
+    vbuf: [2][*]const i16,
+    abuf0: ?[*]const i16,
+    dest_in: [*]u8,
+    dstW: usize,
+    uvalpha: i32,
+    target: c_int,
+    hasAlpha: bool,
+) void {
+    const ubuf0 = ubuf[0];
+    const vbuf0 = vbuf[0];
+    const step: usize = if (target == t.PIXFMT_RGB24 or target == t.PIXFMT_BGR24) 3 else 4;
+    var dest = dest_in;
+
+    if (uvalpha < 2048) {
+        for (0..dstW) |i| {
+            const Y: i32 = @as(i32, buf0[i]) * 4;
+            const U: i32 = (@as(i32, ubuf0[i]) - (128 << 7)) * 4;
+            const V: i32 = (@as(i32, vbuf0[i]) - (128 << 7)) * 4;
+            var A: u8 = 0;
+            if (hasAlpha) {
+                var a_i32: i32 = (@as(i32, abuf0.?[i]) + 64) >> 7;
+                if ((a_i32 & 0x100) != 0) a_i32 = t.clipUint8(a_i32);
+                A = @intCast(a_i32);
+            }
+            yuv2rgbWriteFull(tables, dest, Y, A, U, V, target, hasAlpha);
+            dest += step;
+        }
+    } else {
+        const ubuf1 = ubuf[1];
+        const vbuf1 = vbuf[1];
+        for (0..dstW) |i| {
+            const Y: i32 = @as(i32, buf0[i]) * 4;
+            const U: i32 = (@as(i32, ubuf0[i]) + @as(i32, ubuf1[i]) - (128 << 8)) * 2;
+            const V: i32 = (@as(i32, vbuf0[i]) + @as(i32, vbuf1[i]) - (128 << 8)) * 2;
+            var A: u8 = 0;
+            if (hasAlpha) {
+                var a_i32: i32 = (@as(i32, abuf0.?[i]) + 64) >> 7;
+                if ((a_i32 & 0x100) != 0) a_i32 = t.clipUint8(a_i32);
+                A = @intCast(a_i32);
+            }
+            yuv2rgbWriteFull(tables, dest, Y, A, U, V, target, hasAlpha);
+            dest += step;
+        }
+    }
+}
+
+pub fn yuv2rgb_full_2(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    buf: [2][*]const i16,
+    ubuf: [2][*]const i16,
+    vbuf: [2][*]const i16,
+    abuf: [2]?[*]const i16,
+    dest_in: [*]u8,
+    dstW: usize,
+    yalpha: i32,
+    uvalpha: i32,
+    target: c_int,
+    hasAlpha: bool,
+) void {
+    const buf0 = buf[0];
+    const buf1 = buf[1];
+    const ubuf0 = ubuf[0];
+    const ubuf1 = ubuf[1];
+    const vbuf0 = vbuf[0];
+    const vbuf1 = vbuf[1];
+    const yalpha1: i32 = 4096 - yalpha;
+    const uvalpha1: i32 = 4096 - uvalpha;
+    const step: usize = if (target == t.PIXFMT_RGB24 or target == t.PIXFMT_BGR24) 3 else 4;
+    var dest = dest_in;
+
+    for (0..dstW) |i| {
+        const Y: i32 = (@as(i32, buf0[i]) * yalpha1 + @as(i32, buf1[i]) * yalpha) >> 10;
+        const U: i32 = (@as(i32, ubuf0[i]) * uvalpha1 + @as(i32, ubuf1[i]) * uvalpha - (128 << 19)) >> 10;
+        const V: i32 = (@as(i32, vbuf0[i]) * uvalpha1 + @as(i32, vbuf1[i]) * uvalpha - (128 << 19)) >> 10;
+        var A: u8 = 0;
+        if (hasAlpha) {
+            var a_i32: i32 = (@as(i32, abuf[0].?[i]) * yalpha1 + @as(i32, abuf[1].?[i]) * yalpha + (1 << 18)) >> 19;
+            if ((a_i32 & 0x100) != 0) a_i32 = t.clipUint8(a_i32);
+            A = @intCast(a_i32);
+        }
+        yuv2rgbWriteFull(tables, dest, Y, A, U, V, target, hasAlpha);
+        dest += step;
+    }
+}
+
+pub fn yuv2rgb_full_X(
+    tables: *const yuv2rgb.Yuv2RgbTables,
+    lumFilter: [*]const i16,
+    lumSrc: [*]const [*]const i16,
+    lumFilterSize: usize,
+    chrFilter: [*]const i16,
+    chrUSrc: [*]const [*]const i16,
+    chrVSrc: [*]const [*]const i16,
+    chrFilterSize: usize,
+    alpSrc: ?[*]const [*]const i16,
+    dest_in: [*]u8,
+    dstW: usize,
+    target: c_int,
+    hasAlpha: bool,
+) void {
+    const step: usize = if (target == t.PIXFMT_RGB24 or target == t.PIXFMT_BGR24) 3 else 4;
+    var dest = dest_in;
+
+    for (0..dstW) |i| {
+        var Y: i32 = 1 << 9;
+        var U: i32 = (1 << 9) - (128 << 19);
+        var V: i32 = (1 << 9) - (128 << 19);
+
+        for (0..lumFilterSize) |j| {
+            Y += @as(i32, lumSrc[j][i]) * @as(i32, lumFilter[j]);
+        }
+        for (0..chrFilterSize) |j| {
+            U += @as(i32, chrUSrc[j][i]) * @as(i32, chrFilter[j]);
+            V += @as(i32, chrVSrc[j][i]) * @as(i32, chrFilter[j]);
+        }
+        Y >>= 10;
+        U >>= 10;
+        V >>= 10;
+
+        var A: u8 = 0;
+        if (hasAlpha) {
+            var a_i32: i32 = 1 << 18;
+            for (0..lumFilterSize) |j| {
+                a_i32 += @as(i32, alpSrc.?[j][i]) * @as(i32, lumFilter[j]);
+            }
+            a_i32 >>= 19;
+            if ((a_i32 & 0x100) != 0) a_i32 = t.clipUint8(a_i32);
+            A = @intCast(a_i32);
+        }
+
+        yuv2rgbWriteFull(tables, dest, Y, A, U, V, target, hasAlpha);
+        dest += step;
+    }
+}
