+            dest32[i * 2 + 1] = r_y2 + g_y2 + b_y2 + (A2 << 24);
+        } else {
+            dest32[i * 2 + 0] = r_y1 + g_y1 + b_y1;
+            dest32[i * 2 + 1] = r_y2 + g_y2 + b_y2;
+        }
+    } else {
+        const r_y1 = @as([*]const u8, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(r_ptr))) + @as(isize, Y1)))))[0];
+        const g_y1 = @as([*]const u8, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(g_ptr))) + @as(isize, Y1)))))[0];
+        const b_y1 = @as([*]const u8, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(b_ptr))) + @as(isize, Y1)))))[0];
+
+        const r_y2 = @as([*]const u8, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(r_ptr))) + @as(isize, Y2)))))[0];
+        const g_y2 = @as([*]const u8, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(g_ptr))) + @as(isize, Y2)))))[0];
+        const b_y2 = @as([*]const u8, @ptrFromInt(@as(usize, @bitCast(@as(isize, @bitCast(@intFromPtr(b_ptr))) + @as(isize, Y2)))))[0];
