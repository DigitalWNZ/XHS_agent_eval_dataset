+        errdefer hLumFilter.deinit(allocator);
+
+        var hChrFilter = try filter_mod.initFilter(
+            allocator,
+            chrXInc,
+            chrSrcW,
+            chrDstW,
+            1,
+            1 << 14,
+            algo,
+            filter_mod.getLocalPos(chrSrcHSubSample, -513),
+            filter_mod.getLocalPos(chrDstHSubSample, -513),
