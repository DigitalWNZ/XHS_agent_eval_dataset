+    offset: usize,
+) void {
+    var d_arr: [16]i32 = undefined;
+    inline for (0..16) |k| {
+        d_arr[k] = @as(i32, dither[(k + offset) & 7]) << 12;
+    }
+    const d_vec: V16i32 = d_arr;
+
+    var i: usize = 0;
+    if (filterSize == 2) {
+        const s0 = src[0];
+        const s1 = src[1];
+        const f0: V16i32 = @splat(@as(i32, filter[0]));
+        const f1: V16i32 = @splat(@as(i32, filter[1]));
+        while (i + 16 <= dstW) : (i += 16) {
+            const v0: V16i32 = @intCast(@as(V16i16, s0[i..][0..16].*));
+            const v1: V16i32 = @intCast(@as(V16i16, s1[i..][0..16].*));
