+        const vbuf1 = vbuf[1];
+        var i: usize = 0;
+        if (is_std_range and (dstW & 1) == 0) {
+            while (i + 8 <= halfW) : (i += 8) {
+                const y_v: V16i32 = (@as(V16i32, @intCast(@as(V16i16, buf0[2 * i ..][0..16].*))) + @as(V16i32, @splat(64))) >> @splat(7);
+                const u_v: V8i32 = (@as(V8i32, @intCast(@as(V8i16, ubuf0[i..][0..8].*))) + @as(V8i32, @intCast(@as(V8i16, ubuf1[i..][0..8].*))) + @as(V8i32, @splat(128))) >> @splat(8);
+                const v_v: V8i32 = (@as(V8i32, @intCast(@as(V8i16, vbuf0[i..][0..8].*))) + @as(V8i32, @intCast(@as(V8i16, vbuf1[i..][0..8].*))) + @as(V8i32, @splat(128))) >> @splat(8);
+                var a_v: V16u8 = @splat(255);
+                if (hasAlpha) {
+                    const ab = abuf0.?;
+                    const a_i32 = (@as(V16i32, @intCast(@as(V16i16, ab[2 * i ..][0..16].*))) + @as(V16i32, @splat(64))) >> @splat(7);
