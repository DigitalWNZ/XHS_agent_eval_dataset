+inline fn yuv2rgbVec16_std(
+    y16: V16i32,
+    u8_vec: V8i32,
+    v8_vec: V8i32,
+    a16: V16u8,
+    dst: [*]u8,
+    target: c_int,
+    hasAlpha: bool,
