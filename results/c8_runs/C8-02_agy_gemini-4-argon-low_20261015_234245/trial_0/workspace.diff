+        if (target == t.PIXFMT_RGB24) {
+            dest[i * 6 + 0] = r_y1;
+            dest[i * 6 + 1] = g_y1;
+            dest[i * 6 + 2] = b_y1;
+            dest[i * 6 + 3] = r_y2;
+            dest[i * 6 + 4] = g_y2;
+            dest[i * 6 + 5] = b_y2;
+        } else {
+            dest[i * 6 + 0] = b_y1;
+            dest[i * 6 + 1] = g_y1;
+            dest[i * 6 + 2] = r_y1;
+            dest[i * 6 + 3] = b_y2;
+            dest[i * 6 + 4] = g_y2;
+            dest[i * 6 + 5] = r_y2;
+        }
+    }
+}
