+const RingBuffer = struct {
+    buf: []i16,
+    lines: [][*]i16,
+    line_stride: usize,
+    capacity: usize,
+    first_y: i32 = -1,
+    count: usize = 0,
+
+    fn init(allocator: std.mem.Allocator, capacity: usize, width: usize) !RingBuffer {
+        const line_stride = (width + 63) & ~@as(usize, 31);
+        const buf = try allocator.alloc(i16, capacity * line_stride);
+        @memset(buf, 1 << 14);
+        const lines = try allocator.alloc([*]i16, capacity);
+        for (0..capacity) |i| {
+            lines[i] = buf.ptr + i * line_stride;
+        }
+        return RingBuffer{
+            .buf = buf,
+            .lines = lines,
+            .line_stride = line_stride,
+            .capacity = capacity,
+        };
+    }
+
+    fn deinit(self: *RingBuffer, allocator: std.mem.Allocator) void {
+        allocator.free(self.buf);
+        allocator.free(self.lines);
+    }
+
+    fn reset(self: *RingBuffer) void {
+        self.first_y = 0;
+        self.count = 0;
+    }
+
+    inline fn getLine(self: *const RingBuffer, y: i32) [*]i16 {
+        const idx: usize = @intCast(@mod(y, @as(i32, @intCast(self.capacity))));
+        return self.lines[idx];
+    }
+};
+
