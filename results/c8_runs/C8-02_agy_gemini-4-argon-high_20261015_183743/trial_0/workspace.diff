+inline fn storeRgb24x16(ptr: [*]u8, c0: @Vector(16, u8), c1: @Vector(16, u8), c2: @Vector(16, u8)) void {
+    const rg_lo = @shuffle(u8, c0, c1, [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) });
