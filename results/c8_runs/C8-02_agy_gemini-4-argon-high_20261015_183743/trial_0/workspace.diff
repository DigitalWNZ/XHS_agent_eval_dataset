+            const p0: usize = @intCast(filterPos[i + 0]);
+            const p1: usize = @intCast(filterPos[i + 1]);
+            const p2: usize = @intCast(filterPos[i + 2]);
+            const p3: usize = @intCast(filterPos[i + 3]);
+            const p4: usize = @intCast(filterPos[i + 4]);
+            const p5: usize = @intCast(filterPos[i + 5]);
+            const p6: usize = @intCast(filterPos[i + 6]);
+            const p7: usize = @intCast(filterPos[i + 7]);
+            const v_u16 = @Vector(8, u16){
+                @as(*align(1) const u16, @ptrCast(src + p0)).*,
+                @as(*align(1) const u16, @ptrCast(src + p1)).*,
+                @as(*align(1) const u16, @ptrCast(src + p2)).*,
+                @as(*align(1) const u16, @ptrCast(src + p3)).*,
+                @as(*align(1) const u16, @ptrCast(src + p4)).*,
+                @as(*align(1) const u16, @ptrCast(src + p5)).*,
+                @as(*align(1) const u16, @ptrCast(src + p6)).*,
+                @as(*align(1) const u16, @ptrCast(src + p7)).*,
