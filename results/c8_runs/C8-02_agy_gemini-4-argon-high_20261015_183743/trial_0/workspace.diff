+        const srcPos: usize = @intCast(filterPos[i]);
+        var r_val: i32 = 0;
+        var g_val: i32 = 0;
+        var b_val: i32 = 0;
+        for (0..filterSize) |j| {
+            const w: i32 = filter[i * filterSize + j];
+            const px = (srcPos + j) * 3;
