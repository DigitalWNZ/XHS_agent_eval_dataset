+    const v0: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(ptr + 0)).*;
+    const v1: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(ptr + 16)).*;
+    const v2: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(ptr + 32)).*;
+    const v3: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(ptr + 48)).*;
