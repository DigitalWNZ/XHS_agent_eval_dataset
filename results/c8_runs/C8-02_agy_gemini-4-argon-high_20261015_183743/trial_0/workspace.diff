+        dst[i * 3 + 1] = @intCast(@min(g_val >> 7, 32767));
+        dst[i * 3 + 2] = @intCast(@min(b_val >> 7, 32767));
+    }
+}
+
+inline fn hUpscale2xRgb24Row(dst: []i16, src_w_u: usize, dst_w_u: usize, s_row: [*]const u8) void {
+    dst[0] = @as(i16, s_row[0]) * 4;
+    dst[1] = @as(i16, s_row[1]) * 4;
+    dst[2] = @as(i16, s_row[2]) * 4;
+
+    var x: usize = 0;
+    while (x + 5 < src_w_u) : (x += 4) {
+        const v0_u8: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(s_row + x * 3)).*;
+        const v1_u8: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(s_row + x * 3 + 3)).*;
+        const v0: @Vector(16, i16) = @intCast(v0_u8);
+        const v1: @Vector(16, i16) = @intCast(v1_u8);
+        const sum = v0 + v1;
+        const odd = sum + (v0 << @splat(1));
+        const even = sum + (v1 << @splat(1));
+
+        const out_lo = @shuffle(i16, odd, even, [16]i32{ 0, 1, 2, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), 3, 4, 5, ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), 6, 7, 8, ~@as(i32, 6) });
+        const out_hi = @shuffle(i16, odd, even, [8]i32{ ~@as(i32, 7), ~@as(i32, 8), 9, 10, 11, ~@as(i32, 9), ~@as(i32, 10), ~@as(i32, 11) });
+
+        const d_idx = (2 * x + 1) * 3;
+        @as(*align(1) @Vector(16, i16), @ptrCast(&dst[d_idx])).* = out_lo;
+        @as(*align(1) @Vector(8, i16), @ptrCast(&dst[d_idx + 16])).* = out_hi;
+    }
+    while (x < src_w_u - 1) : (x += 1) {
+        const d_idx = (2 * x + 1) * 3;
+        inline for (0..3) |c| {
+            const p0: i16 = s_row[x * 3 + c];
+            const p1: i16 = s_row[(x + 1) * 3 + c];
+            dst[d_idx + c] = 3 * p0 + p1;
+            dst[d_idx + 3 + c] = p0 + 3 * p1;
+        }
+    }
+    const last_s = (src_w_u - 1) * 3;
+    const last_d = (dst_w_u - 1) * 3;
+    dst[last_d + 0] = @as(i16, s_row[last_s + 0]) * 4;
+    dst[last_d + 1] = @as(i16, s_row[last_s + 1]) * 4;
+    dst[last_d + 2] = @as(i16, s_row[last_s + 2]) * 4;
+}
+
+fn processScaledSpecial(
+    ctx: *SwsContext,
+    sp: [*]const ?[*]const u8,
+    ss: [*]const c_int,
+    dp: [*]const ?[*]u8,
+    ds: [*]const c_int,
+) bool {
+    const src_fmt = ctx.src_fmt;
+    const dst_fmt = ctx.dst_fmt;
+
+    // S1. SWS_POINT (nearest) RGB24/BGR24 -> RGB24/BGR24
+    if (src_fmt == dst_fmt and (src_fmt == SWS_FMT_RGB24 or src_fmt == SWS_FMT_BGR24) and ctx.flags == SWS_POINT) {
+        const is_bgr = (src_fmt == SWS_FMT_BGR24);
+        const dst_h = ctx.dst_h;
+        const dst_w_u: usize = @intCast(ctx.dst_w);
+        const pairs: usize = dst_w_u >> 1;
+        const src_p = sp[0].?;
+        const dst_p = dp[0].?;
+        const h_sub = ctx.chr_src_h_sub;
+
+        var dstY: i32 = 0;
+        while (dstY < dst_h) : (dstY += 1) {
+            const sy = @max(0, @min(ctx.src_h - 1, ctx.v_lum.pos[@intCast(dstY)]));
+            const s_row = strideOffset(src_p, sy, ss[0]);
+            const d_row = strideOffsetMut(dst_p, dstY, ds[0]);
+
+            for (0..pairs) |i| {
+                const c_pos: usize = @as(usize, @intCast(ctx.h_chr.pos[i])) << h_sub;
+                const cx0: usize = c_pos * 3;
+                const cx1: usize = if (h_sub == 1) cx0 + 3 else cx0;
+                const lx0: usize = @as(usize, @intCast(ctx.h_lum.pos[2 * i])) * 3;
+                const lx1: usize = @as(usize, @intCast(ctx.h_lum.pos[2 * i + 1])) * 3;
+
+                const c0: i32 = @as(i32, s_row[cx0 + 0]) + @as(i32, s_row[cx1 + 0]);
+                const c1: i32 = @as(i32, s_row[cx0 + 1]) + @as(i32, s_row[cx1 + 1]);
+                const c2: i32 = @as(i32, s_row[cx0 + 2]) + @as(i32, s_row[cx1 + 2]);
+
+                {
+                    const l00: i32 = s_row[lx0 + 0];
+                    const l01: i32 = s_row[lx0 + 1];
+                    const l02: i32 = s_row[lx0 + 2];
+                    const dr = if (is_bgr) (2 * l02 - c2) else (2 * l00 - c0);
+                    const dg = 2 * l01 - c1;
+                    const db = if (is_bgr) (2 * l00 - c0) else (2 * l02 - c2);
+                    const delta = (4899 * dr + 9617 * dg + 1868 * db + 8192) >> 14;
+                    d_row[6 * i + 0] = clipU8((c0 + delta + 1) >> 1);
+                    d_row[6 * i + 1] = clipU8((c1 + delta + 1) >> 1);
+                    d_row[6 * i + 2] = clipU8((c2 + delta + 1) >> 1);
+                }
+
+                {
+                    const l10: i32 = s_row[lx1 + 0];
+                    const l11: i32 = s_row[lx1 + 1];
+                    const l12: i32 = s_row[lx1 + 2];
+                    const dr = if (is_bgr) (2 * l12 - c2) else (2 * l10 - c0);
+                    const dg = 2 * l11 - c1;
+                    const db = if (is_bgr) (2 * l10 - c0) else (2 * l12 - c2);
+                    const delta = (4899 * dr + 9617 * dg + 1868 * db + 8192) >> 14;
+                    d_row[6 * i + 3] = clipU8((c0 + delta + 1) >> 1);
+                    d_row[6 * i + 4] = clipU8((c1 + delta + 1) >> 1);
+                    d_row[6 * i + 5] = clipU8((c2 + delta + 1) >> 1);
+                }
+            }
+            if ((dst_w_u & 1) != 0) {
+                const last = dst_w_u - 1;
+                const lx: usize = @as(usize, @intCast(ctx.h_lum.pos[last])) * 3;
+                d_row[last * 3 + 0] = s_row[lx + 0];
+                d_row[last * 3 + 1] = s_row[lx + 1];
+                d_row[last * 3 + 2] = s_row[lx + 2];
+            }
+        }
+        return true;
+    }
+
+    // S2. Exact 2:1 Bilinear Upscale RGB24/BGR24 -> RGB24/BGR24 (b006, s002, s014)
+    if (src_fmt == dst_fmt and (src_fmt == SWS_FMT_RGB24 or src_fmt == SWS_FMT_BGR24) and
+        ctx.flags == SWS_BILINEAR and ctx.dst_w == ctx.src_w * 2 and ctx.dst_h == ctx.src_h * 2 and ctx.src_w >= 8 and ctx.src_h >= 2)
+    {
+        const src_w_u: usize = @intCast(ctx.src_w);
+        const dst_w_u: usize = @intCast(ctx.dst_w);
+        const row_elems: usize = dst_w_u * 3;
+        const src_p = sp[0].?;
+        const dst_p = dp[0].?;
+
+        const buf0 = ctx.lum_buf[0..ctx.lum_stride];
+        const buf1 = ctx.lum_buf[ctx.lum_stride .. 2 * ctx.lum_stride];
+
+        hUpscale2xRgb24Row(buf0, src_w_u, dst_w_u, strideOffset(src_p, 0, ss[0]));
+
+        // Row 0: (buf0 + 2) >> 2
+        {
+            const d_row0 = strideOffsetMut(dst_p, 0, ds[0]);
+            var k: usize = 0;
+            while (k + 16 <= row_elems) : (k += 16) {
+                const a: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&buf0[k])).*;
+                @as(*align(1) @Vector(16, u8), @ptrCast(d_row0 + k)).* = @intCast((a + @as(@Vector(16, i16), @splat(2))) >> @splat(2));
+            }
+            while (k < row_elems) : (k += 1) {
+                d_row0[k] = @intCast((buf0[k] + 2) >> 2);
+            }
+        }
+
+        var sy: i32 = 0;
+        while (sy < ctx.src_h - 1) : (sy += 1) {
+            const cur_buf = if ((sy & 1) == 0) buf0 else buf1;
+            const nxt_buf = if ((sy & 1) == 0) buf1 else buf0;
+            hUpscale2xRgb24Row(nxt_buf, src_w_u, dst_w_u, strideOffset(src_p, sy + 1, ss[0]));
+
+            const d_row1 = strideOffsetMut(dst_p, 2 * sy + 1, ds[0]);
+            const d_row2 = strideOffsetMut(dst_p, 2 * sy + 2, ds[0]);
+            var k: usize = 0;
+            const eight: @Vector(16, i16) = @splat(8);
+            while (k + 16 <= row_elems) : (k += 16) {
+                const a: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&cur_buf[k])).*;
+                const b: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&nxt_buf[k])).*;
+                const sum = a + b + eight;
+                const r1: @Vector(16, u8) = @intCast((sum + (a << @splat(1))) >> @splat(4));
+                const r2: @Vector(16, u8) = @intCast((sum + (b << @splat(1))) >> @splat(4));
+                @as(*align(1) @Vector(16, u8), @ptrCast(d_row1 + k)).* = r1;
+                @as(*align(1) @Vector(16, u8), @ptrCast(d_row2 + k)).* = r2;
+            }
+            while (k < row_elems) : (k += 1) {
+                const a: i32 = cur_buf[k];
+                const b: i32 = nxt_buf[k];
+                d_row1[k] = @intCast((3 * a + b + 8) >> 4);
+                d_row2[k] = @intCast((a + 3 * b + 8) >> 4);
+            }
+        }
+
+        // Last row dst_h - 1
+        {
+            const last_buf = if (((ctx.src_h - 1) & 1) == 0) buf0 else buf1;
+            const d_last = strideOffsetMut(dst_p, ctx.dst_h - 1, ds[0]);
+            var k: usize = 0;
+            while (k + 16 <= row_elems) : (k += 16) {
+                const a: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&last_buf[k])).*;
+                @as(*align(1) @Vector(16, u8), @ptrCast(d_last + k)).* = @intCast((a + @as(@Vector(16, i16), @splat(2))) >> @splat(2));
+            }
+            while (k < row_elems) : (k += 1) {
+                d_last[k] = @intCast((last_buf[k] + 2) >> 2);
+            }
+        }
+        return true;
+    }
+
+    // S3. General Upscale RGB24/BGR24 -> RGB24/BGR24 (b009, s006, s011, s017)
+    if (src_fmt == dst_fmt and (src_fmt == SWS_FMT_RGB24 or src_fmt == SWS_FMT_BGR24) and
+        ctx.dst_w >= ctx.src_w and ctx.flags != SWS_POINT)
+    {
+        @memset(ctx.lum_row_tags, -1);
+        const src_w_u: usize = @intCast(ctx.src_w);
+        const dst_w_u: usize = @intCast(ctx.dst_w);
+        const row_elems: usize = dst_w_u * 3;
+        const h_fs_u: usize = @intCast(ctx.h_lum.size);
+        const v_fs_u: usize = @intCast(ctx.v_lum.size);
+        const src_p = sp[0].?;
+        const dst_p = dp[0].?;
+
+        var slots: [64]usize = undefined;
+        var dstY: i32 = 0;
+        while (dstY < ctx.dst_h) : (dstY += 1) {
+            const dstY_u: usize = @intCast(dstY);
+            const firstLum = @max(1 - ctx.v_lum.size, ctx.v_lum.pos[dstY_u]);
+            for (0..v_fs_u) |j| {
+                const sy = @max(0, @min(ctx.src_h - 1, firstLum + @as(i32, @intCast(j))));
+                const slot: usize = @as(usize, @intCast(sy)) % ctx.lum_ring_size;
+                if (ctx.lum_row_tags[slot] != sy) {
+                    ctx.lum_row_tags[slot] = sy;
+                    const dst_line = ctx.lum_buf[slot * ctx.lum_stride .. (slot + 1) * ctx.lum_stride];
+                    const s_row = strideOffset(src_p, sy, ss[0]);
+                    hScaleRgb24Row(dst_line, dst_w_u, src_w_u, s_row, ctx.h_lum.filter, ctx.h_lum.pos, h_fs_u);
+                }
+                slots[j] = slot;
+            }
+
+            const d_row = strideOffsetMut(dst_p, dstY, ds[0]);
+            const vf = ctx.v_lum.filter[dstY_u * v_fs_u ..];
+            var k: usize = 0;
+            while (k + 16 <= row_elems) : (k += 16) {
+                var val_lo: @Vector(8, i32) = @splat(1 << 18);
+                var val_hi: @Vector(8, i32) = @splat(1 << 18);
+                for (0..v_fs_u) |j| {
+                    const s_line = ctx.lum_buf[slots[j] * ctx.lum_stride ..];
+                    const s16: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&s_line[k])).*;
+                    const c_vec: @Vector(8, i32) = @splat(@as(i32, vf[j]));
+                    val_lo += @as(@Vector(8, i32), @shuffle(i16, s16, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 })) * c_vec;
+                    val_hi += @as(@Vector(8, i32), @shuffle(i16, s16, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 })) * c_vec;
+                }
+                const r_lo: @Vector(8, i16) = @intCast(@max(@as(@Vector(8, i32), @splat(0)), @min(@as(@Vector(8, i32), @splat(255)), val_lo >> @splat(19))));
+                const r_hi: @Vector(8, i16) = @intCast(@max(@as(@Vector(8, i32), @splat(0)), @min(@as(@Vector(8, i32), @splat(255)), val_hi >> @splat(19))));
+                const r16 = @shuffle(i16, r_lo, r_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+                @as(*align(1) @Vector(16, u8), @ptrCast(d_row + k)).* = @intCast(r16);
+            }
+            while (k < row_elems) : (k += 1) {
+                var val: i32 = 1 << 18;
+                for (0..v_fs_u) |j| {
+                    const s_line = ctx.lum_buf[slots[j] * ctx.lum_stride ..];
+                    val += @as(i32, s_line[k]) * @as(i32, vf[j]);
+                }
+                d_row[k] = clipU8(val >> 19);
+            }
+        }
+        return true;
+    }
+
+    return false;
+}
+
+pub export fn swscale_process(
+    ctx_opt: ?*SwsContext,
+    src_slice: ?[*]const ?[*]const u8,
+    src_stride: ?[*]const c_int,
+    dst_slice: ?[*]const ?[*]u8,
+    dst_stride: ?[*]const c_int,
+) c_int {
+    const ctx = ctx_opt orelse return -1;
+    const sp = src_slice orelse return -1;
+    const ss = src_stride orelse return -1;
+    const dp = dst_slice orelse return -1;
+    const ds = dst_stride orelse return -1;
+
+    for (0..numPlanes(ctx.src_fmt)) |p| {
+        if (sp[p] == null) return -1;
+    }
+    for (0..numPlanes(ctx.dst_fmt)) |p| {
+        if (dp[p] == null) return -1;
+    }
+
+    if (ctx.src_w == ctx.dst_w and ctx.src_h == ctx.dst_h) {
+        if (processUnscaledSpecial(ctx, sp, ss, dp, ds)) {
+            return 0;
+        }
+    } else {
+        if (processScaledSpecial(ctx, sp, ss, dp, ds)) {
+            return 0;
+        }
+    }
+
+    @memset(ctx.lum_row_tags, -1);
+    @memset(ctx.chr_row_tags, -1);
+
+    const dst_h = ctx.dst_h;
+    const dst_w_u: usize = @intCast(ctx.dst_w);
+    const chr_dst_w_u: usize = @intCast(ctx.chr_dst_w);
+    const v_lum_size: usize = @intCast(ctx.v_lum.size);
+    const v_chr_size: usize = @intCast(ctx.v_chr.size);
+    const dst_fmt = ctx.dst_fmt;
+
+    var lum_slots: [64]usize = undefined;
+    var chr_slots: [64]usize = undefined;
+
+    if (!isAnyRGB(dst_fmt)) {
+        // Planar YUV, NV12/NV21, or GRAY8 output
+        const chr_skip_mask: i32 = (@as(i32, 1) << ctx.chr_dst_v_sub) - 1;
+        var dstY: i32 = 0;
+        while (dstY < dst_h) : (dstY += 1) {
+            const dstY_u: usize = @intCast(dstY);
+            const firstLum = @max(1 - ctx.v_lum.size, ctx.v_lum.pos[dstY_u]);
+            for (0..v_lum_size) |j| {
+                lum_slots[j] = getLumSlot(ctx, firstLum + @as(i32, @intCast(j)), sp, ss);
+            }
+
+            const y_out = strideOffsetMut(dp[0].?, dstY, ds[0]);
+            if (v_lum_size == 1) {
+                const src0 = ctx.lum_buf[lum_slots[0] * ctx.lum_stride ..];
+                var i: usize = 0;
+                while (i + 16 <= dst_w_u) : (i += 16) {
+                    const s16: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&src0[i])).*;
+                    @as(*align(1) @Vector(16, u8), @ptrCast(y_out + i)).* = clampPackU8((s16 +| @as(@Vector(16, i16), @splat(64))) >> @splat(7));
+                }
+                while (i < dst_w_u) : (i += 1) {
+                    y_out[i] = clipU8((@as(i32, src0[i]) + 64) >> 7);
+                }
+            } else {
+                const vf = ctx.v_lum.filter[dstY_u * v_lum_size ..];
+                var i: usize = 0;
+                while (i + 16 <= dst_w_u) : (i += 16) {
+                    var val_lo: @Vector(8, i32) = @splat(1 << 18);
+                    var val_hi: @Vector(8, i32) = @splat(1 << 18);
+                    for (0..v_lum_size) |j| {
+                        const s_line = ctx.lum_buf[lum_slots[j] * ctx.lum_stride ..];
+                        const s16: @Vector(16, i16) = @as(*align(1) const @Vector(16, i16), @ptrCast(&s_line[i])).*;
+                        const c_vec: @Vector(8, i32) = @splat(@as(i32, vf[j]));
+                        val_lo += @as(@Vector(8, i32), @shuffle(i16, s16, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 })) * c_vec;
+                        val_hi += @as(@Vector(8, i32), @shuffle(i16, s16, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 })) * c_vec;
+                    }
+                    const r_lo: @Vector(8, i16) = @intCast(@max(@as(@Vector(8, i32), @splat(-32768)), @min(@as(@Vector(8, i32), @splat(32767)), val_lo >> @splat(19))));
+                    const r_hi: @Vector(8, i16) = @intCast(@max(@as(@Vector(8, i32), @splat(-32768)), @min(@as(@Vector(8, i32), @splat(32767)), val_hi >> @splat(19))));
+                    const r16 = @shuffle(i16, r_lo, r_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+                    @as(*align(1) @Vector(16, u8), @ptrCast(y_out + i)).* = clampPackU8(r16);
+                }
+                while (i < dst_w_u) : (i += 1) {
+                    var val: i32 = 1 << 18;
+                    for (0..v_lum_size) |j| {
+                        const s_line = ctx.lum_buf[lum_slots[j] * ctx.lum_stride ..];
+                        val += @as(i32, s_line[i]) * @as(i32, vf[j]);
+                    }
+                    y_out[i] = clipU8(val >> 19);
+                }
+            }
+
+            if (dst_fmt != SWS_FMT_GRAY8 and (dstY & chr_skip_mask) == 0) {
+                const chrDstY: i32 = dstY >> ctx.chr_dst_v_sub;
+                const chrDstY_u: usize = @intCast(chrDstY);
+                const firstChr = @max(1 - ctx.v_chr.size, ctx.v_chr.pos[chrDstY_u]);
+                for (0..v_chr_size) |j| {
+                    chr_slots[j] = getChrSlot(ctx, firstChr + @as(i32, @intCast(j)), sp, ss);
+                }
+
+                if (isSemiPlanarYUV(dst_fmt)) {
+                    const uv_out = strideOffsetMut(dp[1].?, chrDstY, ds[1]);
+                    const swap = (dst_fmt == SWS_FMT_NV21);
+                    const cf = ctx.v_chr.filter[chrDstY_u * v_chr_size ..];
+                    for (0..chr_dst_w_u) |i| {
+                        var u_val: i32 = 1 << 18;
+                        var v_val: i32 = 1 << 18;
+                        for (0..v_chr_size) |j| {
+                            const u_line = ctx.chr_u_buf[chr_slots[j] * ctx.chr_stride ..];
+                            const v_line = ctx.chr_v_buf[chr_slots[j] * ctx.chr_stride ..];
+                            const coeff: i32 = cf[j];
+                            u_val += @as(i32, u_line[i]) * coeff;
+                            v_val += @as(i32, v_line[i]) * coeff;
+                        }
+                        const u_b = clipU8(u_val >> 19);
+                        const v_b = clipU8(v_val >> 19);
+                        uv_out[2 * i + 0] = if (swap) v_b else u_b;
+                        uv_out[2 * i + 1] = if (swap) u_b else v_b;
+                    }
+                } else {
+                    const u_out = strideOffsetMut(dp[1].?, chrDstY, ds[1]);
+                    const v_out = strideOffsetMut(dp[2].?, chrDstY, ds[2]);
+                    if (v_chr_size == 1) {
+                        const u_s0 = ctx.chr_u_buf[chr_slots[0] * ctx.chr_stride ..];
+                        const v_s0 = ctx.chr_v_buf[chr_slots[0] * ctx.chr_stride ..];
