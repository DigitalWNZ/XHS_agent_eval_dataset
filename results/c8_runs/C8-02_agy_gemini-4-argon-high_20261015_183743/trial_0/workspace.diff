+    const rg_mid = @shuffle(u8, rg_lo, rg_hi, [16]i32{ 11, 12, 13, 14, 15, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), 0, 0, 0, 0, 0 });
+
+    const out0 = @shuffle(u8, rg_lo, c2, [16]i32{ 0, 1, ~@as(i32, 0), 2, 3, ~@as(i32, 1), 4, 5, ~@as(i32, 2), 6, 7, ~@as(i32, 3), 8, 9, ~@as(i32, 4), 10 });
+    const out1 = @shuffle(u8, rg_mid, c2, [16]i32{ 0, ~@as(i32, 5), 1, 2, ~@as(i32, 6), 3, 4, ~@as(i32, 7), 5, 6, ~@as(i32, 8), 7, 8, ~@as(i32, 9), 9, 10 });
+    const out2 = @shuffle(u8, rg_hi, c2, [16]i32{ ~@as(i32, 10), 6, 7, ~@as(i32, 11), 8, 9, ~@as(i32, 12), 10, 11, ~@as(i32, 13), 12, 13, ~@as(i32, 14), 14, 15, ~@as(i32, 15) });
+
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 0)).* = out0;
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 16)).* = out1;
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 32)).* = out2;
+}
+
+inline fn storeRgba16(ptr: [*]u8, c0: @Vector(16, u8), c1: @Vector(16, u8), c2: @Vector(16, u8), a: @Vector(16, u8)) void {
+    const c01_lo = @shuffle(u8, c0, c1, [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) });
