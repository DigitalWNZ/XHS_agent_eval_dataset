+inline fn yuvRowToRgbSimd(
+    y_row: [*]const u8,
+    d_row: [*]u8,
+    off_r_72: @Vector(16, i16),
+    off_g_72: @Vector(16, i16),
+    off_b_72: @Vector(16, i16),
+    x: usize,
+    comptime dst_fmt: c_int,
+) void {
+    const y8: @Vector(16, u8) = @as(*align(1) const @Vector(16, u8), @ptrCast(y_row + x)).*;
+    const y_vec: @Vector(16, i16) = @intCast(y8);
+    const r8 = evalYuvTable16(y_vec + off_r_72);
+    const g8 = evalYuvTable16(y_vec + off_g_72);
+    const b8 = evalYuvTable16(y_vec + off_b_72);
+    switch (dst_fmt) {
+        SWS_FMT_RGB24 => storeRgb24x16(d_row + x * 3, r8, g8, b8),
+        SWS_FMT_BGR24 => storeRgb24x16(d_row + x * 3, b8, g8, r8),
+        SWS_FMT_RGBA => storeRgba16(d_row + x * 4, r8, g8, b8, @splat(255)),
+        SWS_FMT_BGRA => storeRgba16(d_row + x * 4, b8, g8, r8, @splat(255)),
+        else => unreachable,
+    }
+}
+
+fn processUnscaledRgbToYuv420(
+    w_u: usize,
+    h: i32,
+    sp: [*]const u8,
+    ss: c_int,
+    dy: [*]u8,
+    ds_y: c_int,
+    du: [*]u8,
+    ds_u: c_int,
+    dv: [*]u8,
+    ds_v: c_int,
+    comptime src_fmt: c_int,
+    comptime dst_fmt: c_int,
+) void {
+    const is_bgr = (src_fmt == SWS_FMT_BGR24 or src_fmt == SWS_FMT_BGRA);
+    const is_alpha = (src_fmt == SWS_FMT_RGBA or src_fmt == SWS_FMT_BGRA);
+    const s_step: usize = if (is_alpha) 4 else 3;
+    const cw: usize = w_u >> 1;
+    const ch: i32 = h >> 1;
+
+    var r_pair_buf: [4][2048]i16 = undefined;
+    var g_pair_buf: [4][2048]i16 = undefined;
+    var b_pair_buf: [4][2048]i16 = undefined;
+    var slot_row: [4]i32 = .{ -1, -1, -1, -1 };
+
+    const processLumaRow = struct {
+        inline fn run(
+            row_idx: i32,
+            width_u: usize,
+            chr_w: usize,
+            src_p: [*]const u8,
+            src_s: c_int,
+            dst_y_p: [*]u8,
+            dst_y_s: c_int,
+            r_pairs: *[2048]i16,
+            g_pairs: *[2048]i16,
+            b_pairs: *[2048]i16,
+        ) void {
+            const s_row = strideOffset(src_p, row_idx, src_s);
+            const y_row = strideOffsetMut(dst_y_p, row_idx, dst_y_s);
+            var i: usize = 0;
+            while (i + 8 <= chr_w) : (i += 8) {
+                const x = i * 2;
+                var r8: @Vector(16, u8) = undefined;
+                var g8: @Vector(16, u8) = undefined;
+                var b8: @Vector(16, u8) = undefined;
+                if (is_alpha) {
+                    loadRgba16(s_row + x * 4, is_bgr, &r8, &g8, &b8);
+                } else {
+                    loadRgb24x16(s_row + x * 3, is_bgr, &r8, &g8, &b8);
+                }
+
+                const r_hi: @Vector(16, u16) = @as(@Vector(16, u16), r8) << @splat(8);
+                const g_hi: @Vector(16, u16) = @as(@Vector(16, u16), g8) << @splat(8);
+                const b_hi: @Vector(16, u16) = @as(@Vector(16, u16), b8) << @splat(8);
+                const y16 = (mulhiU16(r_hi, @splat(16828)) + mulhiU16(g_hi, @splat(33038)) + mulhiU16(b_hi, @splat(6416)) + @as(@Vector(16, u16), @splat(4227))) >> @splat(8);
+                @as(*align(1) @Vector(16, u8), @ptrCast(y_row + x)).* = @intCast(y16);
+
+                const r_u16: @Vector(8, u16) = @bitCast(r8);
+                const g_u16: @Vector(8, u16) = @bitCast(g8);
+                const b_u16: @Vector(8, u16) = @bitCast(b8);
+                const mask_ff: @Vector(8, u16) = @splat(0x00FF);
+                const r_sum: @Vector(8, i16) = @bitCast((r_u16 & mask_ff) + (r_u16 >> @splat(8)));
+                const g_sum: @Vector(8, i16) = @bitCast((g_u16 & mask_ff) + (g_u16 >> @splat(8)));
+                const b_sum: @Vector(8, i16) = @bitCast((b_u16 & mask_ff) + (b_u16 >> @splat(8)));
+
+                @as(*align(1) @Vector(8, i16), @ptrCast(&r_pairs[i])).* = r_sum;
+                @as(*align(1) @Vector(8, i16), @ptrCast(&g_pairs[i])).* = g_sum;
+                @as(*align(1) @Vector(8, i16), @ptrCast(&b_pairs[i])).* = b_sum;
+            }
