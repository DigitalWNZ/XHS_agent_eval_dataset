+                        var Y2: i32 = 1 << 18;
+                        var U: i32 = 1 << 18;
+                        var V: i32 = 1 << 18;
+                        for (0..v_lum_size) |j| {
+                            const y_line = ctx.lum_buf[lum_slots[j] * ctx.lum_stride ..];
+                            const c: i32 = lf[j];
+                            Y1 += @as(i32, y_line[2 * i]) * c;
+                            Y2 += @as(i32, y_line[2 * i + 1]) * c;
+                        }
+                        for (0..v_chr_size) |j| {
+                            const u_line = ctx.chr_u_buf[chr_slots[j] * ctx.chr_stride ..];
+                            const v_line = ctx.chr_v_buf[chr_slots[j] * ctx.chr_stride ..];
+                            const c: i32 = cf[j];
+                            U += @as(i32, u_line[i]) * c;
+                            V += @as(i32, v_line[i]) * c;
+                        }
+                        switch (dst_fmt) {
+                            SWS_FMT_RGB24 => yuvToRgbPair(Y1 >> 19, Y2 >> 19, U >> 19, V >> 19, 255, 255, SWS_FMT_RGB24, d_row + i * d_pair_step),
+                            SWS_FMT_BGR24 => yuvToRgbPair(Y1 >> 19, Y2 >> 19, U >> 19, V >> 19, 255, 255, SWS_FMT_BGR24, d_row + i * d_pair_step),
+                            SWS_FMT_RGBA => yuvToRgbPair(Y1 >> 19, Y2 >> 19, U >> 19, V >> 19, 255, 255, SWS_FMT_RGBA, d_row + i * d_pair_step),
+                            SWS_FMT_BGRA => yuvToRgbPair(Y1 >> 19, Y2 >> 19, U >> 19, V >> 19, 255, 255, SWS_FMT_BGRA, d_row + i * d_pair_step),
+                            else => unreachable,
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    return 0;
+}
