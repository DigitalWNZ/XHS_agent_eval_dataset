+    const out1 = @shuffle(u8, c01_lo, c2a_lo, [16]i32{ 8, 9, ~@as(i32, 8), ~@as(i32, 9), 10, 11, ~@as(i32, 10), ~@as(i32, 11), 12, 13, ~@as(i32, 12), ~@as(i32, 13), 14, 15, ~@as(i32, 14), ~@as(i32, 15) });
+    const out2 = @shuffle(u8, c01_hi, c2a_hi, [16]i32{ 0, 1, ~@as(i32, 0), ~@as(i32, 1), 2, 3, ~@as(i32, 2), ~@as(i32, 3), 4, 5, ~@as(i32, 4), ~@as(i32, 5), 6, 7, ~@as(i32, 6), ~@as(i32, 7) });
+    const out3 = @shuffle(u8, c01_hi, c2a_hi, [16]i32{ 8, 9, ~@as(i32, 8), ~@as(i32, 9), 10, 11, ~@as(i32, 10), ~@as(i32, 11), 12, 13, ~@as(i32, 12), ~@as(i32, 13), 14, 15, ~@as(i32, 14), ~@as(i32, 15) });
+
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 0)).* = out0;
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 16)).* = out1;
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 32)).* = out2;
+    @as(*align(1) @Vector(16, u8), @ptrCast(ptr + 48)).* = out3;
