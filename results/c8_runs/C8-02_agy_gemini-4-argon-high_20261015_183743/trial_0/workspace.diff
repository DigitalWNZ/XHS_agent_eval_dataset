+const std = @import("std");
+const allocator = std.heap.c_allocator;
+
+pub const SWS_FMT_YUV420P: c_int = 0;
+pub const SWS_FMT_YUV422P: c_int = 1;
+pub const SWS_FMT_YUV444P: c_int = 2;
+pub const SWS_FMT_NV12: c_int = 3;
+pub const SWS_FMT_NV21: c_int = 4;
+pub const SWS_FMT_RGB24: c_int = 5;
+pub const SWS_FMT_BGR24: c_int = 6;
+pub const SWS_FMT_RGBA: c_int = 7;
+pub const SWS_FMT_BGRA: c_int = 8;
+pub const SWS_FMT_GRAY8: c_int = 9;
+
+pub const SWS_ALGO_NEAREST: c_int = 0;
+pub const SWS_ALGO_BILINEAR: c_int = 1;
+pub const SWS_ALGO_BICUBIC: c_int = 2;
+
+const SWS_POINT: u32 = 0x10;
+const SWS_BILINEAR: u32 = 0x02;
+const SWS_BICUBIC: u32 = 0x04;
+
+inline fn isAnyRGB(fmt: c_int) bool {
+    return fmt >= SWS_FMT_RGB24 and fmt <= SWS_FMT_BGRA;
+}
+
+inline fn isAlpha(fmt: c_int) bool {
+    return fmt == SWS_FMT_RGBA or fmt == SWS_FMT_BGRA;
+}
+
+inline fn isPlanarYUV(fmt: c_int) bool {
+    return fmt >= SWS_FMT_YUV420P and fmt <= SWS_FMT_YUV444P;
+}
+
+inline fn isSemiPlanarYUV(fmt: c_int) bool {
+    return fmt == SWS_FMT_NV12 or fmt == SWS_FMT_NV21;
+}
+
+inline fn numPlanes(fmt: c_int) usize {
+    return switch (fmt) {
+        SWS_FMT_YUV420P, SWS_FMT_YUV422P, SWS_FMT_YUV444P => 3,
+        SWS_FMT_NV12, SWS_FMT_NV21 => 2,
+        else => 1,
+    };
+}
+
+inline fn getChromaSubSample(fmt: c_int) struct { h: u3, v: u3 } {
+    return switch (fmt) {
+        SWS_FMT_YUV420P, SWS_FMT_NV12, SWS_FMT_NV21 => .{ .h = 1, .v = 1 },
+        SWS_FMT_YUV422P => .{ .h = 1, .v = 0 },
+        else => .{ .h = 0, .v = 0 },
+    };
+}
+
+inline fn ceilRshift(val: i32, shift: u3) i32 {
+    return (val + (@as(i32, 1) << shift) - 1) >> shift;
+}
+
+inline fn clipU8(val: i32) u8 {
+    return @intCast(@max(0, @min(255, val)));
+}
+
+inline fn roundedDiv(a: i64, b: i64) i64 {
+    return if (a >= 0) @divTrunc(a + (b >> 1), b) else @divTrunc(a - (b >> 1), b);
+}
+
+fn avLog2(v_in: u32) u32 {
+    if (v_in == 0) return 0;
+    return 31 - @clz(v_in);
+}
+
+const FilterData = struct {
+    filter: []i16,
+    pos: []i32,
+    size: i32,
+};
+
+fn initFilter(
+    xInc: i32,
+    srcW: i32,
+    dstW: i32,
+    filterAlign: i32,
+    one: i32,
+    flags: u32,
+    srcPos: i32,
+    dstPos: i32,
+) !FilterData {
+    const dstW_u: usize = @intCast(dstW);
+    const filterPos = try allocator.alloc(i32, dstW_u + 3);
+    errdefer allocator.free(filterPos);
+
+    const ratio: u32 = @intCast(@max(1, @divTrunc(srcW, dstW)));
+    const log2_ratio: u6 = @intCast(@min(avLog2(ratio), 8));
+    const fone_shift: u6 = 54 - log2_ratio;
+    const fone: i64 = @as(i64, 1) << fone_shift;
+
+    var filterSize: i32 = 1;
+    var filter: []i64 = &.{};
+
+    if (@abs(xInc - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try allocator.alloc(i64, dstW_u);
+        for (0..dstW_u) |i| {
+            filter[i] = fone;
+            filterPos[i] = @intCast(i);
+        }
+    } else if ((flags & SWS_POINT) != 0) {
+        filterSize = 1;
+        filter = try allocator.alloc(i64, dstW_u);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * @as(i64, xInc)) >> 8) - ((@as(i64, srcPos) * 0x8000) >> 7);
+        for (0..dstW_u) |i| {
+            const xx: i32 = @intCast((xDstInSrc - ((@as(i64, filterSize) - 1) << 15) + (1 << 15)) >> 16);
+            filterPos[i] = xx;
+            filter[i] = fone;
+            xDstInSrc += xInc;
+        }
+    } else {
+        const sizeFactor: i32 = if ((flags & SWS_BICUBIC) != 0) 4 else 2;
+        if (xInc <= (1 << 16)) {
+            filterSize = 1 + sizeFactor;
+        } else {
+            filterSize = 1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW);
+        }
+        filterSize = @min(filterSize, srcW - 2);
+        filterSize = @max(filterSize, 1);
+
+        const fs_u: usize = @intCast(filterSize);
+        filter = try allocator.alloc(i64, dstW_u * fs_u);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * @as(i64, xInc)) >> 7) - ((@as(i64, srcPos) * 0x10000) >> 7);
+        for (0..dstW_u) |i| {
+            var xx: i32 = @intCast(@divTrunc(xDstInSrc - (@as(i64, filterSize) - 2) * (1 << 16), 1 << 17));
+            filterPos[i] = xx;
+            for (0..fs_u) |j| {
+                const diff: i64 = @intCast(@abs((@as(i64, xx) * (1 << 17)) - xDstInSrc));
+                var d: i64 = diff << 13;
+                if (xInc > (1 << 16)) {
+                    d = @divTrunc(d * dstW, srcW);
+                }
+                var coeff: i64 = 0;
+                if ((flags & SWS_BICUBIC) != 0) {
+                    const B: i64 = 0;
+                    const C: i64 = 10066329; // (int64_t)(0.6 * (1 << 24))
+                    if (d >= (1 << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (1 << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    const div_factor: i64 = @divTrunc(@as(i64, 1) << 54, fone);
+                    coeff = @divTrunc(coeff, div_factor);
+                } else {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * fs_u + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * @as(i64, xInc);
+        }
+    }
+    defer allocator.free(filter);
+
+    const filter2Size: i32 = filterSize;
+    const f2s_u: usize = @intCast(filter2Size);
+    var filter2 = try allocator.alloc(i64, dstW_u * f2s_u);
+    defer allocator.free(filter2);
+    @memcpy(filter2, filter);
+
+    var minFilterSize: i32 = 0;
+    const cutoff_limit: i64 = @intFromFloat(0.002 * @as(f64, @floatFromInt(fone)));
+    {
+        var i_s: isize = @intCast(dstW - 1);
+        while (i_s >= 0) : (i_s -= 1) {
+            const i: usize = @intCast(i_s);
+            var min: i32 = filter2Size;
+            var cutOff: i64 = 0;
+            for (0..f2s_u) |_| {
+                cutOff += @intCast(@abs(filter2[i * f2s_u]));
+                if (cutOff > cutoff_limit) break;
+                if (i < dstW_u - 1 and filterPos[i] >= filterPos[i + 1]) break;
+                for (1..f2s_u) |k| {
+                    filter2[i * f2s_u + k - 1] = filter2[i * f2s_u + k];
+                }
+                filter2[i * f2s_u + f2s_u - 1] = 0;
+                filterPos[i] += 1;
+            }
+            cutOff = 0;
+            var j_s: isize = @intCast(filter2Size - 1);
+            while (j_s > 0) : (j_s -= 1) {
+                const j: usize = @intCast(j_s);
+                cutOff += @intCast(@abs(filter2[i * f2s_u + j]));
+                if (cutOff > cutoff_limit) break;
+                min -= 1;
+            }
+            if (min > minFilterSize) minFilterSize = min;
+        }
+    }
+
+    filterSize = (minFilterSize + (filterAlign - 1)) & (~(filterAlign - 1));
+    const fs_u: usize = @intCast(filterSize);
+    var filter_aligned = try allocator.alloc(i64, dstW_u * fs_u);
+    defer allocator.free(filter_aligned);
+
+    for (0..dstW_u) |i| {
+        for (0..fs_u) |j| {
+            if (j >= f2s_u) {
+                filter_aligned[i * fs_u + j] = 0;
+            } else {
+                filter_aligned[i * fs_u + j] = filter2[i * f2s_u + j];
+            }
+        }
+    }
+
+    // fix borders
+    for (0..dstW_u) |i| {
+        if (filterPos[i] < 0) {
+            for (1..fs_u) |j| {
+                const j_i32: i32 = @intCast(j);
+                const left: usize = @intCast(@max(j_i32 + filterPos[i], 0));
+                filter_aligned[i * fs_u + left] += filter_aligned[i * fs_u + j];
+                filter_aligned[i * fs_u + j] = 0;
+            }
+            filterPos[i] = 0;
+        }
+        if (filterPos[i] + filterSize > srcW) {
+            const shift: i32 = filterPos[i] + @min(filterSize - srcW, 0);
+            var acc: i64 = 0;
+            var j_s: isize = @intCast(filterSize - 1);
+            while (j_s >= 0) : (j_s -= 1) {
+                const j: usize = @intCast(j_s);
+                const j_i32: i32 = @intCast(j);
+                if (filterPos[i] + j_i32 >= srcW) {
+                    acc += filter_aligned[i * fs_u + j];
+                    filter_aligned[i * fs_u + j] = 0;
+                }
+            }
+            j_s = @intCast(filterSize - 1);
+            while (j_s >= 0) : (j_s -= 1) {
+                const j: usize = @intCast(j_s);
+                const j_i32: i32 = @intCast(j);
+                if (j_i32 < shift) {
+                    filter_aligned[i * fs_u + j] = 0;
+                } else {
+                    const src_idx: usize = @intCast(j_i32 - shift);
+                    filter_aligned[i * fs_u + j] = filter_aligned[i * fs_u + src_idx];
+                }
+            }
+            filterPos[i] -= shift;
+            const target_idx: usize = @intCast(srcW - 1 - filterPos[i]);
+            filter_aligned[i * fs_u + target_idx] += acc;
+        }
+    }
+
+    const outFilter = try allocator.alloc(i16, fs_u * (dstW_u + 3));
+    @memset(outFilter, 0);
+    const one_i64: i64 = one;
+
+    for (0..dstW_u) |i| {
+        var error_val: i64 = 0;
+        var sum: i64 = 0;
+        for (0..fs_u) |j| {
+            sum += filter_aligned[i * fs_u + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one_i64, 2), one_i64);
+        if (sum == 0) sum = 1;
+        for (0..fs_u) |j| {
+            const v: i64 = filter_aligned[i * fs_u + j] + error_val;
+            const intV: i64 = roundedDiv(v, sum);
+            outFilter[i * fs_u + j] = @intCast(intV);
+            error_val = v - intV * sum;
+        }
+    }
+
+    filterPos[dstW_u + 0] = filterPos[dstW_u - 1];
+    filterPos[dstW_u + 1] = filterPos[dstW_u - 1];
+    filterPos[dstW_u + 2] = filterPos[dstW_u - 1];
+    for (0..fs_u) |j| {
+        const k = (dstW_u - 1) * fs_u + j;
+        outFilter[k + 1 * fs_u] = outFilter[k];
+        outFilter[k + 2 * fs_u] = outFilter[k];
+        outFilter[k + 3 * fs_u] = outFilter[k];
+    }
+
+    return .{
+        .filter = outFilter,
+        .pos = filterPos,
+        .size = filterSize,
+    };
+}
+
+pub const SwsContext = struct {
+    src_w: i32,
+    src_h: i32,
+    src_fmt: c_int,
+    dst_w: i32,
+    dst_h: i32,
+    dst_fmt: c_int,
+    algo: c_int,
+    flags: u32,
+
+    src_range: u1,
+    dst_range: u1,
+    chr_src_h_sub: u3,
+    chr_src_v_sub: u3,
+    chr_dst_h_sub: u3,
+    chr_dst_v_sub: u3,
+    full_chr_h_int: bool,
+    needs_hcscale: bool,
+    need_alpha: bool,
+
+    chr_src_w: i32,
+    chr_src_h: i32,
+    chr_dst_w: i32,
+    chr_dst_h: i32,
+
+    lum_x_inc: i32,
+    lum_y_inc: i32,
+    chr_x_inc: i32,
+    chr_y_inc: i32,
+
+    h_lum: FilterData,
+    h_chr: FilterData,
+    v_lum: FilterData,
+    v_chr: FilterData,
+
+    // Scratch buffers for general pipeline
+    lum_buf: []i16,
+    alp_buf: []i16,
+    chr_u_buf: []i16,
+    chr_v_buf: []i16,
+    lum_row_tags: []i32,
+    chr_row_tags: []i32,
+    lum_ring_size: usize,
+    chr_ring_size: usize,
+    lum_stride: usize,
+    chr_stride: usize,
+    conv_buf_u16: []u16,
+    conv_buf_v16: []u16,
+    conv_buf_u8: []u8,
+    conv_buf_v8: []u8,
+};
+
+pub export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*SwsContext {
+    if (src_w < 1 or src_h < 1 or dst_w < 1 or dst_h < 1) return null;
+    if (src_fmt < 0 or src_fmt > 9 or dst_fmt < 0 or dst_fmt > 9) return null;
+
+    const flags: u32 = switch (algo) {
+        SWS_ALGO_NEAREST => SWS_POINT,
+        SWS_ALGO_BICUBIC => SWS_BICUBIC,
+        else => SWS_BILINEAR,
+    };
+
+    const src_range: u1 = if (src_fmt == SWS_FMT_GRAY8) 1 else 0;
+    const dst_range: u1 = if (dst_fmt == SWS_FMT_GRAY8) 1 else 0;
+
+    const src_sub = getChromaSubSample(src_fmt);
+    const dst_sub = getChromaSubSample(dst_fmt);
+
+    var chr_src_h_sub: u3 = src_sub.h;
+    const chr_src_v_sub: u3 = src_sub.v;
+    var chr_dst_h_sub: u3 = dst_sub.h;
+    const chr_dst_v_sub: u3 = dst_sub.v;
+
+    var full_chr_h_int = false;
+    if (isAnyRGB(dst_fmt)) {
+        if ((dst_w & 1) != 0 or (chr_src_h_sub == 0 and chr_src_v_sub == 0)) {
+            full_chr_h_int = true;
+        }
+        if (!full_chr_h_int) {
+            chr_dst_h_sub = 1;
+        }
+    }
+
+    if (isAnyRGB(src_fmt) and ((dst_w >> chr_dst_h_sub) <= (src_w >> 1))) {
+        chr_src_h_sub = 1;
+    }
+
+    const chr_src_w = ceilRshift(src_w, chr_src_h_sub);
+    const chr_src_h = ceilRshift(src_h, chr_src_v_sub);
+    const chr_dst_w = ceilRshift(dst_w, chr_dst_h_sub);
+    const chr_dst_h = ceilRshift(dst_h, chr_dst_v_sub);
+
+    const lum_x_inc: i32 = @intCast(@divTrunc((@as(i64, src_w) << 16) + (dst_w >> 1), dst_w));
+    const lum_y_inc: i32 = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+    const chr_x_inc: i32 = @intCast(@divTrunc((@as(i64, chr_src_w) << 16) + (chr_dst_w >> 1), chr_dst_w));
+    const chr_y_inc: i32 = @intCast(@divTrunc((@as(i64, chr_src_h) << 16) + (chr_dst_h >> 1), chr_dst_h));
+
+    const needs_hcscale = !(src_fmt == SWS_FMT_GRAY8 or dst_fmt == SWS_FMT_GRAY8);
+    const need_alpha = isAlpha(src_fmt) and isAlpha(dst_fmt);
+
+    const h_lum = initFilter(lum_x_inc, src_w, dst_w, 1, 1 << 14, flags, 128, 128) catch return null;
+    errdefer {
+        allocator.free(h_lum.filter);
+        allocator.free(h_lum.pos);
+    }
+    const h_chr = initFilter(chr_x_inc, chr_src_w, chr_dst_w, 1, 1 << 14, flags, 128, 128) catch return null;
+    errdefer {
+        allocator.free(h_chr.filter);
+        allocator.free(h_chr.pos);
+    }
+    const v_lum = initFilter(lum_y_inc, src_h, dst_h, 1, 1 << 12, flags, 128, 128) catch return null;
+    errdefer {
+        allocator.free(v_lum.filter);
+        allocator.free(v_lum.pos);
+    }
+    const v_chr = initFilter(chr_y_inc, chr_src_h, chr_dst_h, 1, 1 << 12, flags, 128, 128) catch return null;
+    errdefer {
+        allocator.free(v_chr.filter);
+        allocator.free(v_chr.pos);
+    }
+
+    const lum_ring_size: usize = @intCast(@max(v_lum.size + 4, 8));
+    const chr_ring_size: usize = @intCast(@max(v_chr.size + 4, 8));
+    const lum_stride: usize = (@as(usize, @intCast(dst_w)) * 3 + 31) & ~@as(usize, 15);
+    const chr_stride: usize = (@as(usize, @intCast(chr_dst_w)) + 15) & ~@as(usize, 15);
+
+    const lum_buf = allocator.alloc(i16, lum_ring_size * lum_stride) catch return null;
+    errdefer allocator.free(lum_buf);
+    const alp_buf = allocator.alloc(i16, if (need_alpha) lum_ring_size * lum_stride else 1) catch return null;
+    errdefer allocator.free(alp_buf);
+    const chr_u_buf = allocator.alloc(i16, chr_ring_size * chr_stride) catch return null;
+    errdefer allocator.free(chr_u_buf);
+    const chr_v_buf = allocator.alloc(i16, chr_ring_size * chr_stride) catch return null;
+    errdefer allocator.free(chr_v_buf);
+
+    const lum_row_tags = allocator.alloc(i32, lum_ring_size) catch return null;
+    errdefer allocator.free(lum_row_tags);
+    const chr_row_tags = allocator.alloc(i32, chr_ring_size) catch return null;
+    errdefer allocator.free(chr_row_tags);
+
+    const src_w_u: usize = @intCast(src_w + 16);
+    const conv_buf_u16 = allocator.alloc(u16, src_w_u) catch return null;
+    errdefer allocator.free(conv_buf_u16);
+    const conv_buf_v16 = allocator.alloc(u16, src_w_u) catch return null;
+    errdefer allocator.free(conv_buf_v16);
+    const conv_buf_u8 = allocator.alloc(u8, src_w_u) catch return null;
+    errdefer allocator.free(conv_buf_u8);
+    const conv_buf_v8 = allocator.alloc(u8, src_w_u) catch return null;
+    errdefer allocator.free(conv_buf_v8);
+
+    const ctx = allocator.create(SwsContext) catch return null;
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .flags = flags,
+        .src_range = src_range,
+        .dst_range = dst_range,
+        .chr_src_h_sub = chr_src_h_sub,
+        .chr_src_v_sub = chr_src_v_sub,
+        .chr_dst_h_sub = chr_dst_h_sub,
+        .chr_dst_v_sub = chr_dst_v_sub,
+        .full_chr_h_int = full_chr_h_int,
+        .needs_hcscale = needs_hcscale,
+        .need_alpha = need_alpha,
+        .chr_src_w = chr_src_w,
+        .chr_src_h = chr_src_h,
+        .chr_dst_w = chr_dst_w,
+        .chr_dst_h = chr_dst_h,
+        .lum_x_inc = lum_x_inc,
+        .lum_y_inc = lum_y_inc,
+        .chr_x_inc = chr_x_inc,
+        .chr_y_inc = chr_y_inc,
+        .h_lum = h_lum,
+        .h_chr = h_chr,
+        .v_lum = v_lum,
+        .v_chr = v_chr,
+        .lum_buf = lum_buf,
+        .alp_buf = alp_buf,
+        .chr_u_buf = chr_u_buf,
+        .chr_v_buf = chr_v_buf,
+        .lum_row_tags = lum_row_tags,
+        .chr_row_tags = chr_row_tags,
+        .lum_ring_size = lum_ring_size,
+        .chr_ring_size = chr_ring_size,
+        .lum_stride = lum_stride,
+        .chr_stride = chr_stride,
+        .conv_buf_u16 = conv_buf_u16,
+        .conv_buf_v16 = conv_buf_v16,
+        .conv_buf_u8 = conv_buf_u8,
+        .conv_buf_v8 = conv_buf_v8,
+    };
+    return ctx;
+}
+
+pub export fn swscale_destroy(ctx_opt: ?*SwsContext) void {
+    const ctx = ctx_opt orelse return;
+    allocator.free(ctx.h_lum.filter);
+    allocator.free(ctx.h_lum.pos);
+    allocator.free(ctx.h_chr.filter);
+    allocator.free(ctx.h_chr.pos);
+    allocator.free(ctx.v_lum.filter);
+    allocator.free(ctx.v_lum.pos);
+    allocator.free(ctx.v_chr.filter);
+    allocator.free(ctx.v_chr.pos);
+    allocator.free(ctx.lum_buf);
+    allocator.free(ctx.alp_buf);
+    allocator.free(ctx.chr_u_buf);
+    allocator.free(ctx.chr_v_buf);
+    allocator.free(ctx.lum_row_tags);
+    allocator.free(ctx.chr_row_tags);
+    allocator.free(ctx.conv_buf_u16);
+    allocator.free(ctx.conv_buf_v16);
+    allocator.free(ctx.conv_buf_u8);
+    allocator.free(ctx.conv_buf_v8);
+    allocator.destroy(ctx);
+}
+
+inline fn strideOffset(base: [*]const u8, row: i32, stride: c_int) [*]const u8 {
+    const off: isize = @as(isize, row) * @as(isize, stride);
+    return if (off >= 0) base + @as(usize, @intCast(off)) else base - @as(usize, @intCast(-off));
+}
+
+inline fn strideOffsetMut(base: [*]u8, row: i32, stride: c_int) [*]u8 {
+    const off: isize = @as(isize, row) * @as(isize, stride);
+    return if (off >= 0) base + @as(usize, @intCast(off)) else base - @as(usize, @intCast(-off));
+}
+
+inline fn yuvTableLookup(idx: i32) u8 {
+    return clipU8((idx * 76309 - 1304898) >> 16);
+}
+
+inline fn yuvToRgbPair(
+    y1: i32,
+    y2: i32,
+    u_raw: i32,
+    v_raw: i32,
+    a1: u8,
+    a2: u8,
+    comptime dst_fmt: c_int,
+    dest: [*]u8,
+) void {
+    const u: i32 = @max(0, @min(255, u_raw));
+    const v: i32 = @max(0, @min(255, v_raw));
+    const off_r: i32 = -175 + ((v * 89830) >> 16);
+    const off_b: i32 = -221 + ((u * 113537) >> 16);
+    const off_g: i32 = 134 + ((u * -22049) >> 16) + ((v * -45756) >> 16);
+
+    const r1 = yuvTableLookup(y1 + off_r);
+    const g1 = yuvTableLookup(y1 + off_g);
+    const b1 = yuvTableLookup(y1 + off_b);
+
+    const r2 = yuvTableLookup(y2 + off_r);
+    const g2 = yuvTableLookup(y2 + off_g);
+    const b2 = yuvTableLookup(y2 + off_b);
+
+    switch (dst_fmt) {
+        SWS_FMT_RGB24 => {
+            dest[0] = r1;
+            dest[1] = g1;
+            dest[2] = b1;
+            dest[3] = r2;
+            dest[4] = g2;
+            dest[5] = b2;
+        },
+        SWS_FMT_BGR24 => {
+            dest[0] = b1;
+            dest[1] = g1;
+            dest[2] = r1;
+            dest[3] = b2;
+            dest[4] = g2;
+            dest[5] = r2;
+        },
+        SWS_FMT_RGBA => {
+            dest[0] = r1;
+            dest[1] = g1;
+            dest[2] = b1;
+            dest[3] = a1;
+            dest[4] = r2;
+            dest[5] = g2;
+            dest[6] = b2;
+            dest[7] = a2;
+        },
+        SWS_FMT_BGRA => {
+            dest[0] = b1;
+            dest[1] = g1;
+            dest[2] = r1;
+            dest[3] = a1;
+            dest[4] = b2;
+            dest[5] = g2;
+            dest[6] = r2;
+            dest[7] = a2;
+        },
+        else => unreachable,
+    }
+}
+
+inline fn yuvToRgbFullPixel(
+    y_in: i32,
+    u_in: i32,
+    v_in: i32,
+    a_in: u8,
+    src_range: u1,
+    dst_fmt: c_int,
+    dest: [*]u8,
+) void {
+    const y_offset: i32 = if (src_range == 1) 0 else 8192;
+    const y_coeff: i32 = if (src_range == 1) 8192 else 9539;
+    const v2r: i32 = if (src_range == 1) 11485 else 13075;
+    const v2g: i32 = if (src_range == 1) -5850 else -6660;
+    const u2g: i32 = if (src_range == 1) -2819 else -3209;
+    const u2b: i32 = if (src_range == 1) 14516 else 16525;
+
+    const Y: i32 = (y_in - y_offset) * y_coeff + (1 << 21);
+    const R: u8 = clipU8((Y + v_in * v2r) >> 22);
+    const G: u8 = clipU8((Y + v_in * v2g + u_in * u2g) >> 22);
+    const B: u8 = clipU8((Y + u_in * u2b) >> 22);
+
+    switch (dst_fmt) {
+        SWS_FMT_RGB24 => {
+            dest[0] = R;
+            dest[1] = G;
+            dest[2] = B;
+        },
+        SWS_FMT_BGR24 => {
+            dest[0] = B;
+            dest[1] = G;
+            dest[2] = R;
+        },
+        SWS_FMT_RGBA => {
+            dest[0] = R;
+            dest[1] = G;
+            dest[2] = B;
+            dest[3] = a_in;
+        },
+        SWS_FMT_BGRA => {
+            dest[0] = B;
+            dest[1] = G;
+            dest[2] = R;
+            dest[3] = a_in;
+        },
+        else => unreachable,
+    }
+}
+
+inline fn mulhiI16(a: @Vector(16, i16), b: @Vector(16, i16)) @Vector(16, i16) {
+    const prod: @Vector(16, i32) = @as(@Vector(16, i32), a) * @as(@Vector(16, i32), b);
+    return @intCast(prod >> @splat(16));
+}
+
+inline fn mulhiU16(a: @Vector(16, u16), b: @Vector(16, u16)) @Vector(16, u16) {
+    const prod: @Vector(16, u32) = @as(@Vector(16, u32), a) * @as(@Vector(16, u32), b);
+    return @intCast(prod >> @splat(16));
+}
+
+inline fn clampPackU8(v: @Vector(16, i16)) @Vector(16, u8) {
+    const clamped = @max(@as(@Vector(16, i16), @splat(0)), @min(@as(@Vector(16, i16), @splat(255)), v));
+    return @intCast(clamped);
+}
+
+inline fn evalYuvTable16(d: @Vector(16, i16)) @Vector(16, u8) {
+    const res = d - @as(@Vector(16, i16), @splat(56)) + mulhiI16(d, @splat(10773));
+    return clampPackU8(res);
+}
