+    const c1_hi = @shuffle(u8, v2, v3, [16]i32{ 1, 5, 9, 13, ~@as(i32, 1), ~@as(i32, 5), ~@as(i32, 9), ~@as(i32, 13), 0, 0, 0, 0, 0, 0, 0, 0 });
+    const c1 = @shuffle(u8, c1_lo, c1_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+
+    const c2_lo = @shuffle(u8, v0, v1, [16]i32{ 2, 6, 10, 14, ~@as(i32, 2), ~@as(i32, 6), ~@as(i32, 10), ~@as(i32, 14), 0, 0, 0, 0, 0, 0, 0, 0 });
+    const c2_hi = @shuffle(u8, v2, v3, [16]i32{ 2, 6, 10, 14, ~@as(i32, 2), ~@as(i32, 6), ~@as(i32, 10), ~@as(i32, 14), 0, 0, 0, 0, 0, 0, 0, 0 });
+    const c2 = @shuffle(u8, c2_lo, c2_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+
+    if (is_bgr) {
+        b_out.* = c0;
+        g_out.* = c1;
+        r_out.* = c2;
+    } else {
+        r_out.* = c0;
+        g_out.* = c1;
+        b_out.* = c2;
+    }
+}
