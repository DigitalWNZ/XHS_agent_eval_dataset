+        for x in range(dw):
+            px = h_pos[x]
+            w_row = h_weights[x]
+            acc = 0
+            for j in range(h_size):
+                acc += int(src_grid[y, px + j]) * w_row[j]
+            tmp_grid[y, x] = (acc + 8192) >> 14
+
+    dst_grid = np.zeros((dh, dw), dtype=np.uint8)
+    for y in range(dh):
+        py = v_pos[y]
+        w_col = v_weights[y]
+        for x in range(dw):
+            acc = 0
+            for j in range(v_size):
+                acc += int(tmp_grid[py + j, x]) * w_col[j]
+            val = (acc + 8192) >> 14
+            dst_grid[y, x] = np.clip(val, 0, 255)
+
+    return dst_grid.tobytes()
+
+print("Scaling filter initialized.")
+
+all_wls = workloads.correctness_workloads()
+scale_wls = [w for w in all_wls if w["scaling"]]
+
+for wl in scale_wls:
+    if wl["src_fmt"] != wl["dst_fmt"]:
+        continue
+    k = wl["key"]
+    label = wl["label"]
+    ref_path = f"/tmp/ref_{k}.raw"
+    cmd = workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path)
+    subprocess.run(cmd, capture_output=True)
+    with open(ref_path, "rb") as f: ref_bytes = f.read()
+
+    # Get input planes
+    src_wl = dict(wl)
+    src_wl["dst_w"] = wl["src_w"]
+    src_wl["dst_h"] = wl["src_h"]
+    src_wl["scaling"] = False
+    src_path = f"/tmp/src_{k}.raw"
+    subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", src_wl, 1, src_path), capture_output=True)
+    with open(src_path, "rb") as f: src_bytes = f.read()
+
+    src_planes = workloads.split_planes(src_bytes, wl["src_fmt"], wl["src_w"], wl["src_h"])
+    cand_planes = []
+    for p_idx, p_bytes in enumerate(src_planes):
+        sw = wl["src_w"] if p_idx == 0 or wl["src_fmt"] not in (workloads.YUV420P, workloads.YUV422P) else wl["src_w"] // 2
+        sh = wl["src_h"] if p_idx == 0 or wl["src_fmt"] != workloads.YUV420P else wl["src_h"] // 2
+        dw = wl["dst_w"] if p_idx == 0 or wl["dst_fmt"] not in (workloads.YUV420P, workloads.YUV422P) else wl["dst_w"] // 2
+        dh = wl["dst_h"] if p_idx == 0 or wl["dst_fmt"] != workloads.YUV420P else wl["dst_h"] // 2
+
+        if wl["src_fmt"] in (workloads.RGB24, workloads.BGR24):
+            sw *= 3; dw *= 3
+        elif wl["src_fmt"] in (workloads.RGBA, workloads.BGRA):
+            sw *= 4; dw *= 4
+
+        scaled_p = scale_plane_2pass(p_bytes, sw, sh, dw, dh, wl["algo"])
+        cand_planes.append(scaled_p)
+
+    cand_bytes = b"".join(cand_planes)
+    res = workloads.grade(ref_bytes, cand_bytes, wl["dst_fmt"], wl["dst_w"], wl["dst_h"], True)
+    print(f"{k} ({label}): status={res['status']}, PSNR={res['min_psnr']} dB (bar: {res['bar']})")
