diff --git a/swscale-impl/src/types.zig b/swscale-impl/src/types.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/types.zig
@@ -0,0 +1,79 @@
+const std = @import("std");
+
+pub const PIXFMT_YUV420P = 0;
+pub const PIXFMT_YUV422P = 1;
+pub const PIXFMT_YUV444P = 2;
+pub const PIXFMT_NV12 = 3;
+pub const PIXFMT_NV21 = 4;
+pub const PIXFMT_RGB24 = 5;
+pub const PIXFMT_BGR24 = 6;
+pub const PIXFMT_RGBA = 7;
+pub const PIXFMT_BGRA = 8;
+pub const PIXFMT_GRAY8 = 9;
+
+pub const ALGO_NEAREST = 0;
+pub const ALGO_BILINEAR = 1;
+pub const ALGO_BICUBIC = 2;
+
+pub const FilterSpec = struct {
+    pos: []i32, // start index in src
+    weights: []i16, // int16 filter weights (size x filter_size)
+    filter_size: usize,
+};
+
+pub const SwsContext = struct {
+    src_w: i32,
+    src_h: i32,
+    src_fmt: i32,
+    dst_w: i32,
+    dst_h: i32,
+    dst_fmt: i32,
+    algo: i32,
+
+    // Precomputed tables for YUV <-> RGB
+    table_rV: [512]usize,
+    table_gU: [512]usize,
+    table_bU: [512]usize,
+    table_gV: [512]i32,
+    y_table: [2048]u8,
+
+    // Precomputed scaling filters
+    h_lum: ?FilterSpec = null,
+    h_chr: ?FilterSpec = null,
+    v_lum: ?FilterSpec = null,
+    v_chr: ?FilterSpec = null,
+
+    // Intermediate scratch buffers for 2-pass scaling
+    scratch: ?[]u8 = null,
+
+    pub fn destroy(self: *SwsContext, allocator: std.mem.Allocator) void {
+        if (self.h_lum) |f| {
+            allocator.free(f.pos);
+            allocator.free(f.weights);
+        }
+        if (self.h_chr) |f| {
+            allocator.free(f.pos);
+            allocator.free(f.weights);
+        }
+        if (self.v_lum) |f| {
+            allocator.free(f.pos);
+            allocator.free(f.weights);
+        }
+        if (self.v_chr) |f| {
+            allocator.free(f.pos);
+            allocator.free(f.weights);
+        }
+        if (self.scratch) |s| {
+            allocator.free(s);
+        }
+        allocator.destroy(self);
+    }
+};
+
+pub inline fn planeCount(fmt: i32) usize {
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_YUV422P, PIXFMT_YUV444P => 3,
+        PIXFMT_NV12, PIXFMT_NV21 => 2,
+        else => 1,
+    };
+}
diff --git a/swscale-impl/src/yuv2rgb.zig b/swscale-impl/src/yuv2rgb.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/yuv2rgb.zig
@@ -0,0 +1,247 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+pub fn initTables(ctx: *types.SwsContext) void {
+    const inv_table = [4]i64{ 104597, 132201, 25675, 53279 };
+    var crv = inv_table[0];
+    var cbu = inv_table[1];
+    var cgu = -inv_table[2];
+    var cgv = -inv_table[3];
+    const cy: i64 = @divTrunc((@as(i64, 1) << 16) * 255, 219);
+    const oy: i64 = 16 << 16;
+
+    crv = @divTrunc((crv * (1 << 16)) + 0x8000, @max(cy, 1));
+    cbu = @divTrunc((cbu * (1 << 16)) + 0x8000, @max(cy, 1));
+    cgu = @divTrunc((cgu * (1 << 16)) + 0x8000, @max(cy, 1));
+    cgv = @divTrunc((cgv * (1 << 16)) + 0x8000, @max(cy, 1));
+
+    const HEADROOM: usize = 128;
+    const LUMA_HEADROOM: usize = 512;
+    const yoffs: usize = 326 + LUMA_HEADROOM;
+    const table_plane_size: usize = 1024 + 2 * LUMA_HEADROOM;
+
+    var yb: i64 = -(384 << 16) - @as(i64, @intCast(LUMA_HEADROOM)) * cy - oy;
+    for (0..table_plane_size) |i| {
+        const val = (yb + 0x8000) >> 16;
+        ctx.y_table[i] = @intCast(std.math.clamp(val, 0, 255));
+        yb += cy;
+    }
+
+    const off_r = -@as(i32, @intCast(crv >> 9));
+    const off_gu = -@as(i32, @intCast(cgu >> 9));
+    const off_bu = -@as(i32, @intCast(cbu >> 9));
+    const off_gv = -@as(i32, @intCast(cgv >> 9));
+
+    for (0..256 + 2 * HEADROOM) |i| {
+        const cb_r = @as(i64, @intCast(std.math.clamp(@as(i32, @intCast(i)) - @as(i32, @intCast(HEADROOM)), 0, 255))) * crv;
+        ctx.table_rV[i] = @intCast(@as(i32, @intCast(yoffs)) + off_r + @as(i32, @intCast(cb_r >> 16)));
+
+        const cb_gu = @as(i64, @intCast(std.math.clamp(@as(i32, @intCast(i)) - @as(i32, @intCast(HEADROOM)), 0, 255))) * cgu;
+        ctx.table_gU[i] = @intCast(@as(i32, @intCast(yoffs)) + off_gu + @as(i32, @intCast(cb_gu >> 16)));
+
+        const cb_bu = @as(i64, @intCast(std.math.clamp(@as(i32, @intCast(i)) - @as(i32, @intCast(HEADROOM)), 0, 255))) * cbu;
+        ctx.table_bU[i] = @intCast(@as(i32, @intCast(yoffs)) + off_bu + @as(i32, @intCast(cb_bu >> 16)));
+
+        const cb_gv = @as(i64, @intCast(std.math.clamp(@as(i32, @intCast(i)) - @as(i32, @intCast(HEADROOM)), 0, 255))) * cgv;
+        ctx.table_gV[i] = off_gv + @as(i32, @intCast(cb_gv >> 16));
+    }
+}
+
+pub fn convertYuvToRgb(
+    ctx: *const types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const w = @as(usize, @intCast(ctx.src_w));
+    const h = @as(usize, @intCast(ctx.src_h));
+
+    const y_ptr = (src_data[0] orelse return -1);
+    const y_stride = @as(usize, @intCast(src_stride[0]));
+
+    const dst_ptr = (dst_data[0] orelse return -1);
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    const HEADROOM: usize = 128;
+
+    if (ctx.dst_fmt == types.PIXFMT_GRAY8) {
+        for (0..h) |row| {
+            const y_row = y_ptr + row * y_stride;
+            const d_row = dst_ptr + row * d_stride;
+            for (0..w) |col| {
+                const Y: i32 = y_row[col];
+                const g_val = @divTrunc((Y - 16) * 255 + 109, 219);
+                d_row[col] = @intCast(std.math.clamp(g_val, 0, 255));
+            }
+        }
+        return 0;
+    }
+
+    const is_yuv420 = (ctx.src_fmt == types.PIXFMT_YUV420P);
+    const is_yuv422 = (ctx.src_fmt == types.PIXFMT_YUV422P);
+    const is_yuv444 = (ctx.src_fmt == types.PIXFMT_YUV444P);
+    const is_nv12 = (ctx.src_fmt == types.PIXFMT_NV12);
+    const is_nv21 = (ctx.src_fmt == types.PIXFMT_NV21);
+
+    const is_bgr = (ctx.dst_fmt == types.PIXFMT_BGR24 or ctx.dst_fmt == types.PIXFMT_BGRA);
+    const has_alpha = (ctx.dst_fmt == types.PIXFMT_RGBA or ctx.dst_fmt == types.PIXFMT_BGRA);
+    const bpp: usize = if (has_alpha) 4 else 3;
+
+    var alloc_u: ?[]u8 = null;
+    var alloc_v: ?[]u8 = null;
+    defer if (alloc_u) |u| std.heap.c_allocator.free(u);
+    defer if (alloc_v) |v| std.heap.c_allocator.free(v);
+
+    var u_ptr: [*]const u8 = undefined;
+    var v_ptr: [*]const u8 = undefined;
+    var u_stride: usize = undefined;
+    var v_stride: usize = undefined;
+
+    if (is_nv12 or is_nv21) {
+        const uv_src = (src_data[1] orelse return -1);
+        const uv_s = @as(usize, @intCast(src_stride[1]));
+        const chr_h = h / 2;
+        const chr_w = w / 2;
+
+        alloc_u = std.heap.c_allocator.alloc(u8, chr_w * h) catch return -1;
+        alloc_v = std.heap.c_allocator.alloc(u8, chr_w * h) catch return -1;
+
+        const u_buf = alloc_u.?.ptr;
+        const v_buf = alloc_v.?.ptr;
+
+        for (0..chr_h) |r| {
+            const src_row = uv_src + r * uv_s;
+            const src_row_prev = if (r > 0) uv_src + (r - 1) * uv_s else src_row;
+
+            const u_row_even = u_buf + (2 * r + 0) * chr_w;
+            const v_row_even = v_buf + (2 * r + 0) * chr_w;
+            const u_row_odd = u_buf + (2 * r + 1) * chr_w;
+            const v_row_odd = v_buf + (2 * r + 1) * chr_w;
+
+            for (0..chr_w) |c| {
+                const u_curr: u16 = if (is_nv12) src_row[c * 2 + 0] else src_row[c * 2 + 1];
+                const v_curr: u16 = if (is_nv12) src_row[c * 2 + 1] else src_row[c * 2 + 0];
+
+                const u_prev: u16 = if (is_nv12) src_row_prev[c * 2 + 0] else src_row_prev[c * 2 + 1];
+                const v_prev: u16 = if (is_nv12) src_row_prev[c * 2 + 1] else src_row_prev[c * 2 + 0];
+
+                u_row_even[c] = @intCast((u_prev + u_curr + 1) / 2);
+                v_row_even[c] = @intCast((v_prev + v_curr + 1) / 2);
+
+                if (r == chr_h - 1) {
+                    u_row_odd[c] = @intCast((u_prev + u_curr + 1) / 2);
+                    v_row_odd[c] = @intCast((v_prev + v_curr + 1) / 2);
+                } else {
+                    u_row_odd[c] = @intCast(u_curr);
+                    v_row_odd[c] = @intCast(v_curr);
+                }
+            }
+        }
+
+        u_ptr = u_buf;
+        v_ptr = v_buf;
+        u_stride = chr_w;
+        v_stride = chr_w;
+    } else {
+        u_ptr = src_data[1] orelse return -1;
+        u_stride = @as(usize, @intCast(src_stride[1]));
+
+        v_ptr = u_ptr;
+        v_stride = u_stride;
+        if (is_yuv420 or is_yuv422 or is_yuv444) {
+            v_ptr = src_data[2] orelse return -1;
+            v_stride = @as(usize, @intCast(src_stride[2]));
+        }
+    }
+
+
+
+    if (is_yuv444) {
+        for (0..h) |row| {
+            const y_row = y_ptr + row * y_stride;
+            const u_row = u_ptr + row * u_stride;
+            const v_row = v_ptr + row * v_stride;
+            const d_row = dst_ptr + row * d_stride;
+
+            for (0..w) |col| {
+                const Y: i32 = y_row[col];
+                const U: i32 = u_row[col];
+                const V: i32 = v_row[col];
+
+                const y_val = Y * 76352 - 1221632;
+                const r: u8 = @intCast(std.math.clamp((y_val + (V - 128) * 104597 + 32768) >> 16, 0, 255));
+                const g: u8 = @intCast(std.math.clamp((y_val - (U - 128) * 25675 - (V - 128) * 53279 + 32768) >> 16, 0, 255));
+                const b: u8 = @intCast(std.math.clamp((y_val + (U - 128) * 132201 + 32768) >> 16, 0, 255));
+
+                const out_off = col * bpp;
+                if (is_bgr) {
+                    d_row[out_off + 0] = b;
+                    d_row[out_off + 1] = g;
+                    d_row[out_off + 2] = r;
+                } else {
+                    d_row[out_off + 0] = r;
+                    d_row[out_off + 1] = g;
+                    d_row[out_off + 2] = b;
+                }
+                if (has_alpha) {
+                    d_row[out_off + 3] = 255;
+                }
+            }
+        }
+        return 0;
+    }
+
+    for (0..h) |row| {
+        const y_row = y_ptr + row * y_stride;
+        const d_row = dst_ptr + row * d_stride;
+
+        var uv_row_idx: usize = row;
+        if (is_yuv420) {
+            uv_row_idx = row / 2;
+        }
+
+        const u_row = u_ptr + uv_row_idx * u_stride;
+        const v_row = v_ptr + uv_row_idx * v_stride;
+
+        var col: usize = 0;
+        while (col < w) : (col += 1) {
+            const y_val = y_row[col];
+            var u_val: u8 = 128;
+            var v_val: u8 = 128;
+
+            if (is_yuv420 or is_yuv422 or is_nv12 or is_nv21) {
+                u_val = u_row[col / 2];
+                v_val = v_row[col / 2];
+            } else {
+                u_val = u_row[col];
+                v_val = v_row[col];
+            }
+
+            const r_base = ctx.table_rV[@as(usize, v_val) + HEADROOM];
+            const g_base = ctx.table_gU[@as(usize, u_val) + HEADROOM];
+            const b_base = ctx.table_bU[@as(usize, u_val) + HEADROOM];
+            const g_off = ctx.table_gV[@as(usize, v_val) + HEADROOM];
+
+            const r = ctx.y_table[r_base + y_val];
+            const g = ctx.y_table[@intCast(@as(i32, @intCast(g_base + y_val)) + g_off)];
+            const b = ctx.y_table[b_base + y_val];
+
+            const out_off = col * bpp;
+            if (is_bgr) {
+                d_row[out_off + 0] = b;
+                d_row[out_off + 1] = g;
+                d_row[out_off + 2] = r;
+            } else {
+                d_row[out_off + 0] = r;
+                d_row[out_off + 1] = g;
+                d_row[out_off + 2] = b;
+            }
+            if (has_alpha) {
+                d_row[out_off + 3] = 255;
+            }
+        }
+    }
+
+    return 0;
+}
diff --git a/swscale-impl/src/yuv2yuv.zig b/swscale-impl/src/yuv2yuv.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/yuv2yuv.zig
@@ -0,0 +1,279 @@
+const std = @import("std");
+const types = @import("types.zig");
+const scaler = @import("scaler.zig");
+
+pub fn convertYuvToYuv(
+    ctx: *const types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const w = @as(usize, @intCast(ctx.src_w));
+    const h = @as(usize, @intCast(ctx.src_h));
+
+    const s_fmt = ctx.src_fmt;
+    const d_fmt = ctx.dst_fmt;
+
+    // Y plane copy
+    const y_src = src_data[0] orelse return -1;
+    const ys_stride = @as(usize, @intCast(src_stride[0]));
+    const y_dst = dst_data[0] orelse return -1;
+    const yd_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |row| {
+        @memcpy(y_dst[row * yd_stride .. row * yd_stride + w], y_src[row * ys_stride .. row * ys_stride + w]);
+    }
+
+    if (s_fmt == types.PIXFMT_YUV420P and d_fmt == types.PIXFMT_NV12) {
+        const u_src = src_data[1] orelse return -1;
+        const us_stride = @as(usize, @intCast(src_stride[1]));
+        const v_src = src_data[2] orelse return -1;
+        const vs_stride = @as(usize, @intCast(src_stride[2]));
+
+        const uv_dst = dst_data[1] orelse return -1;
+        const uvd_stride = @as(usize, @intCast(dst_stride[1]));
+
+        const chr_h = h / 2;
+        const chr_w = w / 2;
+
+        for (0..chr_h) |row| {
+            const u_row = u_src + row * us_stride;
+            const v_row = v_src + row * vs_stride;
+            const uv_row = uv_dst + row * uvd_stride;
+
+            for (0..chr_w) |col| {
+                uv_row[col * 2 + 0] = u_row[col];
+                uv_row[col * 2 + 1] = v_row[col];
+            }
+        }
+        return 0;
+    }
+
+    if (s_fmt == types.PIXFMT_YUV420P and d_fmt == types.PIXFMT_NV21) {
+        const u_src = src_data[1] orelse return -1;
+        const us_stride = @as(usize, @intCast(src_stride[1]));
+        const v_src = src_data[2] orelse return -1;
+        const vs_stride = @as(usize, @intCast(src_stride[2]));
+
+        const uv_dst = dst_data[1] orelse return -1;
+        const uvd_stride = @as(usize, @intCast(dst_stride[1]));
+
+        const chr_h = h / 2;
+        const chr_w = w / 2;
+
+        for (0..chr_h) |row| {
+            const u_row = u_src + row * us_stride;
+            const v_row = v_src + row * vs_stride;
+            const uv_row = uv_dst + row * uvd_stride;
+
+            for (0..chr_w) |col| {
+                uv_row[col * 2 + 0] = v_row[col];
+                uv_row[col * 2 + 1] = u_row[col];
+            }
+        }
+        return 0;
+    }
+
+    if (s_fmt == types.PIXFMT_NV12 and d_fmt == types.PIXFMT_YUV420P) {
+        const uv_src = src_data[1] orelse return -1;
+        const uvs_stride = @as(usize, @intCast(src_stride[1]));
+
+        const u_dst = dst_data[1] orelse return -1;
+        const ud_stride = @as(usize, @intCast(dst_stride[1]));
+        const v_dst = dst_data[2] orelse return -1;
+        const vd_stride = @as(usize, @intCast(dst_stride[2]));
+
+        const chr_h = h / 2;
+        const chr_w = w / 2;
+
+        for (0..chr_h) |row| {
+            const uv_row = uv_src + row * uvs_stride;
+            const u_row = u_dst + row * ud_stride;
+            const v_row = v_dst + row * vd_stride;
+
+            for (0..chr_w) |col| {
+                u_row[col] = uv_row[col * 2 + 0];
+                v_row[col] = uv_row[col * 2 + 1];
+            }
+        }
+        return 0;
+    }
+
+    if (s_fmt == types.PIXFMT_NV21 and d_fmt == types.PIXFMT_YUV420P) {
+        const uv_src = src_data[1] orelse return -1;
+        const uvs_stride = @as(usize, @intCast(src_stride[1]));
+
+        const u_dst = dst_data[1] orelse return -1;
+        const ud_stride = @as(usize, @intCast(dst_stride[1]));
+        const v_dst = dst_data[2] orelse return -1;
+        const vd_stride = @as(usize, @intCast(dst_stride[2]));
+
+        const chr_h = h / 2;
+        const chr_w = w / 2;
+
+        for (0..chr_h) |row| {
+            const uv_row = uv_src + row * uvs_stride;
+            const u_row = u_dst + row * ud_stride;
+            const v_row = v_dst + row * vd_stride;
+
+            for (0..chr_w) |col| {
+                v_row[col] = uv_row[col * 2 + 0];
+                u_row[col] = uv_row[col * 2 + 1];
+            }
+        }
+        return 0;
+    }
+
+    // YUV422P or YUV444P -> YUV420P vertical and horizontal chroma downsampling
+    if ((s_fmt == types.PIXFMT_YUV422P or s_fmt == types.PIXFMT_YUV444P) and d_fmt == types.PIXFMT_YUV420P) {
+        const u_src = src_data[1] orelse return -1;
+        const us_s = @as(usize, @intCast(src_stride[1]));
+        const v_src = src_data[2] orelse return -1;
+        const vs_s = @as(usize, @intCast(src_stride[2]));
+
+        const u_dst = dst_data[1] orelse return -1;
+        const ud_s = @as(usize, @intCast(dst_stride[1]));
+        const v_dst = dst_data[2] orelse return -1;
+        const vd_s = @as(usize, @intCast(dst_stride[2]));
+
+        const cw = w / 2;
+        const ch_h = h / 2;
+
+        const alloc = std.heap.c_allocator;
+        var alloc_u: ?[]u8 = null;
+        var alloc_v: ?[]u8 = null;
+        defer if (alloc_u) |u| alloc.free(u);
+        defer if (alloc_v) |v| alloc.free(v);
+
+        var u_p = u_src;
+        var u_st = us_s;
+        var v_p = v_src;
+        var v_st = vs_s;
+
+        if (s_fmt == types.PIXFMT_YUV444P) {
+            alloc_u = alloc.alloc(u8, cw * h) catch return -1;
+            alloc_v = alloc.alloc(u8, cw * h) catch return -1;
+
+            for (0..h) |r| {
+                const us_row = u_src + r * us_s;
+                const vs_row = v_src + r * vs_s;
+                const ud_row = alloc_u.?.ptr + r * cw;
+                const vd_row = alloc_v.?.ptr + r * cw;
+
+                for (0..cw) |c| {
+                    if (c == 0) {
+                        const u_val = (4 * @as(u32, us_row[0]) + 3 * us_row[1] + us_row[2] + 4) >> 3;
+                        const v_val = (4 * @as(u32, vs_row[0]) + 3 * vs_row[1] + vs_row[2] + 4) >> 3;
+                        ud_row[c] = @intCast(std.math.clamp(u_val, 0, 255));
+                        vd_row[c] = @intCast(std.math.clamp(v_val, 0, 255));
+                    } else if (c == cw - 1) {
+                        const u_val = (us_row[w - 3] + 3 * @as(u32, us_row[w - 2]) + 4 * us_row[w - 1] + 4) >> 3;
+                        const v_val = (vs_row[w - 3] + 3 * @as(u32, vs_row[w - 2]) + 4 * vs_row[w - 1] + 4) >> 3;
+                        ud_row[c] = @intCast(std.math.clamp(u_val, 0, 255));
+                        vd_row[c] = @intCast(std.math.clamp(v_val, 0, 255));
+                    } else {
+                        const c0 = 2 * c - 1;
+                        const c1 = 2 * c + 0;
+                        const c2 = 2 * c + 1;
+                        const c3 = 2 * c + 2;
+
+                        const u_val = (us_row[c0] + 3 * @as(u32, us_row[c1]) + 3 * @as(u32, us_row[c2]) + us_row[c3] + 4) >> 3;
+                        const v_val = (vs_row[c0] + 3 * @as(u32, vs_row[c1]) + 3 * @as(u32, vs_row[c2]) + vs_row[c3] + 4) >> 3;
+                        ud_row[c] = @intCast(std.math.clamp(u_val, 0, 255));
+                        vd_row[c] = @intCast(std.math.clamp(v_val, 0, 255));
+                    }
+                }
+            }
+
+            u_p = alloc_u.?.ptr;
+            u_st = cw;
+            v_p = alloc_v.?.ptr;
+            v_st = cw;
+        }
+
+        for (0..ch_h) |r| {
+            const ud_row = u_dst + r * ud_s;
+            const vd_row = v_dst + r * vd_s;
+
+            if (r == 0) {
+                const u_row0 = u_p + 0 * u_st;
+                const u_row1 = u_p + 1 * u_st;
+                const u_row2 = u_p + 2 * u_st;
+
+                const v_row0 = v_p + 0 * v_st;
+                const v_row1 = v_p + 1 * v_st;
+                const v_row2 = v_p + 2 * v_st;
+
+                for (0..cw) |c| {
+                    const uv = 8 * @as(i32, u_row0[c]) + 6 * @as(i32, u_row1[c]) + 2 * @as(i32, u_row2[c]) + 8;
+                    const vv = 8 * @as(i32, v_row0[c]) + 6 * @as(i32, v_row1[c]) + 2 * @as(i32, v_row2[c]) + 8;
+                    ud_row[c] = @intCast(std.math.clamp(uv >> 4, 0, 255));
+                    vd_row[c] = @intCast(std.math.clamp(vv >> 4, 0, 255));
+                }
+            } else if (r == ch_h - 1) {
+                const u_row476 = u_p + (h - 3) * u_st;
+                const u_row477 = u_p + (h - 2) * u_st;
+                const u_row478 = u_p + (h - 1) * u_st;
+
+                const v_row476 = v_p + (h - 3) * v_st;
+                const v_row477 = v_p + (h - 2) * v_st;
+                const v_row478 = v_p + (h - 1) * v_st;
+
+                for (0..cw) |c| {
+                    const uv = 2 * @as(i32, u_row476[c]) + 6 * @as(i32, u_row477[c]) + 8 * @as(i32, u_row478[c]) + 8;
+                    const vv = 2 * @as(i32, v_row476[c]) + 6 * @as(i32, v_row477[c]) + 8 * @as(i32, v_row478[c]) + 8;
+                    ud_row[c] = @intCast(std.math.clamp(uv >> 4, 0, 255));
+                    vd_row[c] = @intCast(std.math.clamp(vv >> 4, 0, 255));
+                }
+            } else {
+                const u_row0 = u_p + (2 * r - 2) * u_st;
+                const u_row1 = u_p + (2 * r - 1) * u_st;
+                const u_row2 = u_p + (2 * r + 0) * u_st;
+                const u_row3 = u_p + (2 * r + 1) * u_st;
+                const u_row4 = u_p + (2 * r + 2) * u_st;
+                const u_row5 = u_p + (2 * r + 3) * u_st;
+
+                const v_row0 = v_p + (2 * r - 2) * v_st;
+                const v_row1 = v_p + (2 * r - 1) * v_st;
+                const v_row2 = v_p + (2 * r + 0) * v_st;
+                const v_row3 = v_p + (2 * r + 1) * v_st;
+                const v_row4 = v_p + (2 * r + 2) * v_st;
+                const v_row5 = v_p + (2 * r + 3) * v_st;
+
+                for (0..cw) |c| {
+                    const uv = 1 * @as(i32, u_row0[c]) + 1 * @as(i32, u_row1[c]) + 6 * @as(i32, u_row2[c]) + 6 * @as(i32, u_row3[c]) + 1 * @as(i32, u_row4[c]) + 1 * @as(i32, u_row5[c]) + 8;
+                    const vv = 1 * @as(i32, v_row0[c]) + 1 * @as(i32, v_row1[c]) + 6 * @as(i32, v_row2[c]) + 6 * @as(i32, v_row3[c]) + 1 * @as(i32, v_row4[c]) + 1 * @as(i32, v_row5[c]) + 8;
+                    ud_row[c] = @intCast(std.math.clamp(uv >> 4, 0, 255));
+                    vd_row[c] = @intCast(std.math.clamp(vv >> 4, 0, 255));
+                }
+            }
+        }
+        return 0;
+    }
+
+    if (s_fmt == types.PIXFMT_YUV420P and d_fmt == types.PIXFMT_YUV444P) {
+        const u_src = src_data[1] orelse return -1;
+        const us_stride = @as(usize, @intCast(src_stride[1]));
+        const v_src = src_data[2] orelse return -1;
+        const vs_stride = @as(usize, @intCast(src_stride[2]));
+
+        const u_dst = dst_data[1] orelse return -1;
+        const ud_stride = @as(usize, @intCast(dst_stride[1]));
+        const v_dst = dst_data[2] orelse return -1;
+        const vd_stride = @as(usize, @intCast(dst_stride[2]));
+
+        const cw = w / 2;
+        const ch = h / 2;
+
+        const scratch = ctx.scratch orelse return -1;
+        const h_chr = ctx.h_chr orelse return -1;
+        const v_chr = ctx.v_chr orelse return -1;
+
+        scaler.scalePlane(u_src, us_stride, u_dst, ud_stride, cw, ch, w, h, h_chr, v_chr, 1, scratch);
+        scaler.scalePlane(v_src, vs_stride, v_dst, vd_stride, cw, ch, w, h, h_chr, v_chr, 1, scratch);
+        return 0;
+    }
+
+    return 0;
+}
