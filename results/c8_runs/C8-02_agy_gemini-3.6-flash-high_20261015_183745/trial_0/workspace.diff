+import os, sys, subprocess, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["key"] == "c018"][0]
+ref_path = "/tmp/c018_ref.raw"
+cmd_ref = workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path)
+subprocess.run(cmd_ref, capture_output=True)
+with open(ref_path, "rb") as f: ref_bytes = f.read()
+
+src_ref_path = "/tmp/c018_src.raw"
+src_wl = {"key": "c018", "src_fmt": 5, "dst_fmt": 5, "src_w": 640, "src_h": 480, "dst_w": 640, "dst_h": 480, "algo": 1, "scaling": False, "label": "rgb24->rgb24"}
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", src_wl, 1, src_ref_path), capture_output=True)
+with open(src_ref_path, "rb") as f: src_bytes = f.read()
+
+rgb_img = np.frombuffer(src_bytes, dtype=np.uint8).reshape((480, 640, 3)).astype(int)
+R = rgb_img[:,:,0]; G = rgb_img[:,:,1]; B = rgb_img[:,:,2]
+
+RU = -4866; GU = -9532; BU = 14392
+RV = 14392; GV = -12062; BV = -2332
+RY = 8419; GY = 16509; BY = 3208
+
+ref_y_plane, ref_u_plane, ref_v_plane = workloads.split_planes(ref_bytes, 0, 640, 480)
+
+r_row0 = R[0::2, 0::2] + R[0::2, 1::2]
+g_row0 = G[0::2, 0::2] + G[0::2, 1::2]
+b_row0 = B[0::2, 0::2] + B[0::2, 1::2]
+
+r_row1 = R[1::2, 0::2] + R[1::2, 1::2]
+g_row1 = G[1::2, 0::2] + G[1::2, 1::2]
+b_row1 = B[1::2, 0::2] + B[1::2, 1::2]
+
+lum = (RY * R + GY * G + BY * B + 524544) >> 9
+y_calc = np.clip((lum + 32) >> 6, 0, 255).astype(np.uint8)
+
+u_off = 8389120
+for r_off in [64, 80, 96, 112, 128, 144, 160, 192, 256]:
+    u_top = (RU * r_row0 + GU * g_row0 + BU * b_row0 + u_off) >> 10
+    u_bot = (RU * r_row1 + GU * g_row1 + BU * b_row1 + u_off) >> 10
+    u_calc = np.clip((u_top + u_bot + r_off) >> 7, 0, 255).astype(np.uint8)
+
+    v_top = (RV * r_row0 + GV * g_row0 + BV * b_row0 + u_off) >> 10
+    v_bot = (RV * r_row1 + GV * g_row1 + BV * b_row1 + u_off) >> 10
+    v_calc = np.clip((v_top + v_bot + r_off) >> 7, 0, 255).astype(np.uint8)
+
+    cand_bytes = y_calc.tobytes() + u_calc.tobytes() + v_calc.tobytes()
+    res = workloads.grade(ref_bytes, cand_bytes, 0, 640, 480, False)
+    print(f"r_off={r_off:3d} -> PSNR={res['min_psnr']} dB, status={res['status']}")
