@@ -0,0 +1,35 @@
+import sys
+import numpy as np
+sys.path.insert(0, "/app")
+
+u_src = np.frombuffer(open("/tmp/input_c008_u.raw", "rb").read(), dtype=np.uint8).astype(np.float64)
+ref_420 = open("/tmp/ref_c008.raw", "rb").read()
+ref_u = np.frombuffer(ref_420[307200 : 307200 + 76800], dtype=np.uint8).astype(np.float64)
+
+u_src_grid = u_src.reshape((480, 320))
+ref_u_grid = ref_u.reshape((240, 320))
+
+out = np.zeros((240, 320))
+
+for r in range(240):
+    for c in range(320):
+        if r == 0:
+            v = (8 * u_src_grid[0, c] + 6 * u_src_grid[1, c] + 2 * u_src_grid[2, c] + 8) // 16
+        elif r == 239:
+            v = (2 * u_src_grid[477, c] + 6 * u_src_grid[478, c] + 8 * u_src_grid[479, c] + 8) // 16
+        else:
+            v = (1 * u_src_grid[2*r - 2, c] + 1 * u_src_grid[2*r - 1, c] +
+                 6 * u_src_grid[2*r + 0, c] + 6 * u_src_grid[2*r + 1, c] +
+                 1 * u_src_grid[2*r + 2, c] + 1 * u_src_grid[2*r + 3, c] + 8) // 16
+        out[r, c] = np.clip(v, 0, 255)
+
+diff = np.abs(out - ref_u_grid)
+max_diff = np.max(diff)
+matching_pixels = np.sum(diff == 0)
+total_pixels = 240 * 320
+
+import workloads
+psnr_val = workloads.psnr(ref_u.astype(np.uint8).tobytes(), out.astype(np.uint8).tobytes())
+print(f"Matching pixels: {matching_pixels} / {total_pixels} ({matching_pixels/total_pixels*100:.2f}%)")
+print(f"Max diff: {max_diff}")
+print(f"PSNR: {psnr_val:.2f} dB")
