new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_scaling_channels.py
@@ -0,0 +1,125 @@
+import os
+import sys
+import math
+import subprocess
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+def ff_init_filter(src_w, dst_w, algo):
+    x_inc = (src_w << 16) // dst_w
+    if algo == 0: # NEAREST
+        pos = []
+        weights = []
+        x_dst_in_src = (x_inc >> 1)
+        for i in range(dst_w):
+            xx = (x_dst_in_src - 0x0000 + 0x8000) >> 16
+            xx = max(0, min(src_w - 1, xx))
+            pos.append(xx)
+            weights.append([16384])
+            x_dst_in_src += x_inc
+        return pos, weights, 1
+
+    size_factor = 1 if algo == 1 else 2
+    if x_inc <= 1 << 16:
+        filter_size = 1 + size_factor
+    else:
+        filter_size = 1 + (size_factor * src_w + dst_w - 1) // dst_w
+
+    filter_size = min(filter_size, src_w)
+    filter_size = max(filter_size, 1)
+
+    pos_list = []
+    weights_list = []
+    fone = 1 << 14
+    x_dst_in_src = (x_inc >> 1)
+
+    for i in range(dst_w):
+        xx = (x_dst_in_src - (filter_size - 2) * (1 << 16)) // (1 << 17)
+        xx = max(0, min(src_w - filter_size, xx))
+        pos_list.append(xx)
+
+        row_w = []
+        sum_w = 0
+        for j in range(filter_size):
+            src_x = xx + j
+            d = abs(src_x * (1 << 17) - x_dst_in_src) << 13
+            if x_inc > 1 << 16:
+                d = d * dst_w // src_w
+            floatd = d * (1.0 / (1 << 30))
+
+            if algo == 1: # BILINEAR
+                coeff = max(0.0, 1.0 - floatd)
+            else: # BICUBIC
+                B, C = 0.0, 0.6
+                if floatd >= 2.0:
+                    coeff = 0.0
+                elif floatd < 1.0:
+                    coeff = (12.0 - 9.0*B - 6.0*C)*floatd*floatd*floatd + (-18.0 + 12.0*B + 6.0*C)*floatd*floatd + (6.0 - 2.0*B)
+                    coeff /= 6.0
+                else:
+                    coeff = (-B - 6.0*C)*floatd*floatd*floatd + (6.0*B + 30.0*C)*floatd*floatd + (-12.0*B - 48.0*C)*floatd + (8.0*B + 24.0*C)
+                    coeff /= 6.0
+
+            w_int = int(round(coeff * fone))
+            row_w.append(w_int)
+            sum_w += w_int
+
+        if sum_w > 0:
+            row_w = [int(round(w * fone / sum_w)) for w in row_w]
+        weights_list.append(row_w)
+        x_dst_in_src += x_inc
+
+    return pos_list, weights_list, filter_size
+
+def scale_grid_2pass(src_grid, dw, dh, algo):
+    sh, sw, num_channels = src_grid.shape
+    h_pos, h_weights, h_size = ff_init_filter(sw, dw, algo)
+    v_pos, v_weights, v_size = ff_init_filter(sh, dh, algo)
+
+    tmp_grid = np.zeros((sh, dw, num_channels), dtype=np.int32)
+
+    for y in range(sh):
+        for x in range(dw):
+            px = h_pos[x]
+            w_row = h_weights[x]
+            acc = np.zeros(num_channels, dtype=np.int32)
+            for j in range(h_size):
+                acc += src_grid[y, px + j].astype(np.int32) * w_row[j]
+            tmp_grid[y, x] = (acc + 8192) >> 14
+
+    dst_grid = np.zeros((dh, dw, num_channels), dtype=np.uint8)
+    for y in range(dh):
+        py = v_pos[y]
+        w_col = v_weights[y]
+        for x in range(dw):
+            acc = np.zeros(num_channels, dtype=np.int32)
+            for j in range(v_size):
+                acc += tmp_grid[py + j, x] * w_col[j]
+            val = (acc + 8192) >> 14
+            dst_grid[y, x] = np.clip(val, 0, 255)
+
+    return dst_grid
+
+# Test s000
+wl = [w for w in workloads.correctness_workloads() if w["key"] == "s000"][0]
+ref_path = "/tmp/s000_ref.raw"
+cmd = workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path)
+subprocess.run(cmd, capture_output=True)
+with open(ref_path, "rb") as f: ref_bytes = f.read()
+
+src_wl = dict(wl)
+src_wl["dst_w"] = 1280
+src_wl["dst_h"] = 720
+src_wl["scaling"] = False
+src_path = "/tmp/s000_src.raw"
+subprocess.run(workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", src_wl, 1, src_path), capture_output=True)
+with open(src_path, "rb") as f: src_bytes = f.read()
+
+src_grid = np.frombuffer(src_bytes, dtype=np.uint8).reshape((720, 1280, 3))
+cand_grid = scale_grid_2pass(src_grid, 640, 360, wl["algo"])
+cand_bytes = cand_grid.tobytes()
+
+res = workloads.grade(ref_bytes, cand_bytes, wl["dst_fmt"], wl["dst_w"], wl["dst_h"], True)
+print(f"s000: status={res['status']}, PSNR={res['min_psnr']} dB (bar: {res['bar']})")
