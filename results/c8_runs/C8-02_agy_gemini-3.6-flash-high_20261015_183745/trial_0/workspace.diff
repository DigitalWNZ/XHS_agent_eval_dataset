+import numpy as np
+import subprocess
+
+BASELINE = "/app/libswscale_public_baseline.so"
+DRIVER = "/app/driver"
+
+# Run s004 ref: yuv420p->rgb24 1280x720->640x360
+subprocess.run([DRIVER, BASELINE, "0", "5", "1280", "720", "640", "360", "1", "1", "/tmp/ref_s004.raw"])
+ref = open("/tmp/ref_s004.raw", "rb").read()
+ref_arr = np.frombuffer(ref, dtype=np.uint8).reshape((360, 640, 3))
+
+# Let's run baseline YUV420P -> YUV420P 1280x720 -> 640x360 (s005)
+subprocess.run([DRIVER, BASELINE, "0", "0", "1280", "720", "640", "360", "1", "1", "/tmp/s005_scaled_yuv.raw"])
+s005_raw = open("/tmp/s005_scaled_yuv.raw", "rb").read()
+
+# Y: 640*360 = 230400, U: 320*180 = 57600, V: 320*180 = 57600
+y_plane = np.frombuffer(s005_raw[:230400], dtype=np.uint8).reshape((360, 640))
+u_plane = np.frombuffer(s005_raw[230400:230400+57600], dtype=np.uint8).reshape((180, 320))
+v_plane = np.frombuffer(s005_raw[230400+57600:], dtype=np.uint8).reshape((180, 320))
+
+print("ref top-left 4x4 R:")
+print(ref_arr[:4, :4, 0])
+
+# Let's unpack U & V to 360x320 using NV12 vertical interpolation rule:
+u_interp = np.zeros((360, 320), dtype=np.uint8)
+v_interp = np.zeros((360, 320), dtype=np.uint8)
+
+for r in range(180):
+    u_curr = u_plane[r, :]
+    v_curr = v_plane[r, :]
+    u_prev = u_plane[r - 1, :] if r > 0 else u_curr
+    v_prev = v_plane[r - 1, :] if r > 0 else v_curr
+
+    u_interp[2 * r + 0, :] = (u_prev.astype(int) + u_curr.astype(int) + 1) // 2
+    v_interp[2 * r + 0, :] = (v_prev.astype(int) + v_curr.astype(int) + 1) // 2
+
+    if r == 179:
+        u_interp[2 * r + 1, :] = (u_prev.astype(int) + u_curr.astype(int) + 1) // 2
+        v_interp[2 * r + 1, :] = (v_prev.astype(int) + v_curr.astype(int) + 1) // 2
+    else:
+        u_interp[2 * r + 1, :] = u_curr
+        v_interp[2 * r + 1, :] = v_curr
+
+# Convert interpolated YUV422 to RGB using table or standard formula
+inv_table = [104597, 132201, 25675, 53279]
+cy = (65536 * 255) // 219
+oy = 16 * 65536
+
+out_rgb = np.zeros((360, 640, 3), dtype=np.uint8)
+for row in range(360):
+    for col in range(640):
+        Y = int(y_plane[row, col])
+        U = int(u_interp[row, col // 2])
+        V = int(v_interp[row, col // 2])
+
+        y_val = Y * 76352 - 1221632
+        r = np.clip((y_val + (V - 128) * 104597 + 32768) >> 16, 0, 255)
+        g = np.clip((y_val - (U - 128) * 25675 - (V - 128) * 53279 + 32768) >> 16, 0, 255)
+        b = np.clip((y_val + (U - 128) * 132201 + 32768) >> 16, 0, 255)
+
+        out_rgb[row, col, 0] = r
+        out_rgb[row, col, 1] = g
+        out_rgb[row, col, 2] = b
+
+print("interp RGB top-left 4x4 R:")
+print(out_rgb[:4, :4, 0])
+
+import sys; sys.path.insert(0, "/app"); import workloads
+g = workloads.grade(ref, out_rgb.tobytes(), 5, 640, 360, True)
+print("Grade with vertical chroma interpolation:", g)
