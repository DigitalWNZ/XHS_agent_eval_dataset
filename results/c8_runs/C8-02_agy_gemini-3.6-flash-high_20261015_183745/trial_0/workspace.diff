diff --git a/swscale-impl/src/test_c011_solver.py b/swscale-impl/src/test_c011_solver.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/test_c011_solver.py
@@ -0,0 +1,46 @@
+import sys
+import numpy as np
+sys.path.insert(0, "/app")
+
+u_src = np.frombuffer(open("/tmp/input_c011_u.raw", "rb").read(), dtype=np.uint8).astype(np.float64).reshape((480, 640))
+ref_420 = open("/tmp/ref_c011.raw", "rb").read()
+ref_u = np.frombuffer(ref_420[307200 : 307200 + 76800], dtype=np.uint8).astype(np.float64).reshape((240, 320))
+
+# Pass 1: Horizontal downsampling 640 -> 320 using [1, 3, 3, 1] / 8 with border clamping
+tmp_horiz = np.zeros((480, 320))
+for r in range(480):
+    for c in range(320):
+        c0 = max(0, min(639, 2*c - 1))
+        c1 = max(0, min(639, 2*c + 0))
+        c2 = max(0, min(639, 2*c + 1))
+        c3 = max(0, min(639, 2*c + 2))
+        
+        # Border clamping at left (c=0)
+        if c == 0:
+            tmp_horiz[r, c] = (4 * u_src[r, 0] + 3 * u_src[r, 1] + 1 * u_src[r, 2] + 4) // 8
+        elif c == 319:
+            tmp_horiz[r, c] = (1 * u_src[r, 637] + 3 * u_src[r, 638] + 4 * u_src[r, 639] + 4) // 8
+        else:
+            tmp_horiz[r, c] = (1 * u_src[r, c0] + 3 * u_src[r, c1] + 3 * u_src[r, c2] + 1 * u_src[r, c3] + 4) // 8
+
+# Pass 2: Vertical downsampling 480 -> 240 using [1, 1, 6, 6, 1, 1] / 16
+out = np.zeros((240, 320))
+for r in range(240):
+    for c in range(320):
+        if r == 0:
+            v = (8 * tmp_horiz[0, c] + 6 * tmp_horiz[1, c] + 2 * tmp_horiz[2, c] + 8) // 16
+        elif r == 239:
+            v = (2 * tmp_horiz[477, c] + 6 * tmp_horiz[478, c] + 8 * tmp_horiz[479, c] + 8) // 16
+        else:
+            v = (1 * tmp_horiz[2*r - 2, c] + 1 * tmp_horiz[2*r - 1, c] +
+                 6 * tmp_horiz[2*r + 0, c] + 6 * tmp_horiz[2*r + 1, c] +
+                 1 * tmp_horiz[2*r + 2, c] + 1 * tmp_horiz[2*r + 3, c] + 8) // 16
+        out[r, c] = np.clip(v, 0, 255)
+
+import workloads
+psnr_val = workloads.psnr(ref_u.astype(np.uint8).tobytes(), out.astype(np.uint8).tobytes())
+diff = np.abs(out - ref_u)
+matching_pixels = np.sum(diff == 0)
+total_pixels = 240 * 320
+print(f"c011 Matching pixels: {matching_pixels} / {total_pixels} ({matching_pixels/total_pixels*100:.2f}%)")
+print(f"c011 PSNR: {psnr_val:.2f} dB")
