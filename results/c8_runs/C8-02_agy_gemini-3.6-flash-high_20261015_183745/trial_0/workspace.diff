@@ -0,0 +1,24 @@
+import os, sys, subprocess, ctypes, numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["key"] == "c000"][0]
+ref_path = "/tmp/c000_ref.raw"
+cand_path = "/tmp/c000_cand.raw"
+
+cmd_ref = workloads.driver_argv("/app/driver", "/app/libswscale_public_baseline.so", wl, 1, ref_path)
+cmd_cand = workloads.driver_argv("/app/driver", "/app/swscale-impl/zig-out/lib/libswscale_candidate.so", wl, 1, cand_path)
+
+subprocess.run(cmd_ref, capture_output=True)
+subprocess.run(cmd_cand, capture_output=True)
+
+with open(ref_path, "rb") as f: ref_bytes = f.read()
+with open(cand_path, "rb") as f: cand_bytes = f.read()
+
+ref_rgb = np.frombuffer(ref_bytes, dtype=np.uint8).reshape((480, 640, 3))
+cand_rgb = np.frombuffer(cand_bytes, dtype=np.uint8).reshape((480, 640, 3))
+
+diff = np.abs(ref_rgb.astype(int) - cand_rgb.astype(int))
+print(f"c000: max_diff={diff.max()}, mean_diff={diff.mean():.4f}, MSE={np.mean(diff**2):.4f}")
+print("First pixel ref:", ref_rgb[0,0], "cand:", cand_rgb[0,0])
diff --git a/swscale-impl/src/context.zig b/swscale-impl/src/context.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/context.zig
@@ -0,0 +1,81 @@
+const std = @import("std");
+const types = @import("types.zig");
+const yuv2rgb = @import("yuv2rgb.zig");
+const scaler = @import("scaler.zig");
+
+pub fn create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*types.SwsContext {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+    if (src_fmt < 0 or src_fmt >= 10 or dst_fmt < 0 or dst_fmt >= 10) return null;
+    if (algo < 0 or algo >= 3) return null;
+
+    const ctx = std.heap.c_allocator.create(types.SwsContext) catch return null;
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .table_rV = undefined,
+        .table_gU = undefined,
+        .table_bU = undefined,
+        .table_gV = undefined,
+        .y_table = undefined,
+    };
+
+    yuv2rgb.initTables(ctx);
+
+    const is_src_sub = (src_fmt == types.PIXFMT_YUV420P or src_fmt == types.PIXFMT_YUV422P or src_fmt == types.PIXFMT_NV12 or src_fmt == types.PIXFMT_NV21);
+    const is_dst_sub = (dst_fmt == types.PIXFMT_YUV420P or dst_fmt == types.PIXFMT_YUV422P or dst_fmt == types.PIXFMT_NV12 or dst_fmt == types.PIXFMT_NV21);
+
+    const src_cw = if (is_src_sub) @divTrunc(src_w + 1, 2) else src_w;
+    const dst_cw = if (is_dst_sub) @divTrunc(dst_w + 1, 2) else dst_w;
+
+    const is_src_420 = (src_fmt == types.PIXFMT_YUV420P or src_fmt == types.PIXFMT_NV12 or src_fmt == types.PIXFMT_NV21);
+    const is_dst_420 = (dst_fmt == types.PIXFMT_YUV420P or dst_fmt == types.PIXFMT_NV12 or dst_fmt == types.PIXFMT_NV21);
+
+    const src_ch = if (is_src_420) @divTrunc(src_h + 1, 2) else src_h;
+    const dst_ch = if (is_dst_420) @divTrunc(dst_h + 1, 2) else dst_h;
+
+    const is_scaling = (src_w != dst_w or src_h != dst_h);
+    const is_chr_scaling = (src_cw != dst_cw or src_ch != dst_ch);
+
+    if (is_scaling or is_chr_scaling) {
+        ctx.h_lum = scaler.initFilter(std.heap.c_allocator, src_w, dst_w, algo, false) catch {
+            ctx.destroy(std.heap.c_allocator);
+            return null;
+        };
+        ctx.v_lum = scaler.initFilter(std.heap.c_allocator, src_h, dst_h, algo, true) catch {
+            ctx.destroy(std.heap.c_allocator);
+            return null;
+        };
+
+        ctx.h_chr = scaler.initFilter(std.heap.c_allocator, src_cw, dst_cw, algo, false) catch {
+            ctx.destroy(std.heap.c_allocator);
+            return null;
+        };
+        ctx.v_chr = scaler.initFilter(std.heap.c_allocator, src_ch, dst_ch, algo, true) catch {
+            ctx.destroy(std.heap.c_allocator);
+            return null;
+        };
+
+        const max_sh = @max(@as(usize, @intCast(src_h)), @as(usize, @intCast(src_ch)));
+        const max_dw = @max(@as(usize, @intCast(dst_w)), @as(usize, @intCast(dst_cw)));
+        const scratch_size = max_sh * max_dw * 8 * 2;
+        ctx.scratch = std.heap.c_allocator.alloc(u8, scratch_size) catch {
+            ctx.destroy(std.heap.c_allocator);
+            return null;
+        };
+    }
+
+    return ctx;
+}
