diff --git a/swscale-impl/src/test_s000_analyze.py b/swscale-impl/src/test_s000_analyze.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/test_s000_analyze.py
@@ -0,0 +1,79 @@
+import numpy as np
+
+src = open("/tmp/src_s000.raw", "rb").read()
+ref = open("/tmp/ref_s000.raw", "rb").read()
+
+src_arr = np.frombuffer(src, dtype=np.uint8).reshape((720, 1280, 3))
+ref_arr = np.frombuffer(ref, dtype=np.uint8).reshape((360, 640, 3))
+
+# Let's test bilinear upscale style 2-tap filter on 1280 -> 640:
+# sw = 1280, dw = 640. x_inc = 131072.
+# xDstInSrc = (x_inc >> 1) - 32768 = 65536 - 32768 = 32768.
+# i = 0: xx = (32768 + 32768) >> 16 = 1.
+# pos[0] = 1.
+# d = |1*65536 - 32768| = 32768.
+# coeff0 = 16384 - 8192 = 8192. coeff1 = 8192.
+
+# Let's test 2-tap filter with xDstInSrc = (x_inc >> 1) - 32768 on src_arr:
+dw = 640
+sw = 1280
+x_inc = (sw << 16) // dw
+
+pos = []
+w0 = []
+w1 = []
+xDstInSrc = (x_inc >> 1) - 32768
+for i in range(dw):
+    xx = (xDstInSrc) >> 16
+    pos.append(xx)
+    d = abs(xx * 65536 - xDstInSrc)
+    c0 = 16384 - (d * 16384) // 65536
+    c1 = 16384 - c0
+    w0.append(c0)
+    w1.append(c1)
+    xDstInSrc += x_inc
+
+print("2-tap filter pos[:4]:", pos[:4])
+print("2-tap filter w0[:4]:", w0[:4])
+print("2-tap filter w1[:4]:", w1[:4])
+
+# Pass 1: Horizontal with 2-tap
+tmp = np.zeros((720, 640, 3), dtype=np.int32)
+for x in range(dw):
+    p = pos[x]
+    w_0 = w0[x]
+    w_1 = w1[x]
+    p1 = min(p + 1, sw - 1)
+    p0 = max(p, 0)
+    tmp[:, x, :] = (src_arr[:, p0, :].astype(int) * w_0 + src_arr[:, p1, :].astype(int) * w_1) >> 7
+
+# Pass 2: Vertical with 2-tap
+v_inc = (720 << 16) // 360
+v_pos = []
+vw0 = []
+vw1 = []
+yDstInSrc = (v_inc >> 1) - 32768
+for y in range(360):
+    yy = yDstInSrc >> 16
+    v_pos.append(yy)
+    d = abs(yy * 65536 - yDstInSrc)
+    c0 = 16384 - (d * 16384) // 65536
+    c1 = 16384 - c0
+    vw0.append(c0)
+    vw1.append(c1)
+    yDstInSrc += v_inc
+
+out = np.zeros((360, 640, 3), dtype=np.uint8)
+for y in range(360):
+    p = v_pos[y]
+    w_0 = vw0[y]
+    w_1 = vw1[y]
+    p1 = min(p + 1, 720 - 1)
+    p0 = max(p, 0)
+    acc = (tmp[p0, :, :].astype(int) * w_0 + tmp[p1, :, :].astype(int) * w_1 + 262144) >> 19
+    out[y, :, :] = np.clip(acc, 0, 255)
+
+diff = np.abs(out.astype(int) - ref_arr.astype(int))
+print("2-tap filter out top-left:", out[:2, :2, 0])
+print("ref top-left:", ref_arr[:2, :2, 0])
+print("max diff 2-tap vs ref:", diff.max(), "mean diff:", diff.mean())
