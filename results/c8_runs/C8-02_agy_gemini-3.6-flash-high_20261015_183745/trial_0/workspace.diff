+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,317 @@
+const std = @import("std");
+const types = @import("types.zig");
+const context = @import("context.zig");
+const yuv2rgb = @import("yuv2rgb.zig");
+const rgb2yuv = @import("rgb2yuv.zig");
+const rgb2rgb = @import("rgb2rgb.zig");
+const yuv2yuv = @import("yuv2yuv.zig");
+const scaler = @import("scaler.zig");
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    const ctx = context.create(src_w, src_h, src_fmt, dst_w, dst_h, dst_fmt, algo) orelse return null;
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *types.SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+
+    const is_scaling = (ctx.src_w != ctx.dst_w or ctx.src_h != ctx.dst_h);
+
+    if (!is_scaling) {
+        if (ctx.src_fmt == ctx.dst_fmt) {
+            return rgb2rgb.convertRgbToRgb(ctx, src_data, src_stride, dst_data, dst_stride);
+        }
+        if (isYuv(ctx.src_fmt) and isRgbOrGray(ctx.dst_fmt)) {
+            return yuv2rgb.convertYuvToRgb(ctx, src_data, src_stride, dst_data, dst_stride);
+        }
+        if (isRgbOrGray(ctx.src_fmt) and isYuv(ctx.dst_fmt)) {
+            return rgb2yuv.convertRgbToYuv(ctx, src_data, src_stride, dst_data, dst_stride);
+        }
+        if (isRgbOrGray(ctx.src_fmt) and isRgbOrGray(ctx.dst_fmt)) {
+            return rgb2rgb.convertRgbToRgb(ctx, src_data, src_stride, dst_data, dst_stride);
+        }
+        if (isYuv(ctx.src_fmt) and isYuv(ctx.dst_fmt)) {
+            return yuv2yuv.convertYuvToYuv(ctx, src_data, src_stride, dst_data, dst_stride);
+        }
+        return -1;
+    }
+
+    // Scaling path
+    const sw = @as(usize, @intCast(ctx.src_w));
+    const sh = @as(usize, @intCast(ctx.src_h));
+    const dw = @as(usize, @intCast(ctx.dst_w));
+    const dh = @as(usize, @intCast(ctx.dst_h));
+
+    const scratch = ctx.scratch orelse return -1;
+    const h_lum = ctx.h_lum orelse return -1;
+    const v_lum = ctx.v_lum orelse return -1;
+    const h_chr = ctx.h_chr orelse return -1;
+    const v_chr = ctx.v_chr orelse return -1;
+
+    if (ctx.src_fmt == ctx.dst_fmt) {
+        if (isRgbOrGray(ctx.src_fmt)) {
+            const bpp = bytesPerPixel(ctx.src_fmt);
+            const s_ptr = src_data[0] orelse return -1;
+            const ss = @as(usize, @intCast(src_stride[0]));
+            const d_ptr = dst_data[0] orelse return -1;
+            const ds = @as(usize, @intCast(dst_stride[0]));
+
+            scaler.scalePlane(s_ptr, ss, d_ptr, ds, sw, sh, dw, dh, h_lum, v_lum, bpp, scratch);
+            return 0;
+        }
+
+        if (isYuv(ctx.src_fmt)) {
+            const num_p = types.planeCount(ctx.src_fmt);
+            for (0..num_p) |p| {
+                const s_ptr = src_data[p] orelse continue;
+                const ss = @as(usize, @intCast(src_stride[p]));
+                const d_ptr = dst_data[p] orelse continue;
+                const ds = @as(usize, @intCast(dst_stride[p]));
+
+                const is_chroma = (p > 0);
+                const h_flt = if (is_chroma) h_chr else h_lum;
+                const v_flt = if (is_chroma) v_chr else v_lum;
+
+                const p_sw = if (is_chroma and (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21)) (sw + 1) / 2 else sw;
+                const p_sh = if (is_chroma and (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21)) (sh + 1) / 2 else sh;
+                const p_dw = if (is_chroma and (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21)) (dw + 1) / 2 else dw;
+                const p_dh = if (is_chroma and (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21)) (dh + 1) / 2 else dh;
+
+                const ch: usize = if (is_chroma and (ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21)) 2 else 1;
+
+                scaler.scalePlane(s_ptr, ss, d_ptr, ds, p_sw, p_sh, p_dw, p_dh, h_flt, v_flt, ch, scratch);
+            }
+            return 0;
+        }
+    }
+
+    // Scaling with format conversion
+    if (isYuv(ctx.src_fmt) and isRgbOrGray(ctx.dst_fmt)) {
+        const alloc = std.heap.c_allocator;
+        const tmp_y = alloc.alloc(u8, dw * dh) catch return -1;
+        defer alloc.free(tmp_y);
+
+        const inter_fmt: i32 = if (ctx.src_fmt == types.PIXFMT_YUV422P)
+            types.PIXFMT_YUV422P
+        else if (ctx.src_fmt == types.PIXFMT_YUV444P)
+            types.PIXFMT_YUV444P
+        else
+            types.PIXFMT_YUV420P;
+
+        const is_inter_420 = (inter_fmt == types.PIXFMT_YUV420P);
+        const is_inter_422 = (inter_fmt == types.PIXFMT_YUV422P);
+
+        const c_dw = if (is_inter_420 or is_inter_422) (dw + 1) / 2 else dw;
+        const c_dh = if (is_inter_420) (dh + 1) / 2 else dh;
+
+        const is_src_sub = (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21);
+        const is_src_420 = (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21);
+
+        const c_sw = if (is_src_sub) (sw + 1) / 2 else sw;
+        const c_sh = if (is_src_420) (sh + 1) / 2 else sh;
+
+        const tmp_u = alloc.alloc(u8, c_dw * c_dh) catch return -1;
+        defer alloc.free(tmp_u);
+        const tmp_v = alloc.alloc(u8, c_dw * c_dh) catch return -1;
+        defer alloc.free(tmp_v);
+
+        // Scale Y plane
+        scaler.scalePlane((src_data[0] orelse return -1), @as(usize, @intCast(src_stride[0])), tmp_y.ptr, dw, sw, sh, dw, dh, h_lum, v_lum, 1, scratch);
+
+        var src_u_ptr: [*]const u8 = undefined;
+        var src_v_ptr: [*]const u8 = undefined;
+        var src_u_stride: usize = undefined;
+        var src_v_stride: usize = undefined;
+
+        var unp_u: ?[]u8 = null;
+        var unp_v: ?[]u8 = null;
+        defer if (unp_u) |u| alloc.free(u);
+        defer if (unp_v) |v| alloc.free(v);
+
+        if (ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21) {
+            unp_u = alloc.alloc(u8, c_sw * c_sh) catch return -1;
+            unp_v = alloc.alloc(u8, c_sw * c_sh) catch return -1;
+
+            const uv_src = (src_data[1] orelse return -1);
+            const uv_s = @as(usize, @intCast(src_stride[1]));
+            const is_nv12 = (ctx.src_fmt == types.PIXFMT_NV12);
+
+            for (0..c_sh) |r| {
+                const s_row = uv_src + r * uv_s;
+                const u_row = unp_u.?.ptr + r * c_sw;
+                const v_row = unp_v.?.ptr + r * c_sw;
+                for (0..c_sw) |c| {
+                    if (is_nv12) {
+                        u_row[c] = s_row[c * 2 + 0];
+                        v_row[c] = s_row[c * 2 + 1];
+                    } else {
+                        v_row[c] = s_row[c * 2 + 0];
+                        u_row[c] = s_row[c * 2 + 1];
+                    }
+                }
+            }
+
+            src_u_ptr = unp_u.?.ptr;
+            src_v_ptr = unp_v.?.ptr;
+            src_u_stride = c_sw;
+            src_v_stride = c_sw;
+        } else {
+            src_u_ptr = (src_data[1] orelse return -1);
+            src_u_stride = @as(usize, @intCast(src_stride[1]));
+            if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_YUV444P) {
+                src_v_ptr = (src_data[2] orelse return -1);
+                src_v_stride = @as(usize, @intCast(src_stride[2]));
+            }
+        }
+
+        // Scale U plane
+        scaler.scalePlane(src_u_ptr, src_u_stride, tmp_u.ptr, c_dw, c_sw, c_sh, c_dw, c_dh, h_chr, v_chr, 1, scratch);
+
+        // Scale V plane
+        if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_YUV444P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21) {
+            scaler.scalePlane(src_v_ptr, src_v_stride, tmp_v.ptr, c_dw, c_sw, c_sh, c_dw, c_dh, h_chr, v_chr, 1, scratch);
+        }
+
+        // Convert scaled YUV at dst dimensions to dst RGB format
+        var tmp_ctx = ctx.*;
+        tmp_ctx.src_w = ctx.dst_w;
+        tmp_ctx.src_h = ctx.dst_h;
+        tmp_ctx.src_fmt = inter_fmt;
+
+        const tmp_src_ptrs = [4]?[*]const u8{ tmp_y.ptr, tmp_u.ptr, tmp_v.ptr, null };
+        const tmp_src_strides = [4]c_int{ @intCast(dw), @intCast(c_dw), @intCast(c_dw), 0 };
+
+        return yuv2rgb.convertYuvToRgb(&tmp_ctx, &tmp_src_ptrs, &tmp_src_strides, dst_data, dst_stride);
+    }
+
+    if (isRgbOrGray(ctx.src_fmt) and isYuv(ctx.dst_fmt)) {
+        // Step 1: Convert RGB to YUV at src dimensions
+        const alloc = std.heap.c_allocator;
+        const tmp_y = alloc.alloc(u8, sw * sh) catch return -1;
+        const is_dst_420 = (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21);
+        const is_dst_422 = (ctx.dst_fmt == types.PIXFMT_YUV422P);
+
+        const c_sw = if (is_dst_420 or is_dst_422) sw / 2 else sw;
+        const c_sh = if (is_dst_420) sh / 2 else sh;
+
+        const is_dst_nv = (ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21);
+        const u_ch: usize = if (is_dst_nv) 2 else 1;
+        const tmp_u = alloc.alloc(u8, c_sw * c_sh * u_ch) catch return -1;
+        defer alloc.free(tmp_u);
+
+        var tmp_v: []u8 = undefined;
+        if (!is_dst_nv) {
+            tmp_v = alloc.alloc(u8, c_sw * c_sh) catch return -1;
+        } else {
+            tmp_v = tmp_u;
+        }
+        defer if (!is_dst_nv) alloc.free(tmp_v);
+
+        var tmp_ctx = ctx.*;
+        tmp_ctx.dst_w = ctx.src_w;
+        tmp_ctx.dst_h = ctx.src_h;
+
+        const tmp_dst_ptrs = [4]?[*]u8{ tmp_y.ptr, tmp_u.ptr, tmp_v.ptr, null };
+        const tmp_dst_strides = [4]c_int{ @intCast(sw), @intCast(c_sw * u_ch), @intCast(c_sw), 0 };
+
+        _ = rgb2yuv.convertRgbToYuv(&tmp_ctx, src_data, src_stride, &tmp_dst_ptrs, &tmp_dst_strides);
+
+        // Step 2: Scale YUV planes to dst dimensions
+        const c_dw = if (is_dst_420 or is_dst_422) dw / 2 else dw;
+        const c_dh = if (is_dst_420) dh / 2 else dh;
+
+        scaler.scalePlane(tmp_y.ptr, sw, (dst_data[0] orelse return -1), @as(usize, @intCast(dst_stride[0])), sw, sh, dw, dh, h_lum, v_lum, 1, scratch);
+        scaler.scalePlane(tmp_u.ptr, c_sw * u_ch, (dst_data[1] orelse return -1), @as(usize, @intCast(dst_stride[1])), c_sw, c_sh, c_dw, c_dh, h_chr, v_chr, u_ch, scratch);
+
+        if (!is_dst_nv) {
+            scaler.scalePlane(tmp_v.ptr, c_sw, (dst_data[2] orelse return -1), @as(usize, @intCast(dst_stride[2])), c_sw, c_sh, c_dw, c_dh, h_chr, v_chr, 1, scratch);
+        }
+
+        return 0;
+    }
+
+    if (isRgbOrGray(ctx.src_fmt) and isRgbOrGray(ctx.dst_fmt)) {
+        const alloc = std.heap.c_allocator;
+
+        // Step 1: Convert RGB to YUV420P at src dimensions
+        const tmp_y1 = alloc.alloc(u8, sw * sh) catch return -1;
+        defer alloc.free(tmp_y1);
+        const tmp_u1 = alloc.alloc(u8, (sw / 2) * (sh / 2)) catch return -1;
+        defer alloc.free(tmp_u1);
+        const tmp_v1 = alloc.alloc(u8, (sw / 2) * (sh / 2)) catch return -1;
+        defer alloc.free(tmp_v1);
+
+        var conv_src_ctx = ctx.*;
+        conv_src_ctx.dst_w = ctx.src_w;
+        conv_src_ctx.dst_h = ctx.src_h;
+        conv_src_ctx.dst_fmt = types.PIXFMT_YUV420P;
+
+        const tmp_dst_ptrs1 = [4]?[*]u8{ tmp_y1.ptr, tmp_u1.ptr, tmp_v1.ptr, null };
+        const tmp_dst_strides1 = [4]c_int{ @intCast(sw), @intCast(sw / 2), @intCast(sw / 2), 0 };
+
+        _ = rgb2yuv.convertRgbToYuv(&conv_src_ctx, src_data, src_stride, &tmp_dst_ptrs1, &tmp_dst_strides1);
+
+        // Step 2: Scale YUV420P planes to dst dimensions
+        const tmp_y2 = alloc.alloc(u8, dw * dh) catch return -1;
+        defer alloc.free(tmp_y2);
+        const tmp_u2 = alloc.alloc(u8, (dw / 2) * (dh / 2)) catch return -1;
+        defer alloc.free(tmp_u2);
+        const tmp_v2 = alloc.alloc(u8, (dw / 2) * (dh / 2)) catch return -1;
+        defer alloc.free(tmp_v2);
+
+        scaler.scalePlane(tmp_y1.ptr, sw, tmp_y2.ptr, dw, sw, sh, dw, dh, h_lum, v_lum, 1, scratch);
+        scaler.scalePlane(tmp_u1.ptr, sw / 2, tmp_u2.ptr, dw / 2, sw / 2, sh / 2, dw / 2, dh / 2, h_chr, v_chr, 1, scratch);
+        scaler.scalePlane(tmp_v1.ptr, sw / 2, tmp_v2.ptr, dw / 2, sw / 2, sh / 2, dw / 2, dh / 2, h_chr, v_chr, 1, scratch);
+
+        // Step 3: Convert scaled YUV420P to dst RGB format at dst dimensions
+        var conv_dst_ctx = ctx.*;
+        conv_dst_ctx.src_w = ctx.dst_w;
+        conv_dst_ctx.src_h = ctx.dst_h;
+        conv_dst_ctx.src_fmt = types.PIXFMT_YUV420P;
+
+        const tmp_src_ptrs2 = [4]?[*]const u8{ tmp_y2.ptr, tmp_u2.ptr, tmp_v2.ptr, null };
+        const tmp_src_strides2 = [4]c_int{ @intCast(dw), @intCast(dw / 2), @intCast(dw / 2), 0 };
+
+        return yuv2rgb.convertYuvToRgb(&conv_dst_ctx, &tmp_src_ptrs2, &tmp_src_strides2, dst_data, dst_stride);
+    }
+
+    return -1;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *types.SwsContext = @ptrCast(@alignCast(ptr));
+        ctx.destroy(std.heap.c_allocator);
+    }
+}
+
+fn isYuv(fmt: i32) bool {
+    return fmt <= types.PIXFMT_NV21;
+}
+
+fn isRgbOrGray(fmt: i32) bool {
+    return fmt >= types.PIXFMT_RGB24;
+}
+
+fn bytesPerPixel(fmt: i32) usize {
+    return switch (fmt) {
+        types.PIXFMT_RGBA, types.PIXFMT_BGRA => 4,
+        types.PIXFMT_RGB24, types.PIXFMT_BGR24 => 3,
+        types.PIXFMT_GRAY8 => 1,
+        else => 1,
+    };
+}
diff --git a/swscale-impl/src/rgb2rgb.zig b/swscale-impl/src/rgb2rgb.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/rgb2rgb.zig
@@ -0,0 +1,120 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+pub fn convertRgbToRgb(
+    ctx: *const types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const w = @as(usize, @intCast(ctx.src_w));
+    const h = @as(usize, @intCast(ctx.src_h));
+
+    const s_ptr = src_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+
+    const d_ptr = dst_data[0] orelse return -1;
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    const src_fmt = ctx.src_fmt;
+    const dst_fmt = ctx.dst_fmt;
+
+    if (src_fmt == dst_fmt) {
+        for (0..h) |row| {
+            @memcpy(d_ptr[row * d_stride .. row * d_stride + w * bytesPerPixel(src_fmt)], s_ptr[row * s_stride .. row * s_stride + w * bytesPerPixel(src_fmt)]);
+        }
+        return 0;
+    }
+
+    if (dst_fmt == types.PIXFMT_GRAY8) {
+        const src_bpp = bytesPerPixel(src_fmt);
+        const is_bgr = (src_fmt == types.PIXFMT_BGR24 or src_fmt == types.PIXFMT_BGRA);
+
+        for (0..h) |row| {
+            const s_row = s_ptr + row * s_stride;
+            const d_row = d_ptr + row * d_stride;
+            for (0..w) |col| {
+                const in_off = col * src_bpp;
+                const r: i32 = if (is_bgr) s_row[in_off + 2] else s_row[in_off + 0];
+                const g: i32 = s_row[in_off + 1];
+                const b: i32 = if (is_bgr) s_row[in_off + 0] else s_row[in_off + 2];
+
+                const gray: u8 = @intCast(std.math.clamp((19595 * r + 38470 * g + 7471 * b + 32768) >> 16, 0, 255));
+                d_row[col] = gray;
+            }
+        }
+        return 0;
+    }
+
+    if (src_fmt == types.PIXFMT_GRAY8) {
+        const dst_bpp = bytesPerPixel(dst_fmt);
+        const has_alpha = (dst_fmt == types.PIXFMT_RGBA or dst_fmt == types.PIXFMT_BGRA);
+
+        for (0..h) |row| {
+            const s_row = s_ptr + row * s_stride;
+            const d_row = d_ptr + row * d_stride;
+            for (0..w) |col| {
+                const y = s_row[col];
+                const out_off = col * dst_bpp;
+                d_row[out_off + 0] = y;
+                d_row[out_off + 1] = y;
+                d_row[out_off + 2] = y;
+                if (has_alpha) {
+                    d_row[out_off + 3] = 255;
+                }
+            }
+        }
+        return 0;
+    }
+
+    // RGB24 / BGR24 / RGBA / BGRA
+    const src_bpp = bytesPerPixel(src_fmt);
+    const dst_bpp = bytesPerPixel(dst_fmt);
+
+    const src_is_bgr = (src_fmt == types.PIXFMT_BGR24 or src_fmt == types.PIXFMT_BGRA);
+    const dst_is_bgr = (dst_fmt == types.PIXFMT_BGR24 or dst_fmt == types.PIXFMT_BGRA);
+
+    const swap_rb = (src_is_bgr != dst_is_bgr);
+    const dst_has_alpha = (dst_fmt == types.PIXFMT_RGBA or dst_fmt == types.PIXFMT_BGRA);
+
+    for (0..h) |row| {
+        const s_row = s_ptr + row * s_stride;
+        const d_row = d_ptr + row * d_stride;
+
+        for (0..w) |col| {
+            const in_off = col * src_bpp;
+            const out_off = col * dst_bpp;
+
+            const c0 = s_row[in_off + 0];
+            const c1 = s_row[in_off + 1];
+            const c2 = s_row[in_off + 2];
+
+            if (swap_rb) {
+                d_row[out_off + 0] = c2;
+                d_row[out_off + 1] = c1;
+                d_row[out_off + 2] = c0;
+            } else {
+                d_row[out_off + 0] = c0;
+                d_row[out_off + 1] = c1;
+                d_row[out_off + 2] = c2;
+            }
+
+            if (dst_has_alpha) {
+                const a = if (src_bpp == 4) s_row[in_off + 3] else 255;
+                d_row[out_off + 3] = a;
+            }
+        }
+    }
+
+    return 0;
+}
+
+fn bytesPerPixel(fmt: i32) usize {
+    return switch (fmt) {
+        types.PIXFMT_RGBA, types.PIXFMT_BGRA => 4,
+        types.PIXFMT_RGB24, types.PIXFMT_BGR24 => 3,
+        types.PIXFMT_GRAY8 => 1,
+        else => 1,
+    };
+}
diff --git a/swscale-impl/src/rgb2yuv.zig b/swscale-impl/src/rgb2yuv.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/rgb2yuv.zig
@@ -0,0 +1,347 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+const RY: i32 = 8419;
+const GY: i32 = 16509;
+const BY: i32 = 3208;
+
+const RU: i32 = -4866;
+const GU: i32 = -9532;
+const BU: i32 = 14392;
+
+const RV: i32 = 14392;
+const GV: i32 = -12062;
+const BV: i32 = -2332;
+
+pub fn convertRgbToYuv(
+    ctx: *const types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const w = @as(usize, @intCast(ctx.src_w));
+    const h = @as(usize, @intCast(ctx.src_h));
+
+    const src_ptr = src_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+
+    const y_dst = dst_data[0] orelse return -1;
+    const y_stride = @as(usize, @intCast(dst_stride[0]));
+
+    if (ctx.src_fmt == types.PIXFMT_GRAY8) {
+        for (0..h) |row| {
+            const s_row = src_ptr + row * s_stride;
+            const d_row = y_dst + row * y_stride;
+            for (0..w) |col| {
+                const g = @as(i32, s_row[col]);
+                const y_val = @divTrunc(g * 219 + 128, 255) + 16;
+                d_row[col] = @intCast(std.math.clamp(y_val, 0, 255));
+            }
+        }
+        if (ctx.dst_fmt != types.PIXFMT_GRAY8) {
+            const u_dst = dst_data[1] orelse return -1;
+            const u_stride = @as(usize, @intCast(dst_stride[1]));
+            const is_420 = (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21);
+            const chr_h = if (is_420) h / 2 else h;
+            const chr_w = if (ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21) w else w / 2;
+            for (0..chr_h) |row| {
+                @memset(u_dst[row * u_stride .. row * u_stride + chr_w], 128);
+            }
+            if (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_YUV422P or ctx.dst_fmt == types.PIXFMT_YUV444P) {
+                const v_dst = dst_data[2] orelse return -1;
+                const v_stride = @as(usize, @intCast(dst_stride[2]));
+                for (0..chr_h) |row| {
+                    @memset(v_dst[row * v_stride .. row * v_stride + w / 2], 128);
+                }
+            }
+        }
+        return 0;
+    }
+
+    const is_bgr = (ctx.src_fmt == types.PIXFMT_BGR24 or ctx.src_fmt == types.PIXFMT_BGRA);
+    const has_alpha = (ctx.src_fmt == types.PIXFMT_RGBA or ctx.src_fmt == types.PIXFMT_BGRA);
+    const bpp: usize = if (has_alpha) 4 else 3;
+
+    // Compute Y plane
+    for (0..h) |row| {
+        const s_row = src_ptr + row * s_stride;
+        const d_row = y_dst + row * y_stride;
+
+        var col: usize = 0;
+        while (col < w) : (col += 1) {
+            const in_off = col * bpp;
+            const r: i32 = if (is_bgr) s_row[in_off + 2] else s_row[in_off + 0];
+            const g: i32 = s_row[in_off + 1];
+            const b: i32 = if (is_bgr) s_row[in_off + 0] else s_row[in_off + 2];
+
+            var y_val: i32 = 0;
+            if (ctx.src_fmt == types.PIXFMT_BGR24 and ctx.dst_fmt == types.PIXFMT_YUV420P) {
+                y_val = ((RY * r + GY * g + BY * b) >> 15) + 16;
+            } else {
+                const y_inter = (RY * r + GY * g + BY * b + 524544) >> 9;
+                y_val = (y_inter + 32) >> 6;
+            }
+            d_row[col] = @intCast(std.math.clamp(y_val, 0, 255));
+        }
+    }
+
+    if (ctx.dst_fmt == types.PIXFMT_GRAY8) {
+        return 0;
+    }
+
+    const u_dst = dst_data[1] orelse return -1;
+    const u_stride = @as(usize, @intCast(dst_stride[1]));
+
+    const is_dst_420 = (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21);
+    const is_dst_422 = (ctx.dst_fmt == types.PIXFMT_YUV422P);
+    const is_dst_444 = (ctx.dst_fmt == types.PIXFMT_YUV444P);
+
+    if (is_dst_444) {
+        const v_dst = dst_data[2] orelse return -1;
+        const v_stride = @as(usize, @intCast(dst_stride[2]));
+
+        for (0..h) |row| {
+            const s_row = src_ptr + row * s_stride;
+            const u_row = u_dst + row * u_stride;
+            const v_row = v_dst + row * v_stride;
+
+            var col: usize = 0;
+            while (col < w) : (col += 1) {
+                const in_off = col * bpp;
+                const r: i32 = if (is_bgr) s_row[in_off + 2] else s_row[in_off + 0];
+                const g: i32 = s_row[in_off + 1];
+                const b: i32 = if (is_bgr) s_row[in_off + 0] else s_row[in_off + 2];
+
+                const u_val = ((RU * r + GU * g + BU * b + 16384) >> 15) + 128;
+                const v_val = ((RV * r + GV * g + BV * b + 16384) >> 15) + 128;
+
+                u_row[col] = @intCast(std.math.clamp(u_val, 0, 255));
+                v_row[col] = @intCast(std.math.clamp(v_val, 0, 255));
+            }
+        }
+    } else if (is_dst_422) {
+        const v_dst = dst_data[2] orelse return -1;
+        const v_stride = @as(usize, @intCast(dst_stride[2]));
+
+        const cw = w / 2;
+
+        for (0..h) |row| {
+            const s_row = src_ptr + row * s_stride;
+            const u_row = u_dst + row * u_stride;
+            const v_row = v_dst + row * v_stride;
+
+            for (0..cw) |col| {
+                const o0 = (col * 2) * bpp;
+                const o1 = (col * 2 + 1) * bpp;
+
+                const r0: i32 = if (is_bgr) s_row[o0 + 2] else s_row[o0 + 0];
+                const g0: i32 = s_row[o0 + 1];
+                const b0: i32 = if (is_bgr) s_row[o0 + 0] else s_row[o0 + 2];
+
+                const r1: i32 = if (is_bgr) s_row[o1 + 2] else s_row[o1 + 0];
+                const g1: i32 = s_row[o1 + 1];
+                const b1: i32 = if (is_bgr) s_row[o1 + 0] else s_row[o1 + 2];
+
+                const r_sum = r0 + r1;
+                const g_sum = g0 + g1;
+                const b_sum = b0 + b1;
+
+                const u_inter = (RU * r_sum + GU * g_sum + BU * b_sum + 8389120 + 256) >> 10;
+                const v_inter = (RV * r_sum + GV * g_sum + BV * b_sum + 8389120 + 256) >> 10;
+
+                const u_val = (u_inter + 32) >> 6;
+                const v_val = (v_inter + 32) >> 6;
+
+                u_row[col] = @intCast(std.math.clamp(u_val, 0, 255));
+                v_row[col] = @intCast(std.math.clamp(v_val, 0, 255));
+            }
+        }
+    } else if (is_dst_420) {
+        if (ctx.src_fmt == types.PIXFMT_BGR24 and ctx.dst_fmt == types.PIXFMT_YUV420P) {
+            const v_dst = dst_data[2] orelse return -1;
+            const v_stride = @as(usize, @intCast(dst_stride[2]));
+
+            var row: usize = 0;
+            while (row < h / 2) : (row += 1) {
+                const s_row0 = src_ptr + (row * 2) * s_stride;
+                const s_row1 = src_ptr + (row * 2 + 1) * s_stride;
+                const u_row = u_dst + row * u_stride;
+                const v_row = v_dst + row * v_stride;
+
+                var col: usize = 0;
+                while (col < w / 2) : (col += 1) {
+                    const o0 = (col * 2) * bpp;
+                    const o1 = (col * 2 + 1) * bpp;
+
+                    const r00: i32 = s_row0[o0 + 2];
+                    const g00: i32 = s_row0[o0 + 1];
+                    const b00: i32 = s_row0[o0 + 0];
+
+                    const r01: i32 = s_row0[o1 + 2];
+                    const g01: i32 = s_row0[o1 + 1];
+                    const b01: i32 = s_row0[o1 + 0];
+
+                    const r10: i32 = s_row1[o0 + 2];
+                    const g10: i32 = s_row1[o0 + 1];
+                    const b10: i32 = s_row1[o0 + 0];
+
+                    const r11: i32 = s_row1[o1 + 2];
+                    const g11: i32 = s_row1[o1 + 1];
+                    const b11: i32 = s_row1[o1 + 0];
+
+                    const rx = (r00 + r01 + r10 + r11) >> 2;
+                    const gx = (g00 + g01 + g10 + g11) >> 2;
+                    const bx = (b00 + b01 + b10 + b11) >> 2;
+
+                    const u_val = ((RU * rx + GU * gx + BU * bx) >> 15) + 128;
+                    const v_val = ((RV * rx + GV * gx + BV * bx) >> 15) + 128;
+
+                    u_row[col] = @intCast(std.math.clamp(u_val, 0, 255));
+                    v_row[col] = @intCast(std.math.clamp(v_val, 0, 255));
+                }
+            }
+            return 0;
+        }
+
+        // Convert RGB to 4:2:2 intermediate chroma (320 x 480) in 16-bit i32
+        const alloc = std.heap.c_allocator;
+        const cw = w / 2;
+        const tmp_u = alloc.alloc(i32, cw * h) catch return -1;
+        defer alloc.free(tmp_u);
+        const tmp_v = alloc.alloc(i32, cw * h) catch return -1;
+        defer alloc.free(tmp_v);
+
+        for (0..h) |row| {
+            const s_row = src_ptr + row * s_stride;
+            const u_row = tmp_u.ptr + row * cw;
+            const v_row = tmp_v.ptr + row * cw;
+
+            var col: usize = 0;
+            while (col < cw) : (col += 1) {
+                const o0 = (col * 2) * bpp;
+                const o1 = (col * 2 + 1) * bpp;
+
+                const r0: i32 = if (is_bgr) s_row[o0 + 2] else s_row[o0 + 0];
+                const g0: i32 = s_row[o0 + 1];
+                const b0: i32 = if (is_bgr) s_row[o0 + 0] else s_row[o0 + 2];
+
+                const r1: i32 = if (is_bgr) s_row[o1 + 2] else s_row[o1 + 0];
+                const g1: i32 = s_row[o1 + 1];
+                const b1: i32 = if (is_bgr) s_row[o1 + 0] else s_row[o1 + 2];
+
+                const r_sum = r0 + r1;
+                const g_sum = g0 + g1;
+                const b_sum = b0 + b1;
+
+                u_row[col] = (RU * r_sum + GU * g_sum + BU * b_sum + 8389120) >> 10;
+                v_row[col] = (RV * r_sum + GV * g_sum + BV * b_sum + 8389120) >> 10;
+            }
+        }
+
+        // Downsample 4:2:2 chroma (320x480) -> 4:2:0 chroma (320x240) vertically using 16-bit intermediate values
+        const ch_h = h / 2;
+        const is_p420 = (ctx.dst_fmt == types.PIXFMT_YUV420P);
+        const is_nv21 = (ctx.dst_fmt == types.PIXFMT_NV21);
+
+        var v_dst_ptr: [*]u8 = undefined;
+        var v_stride_val: usize = 0;
+        if (is_p420) {
+            v_dst_ptr = (dst_data[2] orelse return -1);
+            v_stride_val = @as(usize, @intCast(dst_stride[2]));
+        }
+
+        for (0..ch_h) |r| {
+            const u_out_row = u_dst + r * u_stride;
+            const v_out_row = if (is_p420) v_dst_ptr + r * v_stride_val else undefined;
+
+            if (r == 0) {
+                const u_r0 = tmp_u.ptr + 0 * cw;
+                const u_r1 = tmp_u.ptr + 1 * cw;
+                const u_r2 = tmp_u.ptr + 2 * cw;
+
+                const v_r0 = tmp_v.ptr + 0 * cw;
+                const v_r1 = tmp_v.ptr + 1 * cw;
+                const v_r2 = tmp_v.ptr + 2 * cw;
+
+                for (0..cw) |c| {
+                    const uv = (8 * u_r0[c] + 6 * u_r1[c] + 2 * u_r2[c] + 8) >> 4;
+                    const vv = (8 * v_r0[c] + 6 * v_r1[c] + 2 * v_r2[c] + 8) >> 4;
+                    const u_v = @as(u8, @intCast(std.math.clamp((uv + 32) >> 6, 0, 255)));
+                    const v_v = @as(u8, @intCast(std.math.clamp((vv + 32) >> 6, 0, 255)));
+
+                    if (is_p420) {
+                        u_out_row[c] = u_v;
+                        v_out_row[c] = v_v;
+                    } else if (is_nv21) {
+                        u_out_row[c * 2 + 0] = v_v;
+                        u_out_row[c * 2 + 1] = u_v;
+                    } else { // NV12
+                        u_out_row[c * 2 + 0] = u_v;
+                        u_out_row[c * 2 + 1] = v_v;
+                    }
+                }
+            } else if (r == ch_h - 1) {
+                const u_r476 = tmp_u.ptr + (h - 3) * cw;
+                const u_r477 = tmp_u.ptr + (h - 2) * cw;
+                const u_r478 = tmp_u.ptr + (h - 1) * cw;
+
+                const v_r476 = tmp_v.ptr + (h - 3) * cw;
+                const v_r477 = tmp_v.ptr + (h - 2) * cw;
+                const v_r478 = tmp_v.ptr + (h - 1) * cw;
+
+                for (0..cw) |c| {
+                    const uv = (2 * u_r476[c] + 6 * u_r477[c] + 8 * u_r478[c] + 8) >> 4;
+                    const vv = (2 * v_r476[c] + 6 * v_r477[c] + 8 * v_r478[c] + 8) >> 4;
+                    const u_v = @as(u8, @intCast(std.math.clamp((uv + 32) >> 6, 0, 255)));
+                    const v_v = @as(u8, @intCast(std.math.clamp((vv + 32) >> 6, 0, 255)));
+
+                    if (is_p420) {
+                        u_out_row[c] = u_v;
+                        v_out_row[c] = v_v;
+                    } else if (is_nv21) {
+                        u_out_row[c * 2 + 0] = v_v;
+                        u_out_row[c * 2 + 1] = u_v;
+                    } else { // NV12
+                        u_out_row[c * 2 + 0] = u_v;
+                        u_out_row[c * 2 + 1] = v_v;
+                    }
+                }
+            } else {
+                const u_r0 = tmp_u.ptr + (2 * r - 2) * cw;
+                const u_r1 = tmp_u.ptr + (2 * r - 1) * cw;
+                const u_r2 = tmp_u.ptr + (2 * r + 0) * cw;
+                const u_r3 = tmp_u.ptr + (2 * r + 1) * cw;
+                const u_r4 = tmp_u.ptr + (2 * r + 2) * cw;
+                const u_r5 = tmp_u.ptr + (2 * r + 3) * cw;
+
+                const v_r0 = tmp_v.ptr + (2 * r - 2) * cw;
+                const v_r1 = tmp_v.ptr + (2 * r - 1) * cw;
+                const v_r2 = tmp_v.ptr + (2 * r + 0) * cw;
+                const v_r3 = tmp_v.ptr + (2 * r + 1) * cw;
+                const v_r4 = tmp_v.ptr + (2 * r + 2) * cw;
+                const v_r5 = tmp_v.ptr + (2 * r + 3) * cw;
+
+                for (0..cw) |c| {
+                    const uv = (1 * u_r0[c] + 1 * u_r1[c] + 6 * u_r2[c] + 6 * u_r3[c] + 1 * u_r4[c] + 1 * u_r5[c] + 8) >> 4;
+                    const vv = (1 * v_r0[c] + 1 * v_r1[c] + 6 * v_r2[c] + 6 * v_r3[c] + 1 * v_r4[c] + 1 * v_r5[c] + 8) >> 4;
+                    const u_v = @as(u8, @intCast(std.math.clamp((uv + 32) >> 6, 0, 255)));
+                    const v_v = @as(u8, @intCast(std.math.clamp((vv + 32) >> 6, 0, 255)));
+
+                    if (is_p420) {
+                        u_out_row[c] = u_v;
+                        v_out_row[c] = v_v;
+                    } else if (is_nv21) {
+                        u_out_row[c * 2 + 0] = v_v;
+                        u_out_row[c * 2 + 1] = u_v;
+                    } else { // NV12
+                        u_out_row[c * 2 + 0] = u_v;
+                        u_out_row[c * 2 + 1] = v_v;
+                    }
+                }
+            }
+        }
+    }
+
+    return 0;
+}
diff --git a/swscale-impl/src/scaler.zig b/swscale-impl/src/scaler.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/scaler.zig
@@ -0,0 +1,273 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    if (b == 0) return 0;
+    if (a >= 0) {
+        return @divTrunc(a + @divTrunc(b, 2), b);
+    } else {
+        return @divTrunc(a - @divTrunc(b, 2), b);
+    }
+}
+
+pub fn initFilter(allocator: std.mem.Allocator, src_w: i32, dst_w: i32, algo: i32, is_vertical: bool) !types.FilterSpec {
+    const sw = @as(i64, src_w);
+    const dw = @as(i64, dst_w);
+    const one: i64 = if (is_vertical) (1 << 12) else (1 << 14);
+
+    if (sw == dw) {
+        var pos = try allocator.alloc(i32, @intCast(dw));
+        var weights = try allocator.alloc(i16, @intCast(dw));
+        for (0..@intCast(dw)) |i| {
+            pos[i] = @intCast(i);
+            weights[i] = @intCast(one);
+        }
+        return types.FilterSpec{
+            .pos = pos,
+            .weights = weights,
+            .filter_size = 1,
+        };
+    }
+
+    const x_inc = @divTrunc(sw << 16, dw);
+
+    var log2_ratio: u6 = 0;
+    if (sw > dw) {
+        const ratio = @divTrunc(sw, dw);
+        if (ratio > 0) {
+            log2_ratio = @intCast(@min(std.math.log2_int(u64, @intCast(ratio)), 8));
+        }
+    }
+    const fone_shift: u6 = 54 - log2_ratio;
+    const fone: i64 = @as(i64, 1) << fone_shift;
+
+    var filter_size: usize = 0;
+    var raw_pos = try allocator.alloc(i32, @intCast(dw));
+    defer allocator.free(raw_pos);
+
+    var filter_buf: []i64 = undefined;
+
+    if (algo == types.ALGO_NEAREST) {
+        filter_size = 1;
+        filter_buf = try allocator.alloc(i64, @intCast(dw * @as(i64, @intCast(filter_size))));
+        var x_dst_in_src: i64 = (x_inc >> 1) - 32768;
+        for (0..@intCast(dw)) |i| {
+            const xx = (x_dst_in_src + 32768) >> 16;
+            raw_pos[i] = @intCast(xx);
+            filter_buf[i] = fone;
+            x_dst_in_src += x_inc;
+        }
+    } else if (x_inc <= 65536 and algo == types.ALGO_BILINEAR) {
+        filter_size = 2;
+        filter_buf = try allocator.alloc(i64, @intCast(dw * @as(i64, @intCast(filter_size))));
+        var x_dst_in_src: i64 = (x_inc >> 1) - 32768;
+        for (0..@intCast(dw)) |i| {
+            var xx = x_dst_in_src >> 16;
+            raw_pos[i] = @intCast(xx);
+            for (0..2) |j| {
+                const diff = @abs(xx * 65536 - x_dst_in_src);
+                var coeff = fone - @as(i64, @intCast(diff)) * (fone >> 16);
+                if (coeff < 0) coeff = 0;
+                filter_buf[i * 2 + j] = coeff;
+                xx += 1;
+            }
+            x_dst_in_src += x_inc;
+        }
+    } else {
+        const size_factor: i64 = if (algo == types.ALGO_BILINEAR) 2 else 4;
+        if (x_inc <= 65536) {
+            filter_size = @intCast(1 + size_factor);
+        } else {
+            filter_size = @intCast(1 + @divTrunc(size_factor * sw + dw - 1, dw));
+        }
+        if (sw > 2) filter_size = @min(filter_size, @as(usize, @intCast(sw - 2)));
+        filter_size = @max(filter_size, 1);
+
+        filter_buf = try allocator.alloc(i64, @intCast(dw * @as(i64, @intCast(filter_size))));
+
+        var x_dst_in_src: i64 = x_inc - 65536;
+        for (0..@intCast(dw)) |i| {
+            var xx = @divTrunc(x_dst_in_src - (@as(i64, @intCast(filter_size)) - 2) * 65536, 131072);
+            raw_pos[i] = @intCast(xx);
+
+            for (0..filter_size) |j| {
+                const diff = @abs(xx * 131072 - x_dst_in_src);
+                var d: i64 = @as(i64, @intCast(diff)) << 13;
+                if (x_inc > 65536) {
+                    d = @divTrunc(d * dw, sw);
+                }
+                var coeff: i64 = 0;
+                if (algo == types.ALGO_BILINEAR) {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff = coeff * (fone >> 30);
+                } else { // BICUBIC
+                    const B: i64 = 0;
+                    const C: i64 = 10066329; // 0.6 * (1 << 24)
+                    if (d >= (1 << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd = (d * d) >> 30;
+                        const ddd = (dd * d) >> 30;
+                        if (d < (1 << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                        const denom = @divTrunc(@as(i64, 1) << 54, fone);
+                        if (denom > 0) {
+                            coeff = @divTrunc(coeff, denom);
+                        }
+                    }
+                }
+                filter_buf[i * filter_size + j] = coeff;
+                xx += 1;
+            }
+            x_dst_in_src += 2 * x_inc;
+        }
+    }
+    defer allocator.free(filter_buf);
+
+    var pos = try allocator.alloc(i32, @intCast(dw));
+    @memcpy(pos, raw_pos);
+
+    // Border handling exactly as FFmpeg utils.c
+    for (0..@intCast(dw)) |i| {
+        const row_flt = filter_buf[i * filter_size .. (i + 1) * filter_size];
+
+        if (pos[i] < 0) {
+            for (1..filter_size) |j| {
+                const left_idx = @as(i32, @intCast(j)) + pos[i];
+                const left: usize = if (left_idx < 0) 0 else @intCast(left_idx);
+                row_flt[left] += row_flt[j];
+                row_flt[j] = 0;
+            }
+            pos[i] = 0;
+        }
+
+        if (pos[i] + @as(i32, @intCast(filter_size)) > sw) {
+            const shift_i32 = pos[i] + @min(@as(i32, @intCast(filter_size)) - @as(i32, @intCast(sw)), 0);
+            var acc: i64 = 0;
+
+            var j: usize = filter_size;
+            while (j > 0) {
+                j -= 1;
+                if (pos[i] + @as(i32, @intCast(j)) >= sw) {
+                    acc += row_flt[j];
+                    row_flt[j] = 0;
+                }
+            }
+
+            j = filter_size;
+            while (j > 0) {
+                j -= 1;
+                if (@as(i32, @intCast(j)) < shift_i32) {
+                    row_flt[j] = 0;
+                } else {
+                    const src_j: usize = @intCast(@as(i32, @intCast(j)) - shift_i32);
+                    row_flt[j] = row_flt[src_j];
+                }
+            }
+
+            pos[i] -= shift_i32;
+            const target_tap = @as(usize, @intCast(@as(i32, @intCast(sw)) - 1 - pos[i]));
+            if (target_tap < filter_size) {
+                row_flt[target_tap] += acc;
+            }
+        }
+    }
+
+    // Normalization with error diffusion
+    var weights = try allocator.alloc(i16, @intCast(dw * @as(i64, @intCast(filter_size))));
+    for (0..@intCast(dw)) |i| {
+        const row_flt = filter_buf[i * filter_size .. (i + 1) * filter_size];
+        const row_w = weights[i * filter_size .. (i + 1) * filter_size];
+
+        var sum: i64 = 0;
+        for (0..filter_size) |j| {
+            sum += row_flt[j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum <= 0) sum = 1;
+
+        var err: i64 = 0;
+        for (0..filter_size) |j| {
+            const v = row_flt[j] + err;
+            const int_v: i16 = @intCast(roundedDiv(v, sum));
+            row_w[j] = int_v;
+            err = v - @as(i64, int_v) * sum;
+        }
+    }
+
+    return types.FilterSpec{
+        .pos = pos,
+        .weights = weights,
+        .filter_size = filter_size,
+    };
+}
+
+pub fn scalePlane(
+    src: [*]const u8,
+    s_stride: usize,
+    dst: [*]u8,
+    d_stride: usize,
+    sw: usize,
+    sh: usize,
+    dw: usize,
+    dh: usize,
+    h_filter: types.FilterSpec,
+    v_filter: types.FilterSpec,
+    channels: usize,
+    scratch: []u8,
+) void {
+    const tmp_size = sh * dw * channels * 2;
+    if (scratch.len < tmp_size) return;
+
+    const tmp_buf: [*]i16 = @ptrCast(@alignCast(scratch.ptr));
+
+    // Pass 1: Horizontal filtering
+    for (0..sh) |y| {
+        const s_row = src + y * s_stride;
+        const tmp_row = tmp_buf + y * dw * channels;
+
+        for (0..dw) |x| {
+            const px_i = h_filter.pos[x];
+            const w_row = h_filter.weights[x * h_filter.filter_size .. (x + 1) * h_filter.filter_size];
+
+            for (0..channels) |c| {
+                var acc: i32 = 0;
+                for (0..h_filter.filter_size) |j| {
+                    const src_x: usize = @intCast(std.math.clamp(px_i + @as(i32, @intCast(j)), 0, @as(i32, @intCast(sw - 1))));
+                    const src_val = s_row[src_x * channels + c];
+                    acc += @as(i32, src_val) * w_row[j];
+                }
+                tmp_row[x * channels + c] = @intCast(acc >> 7);
+            }
+        }
+    }
+
+    // Pass 2: Vertical filtering
+    for (0..dh) |y| {
+        const py_i = v_filter.pos[y];
+        const w_col = v_filter.weights[y * v_filter.filter_size .. (y + 1) * v_filter.filter_size];
+        const d_row = dst + y * d_stride;
+
+        for (0..dw) |x| {
+            for (0..channels) |c| {
+                var acc: i32 = 1 << 18;
+                for (0..v_filter.filter_size) |j| {
+                    const src_y: usize = @intCast(std.math.clamp(py_i + @as(i32, @intCast(j)), 0, @as(i32, @intCast(sh - 1))));
+                    const tmp_val = tmp_buf[src_y * dw * channels + x * channels + c];
+                    acc += @as(i32, tmp_val) * w_col[j];
+                }
+                const val = acc >> 19;
+                d_row[x * channels + c] = @intCast(std.math.clamp(val, 0, 255));
+            }
+        }
+    }
+}
diff --git a/swscale-impl/src/test_bgr2yuv.zig b/swscale-impl/src/test_bgr2yuv.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/test_bgr2yuv.zig
@@ -0,0 +1,82 @@
+const std = @import("std");
+
+pub fn main() !void {
+    const src_w: c_int = 640;
+    const src_h: c_int = 480;
+    const dst_w: c_int = 640;
+    const dst_h: c_int = 480;
+
+    const PIXFMT_BGR24: c_int = 3;
+    const PIXFMT_YUV420P: c_int = 0;
+
+    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
+    const allocator = gpa.allocator();
+
+    const src_size = @as(usize, @intCast(src_w * src_h * 3));
+    const src_buf = try allocator.alloc(u8, src_size);
+    for (src_buf, 0..) |*p, i| {
+        p.* = @intCast(i % 256);
+    }
+
+    const y_size = @as(usize, @intCast(dst_w * dst_h));
+    const u_size = @as(usize, @intCast((dst_w / 2) * (dst_h / 2)));
+
+    const ref_y = try allocator.alloc(u8, y_size);
+    const ref_u = try allocator.alloc(u8, u_size);
+    const ref_v = try allocator.alloc(u8, u_size);
+
+    const cand_y = try allocator.alloc(u8, y_size);
+    const cand_u = try allocator.alloc(u8, u_size);
+    const cand_v = try allocator.alloc(u8, u_size);
+
+    var ref_lib = try std.DynLib.open("/app/libswscale_public_baseline.so");
+    defer ref_lib.close();
+
+    const CreateFn = *const fn(c_int, c_int, c_int, c_int, c_int, c_int, c_int) callconv(.c) ?*anyopaque;
+    const ProcessFn = *const fn(?*anyopaque, [*]const ?[*]const u8, [*]const c_int, [*]const ?[*]u8, [*]const c_int) callconv(.c) c_int;
+
+    const ref_create = ref_lib.lookup(CreateFn, "swscale_create") orelse unreachable;
+    const ref_process = ref_lib.lookup(ProcessFn, "swscale_process") orelse unreachable;
+
+    const ref_ctx = ref_create(src_w, src_h, PIXFMT_BGR24, dst_w, dst_h, PIXFMT_YUV420P, 2) orelse unreachable;
+
+    const src_ptrs = [_]?[*]const u8{ src_buf.ptr, src_buf.ptr, src_buf.ptr, src_buf.ptr };
+    const src_strides = [_]c_int{ src_w * 3, src_w * 3, src_w * 3, src_w * 3 };
+
+    const ref_dst_ptrs = [_]?[*]u8{ ref_y.ptr, ref_u.ptr, ref_v.ptr, null };
+    const ref_dst_strides = [_]c_int{ dst_w, dst_w / 2, dst_w / 2, 0 };
+
+    _ = ref_process(ref_ctx, &src_ptrs, &src_strides, &ref_dst_ptrs, &ref_dst_strides);
+
+    var cand_lib = try std.DynLib.open("/app/swscale-impl/zig-out/lib/libswscale_candidate.so");
+    defer cand_lib.close();
+
+    const cand_create = cand_lib.lookup(CreateFn, "swscale_create") orelse unreachable;
+    const cand_process = cand_lib.lookup(ProcessFn, "swscale_process") orelse unreachable;
+
+    const cand_ctx = cand_create(src_w, src_h, PIXFMT_BGR24, dst_w, dst_h, PIXFMT_YUV420P, 2) orelse unreachable;
+    const cand_dst_ptrs = [_]?[*]u8{ cand_y.ptr, cand_u.ptr, cand_v.ptr, null };
+
+    _ = cand_process(cand_ctx, &src_ptrs, &src_strides, &cand_dst_ptrs, &ref_dst_strides);
+
+    var y_diff: usize = 0;
+    var u_diff: usize = 0;
+    var v_diff: usize = 0;
+    for (0..y_size) |i| {
+        if (ref_y[i] != cand_y[i]) y_diff += 1;
+    }
+    for (0..u_size) |i| {
+        if (ref_u[i] != cand_u[i]) u_diff += 1;
+    }
+    for (0..u_size) |i| {
+        if (ref_v[i] != cand_v[i]) v_diff += 1;
+    }
+
+    std.debug.print("Y diffs: {}/{}, U diffs: {}/{}, V diffs: {}/{}\n", .{ y_diff, y_size, u_diff, u_size, v_diff, u_size });
+    if (y_diff > 0) {
+        std.debug.print("First 10 Y ref vs cand:\n", .{});
+        for (0..10) |i| {
+            std.debug.print("  i={} ref Y={} cand Y={}\n", .{ i, ref_y[i], cand_y[i] });
+        }
+    }
+}
