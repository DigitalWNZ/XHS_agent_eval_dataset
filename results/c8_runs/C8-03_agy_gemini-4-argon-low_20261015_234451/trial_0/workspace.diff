diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,48 @@
+WITH multi_senses AS (
+  SELECT wordid, synsetid, COUNT(*) AS cnt
+  FROM senses
+  WHERE wordid IN (
+    SELECT wordid
+    FROM senses
+    GROUP BY wordid
+    HAVING COUNT(*) >= 2 AND MIN(synsetid) < MAX(synsetid)
+  )
+  GROUP BY wordid, synsetid
+),
+top_words AS (
+  SELECT
+    s.wordid,
+    COUNT(*) AS total_synsets,
+    SUM(s.cnt) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids,
+    s.synsetid AS top_synsetid,
+    s.cnt AS top_synset_sense_count,
+    MAX((s.cnt << 30) - s.synsetid)
+  FROM multi_senses s
+  CROSS JOIN synsets syn ON s.synsetid = syn.synsetid
+  GROUP BY s.wordid
+  HAVING distinct_domains >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    s.wordid ASC
+  LIMIT 500
+)
+SELECT
+  tw.wordid AS word_id,
+  w.word AS word,
+  tw.total_synsets,
+  tw.total_senses,
+  tw.distinct_domains,
+  tw.distinct_posids,
+  tw.top_synsetid,
+  tw.top_synset_sense_count
+FROM words w
+JOIN top_words tw ON w.wordid = tw.wordid
+ORDER BY
+  tw.total_senses DESC,
+  tw.total_synsets DESC,
+  tw.distinct_domains DESC,
+  word_id ASC;
