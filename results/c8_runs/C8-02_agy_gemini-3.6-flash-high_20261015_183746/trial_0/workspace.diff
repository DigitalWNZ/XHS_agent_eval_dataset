diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,272 @@
+const std = @import("std");
+const types = @import("types.zig");
+const tables = @import("tables.zig");
+const yuv2rgb = @import("yuv2rgb.zig");
+const rgb2yuv = @import("rgb2yuv.zig");
+const rgb2rgb = @import("rgb2rgb.zig");
+const yuv2yuv = @import("yuv2yuv.zig");
+const scaler = @import("scaler.zig");
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    tables.initYuvTables();
+    const allocator = std.heap.page_allocator;
+    const ctx = allocator.create(types.SwsContext) catch return null;
+
+    ctx.* = .{
+        .src_w = @intCast(src_w),
+        .src_h = @intCast(src_h),
+        .src_fmt = src_fmt,
+        .dst_w = @intCast(dst_w),
+        .dst_h = @intCast(dst_h),
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .is_same_size = (src_w == dst_w and src_h == dst_h),
+        .allocator = allocator,
+    };
+
+    scaler.initContextBuffers(ctx) catch {
+        allocator.destroy(ctx);
+        return null;
+    };
+
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *types.SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+
+    if (ctx.is_same_size) {
+        if (dispatchSameSize(ctx, src_data, src_stride, dst_data, dst_stride)) {
+            return 0;
+        }
+    }
+
+    scaler.processScaler(ctx, src_data, src_stride, dst_data, dst_stride);
+    return 0;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *types.SwsContext = @ptrCast(@alignCast(ptr));
+        scaler.freeContextBuffers(ctx);
+        ctx.allocator.destroy(ctx);
+    }
+}
+
+fn dispatchSameSize(
+    ctx: *types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) bool {
+    const w = ctx.src_w;
+    const h = ctx.src_h;
+
+    // Direct copy for identical format
+    if (ctx.src_fmt == ctx.dst_fmt) {
+        if (types.isPackedRgb(ctx.src_fmt) or ctx.src_fmt == types.PIXFMT_GRAY8) {
+            yuv2yuv.copyPlane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), getRowBytes(ctx.src_fmt, w), h);
+            return true;
+        } else if (types.isPlanarYuv(ctx.src_fmt)) {
+            const h_sub: usize = if (ctx.src_fmt == types.PIXFMT_YUV420P) 2 else 1;
+            const w_sub: usize = if (ctx.src_fmt == types.PIXFMT_YUV444P) 1 else 2;
+            yuv2yuv.copyPlane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            yuv2yuv.copyPlane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), (w + w_sub - 1) / w_sub, (h + h_sub - 1) / h_sub);
+            yuv2yuv.copyPlane(src_data[2].?, @intCast(src_stride[2]), dst_data[2].?, @intCast(dst_stride[2]), (w + w_sub - 1) / w_sub, (h + h_sub - 1) / h_sub);
+            return true;
+        } else if (types.isSemiPlanarYuv(ctx.src_fmt)) {
+            yuv2yuv.copyPlane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            yuv2yuv.copyPlane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), w, h / 2);
+            return true;
+        }
+    }
+
+    // YUV420P outputs
