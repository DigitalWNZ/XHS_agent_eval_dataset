+    u_dst_stride: usize,
+    v_dst: [*]u8,
+    v_dst_stride: usize,
+    width: usize,
+    height: usize,
+) void {
+    copyPlane(y_src, y_src_stride, y_dst, y_dst_stride, width, height);
+
+    var r: usize = 0;
+    while (r < height / 2) : (r += 1) {
+        const u_src_row0 = u_src + (r * 2 + 0) * u_src_stride;
+        const u_src_row1 = u_src + (r * 2 + 1) * u_src_stride;
+        const v_src_row0 = v_src + (r * 2 + 0) * v_src_stride;
+        const v_src_row1 = v_src + (r * 2 + 1) * v_src_stride;
+
