@@ -0,0 +1,570 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+// BT.601 limited-range RGB2YUV coefficients matching FFmpeg input_rgb2yuv_table
+const RY: i32 = 8419;
+const GY: i32 = 16508;
+const BY: i32 = 3210;
+
+const RU: i32 = -4864;
+const GU: i32 = -9528;
+const BU: i32 = 14382;
+
+const RV: i32 = 14382;
+const GV: i32 = -12061;
+const BV: i32 = -2330;
+
+const dither_220: [8][8]i32 = .{
+    .{ 117,  62, 158, 103, 113,  58, 155, 100 },
+    .{  34, 199,  21, 186,  31, 196,  17, 182 },
+    .{ 144,  89, 131,  76, 141,  86, 127,  72 },
+    .{   0, 165,  41, 206,  10, 175,  52, 217 },
+    .{ 110,  55, 151,  96, 120,  65, 162, 107 },
+    .{  28, 193,  14, 179,  38, 203,  24, 189 },
+    .{ 138,  83, 124,  69, 148,  93, 134,  79 },
+    .{   7, 172,  48, 213,   3, 168,  45, 210 },
+};
+
+pub fn convertRgb24ToYuv420p(
+    src_ptr: [*]const u8,
+    src_stride: usize,
+    y_ptr: [*]u8,
+    y_stride: usize,
+    u_ptr: [*]u8,
+    u_stride: usize,
+    v_ptr: [*]u8,
+    v_stride: usize,
+    width: usize,
+    height: usize,
+) void {
+    var r: usize = 0;
+    while (r < height) : (r += 1) {
+        const src_row = src_ptr + r * src_stride;
+        const y_row = y_ptr + r * y_stride;
+
+        var c: usize = 0;
+        while (c < width) : (c += 1) {
+            const red: i32 = src_row[c * 3 + 0];
+            const green: i32 = src_row[c * 3 + 1];
+            const blue: i32 = src_row[c * 3 + 2];
+
+            const y16 = (RY * red + GY * green + BY * blue + 524544) >> 9;
+            const dith = dither_220[r & 7][c & 7];
+            y_row[c] = @intCast(std.math.clamp((y16 + dith) >> 7, 0, 255));
+        }
+    }
+
