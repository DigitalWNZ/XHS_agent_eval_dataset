diff --git a/scratch/test_table_perfect.py b/scratch/test_table_perfect.py
new file mode 100644
--- /dev/null
+++ b/scratch/test_table_perfect.py
@@ -0,0 +1,80 @@
+import sys, os, subprocess, tempfile
+sys.path.insert(0, "/app")
+import numpy as np
+
+with open("/tmp/src_dump.raw", "rb") as f:
+    src_bytes = f.read()
+
+w, h = 640, 480
+y_size = w * h
+uv_size = (w // 2) * (h // 2)
+Y = np.frombuffer(src_bytes[:y_size], dtype=np.uint8).reshape((h, w)).astype(np.int32)
+U = np.frombuffer(src_bytes[y_size:y_size+uv_size], dtype=np.uint8).reshape((h//2, w//2)).astype(np.int32)
+V = np.frombuffer(src_bytes[y_size+uv_size:y_size+2*uv_size], dtype=np.uint8).reshape((h//2, w//2)).astype(np.int32)
+
+import workloads
+
+wl = workloads.correctness_workloads()[0] # yuv420p -> rgb24 640x480
+DRIVER = "/app/driver"
+BASELINE = "/app/libswscale_public_baseline.so"
+
+tmp_ref = tempfile.mktemp(suffix=".raw")
+cmd_ref = workloads.driver_argv(DRIVER, BASELINE, wl, 1, tmp_ref)
+subprocess.run(cmd_ref, check=True)
+with open(tmp_ref, "rb") as f:
+    ref_bytes = f.read()
+os.remove(tmp_ref)
+
+cy = 76309
+oy = 1048576
+
+crv = ((104597 * 65536) + 0x8000) // cy
+cbu = ((132201 * 65536) + 0x8000) // cy
+cgu = ((-25675 * 65536) + 0x8000) // cy
+cgv = ((-53279 * 65536) + 0x8000) // cy
+
+HEADROOM = 512
+table_plane_size = 1024 + 2 * HEADROOM
+yoffs = 326 + HEADROOM
+
+y_table = np.zeros(table_plane_size, dtype=np.uint8)
+yb = -(384 << 16) - HEADROOM * cy - oy
+for i in range(table_plane_size):
+    yval = np.clip((yb + 0x8000) >> 16, 0, 255)
+    y_table[i] = yval
+    yb += cy
+
+def fill_gv_table(inc):
+    off = -(inc >> 9)
+    tab = np.zeros(256, dtype=np.int32)
+    for i in range(256):
+        cb = i * inc
+        tab[i] = off + (cb >> 16)
+    return tab
+
+table_rV = fill_gv_table(crv)
+table_gU = fill_gv_table(cgu)
+table_bU = fill_gv_table(cbu)
+table_gV = fill_gv_table(cgv)
+
+R_out = np.zeros((h, w), dtype=np.uint8)
+G_out = np.zeros((h, w), dtype=np.uint8)
+B_out = np.zeros((h, w), dtype=np.uint8)
+
+for r in range(h):
+    for c_idx in range(w):
+        y_val = Y[r, c_idx]
+        u_val = U[r // 2, c_idx // 2]
+        v_val = V[r // 2, c_idx // 2]
+
+        r_off = table_rV[v_val]
+        g_off = table_gU[u_val] + table_gV[v_val]
+        b_off = table_bU[u_val]
+
+        R_out[r, c_idx] = y_table[y_val + yoffs + r_off]
+        G_out[r, c_idx] = y_table[y_val + yoffs + g_off]
+        B_out[r, c_idx] = y_table[y_val + yoffs + b_off]
+
+cand_bytes = np.stack([R_out, G_out, B_out], axis=2).tobytes()
+grade = workloads.grade(ref_bytes, cand_bytes, 5, 640, 480, False)
+print("GRADE RESULT PERFECT:", grade)
