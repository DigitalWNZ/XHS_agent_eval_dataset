+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_GRAY8) {
+            rgb2rgb.convertRgb24ToGray8(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+    }
+
+    if (ctx.src_fmt == types.PIXFMT_BGR24) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            rgb2rgb.convertRgb24ToBgr24(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_YUV420P) {
+            rgb2yuv.convertBgr24ToYuv420p(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), dst_data[1].?, @intCast(dst_stride[1]), dst_data[2].?, @intCast(dst_stride[2]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_RGBA) {
+            rgb2rgb.convertRgb24ToBgra(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+    }
+
+    if (ctx.src_fmt == types.PIXFMT_RGBA) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            rgb2rgb.convertRgbaToRgb24(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_BGRA) {
+            rgb2rgb.convertRgbaToBgra(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_GRAY8) {
+            rgb2rgb.convertRgbaToGray8(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+    }
+
+    if (ctx.src_fmt == types.PIXFMT_BGRA) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            rgb2rgb.convertBgraToRgb24(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_RGBA) {
+            rgb2rgb.convertBgraToRgba(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+    }
+
+    // GRAY8 outputs
+    if (ctx.src_fmt == types.PIXFMT_GRAY8) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24 or ctx.dst_fmt == types.PIXFMT_BGR24) {
+            rgb2rgb.convertGray8ToRgb24(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_RGBA) {
+            rgb2rgb.convertGray8ToRgba(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_YUV420P) {
+            yuv2yuv.convertGray8ToYuv420p(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), dst_data[1].?, @intCast(dst_stride[1]), dst_data[2].?, @intCast(dst_stride[2]), w, h);
+            return true;
+        }
+    }
+
+    return false;
+}
+
+fn getRowBytes(fmt: c_int, width: usize) usize {
+    return switch (fmt) {
+        types.PIXFMT_RGB24, types.PIXFMT_BGR24 => width * 3,
+        types.PIXFMT_RGBA, types.PIXFMT_BGRA => width * 4,
+        else => width,
+    };
+}
