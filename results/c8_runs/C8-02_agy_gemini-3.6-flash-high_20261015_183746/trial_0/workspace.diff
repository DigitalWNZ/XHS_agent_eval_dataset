+import sys
+import subprocess
+import os
+
+sys.path.append("/app")
+import workloads
+
+wl = [w for w in workloads.correctness_workloads() if w["key"] == "c010"][0]
+
+subprocess.run(["zig", "build", "-Doptimize=ReleaseFast"], cwd="/app/swscale-impl", check=True)
+
+driver = "/app/driver"
+baseline = "/app/libswscale_public_baseline.so"
+candidate = "/app/swscale-impl/zig-out/lib/libswscale_candidate.so"
+
+ref_out = "/tmp/ref_c010.raw"
+cand_out = "/tmp/cand_c010.raw"
+
+iters = 1
+argv_ref = workloads.driver_argv(driver, baseline, wl, iters, ref_out)
+argv_cand = workloads.driver_argv(driver, candidate, wl, iters, cand_out)
+
+subprocess.run(argv_ref, check=True)
+subprocess.run(argv_cand, check=True)
+
+with open(ref_out, "rb") as f:
+    ref_bytes = f.read()
+
+with open(cand_out, "rb") as f:
+    cand_bytes = f.read()
+
+res = workloads.grade(ref_bytes, cand_bytes, wl["dst_fmt"], wl["dst_w"], wl["dst_h"], wl["scaling"])
+print("Grade result for c010:", res)
+
+print("Ref[:30]: ", list(ref_bytes[:30]))
+print("Cand[:30]:", list(cand_bytes[:30]))
