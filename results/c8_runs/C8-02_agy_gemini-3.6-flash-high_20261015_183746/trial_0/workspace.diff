+
+    var r: usize = 0;
+    while (r < src_h) : (r += 1) {
+        const src_row = src_ptr + r * src_stride;
+        const mid_row = mid[r * dst_w .. (r + 1) * dst_w];
+
+        mid_row[0] = src_row[0];
+        var x: usize = 1;
+        while (x < dst_w) : (x += 1) {
+            const k = x / 2;
+            if (x % 2 == 0) {
+                const prev: i32 = src_row[k - 1];
+                const curr: i32 = src_row[k];
+                mid_row[x] = @intCast((prev + curr * 3 + 2) >> 2);
+            } else {
+                const curr: i32 = src_row[k];
+                const next: i32 = src_row[if (k + 1 < src_w) k + 1 else k];
+                mid_row[x] = @intCast((curr * 3 + next + 2) >> 2);
+            }
+        }
+    }
+
+    // Vertical 1D upsampling pass
+    var c: usize = 0;
+    while (c < dst_w) : (c += 1) {
+        dst_ptr[c] = mid[c];
+    }
+
+    var y: usize = 1;
+    while (y < dst_h) : (y += 1) {
+        const dst_row = dst_ptr + y * dst_stride;
+        const k = y / 2;
+        if (y % 2 == 0) {
+            const prev_row = mid[(k - 1) * dst_w .. k * dst_w];
+            const curr_row = mid[k * dst_w .. (k + 1) * dst_w];
+            c = 0;
+            while (c < dst_w) : (c += 1) {
+                const prev: i32 = prev_row[c];
+                const curr: i32 = curr_row[c];
+                dst_row[c] = @intCast((prev + curr * 3 + 2) >> 2);
+            }
+        } else {
+            const curr_row = mid[k * dst_w .. (k + 1) * dst_w];
+            const next_k = if (k + 1 < src_h) k + 1 else k;
+            const next_row = mid[next_k * dst_w .. (next_k + 1) * dst_w];
+            c = 0;
+            while (c < dst_w) : (c += 1) {
+                const curr: i32 = curr_row[c];
+                const next: i32 = next_row[c];
+                dst_row[c] = @intCast((curr * 3 + next + 2) >> 2);
+            }
+        }
+    }
+}
