+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_GRAY8) {
+            yuv2yuv.convertYuv420pToGray8(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_NV12) {
+            yuv2yuv.convertYuv420pToNv12(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), dst_data[1].?, @intCast(dst_stride[1]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_YUV444P) {
+            yuv2yuv.convertYuv420pToYuv444p(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), dst_data[1].?, @intCast(dst_stride[1]), dst_data[2].?, @intCast(dst_stride[2]), w, h);
+            return true;
+        }
+    }
+
+    // YUV422P outputs
+    if (ctx.src_fmt == types.PIXFMT_YUV422P) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            yuv2rgb.convertYuv422pToRgb24(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_RGBA) {
+            yuv2rgb.convertYuv422pToRgba(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+    }
+
+    // YUV444P outputs
+    if (ctx.src_fmt == types.PIXFMT_YUV444P) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            yuv2rgb.convertYuv444pToRgb24(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_BGR24) {
+            yuv2rgb.convertYuv444pToBgr24(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+    }
+
+    // NV12 / NV21 outputs
+    if (ctx.src_fmt == types.PIXFMT_NV12) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            yuv2rgb.convertNv12ToRgb24(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
