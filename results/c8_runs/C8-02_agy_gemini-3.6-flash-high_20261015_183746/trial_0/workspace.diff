+const RY: i32 = 8419;
+const GY: i32 = 16508;
+const BY: i32 = 3210;
+
+const RU: i32 = -4864;
+const GU: i32 = -9528;
+const BU: i32 = 14382;
+
+const RV: i32 = 14382;
+const GV: i32 = -12061;
+const BV: i32 = -2330;
+
+inline fn lookupY(base_idx: usize, off: i32) u8 {
+    const idx = @as(i32, @intCast(base_idx)) + off;
+    return tables.y_table[@intCast(std.math.clamp(idx, 0, 2047))];
+}
+
+pub fn initContextBuffers(ctx: *types.SwsContext) !void {
+    tables.initYuvTables();
+
+    const dst_is_subsampled = (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_YUV422P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21);
+
+    const src_chr_w = if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21 or (types.isPackedRgb(ctx.src_fmt) and dst_is_subsampled)) (ctx.src_w + 1) / 2 else ctx.src_w;
+    const src_chr_h = if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21) (ctx.src_h + 1) / 2 else ctx.src_h;
+
+    const dst_chr_w = if (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_YUV422P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21) (ctx.dst_w + 1) / 2 else ctx.dst_w;
+    const dst_chr_h = if (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21) (ctx.dst_h + 1) / 2 else ctx.dst_h;
+
+    ctx.h_lum = try tables.buildScaleFilter(ctx.allocator, ctx.algo, ctx.src_w, ctx.dst_w, false);
+    ctx.v_lum = try tables.buildScaleFilter(ctx.allocator, ctx.algo, ctx.src_h, ctx.dst_h, true);
+    ctx.h_chr = try tables.buildScaleFilter(ctx.allocator, ctx.algo, src_chr_w, dst_chr_w, false);
+    ctx.v_chr = try tables.buildScaleFilter(ctx.allocator, ctx.algo, src_chr_h, dst_chr_h, true);
+
+
+
+    ctx.src_y16 = try ctx.allocator.alloc(i16, ctx.src_w * ctx.src_h);
+    ctx.src_u16 = try ctx.allocator.alloc(i16, src_chr_w * src_chr_h);
+    ctx.src_v16 = try ctx.allocator.alloc(i16, src_chr_w * src_chr_h);
+
+    ctx.mid_lum = try ctx.allocator.alloc(i32, ctx.dst_w * ctx.src_h);
+    ctx.mid_u = try ctx.allocator.alloc(i32, dst_chr_w * src_chr_h);
+    ctx.mid_v = try ctx.allocator.alloc(i32, dst_chr_w * src_chr_h);
+
+    ctx.dst_y16 = try ctx.allocator.alloc(i16, ctx.dst_w * ctx.dst_h);
+    ctx.dst_u16 = try ctx.allocator.alloc(i16, dst_chr_w * dst_chr_h);
+    ctx.dst_v16 = try ctx.allocator.alloc(i16, dst_chr_w * dst_chr_h);
+}
+
+pub fn freeContextBuffers(ctx: *types.SwsContext) void {
+    if (ctx.h_lum) |f| {
+        ctx.allocator.free(f.pos);
+        ctx.allocator.free(f.weights);
+    }
+    if (ctx.v_lum) |f| {
+        ctx.allocator.free(f.pos);
+        ctx.allocator.free(f.weights);
+    }
+    if (ctx.h_chr) |f| {
+        ctx.allocator.free(f.pos);
+        ctx.allocator.free(f.weights);
+    }
+    if (ctx.v_chr) |f| {
+        ctx.allocator.free(f.pos);
+        ctx.allocator.free(f.weights);
+    }
+
+    if (ctx.src_y16) |buf| ctx.allocator.free(buf);
+    if (ctx.src_u16) |buf| ctx.allocator.free(buf);
+    if (ctx.src_v16) |buf| ctx.allocator.free(buf);
+
+    if (ctx.mid_lum) |buf| ctx.allocator.free(buf);
+    if (ctx.mid_u) |buf| ctx.allocator.free(buf);
+    if (ctx.mid_v) |buf| ctx.allocator.free(buf);
+
+    if (ctx.dst_y16) |buf| ctx.allocator.free(buf);
+    if (ctx.dst_u16) |buf| ctx.allocator.free(buf);
+    if (ctx.dst_v16) |buf| ctx.allocator.free(buf);
+}
+
+pub fn processScaler(
+    ctx: *types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) void {
+    const is_rgb_to_rgb = types.isPackedRgb(ctx.src_fmt) and types.isPackedRgb(ctx.dst_fmt);
+    const is_upscale = (ctx.src_w <= ctx.dst_w and ctx.src_h <= ctx.dst_h);
+
+    if (is_rgb_to_rgb and is_upscale) {
+        processRgbRgbScaler(ctx, src_data, src_stride, dst_data, dst_stride);
+        return;
+    }
+
+    // Standard YUV / cross-domain pipeline
+    unpackInput(ctx, src_data, src_stride);
+
+    scalePlane(
+        ctx.src_w,
+        ctx.src_h,
+        ctx.dst_w,
+        ctx.dst_h,
+        ctx.src_y16.?,
+        ctx.mid_lum.?,
+        ctx.dst_y16.?,
+        ctx.h_lum.?,
+        ctx.v_lum.?,
+    );
+
+    const dst_is_subsampled = (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_YUV422P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21);
+
+    const src_chr_w = if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21 or (types.isPackedRgb(ctx.src_fmt) and dst_is_subsampled)) (ctx.src_w + 1) / 2 else ctx.src_w;
+    const src_chr_h = if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_NV12 or ctx.src_fmt == types.PIXFMT_NV21) (ctx.src_h + 1) / 2 else ctx.src_h;
+
+    const dst_chr_w = if (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_YUV422P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21) (ctx.dst_w + 1) / 2 else ctx.dst_w;
+    const dst_chr_h = if (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_NV12 or ctx.dst_fmt == types.PIXFMT_NV21) (ctx.dst_h + 1) / 2 else ctx.dst_h;
+
+    scalePlane(
+        src_chr_w,
+        src_chr_h,
+        dst_chr_w,
+        dst_chr_h,
+        ctx.src_u16.?,
+        ctx.mid_u.?,
+        ctx.dst_u16.?,
+        ctx.h_chr.?,
+        ctx.v_chr.?,
+    );
+
+    scalePlane(
+        src_chr_w,
+        src_chr_h,
+        dst_chr_w,
+        dst_chr_h,
+        ctx.src_v16.?,
+        ctx.mid_v.?,
+        ctx.dst_v16.?,
+        ctx.h_chr.?,
+        ctx.v_chr.?,
+    );
+
+    packOutput(ctx, dst_data, dst_stride);
+}
+
+fn processRgbRgbScaler(
+    ctx: *types.SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) void {
+    const w_src = ctx.src_w;
+    const h_src = ctx.src_h;
+    const w_dst = ctx.dst_w;
+    const h_dst = ctx.dst_h;
+
+    const src_ptr = src_data[0].?;
+    const s0: usize = @intCast(src_stride[0]);
+
+    const dst_ptr = dst_data[0].?;
+    const d0: usize = @intCast(dst_stride[0]);
+
+    // Unpack R, G, B channels directly to 16-bit (val << 6)
+    var r: usize = 0;
+    while (r < h_src) : (r += 1) {
+        const src_r = src_ptr + r * s0;
+        const dst_r = ctx.src_y16.?[r * w_src .. (r + 1) * w_src];
+        const dst_g = ctx.src_u16.?[r * w_src .. (r + 1) * w_src];
+        const dst_b = ctx.src_v16.?[r * w_src .. (r + 1) * w_src];
+
+        var c: usize = 0;
+        while (c < w_src) : (c += 1) {
+            const red, const green, const blue = getRgbComponents(ctx.src_fmt, src_r, c);
+            dst_r[c] = @as(i16, red) << 6;
+            dst_g[c] = @as(i16, green) << 6;
+            dst_b[c] = @as(i16, blue) << 6;
+        }
+    }
+
+    // Scale R, G, B planes directly
+    scalePlane(w_src, h_src, w_dst, h_dst, ctx.src_y16.?, ctx.mid_lum.?, ctx.dst_y16.?, ctx.h_lum.?, ctx.v_lum.?);
+    scalePlane(w_src, h_src, w_dst, h_dst, ctx.src_u16.?, ctx.mid_u.?, ctx.dst_u16.?, ctx.h_lum.?, ctx.v_lum.?);
+    scalePlane(w_src, h_src, w_dst, h_dst, ctx.src_v16.?, ctx.mid_v.?, ctx.dst_v16.?, ctx.h_lum.?, ctx.v_lum.?);
+
+    // Pack scaled R, G, B planes back to destination format
+    r = 0;
+    while (r < h_dst) : (r += 1) {
+        const src_r = ctx.dst_y16.?[r * w_dst .. (r + 1) * w_dst];
+        const src_g = ctx.dst_u16.?[r * w_dst .. (r + 1) * w_dst];
+        const src_b = ctx.dst_v16.?[r * w_dst .. (r + 1) * w_dst];
+        const dst_r = dst_ptr + r * d0;
+
+        var c: usize = 0;
+        while (c < w_dst) : (c += 1) {
+            const red: u8 = @intCast(std.math.clamp((src_r[c] + 32) >> 6, 0, 255));
+            const green: u8 = @intCast(std.math.clamp((src_g[c] + 32) >> 6, 0, 255));
+            const blue: u8 = @intCast(std.math.clamp((src_b[c] + 32) >> 6, 0, 255));
+
+            putRgbComponents(ctx.dst_fmt, dst_r, c, red, green, blue);
+        }
+    }
+}
+
+fn getRgbComponents(fmt: c_int, src: [*]const u8, idx: usize) struct { u8, u8, u8 } {
+    return switch (fmt) {
+        types.PIXFMT_RGB24 => .{ src[idx * 3 + 0], src[idx * 3 + 1], src[idx * 3 + 2] },
+        types.PIXFMT_BGR24 => .{ src[idx * 3 + 2], src[idx * 3 + 1], src[idx * 3 + 0] },
+        types.PIXFMT_RGBA => .{ src[idx * 4 + 0], src[idx * 4 + 1], src[idx * 4 + 2] },
+        types.PIXFMT_BGRA => .{ src[idx * 4 + 2], src[idx * 4 + 1], src[idx * 4 + 0] },
+        else => .{ 0, 0, 0 },
+    };
+}
+
+fn putRgbComponents(fmt: c_int, dst: [*]u8, idx: usize, r: u8, g: u8, b: u8) void {
+    switch (fmt) {
+        types.PIXFMT_RGB24 => {
+            dst[idx * 3 + 0] = r;
+            dst[idx * 3 + 1] = g;
+            dst[idx * 3 + 2] = b;
+        },
+        types.PIXFMT_BGR24 => {
+            dst[idx * 3 + 0] = b;
+            dst[idx * 3 + 1] = g;
+            dst[idx * 3 + 2] = r;
+        },
+        types.PIXFMT_RGBA => {
+            dst[idx * 4 + 0] = r;
+            dst[idx * 4 + 1] = g;
+            dst[idx * 4 + 2] = b;
+            dst[idx * 4 + 3] = 255;
+        },
+        types.PIXFMT_BGRA => {
+            dst[idx * 4 + 0] = b;
+            dst[idx * 4 + 1] = g;
+            dst[idx * 4 + 2] = r;
+            dst[idx * 4 + 3] = 255;
+        },
+        else => {},
+    }
+}
+
+fn scalePlane(
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    src_buf: []const i16,
+    mid_buf: []i32,
+    dst_buf: []i16,
+    h_filter: types.ScaleFilter1D,
+    v_filter: types.ScaleFilter1D,
+) void {
+    // Horizontal scaling pass
+    var r: usize = 0;
+    while (r < src_h) : (r += 1) {
+        const src_row = src_buf[r * src_w .. (r + 1) * src_w];
+        const mid_row = mid_buf[r * dst_w .. (r + 1) * dst_w];
+
+        var c: usize = 0;
+        while (c < dst_w) : (c += 1) {
+            const start_pos = h_filter.pos[c];
+            const fs = h_filter.filter_size;
+            var sum: i32 = 0;
+            var j: usize = 0;
+            while (j < fs) : (j += 1) {
+                const src_idx = if (start_pos + j < src_w) start_pos + j else src_w - 1;
+                sum += @as(i32, src_row[src_idx]) * @as(i32, h_filter.weights[c * fs + j]);
+            }
+            mid_row[c] = (sum + 64) >> 7;
+        }
+    }
+
+    // Vertical scaling pass
+    var c: usize = 0;
+    while (c < dst_w) : (c += 1) {
+        var dr: usize = 0;
+        while (dr < dst_h) : (dr += 1) {
+            const start_pos = v_filter.pos[dr];
+            const fs = v_filter.filter_size;
+            var sum: i64 = 0;
+            var j: usize = 0;
+            while (j < fs) : (j += 1) {
+                const src_r = if (start_pos + j < src_h) start_pos + j else src_h - 1;
+                sum += @as(i64, mid_buf[src_r * dst_w + c]) * @as(i64, v_filter.weights[dr * fs + j]);
+            }
+            dst_buf[dr * dst_w + c] = @intCast(std.math.clamp((sum + (1 << 18)) >> 19, -32768, 32767));
+        }
+    }
+}
+
+fn unpackInput(ctx: *types.SwsContext, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int) void {
+    const w = ctx.src_w;
+    const h = ctx.src_h;
+
+    switch (ctx.src_fmt) {
+        types.PIXFMT_YUV420P => {
+            const y_ptr = src_data[0].?;
+            const u_ptr = src_data[1].?;
+            const v_ptr = src_data[2].?;
+            const ys: usize = @intCast(src_stride[0]);
+            const us: usize = @intCast(src_stride[1]);
+            const vs: usize = @intCast(src_stride[2]);
+
+            var r: usize = 0;
+            while (r < h) : (r += 1) {
+                const src_r = y_ptr + r * ys;
+                const dst_r = ctx.src_y16.?[r * w .. (r + 1) * w];
+                var c: usize = 0;
+                while (c < w) : (c += 1) {
+                    dst_r[c] = @as(i16, src_r[c]) << 6;
+                }
+            }
+
+            const cw = (w + 1) / 2;
+            const ch = (h + 1) / 2;
+            r = 0;
+            while (r < ch) : (r += 1) {
+                const u_r = u_ptr + r * us;
+                const v_r = v_ptr + r * vs;
+                const dst_u = ctx.src_u16.?[r * cw .. (r + 1) * cw];
+                const dst_v = ctx.src_v16.?[r * cw .. (r + 1) * cw];
+                var c: usize = 0;
+                while (c < cw) : (c += 1) {
+                    dst_u[c] = @as(i16, u_r[c]) << 6;
+                    dst_v[c] = @as(i16, v_r[c]) << 6;
+                }
+            }
+        },
+        types.PIXFMT_NV12 => {
+            const y_ptr = src_data[0].?;
+            const uv_ptr = src_data[1].?;
+            const ys: usize = @intCast(src_stride[0]);
+            const uvs: usize = @intCast(src_stride[1]);
+
+            var r: usize = 0;
+            while (r < h) : (r += 1) {
+                const src_r = y_ptr + r * ys;
+                const dst_r = ctx.src_y16.?[r * w .. (r + 1) * w];
+                var c: usize = 0;
+                while (c < w) : (c += 1) {
+                    dst_r[c] = @as(i16, src_r[c]) << 6;
+                }
+            }
+
+            const cw = (w + 1) / 2;
+            const ch = (h + 1) / 2;
+            r = 0;
+            while (r < ch) : (r += 1) {
+                const uv_r = uv_ptr + r * uvs;
+                const dst_u = ctx.src_u16.?[r * cw .. (r + 1) * cw];
+                const dst_v = ctx.src_v16.?[r * cw .. (r + 1) * cw];
+                var c: usize = 0;
+                while (c < cw) : (c += 1) {
+                    dst_u[c] = @as(i16, uv_r[c * 2 + 0]) << 6;
+                    dst_v[c] = @as(i16, uv_r[c * 2 + 1]) << 6;
+                }
+            }
+        },
+        types.PIXFMT_NV21 => {
+            const y_ptr = src_data[0].?;
+            const vu_ptr = src_data[1].?;
+            const ys: usize = @intCast(src_stride[0]);
+            const vus: usize = @intCast(src_stride[1]);
+
+            var r: usize = 0;
+            while (r < h) : (r += 1) {
+                const src_r = y_ptr + r * ys;
+                const dst_r = ctx.src_y16.?[r * w .. (r + 1) * w];
+                var c: usize = 0;
+                while (c < w) : (c += 1) {
+                    dst_r[c] = @as(i16, src_r[c]) << 6;
+                }
+            }
+
+            const cw = (w + 1) / 2;
+            const ch = (h + 1) / 2;
+            r = 0;
+            while (r < ch) : (r += 1) {
+                const vu_r = vu_ptr + r * vus;
+                const dst_u = ctx.src_u16.?[r * cw .. (r + 1) * cw];
+                const dst_v = ctx.src_v16.?[r * cw .. (r + 1) * cw];
+                var c: usize = 0;
+                while (c < cw) : (c += 1) {
+                    dst_v[c] = @as(i16, vu_r[c * 2 + 0]) << 6;
+                    dst_u[c] = @as(i16, vu_r[c * 2 + 1]) << 6;
+                }
+            }
+        },
+        types.PIXFMT_YUV422P => {
+            const y_ptr = src_data[0].?;
+            const u_ptr = src_data[1].?;
+            const v_ptr = src_data[2].?;
+            const ys: usize = @intCast(src_stride[0]);
+            const us: usize = @intCast(src_stride[1]);
+            const vs: usize = @intCast(src_stride[2]);
+
+            var r: usize = 0;
+            while (r < h) : (r += 1) {
+                const src_r = y_ptr + r * ys;
+                const dst_r = ctx.src_y16.?[r * w .. (r + 1) * w];
+                var c: usize = 0;
+                while (c < w) : (c += 1) {
+                    dst_r[c] = @as(i16, src_r[c]) << 6;
+                }
+            }
+
+            const cw = (w + 1) / 2;
+            r = 0;
+            while (r < h) : (r += 1) {
+                const u_r = u_ptr + r * us;
+                const v_r = v_ptr + r * vs;
+                const dst_u = ctx.src_u16.?[r * cw .. (r + 1) * cw];
+                const dst_v = ctx.src_v16.?[r * cw .. (r + 1) * cw];
+                var c: usize = 0;
+                while (c < cw) : (c += 1) {
+                    dst_u[c] = @as(i16, u_r[c]) << 6;
+                    dst_v[c] = @as(i16, v_r[c]) << 6;
+                }
+            }
+        },
+        types.PIXFMT_YUV444P => {
+            const y_ptr = src_data[0].?;
+            const u_ptr = src_data[1].?;
+            const v_ptr = src_data[2].?;
+            const ys: usize = @intCast(src_stride[0]);
+            const us: usize = @intCast(src_stride[1]);
+            const vs: usize = @intCast(src_stride[2]);
+
+            var r: usize = 0;
+            while (r < h) : (r += 1) {
+                const y_r = y_ptr + r * ys;
+                const u_r = u_ptr + r * us;
+                const v_r = v_ptr + r * vs;
+
+                const dst_y = ctx.src_y16.?[r * w .. (r + 1) * w];
+                const dst_u = ctx.src_u16.?[r * w .. (r + 1) * w];
+                const dst_v = ctx.src_v16.?[r * w .. (r + 1) * w];
+
+                var c: usize = 0;
