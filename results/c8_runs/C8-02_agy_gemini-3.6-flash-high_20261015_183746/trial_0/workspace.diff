+                @as(u16, u_src_row1[c * 2 + 0]) + @as(u16, u_src_row1[c * 2 + 1]);
+            const v_sum: u16 = @as(u16, v_src_row0[c * 2 + 0]) + @as(u16, v_src_row0[c * 2 + 1]) +
+                @as(u16, v_src_row1[c * 2 + 0]) + @as(u16, v_src_row1[c * 2 + 1]);
