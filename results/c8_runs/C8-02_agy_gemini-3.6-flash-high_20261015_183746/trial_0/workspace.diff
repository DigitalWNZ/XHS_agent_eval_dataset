+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_BGR24) {
+            yuv2rgb.convertYuv420pToBgr24(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), src_data[2].?, @intCast(src_stride[2]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
+        if (ctx.dst_fmt == types.PIXFMT_RGBA) {
