+        const v_dst_row = v_dst + r * v_dst_stride;
+
+        var c: usize = 0;
+        while (c < width / 2) : (c += 1) {
+            u_dst_row[c] = @intCast((@as(u16, u_src_row0[c]) + @as(u16, u_src_row1[c]) + 1) >> 1);
+            v_dst_row[c] = @intCast((@as(u16, v_src_row0[c]) + @as(u16, v_src_row1[c]) + 1) >> 1);
+        }
+    }
+}
