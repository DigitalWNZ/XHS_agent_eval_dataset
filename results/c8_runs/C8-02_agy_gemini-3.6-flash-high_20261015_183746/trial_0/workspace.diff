+pub fn convertYuv422pToYuv420p(
+    y_src: [*]const u8,
+    y_src_stride: usize,
+    u_src: [*]const u8,
+    u_src_stride: usize,
+    v_src: [*]const u8,
+    v_src_stride: usize,
+    y_dst: [*]u8,
+    y_dst_stride: usize,
