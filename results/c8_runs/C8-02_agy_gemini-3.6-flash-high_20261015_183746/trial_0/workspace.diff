+            return true;
+        }
+    }
+
+    if (ctx.src_fmt == types.PIXFMT_NV21) {
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            yuv2rgb.convertNv21ToRgb24(src_data[0].?, @intCast(src_stride[0]), src_data[1].?, @intCast(src_stride[1]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            return true;
+        }
