+ref_V = np.frombuffer(ref_bytes[w*h+(w//2)*(h//2):], dtype=np.uint8).reshape((h//2, w//2))
+
+with open("/tmp/src_dump.raw", "rb") as f:
+    src_bytes = f.read()
+
+# Run candidate to dump RGB24
+CANDIDATE = "/app/swscale-impl/zig-out/lib/libswscale_candidate.so"
+cmd_cand = workloads.driver_argv(DRIVER, CANDIDATE, wl, 1, "/tmp/cand_dummy.raw")
+subprocess.run(cmd_cand, check=True)
+
+with open("/tmp/src_dump.raw", "rb") as f:
+    rgb_src_bytes = f.read()
+
+rgb_img = np.frombuffer(rgb_src_bytes[:w*h*3], dtype=np.uint8).reshape((h, w, 3)).astype(np.int32)
+R = rgb_img[:, :, 0]
+G = rgb_img[:, :, 1]
+B = rgb_img[:, :, 2]
+
+ru = -int(0.169 * 224 / 255 * 32768 + 0.5) # -4863
+gu = -int(0.331 * 224 / 255 * 32768 + 0.5) # -9524
+bu = int(0.500 * 224 / 255 * 32768 + 0.5) # 14387
+
+rv = int(0.500 * 224 / 255 * 32768 + 0.5) # 14387
+gv = -int(0.419 * 224 / 255 * 32768 + 0.5) # -12056
+bv = -int(0.081 * 224 / 255 * 32768 + 0.5) # -2331
+
+# Test different chroma U rounding/shifting
+u00 = (ru*R[0::2, 0::2] + gu*G[0::2, 0::2] + bu*B[0::2, 0::2] + (256 << 14) + (1 << 8)) >> 9
+u01 = (ru*R[0::2, 1::2] + gu*G[0::2, 1::2] + bu*B[0::2, 1::2] + (256 << 14) + (1 << 8)) >> 9
+u10 = (ru*R[1::2, 0::2] + gu*G[1::2, 0::2] + bu*B[1::2, 0::2] + (256 << 14) + (1 << 8)) >> 9
+u11 = (ru*R[1::2, 1::2] + gu*G[1::2, 1::2] + bu*B[1::2, 1::2] + (256 << 14) + (1 << 8)) >> 9
+
+u_avg = (u00 + u01 + u10 + u11 + 2) >> 2
+U_cand = np.clip((u_avg + 32) >> 6, 0, 255).astype(np.uint8)
+
+print("U diff max:", np.abs(ref_U.astype(int) - U_cand.astype(int)).max())
+print("U PSNR:", workloads.psnr(ref_U.tobytes(), U_cand.tobytes()))
