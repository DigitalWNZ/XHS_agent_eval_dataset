+++ b/scratch/test_yuv_formula.py
@@ -0,0 +1,55 @@
+import sys, os, subprocess, tempfile
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+DRIVER = "/app/driver"
+BASELINE = "/app/libswscale_public_baseline.so"
+
+wl = workloads.correctness_workloads()[0] # yuv420p -> rgb24 640x480
+tmp = tempfile.mktemp(suffix=".raw")
+cmd = workloads.driver_argv(DRIVER, BASELINE, wl, 1, tmp)
+subprocess.run(cmd, check=True)
+
+with open(tmp, "rb") as f:
+    ref_bytes = f.read()
+os.remove(tmp)
+
+# Now let's test our YUV2RGB formula on synthesized driver input!
+# How does driver synthesize yuv420p input for 640x480?
+# In driver.c:
+# width=640, height=480
+# Y plane: y in 0..479, x in 0..639: y_val = (x*3 + y*5 + 17) & 0xFF
+# U plane: y in 0..239, x in 0..319: u_val = (x*7 + y*11 + 31) & 0xFF
+# V plane: y in 0..239, x in 0..319: v_val = (x*13 + y*3 + 59) & 0xFF
+
+w, h = 640, 480
+Y = np.zeros((h, w), dtype=np.int32)
+for y in range(h):
+    for x in range(w):
+        Y[y, x] = (x*3 + y*5 + 17) & 0xFF
+
+U = np.zeros((h//2, w//2), dtype=np.int32)
+V = np.zeros((h//2, w//2), dtype=np.int32)
+for y in range(h//2):
+    for x in range(w//2):
+        U[y, x] = (x*7 + y*11 + 31) & 0xFF
+        V[y, x] = (x*13 + y*3 + 59) & 0xFF
+
+# Upsample U, V to 640x480 (nearest / box upsample for 4:2:0)
+U_full = np.repeat(np.repeat(U, 2, axis=0), 2, axis=1)
+V_full = np.repeat(np.repeat(V, 2, axis=0), 2, axis=1)
+
+c = Y - 16
+d = U_full - 128
+e = V_full - 128
+
+R = np.clip((298 * c + 409 * e + 128) >> 8, 0, 255).astype(np.uint8)
+G = np.clip((298 * c - 100 * d - 208 * e + 128) >> 8, 0, 255).astype(np.uint8)
+B = np.clip((298 * c + 516 * d + 128) >> 8, 0, 255).astype(np.uint8)
+
+cand_img = np.stack([R, G, B], axis=2).tobytes()
+
+grade = workloads.grade(ref_bytes, cand_img, 5, 640, 480, False)
+print("Grade result:", grade)
