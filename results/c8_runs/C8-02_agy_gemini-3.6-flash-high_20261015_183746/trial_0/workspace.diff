+            while (r < h) : (r += 1) {
+                const src_y = ctx.dst_y16.?[r * w .. (r + 1) * w];
+                const src_u = ctx.dst_u16.?[r * w .. (r + 1) * w];
+                const src_v = ctx.dst_v16.?[r * w .. (r + 1) * w];
+                const dst_r = rgb_ptr + r * s0;
+
+                var c: usize = 0;
+                while (c < w) : (c += 1) {
+                    const y_val: i64 = std.math.clamp((src_y[c] + 32) >> 6, 0, 255);
+                    const u_val: i64 = std.math.clamp((src_u[c] + 32) >> 6, 0, 255);
+                    const v_val: i64 = std.math.clamp((src_v[c] + 32) >> 6, 0, 255);
+
+                    var Y: i64 = y_val << 9;
+                    const U: i64 = (u_val - 128) << 9;
+                    const V: i64 = (v_val - 128) << 9;
+
+                    Y -= 8192;
+                    Y *= 9540;
+                    Y += 1 << 21;
+
+                    const R = Y + V * 13075;
+                    const G = Y + V * -6660 + U * -3209;
+                    const B = Y + U * 16525;
+
+                    dst_r[c * 4 + 0] = @intCast(std.math.clamp(B >> 22, 0, 255));
+                    dst_r[c * 4 + 1] = @intCast(std.math.clamp(G >> 22, 0, 255));
+                    dst_r[c * 4 + 2] = @intCast(std.math.clamp(R >> 22, 0, 255));
+                    dst_r[c * 4 + 3] = 255;
+                }
+            }
+        },
+        types.PIXFMT_GRAY8 => {
+            const g_ptr = dst_data[0].?;
+            const s0: usize = @intCast(dst_stride[0]);
+            var r: usize = 0;
+            while (r < h) : (r += 1) {
+                const src_r = ctx.dst_y16.?[r * w .. (r + 1) * w];
+                const dst_r = g_ptr + r * s0;
+                var c: usize = 0;
+                while (c < w) : (c += 1) {
+                    dst_r[c] = @intCast(std.math.clamp((src_r[c] + 32) >> 6, 0, 255));
+                }
+            }
+        },
+        else => {},
+    }
+}
diff --git a/swscale-impl/src/tables.zig b/swscale-impl/src/tables.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/tables.zig
@@ -0,0 +1,286 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+// Precomputed YUV to RGB table constants
+pub var y_table: [2048]u8 = undefined;
+pub var table_rV: [256]i32 = undefined;
+pub var table_gU: [256]i32 = undefined;
+pub var table_bU: [256]i32 = undefined;
+pub var table_gV: [256]i32 = undefined;
+var tables_initialized: bool = false;
+
+pub const YOFFS: usize = 326 + 512; // 838
+
+pub const dither_220: [8][8]i32 = .{
+    .{ 117,  62, 158, 103, 113,  58, 155, 100 },
+    .{  34, 199,  21, 186,  31, 196,  17, 182 },
+    .{ 144,  89, 131,  76, 141,  86, 127,  72 },
+    .{   0, 165,  41, 206,  10, 175,  52, 217 },
+    .{ 110,  55, 151,  96, 120,  65, 162, 107 },
+    .{  28, 193,  14, 179,  38, 203,  24, 189 },
+    .{ 138,  83, 124,  69, 148,  93, 134,  79 },
+    .{   7, 172,  48, 213,   3, 168,  45, 210 },
+};
+
+pub const dither_128: [8][8]i32 = .{
+    .{  36, 68,  60, 92,  34, 66,  58, 90 },
+    .{ 100,  4, 124, 28,  98,  2, 122, 26 },
+    .{  52, 84,  44, 76,  50, 82,  42, 74 },
+    .{ 116, 20, 108, 12, 114, 18, 106, 10 },
+    .{  32, 64,  56, 88,  38, 70,  62, 94 },
+    .{  96,  0, 120, 24, 102,  6, 126, 30 },
+    .{  48, 80,  40, 72,  54, 86,  46, 78 },
+    .{ 112, 16, 104,  8, 118, 22, 110, 14 },
+};
+
+pub fn initYuvTables() void {
+    if (tables_initialized) return;
+
+    const cy: i64 = 76309;
+    const oy: i64 = 1048576;
+    const headroom: i64 = 512;
+    const plane_size: usize = 2048;
+
+    var yb: i64 = -(384 << 16) - headroom * cy - oy;
+    var i: usize = 0;
+    while (i < plane_size) : (i += 1) {
+        const yval: i64 = (yb + 0x8000) >> 16;
+        y_table[i] = @intCast(std.math.clamp(yval, 0, 255));
+        yb += cy;
+    }
+
+    const crv: i64 = @divTrunc((104597 * 65536) + 0x8000, cy); // 89828
+    const cbu: i64 = @divTrunc((132201 * 65536) + 0x8000, cy); // 113536
+    const cgu: i64 = @divTrunc((-25675 * 65536) + 0x8000, cy); // -22049
+    const cgv: i64 = @divTrunc((-53279 * 65536) + 0x8000, cy); // -45757
+
+    fillGvTable(&table_rV, crv);
+    fillGvTable(&table_gU, cgu);
+    fillGvTable(&table_bU, cbu);
+    fillGvTable(&table_gV, cgv);
+
+    tables_initialized = true;
+}
+
+fn fillGvTable(table: *[256]i32, inc: i64) void {
+    const off: i32 = @intCast(-@divTrunc(inc, 512));
+    var idx: usize = 0;
+    while (idx < 256) : (idx += 1) {
+        const cb: i64 = @as(i64, @intCast(idx)) * inc;
+        table[idx] = off + @as(i32, @intCast(@divTrunc(cb, 65536)));
+    }
+}
+
+// ── Scaler 1D Filter Generators (Matching FFmpeg initFilter) ─────────────────
+
+pub fn buildScaleFilter(
+    allocator: std.mem.Allocator,
+    algo: c_int,
+    src_len: usize,
+    dst_len: usize,
+    is_vertical: bool,
+) !types.ScaleFilter1D {
+    const one: i64 = if (is_vertical) 4096 else 16384;
+
+    if (src_len == dst_len) {
+        const pos = try allocator.alloc(usize, dst_len);
+        const weights = try allocator.alloc(i16, dst_len);
+        const w_val: i16 = @intCast(one);
+        var i: usize = 0;
+        while (i < dst_len) : (i += 1) {
+            pos[i] = i;
+            weights[i] = w_val;
+        }
+        return types.ScaleFilter1D{
+            .filter_size = 1,
+            .pos = pos,
+            .weights = weights,
+        };
+    }
+
+    if (algo == types.ALGO_NEAREST) {
+        const pos = try allocator.alloc(usize, dst_len);
+        const weights = try allocator.alloc(i16, dst_len);
+        const w_val: i16 = @intCast(one);
+        const x_inc: i64 = @divTrunc(@as(i64, @intCast(src_len)) << 16, @as(i64, @intCast(dst_len)));
+
+        var xDstInSrc: i64 = @divTrunc(x_inc - 65536, 2);
+        var i: usize = 0;
+        while (i < dst_len) : (i += 1) {
+            const xx: i64 = (xDstInSrc + 32768) >> 16;
+            const p: usize = @intCast(std.math.clamp(xx, 0, @as(i64, @intCast(src_len - 1))));
+            pos[i] = p;
+            weights[i] = w_val;
+            xDstInSrc += x_inc;
+        }
+        return types.ScaleFilter1D{
+            .filter_size = 1,
+            .pos = pos,
+            .weights = weights,
+        };
+    }
+
+    // Bilinear & Bicubic Filters
+    const x_inc: i64 = @divTrunc(@as(i64, @intCast(src_len)) << 16, @as(i64, @intCast(dst_len)));
+    const log_ratio: usize = if (src_len >= dst_len) std.math.log2(src_len / dst_len) else 0;
+    const min_ratio: usize = @min(log_ratio, @as(usize, 8));
+    const shift_amt: u6 = @intCast(54 - min_ratio);
+    const fone: i64 = @as(i64, 1) << shift_amt;
+
+    var filter_size: usize = 2;
+    if (algo == types.ALGO_BICUBIC) {
+        const size_factor: usize = 4;
+        if (x_inc <= 65536) {
+            filter_size = 1 + size_factor;
+        } else {
+            filter_size = 1 + (size_factor * src_len + dst_len - 1) / dst_len;
+        }
+        if (src_len >= 3 and filter_size > src_len - 2) filter_size = src_len - 2;
+        if (filter_size < 1) filter_size = 1;
+    } else if (x_inc > 65536) {
+        const size_factor: usize = 2;
+        filter_size = 1 + (size_factor * src_len + dst_len - 1) / dst_len;
+        if (src_len >= 3 and filter_size > src_len - 2) filter_size = src_len - 2;
+        if (filter_size < 1) filter_size = 1;
+    }
+
+    const pos_i32 = try allocator.alloc(i32, dst_len);
+    defer allocator.free(pos_i32);
+    const filter_raw = try allocator.alloc(i64, dst_len * filter_size);
+    defer allocator.free(filter_raw);
+    @memset(filter_raw, 0);
+
+    if (x_inc <= 65536 and algo == types.ALGO_BILINEAR) {
+        // Bilinear Upscale
+        var xDstInSrc: i64 = @divTrunc(x_inc - 65536, 2);
+        var i: usize = 0;
+        while (i < dst_len) : (i += 1) {
+            const xx: i32 = @intCast((xDstInSrc - ((@as(i64, @intCast(filter_size)) - 1) << 15) + (1 << 15)) >> 16);
+            pos_i32[i] = xx;
+            var j: usize = 0;
+            while (j < filter_size) : (j += 1) {
+                const sample_x = (@as(i64, xx) + @as(i64, @intCast(j))) * 65536;
+                const dist = @abs(sample_x - xDstInSrc);
+                var coeff: i64 = fone - @as(i64, @intCast(dist)) * (fone >> 16);
+                if (coeff < 0) coeff = 0;
+                filter_raw[i * filter_size + j] = coeff;
+            }
+            xDstInSrc += x_inc;
+        }
+    } else {
+        // Downscale or Bicubic
+        var xDstInSrc: i64 = x_inc - 65536; // in 17-bit fixed point
+        var i: usize = 0;
+        while (i < dst_len) : (i += 1) {
+            const xx: i32 = @intCast(@divTrunc(xDstInSrc - (@as(i64, @intCast(filter_size)) - 2) * 65536, 131072));
+            pos_i32[i] = xx;
+
+            var j: usize = 0;
+            while (j < filter_size) : (j += 1) {
+                const sample_x = (@as(i64, xx) + @as(i64, @intCast(j))) * 131072;
+                var d: i64 = @as(i64, @intCast(@abs(sample_x - xDstInSrc))) << 13;
+                if (x_inc > 65536) {
+                    d = @divTrunc(d * @as(i64, @intCast(dst_len)), @as(i64, @intCast(src_len)));
+                }
+
+                var coeff: i64 = 0;
+                if (algo == types.ALGO_BICUBIC) {
+                    // Mitchell-Netravali / Catmull-Rom cubic spline
+                    const floatd: f64 = @as(f64, @floatFromInt(d)) * (1.0 / 1073741824.0);
+                    if (floatd < 1.0) {
+                        coeff = @intFromFloat((1.5 * floatd * floatd * floatd - 2.5 * floatd * floatd + 1.0) * @as(f64, @floatFromInt(fone)));
+                    } else if (floatd < 2.0) {
+                        coeff = @intFromFloat((-0.5 * floatd * floatd * floatd + 2.5 * floatd * floatd - 4.0 * floatd + 2.0) * @as(f64, @floatFromInt(fone)));
+                    } else {
+                        coeff = 0;
+                    }
+                } else {
+                    // Bilinear Downscale
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= (fone >> 30);
+                }
+                filter_raw[i * filter_size + j] = coeff;
+            }
+            xDstInSrc += 2 * x_inc;
+        }
+    }
+
+    // Step A: Border fixing
+    var i: usize = 0;
+    while (i < dst_len) : (i += 1) {
+        if (pos_i32[i] < 0) {
+            var j: usize = 1;
+            while (j < filter_size) : (j += 1) {
+                const left_i32: i32 = @max(@as(i32, @intCast(j)) + pos_i32[i], 0);
+                const left: usize = @intCast(left_i32);
+                filter_raw[i * filter_size + left] += filter_raw[i * filter_size + j];
+                filter_raw[i * filter_size + j] = 0;
+            }
+            pos_i32[i] = 0;
+        }
+
+        if (pos_i32[i] + @as(i32, @intCast(filter_size)) > @as(i32, @intCast(src_len))) {
+            const shift_i32: i32 = pos_i32[i] + @min(@as(i32, @intCast(filter_size)) - @as(i32, @intCast(src_len)), 0);
+            const shift: usize = @intCast(@max(shift_i32, 0));
+            var acc: i64 = 0;
+
+            var j: usize = filter_size;
+            while (j > 0) {
+                j -= 1;
+                if (pos_i32[i] + @as(i32, @intCast(j)) >= @as(i32, @intCast(src_len))) {
+                    acc += filter_raw[i * filter_size + j];
+                    filter_raw[i * filter_size + j] = 0;
+                }
+            }
+
+            j = filter_size;
+            while (j > 0) {
+                j -= 1;
+                if (j < shift) {
+                    filter_raw[i * filter_size + j] = 0;
+                } else {
+                    filter_raw[i * filter_size + j] = filter_raw[i * filter_size + j - shift];
+                }
+            }
+
+            pos_i32[i] -= @intCast(shift);
+            const target_j: usize = @intCast(@as(i32, @intCast(src_len)) - 1 - pos_i32[i]);
+            if (target_j < filter_size) {
+                filter_raw[i * filter_size + target_j] += acc;
+            }
+        }
+    }
+
+    // Step B: Normalize & error diffusion store
+    const pos = try allocator.alloc(usize, dst_len);
+    const weights = try allocator.alloc(i16, dst_len * filter_size);
+
+    i = 0;
+    while (i < dst_len) : (i += 1) {
+        pos[i] = @intCast(@max(pos_i32[i], 0));
+
+        var sum: i64 = 0;
+        var j: usize = 0;
+        while (j < filter_size) : (j += 1) {
+            sum += filter_raw[i * filter_size + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+
+        var err: i64 = 0;
+        j = 0;
+        while (j < filter_size) : (j += 1) {
+            const v = filter_raw[i * filter_size + j] + err;
+            const int_v: i16 = @intCast(std.math.clamp(@divTrunc(v + @divTrunc(sum, 2), sum), -32768, 32767));
+            weights[i * filter_size + j] = int_v;
+            err = v - @as(i64, int_v) * sum;
+        }
+    }
+
+    return types.ScaleFilter1D{
+        .filter_size = filter_size,
+        .pos = pos,
+        .weights = weights,
+    };
+}
diff --git a/swscale-impl/src/types.zig b/swscale-impl/src/types.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/types.zig
@@ -0,0 +1,66 @@
+const std = @import("std");
+
+pub const PIXFMT_YUV420P: c_int = 0;
+pub const PIXFMT_YUV422P: c_int = 1;
+pub const PIXFMT_YUV444P: c_int = 2;
+pub const PIXFMT_NV12: c_int = 3;
+pub const PIXFMT_NV21: c_int = 4;
+pub const PIXFMT_RGB24: c_int = 5;
+pub const PIXFMT_BGR24: c_int = 6;
+pub const PIXFMT_RGBA: c_int = 7;
+pub const PIXFMT_BGRA: c_int = 8;
+pub const PIXFMT_GRAY8: c_int = 9;
+
+pub const ALGO_NEAREST: c_int = 0;
+pub const ALGO_BILINEAR: c_int = 1;
+pub const ALGO_BICUBIC: c_int = 2;
+
+pub fn isPlanarYuv(fmt: c_int) bool {
+    return fmt == PIXFMT_YUV420P or fmt == PIXFMT_YUV422P or fmt == PIXFMT_YUV444P;
+}
+
+pub fn isSemiPlanarYuv(fmt: c_int) bool {
+    return fmt == PIXFMT_NV12 or fmt == PIXFMT_NV21;
+}
+
+pub fn isPackedRgb(fmt: c_int) bool {
+    return fmt == PIXFMT_RGB24 or fmt == PIXFMT_BGR24 or fmt == PIXFMT_RGBA or fmt == PIXFMT_BGRA;
+}
+
+pub const ScaleFilter1D = struct {
+    filter_size: usize,
+    pos: []usize,
+    weights: []i16, // Fixed point weights: 14-bit for H (sum=16384), 12-bit for V (sum=4096)
+};
+
+pub const SwsContext = struct {
+    src_w: usize,
+    src_h: usize,
+    src_fmt: c_int,
+    dst_w: usize,
+    dst_h: usize,
+    dst_fmt: c_int,
+    algo: c_int,
+    is_same_size: bool,
+
+    // Precalculated scaler filter parameters (allocated in swscale_create)
+    h_lum: ?ScaleFilter1D = null,
+    v_lum: ?ScaleFilter1D = null,
+    h_chr: ?ScaleFilter1D = null,
+    v_chr: ?ScaleFilter1D = null,
+
+    // Scratch buffers for horizontal resampled rows
+    mid_lum: ?[]i32 = null,
+    mid_u: ?[]i32 = null,
+    mid_v: ?[]i32 = null,
+
+    // Temp intermediate full frame planar buffers (16-bit Y, U, V)
+    src_y16: ?[]i16 = null,
+    src_u16: ?[]i16 = null,
+    src_v16: ?[]i16 = null,
+    dst_y16: ?[]i16 = null,
+    dst_u16: ?[]i16 = null,
+    dst_v16: ?[]i16 = null,
+
+    allocator: std.mem.Allocator,
+};
diff --git a/swscale-impl/src/yuv2rgb.zig b/swscale-impl/src/yuv2rgb.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/yuv2rgb.zig
@@ -0,0 +1,493 @@
+const std = @import("std");
+const types = @import("types.zig");
+const tables = @import("tables.zig");
+
+inline fn lookupY(base_idx: usize, off: i32) u8 {
+    const idx = @as(i32, @intCast(base_idx)) + off;
+    return tables.y_table[@intCast(std.math.clamp(idx, 0, 2047))];
+}
+
+pub fn convertYuv420pToRgb24(
+    y_ptr: [*]const u8,
+    y_stride: usize,
+    u_ptr: [*]const u8,
+    u_stride: usize,
+    v_ptr: [*]const u8,
+    v_stride: usize,
+    dst_ptr: [*]u8,
+    dst_stride: usize,
+    width: usize,
+    height: usize,
+) void {
+    tables.initYuvTables();
+    const rV = &tables.table_rV;
+    const gU = &tables.table_gU;
+    const gV = &tables.table_gV;
+    const bU = &tables.table_bU;
+
+    var r: usize = 0;
+    while (r < height) : (r += 1) {
+        const y_row = y_ptr + r * y_stride;
+        const u_row = u_ptr + (r / 2) * u_stride;
+        const v_row = v_ptr + (r / 2) * v_stride;
+        const dst_row = dst_ptr + r * dst_stride;
+
+        var c: usize = 0;
+        while (c < width) : (c += 1) {
+            const y_val = y_row[c];
+            const u_val = u_row[c / 2];
+            const v_val = v_row[c / 2];
+
+            const r_off = rV[v_val];
+            const g_off = gU[u_val] + gV[v_val];
+            const b_off = bU[u_val];
+
+            const base_idx = y_val + tables.YOFFS;
+            dst_row[c * 3 + 0] = lookupY(base_idx, r_off);
+            dst_row[c * 3 + 1] = lookupY(base_idx, g_off);
+            dst_row[c * 3 + 2] = lookupY(base_idx, b_off);
+        }
+    }
+}
+
+pub fn convertYuv420pToBgr24(
+    y_ptr: [*]const u8,
+    y_stride: usize,
+    u_ptr: [*]const u8,
+    u_stride: usize,
+    v_ptr: [*]const u8,
+    v_stride: usize,
+    dst_ptr: [*]u8,
+    dst_stride: usize,
+    width: usize,
+    height: usize,
+) void {
+    tables.initYuvTables();
+    const rV = &tables.table_rV;
+    const gU = &tables.table_gU;
+    const gV = &tables.table_gV;
+    const bU = &tables.table_bU;
+
+    var r: usize = 0;
+    while (r < height) : (r += 1) {
+        const y_row = y_ptr + r * y_stride;
+        const u_row = u_ptr + (r / 2) * u_stride;
+        const v_row = v_ptr + (r / 2) * v_stride;
+        const dst_row = dst_ptr + r * dst_stride;
+
+        var c: usize = 0;
+        while (c < width) : (c += 1) {
+            const y_val = y_row[c];
+            const u_val = u_row[c / 2];
+            const v_val = v_row[c / 2];
+
+            const r_off = rV[v_val];
+            const g_off = gU[u_val] + gV[v_val];
+            const b_off = bU[u_val];
+
+            const base_idx = y_val + tables.YOFFS;
+            dst_row[c * 3 + 0] = lookupY(base_idx, b_off);
+            dst_row[c * 3 + 1] = lookupY(base_idx, g_off);
+            dst_row[c * 3 + 2] = lookupY(base_idx, r_off);
+        }
+    }
+}
+
+pub fn convertYuv420pToRgba(
+    y_ptr: [*]const u8,
+    y_stride: usize,
+    u_ptr: [*]const u8,
+    u_stride: usize,
+    v_ptr: [*]const u8,
+    v_stride: usize,
+    dst_ptr: [*]u8,
+    dst_stride: usize,
+    width: usize,
+    height: usize,
+) void {
+    tables.initYuvTables();
+    const rV = &tables.table_rV;
+    const gU = &tables.table_gU;
+    const gV = &tables.table_gV;
+    const bU = &tables.table_bU;
+
+    var r: usize = 0;
+    while (r < height) : (r += 1) {
+        const y_row = y_ptr + r * y_stride;
+        const u_row = u_ptr + (r / 2) * u_stride;
+        const v_row = v_ptr + (r / 2) * v_stride;
+        const dst_row = dst_ptr + r * dst_stride;
+
+        var c: usize = 0;
+        while (c < width) : (c += 1) {
