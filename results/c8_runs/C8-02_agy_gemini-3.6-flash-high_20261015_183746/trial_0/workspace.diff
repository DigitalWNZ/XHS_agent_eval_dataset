diff --git a/scratch/test_rgb_scale.py b/scratch/test_rgb_scale.py
new file mode 100644
--- /dev/null
+++ b/scratch/test_rgb_scale.py
@@ -0,0 +1,59 @@
+import sys, os, subprocess, tempfile
+sys.path.insert(0, "/app")
+import numpy as np
+import workloads
+
+wl = workloads.correctness_workloads()[42] # rgb24 -> rgb24 1280x720 -> 640x360 bilinear
+DRIVER = "/app/driver"
+BASELINE = "/app/libswscale_public_baseline.so"
+
+tmp_ref = tempfile.mktemp(suffix=".raw")
+cmd_ref = workloads.driver_argv(DRIVER, BASELINE, wl, 1, tmp_ref)
+subprocess.run(cmd_ref, check=True)
+with open(tmp_ref, "rb") as f:
+    ref_bytes = f.read()
+os.remove(tmp_ref)
+
+w_src, h_src = 1280, 720
+w_dst, h_dst = 640, 360
+
+# Dump src_bytes (RGB24 1280x720)
+with open("/tmp/src_dump.raw", "rb") as f:
+    src_bytes = f.read()
+
+# Note: src_dump from previous run might be 640x480. Let's run candidate to dump 1280x720 input:
+CANDIDATE = "/app/swscale-impl/zig-out/lib/libswscale_candidate.so"
+cmd_cand = workloads.driver_argv(DRIVER, CANDIDATE, wl, 1, "/tmp/cand_dummy.raw")
+subprocess.run(cmd_cand, check=True)
+
+with open("/tmp/src_dump.raw", "rb") as f:
+    rgb_src_bytes = f.read()
+
+rgb_img = np.frombuffer(rgb_src_bytes[:w_src*h_src*3], dtype=np.uint8).reshape((h_src, w_src, 3))
+
+# Direct Bilinear Scaling on R, G, B planes using FFmpeg filter positions & weights
+# FFmpeg bilinear downscale 1280->640:
+# xInc = (1280 << 16) // 640 = 131072.
+# pos_fp[i] = i * 131072 + (131072 - 65536)//2 = i * 131072 + 32768.
+# src_idx = pos_fp >> 16 = 2*i.
+# frac = (pos_fp & 0xFFFF) >> 2 = 8192 (0.5).
+# weights = [8192, 8192] / 16384 (exact average of 2 adjacent pixels!).
+
+R = rgb_img[:, :, 0].astype(np.int32)
+G = rgb_img[:, :, 1].astype(np.int32)
+B = rgb_img[:, :, 2].astype(np.int32)
+
+# Horizontal average 1280 -> 640
+R_h = (R[:, 0::2] + R[:, 1::2] + 1) >> 1
+G_h = (G[:, 0::2] + G[:, 1::2] + 1) >> 1
+B_h = (B[:, 0::2] + B[:, 1::2] + 1) >> 1
+
+# Vertical average 720 -> 360
+R_v = (R_h[0::2, :] + R_h[1::2, :] + 1) >> 1
+G_v = (G_h[0::2, :] + G_h[1::2, :] + 1) >> 1
+B_v = (B_h[0::2, :] + B_h[1::2, :] + 1) >> 1
+
+cand_rgb = np.stack([R_v, G_v, B_v], axis=2).astype(np.uint8).tobytes()
+
+grade = workloads.grade(ref_bytes, cand_rgb, 5, 640, 360, True)
+print("RGB SCALE GRADE RESULT:", grade)
