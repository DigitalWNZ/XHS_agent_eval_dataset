+++ b/scratch/test_rgb2yuv_math.py
@@ -0,0 +1,59 @@
+import sys, os, subprocess, tempfile
+sys.path.insert(0, "/app")
+import numpy as np
+import workloads
+
+wl = workloads.correctness_workloads()[18] # rgb24 -> yuv420p 640x480
+DRIVER = "/app/driver"
+BASELINE = "/app/libswscale_public_baseline.so"
+
+tmp_ref = tempfile.mktemp(suffix=".raw")
+cmd_ref = workloads.driver_argv(DRIVER, BASELINE, wl, 1, tmp_ref)
+subprocess.run(cmd_ref, check=True)
+with open(tmp_ref, "rb") as f:
+    ref_bytes = f.read()
+os.remove(tmp_ref)
+
+w, h = 640, 480
+ref_Y = np.frombuffer(ref_bytes[:w*h], dtype=np.uint8).reshape((h, w))
+ref_U = np.frombuffer(ref_bytes[w*h:w*h+(w//2)*(h//2)], dtype=np.uint8).reshape((h//2, w//2))
+ref_V = np.frombuffer(ref_bytes[w*h+(w//2)*(h//2):], dtype=np.uint8).reshape((h//2, w//2))
+
+with open("/tmp/src_dump.raw", "rb") as f:
+    rgb_src_bytes = f.read()
+
+rgb_img = np.frombuffer(rgb_src_bytes[:w*h*3], dtype=np.uint8).reshape((h, w, 3)).astype(np.int32)
+R = rgb_img[:, :, 0]
+G = rgb_img[:, :, 1]
+B = rgb_img[:, :, 2]
+
+# Exact coefficients from utils.c / rgb2rgb_template.c:
+ry = int(0.299 * 219 / 255 * 32768 + 0.5) # 8414
+gy = int(0.587 * 219 / 255 * 32768 + 0.5) # 16519
+by = int(0.114 * 219 / 255 * 32768 + 0.5) # 3208
+
+ru = -int(0.169 * 224 / 255 * 32768 + 0.5) # -4863
+gu = -int(0.331 * 224 / 255 * 32768 + 0.5) # -9524
+bu = int(0.500 * 224 / 255 * 32768 + 0.5) # 14387
+
+rv = int(0.500 * 224 / 255 * 32768 + 0.5) # 14387
+gv = -int(0.419 * 224 / 255 * 32768 + 0.5) # -12056
+bv = -int(0.081 * 224 / 255 * 32768 + 0.5) # -2331
+
+# Y:
+Y_cand = np.clip(((ry * R + gy * G + by * B) >> 15) + 16, 0, 255).astype(np.uint8)
+
+# 2x2 average:
+Rx = (R[0::2, 0::2] + R[0::2, 1::2] + R[1::2, 0::2] + R[1::2, 1::2] + 2) >> 2
+Gx = (G[0::2, 0::2] + G[0::2, 1::2] + G[1::2, 0::2] + G[1::2, 1::2] + 2) >> 2
+Bx = (B[0::2, 0::2] + B[0::2, 1::2] + B[1::2, 0::2] + B[1::2, 1::2] + 2) >> 2
+
+U_cand = np.clip(((ru * Rx + gu * Gx + bu * Bx) >> 15) + 128, 0, 255).astype(np.uint8)
+V_cand = np.clip(((rv * Rx + gv * Gx + bv * Bx) >> 15) + 128, 0, 255).astype(np.uint8)
+
+print("U max diff:", np.abs(ref_U.astype(int) - U_cand.astype(int)).max())
+print("V max diff:", np.abs(ref_V.astype(int) - V_cand.astype(int)).max())
+
+cand_bytes = Y_cand.tobytes() + U_cand.tobytes() + V_cand.tobytes()
+grade = workloads.grade(ref_bytes, cand_bytes, 0, 640, 480, False)
+print("RGB2YUV EXACT GRADE RESULT:", grade)
