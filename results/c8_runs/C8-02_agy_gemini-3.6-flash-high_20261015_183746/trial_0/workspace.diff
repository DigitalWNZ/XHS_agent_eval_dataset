+        var c2: usize = 0;
+        while (c2 < width / 2) : (c2 += 1) {
+            const r0: i32 = src_row[(c2 * 2 + 0) * 3 + 0];
+            const g0: i32 = src_row[(c2 * 2 + 0) * 3 + 1];
+            const b0: i32 = src_row[(c2 * 2 + 0) * 3 + 2];
+
+            const r1: i32 = src_row[(c2 * 2 + 1) * 3 + 0];
+            const g1: i32 = src_row[(c2 * 2 + 1) * 3 + 1];
+            const b1: i32 = src_row[(c2 * 2 + 1) * 3 + 2];
+
+            const rx = (r0 + r1) >> 1;
+            const gx = (g0 + g1) >> 1;
+            const bx = (b0 + b1) >> 1;
+
+            const u_val = ((RU * rx + GU * gx + BU * bx) >> 15) + 128;
+            const v_val = ((RV * rx + GV * gx + BV * bx) >> 15) + 128;
+
+            u_row[c2] = @intCast(std.math.clamp(u_val, 0, 255));
+            v_row[c2] = @intCast(std.math.clamp(v_val, 0, 255));
+        }
+    }
+}
