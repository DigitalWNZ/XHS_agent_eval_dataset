+      // Calculate total remaining
+      let totalRemainingInOrder = 0;
+      for (let origItem of order.items) {
+        let prevRefundedQty = 0;
+        for (let r of order.refunds) {
+          let rItem = r.items.find(ri => ri.sku === origItem.sku);
+          if (rItem) prevRefundedQty += rItem.qty;
+        }
+        totalRemainingInOrder += (origItem.qty - prevRefundedQty);
+      }
+
+      let totalRequestedQty = reqItems.reduce((sum, cur) => sum + cur.qty, 0);
+      let remPayable = round(order.payable - order.refundedAmount);
+      let amount = 0;
+
+      if (totalRequestedQty === totalRemainingInOrder) {
+        amount = remPayable;
+      } else {
+        let calcSum = 0;
+        for (let req of reqItems) {
+          let origItem = order.items.find(i => i.sku === req.sku);
+          calcSum += req.qty * origItem.unitPrice * order.payable / order.subtotal;
+        }
+        amount = round(calcSum);
+        if (amount > remPayable) amount = remPayable;
+      }
+
+      document.getElementById('as-calc-amount').innerText = `￥${amount.toFixed(2)}`;
+    }
+
+    function submitAfterSaleUI() {
+      let orderId = document.getElementById('as-order-id').value;
+      let returnGoods = document.getElementById('as-return-goods').checked;
+      let inputs = document.querySelectorAll('.as-item-input');
+      let items = [];
+      inputs.forEach(inp => {
+        let q = parseInt(inp.value, 10);
+        if (q > 0) {
+          items.push({ sku: inp.dataset.sku, qty: q });
+        }
+      });
+
+      let res = doRequestAfterSale(orderId, items, { returnGoods });
+      if (!res.ok) {
+        toast(res.error, "error");
+      } else {
+        toast(`售后申请成功！退款 ￥${res.amount.toFixed(2)}`, "success");
+        hideAfterSaleModal();
+      }
+    }
+
+    function renderAfterSales() {
+      let tbody = document.getElementById('aftersales-table-body');
+      tbody.innerHTML = "";
+
+      let allRefunds = [];
+      state.orders.forEach(o => {
+        (o.refunds || []).forEach(r => {
+          allRefunds.push({ orderId: o.id, refund: r });
+        });
+      });
+
+      if (allRefunds.length === 0) {
+        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color: var(--text-muted); padding:20px;">暂无售后退款记录</td></tr>`;
+        return;
+      }
+
+      allRefunds.forEach(item => {
+        let r = item.refund;
+        let rItemsText = r.items.map(i => `${i.sku} × ${i.qty}`).join(', ');
+        let tr = document.createElement('tr');
+
+        let actionBtn = '';
+        if (r.returnGoods && !r.restocked) {
+          actionBtn = `<button class="btn btn-primary btn-sm" onclick="uiConfirmReturn('${r.id}')">确认退货入库</button>`;
+        } else if (r.restocked) {
+          actionBtn = `<span style="color:green; font-size:12px;">已入库</span>`;
+        } else {
+          actionBtn = `<span style="color:var(--text-muted); font-size:12px;">无需入库</span>`;
+        }
+
+        tr.innerHTML = `
+          <td>${r.id}</td>
+          <td>${item.orderId}</td>
+          <td>${rItemsText}</td>
+          <td>￥${r.amount.toFixed(2)}</td>
+          <td>${r.returnGoods ? '退货退款' : '仅退款'}</td>
+          <td>${r.restocked ? '<span class="badge badge-shipped">已入库</span>' : '<span class="badge badge-pending">待入库</span>'}</td>
+          <td>${actionBtn}</td>
+        `;
+
+        tbody.appendChild(tr);
+      });
+    }
+
+    function uiConfirmReturn(refundId) {
+      let res = doConfirmReturn(refundId);
+      if (!res.ok) toast(res.error, "error");
+      else toast(`售后单 ${refundId} 确认入库成功，库存已更新`, "success");
+    }
+
+    function renderStats() {
