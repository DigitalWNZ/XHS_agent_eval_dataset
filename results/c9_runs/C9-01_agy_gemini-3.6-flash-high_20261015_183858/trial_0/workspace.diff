+        if (parsed.cart && Array.isArray(parsed.cart.lines)) state.cart = parsed.cart;
+        else state.cart = { lines: [], couponCode: null };
+
+        saveState();
+        renderAll();
+        return { ok: true };
+      } catch (e) {
