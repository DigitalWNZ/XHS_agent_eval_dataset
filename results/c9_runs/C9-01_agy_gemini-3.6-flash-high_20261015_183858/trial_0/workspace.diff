+
+    // Global State
+    let state = getDefaultData();
+    const STORAGE_KEY = 'POP_TOY_SHOP_DATA_V1';
+
+    function round(num) {
+      return Math.round((Number(num) + Number.EPSILON) * 100) / 100;
+    }
+
+    function saveState() {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+      } catch (e) {
+        console.error("Storage save failed", e);
+      }
+    }
+
+    function loadState() {
+      try {
+        let saved = localStorage.getItem(STORAGE_KEY);
+        if (saved) {
+          let parsed = JSON.parse(saved);
+          if (parsed && Array.isArray(parsed.products) && Array.isArray(parsed.orders)) {
+            state = parsed;
+            if (!state.cart) state.cart = { lines: [], couponCode: null };
+            return;
+          }
+        }
+      } catch (e) {
+        console.error("Storage load failed", e);
+      }
+      state = getDefaultData();
+    }
+
+    function findVariant(sku) {
+      for (let p of state.products) {
+        let v = p.variants.find(v => v.sku === sku);
+        if (v) return { product: p, variant: v };
+      }
+      return null;
+    }
+
+    function addLog(action, detail) {
+      let now = new Date();
+      let timeStr = now.getFullYear() + '-' +
+        String(now.getMonth() + 1).padStart(2, '0') + '-' +
+        String(now.getDate()).padStart(2, '0') + ' ' +
+        String(now.getHours()).padStart(2, '0') + ':' +
+        String(now.getMinutes()).padStart(2, '0') + ':' +
+        String(now.getSeconds()).padStart(2, '0');
+      state.logs.unshift({ time: timeStr, action, detail });
+    }
+
+    function toast(msg, type = 'info') {
+      let container = document.getElementById('toast-container');
+      let t = document.createElement('div');
+      t.className = `toast ${type}`;
+      t.innerText = msg;
+      container.appendChild(t);
+      setTimeout(() => {
+        t.remove();
+      }, 3000);
+    }
+
+    // --- Core Business Logic (Used by both UI & window.shopTestAPI) ---
+
+    function doReset() {
+      state = getDefaultData();
+      state.isMember = false;
+      state.cart = { lines: [], couponCode: null };
+      saveState();
+      renderAll();
+      toast("系统已重置为初始数据", "success");
+      return { ok: true };
+    }
+
+    function doGetState() {
+      return {
+        products: JSON.parse(JSON.stringify(state.products)),
+        coupons: JSON.parse(JSON.stringify(state.coupons)),
+        isMember: !!state.isMember,
+        orders: JSON.parse(JSON.stringify(state.orders)),
+        logs: JSON.parse(JSON.stringify(state.logs))
+      };
+    }
+
+    function doSetMember(isMember) {
+      state.isMember = !!isMember;
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doAddToCart(sku, qty) {
+      qty = Number(qty);
+      if (!Number.isInteger(qty) || qty <= 0) {
+        return { ok: false, error: "数量必须为大于0的整数" };
+      }
+      let item = findVariant(sku);
+      if (!item) {
+        return { ok: false, error: "商品SKU不存在" };
+      }
+      let existingLine = state.cart.lines.find(l => l.sku === sku);
+      let currentQty = existingLine ? existingLine.qty : 0;
+      if (currentQty + qty > item.variant.stock) {
+        return { ok: false, error: "添加失败，超过可用库存" };
+      }
+      if (existingLine) {
+        existingLine.qty += qty;
+      } else {
+        state.cart.lines.push({ sku, qty });
+      }
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doSetCartQty(sku, qty) {
+      qty = Number(qty);
+      if (!Number.isInteger(qty) || qty <= 0) {
+        return { ok: false, error: "数量必须为大于0的整数" };
+      }
+      let existingLine = state.cart.lines.find(l => l.sku === sku);
+      if (!existingLine) {
+        return { ok: false, error: "购物车中不存在该商品" };
+      }
+      let item = findVariant(sku);
+      if (!item) {
+        return { ok: false, error: "商品SKU不存在" };
+      }
+      if (qty > item.variant.stock) {
+        return { ok: false, error: "超过商品最大库存" };
+      }
+      existingLine.qty = qty;
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doRemoveFromCart(sku) {
+      state.cart.lines = state.cart.lines.filter(l => l.sku !== sku);
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doApplyCoupon(code) {
+      if (code === null || code === "") {
+        state.cart.couponCode = null;
+        saveState();
+        renderAll();
+        return { ok: true };
+      }
+      let coupon = state.coupons.find(c => c.code === code);
+      if (!coupon) {
+        return { ok: false, error: "优惠券不存在" };
+      }
+      let cartData = doGetCart();
+      if (cartData.subtotal < coupon.threshold) {
+        return { ok: false, error: "订单金额未达到优惠券门槛" };
+      }
+      state.cart.couponCode = code;
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doGetCart() {
+      let lines = [];
+      let subtotal = 0;
+
+      for (let l of state.cart.lines) {
+        let item = findVariant(l.sku);
+        if (!item) continue;
+        let unitPrice = round(item.variant.price);
+        let lineTotal = round(unitPrice * l.qty);
+        subtotal = round(subtotal + lineTotal);
+        lines.push({
+          sku: l.sku,
+          qty: l.qty,
+          unitPrice: unitPrice,
+          lineTotal: lineTotal
+        });
+      }
+
+      let discounts = [];
+      if (state.isMember && subtotal > 0) {
+        let memberDiscount = round(subtotal * 0.1);
+        if (memberDiscount > 0) {
+          discounts.push({ type: "member", amount: memberDiscount });
+        }
+      }
+
+      if (state.cart.couponCode) {
+        let coupon = state.coupons.find(c => c.code === state.cart.couponCode);
+        if (coupon && subtotal >= coupon.threshold) {
+          discounts.push({ type: "coupon", amount: round(coupon.amount) });
+        }
+      }
+
+      let totalDiscounts = discounts.reduce((sum, d) => round(sum + d.amount), 0);
+      let total = Math.max(0, round(subtotal - totalDiscounts));
+
+      return { lines, subtotal, discounts, total };
+    }
+
+    function validateAddress(address) {
+      if (!address || typeof address !== 'object') {
+        return { ok: false, error: "收货信息不能为空" };
+      }
+      let name = (address.name || "").trim();
+      let phone = (address.phone || "").trim();
+      let addr = (address.address || "").trim();
+      if (!name || !phone || !addr) {
+        return { ok: false, error: "收货人、手机号和地址不能为空" };
+      }
+      if (!/^\d{11}$/.test(phone)) {
+        return { ok: false, error: "手机号必须为11位数字" };
+      }
+      return { ok: true, cleaned: { name, phone, address: addr } };
+    }
+
+    function doPrepareCheckout(address) {
+      let valRes = validateAddress(address);
+      if (!valRes.ok) return valRes;
+
+      let cartData = doGetCart();
+      if (cartData.lines.length === 0) {
+        return { ok: false, error: "购物车为空" };
+      }
+
+      for (let l of cartData.lines) {
+        let item = findVariant(l.sku);
+        if (!item || l.qty > item.variant.stock) {
+          return { ok: false, error: "商品 " + l.sku + " 库存不足" };
+        }
+      }
+
+      showCheckoutModal(valRes.cleaned, cartData);
+      return { ok: true };
+    }
+
+    function doCheckout(address) {
+      let valRes = validateAddress(address);
+      if (!valRes.ok) return valRes;
+
+      let cartData = doGetCart();
+      if (cartData.lines.length === 0) {
+        return { ok: false, error: "购物车为空" };
+      }
+
+      for (let l of cartData.lines) {
+        let item = findVariant(l.sku);
+        if (!item || l.qty > item.variant.stock) {
+          return { ok: false, error: "商品 " + l.sku + " 库存不足" };
+        }
+      }
+
+      // Deduct stock
+      for (let l of cartData.lines) {
+        let item = findVariant(l.sku);
+        item.variant.stock -= l.qty;
+      }
+
+      let now = new Date();
+      let datePart = now.getFullYear() +
+        String(now.getMonth() + 1).padStart(2, '0') +
+        String(now.getDate()).padStart(2, '0');
+      let randPart = String(Math.floor(Math.random() * 9000) + 1000);
+      let orderId = "ORD-" + datePart + "-" + randPart;
+
+      let order = {
+        id: orderId,
+        status: "pending",
+        createdAt: now.toISOString(),
+        paidAt: null,
+        items: cartData.lines.map(l => ({
+          sku: l.sku,
+          qty: l.qty,
+          unitPrice: l.unitPrice
+        })),
+        subtotal: cartData.subtotal,
+        discounts: cartData.discounts,
+        payable: cartData.total,
+        refundedAmount: 0.00,
+        refunds: []
+      };
+
+      state.orders.unshift(order);
+      state.cart = { lines: [], couponCode: null };
+      addLog("下单", "订单 " + orderId + " 下单成功，实付 " + order.payable + " 元");
+
+      hideCheckoutModal();
+      saveState();
+      renderAll();
+
+      return { ok: true, orderId };
+    }
+
+    function doPay(orderId) {
+      let order = state.orders.find(o => o.id === orderId);
+      if (!order) return { ok: false, error: "订单不存在" };
+      if (order.status !== "pending") {
+        return { ok: false, error: "当前订单状态不可付款" };
+      }
+
+      order.status = "paid";
+      order.paidAt = new Date().toISOString();
+      addLog("付款", "订单 " + orderId + " 完成付款，金额 " + order.payable + " 元");
+
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doShip(orderId) {
+      let order = state.orders.find(o => o.id === orderId);
+      if (!order) return { ok: false, error: "订单不存在" };
+      if (order.status !== "paid") {
+        return { ok: false, error: "当前订单状态不可发货" };
+      }
+
+      order.status = "shipped";
+      addLog("发货", "订单 " + orderId + " 已发货");
+
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doCancel(orderId) {
+      let order = state.orders.find(o => o.id === orderId);
+      if (!order) return { ok: false, error: "订单不存在" };
+      if (order.status !== "pending" && order.status !== "paid") {
+        return { ok: false, error: "当前订单状态不可取消" };
+      }
+
+      if (order.status === "pending") {
+        order.status = "cancelled";
+        for (let item of order.items) {
+          let v = findVariant(item.sku);
+          if (v) v.variant.stock += item.qty;
+        }
+        addLog("取消订单", "待付款订单 " + orderId + " 已取消并回补库存");
+      } else if (order.status === "paid") {
+        order.status = "cancelled";
+        for (let item of order.items) {
+          let v = findVariant(item.sku);
+          if (v) v.variant.stock += item.qty;
+        }
+        let remAmount = round(order.payable - order.refundedAmount);
+        if (remAmount > 0) {
+          let refRand = String(Math.floor(Math.random() * 9000) + 1000);
+          let refId = "REF-CANCEL-" + refRand;
+          let refundObj = {
+            id: refId,
+            items: order.items.map(i => ({ sku: i.sku, qty: i.qty })),
+            amount: remAmount,
+            returnGoods: false,
+            restocked: true
+          };
+          order.refundedAmount = round(order.refundedAmount + remAmount);
+          order.refunds.push(refundObj);
+        }
+        addLog("取消订单", "已付款订单 " + orderId + " 已取消，退款 " + remAmount + " 元并回补库存");
+      }
+
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function doRequestAfterSale(orderId, items, options) {
+      let order = state.orders.find(o => o.id === orderId);
+      if (!order) return { ok: false, error: "订单不存在" };
+      if (order.status !== "paid" && order.status !== "shipped") {
+        return { ok: false, error: "只有已付款或已发货订单可以申请售后" };
+      }
+      if (!Array.isArray(items) || items.length === 0) {
+        return { ok: false, error: "售后申请商品不能为空" };
+      }
+
+      let returnGoods = options && options.returnGoods === true;
+
+      for (let req of items) {
+        let qty = Number(req.qty);
+        if (!Number.isInteger(qty) || qty <= 0) {
+          return { ok: false, error: "退货数量必须为大于0的整数" };
+        }
+        let origItem = order.items.find(i => i.sku === req.sku);
+        if (!origItem) {
+          return { ok: false, error: "订单中不存在商品 " + req.sku };
+        }
+        let prevRefundedQty = 0;
+        for (let r of order.refunds) {
+          let rItem = r.items.find(ri => ri.sku === req.sku);
+          if (rItem) prevRefundedQty += rItem.qty;
+        }
+        let maxQty = origItem.qty - prevRefundedQty;
+        if (qty > maxQty) {
+          return { ok: false, error: "商品 " + req.sku + " 退货数量超出可退上限 (" + maxQty + ")" };
+        }
+      }
+
+      let totalRemainingInOrder = 0;
+      for (let origItem of order.items) {
+        let prevRefundedQty = 0;
+        for (let r of order.refunds) {
+          let rItem = r.items.find(ri => ri.sku === origItem.sku);
+          if (rItem) prevRefundedQty += rItem.qty;
+        }
+        totalRemainingInOrder += (origItem.qty - prevRefundedQty);
+      }
+
+      let totalRequestedQty = items.reduce((sum, cur) => sum + Number(cur.qty), 0);
+      let remainingPayable = round(order.payable - order.refundedAmount);
+      let amount = 0;
+
+      if (totalRequestedQty === totalRemainingInOrder) {
+        amount = remainingPayable;
+      } else {
+        let calcSum = 0;
+        for (let req of items) {
+          let origItem = order.items.find(i => i.sku === req.sku);
+          calcSum += req.qty * origItem.unitPrice * order.payable / order.subtotal;
+        }
+        amount = round(calcSum);
+        if (amount > remainingPayable) {
+          amount = remainingPayable;
+        }
+      }
+      amount = Math.max(0, amount);
+
+      let restocked = false;
+      if (order.status === "paid") {
+        for (let req of items) {
+          let v = findVariant(req.sku);
+          if (v) v.variant.stock += req.qty;
+        }
+        restocked = true;
+      }
+
+      let refRand = String(Math.floor(Math.random() * 9000) + 1000);
+      let refundId = "REF-" + Date.now() + "-" + refRand;
+
+      let refundObj = {
+        id: refundId,
+        items: items.map(i => ({ sku: i.sku, qty: Number(i.qty) })),
+        amount: amount,
+        returnGoods: returnGoods,
+        restocked: restocked
+      };
+
+      order.refundedAmount = round(order.refundedAmount + amount);
+      order.refunds.push(refundObj);
+
+      addLog("售后申请", "订单 " + orderId + " 提交售后 " + refundId + "，退款 " + amount + " 元");
