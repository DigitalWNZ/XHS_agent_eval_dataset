+    function doConfirmReturn(refundId) {
+      let foundOrder = null;
+      let foundRefund = null;
+      for (let o of state.orders) {
+        let r = o.refunds.find(rf => rf.id === refundId);
+        if (r) {
+          foundOrder = o;
+          foundRefund = r;
+          break;
+        }
+      }
+
+      if (!foundRefund) {
+        return { ok: false, error: "售后单不存在" };
+      }
+      if (foundRefund.restocked) {
+        return { ok: false, error: "该售后单已入库或无需入库" };
+      }
+      if (!foundRefund.returnGoods) {
+        return { ok: false, error: "该售后单无需退货入库" };
+      }
+
+      for (let item of foundRefund.items) {
+        let v = findVariant(item.sku);
+        if (v) v.variant.stock += item.qty;
+      }
+      foundRefund.restocked = true;
+
+      addLog("退货入库", "售后单 " + refundId + " 确认商品入库，库存已更新");
