+    function updateAfterSaleCalc() {
+      let orderId = document.getElementById('as-order-id').value;
+      let order = state.orders.find(o => o.id === orderId);
+      if (!order) return;
+
+      let inputs = document.querySelectorAll('.as-item-input');
+      let reqItems = [];
+      inputs.forEach(inp => {
+        let q = parseInt(inp.value, 10);
+        if (q > 0) {
