+    function doQueryOrders(params) {
+      params = params || {};
+      return state.orders.filter(o => {
+        if (params.orderId) {
+          if (!o.id.toLowerCase().includes(params.orderId.toLowerCase().trim())) return false;
+        }
+        if (params.sku) {
+          if (!o.items.some(i => i.sku === params.sku)) return false;
+        }
+        if (params.status) {
+          if (o.status !== params.status) return false;
+        }
+        if (params.from) {
+          let orderDate = o.createdAt.slice(0, 10);
+          if (orderDate < params.from) return false;
+        }
+        if (params.to) {
+          let orderDate = o.createdAt.slice(0, 10);
+          if (orderDate > params.to) return false;
+        }
+        return true;
+      });
+    }
+
+    function doGetStats() {
+      let sales = 0;
+      let refunds = 0;
+      let unitsSold = {};
+
+      for (let p of state.products) {
+        for (let v of p.variants) {
+          unitsSold[v.sku] = 0;
+        }
+      }
+
+      for (let o of state.orders) {
+        for (let r of o.refunds) {
+          refunds = round(refunds + r.amount);
+        }
+
+        if (o.paidAt !== null && o.paidAt !== undefined) {
+          sales = round(sales + o.payable);
+
+          for (let item of o.items) {
+            unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+          }
+          for (let r of o.refunds) {
+            for (let rItem of r.items) {
+              unitsSold[rItem.sku] = (unitsSold[rItem.sku] || 0) - rItem.qty;
+            }
+          }
+        }
+      }
+
+      let net = round(sales - refunds);
+      return {
+        sales: round(sales),
+        refunds: round(refunds),
+        net: round(net),
+        unitsSold
+      };
+    }
