+        saveState();
+        renderUI();
+        return { ok: true, refundId: refundId, amount: refundAmount };
+      }
+
+      function doConfirmReturn(refundId) {
+        let targetOrder = null;
+        let targetRefund = null;
+
+        for (const o of state.orders) {
+          const r = (o.refunds || []).find(x => x.id === refundId);
+          if (r) {
+            targetOrder = o;
+            targetRefund = r;
+            break;
+          }
+        }
+
+        if (!targetRefund) {
+          return { ok: false, error: "售后记录不存在" };
+        }
