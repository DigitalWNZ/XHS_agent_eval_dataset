+      window.recalcAfterSaleAmount = function () {
+        const orderId = document.getElementById('aftersale-order-id')?.value;
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) return;
+
+        const inputs = document.querySelectorAll('.aftersale-item-qty');
+        const reqItems = [];
+        inputs.forEach(inp => {
+          const sku = inp.dataset.sku;
+          const qty = parseInt(inp.value, 10) || 0;
+          if (qty > 0) {
+            reqItems.push({ sku: sku, qty: qty });
+          }
+        });
+
+        const amountEl = document.getElementById('aftersale-calc-amount');
+        const noteEl = document.getElementById('aftersale-calc-note');
+        if (!amountEl) return;
+
+        if (reqItems.length === 0) {
+          amountEl.innerText = "¥0.00";
+          if (noteEl) noteEl.innerText = "请至少选择一件商品的申请件数";
+          return;
+        }
+
+        let isAll = true;
+        for (const orderItem of order.items) {
+          const past = (order.refunds || []).reduce((s, r) => {
+            const ri = r.items.find(x => x.sku === orderItem.sku);
+            return s + (ri ? ri.qty : 0);
+          }, 0);
+          const cur = reqItems.find(x => x.sku === orderItem.sku)?.qty || 0;
+          if (past + cur < orderItem.qty) {
+            isAll = false;
+            break;
+          }
+        }
+
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        let calcAmt = 0;
+        if (isAll) {
+          calcAmt = remainingPayable;
+          if (noteEl) noteEl.innerText = "所有商品已全部退完，退还订单剩余实付金额 (消除分摊角分误差)";
+        } else {
+          let sumItemPrice = 0;
+          for (const it of reqItems) {
+            const oi = order.items.find(x => x.sku === it.sku);
+            sumItemPrice += it.qty * (oi ? oi.unitPrice : 0);
+          }
+          if (order.subtotal > 0) {
+            calcAmt = Math.round((sumItemPrice * order.payable / order.subtotal) * 100) / 100;
+          }
+          calcAmt = Math.min(calcAmt, remainingPayable);
+          if (noteEl) noteEl.innerText = `分摊公式: ¥${sumItemPrice.toFixed(2)} × ¥${order.payable.toFixed(2)} ÷ ¥${order.subtotal.toFixed(2)}`;
+        }
+
+        amountEl.innerText = `¥${calcAmt.toFixed(2)}`;
+      };
