+        let restocked = false;
+        if (order.status === "paid") {
+          // Goods never shipped from store! Re-stock immediately
+          for (const it of items) {
+            const vObj = findVariant(it.sku);
+            if (vObj) {
+              vObj.variant.stock += it.qty;
+            }
+          }
+          restocked = true;
+        } else {
+          // Shipped goods: cannot restock upon request; only when confirmReturn is called
+          restocked = false;
+        }
+
+        const refundRecord = {
+          id: refundId,
+          items: items.map(it => ({ sku: it.sku, qty: it.qty })),
+          amount: refundAmount,
+          returnGoods: returnGoods,
+          restocked: restocked
+        };
+
+        order.refunds.push(refundRecord);
+        order.refundedAmount = round2(order.refundedAmount + refundAmount);
+
+        addLog("售后退款申请", `订单号: ${order.id}, 售后单号: ${refundId}, 退款: ¥${refundAmount.toFixed(2)}, 退货: ${returnGoods ? '是' : '否'}, 入库: ${restocked ? '已入库' : '待入库'}`);
