+      function doGetStats() {
+        let sales = 0;
+        let refunds = 0;
+
+        const unitsSold = {};
+        for (const p of state.products) {
+          for (const v of p.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const order of state.orders) {
+          if (order.paidAt !== null && order.paidAt !== undefined && order.paidAt !== "") {
+            sales = round2(sales + order.payable);
+            for (const item of order.items) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+            }
+            for (const ref of (order.refunds || [])) {
+              for (const rItem of ref.items) {
+                unitsSold[rItem.sku] = (unitsSold[rItem.sku] || 0) - rItem.qty;
+              }
+            }
+          }
+
+          for (const ref of (order.refunds || [])) {
+            refunds = round2(refunds + ref.amount);
+          }
+        }
+
+        sales = round2(sales);
+        refunds = round2(refunds);
+        const net = round2(sales - refunds);
+
+        return {
+          sales: sales,
+          refunds: refunds,
+          net: net,
+          unitsSold: unitsSold
+        };
+      }
