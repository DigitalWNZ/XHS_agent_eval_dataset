+            const orderItem = order.items.find(x => x.sku === it.sku);
+            sumItemPrice += it.qty * orderItem.unitPrice;
+          }
+          if (order.subtotal > 0) {
+            refundAmount = Math.round((sumItemPrice * order.payable / order.subtotal) * 100) / 100;
+          } else {
+            refundAmount = 0;
+          }
+          refundAmount = Math.min(refundAmount, remainingPayable);
+        }
+
+        const returnGoods = options && options.returnGoods === true;
+        const datePart = new Date().toISOString().slice(0, 10).replace(/-/g, "");
+        const randPart = Math.floor(1000 + Math.random() * 9000);
+        const refundId = `REF-${datePart}-${randPart}`;
