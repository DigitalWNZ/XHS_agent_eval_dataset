+            const sku = inp.dataset.sku;
+            const qty = parseInt(inp.value, 10) || 0;
+            if (qty > 0) {
+              reqItems.push({ sku: sku, qty: qty });
+            }
+          });
+
+          if (reqItems.length === 0) {
+            showToast("请至少选择一件售后商品及数量", "warning");
+            return;
+          }
+
+          const res = doRequestAfterSale(orderId, reqItems, { returnGoods });
+          if (res.ok) {
+            document.getElementById('aftersale-modal')?.classList.remove('show');
+            showToast(`售后退款成功！退款金额: ¥${res.amount.toFixed(2)}`, "success");
+          } else {
+            showToast(res.error, "error");
+          }
+        });
+
+        // Backup Export/Import
+        const exportBtn = document.getElementById('btn-export-json');
+        if (exportBtn) {
+          exportBtn.addEventListener('click', () => {
+            const json = doExportData();
+            const previewArea = document.getElementById('export-preview-area');
+            if (previewArea) previewArea.value = json;
+            navigator.clipboard?.writeText(json).then(() => {
+              showToast("数据已成功导出并复制到剪贴板", "success");
+            }).catch(() => {
+              showToast("数据已生成在文本框中", "info");
+            });
+          });
+        }
+
+        const importBtn = document.getElementById('btn-do-import');
+        if (importBtn) {
+          importBtn.addEventListener('click', () => {
+            const area = document.getElementById('import-input-area');
+            const errEl = document.getElementById('import-error-msg');
+            if (!area) return;
+            const raw = area.value.trim();
+            if (errEl) errEl.innerText = '';
+
+            const res = doImportData(raw);
+            if (res.ok) {
+              showToast("数据导入成功，界面已更新", "success");
+              area.value = '';
+            } else {
+              if (errEl) errEl.innerText = `导入失败: ${res.error}`;
+              showToast(`导入失败: ${res.error}`, "error");
+            }
+          });
+        }
+      });
+
+    })();
+  </script>
