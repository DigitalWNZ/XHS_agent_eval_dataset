+      function doQueryOrders(filters = {}) {
+        const { orderId, sku, status, from, to } = filters;
+        return state.orders.filter(order => {
+          if (orderId && orderId.trim()) {
+            const q = orderId.trim().toLowerCase();
+            if (!order.id.toLowerCase().includes(q)) return false;
+          }
+          if (sku && sku.trim()) {
+            const q = sku.trim().toLowerCase();
+            const hasSku = order.items.some(it => it.sku.toLowerCase() === q || it.sku.toLowerCase().includes(q));
+            if (!hasSku) return false;
+          }
+          if (status && status.trim()) {
+            if (order.status !== status.trim()) return false;
+          }
+          const orderDate = order.createdAt ? order.createdAt.slice(0, 10) : "";
+          if (from && from.trim()) {
+            if (orderDate < from.trim()) return false;
+          }
+          if (to && to.trim()) {
+            if (orderDate > to.trim()) return false;
+          }
+          return true;
+        });
