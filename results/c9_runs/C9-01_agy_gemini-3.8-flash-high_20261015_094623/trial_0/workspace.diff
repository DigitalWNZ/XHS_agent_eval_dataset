+          if (fSku) fSku.value = '';
+          if (fSt) fSt.value = '';
+          if (fFrom) fFrom.value = '';
+          if (fTo) fTo.value = '';
+          renderOrders();
+        });
+
+        // After-Sale Modal Actions
+        document.getElementById('modal-aftersale-close')?.addEventListener('click', () => {
+          document.getElementById('aftersale-modal')?.classList.remove('show');
+        });
+        document.getElementById('modal-aftersale-cancel')?.addEventListener('click', () => {
+          document.getElementById('aftersale-modal')?.classList.remove('show');
+        });
+
+        document.getElementById('btn-submit-aftersale')?.addEventListener('click', () => {
+          const orderId = document.getElementById('aftersale-order-id')?.value;
+          const returnGoods = document.getElementById('aftersale-return-goods')?.checked || false;
+
+          const inputs = document.querySelectorAll('.aftersale-item-qty');
