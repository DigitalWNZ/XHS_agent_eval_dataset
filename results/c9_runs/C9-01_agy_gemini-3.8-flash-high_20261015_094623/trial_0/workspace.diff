+      function doImportData(rawStr) {
+        if (typeof rawStr !== 'string' || !rawStr.trim()) {
+          return { ok: false, error: "导入内容不能为空" };
+        }
+        let data;
+        try {
+          data = JSON.parse(rawStr);
+        } catch (e) {
+          return { ok: false, error: "JSON 格式解析失败: " + e.message };
+        }
+
+        if (!data || typeof data !== 'object') {
+          return { ok: false, error: "导入数据非对象类型" };
+        }
+
+        if (!Array.isArray(data.products)) {
+          return { ok: false, error: "缺少必要的 products 商品数组" };
+        }
+
+        if (!Array.isArray(data.orders)) {
+          return { ok: false, error: "缺少必要的 orders 订单数组" };
+        }
+
+        // Validate products
+        for (const p of data.products) {
+          if (!p.id || !p.name || !Array.isArray(p.variants) || p.variants.length === 0) {
+            return { ok: false, error: `商品 ${p.id || '未知'} 缺少必要字段或规格列表为空` };
+          }
+          for (const v of p.variants) {
+            if (!v.sku || typeof v.price !== 'number' || typeof v.stock !== 'number') {
+              return { ok: false, error: `规格 ${v.sku || '未知'} 价格或库存格式错误` };
+            }
+          }
+        }
+
+        // Validate orders
+        const validStatuses = new Set(["pending", "paid", "shipped", "cancelled"]);
+        for (const o of data.orders) {
+          if (!o.id || !validStatuses.has(o.status) || !o.createdAt || !Array.isArray(o.items)) {
+            return { ok: false, error: `订单 ${o.id || '未知'} 状态不合法或缺少items` };
+          }
+          if (typeof o.subtotal !== 'number' || typeof o.payable !== 'number') {
+            return { ok: false, error: `订单 ${o.id} 金额数据不完整` };
+          }
+          if (o.refunds && !Array.isArray(o.refunds)) {
+            return { ok: false, error: `订单 ${o.id} refunds 必须为数组` };
+          }
+        }
+
+        // Everything is valid -> apply to state
+        state.products = data.products;
+        state.orders = data.orders;
+        if (Array.isArray(data.coupons)) state.coupons = data.coupons;
+        if (typeof data.isMember === 'boolean') state.isMember = data.isMember;
+        if (Array.isArray(data.logs)) state.logs = data.logs;
+        if (data.cart && Array.isArray(data.cart.lines)) state.cart = data.cart;
+        cartStep = 'cart';
