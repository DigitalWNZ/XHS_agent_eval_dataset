+          return { ok: false, error: "已发货订单不能直接取消，请走售后流程" };
+        }
+
+        // If Pending (待付款未发货): release all inventory
+        if (order.status === "pending") {
+          for (const item of order.items) {
+            const { variant } = findProductAndVariant(item.sku);
+            if (variant) {
+              variant.stock += item.qty;
+            }
+          }
+          order.status = "cancelled";
+          addLog("取消待付款订单", `订单号: ${order.id}, 已释放锁定库存`);
+          saveState();
+          render();
+          return { ok: true };
+        }
+
+        // If Paid (已付款未发货):
+        // 1. Release remaining unrefunded inventory
+        // 2. Automatically generate refund record for remaining payable
+        if (order.status === "paid") {
+          const refundItems = [];
+          for (const item of order.items) {
+            const alreadyRefunded = (order.refunds || []).reduce((sum, r) => {
+              const ri = r.items.find(x => x.sku === item.sku);
+              return sum + (ri ? ri.qty : 0);
+            }, 0);
+            const remQty = item.qty - alreadyRefunded;
+            if (remQty > 0) {
+              const { variant } = findProductAndVariant(item.sku);
+              if (variant) {
+                variant.stock += remQty;
+              }
+              refundItems.push({ sku: item.sku, qty: remQty });
+            }
+          }
+
+          const remPayable = round2(order.payable - order.refundedAmount);
+          const refundId = "RF-CANCEL-" + Date.now() + "-" + Math.floor(100 + Math.random() * 900);
+
+          order.refunds.push({
+            id: refundId,
+            items: refundItems,
+            amount: remPayable,
+            returnGoods: false,
+            restocked: true
+          });
+          order.refundedAmount = round2(order.payable);
+          order.status = "cancelled";
+
+          addLog("取消已付款订单", `订单号: ${order.id}, 自动全额退还剩余实付 ¥${remPayable.toFixed(2)}, 已回补库存`);
+          saveState();
+          render();
+          return { ok: true };
+        }
+
+        return { ok: false, error: "不支持的订单状态操作" };
+      },
+
+      requestAfterSale(orderId, items, options) {
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) {
+          return { ok: false, error: "订单不存在" };
+        }
+        if (order.status !== "paid" && order.status !== "shipped") {
+          return { ok: false, error: "只有已付款或已发货订单支持申请售后" };
+        }
+        if (!Array.isArray(items) || items.length === 0) {
+          return { ok: false, error: "申请售后商品列表不能为空" };
+        }
+
+        const returnGoods = Boolean(options && options.returnGoods);
+
+        // Validate each item
+        for (const req of items) {
+          if (!req || !req.sku || typeof req.qty !== "number" || req.qty <= 0 || !Number.isInteger(req.qty)) {
+            return { ok: false, error: "申请售后的商品规格或数量非法" };
+          }
+          const orderItem = order.items.find(i => i.sku === req.sku);
+          if (!orderItem) {
+            return { ok: false, error: `订单中不包含该商品 SKU: ${req.sku}` };
+          }
+          const alreadyRefunded = (order.refunds || []).reduce((sum, r) => {
+            const ri = r.items.find(x => x.sku === req.sku);
+            return sum + (ri ? ri.qty : 0);
+          }, 0);
+          const availableToRefund = orderItem.qty - alreadyRefunded;
+          if (req.qty > availableToRefund) {
+            return { ok: false, error: `SKU ${req.sku} 申请退款数量(${req.qty})超出可退数量(${availableToRefund})` };
+          }
+        }
+
+        // Determine if after this request, all items in the order are completely refunded
+        let allCompleted = true;
+        for (const oi of order.items) {
+          const alreadyRefunded = (order.refunds || []).reduce((sum, r) => {
+            const ri = r.items.find(x => x.sku === oi.sku);
+            return sum + (ri ? ri.qty : 0);
+          }, 0);
+          const reqItem = items.find(x => x.sku === oi.sku);
+          const reqQty = reqItem ? reqItem.qty : 0;
+          if (alreadyRefunded + reqQty !== oi.qty) {
+            allCompleted = false;
+            break;
+          }
+        }
+
+        // Proportional discount allocation formula:
+        // 本次退款 = Σ 数量 × 单价 × 实付 ÷ 商品原价合计，四舍五入到分；当订单商品全部退完时，最后一次退款为剩余实付。
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        let refundAmount;
+
+        if (allCompleted) {
+          refundAmount = remainingPayable;
+        } else {
+          let sumOriginal = 0;
+          for (const req of items) {
+            const oi = order.items.find(i => i.sku === req.sku);
+            sumOriginal += req.qty * oi.unitPrice;
+          }
+          const calc = (sumOriginal * order.payable) / order.subtotal;
+          refundAmount = round2(calc);
+          refundAmount = Math.min(refundAmount, remainingPayable);
+          refundAmount = round2(refundAmount);
+        }
+
+        // Inventory linkage:
+        // "已发货商品不能仅因退款申请就增加库存；只有确认退货入库后才回补，且不能重复入库。"
+        // "未发货订单 (paid) 释放库存"
+        let restocked = false;
+        if (order.status === "paid") {
+          // Goods never left the warehouse, so inventory is released immediately
+          restocked = true;
+          for (const req of items) {
+            const { variant } = findProductAndVariant(req.sku);
+            if (variant) variant.stock += req.qty;
+          }
+        } else if (order.status === "shipped") {
+          // Shipped goods DO NOT restock on refund application
+          restocked = false;
+        }
+
+        const refundId = "RF-" + Date.now() + "-" + Math.floor(100 + Math.random() * 900);
+        const refundRecord = {
+          id: refundId,
+          items: items.map(x => ({ sku: x.sku, qty: x.qty })),
+          amount: refundAmount,
+          returnGoods,
+          restocked
+        };
+
+        order.refunds.push(refundRecord);
+        order.refundedAmount = round2(order.refundedAmount + refundAmount);
+
+        addLog("申请售后", `订单号: ${order.id}, 售后单: ${refundId}, 退款: ¥${refundAmount.toFixed(2)}, 退货: ${returnGoods ? "是" : "否"}, 入库状态: ${restocked ? "已回补" : "待入库"}`);
+        saveState();
+        render();
+
+        return {
+          ok: true,
+          refundId,
+          amount: refundAmount
+        };
+      },
+
+      confirmReturn(refundId) {
+        let foundOrder = null;
+        let foundRefund = null;
+
+        for (const o of state.orders) {
+          const rf = (o.refunds || []).find(r => r.id === refundId);
+          if (rf) {
+            foundOrder = o;
+            foundRefund = rf;
+            break;
+          }
+        }
+
+        if (!foundRefund || !foundOrder) {
+          return { ok: false, error: "未找到该售后单: " + refundId };
+        }
+        if (foundOrder.status !== "shipped") {
+          return { ok: false, error: "只能对已发货订单确认退货入库" };
+        }
+        if (!foundRefund.returnGoods) {
+          return { ok: false, error: "该售后单无需退货入库" };
+        }
+        if (foundRefund.restocked) {
+          return { ok: false, error: "该售后单已入库，不可重复入库" };
+        }
+
+        // Restock inventory
+        for (const it of foundRefund.items) {
+          const { variant } = findProductAndVariant(it.sku);
+          if (variant) {
+            variant.stock += it.qty;
+          }
+        }
+        foundRefund.restocked = true;
+
+        addLog("退货确认入库", `订单号: ${foundOrder.id}, 售后单: ${refundId}, 仓库已确认入库并回补库存`);
+        saveState();
+        render();
+        return { ok: true };
+      },
+
+      queryOrders(filters) {
+        const { orderId, sku, status, from, to } = filters || {};
+        return state.orders.filter(order => {
+          if (orderId && !order.id.toLowerCase().includes(orderId.trim().toLowerCase())) {
+            return false;
+          }
+          if (sku && !order.items.some(i => i.sku === sku.trim())) {
+            return false;
+          }
+          if (status && order.status !== status) {
+            return false;
+          }
+          const orderDate = order.createdAt.slice(0, 10);
+          if (from && orderDate < from) {
+            return false;
+          }
+          if (to && orderDate > to) {
+            return false;
+          }
+          return true;
+        });
+      },
+
+      getStats() {
+        // Sales: sum of payable for all orders where paidAt !== null (including cancelled or refunded later)
+        let sales = 0;
+        for (const ord of state.orders) {
+          if (ord.paidAt !== null) {
+            sales += ord.payable;
+          }
+        }
+        sales = round2(sales);
+
+        // Refunds: sum of all refund amounts across all orders
+        let refunds = 0;
+        for (const ord of state.orders) {
+          for (const rf of (ord.refunds || [])) {
+            refunds += rf.amount;
+          }
+        }
+        refunds = round2(refunds);
+
+        const net = round2(sales - refunds);
+
+        // Units Sold:
+        // unitsSold = 曾付款订单中各 SKU 数量 − 已退数量。
+        const unitsSold = {};
+        for (const prod of state.products) {
+          for (const v of prod.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const ord of state.orders) {
+          if (ord.paidAt !== null) {
+            for (const item of ord.items) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+            }
+            for (const rf of (ord.refunds || [])) {
+              for (const it of rf.items) {
+                unitsSold[it.sku] = (unitsSold[it.sku] || 0) - it.qty;
+              }
+            }
+          }
+        }
+
+        return {
+          sales,
+          refunds,
+          net,
+          unitsSold
+        };
+      },
+
+      exportData() {
+        return JSON.stringify({
+          products: state.products,
+          coupons: state.coupons,
+          isMember: state.isMember,
+          orders: state.orders,
+          cart: state.cart,
+          logs: state.logs
+        }, null, 2);
+      },
+
+      importData(jsonStr) {
+        try {
+          const parsed = JSON.parse(jsonStr);
+          if (!parsed || typeof parsed !== "object") {
+            return { ok: false, error: "导入内容必须为合法 JSON 对象" };
+          }
+          if (!Array.isArray(parsed.products) || parsed.products.length === 0) {
+            return { ok: false, error: "导入数据缺少有效 products 商品列表" };
+          }
+          if (!Array.isArray(parsed.orders)) {
+            return { ok: false, error: "导入数据缺少有效 orders 订单列表" };
+          }
+
+          // Validate products structure
+          for (const p of parsed.products) {
+            if (!p.id || !p.name || !Array.isArray(p.variants) || p.variants.length === 0) {
+              return { ok: false, error: "商品数据不完整，每个商品必须包含 id, name 和 variants" };
+            }
+            for (const v of p.variants) {
+              if (!v.sku || typeof v.price !== "number" || typeof v.stock !== "number") {
+                return { ok: false, error: "商品规格数据不完整: " + (v.sku || "未知") };
+              }
+            }
+          }
+
+          // Validate orders structure
+          const validStatuses = ["pending", "paid", "shipped", "cancelled"];
+          for (const o of parsed.orders) {
+            if (!o.id || !validStatuses.includes(o.status) || !Array.isArray(o.items) || typeof o.payable !== "number") {
+              return { ok: false, error: "订单数据不完整或状态非法: " + (o.id || "未知") };
+            }
+          }
+
+          // Successfully validated, now apply
+          state.products = parsed.products;
+          state.orders = parsed.orders;
+          if (Array.isArray(parsed.coupons)) state.coupons = parsed.coupons;
+          if (typeof parsed.isMember === "boolean") state.isMember = parsed.isMember;
+          if (parsed.cart && Array.isArray(parsed.cart.lines)) state.cart = parsed.cart;
+          if (Array.isArray(parsed.logs)) state.logs = parsed.logs;
+
+          addLog("数据导入", `成功导入 ${state.products.length} 个商品与 ${state.orders.length} 笔订单数据`);
+          saveState();
+          render();
+          return { ok: true };
+        } catch (err) {
+          return { ok: false, error: "JSON 解析错误: " + err.message };
+        }
+      }
