+    function updateAfterSalePreview() {
+      const order = state.orders.find(o => o.id === currentAfterSaleOrderId);
+      if (!order) return;
+
+      const inputs = document.querySelectorAll(".aftersale-qty-input");
+      const reqItems = [];
+      inputs.forEach(input => {
+        const sku = input.getAttribute("data-sku");
+        const qty = parseInt(input.value, 10);
+        if (!isNaN(qty) && qty > 0) {
+          reqItems.push({ sku, qty });
+        }
+      });
+
+      if (reqItems.length === 0) {
+        document.getElementById("afterSalePreviewAmount").textContent = "¥0.00";
+        document.getElementById("afterSalePreviewDetail").textContent = "请至少选择一件商品的退款数量";
+        return;
+      }
+
+      // Check if all items completed
+      let allCompleted = true;
+      for (const oi of order.items) {
+        const alreadyRefunded = (order.refunds || []).reduce((sum, r) => {
+          const ri = r.items.find(x => x.sku === oi.sku);
+          return sum + (ri ? ri.qty : 0);
+        }, 0);
+        const reqItem = reqItems.find(x => x.sku === oi.sku);
+        const reqQty = reqItem ? reqItem.qty : 0;
+        if (alreadyRefunded + reqQty !== oi.qty) {
+          allCompleted = false;
+          break;
+        }
+      }
+
+      const remPayable = round2(order.payable - order.refundedAmount);
+      let previewAmt;
+
+      if (allCompleted) {
+        previewAmt = remPayable;
+        document.getElementById("afterSalePreviewDetail").textContent = `订单商品将全部退完，本次退款为剩余实付全额: ¥${previewAmt.toFixed(2)}`;
+      } else {
