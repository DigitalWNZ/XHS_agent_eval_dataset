+    function doImportData() {
+      const text = document.getElementById("importJsonText").value.trim();
+      const errorBox = document.getElementById("importErrorNotice");
+
+      if (!text) {
+        errorBox.style.display = "flex";
+        errorBox.textContent = "请先粘贴要导入的 JSON 数据！";
+        return;
