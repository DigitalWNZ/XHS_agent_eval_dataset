+          ${o.id}（状态: ${o.status === 'paid' ? '已付款未发货' : '已发货'} | 实付: ¥${o.payable.toFixed(2)} | 已退: ¥${o.refundedAmount.toFixed(2)}）
+        </option>
+      `).join("");
+
+      afterSaleSelectedOrder = eligibleOrders.find(o => o.id === (preferredOrderId || eligibleOrders[0].id)) || eligibleOrders[0];
+      updateAfterSaleModalView();
+      document.getElementById("afterSaleModal").classList.add("show");
+    };
+
+    function updateAfterSaleModalView() {
+      if (!afterSaleSelectedOrder) return;
+      const order = afterSaleSelectedOrder;
+
+      const remainingPayable = toMoney(order.payable - order.refundedAmount);
+      document.getElementById("afterSaleOrderInfoCard").innerHTML = `
+        <div style="display:flex; justify-content:space-between;">
+          <span><b>订单状态:</b> ${order.status === 'paid' ? '已付款（未发货）' : '已发货'}</span>
+          <span><b>剩余可退实付:</b> <b style="color:var(--accent);">¥${remainingPayable.toFixed(2)}</b></span>
+        </div>
+        <div><b>原价合计:</b> ¥${order.subtotal.toFixed(2)} | <b>订单实付:</b> ¥${order.payable.toFixed(2)}</div>
+      `;
+
+      const tbody = document.querySelector("#afterSaleItemsTable tbody");
+      tbody.innerHTML = order.items.map(it => {
+        const found = store.findVariant(it.sku);
+        const name = found ? found.product.name : it.sku;
+        const spec = found ? found.variant.spec : "";
+        const prevRefunded = order.refunds.reduce((sum, r) => {
+          const f = r.items.find(i => i.sku === it.sku);
+          return sum + (f ? f.qty : 0);
+        }, 0);
+        const available = it.qty - prevRefunded;
+
+        return `
+          <tr>
+            <td><b>${name}</b><br><span style="font-size:11px; color:var(--text-muted);">${spec} (${it.sku})</span></td>
+            <td>¥${it.unitPrice.toFixed(2)}</td>
+            <td>${it.qty}</td>
+            <td><b style="color:${available > 0 ? 'var(--primary)' : 'var(--text-light)'}">${available}</b></td>
+            <td>
+              <input type="number" 
+                     id="asQty_${it.sku}" 
+                     class="form-input" 
+                     style="width:70px; padding:4px 8px;" 
+                     min="0" 
+                     max="${available}" 
+                     value="${available > 0 ? 1 : 0}" 
+                     ${available === 0 ? 'disabled' : ''}
+                     oninput="recalcAfterSalePreview()">
+            </td>
+          </tr>
+        `;
+      }).join("");
+
+      recalcAfterSalePreview();
+    }
+
+    window.recalcAfterSalePreview = function() {
+      if (!afterSaleSelectedOrder) return;
+      const order = afterSaleSelectedOrder;
+
+      const items = [];
+      let totalReqQty = 0;
+      for (const it of order.items) {
+        const input = document.getElementById("asQty_" + it.sku);
+        if (input) {
+          const val = parseInt(input.value, 10) || 0;
+          if (val > 0) {
+            items.push({ sku: it.sku, qty: val });
+            totalReqQty += val;
+          }
+        }
+      }
+
+      const amountEl = document.getElementById("afterSaleCalculatedAmount");
+      const tipEl = document.getElementById("afterSaleRemainingTip");
+
+      if (items.length === 0) {
+        amountEl.textContent = "¥0.00";
+        tipEl.textContent = "请至少输入 1 件商品的退货数量";
+        return;
+      }
+
+      // Check if completes all items
+      let willAllItemsBeRefunded = true;
+      for (const orderItem of order.items) {
+        const prevRefunded = order.refunds.reduce((sum, r) => {
+          const f = r.items.find(i => i.sku === orderItem.sku);
+          return sum + (f ? f.qty : 0);
+        }, 0);
+        const curReq = items.find(i => i.sku === orderItem.sku);
+        const curQty = curReq ? curReq.qty : 0;
+        if (prevRefunded + curQty < orderItem.qty) {
+          willAllItemsBeRefunded = false;
+          break;
+        }
+      }
+
+      const remainingPayable = toMoney(order.payable - order.refundedAmount);
+      let previewAmount = 0.00;
+      if (willAllItemsBeRefunded) {
+        previewAmount = remainingPayable;
+        tipEl.textContent = "所有商品全部退完：退还剩余全部实付金额";
+      } else {
+        const requestedSum = items.reduce((acc, it) => {
+          const oi = order.items.find(i => i.sku === it.sku);
+          return acc + (it.qty * oi.unitPrice);
+        }, 0);
+        previewAmount = toMoney((requestedSum * order.payable) / order.subtotal);
+        previewAmount = Math.min(previewAmount, remainingPayable);
+        tipEl.textContent = `按实付与优惠分摊比例四舍五入核算`;
+      }
+
+      amountEl.textContent = `¥${previewAmount.toFixed(2)}`;
+    };
+
