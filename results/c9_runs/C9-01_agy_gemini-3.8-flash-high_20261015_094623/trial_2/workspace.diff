+
+    // ==========================================
+    // 2. STORE BUSINESS LOGIC IMPLEMENTATION
+    // ==========================================
+    const STORAGE_KEY = "TRENDY_TOYS_STORE_DATA";
+
+    function toMoney(val) {
+      if (typeof val !== "number" || isNaN(val)) return 0.00;
+      return Math.round((val + 1e-9) * 100) / 100;
+    }
+
+    function deepClone(obj) {
+      return JSON.parse(JSON.stringify(obj));
+    }
+
+    class Store {
+      constructor() {
+        this.products = [];
+        this.coupons = [];
+        this.orders = [];
+        this.isMember = false;
+        this.cart = {
+          items: [], // [{ sku, qty }]
+          appliedCoupon: null // coupon code or null
+        };
+        this.logs = [];
+        this.isCheckingOut = false; // concurrency / duplicate submit lock
+
+        this.init();
+      }
+
+      init() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            const data = JSON.parse(raw);
+            if (data && Array.isArray(data.products) && Array.isArray(data.orders)) {
+              this.products = data.products;
+              this.coupons = Array.isArray(data.coupons) ? data.coupons : deepClone(INITIAL_COUPONS);
+              this.orders = data.orders;
+              this.isMember = Boolean(data.isMember);
+              this.cart = data.cart && Array.isArray(data.cart.items) ? data.cart : { items: [], appliedCoupon: null };
+              this.logs = Array.isArray(data.logs) ? data.logs : [];
+              return;
+            }
+          }
+        } catch (e) {
+          console.warn("Failed to load stored data, resetting:", e);
+        }
+        this.reset();
+      }
+
+      save() {
+        try {
+          const payload = {
+            products: this.products,
+            coupons: this.coupons,
+            orders: this.orders,
+            isMember: this.isMember,
+            cart: this.cart,
+            logs: this.logs
+          };
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
+        } catch (e) {
+          console.error("Save error:", e);
+        }
+      }
+
+      addLog(action, detail) {
+        this.logs.unshift({
+          time: new Date().toISOString(),
+          action,
+          detail
+        });
+      }
+
+      findVariant(sku) {
+        for (const p of this.products) {
+          for (const v of p.variants) {
+            if (v.sku === sku) return { product: p, variant: v };
+          }
+        }
+        return null;
+      }
+
+      reset() {
+        this.products = deepClone(INITIAL_PRODUCTS);
+        this.coupons = deepClone(INITIAL_COUPONS);
+        this.orders = deepClone(INITIAL_ORDERS);
+        this.isMember = false;
+        this.cart = { items: [], appliedCoupon: null };
+        this.logs = deepClone(INITIAL_LOGS);
+        this.addLog("系统重置", "恢复为初始构造的商品与历史订单");
+        this.save();
+        return { ok: true };
+      }
+
+      getState() {
+        return {
+          products: deepClone(this.products),
+          coupons: deepClone(this.coupons),
+          isMember: this.isMember,
+          orders: deepClone(this.orders),
+          logs: deepClone(this.logs)
+        };
+      }
+
+      setMember(val) {
+        this.isMember = Boolean(val);
+        this.cleanInvalidCoupons();
+        this.save();
+        return { ok: true };
+      }
+
+      cleanInvalidCoupons() {
+        if (!this.cart.appliedCoupon) return;
+        const coupon = this.coupons.find(c => c.code === this.cart.appliedCoupon);
+        if (!coupon) {
+          this.cart.appliedCoupon = null;
+          return;
+        }
+        // Subtotal threshold check
+        const cartInfo = this.getCart();
+        if (cartInfo.subtotal < coupon.threshold) {
+          this.cart.appliedCoupon = null;
+        }
+      }
+
+      addToCart(sku, qty) {
+        const found = this.findVariant(sku);
+        if (!found) {
+          return { ok: false, error: "商品规格 SKU 不存在" };
+        }
+        if (typeof qty !== "number" || !Number.isInteger(qty) || qty <= 0) {
+          return { ok: false, error: "商品数量必须为大于0的整数" };
+        }
+        const currentItem = this.cart.items.find(i => i.sku === sku);
+        const currentQty = currentItem ? currentItem.qty : 0;
+        if (currentQty + qty > found.variant.stock) {
+          return { ok: false, error: "库存不足，当前在库仅剩 " + found.variant.stock + " 件" };
+        }
+
+        if (currentItem) {
+          currentItem.qty += qty;
+        } else {
+          this.cart.items.push({ sku, qty });
+        }
+        this.cleanInvalidCoupons();
+        this.save();
+        return { ok: true };
+      }
+
+      setCartQty(sku, qty) {
+        const found = this.findVariant(sku);
+        if (!found) {
+          return { ok: false, error: "商品规格 SKU 不存在" };
+        }
+        if (typeof qty !== "number" || !Number.isInteger(qty) || qty <= 0) {
+          return { ok: false, error: "数量必须为大于0的整数" };
+        }
+        const item = this.cart.items.find(i => i.sku === sku);
+        if (!item) {
+          return { ok: false, error: "购物车中无此商品" };
+        }
+        if (qty > found.variant.stock) {
+          return { ok: false, error: "修改数量超过库存，当前库存 " + found.variant.stock + " 件" };
+        }
+
+        item.qty = qty;
+        this.cleanInvalidCoupons();
+        this.save();
+        return { ok: true };
+      }
+
+      removeFromCart(sku) {
+        const idx = this.cart.items.findIndex(i => i.sku === sku);
+        if (idx === -1) {
+          return { ok: false, error: "购物车中无此商品" };
+        }
+        this.cart.items.splice(idx, 1);
+        this.cleanInvalidCoupons();
+        this.save();
+        return { ok: true };
+      }
+
+      applyCoupon(code) {
+        if (!code) {
+          this.cart.appliedCoupon = null;
+          this.save();
+          return { ok: true };
+        }
+        const coupon = this.coupons.find(c => c.code === code);
+        if (!coupon) {
+          return { ok: false, error: "优惠券不存在" };
+        }
+        // Calculate current subtotal
+        let subtotal = 0;
+        for (const item of this.cart.items) {
+          const found = this.findVariant(item.sku);
+          if (found) subtotal += item.qty * found.variant.price;
+        }
+        subtotal = toMoney(subtotal);
+        if (subtotal < coupon.threshold) {
+          return { ok: false, error: "未达到优惠券满减门槛（需满 ¥" + coupon.threshold.toFixed(2) + "，当前商品原价合计 ¥" + subtotal.toFixed(2) + "）" };
+        }
+
+        this.cart.appliedCoupon = code;
+        this.save();
+        return { ok: true };
+      }
+
+      getCart() {
+        const lines = [];
+        let subtotal = 0;
+        for (const item of this.cart.items) {
+          const found = this.findVariant(item.sku);
+          const unitPrice = found ? found.variant.price : 0.00;
+          const lineTotal = toMoney(item.qty * unitPrice);
+          subtotal += lineTotal;
+          lines.push({
+            sku: item.sku,
+            qty: item.qty,
+            unitPrice: toMoney(unitPrice),
+            lineTotal: lineTotal
+          });
+        }
+        subtotal = toMoney(subtotal);
+
+        const discounts = [];
+        if (lines.length > 0) {
+          // Member discount applies to any non-empty cart if isMember
+          if (this.isMember) {
+            const memberAmount = toMoney(subtotal * MEMBER_DISCOUNT_RATE);
+            discounts.push({ type: "member", amount: memberAmount });
+          }
+
+          // Coupon discount
+          if (this.cart.appliedCoupon) {
+            const coupon = this.coupons.find(c => c.code === this.cart.appliedCoupon);
+            if (coupon && subtotal >= coupon.threshold) {
+              const prevDiscountsSum = discounts.reduce((acc, d) => acc + d.amount, 0);
+              const maxCouponPossible = toMoney(Math.max(0, subtotal - prevDiscountsSum));
+              const couponAmount = toMoney(Math.min(coupon.amount, maxCouponPossible));
+              discounts.push({ type: "coupon", amount: couponAmount });
+            } else {
+              this.cart.appliedCoupon = null; // Auto invalidate
+            }
+          }
