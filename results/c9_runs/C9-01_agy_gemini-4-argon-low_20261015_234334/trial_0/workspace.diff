+
+  window.updateAfterSalePreview = function() {
+    const order = state.orders.find(o => o.id === currentAfterSaleOrderId);
+    const box = document.getElementById('as-preview-box');
+    if (!order || !box) return;
+
+    const inputs = document.querySelectorAll('.as-qty-input');
+    let reqOrigSum = 0;
+    let totalSelectedQty = 0;
+    let allFullyRefunded = true;
+
+    inputs.forEach(inp => {
+      const sku = inp.getAttribute('data-sku');
+      const qty = Number(inp.value) || 0;
+      const orderItem = order.items.find(i => i.sku === sku);
+      if (orderItem) {
+        const already = getRefundedQtyForOrderSku(order, sku);
+        if (qty > 0) {
+          reqOrigSum += qty * orderItem.unitPrice;
+          totalSelectedQty += qty;
+        }
+        if (already + qty < orderItem.qty) {
+          allFullyRefunded = false;
+        }
+      }
+    });
+
+    if (totalSelectedQty <= 0) {
+      box.innerHTML = '请选择至少 1 件需要申请售后的商品。';
+      return;
+    }
+
+    const remPayable = round2(Math.max(0, order.payable - order.refundedAmount));
+    let est = 0;
+    if (allFullyRefunded) {
+      est = remPayable;
+      box.innerHTML = `本次售后将退完订单内剩余全部商品，按规则退还剩余全部实付金额：<strong style="color:#fbbf24; font-size:15px;">¥${est.toFixed(2)}</strong>`;
+    } else {
+      est = Math.min(remPayable, round2((reqOrigSum * order.payable) / order.subtotal));
+      box.innerHTML = `按比例分摊优惠计算公式：Σ(数量×单价) ¥${reqOrigSum.toFixed(2)} × 实付 ¥${order.payable.toFixed(2)} ÷ 原价合计 ¥${order.subtotal.toFixed(2)} = 预计退款 <strong style="color:#fbbf24; font-size:15px;">¥${est.toFixed(2)}</strong>`;
+    }
+  };
+
+  window.closeAfterSaleModal = function() {
