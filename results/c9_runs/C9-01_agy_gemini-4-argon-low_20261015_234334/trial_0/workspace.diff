+  // 计算某订单中某SKU已申请售后的累计数量
+  function getRefundedQtyForOrderSku(order, sku) {
+    let sum = 0;
+    for (const r of order.refunds) {
+      for (const it of r.items) {
+        if (it.sku === sku) {
+          sum += it.qty;
+        }
+      }
+    }
+    return sum;
+  }
+
+  function apiCancel(orderId) {
+    const order = state.orders.find(o => o.id === orderId);
+    if (!order) {
+      return { ok: false, error: `未找到订单: ${orderId}` };
+    }
+    if (order.status === 'cancelled') {
+      return { ok: false, error: '该订单已处于已取消状态，不可重复取消' };
+    }
+    if (order.status === 'shipped') {
+      return { ok: false, error: '已发货订单不可直接取消，请通过退货退款售后流程处理' };
+    }
+    if (order.status !== 'pending' && order.status !== 'paid') {
+      return { ok: false, error: `当前状态 ${order.status} 不允许取消` };
+    }
+
+    const wasPaid = order.status === 'paid';
+
+    // 计算尚未退过的剩余商品数量并释放库存
+    const remainingItems = [];
+    for (const item of order.items) {
+      const alreadyRefundedQty = getRefundedQtyForOrderSku(order, item.sku);
+      const remQty = Math.max(0, item.qty - alreadyRefundedQty);
+      if (remQty > 0) {
+        remainingItems.push({ sku: item.sku, qty: remQty });
+        const found = findVariant(item.sku);
+        if (found) {
+          found.variant.stock += remQty;
+        }
