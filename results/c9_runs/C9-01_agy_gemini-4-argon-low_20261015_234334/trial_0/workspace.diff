+  function apiGetStats() {
+    let sales = 0;
+    let refunds = 0;
+    const unitsSold = {};
+
+    // 初始化所有已知 SKU 的销量为 0（如果曾付款订单中出现也会统计）
+    for (const p of state.products) {
+      for (const v of p.variants) {
+        unitsSold[v.sku] = 0;
+      }
+    }
+
+    for (const o of state.orders) {
+      // 全部退款记录合计
+      for (const r of o.refunds) {
+        refunds = round2(refunds + round2(r.amount));
+      }
+      // sales = 所有曾付款订单（paidAt 非空，含之后取消或退款的）实付合计
+      if (o.paidAt !== null && o.paidAt !== undefined && o.paidAt !== '') {
+        sales = round2(sales + round2(o.payable));
+        for (const it of o.items) {
+          unitsSold[it.sku] = (unitsSold[it.sku] || 0) + it.qty;
+        }
+        // 减去该曾付款订单中的已退数量
+        for (const r of o.refunds) {
+          for (const ri of r.items) {
+            unitsSold[ri.sku] = (unitsSold[ri.sku] || 0) - ri.qty;
+          }
+        }
+      }
+    }
+
+    const net = round2(sales - refunds);
+    return {
+      sales: round2(sales),
+      refunds: round2(refunds),
+      net: round2(net),
+      unitsSold
+    };
+  }
