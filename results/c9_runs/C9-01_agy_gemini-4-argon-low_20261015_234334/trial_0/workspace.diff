+    const body = document.getElementById('aftersale-modal-body');
+
+    const rowsHtml = order.items.map(it => {
+      const refunded = getRefundedQtyForOrderSku(order, it.sku);
+      const avail = Math.max(0, it.qty - refunded);
+      const found = findVariant(it.sku);
+      const label = found ? `${found.product.name} - ${found.variant.spec}` : it.sku;
+      return `
+        <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid var(--border);">
