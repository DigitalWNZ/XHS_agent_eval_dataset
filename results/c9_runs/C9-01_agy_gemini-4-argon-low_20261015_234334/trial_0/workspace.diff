+    }
+
+    let refundAmount = 0;
+    if (allItemsFullyRefundedAfterThis) {
+      // 当订单商品全部退完时，最后一次退款为剩余实付
+      refundAmount = remainingPayable;
+    } else {
+      // 本次退款 = Σ 数量 × 单价 × 实付 ÷ 商品原价合计，四舍五入到分
+      const reqOriginalSum = cleanItems.reduce((s, it) => s + it.qty * it.unitPrice, 0);
+      const rawRefund = (reqOriginalSum * order.payable) / order.subtotal;
+      refundAmount = round2(rawRefund);
+      if (refundAmount > remainingPayable) {
+        refundAmount = remainingPayable;
+      }
+    }
+
+    state.seq = (state.seq || 100) + 1;
+    const nowDate = new Date().toISOString().slice(0, 10).replace(/-/g, '');
+    const refundId = `REF-${nowDate}-${String(state.seq).padStart(3, '0')}`;
