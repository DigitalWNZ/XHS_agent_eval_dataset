+  }
+
+  function apiImportData(jsonString) {
+    if (typeof jsonString !== 'string' || !jsonString.trim()) {
+      return { ok: false, error: '导入内容不能为空字符串' };
+    }
+    let parsed;
+    try {
+      parsed = JSON.parse(jsonString);
+    } catch (e) {
+      return { ok: false, error: 'JSON 语法解析失败: ' + e.message };
+    }
+    const validation = validateStateObject(parsed);
+    if (!validation.ok) {
