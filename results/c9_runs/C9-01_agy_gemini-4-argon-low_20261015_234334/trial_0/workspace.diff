+      coupons: Array.isArray(parsed.coupons) ? clone(parsed.coupons) : getInitialState().coupons,
+      isMember: Boolean(parsed.isMember),
+      selectedCoupon: parsed.selectedCoupon || null,
+      cart: Array.isArray(parsed.cart) ? clone(parsed.cart) : [],
+      orders: clone(parsed.orders),
+      logs: Array.isArray(parsed.logs) ? clone(parsed.logs) : [],
+      seq: typeof parsed.seq === 'number' ? parsed.seq : 200
+    };
+    preparedAddress = null;
