+  // 严格校验导入数据结构
+  function validateStateObject(data) {
+    if (!data || typeof data !== 'object' || Array.isArray(data)) {
+      return { ok: false, error: '导入数据必须是一个 JSON 对象' };
+    }
+    if (!Array.isArray(data.products) || data.products.length === 0) {
+      return { ok: false, error: '导入数据缺少有效的商品列表 (products)' };
+    }
+    if (!Array.isArray(data.orders)) {
+      return { ok: false, error: '导入数据缺少有效的订单列表 (orders)' };
+    }
+    const validStatuses = new Set(['pending', 'paid', 'shipped', 'cancelled']);
+    for (const p of data.products) {
+      if (!p || typeof p.id !== 'string' || typeof p.name !== 'string' || !Array.isArray(p.variants) || p.variants.length === 0) {
+        return { ok: false, error: '商品数据字段缺失或格式非法' };
+      }
+      for (const v of p.variants) {
+        if (!v || typeof v.sku !== 'string' || typeof v.spec !== 'string' || typeof v.price !== 'number' || v.price < 0 || !Number.isInteger(v.stock) || v.stock < 0) {
+          return { ok: false, error: `商品规格数据非法 (SKU: ${v && v.sku})` };
+        }
+      }
+    }
+    for (const o of data.orders) {
+      if (!o || typeof o.id !== 'string' || !validStatuses.has(o.status) || typeof o.createdAt !== 'string' || !Array.isArray(o.items) || o.items.length === 0) {
+        return { ok: false, error: `订单结构不完整或状态非法 (订单: ${o && o.id})` };
+      }
+      if (typeof o.subtotal !== 'number' || typeof o.payable !== 'number' || typeof o.refundedAmount !== 'number' || !Array.isArray(o.discounts) || !Array.isArray(o.refunds)) {
+        return { ok: false, error: `订单金额或售后列表字段缺失 (订单: ${o.id})` };
+      }
+    }
+    return { ok: true };
+  }
+
+  function apiExportData() {
+    const exportPayload = {
+      products: clone(state.products),
+      coupons: clone(state.coupons),
+      isMember: Boolean(state.isMember),
+      selectedCoupon: state.selectedCoupon || null,
+      cart: clone(state.cart || []),
+      orders: clone(state.orders),
