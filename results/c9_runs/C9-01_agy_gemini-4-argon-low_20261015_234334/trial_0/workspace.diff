+    if (!order) {
+      return { ok: false, error: `未找到订单: ${orderId}` };
+    }
+    if (order.status !== 'paid' && order.status !== 'shipped') {
+      return { ok: false, error: `仅已付款或已发货订单可申请售后（当前状态：${order.status}）` };
+    }
+    if (!Array.isArray(refundItems) || refundItems.length === 0) {
+      return { ok: false, error: '请选择至少一项需要售后的商品及数量' };
+    }
+    if (!options || typeof options.returnGoods !== 'boolean') {
+      return { ok: false, error: '请明确指定是否退货 (returnGoods: true/false)' };
+    }
+
+    // 合并相同 SKU 并校验每个 SKU 的数量合法性
+    const mergedMap = new Map();
+    for (const ri of refundItems) {
+      if (!ri || typeof ri.sku !== 'string' || !isValidPositiveInt(ri.qty)) {
+        return { ok: false, error: '售后商品数量必须为正整数' };
+      }
+      mergedMap.set(ri.sku, (mergedMap.get(ri.sku) || 0) + ri.qty);
+    }
+
+    const cleanItems = [];
+    for (const [sku, reqQty] of mergedMap.entries()) {
+      const orderItem = order.items.find(it => it.sku === sku);
+      if (!orderItem) {
+        return { ok: false, error: `订单中不包含商品 ${sku}` };
+      }
+      const alreadyRefunded = getRefundedQtyForOrderSku(order, sku);
+      const maxAvail = orderItem.qty - alreadyRefunded;
+      if (reqQty > maxAvail) {
+        return { ok: false, error: `商品 ${sku} 申请售后数量(${reqQty})超过剩余可退数量(${maxAvail})` };
+      }
+      cleanItems.push({ sku, qty: reqQty, unitPrice: orderItem.unitPrice });
+    }
+
+    // 判断本次申请后，订单全部商品是否已全部退完
+    let allItemsFullyRefundedAfterThis = true;
+    for (const orderItem of order.items) {
+      const alreadyRefunded = getRefundedQtyForOrderSku(order, orderItem.sku);
+      const thisReq = mergedMap.get(orderItem.sku) || 0;
+      if (alreadyRefunded + thisReq < orderItem.qty) {
+        allItemsFullyRefundedAfterThis = false;
+        break;
+      }
+    }
+
+    const remainingPayable = round2(Math.max(0, order.payable - order.refundedAmount));
+    if (remainingPayable <= 0 && order.payable > 0) {
