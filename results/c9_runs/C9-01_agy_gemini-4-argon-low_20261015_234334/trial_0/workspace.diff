+      if (skuFlt) {
+        const hasSku = o.items.some(it => it.sku === skuFlt || it.sku.includes(skuFlt));
+        if (!hasSku) return false;
+      }
+      if (fromFlt || toFlt) {
+        // 以订单日期 YYYY-MM-DD 比较（含当天）
+        const orderDate = String(o.createdAt).slice(0, 10);
+        if (fromFlt && orderDate < fromFlt) return false;
+        if (toFlt && orderDate > toFlt) return false;
+      }
+      return true;
+    });
