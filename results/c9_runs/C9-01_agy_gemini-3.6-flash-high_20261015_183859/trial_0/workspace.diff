+    function getStats() {
+      let sales = 0;
+      let totalRefunds = 0;
+      const unitsSoldMap = {};
+
+      for (const prod of state.products) {
+        for (const v of prod.variants) {
+          unitsSoldMap[v.sku] = 0;
+        }
+      }
+
+      for (const order of state.orders) {
+        if (order.paidAt !== null) {
+          sales += order.payable;
+          for (const item of order.items) {
+            unitsSoldMap[item.sku] = (unitsSoldMap[item.sku] || 0) + item.qty;
+          }
+        }
+
+        for (const r of order.refunds) {
+          totalRefunds += r.amount;
+          if (order.paidAt !== null) {
+            for (const rItem of r.items) {
+              unitsSoldMap[rItem.sku] = (unitsSoldMap[rItem.sku] || 0) - rItem.qty;
+            }
+          }
+        }
+      }
+
+      sales = Math.round(sales * 100) / 100;
+      totalRefunds = Math.round(totalRefunds * 100) / 100;
+      const net = Math.round((sales - totalRefunds) * 100) / 100;
+
+      return {
+        sales,
+        refunds: totalRefunds,
+        net,
+        unitsSold: unitsSoldMap
+      };
+    }
