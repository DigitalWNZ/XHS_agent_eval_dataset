+
+    const STORAGE_KEY = "POP_TOY_SHOP_DATA_V1";
+
+    // Application State
+    let state = {
+      products: [],
+      coupons: [],
+      isMember: false,
+      orders: [],
+      cart: [], // [{ sku, qty }]
