+
+    function handlePayUI(orderId) {
+      const res = pay(orderId);
+      if (!res.ok) alert(res.error);
+    }
+
+    function handleShipUI(orderId) {
+      const res = ship(orderId);
+      if (!res.ok) alert(res.error);
+    }
+
+    function handleCancelUI(orderId) {
+      if (confirm(`确定要取消订单 ${orderId} 吗？`)) {
+        const res = cancel(orderId);
+        if (!res.ok) alert(res.error);
