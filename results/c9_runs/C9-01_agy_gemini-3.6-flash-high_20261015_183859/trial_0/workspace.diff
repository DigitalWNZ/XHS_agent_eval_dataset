+
+    // Helper functions
+    function deepClone(obj) {
+      return JSON.parse(JSON.stringify(obj));
+    }
+
+    function saveState() {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+      } catch (e) {
+        console.error("LocalStorage save failed", e);
+      }
+    }
+
+    function loadState() {
+      try {
+        const raw = localStorage.getItem(STORAGE_KEY);
+        if (raw) {
+          const parsed = JSON.parse(raw);
+          if (parsed && Array.isArray(parsed.products) && Array.isArray(parsed.orders)) {
+            state = { ...state, ...parsed };
+            return;
+          }
+        }
+      } catch (e) {
+        console.error("Failed to load local storage", e);
+      }
+      // Fallback default init
+      state.products = deepClone(DEFAULT_PRODUCTS);
+      state.coupons = deepClone(DEFAULT_COUPONS);
+      state.orders = deepClone(DEFAULT_ORDERS);
+      state.cart = [];
+      state.isMember = false;
+      state.appliedCouponCode = null;
+      state.logs = [{
+        time: new Date().toISOString(),
+        action: "系统初始化",
+        detail: "加载默认潮玩店业务数据"
+      }];
+    }
+
+    function addLog(action, detail) {
+      state.logs.unshift({
+        time: new Date().toISOString(),
+        action,
+        detail
+      });
+      if (state.logs.length > 200) state.logs.pop();
+    }
+
+    function findVariant(sku) {
+      for (const prod of state.products) {
+        for (const v of prod.variants) {
+          if (v.sku === sku) return v;
+        }
+      }
+      return null;
+    }
+
+    function findProductBySku(sku) {
+      for (const prod of state.products) {
+        for (const v of prod.variants) {
+          if (v.sku === sku) return { product: prod, variant: v };
+        }
+      }
+      return null;
+    }
+
+    function restockSku(sku, qty) {
+      const v = findVariant(sku);
+      if (v) {
+        v.stock += qty;
+      }
+    }
+
+    // --- CORE BUSINESS FUNCTIONS (exposed to window.shopTestAPI) ---
+
+    function reset() {
+      state.products = deepClone(DEFAULT_PRODUCTS);
+      state.coupons = deepClone(DEFAULT_COUPONS);
+      state.orders = deepClone(DEFAULT_ORDERS);
+      state.cart = [];
+      state.isMember = false;
+      state.appliedCouponCode = null;
+      state.checkoutStep = "cart";
+      state.logs = [{
+        time: new Date().toISOString(),
+        action: "系统重置",
+        detail: "恢复为初始商品与历史订单"
+      }];
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function getState() {
+      return deepClone({
+        products: state.products,
+        coupons: state.coupons,
+        isMember: state.isMember,
+        orders: state.orders,
+        logs: state.logs
+      });
+    }
+
+    function setMember(isMember) {
+      state.isMember = Boolean(isMember);
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function addToCart(sku, qty) {
+      if (typeof qty !== 'number' || qty <= 0 || !Number.isInteger(qty)) {
+        return { ok: false, error: "购买数量必须为正整数" };
+      }
+      const variant = findVariant(sku);
+      if (!variant) {
+        return { ok: false, error: "商品SKU不存在" };
+      }
+      const currentLine = state.cart.find(item => item.sku === sku);
+      const currentQty = currentLine ? currentLine.qty : 0;
+      if (currentQty + qty > variant.stock) {
+        return { ok: false, error: `库存不足，当前库存为 ${variant.stock}` };
+      }
+      if (currentLine) {
+        currentLine.qty += qty;
+      } else {
+        state.cart.push({ sku, qty });
+      }
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function setCartQty(sku, qty) {
+      if (typeof qty !== 'number' || !Number.isInteger(qty) || qty < 0) {
+        return { ok: false, error: "非法数量" };
+      }
+      const idx = state.cart.findIndex(item => item.sku === sku);
+      if (qty === 0) {
+        if (idx !== -1) {
+          state.cart.splice(idx, 1);
+        }
+        saveState();
+        renderUI();
+        return { ok: true };
+      }
+      const variant = findVariant(sku);
+      if (!variant) {
+        return { ok: false, error: "商品SKU不存在" };
+      }
+      if (qty > variant.stock) {
+        return { ok: false, error: `超出库存，当前库存为 ${variant.stock}` };
+      }
+      if (idx !== -1) {
+        state.cart[idx].qty = qty;
+      } else {
+        state.cart.push({ sku, qty });
+      }
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function removeFromCart(sku) {
+      const idx = state.cart.findIndex(item => item.sku === sku);
+      if (idx !== -1) {
+        state.cart.splice(idx, 1);
+      }
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function applyCoupon(code) {
+      if (!code) {
+        state.appliedCouponCode = null;
+        saveState();
+        renderUI();
+        return { ok: true };
+      }
+      const coupon = state.coupons.find(c => c.code === code);
+      if (!coupon) {
+        return { ok: false, error: "优惠券不存在" };
+      }
+      const cartObj = getCart();
+      if (cartObj.subtotal < coupon.threshold) {
+        return { ok: false, error: `未达到优惠券门槛（满 ${coupon.threshold} 元可用）` };
+      }
+      state.appliedCouponCode = code;
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function getCart() {
+      const lines = state.cart.map(item => {
+        const variant = findVariant(item.sku);
+        const unitPrice = variant ? variant.price : 0;
+        const lineTotal = Math.round(item.qty * unitPrice * 100) / 100;
+        return {
+          sku: item.sku,
+          qty: item.qty,
+          unitPrice: unitPrice,
+          lineTotal: lineTotal
+        };
+      });
+
+      const subtotal = Math.round(lines.reduce((sum, l) => sum + l.lineTotal, 0) * 100) / 100;
+      const discounts = [];
+
+      // 会员折扣 (10% off, 9折)
+      if (state.isMember && subtotal > 0) {
+        const memberDiscount = Math.round(subtotal * 0.10 * 100) / 100;
+        if (memberDiscount > 0) {
+          discounts.push({ type: "member", amount: memberDiscount });
+        }
+      }
+
+      // 满减优惠券
+      if (state.appliedCouponCode) {
+        const coupon = state.coupons.find(c => c.code === state.appliedCouponCode);
+        if (coupon && subtotal >= coupon.threshold) {
+          const couponAmount = Math.min(coupon.amount, subtotal);
+          if (couponAmount > 0) {
+            discounts.push({ type: "coupon", amount: couponAmount });
+          }
+        }
+      }
+
+      const totalDiscounts = discounts.reduce((sum, d) => sum + d.amount, 0);
+      const total = Math.max(0, Math.round((subtotal - totalDiscounts) * 100) / 100);
+
+      return {
+        lines,
+        subtotal,
+        discounts,
+        total
+      };
+    }
+
+    function prepareCheckout(address) {
+      if (!address || typeof address !== 'object') {
+        return { ok: false, error: "收货信息不能为空" };
+      }
+      const { name, phone, address: addrStr } = address;
+      if (!name || !String(name).trim()) {
+        return { ok: false, error: "请填写收货人姓名" };
+      }
+      if (!phone || !/^\d{11}$/.test(String(phone).trim())) {
+        return { ok: false, error: "手机号必须为11位数字" };
+      }
+      if (!addrStr || !String(addrStr).trim()) {
+        return { ok: false, error: "请填写收货地址" };
+      }
+      const cartObj = getCart();
+      if (cartObj.lines.length === 0) {
+        return { ok: false, error: "购物车为空" };
+      }
+      for (const line of cartObj.lines) {
+        const variant = findVariant(line.sku);
+        if (!variant || line.qty > variant.stock) {
+          return { ok: false, error: `商品 ${line.sku} 库存不足` };
+        }
+      }
+
+      state.checkoutAddress = {
+        name: String(name).trim(),
+        phone: String(phone).trim(),
+        address: String(addrStr).trim()
+      };
+      state.checkoutStep = "confirm";
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    let isSubmittingCheckout = false;
+
+    function checkout(address) {
+      if (isSubmittingCheckout) {
+        return { ok: false, error: "请勿重复提交" };
+      }
+      isSubmittingCheckout = true;
+      try {
+        const prepRes = prepareCheckout(address);
+        if (!prepRes.ok) {
+          return prepRes;
+        }
+
+        const cartObj = getCart();
+
+        // Stock reduction
+        for (const line of cartObj.lines) {
+          const variant = findVariant(line.sku);
+          variant.stock -= line.qty;
+        }
+
+        const orderId = "ORD-" + Date.now() + "-" + Math.floor(Math.random() * 1000);
+        const newOrder = {
+          id: orderId,
+          status: "pending",
+          createdAt: new Date().toISOString(),
+          paidAt: null,
+          items: cartObj.lines.map(l => ({ sku: l.sku, qty: l.qty, unitPrice: l.unitPrice })),
+          subtotal: cartObj.subtotal,
+          discounts: deepClone(cartObj.discounts),
+          payable: cartObj.total,
+          refundedAmount: 0.00,
+          refunds: []
+        };
+
+        state.orders.unshift(newOrder);
+        state.cart = [];
+        state.appliedCouponCode = null;
+        state.checkoutStep = "cart";
+
+        addLog("创建订单", `生成订单 ${orderId}，实付金额 ¥${newOrder.payable.toFixed(2)}`);
+
+        saveState();
+        renderUI();
+
+        return { ok: true, orderId };
+      } finally {
+        isSubmittingCheckout = false;
+      }
+    }
+
+    function pay(orderId) {
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) {
+        return { ok: false, error: "订单不存在" };
+      }
+      if (order.status !== "pending") {
+        return { ok: false, error: "当前订单状态不可付款" };
+      }
+      order.status = "paid";
+      order.paidAt = new Date().toISOString();
+      addLog("订单付款", `订单 ${orderId} 完成模拟付款`);
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function ship(orderId) {
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) {
+        return { ok: false, error: "订单不存在" };
+      }
+      if (order.status !== "paid") {
+        return { ok: false, error: "当前订单状态不可发货" };
+      }
+      order.status = "shipped";
+      addLog("订单发货", `订单 ${orderId} 已成功发货`);
+      saveState();
+      renderUI();
+      return { ok: true };
+    }
+
+    function cancel(orderId) {
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) {
+        return { ok: false, error: "订单不存在" };
+      }
+      if (order.status === "cancelled") {
+        return { ok: false, error: "订单已处于取消状态" };
+      }
+      if (order.status === "shipped") {
+        return { ok: false, error: "已发货订单不可直接取消，请申请退货售后" };
+      }
+
+      if (order.status === "pending") {
+        for (const item of order.items) {
+          restockSku(item.sku, item.qty);
+        }
+        order.status = "cancelled";
+        addLog("取消订单", `未付款订单 ${orderId} 已取消，库存已释放`);
+        saveState();
+        renderUI();
+        return { ok: true };
+      }
+
+      if (order.status === "paid") {
+        for (const item of order.items) {
+          restockSku(item.sku, item.qty);
+        }
+        const remainingPayable = Math.round((order.payable - order.refundedAmount) * 100) / 100;
+        const refundId = "REF-CANCEL-" + Date.now();
+        const refundRecord = {
+          id: refundId,
+          items: order.items.map(i => ({ sku: i.sku, qty: i.qty })),
+          amount: remainingPayable,
+          returnGoods: false,
+          restocked: true
+        };
+        order.refunds.push(refundRecord);
+        order.refundedAmount = Math.round((order.refundedAmount + remainingPayable) * 100) / 100;
+        order.status = "cancelled";
+        addLog("取消订单", `已付款订单 ${orderId} 已取消，退款 ¥${remainingPayable.toFixed(2)}，库存已释放`);
+        saveState();
+        renderUI();
+        return { ok: true };
+      }
+
+      return { ok: false, error: "不可取消" };
+    }
+
+    function requestAfterSale(orderId, itemsToRefund, { returnGoods }) {
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) {
+        return { ok: false, error: "订单不存在" };
+      }
+      if (order.status !== "paid" && order.status !== "shipped") {
+        return { ok: false, error: "当前订单状态不支持申请售后" };
+      }
+      if (!Array.isArray(itemsToRefund) || itemsToRefund.length === 0) {
+        return { ok: false, error: "请选择退款商品" };
+      }
+
+      for (const req of itemsToRefund) {
+        const orderItem = order.items.find(i => i.sku === req.sku);
+        if (!orderItem) {
+          return { ok: false, error: `订单中不包含商品 ${req.sku}` };
+        }
+        if (typeof req.qty !== 'number' || req.qty <= 0 || !Number.isInteger(req.qty)) {
+          return { ok: false, error: `退货数量非法` };
+        }
+
+        let refundedQty = 0;
+        for (const r of order.refunds) {
+          const match = r.items.find(i => i.sku === req.sku);
+          if (match) refundedQty += match.qty;
+        }
+
+        const availableQty = orderItem.qty - refundedQty;
+        if (req.qty > availableQty) {
+          return { ok: false, error: `商品 ${req.sku} 可退数量仅剩 ${availableQty}` };
+        }
+      }
+
+      const remainingPayable = Math.round((order.payable - order.refundedAmount) * 100) / 100;
+      if (remainingPayable <= 0) {
+        return { ok: false, error: "订单实付金额已全额退还，无法继续退款" };
+      }
+
+      // Check if all items in order are fully refunded after this request
+      const isAllItemsFullyRefunded = order.items.every(orderItem => {
+        let refundedQty = 0;
+        for (const r of order.refunds) {
+          const match = r.items.find(i => i.sku === orderItem.sku);
+          if (match) refundedQty += match.qty;
+        }
+        const req = itemsToRefund.find(i => i.sku === orderItem.sku);
+        const newQty = req ? req.qty : 0;
+        return (refundedQty + newQty) === orderItem.qty;
+      });
+
+      let refundAmount = 0;
+      if (isAllItemsFullyRefunded) {
+        refundAmount = remainingPayable;
+      } else {
+        let rawSum = 0;
+        for (const req of itemsToRefund) {
+          const orderItem = order.items.find(i => i.sku === req.sku);
+          rawSum += req.qty * orderItem.unitPrice;
+        }
+        const calcAmount = Math.round((rawSum * order.payable / order.subtotal) * 100) / 100;
+        refundAmount = Math.min(calcAmount, remainingPayable);
+      }
+
+      const refundId = "REF-" + Date.now() + "-" + Math.floor(Math.random() * 1000);
+      const isRestockedImmediately = (order.status === "paid"); // If unshipped paid order, restock now
+
+      if (isRestockedImmediately) {
+        for (const req of itemsToRefund) {
+          restockSku(req.sku, req.qty);
+        }
+      }
+
+      const refundRecord = {
+        id: refundId,
+        items: itemsToRefund.map(i => ({ sku: i.sku, qty: i.qty })),
+        amount: refundAmount,
+        returnGoods: Boolean(returnGoods),
+        restocked: isRestockedImmediately
+      };
+
+      order.refunds.push(refundRecord);
+      order.refundedAmount = Math.round((order.refundedAmount + refundAmount) * 100) / 100;
+
+      addLog("申请售后", `订单 ${orderId} 申请售后 ${refundId}，退款金额 ¥${refundAmount.toFixed(2)}`);
