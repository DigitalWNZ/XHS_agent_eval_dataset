+    }
+
+    // AfterSale UI & Modal
+    let activeRefundOrderId = null;
+
+    function openRefundModalUI(orderId) {
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) return;
+
+      activeRefundOrderId = orderId;
+      const modalBody = document.getElementById('refund-modal-body');
+
+      let html = `
+        <div style="font-size: 0.9rem; margin-bottom: 0.75rem;">
+          <div>订单编号: <strong>${order.id}</strong> (${order.status === 'paid' ? '已付款未发货' : '已发货'})</div>
+          <div>订单实付: ¥${order.payable.toFixed(2)} | 已退金额: ¥${order.refundedAmount.toFixed(2)}</div>
+        </div>
+
+        <table class="order-items-table" style="margin-bottom: 1rem;">
+          <thead>
+            <tr>
+              <th>商品SKU</th>
+              <th>已买数量</th>
+              <th>可退数量</th>
+              <th>本次申请退量</th>
+            </tr>
+          </thead>
+          <tbody>
+      `;
+
+      order.items.forEach(item => {
+        let refundedQty = 0;
+        for (const r of order.refunds) {
+          const match = r.items.find(i => i.sku === item.sku);
+          if (match) refundedQty += match.qty;
+        }
+        const avail = item.qty - refundedQty;
+
+        html += `
+          <tr>
+            <td><strong>${item.sku}</strong></td>
+            <td>${item.qty}</td>
+            <td>${avail}</td>
+            <td>
+              <input type="number" id="refund-qty-${item.sku}" class="qty-input" value="0" min="0" max="${avail}" ${avail <= 0 ? 'disabled' : ''}>
+            </td>
+          </tr>
+        `;
+      });
+
+      html += `
+          </tbody>
+        </table>
+
+        <div style="margin-bottom: 0.5rem;">
+          <label style="font-size: 0.85rem; font-weight: 600;">售后类型：</label>
+          <select id="refund-return-goods" style="width: 100%; margin-top: 0.25rem;">
+            <option value="true">退货退款 (需寄回商品，发货单入库后回补库存)</option>
+            <option value="false">仅退款 (无需退货)</option>
+          </select>
+        </div>
+      `;
+
+      modalBody.innerHTML = html;
+      document.getElementById('refund-modal').classList.add('active');
+    }
+
+    function closeRefundModal() {
+      document.getElementById('refund-modal').classList.remove('active');
+      activeRefundOrderId = null;
+    }
+
+    function submitRefundModal() {
+      if (!activeRefundOrderId) return;
+      const order = state.orders.find(o => o.id === activeRefundOrderId);
+      if (!order) return;
+
+      const itemsToRefund = [];
+      order.items.forEach(item => {
+        const input = document.getElementById(`refund-qty-${item.sku}`);
+        if (input) {
+          const qty = parseInt(input.value, 10);
+          if (qty > 0) {
+            itemsToRefund.push({ sku: item.sku, qty });
+          }
+        }
+      });
+
+      if (itemsToRefund.length === 0) {
+        alert("请至少选择一件商品的退货数量");
+        return;
+      }
+
+      const returnGoods = document.getElementById('refund-return-goods').value === 'true';
+
+      const res = requestAfterSale(activeRefundOrderId, itemsToRefund, { returnGoods });
+      if (!res.ok) {
+        alert(res.error);
+      } else {
+        alert(`售后申请成功！退款金额为 ¥${res.amount.toFixed(2)}`);
+        closeRefundModal();
+      }
+    }
+
+    function renderAfterSaleList() {
+      const container = document.getElementById('aftersale-list-container');
+      const allRefunds = [];
+      state.orders.forEach(o => {
+        o.refunds.forEach(r => {
+          allRefunds.push({ order: o, refund: r });
+        });
+      });
+
+      if (allRefunds.length === 0) {
+        container.innerHTML = `<div style="text-align:center; color:var(--text-muted); padding:2rem;">暂无售后记录</div>`;
+        return;
+      }
+
+      let html = `
+        <table class="order-items-table">
+          <thead>
+            <tr>
+              <th>售后单号</th>
+              <th>关联订单号</th>
+              <th>退款明细</th>
+              <th>退款金额</th>
+              <th>类型</th>
+              <th>库存状态</th>
+              <th>操作</th>
+            </tr>
+          </thead>
+          <tbody>
+      `;
+
+      allRefunds.forEach(({ order, refund }) => {
+        const itemsStr = refund.items.map(i => `${i.sku} ×${i.qty}`).join(', ');
+        const restockBadge = refund.restocked ? `<span style="color:var(--success); font-weight:600;">已入库</span>` : `<span style="color:var(--warning); font-weight:600;">待入库</span>`;
+
+        html += `
+          <tr>
+            <td><strong>${refund.id}</strong></td>
+            <td>${order.id}</td>
+            <td>${itemsStr}</td>
+            <td><strong style="color:var(--danger);">¥${refund.amount.toFixed(2)}</strong></td>
+            <td>${refund.returnGoods ? '退货退款' : '仅退款'}</td>
+            <td>${restockBadge}</td>
+            <td>
+        `;
+
+        if (refund.returnGoods && !refund.restocked) {
+          html += `<button class="btn btn-success btn-sm" onclick="handleConfirmReturnUI('${refund.id}')">确认退货入库</button>`;
+        } else {
+          html += `<span style="color:var(--text-muted); font-size:0.8rem;">-</span>`;
+        }
+
+        html += `
+            </td>
+          </tr>
+        `;
+      });
+
+      html += `</tbody></table>`;
+      container.innerHTML = html;
+    }
+
+    function handleConfirmReturnUI(refundId) {
+      const res = confirmReturn(refundId);
+      if (!res.ok) {
+        alert(res.error);
+      } else {
+        alert("确认入库成功，库存已更新！");
+      }
+    }
+
+    // Analytics Dashboard UI
+    function renderAnalyticsUI() {
+      const stats = getStats();
+      document.getElementById('stat-sales').textContent = `¥${stats.sales.toFixed(2)}`;
+      document.getElementById('stat-refunds').textContent = `¥${stats.refunds.toFixed(2)}`;
+      document.getElementById('stat-net').textContent = `¥${stats.net.toFixed(2)}`;
+
+      const tbody = document.getElementById('stat-units-tbody');
+      let html = '';
+
+      state.products.forEach(prod => {
+        prod.variants.forEach(v => {
+          // Calculate gross paid units vs refunded units
+          let grossPaid = 0;
+          let refunded = 0;
+
+          state.orders.forEach(o => {
+            if (o.paidAt !== null) {
+              const matchItem = o.items.find(i => i.sku === v.sku);
+              if (matchItem) grossPaid += matchItem.qty;
+
+              o.refunds.forEach(r => {
+                const matchRef = r.items.find(i => i.sku === v.sku);
+                if (matchRef) refunded += matchRef.qty;
+              });
+            }
+          });
+
+          const netSold = stats.unitsSold[v.sku] || 0;
+
+          html += `
+            <tr>
+              <td><strong>${v.sku}</strong></td>
+              <td>${escapeHtml(prod.name)}</td>
+              <td>${escapeHtml(v.spec)}</td>
+              <td>¥${v.price.toFixed(2)}</td>
+              <td>${grossPaid}</td>
+              <td style="color:var(--danger);">${refunded}</td>
+              <td><strong style="color:var(--primary);">${netSold}</strong></td>
+            </tr>
+          `;
+        });
+      });
+
+      tbody.innerHTML = html;
+    }
+
+    // Backup & Logs UI
