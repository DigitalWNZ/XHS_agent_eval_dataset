+    function queryOrders(query = {}) {
+      const { orderId, sku, status, from, to } = query;
+      return state.orders.filter(order => {
+        if (orderId && !order.id.toLowerCase().includes(orderId.toLowerCase())) {
+          return false;
+        }
+        if (sku && !order.items.some(i => i.sku.toLowerCase() === sku.toLowerCase())) {
+          return false;
+        }
+        if (status && order.status !== status) {
+          return false;
+        }
+        const createdDateStr = order.createdAt.slice(0, 10);
+        if (from && createdDateStr < from) {
+          return false;
+        }
+        if (to && createdDateStr > to) {
+          return false;
+        }
+        return true;
+      });
+    }
