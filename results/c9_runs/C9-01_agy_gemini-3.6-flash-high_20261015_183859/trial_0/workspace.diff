+            <button class="btn btn-success btn-sm" onclick="handlePayUI('${order.id}')">模拟付款</button>
+            <button class="btn btn-danger btn-sm" onclick="handleCancelUI('${order.id}')">取消订单</button>
+          `;
+        } else if (order.status === 'paid') {
+          html += `
+            <button class="btn btn-primary btn-sm" onclick="handleShipUI('${order.id}')">模拟发货</button>
+            <button class="btn btn-warning btn-sm" onclick="openRefundModalUI('${order.id}')">申请售后/退款</button>
+            <button class="btn btn-danger btn-sm" onclick="handleCancelUI('${order.id}')">取消订单并退款</button>
+          `;
+        } else if (order.status === 'shipped') {
+          html += `
+            <button class="btn btn-warning btn-sm" onclick="openRefundModalUI('${order.id}')">申请售后/退货退款</button>
+          `;
+        }
+
+        html += `
+            </div>
+          </div>
+        </div>
+        `;
+      });
+
+      container.innerHTML = html;
