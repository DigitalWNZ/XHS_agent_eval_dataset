+    function confirmReturn(refundId) {
+      let targetOrder = null;
+      let targetRefund = null;
+      for (const o of state.orders) {
+        const r = o.refunds.find(ref => ref.id === refundId);
+        if (r) {
+          targetOrder = o;
+          targetRefund = r;
+          break;
+        }
+      }
+      if (!targetRefund) {
+        return { ok: false, error: "售后单不存在" };
+      }
+      if (targetRefund.restocked) {
+        return { ok: false, error: "已确认入库，不能重复入库" };
+      }
+      if (!targetRefund.returnGoods) {
+        return { ok: false, error: "该售后单无需退货" };
+      }
+
+      for (const item of targetRefund.items) {
+        restockSku(item.sku, item.qty);
+      }
+      targetRefund.restocked = true;
+
+      addLog("退货入库", `售后单 ${refundId} 确认退货入库，库存已回补`);
