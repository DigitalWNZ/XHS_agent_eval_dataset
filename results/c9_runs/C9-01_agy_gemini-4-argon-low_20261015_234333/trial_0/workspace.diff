+        <div><strong>所属订单：</strong>${escapeHtml(order.id)} (${escapeHtml(order.status)})</div>
+        <div><strong>原价合计：</strong>¥${order.subtotal.toFixed(2)} · <strong>订单实付：</strong>¥${order.payable.toFixed(2)} · <strong>剩余可退实付：</strong><span style="color:var(--danger);font-weight:700;">¥${round2(order.payable - order.refundedAmount).toFixed(2)}</span></div>
+      </div>
+      <table class="table" style="margin-bottom:12px;">
+        <thead>
+          <tr><th>商品 SKU</th><th>原单价</th><th>原购数量</th><th>可退上限</th><th>本次申请退数量</th></tr>
+        </thead>
+        <tbody>${rowsHtml}</tbody>
+      </table>
+      <div style="margin-bottom:12px;">
+        <label style="display:flex;align-items:center;gap:8px;font-weight:600;cursor:pointer;">
+          <input type="checkbox" id="aftersale-return-goods" ${defaultReturnGoods ? "checked" : ""} style="width:16px;height:16px;">
+          <span>需要退回实物商品 (returnGoods = true，已发货订单需后续点击“确认退货入库”才回补库存)</span>
+        </label>
+      </div>
+      <div id="aftersale-preview-box" style="background:var(--primary-light);border:1px solid #c7d2fe;padding:10px 12px;border-radius:6px;font-size:13px;">
+        预计按优惠分摊计算本次应退金额：<strong style="color:#e11d48;font-size:16px;" id="aftersale-preview-amount">¥0.00</strong>
+        <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">公式：round(Σ 本次退货原价 × 订单实付 ÷ 原价合计, 2)；若订单商品全部退完则退还剩余全部实付。</div>
+      </div>
+    `;
+
+    document.getElementById("aftersale-modal").classList.add("open");
+  };
+
+  window.updateAfterSalePreview = function() {
+    if (!activeAfterSaleOrderId) return;
+    const order = state.orders.find(o => o.id === activeAfterSaleOrderId);
+    if (!order) return;
+
+    const returnedMap = getOrderReturnedQtyMap(order);
+    const inputs = document.querySelectorAll(".aftersale-qty-input");
+    let rawSum = 0;
+    let allReturned = true;
+
+    inputs.forEach(inp => {
+      const sku = inp.getAttribute("data-sku");
+      const avail = Number(inp.getAttribute("data-avail"));
+      const price = Number(inp.getAttribute("data-price"));
+      const qty = Math.max(0, Math.floor(Number(inp.value) || 0));
+      rawSum += qty * price;
+      if (qty < avail) allReturned = false;
+    });
+
+    const remPayable = round2(Math.max(0, order.payable - order.refundedAmount));
+    let est = 0;
+    if (rawSum > 0) {
+      if (allReturned) {
+        est = remPayable;
+      } else {
+        est = Math.min(remPayable, round2((rawSum * order.payable) / order.subtotal));
+      }
+    }
+    const previewEl = document.getElementById("aftersale-preview-amount");
+    if (previewEl) previewEl.textContent = `¥${est.toFixed(2)}`;
+  };
+
+  window.closeAfterSaleModal = function() {
+    activeAfterSaleOrderId = null;
+    document.getElementById("aftersale-modal").classList.remove("open");
+  };
