+  window.handleDownloadJsonFile = function() {
+    const jsonStr = window.shopTestAPI.exportData();
+    const ta = document.getElementById("data-json-textarea");
+    if (ta) ta.value = jsonStr;
+    const blob = new Blob([jsonStr], { type: "application/json;charset=utf-8" });
