+
+  // ============================================================================
+  // 售后部分退款/退货弹窗
+  // ============================================================================
+  let activeAfterSaleOrderId = null;
+
+  window.openAfterSaleModal = function(orderId) {
+    const order = state.orders.find(o => o.id === orderId);
+    if (!order) return;
+    activeAfterSaleOrderId = orderId;
+
+    const returnedMap = getOrderReturnedQtyMap(order);
+    const rowsHtml = order.items.map(it => {
+      const found = findVariant(it.sku);
+      const nameSpec = found ? `${found.product.name} - ${found.variant.spec}` : it.sku;
+      const retQty = returnedMap[it.sku] || 0;
+      const avail = Math.max(0, it.qty - retQty);
+      return `
+        <tr>
+          <td>
+            <strong>${escapeHtml(it.sku)}</strong>
+            <div style="font-size:11px;color:var(--text-muted);">${escapeHtml(nameSpec)}</div>
+          </td>
+          <td>¥${it.unitPrice.toFixed(2)}</td>
+          <td>${it.qty} (已退 ${retQty})</td>
+          <td><strong>${avail}</strong></td>
+          <td>
+            <input type="number" class="input aftersale-qty-input" data-sku="${escapeHtml(it.sku)}" data-avail="${avail}" data-price="${it.unitPrice}"
+              style="width:76px;" min="0" max="${avail}" value="0" ${avail <= 0 ? "disabled" : ""} oninput="updateAfterSalePreview()">
+          </td>
+        </tr>
+      `;
+    }).join("");
+
+    const defaultReturnGoods = order.status === "shipped";
+    const bodyEl = document.getElementById("aftersale-modal-body");
+    bodyEl.innerHTML = `
