+
+  window.closeConfirmModal = function() {
+    pendingConfirmCallback = null;
+    document.getElementById("confirm-modal").classList.remove("open");
+  };
+
+  document.getElementById("confirm-modal-ok-btn").addEventListener("click", function() {
+    const cb = pendingConfirmCallback;
+    closeConfirmModal();
+    if (typeof cb === "function") cb();
+  });
+
+  window.openCancelOrderModal = function(orderId, isPaid) {
+    const msg = isPaid
+      ? `您正在取消<strong>已付款未发货</strong>订单 <code>${escapeHtml(orderId)}</code>。<br><br>确认取消后，系统将自动<strong>释放订单占用的未退库存</strong>，并自动生成一条<strong>退还剩余实付金额的退款记录</strong>。是否确认取消？`
+      : `您正在取消<strong>待付款</strong>订单 <code>${escapeHtml(orderId)}</code>。<br><br>确认取消后，系统将立即<strong>释放该订单占用的商品库存</strong>。是否确认取消？`;
+    openConfirmDialog("⚠️ 确认取消订单", msg, function() {
