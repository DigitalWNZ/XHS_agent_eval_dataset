+    const returnGoods = returnGoodsEl ? returnGoodsEl.checked : false;
+
+    const res = window.shopTestAPI.requestAfterSale(activeAfterSaleOrderId, items, { returnGoods });
+    if (!res.ok) {
+      showToast(res.error, "error");
+    } else {
