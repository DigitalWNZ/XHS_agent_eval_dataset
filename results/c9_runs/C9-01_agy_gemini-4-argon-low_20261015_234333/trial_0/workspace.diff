+    const matched = state.orders.filter(o => {
+      if (orderIdFilter && !o.id.toLowerCase().includes(orderIdFilter.toLowerCase())) {
+        return false;
+      }
+      if (skuFilter && !o.items.some(it => it.sku === skuFilter)) {
+        return false;
+      }
+      if (statusFilter && o.status !== statusFilter) {
+        return false;
+      }
+      if (fromFilter || toFilter) {
+        const dateStr = getOrderDatePart(o.createdAt);
+        if (fromFilter && dateStr < fromFilter) return false;
+        if (toFilter && dateStr > toFilter) return false;
