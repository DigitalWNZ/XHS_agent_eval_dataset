+        for (const [sku, qty] of Object.entries(state.cart)) {
+          if (qty > 0) {
+            const match = findVariant(sku);
+            if (match) {
+              const unitPrice = roundMoney(match.variant.price);
+              const lineTotal = roundMoney(unitPrice * qty);
+              subtotal = roundMoney(subtotal + lineTotal);
+              lines.push({
+                sku,
+                qty,
+                unitPrice,
+                lineTotal
+              });
+            }
+          }
+        }
