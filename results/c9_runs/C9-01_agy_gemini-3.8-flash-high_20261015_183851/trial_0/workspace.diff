+        if (typeof qty !== 'number' || !Number.isInteger(qty) || qty <= 0) {
+          return { ok: false, error: "购买数量必须为正整数" };
+        }
+        const match = findVariant(sku);
+        if (!match) {
+          return { ok: false, error: "未找到该SKU商品" };
+        }
+
+        const currentQty = state.cart[sku] || 0;
+        const targetQty = currentQty + qty;
+
+        if (targetQty > match.variant.stock) {
+          return { ok: false, error: `库存不足，当前库存为 ${match.variant.stock} 件` };
+        }
+
+        state.cart[sku] = targetQty;
+        saveState();
+        renderApp();
+        return { ok: true };
+      }
+
+      function setCartQty(sku, qty) {
