+            if (refundAmount > remainingPayable) refundAmount = remainingPayable;
+          }
+
+          document.getElementById('aftersale-calc-amount').textContent = `¥${roundMoney(refundAmount).toFixed(2)}`;
+        },
+
+        onConfirmReturn(refundId) {
+          if (!confirm(`确认售后单 ${refundId} 的退回商品已验货入库？操作后将增加库存，且不可撤销。`)) return;
