+          // Validate orders structure
+          for (const o of data.orders) {
+            if (!o.id || !o.status || !Array.isArray(o.items) || typeof o.payable !== 'number') {
+              return { ok: false, error: `订单 [${o.id || '未知'}] 数据结构不完整` };
+            }
+          }
+
+          // All validated safely!
+          state.products = data.products;
+          state.orders = data.orders;
+          if (Array.isArray(data.coupons)) state.coupons = data.coupons;
+          if (typeof data.isMember === 'boolean') state.isMember = data.isMember;
+          if (Array.isArray(data.logs)) state.logs = data.logs;
+          state.cart = {};
+          state.appliedCoupon = null;
+
+          addLog("数据导入", "成功导入并更新了业务数据");
+          saveState();
+          renderApp();
+
+          return { ok: true };
+        } catch (e) {
+          return { ok: false, error: "JSON解析失败: " + e.message };
+        }
+      }
