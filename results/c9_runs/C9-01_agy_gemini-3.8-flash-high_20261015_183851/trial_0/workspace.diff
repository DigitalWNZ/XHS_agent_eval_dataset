+
+      let isCheckingOut = false; // Prevent concurrent double submission
+      function checkout(address) {
+        if (isCheckingOut) {
+          return { ok: false, error: "正在结算中，请勿重复操作" };
+        }
+
+        // Validate address
+        if (!address || typeof address !== 'object') {
+          return { ok: false, error: "请填写收货地址信息" };
+        }
+        if (!address.name || typeof address.name !== 'string' || !address.name.trim()) {
