+          }
+          if (!Array.isArray(data.orders)) {
+            return { ok: false, error: "导入数据缺少有效的订单列表 (orders)" };
+          }
+
+          // Validate products structure
+          for (const p of data.products) {
+            if (!p.id || !p.name || !Array.isArray(p.variants) || p.variants.length === 0) {
+              return { ok: false, error: `商品 [${p.id || '未知'}] 数据结构不完整` };
