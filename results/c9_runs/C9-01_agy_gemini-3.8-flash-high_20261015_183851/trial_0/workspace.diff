+        }
+
+        order.status = 'shipped';
+        addLog("订单发货", `订单 ${orderId} 已发货出库`);
+        saveState();
+        renderApp();
+        return { ok: true };
+      }
+
+      function cancel(orderId) {
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status === 'cancelled') {
+          return { ok: false, error: "订单已取消，不可重复取消" };
+        }
+        if (order.status === 'shipped') {
+          return { ok: false, error: "已发货订单不可取消" };
+        }
+        if (order.status !== 'pending' && order.status !== 'paid') {
+          return { ok: false, error: `状态为 ${order.status} 的订单不可取消` };
+        }
+
+        // Cancel pending order
+        if (order.status === 'pending') {
+          for (const it of order.items) {
+            const match = findVariant(it.sku);
+            if (match) match.variant.stock += it.qty;
+          }
+          order.status = 'cancelled';
+          addLog("取消待付款订单", `订单 ${orderId} 已取消，库存已恢复`);
+          saveState();
+          renderApp();
+          return { ok: true };
+        }
+
+        // Cancel paid order (unshipped)
+        if (order.status === 'paid') {
+          // Calculate refunded qty per sku so far
+          const refundedMap = {};
+          for (const ref of order.refunds) {
+            for (const it of ref.items) {
+              refundedMap[it.sku] = (refundedMap[it.sku] || 0) + it.qty;
+            }
+          }
+
+          const remRefundItems = [];
+          for (const it of order.items) {
+            const already = refundedMap[it.sku] || 0;
+            const rem = it.qty - already;
+            if (rem > 0) {
+              const match = findVariant(it.sku);
+              if (match) match.variant.stock += rem;
+              remRefundItems.push({ sku: it.sku, qty: rem });
+            }
+          }
+
+          const remainingPayable = roundMoney(order.payable - order.refundedAmount);
+          if (remainingPayable > 0 || remRefundItems.length > 0) {
+            const refId = "REF-" + new Date().toISOString().replace(/\D/g, '').slice(0, 14) + "-" + Math.floor(100 + Math.random() * 900);
+            const refundRecord = {
+              id: refId,
+              items: remRefundItems,
+              amount: remainingPayable,
+              returnGoods: false,
+              restocked: true
+            };
+            order.refunds.push(refundRecord);
+            order.refundedAmount = order.payable;
+          }
+
+          order.status = 'cancelled';
+          addLog("取消已付款订单", `订单 ${orderId} 已取消，自动退款 ¥${remainingPayable.toFixed(2)} 并回补库存`);
+          saveState();
+          renderApp();
+          return { ok: true };
+        }
+
+        return { ok: false, error: "未知错误" };
+      }
+
+      function requestAfterSale(orderId, items, options) {
+        const returnGoods = !!(options && options.returnGoods);
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+
+        if (order.status !== 'paid' && order.status !== 'shipped') {
+          return { ok: false, error: `当前订单状态为 ${order.status}，仅已付款或已发货订单支持售后退款` };
+        }
+
+        if (!Array.isArray(items) || items.length === 0) {
+          return { ok: false, error: "请选择售后商品" };
+        }
+
+        // Calculate refunded qty per sku so far
+        const refundedQtyMap = {};
+        for (const ref of order.refunds) {
+          for (const it of ref.items) {
+            refundedQtyMap[it.sku] = (refundedQtyMap[it.sku] || 0) + it.qty;
+          }
+        }
+
+        for (const req of items) {
+          if (!req.sku || typeof req.qty !== 'number' || !Number.isInteger(req.qty) || req.qty <= 0) {
+            return { ok: false, error: "售后商品规格及数量非法" };
+          }
+          const orderItem = order.items.find(i => i.sku === req.sku);
+          if (!orderItem) {
+            return { ok: false, error: `SKU [${req.sku}] 不在原订单中` };
+          }
+          const already = refundedQtyMap[req.sku] || 0;
+          const canRefund = orderItem.qty - already;
+          if (req.qty > canRefund) {
+            return { ok: false, error: `SKU [${req.sku}] 售后数量(${req.qty})超过可退数量(${canRefund})` };
+          }
+        }
+
+        const remainingPayable = roundMoney(order.payable - order.refundedAmount);
+        if (remainingPayable <= 0) {
+          return { ok: false, error: "订单已无可退款金额" };
+        }
+
+        // Check if after this refund, all items of the order are fully refunded
+        let allDone = true;
+        for (const oi of order.items) {
+          const already = refundedQtyMap[oi.sku] || 0;
+          const req = items.find(r => r.sku === oi.sku)?.qty || 0;
+          if (already + req < oi.qty) {
+            allDone = false;
+            break;
+          }
+        }
+
+        let refundAmount = 0;
+        if (allDone) {
+          refundAmount = remainingPayable;
+        } else {
+          // Formula: Σ 数量 × 单价 × 实付 ÷ 商品原价合计, 四舍五入到分
+          let sum = 0;
+          for (const req of items) {
+            const oi = order.items.find(i => i.sku === req.sku);
+            sum += req.qty * oi.unitPrice * order.payable / order.subtotal;
+          }
+          refundAmount = Math.round(sum * 100) / 100;
+          if (refundAmount > remainingPayable) {
+            refundAmount = remainingPayable;
+          }
+        }
+        refundAmount = roundMoney(refundAmount);
+
+        // Restock linkage:
+        // Shipped orders: NEVER restock directly upon application; must be confirmed via confirmReturn!
+        // Unshipped (paid) orders: If returnGoods is true, restock immediately because goods never left warehouse!
+        let restocked = false;
+        if (order.status === 'paid') {
+          if (returnGoods) {
+            for (const req of items) {
+              const match = findVariant(req.sku);
+              if (match) match.variant.stock += req.qty;
+            }
+            restocked = true;
+          }
+        }
+
+        const refundId = "REF-" + new Date().toISOString().replace(/\D/g, '').slice(0, 14) + "-" + Math.floor(100 + Math.random() * 900);
+        const refundRecord = {
+          id: refundId,
+          items: items.map(i => ({ sku: i.sku, qty: i.qty })),
+          amount: refundAmount,
+          returnGoods,
+          restocked
+        };
+
+        order.refunds.push(refundRecord);
+        order.refundedAmount = roundMoney(order.refundedAmount + refundAmount);
+
+        addLog("售后退款申请", `订单 ${orderId} 售后单 ${refundId} 申请成功，退款 ¥${refundAmount.toFixed(2)} (退货: ${returnGoods ? '是' : '否'}, 入库: ${restocked ? '已回补' : '待入库'})`);
+
+        saveState();
+        renderApp();
+
+        return {
+          ok: true,
+          refundId,
+          amount: refundAmount
+        };
+      }
+
+      function confirmReturn(refundId) {
+        let targetOrder = null;
+        let targetRefund = null;
+
+        for (const o of state.orders) {
+          for (const r of o.refunds) {
+            if (r.id === refundId) {
+              targetOrder = o;
+              targetRefund = r;
+              break;
+            }
+          }
+          if (targetRefund) break;
+        }
+
+        if (!targetRefund) {
+          return { ok: false, error: "售后记录不存在" };
+        }
+        if (targetRefund.restocked) {
+          return { ok: false, error: "该售后单已入库，不可重复入库" };
+        }
+        if (!targetRefund.returnGoods) {
+          return { ok: false, error: "该售后记录为仅退款，无需退货入库" };
+        }
+
+        // Restock
+        for (const it of targetRefund.items) {
+          const match = findVariant(it.sku);
+          if (match) {
+            match.variant.stock += it.qty;
+          }
+        }
+        targetRefund.restocked = true;
+
+        addLog("退货确认入库", `售后单 ${refundId} 确认入库，库存已回补`);
+
+        saveState();
+        renderApp();
+
+        return { ok: true };
+      }
+
+      function queryOrders(params = {}) {
+        const { orderId, sku, status, from, to } = params;
+        return state.orders.filter(order => {
+          if (orderId && !order.id.toLowerCase().includes(orderId.trim().toLowerCase())) {
+            return false;
+          }
+          if (status && order.status !== status) {
+            return false;
+          }
+          if (sku) {
+            const hasSku = order.items.some(i => i.sku.toLowerCase().includes(sku.trim().toLowerCase()));
+            if (!hasSku) return false;
+          }
+          const orderDate = order.createdAt.slice(0, 10);
+          if (from && orderDate < from) {
+            return false;
+          }
+          if (to && orderDate > to) {
+            return false;
+          }
+          return true;
+        });
+      }
+
+      function getStats() {
+        let sales = 0;
+        let refunds = 0;
+
+        const unitsSold = {};
+        for (const p of state.products) {
+          for (const v of p.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const o of state.orders) {
+          // Sales: All orders that were once paid (paidAt !== null), including those later cancelled or refunded
+          if (o.paidAt !== null && o.paidAt !== undefined) {
+            sales = roundMoney(sales + o.payable);
+
+            // Units sold: paid items minus refunded items
+            for (const it of o.items) {
+              unitsSold[it.sku] = (unitsSold[it.sku] || 0) + it.qty;
+            }
+            for (const ref of o.refunds || []) {
+              for (const it of ref.items) {
+                unitsSold[it.sku] = (unitsSold[it.sku] || 0) - it.qty;
+              }
+            }
+          }
+
+          // Refunds: All refunds across all orders
+          for (const ref of o.refunds || []) {
+            refunds = roundMoney(refunds + ref.amount);
+          }
+        }
+
+        const net = roundMoney(sales - refunds);
+
+        return {
+          sales,
+          refunds,
+          net,
+          unitsSold
+        };
+      }
