+      function getAlreadyRefundedQty(order, sku) {
+        let sum = 0;
+        for (const r of order.refunds) {
+          for (const item of r.items) {
+            if (item.sku === sku) {
+              sum += item.qty;
+            }
+          }
+        }
+        return sum;
+      }
