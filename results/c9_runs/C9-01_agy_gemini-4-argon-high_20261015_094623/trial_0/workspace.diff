+        }
+      };
+
+      // Stats & Logs rendering
+      function renderStatsAndLogs() {
+        const stats = window.shopTestAPI.getStats();
+
+        const salesEl = document.getElementById("statSales");
+        const refundsEl = document.getElementById("statRefunds");
+        const netEl = document.getElementById("statNet");
+        const unitsEl = document.getElementById("statUnitsTotal");
+        const pendingInfoEl = document.getElementById("statPendingInfo");
+
+        if (salesEl) salesEl.textContent = `¥${stats.sales.toFixed(2)}`;
+        if (refundsEl) refundsEl.textContent = `¥${stats.refunds.toFixed(2)}`;
+        if (netEl) netEl.textContent = `¥${stats.net.toFixed(2)}`;
+
+        const totalUnits = Object.values(stats.unitsSold).reduce((a, b) => a + b, 0);
+        if (unitsEl) unitsEl.textContent = `${totalUnits} 件`;
+
+        const pendingOrders = state.orders.filter(o => o.status === "pending").length;
+        let pendingRestocks = 0;
+        for (const o of state.orders) {
+          if (o.status === "shipped") {
+            for (const r of o.refunds) {
+              if (r.returnGoods && !r.restocked) pendingRestocks++;
+            }
+          }
+        }
+        if (pendingInfoEl) {
+          pendingInfoEl.textContent = `待付款 ${pendingOrders} 单 · 待确认退货入库 ${pendingRestocks} 单`;
+        }
+
+        // SKU table
+        const skuBody = document.getElementById("skuStatsTableBody");
+        if (skuBody) {
+          const rows = [];
+          for (const p of state.products) {
+            for (const v of p.variants) {
+              const sold = stats.unitsSold[v.sku] || 0;
+              rows.push(`
+                <tr>
+                  <td style="font-family:monospace;font-weight:600;">${escapeHtml(v.sku)}</td>
+                  <td>${escapeHtml(p.name)} · <span style="color:var(--text-secondary);">${escapeHtml(v.spec)}</span></td>
+                  <td>¥${v.price.toFixed(2)}</td>
+                  <td>
+                    <span class="badge ${v.stock <= 0 ? "badge-refund" : v.stock <= 5 ? "badge-pending" : "badge-shipped"}">
+                      ${v.stock} 件
+                    </span>
+                  </td>
+                  <td style="font-weight:700;color:var(--primary);">${sold} 件</td>
+                </tr>
+              `);
+            }
+          }
+          skuBody.innerHTML = rows.join("");
+        }
+
+        // Logs
+        const logContainer = document.getElementById("logListContainer");
+        if (logContainer) {
+          if (state.logs.length === 0) {
+            logContainer.innerHTML = `<div style="color:var(--text-muted);text-align:center;padding:16px;">暂无操作记录</div>`;
+          } else {
+            logContainer.innerHTML = state.logs
+              .map(
+                l => `
+                  <div class="log-item">
+                    <div>
+                      <strong>[${escapeHtml(l.action)}]</strong>
+                      <span>${escapeHtml(l.detail)}</span>
+                    </div>
+                    <span style="color:var(--text-muted);white-space:nowrap;font-family:monospace;">${formatTime(l.time)}</span>
+                  </div>
+                `
+              )
+              .join("");
+          }
+        }
+      }
+
+      // Backup Modal Logic
+      window.openBackupModal = function () {
+        const modal = document.getElementById("backupModal");
+        const textarea = document.getElementById("backupJsonTextarea");
+        const feedback = document.getElementById("backupFeedback");
+        if (textarea) {
+          textarea.value = window.shopTestAPI.exportData();
+        }
+        if (feedback) feedback.classList.add("hidden");
+        modal.classList.remove("hidden");
+      };
+
+      window.closeBackupModal = function () {
+        document.getElementById("backupModal").classList.add("hidden");
+      };
+
+      window.handleExportRefresh = function () {
+        const textarea = document.getElementById("backupJsonTextarea");
+        if (textarea) {
+          textarea.value = window.shopTestAPI.exportData();
+          showToast("已生成最新业务数据 JSON", "success");
+        }
+      };
+
+      window.handleDownloadExportFile = function () {
+        const json = window.shopTestAPI.exportData();
+        const blob = new Blob([json], { type: "application/json;charset=utf-8" });
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement("a");
+        a.href = url;
+        a.download = `popbox-backup-${new Date().toISOString().slice(0, 10)}.json`;
+        document.body.appendChild(a);
+        a.click();
+        document.body.removeChild(a);
+        URL.revokeObjectURL(url);
+        showToast("已触发备份文件下载", "success");
+      };
+
+      window.handleImportFileSelect = function (event) {
+        const file = event.target.files && event.target.files[0];
+        if (!file) return;
+        const reader = new FileReader();
+        reader.onload = function (e) {
+          const content = String(e.target.result || "");
+          const textarea = document.getElementById("backupJsonTextarea");
+          if (textarea) textarea.value = content;
+          handleImportFromTextarea();
+        };
+        reader.readAsText(file);
+        event.target.value = "";
+      };
+
+      window.handleImportFromTextarea = function () {
+        const textarea = document.getElementById("backupJsonTextarea");
+        const feedback = document.getElementById("backupFeedback");
+        const raw = textarea ? textarea.value : "";
+        const res = window.shopTestAPI.importData(raw);
+        if (!res.ok) {
+          if (feedback) {
+            feedback.classList.remove("hidden");
+            feedback.style.color = "var(--danger)";
+            feedback.textContent = `✗ 导入失败：${res.error}（原有数据完好保留，未被覆盖）`;
+          }
+          showToast(`导入失败：${res.error}`, "error");
+        } else {
+          if (feedback) {
+            feedback.classList.remove("hidden");
+            feedback.style.color = "var(--success)";
+            feedback.textContent = "✓ 数据校验通过并已成功恢复！";
+          }
+          showToast("业务数据导入恢复成功", "success");
+        }
+      };
+
+      // Generic Danger Confirmation Modal
+      let pendingDangerCallback = null;
+      function openDangerModal(title, message, onConfirm) {
+        document.getElementById("dangerModalTitle").textContent = title;
+        document.getElementById("dangerModalMessage").textContent = message;
+        pendingDangerCallback = onConfirm;
+        document.getElementById("dangerConfirmModal").classList.remove("hidden");
+      }
+
+      window.closeDangerModal = function () {
+        pendingDangerCallback = null;
+        document.getElementById("dangerConfirmModal").classList.add("hidden");
+      };
+
+      document.getElementById("dangerModalConfirmBtn").addEventListener("click", function () {
+        const cb = pendingDangerCallback;
+        closeDangerModal();
+        if (typeof cb === "function") cb();
+      });
+
+      window.requestResetConfirm = function () {
+        openDangerModal(
+          "恢复初始演示数据",
+          "确定要重置全部业务数据吗？重置后将恢复为初始商品库存与历史订单，清空当前购物车并将会员身份设为否。",
+          function () {
+            window.shopTestAPI.reset();
+            showToast("已恢复为初始商品与历史订单数据", "success");
+          }
+        );
+      };
+
+      function renderAll() {
+        renderCategoryTabs();
+        renderProducts();
+        renderCart();
+        populateSkuFilterOptions();
+        renderOrders();
+        renderStatsAndLogs();
+      }
+
+      // Initialize on load
+      if (!loadState()) {
+        saveState();
+      }
+      renderAll();
+    })();
+  </script>
+</body>
+</html>
