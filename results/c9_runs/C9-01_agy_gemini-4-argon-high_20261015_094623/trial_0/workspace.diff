+      // Lookup helpers
+      function findVariantInfo(sku) {
+        if (typeof sku !== "string" || !sku) return null;
+        for (const product of state.products) {
+          for (const variant of product.variants) {
+            if (variant.sku === sku) {
+              return { product, variant };
+            }
+          }
+        }
+        return null;
+      }
+
+      function findCoupon(code) {
+        if (typeof code !== "string" || !code) return null;
+        return state.coupons.find(c => c.code === code) || null;
+      }
+
+      function findOrder(orderId) {
+        if (typeof orderId !== "string" || !orderId) return null;
+        return state.orders.find(o => o.id === orderId) || null;
+      }
+
+      function findRefundAcrossOrders(refundId) {
+        if (typeof refundId !== "string" || !refundId) return null;
+        for (const order of state.orders) {
+          for (const refund of order.refunds) {
+            if (refund.id === refundId) {
+              return { order, refund };
+            }
+          }
+        }
+        return null;
+      }
