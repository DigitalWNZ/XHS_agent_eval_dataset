+        let seq = state.orders.length + 1;
+        let candidate = `ORD-${y}${m}${d}-${String(seq).padStart(4, "0")}`;
+        while (findOrder(candidate)) {
+          seq++;
+          candidate = `ORD-${y}${m}${d}-${String(seq).padStart(4, "0")}`;
+        }
+        return candidate;
+      }
+
+      function generateRefundId() {
+        const now = new Date();
+        const y = now.getUTCFullYear();
+        const m = String(now.getUTCMonth() + 1).padStart(2, "0");
+        const d = String(now.getUTCDate()).padStart(2, "0");
+        let totalRefunds = 0;
+        for (const o of state.orders) {
+          totalRefunds += o.refunds.length;
+        }
+        let seq = totalRefunds + 1;
+        let candidate = `RFD-${y}${m}${d}-${String(seq).padStart(4, "0")}`;
+        while (findRefundAcrossOrders(candidate)) {
+          seq++;
+          candidate = `RFD-${y}${m}${d}-${String(seq).padStart(4, "0")}`;
+        }
+        return candidate;
