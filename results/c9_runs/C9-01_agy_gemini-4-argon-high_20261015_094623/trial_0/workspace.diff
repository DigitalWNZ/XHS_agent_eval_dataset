+      // Revalidate cart & coupon whenever items/qty/member change
+      function revalidateCartPromotions() {
+        let subtotal = 0;
+        for (const line of state.cart) {
+          const info = findVariantInfo(line.sku);
+          if (info) {
+            subtotal = round2(subtotal + round2(line.qty * info.variant.price));
+          }
+        }
+        if (subtotal <= 0) {
+          state.appliedCouponCode = null;
+          return;
+        }
+        if (state.appliedCouponCode) {
+          const coupon = findCoupon(state.appliedCouponCode);
+          if (!coupon || subtotal < coupon.threshold) {
+            state.appliedCouponCode = null;
+          }
+        }
+      }
+
+      // Compute getCart() result
+      function computeCartObject() {
+        revalidateCartPromotions();
+        const lines = [];
+        let subtotal = 0;
+
+        for (const item of state.cart) {
+          const info = findVariantInfo(item.sku);
+          if (!info) continue;
+          const unitPrice = round2(info.variant.price);
+          const lineTotal = round2(item.qty * unitPrice);
+          lines.push({
+            sku: item.sku,
+            qty: item.qty,
+            unitPrice,
+            lineTotal
+          });
+          subtotal = round2(subtotal + lineTotal);
+        }
+
+        const discounts = [];
+        if (lines.length > 0 && subtotal > 0) {
+          if (state.isMember) {
+            const memberAmt = round2(subtotal * MEMBER_DISCOUNT_RATE);
+            if (memberAmt > 0) {
+              discounts.push({ type: "member", amount: memberAmt });
+            }
+          }
+          if (state.appliedCouponCode) {
+            const coupon = findCoupon(state.appliedCouponCode);
+            if (coupon && subtotal >= coupon.threshold) {
+              discounts.push({ type: "coupon", amount: round2(coupon.amount) });
+            }
+          }
+        }
+
+        const discountSum = round2(discounts.reduce((acc, d) => acc + d.amount, 0));
+        const total = Math.max(0, round2(subtotal - discountSum));
+
+        return {
+          lines,
+          subtotal,
+          discounts,
+          total
+        };
+      }
