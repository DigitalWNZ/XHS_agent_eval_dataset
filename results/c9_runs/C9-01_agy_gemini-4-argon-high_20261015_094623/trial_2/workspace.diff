+            return { ok: false, error: "订单已处于取消状态，不能重复取消" };
+          }
+          if (order.status === "shipped") {
+            return { ok: false, error: "已发货订单不可直接取消，请申请退货退款售后" };
+          }
+          if (order.status !== "pending" && order.status !== "paid") {
+            return { ok: false, error: "当前订单状态不允许取消" };
+          }
