+
+      let currentAfterSaleOrderId = null;
+
+      window.uiOpenAfterSaleModal = function (orderId) {
+        const order = findOrder(orderId);
+        if (!order) return;
+        currentAfterSaleOrderId = orderId;
+
+        document.getElementById("as-modal-title").textContent = `申请售后退款 · 订单 ${order.id}`;
+        document.getElementById("as-order-info").innerHTML = `
+          订单状态：<strong>${escapeHtml(order.status)}</strong> |
+          商品原价合计：<strong>¥${order.subtotal.toFixed(2)}</strong> |
+          订单实付：<strong>¥${order.payable.toFixed(2)}</strong> |
+          已退金额：<strong>¥${order.refundedAmount.toFixed(2)}</strong>
+        `;
+
+        const refundedBySku = {};
+        for (const r of order.refunds) {
+          for (const ri of r.items) {
+            refundedBySku[ri.sku] = (refundedBySku[ri.sku] || 0) + ri.qty;
+          }
+        }
+
+        const tbody = document.getElementById("as-items-tbody");
+        tbody.innerHTML = order.items
+          .map((item) => {
+            const info = findVariantInfo(item.sku);
+            const title = info ? `${info.product.name} (${info.variant.spec})` : item.sku;
+            const refQty = refundedBySku[item.sku] || 0;
+            const remQty = item.qty - refQty;
+            return `
+              <tr>
+                <td>
+                  <strong>${escapeHtml(title)}</strong><br/>
+                  <span class="sku-code">${escapeHtml(item.sku)}</span>
+                </td>
+                <td>¥${item.unitPrice.toFixed(2)}</td>
+                <td>${item.qty}</td>
+                <td>${refQty}</td>
+                <td><strong>${remQty}</strong></td>
+                <td>
+                  <input
+                    type="number"
+                    class="input qty-input as-qty-input"
+                    data-sku="${escapeHtml(item.sku)}"
+                    data-max="${remQty}"
+                    value="0"
+                    min="0"
+                    max="${remQty}"
+                    ${remQty <= 0 ? "disabled" : ""}
+                    oninput="updateAfterSalePreview()"
+                  />
+                </td>
+              </tr>
+            `;
+          })
+          .join("");
+
+        const radios = document.querySelectorAll('input[name="as-return-goods"]');
+        radios.forEach((r) => {
+          r.checked = order.status === "shipped" ? r.value === "true" : r.value === "false";
+        });
+
+        updateAfterSalePreview();
+        document.getElementById("after-sale-modal").classList.add("open");
+      };
