+          const num = Number(inp.value);
+          if (!Number.isInteger(num) || num < 0) {
+            showToast("申请数量必须为非负整数", "error");
+            return;
+          }
+          if (num > 0) {
+            items.push({ sku, qty: num });
+          }
+        }
+
+        if (items.length === 0) {
+          showToast("请至少填写一件需要售后的商品数量 (> 0)", "error");
+          return;
+        }
+
+        const returnGoodsRadio = document.querySelector('input[name="as-return-goods"]:checked');
+        const returnGoods = returnGoodsRadio ? returnGoodsRadio.value === "true" : true;
+
+        const res = shopTestAPI.requestAfterSale(currentAfterSaleOrderId, items, { returnGoods });
+        if (res.ok) {
+          closeAfterSaleModal();
+          showToast(`售后单 ${res.refundId} 提交成功，退款金额 ¥${res.amount.toFixed(2)}`, "success");
+        } else {
+          showToast(res.error, "error");
+        }
+      };
