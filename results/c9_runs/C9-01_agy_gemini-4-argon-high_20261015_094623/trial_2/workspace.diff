+        },
+
+        removeFromCart(sku) {
+          const idx = state.cart.findIndex((item) => item.sku === sku);
+          if (idx === -1) {
+            return { ok: false, error: "购物车中不存在该商品规格" };
+          }
+          state.cart.splice(idx, 1);
+          syncCartDiscounts();
+          checkoutSession.submitted = false;
+          saveState();
+          renderAll();
+          return { ok: true, cart: shopTestAPI.getCart() };
+        },
+
+        applyCoupon(code) {
+          if (code === null || code === "" || code === undefined) {
+            state.selectedCouponCode = null;
+            syncCartDiscounts();
+            checkoutSession.submitted = false;
+            saveState();
+            renderAll();
+            return { ok: true, cart: shopTestAPI.getCart() };
+          }
+
+          if (typeof code !== "string") {
+            return { ok: false, error: "优惠券编码格式无效" };
+          }
+          const trimmed = code.trim();
+          const coupon = state.coupons.find((c) => c.code === trimmed);
+          if (!coupon) {
+            return { ok: false, error: `优惠券 ${trimmed} 不存在` };
+          }
+
+          const cartDetails = computeCartDetails();
+          if (cartDetails.subtotal < coupon.threshold) {
+            return {
+              ok: false,
+              error: `当前商品原价合计 ¥${cartDetails.subtotal.toFixed(2)} 未达到满 ¥${coupon.threshold} 元使用门槛`
+            };
+          }
+
+          state.selectedCouponCode = coupon.code;
+          syncCartDiscounts();
+          checkoutSession.submitted = false;
+          saveState();
+          renderAll();
+          return { ok: true, cart: shopTestAPI.getCart() };
+        },
+
+        getCart() {
+          return deepClone(computeCartDetails());
+        },
+
+        prepareCheckout(address) {
+          if (address && typeof address === "object") {
+            const nameInput = document.getElementById("checkout-name");
+            const phoneInput = document.getElementById("checkout-phone");
+            const addrInput = document.getElementById("checkout-address");
+            if (nameInput) nameInput.value = address.name !== undefined ? String(address.name) : "";
+            if (phoneInput) phoneInput.value = address.phone !== undefined ? String(address.phone) : "";
+            if (addrInput) addrInput.value = address.address !== undefined ? String(address.address) : "";
+          }
