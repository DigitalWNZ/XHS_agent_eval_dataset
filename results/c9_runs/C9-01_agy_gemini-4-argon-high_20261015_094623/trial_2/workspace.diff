+      window.closeAfterSaleModal = function () {
+        document.getElementById("after-sale-modal").classList.remove("open");
+        currentAfterSaleOrderId = null;
+      };
+
+      window.updateAfterSalePreview = function () {
+        const order = findOrder(currentAfterSaleOrderId);
+        if (!order) return;
+
+        const refundedBySku = {};
+        for (const r of order.refunds) {
+          for (const ri of r.items) {
+            refundedBySku[ri.sku] = (refundedBySku[ri.sku] || 0) + ri.qty;
+          }
+        }
+
+        const inputs = document.querySelectorAll(".as-qty-input");
+        const reqMap = {};
+        let hasAny = false;
+        inputs.forEach((inp) => {
+          const sku = inp.getAttribute("data-sku");
+          const val = Math.max(0, parseInt(inp.value || "0", 10) || 0);
+          reqMap[sku] = val;
+          if (val > 0) hasAny = true;
+        });
+
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        document.getElementById("as-payable-info").textContent = `¥${order.payable.toFixed(2)} / 已退 ¥${order.refundedAmount.toFixed(2)}`;
+        document.getElementById("as-remaining-payable").textContent = `¥${remainingPayable.toFixed(2)}`;
+
+        if (!hasAny) {
+          document.getElementById("as-preview-amount").textContent = "¥0.00";
+          return;
+        }
+
+        let isAllRefunded = true;
+        let rawSub = 0;
+        for (const oi of order.items) {
+          const already = refundedBySku[oi.sku] || 0;
+          const nowReq = reqMap[oi.sku] || 0;
+          if (already + nowReq < oi.qty) {
+            isAllRefunded = false;
+          }
+          rawSub += nowReq * oi.unitPrice;
+        }
+
+        let preview = 0;
+        if (isAllRefunded) {
+          preview = remainingPayable;
+        } else {
+          preview = order.subtotal > 0 ? round2((rawSub * order.payable) / order.subtotal) : 0;
+          if (preview > remainingPayable) preview = remainingPayable;
+        }
+
+        document.getElementById("as-preview-amount").textContent = `¥${preview.toFixed(2)}${isAllRefunded ? " (全退尾差兜底：剩余实付)" : ""}`;
+      };
+
+      window.submitAfterSaleModal = function () {
+        if (!currentAfterSaleOrderId) return;
+        const inputs = document.querySelectorAll(".as-qty-input");
