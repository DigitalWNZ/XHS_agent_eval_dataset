+          order.status = "cancelled";
+          saveState();
+          renderAll();
+          return { ok: true, orderId: order.id, status: order.status };
+        },
+
+        requestAfterSale(orderId, items, options) {
+          const order = findOrder(orderId);
+          if (!order) {
+            return { ok: false, error: "订单不存在" };
+          }
+          if (order.status !== "paid" && order.status !== "shipped") {
+            return { ok: false, error: "仅已付款 (paid) 或已发货 (shipped) 订单可申请售后" };
+          }
+          if (!Array.isArray(items) || items.length === 0) {
+            return { ok: false, error: "请选择要申请售后的商品及数量" };
+          }
+
+          // Aggregate and validate requested items
+          const requestedMap = new Map();
+          for (const entry of items) {
+            if (!entry || typeof entry.sku !== "string" || !entry.sku.trim()) {
+              return { ok: false, error: "售后商品 SKU 无效" };
+            }
+            if (typeof entry.qty !== "number" || !Number.isInteger(entry.qty) || entry.qty <= 0) {
+              return { ok: false, error: "售后申请数量必须为正整数" };
+            }
+            const sku = entry.sku.trim();
+            requestedMap.set(sku, (requestedMap.get(sku) || 0) + entry.qty);
+          }
+
+          const orderItemMap = new Map();
+          for (const oi of order.items) {
+            orderItemMap.set(oi.sku, oi);
+          }
+
+          // Compute already refunded quantities per SKU
+          const refundedQtyMap = new Map();
+          for (const oi of order.items) {
+            refundedQtyMap.set(oi.sku, 0);
+          }
+          for (const r of order.refunds) {
+            for (const ri of r.items) {
+              refundedQtyMap.set(ri.sku, (refundedQtyMap.get(ri.sku) || 0) + ri.qty);
+            }
+          }
+
+          // Validate each requested SKU against order items & remaining refundable quantity
+          for (const [sku, reqQty] of requestedMap.entries()) {
+            const orderItem = orderItemMap.get(sku);
+            if (!orderItem) {
+              return { ok: false, error: `订单中不包含商品规格 ${sku}` };
+            }
+            const alreadyRefunded = refundedQtyMap.get(sku) || 0;
+            const maxRefundable = orderItem.qty - alreadyRefunded;
+            if (reqQty > maxRefundable) {
+              return {
+                ok: false,
+                error: `商品 ${sku} 申请售后数量 (${reqQty}) 超过剩余可退数量 (${maxRefundable})`
+              };
+            }
+          }
+
+          const remainingPayable = round2(order.payable - order.refundedAmount);
+          if (remainingPayable <= 0 && order.payable > 0) {
+            return { ok: false, error: "该订单实付金额已全部退完，不可继续退款" };
+          }
+
+          // Check if all items in the order will be completely refunded after this request
+          let isAllItemsRefundedAfter = true;
+          for (const oi of order.items) {
+            const alreadyRefunded = refundedQtyMap.get(oi.sku) || 0;
+            const nowReq = requestedMap.get(oi.sku) || 0;
+            if (alreadyRefunded + nowReq < oi.qty) {
+              isAllItemsRefundedAfter = false;
+              break;
+            }
+          }
+
+          // Calculate refund amount according to proportional discount allocation rule
+          let refundAmount = 0;
+          if (isAllItemsRefundedAfter) {
+            refundAmount = remainingPayable;
+          } else {
+            let requestedRawSubtotal = 0;
+            for (const [sku, reqQty] of requestedMap.entries()) {
+              const oi = orderItemMap.get(sku);
+              requestedRawSubtotal += reqQty * oi.unitPrice;
+            }
+            if (order.subtotal > 0) {
+              refundAmount = round2((requestedRawSubtotal * order.payable) / order.subtotal);
+            } else {
+              refundAmount = 0;
+            }
+            if (refundAmount > remainingPayable) {
+              refundAmount = remainingPayable;
+            }
+          }
+
+          const returnGoods = Boolean(options && options.returnGoods);
+          const refundId = generateRefundId();
+          const normalizedItems = Array.from(requestedMap.entries()).map(([sku, qty]) => ({ sku, qty }));
+
+          const refundRecord = {
+            id: refundId,
+            items: normalizedItems,
+            amount: refundAmount,
+            returnGoods,
+            restocked: false
+          };
+
+          order.refunds.push(refundRecord);
+          order.refundedAmount = round2(order.refundedAmount + refundAmount);
+
+          addLog(
+            "申请售后退款",
+            `订单 ${order.id} 生成售后单 ${refundId} (${returnGoods ? "退货退款" : "仅退款"})，商品 ${normalizedItems.map((i) => `${i.sku}×${i.qty}`).join("、")}，分摊退款 ¥${refundAmount.toFixed(2)}`
+          );
+
+          saveState();
+          renderAll();
+          return {
+            ok: true,
+            refundId,
+            amount: refundAmount
+          };
+        },
+
+        confirmReturn(refundId) {
+          if (typeof refundId !== "string" || !refundId.trim()) {
+            return { ok: false, error: "售后单号无效" };
+          }
+
+          let targetOrder = null;
+          let targetRefund = null;
+          for (const o of state.orders) {
+            const found = o.refunds.find((r) => r.id === refundId.trim());
+            if (found) {
+              targetOrder = o;
+              targetRefund = found;
+              break;
+            }
+          }
+
+          if (!targetOrder || !targetRefund) {
+            return { ok: false, error: `未找到售后单 ${refundId}` };
+          }
+          if (targetOrder.status !== "shipped") {
+            return { ok: false, error: "仅已发货 (shipped) 订单的退货售后单可确认入库" };
+          }
+          if (!targetRefund.returnGoods) {
+            return { ok: false, error: "该售后单为仅退款类型，无需退货入库" };
+          }
+          if (targetRefund.restocked) {
+            return { ok: false, error: "该售后单已确认退货入库，不能重复入库" };
+          }
+
+          // Restock items
+          for (const item of targetRefund.items) {
+            const info = findVariantInfo(item.sku);
+            if (info) {
+              info.variant.stock += item.qty;
+            }
+          }
+
+          targetRefund.restocked = true;
+          addLog(
+            "退货确认入库",
+            `售后单 ${targetRefund.id} (订单 ${targetOrder.id}) 已确认收到退货并回补库存：${targetRefund.items.map((i) => `${i.sku} +${i.qty}`).join("、")}`
