+
+        queryOrders(filter = {}) {
+          const f = filter && typeof filter === "object" ? filter : {};
+          const orderIdQuery = typeof f.orderId === "string" ? f.orderId.trim().toLowerCase() : "";
+          const skuQuery = typeof f.sku === "string" ? f.sku.trim() : "";
+          const statusQuery = typeof f.status === "string" ? f.status.trim() : "";
+          const fromQuery = typeof f.from === "string" ? f.from.trim() : "";
+          const toQuery = typeof f.to === "string" ? f.to.trim() : "";
+
+          const results = state.orders.filter((order) => {
+            if (orderIdQuery && !order.id.toLowerCase().includes(orderIdQuery)) {
+              return false;
+            }
+            if (skuQuery) {
+              const hasSku = order.items.some((item) => {
+                if (item.sku === skuQuery) return true;
+                const info = findVariantInfo(item.sku);
+                if (info && (info.product.name.includes(skuQuery) || info.variant.spec.includes(skuQuery))) {
+                  return true;
+                }
+                return false;
+              });
+              if (!hasSku) return false;
+            }
+            if (statusQuery && order.status !== statusQuery) {
+              return false;
+            }
+            if (fromQuery) {
+              const orderDateStr = new Date(order.createdAt).toISOString().slice(0, 10);
+              if (/^\d{4}-\d{2}-\d{2}$/.test(fromQuery)) {
+                if (orderDateStr < fromQuery) return false;
+              } else {
+                if (new Date(order.createdAt) < new Date(fromQuery)) return false;
+              }
+            }
+            if (toQuery) {
+              const orderDateStr = new Date(order.createdAt).toISOString().slice(0, 10);
+              if (/^\d{4}-\d{2}-\d{2}$/.test(toQuery)) {
+                if (orderDateStr > toQuery) return false;
+              } else {
+                if (new Date(order.createdAt) > new Date(toQuery)) return false;
+              }
+            }
+            return true;
+          });
