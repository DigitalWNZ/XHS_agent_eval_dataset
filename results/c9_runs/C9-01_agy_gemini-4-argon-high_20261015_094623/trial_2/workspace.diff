+          }
+
+          const addrCheck = validateAddress(address);
+          if (!addrCheck.ok) {
+            return { ok: false, error: addrCheck.error };
+          }
+
+          // Verify stock availability for all lines before mutating
+          for (const line of cartInfo.lines) {
+            const info = findVariantInfo(line.sku);
+            if (!info) {
+              return { ok: false, error: `商品规格 ${line.sku} 不存在` };
+            }
+            if (line.qty <= 0 || line.qty > info.variant.stock) {
+              return {
