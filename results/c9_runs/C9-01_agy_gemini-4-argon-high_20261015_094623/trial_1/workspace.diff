+
+      window.updateAfterSalePreview = function () {
+        if (!activeAfterSaleOrderId) return;
+        const order = state.orders.find(o => o.id === activeAfterSaleOrderId);
+        if (!order) return;
+
+        const refundedQtyBySku = {};
+        for (const r of order.refunds) {
+          for (const ri of r.items) {
+            refundedQtyBySku[ri.sku] = (refundedQtyBySku[ri.sku] || 0) + ri.qty;
+          }
+        }
+
+        const inputs = document.querySelectorAll('.aftersale-qty-input');
+        const reqMap = {};
+        let requestedOriginalSum = 0;
+        let valid = true;
+
+        inputs.forEach(inp => {
+          const sku = inp.getAttribute('data-aftersale-sku');
+          const maxRef = Number(inp.getAttribute('data-max-refundable'));
+          const qty = Number(inp.value);
+          if (!Number.isInteger(qty) || qty < 0 || qty > maxRef) {
+            valid = false;
+            return;
+          }
+          if (qty > 0) {
+            reqMap[sku] = qty;
+            const oi = order.items.find(i => i.sku === sku);
+            if (oi) {
+              requestedOriginalSum = round2(requestedOriginalSum + round2(qty * oi.unitPrice));
+            }
+          }
+        });
+
+        const previewEl = document.getElementById('afterSalePreviewAmount');
+        if (!previewEl) return;
+
+        if (!valid || Object.keys(reqMap).length === 0) {
+          previewEl.textContent = '¥0.00';
+          return;
+        }
+
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        const allItemsRefunded = order.items.every(oi => {
+          const prev = refundedQtyBySku[oi.sku] || 0;
+          const cur = reqMap[oi.sku] || 0;
+          return (prev + cur) === oi.qty;
+        });
+
+        let previewAmt = 0;
+        if (allItemsRefunded) {
+          previewAmt = remainingPayable;
+        } else {
+          previewAmt = order.subtotal > 0 ? round2((requestedOriginalSum * order.payable) / order.subtotal) : 0;
+          if (previewAmt > remainingPayable) previewAmt = remainingPayable;
+        }
+        previewEl.textContent = formatMoney(previewAmt);
+      };
