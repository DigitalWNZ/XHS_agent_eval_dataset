+      $('import-msg').innerHTML = r.ok ? `<div class="notice ok">✅ 导入成功：${r.products} 个商品、${r.orders} 笔订单</div>` : `<div class="notice danger">❌ ${esc(r.error)}</div>`;
+    } });
+});
+$('btn-reset').addEventListener('click', () => confirmBox({ title: '恢复初始数据', danger: true, okText: '确认恢复',
+  body: '将清空当前全部订单、库存变动、售后与日志，恢复为初始演示数据。此操作不可撤销，建议先导出备份。', onOk: () => { doReset(); toast('已恢复初始数据', 'ok'); } }));
+
+function doReset() {
+  S = buildSeed();
+  ui.selectedOrder = null; ui.cartNotice = ''; ui.pick = {}; ui.qty = {}; ui.checkout = null;
+  closeModal(); $('confirm-root').innerHTML = '';
+  save(); renderAll();
+}
+
+/* ============================================================
+ * 自动化验收接口（调用与界面完全相同的业务逻辑）
+ * ============================================================ */
+const orderOut = o => clone(o);
+window.shopTestAPI = {
+  reset() { doReset(); return ok(); },
+  getState() {
+    return {
+      products: S.products.map(p => ({ id: p.id, name: p.name, category: p.category, variants: p.variants.map(v => ({ sku: v.sku, spec: v.spec, price: v.price, stock: v.stock })) })),
+      coupons: S.coupons.map(cp => ({ code: cp.code, name: cp.name, threshold: cp.threshold, amount: cp.amount })),
+      isMember: S.isMember,
+      orders: S.orders.map(orderOut),
+      logs: clone(S.logs)
+    };
+  },
+  setMember(v) { ui.cartNotice = ''; return run(() => Biz.setMember(v)); },
+  addToCart(sku, qty) { return run(() => Biz.addToCart(sku, qty)); },
+  setCartQty(sku, qty) { return run(() => Biz.setCartQty(sku, qty)); },
+  removeFromCart(sku) { return run(() => Biz.removeFromCart(sku)); },
+  applyCoupon(code) { return run(() => Biz.applyCoupon(code)); },
+  getCart() { return Biz.getCart(); },
+  checkout(address) { return run(() => Biz.checkout(address)); },
+  prepareCheckout(address) { return prepareCheckout(address); },
+  pay(id) { return run(() => Biz.pay(id)); },
+  ship(id) { return run(() => Biz.ship(id)); },
+  cancel(id) { return run(() => Biz.cancel(id)); },
+  requestAfterSale(id, items, opts) { return run(() => Biz.requestAfterSale(id, items, opts || {})); },
+  confirmReturn(rid) { return run(() => Biz.confirmReturn(rid)); },
+  queryOrders(f) { return queryOrders(f).map(orderOut); },
+  getStats() { const s = computeStats(); return { sales: s.sales, refunds: s.refunds, net: s.net, unitsSold: s.unitsSold }; },
+  exportData() { return exportData(); },
+  importData(str) { const r = run(() => importData(str)); return r.ok ? ok() : r; }
+};
+
+/* 启动 */
+load();
+renderAll();
+</script>
+</body>
+</html>
