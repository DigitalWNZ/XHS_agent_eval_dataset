+.switch input:checked+.slider{background:#ffb648}
+.switch input:checked+.slider:after{left:18px}
+main{padding:18px 20px 40px;max-width:1500px;margin:0 auto}
+.tab{display:none}.tab.active{display:block}
+.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px}
+.panel h3{margin:0 0 12px;font-size:16px}
+.muted{color:var(--muted)}.small{font-size:12px}
+.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
+.spacer{flex:1}
+.btn{border:1px solid var(--line);background:#fff;padding:6px 14px;border-radius:8px;transition:.15s;white-space:nowrap}
+.btn:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
+.btn:disabled{opacity:.45;cursor:not-allowed}
+.btn.primary{background:var(--primary);border-color:var(--primary);color:#fff}
+.btn.primary:hover:not(:disabled){filter:brightness(1.1);color:#fff}
+.btn.danger{background:var(--danger);border-color:var(--danger);color:#fff}
+.btn.danger:hover:not(:disabled){filter:brightness(1.1);color:#fff}
+.btn.ghost-danger{color:var(--danger);border-color:#f2c1c6}
+.btn.ok{background:var(--ok);border-color:var(--ok);color:#fff}
+.btn.ok:hover:not(:disabled){color:#fff;filter:brightness(1.1)}
+.btn.sm{padding:3px 9px;font-size:12px}
+.btn.lg{padding:10px 18px;font-size:15px;width:100%}
+input[type=text],input[type=search],input[type=number],input[type=date],input[type=tel],select,textarea{border:1px solid var(--line);border-radius:8px;padding:6px 10px;background:#fff;outline:none}
+input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-l)}
+input.invalid{border-color:var(--danger);box-shadow:0 0 0 3px var(--danger-l)}
+.tag{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;background:var(--gray-l);color:var(--muted);white-space:nowrap}
+.tag.pending{background:var(--warn-l);color:var(--warn)}
+.tag.paid{background:var(--info-l);color:var(--info)}
+.tag.shipped{background:var(--ok-l);color:var(--ok)}
+.tag.cancelled{background:var(--gray-l);color:#888}
+.tag.refund{background:var(--danger-l);color:var(--danger)}
+.tag.purple{background:var(--primary-l);color:var(--primary)}
+/* shop */
+.shop-layout{display:grid;grid-template-columns:1fr 380px;gap:18px;align-items:start}
+.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
+.toolbar input[type=search]{flex:1;min-width:200px}
+.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
