+  --primary:#5b4bdb;--primary-l:#efedff;--ok:#16a36a;--ok-l:#e3f7ee;--warn:#d98a00;--warn-l:#fff4dc;
+  --danger:#d93a4a;--danger-l:#fde8ea;--info:#2878d6;--info-l:#e6f0fc;--gray-l:#eff0f4;
