+.tabs button.active{background:#fff;color:#1e1b3a;font-weight:600}
+.badge{display:inline-block;min-width:18px;padding:0 6px;border-radius:9px;background:var(--danger);color:#fff;font-size:12px;line-height:18px;text-align:center}
+.badge:empty{display:none}
+.switch{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;background:rgba(255,255,255,.08);padding:6px 12px;border-radius:20px}
