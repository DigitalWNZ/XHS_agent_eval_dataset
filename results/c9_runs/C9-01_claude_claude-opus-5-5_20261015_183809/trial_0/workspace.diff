+<script>
+'use strict';
+/* ============================================================
+ * 基础工具
+ * ============================================================ */
+const LS_KEY = 'chaowan_workbench_v1';
+const MEMBER_OFF_PCT = 5;            // 会员 95 折 => 优惠 5%
+const STATUS = { pending: '待付款', paid: '已付款', shipped: '已发货', cancelled: '已取消' };
+const c = v => Math.round(Number(v) * 100);        // 元 -> 分
+const y = v => Math.round(v) / 100;                // 分 -> 元
+const fmt = v => '¥' + (Number(v) || 0).toFixed(2);
+const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
+const clone = o => JSON.parse(JSON.stringify(o));
+const ok = x => Object.assign({ ok: true }, x || {});
+const fail = e => ({ ok: false, error: e });
+const isPosInt = v => typeof v === 'number' && Number.isInteger(v) && v >= 1 && v <= 99999;
+const pad = (n, l = 2) => String(n).padStart(l, '0');
+let S = null;               // 持久化的业务状态
+let clockOverride = null;   // 仅用于构造历史数据
+const nowISO = () => clockOverride || new Date().toISOString();
+function localDate(iso) { const d = new Date(iso); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; }
+function fmtTime(iso) { if (!iso) return '—'; const d = new Date(iso); return `${localDate(iso)} ${pad(d.getHours())}:${pad(d.getMinutes())}`; }
