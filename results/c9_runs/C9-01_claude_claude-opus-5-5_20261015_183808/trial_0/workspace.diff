+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>潮玩小站 · 店员工作台</title>
+<style>
+:root{
+  --bg:#f4f5f8; --panel:#fff; --line:#e3e6ec; --text:#1f2430; --muted:#6b7280;
+  --accent:#5b4bdb; --accent-weak:#eeebff; --ok:#16a34a; --ok-weak:#e8f7ee;
+  --warn:#c2410c; --warn-weak:#fff1e6; --danger:#dc2626; --danger-weak:#fdecec;
+  --info:#0369a1; --info-weak:#e6f3fb;
+}
+*{box-sizing:border-box}
+html,body{margin:0;padding:0;background:var(--bg);color:var(--text);
+  font:14px/1.5 -apple-system,"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",system-ui,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+header.top{position:sticky;top:0;z-index:20;background:#1d1b3a;color:#fff;display:flex;align-items:center;gap:18px;padding:10px 20px}
+header.top .logo{font-weight:700;font-size:17px;letter-spacing:1px}
+header.top .logo small{font-weight:400;opacity:.7;margin-left:6px;font-size:12px}
+header.top .chips{display:flex;gap:8px;margin-left:auto;flex-wrap:wrap}
+.chip{background:rgba(255,255,255,.12);border-radius:999px;padding:3px 10px;font-size:12px;cursor:pointer;border:0;color:#fff}
+.chip b{color:#ffd166}
+nav.tabs{display:flex;gap:2px;background:#fff;border-bottom:1px solid var(--line);padding:0 16px;position:sticky;top:46px;z-index:19;overflow-x:auto}
+nav.tabs button{border:0;background:none;padding:12px 16px;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap}
+nav.tabs button.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
+main{padding:16px 20px 60px;max-width:1500px;margin:0 auto}
+.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:14px}
+.panel h2{font-size:16px;margin:0 0 10px}
+.panel h3{font-size:14px;margin:14px 0 8px}
+.muted{color:var(--muted)} .small{font-size:12px}
+.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.grow{flex:1}
+.layout-shop{display:grid;grid-template-columns:1fr 380px;gap:14px;align-items:start}
+.layout-orders{display:grid;grid-template-columns:minmax(420px,1fr) minmax(460px,1.1fr);gap:14px;align-items:start}
+.sticky{position:sticky;top:104px}
+@media(max-width:1100px){.layout-shop,.layout-orders{grid-template-columns:1fr}.sticky{position:static}}
+.btn{border:1px solid var(--line);background:#fff;border-radius:7px;padding:6px 12px;cursor:pointer;white-space:nowrap}
+.btn:hover{border-color:#c5cad6}
+.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+.btn.primary:hover{filter:brightness(1.08)}
+.btn.danger{background:var(--danger);border-color:var(--danger);color:#fff}
+.btn.ghost-danger{color:var(--danger);border-color:#f3c0c0}
+.btn.ok{background:var(--ok);border-color:var(--ok);color:#fff}
+.btn.sm{padding:3px 8px;font-size:12px}
+.btn.lg{padding:10px 20px;font-size:15px}
+.btn:disabled{opacity:.45;cursor:not-allowed;filter:none}
+input[type=text],input[type=number],input[type=date],input[type=tel],select,textarea{border:1px solid var(--line);border-radius:7px;padding:6px 9px;background:#fff;outline:none}
+input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-weak)}
+input.bad{border-color:var(--danger)}
+.err{color:var(--danger);font-size:12px;min-height:18px}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
+.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:8px}
+.thumb{height:86px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:700;color:#fff;letter-spacing:2px}
+.pname{font-weight:600}
+.specs{display:flex;flex-wrap:wrap;gap:6px}
+.spec{border:1px solid var(--line);border-radius:7px;padding:4px 8px;cursor:pointer;background:#fff;text-align:left;font-size:12px;line-height:1.35}
+.spec.on{border-color:var(--accent);background:var(--accent-weak)}
+.spec:disabled{background:#f3f4f6;color:#9ca3af;cursor:not-allowed;text-decoration:line-through}
+.price{color:#d9480f;font-weight:700}
+.badge{display:inline-block;border-radius:999px;padding:1px 9px;font-size:12px;font-weight:600;white-space:nowrap}
+.b-pending{background:var(--warn-weak);color:var(--warn)}
+.b-paid{background:var(--info-weak);color:var(--info)}
+.b-shipped{background:var(--ok-weak);color:var(--ok)}
+.b-cancelled{background:#eef0f3;color:#6b7280}
+.b-refund{background:var(--danger-weak);color:var(--danger)}
+.b-wait{background:#fff7d6;color:#a16207}
+.b-low{background:var(--warn-weak);color:var(--warn)}
+.b-out{background:#eef0f3;color:#6b7280}
+table{width:100%;border-collapse:collapse}
+th,td{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
+th{font-size:12px;color:var(--muted);font-weight:600;background:#fafbfc}
+td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
+tr.click{cursor:pointer} tr.click:hover{background:#f8f7ff}
+tr.sel{background:var(--accent-weak)!important}
+.qty{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:7px;overflow:hidden}
+.qty button{border:0;background:#f6f7f9;width:26px;height:28px;cursor:pointer}
+.qty input{border:0;width:46px;text-align:center;border-radius:0;padding:4px}
+.qty input:focus{box-shadow:none}
+.cart-line{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:9px 0;border-bottom:1px dashed var(--line)}
+.sum{width:100%}
+.sum td{border:0;padding:3px 0}
+.sum tr.total td{border-top:1px solid var(--line);padding-top:8px;font-size:17px;font-weight:700}
+.sum .minus{color:var(--ok)}
+.note{background:#f8f9fb;border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:12px;color:var(--muted)}
+.alert{border-radius:8px;padding:8px 10px;font-size:13px;margin:8px 0}
+.alert.warn{background:var(--warn-weak);color:var(--warn)}
+.alert.err{background:var(--danger-weak);color:var(--danger)}
+.alert.ok{background:var(--ok-weak);color:var(--ok)}
+.alert.info{background:var(--info-weak);color:var(--info)}
+.kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-bottom:14px}
+.kpi{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px 14px}
+.kpi .v{font-size:22px;font-weight:700;font-variant-numeric:tabular-nums}
+.kpi .l{font-size:12px;color:var(--muted)}
+.steps{display:flex;gap:6px;margin-bottom:12px}
+.steps span{padding:4px 12px;border-radius:999px;background:#eef0f3;color:var(--muted);font-size:12px}
+.steps span.on{background:var(--accent);color:#fff}
+.form label{display:block;font-size:12px;color:var(--muted);margin-bottom:3px}
+.form input,.form textarea{width:100%}
+.timeline{border-left:2px solid var(--line);margin-left:6px;padding-left:12px}
+.timeline div{margin-bottom:6px;font-size:12px}
+.timeline b{font-weight:600;color:var(--text)}
+.mask{position:fixed;inset:0;background:rgba(20,20,40,.45);display:flex;align-items:center;justify-content:center;z-index:100}
+.modal{background:#fff;border-radius:12px;padding:18px 20px;width:min(520px,92vw);max-height:86vh;overflow:auto;box-shadow:0 20px 50px rgba(0,0,0,.25)}
+.modal h3{margin:0 0 10px;font-size:16px}
+.modal .btns{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
+#toast-root{position:fixed;right:18px;bottom:18px;display:flex;flex-direction:column;gap:8px;z-index:200}
+.toast{background:#1f2430;color:#fff;padding:9px 14px;border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,.2);max-width:380px;font-size:13px}
+.toast.err{background:var(--danger)} .toast.ok{background:var(--ok)}
+.switch{display:inline-flex;align-items:center;gap:6px;cursor:pointer;user-select:none}
+.switch input{width:16px;height:16px}
+.empty{padding:30px;text-align:center;color:var(--muted)}
+code{background:#f3f4f6;padding:0 4px;border-radius:4px;font-size:12px}
+textarea.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;width:100%}
+</style>
+</head>
+<body>
+<header class="top">
+  <div class="logo">潮玩小站<small>店员工作台 · 本地模拟</small></div>
+  <div class="chips" id="hdr-chips"></div>
+</header>
+<nav class="tabs" id="tabs"></nav>
+<main id="view"></main>
+<div id="modal-root"></div>
+<div id="toast-root"></div>
+
+<script>
+(function () {
+'use strict';
+
+/* ============================================================
+ * 常量与工具
+ * 内部金额一律以“分”(整数)存储，对外接口以“元”输出。
+ * ============================================================ */
+var STORAGE_KEY = 'toyshop-workbench-v1';
+var MEMBER_OFF_PCT = 5;            // 会员 95 折，即优惠商品原价的 5%
+var STATUS_TEXT = { pending: '待付款', paid: '已付款', shipped: '已发货', cancelled: '已取消' };
+var STATUSES = ['pending', 'paid', 'shipped', 'cancelled'];
+
+function toC(y) { return Math.round(Number(y) * 100); }
+function toY(c) { return Math.round(c) / 100; }
+function fmt(c) { return (c < 0 ? '-¥' : '¥') + (Math.abs(c) / 100).toFixed(2); }
+function esc(s) {
+  return String(s == null ? '' : s).replace(/[&<>"']/g, function (ch) {
+    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
+  });
+}
+function pad(n, w) { n = String(n); while (n.length < w) n = '0' + n; return n; }
+function dateKey(iso) {
+  var d = new Date(iso);
+  return d.getFullYear() + '-' + pad(d.getMonth() + 1, 2) + '-' + pad(d.getDate(), 2);
+}
+function fmtTime(iso) {
+  if (!iso) return '—';
+  var d = new Date(iso);
+  return dateKey(iso) + ' ' + pad(d.getHours(), 2) + ':' + pad(d.getMinutes(), 2) + ':' + pad(d.getSeconds(), 2);
+}
+var fixedNow = null;     // 仅用于构造历史数据
+function nowISO() { return fixedNow || new Date().toISOString(); }
+function clone(x) { return JSON.parse(JSON.stringify(x)); }
+function normQty(q) {
+  if (typeof q === 'string' && /^\s*\d+\s*$/.test(q)) q = Number(q);
+  return q;
+}
+function isPosInt(n) { return typeof n === 'number' && isFinite(n) && Math.floor(n) === n && n > 0; }
+function isNonNegInt(n) { return typeof n === 'number' && isFinite(n) && Math.floor(n) === n && n >= 0; }
+function fail(msg) { return { ok: false, error: msg }; }
+
+/* ============================================================
+ * 状态
+ * ============================================================ */
+var S = null;
+
+function emptyState() {
+  return { version: 1, products: [], coupons: [], isMember: false, cart: [], coupon: null,
+           orders: [], logs: [], seq: { order: 0, refund: 0, log: 0 } };
+}
+
+function findVariant(sku) {
+  for (var i = 0; i < S.products.length; i++) {
+    var p = S.products[i];
+    for (var j = 0; j < p.variants.length; j++) if (p.variants[j].sku === sku) return { p: p, v: p.variants[j] };
+  }
+  return null;
+}
+function findOrder(id) { for (var i = 0; i < S.orders.length; i++) if (S.orders[i].id === id) return S.orders[i]; return null; }
+function findRefund(rid) {
+  for (var i = 0; i < S.orders.length; i++) {
+    var o = S.orders[i];
+    for (var j = 0; j < o.refunds.length; j++) if (o.refunds[j].id === rid) return { o: o, r: o.refunds[j] };
+  }
+  return null;
+}
+function findCoupon(code) { for (var i = 0; i < S.coupons.length; i++) if (S.coupons[i].code === code) return S.coupons[i]; return null; }
+
+function addLog(action, detail, orderId) {
+  S.seq.log++;
+  S.logs.push({ id: S.seq.log, time: nowISO(), action: action, detail: detail, orderId: orderId || null });
+}
+
+function changeStock(sku, delta, reason, orderId) {
+  var f = findVariant(sku);
+  if (!f) throw new Error('规格 ' + sku + ' 不存在');
+  var before = f.v.stock, after = before + delta;
+  if (after < 0) throw new Error('规格 ' + sku + ' 库存不足');
+  f.v.stock = after;
+  addLog('库存变动', reason + '：' + f.p.name + '（' + f.v.spec + '，' + sku + '）' + (delta > 0 ? '+' : '') + delta + '，库存 ' + before + ' → ' + after, orderId);
+}
+
+/* 事务：执行失败时整体回滚，保证“失败不改变任何数据” */
+function tx(fn) {
+  var snap = JSON.stringify(S);
+  var r;
+  try { r = fn(); } catch (e) { r = fail('操作失败：' + (e && e.message ? e.message : e)); }
+  if (!r || !r.ok) { S = JSON.parse(snap); return r || fail('未知错误'); }
+  persist();
+  return r;
+}
+
+function persist() {
+  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(S)); } catch (e) { /* 存储不可用时忽略 */ }
+}
+
+/* ============================================================
+ * 价格与优惠
+ * 规则：会员 95 折（对任何非空购物车生效）与满减券可叠加；
+ *       两者都以“商品原价合计”为基数计算，满减门槛也以商品原价合计判断；
+ *       每单最多一张满减券。
+ * ============================================================ */
+function quote(lines, member, couponCode) {
+  var out = [], subtotal = 0, problems = [];
+  lines.forEach(function (l) {
+    var f = findVariant(l.sku);
+    var unit = f ? f.v.price : 0;
+    var lt = unit * l.qty;
+    subtotal += lt;
+    var stock = f ? f.v.stock : 0;
+    if (!f) problems.push(l.sku + ' 已下架');
+    else if (l.qty > stock) problems.push(f.p.name + '（' + f.v.spec + '）库存仅剩 ' + stock + ' 件');
+    out.push({ sku: l.sku, qty: l.qty, unitPrice: unit, lineTotal: lt,
+               name: f ? f.p.name : l.sku, spec: f ? f.v.spec : '', stock: stock });
+  });
+  var discounts = [];
+  var memberAmt = 0;
+  if (member && subtotal > 0) {
+    memberAmt = Math.round(subtotal * MEMBER_OFF_PCT / 100);
+    if (memberAmt > 0) discounts.push({ type: 'member', amount: memberAmt, label: '会员 95 折' });
+  }
+  var coupon = null;
+  if (couponCode) {
+    var c = findCoupon(couponCode);
+    if (c) {
+      var okc = subtotal > 0 && subtotal >= c.threshold;
+      coupon = { code: c.code, name: c.name, threshold: c.threshold, amount: c.amount, ok: okc, short: Math.max(0, c.threshold - subtotal) };
+      if (okc) {
+        var amt = Math.min(c.amount, subtotal - memberAmt);
+        if (amt > 0) discounts.push({ type: 'coupon', amount: amt, label: c.name + '（' + c.code + '）', code: c.code });
+      }
+    }
+  }
+  var disc = discounts.reduce(function (s, d) { return s + d.amount; }, 0);
+  return { lines: out, subtotal: subtotal, discounts: discounts, total: subtotal - disc, coupon: coupon, problems: problems };
+}
+function cartQuote() { return quote(S.cart, S.isMember, S.coupon); }
+
+/* ============================================================
+ * 核心业务操作（界面与 shopTestAPI 共用）
+ * ============================================================ */
+var Core = {};
+
+Core.setMember = function (flag) {
+  return tx(function () {
+    if (typeof flag !== 'boolean') return fail('会员身份必须为 true 或 false');
+    S.isMember = flag;
+    return { ok: true, isMember: flag };
+  });
+};
+
+Core.addToCart = function (sku, qty) {
+  return tx(function () {
+    qty = normQty(qty);
+    var f = findVariant(sku);
+    if (!f) return fail('商品规格不存在：' + sku);
+    if (!isPosInt(qty)) return fail('数量必须为正整数');
+    if (f.v.stock <= 0) return fail(f.p.name + '（' + f.v.spec + '）已售罄');
+    var line = null;
+    S.cart.forEach(function (l) { if (l.sku === sku) line = l; });
+    var cur = line ? line.qty : 0;
+    if (cur + qty > f.v.stock) return fail('库存不足：' + f.p.name + '（' + f.v.spec + '）库存 ' + f.v.stock + ' 件，购物车已有 ' + cur + ' 件');
+    if (line) line.qty += qty; else S.cart.push({ sku: sku, qty: qty });
+    return { ok: true, qty: cur + qty };
+  });
+};
+
+Core.setCartQty = function (sku, qty) {
+  return tx(function () {
+    qty = normQty(qty);
+    var line = null;
+    S.cart.forEach(function (l) { if (l.sku === sku) line = l; });
+    if (!line) return fail('购物车中没有该商品：' + sku);
+    if (!isPosInt(qty)) return fail('数量必须为正整数（如需删除请点“移除”）');
+    var f = findVariant(sku);
+    if (!f) return fail('商品规格不存在：' + sku);
+    if (qty > f.v.stock) return fail('超出库存：' + f.p.name + '（' + f.v.spec + '）库存仅 ' + f.v.stock + ' 件');
+    line.qty = qty;
+    return { ok: true, qty: qty };
+  });
+};
+
+Core.removeFromCart = function (sku) {
+  return tx(function () {
+    var idx = -1;
+    S.cart.forEach(function (l, i) { if (l.sku === sku) idx = i; });
+    if (idx < 0) return fail('购物车中没有该商品：' + sku);
+    S.cart.splice(idx, 1);
+    return { ok: true };
+  });
+};
+
+Core.applyCoupon = function (code) {
+  return tx(function () {
+    if (code === null || code === undefined || code === '') { S.coupon = null; return { ok: true, coupon: null }; }
+    var c = findCoupon(code);
+    if (!c) return fail('优惠券不存在：' + code);
+    var q = quote(S.cart, S.isMember, null);
+    if (q.subtotal <= 0) return fail('购物车为空，无法使用优惠券');
+    if (q.subtotal < c.threshold) return fail('未满足使用条件：' + c.name + ' 需商品原价满 ' + fmt(c.threshold) + '，当前 ' + fmt(q.subtotal) + '，还差 ' + fmt(c.threshold - q.subtotal));
+    S.coupon = c.code;
+    return { ok: true, coupon: c.code };
+  });
+};
+
+Core.validateAddress = function (a) {
+  var errs = {};
+  if (!a || typeof a !== 'object') return { ok: false, errors: { name: '缺少收货信息' }, error: '缺少收货信息' };
+  var name = typeof a.name === 'string' ? a.name.trim() : '';
+  var phone = typeof a.phone === 'string' ? a.phone.trim() : (typeof a.phone === 'number' ? String(a.phone) : '');
+  var addr = typeof a.address === 'string' ? a.address.trim() : '';
+  if (!name) errs.name = '请填写收货人姓名';
+  else if (name.length > 20) errs.name = '姓名不超过 20 个字';
+  if (!phone) errs.phone = '请填写手机号';
+  else if (!/^1[3-9]\d{9}$/.test(phone)) errs.phone = '手机号应为 11 位数字，且以 13–19 开头';
+  if (!addr) errs.address = '请填写详细地址';
+  else if (addr.length < 2) errs.address = '地址过短';
+  else if (addr.length > 120) errs.address = '地址不超过 120 个字';
+  var keys = Object.keys(errs);
+  if (keys.length) return { ok: false, errors: errs, error: keys.map(function (k) { return errs[k]; }).join('；') };
+  return { ok: true, value: { name: name, phone: phone, address: addr } };
+};
+
+function genOrderId(createdAt) {
+  var ymd = dateKey(createdAt).replace(/-/g, '');
+  var id;
+  do { S.seq.order++; id = 'SO' + ymd + pad(S.seq.order, 4); } while (findOrder(id));
+  return id;
+}
+function genRefundId() {
+  var id;
+  do { S.seq.refund++; id = 'RF' + pad(S.seq.refund, 5); } while (findRefund(id));
+  return id;
+}
+
+/* 校验收货信息与库存、生成订单、占用库存（不含事务包装） */
+function opCreateOrder(lines, member, couponCode, address) {
+  var va = Core.validateAddress(address);
+  if (!va.ok) return fail('收货信息有误：' + va.error);
+  if (!lines.length) return fail('购物车为空');
+  for (var i = 0; i < lines.length; i++) {
+    var l = lines[i], f = findVariant(l.sku);
+    if (!f) return fail('商品规格不存在：' + l.sku);
+    if (!isPosInt(l.qty)) return fail('数量非法：' + l.sku);
