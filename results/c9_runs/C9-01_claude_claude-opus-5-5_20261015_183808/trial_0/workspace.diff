+    lines: q.lines.map(function (l) { return { sku: l.sku, name: l.name, spec: l.spec, qty: l.qty, unitPrice: toY(l.unitPrice), lineTotal: toY(l.lineTotal) }; }),
+    subtotal: toY(q.subtotal),
+    discounts: q.discounts.map(function (d) { return { type: d.type, amount: toY(d.amount), label: d.label }; }),
+    total: toY(q.total),
+    coupon: S.coupon,
+    couponValid: q.coupon ? q.coupon.ok : null
+  };
+}
+function wrap(fn) {
+  return function () {
+    var r = fn.apply(null, arguments);
+    try { render(); } catch (e) { /* ignore */ }
+    return clone(r);
+  };
+}
+window.shopTestAPI = {
+  reset: wrap(function () { doReset(); return { ok: true }; }),
+  getState: function () { return clone(apiState()); },
+  setMember: wrap(function (f) { return Core.setMember(f); }),
+  addToCart: wrap(function (sku, qty) { return Core.addToCart(sku, qty); }),
+  setCartQty: wrap(function (sku, qty) { return Core.setCartQty(sku, qty); }),
+  removeFromCart: wrap(function (sku) { return Core.removeFromCart(sku); }),
+  applyCoupon: wrap(function (code) { return Core.applyCoupon(code); }),
+  getCart: function () { return clone(apiCart()); },
+  checkout: wrap(function (addr) {
+    var r = Core.checkout(addr);
+    if (r.ok) { ui.co.session = null; if (ui.co.step === 'confirm') ui.co.step = 'address'; }
+    return r.ok ? { ok: true, orderId: r.orderId } : r;
+  }),
+  prepareCheckout: wrap(function (addr) {
+    var r = startConfirm(addr);
+    return r.ok ? { ok: true } : { ok: false, error: r.error };
+  }),
+  pay: wrap(function (id) { return Core.pay(id); }),
+  ship: wrap(function (id) { return Core.ship(id); }),
+  cancel: wrap(function (id) {
+    var r = Core.cancel(id);
+    if (r.ok && r.refundAmount !== undefined) r.refundAmount = toY(r.refundAmount);
+    return r;
+  }),
+  requestAfterSale: wrap(function (id, items, opts) {
+    var r = Core.requestAfterSale(id, items, opts);
+    return r.ok ? { ok: true, refundId: r.refundId, amount: toY(r.amount) } : r;
+  }),
+  confirmReturn: wrap(function (rid) { return Core.confirmReturn(rid); }),
+  queryOrders: function (f) { return clone(Core.queryOrders(f || {}).map(apiOrder)); },
+  getStats: function () {
+    var s = Core.stats(), u = {};
+    Object.keys(s.unitsSold).forEach(function (k) { u[k] = s.unitsSold[k]; });
+    return { sales: toY(s.sales), refunds: toY(s.refunds), net: toY(s.net), unitsSold: u };
+  },
+  exportData: function () { return Core.exportData(); },
+  importData: wrap(function (text) {
+    var r = Core.importData(text);
+    if (r.ok) { ui.selOrder = null; ui.co.session = null; ui.co.step = 'address'; }
+    return r.ok ? { ok: true } : { ok: false, error: r.error };
+  })
+};
+
+load();
+render();
+})();
+</script>
