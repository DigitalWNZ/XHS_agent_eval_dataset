+
+      window.updateAfterSalePreview = function () {
+        const order = state.orders.find(o => o.id === activeAfterSaleOrderId);
+        if (!order) return;
+        const inputs = document.querySelectorAll(".aftersale-qty-input");
+        const refundedMap = getAlreadyRefundedQtyMap(order);
+        const reqMap = {};
+        let hasAny = false;
+
+        inputs.forEach(inp => {
+          const sku = inp.getAttribute("data-aftersale-sku");
+          const qty = Math.max(0, Math.floor(Number(inp.value) || 0));
+          if (qty > 0) {
+            reqMap[sku] = qty;
+            hasAny = true;
+          }
+        });
+
+        const previewEl = document.getElementById("aftersale-preview-amount");
+        if (!previewEl) return;
+        if (!hasAny) {
+          previewEl.textContent = "¥0.00";
+          return;
+        }
+
+        let isAll = true;
+        for (const item of order.items) {
+          const prev = refundedMap[item.sku] || 0;
+          const cur = reqMap[item.sku] || 0;
+          if (prev + cur < item.qty) {
+            isAll = false;
+            break;
+          }
+        }
+
+        const remPayable = round2(Math.max(0, order.payable - order.refundedAmount));
+        let est = 0;
+        if (isAll) {
+          est = remPayable;
+        } else {
+          let origSum = 0;
+          for (const item of order.items) {
+            const cur = reqMap[item.sku] || 0;
+            origSum += cur * item.unitPrice;
+          }
+          est = Math.min(remPayable, round2((origSum * order.payable) / order.subtotal));
+        }
+        previewEl.textContent = `¥${est.toFixed(2)}`;
+      };
