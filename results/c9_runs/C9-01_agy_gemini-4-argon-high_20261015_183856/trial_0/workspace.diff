+          state.isMember = flag;
+          reconcileCartAndCoupon();
+          addLog("切换会员身份", flag ? "开启 VIP 会员身份 (享 9 折优惠)" : "切换为普通顾客身份");
+          saveState();
+          renderAll();
+          return { ok: true, isMember: state.isMember };
+        },
+
+        addToCart(sku, qty) {
+          if (typeof sku !== "string" || !sku.trim()) {
+            return { ok: false, error: "无效的商品 SKU" };
+          }
+          if (typeof qty !== "number" || !Number.isInteger(qty) || qty <= 0 || isNaN(qty)) {
+            return { ok: false, error: "加入购物车数量必须为正整数" };
+          }
+          const info = findVariantInfo(sku);
+          if (!info) {
+            return { ok: false, error: `商品规格不存在: ${sku}` };
+          }
+          if (info.variant.stock <= 0) {
+            return { ok: false, error: `商品 ${info.product.name} (${info.variant.spec}) 当前无库存` };
+          }
+          const existing = state.cart.find(c => c.sku === sku);
+          const currentQty = existing ? existing.qty : 0;
+          const targetQty = currentQty + qty;
+          if (targetQty > info.variant.stock) {
+            return {
+              ok: false,
+              error: `超出可用库存（当前库存 ${info.variant.stock} 件，购物车已有 ${currentQty} 件）`
+            };
+          }
+          if (existing) {
+            existing.qty = targetQty;
+          } else {
+            state.cart.push({ sku, qty });
+          }
+          reconcileCartAndCoupon();
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        setCartQty(sku, qty) {
+          if (typeof sku !== "string" || !sku.trim()) {
+            return { ok: false, error: "无效的商品 SKU" };
+          }
+          if (typeof qty !== "number" || !Number.isInteger(qty) || qty <= 0 || isNaN(qty)) {
+            return { ok: false, error: "商品数量必须为正整数" };
+          }
+          const existing = state.cart.find(c => c.sku === sku);
+          if (!existing) {
+            return { ok: false, error: "购物车中不存在该商品" };
+          }
+          const info = findVariantInfo(sku);
+          if (!info) {
+            return { ok: false, error: "商品规格不存在" };
+          }
+          if (info.variant.stock <= 0 || qty > info.variant.stock) {
+            return {
+              ok: false,
+              error: `修改数量失败：超出可用库存（当前可用 ${info.variant.stock} 件）`
+            };
+          }
+          existing.qty = qty;
+          reconcileCartAndCoupon();
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        removeFromCart(sku) {
+          const idx = state.cart.findIndex(c => c.sku === sku);
+          if (idx === -1) {
+            return { ok: false, error: "购物车中不存在该商品" };
+          }
+          state.cart.splice(idx, 1);
+          reconcileCartAndCoupon();
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        applyCoupon(code) {
+          if (code === null || code === undefined || code === "") {
+            state.appliedCoupon = null;
+            saveState();
+            renderAll();
+            return { ok: true };
+          }
+          if (typeof code !== "string") {
+            return { ok: false, error: "优惠券码格式无效" };
+          }
+          const trimmed = code.trim();
+          const coupon = state.coupons.find(c => c.code === trimmed);
+          if (!coupon) {
+            return { ok: false, error: `优惠券不存在: ${trimmed}` };
+          }
+          const subtotal = computeCartSubtotal();
+          if (subtotal <= 0 || subtotal < coupon.threshold) {
+            return {
+              ok: false,
+              error: `未达到该满减券使用门槛（需满 ¥${coupon.threshold}，当前原价合计 ¥${subtotal.toFixed(2)}）`
+            };
+          }
+          state.appliedCoupon = coupon.code;
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        getCart() {
+          reconcileCartAndCoupon();
+          const lines = [];
+          let subtotal = 0;
+
+          for (const item of state.cart) {
+            const info = findVariantInfo(item.sku);
+            if (!info) continue;
+            const unitPrice = round2(info.variant.price);
+            const lineTotal = round2(unitPrice * item.qty);
+            subtotal = round2(subtotal + lineTotal);
+            lines.push({
+              sku: item.sku,
+              qty: item.qty,
+              unitPrice,
+              lineTotal
+            });
+          }
+
+          const discounts = [];
+          if (state.isMember && subtotal > 0) {
+            const memberAmt = round2(subtotal * MEMBER_DISCOUNT_RATE);
+            if (memberAmt > 0) {
+              discounts.push({ type: "member", amount: memberAmt });
+            }
+          }
+
+          if (state.appliedCoupon && subtotal > 0) {
+            const coupon = state.coupons.find(c => c.code === state.appliedCoupon);
+            if (coupon && subtotal >= coupon.threshold) {
+              discounts.push({ type: "coupon", amount: round2(coupon.amount) });
+            } else {
+              state.appliedCoupon = null;
+            }
+          }
+
+          const discountTotal = round2(discounts.reduce((acc, d) => acc + d.amount, 0));
+          const total = round2(Math.max(0, subtotal - discountTotal));
+
+          return {
+            lines,
+            subtotal,
+            discounts,
+            total
+          };
+        },
+
+        prepareCheckout(address) {
+          if (state.cart.length === 0) {
+            return { ok: false, error: "购物车为空，无法进入结算确认" };
+          }
+          const addrValidation = validateAddress(address);
+          if (!addrValidation.ok) {
+            return addrValidation;
+          }
+          // Check stock for all lines
+          for (const item of state.cart) {
+            const info = findVariantInfo(item.sku);
+            if (!info || info.variant.stock < item.qty) {
+              return { ok: false, error: `商品 ${item.sku} 库存不足，无法结算` };
+            }
+          }
+
+          pendingCheckoutAddress = addrValidation.normalized;
+
+          // Sync UI inputs
+          const nameInput = document.getElementById("checkout-name");
+          const phoneInput = document.getElementById("checkout-phone");
+          const addrInput = document.getElementById("checkout-address");
+          if (nameInput) nameInput.value = pendingCheckoutAddress.name;
+          if (phoneInput) phoneInput.value = pendingCheckoutAddress.phone;
+          if (addrInput) addrInput.value = pendingCheckoutAddress.address;
+
+          openConfirmOrderModal(pendingCheckoutAddress);
+          return { ok: true };
+        },
+
+        checkout(address) {
+          if (state.cart.length === 0) {
+            return { ok: false, error: "购物车为空，不能创建订单" };
+          }
+          const addrValidation = validateAddress(address);
+          if (!addrValidation.ok) {
+            return addrValidation;
+          }
+          for (const item of state.cart) {
+            const info = findVariantInfo(item.sku);
+            if (!info) {
+              return { ok: false, error: `商品规格 ${item.sku} 不存在` };
+            }
+            if (info.variant.stock < item.qty) {
+              return {
+                ok: false,
+                error: `商品 ${info.product.name} (${info.variant.spec}) 库存不足`
+              };
+            }
+          }
+
+          const cartSnapshot = this.getCart();
+
+          // Deduct stock
+          for (const line of cartSnapshot.lines) {
+            const info = findVariantInfo(line.sku);
+            info.variant.stock -= line.qty;
+          }
+
+          const orderId = generateOrderId();
+          const newOrder = {
+            id: orderId,
+            status: "pending",
+            createdAt: new Date().toISOString(),
+            paidAt: null,
+            address: addrValidation.normalized,
+            items: cartSnapshot.lines.map(l => ({
+              sku: l.sku,
+              qty: l.qty,
+              unitPrice: round2(l.unitPrice)
+            })),
+            subtotal: round2(cartSnapshot.subtotal),
+            discounts: cartSnapshot.discounts.map(d => ({
+              type: d.type,
+              amount: round2(d.amount)
+            })),
+            payable: round2(cartSnapshot.total),
+            refundedAmount: 0,
+            refunds: []
+          };
+
+          state.orders.unshift(newOrder);
+          state.cart = [];
+          state.appliedCoupon = null;
+          pendingCheckoutAddress = null;
+
+          addLog(
+            "创建订单",
+            `生成订单 ${orderId}（实付 ¥${newOrder.payable.toFixed(2)}），已占用库存：${newOrder.items.map(i => `${i.sku}×${i.qty}`).join(", ")}`
+          );
+
+          saveState();
+          renderAll();
+          return { ok: true, orderId };
+        },
+
+        pay(orderId) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) {
+            return { ok: false, error: `订单不存在: ${orderId}` };
+          }
+          if (order.status !== "pending") {
+            return { ok: false, error: `当前订单状态 (${order.status}) 不可执行付款操作` };
+          }
+          order.status = "paid";
+          order.paidAt = new Date().toISOString();
+          addLog("订单付款", `订单 ${order.id} 已完成模拟付款 ¥${order.payable.toFixed(2)}`);
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        ship(orderId) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) {
+            return { ok: false, error: `订单不存在: ${orderId}` };
+          }
+          if (order.status !== "paid") {
+            return { ok: false, error: `仅已付款订单可执行发货，当前状态: ${order.status}` };
+          }
+          order.status = "shipped";
+          addLog("订单发货", `订单 ${order.id} 已出库发货`);
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        cancel(orderId) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) {
+            return { ok: false, error: `订单不存在: ${orderId}` };
+          }
+          if (order.status === "cancelled") {
+            return { ok: false, error: "订单已是取消状态，不能重复取消" };
+          }
+          if (order.status === "shipped") {
+            return { ok: false, error: "已发货订单不能直接取消，请走退货退款流程" };
+          }
+          if (order.status !== "pending" && order.status !== "paid") {
+            return { ok: false, error: `当前状态 (${order.status}) 不可取消` };
+          }
+
+          const wasPaid = order.status === "paid";
+
+          // Release stock for unshipped order
+          for (const item of order.items) {
+            const info = findVariantInfo(item.sku);
+            if (info) {
+              info.variant.stock += item.qty;
+            }
+          }
+
+          // If order was paid, automatically generate a refund record for remaining payable
+          if (wasPaid) {
+            const remAmount = round2(Math.max(0, order.payable - order.refundedAmount));
+            const refundedMap = getAlreadyRefundedQtyMap(order);
+            const remItems = [];
+            for (const item of order.items) {
+              const remQty = item.qty - (refundedMap[item.sku] || 0);
+              if (remQty > 0) {
+                remItems.push({ sku: item.sku, qty: remQty });
+              }
+            }
+            const refundId = generateRefundId();
+            order.refunds.push({
+              id: refundId,
+              items: remItems,
+              amount: remAmount,
+              returnGoods: false,
+              restocked: true
+            });
+            order.refundedAmount = round2(order.payable);
+            addLog(
+              "取消已付款订单",
+              `订单 ${order.id} 已取消，释放商品库存并自动产生退还剩余实付记录 ${refundId} (¥${remAmount.toFixed(2)})`
+            );
+          } else {
+            addLog(
+              "取消待付款订单",
+              `订单 ${order.id} 已取消，已释放占用库存`
+            );
+          }
+
+          order.status = "cancelled";
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        requestAfterSale(orderId, refundItems, options) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) {
+            return { ok: false, error: `订单不存在: ${orderId}` };
+          }
+          if (order.status !== "paid" && order.status !== "shipped") {
+            return { ok: false, error: `仅已付款或已发货订单可申请售后，当前状态: ${order.status}` };
+          }
+          if (!Array.isArray(refundItems) || refundItems.length === 0) {
+            return { ok: false, error: "请选择需要申请售后的商品及数量" };
+          }
+
+          // Aggregate and validate requested items
+          const reqMap = {};
+          const reqOrder = [];
+          for (const entry of refundItems) {
+            if (!entry || typeof entry.sku !== "string" || !entry.sku.trim()) {
+              return { ok: false, error: "售后商品 SKU 无效" };
+            }
+            if (typeof entry.qty !== "number" || !Number.isInteger(entry.qty) || entry.qty <= 0 || isNaN(entry.qty)) {
+              return { ok: false, error: "售后申请数量必须为正整数" };
+            }
+            if (!reqMap[entry.sku]) {
+              reqMap[entry.sku] = 0;
+              reqOrder.push(entry.sku);
+            }
+            reqMap[entry.sku] += entry.qty;
+          }
+
+          const alreadyRefundedMap = getAlreadyRefundedQtyMap(order);
+
+          for (const sku of reqOrder) {
+            const ordItem = order.items.find(i => i.sku === sku);
+            if (!ordItem) {
+              return { ok: false, error: `原订单不包含商品 ${sku}` };
+            }
+            const alreadyQty = alreadyRefundedMap[sku] || 0;
+            const maxRefundable = ordItem.qty - alreadyQty;
+            if (reqMap[sku] > maxRefundable) {
+              return {
+                ok: false,
+                error: `商品 ${sku} 申请售后数量 (${reqMap[sku]}) 超过剩余可退数量 (${maxRefundable})`
+              };
+            }
+          }
+
+          const remainingPayable = round2(order.payable - order.refundedAmount);
+          if (remainingPayable <= 0) {
+            return { ok: false, error: "该订单实付金额已全部退完，不可继续申请退款" };
+          }
+
+          // Check whether all items in the order will be completely refunded after this request
+          let isAllItemsRefunded = true;
+          for (const ordItem of order.items) {
+            const prevRefunded = alreadyRefundedMap[ordItem.sku] || 0;
+            const curReq = reqMap[ordItem.sku] || 0;
+            if (prevRefunded + curReq < ordItem.qty) {
+              isAllItemsRefunded = false;
+              break;
+            }
+          }
+
+          let refundAmount = 0;
+          if (isAllItemsRefunded) {
+            refundAmount = remainingPayable;
+          } else {
+            let requestedOriginalSum = 0;
+            for (const sku of reqOrder) {
+              const ordItem = order.items.find(i => i.sku === sku);
+              requestedOriginalSum += reqMap[sku] * ordItem.unitPrice;
+            }
+            refundAmount = round2((requestedOriginalSum * order.payable) / order.subtotal);
+            if (refundAmount > remainingPayable) {
+              refundAmount = remainingPayable;
+            }
+          }
+
+          const returnGoods = Boolean(options && options.returnGoods);
+          const refundId = generateRefundId();
+          const normalizedItems = reqOrder.map(sku => ({
+            sku,
+            qty: reqMap[sku]
+          }));
+
+          order.refunds.push({
+            id: refundId,
+            items: normalizedItems,
+            amount: refundAmount,
+            returnGoods,
+            restocked: false
+          });
+          order.refundedAmount = round2(order.refundedAmount + refundAmount);
+
+          addLog(
+            "申请售后退款",
+            `订单 ${order.id} 生成售后单 ${refundId} (${returnGoods ? "退货退款" : "仅退款"})，商品：${normalizedItems.map(i => `${i.sku}×${i.qty}`).join(", ")}，分摊退款 ¥${refundAmount.toFixed(2)}`
+          );
+
+          saveState();
+          renderAll();
+          return {
+            ok: true,
+            refundId,
+            amount: refundAmount
+          };
+        },
+
+        confirmReturn(refundId) {
+          if (typeof refundId !== "string" || !refundId.trim()) {
+            return { ok: false, error: "请提供有效的售后单号" };
+          }
+          let targetOrder = null;
+          let targetRefund = null;
+          for (const ord of state.orders) {
+            const found = ord.refunds.find(r => r.id === refundId);
+            if (found) {
+              targetOrder = ord;
+              targetRefund = found;
+              break;
+            }
+          }
+          if (!targetOrder || !targetRefund) {
+            return { ok: false, error: `未找到售后单: ${refundId}` };
+          }
+          if (targetOrder.status !== "shipped") {
+            return { ok: false, error: "仅已发货订单的退货售后单可执行确认退货入库" };
+          }
+          if (!targetRefund.returnGoods) {
+            return { ok: false, error: "该售后单为仅退款类型，无需退货入库" };
+          }
+          if (targetRefund.restocked) {
+            return { ok: false, error: `售后单 ${refundId} 已确认入库，不能重复回补库存` };
+          }
+
+          for (const item of targetRefund.items) {
+            const info = findVariantInfo(item.sku);
+            if (info) {
+              info.variant.stock += item.qty;
+            }
+          }
+          targetRefund.restocked = true;
+
+          addLog(
+            "确认退货入库",
+            `售后单 ${refundId} (所属订单 ${targetOrder.id}) 已确认收货入库，回补库存：${targetRefund.items.map(i => `${i.sku} +${i.qty}`).join(", ")}`
+          );
+
+          saveState();
+          renderAll();
+          return { ok: true };
+        },
+
+        queryOrders(filters = {}) {
+          const f = filters && typeof filters === "object" ? filters : {};
+          const orderIdQuery = typeof f.orderId === "string" ? f.orderId.trim().toLowerCase() : "";
+          const skuQuery = typeof f.sku === "string" ? f.sku.trim() : "";
+          const statusQuery = typeof f.status === "string" ? f.status.trim() : "";
+          const fromQuery = typeof f.from === "string" ? f.from.trim() : "";
+          const toQuery = typeof f.to === "string" ? f.to.trim() : "";
+
+          // Check if skuQuery is an exact SKU in our catalog
+          const isExactCatalogSku = skuQuery ? Boolean(findVariantInfo(skuQuery)) : false;
+
+          const matched = state.orders.filter(order => {
+            if (orderIdQuery) {
+              if (!order.id.toLowerCase().includes(orderIdQuery)) {
+                return false;
+              }
+            }
+            if (skuQuery) {
+              if (isExactCatalogSku) {
+                if (!order.items.some(i => i.sku === skuQuery)) {
+                  return false;
+                }
+              } else {
+                const qLower = skuQuery.toLowerCase();
+                const hasMatch = order.items.some(i => {
+                  if (i.sku.toLowerCase().includes(qLower)) return true;
+                  const info = findVariantInfo(i.sku);
+                  if (info && (info.product.name.toLowerCase().includes(qLower) || info.variant.spec.toLowerCase().includes(qLower))) {
+                    return true;
+                  }
+                  return false;
+                });
+                if (!hasMatch) return false;
+              }
+            }
+            if (statusQuery) {
+              if (order.status !== statusQuery) {
+                return false;
+              }
+            }
+            if (fromQuery || toQuery) {
+              const orderDate = new Date(order.createdAt).toISOString().slice(0, 10);
+              if (fromQuery && orderDate < fromQuery.slice(0, 10)) {
+                return false;
+              }
+              if (toQuery && orderDate > toQuery.slice(0, 10)) {
+                return false;
+              }
+            }
+            return true;
+          });
+
+          return deepClone(matched.map(o => ({
+            id: o.id,
+            status: o.status,
+            createdAt: o.createdAt,
+            paidAt: o.paidAt,
+            address: o.address ? deepClone(o.address) : undefined,
+            items: o.items.map(i => ({
+              sku: i.sku,
+              qty: i.qty,
+              unitPrice: round2(i.unitPrice)
+            })),
+            subtotal: round2(o.subtotal),
+            discounts: o.discounts.map(d => ({
+              type: d.type,
+              amount: round2(d.amount)
+            })),
+            payable: round2(o.payable),
+            refundedAmount: round2(o.refundedAmount),
+            refunds: o.refunds.map(r => ({
+              id: r.id,
+              items: r.items.map(ri => ({ sku: ri.sku, qty: ri.qty })),
+              amount: round2(r.amount),
+              returnGoods: Boolean(r.returnGoods),
+              restocked: Boolean(r.restocked)
+            }))
+          })));
+        },
+
+        getStats() {
+          let sales = 0;
+          let refunds = 0;
+          const unitsSold = {};
+
+          // Initialize all known SKUs to 0
+          for (const prod of state.products) {
+            for (const v of prod.variants) {
+              unitsSold[v.sku] = 0;
+            }
+          }
+
+          for (const order of state.orders) {
+            for (const rf of order.refunds) {
+              refunds = round2(refunds + rf.amount);
+            }
+
+            if (order.paidAt) {
+              sales = round2(sales + order.payable);
+              for (const item of order.items) {
+                unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+              }
+              for (const rf of order.refunds) {
+                for (const ri of rf.items) {
+                  unitsSold[ri.sku] = (unitsSold[ri.sku] || 0) - ri.qty;
+                }
+              }
+            }
+          }
+
+          const net = round2(sales - refunds);
+          return {
+            sales: round2(sales),
+            refunds: round2(refunds),
+            net,
+            unitsSold
+          };
+        },
+
+        exportData() {
+          return JSON.stringify(
+            {
+              products: state.products,
+              coupons: state.coupons,
+              isMember: state.isMember,
