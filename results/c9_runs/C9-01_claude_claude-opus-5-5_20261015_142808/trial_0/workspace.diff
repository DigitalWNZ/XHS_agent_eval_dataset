+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>潮玩小站 · 店员工作台</title>
+<style>
+:root{
+  --bg:#f4f5f7;--panel:#fff;--line:#e3e5e8;--text:#1d1f23;--sub:#5b6068;--muted:#8a9099;
+  --brand:#2a78d6;--brand-weak:#e8f1fc;--ok:#1a8a4a;--ok-weak:#e6f5ec;--warn:#b26b00;--warn-weak:#fff4e0;
+  --danger:#c8352b;--danger-weak:#fdecea;--gray-weak:#eef0f2;--purple:#6250d6;--purple-weak:#efedfc;
+}
+*{box-sizing:border-box}
+html,body{margin:0;height:100%}
+body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.5}
+button{font:inherit;cursor:pointer;border:1px solid var(--line);background:#fff;border-radius:6px;padding:5px 12px;color:var(--text)}
+button:hover:not(:disabled){border-color:var(--brand);color:var(--brand)}
+button:disabled{opacity:.45;cursor:not-allowed}
+button.primary{background:var(--brand);border-color:var(--brand);color:#fff}
+button.primary:hover:not(:disabled){background:#1f63b5;color:#fff}
+button.danger{background:#fff;border-color:var(--danger);color:var(--danger)}
+button.danger:hover:not(:disabled){background:var(--danger);color:#fff}
+button.danger.solid{background:var(--danger);color:#fff}
+button.sm{padding:2px 8px;font-size:12px}
+input,select,textarea{font:inherit;border:1px solid var(--line);border-radius:6px;padding:5px 8px;background:#fff;color:var(--text)}
+input:focus,select:focus,textarea:focus{outline:2px solid var(--brand-weak);border-color:var(--brand)}
+input.bad,textarea.bad{border-color:var(--danger);background:var(--danger-weak)}
+.app{display:flex;min-height:100vh}
+nav.side{width:180px;background:#1d2733;color:#cfd6df;flex-shrink:0;display:flex;flex-direction:column}
+nav.side .logo{padding:18px 16px;font-size:17px;font-weight:700;color:#fff;border-bottom:1px solid #2c3846}
+nav.side .logo small{display:block;font-size:12px;color:#8fa0b3;font-weight:400}
+nav.side a{display:block;padding:11px 18px;color:#cfd6df;text-decoration:none;cursor:pointer;border-left:3px solid transparent}
+nav.side a:hover{background:#26323f}
