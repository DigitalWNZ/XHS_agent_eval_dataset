+nav.side .badge{float:right;background:var(--danger);color:#fff;border-radius:9px;font-size:11px;padding:0 6px;margin-top:2px}
+main{flex:1;min-width:0;display:flex;flex-direction:column}
+header.top{background:#fff;border-bottom:1px solid var(--line);padding:10px 20px;display:flex;align-items:center;gap:16px}
+header.top h1{font-size:17px;margin:0;flex:1}
+.member-switch{display:flex;align-items:center;gap:8px;padding:4px 10px;border:1px solid var(--line);border-radius:20px;cursor:pointer;user-select:none}
+.member-switch.on{background:var(--purple-weak);border-color:var(--purple);color:var(--purple)}
+.toggle{width:34px;height:18px;border-radius:9px;background:#c6cad0;position:relative;transition:.15s}
+.toggle::after{content:"";position:absolute;width:14px;height:14px;border-radius:50%;background:#fff;left:2px;top:2px;transition:.15s}
+.on .toggle{background:var(--purple)}
+.on .toggle::after{left:18px}
+.content{padding:16px 20px;flex:1}
+.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:14px}
+.panel h2{font-size:15px;margin:0 0 10px;display:flex;align-items:center;gap:8px}
+.panel h2 .hint{font-weight:400;font-size:12px;color:var(--muted)}
+.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.sell-layout{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:14px;align-items:start}
+.cart-col{position:sticky;top:12px}
+.chips{display:flex;gap:6px;flex-wrap:wrap}
+.chip{padding:3px 12px;border-radius:14px;border:1px solid var(--line);background:#fff;cursor:pointer;font-size:13px}
+.chip.active{background:var(--brand);border-color:var(--brand);color:#fff}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
+.card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:8px}
+.card .thumb{height:70px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:38px}
+.card .name{font-weight:600}
+.card .meta{font-size:12px;color:var(--muted)}
+.variants{display:flex;flex-wrap:wrap;gap:6px}
+.variant{border:1px solid var(--line);border-radius:6px;padding:3px 8px;font-size:12px;cursor:pointer;background:#fff;text-align:left}
+.variant.sel{border-color:var(--brand);background:var(--brand-weak);color:var(--brand)}
+.variant.out{color:var(--muted);background:var(--gray-weak);text-decoration:line-through}
+.price{color:var(--danger);font-weight:700;font-size:16px}
+.stock-tag{font-size:12px}
+.stock-low{color:var(--warn)}
+.stock-out{color:var(--danger)}
+.qty{width:64px;text-align:center}
+.cart-line{display:grid;grid-template-columns:1fr auto;gap:4px 8px;padding:8px 0;border-bottom:1px dashed var(--line)}
+.cart-line .t{font-weight:600;font-size:13px}
+.cart-line .s{font-size:12px;color:var(--muted)}
+.cart-line .warn{grid-column:1/-1;font-size:12px;color:var(--danger)}
+.stepper{display:flex;align-items:center;gap:2px}
+.stepper button{padding:0 8px;height:26px}
+.stepper input{width:48px;height:26px;text-align:center;padding:0}
+.money-table{width:100%;border-collapse:collapse;font-size:13px}
+.money-table td{padding:3px 0}
+.money-table td:last-child{text-align:right;font-variant-numeric:tabular-nums}
+.money-table tr.total td{border-top:1px solid var(--line);padding-top:8px;font-size:16px;font-weight:700}
+.money-table tr.total td:last-child{color:var(--danger)}
+.money-table tr.disc td:last-child{color:var(--ok)}
+.coupon{border:1px dashed var(--line);border-radius:8px;padding:6px 10px;margin-bottom:6px;display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px}
+.coupon .amt{color:var(--danger);font-weight:700;min-width:54px}
+.coupon.sel{border-style:solid;border-color:var(--danger);background:var(--danger-weak)}
+.coupon.na{opacity:.6;cursor:not-allowed}
+.coupon .cond{font-size:12px;color:var(--muted);flex:1}
+.notice{font-size:12px;border-radius:6px;padding:6px 10px;margin:6px 0}
+.notice.info{background:var(--brand-weak);color:#1f4f8a}
+.notice.warn{background:var(--warn-weak);color:var(--warn)}
+.notice.err{background:var(--danger-weak);color:var(--danger)}
+.notice.ok{background:var(--ok-weak);color:var(--ok)}
+table.list{width:100%;border-collapse:collapse;font-size:13px}
+table.list th{text-align:left;font-weight:600;color:var(--sub);background:#fafbfc;border-bottom:1px solid var(--line);padding:7px 8px;white-space:nowrap}
+table.list td{border-bottom:1px solid var(--line);padding:7px 8px;vertical-align:top}
+table.list tr.click{cursor:pointer}
+table.list tr.click:hover td{background:#f7faff}
+table.list tr.sel td{background:var(--brand-weak)}
+.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
+.st{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;white-space:nowrap}
+.st.pending{background:var(--warn-weak);color:var(--warn)}
+.st.paid{background:var(--brand-weak);color:var(--brand)}
+.st.shipped{background:var(--ok-weak);color:var(--ok)}
+.st.cancelled{background:var(--gray-weak);color:var(--sub)}
+.st.refund{background:var(--danger-weak);color:var(--danger)}
+.st.purple{background:var(--purple-weak);color:var(--purple)}
+.orders-layout{display:grid;grid-template-columns:minmax(0,1fr) 460px;gap:14px;align-items:start}
+.kv{display:grid;grid-template-columns:84px 1fr;gap:3px 10px;font-size:13px}
+.kv .k{color:var(--muted)}
+.timeline{list-style:none;padding:0;margin:0;font-size:12px}
+.timeline li{padding:3px 0 3px 14px;border-left:2px solid var(--line);position:relative}
+.timeline li::before{content:"";position:absolute;left:-5px;top:8px;width:8px;height:8px;border-radius:50%;background:var(--brand)}
+.timeline .tm{color:var(--muted);margin-right:6px}
+.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:14px}
+.tile{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px 16px}
+.tile .l{color:var(--sub);font-size:13px}
+.tile .v{font-size:24px;font-weight:700;font-variant-numeric:tabular-nums;margin-top:2px}
+.tile .d{font-size:12px;color:var(--muted)}
+.bar{height:10px;background:var(--brand);border-radius:0 4px 4px 0;min-width:2px}
+.bar-wrap{background:transparent;width:100%}
+.overlay{position:fixed;inset:0;background:rgba(20,25,32,.45);display:flex;align-items:center;justify-content:center;z-index:50}
+.overlay.dlg{z-index:80}
+.modal{background:#fff;border-radius:12px;width:min(620px,94vw);max-height:90vh;overflow:auto;padding:18px 20px;box-shadow:0 10px 40px rgba(0,0,0,.2)}
+.modal h3{margin:0 0 12px;font-size:16px}
+.modal .foot{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
+.steps{display:flex;gap:6px;margin-bottom:12px;font-size:12px}
+.steps span{flex:1;text-align:center;padding:4px;border-radius:4px;background:var(--gray-weak);color:var(--muted)}
+.steps span.on{background:var(--brand);color:#fff}
+.form-row{display:grid;grid-template-columns:80px 1fr;gap:8px;align-items:start;margin-bottom:10px}
+.form-row label{padding-top:6px;color:var(--sub)}
+.form-row .err{color:var(--danger);font-size:12px;margin-top:2px}
+.toasts{position:fixed;bottom:16px;right:16px;z-index:100;display:flex;flex-direction:column;gap:8px}
+.toast{padding:9px 14px;border-radius:8px;color:#fff;font-size:13px;box-shadow:0 4px 14px rgba(0,0,0,.18);max-width:360px}
+.toast.ok{background:var(--ok)}.toast.err{background:var(--danger)}.toast.info{background:#334}
+.empty{color:var(--muted);text-align:center;padding:24px 0;font-size:13px}
+.muted{color:var(--muted)}.small{font-size:12px}
+.mono{font-family:ui-monospace,Menlo,Consolas,monospace}
+textarea.io{width:100%;min-height:140px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
+.as-table input{width:60px}
+@media (max-width:1100px){.sell-layout,.orders-layout{grid-template-columns:1fr}.cart-col{position:static}}
+</style>
+</head>
+<body>
+<div class="app">
+  <nav class="side">
+    <div class="logo">🧸 潮玩小站<small>店员工作台</small></div>
+    <a data-act="nav" data-view="sell">🛒 销售台</a>
+    <a data-act="nav" data-view="orders">📋 订单管理 <span class="badge" id="badgePending"></span></a>
+    <a data-act="nav" data-view="aftersale">↩️ 售后中心 <span class="badge" id="badgeReturn"></span></a>
+    <a data-act="nav" data-view="stats">📈 经营统计</a>
+    <a data-act="nav" data-view="logs">🗒️ 操作记录</a>
+    <a data-act="nav" data-view="data">💾 数据备份</a>
+  </nav>
+  <main>
+    <header class="top">
+      <h1 id="viewTitle">销售台</h1>
+      <span class="small muted" id="saveState"></span>
+      <div class="member-switch" id="memberSwitch" data-act="toggleMember" title="切换当前顾客的会员身份">
+        <span class="toggle"></span><span id="memberLabel">非会员顾客</span>
+      </div>
+    </header>
+    <div class="content" id="view"></div>
+  </main>
+</div>
+<div id="checkoutHost"></div>
+<div id="dlgHost"></div>
+<div class="toasts" id="toasts"></div>
+
+<script>
+(function(){
+'use strict';
+/* =====================================================================
+ * 业务核心（界面与 shopTestAPI 共用）。金额内部一律以“分”为整数存储。
+ * ===================================================================== */
+var STORAGE_KEY = 'toyshop.workbench.v1';
+var MEMBER_OFF_PERCENT = 5;          // 会员 95 折
+var MEMBER_LABEL = '会员 95 折';
+var STATUS_TEXT = {pending:'待付款', paid:'已付款', shipped:'已发货', cancelled:'已取消'};
+var state = null;
+var clockOverride = null;           // 仅用于构造历史数据
+
+function nowISO(){ return (clockOverride ? new Date(clockOverride) : new Date()).toISOString(); }
+function yuan(c){ return Number((Math.round(c)/100).toFixed(2)); }
+function cents(y){ return Math.round(Number(y)*100); }
+function fmt(c){ var neg = c<0; c=Math.abs(Math.round(c)); return (neg?'-':'')+'¥'+(c/100).toFixed(2); }
+function ok(o){ var r={ok:true}; if(o) for(var k in o) r[k]=o[k]; return r; }
+function fail(msg){ return {ok:false, error:msg}; }
+function toInt(v){
+  if(typeof v==='number') return Number.isInteger(v)?v:NaN;
+  if(typeof v==='string' && /^\s*-?\d+\s*$/.test(v)) return parseInt(v,10);
+  return NaN;
+}
+function clone(o){ return JSON.parse(JSON.stringify(o)); }
+function localDate(iso){
+  var d=new Date(iso); if(isNaN(d)) return '';
+  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
+}
+function fmtTime(iso){
+  if(!iso) return '—';
+  var d=new Date(iso); if(isNaN(d)) return String(iso);
+  return localDate(iso)+' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')+':'+String(d.getSeconds()).padStart(2,'0');
+}
+
+function findVariant(sku, st){
+  st = st||state;
+  for(var i=0;i<st.products.length;i++){
+    var p=st.products[i];
+    for(var j=0;j<p.variants.length;j++) if(p.variants[j].sku===sku) return {product:p, variant:p.variants[j]};
+  }
+  return null;
+}
+function skuLabel(sku){
+  var f=findVariant(sku); return f ? f.product.name+'（'+f.variant.spec+'）' : sku;
+}
+function log(action, detail, orderId){
+  var e={time:nowISO(), action:action, detail:detail};
+  if(orderId) e.orderId=orderId;
+  state.logs.push(e);
+  if(orderId){ var o=getOrder(orderId); if(o) o.history.push({time:e.time, action:action, detail:detail}); }
+}
+function getOrder(id){ for(var i=0;i<state.orders.length;i++) if(state.orders[i].id===id) return state.orders[i]; return null; }
+function findRefund(rid){
+  for(var i=0;i<state.orders.length;i++){
+    var o=state.orders[i];
+    for(var j=0;j<o.refunds.length;j++) if(o.refunds[j].id===rid) return {order:o, refund:o.refunds[j]};
+  }
+  return null;
+}
+function genId(prefix, existsFn){
+  var d=new Date(nowISO());
+  var ds=d.getFullYear()+String(d.getMonth()+1).padStart(2,'0')+String(d.getDate()).padStart(2,'0');
+  var id;
+  do { state.seq += 1; id = prefix+ds+String(state.seq).padStart(4,'0'); } while(existsFn(id));
+  return id;
+}
+
+/* ---------- 优惠计算 ----------
+ * 规则：会员 95 折按商品原价合计计算（四舍五入到分）；满减券门槛按商品原价合计判断；
+ * 两者可叠加，每单最多 1 张券；应付 = 原价合计 − 会员折扣 − 满减券。 */
+function pricing(lines, isMember, couponCode){
+  var subtotal=0;
+  lines.forEach(function(l){ subtotal += l.qty*l.unitPrice; });
+  var discounts=[], couponInfo=null;
+  if(subtotal>0 && isMember){
+    var m=Math.round(subtotal*MEMBER_OFF_PERCENT/100);
+    if(m>0) discounts.push({type:'member', amount:m, label:MEMBER_LABEL});
+  }
+  if(couponCode){
+    var c=null; state.coupons.forEach(function(x){ if(x.code===couponCode) c=x; });
+    if(!c) couponInfo={code:couponCode, valid:false, reason:'优惠券不存在'};
+    else if(subtotal<=0) couponInfo={code:c.code, valid:false, reason:'购物车为空'};
+    else if(subtotal<c.threshold) couponInfo={code:c.code, valid:false, reason:'未满 '+fmt(c.threshold)+'，还差 '+fmt(c.threshold-subtotal)};
+    else {
+      var used=discounts.reduce(function(s,d){return s+d.amount;},0);
+      var a=Math.min(c.amount, subtotal-used);
+      discounts.push({type:'coupon', amount:a, label:'满'+(c.threshold/100)+'减'+(c.amount/100)+'（'+c.code+'）', code:c.code});
+      couponInfo={code:c.code, valid:true};
+    }
+  }
+  var total=subtotal-discounts.reduce(function(s,d){return s+d.amount;},0);
+  return {subtotal:subtotal, discounts:discounts, total:total, coupon:couponInfo};
+}
+function cartLines(){
+  var out=[];
+  state.cart.forEach(function(l){
+    var f=findVariant(l.sku); if(!f) return;
+    out.push({sku:l.sku, qty:l.qty, unitPrice:f.variant.price, lineTotal:l.qty*f.variant.price,
+      name:f.product.name, spec:f.variant.spec, stock:f.variant.stock, emoji:f.product.emoji});
+  });
+  return out;
+}
+function cartPricing(){ return pricing(cartLines(), state.isMember, state.couponCode); }
+
+/* ---------- 购物车 ---------- */
+function coreSetMember(v){
+  state.isMember = !!v;
+  log('会员身份', state.isMember ? '当前顾客设为会员（95 折）' : '当前顾客设为非会员');
+  return ok({isMember:state.isMember});
+}
+function coreAddToCart(sku, qty){
+  var q=toInt(qty);
+  if(!(q>0)) return fail('数量必须为正整数');
+  if(q>999) return fail('单次数量过大');
+  var f=findVariant(sku); if(!f) return fail('商品规格不存在：'+sku);
+  if(f.variant.stock<=0) return fail('该规格已售罄，无法加入购物车');
+  var line=null; state.cart.forEach(function(l){ if(l.sku===sku) line=l; });
+  var cur=line?line.qty:0;
+  if(cur+q>f.variant.stock) return fail('库存不足：可售 '+f.variant.stock+' 件，购物车已有 '+cur+' 件');
+  if(line) line.qty+=q; else state.cart.push({sku:sku, qty:q});
+  return ok({qty:cur+q});
+}
+function coreSetCartQty(sku, qty){
+  var q=toInt(qty);
+  var line=null; state.cart.forEach(function(l){ if(l.sku===sku) line=l; });
+  if(!line) return fail('购物车中没有该商品');
+  if(!(q>0)) return fail('数量必须为正整数（如需删除请点“移除”）');
+  var f=findVariant(sku); if(!f) return fail('商品规格不存在');
+  if(q>f.variant.stock) return fail('超出库存：可售 '+f.variant.stock+' 件');
+  line.qty=q;
+  return ok({qty:q});
+}
+function coreRemoveFromCart(sku){
+  var idx=-1; state.cart.forEach(function(l,i){ if(l.sku===sku) idx=i; });
+  if(idx<0) return fail('购物车中没有该商品');
+  state.cart.splice(idx,1);
+  if(!state.cart.length) state.couponCode=null;
+  return ok();
+}
+function coreApplyCoupon(code){
+  if(code===null || code===undefined || code===''){ state.couponCode=null; return ok({coupon:null}); }
+  var c=null; state.coupons.forEach(function(x){ if(x.code===code) c=x; });
+  if(!c) return fail('优惠券不存在：'+code);
+  var p=pricing(cartLines(), state.isMember, null);
+  if(p.subtotal<=0) return fail('购物车为空，无法使用优惠券');
+  if(p.subtotal<c.threshold) return fail('未达到使用门槛：需满 '+fmt(c.threshold)+'，当前原价合计 '+fmt(p.subtotal));
+  state.couponCode=c.code;
+  return ok({coupon:c.code});
+}
+
+/* ---------- 结算 ---------- */
+function validateAddress(a){
+  var errs={};
+  a=a||{};
+  var name=String(a.name==null?'':a.name).trim(), phone=String(a.phone==null?'':a.phone).trim(), addr=String(a.address==null?'':a.address).trim();
+  if(!name) errs.name='请填写收货人'; else if(name.length>20) errs.name='收货人不超过 20 个字';
+  if(!/^1\d{10}$/.test(phone)) errs.phone='请填写 11 位手机号（1 开头）';
+  if(!addr) errs.address='请填写收货地址'; else if(addr.length<2) errs.address='收货地址过短';
+  return {errors:errs, valid:Object.keys(errs).length===0, value:{name:name, phone:phone, address:addr}};
+}
+function validateCartForCheckout(){
+  var lines=cartLines();
+  if(!lines.length) return '购物车为空';
+  if(lines.length!==state.cart.length) return '购物车中有已下架的商品，请移除';
