+  var merged={}, order=[];
+  for(var i=0;i<items.length;i++){
+    var it=items[i]||{}; var q=toInt(it.qty);
+    if(!(q>0)) return fail('售后数量必须为正整数');
+    var line=null; o.items.forEach(function(x){ if(x.sku===it.sku) line=x; });
+    if(!line) return fail('订单中没有该商品：'+it.sku);
+    if(!(it.sku in merged)){ merged[it.sku]=0; order.push(it.sku); }
