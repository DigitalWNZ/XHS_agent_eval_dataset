+    function calculateCartDiscounts(subtotal) {
+      const discounts = [];
+      // 1. Member discount: fixed ratio, applicable to any non-empty cart
+      if (state.isMember && subtotal > 0) {
+        const memberDiscountAmount = round2(subtotal * MEMBER_DISCOUNT_RATE);
+        discounts.push({ type: "member", amount: memberDiscountAmount });
