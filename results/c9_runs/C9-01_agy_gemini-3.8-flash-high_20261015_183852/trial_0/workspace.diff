+        state.cart.push({ sku, qty: count, unitPrice: variant.price });
+      }
+
+      // Re-evaluate discounts
+      getCartLogic();
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function setCartQtyLogic(sku, qty) {
