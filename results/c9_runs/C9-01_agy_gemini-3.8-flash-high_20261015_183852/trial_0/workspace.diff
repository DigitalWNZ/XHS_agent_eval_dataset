+    }
+
+    function handleFileImport(input) {
+      const file = input.files[0];
+      if (!file) return;
+      const reader = new FileReader();
+      reader.onload = function(e) {
+        const text = e.target.result;
+        const res = importDataLogic(text);
+        if (res.ok) {
+          showToast("备份数据导入成功！", "success");
+        } else {
+          showToast(`导入失败: ${res.error}`, "error");
+        }
+        input.value = "";
+      };
+      reader.readAsText(file);
+    }
+
+    function openPasteImportModal() {
+      document.getElementById("pasteImportTextarea").value = "";
+      document.getElementById("pasteImportModal").style.display = "flex";
+    }
+
+    function closePasteImportModal() {
+      document.getElementById("pasteImportModal").style.display = "none";
+    }
+
+    function executePasteImport() {
+      const text = document.getElementById("pasteImportTextarea").value.trim();
+      if (!text) {
+        showToast("请输入要导入的 JSON 内容", "error");
+        return;
+      }
+      const res = importDataLogic(text);
+      if (res.ok) {
+        closePasteImportModal();
+        showToast("备份数据导入成功！", "success");
+      } else {
+        showToast(`导入失败: ${res.error}`, "error");
+      }
+    }
+
+    // Modal Helpers
+    let actionModalCallback = null;
+    function openActionConfirmModal(title, message, callback) {
+      document.getElementById("actionModalTitle").innerText = title;
+      document.getElementById("actionModalMessage").innerHTML = message;
+      actionModalCallback = callback;
+      document.getElementById("actionConfirmModal").style.display = "flex";
