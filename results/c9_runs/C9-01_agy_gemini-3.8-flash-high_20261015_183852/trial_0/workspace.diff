+      if (order.status === "cancelled") return { ok: false, error: "订单已取消，不能重复取消" };
+      if (order.status === "shipped") return { ok: false, error: "已发货订单不可直接取消，请走售后退款/退货流程" };
+
+      if (order.status === "pending") {
+        // Release stock
+        for (const item of order.items) {
+          for (const prod of state.products) {
+            const v = prod.variants.find(it => it.sku === item.sku);
+            if (v) {
+              v.stock += item.qty;
+              break;
+            }
+          }
+        }
+        order.status = "cancelled";
+        addLog("取消订单", `未付款订单 ${orderId} 已取消，库存已自动回补`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      }
+
+      if (order.status === "paid") {
+        // Paid unshipped order cancellation
+        // 1. Release remaining stock
+        const refundedMap = getOrderRefundedQtyMap(order);
+        for (const item of order.items) {
+          const remainingQty = item.qty - (refundedMap[item.sku] || 0);
+          if (remainingQty > 0) {
+            for (const prod of state.products) {
+              const v = prod.variants.find(it => it.sku === item.sku);
+              if (v) {
+                v.stock += remainingQty;
+                break;
+              }
+            }
+          }
+        }
+
+        // 2. Full remaining payable refund
+        const refundAmount = round2(order.payable - order.refundedAmount);
+        const refundItems = order.items
+          .map(it => ({ sku: it.sku, qty: it.qty - (refundedMap[it.sku] || 0) }))
+          .filter(it => it.qty > 0);
+
+        const refundId = "RF-" + new Date().toISOString().replace(/[-:T.Z]/g, "").slice(0, 14) + "-" + Math.floor(100 + Math.random() * 900);
+
+        order.refunds.push({
+          id: refundId,
+          items: refundItems,
+          amount: refundAmount,
+          returnGoods: false,
+          restocked: true
+        });
+        order.refundedAmount = order.payable;
+        order.status = "cancelled";
+
+        addLog("取消订单", `已付款订单 ${orderId} 取消成功，退款 ￥${refundAmount} 并释放剩余库存`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      }
+
+      return { ok: false, error: `不支持的状态取消: ${order.status}` };
+    }
+
+    function calculateRefundAmountLogic(order, requestedItems) {
+      const currentRefundedMap = getOrderRefundedQtyMap(order);
+      const afterRefundedMap = { ...currentRefundedMap };
+      for (const req of requestedItems) {
+        afterRefundedMap[req.sku] = (afterRefundedMap[req.sku] || 0) + req.qty;
+      }
+
+      // Check if all items in order are completely refunded after this
+      let allItemsRefunded = true;
+      for (const orig of order.items) {
+        if ((afterRefundedMap[orig.sku] || 0) < orig.qty) {
+          allItemsRefunded = false;
+          break;
+        }
+      }
+
+      if (allItemsRefunded) {
+        // Last refund covers exact remaining payable
+        return round2(order.payable - order.refundedAmount);
+      }
+
+      // Proportional calculation: Σ 数量 × 单价 × 实付 ÷ 商品原价合计
+      let sum = 0;
+      for (const req of requestedItems) {
+        const orig = order.items.find(i => i.sku === req.sku);
+        if (orig) {
+          sum += req.qty * orig.unitPrice * order.payable / order.subtotal;
+        }
+      }
+      let amt = round2(sum);
+      const remainingPayable = round2(order.payable - order.refundedAmount);
+      if (amt > remainingPayable) {
+        amt = remainingPayable;
+      }
+      return amt;
+    }
+
+    function requestAfterSaleLogic(orderId, items, options) {
+      const returnGoods = options && options.returnGoods === true;
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) return { ok: false, error: "订单不存在" };
+      if (order.status !== "paid" && order.status !== "shipped") {
+        return { ok: false, error: `订单当前状态(${order.status})不可申请售后` };
+      }
+      if (!Array.isArray(items) || items.length === 0) {
+        return { ok: false, error: "售后申请商品列表不能为空" };
+      }
+
+      const refundedMap = getOrderRefundedQtyMap(order);
+
+      // Validate quantities
+      for (const req of items) {
+        if (!req.sku || !Number.isInteger(req.qty) || req.qty <= 0) {
+          return { ok: false, error: "售后数量必须为大于0的整数" };
+        }
+        const orig = order.items.find(i => i.sku === req.sku);
+        if (!orig) {
+          return { ok: false, error: `SKU ${req.sku} 不在原订单商品中` };
+        }
+        const alreadyRefunded = refundedMap[req.sku] || 0;
+        const available = orig.qty - alreadyRefunded;
+        if (req.qty > available) {
+          return { ok: false, error: `SKU ${req.sku} 申请退款数量(${req.qty})超出可退数量(${available})` };
+        }
+      }
+
+      const amount = calculateRefundAmountLogic(order, items);
+
+      // Restock rules:
+      // If shipped: never restock upon refund application; only restock upon confirmReturn!
+      // If paid (unshipped): goods never left warehouse, so restock is immediate.
+      let restocked = false;
+      if (order.status === "paid") {
+        restocked = true;
+        for (const req of items) {
+          for (const prod of state.products) {
+            const v = prod.variants.find(it => it.sku === req.sku);
+            if (v) {
+              v.stock += req.qty;
+              break;
+            }
+          }
+        }
+      } else {
+        restocked = false;
+      }
+
+      const refundId = "RF-" + new Date().toISOString().replace(/[-:T.Z]/g, "").slice(0, 14) + "-" + Math.floor(100 + Math.random() * 900);
+      const refundRecord = {
+        id: refundId,
+        items: items.map(i => ({ sku: i.sku, qty: i.qty })),
+        amount: amount,
+        returnGoods: returnGoods,
+        restocked: restocked
+      };
+
+      order.refunds.push(refundRecord);
+      order.refundedAmount = round2(order.refundedAmount + amount);
+
+      addLog("售后退款", `订单 ${orderId} 售后单 ${refundId} 申请成功，退款 ￥${amount} (退货入库: ${returnGoods ? "是" : "否"})`);
+
+      saveState();
+      renderAll();
+      return { ok: true, refundId, amount };
+    }
+
+    function confirmReturnLogic(refundId) {
+      let targetOrder = null;
+      let targetRefund = null;
+
+      for (const ord of state.orders) {
+        const ref = (ord.refunds || []).find(r => r.id === refundId);
+        if (ref) {
+          targetOrder = ord;
+          targetRefund = ref;
+          break;
+        }
+      }
+
+      if (!targetRefund) return { ok: false, error: "售后记录不存在" };
+      if (targetRefund.restocked) return { ok: false, error: "该售后单已入库，不可重复入库" };
+      if (!targetRefund.returnGoods) return { ok: false, error: "该售后单未申请退货，无需入库" };
+      if (targetOrder.status !== "shipped") return { ok: false, error: "只有已发货订单的退货单才需要确认入库" };
+
+      // Restock all items in refund record
+      for (const item of targetRefund.items) {
+        for (const prod of state.products) {
+          const v = prod.variants.find(it => it.sku === item.sku);
+          if (v) {
+            v.stock += item.qty;
+            break;
+          }
+        }
+      }
+      targetRefund.restocked = true;
+
+      addLog("确认入库", `售后单 ${refundId} 确认退货入库，库存已回补`);
+
+      saveState();
+      renderAll();
+      return { ok: true };
+    }
+
+    function queryOrdersLogic(filter) {
+      filter = filter || {};
+      const { orderId, sku, status, from, to } = filter;
+
+      return state.orders.filter(order => {
+        if (orderId && !order.id.toLowerCase().includes(orderId.trim().toLowerCase())) {
+          return false;
+        }
+        if (sku && !order.items.some(i => i.sku === sku)) {
+          return false;
+        }
+        if (status && order.status !== status) {
+          return false;
+        }
+        if (from) {
+          const orderDate = order.createdAt.slice(0, 10);
+          if (orderDate < from) return false;
+        }
+        if (to) {
+          const orderDate = order.createdAt.slice(0, 10);
+          if (orderDate > to) return false;
+        }
+        return true;
+      });
+    }
+
+    function getStatsLogic() {
+      let sales = 0;
+      let refunds = 0;
+      const unitsSold = {};
+
+      // Initialize all SKUs in products with 0
+      for (const prod of state.products) {
+        for (const v of prod.variants) {
+          unitsSold[v.sku] = 0;
+        }
+      }
+
+      for (const ord of state.orders) {
+        if (ord.paidAt !== null) {
+          sales += ord.payable;
+          for (const item of ord.items) {
+            unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+          }
+        }
+        for (const ref of (ord.refunds || [])) {
+          refunds += ref.amount;
+          if (ord.paidAt !== null) {
+            for (const item of ref.items) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) - item.qty;
+            }
+          }
+        }
+      }
+
+      sales = round2(sales);
+      refunds = round2(refunds);
+      const net = round2(sales - refunds);
+
+      return {
+        sales,
+        refunds,
+        net,
+        unitsSold
+      };
+    }
+
+    function exportDataLogic() {
+      const exportObject = {
+        products: state.products,
+        coupons: state.coupons,
+        isMember: state.isMember,
+        orders: state.orders,
+        logs: state.logs
+      };
+      return JSON.stringify(exportObject, null, 2);
+    }
+
+    function importDataLogic(jsonString) {
+      if (!jsonString || typeof jsonString !== "string") {
+        return { ok: false, error: "导入内容必须为有效的非空字符串" };
+      }
+      try {
+        const data = JSON.parse(jsonString);
+        if (!data || typeof data !== "object") {
+          return { ok: false, error: "导入内容不是有效的 JSON 对象" };
+        }
+        if (!Array.isArray(data.products) || !Array.isArray(data.orders)) {
+          return { ok: false, error: "导入数据缺少必要的 products 或 orders 列表" };
+        }
+
+        // Validate products
+        for (const p of data.products) {
+          if (!p.id || !p.name || !Array.isArray(p.variants)) {
+            return { ok: false, error: "商品数据结构不完整" };
+          }
+          for (const v of p.variants) {
+            if (!v.sku || typeof v.price !== "number" || typeof v.stock !== "number") {
+              return { ok: false, error: "商品规格/库存数据不正确" };
+            }
+          }
+        }
+
+        // Validate orders
+        const validStatuses = ["pending", "paid", "shipped", "cancelled"];
+        for (const o of data.orders) {
+          if (!o.id || !validStatuses.includes(o.status) || !Array.isArray(o.items) || typeof o.payable !== "number") {
+            return { ok: false, error: "订单数据结构不完整或存在非法状态" };
+          }
+          if (typeof o.refundedAmount !== "number" || !Array.isArray(o.refunds)) {
+            return { ok: false, error: "订单售后退款字段不完整" };
+          }
+        }
+
+        // Apply imported state
+        state.products = JSON.parse(JSON.stringify(data.products));
+        state.orders = JSON.parse(JSON.stringify(data.orders));
+        if (Array.isArray(data.coupons)) {
+          state.coupons = JSON.parse(JSON.stringify(data.coupons));
+        }
+        if (typeof data.isMember === "boolean") {
+          state.isMember = data.isMember;
+        }
+        if (Array.isArray(data.logs)) {
+          state.logs = JSON.parse(JSON.stringify(data.logs));
+        }
+        state.cart = [];
+        state.appliedCoupon = null;
+
+        addLog("数据导入", `成功导入 ${state.products.length} 个商品及 ${state.orders.length} 条订单`);
+
+        saveState();
+        renderAll();
+        return { ok: true };
+      } catch (err) {
+        return { ok: false, error: "导入失败: " + err.message };
+      }
+    }
+
+    // ==========================================
+    // 4. ATTACH TO WINDOW.shopTestAPI
