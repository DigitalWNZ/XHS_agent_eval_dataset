+      }
+
+      const existing = state.cart.find(item => item.sku === sku);
+      const currentCartQty = existing ? existing.qty : 0;
+      if (currentCartQty + count > variant.stock) {
+        return { ok: false, error: `库存不足，当前剩余库存 ${variant.stock}` };
+      }
