+
+      function loadState() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            const data = JSON.parse(raw);
+            if (data && Array.isArray(data.products) && Array.isArray(data.orders)) {
+              state.products = data.products;
+              state.coupons = Array.isArray(data.coupons) ? data.coupons : getInitialCoupons();
+              state.isMember = Boolean(data.isMember);
+              state.cart = Array.isArray(data.cart) ? data.cart : [];
+              state.appliedCouponCode = data.appliedCouponCode || null;
+              state.orders = data.orders;
+              state.logs = Array.isArray(data.logs) ? data.logs : [];
+              if (data.checkoutAddress) state.checkoutAddress = data.checkoutAddress;
+              return;
+            }
+          }
