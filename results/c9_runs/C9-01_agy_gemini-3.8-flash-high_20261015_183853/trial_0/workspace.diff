+                return { ok: false, error: `商品规格 ${v.sku || ''} 缺少价格或库存` };
+              }
+            }
+          }
+
+          // Validate orders
+          if (!Array.isArray(parsed.orders)) {
+            return { ok: false, error: "导入数据缺少 orders 列表" };
+          }
+          const validStatuses = ['pending', 'paid', 'shipped', 'cancelled'];
+          for (const ord of parsed.orders) {
+            if (!ord.id || !validStatuses.includes(ord.status) || !ord.createdAt || !Array.isArray(ord.items)) {
+              return { ok: false, error: `订单 ${ord.id || ''} 结构不完整或状态无效` };
+            }
