+          if (order.status === "shipped") {
+            return { ok: false, error: "已发货订单不能取消，请走售后退货流程" };
+          }
+          if (order.status === "cancelled") {
+            return { ok: false, error: "订单已处于取消状态，不能重复取消" };
+          }
