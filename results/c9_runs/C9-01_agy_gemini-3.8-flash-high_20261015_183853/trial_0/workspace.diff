+
+        addToCart(sku, qty) {
+          const quantity = (qty === undefined) ? 1 : Number(qty);
+          if (!Number.isInteger(quantity) || quantity <= 0) {
+            return { ok: false, error: "添加数量必须为大于0的整数" };
+          }
+          const info = findVariant(sku);
+          if (!info) {
+            return { ok: false, error: `SKU ${sku} 不存在` };
+          }
+          const existing = state.cart.find(it => it.sku === sku);
+          const currentInCart = existing ? existing.qty : 0;
+          if (currentInCart + quantity > info.variant.stock) {
+            return { ok: false, error: `库存不足，当前库存为 ${info.variant.stock}，购物车已有 ${currentInCart}` };
+          }
+
+          if (existing) {
+            existing.qty += quantity;
+          } else {
+            state.cart.push({ sku: sku, qty: quantity, unitPrice: info.variant.price });
+          }
+
+          calculateCart();
+          saveState();
+          renderApp();
+          return { ok: true };
+        },
+
+        setCartQty(sku, qty) {
+          if (!Number.isInteger(qty) || qty < 0) {
+            return { ok: false, error: "数量必须为大于等于0的整数" };
+          }
+          const info = findVariant(sku);
+          if (!info) {
+            return { ok: false, error: `SKU ${sku} 不存在` };
+          }
+
+          if (qty === 0) {
+            state.cart = state.cart.filter(it => it.sku !== sku);
+            calculateCart();
+            saveState();
+            renderApp();
+            return { ok: true };
+          }
+
+          if (qty > info.variant.stock) {
+            return { ok: false, error: `库存不足，当前库存为 ${info.variant.stock}` };
+          }
+
+          const existing = state.cart.find(it => it.sku === sku);
+          if (existing) {
+            existing.qty = qty;
+          } else {
+            state.cart.push({ sku: sku, qty: qty, unitPrice: info.variant.price });
+          }
+
+          calculateCart();
+          saveState();
+          renderApp();
+          return { ok: true };
+        },
+
+        removeFromCart(sku) {
+          const prevLen = state.cart.length;
+          state.cart = state.cart.filter(it => it.sku !== sku);
+          calculateCart();
+          saveState();
+          renderApp();
+          return { ok: true };
+        },
+
+        applyCoupon(code) {
+          if (code === null || code === "") {
+            state.appliedCouponCode = null;
+            calculateCart();
+            saveState();
+            renderApp();
+            return { ok: true };
