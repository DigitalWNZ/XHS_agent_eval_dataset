+      }
+
+      function resetToInitialState() {
+        state.products = getInitialProducts();
+        state.coupons = getInitialCoupons();
+        state.isMember = false;
+        state.cart = [];
+        state.appliedCouponCode = null;
+        state.orders = getInitialOrders();
+        state.logs = getInitialLogs();
+        saveState();
+      }
+
+      function addLog(action, detail) {
+        state.logs.unshift({
+          time: new Date().toISOString(),
+          action,
+          detail
+        });
+        if (state.logs.length > 200) state.logs.pop();
+      }
+
+      // --- Catalog Lookup Helpers ---
+      function findVariant(sku) {
+        for (const prod of state.products) {
+          const v = prod.variants.find(item => item.sku === sku);
+          if (v) return { variant: v, product: prod };
+        }
+        return null;
+      }
+
+      // --- Cart & Discounts Calculation ---
+      // Fixed member discount is 10% (0.9折)
+      const MEMBER_DISCOUNT_RATE = 0.10;
+
+      function calculateCart() {
+        const lines = [];
+        let subtotal = 0;
+
+        for (const item of state.cart) {
+          const info = findVariant(item.sku);
+          const unitPrice = info ? info.variant.price : item.unitPrice;
+          const lineTotal = round2(item.qty * unitPrice);
+          subtotal = round2(subtotal + lineTotal);
+          lines.push({
+            sku: item.sku,
+            qty: item.qty,
+            unitPrice: unitPrice,
+            lineTotal: lineTotal
+          });
+        }
+
+        const discounts = [];
+        let remainingSubtotal = subtotal;
+
+        // 1. Member Discount: applies to any non-empty cart if isMember is true
+        if (state.isMember && lines.length > 0 && subtotal > 0) {
+          const memberAmount = round2(subtotal * MEMBER_DISCOUNT_RATE);
+          if (memberAmount > 0) {
+            discounts.push({ type: "member", amount: memberAmount });
+            remainingSubtotal = round2(Math.max(0, remainingSubtotal - memberAmount));
+          }
+        }
+
+        // 2. Coupon Discount: check validity & threshold
+        if (state.appliedCouponCode) {
+          const coupon = state.coupons.find(c => c.code === state.appliedCouponCode);
+          if (coupon && subtotal >= coupon.threshold) {
+            const couponAmount = Math.min(coupon.amount, remainingSubtotal);
+            if (couponAmount > 0) {
+              discounts.push({ type: "coupon", amount: round2(couponAmount) });
+              remainingSubtotal = round2(Math.max(0, remainingSubtotal - couponAmount));
+            }
+          } else {
+            // Coupon no longer meets threshold, invalidate
+            state.appliedCouponCode = null;
+          }
+        }
+
+        const totalDiscounts = discounts.reduce((sum, d) => round2(sum + d.amount), 0);
+        const total = round2(Math.max(0, subtotal - totalDiscounts));
+
+        return {
+          lines,
+          subtotal,
+          discounts,
+          total
+        };
+      }
+
+      // --- Refund Helpers ---
+      function getAlreadyRefundedQty(order, sku) {
+        return (order.refunds || []).reduce((sum, ref) => {
+          const match = (ref.items || []).find(it => it.sku === sku);
+          return sum + (match ? match.qty : 0);
+        }, 0);
+      }
+
+      function isOrderFullyRefundedAfter(order, requestedItems) {
+        for (const item of order.items) {
+          const prev = getAlreadyRefundedQty(order, item.sku);
+          const reqMatch = requestedItems.find(r => r.sku === item.sku);
+          const reqQty = reqMatch ? reqMatch.qty : 0;
+          if (prev + reqQty !== item.qty) {
+            return false;
+          }
+        }
+        return true;
+      }
+
+      // =========================================================================
+      // shopTestAPI Implementation (Shared Single Source of Truth)
+      // =========================================================================
+      const shopTestAPI = {
+        reset() {
+          resetToInitialState();
