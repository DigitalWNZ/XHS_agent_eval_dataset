+
+          const order = {
+            id: orderId,
+            status: "pending",
+            createdAt: now.toISOString(),
+            paidAt: null,
+            items: cart.lines.map(l => ({ sku: l.sku, qty: l.qty, unitPrice: l.unitPrice })),
+            subtotal: cart.subtotal,
+            discounts: cart.discounts,
+            payable: cart.total,
