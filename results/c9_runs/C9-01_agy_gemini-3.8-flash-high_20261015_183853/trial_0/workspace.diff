+
+        pay(orderId) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) return { ok: false, error: `订单 ${orderId} 不存在` };
+          if (order.status !== "pending") {
+            return { ok: false, error: `只有待付款订单可以付款，当前状态为: ${order.status}` };
+          }
+
+          order.status = "paid";
+          order.paidAt = new Date().toISOString();
