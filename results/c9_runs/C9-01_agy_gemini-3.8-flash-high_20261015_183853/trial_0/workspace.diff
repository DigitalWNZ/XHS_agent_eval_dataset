+              return { ok: false, error: `订单 ${ord.id} 金额数据不完整` };
+            }
+          }
+
+          // Import safely
+          state.products = parsed.products;
+          state.orders = parsed.orders;
+          if (Array.isArray(parsed.coupons)) state.coupons = parsed.coupons;
+          if (parsed.isMember !== undefined) state.isMember = Boolean(parsed.isMember);
+          if (Array.isArray(parsed.logs)) state.logs = parsed.logs;
+
+          // Clear cart
+          state.cart = [];
+          state.appliedCouponCode = null;
