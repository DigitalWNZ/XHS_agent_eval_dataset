+
+          // Calculate current subtotal
+          let currentSubtotal = 0;
+          for (const item of state.cart) {
+            const info = findVariant(item.sku);
+            const price = info ? info.variant.price : item.unitPrice;
+            currentSubtotal = round2(currentSubtotal + item.qty * price);
+          }
+
+          if (currentSubtotal < coupon.threshold) {
+            return { ok: false, error: `未达到优惠券满减门槛（需满 ${coupon.threshold} 元，当前 ${currentSubtotal} 元）` };
+          }
+
+          state.appliedCouponCode = coupon.code;
+          calculateCart();
+          saveState();
+          renderApp();
+          return { ok: true };
+        },
+
+        getCart() {
+          const cart = calculateCart();
+          return JSON.parse(JSON.stringify(cart));
+        },
+
+        prepareCheckout(address) {
+          if (!address || typeof address !== 'object') {
+            return { ok: false, error: "收货信息不能为空" };
+          }
+          const name = String(address.name || "").trim();
+          const phone = String(address.phone || "").trim();
+          const addr = String(address.address || "").trim();
+
+          if (!name) return { ok: false, error: "请填写收件人姓名" };
+          if (!/^\d{11}$/.test(phone)) return { ok: false, error: "手机号必须为11位数字" };
+          if (!addr) return { ok: false, error: "请填写详细地址" };
+
+          if (state.cart.length === 0) {
+            return { ok: false, error: "购物车为空，无法结算" };
+          }
+
+          // Check stock sufficiency
+          for (const item of state.cart) {
+            const info = findVariant(item.sku);
+            if (!info || info.variant.stock < item.qty) {
+              return { ok: false, error: `商品 ${item.sku} 库存不足` };
+            }
+          }
+
+          state.checkoutAddress = { name, phone, address: addr };
+
+          // Open confirmation modal in UI containing data-testid="confirm-order"
+          openCheckoutModal(true);
+          return { ok: true };
+        },
+
+        checkout(address) {
+          if (!address || typeof address !== 'object') {
+            return { ok: false, error: "收货信息不能为空" };
+          }
+          const name = String(address.name || "").trim();
+          const phone = String(address.phone || "").trim();
+          const addr = String(address.address || "").trim();
+
+          if (!name) return { ok: false, error: "请填写收件人姓名" };
+          if (!/^\d{11}$/.test(phone)) return { ok: false, error: "手机号必须为11位数字" };
+          if (!addr) return { ok: false, error: "请填写详细地址" };
+
+          if (state.cart.length === 0) {
+            return { ok: false, error: "购物车为空，不能重复下单" };
+          }
+
+          // Verify stock for all items
+          for (const item of state.cart) {
+            const info = findVariant(item.sku);
+            if (!info || info.variant.stock < item.qty) {
+              return { ok: false, error: `商品 ${item.sku} 库存不足，下单终止` };
+            }
