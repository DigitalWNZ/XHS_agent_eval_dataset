+
+      function openAftersaleModal(orderId) {
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) return;
+        currentAftersaleOrderId = orderId;
+
+        document.getElementById('aftersale-modal-title').textContent = `↩️ 申请售后 - 订单 ${orderId}`;
+        const tbody = document.getElementById('aftersale-items-tbody');
+        tbody.innerHTML = '';
+
+        order.items.forEach(it => {
+          const already = getAlreadyRefundedQty(order, it.sku);
+          const remaining = it.qty - already;
+          const tr = document.createElement('tr');
+          tr.innerHTML = `
+            <td><b>${it.sku}</b></td>
+            <td>¥${it.unitPrice.toFixed(2)}</td>
+            <td>${it.qty}</td>
+            <td style="font-weight:700; color:${remaining > 0 ? 'var(--primary)' : 'var(--text-muted)'};">${remaining}</td>
+            <td>
+              <input type="number" class="form-input aftersale-qty-input" data-sku="${it.sku}"
+                min="0" max="${remaining}" value="0" style="width: 80px; padding: 0.3rem 0.5rem;" ${remaining <= 0 ? 'disabled' : ''}>
+            </td>
+          `;
+          tbody.appendChild(tr);
+        });
+
+        // Set returnGoods checkbox based on whether goods shipped
+        const returnCheck = document.getElementById('aftersale-return-goods');
+        returnCheck.checked = (order.status === 'shipped');
+
+        updateAftersaleEstimatedAmount();
+
+        tbody.querySelectorAll('.aftersale-qty-input').forEach(input => {
+          input.addEventListener('input', updateAftersaleEstimatedAmount);
+        });
+
+        document.getElementById('modal-aftersale').classList.add('open');
+      }
+
+      function updateAftersaleEstimatedAmount() {
+        if (!currentAftersaleOrderId) return;
+        const order = state.orders.find(o => o.id === currentAftersaleOrderId);
+        if (!order) return;
+
+        const inputs = document.querySelectorAll('.aftersale-qty-input');
+        const reqItems = [];
+        inputs.forEach(inp => {
+          const val = parseInt(inp.value, 10) || 0;
+          if (val > 0) {
+            reqItems.push({ sku: inp.dataset.sku, qty: val });
+          }
+        });
+
+        if (reqItems.length === 0) {
+          document.getElementById('aftersale-estimated-amount').textContent = '¥0.00';
+          return;
+        }
+
+        const isFully = isOrderFullyRefundedAfter(order, reqItems);
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        let amount = 0;
+
+        if (isFully) {
+          amount = remainingPayable;
+        } else {
+          let raw = 0;
+          for (const req of reqItems) {
+            const it = order.items.find(i => i.sku === req.sku);
+            if (it) {
+              raw += (req.qty * it.unitPrice * order.payable) / order.subtotal;
+            }
+          }
+          amount = round2(raw);
+          amount = Math.min(amount, remainingPayable);
+        }
+
+        document.getElementById('aftersale-estimated-amount').textContent = `¥${amount.toFixed(2)}`;
+      }
+
+      function closeAftersaleModal() {
+        document.getElementById('modal-aftersale').classList.remove('open');
+        currentAftersaleOrderId = null;
+      }
