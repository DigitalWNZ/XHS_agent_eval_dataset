+        requestAfterSale(orderId, items, options) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) return { ok: false, error: `订单 ${orderId} 不存在` };
+
+          if (order.status !== "paid" && order.status !== "shipped") {
+            return { ok: false, error: `仅已付款或已发货订单可申请售后，当前状态为: ${order.status}` };
+          }
+
+          if (!Array.isArray(items) || items.length === 0) {
+            return { ok: false, error: "售后商品列表不能为空" };
+          }
+
+          // Validate items & refundable quantities
+          for (const req of items) {
+            if (!Number.isInteger(req.qty) || req.qty <= 0) {
+              return { ok: false, error: `商品 ${req.sku} 申请售后数量必须大于0` };
+            }
+            const orderItem = order.items.find(it => it.sku === req.sku);
+            if (!orderItem) {
+              return { ok: false, error: `商品 ${req.sku} 不在原订单中` };
+            }
+            const alreadyRef = getAlreadyRefundedQty(order, req.sku);
+            const refundable = orderItem.qty - alreadyRef;
+            if (req.qty > refundable) {
+              return { ok: false, error: `商品 ${req.sku} 申请数量 ${req.qty} 超出剩余可退数量 ${refundable}` };
+            }
+          }
+
+          const remainingPayable = round2(order.payable - order.refundedAmount);
+          if (remainingPayable <= 0) {
+            return { ok: false, error: "该订单已无剩余可退金额" };
+          }
+
+          const isFullyRefunded = isOrderFullyRefundedAfter(order, items);
+          let refundAmount = 0;
+
+          if (isFullyRefunded) {
+            // "当订单商品全部退完时，最后一次退款为剩余实付"
+            refundAmount = remainingPayable;
+          } else {
+            // "本次退款 = Σ 数量 × 单价 × 实付 ÷ 商品原价合计，四舍五入到分"
+            let rawSum = 0;
+            for (const req of items) {
+              const orderItem = order.items.find(it => it.sku === req.sku);
+              rawSum += (req.qty * orderItem.unitPrice * order.payable) / order.subtotal;
+            }
+            refundAmount = round2(rawSum);
+            // Cumulative refund cannot exceed payable
+            refundAmount = Math.min(refundAmount, remainingPayable);
+          }
+
+          const returnGoods = Boolean(options && options.returnGoods);
+          let restocked = false;
+
+          // If order is paid but unshipped, goods are in warehouse -> restock immediately
+          if (order.status === "paid") {
+            for (const req of items) {
+              const info = findVariant(req.sku);
+              if (info) {
+                info.variant.stock += req.qty;
+              }
+            }
+            restocked = true;
+          }
+
+          const refundId = `REF-${Date.now()}-${Math.floor(1000 + Math.random() * 9000)}`;
+          const refund = {
+            id: refundId,
+            items: items.map(it => ({ sku: it.sku, qty: it.qty })),
+            amount: refundAmount,
+            returnGoods: returnGoods,
+            restocked: restocked
+          };
+
+          order.refunds.push(refund);
+          order.refundedAmount = round2(order.refundedAmount + refundAmount);
+
+          addLog("售后申请", `订单 ${orderId} 售后单 ${refundId} 申请成功，退款 ¥${refundAmount}（退货: ${returnGoods ? '是' : '否'}）`);
+          saveState();
+          renderApp();
+
+          return { ok: true, refundId: refundId, amount: refundAmount };
+        },
+
+        confirmReturn(refundId) {
+          let foundOrder = null;
+          let foundRefund = null;
+
+          for (const ord of state.orders) {
+            const ref = (ord.refunds || []).find(r => r.id === refundId);
+            if (ref) {
+              foundOrder = ord;
+              foundRefund = ref;
+              break;
+            }
+          }
+
+          if (!foundRefund) {
+            return { ok: false, error: `售后单 ${refundId} 不存在` };
+          }
+
+          if (foundOrder.status !== "shipped") {
+            return { ok: false, error: "仅已发货订单的退货可确认入库" };
+          }
+
+          if (!foundRefund.returnGoods) {
+            return { ok: false, error: "该售后单未申请退货（仅退款无退货）" };
+          }
+
+          if (foundRefund.restocked) {
+            return { ok: false, error: "该售后单退货已确认入库，不能重复入库" };
+          }
+
+          // Restock inventory
+          for (const item of foundRefund.items) {
+            const info = findVariant(item.sku);
+            if (info) {
+              info.variant.stock += item.qty;
+            }
+          }
+
+          foundRefund.restocked = true;
+
+          addLog("退货入库", `售后单 ${refundId} 退货商品已确认入库，库存已回补`);
+          saveState();
+          renderApp();
+
+          return { ok: true };
+        },
+
+        queryOrders(params) {
+          const { orderId, sku, status, from, to } = params || {};
+          return state.orders.filter(ord => {
+            if (orderId && orderId.trim()) {
+              if (!ord.id.toLowerCase().includes(orderId.trim().toLowerCase())) return false;
+            }
+            if (sku && sku.trim()) {
+              const hasSku = (ord.items || []).some(it => it.sku.toLowerCase() === sku.trim().toLowerCase());
+              if (!hasSku) return false;
+            }
+            if (status && status.trim()) {
+              if (ord.status !== status.trim()) return false;
+            }
+            const dateStr = ord.createdAt.slice(0, 10);
+            if (from && from.trim()) {
+              if (dateStr < from.trim()) return false;
+            }
+            if (to && to.trim()) {
+              if (dateStr > to.trim()) return false;
+            }
+            return true;
+          });
+        },
+
+        getStats() {
+          let sales = 0;
+          let refunds = 0;
+          const unitsSold = {};
+
+          // Initialize all known skus
+          state.products.forEach(p => {
+            p.variants.forEach(v => {
+              unitsSold[v.sku] = 0;
+            });
+          });
+
+          // sales = 所有曾付款订单（paidAt 非空，含之后取消或退款的）实付合计
+          state.orders.forEach(ord => {
+            if (ord.paidAt !== null) {
+              sales = round2(sales + ord.payable);
+              (ord.items || []).forEach(it => {
+                unitsSold[it.sku] = (unitsSold[it.sku] || 0) + it.qty;
+              });
+            }
+
+            // refunds = 全部退款记录合计
+            (ord.refunds || []).forEach(ref => {
+              refunds = round2(refunds + ref.amount);
+              (ref.items || []).forEach(it => {
+                unitsSold[it.sku] = (unitsSold[it.sku] || 0) - it.qty;
+              });
+            });
+          });
+
+          const net = round2(sales - refunds);
+
+          return {
+            sales,
+            refunds,
+            net,
+            unitsSold
+          };
+        },
+
+        exportData() {
+          return JSON.stringify({
+            products: state.products,
+            coupons: state.coupons,
+            isMember: state.isMember,
+            orders: state.orders,
+            logs: state.logs
+          }, null, 2);
+        },
+
+        importData(str) {
+          if (typeof str !== 'string' || !str.trim()) {
+            return { ok: false, error: "导入数据不能为空" };
+          }
+          let parsed;
+          try {
+            parsed = JSON.parse(str);
+          } catch (e) {
+            return { ok: false, error: "JSON 格式解析失败" };
+          }
+
+          if (!parsed || typeof parsed !== 'object') {
+            return { ok: false, error: "导入数据格式不正确" };
+          }
+
+          // Validate products
+          if (!Array.isArray(parsed.products) || parsed.products.length === 0) {
+            return { ok: false, error: "导入数据缺少有效的 products 商品列表" };
+          }
+          for (const p of parsed.products) {
+            if (!p.id || !p.name || !Array.isArray(p.variants) || p.variants.length === 0) {
+              return { ok: false, error: "商品数据结构不完整" };
+            }
+            for (const v of p.variants) {
