+          if (order.status === "pending") {
+            // Unfulfilled pending order: release reserved stock
+            for (const item of order.items) {
+              const info = findVariant(item.sku);
+              if (info) {
+                info.variant.stock += item.qty;
+              }
+            }
+            order.status = "cancelled";
+            addLog("取消订单", `待付款订单 ${orderId} 已取消，库存已自动释放`);
+            saveState();
+            renderApp();
+            return { ok: true };
+          }
+
+          if (order.status === "paid") {
+            // Paid but unshipped: release remaining stock & generate refund record for remaining payable
+            for (const item of order.items) {
+              const alreadyRef = getAlreadyRefundedQty(order, item.sku);
+              const remainingStockQty = item.qty - alreadyRef;
+              if (remainingStockQty > 0) {
+                const info = findVariant(item.sku);
+                if (info) {
+                  info.variant.stock += remainingStockQty;
+                }
+              }
+            }
+
+            const remainingPayable = round2(order.payable - order.refundedAmount);
+            if (remainingPayable > 0 || order.refunds.length === 0) {
+              const refundId = `REF-${Date.now()}-${Math.floor(1000 + Math.random() * 9000)}`;
+              const refItems = [];
+              for (const item of order.items) {
+                const alreadyRef = getAlreadyRefundedQty(order, item.sku);
+                const rem = item.qty - alreadyRef;
+                if (rem > 0) {
+                  refItems.push({ sku: item.sku, qty: rem });
+                }
+              }
+              const refundRecord = {
+                id: refundId,
+                items: refItems,
+                amount: remainingPayable,
+                returnGoods: false,
+                restocked: true
+              };
+              order.refunds.push(refundRecord);
+              order.refundedAmount = order.payable;
+            }
