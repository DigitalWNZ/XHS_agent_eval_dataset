+        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(function () { toast('已复制到剪贴板', 'ok'); }, function () { $('#imp-text').value = txt; toast('无法访问剪贴板，已放入右侧文本框', 'warn'); });
+        else { $('#imp-text').value = txt; toast('已放入右侧文本框，可手动复制', 'warn'); }
+        break;
+      }
+      case 'import': uiImport(); break;
+      case 'reset': confirmDanger('恢复初始数据', '<p>将清空当前所有订单、购物车与操作记录，恢复为演示初始数据。<b>此操作不可撤销</b>，建议先导出备份。</p>', '确认恢复', function () { api.reset(); toast('已恢复初始数据', 'ok'); }); break;
+    }
+  });
+}
+function readOF() {
+  UI.of = { orderId: $('#of-id').value, sku: $('#of-sku').value, status: $('#of-status').value, from: $('#of-from').value, to: $('#of-to').value, refund: $('#of-refund').value };
+  renderOrders();
+}
+
+/* ======================= 自动化验收接口（调用同一套业务逻辑） ======================= */
+function apiRun(fn) {
+  var r = txn(fn);
+  try { renderAll(); } catch (e) { /* 渲染问题不影响业务结果 */ }
+  var out = {};
+  for (var k in r) if (k !== 'fieldErrors') out[k] = r[k];
+  if (!out.ok) out.ok = false;
+  return out;
+}
+var api = {
+  reset: function () {
+    S = buildSeed(); persist();
+    UI.selOrder = null; UI.checkout = { step: 'form', address: { name: '', phone: '', address: '', note: '' }, errors: {}, session: null };
+    renderAll();
+    return { ok: true };
+  },
+  getState: function () {
+    return { products: pubProducts(), coupons: pubCoupons(), isMember: S.isMember, couponCode: S.couponCode, orders: S.orders.map(pubOrder),
+      logs: S.logs.map(function (l) { return { time: l.time, action: l.action, detail: l.detail, orderId: l.orderId }; }) };
+  },
+  setMember: function (f) { return apiRun(function () { return opSetMember(f); }); },
+  addToCart: function (sku, qty) { return apiRun(function () { return opAddToCart(sku, qty); }); },
+  setCartQty: function (sku, qty) { return apiRun(function () { return opSetCartQty(sku, qty); }); },
+  removeFromCart: function (sku) { return apiRun(function () { return opRemoveFromCart(sku); }); },
+  applyCoupon: function (code) { return apiRun(function () { return opApplyCoupon(code); }); },
+  getCart: function () {
+    var pr = cartPricing();
+    return { lines: cartLines().map(function (l) { return { sku: l.sku, qty: l.qty, unitPrice: c2y(l.unitPrice), lineTotal: c2y(l.lineTotal), name: l.name, spec: l.spec, stock: l.stock }; }),
+      subtotal: c2y(pr.subtotal), discounts: pubDiscounts(pr.discounts), total: c2y(pr.total), couponCode: S.couponCode, couponApplicable: !!(pr.couponState && pr.couponState.valid) };
+  },
+  checkout: function (address) {
+    var r = apiRun(function () { return opCheckout(address); });
+    return r;
+  },
+  prepareCheckout: function (address) {
+    var r = startConfirm(address);
+    if (!r.ok) return { ok: false, error: r.error };
+    closeModal();
+    setView('checkout');
+    return { ok: true };
+  },
+  pay: function (id) { return apiRun(function () { return opPay(id); }); },
+  ship: function (id) { return apiRun(function () { return opShip(id); }); },
+  cancel: function (id) { return apiRun(function () { return opCancel(id); }); },
+  requestAfterSale: function (id, items, opts) { return apiRun(function () { return opAfterSale(id, items, opts); }); },
+  confirmReturn: function (rid) { return apiRun(function () { return opConfirmReturn(rid); }); },
+  queryOrders: function (f) { return filterOrders(f && typeof f === 'object' ? { orderId: f.orderId, sku: f.sku, status: f.status, from: f.from, to: f.to } : {}).map(pubOrder); },
+  getStats: function () {
+    var st = computeStats(S.orders), u = {};
+    Object.keys(st.units).forEach(function (k) { u[k] = st.units[k]; });
+    return { sales: c2y(st.sales), refunds: c2y(st.refunds), net: c2y(st.net), unitsSold: u };
+  },
+  exportData: function () { return buildExport(); },
+  importData: function (text) {
+    var r = apiRun(function () { return opImport(text); });
+    if (r.ok) { UI.selOrder = null; UI.checkout.session = null; UI.checkout.step = 'form'; renderAll(); }
+    return r.ok ? { ok: true, error: null, products: r.products, orders: r.orders } : { ok: false, error: r.error };
+  }
+};
+window.shopTestAPI = api;
+
+/* ======================= 启动 ======================= */
+var loaded = load();
+bind();
+renderAll();
+if (loaded === 'corrupt') toast('本地数据损坏，已载入初始数据（原数据已另存）', 'warn');
+if (!storageOK) toast('本地存储不可用：刷新后数据会丢失，请导出备份', 'warn');
+})();
+</script>
+</body>
+</html>
