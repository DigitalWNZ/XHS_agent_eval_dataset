diff --git a/index.html b/index.html
new file mode 100644
--- /dev/null
+++ b/index.html
@@ -0,0 +1,1667 @@
+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>潮玩星球 · 门店工作台</title>
+<style>
+:root{
+  --bg:#f4f5fb; --card:#fff; --line:#e5e7f0; --text:#1f2333; --muted:#6b7085; --soft:#9aa0b4;
+  --primary:#6246ea; --primary-soft:#efebff; --ok:#13a36b; --ok-soft:#e3f7ee; --warn:#d98300; --warn-soft:#fff3dc;
+  --danger:#e0384b; --danger-soft:#fde8ea; --info:#2a7de1; --info-soft:#e4f0fd; --grey-soft:#eef0f4;
+  --radius:12px; --shadow:0 1px 3px rgba(20,24,60,.06),0 6px 18px rgba(20,24,60,.05);
+}
+*{box-sizing:border-box}
+html,body{margin:0;padding:0}
+body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.5}
+button,input,select,textarea{font:inherit;color:inherit}
+h1,h2,h3,h4{margin:0}
+.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
+.muted{color:var(--muted)} .soft{color:var(--soft)} .small{font-size:12px}
+.right{text-align:right} .nowrap{white-space:nowrap}
+.money{font-variant-numeric:tabular-nums;white-space:nowrap}
+.neg{color:var(--danger)} .pos{color:var(--ok)}
+
+/* header */
+header.top{position:sticky;top:0;z-index:20;background:#1d1640;color:#fff;display:flex;align-items:center;gap:18px;padding:0 20px;height:58px;box-shadow:0 2px 10px rgba(0,0,0,.15)}
+.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px;white-space:nowrap}
+.brand .logo{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#ff7eb3,#7b5cff);display:grid;place-items:center;font-size:17px}
+.brand small{font-weight:400;opacity:.65;font-size:12px}
+nav.tabs{display:flex;gap:4px;flex:1;overflow-x:auto}
+nav.tabs button{background:none;border:0;color:#cfc9f2;padding:8px 13px;border-radius:8px;cursor:pointer;white-space:nowrap;position:relative}
+nav.tabs button:hover{background:rgba(255,255,255,.08);color:#fff}
+nav.tabs button.active{background:rgba(255,255,255,.16);color:#fff;font-weight:600}
+.badge-dot{display:inline-block;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:#ff5a7a;color:#fff;font-size:11px;line-height:18px;text-align:center;margin-left:4px;font-weight:600}
+.member-switch{display:flex;align-items:center;gap:8px;white-space:nowrap;font-size:13px;background:rgba(255,255,255,.08);padding:6px 12px;border-radius:20px;cursor:pointer;user-select:none}
+.switch{position:relative;width:38px;height:22px;border-radius:11px;background:#5a5480;transition:.2s;flex:none}
+.switch::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s}
+.switch.on{background:#ffb020}.switch.on::after{left:19px}
+
+main{padding:18px 20px 40px;max-width:1500px;margin:0 auto}
+.view{display:none}.view.active{display:block}
+.card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--line)}
+.card-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}
+.card-hd h3{font-size:15px}
+.card-bd{padding:14px 16px}
+.page-title{display:flex;align-items:baseline;gap:12px;margin-bottom:14px}
+.page-title h2{font-size:19px}
+
+/* controls */
+.btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 14px;cursor:pointer;transition:.15s;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;justify-content:center}
+.btn:hover{border-color:#c9cbe0;background:#fafaff}
+.btn:disabled,.btn.is-disabled{opacity:.5;cursor:not-allowed}
+.btn-primary{background:var(--primary);border-color:var(--primary);color:#fff}
+.btn-primary:hover{background:#5236d8;border-color:#5236d8}
+.btn-danger{background:var(--danger);border-color:var(--danger);color:#fff}
+.btn-danger:hover{background:#c92a3c}
+.btn-ghost-danger{color:var(--danger);border-color:#f3c1c7}
+.btn-ghost-danger:hover{background:var(--danger-soft)}
+.btn-ok{background:var(--ok);border-color:var(--ok);color:#fff}
+.btn-ok:hover{background:#0f8a5a}
+.btn-sm{padding:4px 10px;font-size:12px;border-radius:7px}
+.btn-lg{padding:11px 22px;font-size:15px;border-radius:10px}
+.btn-block{width:100%}
+input[type=text],input[type=search],input[type=tel],input[type=date],input[type=number],select,textarea{border:1px solid var(--line);border-radius:8px;padding:7px 10px;background:#fff;outline:none;min-width:0}
+input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
+textarea{resize:vertical;width:100%}
+label.field{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
+label.field>span{font-size:13px;color:var(--muted)}
+label.field>span b{color:var(--danger)}
+.field-err{color:var(--danger);font-size:12px;min-height:16px}
+input.invalid,textarea.invalid{border-color:var(--danger)}
+.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px}
+.toolbar input[type=search]{flex:1;min-width:200px}
+
+/* tags */
+.tag{display:inline-flex;align-items:center;gap:4px;padding:1px 8px;border-radius:20px;font-size:12px;font-weight:600;white-space:nowrap}
+.st-pending{background:var(--warn-soft);color:var(--warn)}
+.st-paid{background:var(--info-soft);color:var(--info)}
+.st-shipped{background:var(--ok-soft);color:var(--ok)}
+.st-cancelled{background:var(--grey-soft);color:#7a7f92}
+.tag-refund{background:var(--danger-soft);color:var(--danger)}
+.tag-purple{background:var(--primary-soft);color:var(--primary)}
+.tag-grey{background:var(--grey-soft);color:#646a80}
+
+/* shop */
+.shop-layout{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:18px;align-items:start}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
+.pcard{display:flex;flex-direction:column;overflow:hidden}
+.thumb{height:118px;display:grid;place-items:center;font-size:52px;position:relative}
+.thumb .cat{position:absolute;left:10px;top:10px;background:rgba(255,255,255,.85);border-radius:20px;padding:1px 9px;font-size:12px;font-weight:600;color:#444}
+.thumb .soldout{position:absolute;right:10px;top:10px;background:rgba(30,30,40,.75);color:#fff;border-radius:20px;padding:1px 9px;font-size:12px}
+.pbody{padding:12px 14px 14px;display:flex;flex-direction:column;gap:8px;flex:1}
+.pname{font-weight:600;font-size:14.5px;line-height:1.35}
+.pmeta{font-size:12px;color:var(--muted)}
+.chips{display:flex;flex-wrap:wrap;gap:6px}
+.chip{border:1px solid var(--line);background:#fff;border-radius:8px;padding:4px 8px;font-size:12px;cursor:pointer;text-align:left;line-height:1.3}
+.chip small{display:block;color:var(--muted);font-size:11px}
+.chip.sel{border-color:var(--primary);background:var(--primary-soft);color:var(--primary)}
+.chip.out{color:var(--soft);background:#fafafa}
+.chip.out small{color:#d3a0a7}
+.price-row{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
+.price{font-size:20px;font-weight:700;color:#e0384b}
+.stock{font-size:12px}
+.stock.low{color:var(--warn)} .stock.zero{color:var(--danger)}
+.add-row{display:flex;gap:8px;align-items:center;margin-top:auto}
+.stepper{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}
+.stepper button{border:0;background:#f6f6fb;width:28px;cursor:pointer;font-size:15px}
+.stepper button:hover{background:#ebebf6}
+.stepper input{border:0;width:44px;text-align:center;border-radius:0;padding:5px 2px}
+.stepper input:focus{box-shadow:none}
+.empty{padding:36px 16px;text-align:center;color:var(--muted)}
+.empty .big{font-size:36px;margin-bottom:6px}
+
+.cart-panel{position:sticky;top:76px;max-height:calc(100vh - 92px);display:flex;flex-direction:column}
+.cart-panel .card-bd{overflow:auto}
+.cart-line{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:10px 0;border-bottom:1px dashed var(--line)}
+.cart-line:last-child{border-bottom:0}
+.cart-line .nm{font-weight:600;font-size:13px}
+.cart-line .warn{grid-column:1/-1;color:var(--danger);font-size:12px}
+.section-label{font-size:12px;color:var(--muted);font-weight:600;margin:14px 0 6px;letter-spacing:.5px}
+.coupon{display:flex;align-items:center;gap:8px;padding:7px 9px;border:1px solid var(--line);border-radius:8px;margin-bottom:6px;cursor:pointer;font-size:13px}
+.coupon:hover{border-color:#c9c3f5}
+.coupon.sel{border-color:var(--primary);background:var(--primary-soft)}
+.coupon.unmet{opacity:.85}
+.coupon .cond{font-size:11.5px;color:var(--muted)}
+.coupon .st{margin-left:auto;font-size:12px;white-space:nowrap}
+.breakdown{width:100%;border-collapse:collapse}
+.breakdown td{padding:4px 0}
+.breakdown td:last-child{text-align:right}
+.breakdown tr.total td{border-top:1px solid var(--line);padding-top:9px;font-weight:700;font-size:16px}
+.breakdown tr.total td:last-child{color:#e0384b;font-size:20px}
+.notice{border-radius:8px;padding:8px 11px;font-size:12.5px;margin:8px 0;line-height:1.55}
+.notice.warn{background:var(--warn-soft);color:#8a5600}
+.notice.info{background:var(--info-soft);color:#1d5ca8}
+.notice.err{background:var(--danger-soft);color:#a3202f}
+.notice.ok{background:var(--ok-soft);color:#0b6e48}
+.rules{font-size:12px;color:var(--muted);background:#f8f8fc;border-radius:8px;padding:8px 10px;margin-top:10px}
+.rules ul{margin:4px 0 0;padding-left:18px}
+
+/* tables */
+table.tbl{width:100%;border-collapse:collapse;font-size:13px}
+table.tbl th{text-align:left;font-weight:600;color:var(--muted);background:#f8f8fc;padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap;font-size:12.5px}
+table.tbl td{padding:9px 10px;border-bottom:1px solid #f0f1f6;vertical-align:middle}
+table.tbl tr.clickable{cursor:pointer}
+table.tbl tr.clickable:hover td{background:#faf9ff}
+table.tbl tr.sel td{background:var(--primary-soft)}
+table.tbl tfoot td{font-weight:600;background:#fafafd}
+.tbl-wrap{overflow:auto}
+
+/* checkout */
+.steps{display:flex;gap:0;margin-bottom:16px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
+.steps div{flex:1;padding:11px 14px;font-size:13px;color:var(--soft);border-right:1px solid var(--line);display:flex;align-items:center;gap:8px}
+.steps div:last-child{border-right:0}
+.steps div i{font-style:normal;width:22px;height:22px;border-radius:50%;border:1.5px solid currentColor;display:grid;place-items:center;font-size:12px;font-weight:700}
+.steps div.done{color:var(--ok)} .steps div.cur{color:var(--primary);font-weight:600;background:var(--primary-soft)}
+.co-layout{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:18px;align-items:start}
+.pay-total{font-size:30px;font-weight:800;color:#e0384b}
+.success-banner{background:linear-gradient(135deg,#e6f9f0,#eef6ff);border:1px solid #bfe9d4;border-radius:var(--radius);padding:16px 18px;margin-bottom:14px}
+.success-banner h3{color:var(--ok);font-size:17px;margin-bottom:4px}
+
+/* orders */
+.orders-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(380px,1fr);gap:18px;align-items:start}
+.filters{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;align-items:end}
+.filters label{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--muted)}
+.detail{position:sticky;top:76px;max-height:calc(100vh - 92px);overflow:auto}
+.kv{display:grid;grid-template-columns:90px 1fr;gap:5px 10px;font-size:13px}
+.kv dt{color:var(--muted)} .kv dd{margin:0}
+.flow{display:flex;align-items:center;gap:4px;margin:4px 0 12px;font-size:12px;flex-wrap:wrap}
+.flow span{padding:3px 10px;border-radius:20px;background:var(--grey-soft);color:var(--soft)}
+.flow span.done{background:var(--ok-soft);color:var(--ok)}
+.flow span.cur{background:var(--primary);color:#fff}
+.flow span.cancel{background:var(--grey-soft);color:#555;text-decoration:line-through}
+.flow em{color:var(--soft);font-style:normal}
+.actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
+.timeline{list-style:none;margin:0;padding:0 0 0 14px;border-left:2px solid var(--line)}
+.timeline li{position:relative;padding:0 0 10px 12px;font-size:12.5px}
+.timeline li::before{content:"";position:absolute;left:-20px;top:5px;width:10px;height:10px;border-radius:50%;background:#fff;border:2px solid var(--primary)}
+.timeline li b{font-weight:600}
+.refund-box{border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px;font-size:13px}
+.refund-box .hd{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:4px}
+
+/* stats */
+.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:18px}
+.tile{padding:16px 18px}
+.tile .lb{font-size:12.5px;color:var(--muted)}
+.tile .val{font-size:26px;font-weight:800;margin-top:4px;font-variant-numeric:tabular-nums}
+.tile .sub{font-size:12px;color:var(--soft);margin-top:2px}
+.bar{height:10px;border-radius:5px;background:var(--primary);min-width:2px}
+.bar-track{background:#f0eefc;border-radius:5px;width:100%}
+.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}
+
+/* modal & toast */
+.modal-mask{position:fixed;inset:0;background:rgba(18,16,40,.45);z-index:100;display:grid;place-items:center;padding:20px;animation:fade .15s}
+.modal{background:#fff;border-radius:14px;width:min(480px,100%);max-height:calc(100vh - 40px);display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.25)}
+.modal.wide{width:min(760px,100%)}
+.modal-hd{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}
+.modal-hd h3{font-size:16px}
+.modal-bd{padding:16px 18px;overflow:auto}
+.modal-ft{display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--line)}
+.modal.danger .modal-hd{background:var(--danger-soft);border-radius:14px 14px 0 0}
+.modal.danger .modal-hd h3{color:var(--danger)}
+.icon-btn{border:0;background:none;font-size:22px;cursor:pointer;color:var(--muted);line-height:1}
+#toast-root{position:fixed;right:20px;bottom:20px;z-index:200;display:flex;flex-direction:column;gap:8px;align-items:flex-end}
+.toast{background:#252041;color:#fff;padding:10px 16px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.2);font-size:13.5px;max-width:420px;animation:slide .2s}
+.toast.ok{background:#0f8a5a}.toast.error{background:#c92a3c}.toast.warn{background:#b06a00}
+@keyframes fade{from{opacity:0}to{opacity:1}}
+@keyframes slide{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}
+.radio-row{display:flex;flex-direction:column;gap:6px}
+.radio-row label{display:flex;gap:8px;align-items:flex-start;border:1px solid var(--line);border-radius:8px;padding:8px 10px;cursor:pointer}
+.radio-row label:has(input:checked){border-color:var(--primary);background:var(--primary-soft)}
+
+@media (max-width:1100px){
+  .shop-layout,.co-layout,.orders-layout,.two-col{grid-template-columns:1fr}
+  .cart-panel,.detail{position:static;max-height:none}
+  .filters{grid-template-columns:repeat(3,minmax(0,1fr))}
+}
+</style>
+</head>
+<body>
+<header class="top">
+  <div class="brand"><div class="logo">🧸</div><div>潮玩星球<br><small>门店工作台</small></div></div>
+  <nav class="tabs" id="tabs">
+    <button data-view="shop" class="active">🛍️ 商品选购<span id="b-cart"></span></button>
+    <button data-view="checkout">🧾 结算</button>
+    <button data-view="orders">📦 订单管理<span id="b-orders"></span></button>
+    <button data-view="aftersale">↩️ 售后处理<span id="b-after"></span></button>
+    <button data-view="stats">📊 统计与库存</button>
+    <button data-view="logs">📝 操作记录</button>
+    <button data-view="data">💾 数据备份</button>
+  </nav>
+  <div class="member-switch" id="member-toggle" title="切换当前顾客的会员身份（影响购物车会员折扣）">
+    <div class="switch" id="member-switch"></div><span id="member-label">非会员</span>
+  </div>
+</header>
+
+<main>
+  <!-- 商品选购 -->
+  <section class="view active" id="view-shop">
+    <div class="shop-layout">
+      <div>
+        <div class="toolbar">
+          <input type="search" id="f-search" placeholder="🔍 搜索商品名称 / 品牌 / 系列 / SKU">
+          <select id="f-cat"></select>
+          <select id="f-price">
+            <option value="">全部价位</option>
+            <option value="0-100">¥100 以下</option>
+            <option value="100-500">¥100 – ¥500</option>
+            <option value="500-1000">¥500 – ¥1000</option>
+            <option value="1000-">¥1000 以上</option>
+          </select>
+          <select id="f-sort">
+            <option value="default">默认排序</option>
+            <option value="price-asc">价格从低到高</option>
+            <option value="price-desc">价格从高到低</option>
+            <option value="stock-desc">库存从多到少</option>
+          </select>
+          <label class="small" style="display:flex;gap:5px;align-items:center;white-space:nowrap"><input type="checkbox" id="f-instock">仅看有货</label>
+          <span class="muted small" id="f-count"></span>
+        </div>
+        <div class="grid" id="product-grid"></div>
+      </div>
+      <aside class="card cart-panel" id="cart-panel"></aside>
+    </div>
+  </section>
+
+  <!-- 结算 -->
+  <section class="view" id="view-checkout"></section>
+
+  <!-- 订单 -->
+  <section class="view" id="view-orders">
+    <div class="orders-layout">
+      <div>
+        <div class="card" style="margin-bottom:14px">
+          <div class="card-bd">
+            <div class="filters">
+              <label>订单号<input type="text" id="of-id" placeholder="如 SO2026…"></label>
+              <label>商品<select id="of-sku"></select></label>
+              <label>状态<select id="of-status">
+                <option value="">全部状态</option><option value="pending">待付款</option><option value="paid">已付款</option><option value="shipped">已发货</option><option value="cancelled">已取消</option>
+              </select></label>
+              <label>开始日期<input type="date" id="of-from"></label>
+              <label>结束日期<input type="date" id="of-to"></label>
+              <label>售后<select id="of-refund"><option value="">不限</option><option value="yes">有退款</option><option value="pendingReturn">待退货入库</option></select></label>
+            </div>
+            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px">
+              <span class="muted small" id="of-summary"></span>
+              <button class="btn btn-sm" id="of-clear">清空筛选</button>
+            </div>
+          </div>
+        </div>
+        <div class="card"><div class="tbl-wrap" id="order-table"></div></div>
+      </div>
+      <div class="card detail" id="order-detail"></div>
+    </div>
+  </section>
+
+  <!-- 售后 -->
+  <section class="view" id="view-aftersale"></section>
+  <!-- 统计 -->
+  <section class="view" id="view-stats"></section>
+  <!-- 日志 -->
+  <section class="view" id="view-logs"></section>
+  <!-- 数据 -->
+  <section class="view" id="view-data"></section>
+</main>
+
+<div id="modal-root"></div>
+<div id="toast-root"></div>
+
+<script>
+(function () {
+'use strict';
+
+/* ======================= 常量与工具 ======================= */
+var STORAGE_KEY = 'toyshop.workbench.v1';
+var BACKUP_FORMAT = 'toyshop-workbench-backup';
+var MEMBER_OFF_PCT = 5;            // 会员 9.5 折，即按商品原价优惠 5%
+var STATUS_TEXT = { pending: '待付款', paid: '已付款', shipped: '已发货', cancelled: '已取消' };
+var STATUSES = ['pending', 'paid', 'shipped', 'cancelled'];
+var PAY_METHODS = ['微信支付', '支付宝', '银行卡', '现金'];
+var CARRIERS = ['顺丰速运', '中通快递', '京东物流', '门店自提'];
+
