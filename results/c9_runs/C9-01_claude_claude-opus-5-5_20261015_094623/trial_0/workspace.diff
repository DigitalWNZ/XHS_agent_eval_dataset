+.toast.ok{background:#14532d}.toast.err{background:#991b1b}.toast.warn{background:#92400e}
+textarea{width:100%;min-height:160px;font-family:ui-monospace,Consolas,monospace;font-size:12px}
+.empty{padding:30px;text-align:center;color:var(--muted)}
+.kv{display:grid;grid-template-columns:90px 1fr;gap:4px 10px;font-size:13px}
+.kv div:nth-child(odd){color:var(--muted)}
+@media (max-width:1000px){.shop-layout,.two-col{grid-template-columns:1fr}.cart-panel{position:static}.hchips{display:none}}
+</style>
+</head>
+<body>
+<header>
+  <div class="logo">🧸 潮玩小站<small>店员工作台</small></div>
+  <nav id="nav">
+    <button data-tab="shop" class="active">商品销售</button>
+    <button data-tab="orders">订单管理</button>
+    <button data-tab="aftersale">售后处理</button>
+    <button data-tab="stats">统计与库存</button>
+    <button data-tab="logs">操作记录</button>
+    <button data-tab="data">数据备份</button>
+  </nav>
+  <div class="hchips" id="hchips"></div>
+  <label class="member-toggle" title="会员顾客享受商品原价合计 95 折"><input type="checkbox" id="memberToggle"> 会员顾客（95折）</label>
+</header>
+
+<main>
+  <!-- 商品销售 -->
+  <section class="tab active" id="tab-shop">
+    <div class="shop-layout">
+      <div>
+        <div class="toolbar">
+          <input type="text" id="fQ" placeholder="搜索商品名称 / IP / 规格 / SKU">
+          <select id="fCat"><option value="">全部分类</option></select>
+          <select id="fStock"><option value="">全部库存</option><option value="in">仅看有货</option><option value="low">低库存(≤5)</option></select>
+          <select id="fSort"><option value="">默认排序</option><option value="pa">价格从低到高</option><option value="pd">价格从高到低</option></select>
+        </div>
+        <div id="productGrid" class="grid"></div>
+      </div>
+      <aside class="cart-panel panel" id="cartPanel"></aside>
+    </div>
+  </section>
+
+  <!-- 订单管理 -->
+  <section class="tab" id="tab-orders">
+    <div class="panel">
+      <div class="filters">
+        <input type="text" id="oId" placeholder="订单号">
+        <input type="text" id="oProd" placeholder="商品名称或 SKU">
+        <select id="oStatus"><option value="">全部状态</option><option value="pending">待付款</option><option value="paid">已付款</option><option value="shipped">已发货</option><option value="cancelled">已取消</option></select>
+        <span class="muted small">下单日期</span><input type="date" id="oFrom"><span class="muted">至</span><input type="date" id="oTo">
+        <button class="btn" id="oReset">清空筛选</button>
+        <span class="muted small" id="oCount"></span>
