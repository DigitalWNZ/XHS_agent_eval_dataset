+.cart-panel{position:sticky;top:74px}
+.cline{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:10px 0;border-bottom:1px dashed var(--line)}
+.cline .lt{font-weight:600;text-align:right}
