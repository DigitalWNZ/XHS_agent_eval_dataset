+<script>
+(function(){
+'use strict';
+
+/* ======================= 常量与工具 ======================= */
+var LS_KEY = 'toyshop-workbench-v1';
+var MEMBER_PCT = 5;                      // 会员 95 折：优惠 = 原价合计 × 5%
+var STATUS = {pending:'待付款', paid:'已付款', shipped:'已发货', cancelled:'已取消'};
+
+function $(s){ return document.querySelector(s); }
+function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
+function fmt(c){ return '¥' + (c / 100).toFixed(2); }        // 分 -> 展示
+function Y(c){ return Math.round(c) / 100; }                  // 分 -> 元(数字)
+function C(y){ return Math.round(Number(y) * 100); }          // 元 -> 分
+function clone(o){ return JSON.parse(JSON.stringify(o)); }
+function err(msg){ return {ok:false, error:msg}; }
+function pad(n, w){ n = String(n); while (n.length < w) n = '0' + n; return n; }
+function localDate(iso){ var d = new Date(iso); return d.getFullYear() + '-' + pad(d.getMonth() + 1, 2) + '-' + pad(d.getDate(), 2); }
+function fmtTime(iso){ if (!iso) return '—'; var d = new Date(iso); return localDate(iso) + ' ' + pad(d.getHours(), 2) + ':' + pad(d.getMinutes(), 2) + ':' + pad(d.getSeconds(), 2); }
+function parseQty(v){
+  if (typeof v === 'number') return Number.isInteger(v) ? v : NaN;
+  if (typeof v === 'string' && /^\s*\d+\s*$/.test(v)) return parseInt(v, 10);
+  return NaN;
+}
+var MAX_QTY = 999;
+
+/* ======================= 初始数据 ======================= */
+function seedProducts(){
+  var raw = [
+    ['P01','Molly 星空漫游系列盲盒','盲盒','Molly','🌟',[['MOL-1','单盒（随机款）',69,40],['MOL-12','整端 12 盒',780,5]]],
+    ['P02','Dimoo 森林之夜手办','手办','Dimoo','🌙',[['DIM-STD','标准版',129,12],['DIM-GLOW','夜光限定版',199,0]]],
+    ['P03','Labubu 搪胶毛绒挂件','毛绒','Labubu','🐰',[['LAB-PNK','樱花粉',99,25],['LAB-MNT','薄荷绿',99,3],['LAB-WHT','奶油白·限定',109,8]]],
+    ['P04','Skullpanda 机甲纪元大娃','大娃','Skullpanda','🤖',[['SKP-400','400%',599,4],['SKP-1000','1000%',1599,1]]],
+    ['P05','Hirono 小野·城市漫步盲盒','盲盒','Hirono','🏙️',[['HIR-1','单盒（随机款）',69,30],['HIR-6','端盒 6 盒',399,6]]],
+    ['P06','Crybaby 泪眼派对亚克力立牌','周边','Crybaby','💧',[['CRY-S','小号 10cm',39.9,50],['CRY-L','大号 18cm',59.9,20]]],
+    ['P07','潮玩防尘展示收纳盒','周边','通用','📦',[['BOX-1','单层',89,15],['BOX-3','三层带灯',239,7]]],
+    ['P08','Pucky 精灵咖啡馆积木','积木','Pucky','☕',[['PUC-STD','标准款',259,9]]]
+  ];
+  return raw.map(function(r){
+    return {id:r[0], name:r[1], category:r[2], ip:r[3], emoji:r[4],
+      variants:r[5].map(function(v){ return {sku:v[0], spec:v[1], price:C(v[2]), stock:v[3]}; })};
+  });
+}
+function seedCoupons(){
+  return [
+    {code:'MJ20', threshold:C(199), amount:C(20)},
+    {code:'MJ50', threshold:C(399), amount:C(50)},
+    {code:'MJ120', threshold:C(999), amount:C(120)}
+  ];
+}
+
+function findVariantIn(products, sku){
+  for (var i = 0; i < products.length; i++) for (var j = 0; j < products[i].variants.length; j++)
+    if (products[i].variants[j].sku === sku) return {p:products[i], v:products[i].variants[j]};
+  return null;
+}
+
+/* 金额计算（纯函数）：会员折扣与满减门槛均按“商品原价合计”计算，可叠加，每单限一张券 */
+function calcTotals(lines, isMember, couponCode, coupons){
+  var subtotal = 0;
+  lines.forEach(function(l){ subtotal += l.unitPrice * l.qty; });
+  var discounts = [], rest = subtotal, couponState = null;
+  if (isMember && subtotal > 0){
+    var m = Math.round(subtotal * MEMBER_PCT / 100);
+    if (m > 0){ discounts.push({type:'member', amount:m, label:'会员 95 折'}); rest -= m; }
+  }
+  if (couponCode){
+    var c = null;
+    coupons.forEach(function(x){ if (x.code === couponCode) c = x; });
+    if (!c) couponState = {ok:false, msg:'优惠券不存在'};
+    else if (subtotal < c.threshold) couponState = {ok:false, coupon:c, msg:'未满 ' + fmt(c.threshold) + '，还差 ' + fmt(c.threshold - subtotal)};
+    else {
+      var a = Math.min(c.amount, rest);
+      discounts.push({type:'coupon', amount:a, code:c.code, label:'满' + Y(c.threshold) + '减' + Y(c.amount) + '（' + c.code + '）'});
+      rest -= a; couponState = {ok:true, coupon:c};
