+      <div id="orderTable"></div>
+    </div>
+  </section>
+
+  <!-- 售后处理 -->
+  <section class="tab" id="tab-aftersale">
+    <div class="panel" style="margin-bottom:16px">
+      <h3>发起售后</h3>
+      <div class="row">
+        <select id="asOrderSel" style="min-width:360px"></select>
+        <button class="btn primary" id="asOpen">选择商品申请售后</button>
+        <span class="muted small">仅“已付款”“已发货”且仍有可退金额的订单可申请。退款在申请时即记入。</span>
+      </div>
+    </div>
+    <div class="panel" style="margin-bottom:16px">
+      <h3>待退货入库 <span class="muted small">（已发货订单的退货，商品寄回验收后点击确认入库才会回补库存）</span></h3>
+      <div id="inboundList"></div>
+    </div>
