+            appState.cart.appliedCouponCode = null;
+          }
+        }
+      }
+
+      function computeCartSubtotal() {
+        let sum = 0;
+        for (const item of appState.cart.lines) {
+          const found = findVariantBySku(item.sku);
+          if (found) {
+            sum = round2(sum + round2(item.qty * found.variant.price));
+          }
+        }
+        return round2(sum);
+      }
+
+      // Compute full cart representation for getCart() and UI
+      function computeCartDetails() {
+        const lines = [];
+        let subtotal = 0;
+
+        for (const item of appState.cart.lines) {
+          const found = findVariantBySku(item.sku);
+          if (!found) continue;
+          const unitPrice = round2(found.variant.price);
+          const lineTotal = round2(item.qty * unitPrice);
+          subtotal = round2(subtotal + lineTotal);
+          lines.push({
+            sku: item.sku,
+            qty: item.qty,
+            unitPrice,
+            lineTotal
+          });
+        }
+
+        const discounts = [];
+        if (subtotal > 0 && appState.isMember) {
+          const memberDiscount = round2(subtotal * MEMBER_DISCOUNT_RATE);
+          if (memberDiscount > 0) {
+            discounts.push({
+              type: "member",
+              amount: memberDiscount
+            });
+          }
+        }
+
+        if (subtotal > 0 && appState.cart.appliedCouponCode) {
+          const coupon = appState.coupons.find(c => c.code === appState.cart.appliedCouponCode);
+          if (coupon && subtotal >= coupon.threshold) {
+            const currentDiscountSum = discounts.reduce((acc, d) => round2(acc + d.amount), 0);
+            const maxAllowedCoupon = round2(Math.max(0, subtotal - currentDiscountSum));
+            const couponAmount = round2(Math.min(coupon.amount, maxAllowedCoupon));
+            if (couponAmount > 0) {
+              discounts.push({
+                type: "coupon",
+                amount: couponAmount
+              });
+            }
+          }
+        }
+
+        const totalDiscount = discounts.reduce((acc, d) => round2(acc + d.amount), 0);
+        const total = round2(Math.max(0, subtotal - totalDiscount));
+
+        return {
+          lines,
+          subtotal,
+          discounts,
+          total
+        };
