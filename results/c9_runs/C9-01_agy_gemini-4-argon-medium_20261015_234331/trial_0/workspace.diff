+
+          // Aggregate requested quantities per SKU and validate
+          const reqMap = new Map();
+          for (const entry of items) {
+            if (!entry || typeof entry.sku !== "string" || !entry.sku.trim()) {
+              return { ok: false, error: "售后商品缺少有效的 SKU" };
+            }
+            if (typeof entry.qty !== "number" || !Number.isInteger(entry.qty) || entry.qty <= 0) {
+              return { ok: false, error: `售后商品 ${entry.sku} 数量必须为正整数` };
+            }
+            const sku = entry.sku.trim();
+            reqMap.set(sku, (reqMap.get(sku) || 0) + entry.qty);
+          }
+
+          for (const [sku, reqQty] of reqMap.entries()) {
+            const orderItem = order.items.find(i => i.sku === sku);
+            if (!orderItem) {
+              return { ok: false, error: `原订单中不包含商品 ${sku}` };
+            }
+            const alreadyRefunded = getOrderRefundedQty(order, sku);
+            const maxRefundableQty = orderItem.qty - alreadyRefunded;
+            if (reqQty > maxRefundableQty) {
+              return {
+                ok: false,
+                error: `商品 ${sku} 申请售后数量(${reqQty})超过剩余可退数量(${maxRefundableQty})`
+              };
+            }
+          }
+
+          const remainingPayable = round2(order.payable - order.refundedAmount);
+          if (order.payable > 0 && remainingPayable <= 0) {
+            return { ok: false, error: "该订单实付金额已全部退完，无法继续申请退款" };
