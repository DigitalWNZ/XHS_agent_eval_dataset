+            }
+            if (statusFilter && statusFilter !== "all") {
+              if (order.status !== statusFilter) {
+                return false;
+              }
+            }
+            if (fromFilter || toFilter) {
+              const orderDate = String(order.createdAt).slice(0, 10);
+              if (fromFilter && orderDate < fromFilter) {
+                return false;
+              }
+              if (toFilter && orderDate > toFilter) {
+                return false;
+              }
+            }
+            return true;
+          });
+
+          return deepClone(matched.map(o => ({
+            id: o.id,
+            status: o.status,
+            createdAt: o.createdAt,
+            paidAt: o.paidAt === undefined ? null : o.paidAt,
+            address: o.address ? deepClone(o.address) : undefined,
+            items: o.items.map(i => ({
+              sku: i.sku,
+              qty: i.qty,
+              unitPrice: round2(i.unitPrice)
+            })),
+            subtotal: round2(o.subtotal),
+            discounts: (o.discounts || []).map(d => ({
+              type: d.type,
+              amount: round2(d.amount)
+            })),
+            payable: round2(o.payable),
+            refundedAmount: round2(o.refundedAmount),
+            refunds: (o.refunds || []).map(r => ({
+              id: r.id,
+              items: r.items.map(ri => ({ sku: ri.sku, qty: ri.qty })),
+              amount: round2(r.amount),
+              returnGoods: Boolean(r.returnGoods),
+              restocked: Boolean(r.restocked)
+            }))
+          })));
+        },
+
+        getStats() {
+          let sales = 0;
+          let refunds = 0;
+          const unitsSold = {};
+
+          // Initialize all known product variant SKUs with 0
+          for (const prod of appState.products) {
+            for (const v of prod.variants) {
+              unitsSold[v.sku] = 0;
+            }
+          }
+
+          for (const order of appState.orders) {
+            // 全部退款记录合计
+            for (const ref of (order.refunds || [])) {
+              refunds = round2(refunds + round2(ref.amount));
+            }
+
+            // 曾付款订单 (paidAt 非空，含之后取消或退款的)
+            if (order.paidAt !== null && order.paidAt !== undefined && String(order.paidAt).trim() !== "") {
+              sales = round2(sales + round2(order.payable));
+
+              for (const item of order.items) {
+                unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+              }
+              for (const ref of (order.refunds || [])) {
+                for (const ri of (ref.items || [])) {
+                  unitsSold[ri.sku] = (unitsSold[ri.sku] || 0) - ri.qty;
+                }
+              }
+            }
+          }
+
+          const net = round2(sales - refunds);
+          return {
+            sales: round2(sales),
+            refunds: round2(refunds),
+            net: round2(net),
+            unitsSold
+          };
+        },
+
+        exportData() {
+          const payload = {
+            version: 1,
+            exportedAt: new Date().toISOString(),
+            products: appState.products,
+            coupons: appState.coupons,
+            isMember: appState.isMember,
+            cart: appState.cart,
+            orders: appState.orders,
+            logs: appState.logs,
+            orderSeq: appState.orderSeq,
+            refundSeq: appState.refundSeq
+          };
+          return JSON.stringify(payload, null, 2);
+        },
+
+        importData(jsonString) {
+          if (typeof jsonString !== "string" || !jsonString.trim()) {
+            return { ok: false, error: "导入内容不能为空，请提供合法的 JSON 字符串" };
+          }
+          let parsed = null;
+          try {
+            parsed = JSON.parse(jsonString);
+          } catch (err) {
+            return { ok: false, error: "JSON 解析失败：文件内容不是合法的 JSON 格式" };
+          }
+
+          const check = validateImportedStateObject(parsed);
+          if (!check.ok) {
+            return check;
+          }
+
+          applyValidatedState(parsed);
+          preparedCheckoutSession = null;
+          saveState();
+          renderAll();
+          return { ok: true };
+        }
+      };
