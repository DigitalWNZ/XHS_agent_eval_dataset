+        returnCheckbox.checked = order.status === "shipped";
+
+        const itemsContainer = document.getElementById("aftersale-items-list");
+        const rows = [];
+        for (const item of order.items) {
+          const refunded = getOrderRefundedQty(order, item.sku);
+          const avail = item.qty - refunded;
+          const found = findVariantBySku(item.sku);
+          const label = found ? `${found.product.name} · ${found.variant.spec}` : item.sku;
+          rows.push(`
+            <div class="cart-line">
