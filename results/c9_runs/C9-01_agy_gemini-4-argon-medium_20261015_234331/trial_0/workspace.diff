+                <input
+                  type="number"
+                  class="input aftersale-qty-input mono"
+                  data-sku="${escapeHtml(item.sku)}"
+                  data-max="${avail}"
+                  min="0"
+                  max="${avail}"
+                  value="${avail > 0 ? 1 : 0}"
