+
+      function updateAfterSalePreview() {
+        const order = appState.orders.find(o => o.id === currentAfterSaleOrderId);
+        if (!order) return;
+        const inputs = document.querySelectorAll(".aftersale-qty-input");
+        const reqMap = new Map();
+        inputs.forEach(inp => {
+          const sku = inp.getAttribute("data-sku");
+          const qty = parseInt(inp.value, 10) || 0;
+          if (qty > 0) reqMap.set(sku, qty);
+        });
+
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        if (reqMap.size === 0) {
+          document.getElementById("aftersale-preview-amount").textContent = "¥0.00";
+          return;
+        }
+
+        const isAllExhausted = order.items.every(oi => {
+          const already = getOrderRefundedQty(order, oi.sku);
+          const add = reqMap.get(oi.sku) || 0;
+          return already + add === oi.qty;
+        });
+
+        let preview = 0;
+        if (isAllExhausted) {
+          preview = remainingPayable;
+        } else {
+          let reqOrig = 0;
+          for (const [sku, q] of reqMap.entries()) {
+            const oi = order.items.find(i => i.sku === sku);
+            if (oi) reqOrig = round2(reqOrig + round2(q * oi.unitPrice));
+          }
+          preview = order.subtotal > 0
+            ? round2(Math.min(remainingPayable, (reqOrig * order.payable) / order.subtotal))
+            : 0;
+        }
+        document.getElementById("aftersale-preview-amount").textContent = `¥${preview.toFixed(2)}`;
+      }
