+        const prevRefunded = order.refunds.reduce((sum, r) => {
+          const rItem = r.items.find(ri => ri.sku === it.sku);
+          return sum + (rItem ? rItem.qty : 0);
+        }, 0);
+        const maxRefundable = it.qty - prevRefunded;
+
