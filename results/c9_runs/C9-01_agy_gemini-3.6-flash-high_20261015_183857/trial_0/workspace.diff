+
+    function openAfterSaleModal(orderId) {
+      const order = shopState.orders.find(o => o.id === orderId);
+      if (!order) return;
+
+      const isShipped = order.status === "shipped";
+      let bodyHtml = `
+        <div style="font-size:0.9rem; margin-bottom:1rem;">
+          <div>关联订单: <strong>${order.id}</strong> (${order.status === 'shipped' ? '已发货' : '已付款未发货'})</div>
+          <div>订单实付: <strong style="color:var(--primary)">¥${order.payable.toFixed(2)}</strong> | 已退款: ¥${order.refundedAmount.toFixed(2)}</div>
+        </div>
+        <form id="afterSaleForm">
+          <div style="font-weight:600; font-size:0.9rem; margin-bottom:0.5rem;">选择申请退款的商品与数量:</div>
+      `;
+
+      order.items.forEach(it => {
