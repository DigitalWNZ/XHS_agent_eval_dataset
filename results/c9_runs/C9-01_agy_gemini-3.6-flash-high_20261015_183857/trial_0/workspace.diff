+
+    // Load or Reset State
+    function loadState() {
+      const saved = localStorage.getItem("toy_shop_state");
+      if (saved) {
+        try {
+          const parsed = JSON.parse(saved);
+          shopState = {
+            products: parsed.products || deepClone(INITIAL_PRODUCTS),
+            coupons: parsed.coupons || deepClone(INITIAL_COUPONS),
+            isMember: !!parsed.isMember,
+            cart: parsed.cart || [],
+            appliedCouponCode: parsed.appliedCouponCode || null,
+            orders: parsed.orders || deepClone(INITIAL_ORDERS),
+            logs: parsed.logs || deepClone(INITIAL_LOGS)
+          };
+          return;
+        } catch (e) {
+          console.error("Failed to parse local storage state:", e);
+        }
+      }
+      resetToInitial();
+    }
+
+    function saveState() {
+      localStorage.setItem("toy_shop_state", JSON.stringify(shopState));
+    }
+
+    function resetToInitial() {
+      shopState = {
+        products: deepClone(INITIAL_PRODUCTS),
+        coupons: deepClone(INITIAL_COUPONS),
+        isMember: false,
+        cart: [],
+        appliedCouponCode: null,
+        orders: deepClone(INITIAL_ORDERS),
+        logs: deepClone(INITIAL_LOGS)
+      };
+      saveState();
+    }
+
+    function deepClone(obj) {
+      return JSON.parse(JSON.stringify(obj));
+    }
+
+    function logAction(action, detail) {
+      const timeStr = new Date().toLocaleString("zh-CN", { hour12: false });
+      shopState.logs.unshift({ time: timeStr, action, detail });
+      if (shopState.logs.length > 200) shopState.logs.pop();
+    }
+
+    // Helper: Find Variant by SKU
+    function findVariant(sku) {
+      for (const p of shopState.products) {
+        const v = p.variants.find(item => item.sku === sku);
+        if (v) return { product: p, variant: v };
+      }
+      return null;
+    }
+
+    // ==========================================
+    // CORE BUSINESS & CALCULATION LOGIC
+    // ==========================================
+
+    function computeCart() {
+      const lines = shopState.cart.map(item => {
+        const info = findVariant(item.sku);
+        const unitPrice = info ? info.variant.price : 0;
+        const lineTotal = Math.round(item.qty * unitPrice * 100) / 100;
+        return {
+          sku: item.sku,
+          qty: item.qty,
+          unitPrice: unitPrice,
+          lineTotal: lineTotal
+        };
+      });
+
+      const subtotal = Math.round(lines.reduce((sum, l) => sum + l.lineTotal, 0) * 100) / 100;
+      
+      let memberDiscount = 0;
+      if (shopState.isMember && subtotal > 0) {
+        memberDiscount = Math.round(subtotal * 0.10 * 100) / 100; // 10% member discount
+      }
+
+      let couponDiscount = 0;
+      let appliedCoupon = null;
+      if (shopState.appliedCouponCode) {
+        appliedCoupon = shopState.coupons.find(c => c.code === shopState.appliedCouponCode);
+        if (appliedCoupon && subtotal >= appliedCoupon.threshold) {
+          couponDiscount = appliedCoupon.amount;
+        } else {
+          // Coupon threshold no longer met! Auto-remove invalid coupon.
+          shopState.appliedCouponCode = null;
+          appliedCoupon = null;
+        }
+      }
+
+      const discounts = [];
+      if (memberDiscount > 0) {
+        discounts.push({ type: "member", amount: memberDiscount });
+      }
+      if (couponDiscount > 0) {
+        discounts.push({ type: "coupon", amount: couponDiscount });
+      }
+
+      const totalDiscount = Math.round((memberDiscount + couponDiscount) * 100) / 100;
+      const total = Math.max(0, Math.round((subtotal - totalDiscount) * 100) / 100);
+
+      return {
+        lines,
+        subtotal,
+        discounts,
+        total
+      };
+    }
+
+    // ==========================================
+    // window.shopTestAPI IMPLEMENTATION
+    // ==========================================
+    window.shopTestAPI = {
+      
+      reset: function() {
+        resetToInitial();
+        logAction("API重置", "通过测试接口重置初始数据");
+        saveState();
+        renderAll();
+      },
+
+      getState: function() {
+        return {
+          products: deepClone(shopState.products),
+          coupons: deepClone(shopState.coupons),
+          isMember: shopState.isMember,
+          orders: deepClone(shopState.orders),
+          logs: deepClone(shopState.logs)
+        };
+      },
+
+      setMember: function(isMember) {
+        shopState.isMember = !!isMember;
+        computeCart(); // re-evaluates coupons/discounts
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      addToCart: function(sku, qty) {
+        const info = findVariant(sku);
+        if (!info) return { ok: false, error: "商品SKU不存在" };
+        if (!Number.isInteger(qty) || qty <= 0) return { ok: false, error: "添加数量必须为大于0的整数" };
+
+        const existing = shopState.cart.find(c => c.sku === sku);
+        const currentQty = existing ? existing.qty : 0;
+        if (currentQty + qty > info.variant.stock) {
+          return { ok: false, error: `超出最大可用库存 (${info.variant.stock})` };
+        }
+
+        if (existing) {
+          existing.qty += qty;
+        } else {
+          shopState.cart.push({ sku, qty });
+        }
+
+        computeCart();
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      setCartQty: function(sku, qty) {
+        if (qty === 0) {
+          return this.removeFromCart(sku);
+        }
+        if (!Number.isInteger(qty) || qty < 0) return { ok: false, error: "数量必须为非负整数" };
+        const info = findVariant(sku);
+        if (!info) return { ok: false, error: "商品SKU不存在" };
+        if (qty > info.variant.stock) {
+          return { ok: false, error: `超出最大可用库存 (${info.variant.stock})` };
+        }
+
+        const existing = shopState.cart.find(c => c.sku === sku);
+        if (existing) {
+          existing.qty = qty;
+        } else {
+          shopState.cart.push({ sku, qty });
+        }
+
+        computeCart();
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      removeFromCart: function(sku) {
+        shopState.cart = shopState.cart.filter(c => c.sku !== sku);
+        computeCart();
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      applyCoupon: function(code) {
+        if (code === null || code === "") {
+          shopState.appliedCouponCode = null;
+          computeCart();
+          saveState();
+          renderAll();
+          return { ok: true };
+        }
+
+        const coupon = shopState.coupons.find(c => c.code === code);
+        if (!coupon) return { ok: false, error: "优惠券不存在" };
+
+        const cartInfo = computeCart();
+        if (cartInfo.subtotal < coupon.threshold) {
+          return { ok: false, error: `未达到优惠券满减门槛 (满${coupon.threshold}元可用)` };
+        }
+
+        shopState.appliedCouponCode = code;
+        computeCart();
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      getCart: function() {
+        return computeCart();
+      },
+
+      checkout: function(address) {
+        if (shopState.cart.length === 0) return { ok: false, error: "购物车为空，无法下单" };
+        if (!address || typeof address !== "object") return { ok: false, error: "收货信息不能为空" };
+        if (!address.name || typeof address.name !== "string" || !address.name.trim()) return { ok: false, error: "收货人姓名不能为空" };
+        if (!address.phone || !/^1\d{10}$/.test(String(address.phone).trim())) return { ok: false, error: "请输入有效的11位手机号码" };
+        if (!address.address || typeof address.address !== "string" || !address.address.trim()) return { ok: false, error: "收货地址不能为空" };
+
+        // Stock Check
+        for (const item of shopState.cart) {
+          const info = findVariant(item.sku);
+          if (!info || info.variant.stock < item.qty) {
+            return { ok: false, error: `商品 SKU [${item.sku}] 库存不足` };
+          }
+        }
+
+        // Deduct Stock
+        for (const item of shopState.cart) {
+          const info = findVariant(item.sku);
+          info.variant.stock -= item.qty;
+        }
+
+        const cartInfo = computeCart();
+        const orderId = "ORD-" + new Date().toISOString().replace(/[-:T.Z]/g, "").slice(0, 14) + "-" + Math.floor(100 + Math.random() * 900);
+
+        const order = {
+          id: orderId,
+          status: "pending",
+          createdAt: new Date().toISOString(),
+          paidAt: null,
+          items: cartInfo.lines.map(l => ({ sku: l.sku, qty: l.qty, unitPrice: l.unitPrice })),
+          subtotal: cartInfo.subtotal,
+          discounts: cartInfo.discounts,
+          payable: cartInfo.total,
+          refundedAmount: 0,
+          refunds: [],
+          address: {
+            name: address.name.trim(),
+            phone: String(address.phone).trim(),
+            address: address.address.trim()
+          }
+        };
+
+        shopState.orders.unshift(order);
+        shopState.cart = [];
+        shopState.appliedCouponCode = null;
+
+        logAction("生成订单", `订单号: ${orderId}, 实付: ¥${order.payable}`);
+        saveState();
+        renderAll();
+        return { ok: true, orderId: orderId };
+      },
+
+      prepareCheckout: function(address) {
+        if (shopState.cart.length === 0) return { ok: false, error: "购物车为空，无法下单" };
+        if (!address || typeof address !== "object") return { ok: false, error: "收货信息不能为空" };
+        if (!address.name || typeof address.name !== "string" || !address.name.trim()) return { ok: false, error: "收货人姓名不能为空" };
+        if (!address.phone || !/^1\d{10}$/.test(String(address.phone).trim())) return { ok: false, error: "请输入有效的11位手机号码" };
+        if (!address.address || typeof address.address !== "string" || !address.address.trim()) return { ok: false, error: "收货地址不能为空" };
+
+        // Populate fields and open modal
+        document.getElementById("shipNameInput").value = address.name;
+        document.getElementById("shipPhoneInput").value = address.phone;
+        document.getElementById("shipAddressInput").value = address.address;
+        openCheckoutModal();
+        return { ok: true };
+      },
+
+      pay: function(orderId) {
+        const order = shopState.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "pending") return { ok: false, error: "只有待付款订单可以进行支付" };
+
+        order.status = "paid";
+        order.paidAt = new Date().toISOString();
+
+        logAction("模拟支付", `订单号: ${orderId}, 支付金额: ¥${order.payable}`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      ship: function(orderId) {
+        const order = shopState.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "paid") return { ok: false, error: "只有已付款订单可以发货" };
+
+        order.status = "shipped";
+
+        logAction("模拟发货", `订单号: ${orderId}`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      cancel: function(orderId) {
+        const order = shopState.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "pending" && order.status !== "paid") {
+          return { ok: false, error: "只能取消待付款或已付款未发货的订单" };
+        }
+
+        const prevStatus = order.status;
+        order.status = "cancelled";
+
+        // Release unrefunded stock for unshipped orders
+        for (const item of order.items) {
+          const prevRefundedQty = order.refunds.reduce((sum, r) => {
+            const rItem = r.items.find(ri => ri.sku === item.sku);
+            return sum + (rItem ? rItem.qty : 0);
+          }, 0);
+          const unrefundedQty = item.qty - prevRefundedQty;
+          if (unrefundedQty > 0) {
+            const info = findVariant(item.sku);
+            if (info) info.variant.stock += unrefundedQty;
+          }
+        }
+
+        // If paid order cancelled, auto-create refund record for remaining paid amount
+        if (prevStatus === "paid") {
+          const remainingPayable = Math.round((order.payable - order.refundedAmount) * 100) / 100;
+          if (remainingPayable > 0) {
+            const cancelRefundItems = order.items.map(it => {
+              const prevRefundedQty = order.refunds.reduce((sum, r) => {
+                const rItem = r.items.find(ri => ri.sku === it.sku);
+                return sum + (rItem ? rItem.qty : 0);
+              }, 0);
+              return { sku: it.sku, qty: it.qty - prevRefundedQty };
+            }).filter(i => i.qty > 0);
+
+            const refundId = "REF-CANCEL-" + Date.now();
+            order.refunds.push({
+              id: refundId,
+              items: cancelRefundItems,
+              amount: remainingPayable,
+              returnGoods: false,
+              restocked: false // stock was already released above by cancel
+            });
+            order.refundedAmount = Math.round((order.refundedAmount + remainingPayable) * 100) / 100;
+          }
+        }
+
+        logAction("取消订单", `订单号: ${orderId}, 原状态: ${prevStatus}`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      requestAfterSale: function(orderId, items, options) {
+        const order = shopState.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "paid" && order.status !== "shipped") {
+          return { ok: false, error: "只能对已付款或已发货订单申请售后" };
+        }
+        if (!Array.isArray(items) || items.length === 0) {
+          return { ok: false, error: "请选择退款商品" };
+        }
+
+        const returnGoods = !!(options && options.returnGoods);
+
+        // Validation of items & quantities
+        for (const reqItem of items) {
+          const orderItem = order.items.find(i => i.sku === reqItem.sku);
+          if (!orderItem) return { ok: false, error: `订单中未包含商品 SKU [${reqItem.sku}]` };
+          if (!Number.isInteger(reqItem.qty) || reqItem.qty <= 0) {
+            return { ok: false, error: "退款数量必须为正整数" };
+          }
+
+          const prevRefundedQty = order.refunds.reduce((sum, r) => {
+            const rItem = r.items.find(ri => ri.sku === reqItem.sku);
+            return sum + (rItem ? rItem.qty : 0);
+          }, 0);
+
+          const maxRefundable = orderItem.qty - prevRefundedQty;
+          if (reqItem.qty > maxRefundable) {
+            return { ok: false, error: `SKU [${reqItem.sku}] 超出最大可退数量 (剩余可退: ${maxRefundable})` };
+          }
+        }
+
+        // Check if all items in the order are completely refunded after this refund
+        let allFullyRefunded = true;
+        for (const orderItem of order.items) {
+          const prevRefundedQty = order.refunds.reduce((sum, r) => {
+            const rItem = r.items.find(ri => ri.sku === orderItem.sku);
+            return sum + (rItem ? rItem.qty : 0);
+          }, 0);
+          const reqItem = items.find(i => i.sku === orderItem.sku);
+          const reqQty = reqItem ? reqItem.qty : 0;
+          if (prevRefundedQty + reqQty < orderItem.qty) {
+            allFullyRefunded = false;
+            break;
+          }
+        }
+
+        const remainingPayable = Math.round((order.payable - order.refundedAmount) * 100) / 100;
+        let amount = 0;
+
+        if (allFullyRefunded) {
+          amount = remainingPayable;
+        } else {
+          let sumRatio = 0;
+          for (const reqItem of items) {
+            const orderItem = order.items.find(i => i.sku === reqItem.sku);
+            sumRatio += reqItem.qty * orderItem.unitPrice * (order.payable / order.subtotal);
+          }
+          amount = Math.round(sumRatio * 100) / 100;
+          if (amount > remainingPayable) {
+            amount = remainingPayable;
+          }
+        }
+
+        const refundId = "REF-" + Date.now() + "-" + Math.floor(100 + Math.random() * 900);
+        const refundRecord = {
+          id: refundId,
+          items: items.map(i => ({ sku: i.sku, qty: i.qty })),
+          amount: amount,
+          returnGoods: returnGoods,
+          restocked: false
+        };
+
+        order.refunds.push(refundRecord);
+        order.refundedAmount = Math.round((order.refundedAmount + amount) * 100) / 100;
+
+        logAction("申请售后", `订单: ${orderId}, 售后单: ${refundId}, 金额: ¥${amount}, 退货入库: ${returnGoods ? "是" : "否"}`);
+        saveState();
+        renderAll();
+        return { ok: true, refundId: refundId, amount: amount };
+      },
+
+      confirmReturn: function(refundId) {
+        let targetOrder = null;
+        let targetRefund = null;
+
+        for (const order of shopState.orders) {
+          const ref = order.refunds.find(r => r.id === refundId);
+          if (ref) {
+            targetOrder = order;
+            targetRefund = ref;
+            break;
+          }
+        }
+
+        if (!targetRefund || !targetOrder) {
+          return { ok: false, error: "售后单不存在" };
+        }
+        if (targetRefund.restocked) {
+          return { ok: false, error: "该售后单已确认入库，请勿重复操作" };
+        }
+        if (targetOrder.status !== "shipped") {
+          return { ok: false, error: "只有已发货订单可以确认退货入库" };
+        }
+        if (!targetRefund.returnGoods) {
+          return { ok: false, error: "该售后单未包含退货商品" };
+        }
+
+        // Restock items
+        for (const item of targetRefund.items) {
+          const info = findVariant(item.sku);
+          if (info) {
+            info.variant.stock += item.qty;
+          }
+        }
+        targetRefund.restocked = true;
+
+        logAction("确认退货入库", `售后单: ${refundId}, 关联订单: ${targetOrder.id}`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      },
+
+      queryOrders: function(filters) {
+        filters = filters || {};
+        return shopState.orders.filter(order => {
+          if (filters.orderId && !order.id.toLowerCase().includes(filters.orderId.toLowerCase())) return false;
+          if (filters.sku && !order.items.some(it => it.sku === filters.sku)) return false;
+          if (filters.status && order.status !== filters.status) return false;
+          const orderDate = order.createdAt.slice(0, 10);
+          if (filters.from && orderDate < filters.from) return false;
+          if (filters.to && orderDate > filters.to) return false;
+          return true;
+        });
+      },
+
+      getStats: function() {
+        let sales = 0;
+        let refunds = 0;
+        const unitsSold = {};
+
+        // Initialize unitsSold map for all SKUs
+        for (const p of shopState.products) {
+          for (const v of p.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const order of shopState.orders) {
+          if (order.paidAt !== null) {
+            sales += order.payable;
+            for (const item of order.items) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+            }
+          }
+          for (const ref of order.refunds) {
+            refunds += ref.amount;
+            if (order.paidAt !== null) {
+              for (const refItem of ref.items) {
+                unitsSold[refItem.sku] = (unitsSold[refItem.sku] || 0) - refItem.qty;
+              }
+            }
+          }
+        }
+
+        sales = Math.round(sales * 100) / 100;
+        refunds = Math.round(refunds * 100) / 100;
+        const net = Math.round((sales - refunds) * 100) / 100;
+
+        return { sales, refunds, net, unitsSold };
+      },
+
+      exportData: function() {
+        return JSON.stringify({
+          products: shopState.products,
+          coupons: shopState.coupons,
+          isMember: shopState.isMember,
+          cart: shopState.cart,
+          appliedCouponCode: shopState.appliedCouponCode,
+          orders: shopState.orders,
+          logs: shopState.logs
+        }, null, 2);
+      },
+
+      importData: function(jsonString) {
+        try {
+          const data = JSON.parse(jsonString);
+          if (!data || typeof data !== "object") {
+            return { ok: false, error: "无法解析JSON格式" };
+          }
+          if (!Array.isArray(data.products) || !Array.isArray(data.orders)) {
+            return { ok: false, error: "导入文件格式错误：必须包含 products 和 orders 列表" };
+          }
+          for (const p of data.products) {
+            if (!p.id || !p.name || !Array.isArray(p.variants)) {
+              return { ok: false, error: "导入商品数据结构不完整" };
+            }
+          }
+          for (const o of data.orders) {
+            if (!o.id || !o.status || !Array.isArray(o.items) || typeof o.payable !== "number") {
+              return { ok: false, error: "导入订单数据结构不完整" };
+            }
+          }
+
+          shopState.products = data.products;
+          shopState.orders = data.orders;
+          shopState.coupons = data.coupons || deepClone(INITIAL_COUPONS);
+          shopState.isMember = !!data.isMember;
+          shopState.cart = data.cart || [];
+          shopState.appliedCouponCode = data.appliedCouponCode || null;
+          shopState.logs = data.logs || [];
+
+          logAction("恢复备份", "成功从JSON文件导入系统数据");
+          saveState();
+          renderAll();
+          return { ok: true };
+        } catch (e) {
+          return { ok: false, error: "JSON语法错误: " + e.message };
+        }
+      }
+    };
