+
+    function submitAfterSaleAction(orderId) {
+      const qtyInputs = document.querySelectorAll(".aftersale-qty");
+      const items = [];
+      qtyInputs.forEach(input => {
+        const sku = input.getAttribute("data-sku");
+        const qty = parseInt(input.value, 10);
+        if (qty > 0) {
+          items.push({ sku, qty });
+        }
+      });
+
+      if (items.length === 0) {
+        showToast("请至少选择一件商品的退款数量", "error");
+        return;
+      }
+
+      const returnGoods = document.getElementById("aftersaleReturnGoods").value === "true";
+
+      const res = window.shopTestAPI.requestAfterSale(orderId, items, { returnGoods });
+      if (res.ok) {
+        closeModal("afterSaleModal");
+        showToast(`售后申请成功！退款金额: ¥${res.amount.toFixed(2)}`);
