+    function submitAfterSaleModal(orderId) {
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) return;
+
+      const itemsToRefund = [];
+      for (const item of order.items) {
+        const qtyInput = document.getElementById(`aftersale-qty-${item.sku}`);
+        if (qtyInput) {
