+        if (ref) {
+          targetOrder = order;
+          targetRefund = ref;
+          break;
+        }
+      }
+
+      if (!targetRefund) {
+        return { ok: false, error: "售后退款单不存在" };
+      }
+
+      if (targetRefund.restocked) {
+        return { ok: false, error: "该售后单已入库，不可重复入库" };
+      }
+
+      for (const item of targetRefund.items) {
+        const found = findVariant(item.sku);
+        if (found) {
+          found.variant.stock += item.qty;
+        }
+      }
+
+      targetRefund.restocked = true;
+      addLog("退货入库", `售后单 ${refundId} 确认入库，库存已回补`);
