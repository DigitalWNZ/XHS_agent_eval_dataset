+      confirmReturn(refundId) {
+        let targetOrder = null;
+        let targetRefund = null;
+
+        for (const o of this.orders) {
+          const r = o.refunds.find(ref => ref.id === refundId);
+          if (r) {
+            targetOrder = o;
+            targetRefund = r;
+            break;
+          }
+        }
+
+        if (!targetRefund) return { ok: false, error: "退款单不存在" };
+        if (targetOrder.status !== "shipped") return { ok: false, error: "非发货状态订单不可确认退货入库" };
+        if (targetRefund.restocked) return { ok: false, error: "该退款单已入库，不可重复入库" };
+
+        for (const item of targetRefund.items) {
+          const vInfo = this.getVariant(item.sku);
+          if (vInfo) vInfo.variant.stock += item.qty;
+        }
+
+        targetRefund.restocked = true;
+        this.addLog("确认退货入库", `退款单号: ${refundId}`);
+        this.saveState();
+        this.render();
+        return { ok: true };
