+      queryOrders({ orderId, sku, status, from, to } = {}) {
+        return this.orders.filter(order => {
+          if (orderId && !order.id.includes(orderId)) return false;
+          if (sku && !order.items.some(i => i.sku === sku)) return false;
+          if (status && order.status !== status) return false;
+
+          const orderDateStr = order.createdAt.substring(0, 10);
+          if (from && orderDateStr < from) return false;
+          if (to && orderDateStr > to) return false;
+
+          return true;
+        });
+      }
+
+      getStats() {
+        let sales = 0;
+        let refunds = 0;
+        const unitsSold = {};
+
+        for (const p of this.products) {
+          for (const v of p.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const order of this.orders) {
+          for (const ref of order.refunds) {
+            refunds = round2(refunds + ref.amount);
+          }
+
+          if (order.paidAt !== null) {
+            sales = round2(sales + order.payable);
+
+            for (const item of order.items) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+            }
+
+            for (const ref of order.refunds) {
+              for (const refItem of ref.items) {
+                unitsSold[refItem.sku] = (unitsSold[refItem.sku] || 0) - refItem.qty;
+              }
+            }
+          }
+        }
+
+        const net = round2(sales - refunds);
+        return { sales, refunds, net, unitsSold };
+      }
