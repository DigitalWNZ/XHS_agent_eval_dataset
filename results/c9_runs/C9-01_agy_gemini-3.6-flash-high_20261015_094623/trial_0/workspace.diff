+        const newOrder = {
+          id: orderId,
+          status: "pending",
+          createdAt: new Date().toISOString(),
+          paidAt: null,
+          address: { name: name.trim(), phone: phone.trim(), address: addrStr.trim() },
+          items: cartCalc.lines.map(l => ({ sku: l.sku, qty: l.qty, unitPrice: l.unitPrice })),
+          subtotal: cartCalc.subtotal,
+          discounts: JSON.parse(JSON.stringify(cartCalc.discounts)),
+          payable: cartCalc.total,
+          refundedAmount: 0.00,
+          refunds: []
+        };
+
+        this.orders.unshift(newOrder);
+        this.addLog("创建订单", `订单号: ${orderId}, 实付: ¥${cartCalc.total}`);
