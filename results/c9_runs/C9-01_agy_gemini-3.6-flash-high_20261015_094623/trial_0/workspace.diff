+        return { ok: true, orderId: orderId };
+      }
+
+      pay(orderId) {
+        const order = this.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "pending") return { ok: false, error: "当前订单状态不可付款" };
+
+        order.status = "paid";
+        order.paidAt = new Date().toISOString();
+        this.addLog("订单付款", `订单号: ${orderId}, 付款: ¥${order.payable}`);
+        this.saveState();
+        this.render();
+        return { ok: true };
+      }
+
+      ship(orderId) {
+        const order = this.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "paid") return { ok: false, error: "当前订单状态不可发货" };
+
+        order.status = "shipped";
+        this.addLog("订单发货", `订单号: ${orderId}`);
+        this.saveState();
+        this.render();
+        return { ok: true };
+      }
+
+      cancel(orderId) {
+        const order = this.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "pending" && order.status !== "paid") {
+          return { ok: false, error: "已发货或已取消的订单不可取消" };
+        }
+
+        if (order.status === "pending") {
+          // Un-reserve stock
+          for (const item of order.items) {
+            const vInfo = this.getVariant(item.sku);
+            if (vInfo) vInfo.variant.stock += item.qty;
+          }
+          order.status = "cancelled";
+          this.addLog("取消订单", `未付款订单已取消: ${orderId}`);
+        } else if (order.status === "paid") {
+          // Restore stock for unshipped order
+          for (const item of order.items) {
+            const vInfo = this.getVariant(item.sku);
+            if (vInfo) vInfo.variant.stock += item.qty;
+          }
+
+          const remainingPayable = round2(order.payable - order.refundedAmount);
+          if (remainingPayable > 0) {
+            const unrefundedItems = [];
+            for (const item of order.items) {
+              let prevQty = 0;
+              for (const ref of order.refunds) {
+                const ri = ref.items.find(i => i.sku === item.sku);
+                if (ri) prevQty += ri.qty;
+              }
+              const rem = item.qty - prevQty;
+              if (rem > 0) unrefundedItems.push({ sku: item.sku, qty: rem });
+            }
+
+            const refundId = "REF-" + Date.now() + "-" + Math.floor(Math.random() * 899 + 100);
+            order.refunds.push({
+              id: refundId,
+              items: unrefundedItems,
+              amount: remainingPayable,
+              returnGoods: false,
+              restocked: true,
+              createdAt: new Date().toISOString()
+            });
+            order.refundedAmount = order.payable;
+          }
+
+          order.status = "cancelled";
+          this.addLog("取消订单", `已付款订单已取消: ${orderId}, 自动全额退款 ¥${remainingPayable}`);
+        }
+
+        this.saveState();
+        this.render();
+        return { ok: true };
+      }
+
+      requestAfterSale(orderId, items, options = {}) {
+        const order = this.orders.find(o => o.id === orderId);
+        if (!order) return { ok: false, error: "订单不存在" };
+        if (order.status !== "paid" && order.status !== "shipped") {
+          return { ok: false, error: "只有已付款或已发货订单可申请售后" };
+        }
+
+        if (!Array.isArray(items) || items.length === 0) {
+          return { ok: false, error: "请选择需要退货的商品" };
+        }
+
+        for (const reqItem of items) {
+          if (!Number.isInteger(reqItem.qty) || reqItem.qty <= 0) {
+            return { ok: false, error: "退款数量必须为正整数" };
+          }
+          const origItem = order.items.find(i => i.sku === reqItem.sku);
+          if (!origItem) {
+            return { ok: false, error: `订单中不包含商品 [${reqItem.sku}]` };
+          }
+
+          let prevRefundedQty = 0;
+          for (const ref of order.refunds) {
+            const ri = ref.items.find(i => i.sku === reqItem.sku);
+            if (ri) prevRefundedQty += ri.qty;
+          }
+
+          const remQty = origItem.qty - prevRefundedQty;
+          if (reqItem.qty > remQty) {
+            return { ok: false, error: `商品 [${reqItem.sku}] 申请数量 (${reqItem.qty}) 超过可退数量 (${remQty})` };
+          }
+        }
+
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+        if (remainingPayable <= 0) {
+          return { ok: false, error: "订单已无剩余可退金额" };
+        }
+
+        // Check if fully refunded after this request
+        let fullyRefundedAfter = true;
+        for (const origItem of order.items) {
+          let prevQty = 0;
+          for (const ref of order.refunds) {
+            const ri = ref.items.find(i => i.sku === origItem.sku);
+            if (ri) prevQty += ri.qty;
+          }
+          const reqItem = items.find(i => i.sku === origItem.sku);
+          const reqQty = reqItem ? reqItem.qty : 0;
+          if (prevQty + reqQty < origItem.qty) {
+            fullyRefundedAfter = false;
+            break;
+          }
+        }
+
+        let refundAmount = 0;
+        if (fullyRefundedAfter) {
+          refundAmount = remainingPayable;
+        } else {
+          let reqSubtotal = 0;
+          for (const reqItem of items) {
+            const origItem = order.items.find(i => i.sku === reqItem.sku);
+            reqSubtotal += reqItem.qty * origItem.unitPrice;
+          }
+          refundAmount = round2((reqSubtotal * order.payable) / order.subtotal);
+          if (refundAmount > remainingPayable) refundAmount = remainingPayable;
+        }
+
+        const returnGoods = !!options.returnGoods;
+        const refundId = "REF-" + Date.now() + "-" + Math.floor(Math.random() * 899 + 100);
+
+        let restocked = false;
+        if (order.status === "paid") {
+          // Paid but unshipped: restock immediately
+          for (const reqItem of items) {
+            const vInfo = this.getVariant(reqItem.sku);
+            if (vInfo) vInfo.variant.stock += reqItem.qty;
+          }
+          restocked = true;
+        }
+
+        order.refunds.push({
+          id: refundId,
+          items: items.map(i => ({ sku: i.sku, qty: i.qty })),
+          amount: refundAmount,
+          returnGoods: returnGoods,
+          restocked: restocked,
+          createdAt: new Date().toISOString()
+        });
+
+        order.refundedAmount = round2(order.refundedAmount + refundAmount);
+        this.addLog("申请售后退款", `订单: ${orderId}, 退款单: ${refundId}, 金额: ¥${refundAmount}`);
+
+        this.showRefundModal = false;
+        this.saveState();
+        this.render();
+
+        return { ok: true, refundId: refundId, amount: refundAmount };
+      }
