+        return { ok: true };
+      }
+
+      checkout(address) {
+        if (!address || typeof address !== 'object') {
+          return { ok: false, error: "请填写收货信息" };
+        }
+        const { name, phone, address: addrStr } = address;
+        if (!name || !name.trim()) return { ok: false, error: "请输入收货人姓名" };
+        if (!phone || !/^\d{11}$/.test(phone)) return { ok: false, error: "请输入有效的11位手机号码" };
+        if (!addrStr || !addrStr.trim()) return { ok: false, error: "请输入收货地址" };
+
+        if (this.cart.lines.length === 0) {
+          return { ok: false, error: "购物车为空，无法下单" };
+        }
+
+        // Validate stock
+        for (const line of this.cart.lines) {
+          const vInfo = this.getVariant(line.sku);
+          if (!vInfo || line.qty > vInfo.variant.stock) {
+            return { ok: false, error: `商品 [${line.sku}] 库存不足` };
+          }
+        }
