+        if (this.cart.couponCode) {
+          const coupon = this.coupons.find(c => c.code === this.cart.couponCode);
+          if (coupon && subtotal >= coupon.threshold) {
+            couponDiscount = round2(coupon.amount);
+            if (couponDiscount > 0) {
+              discounts.push({ type: "coupon", amount: couponDiscount });
+            }
+          }
+        }
+
+        const total = Math.max(0, round2(subtotal - memberDiscount - couponDiscount));
+
+        return {
+          lines,
+          subtotal,
+          discounts,
+          total
