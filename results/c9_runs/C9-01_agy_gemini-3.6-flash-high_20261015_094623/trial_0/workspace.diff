+
+      addToCart(sku, qty) {
+        const vInfo = this.getVariant(sku);
+        if (!vInfo) return { ok: false, error: "商品不存在" };
+        if (!Number.isInteger(qty) || qty <= 0) return { ok: false, error: "数量必须为正整数" };
+
+        const existing = this.cart.lines.find(l => l.sku === sku);
+        const currentQty = existing ? existing.qty : 0;
+        const newQty = currentQty + qty;
+
+        if (newQty > vInfo.variant.stock) {
+          return { ok: false, error: `库存不足，当前剩余库存为 ${vInfo.variant.stock}` };
+        }
+
+        if (existing) {
+          existing.qty = newQty;
+        } else {
+          this.cart.lines.push({ sku, qty: newQty });
+        }
+
+        this.saveState();
+        this.render();
+        return { ok: true };
+      }
+
+      setCartQty(sku, qty) {
+        const vInfo = this.getVariant(sku);
+        if (!vInfo) return { ok: false, error: "商品不存在" };
+        if (!Number.isInteger(qty) || qty < 0) return { ok: false, error: "非法数量" };
+
+        if (qty === 0) {
+          return this.removeFromCart(sku);
+        }
+
+        if (qty > vInfo.variant.stock) {
+          return { ok: false, error: `超出可用库存 (${vInfo.variant.stock})` };
+        }
+
+        const existing = this.cart.lines.find(l => l.sku === sku);
+        if (existing) {
+          existing.qty = qty;
+        } else {
+          this.cart.lines.push({ sku, qty });
+        }
+
+        this.saveState();
+        this.render();
+        return { ok: true };
+      }
+
+      removeFromCart(sku) {
+        this.cart.lines = this.cart.lines.filter(l => l.sku !== sku);
+        const cartCalc = this.getCart();
+        if (this.cart.couponCode) {
+          const coupon = this.coupons.find(c => c.code === this.cart.couponCode);
+          if (!coupon || cartCalc.subtotal < coupon.threshold) {
+            this.cart.couponCode = null;
+          }
+        }
+        this.saveState();
+        this.render();
+        return { ok: true };
+      }
+
+      applyCoupon(code) {
+        if (!code) {
+          this.cart.couponCode = null;
+          this.saveState();
+          this.render();
+          return { ok: true };
+        }
+        const coupon = this.coupons.find(c => c.code === code);
+        if (!coupon) return { ok: false, error: "优惠券不存在" };
+
+        const cartCalc = this.getCart();
+        if (cartCalc.subtotal < coupon.threshold) {
+          return { ok: false, error: `未达到优惠券使用门槛（满 ${coupon.threshold} 元可用）` };
+        }
