+      const returnGoods = options && options.returnGoods === true;
+
+      // Validate item quantities
+      for (const reqItem of items) {
+        if (!reqItem.sku || typeof reqItem.qty !== 'number' || reqItem.qty <= 0 || !Number.isInteger(reqItem.qty)) {
+          return { ok: false, error: "退款数量不正确" };
+        }
+        const orderItem = order.items.find(i => i.sku === reqItem.sku);
+        if (!orderItem) {
+          return { ok: false, error: `商品 ${reqItem.sku} 不存在于订单中` };
+        }
+
+        let cumulativeRefundedQty = 0;
+        for (const rf of order.refunds) {
+          for (const rfi of rf.items) {
+            if (rfi.sku === reqItem.sku) cumulativeRefundedQty += rfi.qty;
+          }
+        }
+
+        const remainingQty = orderItem.qty - cumulativeRefundedQty;
+        if (reqItem.qty > remainingQty) {
+          return { ok: false, error: `商品 ${reqItem.sku} 超出可退数量 (剩余可退 ${remainingQty} 件)` };
+        }
+      }
+
+      const remainingPayable = round2(order.payable - order.refundedAmount);
+      if (remainingPayable <= 0) {
+        return { ok: false, error: "该订单已无可退款金额" };
+      }
+
+      // Check if ALL items in order will be completely refunded after this refund request
+      let allFullyRefunded = true;
+      for (const orderItem of order.items) {
+        let cumulativeRefundedQty = 0;
+        for (const rf of order.refunds) {
+          for (const rfi of rf.items) {
+            if (rfi.sku === orderItem.sku) cumulativeRefundedQty += rfi.qty;
+          }
+        }
+        const req = items.find(i => i.sku === orderItem.sku);
+        const thisReqQty = req ? req.qty : 0;
+        if (cumulativeRefundedQty + thisReqQty !== orderItem.qty) {
+          allFullyRefunded = false;
+          break;
+        }
+      }
