+
+    // --- CORE BUSINESS FUNCTIONS & shopTestAPI IMPLEMENTATIONS ---
+
+    function resetAPI() {
+      state = JSON.parse(JSON.stringify(INITIAL_DATA));
+      saveState();
+      render();
+      return { ok: true };
+    }
+
+    function getStateAPI() {
+      return {
+        products: state.products,
+        coupons: state.coupons,
+        isMember: state.isMember,
+        orders: state.orders,
+        logs: state.logs
+      };
+    }
+
+    function setMemberAPI(isMember) {
+      state.isMember = Boolean(isMember);
+      saveState();
+      render();
+      return { ok: true };
+    }
+
+    function getCartAPI() {
+      let subtotal = 0;
+      const lines = state.cart.lines.map(line => {
+        const lineTotal = round2(line.qty * line.unitPrice);
+        subtotal += lineTotal;
+        return {
+          sku: line.sku,
+          qty: line.qty,
+          unitPrice: line.unitPrice,
+          lineTotal: lineTotal
+        };
+      });
+      subtotal = round2(subtotal);
+
+      const discounts = [];
+      if (lines.length > 0) {
+        if (state.isMember) {
+          const mAmount = round2(subtotal * 0.10);
+          if (mAmount > 0) {
+            discounts.push({ type: "member", amount: mAmount });
+          }
+        }
+        if (state.cart.activeCouponCode) {
+          const coupon = state.coupons.find(c => c.code === state.cart.activeCouponCode);
+          if (coupon && subtotal >= coupon.threshold && coupon.amount > 0) {
+            discounts.push({ type: "coupon", amount: round2(coupon.amount) });
+          }
+        }
+      }
+
+      const totalDiscount = round2(discounts.reduce((sum, d) => sum + d.amount, 0));
+      const total = round2(Math.max(0, subtotal - totalDiscount));
+
+      return {
+        lines,
+        subtotal,
+        discounts,
+        total
+      };
+    }
+
+    function addToCartAPI(sku, qty) {
+      if (typeof qty !== 'number' || qty <= 0 || !Number.isInteger(qty)) {
+        return { ok: false, error: "加购数量必须为大于0的整数" };
+      }
+      const variant = findVariant(sku);
+      if (!variant) {
+        return { ok: false, error: "商品SKU不存在" };
+      }
+      const existingLine = state.cart.lines.find(l => l.sku === sku);
+      const currentQty = existingLine ? existingLine.qty : 0;
+      if (currentQty + qty > variant.stock) {
+        return { ok: false, error: `库存不足，最大库存为 ${variant.stock}` };
+      }
+      if (existingLine) {
+        existingLine.qty += qty;
+      } else {
+        state.cart.lines.push({
+          sku: sku,
+          qty: qty,
+          unitPrice: variant.price
+        });
+      }
+      saveState();
+      render();
+      return { ok: true };
+    }
+
+    function setCartQtyAPI(sku, qty) {
+      if (typeof qty !== 'number' || !Number.isInteger(qty) || qty < 0) {
+        return { ok: false, error: "数量格式不正确" };
+      }
+      const lineIndex = state.cart.lines.findIndex(l => l.sku === sku);
+      if (lineIndex === -1) {
+        return { ok: false, error: "购物车中不存在该商品" };
+      }
+      if (qty === 0) {
+        state.cart.lines.splice(lineIndex, 1);
+        saveState();
+        render();
+        return { ok: true };
+      }
+      const variant = findVariant(sku);
+      if (!variant) {
+        return { ok: false, error: "商品SKU不存在" };
+      }
+      if (qty > variant.stock) {
+        return { ok: false, error: `库存不足，最大可用库存为 ${variant.stock}` };
+      }
+      state.cart.lines[lineIndex].qty = qty;
+      saveState();
+      render();
+      return { ok: true };
+    }
+
+    function removeFromCartAPI(sku) {
+      const lineIndex = state.cart.lines.findIndex(l => l.sku === sku);
+      if (lineIndex !== -1) {
+        state.cart.lines.splice(lineIndex, 1);
+        saveState();
+        render();
+        return { ok: true };
+      }
+      return { ok: false, error: "购物车中无该商品" };
+    }
+
+    function applyCouponAPI(code) {
+      if (code === null || code === "") {
+        state.cart.activeCouponCode = null;
+        saveState();
+        render();
+        return { ok: true };
+      }
+      const coupon = state.coupons.find(c => c.code === code);
