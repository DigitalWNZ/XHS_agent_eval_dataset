+    }
+
+    // LocalStorage Management
+    const STORAGE_KEY = "TRENDY_TOY_SHOP_DATA";
+    function loadState() {
+      try {
+        const raw = localStorage.getItem(STORAGE_KEY);
+        if (raw) {
+          state = JSON.parse(raw);
