+
+    function updateAftersalesPreview() {
+      const orderId = document.getElementById("aftersalesOrderSelect") ? document.getElementById("aftersalesOrderSelect").value : "";
+      const previewBox = document.getElementById("aftersalesPreviewBox");
+      if (!previewBox) return;
+
+      const order = state.orders.find(o => o.id === orderId);
+      if (!order) {
+        previewBox.style.display = "none";
+        return;
+      }
+
+      const checks = document.querySelectorAll(".aftersales-item-check");
+      const reqItems = [];
+      checks.forEach(chk => {
+        if (chk.checked) {
+          const sku = chk.getAttribute("data-sku");
+          const qtyInput = document.querySelector(`.aftersales-item-qty[data-sku="${sku}"]`);
+          const qty = qtyInput ? (parseInt(qtyInput.value) || 0) : 0;
+          if (qty > 0) reqItems.push({ sku, qty });
+        }
+      });
+
+      if (reqItems.length === 0) {
+        previewBox.style.display = "none";
+        return;
+      }
+
+      // Proportional math calculation preview
+      const remainingPayable = round2(order.payable - order.refundedAmount);
+      let allFullyRefunded = true;
+      for (const orderItem of order.items) {
+        let cumulativeRefundedQty = 0;
+        for (const rf of order.refunds) {
+          for (const rfi of rf.items) {
+            if (rfi.sku === orderItem.sku) cumulativeRefundedQty += rfi.qty;
+          }
+        }
+        const req = reqItems.find(i => i.sku === orderItem.sku);
+        const thisReqQty = req ? req.qty : 0;
+        if (cumulativeRefundedQty + thisReqQty !== orderItem.qty) {
+          allFullyRefunded = false;
+          break;
+        }
+      }
+
+      let estAmount = 0;
+      if (allFullyRefunded) {
+        estAmount = remainingPayable;
+      } else {
+        let rawSum = 0;
+        for (const reqItem of reqItems) {
+          const orderItem = order.items.find(i => i.sku === reqItem.sku);
+          rawSum += reqItem.qty * orderItem.unitPrice;
+        }
+        estAmount = Math.min(round2(rawSum * order.payable / order.subtotal), remainingPayable);
+      }
+
+      previewBox.innerHTML = `
+        <div><b>退款金额计算预览:</b></div>
+        <div>原订单实付比例优惠分摊后，预计退款金额: <b style="color:var(--danger); font-size:15px;">¥${estAmount.toFixed(2)}</b></div>
+        <div style="font-size:11px; color:var(--gray-600); margin-top:4px;">
+          公式: Σ(数量×单价) × 实付(${order.payable}) ÷ 原价小计(${order.subtotal}) ${allFullyRefunded ? ' (全部退完分摊剩余尾数)' : ''}
+        </div>
+      `;
+      previewBox.style.display = "block";
+    }
