+        for (const reqItem of items) {
+          const orderItem = order.items.find(i => i.sku === reqItem.sku);
+          rawSum += reqItem.qty * orderItem.unitPrice;
+        }
+        const calc = round2(rawSum * order.payable / order.subtotal);
+        refundAmount = Math.min(calc, remainingPayable);
+      }
