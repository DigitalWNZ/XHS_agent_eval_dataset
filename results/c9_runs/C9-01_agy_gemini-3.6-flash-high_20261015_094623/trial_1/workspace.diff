+      }
+      state.cart.activeCouponCode = code;
+      saveState();
+      render();
+      return { ok: true };
+    }
+
+    function validateAddress(address) {
+      if (!address || typeof address !== 'object') {
+        return { ok: false, error: "收货信息不完整" };
+      }
+      const { name, phone, address: addrStr } = address;
+      if (!name || !String(name).trim()) {
+        return { ok: false, error: "姓名不能为空" };
+      }
+      const cleanPhone = String(phone || '').trim();
+      if (!cleanPhone || !/^\d{11}$/.test(cleanPhone)) {
+        return { ok: false, error: "手机号码格式不正确 (必须为11位数字)" };
+      }
+      if (!addrStr || !String(addrStr).trim()) {
+        return { ok: false, error: "收货地址不能为空" };
+      }
+      return { ok: true, clean: { name: String(name).trim(), phone: cleanPhone, address: String(addrStr).trim() } };
+    }
+
+    function prepareCheckoutAPI(address) {
+      if (!state.cart.lines || state.cart.lines.length === 0) {
+        return { ok: false, error: "购物车为空，无法结算" };
+      }
+      const val = validateAddress(address);
+      if (!val.ok) return val;
+
+      for (const line of state.cart.lines) {
+        const variant = findVariant(line.sku);
+        if (!variant || variant.stock < line.qty) {
+          return { ok: false, error: `商品 ${line.sku} 库存不足` };
+        }
+      }
+
+      pendingCheckoutAddress = val.clean;
+      renderCheckoutModal(true);
+      return { ok: true };
+    }
+
+    function checkoutAPI(address) {
+      if (isSubmittingCheckout) {
+        return { ok: false, error: "请勿重复提交" };
+      }
+
+      if (!state.cart.lines || state.cart.lines.length === 0) {
+        return { ok: false, error: "购物车为空，无法结算" };
+      }
+
+      const val = validateAddress(address);
+      if (!val.ok) return val;
+
+      // Stock check
+      for (const line of state.cart.lines) {
+        const variant = findVariant(line.sku);
+        if (!variant || variant.stock < line.qty) {
+          return { ok: false, error: `商品 ${line.sku} 库存不足` };
+        }
+      }
+
+      isSubmittingCheckout = true;
+      try {
+        const cartInfo = getCartAPI();
+
+        // Deduct stock
+        for (const line of state.cart.lines) {
+          const variant = findVariant(line.sku);
+          if (variant) {
+            // Find variant in state.products to mutate actual state
+            for (const p of state.products) {
+              const targetV = p.variants.find(v => v.sku === line.sku);
+              if (targetV) {
+                targetV.stock -= line.qty;
+              }
+            }
+          }
+        }
+
+        const newOrderId = "ORD-" + Date.now() + "-" + Math.floor(Math.random() * 1000);
+        const order = {
+          id: newOrderId,
+          status: "pending",
+          createdAt: new Date().toISOString(),
