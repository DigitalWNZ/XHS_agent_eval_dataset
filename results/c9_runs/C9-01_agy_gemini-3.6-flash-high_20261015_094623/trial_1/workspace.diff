+        for (const reqItem of items) {
+          for (const p of state.products) {
+            const targetV = p.variants.find(v => v.sku === reqItem.sku);
+            if (targetV) targetV.stock += reqItem.qty;
+          }
+        }
+        restocked = true;
+      }
