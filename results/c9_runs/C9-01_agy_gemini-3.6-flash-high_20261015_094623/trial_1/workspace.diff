+      for (const order of state.orders) {
+        if (order.paidAt !== null && order.paidAt !== undefined) {
+          sales += order.payable;
+
+          for (const item of order.items) {
+            unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+          }
+
+          for (const rf of order.refunds) {
+            for (const rfi of rf.items) {
+              unitsSold[rfi.sku] = (unitsSold[rfi.sku] || 0) - rfi.qty;
