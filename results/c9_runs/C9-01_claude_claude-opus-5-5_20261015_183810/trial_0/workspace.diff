+  pay: function(id){ return plain(run(function(){ return ops.pay(id); })); },
+  ship: function(id){ return plain(run(function(){ return ops.ship(id); })); },
+  cancel: function(id){ return plain(run(function(){ return ops.cancel(id); })); },
+  requestAfterSale: function(id, items, opts){
