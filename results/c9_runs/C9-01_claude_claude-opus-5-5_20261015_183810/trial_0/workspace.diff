+    subtotal:toYuan(cv.subtotal), discounts:cv.discounts.map(function(d){ var x = {type:d.type, amount:toYuan(d.amount), label:d.label}; if (d.code) x.code = d.code; return x; }),
+    total:toYuan(cv.total), couponCode:state.couponCode, couponApplied:cv.discounts.some(function(d){ return d.type === 'coupon'; }), isMember:state.isMember};
+}
+function plain(r){ return JSON.parse(JSON.stringify(r)); }
+window.shopTestAPI = {
+  reset: function(){ resetAll(); return {ok:true}; },
+  getState: function(){
+    return {products:productsOut(), coupons:couponsOut(), isMember:state.isMember, orders:state.orders.map(orderOut), logs:clone(state.logs), cart:cartOut()};
+  },
+  setMember: function(v){ return plain(run(function(){ return ops.setMember(v); })); },
+  addToCart: function(sku, qty){ return plain(run(function(){ return ops.addToCart(sku, qty); })); },
+  setCartQty: function(sku, qty){ return plain(run(function(){ return ops.setCartQty(sku, qty); })); },
+  removeFromCart: function(sku){ return plain(run(function(){ return ops.removeFromCart(sku); })); },
+  applyCoupon: function(code){ return plain(run(function(){ return ops.applyCoupon(code); })); },
+  getCart: function(){ return cartOut(); },
+  checkout: function(address){ return plain(run(function(){ return ops.checkout(address); })); },
+  prepareCheckout: function(address){
+    handlers.tab(document.querySelector('#tabs button[data-tab=pos]'));
+    return plain(prepareCheckout(address));
