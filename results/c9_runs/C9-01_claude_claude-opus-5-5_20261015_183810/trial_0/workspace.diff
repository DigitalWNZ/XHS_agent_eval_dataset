+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>潮玩小站 · 店员工作台</title>
+<style>
+:root{
+  --bg:#f4f5fa;--panel:#fff;--line:#e4e6ef;--text:#1f2333;--muted:#6b7085;
+  --primary:#5b43e0;--primary-soft:#ece8ff;--pink:#e5487f;--green:#18a058;--green-soft:#e3f6eb;
+  --orange:#e08a12;--orange-soft:#fdf1dc;--red:#d03050;--red-soft:#fde6ea;--gray-soft:#eef0f4;--blue:#2f7be0;--blue-soft:#e3eefc;
+}
+*{box-sizing:border-box}
+body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif;background:var(--bg);color:var(--text);font-size:14px}
+button,input,select,textarea{font:inherit;color:inherit}
+header{background:linear-gradient(90deg,#3b2aa8,#5b43e0 55%,#c23f88);color:#fff;padding:10px 20px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
+header h1{font-size:18px;margin:0;letter-spacing:1px}
+header h1 small{font-weight:normal;opacity:.8;font-size:12px;margin-left:6px}
+.member-switch{margin-left:auto;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.14);padding:6px 12px;border-radius:20px;cursor:pointer;user-select:none}
+.member-switch input{width:16px;height:16px}
+nav.tabs{display:flex;gap:4px;background:#fff;border-bottom:1px solid var(--line);padding:0 16px;position:sticky;top:0;z-index:5}
+nav.tabs button{border:0;background:none;padding:12px 16px;cursor:pointer;border-bottom:3px solid transparent;color:var(--muted);font-weight:600}
+nav.tabs button.on{color:var(--primary);border-bottom-color:var(--primary)}
+nav.tabs .badge{margin-left:4px}
+main{padding:16px 20px 40px}
+.tab{display:none}.tab.on{display:block}
+.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px}
+.panel h2{font-size:15px;margin:0 0 10px}
+.muted{color:var(--muted)}
+.small{font-size:12px}
+.btn{border:1px solid var(--line);background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;white-space:nowrap}
+.btn:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
+.btn:disabled{opacity:.45;cursor:not-allowed}
+.btn.primary{background:var(--primary);border-color:var(--primary);color:#fff}
+.btn.primary:hover:not(:disabled){background:#4a33cc;color:#fff}
+.btn.danger{background:var(--red);border-color:var(--red);color:#fff}
+.btn.danger:hover:not(:disabled){background:#b5223f;color:#fff}
+.btn.warn{background:var(--orange);border-color:var(--orange);color:#fff}
+.btn.ghost-danger{color:var(--red);border-color:#f2b8c4}
+.btn.sm{padding:3px 8px;font-size:12px}
+.btn.lg{padding:10px 18px;font-size:15px}
+input[type=text],input[type=number],input[type=date],input[type=tel],select,textarea{border:1px solid var(--line);border-radius:6px;padding:6px 8px;background:#fff;outline:none}
+input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 2px var(--primary-soft)}
+.badge{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;font-weight:600;line-height:18px}
+.b-pending{background:var(--orange-soft);color:var(--orange)}
+.b-paid{background:var(--blue-soft);color:var(--blue)}
+.b-shipped{background:var(--green-soft);color:var(--green)}
+.b-cancelled{background:var(--gray-soft);color:#777}
+.b-refund{background:var(--red-soft);color:var(--red)}
+.b-purple{background:var(--primary-soft);color:var(--primary)}
+table{border-collapse:collapse;width:100%}
+th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line);vertical-align:middle}
+th{font-size:12px;color:var(--muted);font-weight:600;background:#fafbfd}
+td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
+.money{font-variant-numeric:tabular-nums}
+.neg{color:var(--red)}
+/* POS */
+.pos{display:grid;grid-template-columns:1fr 380px;gap:16px;align-items:start}
+.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
+.filters input[type=text]{min-width:220px}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
+.card{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column}
+.thumb{height:74px;display:flex;align-items:center;padding:0 14px;gap:12px;color:#fff}
+.thumb span{width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700}
+.thumb em{font-style:normal;font-size:12px;background:rgba(0,0,0,.18);padding:2px 8px;border-radius:10px}
+.card-body{padding:10px 12px 12px;display:flex;flex-direction:column;gap:8px;flex:1}
+.card h3{margin:0;font-size:15px}
+.variants{display:flex;flex-wrap:wrap;gap:6px}
+.var{border:1px solid var(--line);background:#fff;border-radius:6px;padding:4px 8px;cursor:pointer;text-align:left;line-height:1.3}
+.var small{display:block;font-size:11px;color:var(--muted)}
+.var.on{border-color:var(--primary);background:var(--primary-soft)}
