+.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}
+.stat{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px 14px}
+.stat .lbl{color:var(--muted);font-size:12px}
+.stat .val{font-size:24px;font-weight:700;margin-top:4px;font-variant-numeric:tabular-nums}
+.stat .sub{font-size:12px;color:var(--muted);margin-top:2px}
+.bar{height:8px;background:var(--primary);border-radius:4px;min-width:2px}
+.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
+/* modal */
+.overlay{position:fixed;inset:0;background:rgba(20,22,40,.45);display:flex;align-items:center;justify-content:center;z-index:50;padding:20px}
+.modal{background:#fff;border-radius:12px;width:min(640px,100%);max-height:92vh;overflow:auto;box-shadow:0 20px 60px rgba(0,0,0,.25)}
+.modal header{background:none;color:var(--text);padding:14px 18px;border-bottom:1px solid var(--line);font-weight:700;font-size:16px}
+.modal .mbody{padding:14px 18px}
+.modal .mfoot{padding:12px 18px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}
+.modal.danger header{color:var(--red)}
+.steps{display:flex;gap:6px;margin-bottom:12px}
+.steps span{flex:1;text-align:center;padding:6px;border-radius:6px;background:var(--gray-soft);font-size:12px;color:var(--muted)}
+.steps span.on{background:var(--primary);color:#fff}
+.form-row{margin-bottom:10px}
+.form-row label{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}
+.form-row input,.form-row textarea{width:100%}
+.form-row input[type=radio],.form-row input[type=checkbox]{width:auto;margin-right:6px}
+.form-row label.opt{color:var(--text);font-size:13px;padding:3px 0;cursor:pointer}
+.form-row .err{color:var(--red);font-size:12px;margin-top:3px}
+.form-row.invalid input,.form-row.invalid textarea{border-color:var(--red)}
+#toastRoot{position:fixed;right:20px;bottom:20px;display:flex;flex-direction:column;gap:8px;z-index:100}
+.toast{background:#262a3d;color:#fff;padding:10px 14px;border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.2);max-width:360px}
+.toast.err{background:var(--red)}
+.toast.ok{background:var(--green)}
+textarea.code{width:100%;min-height:150px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
+@media (max-width:1100px){.pos,.orders-layout,.two-col{grid-template-columns:1fr}.cart{position:static}}
+</style>
+</head>
+<body>
+<header>
+  <h1>潮玩小站 <small>店员工作台 · 本地模拟收付款</small></h1>
+  <label class="member-switch" title="会员享 95 折，可与满减券叠加">
+    <input type="checkbox" id="memberToggle"> <span id="memberLabel">当前顾客：非会员</span>
+  </label>
+</header>
+<nav class="tabs" id="tabs">
+  <button data-act="tab" data-tab="pos" class="on">收银台</button>
+  <button data-act="tab" data-tab="orders">订单管理 <span class="badge b-pending" id="pendingCount"></span></button>
+  <button data-act="tab" data-tab="aftersale">售后 / 退货入库 <span class="badge b-refund" id="awaitCount"></span></button>
+  <button data-act="tab" data-tab="stats">统计与库存</button>
+  <button data-act="tab" data-tab="logs">操作记录</button>
+  <button data-act="tab" data-tab="data">数据备份</button>
+</nav>
+<main>
+  <section class="tab on" id="tab-pos">
+    <div class="pos">
+      <div>
+        <div class="filters panel">
+          <input type="text" id="fSearch" placeholder="搜索商品名 / 系列 / SKU / 规格">
+          <select id="fCat"></select>
+          <select id="fSort">
+            <option value="">默认排序</option>
+            <option value="price-asc">价格从低到高</option>
+            <option value="price-desc">价格从高到低</option>
+            <option value="stock-desc">库存从多到少</option>
+          </select>
+          <label class="small"><input type="checkbox" id="fInStock"> 仅显示有货</label>
+          <span class="muted small" id="fCount"></span>
+        </div>
+        <div class="grid" id="productGrid"></div>
+      </div>
+      <aside class="cart panel" id="cartPanel"></aside>
+    </div>
+  </section>
+
+  <section class="tab" id="tab-orders">
+    <div class="filters panel">
+      <input type="text" id="oId" placeholder="订单号">
+      <input type="text" id="oProd" placeholder="商品名 / SKU">
+      <select id="oStatus">
+        <option value="">全部状态</option>
+        <option value="pending">待付款</option>
+        <option value="paid">已付款</option>
+        <option value="shipped">已发货</option>
+        <option value="cancelled">已取消</option>
+      </select>
+      <label class="small"><input type="checkbox" id="oRefundOnly"> 仅看有退款</label>
+      <span class="small muted">下单日期</span>
+      <input type="date" id="oFrom"> <span class="muted">至</span> <input type="date" id="oTo">
+      <button class="btn" data-act="of-reset">清空筛选</button>
+      <span class="muted small" id="oCount"></span>
+    </div>
+    <div class="orders-layout">
+      <div class="panel" style="padding:0;overflow:auto" id="orderList"></div>
+      <div class="panel" id="orderDetail"></div>
+    </div>
+  </section>
+
+  <section class="tab" id="tab-aftersale">
+    <div class="panel" id="afterSaleView"></div>
+  </section>
+
+  <section class="tab" id="tab-stats">
+    <div id="statsView"></div>
+  </section>
+
+  <section class="tab" id="tab-logs">
+    <div class="filters panel">
+      <input type="text" id="lSearch" placeholder="搜索操作类型 / 订单号 / 内容">
+      <span class="muted small" id="lCount"></span>
+    </div>
+    <div class="panel" style="padding:0" id="logView"></div>
+  </section>
+
+  <section class="tab" id="tab-data">
+    <div class="two-col">
+      <div class="panel">
+        <h2>导出备份</h2>
+        <p class="muted small">导出全部商品、库存、优惠券、订单、售后、操作记录、购物车和会员状态（JSON）。</p>
+        <div class="actions">
+          <button class="btn primary" data-act="export-download">下载备份文件</button>
+          <button class="btn" data-act="export-show">在下方显示 JSON</button>
+        </div>
+        <textarea class="code" id="exportText" readonly placeholder="点击“在下方显示 JSON”"></textarea>
+      </div>
+      <div class="panel">
+        <h2>导入恢复</h2>
+        <p class="muted small">导入会<b>覆盖</b>当前全部数据。文件会先完整校验，校验不通过时不会改动现有数据。</p>
+        <div class="actions">
+          <input type="file" id="importFile" accept=".json,application/json">
+        </div>
+        <textarea class="code" id="importText" placeholder="或将备份 JSON 粘贴到这里"></textarea>
+        <div class="actions"><button class="btn warn" data-act="import-text">导入粘贴的 JSON</button></div>
+        <div id="importMsg"></div>
+        <h2 style="margin-top:20px">重置</h2>
+        <p class="muted small">恢复为初始演示商品与历史订单（当前数据将丢失，建议先导出备份）。</p>
+        <button class="btn ghost-danger" data-act="reset-data">恢复初始数据</button>
