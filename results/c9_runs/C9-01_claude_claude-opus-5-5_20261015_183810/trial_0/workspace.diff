+.var.soldout small{text-decoration:none}
+.buyrow{display:flex;align-items:center;gap:8px;margin-top:auto}
+.price{font-size:18px;font-weight:700;color:var(--pink);margin-right:auto}
+.stepper{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
+.stepper button{border:0;background:#f5f6fa;width:26px;cursor:pointer}
+.stepper input::-webkit-outer-spin-button,.stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
+.stepper input{-moz-appearance:textfield;width:44px;border:0;border-radius:0;text-align:center;padding:4px 2px}
