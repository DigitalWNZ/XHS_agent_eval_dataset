+<script>
+(function(){
+'use strict';
+
+/* ================= 常量与工具 ================= */
+var LS_KEY = 'toyshop-workbench-v1';
+var MEMBER_PCT = 95;               // 会员 95 折
+var STATUS = {pending:'待付款', paid:'已付款', shipped:'已发货', cancelled:'已取消'};
+var STATUS_LIST = ['pending','paid','shipped','cancelled'];
+
+function $(s){ return document.querySelector(s); }
+function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
+function toYuan(c){ return Math.round(c) / 100; }
+function toCents(v){ return Math.round(Number(v) * 100); }
+function fmt(c){ var s = (Math.abs(c) / 100).toFixed(2); return (c < 0 ? '-¥' : '¥') + s; }
+function clone(o){ return JSON.parse(JSON.stringify(o)); }
+function nowISO(){ return new Date().toISOString(); }
+function isInt(n){ return typeof n === 'number' && Number.isInteger(n); }
+function pad(n){ return String(n).padStart(2, '0'); }
+function localDate(iso){ var d = new Date(iso); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
+function fmtTime(iso){ if (!iso) return '—'; var d = new Date(iso); return localDate(iso) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()); }
+function validISO(s){ return typeof s === 'string' && s.length >= 10 && !isNaN(new Date(s).getTime()); }
+function sum(arr, f){ return arr.reduce(function(s, x){ return s + f(x); }, 0); }
+
+/* ================= 定价与优惠 ================= */
+function findCoupon(code, list){ return (list || state.coupons).find(function(c){ return c.code === code; }) || null; }
+
+// lines: [{qty, unitPrice(分)}]
+// 规则：会员折扣 = 原价合计 × 5%（四舍五入到分）；满减门槛按原价合计判断；两者可叠加；每单限一张券。
+function priceLines(lines, isMember, couponCode, coupons){
+  var subtotal = sum(lines, function(l){ return l.unitPrice * l.qty; });
+  var discounts = [];
+  var couponInfo = null;
+  if (isMember && subtotal > 0) {
+    var m = Math.round(subtotal * (100 - MEMBER_PCT) / 100);
+    if (m > 0) discounts.push({type:'member', amount:m, label:'会员 ' + (MEMBER_PCT / 10) + ' 折'});
+  }
+  if (couponCode) {
+    var c = findCoupon(couponCode, coupons);
+    if (c) {
+      var eligible = subtotal > 0 && subtotal >= c.threshold;
+      couponInfo = {code:c.code, eligible:eligible, short:Math.max(0, c.threshold - subtotal), coupon:c};
+      if (eligible) {
+        var room = subtotal - sum(discounts, function(d){ return d.amount; });
+        var a = Math.min(c.amount, room);
+        if (a > 0) discounts.push({type:'coupon', code:c.code, amount:a, label:c.name + '（' + c.code + '）'});
+      }
+    }
+  }
+  var total = subtotal - sum(discounts, function(d){ return d.amount; });
+  return {subtotal:subtotal, discounts:discounts, total:total, couponInfo:couponInfo};
+}
+
+/* ================= 初始数据 ================= */
+function seedState(){
+  function P(id, name, category, series, desc, hue, variants){
+    return {id:id, name:name, category:category, series:series, desc:desc, hue:hue,
+      variants: variants.map(function(v){ return {sku:v[0], spec:v[1], price:toCents(v[2]), stock:v[3]}; })};
+  }
+  var products = [
+    P('P01','星空兔 Lumi 系列盲盒','盲盒','Lumi 星空','第三弹，12 款常规 + 1 款隐藏',265,[
+      ['LUMI-1','单盒',59,120],['LUMI-12','整端（12 盒）',648,8],['LUMI-HID','隐藏款确认盒',299,2]]),
+    P('P02','机甲熊猫 MK-II 手办','手办','机甲动物园','1/12 可动，含替换配件',210,[
+      ['MKP-STD','标准版',399,15],['MKP-MET','限定金属色',599,3]]),
+    P('P03','糖果怪兽搪胶公仔','搪胶','糖果怪兽','软胶材质，可站立',330,[
+      ['CANDY-P15','15cm 草莓粉',129,30],['CANDY-M15','15cm 薄荷绿',129,0],['CANDY-P30','30cm 草莓粉',269,6]]),
+    P('P04','像素骑士积木','积木','像素王国','兼容主流颗粒',20,[
+      ['PXK-BASIC','基础骑士款',89,40],['PXK-CASTLE','豪华城堡款',459,5]]),
+    P('P05','云朵猫毛绒挂件','周边','云朵猫','10cm 包挂',190,[
+      ['CLOUD-W','奶白色',49,60],['CLOUD-G','烟灰色',49,25]]),
+    P('P06','Mini 城市景观盲盒','盲盒','Mini City','8 款街角微缩场景',160,[
+      ['MINI-1','单盒',45,200],['MINI-8','整盒（8 盒）',336,0]]),
