+  },
+  confirmReturn: function(rid){ return plain(run(function(){ return ops.confirmReturn(rid); })); },
+  queryOrders: function(f){
+    f = f || {};
+    return queryOrders({orderId:f.orderId, sku:f.sku, status:f.status, from:f.from, to:f.to}).map(orderOut);
+  },
+  getStats: function(){
+    var s = computeStats(), u = {};
+    Object.keys(s.unitsSold).forEach(function(k){ u[k] = s.unitsSold[k]; });
+    return {sales:toYuan(s.sales), refunds:toYuan(s.refunds), net:toYuan(s.net), unitsSold:u};
+  },
+  exportData: function(){ return JSON.stringify(exportObj()); },
+  importData: function(text){
+    if (typeof text !== 'string') return {ok:false, error:'导入内容必须是 JSON 字符串'};
