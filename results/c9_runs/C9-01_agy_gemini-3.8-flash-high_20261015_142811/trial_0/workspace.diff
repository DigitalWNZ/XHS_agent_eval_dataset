+
+      function updateAfterSalePreview() {
+        const order = state.orders.find(o => o.id === currentAfterSaleOrderId);
+        if (!order) return;
+
+        const checks = document.querySelectorAll('.aftersale-item-check:checked');
+        const items = [];
+        checks.forEach(chk => {
+          const sku = chk.dataset.sku;
+          const inp = document.querySelector(`.aftersale-qty-input[data-sku="${sku}"]`);
+          const qty = parseInt(inp ? inp.value : '1', 10);
+          if (qty > 0) items.push({ sku, qty });
+        });
+
+        const estEl = document.getElementById('aftersale-estimated-amount');
+        const descEl = document.getElementById('aftersale-calc-desc');
+
+        if (items.length === 0) {
+          estEl.textContent = '¥0.00';
+          descEl.textContent = '请勾选需要售后的商品规格';
+          return;
+        }
+
+        // Check if fully refunded
+        const refundedMap = {};
+        for (const ref of order.refunds) {
+          for (const rit of ref.items) {
+            refundedMap[rit.sku] = (refundedMap[rit.sku] || 0) + rit.qty;
+          }
+        }
+        const nextRefundedMap = { ...refundedMap };
+        for (const it of items) {
+          nextRefundedMap[it.sku] = (nextRefundedMap[it.sku] || 0) + it.qty;
+        }
+
+        const willBeFullyRefunded = order.items.every(it => (nextRefundedMap[it.sku] || 0) === it.qty);
+        const remainingPayable = round2(order.payable - order.refundedAmount);
+
+        let amount = 0;
+        if (willBeFullyRefunded) {
+          amount = remainingPayable;
+          descEl.textContent = '全部商品均已退完，本次退款为剩余全部实付金额';
+        } else {
+          let rawSum = 0;
+          for (const it of items) {
+            const oi = order.items.find(x => x.sku === it.sku);
+            if (oi) rawSum += it.qty * oi.unitPrice * order.payable / order.subtotal;
+          }
+          amount = round2(rawSum);
+          if (amount > remainingPayable) amount = remainingPayable;
+          descEl.textContent = `按优惠比例分摊计算 (原价 ¥${order.subtotal.toFixed(2)}，实付 ¥${order.payable.toFixed(2)})`;
+        }
+
+        estEl.textContent = `¥${amount.toFixed(2)}`;
+      }
