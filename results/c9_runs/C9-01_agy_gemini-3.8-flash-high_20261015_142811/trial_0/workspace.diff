+
+        importData: function (jsonStr) {
+          if (!jsonStr || typeof jsonStr !== 'string' || !jsonStr.trim()) {
+            return { ok: false, error: '导入数据不能为空' };
+          }
+          let parsed;
+          try {
+            parsed = JSON.parse(jsonStr);
+          } catch (e) {
+            return { ok: false, error: 'JSON 解析失败，格式错误' };
+          }
+          if (!parsed || typeof parsed !== 'object') {
+            return { ok: false, error: '导入数据必须为有效的 JSON 对象' };
+          }
+          if (!Array.isArray(parsed.products) || parsed.products.length === 0) {
+            return { ok: false, error: '缺少有效的商品列表 (products)' };
+          }
+          if (!Array.isArray(parsed.orders)) {
+            return { ok: false, error: '缺少有效的订单列表 (orders)' };
+          }
+
+          // Validate products structure
