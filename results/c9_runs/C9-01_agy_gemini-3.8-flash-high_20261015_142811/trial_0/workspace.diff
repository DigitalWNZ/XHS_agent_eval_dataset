+          } else if (order.status === 'paid') {
+            // Paid order cancelled before shipping:
+            // Calculate remaining items not yet refunded
+            const refundedMap = {};
+            for (const ref of order.refunds) {
+              for (const rItem of ref.items) {
+                refundedMap[rItem.sku] = (refundedMap[rItem.sku] || 0) + rItem.qty;
+              }
+            }
+
+            const remainingItems = [];
+            for (const item of order.items) {
+              const refundedQty = refundedMap[item.sku] || 0;
