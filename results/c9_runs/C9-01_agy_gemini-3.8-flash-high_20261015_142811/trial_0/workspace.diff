+          }
+
+          // Restock items
+          for (const item of foundRefund.items) {
+            const variant = findVariant(item.sku);
+            if (variant) {
+              variant.stock += item.qty;
+            }
+          }
+
+          foundRefund.restocked = true;
+          addLog('退货入库', `售后单 ${refundId} 确认入库，库存回补完成`);
+          saveStateToStorage();
+          renderAll();
+          return { ok: true };
