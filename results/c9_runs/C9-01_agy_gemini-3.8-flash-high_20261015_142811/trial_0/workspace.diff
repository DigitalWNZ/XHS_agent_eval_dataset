+
+        requestAfterSale: function (orderId, items, options) {
+          const order = state.orders.find(o => o.id === orderId);
+          if (!order) {
+            return { ok: false, error: `订单 ${orderId} 不存在` };
+          }
+          if (order.status !== 'paid' && order.status !== 'shipped') {
+            return { ok: false, error: `当前订单状态为 ${order.status}，仅已付款或已发货订单支持售后申请` };
+          }
+
+          if (!Array.isArray(items) || items.length === 0) {
+            return { ok: false, error: '售后商品列表不能为空' };
+          }
+
+          // Calculate refunded qty per SKU
+          const refundedMap = {};
+          for (const ref of order.refunds) {
+            for (const rItem of ref.items) {
+              refundedMap[rItem.sku] = (refundedMap[rItem.sku] || 0) + rItem.qty;
+            }
+          }
+
+          // Validate requested items
+          for (const reqItem of items) {
+            if (!reqItem.sku || typeof reqItem.sku !== 'string') {
+              return { ok: false, error: '商品规格 SKU 无效' };
+            }
+            if (!Number.isInteger(reqItem.qty) || reqItem.qty <= 0) {
+              return { ok: false, error: '申请售后数量必须为正整数' };
+            }
+            const orderItem = order.items.find(it => it.sku === reqItem.sku);
+            if (!orderItem) {
+              return { ok: false, error: `订单中不包含商品规格 ${reqItem.sku}` };
+            }
+            const refundable = orderItem.qty - (refundedMap[reqItem.sku] || 0);
+            if (reqItem.qty > refundable) {
+              return { ok: false, error: `商品规格 ${reqItem.sku} 申请售后数量 (${reqItem.qty}) 超过可退数量 (${refundable})` };
+            }
+          }
+
+          // Check if all items in order will be completely refunded after this refund
+          const nextRefundedMap = { ...refundedMap };
+          for (const reqItem of items) {
+            nextRefundedMap[reqItem.sku] = (nextRefundedMap[reqItem.sku] || 0) + reqItem.qty;
+          }
+
+          const willBeFullyRefunded = order.items.every(orderItem =>
+            (nextRefundedMap[orderItem.sku] || 0) === orderItem.qty
+          );
+
+          const remainingPayable = round2(order.payable - order.refundedAmount);
+          if (remainingPayable <= 0) {
+            return { ok: false, error: '该订单已无可退金额' };
+          }
+
+          let amount = 0;
+          if (willBeFullyRefunded) {
+            // 当订单商品全部退完时，最后一次退款为剩余实付
+            amount = remainingPayable;
+          } else {
+            // 本次退款 = Σ 数量 × 单价 × 实付 ÷ 商品原价合计，四舍五入到分
+            let rawSum = 0;
+            for (const reqItem of items) {
+              const orderItem = order.items.find(it => it.sku === reqItem.sku);
+              rawSum += reqItem.qty * orderItem.unitPrice * order.payable / order.subtotal;
+            }
+            amount = round2(rawSum);
+            if (amount > remainingPayable) {
+              amount = remainingPayable;
+            }
+          }
+
+          const returnGoods = order.status === 'shipped' ? Boolean(options?.returnGoods) : false;
+          // 已发货商品不能仅因退款申请就增加库存；只有确认退货入库后才回补
+          // 未发货订单直接在库释放
+          const restocked = order.status === 'paid';
+
+          if (order.status === 'paid') {
+            for (const reqItem of items) {
+              const variant = findVariant(reqItem.sku);
+              if (variant) variant.stock += reqItem.qty;
+            }
+          }
+
+          const refundId = 'REF-' + new Date().toISOString().replace(/\D/g, '').slice(0, 14) + '-' + Math.floor(100 + Math.random() * 900);
+          const refundRecord = {
+            id: refundId,
+            items: items.map(it => ({ sku: it.sku, qty: it.qty })),
+            amount: amount,
+            returnGoods: returnGoods,
+            restocked: restocked
+          };
+
+          order.refunds.push(refundRecord);
+          order.refundedAmount = round2(order.refundedAmount + amount);
+
+          addLog('售后申请', `订单 ${orderId} 申请售后成功，分摊退款 ¥${amount.toFixed(2)}，售后编号 ${refundId}`);
+          saveStateToStorage();
+          renderAll();
+
+          return { ok: true, refundId, amount };
+        },
+
+        confirmReturn: function (refundId) {
+          if (!refundId) {
+            return { ok: false, error: '缺少售后单编号' };
+          }
+
+          let foundOrder = null;
+          let foundRefund = null;
+
+          for (const o of state.orders) {
+            if (Array.isArray(o.refunds)) {
+              for (const r of o.refunds) {
+                if (r.id === refundId) {
+                  foundOrder = o;
+                  foundRefund = r;
+                  break;
+                }
+              }
