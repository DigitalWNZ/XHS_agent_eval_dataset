+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (parsed && Array.isArray(parsed.products) && Array.isArray(parsed.orders)) {
+              state.products = parsed.products;
+              state.coupons = Array.isArray(parsed.coupons) ? parsed.coupons : deepClone(INITIAL_COUPONS);
+              state.isMember = Boolean(parsed.isMember);
+              state.appliedCouponCode = parsed.appliedCouponCode || null;
+              state.cart = Array.isArray(parsed.cart) ? parsed.cart : [];
+              state.orders = parsed.orders;
+              state.logs = Array.isArray(parsed.logs) ? parsed.logs : deepClone(INITIAL_LOGS);
+              return;
+            }
