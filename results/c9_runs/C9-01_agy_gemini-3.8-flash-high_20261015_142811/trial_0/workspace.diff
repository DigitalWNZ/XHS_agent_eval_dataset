+
+        getStats: function () {
+          // sales = 所有曾付款订单（paidAt 非空，含之后取消或退款的）实付合计
+          // refunds = 全部退款记录合计
+          // net = sales − refunds
+          // unitsSold = 曾付款订单中各 SKU 数量 − 已退数量
+          let sales = 0;
+          let refunds = 0;
+          const unitsSold = {};
+
+          // Initialize all known SKUs with 0
+          for (const p of state.products) {
+            for (const v of p.variants) {
+              unitsSold[v.sku] = 0;
+            }
+          }
+
+          for (const order of state.orders) {
+            if (order.paidAt !== null && order.paidAt !== undefined) {
+              sales += order.payable;
+              // Add ordered quantities
+              for (const it of order.items) {
+                unitsSold[it.sku] = (unitsSold[it.sku] || 0) + it.qty;
+              }
+              // Subtract refunded quantities
+              if (Array.isArray(order.refunds)) {
+                for (const ref of order.refunds) {
+                  if (Array.isArray(ref.items)) {
+                    for (const rit of ref.items) {
+                      unitsSold[rit.sku] = (unitsSold[rit.sku] || 0) - rit.qty;
+                    }
+                  }
+                }
+              }
+            }
+
+            // Sum all refunds in the system
+            if (Array.isArray(order.refunds)) {
+              for (const ref of order.refunds) {
+                refunds += ref.amount;
+              }
+            }
+          }
+
+          sales = round2(sales);
+          refunds = round2(refunds);
+          const net = round2(sales - refunds);
+
+          return {
+            sales,
+            refunds,
+            net,
+            unitsSold
+          };
+        },
