+      /* --- After-Sale Modal Controller --- */
+      let currentAfterSaleOrderId = null;
+
+      function openAfterSaleModal(orderId) {
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) return;
+        currentAfterSaleOrderId = orderId;
+
+        document.getElementById('aftersale-modal-title').textContent = `↩️ 订单 ${order.id} 售后申请`;
+        document.getElementById('aftersale-order-info-text').innerHTML = `
+          <strong>订单状态：</strong>${order.status === 'paid' ? '已付款 (未发货)' : '已发货'} ·
+          <strong>商品原价：</strong>¥${order.subtotal.toFixed(2)} ·
+          <strong>实际支付：</strong>¥${order.payable.toFixed(2)} ·
+          <strong>累计已退：</strong>¥${order.refundedAmount.toFixed(2)} ·
+          <strong>剩余可退金额：</strong>¥${(order.payable - order.refundedAmount).toFixed(2)}
+        `;
+
+        // If order status is paid (not shipped), returnGoods is not needed because items never shipped
+        const returnGoodsGroup = document.getElementById('aftersale-returngoods-group');
+        if (order.status === 'paid') {
+          returnGoodsGroup.style.display = 'none';
+        } else {
+          returnGoodsGroup.style.display = 'block';
+        }
+
+        // Calculate refunded map
+        const refundedMap = {};
+        for (const ref of order.refunds) {
+          for (const rit of ref.items) {
+            refundedMap[rit.sku] = (refundedMap[rit.sku] || 0) + rit.qty;
+          }
+        }
+
+        const tbody = document.getElementById('aftersale-items-tbody');
+        tbody.innerHTML = order.items.map(it => {
+          const v = findVariant(it.sku);
+          const alreadyRefunded = refundedMap[it.sku] || 0;
+          const refundable = it.qty - alreadyRefunded;
+          const isEligible = refundable > 0;
+
+          return `
+            <tr>
+              <td>
+                <input type="checkbox" class="aftersale-item-check" data-sku="${it.sku}" ${!isEligible ? 'disabled' : ''}>
+              </td>
+              <td><strong>${v ? v.spec : it.sku}</strong><br><span style="font-size:10px; color:var(--gray-400);">${it.sku}</span></td>
+              <td>${it.qty}</td>
+              <td>${alreadyRefunded}</td>
+              <td style="font-weight:700; color:${refundable > 0 ? 'var(--primary)' : 'var(--gray-400)'};">${refundable}</td>
+              <td>
+                <input type="number" class="form-input aftersale-qty-input" data-sku="${it.sku}" value="1" min="1" max="${refundable}" style="width:70px; padding:4px 6px;" ${!isEligible ? 'disabled' : ''}>
+              </td>
+            </tr>
+          `;
+        }).join('');
+
+        // Wire change events for real-time recalculation preview
+        tbody.querySelectorAll('.aftersale-item-check, .aftersale-qty-input').forEach(el => {
+          el.addEventListener('change', updateAfterSalePreview);
+          el.addEventListener('input', updateAfterSalePreview);
+        });
+
+        updateAfterSalePreview();
+        document.getElementById('modal-aftersale').classList.add('active');
