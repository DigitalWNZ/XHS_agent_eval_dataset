+      /* --- Variant & Product Helpers --- */
+      function findVariant(sku) {
+        for (const p of state.products) {
+          for (const v of p.variants) {
+            if (v.sku === sku) return v;
+          }
+        }
+        return null;
+      }
+
+      function findProductBySku(sku) {
+        for (const p of state.products) {
+          for (const v of p.variants) {
+            if (v.sku === sku) return p;
+          }
+        }
+        return null;
+      }
+
+      /* --- Core Cart & Discount Calculation --- */
+      function calculateCart() {
+        const lines = [];
+        let subtotal = 0;
+
+        for (const item of state.cart) {
+          const variant = findVariant(item.sku);
+          if (variant) {
+            const lineTotal = round2(item.qty * variant.price);
+            lines.push({
+              sku: item.sku,
+              qty: item.qty,
+              unitPrice: variant.price,
+              lineTotal: lineTotal
+            });
+            subtotal += lineTotal;
+          }
+        }
+
+        subtotal = round2(subtotal);
+
+        // Calculate discounts
+        const discounts = [];
+        let memberDiscount = 0;
+        let couponDiscount = 0;
+
+        // 1. Member Discount: 10% on any non-empty cart
+        if (state.isMember && lines.length > 0) {
+          memberDiscount = round2(subtotal * MEMBER_DISCOUNT_RATE);
+          if (memberDiscount > subtotal) {
+            memberDiscount = subtotal;
+          }
+          discounts.push({
+            type: 'member',
+            amount: memberDiscount
+          });
+        }
+
+        // 2. Coupon Discount
+        let couponObj = null;
+        if (state.appliedCouponCode) {
+          couponObj = state.coupons.find(c => c.code === state.appliedCouponCode);
+          if (couponObj) {
+            if (subtotal < couponObj.threshold) {
+              // Automatically invalidate coupon if threshold not met!
+              state.appliedCouponCode = null;
+              couponObj = null;
+            } else {
+              couponDiscount = couponObj.amount;
+              // Cap coupon discount so total is not below 0
+              const remainingSubtotal = Math.max(0, round2(subtotal - memberDiscount));
+              if (couponDiscount > remainingSubtotal) {
+                couponDiscount = remainingSubtotal;
+              }
+              couponDiscount = round2(couponDiscount);
+              discounts.push({
+                type: 'coupon',
+                amount: couponDiscount
+              });
+            }
+          } else {
+            state.appliedCouponCode = null;
+          }
+        }
+
+        const totalDiscounts = round2(memberDiscount + couponDiscount);
+        const total = Math.max(0, round2(subtotal - totalDiscounts));
+
+        return {
+          lines,
+          subtotal,
+          discounts,
+          total
+        };
+      }
