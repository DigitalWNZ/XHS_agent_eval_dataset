+
+      // =========================================================================
+      // Backup Export / Import & Reset Confirmation
+      // =========================================================================
+
+      function showBackupFeedback(msg, isError) {
+        const el = document.getElementById('backup-feedback');
+        if (!el) return;
+        el.style.display = 'block';
+        el.style.background = isError ? 'var(--danger-bg)' : 'var(--success-bg)';
+        el.style.color = isError ? '#991b1b' : '#065f46';
+        el.textContent = msg;
+      }
+
+      window.handleExportToTextarea = function () {
+        const json = apiExportData();
+        document.getElementById('backup-json-textarea').value = json;
+        showBackupFeedback('已生成当前完整业务数据的 JSON 字符串，您可以复制保存或直接修改后导入。', false);
+      };
+
+      window.handleDownloadJson = function () {
+        const json = apiExportData();
+        document.getElementById('backup-json-textarea').value = json;
+        const blob = new Blob([json], { type: 'application/json' });
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        a.href = url;
+        a.download = `popbox-backup-${new Date().toISOString().slice(0, 10)}.json`;
+        a.click();
+        URL.revokeObjectURL(url);
+        showBackupFeedback('已触发 JSON 备份文件下载。', false);
+      };
+
+      window.handleFileImport = function (event) {
+        const file = event.target.files && event.target.files[0];
+        if (!file) return;
+        const reader = new FileReader();
+        reader.onload = function (e) {
+          const content = String(e.target.result || '');
+          document.getElementById('backup-json-textarea').value = content;
+          const res = apiImportData(content);
+          if (!res.ok) {
+            showBackupFeedback(`导入失败：${res.error}（原有数据未受影响）`, true);
+            showToast(res.error, 'error');
+          } else {
+            showBackupFeedback('文件导入成功！全部商品、库存、订单与统计数据已恢复。', false);
+            showToast('数据导入成功', 'success');
+          }
+          event.target.value = '';
+        };
+        reader.readAsText(file);
+      };
+
+      window.handleImportFromTextarea = function () {
+        const raw = document.getElementById('backup-json-textarea').value;
+        const res = apiImportData(raw);
+        if (!res.ok) {
+          showBackupFeedback(`导入校验未通过：${res.error}（已保留当前有效业务数据，未覆盖）`, true);
+          showToast(res.error, 'error');
+        } else {
+          showBackupFeedback('JSON 数据导入成功！系统状态与统计指标已实时更新。', false);
+          showToast('JSON 数据导入成功', 'success');
+        }
+      };
+
+      // Confirm Modal Helpers
+      let pendingConfirmCallback = null;
+
+      function openConfirmModal(title, htmlMessage, onConfirm) {
+        document.getElementById('confirm-modal-title').textContent = title;
+        document.getElementById('confirm-modal-body').innerHTML = htmlMessage;
+        pendingConfirmCallback = onConfirm;
+        const okBtn = document.getElementById('confirm-modal-ok-btn');
+        okBtn.onclick = function () {
+          const cb = pendingConfirmCallback;
+          closeConfirmModal();
+          if (cb) cb();
+        };
+        document.getElementById('confirm-modal').classList.add('open');
+      }
+
+      window.closeConfirmModal = function () {
+        pendingConfirmCallback = null;
+        document.getElementById('confirm-modal').classList.remove('open');
+      };
+
+      window.handleResetConfirm = function () {
+        openConfirmModal(
+          '恢复初始演示数据',
+          '确定要将工作台重置为初始构造的商品、库存和历史订单吗？当前新增的订单、购物车和修改将被清空。',
+          () => {
+            apiReset();
+            showToast('已恢复为初始商品与历史订单数据', 'info');
+          }
+        );
+      };
+
+      function formatTime(isoStr) {
+        if (!isoStr) return '-';
+        return String(isoStr).replace('T', ' ').slice(0, 19);
+      }
+
+      function escapeHtml(str) {
+        return String(str ?? '')
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      }
+
+      function renderAll() {
+        renderStatsBar();
+        renderProducts();
+        renderCartAndCheckout();
+        renderOrdersList();
+        renderStatsAndLogs();
+      }
+
+      // Initialize on page load
+      loadState();
+      renderAll();
+    })();
+  </script>
+</body>
+</html>
