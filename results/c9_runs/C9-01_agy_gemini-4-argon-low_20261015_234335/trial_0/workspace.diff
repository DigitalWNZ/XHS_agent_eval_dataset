+        }
+
+        const remainingPayable = round2(Math.max(0, order.payable - (order.refundedAmount || 0)));
+        if (remainingPayable <= 0 && order.payable > 0) {
+          return { ok: false, error: '该订单实付金额已全部退完，无法继续退款' };
+        }
+
+        let refundAmount = 0;
+        if (totalRemainingAfterThis === 0) {
+          // Last refund when all items in the order are refunded: amount = remaining payable
+          refundAmount = remainingPayable;
+        } else {
+          // Proportional formula: Σ (qty * unitPrice) * payable / subtotal, rounded to cents
+          const returnedOriginalSum = normalizedItems.reduce((acc, it) => acc + it.qty * it.unitPrice, 0);
+          if (order.subtotal > 0) {
+            refundAmount = round2((returnedOriginalSum * order.payable) / order.subtotal);
+          } else {
+            refundAmount = 0;
+          }
+          // Cap at remainingPayable so cumulative refund never exceeds payable
+          if (refundAmount > remainingPayable) {
+            refundAmount = remainingPayable;
+          }
+        }
+
+        const nowIso = new Date().toISOString();
+        const datePart = nowIso.slice(0, 10).replace(/-/g, '');
+        const refundId = `REF-${datePart}-${String(state.seqRefund++).padStart(3, '0')}`;
+
+        // Stock linkage rule:
+        // - Shipped orders: do NOT restock on refund request; only restock when confirmReturn(refundId) is called.
+        // - Paid (unshipped) orders: items haven't left the store; if returnGoods or unshipped refund, restock immediately.
+        let restocked = false;
+        if (order.status === 'paid') {
+          for (const it of normalizedItems) {
+            const found = findSku(it.sku);
+            if (found) {
+              found.variant.stock += it.qty;
+            }
+          }
+          restocked = true;
+        }
+
+        const refundRecord = {
+          id: refundId,
+          items: normalizedItems.map(it => ({ sku: it.sku, qty: it.qty })),
+          amount: round2(refundAmount),
+          returnGoods,
+          restocked
+        };
+
+        order.refunds.push(refundRecord);
+        order.refundedAmount = round2((order.refundedAmount || 0) + refundRecord.amount);
+
+        addLog(
+          '申请售后',
+          `订单 ${order.id} 生成售后单 ${refundId}，退款 ¥${refundRecord.amount.toFixed(2)} (${returnGoods ? '退货退款' : '仅退款'}${order.status === 'shipped' ? '，已发货商品待确认退货入库后回补库存' : '，未发货已回补库存'})`
+        );
+        saveState();
+        renderAll();
+        return {
+          ok: true,
+          refundId,
+          amount: refundRecord.amount
+        };
+      }
+
+      function apiConfirmReturn(refundId) {
+        if (!refundId || typeof refundId !== 'string') {
+          return { ok: false, error: '售后单号不能为空' };
+        }
+        let targetOrder = null;
+        let targetRefund = null;
+        for (const o of state.orders) {
+          for (const r of (o.refunds || [])) {
+            if (r.id === refundId) {
+              targetOrder = o;
+              targetRefund = r;
+              break;
+            }
+          }
+          if (targetRefund) break;
+        }
+
+        if (!targetOrder || !targetRefund) {
+          return { ok: false, error: `未找到售后单: ${refundId}` };
+        }
+        if (targetOrder.status !== 'shipped') {
+          return { ok: false, error: '只有已发货订单的售后单需要执行退货确认入库' };
+        }
+        if (!targetRefund.returnGoods) {
+          return { ok: false, error: '该售后单为“仅退款”类型，无需退货入库' };
+        }
+        if (targetRefund.restocked) {
+          return { ok: false, error: `售后单 ${refundId} 已完成入库，不能重复入库` };
+        }
+
+        const restockedDetails = [];
+        for (const item of targetRefund.items) {
+          const found = findSku(item.sku);
+          if (found) {
+            found.variant.stock += item.qty;
+            restockedDetails.push(`${item.sku} × ${item.qty}`);
+          }
+        }
+        targetRefund.restocked = true;
+
+        addLog('退货入库', `确认售后单 ${refundId} (所属订单 ${targetOrder.id}) 退货入库，回补库存：${restockedDetails.join(', ')}`);
+        saveState();
+        renderAll();
+        return { ok: true, refundId, restocked: true };
+      }
+
+      function apiQueryOrders(filter = {}) {
+        if (!filter || typeof filter !== 'object') {
+          filter = {};
+        }
+        const orderIdFilter = typeof filter.orderId === 'string' ? filter.orderId.trim() : '';
+        const skuFilter = typeof filter.sku === 'string' ? filter.sku.trim() : '';
+        const statusFilter = typeof filter.status === 'string' ? filter.status.trim() : '';
+        const fromFilter = typeof filter.from === 'string' ? filter.from.trim() : '';
+        const toFilter = typeof filter.to === 'string' ? filter.to.trim() : '';
+
+        const result = state.orders.filter(order => {
+          if (orderIdFilter && !order.id.toLowerCase().includes(orderIdFilter.toLowerCase())) {
+            return false;
+          }
+          if (statusFilter && order.status !== statusFilter) {
+            return false;
+          }
+          if (skuFilter) {
+            const q = skuFilter.toLowerCase();
+            const matchSkuOrName = order.items.some(it => {
+              if (it.sku.toLowerCase() === q || it.sku.toLowerCase().includes(q)) return true;
+              const found = findSku(it.sku);
+              if (found && (found.product.name.toLowerCase().includes(q) || found.variant.spec.toLowerCase().includes(q))) {
+                return true;
+              }
+              return false;
+            });
+            if (!matchSkuOrName) return false;
+          }
+          if (fromFilter || toFilter) {
+            // Compare YYYY-MM-DD against order.createdAt date part (both UTC date string and local date string)
+            const createdDateUtc = String(order.createdAt).slice(0, 10);
+            if (fromFilter && createdDateUtc < fromFilter) {
+              return false;
+            }
+            if (toFilter && createdDateUtc > toFilter) {
+              return false;
+            }
+          }
+          return true;
+        });
+
+        return result.map(formatOrderOutput);
+      }
+
+      function apiGetStats() {
+        let sales = 0;
+        let refunds = 0;
+        const unitsSold = {};
+
+        // Initialize all known SKUs to 0 so stats table & object are clean
+        for (const p of state.products) {
+          for (const v of p.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const order of state.orders) {
+          const everPaid = Boolean(order.paidAt);
+          if (everPaid) {
+            sales = round2(sales + round2(order.payable));
+            for (const item of order.items) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+            }
+          }
+          for (const r of (order.refunds || [])) {
+            refunds = round2(refunds + round2(r.amount));
+            if (everPaid) {
+              for (const ri of (r.items || [])) {
+                unitsSold[ri.sku] = (unitsSold[ri.sku] || 0) - ri.qty;
+              }
+            }
+          }
+        }
+
+        const net = round2(sales - refunds);
+        return {
+          sales: round2(sales),
+          refunds: round2(refunds),
+          net: round2(net),
+          unitsSold
+        };
+      }
+
+      function validateStateObject(data) {
+        if (!data || typeof data !== 'object' || Array.isArray(data)) {
+          return { ok: false, error: '导入数据必须是一个 JSON 对象' };
+        }
+        if (!Array.isArray(data.products) || data.products.length === 0) {
+          return { ok: false, error: '导入数据缺少有效的商品列表 (products)' };
+        }
+        if (!Array.isArray(data.orders)) {
+          return { ok: false, error: '导入数据缺少有效的订单列表 (orders)' };
+        }
+
+        // Validate each product & variant
+        const skuSet = new Set();
+        for (const p of data.products) {
+          if (!p || typeof p.id !== 'string' || !p.id.trim() || typeof p.name !== 'string' || !p.name.trim() || !Array.isArray(p.variants) || p.variants.length === 0) {
+            return { ok: false, error: '商品数据格式不完整 (需包含 id, name, variants)' };
+          }
+          for (const v of p.variants) {
+            if (!v || typeof v.sku !== 'string' || !v.sku.trim() || typeof v.spec !== 'string') {
+              return { ok: false, error: `商品 ${p.id} 的规格缺少 sku 或 spec` };
+            }
+            if (typeof v.price !== 'number' || !Number.isFinite(v.price) || v.price < 0) {
+              return { ok: false, error: `规格 ${v.sku} 的价格不合法` };
+            }
+            if (typeof v.stock !== 'number' || !Number.isInteger(v.stock) || v.stock < 0) {
+              return { ok: false, error: `规格 ${v.sku} 的库存必须为非负整数` };
+            }
+            skuSet.add(v.sku);
+          }
+        }
+
+        // Validate each order
+        const validStatuses = new Set(['pending', 'paid', 'shipped', 'cancelled']);
+        for (const o of data.orders) {
+          if (!o || typeof o.id !== 'string' || !o.id.trim()) {
+            return { ok: false, error: '订单缺少有效 id' };
+          }
+          if (!validStatuses.has(o.status)) {
+            return { ok: false, error: `订单 ${o.id} 状态不合法: ${o.status}` };
+          }
+          if (typeof o.createdAt !== 'string' || !o.createdAt.trim()) {
+            return { ok: false, error: `订单 ${o.id} 缺少 createdAt 时间` };
+          }
+          if (!Array.isArray(o.items) || o.items.length === 0) {
+            return { ok: false, error: `订单 ${o.id} 缺少商品明细列表 (items)` };
+          }
+          for (const it of o.items) {
+            if (!it || typeof it.sku !== 'string' || !isValidPositiveInt(it.qty) || typeof it.unitPrice !== 'number' || it.unitPrice < 0) {
+              return { ok: false, error: `订单 ${o.id} 的商品项数据无效` };
+            }
+          }
+          if (typeof o.subtotal !== 'number' || typeof o.payable !== 'number' || o.payable < 0) {
+            return { ok: false, error: `订单 ${o.id} 金额字段不完整或非法` };
+          }
+          if (o.refunds !== undefined && !Array.isArray(o.refunds)) {
+            return { ok: false, error: `订单 ${o.id} 的 refunds 字段必须是数组` };
+          }
+        }
+
+        return { ok: true };
+      }
+
+      function apiExportData() {
+        const payload = {
+          version: 1,
+          exportedAt: new Date().toISOString(),
+          products: state.products,
+          coupons: state.coupons,
+          isMember: state.isMember,
+          cart: state.cart,
+          appliedCouponCode: state.appliedCouponCode,
+          orders: state.orders,
+          logs: state.logs,
+          seqOrder: state.seqOrder,
+          seqRefund: state.seqRefund
+        };
+        return JSON.stringify(payload, null, 2);
+      }
+
+      function apiImportData(jsonStr) {
+        if (typeof jsonStr !== 'string' || !jsonStr.trim()) {
+          return { ok: false, error: '导入内容不能为空且必须为 JSON 字符串' };
+        }
+        let parsed;
+        try {
+          parsed = JSON.parse(jsonStr);
+        } catch (e) {
+          return { ok: false, error: 'JSON 语法解析失败，请检查文件格式是否正确' };
+        }
+
+        const validation = validateStateObject(parsed);
+        if (!validation.ok) {
+          return validation;
+        }
+
+        const defaults = getInitialData();
+        state = {
+          products: deepClone(parsed.products),
+          coupons: Array.isArray(parsed.coupons) && parsed.coupons.length > 0 ? deepClone(parsed.coupons) : defaults.coupons,
+          isMember: typeof parsed.isMember === 'boolean' ? parsed.isMember : false,
+          cart: Array.isArray(parsed.cart) ? deepClone(parsed.cart) : [],
+          appliedCouponCode: typeof parsed.appliedCouponCode === 'string' ? parsed.appliedCouponCode : null,
+          orders: deepClone(parsed.orders).map(o => ({
+            ...o,
+            paidAt: o.paidAt || null,
+            discounts: Array.isArray(o.discounts) ? o.discounts : [],
+            refundedAmount: round2(o.refundedAmount || 0),
+            refunds: Array.isArray(o.refunds) ? o.refunds : []
+          })),
+          logs: Array.isArray(parsed.logs) ? deepClone(parsed.logs) : [],
+          seqOrder: typeof parsed.seqOrder === 'number' ? parsed.seqOrder : (parsed.orders.length + 1),
+          seqRefund: typeof parsed.seqRefund === 'number' ? parsed.seqRefund : 100
+        };
+
+        preparedCheckoutAddress = null;
+        reconcileCartCoupons();
+        addLog('导入数据', `成功导入业务数据：包含 ${state.products.length} 款商品、${state.orders.length} 笔订单`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      }
