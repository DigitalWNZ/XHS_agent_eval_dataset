+
+      function apiRequestAfterSale(orderId, items, options) {
+        if (!orderId || typeof orderId !== "string") {
+          return { ok: false, error: "订单号无效" };
+        }
+        const order = state.orders.find(o => o.id === orderId);
+        if (!order) {
+          return { ok: false, error: "订单不存在" };
+        }
+        if (order.status !== "paid" && order.status !== "shipped") {
+          return { ok: false, error: "仅已付款 (paid) 或已发货 (shipped) 的订单可申请售后" };
+        }
+        if (!Array.isArray(items) || items.length === 0) {
+          return { ok: false, error: "请选择至少一件售后商品及数量" };
+        }
+
+        // Aggregate and validate requested items
+        const requestedBySku = {};
+        const requestedOrder = [];
+        for (const entry of items) {
+          if (!entry || typeof entry !== "object" || typeof entry.sku !== "string" || !entry.sku.trim()) {
+            return { ok: false, error: "售后商品 SKU 参数无效" };
+          }
+          if (typeof entry.qty !== "number" || !Number.isInteger(entry.qty) || entry.qty <= 0) {
+            return { ok: false, error: "售后退货数量必须为正整数" };
+          }
+          const sku = entry.sku.trim();
+          if (!requestedBySku[sku]) {
+            requestedBySku[sku] = 0;
+            requestedOrder.push(sku);
+          }
+          requestedBySku[sku] += entry.qty;
+        }
+
+        const refundedQtyMap = getRefundedQtyMapForOrder(order);
+        const orderItemMap = {};
+        for (const item of order.items) {
+          orderItemMap[item.sku] = item;
+        }
+
+        for (const sku of requestedOrder) {
+          const orderItem = orderItemMap[sku];
+          if (!orderItem) {
+            return { ok: false, error: `原订单不包含商品 ${sku}` };
+          }
+          const alreadyRefunded = refundedQtyMap[sku] || 0;
+          const availableQty = orderItem.qty - alreadyRefunded;
+          if (requestedBySku[sku] > availableQty) {
+            return { ok: false, error: `商品 ${sku} 申请数量 (${requestedBySku[sku]}) 超过剩余可退数量 (${availableQty})` };
+          }
+        }
