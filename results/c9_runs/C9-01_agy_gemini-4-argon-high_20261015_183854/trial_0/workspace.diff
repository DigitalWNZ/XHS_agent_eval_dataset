+        addLog(
+          "申请售后",
+          `订单 ${order.id} 生成售后单 ${refundRecord.id} (${returnGoods ? "退货退款" : "仅退款"})，退还实付 ¥${refundAmount.toFixed(2)}`
+        );
+
+        saveState();
+        renderAll();
+        return {
+          ok: true,
+          refundId: refundRecord.id,
+          amount: refundRecord.amount
+        };
+      }
+
+      function apiConfirmReturn(refundId) {
+        if (!refundId || typeof refundId !== "string") {
+          return { ok: false, error: "售后单号无效" };
+        }
+
+        let targetOrder = null;
