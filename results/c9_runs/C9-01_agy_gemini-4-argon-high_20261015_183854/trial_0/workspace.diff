+        const returnGoods = Boolean(options && options.returnGoods);
+        const normalizedItems = requestedOrder.map(sku => ({
+          sku,
+          qty: requestedBySku[sku]
+        }));
+
+        const refundRecord = {
+          id: generateRefundId(),
+          items: normalizedItems,
+          amount: refundAmount,
+          returnGoods,
+          restocked: false
+        };
