+
+      function validateCartForCheckout() {
+        const cart = computeCartDetails();
+        if (cart.lines.length === 0) {
+          return { ok: false, error: "购物车为空，请先选择商品加入购物车" };
+        }
+        for (const line of cart.lines) {
+          const found = findVariantBySku(line.sku);
+          if (!found) {
+            return { ok: false, error: `商品规格 ${line.sku} 不存在` };
+          }
+          if (found.variant.stock <= 0) {
+            return { ok: false, error: `商品 ${found.product.name} (${found.variant.spec}) 已无库存` };
+          }
+          if (line.qty > found.variant.stock) {
+            return { ok: false, error: `商品 ${found.product.name} (${found.variant.spec}) 库存不足 (当前库存 ${found.variant.stock})` };
+          }
+        }
+        return { ok: true, cart };
+      }
+
+      function generateOrderId() {
+        const now = new Date();
+        const ymd = now.toISOString().slice(0, 10).replace(/-/g, "");
+        let seq = state.orders.length + 1;
+        let candidate = `ORD-${ymd}-${String(seq).padStart(3, "0")}`;
+        while (state.orders.some(o => o.id === candidate)) {
+          seq++;
+          candidate = `ORD-${ymd}-${String(seq).padStart(3, "0")}`;
+        }
+        return candidate;
+      }
+
+      function generateRefundId() {
+        const now = new Date();
+        const ymd = now.toISOString().slice(0, 10).replace(/-/g, "");
+        let totalRefunds = state.orders.reduce((acc, o) => acc + (o.refunds ? o.refunds.length : 0), 0) + 1;
+        let candidate = `REF-${ymd}-${String(totalRefunds).padStart(3, "0")}`;
+        const exists = (id) => state.orders.some(o => (o.refunds || []).some(r => r.id === id));
+        while (exists(candidate)) {
+          totalRefunds++;
+          candidate = `REF-${ymd}-${String(totalRefunds).padStart(3, "0")}`;
+        }
+        return candidate;
+      }
+
+      function getRefundedQtyMapForOrder(order) {
+        const map = {};
+        for (const r of (order.refunds || [])) {
+          for (const item of (r.items || [])) {
+            map[item.sku] = (map[item.sku] || 0) + item.qty;
+          }
+        }
+        return map;
+      }
