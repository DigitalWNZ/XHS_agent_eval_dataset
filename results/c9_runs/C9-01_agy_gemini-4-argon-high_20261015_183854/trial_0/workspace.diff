+              </label>
+              <div style="font-size: 13px; font-weight: 700;">
+                预计本次退款：<span id="aftersale-preview-amount" style="color: var(--accent-pink); font-family: var(--font-mono); font-size: 16px;">¥0.00</span>
+              </div>
+            </div>
+          </div>
+        `;
+
+        const updatePreview = () => {
+          const inputs = document.querySelectorAll(".aftersale-qty-input");
+          const reqMap = {};
+          let anyValid = false;
+          inputs.forEach(inp => {
+            const q = parseInt(inp.value, 10) || 0;
+            const sku = inp.getAttribute("data-sku");
+            if (q > 0) {
+              reqMap[sku] = q;
+              anyValid = true;
+            }
+          });
+          const previewEl = document.getElementById("aftersale-preview-amount");
+          if (!anyValid) {
+            previewEl.textContent = "¥0.00";
+            return;
+          }
+
+          let allWillBeRefunded = true;
+          for (const item of order.items) {
+            const already = refundedQtyMap[item.sku] || 0;
+            const add = reqMap[item.sku] || 0;
+            if (already + add < item.qty) {
+              allWillBeRefunded = false;
+              break;
+            }
+          }
+
+          let est = 0;
