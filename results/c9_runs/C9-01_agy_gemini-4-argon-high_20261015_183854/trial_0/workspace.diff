+        }
+        if (typeof qty !== "number" || !Number.isInteger(qty) || qty <= 0) {
+          return { ok: false, error: "商品数量必须为正整数" };
+        }
+        const found = findVariantBySku(sku);
+        if (!found || found.variant.stock <= 0) {
+          return { ok: false, error: "该商品规格当前无库存" };
+        }
+        if (qty > found.variant.stock) {
+          return { ok: false, error: `修改数量超出可用库存 (当前最大可用 ${found.variant.stock})` };
+        }
+
+        existing.qty = qty;
+        preparedCheckoutSession = { active: false, address: null, submittedOrderId: null, snapshotCart: null };
