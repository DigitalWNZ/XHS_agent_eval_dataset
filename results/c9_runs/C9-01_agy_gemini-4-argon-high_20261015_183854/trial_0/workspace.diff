+      }
+
+      function apiQueryOrders(filter = {}) {
+        const f = filter && typeof filter === "object" ? filter : {};
+        const orderIdQuery = typeof f.orderId === "string" ? f.orderId.trim().toLowerCase() : "";
+        const skuQuery = typeof f.sku === "string" ? f.sku.trim().toLowerCase() : "";
+        const statusQuery = typeof f.status === "string" ? f.status.trim() : "";
+        const fromDate = typeof f.from === "string" ? f.from.trim() : "";
+        const toDate = typeof f.to === "string" ? f.to.trim() : "";
+
+        const matched = state.orders.filter(order => {
+          if (orderIdQuery) {
+            if (!order.id.toLowerCase().includes(orderIdQuery)) {
+              return false;
+            }
+          }
+          if (skuQuery) {
+            const hasSkuOrName = order.items.some(item => {
+              if (item.sku.toLowerCase() === skuQuery || item.sku.toLowerCase().includes(skuQuery)) {
+                return true;
+              }
+              const found = findVariantBySku(item.sku);
+              if (found) {
+                const fullText = `${found.product.name} ${found.variant.spec}`.toLowerCase();
+                if (fullText.includes(skuQuery)) return true;
+              }
+              return false;
+            });
+            if (!hasSkuOrName) return false;
+          }
+          if (statusQuery && statusQuery !== "all") {
+            if (order.status !== statusQuery) return false;
+          }
+          if (fromDate || toDate) {
+            const ymd = getOrderDateYMD(order.createdAt);
+            if (!ymd) return false;
+            if (fromDate && ymd < fromDate) return false;
+            if (toDate && ymd > toDate) return false;
+          }
+          return true;
+        });
+
+        return deepClone(matched);
+      }
+
+      function apiGetStats() {
+        let sales = 0;
+        let refunds = 0;
+        const unitsSold = {};
+
+        for (const p of state.products) {
+          for (const v of p.variants) {
+            unitsSold[v.sku] = 0;
+          }
+        }
+
+        for (const order of state.orders) {
+          const everPaid = Boolean(order.paidAt);
+          if (everPaid) {
+            sales = round2(sales + Number(order.payable || 0));
+            for (const item of (order.items || [])) {
+              unitsSold[item.sku] = (unitsSold[item.sku] || 0) + item.qty;
+            }
+          }
+
+          for (const r of (order.refunds || [])) {
+            refunds = round2(refunds + Number(r.amount || 0));
+            if (everPaid) {
+              for (const ri of (r.items || [])) {
+                unitsSold[ri.sku] = (unitsSold[ri.sku] || 0) - ri.qty;
+              }
+            }
+          }
+        }
+
+        const net = round2(sales - refunds);
+        return deepClone({
+          sales,
+          refunds,
+          net,
+          unitsSold
+        });
+      }
+
+      function apiExportData() {
+        const payload = {
+          products: state.products,
+          coupons: state.coupons,
+          isMember: state.isMember,
+          cart: state.cart,
+          orders: state.orders,
+          logs: state.logs
+        };
+        return JSON.stringify(payload, null, 2);
+      }
+
+      function apiImportData(jsonStr) {
+        if (typeof jsonStr !== "string" || !jsonStr.trim()) {
+          return { ok: false, error: "导入内容不能为空字符串" };
+        }
+        let parsed = null;
+        try {
+          parsed = JSON.parse(jsonStr);
+        } catch (e) {
+          return { ok: false, error: "JSON 语法解析失败，请检查文件格式" };
+        }
+
+        const validation = validateImportPayload(parsed);
+        if (!validation.ok) {
+          return { ok: false, error: validation.error };
+        }
+
+        state = {
+          products: deepClone(parsed.products),
+          coupons: Array.isArray(parsed.coupons) ? deepClone(parsed.coupons) : deepClone(state.coupons),
+          isMember: typeof parsed.isMember === "boolean" ? parsed.isMember : false,
+          cart: parsed.cart && Array.isArray(parsed.cart.lines) ? deepClone(parsed.cart) : { lines: [], couponCode: null },
+          orders: deepClone(parsed.orders),
+          logs: Array.isArray(parsed.logs) ? deepClone(parsed.logs) : deepClone(state.logs)
+        };
+
+        preparedCheckoutSession = { active: false, address: null, submittedOrderId: null, snapshotCart: null };
+        reconcileCartAndDiscounts();
+        addLog("导入数据", `成功导入 ${state.products.length} 款商品与 ${state.orders.length} 笔订单记录`);
+        saveState();
+        renderAll();
+        return { ok: true };
+      }
+
