+					},
+					{Name: "c", TTL: new("1h")},
+					{Name: "d", TTL: new("1h30m")},
+				},
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User", RegexRewrite: &kgateway.ConsistentHashRegexRewrite{Pattern: "^u-(.*)$", Substitution: `\1`}},
+					{HeaderName: "x-user", Terminal: new(true)},
+					{HeaderName: "x-tenant"},
+				},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
