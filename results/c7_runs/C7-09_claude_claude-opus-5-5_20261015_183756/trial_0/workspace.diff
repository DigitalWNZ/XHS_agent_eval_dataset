+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: route-full
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "full.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: route-default
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "default.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: route-merge
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "merge.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+# All fields set, listed out of canonical order and with duplicates
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-full
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-full
+  consistentHash:
+    sourceIp:
+      terminal: true
+    filterState:
+      - key: io.istio.peer_principal
+      - key: io.istio.peer_principal
+        terminal: true
+    queryParameters:
+      - name: user
+        terminal: true
+      - name: user
+    cookies:
+      - name: session
+        ttl: "3600"
+        path: /
+        attributes:
+          - name: SameSite
+            value: Strict
+          - name: Secure
+      - name: other
+        ttl: 1h30m
+      - name: session
+        ttl: 10s
+    headers:
+      - headerName: X-User-Id
+        regexRewrite:
+          pattern: "^user-(.*)$"
+          substitution: "\\1"
+      - headerName: x-user-id
+        terminal: true
+      - headerName: x-tenant
+        terminal: true
+---
+# Empty consistentHash defaults to a single sourceIp hash policy
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-default
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-default
+  consistentHash: {}
+---
+# Higher priority (older) policy for route-merge
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-merge-a
+  creationTimestamp: "2024-01-01T00:00:00Z"
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-merge
+  consistentHash:
+    queryParameters:
+      - name: user
+    headers:
+      - headerName: X-Tenant
+        terminal: true
+---
+# Lower priority (newer) policy for route-merge
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-merge-b
+  creationTimestamp: "2024-01-02T00:00:00Z"
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-merge
+  consistentHash:
+    sourceIp:
+      terminal: true
+    headers:
+      - headerName: x-tenant
+      - headerName: x-user
+    cookies:
+      - name: session
