+	}
+}
+
+func TestApplyConsistentHash(t *testing.T) {
+	action := &envoyroutev3.RouteAction{HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{headerHP("a", false)}}
+	applyConsistentHash(&consistentHashIR{disable: true}, action)
+	assert.Empty(t, action.GetHashPolicy(), "disable should clear hash policies")
+
+	applyConsistentHash(&consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{cookieHP("session")}}, action)
+	assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{cookieHP("session")}, action.GetHashPolicy())
+}
