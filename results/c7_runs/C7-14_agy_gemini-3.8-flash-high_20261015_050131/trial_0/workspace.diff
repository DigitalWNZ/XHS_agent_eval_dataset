+// Encode encodes the ShapeIndex to the given io.Writer.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if s == nil {
+		return errors.New("cannot encode nil ShapeIndex")
+	}
+	if w == nil {
+		return errors.New("cannot encode to nil Writer")
+	}
+
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+	e.writeInt8(encodingVersion)
+	e.writeUint32(uint32(s.maxEdgesPerCell))
+	e.writeInt32(s.nextID)
+	e.writeUint32(uint32(len(s.shapes)))
+	if e.err != nil {
+		return e.err
+	}
+
+	// Sort shape IDs for deterministic encoding.
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		shapeIDs = append(shapeIDs, id)
+	}
+	slices.Sort(shapeIDs)
+
+	var buf bytes.Buffer
+	for _, id := range shapeIDs {
+		shape := s.shapes[id]
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			return fmt.Errorf("cannot encode shape %d of type %T with typeTagNone", id, shape)
+		}
+		buf.Reset()
+		if err := encodeShape(shape, &buf); err != nil {
+			return fmt.Errorf("failed to encode shape %d: %w", id, err)
+		}
+		e.writeInt32(id)
+		e.writeUint32(uint32(tag))
+		e.writeUint32(uint32(buf.Len()))
+		if e.err != nil {
+			return e.err
+		}
+		if _, err := w.Write(buf.Bytes()); err != nil {
+			return err
+		}
+	}
+
+	// Encode spatial cells.
+	e.writeUint32(uint32(len(s.cells)))
+	if e.err != nil {
+		return e.err
+	}
+
+	for _, cellID := range s.cells {
+		cell := s.cellMap[cellID]
+		numClipped := 0
+		if cell != nil {
+			numClipped = len(cell.shapes)
+		}
+		e.writeUint64(uint64(cellID))
+		e.writeUint32(uint32(numClipped))
+		if e.err != nil {
+			return e.err
+		}
+		if cell != nil {
+			for _, cs := range cell.shapes {
+				e.writeInt32(cs.shapeID)
+				e.writeBool(cs.containsCenter)
+				e.writeUint32(uint32(len(cs.edges)))
+				for _, edgeID := range cs.edges {
+					e.writeInt32(int32(edgeID))
+				}
+				if e.err != nil {
+					return e.err
+				}
+			}
+		}
+	}
+
+	return e.err
+}
+
+// Decode decodes the ShapeIndex from the given io.Reader.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if s == nil {
+		return errors.New("cannot decode into nil ShapeIndex")
+	}
+	if r == nil {
+		return errors.New("cannot decode from nil Reader")
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.Reset()
+
+	br := asByteReader(r)
+	d := &decoder{r: br}
+
+	version := d.readInt8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != encodingVersion {
+		return fmt.Errorf("unsupported ShapeIndex version %d; my version: %d", version, encodingVersion)
+	}
+
+	maxEdgesPerCell := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > maxAllowedEdgesPerCell {
+		return fmt.Errorf("invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+
+	nextID := d.readInt32()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID < 0 || nextID > maxEncodedShapes {
+		return fmt.Errorf("invalid nextID %d", nextID)
+	}
+
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numShapes > maxEncodedShapes {
+		return fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+	}
+	if int32(numShapes) > nextID {
+		return fmt.Errorf("number of shapes %d exceeds nextID %d", numShapes, nextID)
+	}
+
+	shapes := make(map[int32]Shape, min(numShapes, 1024))
+	for i := uint32(0); i < numShapes; i++ {
+		if d.err != nil {
+			return d.err
+		}
+		shapeID := d.readInt32()
+		if d.err != nil {
+			return d.err
+		}
+		if shapeID < 0 || shapeID >= nextID {
+			return fmt.Errorf("invalid shapeID %d (nextID is %d)", shapeID, nextID)
+		}
+		if _, exists := shapes[shapeID]; exists {
+			return fmt.Errorf("duplicate shape ID %d", shapeID)
+		}
+
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return d.err
+		}
+
+		dataLen := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+		if dataLen > maxEncodedShapeBytes {
+			return fmt.Errorf("shape data length %d exceeds maximum %d", dataLen, maxEncodedShapeBytes)
+		}
+
+		lr := &limitedByteReader{r: br, n: int64(dataLen)}
+		shape, err := decodeShape(tag, lr)
+		if err != nil {
+			return fmt.Errorf("failed to decode shape %d: %w", shapeID, err)
+		}
+		if lr.n > 0 {
+			_, err := io.Copy(io.Discard, lr)
+			if err != nil || lr.n > 0 {
+				return io.ErrUnexpectedEOF
+			}
+		}
+
+		shapes[shapeID] = shape
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+
+	cells := make([]CellID, 0, min(numCells, 1024))
+	cellMap := make(map[CellID]*ShapeIndexCell, min(numCells, 1024))
+	var prevCellID CellID
+
+	for i := uint32(0); i < numCells; i++ {
+		if d.err != nil {
+			return d.err
+		}
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return d.err
+		}
+		if !cellID.IsValid() {
+			return fmt.Errorf("invalid CellID: %v", cellID)
+		}
+		if i > 0 && cellID <= prevCellID {
+			return fmt.Errorf("cells not in strictly increasing order: %v <= %v", cellID, prevCellID)
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped > uint32(len(shapes)) {
+			return fmt.Errorf("too many clipped shapes in cell (%d; total shapes %d)", numClipped, len(shapes))
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		var prevShapeID int32 = -1
+
+		for j := uint32(0); j < numClipped; j++ {
+			if d.err != nil {
+				return d.err
+			}
+			csShapeID := d.readInt32()
+			if d.err != nil {
+				return d.err
+			}
+			if csShapeID < 0 {
+				return fmt.Errorf("negative shapeID in cell: %d", csShapeID)
+			}
+			if j > 0 && csShapeID <= prevShapeID {
+				return fmt.Errorf("clipped shapes in cell not in strictly increasing order: %d <= %d", csShapeID, prevShapeID)
+			}
+			prevShapeID = csShapeID
+
+			shape, ok := shapes[csShapeID]
+			if !ok {
+				return fmt.Errorf("cell references non-existent shapeID %d", csShapeID)
+			}
+
+			boolByte, err := br.ReadByte()
+			if err != nil {
+				return err
+			}
+			if boolByte != 0 && boolByte != 1 {
+				return fmt.Errorf("invalid bool value: %d", boolByte)
+			}
+			containsCenter := boolByte == 1
+			if containsCenter && shape.Dimension() != 2 {
+				return fmt.Errorf("containsCenter true for non-polygon shape %d", csShapeID)
+			}
+
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return d.err
+			}
+			if numEdges > uint32(shape.NumEdges()) {
+				return fmt.Errorf("cell edge count %d exceeds shape %d edge count %d", numEdges, csShapeID, shape.NumEdges())
+			}
+
+			cs := newClippedShape(csShapeID, int(numEdges))
+			cs.containsCenter = containsCenter
+
+			prevEdgeID := -1
+			for k := uint32(0); k < numEdges; k++ {
+				if d.err != nil {
+					return d.err
+				}
+				edgeID := int(d.readInt32())
+				if d.err != nil {
+					return d.err
+				}
+				if edgeID < 0 || edgeID >= shape.NumEdges() {
+					return fmt.Errorf("invalid edge ID %d for shape %d (num edges %d)", edgeID, csShapeID, shape.NumEdges())
+				}
+				if k > 0 && edgeID <= prevEdgeID {
+					return fmt.Errorf("edges in clipped shape not in strictly increasing order: %d <= %d", edgeID, prevEdgeID)
+				}
+				prevEdgeID = edgeID
+				cs.edges[k] = edgeID
+			}
+
+			cell.shapes[j] = cs
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = cell
+	}
+
+	if d.err != nil {
+		return d.err
+	}
+
+	s.shapes = shapes
+	s.nextID = nextID
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.cells = cells
+	s.cellMap = cellMap
+	atomic.StoreInt32(&s.status, fresh)
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+
+	return nil
+}
