+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	numLoops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+	loops := make([][]Point, 0, min(numLoops, 1024))
+	totalVertices := uint32(0)
+	for i := uint32(0); i < numLoops; i++ {
+		nVerts := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if nVerts > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices in loop (%d; max is %d)", nVerts, maxEncodedVertices)
+			return
+		}
+		totalVertices += nVerts
+		if totalVertices > maxEncodedVertices {
+			d.err = fmt.Errorf("total vertices exceeded limit (%d; max is %d)", totalVertices, maxEncodedVertices)
+			return
+		}
+		loop := make([]Point, 0, min(nVerts, 1024))
+		for j := uint32(0); j < nVerts; j++ {
+			x := d.readFloat64()
+			y := d.readFloat64()
+			z := d.readFloat64()
+			if d.err != nil {
+				return
+			}
+			loop = append(loop, Point{r3.Vector{X: x, Y: y, Z: z}})
+		}
+		loops = append(loops, loop)
+	}
+	*p = *LaxPolygonFromPoints(loops)
+}
