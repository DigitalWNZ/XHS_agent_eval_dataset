+// helper to assert that an index and its decoded counterpart are equivalent.
+func verifyShapeIndexEquivalent(t *testing.T, orig, dec *ShapeIndex) {
+	t.Helper()
+
+	if dec.Len() != orig.Len() {
+		t.Fatalf("Len() mismatch: got %d, want %d", dec.Len(), orig.Len())
+	}
+	if dec.NumEdges() != orig.NumEdges() {
+		t.Fatalf("NumEdges() mismatch: got %d, want %d", dec.NumEdges(), orig.NumEdges())
+	}
+	if dec.nextID != orig.nextID {
+		t.Fatalf("nextID mismatch: got %d, want %d", dec.nextID, orig.nextID)
+	}
+
+	// Verify all shapes and their IDs.
+	for id := int32(0); id < orig.nextID; id++ {
+		origShape := orig.Shape(id)
+		decShape := dec.Shape(id)
+		if (origShape == nil) != (decShape == nil) {
+			t.Fatalf("shape %d existence mismatch: orig=%v, dec=%v", id, origShape != nil, decShape != nil)
+		}
+		if origShape == nil {
+			continue
+		}
+		if decShape.typeTag() != origShape.typeTag() {
+			t.Fatalf("shape %d typeTag mismatch: got %d, want %d", id, decShape.typeTag(), origShape.typeTag())
+		}
+		if decShape.NumEdges() != origShape.NumEdges() {
+			t.Fatalf("shape %d NumEdges mismatch: got %d, want %d", id, decShape.NumEdges(), origShape.NumEdges())
+		}
+		if decShape.NumChains() != origShape.NumChains() {
+			t.Fatalf("shape %d NumChains mismatch: got %d, want %d", id, decShape.NumChains(), origShape.NumChains())
+		}
+		if decShape.Dimension() != origShape.Dimension() {
+			t.Fatalf("shape %d Dimension mismatch: got %d, want %d", id, decShape.Dimension(), origShape.Dimension())
+		}
+		if decShape.IsEmpty() != origShape.IsEmpty() {
+			t.Fatalf("shape %d IsEmpty mismatch: got %v, want %v", id, decShape.IsEmpty(), origShape.IsEmpty())
+		}
+		if decShape.IsFull() != origShape.IsFull() {
+			t.Fatalf("shape %d IsFull mismatch: got %v, want %v", id, decShape.IsFull(), origShape.IsFull())
+		}
+		for e := 0; e < origShape.NumEdges(); e++ {
+			if decShape.Edge(e) != origShape.Edge(e) {
+				t.Fatalf("shape %d Edge(%d) mismatch: got %v, want %v", id, e, decShape.Edge(e), origShape.Edge(e))
+			}
+		}
+		for c := 0; c < origShape.NumChains(); c++ {
+			if decShape.Chain(c) != origShape.Chain(c) {
+				t.Fatalf("shape %d Chain(%d) mismatch: got %v, want %v", id, c, decShape.Chain(c), origShape.Chain(c))
+			}
+		}
+	}
+
+	// Verify cell structure.
+	if len(dec.cells) != len(orig.cells) {
+		t.Fatalf("cells count mismatch: got %d, want %d", len(dec.cells), len(orig.cells))
+	}
+	for i, cellID := range orig.cells {
+		if dec.cells[i] != cellID {
+			t.Fatalf("cell %d mismatch: got %v, want %v", i, dec.cells[i], cellID)
+		}
+		origCell := orig.cellMap[cellID]
+		decCell := dec.cellMap[cellID]
+		if len(decCell.shapes) != len(origCell.shapes) {
+			t.Fatalf("cell %v clipped shapes count mismatch: got %d, want %d", cellID, len(decCell.shapes), len(origCell.shapes))
+		}
+		for j, origCS := range origCell.shapes {
+			decCS := decCell.shapes[j]
+			if decCS.shapeID != origCS.shapeID {
+				t.Fatalf("cell %v clipped %d shapeID mismatch: got %d, want %d", cellID, j, decCS.shapeID, origCS.shapeID)
+			}
+			if decCS.containsCenter != origCS.containsCenter {
+				t.Fatalf("cell %v clipped %d containsCenter mismatch: got %v, want %v", cellID, j, decCS.containsCenter, origCS.containsCenter)
+			}
+			if !reflect.DeepEqual(decCS.edges, origCS.edges) {
+				t.Fatalf("cell %v clipped %d edges mismatch: got %v, want %v", cellID, j, decCS.edges, origCS.edges)
+			}
+		}
+	}
+
+	// Verify iterator without Build.
+	itOrig := orig.Iterator()
+	itDec := dec.Iterator()
+	for !itOrig.Done() && !itDec.Done() {
+		if itDec.CellID() != itOrig.CellID() {
+			t.Fatalf("iterator CellID mismatch: got %v, want %v", itDec.CellID(), itOrig.CellID())
+		}
+		itOrig.Next()
+		itDec.Next()
+	}
+	if itOrig.Done() != itDec.Done() {
+		t.Fatalf("iterator Done() mismatch: orig=%v, dec=%v", itOrig.Done(), itDec.Done())
+	}
+}
