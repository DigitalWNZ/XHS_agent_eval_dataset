+func encodeShape(shape Shape, w io.Writer) error {
+	switch s := shape.(type) {
+	case *Polygon:
+		return s.Encode(w)
+	case *Polyline:
+		return s.Encode(w)
+	case *PointVector:
+		return s.Encode(w)
+	case *LaxPolyline:
+		return s.Encode(w)
+	case *LaxPolygon:
+		return s.Encode(w)
+	case *Loop:
+		return s.Encode(w)
+	case *LaxLoop:
+		return s.Encode(w)
+	default:
+		return fmt.Errorf("unsupported shape type %T", shape)
+	}
+}
+
+func decodeShape(tag typeTag, r io.Reader) (Shape, error) {
+	switch tag {
+	case typeTagPolygon:
+		p := new(Polygon)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPolyline:
+		p := new(Polyline)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPointVector:
+		p := new(PointVector)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolyline:
+		p := new(LaxPolyline)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolygon:
+		p := new(LaxPolygon)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLoop:
+		p := new(Loop)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxLoop:
+		p := new(LaxLoop)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	default:
+		return nil, fmt.Errorf("unknown shape type tag %d", tag)
+	}
