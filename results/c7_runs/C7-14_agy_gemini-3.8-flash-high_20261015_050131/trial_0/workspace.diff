+func TestShapeIndexAllBuiltinShapeTypes(t *testing.T) {
+	idx := NewShapeIndex()
+
+	// 1. PointVector
+	pv := PointVector([]Point{
+		PointFromLatLng(LatLngFromDegrees(10, 20)),
+		PointFromLatLng(LatLngFromDegrees(30, 40)),
+	})
+	pvID := idx.Add(&pv)
+
+	// 2. Polyline
+	pline := makePolyline("0:0, 0:1, 1:1")
+	plineID := idx.Add(pline)
+
+	// 3. LaxPolyline
+	laxPline := makeLaxPolyline("10:10, 10:20, 20:20")
+	laxPlineID := idx.Add(laxPline)
+
+	// 4. Polygon
+	polygon := makePolygon("0:0, 0:10, 10:10, 10:0", false)
+	polygonID := idx.Add(polygon)
+
+	// 5. LaxPolygon
+	laxPolygon := makeLaxPolygon("20:20, 20:30, 30:30, 30:20")
+	laxPolyID := idx.Add(laxPolygon)
+
+	// 6. Loop
+	loop := RegularLoop(PointFromCoords(1, 0, 0), s1.Angle(0.1), 8)
+	loopID := idx.Add(loop)
+
+	// 7. LaxLoop
+	laxLoop := LaxLoopFromPoints([]Point{
+		PointFromLatLng(LatLngFromDegrees(40, 40)),
+		PointFromLatLng(LatLngFromDegrees(40, 50)),
+		PointFromLatLng(LatLngFromDegrees(50, 40)),
+	})
+	laxLoopID := idx.Add(laxLoop)
+
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	verifyShapeIndexEquivalent(t, idx, dec)
+
+	// Verify all assigned IDs were preserved.
+	if dec.Shape(pvID) == nil || dec.Shape(plineID) == nil || dec.Shape(laxPlineID) == nil ||
+		dec.Shape(polygonID) == nil || dec.Shape(laxPolyID) == nil || dec.Shape(loopID) == nil ||
+		dec.Shape(laxLoopID) == nil {
+		t.Fatalf("shape IDs not preserved")
+	}
+
+	// Verify queries work without Build.
+	cpq := NewContainsPointQuery(dec, VertexModelSemiOpen)
+	// Point inside polygon (5:5)
+	pInside := PointFromLatLng(LatLngFromDegrees(5, 5))
+	if !cpq.Contains(pInside) {
+		t.Errorf("ContainsPointQuery failed for point inside polygon")
+	}
+}
