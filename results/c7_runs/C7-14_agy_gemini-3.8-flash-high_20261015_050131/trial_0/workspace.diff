+func TestShapeIndexShapeIDsSurvivalWithRemovals(t *testing.T) {
+	idx := NewShapeIndex()
+
+	s0 := makePolyline("0:0, 1:1")
+	s1 := makePolyline("2:2, 3:3")
+	s2 := makePolyline("4:4, 5:5")
+	s3 := makePolyline("6:6, 7:7")
+
+	id0 := idx.Add(s0)
+	id1 := idx.Add(s1)
+	id2 := idx.Add(s2)
+	id3 := idx.Add(s3)
+
+	// Remove s1 and s2
+	idx.Remove(s1)
+	idx.Remove(s2)
+
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if dec.Len() != 2 {
+		t.Fatalf("expected 2 shapes, got %d", dec.Len())
+	}
+	if dec.Shape(id0) == nil {
+		t.Fatalf("shape %d should exist", id0)
+	}
+	if dec.Shape(id1) != nil {
+		t.Fatalf("shape %d should be nil (removed)", id1)
+	}
+	if dec.Shape(id2) != nil {
+		t.Fatalf("shape %d should be nil (removed)", id2)
+	}
+	if dec.Shape(id3) == nil {
+		t.Fatalf("shape %d should exist", id3)
+	}
+	if dec.nextID != 4 {
+		t.Fatalf("nextID should be 4, got %d", dec.nextID)
+	}
+
+	verifyShapeIndexEquivalent(t, idx, dec)
+
+	// Verify adding a new shape gets id 4 without collision.
+	s4 := makePolyline("8:8, 9:9")
+	id4 := dec.Add(s4)
+	if id4 != 4 {
+		t.Fatalf("expected new shape to get ID 4, got %d", id4)
+	}
+}
