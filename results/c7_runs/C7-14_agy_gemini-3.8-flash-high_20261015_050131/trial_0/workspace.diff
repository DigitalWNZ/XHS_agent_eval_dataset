+func TestShapeIndexReuseInstance(t *testing.T) {
+	idx1 := makeShapeIndex("0:0 # #")
+	idx2 := makeShapeIndex("# 1:1, 2:2 # 0:0, 0:10, 10:10")
+
+	var buf1, buf2 bytes.Buffer
+	if err := idx1.Encode(&buf1); err != nil {
+		t.Fatalf("Encode idx1 failed: %v", err)
+	}
+	if err := idx2.Encode(&buf2); err != nil {
+		t.Fatalf("Encode idx2 failed: %v", err)
+	}
+
+	reused := NewShapeIndex()
+	if err := reused.Decode(&buf1); err != nil {
+		t.Fatalf("Decode 1 failed: %v", err)
+	}
+	verifyShapeIndexEquivalent(t, idx1, reused)
+
+	if err := reused.Decode(&buf2); err != nil {
+		t.Fatalf("Decode 2 into same instance failed: %v", err)
+	}
+	verifyShapeIndexEquivalent(t, idx2, reused)
+}
