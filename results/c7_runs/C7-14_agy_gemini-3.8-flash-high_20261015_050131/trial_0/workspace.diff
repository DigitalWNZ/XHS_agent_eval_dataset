+func TestShapeIndexZeroEdgeShapesAndMixedChains(t *testing.T) {
+	idx := NewShapeIndex()
+
+	// Zero-edge PointVector
+	emptyPV := &PointVector{}
+	id0 := idx.Add(emptyPV)
+
+	// Zero-edge Polyline
+	emptyPline := &Polyline{}
+	id1 := idx.Add(emptyPline)
+
+	// 1-vertex Polyline (0 edges)
+	singlePline := &Polyline{PointFromCoords(1, 0, 0)}
+	id2 := idx.Add(singlePline)
+
+	// Zero-edge LaxPolyline
+	emptyLaxPline := LaxPolylineFromPoints(nil)
+	id3 := idx.Add(emptyLaxPline)
+
+	// 1-vertex LaxPolyline (0 edges)
+	singleLaxPline := LaxPolylineFromPoints([]Point{PointFromCoords(0, 1, 0)})
+	id4 := idx.Add(singleLaxPline)
+
+	// Empty Polygon (0 edges, 0 chains)
+	emptyPolygon := &Polygon{}
+	id5 := idx.Add(emptyPolygon)
+
+	// Full Polygon (0 edges, 1 chain)
+	fullPolygon := FullPolygon()
+	id6 := idx.Add(fullPolygon)
+
+	// Empty LaxPolygon (0 edges, 0 chains)
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+	id7 := idx.Add(emptyLaxPoly)
+
+	// Full LaxPolygon (0 edges, 1 chain)
+	fullLaxPoly := LaxPolygonFromPoints([][]Point{{}})
+	id8 := idx.Add(fullLaxPoly)
+
+	// Mixed chain LaxPolygon:
+	// Loop 0: 4 points (4 edges)
+	// Loop 1: 0 points (0 edges, full loop)
+	// Loop 2: 1 point (1 edge, degenerate)
+	p1 := PointFromLatLng(LatLngFromDegrees(0, 0))
+	p2 := PointFromLatLng(LatLngFromDegrees(0, 2))
+	p3 := PointFromLatLng(LatLngFromDegrees(2, 2))
+	p4 := PointFromLatLng(LatLngFromDegrees(2, 0))
+	p5 := PointFromLatLng(LatLngFromDegrees(5, 5))
+	mixedLaxPoly := LaxPolygonFromPoints([][]Point{
+		{p1, p2, p3, p4},
+		{},
+		{p5},
+	})
+	id9 := idx.Add(mixedLaxPoly)
+
+	// PointVector with 4 points (4 chains, 4 edges)
+	multiPV := &PointVector{p1, p2, p3, p4}
+	id10 := idx.Add(multiPV)
+
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	verifyShapeIndexEquivalent(t, idx, dec)
+
+	// Verify zero-edge shapes properties on decoded index.
+	if dec.Shape(id0).NumEdges() != 0 || dec.Shape(id0).NumChains() != 0 {
+		t.Errorf("emptyPV mismatch")
+	}
+	if dec.Shape(id1).NumEdges() != 0 || dec.Shape(id1).NumChains() != 0 {
+		t.Errorf("emptyPline mismatch")
+	}
+	if dec.Shape(id2).NumEdges() != 0 || dec.Shape(id2).NumChains() != 0 {
+		t.Errorf("singlePline mismatch")
+	}
+	if dec.Shape(id3).NumEdges() != 0 || dec.Shape(id3).NumChains() != 0 {
+		t.Errorf("emptyLaxPline mismatch")
+	}
+	if dec.Shape(id4).NumEdges() != 0 || dec.Shape(id4).NumChains() != 0 {
+		t.Errorf("singleLaxPline mismatch")
+	}
+	if dec.Shape(id5).NumEdges() != 0 || dec.Shape(id5).NumChains() != 0 || !dec.Shape(id5).IsEmpty() {
+		t.Errorf("emptyPolygon mismatch")
+	}
+	if dec.Shape(id6).NumEdges() != 0 || dec.Shape(id6).NumChains() != 1 || !dec.Shape(id6).IsFull() {
+		t.Errorf("fullPolygon mismatch")
+	}
+	if dec.Shape(id7).NumEdges() != 0 || dec.Shape(id7).NumChains() != 0 || !dec.Shape(id7).IsEmpty() {
+		t.Errorf("emptyLaxPoly mismatch")
+	}
+	if dec.Shape(id8).NumEdges() != 0 || dec.Shape(id8).NumChains() != 1 || !dec.Shape(id8).IsFull() {
+		t.Errorf("fullLaxPoly mismatch")
+	}
+	if dec.Shape(id9).NumChains() != 3 || dec.Shape(id9).NumEdges() != 5 {
+		t.Errorf("mixedLaxPoly mismatch: chains=%d, edges=%d", dec.Shape(id9).NumChains(), dec.Shape(id9).NumEdges())
+	}
+	if dec.Shape(id10).NumChains() != 4 || dec.Shape(id10).NumEdges() != 4 {
+		t.Errorf("multiPV mismatch: chains=%d, edges=%d", dec.Shape(id10).NumChains(), dec.Shape(id10).NumEdges())
+	}
+}
