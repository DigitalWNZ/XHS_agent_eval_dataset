+func TestShapeIndexDecodeCorruptedBytes(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 10:10, 20:20"))
+	idx.Add(makePolygon("0:0, 0:5, 5:5, 5:0", false))
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validData := buf.Bytes()
+
+	// 1. Wrong version byte
+	corruptVersion := append([]byte(nil), validData...)
+	corruptVersion[0] = 99
+	dec := NewShapeIndex()
+	if err := dec.Decode(bytes.NewReader(corruptVersion)); err == nil {
+		t.Errorf("expected error for wrong version")
+	}
+
+	// 2. Corrupted maxEdgesPerCell = 0
+	corruptMaxEdges := append([]byte(nil), validData...)
+	binary.LittleEndian.PutUint32(corruptMaxEdges[1:5], 0)
+	if err := dec.Decode(bytes.NewReader(corruptMaxEdges)); err == nil {
+		t.Errorf("expected error for maxEdgesPerCell = 0")
+	}
+
+	// 3. Corrupted nextID < 0
+	corruptNextID := append([]byte(nil), validData...)
+	binary.LittleEndian.PutUint32(corruptNextID[5:9], 0x80000000)
+	if err := dec.Decode(bytes.NewReader(corruptNextID)); err == nil {
+		t.Errorf("expected error for negative nextID")
+	}
+
+	// 4. Corrupted unknown shape tag
+	corruptTag := append([]byte(nil), validData...)
+	// Shape 0 starts at offset 13 (1 version + 4 maxEdges + 4 nextID + 4 numShapes).
+	// shapeID is 4 bytes (offset 13..17), tag is 4 bytes (offset 17..21).
+	binary.LittleEndian.PutUint32(corruptTag[17:21], 99999)
+	if err := dec.Decode(bytes.NewReader(corruptTag)); err == nil {
+		t.Errorf("expected error for unknown shape type tag")
+	}
+
+	// 5. Random byte sequences should never panic.
+	rng := rand.New(rand.NewSource(time.Now().UnixNano()))
+	for i := 0; i < 500; i++ {
+		randomLen := rng.Intn(256)
+		randomBytes := make([]byte, randomLen)
+		rng.Read(randomBytes)
+		dec := NewShapeIndex()
+		_ = dec.Decode(bytes.NewReader(randomBytes))
+	}
+}
