+func TestShapeIndexFuzzBitFlips(t *testing.T) {
+	idx := makeShapeIndex("0:0 | 1:1 # 2:2, 3:3 # 0:0, 0:10, 10:10")
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// Flip every single bit in the byte stream and verify no panics.
+	for byteIdx := 0; byteIdx < len(validBytes); byteIdx++ {
+		for bit := 0; bit < 8; bit++ {
+			corrupt := append([]byte(nil), validBytes...)
+			corrupt[byteIdx] ^= 1 << bit
+
+			dec := NewShapeIndex()
+			_ = dec.Decode(bytes.NewReader(corrupt))
+		}
+	}
+}
