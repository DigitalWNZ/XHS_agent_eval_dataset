+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	idx := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("empty index must encode to a non-empty byte stream")
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	verifyShapeIndexEquivalent(t, idx, dec)
+
+	// Verify iteration on empty decoded index.
+	it := dec.Iterator()
+	if !it.Done() {
+		t.Errorf("expected iterator to be done on empty index")
+	}
+
+	// Verify query on empty decoded index.
+	query := NewContainsPointQuery(dec, VertexModelSemiOpen)
+	if query.Contains(OriginPoint()) {
+		t.Errorf("empty index should not contain any points")
+	}
+}
