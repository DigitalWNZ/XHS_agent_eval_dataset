+func TestShapeIndexDecodeTruncatedData(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 10:10, 20:20"))
+	idx.Add(makePolygon("0:0, 0:5, 5:5, 5:0", false))
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	data := buf.Bytes()
+
+	// Truncate at every length from 0 to len-1
+	for truncateAt := 0; truncateAt < len(data); truncateAt++ {
+		dec := NewShapeIndex()
+		err := dec.Decode(bytes.NewReader(data[:truncateAt]))
+		if err == nil {
+			t.Fatalf("expected error for truncated data of length %d / %d", truncateAt, len(data))
+		}
+	}
+}
