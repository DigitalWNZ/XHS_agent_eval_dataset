+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUint32(uint32(p.numLoops))
+	for i := range p.numLoops {
+		n := p.numLoopVertices(i)
+		e.writeUint32(uint32(n))
+		for j := range n {
+			pt := p.loopVertex(i, j)
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
