+func TestShapeIndexDecodeOversizedAllocationRequests(t *testing.T) {
+	dec := NewShapeIndex()
+
+	// 1. Oversized numShapes
+	var buf bytes.Buffer
+	buf.WriteByte(1)                                            // version
+	binary.Write(&buf, binary.LittleEndian, uint32(10))         // maxEdgesPerCell
+	binary.Write(&buf, binary.LittleEndian, int32(100))         // nextID
+	binary.Write(&buf, binary.LittleEndian, uint32(0x7fffffff)) // huge numShapes
+	if err := dec.Decode(&buf); err == nil {
+		t.Errorf("expected error for oversized numShapes")
+	}
+
+	// 2. Oversized numCells
+	buf.Reset()
+	buf.WriteByte(1)                                            // version
+	binary.Write(&buf, binary.LittleEndian, uint32(10))         // maxEdgesPerCell
+	binary.Write(&buf, binary.LittleEndian, int32(0))           // nextID
+	binary.Write(&buf, binary.LittleEndian, uint32(0))          // numShapes = 0
+	binary.Write(&buf, binary.LittleEndian, uint32(0x7fffffff)) // huge numCells
+	if err := dec.Decode(&buf); err == nil {
+		t.Errorf("expected error for oversized numCells")
+	}
+
+	// 3. Oversized shape dataLen
+	buf.Reset()
+	buf.WriteByte(1)                                                 // version
+	binary.Write(&buf, binary.LittleEndian, uint32(10))              // maxEdgesPerCell
+	binary.Write(&buf, binary.LittleEndian, int32(1))                // nextID = 1
+	binary.Write(&buf, binary.LittleEndian, uint32(1))               // numShapes = 1
+	binary.Write(&buf, binary.LittleEndian, int32(0))                // shapeID = 0
+	binary.Write(&buf, binary.LittleEndian, uint32(typeTagPolyline)) // tag
+	binary.Write(&buf, binary.LittleEndian, uint32(0x7fffffff))      // huge dataLen
+	if err := dec.Decode(&buf); err == nil {
+		t.Errorf("expected error for oversized shape dataLen")
+	}
+
+	// 4. Oversized vertices in PointVector
+	buf.Reset()
+	buf.WriteByte(1)                                            // version
+	binary.Write(&buf, binary.LittleEndian, uint32(0x7fffffff)) // huge npoints
+	pv := &PointVector{}
+	if err := pv.Decode(&buf); err == nil {
+		t.Errorf("expected error for oversized npoints in PointVector")
+	}
+
+	// 5. Oversized vertices in LaxPolyline
+	buf.Reset()
+	buf.WriteByte(1)                                            // version
+	binary.Write(&buf, binary.LittleEndian, uint32(0x7fffffff)) // huge nvertices
+	lp := &LaxPolyline{}
+	if err := lp.Decode(&buf); err == nil {
+		t.Errorf("expected error for oversized nvertices in LaxPolyline")
+	}
+
+	// 6. Oversized loops in LaxPolygon
+	buf.Reset()
+	buf.WriteByte(1)                                            // version
+	binary.Write(&buf, binary.LittleEndian, uint32(0x7fffffff)) // huge numLoops
+	lpoly := &LaxPolygon{}
+	if err := lpoly.Decode(&buf); err == nil {
+		t.Errorf("expected error for oversized numLoops in LaxPolygon")
+	}
+}
