+	if id4 != 4 {
+		t.Errorf("new shape ID on decoded index: got %d, want 4", id4)
+	}
+	decoded.Build()
+	if decoded.Shape(4) == nil {
+		t.Errorf("decoded.Shape(4) is nil after Add and Build")
+	}
