+func compareShapes(t *testing.T, id int32, s1, s2 Shape) {
+	t.Helper()
+	if s1 == nil && s2 == nil {
+		return
+	}
+	if (s1 == nil) != (s2 == nil) {
+		t.Fatalf("shape %d nil mismatch: s1=%v, s2=%v", id, s1, s2)
+	}
+	if s1.typeTag() != s2.typeTag() {
+		t.Errorf("shape %d typeTag: got %d, want %d", id, s2.typeTag(), s1.typeTag())
+	}
+	if s1.Dimension() != s2.Dimension() {
+		t.Errorf("shape %d Dimension: got %d, want %d", id, s2.Dimension(), s1.Dimension())
+	}
+	if s1.NumEdges() != s2.NumEdges() {
+		t.Errorf("shape %d NumEdges: got %d, want %d", id, s2.NumEdges(), s1.NumEdges())
+	}
+	if s1.NumChains() != s2.NumChains() {
+		t.Errorf("shape %d NumChains: got %d, want %d", id, s2.NumChains(), s1.NumChains())
+	}
+	if s1.IsEmpty() != s2.IsEmpty() {
+		t.Errorf("shape %d IsEmpty: got %v, want %v", id, s2.IsEmpty(), s1.IsEmpty())
+	}
+	if s1.IsFull() != s2.IsFull() {
+		t.Errorf("shape %d IsFull: got %v, want %v", id, s2.IsFull(), s1.IsFull())
+	}
+	for e := 0; e < s1.NumEdges(); e++ {
+		e1 := s1.Edge(e)
+		e2 := s2.Edge(e)
+		if e1 != e2 {
+			t.Errorf("shape %d edge %d mismatch: got %v, want %v", id, e, e2, e1)
+		}
+	}
+	for c := 0; c < s1.NumChains(); c++ {
+		c1 := s1.Chain(c)
+		c2 := s2.Chain(c)
+		if c1 != c2 {
+			t.Errorf("shape %d chain %d mismatch: got %v, want %v", id, c, c2, c1)
+		}
+	}
+}
