+func compareIndices(t *testing.T, orig, dec *ShapeIndex) {
+	t.Helper()
+	if dec.Len() != orig.Len() {
+		t.Errorf("Len mismatch: got %d, want %d", dec.Len(), orig.Len())
+	}
+	if dec.NumEdges() != orig.NumEdges() {
+		t.Errorf("NumEdges mismatch: got %d, want %d", dec.NumEdges(), orig.NumEdges())
+	}
+	if dec.nextID != orig.nextID {
+		t.Errorf("nextID mismatch: got %d, want %d", dec.nextID, orig.nextID)
+	}
+	if dec.maxEdgesPerCell != orig.maxEdgesPerCell {
+		t.Errorf("maxEdgesPerCell mismatch: got %d, want %d", dec.maxEdgesPerCell, orig.maxEdgesPerCell)
+	}
+	if !dec.IsFresh() {
+		t.Errorf("dec.IsFresh() is false, want true")
+	}
+
+	for id := int32(0); id < orig.nextID; id++ {
+		compareShapes(t, id, orig.Shape(id), dec.Shape(id))
+	}
+
+	// Compare cells
+	if len(dec.cells) != len(orig.cells) {
+		t.Fatalf("cells count mismatch: got %d, want %d", len(dec.cells), len(orig.cells))
+	}
+	for i := range orig.cells {
+		if dec.cells[i] != orig.cells[i] {
+			t.Fatalf("cell %d ID mismatch: got %v, want %v", i, dec.cells[i], orig.cells[i])
+		}
+		c1 := orig.cellMap[orig.cells[i]]
+		c2 := dec.cellMap[dec.cells[i]]
+		if len(c1.shapes) != len(c2.shapes) {
+			t.Fatalf("cell %v clipped shapes count mismatch: got %d, want %d", orig.cells[i], len(c2.shapes), len(c1.shapes))
+		}
+		for j := range c1.shapes {
+			cs1 := c1.shapes[j]
+			cs2 := c2.shapes[j]
+			if cs1.shapeID != cs2.shapeID {
+				t.Errorf("cell %v shape %d shapeID mismatch: got %d, want %d", orig.cells[i], j, cs2.shapeID, cs1.shapeID)
+			}
+			if cs1.containsCenter != cs2.containsCenter {
+				t.Errorf("cell %v shape %d containsCenter mismatch: got %v, want %v", orig.cells[i], j, cs2.containsCenter, cs1.containsCenter)
+			}
+			if len(cs1.edges) != len(cs2.edges) {
+				t.Errorf("cell %v shape %d edges len mismatch: got %d, want %d", orig.cells[i], j, len(cs2.edges), len(cs1.edges))
+			} else {
+				for k := range cs1.edges {
+					if cs1.edges[k] != cs2.edges[k] {
+						t.Errorf("cell %v shape %d edge %d mismatch: got %d, want %d", orig.cells[i], j, k, cs2.edges[k], cs1.edges[k])
+					}
+				}
+			}
+		}
+	}
+}
