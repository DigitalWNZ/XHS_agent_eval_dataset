+func TestShapeIndexSerializationMalformedInput(t *testing.T) {
+	// 1. Truncated data: every prefix from 0 to N-1 must return an error and not panic
+	validIndex := NewShapeIndex()
+	validIndex.Add(makePolyline("0:0, 1:1, 2:2"))
+	validIndex.Add(makePolygon("10:10, 10:20, 20:10", false))
+	validIndex.Build()
+
+	var buf bytes.Buffer
+	if err := validIndex.Encode(&buf); err != nil {
+		t.Fatalf("validIndex.Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	for length := 0; length < len(validBytes); length++ {
+		truncated := bytes.NewReader(validBytes[:length])
+		dec := NewShapeIndex()
+		if err := dec.Decode(truncated); err == nil {
+			t.Errorf("Decode on truncated stream of length %d succeeded, want error", length)
+		}
+	}
+
+	// 2. Corrupted version byte
+	corruptVersion := make([]byte, len(validBytes))
+	copy(corruptVersion, validBytes)
+	corruptVersion[0] = 99
+	dec := NewShapeIndex()
+	if err := dec.Decode(bytes.NewReader(corruptVersion)); err == nil {
+		t.Errorf("Decode with corrupted version succeeded, want error")
+	}
+
+	// 3. Oversized allocation requests
+	makeHeader := func(maxEdges, nextID, numShapes uint32) []byte {
+		b := make([]byte, 1+4+4+4)
+		b[0] = byte(encodingVersion)
+		binary.LittleEndian.PutUint32(b[1:5], maxEdges)
+		binary.LittleEndian.PutUint32(b[5:9], nextID)
+		binary.LittleEndian.PutUint32(b[9:13], numShapes)
+		return b
+	}
+
+	testCases := []struct {
+		name string
+		data []byte
+	}{
+		{
+			name: "huge numShapes",
+			data: makeHeader(10, 0xFFFFFFFF, 0xFFFFFFFF),
+		},
+		{
+			name: "huge nextID",
+			data: makeHeader(10, 0xFFFFFFFF, 1),
+		},
+		{
+			name: "nextID less than numShapes",
+			data: makeHeader(10, 2, 5),
+		},
+		{
+			name: "corrupted unknown shape tag",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				shapeHeader := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeHeader[0:4], 0)     // shapeID
+				binary.LittleEndian.PutUint32(shapeHeader[4:8], 99999) // unknown tag
+				return append(h, shapeHeader...)
+			}(),
+		},
+		{
+			name: "corrupted duplicate shapeID",
+			data: func() []byte {
+				idx := NewShapeIndex()
+				idx.Add(makePolyline("0:0, 1:1"))
+				idx.Add(makePolyline("2:2, 3:3"))
+				idx.Build()
+				var b bytes.Buffer
+				idx.Encode(&b)
+				raw := append([]byte(nil), b.Bytes()...)
+				// Header is 13 bytes. Shape 0 is 61 bytes. Shape 1 ID is at offset 74.
+				binary.LittleEndian.PutUint32(raw[74:78], 0)
+				return raw
+			}(),
+		},
+		{
+			name: "huge numCells",
+			data: func() []byte {
+				h := makeHeader(10, 0, 0)
+				cellsHeader := make([]byte, 4)
+				binary.LittleEndian.PutUint32(cellsHeader, 0xFFFFFFFF)
+				return append(h, cellsHeader...)
+			}(),
+		},
+		{
+			name: "invalid CellID",
+			data: func() []byte {
+				h := makeHeader(10, 0, 0)
+				cellsHeader := make([]byte, 4+8)
+				binary.LittleEndian.PutUint32(cellsHeader[0:4], 1) // 1 cell
+				binary.LittleEndian.PutUint64(cellsHeader[4:12], 0) // CellID 0 (invalid)
+				return append(h, cellsHeader...)
+			}(),
+		},
+		{
+			name: "cells out of order",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1")
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(1)
+				cell1 := CellIDFromFace(0) // cell1 < cell0!
+				cellsBuf := make([]byte, 4+8+4+8+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 2)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 0) // 0 clipped shapes
+				binary.LittleEndian.PutUint64(cellsBuf[16:24], uint64(cell1))
+				binary.LittleEndian.PutUint32(cellsBuf[24:28], 0) // 0 clipped shapes
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "overlapping cells",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1")
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				// cell0 contains cell1
+				parent := CellIDFromFace(0)
+				child := parent.ChildBegin()
+				cellsBuf := make([]byte, 4+8+4+8+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 2)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(child))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 0)
+				binary.LittleEndian.PutUint64(cellsBuf[16:24], uint64(parent))
+				binary.LittleEndian.PutUint32(cellsBuf[24:28], 0)
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "cell references non-existent shape ID",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1")
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(0)
+				cellsBuf := make([]byte, 4+8+4+4+1+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 1)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 1) // 1 clipped shape
+				binary.LittleEndian.PutUint32(cellsBuf[16:20], 5) // shapeID 5 (non-existent!)
+				cellsBuf[20] = 0                                 // containsCenter = false
+				binary.LittleEndian.PutUint32(cellsBuf[21:25], 0) // 0 edges
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "cell edge ID out of range",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1") // 1 edge
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(0)
+				cellsBuf := make([]byte, 4+8+4+4+1+4+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 1)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 1)  // 1 clipped shape
+				binary.LittleEndian.PutUint32(cellsBuf[16:20], 0)  // shapeID 0
+				cellsBuf[20] = 0                                  // containsCenter = false
+				binary.LittleEndian.PutUint32(cellsBuf[21:25], 1)  // 1 edge
+				binary.LittleEndian.PutUint32(cellsBuf[25:29], 99) // edgeID 99 (shape has only 1 edge!)
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "cell edges out of order",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1, 0:2, 0:3") // 3 edges
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(0)
+				cellsBuf := make([]byte, 4+8+4+4+1+4+4+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 1)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 1) // 1 clipped shape
+				binary.LittleEndian.PutUint32(cellsBuf[16:20], 0) // shapeID 0
+				cellsBuf[20] = 0                                 // containsCenter = false
+				binary.LittleEndian.PutUint32(cellsBuf[21:25], 2) // 2 edges
+				binary.LittleEndian.PutUint32(cellsBuf[25:29], 2) // edgeID 2
+				binary.LittleEndian.PutUint32(cellsBuf[29:33], 1) // edgeID 1 (out of order!)
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "cell containsCenter true for polyline",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1")
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(0)
+				cellsBuf := make([]byte, 4+8+4+4+1+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 1)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 1) // 1 clipped shape
+				binary.LittleEndian.PutUint32(cellsBuf[16:20], 0) // shapeID 0 (polyline)
+				cellsBuf[20] = 1                                 // containsCenter = true (invalid for polyline!)
+				binary.LittleEndian.PutUint32(cellsBuf[21:25], 0) // 0 edges
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "huge numClipped in cell",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1")
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(0)
+				cellsBuf := make([]byte, 4+8+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 1)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 0xFFFFFFFF) // huge numClipped
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+		{
+			name: "huge numEdges in clippedShape",
+			data: func() []byte {
+				h := makeHeader(10, 1, 1)
+				polyData := makePolyline("0:0, 0:1")
+				var pb bytes.Buffer
+				polyData.Encode(&pb)
+				shapeEntry := make([]byte, 8)
+				binary.LittleEndian.PutUint32(shapeEntry[0:4], 0)
+				binary.LittleEndian.PutUint32(shapeEntry[4:8], uint32(typeTagPolyline))
+				shapeEntry = append(shapeEntry, pb.Bytes()...)
+				cell0 := CellIDFromFace(0)
+				cellsBuf := make([]byte, 4+8+4+4+1+4)
+				binary.LittleEndian.PutUint32(cellsBuf[0:4], 1)
+				binary.LittleEndian.PutUint64(cellsBuf[4:12], uint64(cell0))
+				binary.LittleEndian.PutUint32(cellsBuf[12:16], 1)          // 1 clipped shape
+				binary.LittleEndian.PutUint32(cellsBuf[16:20], 0)          // shapeID 0
+				cellsBuf[20] = 0                                           // containsCenter = false
+				binary.LittleEndian.PutUint32(cellsBuf[21:25], 0xFFFFFFFF) // huge numEdges
+				return append(append(h, shapeEntry...), cellsBuf...)
+			}(),
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			dec := NewShapeIndex()
+			if err := dec.Decode(bytes.NewReader(tc.data)); err == nil {
+				t.Errorf("Decode on %s succeeded, want error", tc.name)
+			}
+		})
+	}
+}
