+func TestShapeIndexSerializationEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("index.Encode failed: %v", err)
+	}
+
+	// Even an empty index encodes to a non-empty byte stream.
+	if buf.Len() == 0 {
+		t.Fatalf("expected non-empty byte stream, got 0 bytes")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("decoded.Decode failed: %v", err)
+	}
+
+	if got := decoded.Len(); got != 0 {
+		t.Errorf("decoded.Len() = %d, want 0", got)
+	}
+	if got := decoded.NumEdges(); got != 0 {
+		t.Errorf("decoded.NumEdges() = %d, want 0", got)
+	}
+	if !decoded.IsFresh() {
+		t.Errorf("decoded.IsFresh() = false, want true")
+	}
+	if !decoded.Iterator().Done() {
+		t.Errorf("decoded.Iterator().Done() = false, want true")
+	}
+}
