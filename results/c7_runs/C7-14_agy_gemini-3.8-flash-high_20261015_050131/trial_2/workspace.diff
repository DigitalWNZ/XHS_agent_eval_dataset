+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("cannot decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	nloops := d.readUint32()
