+
+	if numShapes > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("nextID too large (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+	if int32(nextID) < int32(numShapes) {
+		d.err = fmt.Errorf("invalid nextID %d for %d shapes", nextID, numShapes)
+		return
+	}
+
+	decodedShapes := make(map[int32]Shape, numShapes)
+	for range numShapes {
+		shapeID := d.readUint32()
+		tag := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if shapeID >= nextID {
+			d.err = fmt.Errorf("shapeID %d >= nextID %d", shapeID, nextID)
+			return
+		}
+		id := int32(shapeID)
+		if _, exists := decodedShapes[id]; exists {
+			d.err = fmt.Errorf("duplicate shapeID: %d", id)
+			return
+		}
+
+		var shape Shape
+		switch typeTag(tag) {
+		case typeTagPolygon:
+			p := new(Polygon)
+			p.decodePolygon(d)
+			shape = p
+		case typeTagPolyline:
+			p := new(Polyline)
+			p.decode(d)
+			shape = p
+		case typeTagPointVector:
+			p := new(PointVector)
+			p.decode(d)
+			shape = p
+		case typeTagLaxPolyline:
+			p := new(LaxPolyline)
+			p.decode(d)
+			shape = p
+		case typeTagLaxPolygon:
+			p := new(LaxPolygon)
+			p.decode(d)
+			shape = p
+		case typeTagLoop:
+			p := new(Loop)
+			p.decode(d)
+			shape = p
+		case typeTagLaxLoop:
+			p := new(LaxLoop)
+			p.decode(d)
+			shape = p
+		default:
+			d.err = fmt.Errorf("unknown shape type tag: %d", tag)
+			return
+		}
+		if d.err != nil {
+			return
+		}
+		decodedShapes[id] = shape
+	}
+
+	// Decode cells
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	decodedCells := make([]CellID, 0, numCells)
+	decodedCellMap := make(map[CellID]*ShapeIndexCell, numCells)
+
+	var prevCellID CellID
+	for i := range numCells {
+		rawCellID := d.readUint64()
+		if d.err != nil {
+			return
+		}
+		cellID := CellID(rawCellID)
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID: %v", rawCellID)
+			return
+		}
+		if i > 0 {
+			if cellID <= prevCellID {
+				d.err = fmt.Errorf("cells not in strictly increasing order: %v <= %v", cellID, prevCellID)
+				return
+			}
+			if prevCellID.RangeMax() >= cellID.RangeMin() {
+				d.err = fmt.Errorf("overlapping cells: %v and %v", prevCellID, cellID)
+				return
+			}
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedShapes {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, maxEncodedShapes)
+			return
+		}
+
+		cell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, numClipped),
+		}
+
+		var prevShapeID int32 = -1
+		for j := range numClipped {
+			shapeID := d.readUint32()
+			containsCenter := d.readBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			id := int32(shapeID)
+			if j > 0 && id <= prevShapeID {
+				d.err = fmt.Errorf("clipped shapes not in strictly increasing order: %d <= %d", id, prevShapeID)
+				return
+			}
+			prevShapeID = id
+
+			shape, ok := decodedShapes[id]
+			if !ok {
+				d.err = fmt.Errorf("cell references non-existent shape ID: %d", id)
+				return
+			}
+			if containsCenter && shape.Dimension() < 2 {
+				d.err = fmt.Errorf("shape %d with dimension %d cannot contain cell center", id, shape.Dimension())
+				return
+			}
+			if numEdges > maxEdgesPerShape {
+				d.err = fmt.Errorf("too many edges in clipped shape (%d; max is %d)", numEdges, maxEdgesPerShape)
+				return
+			}
+
+			cs := &clippedShape{
+				shapeID:        id,
+				containsCenter: containsCenter,
+				edges:          make([]int, numEdges),
+			}
+			var prevEdgeID int = -1
+			for e := range numEdges {
+				edgeID := d.readUint32()
+				if d.err != nil {
+					return
+				}
+				eid := int(edgeID)
+				if e > 0 && eid <= prevEdgeID {
+					d.err = fmt.Errorf("edges not in strictly increasing order: %d <= %d", eid, prevEdgeID)
+					return
+				}
+				prevEdgeID = eid
+				if eid >= shape.NumEdges() {
+					d.err = fmt.Errorf("edge ID %d out of range for shape %d with %d edges", eid, id, shape.NumEdges())
+					return
+				}
+				cs.edges[e] = eid
+			}
+			cell.shapes = append(cell.shapes, cs)
+		}
+
+		decodedCells = append(decodedCells, cellID)
+		decodedCellMap[cellID] = cell
+	}
+
+	if d.err != nil {
+		return
+	}
+
+	// Apply decoded state to s
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.shapes = decodedShapes
+	s.cells = decodedCells
+	s.cellMap = decodedCellMap
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+}
