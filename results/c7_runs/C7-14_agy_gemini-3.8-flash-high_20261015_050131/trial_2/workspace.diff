+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("index.Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("decoded.Decode failed: %v", err)
+	}
+
+	// Decoded index must be fresh and have populated cells
+	if !decoded.IsFresh() {
+		t.Errorf("decoded.IsFresh() = false, want true")
+	}
+	if len(decoded.cells) == 0 {
+		t.Errorf("decoded.cells is empty, spatial structure not preserved")
+	}
+
+	// Queries work without calling Build
+	queryPt := PointFromLatLng(LatLngFromDegrees(12, 12))
+	containsQuery := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !containsQuery.Contains(queryPt) {
+		t.Errorf("containsQuery.Contains(%v) = false, want true", queryPt)
+	}
+
+	// Crossing query works without calling Build
+	crossQuery := NewCrossingEdgeQuery(decoded)
+	edges := crossQuery.Crossings(
+		PointFromLatLng(LatLngFromDegrees(0, 1)),
+		PointFromLatLng(LatLngFromDegrees(1, 0)),
+		decoded.Shape(0),
+		CrossingTypeAll,
+	)
+	if len(edges) == 0 {
+		t.Errorf("crossQuery found 0 edges, want at least 1")
+	}
+
+	// Iteration works without calling Build
+	count := 0
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		if !it.CellID().IsValid() {
+			t.Errorf("invalid cell ID in iteration: %v", it.CellID())
+		}
+		if it.IndexCell() == nil {
+			t.Errorf("nil IndexCell for cell %v", it.CellID())
+		}
+		count++
+	}
+	if count != len(decoded.cells) {
+		t.Errorf("iterated %d cells, want %d", count, len(decoded.cells))
+	}
+}
