+func TestShapeIndexSerializationFuzzCorruptedBytes(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 1:1, 2:2"))
+	idx.Add(makePolygon("10:10, 10:20, 20:10", false))
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	original := buf.Bytes()
+
+	// Flip single bytes, test that Decode never panics
+	for i := range original {
+		corrupted := append([]byte(nil), original...)
+		corrupted[i] ^= 0xFF
+		dec := NewShapeIndex()
+		// We don't check for error because a flipped byte might coincidentally form valid data,
+		// but it MUST NOT panic.
+		_ = dec.Decode(bytes.NewReader(corrupted))
+	}
+}
