+func TestShapeIndexSerializationQueryParity(t *testing.T) {
+	index := NewShapeIndex()
+	poly := makePolygon("10:10, 10:30, 30:30, 30:10", false)
+	index.Add(poly)
+	pline := makePolyline("0:0, 15:15, 25:25")
+	index.Add(pline)
+	pv := PointVector{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0)}
+	index.Add(&pv)
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	// 1. Point containment query parity
+	cqOrig := NewContainsPointQuery(index, VertexModelSemiOpen)
+	cqDec := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+
+	testPoints := []Point{
+		PointFromLatLng(LatLngFromDegrees(20, 20)), // inside
+		PointFromLatLng(LatLngFromDegrees(5, 5)),   // outside
+		PointFromLatLng(LatLngFromDegrees(10, 10)), // vertex
+		PointFromLatLng(LatLngFromDegrees(0, 0)),   // outside
+	}
+	for _, pt := range testPoints {
+		if got, want := cqDec.Contains(pt), cqOrig.Contains(pt); got != want {
+			t.Errorf("Contains(%v): got %v, want %v", pt, got, want)
+		}
+	}
+
+	// 2. Crossing query parity
+	xqOrig := NewCrossingEdgeQuery(index)
+	xqDec := NewCrossingEdgeQuery(decoded)
+
+	a := PointFromLatLng(LatLngFromDegrees(5, 20))
+	b := PointFromLatLng(LatLngFromDegrees(35, 20))
+	origEdges := xqOrig.Crossings(a, b, index.Shape(0), CrossingTypeAll)
+	decEdges := xqDec.Crossings(a, b, decoded.Shape(0), CrossingTypeAll)
+
+	if len(origEdges) != len(decEdges) {
+		t.Fatalf("crossing edges count mismatch: got %d, want %d", len(decEdges), len(origEdges))
+	}
+	for i := range origEdges {
+		if origEdges[i] != decEdges[i] {
+			t.Errorf("crossing edge %d mismatch: got %d, want %d", i, decEdges[i], origEdges[i])
+		}
+	}
+
+	// 3. Iterator cell parity
+	itOrig := index.Iterator()
+	itDec := decoded.Iterator()
+	for !itOrig.Done() && !itDec.Done() {
+		if itOrig.CellID() != itDec.CellID() {
+			t.Fatalf("CellID mismatch: %v vs %v", itOrig.CellID(), itDec.CellID())
+		}
+		c1 := itOrig.IndexCell()
+		c2 := itDec.IndexCell()
+		if len(c1.shapes) != len(c2.shapes) {
+			t.Fatalf("Cell %v shapes len mismatch: %d vs %d", itOrig.CellID(), len(c1.shapes), len(c2.shapes))
+		}
+		itOrig.Next()
+		itDec.Next()
+	}
+	if !itOrig.Done() || !itDec.Done() {
+		t.Fatalf("Iterator completion mismatch: itOrig.Done=%v, itDec.Done=%v", itOrig.Done(), itDec.Done())
+	}
+}
