+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	if nloops == 0 {
+		*p = *LaxPolygonFromPoints(nil)
+		return
+	}
+	loopSizes := make([]int, nloops)
+	totalVertices := 0
+	for i := range loopSizes {
+		sz := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if sz > maxEncodedVertices {
+			d.err = fmt.Errorf("too many loop vertices (%d; max is %d)", sz, maxEncodedVertices)
+			return
+		}
+		totalVertices += int(sz)
+		if totalVertices > maxEncodedVertices {
+			d.err = fmt.Errorf("total vertices exceed max (%d; max is %d)", totalVertices, maxEncodedVertices)
+			return
+		}
+		loopSizes[i] = int(sz)
+	}
+	loops := make([][]Point, nloops)
+	for i, sz := range loopSizes {
+		loops[i] = make([]Point, sz)
+		for j := range loops[i] {
+			loops[i][j].X = d.readFloat64()
+			loops[i][j].Y = d.readFloat64()
+			loops[i][j].Z = d.readFloat64()
+		}
+	}
