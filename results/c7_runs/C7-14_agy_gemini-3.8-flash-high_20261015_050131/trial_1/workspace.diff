+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	numLoops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+	loopSizes := make([]int, numLoops)
+	var totalExpected int64
+	for i := range loopSizes {
+		sz := d.readUint32()
+		loopSizes[i] = int(sz)
+		totalExpected += int64(sz)
+		if totalExpected > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", totalExpected, maxEncodedVertices)
+			return
+		}
+	}
+	totalVerts := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if int64(totalVerts) != totalExpected {
+		d.err = fmt.Errorf("vertex count mismatch: header %d, sum of loops %d", totalVerts, totalExpected)
+		return
+	}
+	if totalVerts > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", totalVerts, maxEncodedVertices)
+		return
+	}
+	allVerts := make([]Point, totalVerts)
+	for i := range allVerts {
+		allVerts[i].X = d.readFloat64()
+		allVerts[i].Y = d.readFloat64()
+		allVerts[i].Z = d.readFloat64()
+	}
+	if d.err != nil {
+		return
+	}
+	loops := make([][]Point, numLoops)
+	offset := 0
+	for i, sz := range loopSizes {
+		loops[i] = allVerts[offset : offset+sz]
+		offset += sz
+	}
+	*p = *LaxPolygonFromPoints(loops)
+}
