+func verifyIndicesMatch(t *testing.T, orig, dec *ShapeIndex) {
+	t.Helper()
+
+	itOrig := orig.Iterator()
+	itDec := dec.Iterator()
+	itOrig.Begin()
+	itDec.Begin()
+	for !itOrig.Done() && !itDec.Done() {
+		if itOrig.CellID() != itDec.CellID() {
+			t.Fatalf("CellID mismatch: %v != %v", itDec.CellID(), itOrig.CellID())
+		}
+		cOrig := itOrig.IndexCell()
+		cDec := itDec.IndexCell()
+
+		if len(cOrig.shapes) != len(cDec.shapes) {
+			t.Fatalf("Cell %v shape count mismatch: %d != %d", itOrig.CellID(), len(cDec.shapes), len(cOrig.shapes))
+		}
+
+		for j := range cOrig.shapes {
+			csOrig := cOrig.shapes[j]
+			csDec := cDec.shapes[j]
+			if csOrig.shapeID != csDec.shapeID {
+				t.Errorf("Cell %v shape %d ID mismatch: %d != %d", itOrig.CellID(), j, csDec.shapeID, csOrig.shapeID)
+			}
+			if csOrig.containsCenter != csDec.containsCenter {
+				t.Errorf("Cell %v shape %d containsCenter mismatch: %v != %v", itOrig.CellID(), j, csDec.containsCenter, csOrig.containsCenter)
+			}
+			if !slices.Equal(csOrig.edges, csDec.edges) {
+				t.Errorf("Cell %v shape %d edges mismatch: %v != %v", itOrig.CellID(), j, csDec.edges, csOrig.edges)
+			}
+		}
+		itOrig.Next()
+		itDec.Next()
+	}
+
+	if itOrig.Done() != itDec.Done() {
+		t.Fatalf("iterator Done mismatch: orig=%v, dec=%v", itOrig.Done(), itDec.Done())
+	}
+}
