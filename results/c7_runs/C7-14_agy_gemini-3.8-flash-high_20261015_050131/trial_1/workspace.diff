+func TestShapeIndexSpatialQueriesWithoutBuild(t *testing.T) {
+	orig := NewShapeIndex()
+	orig.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2", true))
+	orig.Add(makePolyline("1:1, 5:5, 9:9"))
+	orig.Add(LaxPolylineFromPoints([]Point{testPoint(0, 5), testPoint(10, 5)}))
+	pv := PointVector([]Point{testPoint(3, 3), testPoint(7, 7)})
+	orig.Add(&pv)
+	orig.Build()
+
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+
+	// 1. ContainsPointQuery comparison
+	for _, model := range []VertexModel{VertexModelOpen, VertexModelSemiOpen, VertexModelClosed} {
+		cpqOrig := NewContainsPointQuery(orig, model)
+		cpqDec := NewContainsPointQuery(dec, model)
+
+		for lat := -5.0; lat <= 15.0; lat += 1.5 {
+			for lng := -5.0; lng <= 15.0; lng += 1.5 {
+				pt := testPoint(lat, lng)
+				gotOrig := cpqOrig.Contains(pt)
+				gotDec := cpqDec.Contains(pt)
+				if gotOrig != gotDec {
+					t.Errorf("ContainsPointQuery(%v, model %v): got %v, want %v", pt, model, gotDec, gotOrig)
+				}
+			}
+		}
+	}
+
+	// 2. CrossingEdgeQuery comparison
+	ceqOrig := NewCrossingEdgeQuery(orig)
+	ceqDec := NewCrossingEdgeQuery(dec)
+
+	testEdges := []Edge{
+		{testPoint(-1, -1), testPoint(11, 11)},
+		{testPoint(5, -1), testPoint(5, 11)},
+		{testPoint(20, 20), testPoint(21, 21)},
+		{testPoint(0, 0), testPoint(10, 0)},
+	}
+
+	for _, e := range testEdges {
+		crossOrig := ceqOrig.Crossings(e.V0, e.V1, orig.Shape(0), CrossingTypeAll)
+		crossDec := ceqDec.Crossings(e.V0, e.V1, dec.Shape(0), CrossingTypeAll)
+		if !slices.Equal(crossOrig, crossDec) {
+			t.Errorf("CrossingEdgeQuery(%v, %v): got %v, want %v", e.V0, e.V1, crossDec, crossOrig)
+		}
+	}
+
+	// 3. LocatePoint and LocateCellID
+	itOrig := orig.Iterator()
+	itDec := dec.Iterator()
+
+	for lat := -5.0; lat <= 15.0; lat += 2.0 {
+		for lng := -5.0; lng <= 15.0; lng += 2.0 {
+			pt := testPoint(lat, lng)
+			locOrig := itOrig.LocatePoint(pt)
+			locDec := itDec.LocatePoint(pt)
+			if locOrig != locDec {
+				t.Errorf("LocatePoint(%v): got %v, want %v", pt, locDec, locOrig)
+			}
+			if locOrig && itOrig.CellID() != itDec.CellID() {
+				t.Errorf("LocatePoint(%v) CellID: got %v, want %v", pt, itDec.CellID(), itOrig.CellID())
+			}
+
+			cid := CellIDFromLatLng(LatLngFromDegrees(lat, lng))
+			relOrig := itOrig.LocateCellID(cid)
+			relDec := itDec.LocateCellID(cid)
+			if relOrig != relDec {
+				t.Errorf("LocateCellID(%v): got %v, want %v", cid, relDec, relOrig)
+			}
+		}
+	}
+}
