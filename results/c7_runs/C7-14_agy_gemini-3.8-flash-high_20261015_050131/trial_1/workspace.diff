+package s2
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"sync/atomic"
+)
+
+const (
+	shapeIndexEncodingVersion = int8(1)
+
+	maxEncodedShapes        = 1_000_000
+	maxEncodedShapeBytes    = 100 * 1024 * 1024 // 100 MB per shape
+	maxEncodedCells         = 10_000_000
+	maxClippedShapesPerCell = 100_000
+)
+
+// Encode encodes the ShapeIndex to the given writer.
+// If the index has pending updates, they will be applied before encoding,
+// ensuring the spatial cell structure is fully written.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if s == nil {
+		return errors.New("cannot encode nil ShapeIndex")
+	}
+
+	// Ensure any pending additions/removals are applied first so that the spatial index
+	// is complete and fully formed.
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+
+	// 1. Header
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeInt32(int32(s.maxEdgesPerCell))
+	e.writeInt32(s.nextID)
+
+	// 2. Shapes
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		shapeIDs = append(shapeIDs, id)
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUint32(uint32(len(shapeIDs)))
+
+	var shapeBuf bytes.Buffer
+	for _, shapeID := range shapeIDs {
+		shape := s.shapes[shapeID]
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			return fmt.Errorf("shape at ID %d has typeTagNone and cannot be encoded", shapeID)
+		}
+
+		shapeBuf.Reset()
+		if err := encodeShape(shape, &shapeBuf); err != nil {
+			return fmt.Errorf("failed to encode shape at ID %d: %w", shapeID, err)
+		}
+
+		shapeData := shapeBuf.Bytes()
+		e.writeInt32(shapeID)
+		e.writeUint32(uint32(tag))
+		e.writeUint32(uint32(len(shapeData)))
+		if e.err != nil {
+			return e.err
+		}
+		if _, err := e.w.Write(shapeData); err != nil {
+			return err
+		}
+	}
+
+	// 3. Cells
+	e.writeUint32(uint32(len(s.cells)))
+	for _, cid := range s.cells {
+		cell, ok := s.cellMap[cid]
+		if !ok || cell == nil {
+			return fmt.Errorf("cell ID %v present in cells list but missing from cellMap", cid)
+		}
+
+		e.writeUint64(uint64(cid))
+		e.writeUint32(uint32(len(cell.shapes)))
+		for _, cs := range cell.shapes {
+			e.writeInt32(cs.shapeID)
+			if cs.containsCenter {
+				e.writeUint8(1)
+			} else {
+				e.writeUint8(0)
+			}
+			e.writeUint32(uint32(len(cs.edges)))
+			for _, edgeID := range cs.edges {
+				e.writeInt32(int32(edgeID))
+			}
+		}
+	}
+
+	return e.err
+}
+
+// Decode decodes the ShapeIndex from the given reader.
+// On success, the index is ready for queries and iteration without needing Build.
+func (s *ShapeIndex) Decode(r io.Reader) (err error) {
+	if s == nil {
+		return errors.New("cannot decode into nil ShapeIndex")
+	}
+
+	defer func() {
+		if rec := recover(); rec != nil {
+			err = fmt.Errorf("panic during ShapeIndex decode: %v", rec)
+		}
+	}()
+
+	br := asByteReader(r)
+	d := &decoder{r: br}
+
+	// 1. Header
+	version := d.readInt8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("unsupported ShapeIndex encoding version %d", version)
+	}
+
+	maxEdgesPerCell := int(d.readInt32())
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell <= 0 || maxEdgesPerCell > 1_000_000 {
+		return fmt.Errorf("invalid maxEdgesPerCell: %d", maxEdgesPerCell)
+	}
+
+	nextID := d.readInt32()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID < 0 {
+		return fmt.Errorf("invalid nextID: %d", nextID)
+	}
+
+	// 2. Shapes
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numShapes > maxEncodedShapes {
+		return fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+	}
+	if int64(nextID) < int64(numShapes) {
+		return fmt.Errorf("nextID %d is less than numShapes %d", nextID, numShapes)
+	}
+
+	shapes := make(map[int32]Shape, numShapes)
+	for range numShapes {
+		shapeID := d.readInt32()
+		tag := typeTag(d.readUint32())
+		shapeLen := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+
+		if shapeID < 0 || shapeID >= nextID {
+			return fmt.Errorf("shape ID %d out of bounds [0, %d)", shapeID, nextID)
+		}
+		if _, exists := shapes[shapeID]; exists {
+			return fmt.Errorf("duplicate shape ID %d in stream", shapeID)
+		}
+		if shapeLen > maxEncodedShapeBytes {
+			return fmt.Errorf("shape data length %d exceeds maximum %d", shapeLen, maxEncodedShapeBytes)
+		}
+
+		shapeBytes := make([]byte, shapeLen)
+		if _, err := io.ReadFull(d.r, shapeBytes); err != nil {
+			return err
+		}
+
+		shapeReader := bytes.NewReader(shapeBytes)
+		shape, err := decodeShape(tag, shapeReader)
+		if err != nil {
+			return fmt.Errorf("error decoding shape %d (tag %d): %w", shapeID, tag, err)
+		}
+		if shapeReader.Len() > 0 {
+			return fmt.Errorf("extra unread bytes (%d) when decoding shape %d", shapeReader.Len(), shapeID)
+		}
+
+		shapes[shapeID] = shape
+	}
+
+	// 3. Cells
+	numCells := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+
+	cells := make([]CellID, numCells)
+	cellMap := make(map[CellID]*ShapeIndexCell, numCells)
+	var prevCellID CellID
+
+	for i := range numCells {
+		cid := CellID(d.readUint64())
+		if d.err != nil {
+			return d.err
+		}
+		if !cid.IsValid() {
+			return fmt.Errorf("invalid cell ID in stream: %v", cid)
+		}
+		if i > 0 && cid <= prevCellID {
+			return fmt.Errorf("cell IDs not in strictly increasing order: %v <= %v", cid, prevCellID)
+		}
+		prevCellID = cid
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped > maxClippedShapesPerCell {
+			return fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, maxClippedShapesPerCell)
+		}
+		if int(numClipped) > len(shapes) {
+			return fmt.Errorf("cell has %d clipped shapes, exceeding total shapes %d", numClipped, len(shapes))
+		}
+
+		cell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, numClipped),
+		}
+
+		var prevShapeID int32 = -1
+		for j := range numClipped {
+			shapeID := d.readInt32()
+			containsByte := d.readUint8()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return d.err
+			}
+
+			shape, ok := shapes[shapeID]
+			if !ok {
+				return fmt.Errorf("clipped shape references unknown shape ID %d", shapeID)
+			}
+			if j > 0 && shapeID <= prevShapeID {
+				return fmt.Errorf("clipped shapes in cell not in strictly increasing order: %d <= %d", shapeID, prevShapeID)
+			}
+			prevShapeID = shapeID
+
+			if containsByte > 1 {
+				return fmt.Errorf("invalid containsCenter byte %d in cell %v", containsByte, cid)
+			}
+			containsCenter := containsByte == 1
+
+			if int(numEdges) > shape.NumEdges() {
+				return fmt.Errorf("clipped shape ID %d has %d edges, exceeding shape edge count %d", shapeID, numEdges, shape.NumEdges())
+			}
+
+			edges := make([]int, numEdges)
+			var prevEdgeID int = -1
+			for k := range numEdges {
+				edgeID := int(d.readInt32())
+				if d.err != nil {
+					return d.err
+				}
+				if edgeID < 0 || edgeID >= shape.NumEdges() {
+					return fmt.Errorf("edge ID %d out of bounds for shape %d (edge count %d)", edgeID, shapeID, shape.NumEdges())
+				}
+				if k > 0 && edgeID <= prevEdgeID {
+					return fmt.Errorf("edge IDs in clipped shape not in strictly increasing order: %d <= %d", edgeID, prevEdgeID)
+				}
+				prevEdgeID = edgeID
+				edges[k] = edgeID
+			}
+
+			cell.shapes[j] = &clippedShape{
+				shapeID:        shapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			}
+		}
+
+		cells[i] = cid
+		cellMap[cid] = cell
+	}
+
+	// Apply decoded state
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.maxEdgesPerCell = maxEdgesPerCell
+	s.nextID = nextID
+	s.shapes = shapes
+	s.cells = cells
+	s.cellMap = cellMap
+	s.pendingAdditionsPos = nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+
+	return nil
+}
+
+func encodeShape(shape Shape, w io.Writer) error {
+	switch s := shape.(type) {
+	case *Polygon:
+		return s.Encode(w)
+	case *Polyline:
+		return s.Encode(w)
+	case *PointVector:
+		return s.Encode(w)
+	case *LaxPolyline:
+		return s.Encode(w)
+	case *LaxPolygon:
+		return s.Encode(w)
+	case *Loop:
+		return s.Encode(w)
+	case *LaxLoop:
+		return s.Encode(w)
+	default:
+		return fmt.Errorf("unsupported shape type %T", shape)
+	}
+}
+
+func decodeShape(tag typeTag, r io.Reader) (Shape, error) {
+	switch tag {
+	case typeTagPolygon:
+		p := new(Polygon)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPolyline:
+		p := new(Polyline)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPointVector:
+		p := new(PointVector)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolyline:
+		p := new(LaxPolyline)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolygon:
+		p := new(LaxPolygon)
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLoop:
+		l := new(Loop)
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	case typeTagLaxLoop:
+		l := new(LaxLoop)
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	default:
+		return nil, fmt.Errorf("unknown shape type tag %d", tag)
+	}
+}
