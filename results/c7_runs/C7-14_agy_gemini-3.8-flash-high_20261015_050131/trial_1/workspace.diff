+func TestShapeIndexZeroEdgeShapes(t *testing.T) {
+	// All zero-edge shapes
+	emptyPoly := makePolygon("", true)
+	fullPoly := makePolygon("full", true)
+	emptyPolyline := Polyline([]Point{})
+	emptyPV := PointVector([]Point{})
+	emptyLaxPolyline := LaxPolylineFromPoints(nil)
+	singlePtLaxPolyline := LaxPolylineFromPoints([]Point{testPoint(0, 0)}) // 1 vertex, 0 edges
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+	fullLaxPoly := LaxPolygonFromPoints([][]Point{{}}) // 1 loop of 0 vertices = full
+	emptyLoop := EmptyLoop()
+	fullLoop := FullLoop()
+	emptyLaxLoop := LaxLoopFromPoints(nil)
+
+	zeroEdgeShapes := []Shape{
+		emptyPoly,
+		fullPoly,
+		&emptyPolyline,
+		&emptyPV,
+		emptyLaxPolyline,
+		singlePtLaxPolyline,
+		emptyLaxPoly,
+		fullLaxPoly,
+		emptyLoop,
+		fullLoop,
+		emptyLaxLoop,
+	}
+
+	index := NewShapeIndex()
+	for _, s := range zeroEdgeShapes {
+		index.Add(s)
+	}
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != len(zeroEdgeShapes) {
+		t.Fatalf("decoded.Len() = %d, want %d", decoded.Len(), len(zeroEdgeShapes))
+	}
+	if decoded.NumEdges() != 0 {
+		t.Fatalf("decoded.NumEdges() = %d, want 0", decoded.NumEdges())
+	}
+
+	for i := range int32(len(zeroEdgeShapes)) {
+		orig := index.Shape(i)
+		dec := decoded.Shape(i)
+		if dec == nil {
+			t.Fatalf("decoded shape %d is nil", i)
+		}
+		if dec.NumEdges() != 0 {
+			t.Errorf("shape %d NumEdges() = %d, want 0", i, dec.NumEdges())
+		}
+		if orig.IsEmpty() != dec.IsEmpty() {
+			t.Errorf("shape %d IsEmpty() = %v, want %v", i, dec.IsEmpty(), orig.IsEmpty())
+		}
+		if orig.IsFull() != dec.IsFull() {
+			t.Errorf("shape %d IsFull() = %v, want %v", i, dec.IsFull(), orig.IsFull())
+		}
+		if orig.NumChains() != dec.NumChains() {
+			t.Errorf("shape %d NumChains() = %d, want %d", i, dec.NumChains(), orig.NumChains())
+		}
+	}
+
+	// Verify spatial index query without Build: full shapes should contain points!
+	queryOrig := NewContainsPointQuery(index, VertexModelSemiOpen)
+	queryDec := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+
+	testPoints := []Point{
+		testPoint(0, 0),
+		testPoint(45, 90),
+		testPoint(-30, -120),
+	}
+	for _, pt := range testPoints {
+		if queryOrig.Contains(pt) != queryDec.Contains(pt) {
+			t.Errorf("Contains(%v) = %v, want %v", pt, queryDec.Contains(pt), queryOrig.Contains(pt))
+		}
+	}
+
+	verifyIndicesMatch(t, index, decoded)
+}
