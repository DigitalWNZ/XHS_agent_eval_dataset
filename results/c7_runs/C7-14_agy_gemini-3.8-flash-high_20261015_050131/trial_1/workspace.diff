+func TestShapeIndexMixedChainCounts(t *testing.T) {
+	// LaxPolygon with mixed chain sizes: 3 vertices, 0 vertices (full loop), 4 vertices
+	mixedLaxPoly := LaxPolygonFromPoints([][]Point{
+		{testPoint(0, 0), testPoint(0, 2), testPoint(2, 0)},
+		{}, // full loop
+		{testPoint(10, 10), testPoint(10, 12), testPoint(12, 12), testPoint(12, 10)},
+	})
+
+	pv := PointVector([]Point{testPoint(1, 1), testPoint(2, 2), testPoint(3, 3), testPoint(4, 4)})
+	polyline := makePolyline("5:5, 6:6, 7:7, 8:8")
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+
+	index := NewShapeIndex()
+	index.Add(mixedLaxPoly)
+	index.Add(&pv)
+	index.Add(polyline)
+	index.Add(emptyLaxPoly)
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 4 {
+		t.Fatalf("decoded.Len() = %d, want 4", decoded.Len())
+	}
+
+	// Check mixed LaxPolygon chains
+	decPoly := decoded.Shape(0).(*LaxPolygon)
+	if decPoly.NumChains() != 3 {
+		t.Fatalf("decPoly.NumChains() = %d, want 3", decPoly.NumChains())
+	}
+	wantChainLengths := []int{3, 0, 4}
+	for i, wantLen := range wantChainLengths {
+		c := decPoly.Chain(i)
+		if c.Length != wantLen {
+			t.Errorf("chain %d length = %d, want %d", i, c.Length, wantLen)
+		}
+	}
+
+	// Check PointVector chains
+	decPV := decoded.Shape(1).(*PointVector)
+	if decPV.NumChains() != 4 {
+		t.Errorf("decPV.NumChains() = %d, want 4", decPV.NumChains())
+	}
+
+	// Check empty LaxPolygon chains
+	decEmpty := decoded.Shape(3).(*LaxPolygon)
+	if decEmpty.NumChains() != 0 {
+		t.Errorf("decEmpty.NumChains() = %d, want 0", decEmpty.NumChains())
+	}
+
+	verifyIndicesMatch(t, index, decoded)
+}
