+func TestShapeIndexShapeIDsSurvive(t *testing.T) {
+	index := NewShapeIndex()
+	s0 := makePolyline("0:0, 1:1")
+	s1 := makePolyline("2:2, 3:3")
+	s2 := makePolyline("4:4, 5:5")
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+
+	if id0 != 0 || id1 != 1 || id2 != 2 {
+		t.Fatalf("unexpected assigned IDs: %d, %d, %d", id0, id1, id2)
+	}
+
+	// Remove middle shape
+	index.Remove(s1)
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(0) == nil {
+		t.Errorf("shape 0 should exist")
+	}
+	if decoded.Shape(1) != nil {
+		t.Errorf("shape 1 should be nil (removed)")
+	}
+	if decoded.Shape(2) == nil {
+		t.Errorf("shape 2 should exist")
+	}
+
+	// Verify all cell references refer only to valid IDs (0 and 2)
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		cell := it.IndexCell()
+		for _, cs := range cell.shapes {
+			if cs.shapeID == 1 {
+				t.Errorf("cell references removed shape ID 1")
+			}
+			if cs.shapeID != 0 && cs.shapeID != 2 {
+				t.Errorf("cell references unexpected shape ID %d", cs.shapeID)
+			}
+		}
+	}
+
+	// Adding a new shape to decoded should assign ID >= 3
+	s3 := makePolyline("6:6, 7:7")
+	id3 := decoded.Add(s3)
+	if id3 < 3 {
+		t.Errorf("new shape assigned ID %d, want >= 3", id3)
+	}
+	decoded.Build()
+	if decoded.Shape(id3) == nil {
+		t.Errorf("new shape ID %d not found in decoded index", id3)
+	}
+}
