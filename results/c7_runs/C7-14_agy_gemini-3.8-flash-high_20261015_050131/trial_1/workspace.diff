+func TestShapeIndexMalformedExhaustive(t *testing.T) {
+	// Base valid index with 2 shapes and spatial cells
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:2, 2:2, 2:0", true))
+	index.Add(makePolyline("0:0, 1:1, 2:2"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	valid := buf.Bytes()
+
+	tests := []struct {
+		name    string
+		corrupt func([]byte) []byte
+	}{
+		{
+			name: "empty bytes",
+			corrupt: func(b []byte) []byte {
+				return []byte{}
+			},
+		},
+		{
+			name: "version 0",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				c[0] = 0
+				return c
+			},
+		},
+		{
+			name: "version 2",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				c[0] = 2
+				return c
+			},
+		},
+		{
+			name: "maxEdgesPerCell negative",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[1:5], uint32(0x80000001))
+				return c
+			},
+		},
+		{
+			name: "maxEdgesPerCell zero",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[1:5], 0)
+				return c
+			},
+		},
+		{
+			name: "maxEdgesPerCell too large",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[1:5], 2_000_000)
+				return c
+			},
+		},
+		{
+			name: "nextID negative",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[5:9], uint32(0xFFFFFFFF))
+				return c
+			},
+		},
+		{
+			name: "nextID less than numShapes",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[5:9], 1) // nextID = 1, but numShapes = 2
+				return c
+			},
+		},
+		{
+			name: "numShapes oversized",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[9:13], 2_000_000)
+				return c
+			},
+		},
+		{
+			name: "shapeID negative",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[13:17], uint32(0xFFFFFFFF))
+				return c
+			},
+		},
+		{
+			name: "shapeID >= nextID",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[13:17], 100)
+				return c
+			},
+		},
+		{
+			name: "typeTag 0",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[17:21], 0)
+				return c
+			},
+		},
+		{
+			name: "typeTag unknown",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[17:21], 9999)
+				return c
+			},
+		},
+		{
+			name: "shapeLen oversized",
+			corrupt: func(b []byte) []byte {
+				c := slices.Clone(b)
+				binary.LittleEndian.PutUint32(c[21:25], 200*1024*1024)
+				return c
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			data := tc.corrupt(valid)
+			dec := NewShapeIndex()
+			if err := dec.Decode(bytes.NewReader(data)); err == nil {
+				t.Errorf("Decode on %s succeeded, want error", tc.name)
+			}
+		})
+	}
+}
