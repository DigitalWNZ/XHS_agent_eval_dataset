+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	// Generate valid encoded bytes from an index
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:4, 4:4, 4:0", true))
+	index.Add(makePolyline("1:1, 2:2, 3:3"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// 1. Truncation tests
+	for length := 0; length < len(validBytes); length++ {
+		truncated := validBytes[:length]
+		dec := NewShapeIndex()
+		if err := dec.Decode(bytes.NewReader(truncated)); err == nil {
+			t.Errorf("Decode on truncated bytes (len %d/%d) succeeded, want error", length, len(validBytes))
+		}
+	}
+
+	// 2. Corrupted version
+	corrupted := slices.Clone(validBytes)
+	corrupted[0] = 99
+	if err := NewShapeIndex().Decode(bytes.NewReader(corrupted)); err == nil {
+		t.Errorf("Decode with corrupted version succeeded, want error")
+	}
+
+	// 3. Corrupted maxEdgesPerCell (set to 0 or negative)
+	corrupted = slices.Clone(validBytes)
+	binary.LittleEndian.PutUint32(corrupted[1:5], 0)
+	if err := NewShapeIndex().Decode(bytes.NewReader(corrupted)); err == nil {
+		t.Errorf("Decode with maxEdgesPerCell=0 succeeded, want error")
+	}
+
+	// 4. Corrupted nextID (negative)
+	corrupted = slices.Clone(validBytes)
+	binary.LittleEndian.PutUint32(corrupted[5:9], uint32(0x80000000))
+	if err := NewShapeIndex().Decode(bytes.NewReader(corrupted)); err == nil {
+		t.Errorf("Decode with negative nextID succeeded, want error")
+	}
+
+	// 5. Oversized allocation requests
+	testOversized := func(name string, mutator func([]byte)) {
+		c := slices.Clone(validBytes)
+		mutator(c)
+		dec := NewShapeIndex()
+		if err := dec.Decode(bytes.NewReader(c)); err == nil {
+			t.Errorf("oversized test %s succeeded, want error", name)
+		}
+	}
+
+	// Oversized numShapes
+	testOversized("numShapes=0xFFFFFFFF", func(b []byte) {
+		binary.LittleEndian.PutUint32(b[9:13], 0xFFFFFFFF)
+	})
+
+	// Oversized shape length
+	testOversized("shapeLen=0xFFFFFFFF", func(b []byte) {
+		// shape 0 header is at offset 13 (shapeID 4 bytes, tag 4 bytes, len 4 bytes)
+		binary.LittleEndian.PutUint32(b[21:25], 0xFFFFFFFF)
+	})
+
+	// Corrupted type tag
+	testOversized("typeTag=9999", func(b []byte) {
+		binary.LittleEndian.PutUint32(b[17:21], 9999)
+	})
+
+	// Random corrupted bytes fuzzing
+	r := rand.New(rand.NewSource(42))
+	for range 100 {
+		fuzzed := slices.Clone(validBytes)
+		// Corrupt 1 to 5 random bytes
+		numCorruptions := r.Intn(5) + 1
+		for range numCorruptions {
+			idx := r.Intn(len(fuzzed))
+			fuzzed[idx] ^= byte(r.Intn(255) + 1)
+		}
+		dec := NewShapeIndex()
+		// Must not panic!
+		_ = dec.Decode(bytes.NewReader(fuzzed))
+	}
+}
