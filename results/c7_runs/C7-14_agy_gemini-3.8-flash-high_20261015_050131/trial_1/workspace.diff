+func TestIndividualShapeEncodings(t *testing.T) {
+	// PointVector
+	pv := PointVector([]Point{testPoint(1, 2), testPoint(3, 4)})
+	var buf bytes.Buffer
+	if err := pv.Encode(&buf); err != nil {
+		t.Fatalf("PointVector.Encode: %v", err)
+	}
+	var decPV PointVector
+	if err := decPV.Decode(&buf); err != nil {
+		t.Fatalf("PointVector.Decode: %v", err)
+	}
+	if !reflect.DeepEqual(pv, decPV) {
+		t.Errorf("PointVector roundtrip mismatch: got %v, want %v", decPV, pv)
+	}
+
+	// LaxPolyline
+	lp := LaxPolylineFromPoints([]Point{testPoint(1, 2), testPoint(3, 4), testPoint(5, 6)})
+	buf.Reset()
+	if err := lp.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolyline.Encode: %v", err)
+	}
+	var decLP LaxPolyline
+	if err := decLP.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolyline.Decode: %v", err)
+	}
+	if !reflect.DeepEqual(lp.vertices, decLP.vertices) {
+		t.Errorf("LaxPolyline roundtrip mismatch: got %v, want %v", decLP.vertices, lp.vertices)
+	}
+
+	// LaxPolygon
+	poly := LaxPolygonFromPoints([][]Point{
+		{testPoint(0, 0), testPoint(0, 2), testPoint(2, 2)},
+		{testPoint(5, 5), testPoint(5, 6), testPoint(6, 6)},
+	})
+	buf.Reset()
+	if err := poly.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolygon.Encode: %v", err)
+	}
+	var decPoly LaxPolygon
+	if err := decPoly.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolygon.Decode: %v", err)
+	}
+	if decPoly.NumChains() != poly.NumChains() || decPoly.NumEdges() != poly.NumEdges() {
+		t.Errorf("LaxPolygon roundtrip mismatch: got %d chains / %d edges, want %d / %d",
+			decPoly.NumChains(), decPoly.NumEdges(), poly.NumChains(), poly.NumEdges())
+	}
+
+	// LaxLoop
+	ll := LaxLoopFromPoints([]Point{testPoint(1, 1), testPoint(2, 2), testPoint(3, 3)})
+	buf.Reset()
+	if err := ll.Encode(&buf); err != nil {
+		t.Fatalf("LaxLoop.Encode: %v", err)
+	}
+	var decLL LaxLoop
+	if err := decLL.Decode(&buf); err != nil {
+		t.Fatalf("LaxLoop.Decode: %v", err)
+	}
+	if !reflect.DeepEqual(ll.vertices, decLL.vertices) {
+		t.Errorf("LaxLoop roundtrip mismatch: got %v, want %v", decLL.vertices, ll.vertices)
+	}
+}
