+func TestShapeIndexUnbuiltEncoding(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:4, 4:4, 4:0", true))
+	index.Add(makePolyline("1:1, 2:2, 3:3"))
+
+	// NOT calling index.Build()!
+	if index.IsFresh() {
+		t.Fatalf("index should not be fresh before Build")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode on unbuilt index failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Errorf("decoded index IsFresh() = false, want true")
+	}
+
+	// Spatial structure should be present and valid without calling Build
+	it := decoded.Iterator()
+	count := 0
+	for it.Begin(); !it.Done(); it.Next() {
+		count++
+		if it.IndexCell() == nil {
+			t.Errorf("cell %v has nil IndexCell", it.CellID())
+		}
+	}
+	if count == 0 {
+		t.Fatalf("expected non-zero cells in decoded index without Build")
+	}
+
+	// ContainsPointQuery should work immediately
+	query := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !query.Contains(testPoint(2, 2)) {
+		t.Errorf("decoded index failed Contains(2, 2)")
+	}
+	if query.Contains(testPoint(10, 10)) {
+		t.Errorf("decoded index unexpectedly contained (10, 10)")
+	}
+}
