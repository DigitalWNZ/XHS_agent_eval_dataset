+func TestShapeIndexEmptyEncodeDecode(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	if buf.Len() == 0 {
+		t.Fatalf("expected non-empty byte stream for empty index, got 0 bytes")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 0 {
+		t.Errorf("decoded.Len() = %d, want 0", decoded.Len())
+	}
+	if decoded.NumEdges() != 0 {
+		t.Errorf("decoded.NumEdges() = %d, want 0", decoded.NumEdges())
+	}
+	if !decoded.IsFresh() {
+		t.Errorf("decoded.IsFresh() = false, want true")
+	}
+
+	it := decoded.Iterator()
+	if !it.Done() {
+		t.Errorf("decoded.Iterator().Done() = false, want true")
+	}
+
+	// ContainsPointQuery should work without Build
+	query := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if query.Contains(testPoint(0, 0)) {
+		t.Errorf("empty index contains point, want false")
+	}
+}
