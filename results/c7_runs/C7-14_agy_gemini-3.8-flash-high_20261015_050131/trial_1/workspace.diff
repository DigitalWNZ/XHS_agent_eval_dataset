+func TestShapeIndexBuiltInShapeTypesRoundTrip(t *testing.T) {
+	// Built-in shapes to test
+	poly := makePolygon("0:0, 0:4, 4:4, 4:0; 1:1, 1:2, 2:2, 2:1", true) // Polygon with a hole
+	polyline := makePolyline("0:0, 2:1, 0:2, 2:3, 0:4")
+	pv := PointVector([]Point{testPoint(10, 10), testPoint(20, 20), testPoint(30, 30)})
+	laxPolyline := LaxPolylineFromPoints([]Point{testPoint(5, 5), testPoint(6, 6), testPoint(7, 7)})
+	laxPoly := LaxPolygonFromPoints([][]Point{
+		{testPoint(0, 10), testPoint(0, 14), testPoint(4, 14), testPoint(4, 10)},
+		{testPoint(1, 11), testPoint(1, 12), testPoint(2, 12), testPoint(2, 11)},
+	})
+	loop := makeLoop("10:0, 10:10, 0:10, 0:0")
+	laxLoop := LaxLoopFromPoints([]Point{testPoint(20, 0), testPoint(20, 5), testPoint(25, 5), testPoint(25, 0)})
+
+	shapes := []Shape{poly, polyline, &pv, laxPolyline, laxPoly, loop, laxLoop}
+
+	index := NewShapeIndex()
+	for _, s := range shapes {
+		index.Add(s)
+	}
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != index.Len() {
+		t.Fatalf("decoded.Len() = %d, want %d", decoded.Len(), index.Len())
+	}
+	if decoded.NumEdges() != index.NumEdges() {
+		t.Fatalf("decoded.NumEdges() = %d, want %d", decoded.NumEdges(), index.NumEdges())
+	}
+	if !decoded.IsFresh() {
+		t.Errorf("decoded.IsFresh() = false, want true")
+	}
+
+	// Verify each shape
+	for i := range int32(len(shapes)) {
+		orig := index.Shape(i)
+		dec := decoded.Shape(i)
+		if dec == nil {
+			t.Fatalf("decoded shape %d is nil", i)
+		}
+		if orig.Dimension() != dec.Dimension() {
+			t.Errorf("shape %d Dimension() = %d, want %d", i, dec.Dimension(), orig.Dimension())
+		}
+		if orig.NumEdges() != dec.NumEdges() {
+			t.Errorf("shape %d NumEdges() = %d, want %d", i, dec.NumEdges(), orig.NumEdges())
+		}
+		if orig.NumChains() != dec.NumChains() {
+			t.Errorf("shape %d NumChains() = %d, want %d", i, dec.NumChains(), orig.NumChains())
+		}
+		if orig.typeTag() != dec.typeTag() {
+			t.Errorf("shape %d typeTag() = %d, want %d", i, dec.typeTag(), orig.typeTag())
+		}
+		for e := range orig.NumEdges() {
+			oe := orig.Edge(e)
+			de := dec.Edge(e)
+			if oe.V0 != de.V0 || oe.V1 != de.V1 {
+				t.Errorf("shape %d edge %d = %v, want %v", i, e, de, oe)
+			}
+		}
+		for c := range orig.NumChains() {
+			oc := orig.Chain(c)
+			dc := dec.Chain(c)
+			if oc != dc {
+				t.Errorf("shape %d chain %d = %v, want %v", i, c, dc, oc)
+			}
+		}
+	}
+
+	// Verify cells and spatial structure without calling Build
+	verifyIndicesMatch(t, index, decoded)
+}
