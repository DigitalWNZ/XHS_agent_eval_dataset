+func TestDecryptReader_ErrorsAndLazyInit(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("secret database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	// Invalid key on DecryptReader
+	_, err = DecryptReader(bytes.NewReader(validBytes), []byte("short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// Wrong magic -> "invalid header" (lazy init: no error until Read)
+	badMagic := append([]byte(nil), validBytes...)
+	badMagic[0] = 0x00
+	dr, err := DecryptReader(bytes.NewReader(badMagic), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+
+	// Wrong version -> "unsupported version"
+	badVersion := append([]byte(nil), validBytes...)
+	badVersion[2] = 0x02
+	dr, err = DecryptReader(bytes.NewReader(badVersion), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+
+	// Tampered HMAC -> "integrity"
+	badHMAC := append([]byte(nil), validBytes...)
+	badHMAC[len(badHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(badHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+
+	// Wrong key -> must fail
+	wrongKey := generateTestKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validBytes), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Truncated data at various positions -> must error
+	for _, cut := range []int{0, 1, 2, 3, 5, 10, len(validBytes) - 36, len(validBytes) - 32, len(validBytes) - 5} {
+		dr, err = DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		assert.Error(t, err, "expected error for truncated stream of length %d", cut)
+	}
+}
