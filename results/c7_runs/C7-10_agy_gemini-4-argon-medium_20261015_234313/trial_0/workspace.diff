+func TestEncryptDecrypt_RoundTripAndFormat(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Test multi-chunk payload (> 64KB, e.g., 150KB)
+	plaintext := make([]byte, 150*1024+123)
+	_, err = io.ReadFull(rand.Reader, plaintext)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	n, err := ew.Write(plaintext)
+	require.NoError(t, err)
+	assert.Equal(t, len(plaintext), n)
+
+	// Close is idempotent
+	require.NoError(t, ew.Close())
+	lenAfterFirstClose := buf.Len()
+	require.NoError(t, ew.Close())
+	assert.Equal(t, lenAfterFirstClose, buf.Len())
+
+	raw := buf.Bytes()
+
+	// Verify 3-byte header: 0x4F 0x44 0x01
+	require.GreaterOrEqual(t, len(raw), HeaderSize+4+HMACSize)
+	assert.Equal(t, byte(0x4F), raw[0])
+	assert.Equal(t, byte(0x44), raw[1])
+	assert.Equal(t, byte(0x01), raw[2])
+
+	// Parse chunks and verify nonces are unique and chunks are <= 64KB plaintext
+	offset := HeaderSize
+	nonces := make(map[string]bool)
+	chunkCount := 0
+	for {
+		require.LessOrEqual(t, offset+4, len(raw))
+		frameLen := binary.BigEndian.Uint32(raw[offset : offset+4])
+		offset += 4
+		if frameLen == 0 {
+			break
+		}
+		chunkCount++
+		assert.LessOrEqual(t, int(frameLen), MaxChunkSize+NonceSize+TagSize)
+		require.LessOrEqual(t, offset+int(frameLen), len(raw))
+		nonce := string(raw[offset : offset+NonceSize])
+		assert.False(t, nonces[nonce], "duplicate nonce detected in chunk %d", chunkCount)
+		nonces[nonce] = true
+		offset += int(frameLen)
+	}
+	assert.Equal(t, 3, chunkCount)
+
+	// Verify 32-byte HMAC over bytes between header and sentinel
+	sentinelPos := offset - 4
+	expectedHMAC := raw[offset:]
+	assert.Len(t, expectedHMAC, HMACSize)
+
+	mac := hmac.New(sha256.New, key)
+	mac.Write(raw[HeaderSize:sentinelPos])
+	assert.True(t, hmac.Equal(expectedHMAC, mac.Sum(nil)))
+
+	// Decrypt and verify round-trip
+	dr, err := DecryptReader(bytes.NewReader(raw), key)
+	require.NoError(t, err)
+	decrypted, err := io.ReadAll(dr)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, decrypted)
+}
