+func TestLoadKey(t *testing.T) {
+	rawKey := generateTestKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// 1. Literal
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// 2. Env
+	const envVar = "ONEDUMP_TEST_ENC_KEY"
+	t.Setenv(envVar, b64Key)
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: envVar})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Unset env var -> error
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_UNSET_KEY_VAR"})
+	require.Error(t, err)
+
+	// 3. File (trimmed)
+	tmpFile := filepath.Join(t.TempDir(), "key.txt")
+	require.NoError(t, os.WriteFile(tmpFile, []byte("  \n"+b64Key+"\n\t "), 0600))
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: tmpFile})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// 4. Derive
+	salt := make([]byte, 16)
+	_, err = io.ReadFull(rand.Reader, salt)
+	require.NoError(t, err)
+	b64Salt := base64.StdEncoding.EncodeToString(salt)
+
+	dk1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-passphrase", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Len(t, dk1, 32)
+
+	dk2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-passphrase", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Equal(t, dk1, dk2)
+
+	// Short salt (< 16 bytes) rejected
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-passphrase", Salt: shortSalt})
+	assert.Error(t, err)
+
+	// Empty passphrase rejected
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt})
+	assert.Error(t, err)
+}
