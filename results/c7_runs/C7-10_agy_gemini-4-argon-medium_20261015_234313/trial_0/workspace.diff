diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..de5a20b
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,197 @@
+package encryption
+
+import (
+	"crypto/pbkdf2"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+// Config holds configuration for dump encryption.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// UnmarshalYAML supports flat lowercase, snake_case, and kebab-case YAML keys.
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled      bool   `yaml:"enabled"`
+		KeySource    string `yaml:"keysource"`
+		KeySourceSnk string `yaml:"key_source"`
+		KeySourceKeb string `yaml:"key-source"`
+		KeyEnvVar    string `yaml:"keyenvvar"`
+		KeyEnvVarSnk string `yaml:"key_env_var"`
+		KeyEnvVarKeb string `yaml:"key-env-var"`
+		KeyFile      string `yaml:"keyfile"`
+		KeyFileSnk   string `yaml:"key_file"`
+		KeyFileKeb   string `yaml:"key-file"`
+		Key          string `yaml:"key"`
+		Passphrase   string `yaml:"passphrase"`
+		Salt         string `yaml:"salt"`
+	}
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySourceSnk, raw.KeySourceKeb)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVarSnk, raw.KeyEnvVarKeb)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFileSnk, raw.KeyFileKeb)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+	return nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+// Validate checks whether the encryption configuration is valid.
+// Disabled configs are always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateFields()
+}
+
+func (c Config) validateFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasPassphrase := strings.TrimSpace(c.Passphrase) != ""
+	hasSalt := strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case KeySourceEnv:
+		if hasFile || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key source 'env' fields are mutually exclusive with KeyFile, Key, Passphrase, and Salt")
+		}
+		if !hasEnv {
+			return errors.New("encryption key environment variable (KeyEnvVar) is required for key source 'env'")
+		}
+	case KeySourceFile:
+		if hasEnv || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key source 'file' fields are mutually exclusive with KeyEnvVar, Key, Passphrase, and Salt")
+		}
+		if !hasFile {
+			return errors.New("encryption key file path (KeyFile) is required for key source 'file'")
+		}
+	case KeySourceLiteral:
+		if hasEnv || hasFile || hasPassphrase || hasSalt {
+			return errors.New("encryption key source 'literal' fields are mutually exclusive with KeyEnvVar, KeyFile, Passphrase, and Salt")
+		}
+		if !hasLiteral {
+			return errors.New("encryption literal key (Key) is required for key source 'literal'")
+		}
+	case KeySourceDerive:
+		if hasEnv || hasFile || hasLiteral {
+			return errors.New("encryption key source 'derive' fields are mutually exclusive with KeyEnvVar, KeyFile, and Key")
+		}
+		if !hasPassphrase {
+			return errors.New("encryption passphrase is required for key source 'derive'")
+		}
+		if !hasSalt {
+			return errors.New("encryption salt is required for key source 'derive'")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %q", c.KeySource)
+	}
+
+	return nil
+}
+
+// LoadKey loads or derives a 32-byte encryption key according to the given Config.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateFields(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envName)
+		}
+		return decodeAndValidateKey(strings.TrimSpace(val), fmt.Sprintf("env var %q", envName))
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		return decodeAndValidateKey(strings.TrimSpace(string(data)), fmt.Sprintf("file %q", filePath))
+
+	case KeySourceLiteral:
+		return decodeAndValidateKey(strings.TrimSpace(cfg.Key), "literal key")
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+		saltBytes, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(saltBytes) < MinSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d bytes", MinSaltSize, len(saltBytes))
+		}
+		derived, err := pbkdf2.Key(sha256.New, cfg.Passphrase, saltBytes, pbkdf2Iterations, KeySize)
+		if err != nil {
+			return nil, fmt.Errorf("failed to derive encryption key: %w", err)
+		}
+		return derived, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %q", cfg.KeySource)
+	}
+}
+
+func decodeAndValidateKey(encoded string, sourceDesc string) ([]byte, error) {
+	if encoded == "" {
+		return nil, fmt.Errorf("%w: empty encryption key from %s", ErrInvalidKey, sourceDesc)
+	}
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode base64 encryption key from %s: %w", sourceDesc, err)
+	}
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: encryption key from %s must be %d bytes, got %d bytes", ErrInvalidKey, sourceDesc, KeySize, len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..720212d
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,333 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	// MagicByte1 and MagicByte2 identify an encrypted OneDump stream ("OD").
+	MagicByte1 = 0x4F
+	MagicByte2 = 0x44
+
+	// StreamVersion is the current wire format version.
+	StreamVersion = 0x01
+
+	// HeaderSize is 2 magic bytes + 1 version byte.
+	HeaderSize = 3
+
+	// MaxChunkSize is the maximum plaintext size per chunk (64KB).
+	MaxChunkSize = 64 * 1024
+
+	// KeySize is the required AES-256 key size in bytes.
+	KeySize = 32
+
+	// NonceSize is the standard GCM nonce size in bytes.
+	NonceSize = 12
+
+	// TagSize is the standard GCM authentication tag size in bytes.
+	TagSize = 16
+
+	// HMACSize is the SHA-256 HMAC size in bytes.
+	HMACSize = 32
+)
+
+var (
+	// ErrInvalidKey is returned when a key is not 32 bytes.
+	ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+)
+
+// Encryptor handles AES-256-GCM streaming encryption.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor with the given 32-byte key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+	return &Encryptor{key: keyCopy}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts written data using AES-256-GCM
+// in chunks of up to 64KB and writes a trailing sentinel and HMAC-SHA256 upon Close.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	var gcm cipher.AEAD
+	if err == nil {
+		gcm, err = cipher.NewGCM(block)
+	}
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, e.key),
+		err: err,
+	}
+}
+
+type encryptWriter struct {
+	w           io.Writer
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	wroteHeader bool
+	closed      bool
+	err         error
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.wroteHeader {
+		return nil
+	}
+	header := [HeaderSize]byte{MagicByte1, MagicByte2, StreamVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return fmt.Errorf("failed to write encryption header: %w", err)
+	}
+	ew.wroteHeader = true
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write on closed EncryptWriter")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if err := ew.ensureHeader(); err != nil {
+		ew.err = err
+		return 0, err
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		chunkSize := len(p)
+		if chunkSize > MaxChunkSize {
+			chunkSize = MaxChunkSize
+		}
+		chunk := p[:chunkSize]
+
+		if err := ew.writeChunk(chunk); err != nil {
+			ew.err = err
+			return totalWritten, err
+		}
+
+		p = p[chunkSize:]
+		totalWritten += chunkSize
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertextWithTag := ew.gcm.Seal(nil, nonce, plaintext, nil)
+	frameLen := uint32(len(nonce) + len(ciphertextWithTag))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], frameLen)
+
+	// Write length prefix
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return fmt.Errorf("failed to write chunk length: %w", err)
+	}
+	ew.mac.Write(lenBuf[:])
+
+	// Write nonce
+	if _, err := ew.w.Write(nonce); err != nil {
+		return fmt.Errorf("failed to write chunk nonce: %w", err)
+	}
+	ew.mac.Write(nonce)
+
+	// Write ciphertext + tag
+	if _, err := ew.w.Write(ciphertextWithTag); err != nil {
+		return fmt.Errorf("failed to write chunk ciphertext: %w", err)
+	}
+	ew.mac.Write(ciphertextWithTag)
+
+	return nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	// Write 4-byte zero sentinel
+	var sentinel [4]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		ew.err = fmt.Errorf("failed to write sentinel: %w", err)
+		return ew.err
+	}
+
+	// Write 32-byte HMAC-SHA256 computed over all bytes between header and sentinel
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		ew.err = fmt.Errorf("failed to write HMAC: %w", err)
+		return ew.err
+	}
+
+	return nil
+}
+
+// DecryptReader returns an io.Reader that lazily reads and decrypts an AES-256-GCM
+// stream produced by EncryptWriter.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create cipher: %w", err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r          io.Reader
+	gcm        cipher.AEAD
+	mac        hash.Hash
+	headerRead bool
+	buf        []byte
+	eof        bool
+	err        error
+}
+
+func (dr *decryptReader) readHeader() error {
+	var header [HeaderSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		return fmt.Errorf("invalid header: truncated stream: %w", io.ErrUnexpectedEOF)
+	}
+	if header[0] != MagicByte1 || header[1] != MagicByte2 {
+		return fmt.Errorf("invalid header: unexpected magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+	if header[2] != StreamVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+	dr.headerRead = true
+	return nil
+}
+
+func (dr *decryptReader) verifyTrailingHMAC() error {
+	var expectedMAC [HMACSize]byte
+	if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+		return fmt.Errorf("truncated stream: missing or incomplete HMAC (integrity check failed): %w", io.ErrUnexpectedEOF)
+	}
+	actualMAC := dr.mac.Sum(nil)
+	if !hmac.Equal(expectedMAC[:], actualMAC) {
+		return errors.New("stream integrity check failed: HMAC mismatch")
+	}
+	dr.eof = true
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if len(dr.buf) > 0 {
+		n := copy(p, dr.buf)
+		dr.buf = dr.buf[n:]
+		return n, nil
+	}
+
+	if dr.eof {
+		return 0, io.EOF
+	}
+
+	if !dr.headerRead {
+		if err := dr.readHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for {
+		var lenBuf [4]byte
+		if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+			dr.err = fmt.Errorf("truncated stream: failed to read chunk length or sentinel: %w", io.ErrUnexpectedEOF)
+			return 0, dr.err
+		}
+
+		frameLen := binary.BigEndian.Uint32(lenBuf[:])
+		if frameLen == 0 {
+			// Sentinel reached; read and verify trailing HMAC
+			if err := dr.verifyTrailingHMAC(); err != nil {
+				dr.err = err
+				return 0, err
+			}
+			return 0, io.EOF
+		}
+
+		minFrameLen := uint32(NonceSize + TagSize)
+		maxFrameLen := uint32(MaxChunkSize + NonceSize + TagSize)
+		if frameLen < minFrameLen || frameLen > maxFrameLen {
+			dr.err = fmt.Errorf("corrupted or truncated chunk: invalid frame length %d (integrity check failed)", frameLen)
+			return 0, dr.err
+		}
+
+		frame := make([]byte, frameLen)
+		if _, err := io.ReadFull(dr.r, frame); err != nil {
+			dr.err = fmt.Errorf("truncated stream: failed to read chunk payload: %w", io.ErrUnexpectedEOF)
+			return 0, dr.err
+		}
+
+		dr.mac.Write(lenBuf[:])
+		dr.mac.Write(frame)
+
+		nonce := frame[:NonceSize]
+		ciphertextWithTag := frame[NonceSize:]
+
+		plaintext, err := dr.gcm.Open(nil, nonce, ciphertextWithTag, nil)
+		if err != nil {
+			dr.err = fmt.Errorf("decryption failed (wrong key or integrity check failed): %w", err)
+			return 0, dr.err
+		}
+
+		if len(plaintext) == 0 {
+			continue
+		}
+
+		n := copy(p, plaintext)
+		dr.buf = plaintext[n:]
+		return n, nil
+	}
+}
