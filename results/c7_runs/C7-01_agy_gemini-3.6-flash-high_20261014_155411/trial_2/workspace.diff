+# /*
+'''
+# */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+typedef struct {
+    uint32_t *limbs;
+    int size;
+    int cap;
+} BigInt;
+
+static void bigint_init(BigInt *b, uint32_t val) {
+    b->cap = 4;
+    b->limbs = (uint32_t *)malloc(b->cap * sizeof(uint32_t));
+    b->limbs[0] = val;
+    b->size = 1;
+}
+
+static void bigint_free(BigInt *b) {
+    free(b->limbs);
+}
+
+static void bigint_add(const BigInt *a, const BigInt *b, BigInt *res) {
+    int max_size = (a->size > b->size ? a->size : b->size) + 1;
+    if (res->cap < max_size) {
+        res->cap = max_size * 2;
+        res->limbs = (uint32_t *)realloc(res->limbs, res->cap * sizeof(uint32_t));
+    }
+    uint64_t carry = 0;
+    int i = 0;
+    for (; i < max_size; i++) {
+        uint64_t va = (i < a->size) ? a->limbs[i] : 0;
+        uint64_t vb = (i < b->size) ? b->limbs[i] : 0;
+        uint64_t sum = va + vb + carry;
+        res->limbs[i] = (uint32_t)(sum % 1000000000ULL);
+        carry = sum / 1000000000ULL;
+    }
+    while (max_size > 1 && res->limbs[max_size - 1] == 0) {
+        max_size--;
+    }
+    res->size = max_size;
+}
+
+static void bigint_print(const BigInt *b) {
+    printf("%u", b->limbs[b->size - 1]);
+    for (int i = b->size - 2; i >= 0; i--) {
+        printf("%09u", b->limbs[i]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) {
+        return 0;
+    }
+    long long n = atoll(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+    BigInt a, b, c;
+    bigint_init(&a, 0);
+    bigint_init(&b, 1);
+    bigint_init(&c, 0);
+
+    for (long long i = 2; i <= n; i++) {
+        bigint_add(&a, &b, &c);
+        BigInt temp = a;
+        a = b;
+        b = c;
+        c = temp;
+    }
+
+    bigint_print(&b);
+
+    bigint_free(&a);
+    bigint_free(&b);
+    bigint_free(&c);
+    return 0;
+}
+
