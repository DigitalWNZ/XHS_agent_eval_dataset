+# /*
+"""
+*/
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define BASE 1000000000ULL
+#define MAX_WORDS 20000
+
+typedef struct {
+    unsigned long long d[MAX_WORDS];
+    int len;
+} BigInt;
+
+static void init_val(BigInt *b, unsigned long long v) {
+    memset(b, 0, sizeof(BigInt));
+    b->len = 1;
+    b->d[0] = v;
+}
+
+static void add(const BigInt *a, const BigInt *b, BigInt *res) {
+    unsigned long long carry = 0;
+    int max_len = a->len > b->len ? a->len : b->len;
+    res->len = 0;
+    for (int i = 0; i < max_len || carry; i++) {
+        unsigned long long sum = carry;
+        if (i < a->len) sum += a->d[i];
+        if (i < b->len) sum += b->d[i];
+        res->d[i] = sum % BASE;
+        carry = sum / BASE;
+        res->len = i + 1;
+    }
+}
+
+static void print_big(const BigInt *a) {
+    if (a->len == 0) { printf("0\n"); return; }
+    printf("%llu", a->d[a->len - 1]);
+    for (int i = a->len - 2; i >= 0; i--) {
+        printf("%09llu", a->d[i]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 0;
+    int n = atoi(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+    static BigInt a, b, c;
+    init_val(&a, 0);
+    init_val(&b, 1);
+    for (int i = 2; i <= n; i++) {
+        add(&a, &b, &c);
+        a = b;
+        b = c;
+    }
+    print_big(&b);
+    return 0;
+}
+# /*
+"""
