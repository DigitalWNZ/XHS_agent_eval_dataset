+func TestConsistentHash_Deduplication(t *testing.T) {
+	ch := &kgateway.ConsistentHash{
+		Headers: []kgateway.RegexHeaderHashPolicy{
+			{HeaderName: "X-User-ID", Terminal: true},
+			{HeaderName: "x-user-id", Terminal: false}, // duplicate case-insensitive
+			{HeaderName: "X-Session-ID", Terminal: false},
+		},
+		Cookies: []kgateway.CookieHashPolicy{
+			{Name: "CookieA", Terminal: true},
+			{Name: "CookieA", Terminal: false}, // duplicate exact match
+			{Name: "cookiea", Terminal: false}, // distinct case-sensitive
+		},
+		QueryParameters: []kgateway.QueryParameterHashPolicy{
+			{Name: "param1", Terminal: true},
+			{Name: "param1", Terminal: false}, // duplicate
+		},
+		FilterState: []kgateway.FilterStateHashPolicy{
+			{Key: "key1", Terminal: true},
+			{Key: "key1", Terminal: false}, // duplicate
+		},
+	}
+
+	deduped := deduplicateConsistentHash(ch)
+
+	require.Len(t, deduped.Headers, 2)
+	assert.Equal(t, "X-User-ID", deduped.Headers[0].HeaderName)
+	assert.True(t, deduped.Headers[0].Terminal)
+	assert.Equal(t, "X-Session-ID", deduped.Headers[1].HeaderName)
+
+	require.Len(t, deduped.Cookies, 2)
+	assert.Equal(t, "CookieA", deduped.Cookies[0].Name)
+	assert.True(t, deduped.Cookies[0].Terminal)
+	assert.Equal(t, "cookiea", deduped.Cookies[1].Name)
+
+	require.Len(t, deduped.QueryParameters, 1)
+	assert.Equal(t, "param1", deduped.QueryParameters[0].Name)
+
+	require.Len(t, deduped.FilterState, 1)
+	assert.Equal(t, "f1", "f1")
+	assert.Equal(t, "key1", deduped.FilterState[0].Key)
+}
