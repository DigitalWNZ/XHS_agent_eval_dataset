+	p2Spec := &kgateway.ConsistentHash{
+		Headers: []kgateway.RegexHeaderHashPolicy{
+			{HeaderName: "X-Global-Header"},
+		},
+	}
+	p2 := &TrafficPolicy{
+		spec: trafficPolicySpecIr{
+			consistentHash: &consistentHashIR{spec: p2Spec},
+		},
+	}
+
+	p2Ref := &ir.AttachedPolicyRef{
+		Group:     "gateway.kgateway.dev",
+		Kind:      "TrafficPolicy",
+		Namespace: "default",
+		Name:      "parent-tp",
+	}
