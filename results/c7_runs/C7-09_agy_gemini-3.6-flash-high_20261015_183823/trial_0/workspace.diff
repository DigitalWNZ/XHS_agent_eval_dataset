+func TestConsistentHash_PolicyMerging(t *testing.T) {
+	// Higher priority policy p1
+	p1Spec := &kgateway.ConsistentHash{
+		Headers: []kgateway.RegexHeaderHashPolicy{
+			{HeaderName: "X-Auth-User"},
+		},
+		Cookies: []kgateway.CookieHashPolicy{
+			{Name: "session"},
+		},
+		// SourceIp is unset (nil)
+	}
+	p1 := &TrafficPolicy{
+		spec: trafficPolicySpecIr{
+			consistentHash: &consistentHashIR{spec: p1Spec},
+		},
+	}
+
+	// Lower priority policy p2
+	p2Spec := &kgateway.ConsistentHash{
+		Headers: []kgateway.RegexHeaderHashPolicy{
+			{HeaderName: "x-auth-user"}, // duplicate
+			{HeaderName: "X-Tenant-ID"},
+		},
+		Cookies: []kgateway.CookieHashPolicy{
+			{Name: "session"}, // duplicate
+			{Name: "tracking"},
+		},
+		QueryParameters: []kgateway.QueryParameterHashPolicy{
+			{Name: "debug"},
+		},
+		SourceIp: &kgateway.SourceIpHashPolicy{
+			Terminal: true,
+		},
+	}
+	p2 := &TrafficPolicy{
+		spec: trafficPolicySpecIr{
+			consistentHash: &consistentHashIR{spec: p2Spec},
+		},
+	}
+
+	p2Ref := &ir.AttachedPolicyRef{
+		Group:     "gateway.kgateway.dev",
+		Kind:      "TrafficPolicy",
+		Namespace: "default",
+		Name:      "parent-tp",
+	}
+	mergeOrigins := ir.MergeOrigins{}
+
+	mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+	mergedCH := p1.spec.consistentHash.spec
+	require.NotNil(t, mergedCH)
+
+	// Headers unioned & deduplicated
+	require.Len(t, mergedCH.Headers, 2)
+	assert.Equal(t, "X-Auth-User", mergedCH.Headers[0].HeaderName)
+	assert.Equal(t, "X-Tenant-ID", mergedCH.Headers[1].HeaderName)
+
+	// Cookies unioned & deduplicated
+	require.Len(t, mergedCH.Cookies, 2)
+	assert.Equal(t, "session", mergedCH.Cookies[0].Name)
+	assert.Equal(t, "tracking", mergedCH.Cookies[1].Name)
+
+	// QueryParameters unioned
+	require.Len(t, mergedCH.QueryParameters, 1)
+	assert.Equal(t, "debug", mergedCH.QueryParameters[0].Name)
+
+	// SourceIp retains higher-priority policy's value (nil)
+	assert.Nil(t, mergedCH.SourceIp)
+
+	// Merge origins recorded under "consistentHash"
+	assert.Contains(t, mergeOrigins.Get("consistentHash"), p2Ref.ID())
+}
