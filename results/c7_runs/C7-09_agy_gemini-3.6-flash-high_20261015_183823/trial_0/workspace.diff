+	assert.True(t, policies[0].Terminal)
+	require.NotNil(t, policies[0].GetHeader().GetRegexRewrite())
+	assert.Equal(t, "^/user/([^/]+)/.*$", policies[0].GetHeader().GetRegexRewrite().GetPattern().GetRegex())
+	assert.Equal(t, "\\1", policies[0].GetHeader().GetRegexRewrite().GetSubstitution())
