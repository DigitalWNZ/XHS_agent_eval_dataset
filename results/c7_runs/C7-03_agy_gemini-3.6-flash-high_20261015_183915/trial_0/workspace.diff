+    def test_deferred_prefetch_related_parent(self):
+        house = House.objects.create(name="My House", address="123 Main St")
+        Room.objects.create(name="Living Room", house=house)
+
+        queryset = House.objects.only("name").prefetch_related(
+            Prefetch(
+                "rooms",
+                queryset=Room.objects.prefetch_related(
+                    Prefetch("house", queryset=House.objects.only("address"))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            h = queryset.first()
+
+        with self.assertNumQueries(0):
+            self.assertEqual(h.rooms.all()[0].house.address, "123 Main St")
+
+        queryset = House.objects.only("name").prefetch_related("rooms__house")
+        with self.assertNumQueries(3):
+            h = queryset.first()
+
+        with self.assertNumQueries(0):
+            self.assertEqual(h.rooms.all()[0].house.address, "123 Main St")
+
     def test_m2m_forward(self):
