@@ -0,0 +1,297 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func generateTestKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	for _, size := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		_, err := NewEncryptor(make([]byte, size))
+		require.Error(t, err)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	cases := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("SELECT * FROM users;")},
+		{"exact_64kb", bytes.Repeat([]byte("A"), 64*1024)},
+		{"multi_chunk_200kb", bytes.Repeat([]byte("0123456789abcdef"), (200*1024)/16)},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+			if len(tc.data) > 0 {
+				n, err := ew.Write(tc.data)
+				require.NoError(t, err)
+				assert.Equal(t, len(tc.data), n)
+			}
+			require.NoError(t, ew.Close())
+			// Idempotent close
+			require.NoError(t, ew.Close())
+
+			dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+			require.NoError(t, err)
+
+			out, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.data, out)
+		})
+	}
+}
