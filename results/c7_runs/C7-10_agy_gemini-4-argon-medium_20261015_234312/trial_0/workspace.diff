+func TestDecryptReaderErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("secret database dump content"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	t.Run("lazy_init_bad_magic", func(t *testing.T) {
+		badMagic := append([]byte(nil), validBytes...)
+		badMagic[0] = 0x00
+		dr, err := DecryptReader(bytes.NewReader(badMagic), key)
+		require.NoError(t, err) // Lazy init: no error yet
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+	})
+
+	t.Run("unsupported_version", func(t *testing.T) {
+		badVer := append([]byte(nil), validBytes...)
+		badVer[2] = 0x02
+		dr, err := DecryptReader(bytes.NewReader(badVer), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+	})
+
+	t.Run("hmac_integrity_failure", func(t *testing.T) {
+		badHMAC := append([]byte(nil), validBytes...)
+		badHMAC[len(badHMAC)-1] ^= 0xFF
+		dr, err := DecryptReader(bytes.NewReader(badHMAC), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+	})
+
+	t.Run("wrong_key", func(t *testing.T) {
+		wrongKey := generateTestKey(t)
+		dr, err := DecryptReader(bytes.NewReader(validBytes), wrongKey)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("truncated_data", func(t *testing.T) {
+		for _, cut := range []int{0, 1, 2, 3, 5, 10, len(validBytes) - 33, len(validBytes) - 10, len(validBytes) - 1} {
+			dr, err := DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+			require.NoError(t, err)
+			_, err = io.ReadAll(dr)
+			require.Error(t, err, "expected error for truncated length %d", cut)
+		}
+	})
+}
