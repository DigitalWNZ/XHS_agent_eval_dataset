diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..a931b27
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,194 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"key_source"`
+	KeyEnvVar  string `yaml:"key_env_var"`
+	KeyFile    string `yaml:"key_file"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled    bool   `yaml:"enabled"`
+		KeySource  string `yaml:"key_source"`
+		KeySource2 string `yaml:"keysource"`
+		KeySource3 string `yaml:"key-source"`
+		KeyEnvVar  string `yaml:"key_env_var"`
+		KeyEnvVar2 string `yaml:"keyenvvar"`
+		KeyEnvVar3 string `yaml:"key-env-var"`
+		KeyFile    string `yaml:"key_file"`
+		KeyFile2   string `yaml:"keyfile"`
+		KeyFile3   string `yaml:"key-file"`
+		Key        string `yaml:"key"`
+		Passphrase string `yaml:"passphrase"`
+		Salt       string `yaml:"salt"`
+	}
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySource2, raw.KeySource3)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVar2, raw.KeyEnvVar3)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFile2, raw.KeyFile3)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+	return nil
+}
+
+func firstNonEmpty(vals ...string) string {
+	for _, v := range vals {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateEnabled()
+}
+
+func (c Config) validateEnabled() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case KeySourceEnv:
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption key source 'env' fields are mutually exclusive with other key sources")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("encryption key env var is required when key source is 'env'")
+		}
+	case KeySourceFile:
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption key source 'file' fields are mutually exclusive with other key sources")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("encryption key file is required when key source is 'file'")
+		}
+	case KeySourceLiteral:
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption key source 'literal' fields are mutually exclusive with other key sources")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("encryption key is required when key source is 'literal'")
+		}
+	case KeySourceDerive:
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("encryption key source 'derive' fields are mutually exclusive with other key sources")
+		}
+		if c.Passphrase == "" {
+			return errors.New("encryption passphrase is required when key source is 'derive'")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption salt is required when key source is 'derive'")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %q", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateEnabled(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envVar := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envVar)
+		}
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(val))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from environment variable %q: %w", envVar, err)
+		}
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: decoded key from environment variable %q has %d bytes, expected %d", ErrInvalidKey, envVar, len(key), KeySize)
+		}
+		return key, nil
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		if trimmed == "" {
+			return nil, fmt.Errorf("%w: encryption key file %q is empty", ErrInvalidKey, filePath)
+		}
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %q: %w", filePath, err)
+		}
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: decoded key from file %q has %d bytes, expected %d", ErrInvalidKey, filePath, len(key), KeySize)
+		}
+		return key, nil
+
+	case KeySourceLiteral:
+		trimmed := strings.TrimSpace(cfg.Key)
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 literal encryption key: %w", err)
+		}
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: decoded literal key has %d bytes, expected %d", ErrInvalidKey, len(key), KeySize)
+		}
+		return key, nil
+
+	case KeySourceDerive:
+		if cfg.Passphrase == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+		saltBytes, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(saltBytes) < MinSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d bytes", MinSaltSize, len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, pbkdf2Iterations, KeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %q", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..44edb23
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,320 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize       = 32
+	MaxChunkSize  = 64 * 1024
+	magicByte0    = 0x4F
+	magicByte1    = 0x44
+	formatVersion = 0x01
+	headerSize    = 3
+	nonceSize     = 12
+	tagSize       = 16
+	sentinelSize  = 4
+	hmacSize      = 32
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+)
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes, expected %d", ErrInvalidKey, len(key), KeySize)
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	return &Encryptor{
+		key: keyCopy,
+	}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		return &encryptWriter{w: w, initErr: err}
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return &encryptWriter{w: w, initErr: err}
+	}
+
+	mac := hmac.New(sha256.New, e.key)
+
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: mac,
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	headerWritten bool
+	closed        bool
+	initErr       error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := [headerSize]byte{magicByte0, magicByte1, formatVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return fmt.Errorf("failed to write encryption header: %w", err)
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(chunk []byte) error {
+	var nonce [nonceSize]byte
+	if _, err := io.ReadFull(rand.Reader, nonce[:]); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce[:], chunk, nil)
+	payloadLen := uint32(nonceSize + len(ciphertext))
+
+	frame := make([]byte, 4+int(payloadLen))
+	binary.BigEndian.PutUint32(frame[:4], payloadLen)
+	copy(frame[4:4+nonceSize], nonce[:])
+	copy(frame[4+nonceSize:], ciphertext)
+
+	ew.mac.Write(frame)
+
+	if _, err := ew.w.Write(frame); err != nil {
+		return fmt.Errorf("failed to write encrypted chunk: %w", err)
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.initErr != nil {
+		return 0, ew.initErr
+	}
+	if ew.closed {
+		return 0, errors.New("cannot write to closed encrypt writer")
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		return 0, err
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		chunkSize := len(p)
+		if chunkSize > MaxChunkSize {
+			chunkSize = MaxChunkSize
+		}
+
+		if err := ew.writeChunk(p[:chunkSize]); err != nil {
+			return totalWritten, err
+		}
+
+		p = p[chunkSize:]
+		totalWritten += chunkSize
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.initErr != nil {
+		return ew.initErr
+	}
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.writeHeader(); err != nil {
+		return err
+	}
+
+	var trailer [sentinelSize + hmacSize]byte
+	// First 4 bytes are zero sentinel (0x00, 0x00, 0x00, 0x00)
+	sum := ew.mac.Sum(nil)
+	copy(trailer[sentinelSize:], sum)
+
+	if _, err := ew.w.Write(trailer[:]); err != nil {
+		return fmt.Errorf("failed to write encryption trailer: %w", err)
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes, expected %d", ErrInvalidKey, len(key), KeySize)
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	eof         bool
+	hasPending  bool
+	pendingLen  uint32
+	buf         []byte
+	err         error
+}
+
+func (dr *decryptReader) initHeader() error {
+	var header [headerSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		return fmt.Errorf("invalid header: failed to read header: %w", err)
+	}
+
+	if header[0] != magicByte0 || header[1] != magicByte1 {
+		return errors.New("invalid header: unrecognized magic bytes")
+	}
+
+	if header[2] != formatVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	return nil
+}
+
+func (dr *decryptReader) verifyTrailer() error {
+	var expectedMAC [hmacSize]byte
+	if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream: failed to read HMAC trailer: %w", io.ErrUnexpectedEOF)
+	}
+
+	actualMAC := dr.mac.Sum(nil)
+	if !hmac.Equal(actualMAC, expectedMAC[:]) {
+		return errors.New("HMAC verification failed: data integrity check failed")
+	}
+
+	dr.eof = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var chunkLen uint32
+	if dr.hasPending {
+		chunkLen = dr.pendingLen
+		dr.hasPending = false
+		dr.pendingLen = 0
+	} else {
+		var lenBuf [4]byte
+		if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+			return fmt.Errorf("truncated encrypted stream: unexpected EOF reading chunk length: %w", io.ErrUnexpectedEOF)
+		}
+		chunkLen = binary.BigEndian.Uint32(lenBuf[:])
+		if chunkLen == 0 {
+			return dr.verifyTrailer()
+		}
+		dr.mac.Write(lenBuf[:])
+	}
+
+	minChunkLen := uint32(nonceSize + tagSize)
+	maxAllowedLen := uint32(MaxChunkSize + nonceSize + tagSize)
+	if chunkLen < minChunkLen || chunkLen > maxAllowedLen {
+		return fmt.Errorf("invalid chunk length %d: data integrity check failed", chunkLen)
+	}
+
+	chunkBuf := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkBuf); err != nil {
+		return fmt.Errorf("truncated encrypted stream: unexpected EOF reading chunk data: %w", io.ErrUnexpectedEOF)
+	}
+	dr.mac.Write(chunkBuf)
+
+	nonce := chunkBuf[:nonceSize]
+	ciphertext := chunkBuf[nonceSize:]
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decryption failed: data integrity check failed: %w", err)
+	}
+
+	dr.buf = append(dr.buf, plaintext...)
+
+	// Read the next 4-byte length prefix to immediately detect sentinel/HMAC or truncation.
+	var nextLenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, nextLenBuf[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream: missing sentinel or chunk length: %w", io.ErrUnexpectedEOF)
+	}
+	nextLen := binary.BigEndian.Uint32(nextLenBuf[:])
+	if nextLen == 0 {
+		return dr.verifyTrailer()
+	}
+
+	dr.mac.Write(nextLenBuf[:])
+	dr.hasPending = true
+	dr.pendingLen = nextLen
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.initialized {
+		dr.initialized = true
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+	}
+
+	for (len(dr.buf) == 0 || (dr.hasPending && len(dr.buf) < len(p))) && !dr.eof {
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+	}
+
+	if len(dr.buf) > 0 {
+		n := copy(p, dr.buf)
+		dr.buf = dr.buf[n:]
+		return n, nil
+	}
+
+	return 0, io.EOF
+}
