+func TestStorageReadWriteCloserEncryptionRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	originalData := []byte("-- MySQL dump test content\nCREATE TABLE t1 (id INT);\nINSERT INTO t1 VALUES (1), (2), (3);\n")
+
+	readers, writer, closer := storageReadWriteCloser(1, true, enc)
+	require.Len(t, readers, 1)
+
+	errCh := make(chan error, 1)
+	go func() {
+		_, wErr := writer.Write(originalData)
+		cErr := closer.Close()
+		errCh <- errors.Join(wErr, cErr)
+	}()
+
+	dr, err := encryption.DecryptReader(readers[0], key)
+	require.NoError(t, err)
+
+	gr, err := gzip.NewReader(dr)
+	require.NoError(t, err)
+	defer gr.Close()
+
+	roundTripped, err := io.ReadAll(gr)
+	require.NoError(t, err)
+	require.NoError(t, <-errCh)
+
+	assert.Equal(t, originalData, roundTripped)
+}
