+	// LaxPolyline oversized count
+	buf.Reset()
+	e = &encoder{w: &buf}
+	e.writeUint8(uint8(encodingVersion))
+	e.writeUvarint(1000000000)
+	var lp LaxPolyline
+	if err := lp.Decode(&buf); err == nil {
+		t.Errorf("LaxPolyline.Decode expected error for oversized count, got nil")
+	}
+
+	// LaxPolygon mismatched loop vertex counts
+	buf.Reset()
+	e = &encoder{w: &buf}
+	e.writeUint8(uint8(encodingVersion))
+	e.writeUvarint(2) // 2 loops
+	e.writeUvarint(5) // total vertices = 5
+	e.writeUvarint(2) // loop 0 count = 2
+	e.writeUvarint(2) // loop 1 count = 2 (sum = 4 != 5)
+	// write 5 points
+	for range 5 {
+		e.writeFloat64(1.0)
+		e.writeFloat64(0.0)
+		e.writeFloat64(0.0)
+	}
+	var laxPoly LaxPolygon
+	if err := laxPoly.Decode(&buf); err == nil {
+		t.Errorf("LaxPolygon.Decode expected error for mismatched loop counts, got nil")
+	}
