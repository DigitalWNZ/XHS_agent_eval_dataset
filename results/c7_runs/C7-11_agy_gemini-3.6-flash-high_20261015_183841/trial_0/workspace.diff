+func TestDecodeMalformedInput(t *testing.T) {
+	// Build a valid encoded ShapeIndex to corrupt
+	validIndex := NewShapeIndex()
+	validIndex.Add(makePolyline("0:0, 1:1, 2:2"))
+	validIndex.Add(LaxPolygonFromPoints([][]Point{parsePoints("10:10, 10:11, 11:11")}))
+	var validBuf bytes.Buffer
+	if err := validIndex.Encode(&validBuf); err != nil {
+		t.Fatalf("validIndex.Encode failed: %v", err)
+	}
+	validBytes := validBuf.Bytes()
+
+	// 1. Truncated inputs
+	for l := 0; l < len(validBytes); l++ {
+		truncated := validBytes[:l]
+		decoded := NewShapeIndex()
+		err := decoded.Decode(bytes.NewReader(truncated))
+		if err == nil {
+			t.Errorf("expected error decoding truncated buffer of length %d, got nil", l)
+		}
+	}
+
+	// 2. Invalid version
+	badVersion := append([]byte(nil), validBytes...)
+	badVersion[0] = 99
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(badVersion)); err == nil {
+		t.Errorf("expected error for unsupported version 99, got nil")
+	}
+
+	// 3. Oversized shape count request
+	var oversizedBuf bytes.Buffer
+	e := &encoder{w: &oversizedBuf}
+	e.writeUint8(shapeIndexEncodingVersion) // version 1
+	e.writeUint32(10)                       // maxEdgesPerCell
+	e.writeInt32(100)                       // nextID
+	e.writeUvarint(1000000000)              // numShapes = 1 billion!
+	dec := NewShapeIndex()
+	if err := dec.Decode(&oversizedBuf); err == nil {
+		t.Errorf("expected error for oversized shape count, got nil")
+	}
+
+	// 4. Oversized cell count request
+	oversizedBuf.Reset()
+	e = &encoder{w: &oversizedBuf}
+	e.writeUint8(shapeIndexEncodingVersion) // version 1
+	e.writeUint32(10)                       // maxEdgesPerCell
+	e.writeInt32(0)                         // nextID
+	e.writeUvarint(0)                       // numShapes = 0
+	e.writeUvarint(1000000000)              // numCells = 1 billion!
+	dec = NewShapeIndex()
+	if err := dec.Decode(&oversizedBuf); err == nil {
+		t.Errorf("expected error for oversized cell count, got nil")
+	}
+
+	// 5. Corrupted uvarint in stream
+	corruptVarintBuf := append([]byte(nil), validBytes...)
+	// Invalidate bytes near middle
+	if len(corruptVarintBuf) > 5 {
+		for i := 4; i < len(corruptVarintBuf); i++ {
+			corruptVarintBuf[i] = 0xFF // high bit set for varint continuation without end
+		}
+	}
+	dec = NewShapeIndex()
+	if err := dec.Decode(bytes.NewReader(corruptVarintBuf)); err == nil {
+		t.Errorf("expected error for corrupted varint stream, got nil")
+	}
+}
