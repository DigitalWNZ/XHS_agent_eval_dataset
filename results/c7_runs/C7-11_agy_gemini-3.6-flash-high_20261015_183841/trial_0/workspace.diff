+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeUint8(uint8(encodingVersion))
+	e.writeUvarint(uint64(p.numLoops))
+	e.writeUvarint(uint64(len(p.vertices)))
+	if p.numLoops > 1 {
+		for i := range p.numLoops {
+			e.writeUvarint(uint64(p.numLoopVertices(i)))
+		}
+	}
+	for _, pt := range p.vertices {
+		e.writeFloat64(pt.X)
+		e.writeFloat64(pt.Y)
+		e.writeFloat64(pt.Z)
+	}
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readUint8()
+	if d.err != nil {
+		return
+	}
+	if version != uint8(encodingVersion) {
+		d.err = fmt.Errorf("unsupported version %d", version)
+		return
+	}
+	numLoops := d.readUvarint()
+	numVertices := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+	if numVertices > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", numVertices, maxEncodedVertices)
+		return
+	}
+
+	loops := make([][]Point, numLoops)
+	if numLoops == 0 {
+		if numVertices != 0 {
+			d.err = fmt.Errorf("invalid LaxPolygon: 0 loops but %d vertices", numVertices)
+			return
+		}
+		*p = *LaxPolygonFromPoints(nil)
+		return
+	}
+
+	if numLoops == 1 {
+		verts := make([]Point, numVertices)
+		for i := range verts {
+			verts[i].X = d.readFloat64()
+			verts[i].Y = d.readFloat64()
+			verts[i].Z = d.readFloat64()
+		}
+		if d.err != nil {
+			return
+		}
+		loops[0] = verts
+		*p = *LaxPolygonFromPoints(loops)
+		return
+	}
+
+	// numLoops > 1
+	loopCounts := make([]int, numLoops)
+	var totalCount uint64
+	for i := range int(numLoops) {
+		cnt := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if cnt > maxEncodedVertices {
+			d.err = fmt.Errorf("loop vertex count %d exceeds maximum", cnt)
+			return
+		}
+		loopCounts[i] = int(cnt)
+		totalCount += cnt
+	}
+	if totalCount != numVertices {
+		d.err = fmt.Errorf("sum of loop vertex counts (%d) does not match total vertices (%d)", totalCount, numVertices)
+		return
+	}
+
+	for i := range int(numLoops) {
+		verts := make([]Point, loopCounts[i])
+		for j := range verts {
+			verts[j].X = d.readFloat64()
+			verts[j].Y = d.readFloat64()
+			verts[j].Z = d.readFloat64()
+		}
+		loops[i] = verts
+	}
+	if d.err != nil {
+		return
+	}
+	*p = *LaxPolygonFromPoints(loops)
+}
