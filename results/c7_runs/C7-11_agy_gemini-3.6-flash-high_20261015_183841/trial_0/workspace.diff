+)
+
+func TestEmptyShapeIndexEncodeDecode(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("index.Encode() failed: %v", err)
+	}
+
+	if buf.Len() == 0 {
+		t.Errorf("expected non-empty byte stream for empty index, got 0 bytes")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("decoded.Decode() failed: %v", err)
+	}
+
+	if decoded.Len() != 0 {
+		t.Errorf("decoded.Len() = %d, want 0", decoded.Len())
+	}
+
+	if !decoded.IsFresh() {
+		t.Errorf("decoded.IsFresh() = false, want true")
+	}
+
+	it := decoded.Iterator()
+	if !it.Done() {
+		t.Errorf("iterator for empty index is not Done")
+	}
+}
+
+func TestShapeTypesEncodeDecode(t *testing.T) {
+	// Test individual shape types Encode and Decode round-trips.
+
+	// PointVector
+	pv := PointVector{
+		PointFromCoords(1, 0, 0),
+		PointFromCoords(0, 1, 0),
+		PointFromCoords(0, 0, 1),
+	}
+	var buf bytes.Buffer
+	if err := pv.Encode(&buf); err != nil {
+		t.Fatalf("PointVector.Encode failed: %v", err)
+	}
+	var pvDec PointVector
+	if err := pvDec.Decode(&buf); err != nil {
+		t.Fatalf("PointVector.Decode failed: %v", err)
+	}
+	if !reflect.DeepEqual(pv, pvDec) {
+		t.Errorf("PointVector round-trip mismatch: got %v, want %v", pvDec, pv)
+	}
+
+	// Empty PointVector
+	pvEmpty := PointVector{}
+	buf.Reset()
+	if err := pvEmpty.Encode(&buf); err != nil {
+		t.Fatalf("Empty PointVector.Encode failed: %v", err)
+	}
+	var pvEmptyDec PointVector
+	if err := pvEmptyDec.Decode(&buf); err != nil {
+		t.Fatalf("Empty PointVector.Decode failed: %v", err)
+	}
+	if len(pvEmptyDec) != 0 {
+		t.Errorf("Empty PointVector decoded length = %d, want 0", len(pvEmptyDec))
+	}
+
+	// LaxPolyline
+	laxPolyline := LaxPolylineFromPoints(parsePoints("0:0, 1:1, 2:2"))
+	buf.Reset()
+	if err := laxPolyline.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolyline.Encode failed: %v", err)
+	}
+	var laxPolylineDec LaxPolyline
+	if err := laxPolylineDec.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolyline.Decode failed: %v", err)
+	}
+	if !reflect.DeepEqual(laxPolyline, &laxPolylineDec) {
+		t.Errorf("LaxPolyline round-trip mismatch: got %v, want %v", &laxPolylineDec, laxPolyline)
+	}
+
+	// LaxPolygon (single loop)
+	laxPoly := LaxPolygonFromPoints([][]Point{parsePoints("0:0, 0:1, 1:1, 1:0")})
+	buf.Reset()
+	if err := laxPoly.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolygon.Encode failed: %v", err)
+	}
+	var laxPolyDec LaxPolygon
+	if err := laxPolyDec.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolygon.Decode failed: %v", err)
+	}
+	if laxPolyDec.NumEdges() != laxPoly.NumEdges() || laxPolyDec.NumChains() != laxPoly.NumChains() {
+		t.Errorf("LaxPolygon round-trip mismatch: edges %d vs %d, chains %d vs %d",
+			laxPolyDec.NumEdges(), laxPoly.NumEdges(), laxPolyDec.NumChains(), laxPoly.NumChains())
+	}
+
+	// LaxPolygon (empty & full)
+	laxEmpty := LaxPolygonFromPoints(nil)
+	buf.Reset()
+	if err := laxEmpty.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolygon empty Encode failed: %v", err)
+	}
+	var laxEmptyDec LaxPolygon
+	if err := laxEmptyDec.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolygon empty Decode failed: %v", err)
+	}
+	if !laxEmptyDec.IsEmpty() {
+		t.Errorf("laxEmptyDec.IsEmpty() = false, want true")
+	}
+
+	laxFull := LaxPolygonFromPoints([][]Point{{}})
+	buf.Reset()
+	if err := laxFull.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolygon full Encode failed: %v", err)
+	}
+	var laxFullDec LaxPolygon
+	if err := laxFullDec.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolygon full Decode failed: %v", err)
+	}
+	if !laxFullDec.IsFull() {
+		t.Errorf("laxFullDec.IsFull() = false, want true")
+	}
+
+	// LaxPolygon (mixed chain counts: loop 0 empty, loop 1 has 3 vertices)
+	laxMixed := LaxPolygonFromPoints([][]Point{{}, parsePoints("0:0, 0:1, 1:0")})
+	buf.Reset()
+	if err := laxMixed.Encode(&buf); err != nil {
+		t.Fatalf("LaxPolygon mixed Encode failed: %v", err)
+	}
+	var laxMixedDec LaxPolygon
+	if err := laxMixedDec.Decode(&buf); err != nil {
+		t.Fatalf("LaxPolygon mixed Decode failed: %v", err)
+	}
+	if laxMixedDec.NumChains() != 2 || laxMixedDec.NumEdges() != 3 {
+		t.Errorf("LaxPolygon mixed decoded chains=%d edges=%d, want 2 and 3",
+			laxMixedDec.NumChains(), laxMixedDec.NumEdges())
+	}
+	if laxMixedDec.Chain(0).Length != 0 || laxMixedDec.Chain(1).Length != 3 {
+		t.Errorf("LaxPolygon mixed decoded chain lengths: chain 0=%d, chain 1=%d, want 0 and 3",
+			laxMixedDec.Chain(0).Length, laxMixedDec.Chain(1).Length)
+	}
+}
