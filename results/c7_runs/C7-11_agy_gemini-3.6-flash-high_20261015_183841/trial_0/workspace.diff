diff --git a/s2/shapeindex.go b/s2/shapeindex.go
index 60f7257..6899248 100644
--- a/s2/shapeindex.go
+++ b/s2/shapeindex.go
@@ -15,6 +15,8 @@
 package s2
 
 import (
+	"fmt"
+	"io"
 	"math"
 	"slices"
 	"sort"
@@ -1540,3 +1542,242 @@ func maxLevelForEdge(edge Edge) int {
 func (s *ShapeIndex) removeShapeInternal(removed *removedShape, allEdges [][]faceEdge, t *tracker) {
 	// TODO(roberts): finish the implementation of this.
 }
+
+const (
+	shapeIndexEncodingVersion = uint8(1)
+
+	maxEncodedShapes        = 100000000
+	maxEncodedCells         = 100000000
+	maxEncodedClippedShapes = 100000000
+	maxEncodedEdges         = 100000000
+)
+
+// Encode encodes the ShapeIndex into the given writer.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+
+	e.writeUint8(shapeIndexEncodingVersion)
+	e.writeUint32(uint32(s.maxEdgesPerCell))
+	e.writeInt32(s.nextID)
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		shapeIDs = append(shapeIDs, id)
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUvarint(uint64(len(shapeIDs)))
+	for _, id := range shapeIDs {
+		shape := s.shapes[id]
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			return fmt.Errorf("shape ID %d of type %T cannot be encoded", id, shape)
+		}
+
+		e.writeInt32(id)
+		e.writeUint32(uint32(tag))
+
+		switch tag {
+		case typeTagPolygon:
+			if err := shape.(*Polygon).Encode(e.w); err != nil {
+				return err
+			}
+		case typeTagPolyline:
+			if err := shape.(*Polyline).Encode(e.w); err != nil {
+				return err
+			}
+		case typeTagPointVector:
+			if err := shape.(*PointVector).Encode(e.w); err != nil {
+				return err
+			}
+		case typeTagLaxPolyline:
+			if err := shape.(*LaxPolyline).Encode(e.w); err != nil {
+				return err
+			}
+		case typeTagLaxPolygon:
+			if err := shape.(*LaxPolygon).Encode(e.w); err != nil {
+				return err
+			}
+		default:
+			return fmt.Errorf("unsupported shape type tag %d for shape ID %d", tag, id)
+		}
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		cell := s.cellMap[cellID]
+		e.writeUint64(uint64(cellID))
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, cs := range cell.shapes {
+			e.writeInt32(cs.shapeID)
+			e.writeBool(cs.containsCenter)
+			e.writeUvarint(uint64(len(cs.edges)))
+			for _, edgeID := range cs.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+
+	return e.err
+}
+
+// Decode decodes a ShapeIndex from the given reader.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.shapes = make(map[int32]Shape)
+	s.cellMap = make(map[CellID]*ShapeIndexCell)
+	s.cells = nil
+	s.pendingRemovals = nil
+	s.pendingAdditionsPos = 0
+
+	d := &decoder{r: asByteReader(r)}
+
+	version := d.readUint8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("unsupported ShapeIndex version %d", version)
+	}
+
+	s.maxEdgesPerCell = int(d.readUint32())
+	s.nextID = d.readInt32()
+	if s.nextID < 0 {
+		return fmt.Errorf("invalid negative nextID %d", s.nextID)
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numShapes > maxEncodedShapes {
+		return fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+	}
+
+	for range int(numShapes) {
+		shapeID := d.readInt32()
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return d.err
+		}
+		if shapeID < 0 || shapeID >= s.nextID {
+			return fmt.Errorf("invalid shape ID %d (nextID is %d)", shapeID, s.nextID)
+		}
+
+		var shape Shape
+		switch tag {
+		case typeTagPolygon:
+			poly := new(Polygon)
+			if err := poly.Decode(d.r); err != nil {
+				return err
+			}
+			shape = poly
+		case typeTagPolyline:
+			poly := new(Polyline)
+			if err := poly.Decode(d.r); err != nil {
+				return err
+			}
+			shape = poly
+		case typeTagPointVector:
+			pv := new(PointVector)
+			if err := pv.Decode(d.r); err != nil {
+				return err
+			}
+			shape = pv
+		case typeTagLaxPolyline:
+			lp := new(LaxPolyline)
+			if err := lp.Decode(d.r); err != nil {
+				return err
+			}
+			shape = lp
+		case typeTagLaxPolygon:
+			lp := new(LaxPolygon)
+			if err := lp.Decode(d.r); err != nil {
+				return err
+			}
+			shape = lp
+		default:
+			return fmt.Errorf("unsupported shape type tag %d for shape ID %d", tag, shapeID)
+		}
+
+		s.shapes[shapeID] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+
+	s.cells = make([]CellID, numCells)
+	for i := range int(numCells) {
+		rawCellID := d.readUint64()
+		cellID := CellID(rawCellID)
+		if !cellID.IsValid() {
+			return fmt.Errorf("invalid cell ID %v", rawCellID)
+		}
+
+		numClippedShapes := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if numClippedShapes > maxEncodedClippedShapes {
+			return fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClippedShapes, maxEncodedClippedShapes)
+		}
+
+		indexCell := NewShapeIndexCell(int(numClippedShapes))
+		for j := range int(numClippedShapes) {
+			csShapeID := d.readInt32()
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if numEdges > maxEncodedEdges {
+				return fmt.Errorf("too many edges in clipped shape (%d; max is %d)", numEdges, maxEncodedEdges)
+			}
+
+			shape, ok := s.shapes[csShapeID]
+			if !ok {
+				return fmt.Errorf("clipped shape refers to non-existent shape ID %d", csShapeID)
+			}
+
+			cs := newClippedShape(csShapeID, int(numEdges))
+			cs.containsCenter = containsCenter
+			for k := range int(numEdges) {
+				edgeID := int(d.readUvarint())
+				if d.err != nil {
+					return d.err
+				}
+				if edgeID < 0 || edgeID >= shape.NumEdges() {
+					return fmt.Errorf("invalid edge ID %d for shape ID %d (NumEdges is %d)", edgeID, csShapeID, shape.NumEdges())
+				}
+				cs.edges[k] = edgeID
+			}
+			indexCell.shapes[j] = cs
+		}
+
+		s.cellMap[cellID] = indexCell
+		s.cells[i] = cellID
+	}
+
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+
+	return d.err
+}
