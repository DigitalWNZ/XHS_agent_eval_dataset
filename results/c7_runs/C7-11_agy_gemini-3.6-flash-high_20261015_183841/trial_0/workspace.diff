+			sLaxMixed.NumChains(), sLaxMixed.NumEdges())
+	}
+	if sLaxMixed.Chain(0).Length != 0 || sLaxMixed.Chain(1).Length != 3 {
+		t.Errorf("decoded mixed LaxPolygon chain lengths: %d, %d, want 0, 3",
+			sLaxMixed.Chain(0).Length, sLaxMixed.Chain(1).Length)
+	}
+}
