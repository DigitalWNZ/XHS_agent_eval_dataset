+func TestShapeIDsSurvivalWithRemovals(t *testing.T) {
+	index := NewShapeIndex()
+
+	s0 := makePolyline("0:0, 1:1")
+	s1 := makePolyline("2:2, 3:3")
+	s2 := makePolyline("4:4, 5:5")
+
+	id0 := index.Add(s0) // 0
+	id1 := index.Add(s1) // 1
+	id2 := index.Add(s2) // 2
+
+	index.Remove(s1) // Remove s1 (ID 1)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 2 {
+		t.Errorf("decoded.Len() = %d, want 2", decoded.Len())
+	}
+
+	if decoded.Shape(id0) == nil {
+		t.Errorf("decoded.Shape(%d) is nil, expected shape 0", id0)
+	}
+	if decoded.Shape(id1) != nil {
+		t.Errorf("decoded.Shape(%d) is not nil, expected shape 1 to be removed", id1)
+	}
+	if decoded.Shape(id2) == nil {
+		t.Errorf("decoded.Shape(%d) is nil, expected shape 2", id2)
+	}
+
+	// Add a new shape to decoded index and verify it gets assigned ID 3 (nextID survived)
+	s3 := makePolyline("6:6, 7:7")
+	id3 := decoded.Add(s3)
+	if id3 != 3 {
+		t.Errorf("decoded.Add() returned ID %d, want 3", id3)
+	}
+}
