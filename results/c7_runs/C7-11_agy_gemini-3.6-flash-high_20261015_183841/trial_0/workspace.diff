+func TestShapeIndexEncodeDecodeAllBuiltinShapes(t *testing.T) {
+	index := NewShapeIndex()
+
+	// 1. Polygon
+	poly := makePolygon("0:0, 0:2, 2:2, 2:0", false)
+	idPoly := index.Add(poly)
+
+	// 2. Polyline
+	polyline := makePolyline("0:0, 1:1, 2:2")
+	idPolyline := index.Add(polyline)
+
+	// 3. PointVector
+	pv := &PointVector{
+		PointFromCoords(1, 0, 0),
+		PointFromCoords(0, 1, 0),
+	}
+	idPV := index.Add(pv)
+
+	// 4. LaxPolyline
+	laxPolyline := LaxPolylineFromPoints(parsePoints("3:3, 4:4, 5:5"))
+	idLaxPolyline := index.Add(laxPolyline)
+
+	// 5. LaxPolygon
+	laxPoly := LaxPolygonFromPoints([][]Point{parsePoints("10:10, 10:12, 12:12, 12:10")})
+	idLaxPoly := index.Add(laxPoly)
+
+	// Note: We deliberately do NOT call index.Build() before Encode!
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("index.Encode() failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("decoded.Decode() failed: %v", err)
+	}
+
+	if decoded.Len() != 5 {
+		t.Errorf("decoded.Len() = %d, want 5", decoded.Len())
+	}
+
+	// Verify Shape IDs survive encoding
+	if decoded.Shape(idPoly) == nil || decoded.Shape(idPoly).Dimension() != 2 {
+		t.Errorf("decoded shape %d is invalid", idPoly)
+	}
+	if decoded.Shape(idPolyline) == nil || decoded.Shape(idPolyline).Dimension() != 1 {
+		t.Errorf("decoded shape %d is invalid", idPolyline)
+	}
+	if decoded.Shape(idPV) == nil || decoded.Shape(idPV).Dimension() != 0 {
+		t.Errorf("decoded shape %d is invalid", idPV)
+	}
+	if decoded.Shape(idLaxPolyline) == nil || decoded.Shape(idLaxPolyline).Dimension() != 1 {
+		t.Errorf("decoded shape %d is invalid", idLaxPolyline)
+	}
+	if decoded.Shape(idLaxPoly) == nil || decoded.Shape(idLaxPoly).Dimension() != 2 {
+		t.Errorf("decoded shape %d is invalid", idLaxPoly)
+	}
+
+	// Verify queries and iteration work directly without calling Build
+	var count int
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		count++
+		if !it.CellID().IsValid() {
+			t.Errorf("invalid cell ID in decoded iterator: %v", it.CellID())
+		}
+	}
+	if count == 0 {
+		t.Errorf("iterator yielded 0 cells in decoded index")
+	}
+
+	// Verify point query on decoded index works without Build
+	containsQuery := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	pInPoly := PointFromLatLng(LatLngFromDegrees(1, 1))
+	if !containsQuery.Contains(pInPoly) {
+		t.Errorf("ContainsPointQuery returned false for point inside polygon")
+	}
+}
