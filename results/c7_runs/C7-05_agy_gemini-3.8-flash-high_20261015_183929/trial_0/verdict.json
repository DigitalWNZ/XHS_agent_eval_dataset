 "model_patch": "diff --git a/django/db/models/fields/json.py b/django/db/models/fields/json.py\nindex fdca700c9d..b9719f1acf 100644\n--- a/django/db/models/fields/json.py\n+++ b/django/db/models/fields/json.py\n@@ -193,13 +193,10 @@ class HasKeyLookup(PostgresOperatorLookup):\n                 *_, rhs_key_transforms = key.preprocess_lhs(compiler, connection)\n             else:\n                 rhs_key_transforms = [key]\n-            rhs_params.append(\n-                \"%s%s\"\n-                % (\n-                    lhs_json_path,\n-                    compile_json_path(rhs_key_transforms, include_root=False),\n-                )\n-            )\n+            *rhs_key_transforms, final_key = rhs_key_transforms\n+            rhs_json_path = compile_json_path(rhs_key_transforms, include_root=False)\n+            rhs_json_path += \".%s\" % json.dumps(str(final_key))\n+            rhs_params.append(\"%s%s\" % (lhs_json_path, rhs_json_path))\n         # Add condition for each key.\n         if self.logical_operator:\n             sql = \"(%s)\" % self.logical_operator.join([sql] * len(rhs_params))\n@@ -237,6 +234,11 @@ class HasKey(HasKeyLookup):\n     postgres_operator = \"?\"\n     prepare_rhs = False\n \n+    def get_prep_lookup(self):\n+        if hasattr(self.rhs, \"resolve_expression\"):\n+            return self.rhs\n+        return str(self.rhs)\n+\n \n class HasKeys(HasKeyLookup):\n     lookup_name = \"has_keys\"\n@@ -244,7 +246,10 @@ class HasKeys(HasKeyLookup):\n     logical_operator = \" AND \"\n \n     def get_prep_lookup(self):\n-        return [str(item) for item in self.rhs]\n+        return [\n+            item if hasattr(item, \"resolve_expression\") else str(item)\n+            for item in self.rhs\n+        ]\n \n \n class HasAnyKeys(HasKeys):\n@@ -387,25 +392,25 @@ class KeyTransformTextLookupMixin:\n class KeyTransformIsNull(lookups.IsNull):\n     # key__isnull=False is the same as has_key='key'\n     def as_oracle(self, compiler, connectio