+#include <string.h>
+
+/* Arbitrary-precision Fibonacci using base-1e9 limbs. */
+int main(int argc, char **argv) {
+    if (argc < 2) { fprintf(stderr, "usage: %s N\n", argv[0]); return 1; }
+    long n = atol(argv[1]);
+    size_t cap = (size_t)(n / 40 + 2);
+    unsigned int *a = calloc(cap, sizeof *a), *b = calloc(cap, sizeof *b);
+    size_t len = 1;
+    a[0] = 0; b[0] = 1;            /* a = f(0), b = f(1) */
+    for (long i = 0; i < n; i++) { /* (a, b) = (b, a + b) */
+        unsigned int carry = 0;
+        for (size_t j = 0; j < len; j++) {
+            unsigned int s = a[j] + b[j] + carry;
+            carry = s >= 1000000000u;
+            if (carry) s -= 1000000000u;
+            a[j] = b[j];
+            b[j] = s;
+        }
+        if (carry) { a[len] = 0; b[len] = carry; len++; }
+    }
+    size_t top = len;
+    while (top > 1 && a[top - 1] == 0) top--;
+    printf("%u", a[top - 1]);
+    for (size_t j = top - 1; j-- > 0;) printf("%09u", a[j]);
+    printf("\n");
+    free(a); free(b);
+    return 0;
+}
