+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out trafficPolicySpecIr
+			err := constructConsistentHash(tt.spec, &out)
+			if tt.expectErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			if tt.expectNil {
+				assert.Nil(t, out.consistentHash)
+				return
+			}
+			require.NotNil(t, out.consistentHash)
+			assert.Equal(t, tt.expectDisable, out.consistentHash.disable)
+			assertHashPoliciesEqual(t, tt.expectedPolicies, out.consistentHash.hashPolicies)
+		})
+	}
+}
