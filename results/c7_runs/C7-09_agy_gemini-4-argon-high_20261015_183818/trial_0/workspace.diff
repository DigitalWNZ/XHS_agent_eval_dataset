+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	buildPolicy := func(name string, ch *kgateway.ConsistentHash) ir.PolicyAtt {
+		var spec trafficPolicySpecIr
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, &spec)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{
+				Group:     gk.Group,
+				Kind:      gk.Kind,
+				Namespace: "default",
+				Name:      name,
+			},
+			PolicyIr: &TrafficPolicy{
+				ct:   time.Now(),
+				spec: spec,
+			},
+		}
+	}
+
+	t.Run("unions array fields with higher-priority first, deduplicates by key, re-sorts canonically, and retains unset sourceIp from higher-priority", func(t *testing.T) {
+		// Higher priority policy has cookies, filterState, and one header; sourceIp is unset!
+		highPol := buildPolicy("high-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Shared-Header", Terminal: new(true)},
+				{HeaderName: "X-High-Header", Terminal: new(false)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "shared-cookie", Path: new("/high"), Terminal: new(true)},
+				{Name: "high-cookie", Path: new("/hc")},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "shared-fs", Terminal: new(true)},
+			},
+		})
+
+		// Lower priority policy has headers (with different casing for shared), cookies, queryParameters, filterState, and sourceIp
+		lowPol := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared-header", Terminal: new(false)},
+				{HeaderName: "X-Low-Header", Terminal: new(true)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "shared-cookie", Path: new("/low"), Terminal: new(false)},
+				{Name: "low-cookie", Path: new("/lc")},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "low-qp", Terminal: new(true)},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "shared-fs", Terminal: new(false)},
+				{Key: "low-fs", Terminal: new(false)},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{highPol, lowPol}, mergeTrafficPolicies, "")
+		mergedTP, ok := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.True(t, ok)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.False(t, mergedTP.spec.consistentHash.disable)
+
+		expected := []*envoyroutev3.RouteAction_HashPolicy{
+			// 1. Headers: high first, then low (deduplicated case-insensitively)
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Shared-Header"},
+				},
+				Terminal: true,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-High-Header"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Low-Header"},
+				},
+				Terminal: true,
+			},
+			// 2. Cookies: high first, then low
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+					Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{Name: "shared-cookie", Path: "/high"},
+				},
+				Terminal: true,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+					Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{Name: "high-cookie", Path: "/hc"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+					Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{Name: "low-cookie", Path: "/lc"},
+				},
+				Terminal: false,
+			},
+			// 3. QueryParameters: from low
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+					QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: "low-qp"},
+				},
+				Terminal: true,
+			},
+			// 4. FilterState: high first, then low
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+					FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{Key: "shared-fs"},
+				},
+				Terminal: true,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+					FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{Key: "low-fs"},
+				},
+				Terminal: false,
+			},
+			// 5. SourceIP: omitted because highPol had sourceIp unset!
+		}
+		assertHashPoliciesEqual(t, expected, mergedTP.spec.consistentHash.hashPolicies)
+
+		// Verify merge metadata records consistentHash with both policy refs
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-pol",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-pol",
+		}, origins)
+	})
+
+	t.Run("retains higher-priority sourceIp when set and re-sorts canonically", func(t *testing.T) {
+		highPol := buildPolicy("high-pol", &kgateway.ConsistentHash{
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		})
+		lowPol := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user-id"},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(false),
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{highPol, lowPol}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		expected := []*envoyroutev3.RouteAction_HashPolicy{
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "x-user-id"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+					ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{SourceIp: true},
+				},
+				Terminal: true,
+			},
+		}
+		assertHashPoliciesEqual(t, expected, mergedTP.spec.consistentHash.hashPolicies)
+	})
+
+	t.Run("higher-priority disable=true suppresses broader-scoped policy", func(t *testing.T) {
+		highPol := buildPolicy("high-disable", &kgateway.ConsistentHash{
+			Disable: new(true),
+		})
+		lowPol := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user-id"},
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{highPol, lowPol}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+		assert.Empty(t, mergedTP.spec.consistentHash.hashPolicies)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-disable",
+		}, origins)
+	})
+}
