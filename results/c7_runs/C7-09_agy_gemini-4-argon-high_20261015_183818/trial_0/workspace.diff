+func assertHashPoliciesEqual(t *testing.T, expected, actual []*envoyroutev3.RouteAction_HashPolicy) {
+	t.Helper()
+	require.Len(t, actual, len(expected))
+	for i := range expected {
+		assert.True(t, proto.Equal(expected[i], actual[i]),
+			"hashPolicy[%d] mismatch:\nexpected: %v\nactual:   %v", i, expected[i], actual[i])
+	}
+}
