+func TestConsistentHashIRValidate(t *testing.T) {
+	tests := []struct {
+		name        string
+		ir          *consistentHashIR
+		expectError bool
+	}{
+		{
+			name:        "nil IR is valid",
+			ir:          nil,
+			expectError: false,
+		},
+		{
+			name:        "empty IR is valid",
+			ir:          &consistentHashIR{},
+			expectError: false,
+		},
+		{
+			name: "valid header with regex rewrite",
+			ir: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-version",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^v([0-9]+)\\..*$"},
+									Substitution: "\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+			expectError: false,
+		},
+		{
+			name: "invalid regex in header regex rewrite",
+			ir: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-version",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "[invalid("},
+									Substitution: "\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+			expectError: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.ir.Validate()
+			if tt.expectError {
+				assert.Error(t, err)
+			} else {
+				assert.NoError(t, err)
+			}
+		})
+	}
+}
