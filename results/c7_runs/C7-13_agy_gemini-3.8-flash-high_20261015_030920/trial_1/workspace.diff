+func TestStorageReadWriteCloser_EncryptionRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	count := 2
+	readers, writer, closer := storageReadWriteCloser(count, true, enc)
+
+	originalData := make([]byte, 100*1024) // 100KB test data
+	_, err = io.ReadFull(rand.Reader, originalData)
+	require.NoError(t, err)
+
+	errCh := make(chan error, count+1)
+
+	// In goroutine, write original data to writer and close
+	go func() {
+		_, err := writer.Write(originalData)
+		if err != nil {
+			errCh <- err
+		}
+		if closeErr := closer.Close(); closeErr != nil {
+			errCh <- closeErr
+		}
+	}()
+
+	// Read from each pipe reader, decrypt through DecryptReader, then decompress through gzip.NewReader
+	for i := 0; i < count; i++ {
+		r := readers[i]
+		go func(reader io.Reader) {
+			decReader, err := encryption.DecryptReader(reader, key)
+			if err != nil {
+				errCh <- err
+				return
+			}
+			gzReader, err := gzip.NewReader(decReader)
+			if err != nil {
+				errCh <- err
+				return
+			}
+			defer gzReader.Close()
+
+			data, err := io.ReadAll(gzReader)
+			if err != nil {
+				errCh <- err
+				return
+			}
+			if !bytes.Equal(data, originalData) {
+				errCh <- errors.New("data mismatch")
+				return
+			}
+			errCh <- nil
+		}(r)
+	}
+
+	for i := 0; i < count; i++ {
+		readErr := <-errCh
+		require.NoError(t, readErr)
+	}
+}
