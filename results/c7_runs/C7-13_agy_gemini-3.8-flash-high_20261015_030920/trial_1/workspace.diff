+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+)
+
+func generateRandomBytes(n int) []byte {
+	b := make([]byte, n)
+	rand.Read(b)
+	return b
+}
+
+func TestNewEncryptor(t *testing.T) {
+	// Non-32-byte keys must be rejected and wrap ErrInvalidKey
+	invalidKeyLengths := []int{0, 15, 16, 31, 33, 64}
+	for _, l := range invalidKeyLengths {
+		k := make([]byte, l)
+		enc, err := NewEncryptor(k)
+		assert.Nil(t, enc)
+		require.Error(t, err)
+		assert.True(t, errors.Is(err, ErrInvalidKey), "expected error to wrap ErrInvalidKey for length %d", l)
+	}
+
+	// 32-byte key must succeed
+	validKey := generateRandomBytes(32)
+	enc, err := NewEncryptor(validKey)
+	require.NoError(t, err)
+	assert.NotNil(t, enc)
+}
+
+func TestStreamHeaderAndFormat(t *testing.T) {
+	key := generateRandomBytes(32)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write([]byte("hello world"))
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	data := buf.Bytes()
+	// Must start with 3-byte header: 0x4F, 0x44, 0x01
+	require.GreaterOrEqual(t, len(data), 3)
+	assert.Equal(t, byte(0x4F), data[0])
+	assert.Equal(t, byte(0x44), data[1])
+	assert.Equal(t, byte(0x01), data[2])
+
+	// Two encryptions of same plaintext must differ
+	var buf2 bytes.Buffer
+	w2 := enc.EncryptWriter(&buf2)
+	_, err = w2.Write([]byte("hello world"))
+	require.NoError(t, err)
+	require.NoError(t, w2.Close())
+	assert.NotEqual(t, buf.Bytes(), buf2.Bytes())
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateRandomBytes(32)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		size int
+	}{
+		{"empty", 0},
+		{"small", 100},
+		{"exact chunk", ChunkSize},
+		{"multi chunk", ChunkSize*2 + 1024},
+		{"large", ChunkSize*3 + 12345},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			plaintext := generateRandomBytes(tc.size)
+
+			var encBuf bytes.Buffer
+			w := enc.EncryptWriter(&encBuf)
+			n, err := w.Write(plaintext)
+			require.NoError(t, err)
+			assert.Equal(t, tc.size, n)
+			require.NoError(t, w.Close())
+
+			// Close should be idempotent
+			require.NoError(t, w.Close())
+			require.NoError(t, w.Close())
+
+			// Decrypt
+			r, err := DecryptReader(&encBuf, key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(r)
+			require.NoError(t, err)
+			assert.Equal(t, plaintext, decrypted)
+		})
+	}
+}
+
+func TestDecryptReaderLazyInit(t *testing.T) {
+	key := generateRandomBytes(32)
+	pipeR, pipeW := io.Pipe()
+
+	// DecryptReader must return without error and not block even if nothing is written yet
+	dr, err := DecryptReader(pipeR, key)
+	require.NoError(t, err)
+	assert.NotNil(t, dr)
+
+	// Close pipe with EOF without header
+	pipeW.Close()
+
+	buf := make([]byte, 10)
+	_, err = dr.Read(buf)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+}
+
+func TestDecryptErrors(t *testing.T) {
+	key := generateRandomBytes(32)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("secret database dump content")
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	validData := buf.Bytes()
+
+	t.Run("wrong magic", func(t *testing.T) {
+		corrupted := make([]byte, len(validData))
+		copy(corrupted, validData)
+		corrupted[0] = 0x00
+
+		r, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(r)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid header")
+	})
+
+	t.Run("unsupported version", func(t *testing.T) {
+		corrupted := make([]byte, len(validData))
+		copy(corrupted, validData)
+		corrupted[2] = 0x02
+
+		r, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(r)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported version")
+	})
+
+	t.Run("wrong key", func(t *testing.T) {
+		wrongKey := generateRandomBytes(32)
+		r, err := DecryptReader(bytes.NewReader(validData), wrongKey)
+		require.NoError(t, err)
+		_, err = io.ReadAll(r)
+		require.Error(t, err)
+	})
+
+	t.Run("integrity failure", func(t *testing.T) {
+		corrupted := make([]byte, len(validData))
+		copy(corrupted, validData)
+		// Tamper with HMAC (last 32 bytes)
+		corrupted[len(corrupted)-1] ^= 0xFF
+
+		r, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(r)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "integrity")
+	})
+
+	t.Run("truncated data", func(t *testing.T) {
+		truncations := []int{
+			0,                  // 0 bytes
+			2,                  // partial header
+			3,                  // header only
+			len(validData) - 1, // missing part of HMAC
+			len(validData) - 34, // missing HMAC and part of sentinel
+		}
+		for _, tl := range truncations {
+			r, err := DecryptReader(bytes.NewReader(validData[:tl]), key)
+			require.NoError(t, err)
+			_, err = io.ReadAll(r)
+			require.Error(t, err)
+		}
+	})
+}
+
+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	disabled := Config{
+		Enabled:   false,
+		KeySource: "",
+	}
+	assert.NoError(t, disabled.Validate())
+
+	// Enabled with empty KeySource
+	enabledEmpty := Config{
+		Enabled: true,
+	}
+	assert.Error(t, enabledEmpty.Validate())
+
+	// Enabled with unsupported KeySource
+	enabledUnsupported := Config{
+		Enabled:   true,
+		KeySource: "kms",
+	}
+	assert.Error(t, enabledUnsupported.Validate())
+
+	// Env source
+	t.Run("env source", func(t *testing.T) {
+		cfg := Config{
+			Enabled:   true,
+			KeySource: "env",
+			KeyEnvVar: "MY_KEY",
+		}
+		assert.NoError(t, cfg.Validate())
+
+		// Mutually exclusive fields
+		cfgConflict := cfg
+		cfgConflict.Key = "somekey"
+		err := cfgConflict.Validate()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "mutually exclusive")
+
+		// Missing required field
+		cfgMissing := Config{Enabled: true, KeySource: "env"}
+		assert.Error(t, cfgMissing.Validate())
+	})
+
+	// File source
+	t.Run("file source", func(t *testing.T) {
+		cfg := Config{
+			Enabled:   true,
+			KeySource: "file",
+			KeyFile:   "/path/to/key",
+		}
+		assert.NoError(t, cfg.Validate())
+
+		cfgConflict := cfg
+		cfgConflict.KeyEnvVar = "ENV_VAR"
+		err := cfgConflict.Validate()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "mutually exclusive")
+
+		cfgMissing := Config{Enabled: true, KeySource: "file"}
+		assert.Error(t, cfgMissing.Validate())
+	})
+
+	// Literal source
+	t.Run("literal source", func(t *testing.T) {
+		cfg := Config{
+			Enabled:   true,
+			KeySource: "literal",
+			Key:       base64.StdEncoding.EncodeToString(generateRandomBytes(32)),
+		}
+		assert.NoError(t, cfg.Validate())
+
+		cfgConflict := cfg
+		cfgConflict.KeyFile = "/file"
+		err := cfgConflict.Validate()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "mutually exclusive")
+
+		cfgMissing := Config{Enabled: true, KeySource: "literal"}
+		assert.Error(t, cfgMissing.Validate())
+	})
+
+	// Derive source
+	t.Run("derive source", func(t *testing.T) {
+		validSalt := base64.StdEncoding.EncodeToString(generateRandomBytes(16))
+		cfg := Config{
+			Enabled:    true,
+			KeySource:  "derive",
+			Passphrase: "my secret passphrase",
+			Salt:       validSalt,
+		}
+		assert.NoError(t, cfg.Validate())
+
+		// Case-insensitive source
+		cfgCase := cfg
+		cfgCase.KeySource = "DERIVE"
+		assert.NoError(t, cfgCase.Validate())
+
+		// Mutually exclusive fields
+		cfgConflict := cfg
+		cfgConflict.Key = "literal-key"
+		err := cfgConflict.Validate()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "mutually exclusive")
+
+		// Empty passphrase rejected
+		cfgEmptyPass := cfg
+		cfgEmptyPass.Passphrase = ""
+		assert.Error(t, cfgEmptyPass.Validate())
+
+		// Salt < 16 bytes rejected
+		shortSalt := base64.StdEncoding.EncodeToString(generateRandomBytes(15))
+		cfgShortSalt := cfg
+		cfgShortSalt.Salt = shortSalt
+		assert.Error(t, cfgShortSalt.Validate())
+	})
+}
+
+func TestLoadKey(t *testing.T) {
+	rawKey := generateRandomBytes(32)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	t.Run("env", func(t *testing.T) {
+		envVar := "TEST_LOAD_KEY_ENV"
+		os.Setenv(envVar, b64Key)
+		defer os.Unsetenv(envVar)
+
+		loaded, err := LoadKey(Config{KeySource: "env", KeyEnvVar: envVar})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+
+		// Unset env var returns error containing encryption or key
+		os.Unsetenv(envVar)
+		_, err = LoadKey(Config{KeySource: "env", KeyEnvVar: envVar})
+		require.Error(t, err)
+		msg := err.Error()
+		assert.True(t, bytes.Contains([]byte(msg), []byte("encryption")) || bytes.Contains([]byte(msg), []byte("key")))
+	})
+
+	t.Run("file", func(t *testing.T) {
+		tmpFile, err := os.CreateTemp("", "keyfile")
+		require.NoError(t, err)
+		defer os.Remove(tmpFile.Name())
+
+		// With whitespace to test trimming
+		_, err = tmpFile.WriteString("  " + b64Key + " \n ")
+		require.NoError(t, err)
+		tmpFile.Close()
+
+		loaded, err := LoadKey(Config{KeySource: "file", KeyFile: tmpFile.Name()})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+	})
+
+	t.Run("literal", func(t *testing.T) {
+		loaded, err := LoadKey(Config{KeySource: "literal", Key: " " + b64Key + "\n"})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+	})
+
+	t.Run("derive", func(t *testing.T) {
+		salt := generateRandomBytes(16)
+		b64Salt := base64.StdEncoding.EncodeToString(salt)
+
+		k1, err := LoadKey(Config{KeySource: "derive", Passphrase: "hello", Salt: b64Salt})
+		require.NoError(t, err)
+		assert.Len(t, k1, 32)
+
+		// Deterministic
+		k2, err := LoadKey(Config{KeySource: "derive", Passphrase: "hello", Salt: b64Salt})
+		require.NoError(t, err)
+		assert.Equal(t, k1, k2)
+
+		// Different passphrase produces different key
+		k3, err := LoadKey(Config{KeySource: "derive", Passphrase: "world", Salt: b64Salt})
+		require.NoError(t, err)
+		assert.NotEqual(t, k1, k3)
+
+		// Empty passphrase rejected
+		_, err = LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: b64Salt})
+		require.Error(t, err)
+
+		// Salt < 16 bytes rejected
+		shortSalt := base64.StdEncoding.EncodeToString(generateRandomBytes(10))
+		_, err = LoadKey(Config{KeySource: "derive", Passphrase: "pass", Salt: shortSalt})
+		require.Error(t, err)
+	})
+}
+
+func TestConfigYAML(t *testing.T) {
+	yamlStr := `
+enabled: true
+key_source: derive
+passphrase: mysecret
+salt: c29tZXNhbHR2YWx1ZTE2Ynl0ZXM=
+`
+	var cfg Config
+	err := yaml.Unmarshal([]byte(yamlStr), &cfg)
+	require.NoError(t, err)
+	assert.True(t, cfg.Enabled)
+	assert.Equal(t, "derive", cfg.KeySource)
+	assert.Equal(t, "mysecret", cfg.Passphrase)
+	assert.Equal(t, "c29tZXNhbHR2YWx1ZTE2Ynl0ZXM=", cfg.Salt)
+	assert.NoError(t, cfg.Validate())
+}
