+func TestJobValidate(t *testing.T) {
+	assert := assert.New(t)
+
+	// Valid job without encryption
+	job := NewJob("job1", "mysql", testDBDsn)
+	assert.NoError(job.Validate())
+	assert.False(job.Encrypted())
+
+	// Valid job with valid encryption
+	encCfg := encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       "dGVzdGtleXRlc3RrZXl0ZXN0a2V5dGVzdGtleTEyMzQ=",
+	}
+	jobEnc := NewJob("job2", "mysql", testDBDsn, WithEncryption(encCfg))
+	assert.NoError(jobEnc.Validate())
+	assert.True(jobEnc.Encrypted())
+
+	// Invalid encryption config must fail Job.Validate()
+	invalidEncCfg := encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		// missing KeyEnvVar
+	}
+	jobInvalidEnc := NewJob("job3", "mysql", testDBDsn, WithEncryption(invalidEncCfg))
+	assert.Error(jobInvalidEnc.Validate())
+}
