index 0000000..06ea871
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,571 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	MagicByte1 = 0x4F
+	MagicByte2 = 0x44
+	Version1   = 0x01
+	ChunkSize  = 64 * 1024 // 64KB
+	NonceSize  = 12
+	TagSize    = 16
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key")
+)
+
+// Config holds encryption configuration.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// UnmarshalYAML implements custom unmarshaling to support various casing and hyphenation.
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	type rawConfig Config
+	var raw rawConfig
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+	*c = Config(raw)
+
+	var m map[string]any
+	if err := value.Decode(&m); err == nil {
+		for k, v := range m {
+			strVal, _ := v.(string)
+			cleanKey := strings.ToLower(strings.ReplaceAll(strings.ReplaceAll(k, "-", ""), "_", ""))
+			switch cleanKey {
+			case "enabled":
+				if b, ok := v.(bool); ok {
+					c.Enabled = b
+				}
+			case "keysource":
+				if c.KeySource == "" && strVal != "" {
+					c.KeySource = strVal
+				}
+			case "keyenvvar":
+				if c.KeyEnvVar == "" && strVal != "" {
+					c.KeyEnvVar = strVal
+				}
+			case "keyfile":
+				if c.KeyFile == "" && strVal != "" {
+					c.KeyFile = strVal
+				}
+			case "key":
+				if c.Key == "" && strVal != "" {
+					c.Key = strVal
+				}
+			case "passphrase":
+				if c.Passphrase == "" && strVal != "" {
+					c.Passphrase = strVal
+				}
+			case "salt":
+				if c.Salt == "" && strVal != "" {
+					c.Salt = strVal
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// Validate validates the encryption configuration.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case "env":
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("key fields are mutually exclusive: keyenvvar cannot be used with other key fields")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("keyenvvar is required for env key source")
+		}
+	case "file":
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("key fields are mutually exclusive: keyfile cannot be used with other key fields")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("keyfile is required for file key source")
+		}
+	case "literal":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("key fields are mutually exclusive: key cannot be used with other key fields")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+	case "derive":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("key fields are mutually exclusive: passphrase and salt cannot be used with other key fields")
+		}
+		if c.Passphrase == "" {
+			return errors.New("empty passphrase rejected: passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+		saltBytes, err := decodeBase64(c.Salt)
+		if err != nil {
+			return fmt.Errorf("invalid base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return fmt.Errorf("salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+	default:
+		return fmt.Errorf("unsupported key source: %q", c.KeySource)
+	}
+
+	return nil
+}
+
+// LoadKey loads a 32-byte key based on the provided Config.
+func LoadKey(cfg Config) ([]byte, error) {
+	cfgCopy := cfg
+	cfgCopy.Enabled = true
+	if err := cfgCopy.Validate(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+		if strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is empty", cfg.KeyEnvVar)
+		}
+		key, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from environment variable %s: %w", cfg.KeyEnvVar, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("encryption key from %s must be 32 bytes, got %d: %w", cfg.KeyEnvVar, len(key), ErrInvalidKey)
+		}
+		return key, nil
+
+	case "file":
+		content, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %s: %w", cfg.KeyFile, err)
+		}
+		trimmed := strings.TrimSpace(string(content))
+		key, err := decodeBase64(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %s: %w", cfg.KeyFile, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("encryption key from file %s must be 32 bytes, got %d: %w", cfg.KeyFile, len(key), ErrInvalidKey)
+		}
+		return key, nil
+
+	case "literal":
+		trimmed := strings.TrimSpace(cfg.Key)
+		key, err := decodeBase64(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode literal base64 encryption key: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("literal encryption key must be 32 bytes, got %d: %w", len(key), ErrInvalidKey)
+		}
+		return key, nil
+
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("empty passphrase rejected")
+		}
+		saltBytes, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, fmt.Errorf("salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+		derivedKey := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, 100000, 32, sha256.New)
+		return derivedKey, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported key source: %q", cfg.KeySource)
+	}
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	if data, err := base64.StdEncoding.DecodeString(s); err == nil {
+		return data, nil
+	}
+	if data, err := base64.RawStdEncoding.DecodeString(s); err == nil {
+		return data, nil
+	}
+	if data, err := base64.URLEncoding.DecodeString(s); err == nil {
+		return data, nil
+	}
+	if data, err := base64.RawURLEncoding.DecodeString(s); err == nil {
+		return data, nil
+	}
+	return nil, errors.New("illegal base64 data")
+}
+
+// Encryptor handles AES-256-GCM encryption.
+type Encryptor struct {
+	key []byte
+	gcm cipher.AEAD
+}
+
+// NewEncryptor creates a new Encryptor using a 32-byte key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("invalid key length %d: %w", len(key), ErrInvalidKey)
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create gcm: %w", err)
+	}
+
+	k := make([]byte, len(key))
+	copy(k, key)
+
+	return &Encryptor{
+		key: k,
+		gcm: gcm,
+	}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts data written to w.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return newEncryptWriter(w, e.key, e.gcm)
+}
+
+// DecryptReader returns an io.Reader that decrypts data from r using the encryptor's key.
+func (e *Encryptor) DecryptReader(r io.Reader) (io.Reader, error) {
+	return DecryptReader(r, e.key)
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	gcm           cipher.AEAD
+	h             hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func newEncryptWriter(w io.Writer, key []byte, gcm cipher.AEAD) *encryptWriter {
+	h := hmac.New(sha256.New, key)
+	return &encryptWriter{
+		w:   w,
+		key: key,
+		gcm: gcm,
+		h:   h,
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{MagicByte1, MagicByte2, Version1}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	if len(plaintext) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertextAndTag := ew.gcm.Seal(nil, nonce, plaintext, nil)
+
+	totalLen := len(nonce) + len(ciphertextAndTag)
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], uint32(totalLen))
+
+	chunk := make([]byte, 4+totalLen)
+	copy(chunk[0:4], lenBuf[:])
+	copy(chunk[4:4+NonceSize], nonce)
+	copy(chunk[4+NonceSize:], ciphertextAndTag)
+
+	// All bytes between header and sentinel are included in the HMAC
+	ew.h.Write(chunk)
+
+	if _, err := ew.w.Write(chunk); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed EncryptWriter")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return 0, err
+		}
+	}
+
+	totalWritten := len(p)
+	for len(p) > 0 {
+		space := ChunkSize - len(ew.buf)
+		if len(p) < space {
+			ew.buf = append(ew.buf, p...)
+			break
+		}
+		ew.buf = append(ew.buf, p[:space]...)
+		p = p[space:]
+		if err := ew.writeChunk(ew.buf); err != nil {
+			ew.err = err
+			return 0, err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+	if ew.err != nil {
+		return ew.err
+	}
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return err
+		}
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.writeChunk(ew.buf); err != nil {
+			ew.err = err
+			return err
+		}
+		ew.buf = nil
+	}
+
+	// 4-byte zero sentinel
+	sentinel := make([]byte, 4)
+	if _, err := ew.w.Write(sentinel); err != nil {
+		ew.err = err
+		return err
+	}
+
+	// 32-byte HMAC-SHA256
+	mac := ew.h.Sum(nil)
+	if _, err := ew.w.Write(mac); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+// DecryptReader creates an io.Reader that decrypts an encrypted stream.
+// It initializes lazily on the first Read call.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("invalid key length %d: %w", len(key), ErrInvalidKey)
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create gcm: %w", err)
+	}
+
+	k := make([]byte, len(key))
+	copy(k, key)
+
+	return &decryptReader{
+		r:   r,
+		key: k,
+		gcm: gcm,
+		h:   hmac.New(sha256.New, k),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	gcm         cipher.AEAD
+	h           hash.Hash
+	initialized bool
+	eofReached  bool
+	err         error
+	plainBuf    []byte
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(dr.plainBuf) > 0 {
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if dr.eofReached {
+		return 0, io.EOF
+	}
+
+	if !dr.initialized {
+		var header [3]byte
+		n, err := io.ReadFull(dr.r, header[:])
+		if err != nil {
+			if err == io.EOF || err == io.ErrUnexpectedEOF || n < 3 {
+				dr.err = fmt.Errorf("invalid header: truncated stream: %w", err)
+			} else {
+				dr.err = fmt.Errorf("invalid header: %w", err)
+			}
+			return 0, dr.err
+		}
+
+		if header[0] != MagicByte1 || header[1] != MagicByte2 {
+			dr.err = fmt.Errorf("invalid header: wrong magic bytes 0x%02X 0x%02X", header[0], header[1])
+			return 0, dr.err
+		}
+
+		if header[2] != Version1 {
+			dr.err = fmt.Errorf("unsupported version: 0x%02X", header[2])
+			return 0, dr.err
+		}
+
+		dr.initialized = true
+	}
+
+	for {
+		var lenBuf [4]byte
+		_, err := io.ReadFull(dr.r, lenBuf[:])
+		if err != nil {
+			dr.err = fmt.Errorf("truncated data: %w", err)
+			return 0, dr.err
+		}
+
+		chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+		if chunkLen == 0 {
+			// Zero sentinel
+			var expectedHMAC [32]byte
+			_, err := io.ReadFull(dr.r, expectedHMAC[:])
+			if err != nil {
+				dr.err = fmt.Errorf("truncated data: missing HMAC: %w", err)
+				return 0, dr.err
+			}
+
+			computedHMAC := dr.h.Sum(nil)
+			if !hmac.Equal(computedHMAC, expectedHMAC[:]) {
+				dr.err = errors.New("integrity check failed: HMAC mismatch")
+				return 0, dr.err
+			}
+
+			dr.eofReached = true
+			if len(dr.plainBuf) > 0 {
+				n := copy(p, dr.plainBuf)
+				dr.plainBuf = dr.plainBuf[n:]
+				return n, nil
+			}
+			return 0, io.EOF
+		}
+
+		if chunkLen < NonceSize+TagSize {
+			dr.err = fmt.Errorf("truncated data: invalid chunk length %d", chunkLen)
+			return 0, dr.err
+		}
+
+		chunkPayload := make([]byte, chunkLen)
+		_, err = io.ReadFull(dr.r, chunkPayload)
+		if err != nil {
+			dr.err = fmt.Errorf("truncated data: %w", err)
+			return 0, dr.err
+		}
+
+		dr.h.Write(lenBuf[:])
+		dr.h.Write(chunkPayload)
+
+		nonce := chunkPayload[:NonceSize]
+		ciphertextAndTag := chunkPayload[NonceSize:]
+
+		plaintext, err := dr.gcm.Open(nil, nonce, ciphertextAndTag, nil)
+		if err != nil {
+			dr.err = fmt.Errorf("decryption failed (wrong key or corrupted data): %w", err)
+			return 0, dr.err
+		}
+
+		if len(plaintext) == 0 {
+			continue
+		}
+
+		dr.plainBuf = plaintext
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+}
+
+func (dr *decryptReader) Close() error {
+	if c, ok := dr.r.(io.Closer); ok {
+		return c.Close()
+	}
+	return nil
+}
