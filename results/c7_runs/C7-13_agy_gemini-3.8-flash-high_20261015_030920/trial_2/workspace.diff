+func TestConfigValidation(t *testing.T) {
+	// Disabled config is always valid
+	t.Run("disabled config is always valid", func(t *testing.T) {
+		cfg := Config{Enabled: false}
+		assert.NoError(t, cfg.Validate())
+
+		cfgInvalidFields := Config{
+			Enabled:   false,
+			KeySource: "nonsense",
+			KeyEnvVar: "var",
+			KeyFile:   "file",
+		}
+		assert.NoError(t, cfgInvalidFields.Validate())
+	})
+
+	t.Run("rejects empty or unsupported key source when enabled", func(t *testing.T) {
+		cfg := Config{Enabled: true}
+		assert.Error(t, cfg.Validate())
+
+		cfgUnsupported := Config{Enabled: true, KeySource: "quantum"}
+		assert.Error(t, cfgUnsupported.Validate())
+	})
+
+	t.Run("source env", func(t *testing.T) {
+		// Valid
+		cfg := Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}
+		assert.NoError(t, cfg.Validate())
+
+		// Missing required field
+		cfgMissing := Config{Enabled: true, KeySource: "env"}
+		assert.Error(t, cfgMissing.Validate())
+
+		// Mutually exclusive fields
+		exclusiveCases := []Config{
+			{Enabled: true, KeySource: "env", KeyEnvVar: "K", KeyFile: "F"},
+			{Enabled: true, KeySource: "env", KeyEnvVar: "K", Key: "literal"},
+			{Enabled: true, KeySource: "env", KeyEnvVar: "K", Passphrase: "pass"},
+			{Enabled: true, KeySource: "env", KeyEnvVar: "K", Salt: "salt"},
+		}
+		for _, c := range exclusiveCases {
+			err := c.Validate()
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "mutually exclusive")
+		}
+	})
+
+	t.Run("source file", func(t *testing.T) {
+		// Valid
+		cfg := Config{Enabled: true, KeySource: "File", KeyFile: "/tmp/key"}
+		assert.NoError(t, cfg.Validate())
+
+		// Missing required field
+		cfgMissing := Config{Enabled: true, KeySource: "file"}
+		assert.Error(t, cfgMissing.Validate())
+
+		// Mutually exclusive fields
+		exclusiveCases := []Config{
+			{Enabled: true, KeySource: "file", KeyFile: "F", KeyEnvVar: "E"},
+			{Enabled: true, KeySource: "file", KeyFile: "F", Key: "literal"},
+			{Enabled: true, KeySource: "file", KeyFile: "F", Passphrase: "pass"},
+			{Enabled: true, KeySource: "file", KeyFile: "F", Salt: "salt"},
+		}
+		for _, c := range exclusiveCases {
+			err := c.Validate()
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "mutually exclusive")
+		}
+	})
+
+	t.Run("source literal", func(t *testing.T) {
+		// Valid
+		cfg := Config{Enabled: true, KeySource: "literal", Key: "base64key"}
+		assert.NoError(t, cfg.Validate())
+
+		// Missing required field
+		cfgMissing := Config{Enabled: true, KeySource: "literal"}
+		assert.Error(t, cfgMissing.Validate())
+
+		// Mutually exclusive fields
+		exclusiveCases := []Config{
+			{Enabled: true, KeySource: "literal", Key: "K", KeyEnvVar: "E"},
+			{Enabled: true, KeySource: "literal", Key: "K", KeyFile: "F"},
+			{Enabled: true, KeySource: "literal", Key: "K", Passphrase: "pass"},
+			{Enabled: true, KeySource: "literal", Key: "K", Salt: "salt"},
+		}
+		for _, c := range exclusiveCases {
+			err := c.Validate()
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "mutually exclusive")
+		}
+	})
+
+	t.Run("source derive", func(t *testing.T) {
+		// Valid
+		cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "c2FsdHNhbHRzYWx0c2FsdA=="}
+		assert.NoError(t, cfg.Validate())
+
+		// Missing required fields
+		cfgNoPass := Config{Enabled: true, KeySource: "derive", Salt: "salt"}
+		assert.Error(t, cfgNoPass.Validate())
+
+		cfgNoSalt := Config{Enabled: true, KeySource: "derive", Passphrase: "pass"}
+		assert.Error(t, cfgNoSalt.Validate())
+
+		// Mutually exclusive fields
+		exclusiveCases := []Config{
+			{Enabled: true, KeySource: "derive", Passphrase: "P", Salt: "S", KeyEnvVar: "E"},
+			{Enabled: true, KeySource: "derive", Passphrase: "P", Salt: "S", KeyFile: "F"},
+			{Enabled: true, KeySource: "derive", Passphrase: "P", Salt: "S", Key: "K"},
+		}
+		for _, c := range exclusiveCases {
+			err := c.Validate()
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "mutually exclusive")
+		}
+	})
+}
+
+func TestLoadKey(t *testing.T) {
+	raw32 := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, raw32)
+	require.NoError(t, err)
+	b64Key := base64.StdEncoding.EncodeToString(raw32)
+
+	t.Run("env", func(t *testing.T) {
+		envVar := "TEST_ONEDUMP_ENC_KEY"
+		require.NoError(t, os.Setenv(envVar, b64Key))
+		defer os.Unsetenv(envVar)
+
+		key, err := LoadKey(Config{KeySource: "env", KeyEnvVar: envVar})
+		require.NoError(t, err)
+		assert.Equal(t, raw32, key)
+
+		// Unset env var returns error containing encryption or key
+		unsetVar := "NONEXISTENT_VAR_FOR_TEST_KEY"
+		_, err = LoadKey(Config{KeySource: "env", KeyEnvVar: unsetVar})
+		require.Error(t, err)
+		errStr := strings.ToLower(err.Error())
+		assert.True(t, strings.Contains(errStr, "encryption") || strings.Contains(errStr, "key"))
+	})
+
+	t.Run("file", func(t *testing.T) {
+		tmpFile, err := os.CreateTemp("", "enckey-*")
+		require.NoError(t, err)
+		defer os.Remove(tmpFile.Name())
+
+		// Write with surrounding whitespace/newlines to test trimmed requirement
+		_, err = tmpFile.WriteString("  \n" + b64Key + "\n  \t")
+		require.NoError(t, err)
+		require.NoError(t, tmpFile.Close())
+
+		key, err := LoadKey(Config{KeySource: "file", KeyFile: tmpFile.Name()})
+		require.NoError(t, err)
+		assert.Equal(t, raw32, key)
+	})
+
+	t.Run("literal", func(t *testing.T) {
+		key, err := LoadKey(Config{KeySource: "literal", Key: b64Key})
+		require.NoError(t, err)
+		assert.Equal(t, raw32, key)
+	})
+
+	t.Run("derive", func(t *testing.T) {
+		saltBytes := []byte("0123456789abcdef") // 16 bytes
+		b64Salt := base64.StdEncoding.EncodeToString(saltBytes)
+
+		cfg := Config{
+			KeySource:  "derive",
+			Passphrase: "my-secure-passphrase",
+			Salt:       b64Salt,
+		}
+
+		key1, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Len(t, key1, 32)
+
+		// Deterministic: second run must match exactly
+		key2, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, key1, key2)
+
+		// Salt < 16 bytes must error
+		shortSalt := base64.StdEncoding.EncodeToString([]byte("short"))
+		_, err = LoadKey(Config{KeySource: "derive", Passphrase: "pass", Salt: shortSalt})
+		require.Error(t, err)
+
+		// Empty passphrase must error
+		_, err = LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: b64Salt})
+		require.Error(t, err)
+	})
+}
+
+func TestConfigYAML(t *testing.T) {
+	yamlData := `
+enabled: true
+key-source: derive
+passphrase: mypassword
+salt: c2FsdHNhbHRzYWx0c2FsdA==
+`
+	var cfg Config
+	err := yaml.Unmarshal([]byte(yamlData), &cfg)
+	require.NoError(t, err)
+	assert.True(t, cfg.Enabled)
+	assert.Equal(t, "derive", cfg.KeySource)
+	assert.Equal(t, "mypassword", cfg.Passphrase)
+	assert.NoError(t, cfg.Validate())
+}
diff --git a/encryption/encryptor.go b/encryption/encryptor.go
new file mode 100644
index 0000000..22b39d3
--- /dev/null
+++ b/encryption/encryptor.go
@@ -0,0 +1,186 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	MagicByte1 = 0x4F
+	MagicByte2 = 0x44
+	Version1   = 0x01
+
+	ChunkSize = 64 * 1024 // 64KB
+	NonceSize = 12
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key: key must be 32 bytes")
+)
+
+type Encryptor struct {
+	key []byte
+	gcm cipher.AEAD
+}
+
+// NewEncryptor creates a new Encryptor using the provided 32-byte key.
+// It rejects non-32-byte keys, returning an error that wraps ErrInvalidKey.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	keyCopy := make([]byte, 32)
+	copy(keyCopy, key)
+
+	return &Encryptor{
+		key: keyCopy,
+		gcm: gcm,
+	}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts streaming data with AES-256-GCM.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:   w,
+		gcm: e.gcm,
+		mac: hmac.New(sha256.New, e.key),
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+// DecryptReader returns an io.Reader that decrypts data from r using the Encryptor's key.
+func (e *Encryptor) DecryptReader(r io.Reader) (io.Reader, error) {
+	return DecryptReader(r, e.key)
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{MagicByte1, MagicByte2, Version1}
+	if _, err := ew.w.Write(header); err != nil {
+		return fmt.Errorf("failed to write header: %w", err)
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertextAndTag := ew.gcm.Seal(nil, nonce, ew.buf, nil)
+
+	chunkLen := uint32(len(nonce) + len(ciphertextAndTag))
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	// HMAC is computed over all bytes between header and sentinel
+	ew.mac.Write(lenBuf[:])
+	ew.mac.Write(nonce)
+	ew.mac.Write(ciphertextAndTag)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(ciphertextAndTag); err != nil {
+		return err
+	}
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed encrypt writer")
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		return 0, err
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		needed := ChunkSize - len(ew.buf)
+		if len(p) < needed {
+			ew.buf = append(ew.buf, p...)
+			break
+		}
+		ew.buf = append(ew.buf, p[:needed]...)
+		p = p[needed:]
+		if err := ew.flushChunk(); err != nil {
+			return 0, err
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(); err != nil {
+			return err
+		}
+	}
+
+	// Zero sentinel (4 zero bytes) ends chunks
+	sentinel := make([]byte, 4)
+	if _, err := ew.w.Write(sentinel); err != nil {
+		return err
+	}
+
+	// 32-byte HMAC-SHA256 computed over all bytes between header and sentinel
+	mac := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(mac); err != nil {
+		return err
+	}
+
+	return nil
+}
