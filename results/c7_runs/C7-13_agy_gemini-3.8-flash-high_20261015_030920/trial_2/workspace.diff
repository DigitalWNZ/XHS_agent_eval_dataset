+++ b/encryption/encryption_test.go
@@ -0,0 +1,425 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+)
+
+func TestNewEncryptor(t *testing.T) {
+	key32 := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key32)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key32)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+
+	// Test non-32-byte keys
+	for _, l := range []int{0, 16, 31, 33, 64} {
+		badKey := make([]byte, l)
+		_, err := NewEncryptor(badKey)
+		require.Error(t, err)
+		assert.True(t, errors.Is(err, ErrInvalidKey), "expected error to wrap ErrInvalidKey for length %d", l)
+	}
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		size int
+	}{
+		{"empty", 0},
+		{"single byte", 1},
+		{"small", 100},
+		{"exact chunk", ChunkSize},
+		{"chunk plus 1", ChunkSize + 1},
+		{"multiple chunks", ChunkSize*3 + 1234},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			plaintext := make([]byte, tc.size)
+			if tc.size > 0 {
+				_, err := io.ReadFull(rand.Reader, plaintext)
+				require.NoError(t, err)
+			}
+
+			var cipherBuf bytes.Buffer
+			ew := enc.EncryptWriter(&cipherBuf)
+			n, err := ew.Write(plaintext)
+			require.NoError(t, err)
+			assert.Equal(t, tc.size, n)
+
+			// Idempotent Close
+			require.NoError(t, ew.Close())
+			require.NoError(t, ew.Close())
+
+			// Decrypt
+			dr, err := DecryptReader(&cipherBuf, key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, plaintext, decrypted)
+		})
+	}
+}
+
+func TestTwoEncryptionsProduceDifferentOutputs(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("constant secret database payload")
+
+	var buf1, buf2 bytes.Buffer
+	w1 := enc.EncryptWriter(&buf1)
+	_, err = w1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w1.Close())
+
+	w2 := enc.EncryptWriter(&buf2)
+	_, err = w2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	// Both should decrypt to same plaintext
+	r1, err := DecryptReader(&buf1, key)
+	require.NoError(t, err)
+	d1, err := io.ReadAll(r1)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, d1)
+
+	r2, err := DecryptReader(&buf2, key)
+	require.NoError(t, err)
+	d2, err := io.ReadAll(r2)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, d2)
+}
+
+func TestDecryptReaderErrors(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("important database backup")
+	var validBuf bytes.Buffer
+	w := enc.EncryptWriter(&validBuf)
+	_, err = w.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	validData := validBuf.Bytes()
+
+	t.Run("lazy init: non-32 byte key", func(t *testing.T) {
+		dr, err := DecryptReader(bytes.NewReader(validData), []byte("short-key"))
+		require.NoError(t, err, "DecryptReader must not error on construction")
+
+		buf := make([]byte, 100)
+		_, err = dr.Read(buf)
+		require.Error(t, err)
+		assert.True(t, errors.Is(err, ErrInvalidKey))
