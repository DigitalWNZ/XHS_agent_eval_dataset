+func TestStorageReadWriteCloserRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	originalData := []byte("SELECT * FROM users WHERE active = 1;\nINSERT INTO test VALUES (1, 'hello');\n")
+
+	// Test with both compression and encryption enabled
+	readers, writer, closer := storageReadWriteCloser(2, true, enc)
+
+	readResults := make([][]byte, len(readers))
+	errCh := make(chan error, len(readers))
+
+	for i, r := range readers {
+		go func(idx int, reader io.Reader) {
+			// Round-trip through DecryptReader then gzip.NewReader back to the original data
+			dr, err := encryption.DecryptReader(reader, key)
+			if err != nil {
+				errCh <- err
+				return
+			}
+
+			gr, err := gzip.NewReader(dr)
+			if err != nil {
+				errCh <- err
+				return
+			}
+			defer gr.Close()
+
+			data, err := io.ReadAll(gr)
+			if err != nil {
+				errCh <- err
+				return
+			}
+			readResults[idx] = data
+			errCh <- nil
+		}(i, r)
+	}
+
+	// Write original data to the pipeline writer
+	_, err = writer.Write(originalData)
+	require.NoError(t, err)
+
+	err = closer.Close()
+	require.NoError(t, err)
+
+	for range readers {
+		err := <-errCh
+		require.NoError(t, err)
+	}
+
+	for _, result := range readResults {
+		assert.Equal(t, originalData, result)
+	}
+}
