+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+	})
+
+	t.Run("unsupported version returns unsupported version", func(t *testing.T) {
+		corrupted := append([]byte(nil), validData...)
+		corrupted[2] = 0x99 // unsupported version
+		dr, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
