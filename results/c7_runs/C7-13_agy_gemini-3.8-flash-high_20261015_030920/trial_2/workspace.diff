+func TestFailFastOnMissingKeyEnvVar(t *testing.T) {
+	// Job with encryption enabled using an unset env var
+	encCfg := encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "NONEXISTENT_KEY_ENV_VAR_12345",
+	}
+
+	t.Run("without storages configured", func(t *testing.T) {
+		job := config.NewJob("test-fail-fast", "mysql", testDBDsn, config.WithEncryption(encCfg))
+		handler := NewJobHandler(job)
+
+		err := handler.save()
+		require.Error(t, err)
+		errStr := strings.ToLower(err.Error())
+		assert.True(t, strings.Contains(errStr, "encryption") || strings.Contains(errStr, "key"))
+
+		res := handler.Do()
+		require.Error(t, res.Error)
+		resErrStr := strings.ToLower(res.Error.Error())
+		assert.True(t, strings.Contains(resErrStr, "encryption") || strings.Contains(resErrStr, "key"))
+	})
+
+	t.Run("with storages configured", func(t *testing.T) {
+		job := config.NewJob("test-fail-fast", "mysql", testDBDsn, config.WithEncryption(encCfg))
