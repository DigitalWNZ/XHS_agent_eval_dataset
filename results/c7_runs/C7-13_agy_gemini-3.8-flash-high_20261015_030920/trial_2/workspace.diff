diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..815bd2f
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,203 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	type rawConfig Config
+	var raw rawConfig
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+	*c = Config(raw)
+
+	var m map[string]interface{}
+	if err := value.Decode(&m); err == nil {
+		for k, v := range m {
+			strVal, isStr := v.(string)
+			if !isStr {
+				continue
+			}
+			normKey := strings.ToLower(strings.ReplaceAll(strings.ReplaceAll(k, "-", ""), "_", ""))
+			switch normKey {
+			case "keysource":
+				if c.KeySource == "" {
+					c.KeySource = strVal
+				}
+			case "keyenvvar":
+				if c.KeyEnvVar == "" {
+					c.KeyEnvVar = strVal
+				}
+			case "keyfile":
+				if c.KeyFile == "" {
+					c.KeyFile = strVal
+				}
+			case "key":
+				if c.Key == "" {
+					c.Key = strVal
+				}
+			case "passphrase":
+				if c.Passphrase == "" {
+					c.Passphrase = strVal
+				}
+			case "salt":
+				if c.Salt == "" {
+					c.Salt = strVal
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// Validate checks the configuration. Disabled configs are always valid.
+// Enabled configs must specify a valid KeySource and the required fields for that source,
+// and reject fields belonging to other sources (with an error containing "mutually exclusive").
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source cannot be empty")
+	}
+
+	switch source {
+	case "env":
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("keyenvvar is required for env key source")
+		}
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive: env source does not allow keyfile, key, passphrase, or salt")
+		}
+	case "file":
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("keyfile is required for file key source")
+		}
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive: file source does not allow keyenvvar, key, passphrase, or salt")
+		}
+	case "literal":
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive: literal source does not allow keyenvvar, keyfile, passphrase, or salt")
+		}
+	case "derive":
+		if c.Passphrase == "" {
+			return errors.New("passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("encryption config fields are mutually exclusive: derive source does not allow keyenvvar, keyfile, or key")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	if b, err := base64.StdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.RawStdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.URLEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	return base64.RawURLEncoding.DecodeString(s)
+}
+
+// LoadKey loads and returns a 32-byte encryption key according to cfg.
+func LoadKey(cfg Config) ([]byte, error) {
+	cfgCopy := cfg
+	cfgCopy.Enabled = true
+	if err := cfgCopy.Validate(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok {
+			return nil, fmt.Errorf("encryption key environment variable %q is unset", cfg.KeyEnvVar)
+		}
+		key, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode encryption key from environment variable %q: %w", cfg.KeyEnvVar, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("encryption key from environment variable %q must be 32 bytes, got %d", cfg.KeyEnvVar, len(key))
+		}
+		return key, nil
+
+	case "file":
+		data, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", cfg.KeyFile, err)
+		}
+		key, err := decodeBase64(string(data))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode encryption key from file %q: %w", cfg.KeyFile, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("encryption key from file %q must be 32 bytes, got %d", cfg.KeyFile, len(key))
+		}
+		return key, nil
+
+	case "literal":
+		key, err := decodeBase64(cfg.Key)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode literal encryption key: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("literal encryption key must be 32 bytes, got %d", len(key))
+		}
+		return key, nil
+
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("empty passphrase rejected")
+		}
+		salt, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 salt: %w", err)
+		}
+		if len(salt) < 16 {
+			return nil, fmt.Errorf("encryption salt must be at least 16 bytes, got %d", len(salt))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, 100000, 32, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
diff --git a/encryption/decryptor.go b/encryption/decryptor.go
new file mode 100644
index 0000000..5cbb7dd
--- /dev/null
+++ b/encryption/decryptor.go
@@ -0,0 +1,184 @@
+package encryption
+
+import (
+	"bufio"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+type decryptReader struct {
+	r           io.Reader
+	br          *bufio.Reader
+	key         []byte
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	buf         []byte
+	initialized bool
+	eof         bool
+}
+
+// DecryptReader reverses the AES-256-GCM streaming encryption.
+// Initialization is lazy; validation and stream errors occur in Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	keyCopy := make([]byte, len(key))
+	copy(keyCopy, key)
+	return &decryptReader{
+		r:   r,
+		key: keyCopy,
+	}, nil
+}
+
+func (dr *decryptReader) init() error {
+	dr.initialized = true
+
+	if len(dr.key) != 32 {
+		return fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(dr.key))
+	}
+
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return err
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return err
+	}
+	dr.gcm = gcm
+	dr.mac = hmac.New(sha256.New, dr.key)
+	dr.br = bufio.NewReader(dr.r)
+
+	var header [3]byte
+	_, err = io.ReadFull(dr.br, header[:])
+	if err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("invalid header: truncated data: %w", io.ErrUnexpectedEOF)
+		}
+		return fmt.Errorf("invalid header: %w", err)
+	}
+
+	if header[0] != MagicByte1 || header[1] != MagicByte2 {
+		return fmt.Errorf("invalid header: magic mismatch (expected 0x%02X 0x%02X, got 0x%02X 0x%02X)",
+			MagicByte1, MagicByte2, header[0], header[1])
+	}
+
+	if header[2] != Version1 {
+		return fmt.Errorf("unsupported version: 0x%02X", header[2])
+	}
+
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			return 0, err
+		}
+	}
+
+	if len(dr.buf) > 0 {
+		n := copy(p, dr.buf)
+		dr.buf = dr.buf[n:]
+		return n, nil
+	}
+
+	if dr.eof {
+		return 0, io.EOF
+	}
+
+	for {
+		var lenBuf [4]byte
+		_, err := io.ReadFull(dr.br, lenBuf[:])
+		if err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return 0, fmt.Errorf("truncated data: unexpected EOF before sentinel: %w", io.ErrUnexpectedEOF)
+			}
+			return 0, fmt.Errorf("truncated data: %w", err)
+		}
+
+		chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+		if chunkLen == 0 {
+			// Zero sentinel reached
+			var hmacBuf [32]byte
+			_, err := io.ReadFull(dr.br, hmacBuf[:])
+			if err != nil {
+				return 0, fmt.Errorf("truncated data: unexpected EOF reading HMAC: %w", err)
+			}
+
+			expectedMac := dr.mac.Sum(nil)
+			if !hmac.Equal(expectedMac, hmacBuf[:]) {
+				return 0, errors.New("stream integrity check failed: HMAC mismatch")
+			}
+
+			dr.eof = true
+			return 0, io.EOF
+		}
+
+		dr.mac.Write(lenBuf[:])
+
+		if chunkLen < NonceSize+16 {
+			return 0, fmt.Errorf("invalid chunk length %d: smaller than nonce and tag", chunkLen)
+		}
+
+		chunkData := make([]byte, chunkLen)
+		_, err = io.ReadFull(dr.br, chunkData)
+		if err != nil {
+			return 0, fmt.Errorf("truncated data: unexpected EOF reading chunk data: %w", err)
+		}
+
+		dr.mac.Write(chunkData)
+
+		nonce := chunkData[:NonceSize]
+		ciphertextAndTag := chunkData[NonceSize:]
+
+		plaintext, err := dr.gcm.Open(nil, nonce, ciphertextAndTag, nil)
+		if err != nil {
+			return 0, fmt.Errorf("decryption failed (wrong key or corrupted data): %w", err)
+		}
+
+		dr.buf = plaintext
+
+		// Check if the stream terminator (sentinel + HMAC) is already buffered in memory
+		if dr.br.Buffered() >= 36 {
+			peek, err := dr.br.Peek(4)
+			if err == nil && binary.BigEndian.Uint32(peek) == 0 {
+				_, _ = dr.br.Discard(4)
+				var hmacBuf [32]byte
+				if _, err := io.ReadFull(dr.br, hmacBuf[:]); err != nil {
+					return 0, fmt.Errorf("truncated data: unexpected EOF reading HMAC: %w", err)
+				}
+				expectedMac := dr.mac.Sum(nil)
+				if !hmac.Equal(expectedMac, hmacBuf[:]) {
+					dr.buf = nil
+					return 0, errors.New("stream integrity check failed: HMAC mismatch")
+				}
+				dr.eof = true
+			}
+		}
+
+		if len(dr.buf) > 0 {
+			n := copy(p, dr.buf)
+			dr.buf = dr.buf[n:]
+			return n, nil
+		}
+	}
+}
+
+// Close closes the underlying reader if it implements io.Closer.
+func (dr *decryptReader) Close() error {
+	if c, ok := dr.r.(io.Closer); ok {
+		return c.Close()
+	}
+	return nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..6de20a2
