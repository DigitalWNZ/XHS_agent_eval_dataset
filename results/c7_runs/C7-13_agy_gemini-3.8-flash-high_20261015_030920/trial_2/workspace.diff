+		_, err := io.ReadFull(rand.Reader, wrongKey)
+		require.NoError(t, err)
+
+		dr, err := DecryptReader(bytes.NewReader(validData), wrongKey)
+		require.NoError(t, err)
+
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
