+func TestStorageReadWriteCloserPipeline_RoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	count := 2
+	readers, writer, closer := storageReadWriteCloser(count, true, enc)
+
+	originalData := []byte("CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(255));\nINSERT INTO users VALUES (1, 'Alice');\n")
+
+	var wg sync.WaitGroup
+	results := make([][]byte, count)
+
+	for i := 0; i < count; i++ {
+		wg.Add(1)
+		go func(idx int, r io.Reader) {
+			defer wg.Done()
+
+			// Round-trip: DecryptReader -> gzip.NewReader -> original data
+			dr, err := encryption.DecryptReader(r, key)
+			if err != nil {
+				t.Errorf("DecryptReader error: %v", err)
+				return
+			}
+
+			gr, err := gzip.NewReader(dr)
+			if err != nil {
+				t.Errorf("gzip.NewReader error: %v", err)
+				return
+			}
+			defer gr.Close()
+
+			decompressed, err := io.ReadAll(gr)
+			if err != nil {
+				t.Errorf("ReadAll error: %v", err)
+				return
+			}
+
+			results[idx] = decompressed
+		}(i, readers[i])
+	}
+
+	// Write data to pipeline
+	_, err = writer.Write(originalData)
+	require.NoError(t, err)
+
+	err = closer.Close()
+	require.NoError(t, err)
+
+	wg.Wait()
+
+	for i := 0; i < count; i++ {
+		assert.Equal(t, originalData, results[i])
+	}
+}
