+func TestJobHandler_MissingKeyEnvVar_FailFast_WithoutStorages(t *testing.T) {
+	job := config.NewJob("test-fail-fast", "mysql", testDBDsn)
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "UNSET_KEY_ENV_VAR_12345",
+	}
+
+	handler := NewJobHandler(job)
+	res := handler.Do()
+	require.NotNil(t, res.Error)
+
+	errMsg := strings.ToLower(res.Error.Error())
+	assert.True(t, strings.Contains(errMsg, "encryption") || strings.Contains(errMsg, "key"),
+		"error message must contain 'encryption' or 'key', got: %s", res.Error.Error())
+}
