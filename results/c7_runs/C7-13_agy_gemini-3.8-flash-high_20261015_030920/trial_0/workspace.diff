+func TestEncryptDecrypt_LargeStreaming(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	dataSize := 1024 * 1024 // 1 MB
+	originalData := make([]byte, dataSize)
+	_, err = io.ReadFull(rand.Reader, originalData)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+
+	// Write in irregular chunk sizes
+	chunkSizes := []int{10, 100, 1000, 70000, 65536, 5000}
+	offset := 0
+	for offset < len(originalData) {
+		sz := chunkSizes[offset%len(chunkSizes)]
+		if offset+sz > len(originalData) {
+			sz = len(originalData) - offset
+		}
+		_, err := ew.Write(originalData[offset : offset+sz])
+		require.NoError(t, err)
+		offset += sz
+	}
+	require.NoError(t, ew.Close())
+
+	dr, err := DecryptReader(&buf, key)
+	require.NoError(t, err)
+
+	// Read in small buffers
+	var decrypted bytes.Buffer
+	readBuf := make([]byte, 512)
+	for {
+		n, err := dr.Read(readBuf)
+		if n > 0 {
+			decrypted.Write(readBuf[:n])
+		}
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		require.NoError(t, err)
+	}
+
+	assert.Equal(t, originalData, decrypted.Bytes())
+}
