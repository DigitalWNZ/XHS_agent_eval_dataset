+func TestLoadKey(t *testing.T) {
+	rawKey := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, rawKey)
+	require.NoError(t, err)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// Env source
+	envVar := "ONEDUMP_TEST_ENC_KEY"
+	t.Setenv(envVar, b64Key)
+	key, err := LoadKey(Config{KeySource: "env", KeyEnvVar: envVar})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, key)
+
+	// Env source: unset
+	_, err = LoadKey(Config{KeySource: "env", KeyEnvVar: "NON_EXISTENT_VAR_12345"})
+	require.Error(t, err)
+	assert.True(t, strings.Contains(strings.ToLower(err.Error()), "encryption") ||
+		strings.Contains(strings.ToLower(err.Error()), "key"))
+
+	// File source (trimmed)
+	tmpDir := t.TempDir()
+	keyFile := filepath.Join(tmpDir, "key.txt")
+	err = os.WriteFile(keyFile, []byte("  \n"+b64Key+" \n\t"), 0600)
+	require.NoError(t, err)
+
+	key, err = LoadKey(Config{KeySource: "file", KeyFile: keyFile})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, key)
+
+	// Literal source
+	key, err = LoadKey(Config{KeySource: "literal", Key: b64Key})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, key)
+
+	// Derive source: deterministic 32-byte key
+	salt := make([]byte, 16)
+	salt[0] = 42
+	b64Salt := base64.StdEncoding.EncodeToString(salt)
+	deriveCfg := Config{KeySource: "derive", Passphrase: "my-secure-passphrase", Salt: b64Salt}
+
+	k1, err := LoadKey(deriveCfg)
+	require.NoError(t, err)
+	assert.Len(t, k1, 32)
+
+	k2, err := LoadKey(deriveCfg)
+	require.NoError(t, err)
+	assert.Equal(t, k1, k2, "derived key must be deterministic")
+
+	// Derive source: empty passphrase rejected
+	_, err = LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: b64Salt})
+	require.Error(t, err)
+
+	// Derive source: salt < 16 bytes rejected
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	_, err = LoadKey(Config{KeySource: "derive", Passphrase: "pwd", Salt: shortSalt})
+	require.Error(t, err)
+}
