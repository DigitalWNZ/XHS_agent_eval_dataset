diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..6d29ec6
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,175 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+// Config holds configuration for encryption.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// Validate validates the encryption configuration.
+// Disabled configs are always valid.
+// When enabled, it rejects empty/unsupported key sources, ensures required fields are set,
+// and rejects fields belonging to other sources (error must contain "mutually exclusive").
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateFields()
+}
+
+func (c Config) validateFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case "env":
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("key source options are mutually exclusive")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("keyenvvar is required for env key source")
+		}
+		return nil
+
+	case "file":
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("key source options are mutually exclusive")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("keyfile is required for file key source")
+		}
+		return nil
+
+	case "literal":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("key source options are mutually exclusive")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+		return nil
+
+	case "derive":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("key source options are mutually exclusive")
+		}
+		if c.Passphrase == "" {
+			return errors.New("empty passphrase rejected")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+		saltBytes, err := decodeBase64(c.Salt)
+		if err != nil {
+			return fmt.Errorf("invalid salt base64: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return fmt.Errorf("salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+		return nil
+
+	default:
+		return fmt.Errorf("unsupported key source: %s", c.KeySource)
+	}
+}
+
+// LoadKey loads a 32-byte encryption key based on the given configuration.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateFields(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+		key, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from environment variable %q: %w", cfg.KeyEnvVar, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key from environment variable %q must be 32 bytes, got %d", ErrInvalidKey, cfg.KeyEnvVar, len(key))
+		}
+		return key, nil
+
+	case "file":
+		data, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", cfg.KeyFile, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		key, err := decodeBase64(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %q: %w", cfg.KeyFile, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key from file %q must be 32 bytes, got %d", ErrInvalidKey, cfg.KeyFile, len(key))
+		}
+		return key, nil
+
+	case "literal":
+		key, err := decodeBase64(cfg.Key)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode literal base64 encryption key: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: literal encryption key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("empty passphrase rejected")
+		}
+		saltBytes, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("invalid salt base64: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, fmt.Errorf("salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, 100000, 32, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	if b, err := base64.StdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.RawStdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.URLEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.RawURLEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	return nil, errors.New("illegal base64 data")
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..fa2e634
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,319 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"slices"
+)
+
+const (
+	ChunkSize    = 64 * 1024
+	HeaderMagic1 = 0x4F
+	HeaderMagic2 = 0x44
+	HeaderVer    = 0x01
+	NonceSize    = 12
+	TagSize      = 16
+	HMACSize     = 32
+	MinChunkLen  = NonceSize + TagSize // 28 bytes
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key: key must be 32 bytes")
+)
+
+// Encryptor performs AES-256-GCM encryption with HMAC-SHA256 integrity protection.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor. It rejects non-32-byte keys with an error wrapping ErrInvalidKey.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: expected 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+	return &Encryptor{
+		key: slices.Clone(key),
+	}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts data written to it using AES-256-GCM streaming.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		// key is already validated to be 32 bytes, so aes.NewCipher will not fail
+		panic(err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		panic(err)
+	}
+
+	return &encryptWriter{
+		w:    w,
+		key:  e.key,
+		aead: gcm,
+		mac:  hmac.New(sha256.New, e.key),
+		buf:  make([]byte, 0, ChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w        io.Writer
+	key      []byte
+	aead     cipher.AEAD
+	mac      hash.Hash
+	buf      []byte
+	wroteHdr bool
+	closed   bool
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	header := []byte{HeaderMagic1, HeaderMagic2, HeaderVer}
+	if err := writeFull(ew.w, header); err != nil {
+		return fmt.Errorf("failed to write header: %w", err)
+	}
+	ew.wroteHdr = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk(data []byte) error {
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertextAndTag := ew.aead.Seal(nil, nonce, data, nil)
+
+	chunkPayloadLen := uint32(len(nonce) + len(ciphertextAndTag))
+	buf := make([]byte, 4+chunkPayloadLen)
+	binary.BigEndian.PutUint32(buf[0:4], chunkPayloadLen)
+	copy(buf[4:4+NonceSize], nonce)
+	copy(buf[4+NonceSize:], ciphertextAndTag)
+
+	// Feed length prefix, nonce, ciphertext+tag to HMAC
+	ew.mac.Write(buf)
+
+	if err := writeFull(ew.w, buf); err != nil {
+		return fmt.Errorf("failed to write chunk: %w", err)
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed EncryptWriter")
+	}
+
+	if !ew.wroteHdr {
+		if err := ew.writeHeader(); err != nil {
+			return 0, err
+		}
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		if len(ew.buf) == 0 && len(p) >= ChunkSize {
+			chunk := p[:ChunkSize]
+			p = p[ChunkSize:]
+			if err := ew.flushChunk(chunk); err != nil {
+				return 0, err
+			}
+			continue
+		}
+
+		space := ChunkSize - len(ew.buf)
+		if len(p) < space {
+			ew.buf = append(ew.buf, p...)
+			break
+		}
+
+		ew.buf = append(ew.buf, p[:space]...)
+		p = p[space:]
+		if err := ew.flushChunk(ew.buf); err != nil {
+			return 0, err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if !ew.wroteHdr {
+		if err := ew.writeHeader(); err != nil {
+			return err
+		}
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = nil
+	}
+
+	// 4 zero bytes sentinel
+	sentinel := make([]byte, 4)
+	if err := writeFull(ew.w, sentinel); err != nil {
+		return fmt.Errorf("failed to write sentinel: %w", err)
+	}
+
+	// 32-byte HMAC-SHA256
+	macSum := ew.mac.Sum(nil)
+	if err := writeFull(ew.w, macSum); err != nil {
+		return fmt.Errorf("failed to write HMAC: %w", err)
+	}
+
+	return nil
+}
+
+// DecryptReader returns an io.Reader that decrypts an AES-256-GCM stream.
+// It initializes lazily on the first Read call.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: expected 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+	return &decryptReader{
+		r:   r,
+		key: slices.Clone(key),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	aead        cipher.AEAD
+	mac         hash.Hash
+	buf         []byte
+	initialized bool
+	eof         bool
+}
+
+func (dr *decryptReader) init() error {
+	dr.initialized = true
+
+	var header [3]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		return fmt.Errorf("truncated data: failed to read header: %w", err)
+	}
+
+	if header[0] != HeaderMagic1 || header[1] != HeaderMagic2 {
+		return fmt.Errorf("invalid header: expected magic 0x%02X 0x%02X, got 0x%02X 0x%02X",
+			HeaderMagic1, HeaderMagic2, header[0], header[1])
+	}
+
+	if header[2] != HeaderVer {
+		return fmt.Errorf("unsupported version: expected 0x%02X, got 0x%02X", HeaderVer, header[2])
+	}
+
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return fmt.Errorf("failed to create cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	dr.aead = gcm
+	dr.mac = hmac.New(sha256.New, dr.key)
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	if dr.eof {
+		return 0, io.EOF
+	}
+
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			return 0, err
+		}
+	}
+
+	for {
+		if len(dr.buf) > 0 {
+			n := copy(p, dr.buf)
+			dr.buf = dr.buf[n:]
+			return n, nil
+		}
+
+		var lenBuf [4]byte
+		if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return 0, fmt.Errorf("truncated data: missing sentinel: %w", io.ErrUnexpectedEOF)
+			}
+			return 0, fmt.Errorf("truncated data: %w", err)
+		}
+
+		chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+		if chunkLen == 0 {
+			// Zero sentinel reached: read HMAC
+			var hmacBuf [HMACSize]byte
+			if _, err := io.ReadFull(dr.r, hmacBuf[:]); err != nil {
+				return 0, fmt.Errorf("truncated data: missing HMAC after sentinel: %w", err)
+			}
+
+			computedHMAC := dr.mac.Sum(nil)
+			if !hmac.Equal(computedHMAC, hmacBuf[:]) {
+				return 0, fmt.Errorf("integrity check failed: HMAC mismatch")
+			}
+
+			dr.eof = true
+			return 0, io.EOF
+		}
+
+		if chunkLen < MinChunkLen {
+			return 0, fmt.Errorf("integrity error: invalid chunk length %d", chunkLen)
+		}
+
+		dr.mac.Write(lenBuf[:])
+
+		chunkData := make([]byte, chunkLen)
+		if _, err := io.ReadFull(dr.r, chunkData); err != nil {
+			return 0, fmt.Errorf("truncated data: incomplete chunk: %w", err)
+		}
+
+		dr.mac.Write(chunkData)
+
+		nonce := chunkData[:NonceSize]
+		ciphertextAndTag := chunkData[NonceSize:]
+
+		plaintext, err := dr.aead.Open(nil, nonce, ciphertextAndTag, nil)
+		if err != nil {
+			return 0, fmt.Errorf("integrity error: decryption failed: %w", err)
+		}
+
+		dr.buf = plaintext
+	}
+}
+
+func writeFull(w io.Writer, b []byte) error {
+	for len(b) > 0 {
+		n, err := w.Write(b)
+		if err != nil {
+			return err
+		}
+		b = b[n:]
+	}
+	return nil
+}
