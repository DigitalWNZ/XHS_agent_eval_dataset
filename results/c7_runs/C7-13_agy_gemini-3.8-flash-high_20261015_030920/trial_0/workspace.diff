+func TestConfigValidation(t *testing.T) {
+	// Disabled config is always valid
+	disabled := Config{Enabled: false}
+	assert.NoError(t, disabled.Validate())
+
+	disabledWithGarbage := Config{
+		Enabled:   false,
+		KeySource: "invalid",
+		KeyFile:   "foo",
+		KeyEnvVar: "bar",
+	}
+	assert.NoError(t, disabledWithGarbage.Validate())
+
+	// Enabled with empty KeySource
+	cfg := Config{Enabled: true}
+	assert.Error(t, cfg.Validate())
+
+	// Enabled with unsupported KeySource
+	cfg = Config{Enabled: true, KeySource: "unsupported"}
+	assert.Error(t, cfg.Validate())
+
+	// Env source: valid
+	cfg = Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, cfg.Validate())
+
+	// Case-insensitive source
+	cfg = Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, cfg.Validate())
+
+	// Env source: missing KeyEnvVar
+	cfg = Config{Enabled: true, KeySource: "env"}
+	assert.Error(t, cfg.Validate())
+
+	// Env source: mutually exclusive fields
+	cfg = Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", KeyFile: "/tmp/key"}
+	err := cfg.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// File source: valid
+	cfg = Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key"}
+	assert.NoError(t, cfg.Validate())
+
+	// File source: missing KeyFile
+	cfg = Config{Enabled: true, KeySource: "file"}
+	assert.Error(t, cfg.Validate())
+
+	// File source: mutually exclusive
+	cfg = Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", Key: "base64"}
+	err = cfg.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// Literal source: valid
+	cfg = Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString(make([]byte, 32))}
+	assert.NoError(t, cfg.Validate())
+
+	// Literal source: missing Key
+	cfg = Config{Enabled: true, KeySource: "literal"}
+	assert.Error(t, cfg.Validate())
+
+	// Literal source: mutually exclusive
+	cfg = Config{Enabled: true, KeySource: "literal", Key: "foo", KeyEnvVar: "bar"}
+	err = cfg.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// Derive source: valid
+	validSalt := base64.StdEncoding.EncodeToString(make([]byte, 16))
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "secret-passphrase", Salt: validSalt}
+	assert.NoError(t, cfg.Validate())
+
+	// Derive source: missing passphrase
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: validSalt}
+	assert.Error(t, cfg.Validate())
+
+	// Derive source: missing salt
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "pwd", Salt: ""}
+	assert.Error(t, cfg.Validate())
+
+	// Derive source: salt too short (<16 bytes)
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 10))
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "pwd", Salt: shortSalt}
+	assert.Error(t, cfg.Validate())
+
+	// Derive source: mutually exclusive
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "pwd", Salt: validSalt, Key: "lit"}
+	err = cfg.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+}
