index 0000000..3d1f38f
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,491 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptor(t *testing.T) {
+	// Valid 32-byte key
+	key32 := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key32)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key32)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+
+	// Invalid key length (less than 32)
+	shortKey := make([]byte, 16)
+	_, err = NewEncryptor(shortKey)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	// Invalid key length (greater than 32)
+	longKey := make([]byte, 64)
+	_, err = NewEncryptor(longKey)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	// Nil key
+	_, err = NewEncryptor(nil)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("hello world")},
+		{"exact-one-chunk", make([]byte, ChunkSize)},
+		{"multi-chunk", make([]byte, ChunkSize*2 + 1024)},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			if len(tc.data) > 0 {
+				_, err := io.ReadFull(rand.Reader, tc.data)
+				require.NoError(t, err)
+			}
+
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+			n, err := ew.Write(tc.data)
+			require.NoError(t, err)
+			assert.Equal(t, len(tc.data), n)
+
+			err = ew.Close()
+			require.NoError(t, err)
+
+			// Idempotent Close
+			err = ew.Close()
+			require.NoError(t, err)
+
+			// Decrypt
+			dr, err := DecryptReader(&buf, key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.data, decrypted)
+		})
+	}
+}
