+func TestLoadKey(t *testing.T) {
+	rawKey := generateKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// 1. Env
+	t.Setenv("TEST_ONEDUMP_ENC_KEY", b64Key)
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_ONEDUMP_ENC_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Unset env var
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "UNSET_ONEDUMP_ENC_KEY_XYZ"})
+	require.Error(t, err)
+
+	// 2. File (with whitespace to trim)
+	tmpDir := t.TempDir()
+	keyPath := filepath.Join(tmpDir, "key.txt")
+	require.NoError(t, os.WriteFile(keyPath, []byte("  \n"+b64Key+"\n\t "), 0600))
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: keyPath})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// 3. Literal
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Non-32-byte key in literal
+	shortKeyB64 := base64.StdEncoding.EncodeToString([]byte("short"))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: shortKeyB64})
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	// 4. Derive
+	salt := make([]byte, 16)
+	_, err = io.ReadFull(rand.Reader, salt)
+	require.NoError(t, err)
+	b64Salt := base64.StdEncoding.EncodeToString(salt)
+
+	k1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-password", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Len(t, k1, 32)
+
+	k2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-password", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Equal(t, k1, k2)
+
+	k3, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "other-password", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.NotEqual(t, k1, k3)
+
+	// Short salt (< 16 bytes)
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-password", Salt: shortSalt})
+	require.Error(t, err)
+
+	// Empty passphrase
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt})
+	require.Error(t, err)
+}
