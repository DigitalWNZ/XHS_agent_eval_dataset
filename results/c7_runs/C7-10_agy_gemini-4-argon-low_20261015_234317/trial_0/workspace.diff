+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	assert.NoError(t, (Config{Enabled: false}).Validate())
+	assert.NoError(t, (Config{Enabled: false, KeySource: "invalid", Key: "abc", KeyEnvVar: "FOO"}).Validate())
+
+	// Enabled with empty or unsupported source
+	assert.Error(t, (Config{Enabled: true}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "kms"}).Validate())
+
+	// Case-insensitive valid sources
+	assert.NoError(t, (Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "File", KeyFile: "/path/to/key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "LiTeRaL", Key: "base64key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "DERIVE", Passphrase: "secret", Salt: "base64salt"}).Validate())
+
+	// Missing required field for each source
+	assert.Error(t, (Config{Enabled: true, KeySource: "env"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "file"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "literal"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Passphrase: "secret"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Salt: "salt"}).Validate())
+
+	// Mutually exclusive fields
+	err := (Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", KeyFile: "/path"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "file", KeyFile: "/path", Key: "inline"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "literal", Key: "inline", Passphrase: "pass"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", KeyEnvVar: "ENV"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+}
