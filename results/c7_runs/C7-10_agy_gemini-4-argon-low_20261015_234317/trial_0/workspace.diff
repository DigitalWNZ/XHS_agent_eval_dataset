diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..0203dcf
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,153 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	PBKDF2Iterations = 100000
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasDerive := strings.TrimSpace(c.Passphrase) != "" || strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case KeySourceEnv:
+		if !hasEnv {
+			return errors.New("encryption keyenvvar is required when keysource is env")
+		}
+		if hasFile || hasLiteral || hasDerive {
+			return errors.New("encryption key source fields are mutually exclusive: env source only allows keyenvvar")
+		}
+	case KeySourceFile:
+		if !hasFile {
+			return errors.New("encryption keyfile is required when keysource is file")
+		}
+		if hasEnv || hasLiteral || hasDerive {
+			return errors.New("encryption key source fields are mutually exclusive: file source only allows keyfile")
+		}
+	case KeySourceLiteral:
+		if !hasLiteral {
+			return errors.New("encryption key is required when keysource is literal")
+		}
+		if hasEnv || hasFile || hasDerive {
+			return errors.New("encryption key source fields are mutually exclusive: literal source only allows key")
+		}
+	case KeySourceDerive:
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption passphrase is required when keysource is derive")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption salt is required when keysource is derive")
+		}
+		if hasEnv || hasFile || hasLiteral {
+			return errors.New("encryption key source fields are mutually exclusive: derive source only allows passphrase and salt")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+
+	switch source {
+	case KeySourceEnv:
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		if envName == "" {
+			return nil, errors.New("encryption key env var name is empty")
+		}
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envName)
+		}
+		return decodeAndValidateKey(strings.TrimSpace(val))
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		if filePath == "" {
+			return nil, errors.New("encryption key file path is empty")
+		}
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		return decodeAndValidateKey(strings.TrimSpace(string(data)))
+
+	case KeySourceLiteral:
+		raw := strings.TrimSpace(cfg.Key)
+		if raw == "" {
+			return nil, errors.New("encryption literal key is empty")
+		}
+		return decodeAndValidateKey(raw)
+
+	case KeySourceDerive:
+		if cfg.Passphrase == "" {
+			return nil, errors.New("encryption passphrase must not be empty")
+		}
+		saltStr := strings.TrimSpace(cfg.Salt)
+		if saltStr == "" {
+			return nil, errors.New("encryption salt must not be empty")
+		}
+		salt, err := base64.StdEncoding.DecodeString(saltStr)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(salt) < MinSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d bytes", MinSaltSize, len(salt))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, PBKDF2Iterations, KeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
+
+func decodeAndValidateKey(b64 string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(b64)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode base64 encryption key: %w", err)
+	}
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..ede924f
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,337 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize        = 32
+	MaxChunkSize   = 64 * 1024
+	HeaderSize     = 3
+	MagicByte0     = 0x4F
+	MagicByte1     = 0x44
+	Version1       = 0x01
+	NonceSize      = 12
+	TagSize        = 16
+	SentinelSize   = 4
+	HMACSize       = 32
+	LengthPrefSize = 4
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes for AES-256")
+)
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &Encryptor{key: k}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		return &encryptWriter{err: err}
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return &encryptWriter{err: err}
+	}
+
+	mac := hmac.New(sha256.New, e.key)
+
+	return &encryptWriter{
+		w:    w,
+		aead: aead,
+		mac:  mac,
+		buf:  make([]byte, 0, MaxChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{MagicByte0, MagicByte1, Version1}
+	if _, err := ew.w.Write(header); err != nil {
+		ew.err = err
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk(plaintext []byte) error {
+	if err := ew.writeHeader(); err != nil {
+		return err
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		ew.err = err
+		return err
+	}
+
+	ciphertext := ew.aead.Seal(nil, nonce, plaintext, nil)
+	chunkPayloadLen := uint32(len(nonce) + len(ciphertext))
+
+	frame := make([]byte, LengthPrefSize+int(chunkPayloadLen))
+	binary.BigEndian.PutUint32(frame[:LengthPrefSize], chunkPayloadLen)
+	copy(frame[LengthPrefSize:LengthPrefSize+NonceSize], nonce)
+	copy(frame[LengthPrefSize+NonceSize:], ciphertext)
+
+	ew.mac.Write(frame)
+
+	if _, err := ew.w.Write(frame); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write on closed encryptWriter")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		space := MaxChunkSize - len(ew.buf)
+		toCopy := len(p)
+		if toCopy > space {
+			toCopy = space
+		}
+
+		ew.buf = append(ew.buf, p[:toCopy]...)
+		p = p[toCopy:]
+		totalWritten += toCopy
+
+		if len(ew.buf) == MaxChunkSize {
+			if err := ew.flushChunk(ew.buf); err != nil {
+				return totalWritten, err
+			}
+			ew.buf = ew.buf[:0]
+		}
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return ew.err
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	sentinel := make([]byte, SentinelSize)
+	if _, err := ew.w.Write(sentinel); err != nil {
+		ew.err = err
+		return err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	block, err := aes.NewCipher(k)
+	if err != nil {
+		return nil, err
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	mac := hmac.New(sha256.New, k)
+
+	return &decryptReader{
+		r:    r,
+		aead: aead,
+		mac:  mac,
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	aead        cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	buf         []byte
+	eof         bool
+	err         error
+}
+
+func (dr *decryptReader) initHeader() error {
+	header := make([]byte, HeaderSize)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("invalid header: truncated stream: %w", err)
+		}
+		return fmt.Errorf("invalid header: %w", err)
+	}
+
+	if header[0] != MagicByte0 || header[1] != MagicByte1 {
+		return fmt.Errorf("invalid header: wrong magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+
+	if header[2] != Version1 {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [LengthPrefSize]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream reading chunk length: %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		// Sentinel reached; read and verify 32-byte HMAC
+		expectedMAC := make([]byte, HMACSize)
+		if _, err := io.ReadFull(dr.r, expectedMAC); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return fmt.Errorf("truncated encrypted stream reading integrity HMAC: %w", io.ErrUnexpectedEOF)
+			}
+			return err
+		}
+
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC) {
+			return errors.New("integrity check failed: HMAC mismatch")
+		}
+
+		dr.eof = true
+		return io.EOF
+	}
+
+	minChunkLen := uint32(NonceSize + TagSize)
+	maxChunkLen := uint32(NonceSize + MaxChunkSize + TagSize)
+	if chunkLen < minChunkLen || chunkLen > maxChunkLen {
+		return fmt.Errorf("invalid chunk length: %d", chunkLen)
+	}
+
+	payload := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, payload); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream reading chunk payload: %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	dr.mac.Write(lenBuf[:])
+	dr.mac.Write(payload)
+
+	nonce := payload[:NonceSize]
+	ciphertext := payload[NonceSize:]
+
+	plaintext, err := dr.aead.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decryption failed (integrity / authentication error): %w", err)
+	}
+
+	dr.buf = append(dr.buf, plaintext...)
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.initialized {
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.buf) == 0 && !dr.eof {
+		if err := dr.readNextChunk(); err != nil {
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if len(dr.buf) > 0 {
+		n := copy(p, dr.buf)
+		dr.buf = dr.buf[n:]
+		if len(dr.buf) == 0 && dr.eof {
+			return n, io.EOF
+		}
+		return n, nil
+	}
+
+	return 0, io.EOF
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..b6a10da
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,269 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func generateKey(t *testing.T) []byte {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor_KeyValidation(t *testing.T) {
+	for _, size := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		key := make([]byte, size)
+		enc, err := NewEncryptor(key)
+		assert.Nil(t, enc)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+
+	validKey := generateKey(t)
+	enc, err := NewEncryptor(validKey)
+	assert.NoError(t, err)
+	assert.NotNil(t, enc)
+}
+
+func TestEncryptDecrypt_RoundTrip(t *testing.T) {
+	key := generateKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	sizes := []int{
+		0,
+		1,
+		100,
+		MaxChunkSize - 1,
+		MaxChunkSize,
+		MaxChunkSize + 1,
+		MaxChunkSize * 3,
+		MaxChunkSize*3 + 12345,
+	}
+
+	for _, size := range sizes {
+		plaintext := make([]byte, size)
+		_, err := io.ReadFull(rand.Reader, plaintext)
+		require.NoError(t, err)
+
+		var buf bytes.Buffer
+		ew := enc.EncryptWriter(&buf)
+
+		// Write in small pieces and large pieces
+		written := 0
+		for written < len(plaintext) {
+			step := 4096
+			if written+step > len(plaintext) {
+				step = len(plaintext) - written
+			}
+			n, err := ew.Write(plaintext[written : written+step])
+			require.NoError(t, err)
+			written += n
+		}
+		require.NoError(t, ew.Close())
+		// Close is idempotent
+		require.NoError(t, ew.Close())
+
+		cipherBytes := buf.Bytes()
+		// Check header: 0x4F 0x44 0x01
+		require.GreaterOrEqual(t, len(cipherBytes), HeaderSize+SentinelSize+HMACSize)
+		assert.Equal(t, byte(0x4F), cipherBytes[0])
+		assert.Equal(t, byte(0x44), cipherBytes[1])
+		assert.Equal(t, byte(0x01), cipherBytes[2])
+
+		dr, err := DecryptReader(bytes.NewReader(cipherBytes), key)
+		require.NoError(t, err)
+
+		decrypted, err := io.ReadAll(dr)
+		require.NoError(t, err)
+		assert.Equal(t, plaintext, decrypted)
+	}
+}
+
+func TestTwoEncryptionsDifferAndUniqueNonces(t *testing.T) {
+	key := generateKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := bytes.Repeat([]byte("hello world! "), 15000) // > 2 chunks
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+}
+
+func TestDecryptReader_Errors(t *testing.T) {
+	key := generateKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("secret database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	// Lazy init: creating DecryptReader with bad data does not error until Read
+	badMagic := append([]byte(nil), validBytes...)
+	badMagic[0] = 0x00
+	dr, err := DecryptReader(bytes.NewReader(badMagic), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+
+	// Unsupported version
+	badVersion := append([]byte(nil), validBytes...)
+	badVersion[2] = 0x02
+	dr, err = DecryptReader(bytes.NewReader(badVersion), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+
+	// Tampered HMAC -> integrity error
+	badHMAC := append([]byte(nil), validBytes...)
+	badHMAC[len(badHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(badHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+
+	// Wrong key -> fails
+	wrongKey := generateKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validBytes), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Empty / truncated streams -> fails
+	for _, truncLen := range []int{0, 1, 2, 3, 5, 10, len(validBytes) - 36, len(validBytes) - 32, len(validBytes) - 1} {
+		dr, err = DecryptReader(bytes.NewReader(validBytes[:truncLen]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "expected error for truncated length %d", truncLen)
+	}
+}
