+func TestStorageReadWriteCloser_EncryptedGzipRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	originalData := bytes.Repeat([]byte("CREATE TABLE users (id INT PRIMARY KEY); "), 5000)
+
+	readers, writer, closer := storageReadWriteCloser(2, true, encryptor)
+	require.Len(t, readers, 2)
+
+	outputs := make([][]byte, 2)
+	errs := make([]error, 2)
+	var wg sync.WaitGroup
+	wg.Add(2)
+	for i := 0; i < 2; i++ {
+		idx := i
+		go func() {
+			defer wg.Done()
+			data, rErr := io.ReadAll(readers[idx])
+			outputs[idx] = data
+			errs[idx] = rErr
+		}()
+	}
+
+	_, err = writer.Write(originalData)
+	require.NoError(t, err)
+	require.NoError(t, closer.Close())
+
+	wg.Wait()
+
+	for i := 0; i < 2; i++ {
+		require.NoError(t, errs[i])
+		dr, err := encryption.DecryptReader(bytes.NewReader(outputs[i]), key)
+		require.NoError(t, err)
+		gr, err := gzip.NewReader(dr)
+		require.NoError(t, err)
+		decompressed, err := io.ReadAll(gr)
+		require.NoError(t, err)
+		require.NoError(t, gr.Close())
+		assert.Equal(t, originalData, decompressed)
+	}
+}
