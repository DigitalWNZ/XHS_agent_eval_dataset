+import type { Equal } from 'type-tests/utils.ts';
+import { Expect } from 'type-tests/utils.ts';
+import {
+	cumeDist,
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	rowNumber,
+	sql,
+	windowCount,
+	windowMax,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { db } from './db.ts';
+
+const t = pgTable('window_t', {
+	id: integer('id').notNull(),
+	name: text('name'),
+});
+
+const res = await db.select({
+	rn: rowNumber().over(),
+	nt: ntile(3).over('w'),
+	cd: cumeDist().over(),
+	lag: lag(t.id).over(),
+	lagDefault: lag(t.id, 1, 0).over(),
+	leadDefault: lead(t.name, 1, 'x').over(),
+	lead: lead(t.name).over(),
+	first: firstValue(t.id).over(),
+	last: lastValue(sql<string>`x`).over(),
+	nth: nthValue(t.id, 2).over(),
+	sum: windowSum(t.id).over(),
+	max: windowMax(t.id).over(),
+	cnt: windowCount().over(),
+}).from(t).window('w', { orderBy: t.id }).where(sql`true`);
+
+Expect<
+	Equal<{
+		rn: number;
+		nt: number;
+		cd: number;
+		lag: number | null;
+		lagDefault: number;
+		leadDefault: string;
+		lead: string | null;
+		first: number | null;
+		last: string | null;
+		nth: number | null;
+		sum: string | null;
+		max: number | null;
+		cnt: number;
+	}[], typeof res>
+>;
