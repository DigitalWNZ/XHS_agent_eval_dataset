diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..52f89323
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,428 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+/** Infers the TypeScript type of a column or SQL expression. */
+export type InferWindowExpressionType<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+// ---------------------------------------------------------------------------
+// Frame boundaries
+// ---------------------------------------------------------------------------
+
+export type WindowFrameBoundary =
+	| { readonly kind: 'unboundedPreceding' }
+	| { readonly kind: 'preceding'; readonly offset: number | SQLWrapper }
+	| { readonly kind: 'currentRow' }
+	| { readonly kind: 'following'; readonly offset: number | SQLWrapper }
+	| { readonly kind: 'unboundedFollowing' };
+
+/** `unbounded preceding` frame boundary. */
+export const unboundedPreceding: WindowFrameBoundary = Object.freeze({ kind: 'unboundedPreceding' as const });
+/** `current row` frame boundary. */
+export const currentRow: WindowFrameBoundary = Object.freeze({ kind: 'currentRow' as const });
+/** `unbounded following` frame boundary. */
+export const unboundedFollowing: WindowFrameBoundary = Object.freeze({ kind: 'unboundedFollowing' as const });
+
+function assertFrameOffset(helper: string, offset: unknown): void {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset < 0) {
+			throw new Error(`${helper}() expects a non-negative integer, received ${offset}`);
+		}
+		return;
+	}
+	if (typeof offset !== 'object' || offset === null || typeof (offset as SQLWrapper).getSQL !== 'function') {
+		throw new Error(`${helper}() expects a non-negative integer or SQL expression, received ${String(offset)}`);
+	}
+}
+
+/**
+ * `<offset> preceding` frame boundary.
+ *
+ * @param offset a non-negative integer, or an SQL expression (e.g. an interval for `range` frames)
+ */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertFrameOffset('preceding', offset);
+	return Object.freeze({ kind: 'preceding' as const, offset });
+}
+
+/**
+ * `<offset> following` frame boundary.
+ *
+ * @param offset a non-negative integer, or an SQL expression (e.g. an interval for `range` frames)
+ */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertFrameOffset('following', offset);
+	return Object.freeze({ kind: 'following' as const, offset });
+}
+
+const boundaryRank: Record<WindowFrameBoundary['kind'], number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+/** Returns true if `from` is ordered after `to`. */
+function isBoundaryAfter(from: WindowFrameBoundary, to: WindowFrameBoundary): boolean {
+	const fromRank = boundaryRank[from.kind];
+	const toRank = boundaryRank[to.kind];
+	if (fromRank !== toRank) {
+		return fromRank > toRank;
+	}
+	if (
+		(from.kind === 'preceding' && to.kind === 'preceding')
+		|| (from.kind === 'following' && to.kind === 'following')
+	) {
+		if (typeof from.offset === 'number' && typeof to.offset === 'number') {
+			return from.kind === 'preceding' ? from.offset < to.offset : from.offset > to.offset;
+		}
+	}
+	return false;
+}
+
+function boundaryToSQL(boundary: WindowFrameBoundary): SQL {
+	switch (boundary.kind) {
+		case 'unboundedPreceding': {
+			return sql.raw('unbounded preceding');
+		}
+		case 'currentRow': {
+			return sql.raw('current row');
+		}
+		case 'unboundedFollowing': {
+			return sql.raw('unbounded following');
+		}
+		case 'preceding':
+		case 'following': {
+			const offset = typeof boundary.offset === 'number' ? sql.raw(String(boundary.offset)) : boundary.offset;
+			return sql`${offset} ${sql.raw(boundary.kind)}`;
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Frames
+// ---------------------------------------------------------------------------
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: 'rows' | 'range',
+		readonly from: WindowFrameBoundary,
+		readonly to: WindowFrameBoundary | undefined,
+	) {}
+
+	getSQL(): SQL {
+		if (this.to === undefined) {
+			return sql`${sql.raw(this.mode)} ${boundaryToSQL(this.from)}`;
+		}
+		return sql`${sql.raw(this.mode)} between ${boundaryToSQL(this.from)} and ${boundaryToSQL(this.to)}`;
+	}
+}
+
+function buildFrame(mode: 'rows' | 'range', spec: WindowFrameSpec): WindowFrame {
+	if (!spec || typeof spec !== 'object' || !spec.from) {
+		throw new Error(`${mode}() expects a { from, to } frame specification with a "from" boundary`);
+	}
+	const { from, to } = spec;
+	if (to !== undefined && isBoundaryAfter(from, to)) {
+		throw new Error(`${mode}(): "from" boundary must not be ordered after the "to" boundary`);
+	}
+	if (from.kind === 'unboundedFollowing') {
+		throw new Error(`${mode}(): "from" boundary cannot be unboundedFollowing`);
+	}
+	if (to?.kind === 'unboundedPreceding') {
+		throw new Error(`${mode}(): "to" boundary cannot be unboundedPreceding`);
+	}
+	return new WindowFrame(mode, from, to);
+}
+
+/**
+ * Builds a `rows` window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * rows({ from: unboundedPreceding, to: currentRow })
+ * // rows between unbounded preceding and current row
+ * ```
+ */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/**
+ * Builds a `range` window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * range({ from: preceding(5), to: following(5) })
+ * // range between 5 preceding and 5 following
+ * ```
+ */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+// ---------------------------------------------------------------------------
+// Window specification
+// ---------------------------------------------------------------------------
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | AnyColumn | (SQLWrapper | AnyColumn)[];
+	orderBy?: SQLWrapper | AnyColumn | (SQLWrapper | AnyColumn)[];
+	frame?: WindowFrame;
+}
+
+/** @internal */
+export function assertWindowName(name: unknown): asserts name is string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not consist only of whitespace');
+	}
+}
+
+function toList(value: SQLWrapper | AnyColumn | (SQLWrapper | AnyColumn)[] | undefined): (SQLWrapper | AnyColumn)[] {
+	if (value === undefined) return [];
+	return Array.isArray(value) ? value : [value];
+}
+
+/** Compiles a window specification to the SQL found between the parentheses of `over (...)`. */
+export function windowSpecToSQL(spec: WindowSpec = {}): SQL {
+	const chunks: SQL[] = [];
+	const partitionBy = toList(spec.partitionBy);
+	if (partitionBy.length > 0) {
+		chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+	const orderBy = toList(spec.orderBy);
+	if (orderBy.length > 0) {
+		chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+	if (spec.frame !== undefined) {
+		chunks.push(spec.frame.getSQL());
+	}
+	return sql.join(chunks, sql` `);
+}
+
+/** Compiles a list of named windows to a ` window ...` clause (with leading space). */
+export function windowClauseToSQL(windows: { name: string; spec: WindowSpec }[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${windowSpecToSQL(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+// ---------------------------------------------------------------------------
+// Window function builder
+// ---------------------------------------------------------------------------
+
+type WindowFunctionDecoder = DriverValueDecoder<any, any> | ((value: any) => any) | AnyColumn;
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: { readonly type: T };
+
+	constructor(
+		/** @internal */
+		readonly fn: SQL,
+		/** @internal */
+		readonly decoder: WindowFunctionDecoder,
+	) {}
+
+	/**
+	 * Applies the window function over an inline window specification or a named window
+	 * (defined with `.window(name, spec)` on the select query).
+	 */
+	over(spec: WindowSpec | string = {}): SQL<T> {
+		let overSql: SQL;
+		if (typeof spec === 'string') {
+			assertWindowName(spec);
+			overSql = sql`${this.fn} over ${sql.identifier(spec)}`;
+		} else {
+			overSql = sql`${this.fn} over (${windowSpecToSQL(spec)})`;
+		}
+		return overSql.mapWith(this.decoder as any) as SQL<T>;
+	}
+}
+
+function decoderFor(expression: unknown, fallback: (value: any) => any): WindowFunctionDecoder {
+	return is(expression, Column) ? expression : is(expression, SQL) ? expression.decoder : fallback;
+}
+
+function assertPositiveInteger(fnName: string, value: unknown): asserts value is number {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() expects a positive integer, received ${String(value)}`);
+	}
+}
+
+function assertInteger(fnName: string, value: unknown): asserts value is number {
+	if (typeof value !== 'number' || !Number.isInteger(value)) {
+		throw new Error(`${fnName}() expects an integer offset, received ${String(value)}`);
+	}
+}
+
+function literalOrValue(value: unknown): SQLChunk {
+	if (typeof value === 'number' && Number.isFinite(value)) {
+		return sql.raw(String(value));
+	}
+	return value as SQLChunk;
+}
+
+// Ranking functions
+
+/** `row_number()` - number of the current row within its partition, counting from 1. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+/** `rank()` - rank of the current row with gaps. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+/** `dense_rank()` - rank of the current row without gaps. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+/** `ntile(n)` - integer ranging from 1 to `buckets`, dividing the partition as equally as possible. */
+export function ntile(buckets: number): WindowFunction<number> {
+	assertPositiveInteger('ntile', buckets);
+	return new WindowFunction(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+/** `percent_rank()` - relative rank of the current row: (rank - 1) / (total partition rows - 1). */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+/** `cume_dist()` - cumulative distribution of the current row. */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+// Value functions
+
+function offsetFunction(
+	name: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultValue: unknown,
+): WindowFunction<any> {
+	const args: SQLChunk[] = [expression];
+	if (offset !== undefined || defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		assertInteger(name, resolvedOffset);
+		args.push(sql.raw(String(resolvedOffset)));
+	}
+	if (defaultValue !== undefined) {
+		args.push(literalOrValue(defaultValue));
+	}
+	return new WindowFunction(
+		sql`${sql.raw(name)}(${sql.join(args, sql`, `)})`,
+		decoderFor(expression, (value) => value),
+	);
+}
+
+/**
+ * `lag(expression, offset, default)` - value of `expression` evaluated at the row `offset` rows
+ * before the current row within the partition.
+ */
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<InferWindowExpressionType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: InferWindowExpressionType<T> | SQLWrapper,
+): WindowFunction<NonNullable<InferWindowExpressionType<T>>>;
+export function lag(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lag', expression, offset, defaultValue);
+}
+
+/**
+ * `lead(expression, offset, default)` - value of `expression` evaluated at the row `offset` rows
+ * after the current row within the partition.
+ */
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<InferWindowExpressionType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: InferWindowExpressionType<T> | SQLWrapper,
+): WindowFunction<NonNullable<InferWindowExpressionType<T>>>;
+export function lead(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lead', expression, offset, defaultValue);
+}
+
+/** `first_value(expression)` - value of `expression` at the first row of the window frame. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowExpressionType<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, decoderFor(expression, (value) => value));
+}
+
+/** `last_value(expression)` - value of `expression` at the last row of the window frame. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowExpressionType<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, decoderFor(expression, (value) => value));
+}
+
+/** `nth_value(expression, n)` - value of `expression` at the `n`-th row (1-based) of the window frame. */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<InferWindowExpressionType<T> | null> {
+	assertPositiveInteger('nthValue', n);
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		decoderFor(expression, (value) => value),
+	);
+}
+
+// Aggregate functions
+
+/** `sum(expression)` as a window function. */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+/** `avg(expression)` as a window function. */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+/** `min(expression)` as a window function. */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `max(expression)` as a window function. */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `count(expression)` as a window function; `count(*)` when called without an argument. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
