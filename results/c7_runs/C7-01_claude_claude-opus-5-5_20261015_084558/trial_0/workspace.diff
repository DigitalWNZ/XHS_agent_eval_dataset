diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..c61213c6
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,138 @@
+import { describe, expect, test } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int as mysqlInt, mysqlTable } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { integer as sqliteInt, sqliteTable } from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	dept: text('dept').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+const db = pgDrizzle.mock();
+
+describe('window functions', () => {
+	test('function names', () => {
+		const q = db.select({
+			a: rowNumber().over(),
+			b: rank().over(),
+			c: denseRank().over(),
+			d: ntile(4).over(),
+			e: percentRank().over(),
+			f: cumeDist().over(),
+			g: lag(employees.salary).over(),
+			h: lead(employees.salary).over(),
+			i: firstValue(employees.salary).over(),
+			j: lastValue(employees.salary).over(),
+			k: nthValue(employees.salary, 2).over(),
+			l: windowSum(employees.salary).over(),
+			m: windowAvg(employees.salary).over(),
+			n: windowMin(employees.salary).over(),
+			o: windowMax(employees.salary).over(),
+			p: windowCount().over(),
+			q: windowCount(employees.id).over(),
+		}).from(employees).toSQL();
+		expect(q.sql).toBe(
+			'select row_number() over (), rank() over (), dense_rank() over (), ntile(4) over (), percent_rank() over (), cume_dist() over (), '
+				+ 'lag("employees"."salary") over (), lead("employees"."salary") over (), first_value("employees"."salary") over (), last_value("employees"."salary") over (), nth_value("employees"."salary", 2) over (), '
+				+ 'sum("employees"."salary") over (), avg("employees"."salary") over (), min("employees"."salary") over (), max("employees"."salary") over (), count(*) over (), count("employees"."id") over () from "employees"',
+		);
+		expect(q.params).toEqual([]);
+	});
+
+	test('positional args never bound, even zero', () => {
+		const q = db.select({
+			a: lag(employees.salary, 0, 0).over(),
+			b: lead(employees.salary, 2).over(),
+			c: lag(employees.salary, undefined, 5).over(),
+		}).from(employees).toSQL();
+		expect(q.sql).toBe(
+			'select lag("employees"."salary", 0, 0) over (), lead("employees"."salary", 2) over (), lag("employees"."salary", 1, 5) over () from "employees"',
+		);
+		expect(q.params).toEqual([]);
+	});
+
+	test('inline spec with frame', () => {
+		const q = db.select({
+			total: windowSum(employees.salary).over({
+				partitionBy: employees.dept,
+				orderBy: [desc(employees.salary), employees.id],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+			r: windowAvg(employees.salary).over({ frame: range({ from: preceding(0), to: following(3) }) }),
+		}).from(employees).toSQL();
+		expect(q.sql).toBe(
+			'select sum("employees"."salary") over (partition by "employees"."dept" order by "employees"."salary" desc, "employees"."id" rows between unbounded preceding and current row), '
+				+ 'avg("employees"."salary") over (range between 0 preceding and 3 following) from "employees"',
+		);
+		expect(q.params).toEqual([]);
+	});
+
+	test('named windows', () => {
+		const q = db.select({ rn: rowNumber().over('w') }).from(employees)
+			.window('w', { partitionBy: employees.dept })
+			.window('w2', {})
+			.orderBy(employees.id).toSQL();
+		expect(q.sql).toBe(
+			'select row_number() over "w" from "employees" window "w" as (partition by "employees"."dept"), "w2" as () order by "employees"."id"',
+		);
+	});
+
+	test('other dialects', () => {
+		const m = mysqlTable('t', { id: mysqlInt('id') });
+		expect(mysqlDrizzle.mock().select({ r: rank().over('w') }).from(m).window('w', { orderBy: m.id }).toSQL().sql)
+			.toBe('select rank() over `w` from `t` window `w` as (order by `t`.`id`)');
+		const s = sqliteTable('t', { id: sqliteInt('id') });
+		expect(sqliteDrizzle().select({ r: rank().over('w') }).from(s).window('w', { orderBy: s.id }).toSQL().sql)
+			.toBe('select rank() over "w" from "t" window "w" as (order by "t"."id")');
+	});
+
+	test('validation', () => {
+		expect(() => ntile(0)).toThrow(/ntile.*0/);
+		expect(() => ntile(1.5)).toThrow(/ntile.*1\.5/);
+		expect(() => nthValue(employees.salary, -1)).toThrow(/nthValue.*-1/);
+		expect(() => db.select().from(employees).window('', {})).toThrow(/non-empty/);
+		expect(() => db.select().from(employees).window('  ', {})).toThrow(/whitespace/);
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrow(/from/);
+		expect(() => rows({ from: following(1), to: preceding(1) })).toThrow(/from/);
+		expect(() => range({ from: preceding(1), to: preceding(3) })).toThrow(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: unboundedFollowing })).toThrow(/from/);
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => following(1.5)).toThrow(/following/);
+	});
+});
+
+test('non-numeric default value is bound as a parameter', () => {
+	const q = db.select({ a: lag(employees.dept, 1, 'none').over() }).from(employees).toSQL();
+	expect(q.sql).toBe('select lag("employees"."dept", 1, $1) over () from "employees"');
+	expect(q.params).toEqual(['none']);
+});
