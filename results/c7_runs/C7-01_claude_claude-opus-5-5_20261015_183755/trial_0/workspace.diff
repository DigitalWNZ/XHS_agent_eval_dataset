diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..29d949da
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,163 @@
+import { describe, expect, expectTypeOf, test } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import { gelTable, integer as gelInt } from '~/gel-core/index.ts';
+import { drizzle as gelDrizzle } from '~/gel/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	type SQL,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int, mysqlTable, varchar } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { int as ssInt, singlestoreTable } from '~/singlestore-core/index.ts';
+import { drizzle as singlestoreDrizzle } from '~/singlestore/index.ts';
+import { integer as sqliteInt, sqliteTable } from '~/sqlite-core/index.ts';
+
+const users = pgTable('users', {
+	id: integer('id').notNull(),
+	city: text('city').notNull(),
+	score: integer('score'),
+});
+
+const db = pgDrizzle.mock();
+
+describe('window functions', () => {
+	test('function names', () => {
+		const q = db.select({
+			a: rowNumber().over(),
+			b: rank().over(),
+			c: denseRank().over(),
+			d: ntile(4).over(),
+			e: percentRank().over(),
+			f: cumeDist().over(),
+			g: lag(users.score).over(),
+			h: lead(users.score).over(),
+			i: firstValue(users.score).over(),
+			j: lastValue(users.score).over(),
+			k: nthValue(users.score, 2).over(),
+			l: windowSum(users.score).over(),
+			m: windowAvg(users.score).over(),
+			n: windowMin(users.score).over(),
+			o: windowMax(users.score).over(),
+			p: windowCount().over(),
+			q: windowCount(users.score).over({}),
+		}).from(users).toSQL();
+		expect(q.sql).toBe(
+			'select row_number() over (), rank() over (), dense_rank() over (), ntile(4) over (), percent_rank() over (), cume_dist() over (), '
+				+ 'lag("users"."score") over (), lead("users"."score") over (), first_value("users"."score") over (), last_value("users"."score") over (), nth_value("users"."score", 2) over (), '
+				+ 'sum("users"."score") over (), avg("users"."score") over (), min("users"."score") over (), max("users"."score") over (), count(*) over (), count("users"."score") over () from "users"',
+		);
+		expect(q.params).toEqual([]);
+	});
+
+	test('positional args never become params, even zero', () => {
+		const q = db.select({ a: lag(users.score, 0).over(), b: lead(users.score, 2, 0).over() }).from(users).toSQL();
+		expect(q.sql).toBe('select lag("users"."score", 0) over (), lead("users"."score", 2, $1) over () from "users"');
+		expect(q.params).toEqual([0]);
+		const q2 = db.select({ a: lag(users.score, undefined, 5).over() }).from(users).toSQL();
+		expect(q2.sql).toBe('select lag("users"."score", 1, $1) over () from "users"');
+	});
+
+	test('inline spec with frame', () => {
+		const q = db.select({
+			total: windowSum(users.score).over({
+				partitionBy: users.city,
+				orderBy: [desc(users.score), users.id],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+			moving: windowAvg(users.score).over({
+				orderBy: users.id,
+				frame: range({ from: preceding(0), to: following(3) }),
+			}),
+			tail: windowMax(users.score).over({ frame: rows({ from: currentRow, to: unboundedFollowing }) }),
+			short: windowMin(users.score).over({ frame: rows({ from: preceding(2) }) }),
+		}).from(users).toSQL();
+		expect(q.sql).toBe(
+			'select sum("users"."score") over (partition by "users"."city" order by "users"."score" desc, "users"."id" rows between unbounded preceding and current row), '
+				+ 'avg("users"."score") over (order by "users"."id" range between 0 preceding and 3 following), '
+				+ 'max("users"."score") over (rows between current row and unbounded following), '
+				+ 'min("users"."score") over (rows 2 preceding) from "users"',
+		);
+		expect(q.params).toEqual([]);
+	});
+
+	test('named windows', () => {
+		const q = db.select({ id: users.id, rn: rowNumber().over('w') }).from(users)
+			.window('w', { partitionBy: users.city, orderBy: users.id })
+			.window('w2', {})
+			.orderBy(users.id)
+			.toSQL();
+		expect(q.sql).toBe(
+			'select "id", row_number() over "w" from "users" window "w" as (partition by "users"."city" order by "users"."id"), "w2" as () order by "users"."id"',
+		);
+	});
+
+	test('window on all dialects', () => {
+		const m = mysqlTable('t', { id: int('id'), name: varchar('name', { length: 10 }) });
+		expect(
+			mysqlDrizzle.mock().select({ rn: rowNumber().over('w') }).from(m).window('w', { orderBy: m.id }).toSQL().sql,
+		).toBe('select row_number() over `w` from `t` window `w` as (order by `t`.`id`)');
+		const s = sqliteTable('t', { id: sqliteInt('id') });
+		expect(
+			sqliteDrizzle(':memory:').select({ rn: rowNumber().over('w') }).from(s).window('w', { orderBy: s.id }).toSQL()
+				.sql,
+		).toBe('select row_number() over "w" from "t" window "w" as (order by "t"."id")');
+		const ss = singlestoreTable('t', { id: ssInt('id') });
+		expect(
+			singlestoreDrizzle.mock().select({ rn: rowNumber().over('w') }).from(ss).window('w', { orderBy: ss.id })
+				.toSQL().sql,
+		).toBe('select row_number() over `w` from `t` window `w` as (order by `t`.`id`)');
+		const g = gelTable('t', { id: gelInt('id') });
+		expect(
+			gelDrizzle({ client: {} as any }).select({ rn: rowNumber().over('w') }).from(g).window('w', { orderBy: g.id })
+				.toSQL().sql,
+		).toBe('select row_number() over "w" from "t" window "w" as (order by "t"."id")');
+	});
+
+	test('validation', () => {
+		expect(() => ntile(0)).toThrow(/ntile.*0/);
+		expect(() => ntile(1.5)).toThrow(/ntile.*1\.5/);
+		expect(() => nthValue(users.id, -1)).toThrow(/nthValue.*-1/);
+		expect(() => db.select().from(users).window('', {})).toThrow(/non-empty/);
+		expect(() => db.select().from(users).window('   ', {})).toThrow(/whitespace/);
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrow(/from|to/);
+		expect(() => rows({ from: following(1), to: preceding(1) })).toThrow(/from/);
+		expect(() => range({ from: preceding(1), to: preceding(3) })).toThrow(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: unboundedFollowing })).toThrow(/from/);
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => following(1.5)).toThrow(/following/);
+	});
+
+	test('types', () => {
+		expectTypeOf(rowNumber().over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(lag(users.id).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(lag(users.id, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(lead(users.city, 1, 'x').over()).toEqualTypeOf<SQL<string>>();
+		expectTypeOf(firstValue(users.city).over()).toEqualTypeOf<SQL<string | null>>();
+		expectTypeOf(nthValue(users.city, 1).over()).toEqualTypeOf<SQL<string | null>>();
+	});
+});
