diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..40f3380c
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,358 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+type WindowValue<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+/** A single frame boundary, e.g. `unbounded preceding` or `3 following`. */
+export class WindowFrameBoundary {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		/** @internal */
+		readonly kind: 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing',
+		/** @internal */
+		readonly offset?: number | SQLWrapper,
+	) {}
+
+	/** @internal */
+	getSQL(): SQL {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return sql.raw('unbounded preceding');
+			}
+			case 'currentRow': {
+				return sql.raw('current row');
+			}
+			case 'unboundedFollowing': {
+				return sql.raw('unbounded following');
+			}
+			case 'preceding':
+			case 'following': {
+				const offset = typeof this.offset === 'number' ? sql.raw(String(this.offset)) : this.offset!;
+				return sql`${offset} ${sql.raw(this.kind)}`;
+			}
+		}
+	}
+}
+
+/** `unbounded preceding` frame boundary. */
+export const unboundedPreceding = new WindowFrameBoundary('unboundedPreceding');
+/** `current row` frame boundary. */
+export const currentRow = new WindowFrameBoundary('currentRow');
+/** `unbounded following` frame boundary. */
+export const unboundedFollowing = new WindowFrameBoundary('unboundedFollowing');
+
+function frameOffset(name: string, offset: number | SQLWrapper): number | SQLWrapper {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset < 0) {
+			throw new Error(`${name}() expects a non-negative integer, received ${offset}`);
+		}
+		return offset;
+	}
+	if (!isSQLWrapper(offset)) {
+		throw new Error(`${name}() expects a non-negative integer or SQL expression, received ${String(offset)}`);
+	}
+	return offset;
+}
+
+/** `<offset> preceding` frame boundary. */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	return new WindowFrameBoundary('preceding', frameOffset('preceding', offset));
+}
+
+/** `<offset> following` frame boundary. */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	return new WindowFrameBoundary('following', frameOffset('following', offset));
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+/** A window frame clause, e.g. `rows between unbounded preceding and current row`. */
+export class WindowFrame {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		/** @internal */
+		readonly mode: 'rows' | 'range',
+		/** @internal */
+		readonly from: WindowFrameBoundary,
+		/** @internal */
+		readonly to?: WindowFrameBoundary,
+	) {}
+
+	/** @internal */
+	getSQL(): SQL {
+		const mode = sql.raw(this.mode);
+		return this.to
+			? sql`${mode} between ${this.from.getSQL()} and ${this.to.getSQL()}`
+			: sql`${mode} ${this.from.getSQL()}`;
+	}
+}
+
+const boundaryRank = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+} as const;
+
+/** Returns negative if `a` is ordered before `b`, positive if after, 0 if equal or unknown. */
+function compareBoundaries(a: WindowFrameBoundary, b: WindowFrameBoundary): number {
+	const diff = boundaryRank[a.kind] - boundaryRank[b.kind];
+	if (diff !== 0) return diff;
+	if (typeof a.offset === 'number' && typeof b.offset === 'number') {
+		return a.kind === 'preceding' ? b.offset - a.offset : a.offset - b.offset;
+	}
+	return 0;
+}
+
+function buildFrame(mode: 'rows' | 'range', spec: WindowFrameSpec): WindowFrame {
+	if (!spec || !is(spec.from, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects a "from" frame boundary`);
+	}
+	if (spec.to !== undefined && !is(spec.to, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects "to" to be a frame boundary`);
+	}
+	if (spec.from.kind === 'unboundedFollowing') {
+		throw new Error(`${mode}(): "from" boundary cannot be unbounded following`);
+	}
+	if (spec.to) {
+		if (spec.to.kind === 'unboundedPreceding') {
+			throw new Error(`${mode}(): "to" boundary cannot be unbounded preceding`);
+		}
+		if (compareBoundaries(spec.from, spec.to) > 0) {
+			throw new Error(`${mode}(): "from" boundary must not be ordered after the "to" boundary`);
+		}
+	}
+	return new WindowFrame(mode, spec.from, spec.to);
+}
+
+/** Builds a `rows` frame clause. */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/** Builds a `range` frame clause. */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+/** @internal */
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not consist only of whitespace');
+	}
+}
+
+/** Builds the contents of a window specification (without surrounding parentheses). */
+export function buildWindowSpec(spec: WindowSpec = {}): SQL {
+	const parts: SQL[] = [];
+	const toList = (value: SQLWrapper | SQLWrapper[]) => Array.isArray(value) ? value : [value];
+	if (spec.partitionBy !== undefined) {
+		const list = toList(spec.partitionBy);
+		if (list.length > 0) parts.push(sql`partition by ${sql.join(list, sql`, `)}`);
+	}
+	if (spec.orderBy !== undefined) {
+		const list = toList(spec.orderBy);
+		if (list.length > 0) parts.push(sql`order by ${sql.join(list, sql`, `)}`);
+	}
+	if (spec.frame) {
+		parts.push(spec.frame.getSQL());
+	}
+	return sql.join(parts, sql` `);
+}
+
+/** Builds a `window "name" as (...), ...` clause. */
+export function buildWindowClause(windows: { name: string; spec: WindowSpec }[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	const defs = windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`);
+	return sql` window ${sql.join(defs, sql`, `)}`;
+}
+
+/** A window function call awaiting its `over` clause. */
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: {
+		readonly type: T;
+	};
+
+	constructor(
+		/** @internal */
+		readonly call: SQL,
+		/** @internal */
+		readonly decoder?: Column | ((value: any) => any),
+	) {}
+
+	/**
+	 * Adds an `over` clause. Pass an inline window specification, or the name of a
+	 * window defined with `.window(name, spec)` on the select builder.
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		let result: SQL;
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			result = sql`${this.call} over ${sql.identifier(spec)}`;
+		} else {
+			result = sql`${this.call} over (${buildWindowSpec(spec)})`;
+		}
+		if (this.decoder) result.mapWith(this.decoder);
+		return result as SQL<T>;
+	}
+}
+
+function positiveInteger(name: string, value: number): SQL {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${name}() expects a positive integer, received ${String(value)}`);
+	}
+	return sql.raw(String(value));
+}
+
+function nonNegativeInteger(name: string, value: number): SQL {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${name}() expects a non-negative integer offset, received ${String(value)}`);
+	}
+	return sql.raw(String(value));
+}
+
+function columnDecoder(expression: SQLWrapper): Column | undefined {
+	return is(expression, Column) ? expression : undefined;
+}
+
+// Ranking functions
+
+/** `row_number()` - sequential number of the row within its partition, starting at 1. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+/** `rank()` - rank of the current row with gaps. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+/** `dense_rank()` - rank of the current row without gaps. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+/** `ntile(n)` - divides the partition into `n` buckets and returns the bucket number. */
+export function ntile(buckets: number): WindowFunction<number> {
+	return new WindowFunction(sql`ntile(${positiveInteger('ntile', buckets)})`, Number);
+}
+
+/** `percent_rank()` - relative rank of the current row: (rank - 1) / (total rows - 1). */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+/** `cume_dist()` - cumulative distribution of the current row. */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+// Value access functions
+
+function offsetFunction(
+	name: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultValue: unknown,
+): WindowFunction<any> {
+	const args: SQL[] = [sql`${expression}`];
+	if (offset !== undefined || defaultValue !== undefined) {
+		args.push(nonNegativeInteger(name, offset ?? 1));
+	}
+	if (defaultValue !== undefined) {
+		args.push(sql`${defaultValue}`);
+	}
+	return new WindowFunction(sql`${sql.raw(name)}(${sql.join(args, sql`, `)})`, columnDecoder(expression));
+}
+
+/** `lag(expr[, offset[, default]])` - value of `expr` from a preceding row. */
+export function lag<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<WindowValue<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: WindowValue<T> | SQLWrapper,
+): WindowFunction<NonNullable<WindowValue<T>>>;
+export function lag(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lag', expression, offset, defaultValue);
+}
+
+/** `lead(expr[, offset[, default]])` - value of `expr` from a following row. */
+export function lead<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<WindowValue<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: WindowValue<T> | SQLWrapper,
+): WindowFunction<NonNullable<WindowValue<T>>>;
+export function lead(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lead', expression, offset, defaultValue);
+}
+
+/** `first_value(expr)` - value of `expr` at the first row of the window frame. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<WindowValue<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, columnDecoder(expression));
+}
+
+/** `last_value(expr)` - value of `expr` at the last row of the window frame. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<WindowValue<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, columnDecoder(expression));
+}
+
+/** `nth_value(expr, n)` - value of `expr` at the n-th row (1-based) of the window frame. */
+export function nthValue<T extends SQLWrapper>(expression: T, n: number): WindowFunction<WindowValue<T> | null> {
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${positiveInteger('nthValue', n)})`,
+		columnDecoder(expression),
+	);
+}
+
+// Aggregate functions used as window functions
+
+/** `sum(expr) over (...)` */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+/** `avg(expr) over (...)` */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+/** `min(expr) over (...)` */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, columnDecoder(expression) ?? String);
+}
+
+/** `max(expr) over (...)` */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, columnDecoder(expression) ?? String);
+}
+
+/** `count(expr) over (...)`, or `count(*) over (...)` when called without an argument. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
