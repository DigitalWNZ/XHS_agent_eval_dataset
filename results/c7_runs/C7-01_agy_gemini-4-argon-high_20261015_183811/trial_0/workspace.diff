new file mode 100644
index 00000000..1fdb8d44
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,393 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import { type DriverValueDecoder, isSQLWrapper, noopDecoder, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameBoundaryType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+const boundaryOrderMap: Record<WindowFrameBoundaryType, number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly type: WindowFrameBoundaryType,
+		readonly offset?: number,
+	) {}
+
+	getSQL(): SQL {
+		switch (this.type) {
+			case 'unboundedPreceding': {
+				return sql.raw('unbounded preceding');
+			}
+			case 'preceding': {
+				return sql.raw(`${this.offset} preceding`);
+			}
+			case 'currentRow': {
+				return sql.raw('current row');
+			}
+			case 'following': {
+				return sql.raw(`${this.offset} following`);
+			}
+			case 'unboundedFollowing': {
+				return sql.raw('unbounded following');
+			}
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding = new WindowFrameBoundary('unboundedPreceding');
+export const currentRow = new WindowFrameBoundary('currentRow');
+export const unboundedFollowing = new WindowFrameBoundary('unboundedFollowing');
+
+export function preceding(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() expects a non-negative integer, received ${offset}`);
+	}
+	return new WindowFrameBoundary('preceding', offset === 0 ? 0 : offset);
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() expects a non-negative integer, received ${offset}`);
+	}
+	return new WindowFrameBoundary('following', offset === 0 ? 0 : offset);
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+export type WindowFrameMode = 'rows' | 'range';
+
+function isFromOrderedAfterTo(from: WindowFrameBoundary, to: WindowFrameBoundary): boolean {
+	const fromOrder = boundaryOrderMap[from.type];
+	const toOrder = boundaryOrderMap[to.type];
+	if (fromOrder !== toOrder) {
+		return fromOrder > toOrder;
+	}
+	if (from.type === 'preceding' && to.type === 'preceding') {
+		return (from.offset ?? 0) < (to.offset ?? 0);
+	}
+	if (from.type === 'following' && to.type === 'following') {
+		return (from.offset ?? 0) > (to.offset ?? 0);
+	}
+	return false;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		readonly from: WindowFrameBoundary,
+		readonly to: WindowFrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(this.mode)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	if (isFromOrderedAfterTo(spec.from, spec.to)) {
+		throw new Error('Invalid window frame: "from" boundary cannot be ordered after "to" boundary');
+	}
+	return new WindowFrame('rows', spec.from, spec.to);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	if (isFromOrderedAfterTo(spec.from, spec.to)) {
+		throw new Error('Invalid window frame: "from" boundary cannot be ordered after "to" boundary');
+	}
+	return new WindowFrame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	frame?: WindowFrame | SQL;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot contain only whitespace');
+	}
+}
+
+export function buildWindowSpecSql(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionByList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByList.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderByList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByList.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		const frameSql = is(spec.frame, SQL) ? spec.frame : spec.frame.getSQL();
+		parts.push(frameSql);
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder:
+			| DriverValueDecoder<any, any>
+			| DriverValueDecoder<any, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(specOrName?: WindowSpec | string): SQL<T> {
+		if (typeof specOrName === 'string') {
+			validateWindowName(specOrName);
+			return sql`${this.fnSql} over ${sql.identifier(specOrName)}`.mapWith(this.decoder) as SQL<T>;
+		}
+
+		const specSql = buildWindowSpecSql(specOrName);
+		return sql`${this.fnSql} over (${specSql})`.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type ExtractWindowValueType<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer TData> ? TData
+	: T extends SQL.Aliased<infer TData> ? TData
+	: unknown;
+
+type StripNull<T> = unknown extends T ? unknown : NonNullable<T>;
+
+function getExpressionDecoder(
+	expression: SQLWrapper,
+): DriverValueDecoder<any, any> | DriverValueDecoder<any, any>['mapFromDriverValue'] {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(buckets: number): WindowFunctionBuilder<number> {
+	if (typeof buckets !== 'number' || !Number.isInteger(buckets) || buckets < 1) {
+		throw new Error(`ntile() expects a positive integer, received ${buckets}`);
+	}
+	return new WindowFunctionBuilder(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`cume_dist()`, Number);
+}
+
+function buildLagLead(
+	fnName: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		const defaultChunk = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: isSQLWrapper(defaultValue)
+			? defaultValue
+			: bindIfParam(defaultValue, expression);
+		return new WindowFunctionBuilder(
+			sql`${sql.raw(fnName)}(${expression}, ${sql.raw(String(resolvedOffset))}, ${defaultChunk})`,
+			decoder,
+		);
+	}
+	if (offset !== undefined) {
+		return new WindowFunctionBuilder(
+			sql`${sql.raw(fnName)}(${expression}, ${sql.raw(String(offset))})`,
+			decoder,
+		);
+	}
+	return new WindowFunctionBuilder(
+		sql`${sql.raw(fnName)}(${expression})`,
+		decoder,
+	);
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: undefined,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<ExtractWindowValueType<T>> | SQLWrapper,
+): WindowFunctionBuilder<StripNull<ExtractWindowValueType<T>>>;
+export function lag(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	return buildLagLead('lag', expression, offset, defaultValue);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: undefined,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<ExtractWindowValueType<T>> | SQLWrapper,
+): WindowFunctionBuilder<StripNull<ExtractWindowValueType<T>>>;
+export function lead(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	return buildLagLead('lead', expression, offset, defaultValue);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null> {
+	return new WindowFunctionBuilder(
+		sql`first_value(${expression})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null> {
+	return new WindowFunctionBuilder(
+		sql`last_value(${expression})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() expects a positive integer, received ${n}`);
+	}
+	return new WindowFunctionBuilder(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<
+	(T extends AnyColumn ? T['_']['data']
+		: T extends SQL<infer TData> ? (unknown extends TData ? string : TData)
+		: T extends SQL.Aliased<infer TData> ? (unknown extends TData ? string : TData)
+		: string) | null
+> {
+	return new WindowFunctionBuilder(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : String,
+	);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<
+	(T extends AnyColumn ? T['_']['data']
+		: T extends SQL<infer TData> ? (unknown extends TData ? string : TData)
+		: T extends SQL.Aliased<infer TData> ? (unknown extends TData ? string : TData)
+		: string) | null
+> {
+	return new WindowFunctionBuilder(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : String,
+	);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(
+		sql`count(${expression ?? sql.raw('*')})`,
+		Number,
+	);
+}
