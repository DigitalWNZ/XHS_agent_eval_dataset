diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..ac1ab75
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,439 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const (
+	KeySize        = 32
+	MaxChunkSize   = 64 * 1024
+	NonceSize      = 12
+	TagSize        = 16
+	HMACSize       = 32
+	HeaderSize     = 3
+	MagicByte1     = 0x4F
+	MagicByte2     = 0x44
+	FormatVersion1 = 0x01
+	MinSaltSize    = 16
+	PBKDF2Iter     = 100000
+)
+
+var (
+	ErrInvalidKey = errors.New("encryption: invalid key length, must be 32 bytes")
+)
+
+type Encryptor struct {
+	key  []byte
+	aead cipher.AEAD
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to create AES cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to create GCM: %w", err)
+	}
+
+	return &Encryptor{
+		key:  keyCopy,
+		aead: aead,
+	}, nil
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	enc           *Encryptor
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:   w,
+		enc: e,
+		mac: hmac.New(sha256.New, e.key),
+		buf: make([]byte, 0, MaxChunkSize),
+	}
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{MagicByte1, MagicByte2, FormatVersion1}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk(plaintext []byte) error {
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("encryption: failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.enc.aead.Seal(nil, nonce, plaintext, nil)
+	chunkLen := uint32(len(nonce) + len(ciphertext))
+
+	frame := make([]byte, 4+int(chunkLen))
+	binary.BigEndian.PutUint32(frame[:4], chunkLen)
+	copy(frame[4:4+NonceSize], nonce)
+	copy(frame[4+NonceSize:], ciphertext)
+
+	ew.mac.Write(frame)
+	_, err := ew.w.Write(frame)
+	return err
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("encryption: write on closed writer")
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		return 0, err
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		space := MaxChunkSize - len(ew.buf)
+		n := len(p)
+		if n > space {
+			n = space
+		}
+		ew.buf = append(ew.buf, p[:n]...)
+		p = p[n:]
+
+		if len(ew.buf) == MaxChunkSize {
+			if err := ew.flushChunk(ew.buf); err != nil {
+				return 0, err
+			}
+			ew.buf = ew.buf[:0]
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	var sentinel [4]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		return err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	aead        cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	done        bool
+	err         error
+	plainBuf    []byte
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to create AES cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: failed to create GCM: %w", err)
+	}
+
+	return &decryptReader{
+		r:    r,
+		key:  keyCopy,
+		aead: aead,
+		mac:  hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+func (dr *decryptReader) initHeader() error {
+	var header [HeaderSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		return fmt.Errorf("encryption: invalid header: %w", err)
+	}
+	if header[0] != MagicByte1 || header[1] != MagicByte2 {
+		return errors.New("encryption: invalid header magic bytes")
+	}
+	if header[2] != FormatVersion1 {
+		return fmt.Errorf("encryption: unsupported version: 0x%02x", header[2])
+	}
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("encryption: truncated stream reading chunk length: %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		var expectedMAC [HMACSize]byte
+		if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return fmt.Errorf("encryption: truncated stream reading HMAC: %w", io.ErrUnexpectedEOF)
+			}
+			return err
+		}
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC[:]) {
+			return errors.New("encryption: integrity check failed: HMAC mismatch")
+		}
+		dr.done = true
+		return io.EOF
+	}
+
+	const maxEncryptedChunkSize = NonceSize + MaxChunkSize + TagSize
+	if chunkLen < NonceSize+TagSize || chunkLen > maxEncryptedChunkSize {
+		return fmt.Errorf("encryption: invalid chunk length %d", chunkLen)
+	}
+
+	payload := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, payload); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("encryption: truncated chunk payload: %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	dr.mac.Write(lenBuf[:])
+	dr.mac.Write(payload)
+
+	nonce := payload[:NonceSize]
+	ciphertext := payload[NonceSize:]
+
+	plaintext, err := dr.aead.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("encryption: integrity check failed during chunk decryption: %w", err)
+	}
+
+	dr.plainBuf = append(dr.plainBuf, plaintext...)
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.initialized {
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.plainBuf) == 0 && !dr.done {
+		if err := dr.readNextChunk(); err != nil {
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if len(dr.plainBuf) > 0 {
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+
+	return 0, io.EOF
+}
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"key-source"`
+	KeyEnvVar  string `yaml:"key-env"`
+	KeyFile    string `yaml:"key-file"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption: key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasKey := strings.TrimSpace(c.Key) != ""
+	hasPass := c.Passphrase != ""
+	hasSalt := strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case "env":
+		if !hasEnv {
+			return errors.New("encryption: key env var is required for env key source")
+		}
+		if hasFile || hasKey || hasPass || hasSalt {
+			return errors.New("encryption: key source fields are mutually exclusive; env source only allows key-env")
+		}
+	case "file":
+		if !hasFile {
+			return errors.New("encryption: key file is required for file key source")
+		}
+		if hasEnv || hasKey || hasPass || hasSalt {
+			return errors.New("encryption: key source fields are mutually exclusive; file source only allows key-file")
+		}
+	case "literal":
+		if !hasKey {
+			return errors.New("encryption: key is required for literal key source")
+		}
+		if hasEnv || hasFile || hasPass || hasSalt {
+			return errors.New("encryption: key source fields are mutually exclusive; literal source only allows key")
+		}
+	case "derive":
+		if !hasPass {
+			return errors.New("encryption: passphrase is required for derive key source")
+		}
+		if !hasSalt {
+			return errors.New("encryption: salt is required for derive key source")
+		}
+		if hasEnv || hasFile || hasKey {
+			return errors.New("encryption: key source fields are mutually exclusive; derive source only allows passphrase and salt")
+		}
+	default:
+		return fmt.Errorf("encryption: unsupported key source %q", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if !cfg.Enabled {
+		cfg.Enabled = true
+	}
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption: environment variable %q for key is not set or empty", envName)
+		}
+		return decodeBase64Key(strings.TrimSpace(val))
+	case "file":
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("encryption: failed to read key file %q: %w", filePath, err)
+		}
+		return decodeBase64Key(strings.TrimSpace(string(data)))
+	case "literal":
+		return decodeBase64Key(strings.TrimSpace(cfg.Key))
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("encryption: passphrase cannot be empty for key derivation")
+		}
+		saltBytes, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("encryption: invalid base64 salt for key derivation: %w", err)
+		}
+		if len(saltBytes) < MinSaltSize {
+			return nil, fmt.Errorf("encryption: salt for key derivation must be at least %d bytes, got %d", MinSaltSize, len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, PBKDF2Iter, KeySize, sha256.New)
+		return key, nil
+	default:
+		return nil, fmt.Errorf("encryption: unsupported key source %q", cfg.KeySource)
+	}
+}
+
+func decodeBase64Key(encoded string) ([]byte, error) {
+	if encoded == "" {
+		return nil, fmt.Errorf("%w: empty encoded key", ErrInvalidKey)
+	}
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("encryption: invalid base64 key: %w", err)
+	}
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: decoded key has %d bytes", ErrInvalidKey, len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..5daef67
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,272 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func generateTestKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	_, err := NewEncryptor(nil)
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	_, err = NewEncryptor(make([]byte, 16))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	_, err = NewEncryptor(make([]byte, 31))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	_, err = NewEncryptor(make([]byte, 33))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	enc, err := NewEncryptor(make([]byte, 32))
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	sizes := []int{0, 1, 100, MaxChunkSize - 1, MaxChunkSize, MaxChunkSize + 1, MaxChunkSize * 3 + 500}
+	for _, size := range sizes {
+		plaintext := make([]byte, size)
+		_, err := io.ReadFull(rand.Reader, plaintext)
+		require.NoError(t, err)
+
+		var buf bytes.Buffer
+		ew := enc.EncryptWriter(&buf)
+		n, err := ew.Write(plaintext)
+		require.NoError(t, err)
+		assert.Equal(t, size, n)
+		require.NoError(t, ew.Close())
+		// Close is idempotent
+		require.NoError(t, ew.Close())
+
+		dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+		require.NoError(t, err)
+
+		decrypted, err := io.ReadAll(dr)
+		require.NoError(t, err)
+		assert.Equal(t, plaintext, decrypted)
+	}
+}
+
+func TestStreamFormatAndNonces(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Two encryptions of same plaintext must differ
+	plaintext := []byte("hello world secret dump")
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	// Check multi-chunk stream format and unique nonces
+	multiPlain := make([]byte, MaxChunkSize*2+10)
+	_, err = io.ReadFull(rand.Reader, multiPlain)
+	require.NoError(t, err)
+
+	var multiBuf bytes.Buffer
+	ewMulti := enc.EncryptWriter(&multiBuf)
+	_, err = ewMulti.Write(multiPlain)
+	require.NoError(t, err)
+	require.NoError(t, ewMulti.Close())
+
+	stream := multiBuf.Bytes()
+	// Header: 0x4F 0x44 0x01
+	require.True(t, len(stream) >= 3+4+32)
+	assert.Equal(t, []byte{0x4F, 0x44, 0x01}, stream[:3])
+
+	pos := 3
+	nonces := make(map[string]bool)
+	chunks := 0
+	for {
+		require.True(t, pos+4 <= len(stream))
+		chunkLen := binary.BigEndian.Uint32(stream[pos : pos+4])
+		pos += 4
+		if chunkLen == 0 {
+			break
+		}
+		chunks++
+		require.True(t, pos+int(chunkLen) <= len(stream))
+		nonce := string(stream[pos : pos+NonceSize])
+		assert.False(t, nonces[nonce], "duplicate nonce in chunk")
+		nonces[nonce] = true
+		pos += int(chunkLen)
+	}
+	assert.Equal(t, 3, chunks)
+	// Remaining 32 bytes is HMAC
+	assert.Equal(t, 32, len(stream)-pos)
+}
+
+func TestDecryptReaderErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Invalid key in DecryptReader
+	_, err = DecryptReader(bytes.NewReader(nil), make([]byte, 10))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// Lazy init: bad header doesn't fail until Read
+	badMagic := []byte{0x00, 0x00, 0x01, 0, 0, 0, 0}
+	dr, err := DecryptReader(bytes.NewReader(badMagic), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+
+	// Unsupported version
+	badVersion := []byte{0x4F, 0x44, 0x02, 0, 0, 0, 0}
+	dr, err = DecryptReader(bytes.NewReader(badVersion), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+
+	// Valid encrypted stream for tampering tests
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("important database dump content"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validStream := buf.Bytes()
+
+	// Wrong key must fail
+	wrongKey := generateTestKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validStream), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Tampered HMAC must fail with "integrity"
+	tamperedHMAC := make([]byte, len(validStream))
+	copy(tamperedHMAC, validStream)
+	tamperedHMAC[len(tamperedHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(tamperedHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+
+	// Truncated data must error
+	for cut := 1; cut < len(validStream); cut++ {
+		dr, err = DecryptReader(bytes.NewReader(validStream[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "expected error at cut=%d", cut)
+	}
+}
