+func TestConfigValidateAndLoadKey(t *testing.T) {
+	// Disabled config is always valid
+	cfg := Config{Enabled: false}
+	require.NoError(t, cfg.Validate())
+
+	// Enabled with empty or unsupported source
+	cfg = Config{Enabled: true, KeySource: ""}
+	require.Error(t, cfg.Validate())
+
+	cfg = Config{Enabled: true, KeySource: "vault"}
+	require.Error(t, cfg.Validate())
+
+	rawKey := generateTestKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// Literal source
+	cfg = Config{Enabled: true, KeySource: "LITERAL", Key: b64Key}
+	require.NoError(t, cfg.Validate())
+	loaded, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Literal with extra field -> mutually exclusive
+	cfgBad := Config{Enabled: true, KeySource: "literal", Key: b64Key, KeyEnvVar: "FOO"}
+	err = cfgBad.Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	// Env source
+	envVar := "TEST_ONEDUMP_ENC_KEY"
+	t.Setenv(envVar, b64Key)
+	cfg = Config{Enabled: true, KeySource: "Env", KeyEnvVar: envVar}
+	require.NoError(t, cfg.Validate())
+	loaded, err = LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Unset env var
+	cfgUnset := Config{Enabled: true, KeySource: "env", KeyEnvVar: "UNSET_ONEDUMP_ENC_KEY_XYZ"}
+	_, err = LoadKey(cfgUnset)
+	require.Error(t, err)
+
+	// File source
+	tmpFile := filepath.Join(t.TempDir(), "key.txt")
+	require.NoError(t, os.WriteFile(tmpFile, []byte("  "+b64Key+"\n"), 0600))
+	cfg = Config{Enabled: true, KeySource: "file", KeyFile: tmpFile}
+	require.NoError(t, cfg.Validate())
+	loaded, err = LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Derive source
+	salt := make([]byte, 16)
+	_, err = io.ReadFull(rand.Reader, salt)
+	require.NoError(t, err)
+	b64Salt := base64.StdEncoding.EncodeToString(salt)
+
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "my-secret-passphrase", Salt: b64Salt}
+	require.NoError(t, cfg.Validate())
+	derived1, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Len(t, derived1, 32)
+	derived2, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, derived1, derived2)
+
+	// Short salt rejected
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	cfgShortSalt := Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: shortSalt}
+	_, err = LoadKey(cfgShortSalt)
+	require.Error(t, err)
+
+	// Empty passphrase rejected
+	cfgEmptyPass := Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt}
+	require.Error(t, cfgEmptyPass.Validate())
+	_, err = LoadKey(cfgEmptyPass)
+	require.Error(t, err)
+}
