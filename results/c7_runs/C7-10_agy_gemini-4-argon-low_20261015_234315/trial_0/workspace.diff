+func TestEncryptedPipelineRoundTripAndFailFast(t *testing.T) {
+	// Missing key env var fails fast with "encryption" or "key" even without storages
+	job := config.NewJob("enc-job", "mysqldump", testDBDsn)
+	job.Encryption.Enabled = true
+	job.Encryption.KeySource = "env"
+	job.Encryption.KeyEnvVar = "MISSING_ENC_KEY_ENV_VAR_999"
+
+	res := NewJobHandler(job).Do()
+	assert.NotNil(t, res.Error)
+	assert.Contains(t, res.Error.Error(), "encryption")
+
+	// Round-trip test through storageReadWriteCloser -> DecryptReader -> gzip.NewReader
+	key := make([]byte, 32)
+	for i := range key {
+		key[i] = byte(i + 1)
+	}
+	enc, err := encryption.NewEncryptor(key)
+	assert.NoError(t, err)
+
+	readers, writer, closer := storageReadWriteCloser(1, true, enc)
+	original := "SELECT * FROM users; -- full pipeline round trip test"
+
+	done := make(chan []byte, 1)
+	go func() {
+		dr, err := encryption.DecryptReader(readers[0], key)
+		assert.NoError(t, err)
+		gr, err := gzip.NewReader(dr)
+		assert.NoError(t, err)
+		defer gr.Close()
+		out, err := io.ReadAll(gr)
+		assert.NoError(t, err)
+		done <- out
+	}()
+
+	_, err = writer.Write([]byte(original))
+	assert.NoError(t, err)
+	assert.NoError(t, closer.Close())
+
+	decrypted := <-done
+	assert.Equal(t, original, string(decrypted))
+}
