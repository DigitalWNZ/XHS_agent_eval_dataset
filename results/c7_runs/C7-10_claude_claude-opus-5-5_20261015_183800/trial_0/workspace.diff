diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..8cc9cbb
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,173 @@
+package encryption
+
+import (
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+
+	"golang.org/x/crypto/argon2"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize = 16
+)
+
+// Argon2id parameters used to derive a key from a passphrase.
+const (
+	argonTime    = 3
+	argonMemory  = 64 * 1024
+	argonThreads = 4
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`  // env, file, literal or derive
+	KeyEnvVar  string `yaml:"keyenvvar"`  // env: name of the env var holding a base64 encoded key
+	KeyFile    string `yaml:"keyfile"`    // file: path of the file holding a base64 encoded key
+	Key        string `yaml:"key"`        // literal: base64 encoded key
+	Passphrase string `yaml:"passphrase"` // derive: passphrase
+	Salt       string `yaml:"salt"`       // derive: base64 encoded salt, at least 16 bytes
+}
+
+func (cfg Config) source() string {
+	return strings.ToLower(strings.TrimSpace(cfg.KeySource))
+}
+
+// Validate checks the config is consistent. Disabled configs are always valid.
+func (cfg Config) Validate() error {
+	if !cfg.Enabled {
+		return nil
+	}
+
+	source := cfg.source()
+
+	type field struct {
+		name  string
+		value string
+	}
+
+	keyEnvVar := field{"keyenvvar", cfg.KeyEnvVar}
+	keyFile := field{"keyfile", cfg.KeyFile}
+	key := field{"key", cfg.Key}
+	passphrase := field{"passphrase", cfg.Passphrase}
+	salt := field{"salt", cfg.Salt}
+
+	var required []field
+	switch source {
+	case "":
+		return errors.New("encryption key source is required when encryption is enabled")
+	case KeySourceEnv:
+		required = []field{keyEnvVar}
+	case KeySourceFile:
+		required = []field{keyFile}
+	case KeySourceLiteral:
+		required = []field{key}
+	case KeySourceDerive:
+		required = []field{passphrase, salt}
+	default:
+		return fmt.Errorf("unsupported encryption key source %q, supported sources: env, file, literal, derive", cfg.KeySource)
+	}
+
+	for _, f := range required {
+		if strings.TrimSpace(f.value) == "" {
+			return fmt.Errorf("encryption %s is required for key source %q", f.name, source)
+		}
+	}
+
+	var requiredNames, conflicts []string
+	for _, f := range required {
+		requiredNames = append(requiredNames, f.name)
+	}
+
+	for _, f := range []field{keyEnvVar, keyFile, key, passphrase, salt} {
+		if !slices.Contains(requiredNames, f.name) && strings.TrimSpace(f.value) != "" {
+			conflicts = append(conflicts, f.name)
+		}
+	}
+
+	if len(conflicts) > 0 {
+		return fmt.Errorf("encryption %s and %s are mutually exclusive (key source %q)", strings.Join(requiredNames, ", "), strings.Join(conflicts, ", "), source)
+	}
+
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+
+	for _, enc := range []*base64.Encoding{base64.StdEncoding, base64.RawStdEncoding, base64.URLEncoding, base64.RawURLEncoding} {
+		if b, err := enc.DecodeString(s); err == nil {
+			return b, nil
+		}
+	}
+
+	return nil, errors.New("value is not valid base64")
+}
+
+func decodeKey(s string) ([]byte, error) {
+	key, err := decodeBase64(s)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	return key, nil
+}
+
+// LoadKey loads the 32-byte encryption key described by cfg.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+
+	if !cfg.Enabled {
+		return nil, errors.New("encryption is not enabled")
+	}
+
+	switch cfg.source() {
+	case KeySourceEnv:
+		value, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || strings.TrimSpace(value) == "" {
+			return nil, fmt.Errorf("encryption key env var %q is not set", cfg.KeyEnvVar)
+		}
+
+		return decodeKey(value)
+	case KeySourceFile:
+		content, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("could not read encryption key file: %w", err)
+		}
+
+		return decodeKey(string(content))
+	case KeySourceLiteral:
+		return decodeKey(cfg.Key)
+	case KeySourceDerive:
+		if cfg.Passphrase == "" {
+			return nil, errors.New("encryption passphrase must not be empty")
+		}
+
+		salt, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("invalid encryption salt: %v", err)
+		}
+
+		if len(salt) < MinSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", MinSaltSize, len(salt))
+		}
+
+		return argon2.IDKey([]byte(cfg.Passphrase), salt, argonTime, argonMemory, argonThreads, KeySize), nil
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source %q", cfg.KeySource)
+	}
+}
diff --git a/encryption/config_test.go b/encryption/config_test.go
new file mode 100644
index 0000000..f06748e
--- /dev/null
+++ b/encryption/config_test.go
@@ -0,0 +1,100 @@
+package encryption
+
+import (
+	"encoding/base64"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestConfigValidate(t *testing.T) {
+	salt := base64.StdEncoding.EncodeToString(make([]byte, 16))
+
+	valid := []Config{
+		{},
+		{Enabled: false, KeySource: "nonsense", Key: "x", KeyFile: "y"},
+		{Enabled: true, KeySource: "env", KeyEnvVar: "KEY"},
+		{Enabled: true, KeySource: "ENV", KeyEnvVar: "KEY"},
+		{Enabled: true, KeySource: "file", KeyFile: "/tmp/key"},
+		{Enabled: true, KeySource: "Literal", Key: "abc"},
+		{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: salt},
+	}
+	for _, cfg := range valid {
+		assert.NoError(t, cfg.Validate(), "%+v", cfg)
+	}
+
+	invalid := []Config{
+		{Enabled: true},
+		{Enabled: true, KeySource: "vault"},
+		{Enabled: true, KeySource: "env"},
+		{Enabled: true, KeySource: "file"},
+		{Enabled: true, KeySource: "literal"},
+		{Enabled: true, KeySource: "derive", Passphrase: "secret"},
+		{Enabled: true, KeySource: "derive", Salt: salt},
+	}
+	for _, cfg := range invalid {
+		assert.Error(t, cfg.Validate(), "%+v", cfg)
+	}
+
+	exclusive := []Config{
+		{Enabled: true, KeySource: "env", KeyEnvVar: "KEY", KeyFile: "f"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", Key: "k"},
+		{Enabled: true, KeySource: "literal", Key: "k", Passphrase: "p"},
+		{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: salt, KeyEnvVar: "KEY"},
+	}
+	for _, cfg := range exclusive {
+		assert.ErrorContains(t, cfg.Validate(), "mutually exclusive", "%+v", cfg)
+	}
+}
+
+func TestLoadKey(t *testing.T) {
+	raw := make([]byte, KeySize)
+	for i := range raw {
+		raw[i] = byte(i)
+	}
+	encoded := base64.StdEncoding.EncodeToString(raw)
+
+	t.Setenv("ONEDUMP_TEST_KEY", encoded)
+	key, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, raw, key)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY_UNSET"})
+	assert.Error(t, err)
+
+	file := filepath.Join(t.TempDir(), "key")
+	require.NoError(t, os.WriteFile(file, []byte("  "+encoded+"\n"), 0600))
+	key, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file})
+	require.NoError(t, err)
+	assert.Equal(t, raw, key)
+
+	key, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: encoded})
+	require.NoError(t, err)
+	assert.Equal(t, raw, key)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString(raw[:16])})
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	salt := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+	cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: salt}
+	k1, err := LoadKey(cfg)
+	require.NoError(t, err)
+	k2, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Len(t, k1, KeySize)
+	assert.Equal(t, k1, k2)
+
+	cfg.Passphrase = "other"
+	k3, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.NotEqual(t, k1, k3)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: base64.StdEncoding.EncodeToString([]byte("short"))})
+	assert.Error(t, err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: salt})
+	assert.Error(t, err)
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..7ecb92b
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,332 @@
+// Package encryption provides AES-256-GCM streaming encryption for dump files.
+//
+// Stream format:
+//
+//	header:   0x4F 0x44 (magic) | 0x01 (version)
+//	chunks:   [4-byte big-endian length][12-byte nonce][ciphertext + 16-byte tag] ...
+//	sentinel: 0x00 0x00 0x00 0x00
+//	trailer:  32-byte HMAC-SHA256 over every byte between the header and the sentinel
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize         = 32
+	ChunkSize       = 64 * 1024
+	NonceSize       = 12
+	TagSize         = 16
+	HeaderSize      = 3
+	LengthSize      = 4
+	MACSize         = sha256.Size
+	Version    byte = 0x01
+
+	maxChunkLen = NonceSize + ChunkSize + TagSize
+	minChunkLen = NonceSize + TagSize
+)
+
+var (
+	Magic = []byte{0x4F, 0x44}
+
+	ErrInvalidKey = errors.New("invalid encryption key")
+)
+
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates an encryptor with a 32-byte AES-256 key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &Encryptor{key: k}, nil
+}
+
+func newGCM(key []byte) (cipher.AEAD, error) {
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+
+	return cipher.NewGCM(block)
+}
+
+// EncryptWriter returns a writer that encrypts everything written to it and writes the encrypted stream to w.
+// Close must be called to flush the final chunk and write the trailer; it does not close w.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		key: e.key,
+		w:   w,
+		buf: make([]byte, 0, ChunkSize),
+		mac: hmac.New(sha256.New, e.key),
+	}
+}
+
+type encryptWriter struct {
+	key           []byte
+	w             io.Writer
+	aead          cipher.AEAD
+	buf           []byte
+	mac           hash.Hash
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) init() error {
+	if ew.headerWritten {
+		return nil
+	}
+
+	aead, err := newGCM(ew.key)
+	if err != nil {
+		return err
+	}
+	ew.aead = aead
+
+	header := append(append([]byte{}, Magic...), Version)
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("encryption: write to closed writer")
+	}
+
+	if ew.err != nil {
+		return 0, ew.err
+	}
+
+	if err := ew.init(); err != nil {
+		ew.err = err
+		return 0, err
+	}
+
+	written := 0
+	for len(p) > 0 {
+		n := min(ChunkSize-len(ew.buf), len(p))
+		ew.buf = append(ew.buf, p[:n]...)
+		p = p[n:]
+		written += n
+
+		if len(ew.buf) == ChunkSize {
+			if err := ew.flushChunk(); err != nil {
+				ew.err = err
+				return written, err
+			}
+		}
+	}
+
+	return written, nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	out := make([]byte, LengthSize+NonceSize, LengthSize+NonceSize+len(ew.buf)+TagSize)
+	nonce := out[LengthSize : LengthSize+NonceSize]
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("encryption: could not generate nonce: %w", err)
+	}
+
+	out = ew.aead.Seal(out, nonce, ew.buf, nil)
+	binary.BigEndian.PutUint32(out[:LengthSize], uint32(len(out)-LengthSize))
+
+	ew.mac.Write(out)
+	if _, err := ew.w.Write(out); err != nil {
+		return err
+	}
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+// Close flushes the remaining data, then writes the sentinel and the HMAC. It is idempotent.
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return ew.err
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.init(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	if err := ew.flushChunk(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	trailer := make([]byte, LengthSize, LengthSize+MACSize)
+	trailer = ew.mac.Sum(trailer)
+
+	if _, err := ew.w.Write(trailer); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+// DecryptReader returns a reader that decrypts a stream produced by EncryptWriter.
+// The header is read lazily, so stream errors are returned from Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &decryptReader{
+		r:   r,
+		key: k,
+		mac: hmac.New(sha256.New, k),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	aead        cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	plain       []byte
+	done        bool
+	err         error
+}
+
+func (dr *decryptReader) init() error {
+	header := make([]byte, HeaderSize)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		return fmt.Errorf("encryption: invalid header: %w", truncated(err))
+	}
+
+	if header[0] != Magic[0] || header[1] != Magic[1] {
+		return errors.New("encryption: invalid header: bad magic bytes")
+	}
+
+	if header[2] != Version {
+		return fmt.Errorf("encryption: unsupported version %d", header[2])
+	}
+
+	aead, err := newGCM(dr.key)
+	if err != nil {
+		return err
+	}
+
+	dr.aead = aead
+	dr.initialized = true
+	return nil
+}
+
+func truncated(err error) error {
+	if errors.Is(err, io.EOF) {
+		return io.ErrUnexpectedEOF
+	}
+	return err
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	for len(dr.plain) == 0 {
+		if dr.err != nil {
+			return 0, dr.err
+		}
+
+		if dr.done {
+			return 0, io.EOF
+		}
+
+		if err := dr.next(); err != nil {
+			dr.err = err
+		}
+	}
+
+	n := copy(p, dr.plain)
+	dr.plain = dr.plain[n:]
+	return n, nil
+}
+
+// next reads and decrypts the next chunk, or verifies the trailer when the sentinel is reached.
+func (dr *decryptReader) next() error {
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			return err
+		}
+	}
+
+	lenBuf := make([]byte, LengthSize)
+	if _, err := io.ReadFull(dr.r, lenBuf); err != nil {
+		return fmt.Errorf("encryption: truncated stream: %w", truncated(err))
+	}
+
+	length := binary.BigEndian.Uint32(lenBuf)
+	if length == 0 {
+		return dr.verify()
+	}
+
+	if length < minChunkLen || length > maxChunkLen {
+		return fmt.Errorf("encryption: invalid chunk length %d", length)
+	}
+
+	chunk := make([]byte, length)
+	if _, err := io.ReadFull(dr.r, chunk); err != nil {
+		return fmt.Errorf("encryption: truncated stream: %w", truncated(err))
+	}
+
+	dr.mac.Write(lenBuf)
+	dr.mac.Write(chunk)
+
+	plain, err := dr.aead.Open(chunk[NonceSize:NonceSize], chunk[:NonceSize], chunk[NonceSize:], nil)
+	if err != nil {
+		return errors.New("encryption: chunk integrity check failed (wrong key or corrupted data)")
+	}
+
+	dr.plain = plain
+	return nil
+}
+
+func (dr *decryptReader) verify() error {
+	expected := make([]byte, MACSize)
+	if _, err := io.ReadFull(dr.r, expected); err != nil {
+		return fmt.Errorf("encryption: truncated stream, missing integrity trailer: %w", truncated(err))
+	}
+
+	if !hmac.Equal(expected, dr.mac.Sum(nil)) {
+		return errors.New("encryption: integrity check failed (HMAC mismatch)")
+	}
+
+	dr.done = true
+	return nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..2870e6a
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,131 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/binary"
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func testKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, KeySize)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+	return key
+}
+
+func encrypt(t *testing.T, key, plain []byte) []byte {
+	t.Helper()
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write(plain)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	require.NoError(t, w.Close())
+	return buf.Bytes()
+}
+
+func decrypt(key, data []byte) ([]byte, error) {
+	r, err := DecryptReader(bytes.NewReader(data), key)
+	if err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+func TestNewEncryptorInvalidKey(t *testing.T) {
+	for _, size := range []int{0, 16, 31, 33, 64} {
+		_, err := NewEncryptor(make([]byte, size))
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+}
+
+func TestRoundTrip(t *testing.T) {
+	key := testKey(t)
+
+	for _, size := range []int{0, 1, ChunkSize - 1, ChunkSize, ChunkSize + 1, 3*ChunkSize + 123} {
+		plain := make([]byte, size)
+		_, _ = rand.Read(plain)
+
+		data := encrypt(t, key, plain)
+		assert.Equal(t, []byte{0x4F, 0x44, 0x01}, data[:3])
+
+		got, err := decrypt(key, data)
+		require.NoError(t, err, "size %d", size)
+		assert.Equal(t, plain, got)
+	}
+}
+
+func TestEncryptionIsRandomizedAndNoncesUnique(t *testing.T) {
+	key := testKey(t)
+	plain := bytes.Repeat([]byte("a"), 4*ChunkSize)
+
+	a := encrypt(t, key, plain)
+	b := encrypt(t, key, plain)
+	assert.NotEqual(t, a, b)
+
+	nonces := map[string]bool{}
+	for _, data := range [][]byte{a, b} {
+		offset := HeaderSize
+		for {
+			length := binary.BigEndian.Uint32(data[offset:])
+			offset += LengthSize
+			if length == 0 {
+				break
+			}
+			assert.LessOrEqual(t, int(length), NonceSize+ChunkSize+TagSize)
+			nonce := string(data[offset : offset+NonceSize])
+			assert.False(t, nonces[nonce])
+			nonces[nonce] = true
+			offset += int(length)
+		}
+		assert.Equal(t, len(data), offset+MACSize)
+	}
+	assert.Len(t, nonces, 8)
+}
+
+func TestDecryptErrors(t *testing.T) {
+	key := testKey(t)
+	data := encrypt(t, key, []byte("hello world"))
+
+	_, err := decrypt(testKey(t), data)
+	assert.Error(t, err)
+
+	bad := append([]byte{}, data...)
+	bad[0] = 'X'
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "invalid header")
+
+	bad = append([]byte{}, data...)
+	bad[2] = 0x02
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "unsupported version")
+
+	bad = append([]byte{}, data...)
+	bad[len(bad)-1] ^= 0xFF
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "integrity")
+
+	for i := 0; i < len(data); i++ {
+		_, err = decrypt(key, data[:i])
+		assert.Error(t, err, "truncated at %d", i)
+	}
+
+	_, err = DecryptReader(bytes.NewReader(data), key[:16])
+	assert.ErrorIs(t, err, ErrInvalidKey)
+}
+
+func TestDecryptReaderIsLazy(t *testing.T) {
+	r, err := DecryptReader(bytes.NewReader([]byte("garbage")), testKey(t))
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	assert.ErrorContains(t, err, "invalid header")
+}
