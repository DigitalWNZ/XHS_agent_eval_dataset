+func TestShapeIndexEncodeDecodeAllShapeTypes(t *testing.T) {
+	index := allShapeTypesIndex()
+	index.Build()
+	got := decodeShapeIndexOrDie(t, encodeShapeIndexOrDie(t, index))
+	checkShapeIndexEqual(t, index, got)
+
+	// Queries work on the decoded index.
+	q := NewContainsPointQuery(got, VertexModelSemiOpen)
+	if !q.Contains(PointFromLatLng(LatLngFromDegrees(1, 1))) {
+		t.Errorf("decoded index should contain 1:1")
+	}
+	if q.Contains(PointFromLatLng(LatLngFromDegrees(5, 5))) {
+		t.Errorf("decoded index should not contain 5:5 (inside a hole)")
+	}
+	if !q.Contains(PointFromLatLng(LatLngFromDegrees(52, 55))) {
+		t.Errorf("decoded index should contain 52:55")
+	}
+
+	// Re-encoding the decoded index produces identical bytes.
+	if a, b := encodeShapeIndexOrDie(t, index), encodeShapeIndexOrDie(t, got); !bytes.Equal(a, b) {
+		t.Errorf("re-encoding the decoded index produced different bytes")
+	}
+}
