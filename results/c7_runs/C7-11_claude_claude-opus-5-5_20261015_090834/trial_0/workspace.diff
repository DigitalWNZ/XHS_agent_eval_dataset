+package s2
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+func encodeShapeIndexOrDie(t *testing.T, index *ShapeIndex) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func decodeShapeIndexOrDie(t *testing.T, data []byte) *ShapeIndex {
+	t.Helper()
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	return got
+}
+
+// checkShapeIndexEqual verifies that the shapes and cells of both indexes match.
+func checkShapeIndexEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded index is not fresh")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	for id, ws := range want.shapes {
+		gs := got.Shape(id)
+		if gs == nil {
+			t.Fatalf("shape %d missing from decoded index", id)
+		}
+		if reflect.TypeOf(gs) != reflect.TypeOf(ws) {
+			t.Errorf("shape %d type = %T, want %T", id, gs, ws)
+		}
+		if gs.Dimension() != ws.Dimension() || gs.NumEdges() != ws.NumEdges() || gs.NumChains() != ws.NumChains() {
+			t.Fatalf("shape %d: dimension/edges/chains mismatch", id)
+		}
+		for e := 0; e < ws.NumEdges(); e++ {
+			if gs.Edge(e) != ws.Edge(e) {
+				t.Errorf("shape %d edge %d = %v, want %v", id, e, gs.Edge(e), ws.Edge(e))
+			}
+		}
+		for c := 0; c < ws.NumChains(); c++ {
+			if gs.Chain(c) != ws.Chain(c) {
+				t.Errorf("shape %d chain %d = %v, want %v", id, c, gs.Chain(c), ws.Chain(c))
+			}
+		}
+		if gs.ReferencePoint() != ws.ReferencePoint() {
+			t.Errorf("shape %d ReferencePoint = %v, want %v", id, gs.ReferencePoint(), ws.ReferencePoint())
+		}
+	}
+
+	// Compare the cell structure without triggering any rebuild of got.
+	if !reflect.DeepEqual(got.cells, want.cells) && !(len(got.cells) == 0 && len(want.cells) == 0) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	for _, id := range want.cells {
+		gc := got.cellMap[id]
+		// Clipped shapes of removed shapes are not encoded.
+		var wshapes []*clippedShape
+		for _, cs := range want.cellMap[id].shapes {
+			if want.Shape(cs.shapeID) != nil {
+				wshapes = append(wshapes, cs)
+			}
+		}
+		if gc == nil || len(gc.shapes) != len(wshapes) {
+			t.Fatalf("cell %v mismatch", id)
+		}
+		for i := range wshapes {
+			w, g := wshapes[i], gc.shapes[i]
+			if w.shapeID != g.shapeID || w.containsCenter != g.containsCenter ||
+				!reflect.DeepEqual(append([]int{}, w.edges...), append([]int{}, g.edges...)) {
+				t.Errorf("cell %v clipped shape %d = %+v, want %+v", id, i, g, w)
+			}
+		}
+	}
+}
+
+func allShapeTypesIndex() *ShapeIndex {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2", true))
+	index.Add(makePolyline("20:20, 21:21, 22:20"))
+	pv := PointVector(parsePoints("30:30 | 31:31 | -5:-5"))
+	index.Add(&pv)
+	index.Add(makeLaxPolyline("40:40, 41:42, 43:40"))
+	index.Add(makeLaxPolygon("-10:-10, -10:-20, -20:-20; -12:-12, -14:-14, -12:-14; full"))
+	index.Add(makeLoop("50:50, 50:60, 60:60"))
+	index.Add(LaxLoopFromPoints(parsePoints("-30:-30, -30:-40, -40:-40")))
+	return index
+}
