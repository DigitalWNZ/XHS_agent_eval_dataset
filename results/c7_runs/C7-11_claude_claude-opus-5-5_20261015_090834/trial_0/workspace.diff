+package s2
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"sort"
+	"sync/atomic"
+)
+
+// shapeIndexEncodingVersion is the version of the ShapeIndex encoding format.
+const shapeIndexEncodingVersion = uint8(1)
+
+// Tags identifying the concrete type of each Shape in an encoded ShapeIndex.
+// These are local to the ShapeIndex encoding format.
+const (
+	shapeIndexTagPolygon     = uint8(1)
+	shapeIndexTagPolyline    = uint8(2)
+	shapeIndexTagPointVector = uint8(3)
+	shapeIndexTagLaxPolyline = uint8(4)
+	shapeIndexTagLaxPolygon  = uint8(5)
+	shapeIndexTagLoop        = uint8(6)
+	shapeIndexTagLaxLoop     = uint8(7)
+)
+
+// decodeChunkSize bounds the up-front allocations made while decoding, so
+// that a corrupt length prefix cannot force a huge allocation before the
+// data backing it has actually been read.
+const decodeChunkSize = 1024
+
+// Limits that guard allocations during decoding.
+const (
+	maxEncodedShapes      = math.MaxInt32
+	maxEncodedCells       = 1 << 40
+	maxEncodedCellShapes  = math.MaxInt32
+	maxEncodedClipEdges   = math.MaxInt32
+	maxEncodedLaxLoops    = maxEncodedLoops
+	maxEncodedPointsTotal = maxEncodedVertices
+)
+
+// Encode encodes the ShapeIndex, including all of its shapes (with their IDs)
+// and its full cell structure, so that the decoded index can be queried and
+// iterated without being rebuilt. Any pending updates are applied first.
+//
+// All the built-in Shape types (Polygon, Polyline, Loop, PointVector,
+// LaxPolygon, LaxPolyline and LaxLoop) are supported.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeUint8(shapeIndexEncodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	ids := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		e.writeUvarint(uint64(id))
+		encodeIndexedShape(e, s.shapes[id])
+		if e.err != nil {
+			return
+		}
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, id := range s.cells {
+		cell := s.cellMap[id]
+		if cell == nil {
+			e.err = fmt.Errorf("s2: ShapeIndex has no cell data for %v", id)
+			return
+		}
+		// Shape removal does not yet clear removed shapes from the cells, so
+		// skip any clipped shapes that refer to shapes no longer in the index.
+		numShapes := 0
+		for _, cs := range cell.shapes {
+			if _, ok := s.shapes[cs.shapeID]; ok {
+				numShapes++
+			}
+		}
+		e.writeUint64(uint64(id))
+		e.writeUvarint(uint64(numShapes))
+		for _, cs := range cell.shapes {
+			if _, ok := s.shapes[cs.shapeID]; !ok {
+				continue
+			}
+			e.writeUvarint(uint64(cs.shapeID))
+			e.writeBool(cs.containsCenter)
+			e.writeUvarint(uint64(len(cs.edges)))
+			prev := 0
+			for _, edge := range cs.edges {
+				e.writeUvarint(uint64(zigzagEncode64(int64(edge - prev))))
+				prev = edge
+			}
+		}
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// Decode decodes a ShapeIndex previously written by Encode, replacing the
+// current contents of s. The decoded index is ready to be queried without
+// being rebuilt.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	t, err := decodeShapeIndex(d)
+	if err != nil {
+		return err
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.shapes = t.shapes
+	s.maxEdgesPerCell = t.maxEdgesPerCell
+	s.nextID = t.nextID
+	s.cellMap = t.cellMap
+	s.cells = t.cells
+	s.pendingAdditionsPos = int32(len(t.shapes))
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	return nil
+}
+
+// decodedShapeIndex holds the decoded state of a ShapeIndex before it is
+// installed into the destination index.
+type decodedShapeIndex struct {
+	shapes          map[int32]Shape
+	maxEdgesPerCell int
+	nextID          int32
+	cellMap         map[CellID]*ShapeIndexCell
+	cells           []CellID
+}
+
+func decodeShapeIndex(d *decoder) (*decodedShapeIndex, error) {
+	version := d.readUint8()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if version != shapeIndexEncodingVersion {
+		return nil, fmt.Errorf("s2: unsupported ShapeIndex encoding version %d", version)
+	}
+
+	maxEdges := d.readUvarint()
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if maxEdges > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdges)
+	}
+	if nextID > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid next shape ID %d", nextID)
+	}
+
+	t := &decodedShapeIndex{
+		shapes:          make(map[int32]Shape),
+		maxEdgesPerCell: int(maxEdges),
+		nextID:          int32(nextID),
+		cellMap:         make(map[CellID]*ShapeIndexCell),
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if numShapes > nextID || numShapes > maxEncodedShapes {
+		return nil, fmt.Errorf("s2: invalid number of shapes %d", numShapes)
+	}
+	prevID := int64(-1)
+	for i := uint64(0); i < numShapes; i++ {
+		id := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		if id >= nextID || int64(id) <= prevID {
+			return nil, fmt.Errorf("s2: invalid shape ID %d", id)
+		}
+		prevID = int64(id)
+		shape := decodeIndexedShape(d)
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		t.shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if numCells > maxEncodedCells {
+		return nil, fmt.Errorf("s2: too many cells (%d)", numCells)
+	}
+	t.cells = make([]CellID, 0, min(numCells, decodeChunkSize))
+	for i := uint64(0); i < numCells; i++ {
+		id := CellID(d.readUint64())
+		numCellShapes := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		if !id.IsValid() {
+			return nil, fmt.Errorf("s2: invalid cell ID %d", uint64(id))
+		}
+		if n := len(t.cells); n > 0 && id.RangeMin() <= t.cells[n-1].RangeMax() {
+			return nil, fmt.Errorf("s2: cell %v is out of order or overlaps the previous cell", id)
+		}
+		if numCellShapes > maxEncodedCellShapes || numCellShapes > numShapes {
+			return nil, fmt.Errorf("s2: too many shapes (%d) in cell %v", numCellShapes, id)
+		}
+
+		cell := &ShapeIndexCell{shapes: make([]*clippedShape, 0, min(numCellShapes, decodeChunkSize))}
+		prevShapeID := int64(-1)
+		for j := uint64(0); j < numCellShapes; j++ {
+			cs, err := decodeClippedShape(d, t.shapes)
+			if err != nil {
+				return nil, err
+			}
+			if int64(cs.shapeID) <= prevShapeID {
+				return nil, fmt.Errorf("s2: shapes in cell %v are out of order", id)
+			}
+			prevShapeID = int64(cs.shapeID)
+			cell.shapes = append(cell.shapes, cs)
+		}
+		t.cells = append(t.cells, id)
+		t.cellMap[id] = cell
+	}
+	return t, nil
+}
+
+func decodeClippedShape(d *decoder, shapes map[int32]Shape) (*clippedShape, error) {
+	shapeID := d.readUvarint()
+	containsCenter := d.readBool()
+	numEdges := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if shapeID > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid clipped shape ID %d", shapeID)
+	}
+	shape, ok := shapes[int32(shapeID)]
+	if !ok {
+		return nil, fmt.Errorf("s2: cell references unknown shape ID %d", shapeID)
+	}
+	shapeEdges := shape.NumEdges()
+	if numEdges > maxEncodedClipEdges || numEdges > uint64(shapeEdges) {
+		return nil, fmt.Errorf("s2: too many edges (%d) for shape %d", numEdges, shapeID)
+	}
+
+	cs := &clippedShape{
+		shapeID:        int32(shapeID),
+		containsCenter: containsCenter,
+		edges:          make([]int, 0, min(numEdges, decodeChunkSize)),
+	}
+	prev := int64(0)
+	for k := uint64(0); k < numEdges; k++ {
+		delta := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		edge := prev + zigzagDecode64(delta)
+		if edge < 0 || edge >= int64(shapeEdges) {
+			return nil, fmt.Errorf("s2: invalid edge ID %d for shape %d", edge, shapeID)
+		}
+		cs.edges = append(cs.edges, int(edge))
+		prev = edge
+	}
+	return cs, nil
+}
+
+// decodeErr converts the error returned by the underlying reader into one
+// that is suitable for returning from Decode.
+func decodeErr(err error) error {
+	if errors.Is(err, io.EOF) {
+		return io.ErrUnexpectedEOF
+	}
+	return err
+}
+
+func zigzagEncode64(x int64) uint64 {
+	return uint64(x<<1) ^ uint64(x>>63)
+}
+
+func zigzagDecode64(x uint64) int64 {
+	return int64(x>>1) ^ -int64(x&1)
+}
+
+// encodeIndexedShape writes a type tag followed by the given shape's data.
+func encodeIndexedShape(e *encoder, shape Shape) {
+	switch sh := shape.(type) {
+	case *Polygon:
+		e.writeUint8(shapeIndexTagPolygon)
+		e.writeBool(sh.hasHoles)
+		e.writeUvarint(uint64(len(sh.loops)))
+		for _, l := range sh.loops {
+			encodeIndexedLoop(e, l)
+		}
+		sh.bound.encode(e)
+	case *Polyline:
+		e.writeUint8(shapeIndexTagPolyline)
+		encodePointList(e, *sh)
+	case *PointVector:
+		e.writeUint8(shapeIndexTagPointVector)
+		encodePointList(e, *sh)
+	case *LaxPolyline:
+		e.writeUint8(shapeIndexTagLaxPolyline)
+		encodePointList(e, sh.vertices)
+	case *LaxPolygon:
+		e.writeUint8(shapeIndexTagLaxPolygon)
+		e.writeUvarint(uint64(sh.numLoops))
+		for i := 0; i < sh.numLoops; i++ {
+			c := sh.Chain(i)
+			encodePointList(e, sh.vertices[c.Start:c.Start+c.Length])
+		}
+	case *Loop:
+		e.writeUint8(shapeIndexTagLoop)
+		encodeIndexedLoop(e, sh)
+	case *LaxLoop:
+		e.writeUint8(shapeIndexTagLaxLoop)
+		encodePointList(e, sh.vertices[:sh.numVertices])
+	default:
+		if e.err == nil {
+			e.err = fmt.Errorf("s2: cannot encode shape of type %T", shape)
+		}
+	}
+}
+
+// decodeIndexedShape reads a shape written by encodeIndexedShape.
+func decodeIndexedShape(d *decoder) Shape {
+	tag := d.readUint8()
+	if d.err != nil {
+		return nil
+	}
+	switch tag {
+	case shapeIndexTagPolygon:
+		return decodeIndexedPolygon(d)
+	case shapeIndexTagPolyline:
+		p := Polyline(decodePointList(d))
+		return &p
+	case shapeIndexTagPointVector:
+		p := PointVector(decodePointList(d))
+		return &p
+	case shapeIndexTagLaxPolyline:
+		return &LaxPolyline{vertices: decodePointList(d)}
+	case shapeIndexTagLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numLoops > maxEncodedLaxLoops {
+			d.err = fmt.Errorf("s2: too many loops (%d; max is %d)", numLoops, maxEncodedLaxLoops)
+			return nil
+		}
+		loops := make([][]Point, 0, min(numLoops, decodeChunkSize))
+		total := 0
+		for i := uint64(0); i < numLoops; i++ {
+			pts := decodePointList(d)
+			if d.err != nil {
+				return nil
+			}
+			total += len(pts)
+			if total > maxEncodedPointsTotal {
+				d.err = fmt.Errorf("s2: too many vertices (%d; max is %d)", total, maxEncodedPointsTotal)
+				return nil
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops)
+	case shapeIndexTagLoop:
+		return decodeIndexedLoop(d)
+	case shapeIndexTagLaxLoop:
+		pts := decodePointList(d)
+		return &LaxLoop{numVertices: len(pts), vertices: pts}
+	default:
+		d.err = fmt.Errorf("s2: unknown shape type tag %d", tag)
+		return nil
+	}
+}
+
+func encodeIndexedLoop(e *encoder, l *Loop) {
+	encodePointList(e, l.vertices)
+	e.writeBool(l.originInside)
+	e.writeUvarint(zigzagEncode64(int64(l.depth)))
+	l.bound.encode(e)
+}
+
+func decodeIndexedLoop(d *decoder) *Loop {
+	l := &Loop{}
+	l.vertices = decodePointList(d)
+	l.originInside = d.readBool()
+	depth := zigzagDecode64(d.readUvarint())
+	l.bound.decode(d)
+	if d.err != nil {
+		return nil
+	}
+	if depth < math.MinInt32 || depth > math.MaxInt32 {
+		d.err = fmt.Errorf("s2: invalid loop depth %d", depth)
+		return nil
+	}
+	l.depth = int(depth)
+	l.subregionBound = ExpandForSubregions(l.bound)
+	l.index = NewShapeIndex()
+	l.index.Add(l)
+	return l
+}
+
+func decodeIndexedPolygon(d *decoder) *Polygon {
+	p := &Polygon{}
+	p.hasHoles = d.readBool()
+	numLoops := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("s2: too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return nil
+	}
+	p.loops = make([]*Loop, 0, min(numLoops, decodeChunkSize))
+	for i := uint64(0); i < numLoops; i++ {
+		l := decodeIndexedLoop(d)
+		if d.err != nil {
+			return nil
+		}
+		p.numVertices += len(l.vertices)
+		if p.numVertices > maxEncodedPointsTotal {
+			d.err = fmt.Errorf("s2: too many vertices (%d; max is %d)", p.numVertices, maxEncodedPointsTotal)
+			return nil
+		}
+		p.loops = append(p.loops, l)
+	}
+	p.bound.decode(d)
+	if d.err != nil {
+		return nil
+	}
+	p.subregionBound = ExpandForSubregions(p.bound)
+	p.initEdgesAndIndex()
+	return p
+}
+
+// encodePointList writes a length-prefixed sequence of points.
+func encodePointList(e *encoder, pts []Point) {
+	e.writeUvarint(uint64(len(pts)))
+	for _, p := range pts {
+		e.writeFloat64(p.X)
+		e.writeFloat64(p.Y)
+		e.writeFloat64(p.Z)
+	}
+}
+
+// decodePointList reads a sequence of points written by encodePointList. The backing
+// slice is grown as points are read, so a corrupt length cannot trigger an
+// oversized allocation.
+func decodePointList(d *decoder) []Point {
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("s2: too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+	if n == 0 {
+		return nil
+	}
+	pts := make([]Point, 0, min(n, decodeChunkSize))
+	for i := uint64(0); i < n; i++ {
+		var p Point
+		p.X = d.readFloat64()
+		p.Y = d.readFloat64()
+		p.Z = d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, p)
+	}
+	return pts
+}
