+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	data := encodeShapeIndexOrDie(t, allShapeTypesIndex())
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < 5000; i++ {
+		c := append([]byte(nil), data...)
+		for j := 0; j < 1+rng.Intn(4); j++ {
+			c[rng.Intn(len(c))] = byte(rng.Intn(256))
+		}
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("Decode panicked on corrupted input: %v", r)
+				}
+			}()
+			got := NewShapeIndex()
+			if got.Decode(bytes.NewReader(c)) == nil {
+				// Whatever decoded successfully must be usable.
+				for it := got.Iterator(); !it.Done(); it.Next() {
+					_ = it.IndexCell()
+				}
+			}
+		}()
+	}
+}
