+func TestShapeIndexEncodeDecodeShapeIDsPreserved(t *testing.T) {
+	index := NewShapeIndex()
+	a := makePolyline("0:0, 1:1")
+	b := makePolyline("2:2, 3:3")
+	c := makePolyline("4:4, 5:5")
+	index.Add(a)
+	index.Add(b)
+	index.Add(c)
+	index.Build()
+	index.Remove(b)
+	index.Build()
+
+	got := decodeShapeIndexOrDie(t, encodeShapeIndexOrDie(t, index))
+	if got.Shape(1) != nil {
+		t.Errorf("removed shape 1 is present in decoded index")
+	}
+	if got.Shape(0) == nil || got.Shape(2) == nil {
+		t.Fatalf("shapes 0 and 2 should be present")
+	}
+	checkShapeIndexEqual(t, index, got)
+	if id := got.Add(makePolyline("6:6, 7:7")); id != 3 {
+		t.Errorf("Add() after decode = %d, want 3", id)
+	}
+}
