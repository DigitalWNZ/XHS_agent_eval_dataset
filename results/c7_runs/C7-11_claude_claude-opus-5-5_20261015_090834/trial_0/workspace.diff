+func TestShapeIndexDecodeOversized(t *testing.T) {
+	uv := func(xs ...uint64) []byte {
+		var b []byte
+		for _, x := range xs {
+			b = binary.AppendUvarint(b, x)
+		}
+		return b
+	}
+	header := append([]byte{shapeIndexEncodingVersion}, uv(10, 1<<31-1)...)
+
+	tests := []struct {
+		name string
+		data []byte
+	}{
+		{"bad version", []byte{99}},
+		{"huge shape count", append(append([]byte{}, header...), uv(1<<62)...)},
+		{"huge vertex count", append(append(append([]byte{}, header...), uv(1, 0)...),
+			append([]byte{shapeIndexTagPolyline}, uv(1<<40)...)...)},
+		{"large vertex count", append(append(append([]byte{}, header...), uv(1, 0)...),
+			append([]byte{shapeIndexTagPolyline}, uv(maxEncodedVertices)...)...)},
+		{"huge loop count", append(append(append([]byte{}, header...), uv(1, 0)...),
+			append([]byte{shapeIndexTagLaxPolygon}, uv(maxEncodedLoops)...)...)},
+		{"huge polygon loops", append(append(append([]byte{}, header...), uv(1, 0)...),
+			append([]byte{shapeIndexTagPolygon, 0}, uv(1<<50)...)...)},
+		{"huge cell count", append(append([]byte{}, header...), uv(0, 1<<39)...)},
+		{"unknown tag", append(append(append([]byte{}, header...), uv(1, 0)...), 200)},
+		{"next id overflow", append([]byte{shapeIndexEncodingVersion}, uv(10, 1<<40)...)},
+	}
+	for _, test := range tests {
+		if err := NewShapeIndex().Decode(bytes.NewReader(test.data)); err == nil {
+			t.Errorf("%s: Decode succeeded, want error", test.name)
+		}
+	}
+}
