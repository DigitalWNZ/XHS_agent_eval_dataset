+	data := encodeShapeIndexOrDie(t, index)
+	if len(data) == 0 {
+		t.Fatalf("empty index encoded to zero bytes")
+	}
+	got := decodeShapeIndexOrDie(t, data)
+	checkShapeIndexEqual(t, index, got)
+	if it := got.Iterator(); !it.Done() {
+		t.Errorf("empty decoded index iterator is not done")
+	}
+
+	// Decoding into a zero-value index also works.
+	var z ShapeIndex
+	if err := z.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode into zero-value index failed: %v", err)
+	}
+	z.Add(makePolyline("0:0, 1:1"))
+	z.Build()
+	if z.Len() != 1 {
