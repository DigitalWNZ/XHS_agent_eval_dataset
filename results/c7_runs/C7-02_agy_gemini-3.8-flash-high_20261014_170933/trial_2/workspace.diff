diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,54 @@
+WITH top_words AS (
+  SELECT 
+    s.wordid,
+    COUNT(DISTINCT s.synsetid) AS total_synsets,
+    COUNT(*) AS total_senses,
+    COUNT(DISTINCT syn.domainid) AS distinct_domains,
+    COUNT(DISTINCT syn.posid) AS distinct_posids
+  FROM senses s
+  JOIN synsets syn ON s.synsetid = syn.synsetid
+  GROUP BY s.wordid
+  HAVING total_synsets >= 2
+    AND distinct_domains >= 2 
+    AND total_senses >= 2
+  ORDER BY
+    total_senses DESC,
+    total_synsets DESC,
+    distinct_domains DESC,
+    s.wordid ASC
+  LIMIT 500
+),
+top_synsets AS (
+  SELECT wordid, synsetid, sense_count
+  FROM (
+    SELECT
+      s.wordid,
+      s.synsetid,
+      COUNT(*) AS sense_count,
+      ROW_NUMBER() OVER (
+        PARTITION BY s.wordid 
+        ORDER BY COUNT(*) DESC, s.synsetid ASC
+      ) AS rn
+    FROM senses s
+    JOIN top_words tw ON s.wordid = tw.wordid
+    GROUP BY s.wordid, s.synsetid
+  )
+  WHERE rn = 1
+)
+SELECT
+  tw.wordid AS word_id,
+  w.word AS word,
+  tw.total_synsets,
+  tw.total_senses,
+  tw.distinct_domains,
+  tw.distinct_posids,
+  ts.synsetid AS top_synsetid,
+  ts.sense_count AS top_synset_sense_count
+FROM top_words tw
+JOIN words w ON tw.wordid = w.wordid
+JOIN top_synsets ts ON tw.wordid = ts.wordid
+ORDER BY
+  tw.total_senses DESC,
+  tw.total_synsets DESC,
+  tw.distinct_domains DESC,
+  word_id ASC;
