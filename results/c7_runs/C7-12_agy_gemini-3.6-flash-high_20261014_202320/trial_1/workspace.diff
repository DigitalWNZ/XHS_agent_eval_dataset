+import { describe, expect, it, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  createPersisterRestoreResult,
+  isPersisterRestoreResult,
+  reconcileQueryState,
+} from '..'
+import { queryKey } from '@tanstack/query-test-utils'
+
+describe('createPersisterRestoreResult and state restoration', () => {
+  it('should create and recognize persister restore result marker', () => {
+    const result = createPersisterRestoreResult({
+      data: 'test-data',
+      state: {
+        data: 'test-data',
+        dataUpdateCount: 1,
+        dataUpdatedAt: 1000,
+        error: new Error('test-error'),
+        errorUpdateCount: 1,
+        errorUpdatedAt: 2000,
+        fetchFailureCount: 3,
+        fetchFailureReason: new Error('test-error'),
+        fetchMeta: null,
+        isInvalidated: true,
+        status: 'error',
+        fetchStatus: 'idle',
+      },
+    })
+
+    expect(isPersisterRestoreResult(result)).toBe(true)
+    expect(isPersisterRestoreResult({ data: 'test-data' })).toBe(false)
+  })
+
+  it('should adopt restored state without triggering onSuccess or onSettled callbacks', async () => {
+    const key = queryKey()
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+
+    const queryCache = new QueryCache({
+      onSuccess,
+      onSettled,
+    })
+    const queryClient = new QueryClient({ queryCache })
+
+    const restoredState = {
+      data: 'persisted-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('persisted-error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2000,
+      fetchFailureCount: 2,
+      fetchFailureReason: new Error('persisted-error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error' as const,
+      fetchStatus: 'idle' as const,
+    }
+
+    const persister = vi.fn().mockResolvedValue(
+      createPersisterRestoreResult({
+        data: restoredState.data,
+        state: restoredState,
+      }),
+    )
+
+    const queryFn = vi.fn()
+
+    const data = await queryClient.fetchQuery({
+      queryKey: key,
+      queryFn,
+      persister,
+      staleTime: 10000,
+    })
+
+    expect(data).toBe('persisted-data')
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('error')
+    expect(query.state.error).toEqual(new Error('persisted-error'))
+    expect(query.state.fetchFailureCount).toBe(2)
+    expect(query.state.dataUpdatedAt).toBe(1000)
+    expect(query.state.errorUpdatedAt).toBe(2000)
+  })
+
+  it('should correctly reconcile independent data and error freshness', () => {
+    // Case 1: Live cache has newer data, persisted snapshot has newer error
+    const liveState1 = {
+      data: 'live-newer-data',
+      dataUpdateCount: 2,
+      dataUpdatedAt: 5000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'success' as const,
+      fetchStatus: 'idle' as const,
+    }
+
+    const persistedState1 = {
+      data: 'old-persisted-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('newer-persisted-error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 6000,
+      fetchFailureCount: 3,
+      fetchFailureReason: new Error('newer-persisted-error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error' as const,
+      fetchStatus: 'idle' as const,
+    }
+
+    const merged1 = reconcileQueryState(liveState1, persistedState1)
+    expect(merged1.data).toBe('live-newer-data')
+    expect(merged1.dataUpdatedAt).toBe(5000)
+    expect(merged1.error).toEqual(new Error('newer-persisted-error'))
+    expect(merged1.errorUpdatedAt).toBe(6000)
+    expect(merged1.fetchFailureCount).toBe(3)
+    expect(merged1.status).toBe('error')
+
+    // Case 2: Persisted snapshot has newer data, live cache has newer error
+    const liveState2 = {
+      data: 'old-live-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('newer-live-error'),
+      errorUpdateCount: 2,
+      errorUpdatedAt: 7000,
+      fetchFailureCount: 4,
+      fetchFailureReason: new Error('newer-live-error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error' as const,
+      fetchStatus: 'idle' as const,
+    }
+
+    const persistedState2 = {
+      data: 'newer-persisted-data',
+      dataUpdateCount: 3,
+      dataUpdatedAt: 8000,
+      error: new Error('old-persisted-error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2000,
+      fetchFailureCount: 1,
+      fetchFailureReason: new Error('old-persisted-error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error' as const,
+      fetchStatus: 'idle' as const,
+    }
+
+    const merged2 = reconcileQueryState(liveState2, persistedState2)
+    expect(merged2.data).toBe('newer-persisted-data')
+    expect(merged2.dataUpdatedAt).toBe(8000)
+    expect(merged2.error).toEqual(new Error('newer-live-error'))
+    expect(merged2.errorUpdatedAt).toBe(7000)
+    expect(merged2.fetchFailureCount).toBe(4)
+    expect(merged2.status).toBe('error')
+  })
+})
