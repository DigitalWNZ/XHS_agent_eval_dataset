@@ -0,0 +1,108 @@
+import type { QueryState } from './query'
+import type { DefaultError } from './types'
+
+const PERSISTER_RESTORE_RESULT_SYMBOL = Symbol('PersisterRestoreResult')
+
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  data?: TData
+  state?: QueryState<TData, TError>
+  [PERSISTER_RESTORE_RESULT_SYMBOL]?: boolean
+}
+
+export function createPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(result: {
+  data?: TData
+  state?: QueryState<TData, TError>
+}): PersisterRestoreResult<TData, TError> {
+  return {
+    ...result,
+    [PERSISTER_RESTORE_RESULT_SYMBOL]: true,
+  }
+}
+
+export function isPersisterRestoreResult(
+  value: unknown,
+): value is PersisterRestoreResult {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as any)[PERSISTER_RESTORE_RESULT_SYMBOL] === true
+  )
+}
+
+export function reconcileRestoredState<TData, TError>(
+  existingState: QueryState<TData, TError>,
+  restoredState: Partial<QueryState<TData, TError>>,
+): QueryState<TData, TError> {
+  const existingDataUpdatedAt = existingState.dataUpdatedAt ?? 0
+  const restoredDataUpdatedAt = restoredState.dataUpdatedAt ?? 0
+
+  const useRestoredData = restoredDataUpdatedAt >= existingDataUpdatedAt
+
+  const data = useRestoredData ? restoredState.data : existingState.data
+  const dataUpdatedAt = useRestoredData
+    ? restoredDataUpdatedAt
+    : existingDataUpdatedAt
+  const dataUpdateCount = useRestoredData
+    ? (restoredState.dataUpdateCount ?? existingState.dataUpdateCount)
+    : existingState.dataUpdateCount
+
+  const existingErrorUpdatedAt = existingState.errorUpdatedAt ?? 0
+  const restoredErrorUpdatedAt = restoredState.errorUpdatedAt ?? 0
+
+  const useRestoredError = restoredErrorUpdatedAt >= existingErrorUpdatedAt
+
+  const error =
+    (useRestoredError ? restoredState.error : existingState.error) ?? null
+  const errorUpdatedAt = useRestoredError
+    ? restoredErrorUpdatedAt
+    : existingErrorUpdatedAt
+  const errorUpdateCount = useRestoredError
+    ? restoredErrorUpdatedAt > 0
+      ? (restoredState.errorUpdateCount ?? existingState.errorUpdateCount)
+      : existingState.errorUpdateCount
+    : existingState.errorUpdateCount
+  const fetchFailureCount = useRestoredError
+    ? restoredErrorUpdatedAt > 0
+      ? (restoredState.fetchFailureCount ?? existingState.fetchFailureCount)
+      : existingState.fetchFailureCount
+    : existingState.fetchFailureCount
+  const fetchFailureReason = useRestoredError
+    ? restoredErrorUpdatedAt > 0
+      ? (restoredState.fetchFailureReason ?? existingState.fetchFailureReason)
+      : existingState.fetchFailureReason
+    : existingState.fetchFailureReason
+
+  const isInvalidated =
+    restoredState.isInvalidated ?? existingState.isInvalidated
+
+  let status: 'pending' | 'success' | 'error'
+  if (error) {
+    status = 'error'
+  } else if (data !== undefined) {
+    status = 'success'
+  } else {
+    status = 'pending'
+  }
+
+  return {
+    ...existingState,
+    ...(restoredState as Partial<QueryState<TData, TError>>),
+    data,
+    dataUpdatedAt,
+    dataUpdateCount,
+    error,
+    errorUpdatedAt,
+    errorUpdateCount,
+    fetchFailureCount,
+    fetchFailureReason,
+    isInvalidated,
+    status,
+    fetchStatus: 'idle',
+  }
+}
