@@ -0,0 +1,185 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  createPersisterRestoreResult,
+  reconcileRestoredState,
+} from '..'
+import type { QueryState } from '..'
+
+describe('createPersisterRestoreResult & query restoration', () => {
+  it('exports createPersisterRestoreResult helper', () => {
+    const state: QueryState<string, Error> = {
+      data: 'persisted data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('persisted error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 1200,
+      fetchFailureCount: 2,
+      fetchFailureReason: new Error('persisted error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const restoreResult = createPersisterRestoreResult({
+      data: state.data,
+      state,
+    })
+
+    expect(restoreResult).toBeDefined()
+    expect(restoreResult.data).toBe('persisted data')
+    expect(restoreResult.state).toBe(state)
+  })
+
+  it('adopts provided state on persister restore without triggering fetch success callbacks', async () => {
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+    const queryCache = new QueryCache({
+      onSuccess,
+      onSettled,
+    })
+    const queryClient = new QueryClient({ queryCache })
+
+    const persistedState: QueryState<string, Error> = {
+      data: 'cached data',
+      dataUpdateCount: 3,
+      dataUpdatedAt: 5000,
+      error: new Error('refetch error'),
+      errorUpdateCount: 2,
+      errorUpdatedAt: 6000,
+      fetchFailureCount: 4,
+      fetchFailureReason: new Error('refetch error'),
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const persister = vi.fn(() =>
+      Promise.resolve(
+        createPersisterRestoreResult({
+          data: persistedState.data,
+          state: persistedState,
+        }),
+      ),
+    )
+
+    await queryClient.prefetchQuery({
+      queryKey: ['test-restore'],
+      queryFn: () => Promise.resolve('fresh fetch'),
+      persister,
+    })
+
+    const query = queryCache.find({ queryKey: ['test-restore'] })!
+    expect(query).toBeDefined()
+    expect(query.state.data).toBe('cached data')
+    expect(query.state.error?.message).toBe('refetch error')
+    expect(query.state.status).toBe('error')
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.fetchFailureCount).toBe(4)
+    expect(query.state.dataUpdatedAt).toBe(5000)
+    expect(query.state.errorUpdatedAt).toBe(6000)
+    expect(query.state.isInvalidated).toBe(true)
+
+    // Callbacks must not be triggered for restore
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+  })
+
+  it('reconciles live cache and persisted snapshot merging data and error freshness independently', () => {
+    const liveState: QueryState<string, Error> = {
+      data: 'newer live data',
+      dataUpdateCount: 2,
+      dataUpdatedAt: 10000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'success',
+      fetchStatus: 'idle',
+    }
+
+    const persistedState: QueryState<string, Error> = {
+      data: 'older persisted data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 2000,
+      error: new Error('newer persisted error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 8000,
+      fetchFailureCount: 3,
+      fetchFailureReason: new Error('newer persisted error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const reconciled = reconcileRestoredState(liveState, persistedState)
+
+    // Keeps newer live data (10000 > 2000)
+    expect(reconciled.data).toBe('newer live data')
+    expect(reconciled.dataUpdatedAt).toBe(10000)
+
+    // Adopts newer persisted error (8000 > 0)
+    expect(reconciled.error?.message).toBe('newer persisted error')
+    expect(reconciled.errorUpdatedAt).toBe(8000)
+    expect(reconciled.fetchFailureCount).toBe(3)
+
+    // Combined state is refetch error (status: 'error', has data and error)
+    expect(reconciled.status).toBe('error')
+    expect(reconciled.fetchStatus).toBe('idle')
+  })
+
+  it('reconciles inverse case: newer persisted data and newer live error', () => {
+    const liveState: QueryState<string, Error> = {
+      data: undefined,
+      dataUpdateCount: 0,
+      dataUpdatedAt: 0,
+      error: new Error('newer live error'),
+      errorUpdateCount: 2,
+      errorUpdatedAt: 12000,
+      fetchFailureCount: 5,
+      fetchFailureReason: new Error('newer live error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const persistedState: QueryState<string, Error> = {
+      data: 'newer persisted data',
+      dataUpdateCount: 2,
+      dataUpdatedAt: 9000,
+      error: new Error('older persisted error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 5000,
+      fetchFailureCount: 2,
+      fetchFailureReason: new Error('older persisted error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const reconciled = reconcileRestoredState(liveState, persistedState)
+
+    // Adopts newer persisted data (9000 > 0)
+    expect(reconciled.data).toBe('newer persisted data')
+    expect(reconciled.dataUpdatedAt).toBe(9000)
+
+    // Keeps newer live error (12000 > 5000)
+    expect(reconciled.error?.message).toBe('newer live error')
+    expect(reconciled.errorUpdatedAt).toBe(12000)
+    expect(reconciled.fetchFailureCount).toBe(5)
+
+    // Result remains refetch error
+    expect(reconciled.status).toBe('error')
+    expect(reconciled.fetchStatus).toBe('idle')
+  })
+})
