+func TestHandlerEncryptionPipeline(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	originalData := []byte("CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(255));\nINSERT INTO users VALUES (1, 'Alice');\n")
+
+	readers, writer, closer := storageReadWriteCloser(1, true, enc)
+
+	var readData []byte
+	var readErr error
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+		readData, readErr = io.ReadAll(readers[0])
+	}()
+
+	_, err = writer.Write(originalData)
+	require.NoError(t, err)
+
+	err = closer.Close()
+	require.NoError(t, err)
+
+	<-done
+	require.NoError(t, readErr)
+
+	// Round-trip through DecryptReader then gzip.NewReader back to original data
+	decryptedReader, err := encryption.DecryptReader(bytes.NewReader(readData), key)
+	require.NoError(t, err)
+
+	gzReader, err := gzip.NewReader(decryptedReader)
+	require.NoError(t, err)
+
+	uncompressedData, err := io.ReadAll(gzReader)
+	require.NoError(t, err)
+
+	assert.Equal(t, originalData, uncompressedData)
+}
