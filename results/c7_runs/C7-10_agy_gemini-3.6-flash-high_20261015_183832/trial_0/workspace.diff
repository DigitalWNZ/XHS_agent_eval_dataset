diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..c8238a1
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,461 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+var ErrInvalidKey = errors.New("invalid encryption key")
+
+type Encryptor struct {
+	key []byte
+}
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	src := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if src == "" {
+		return errors.New("key source is required when encryption is enabled")
+	}
+
+	switch src {
+	case "env":
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("keyfile, key, passphrase, salt are mutually exclusive with env key source")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("keyenvvar is required for env key source")
+		}
+	case "file":
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("keyenvvar, key, passphrase, salt are mutually exclusive with file key source")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("keyfile is required for file key source")
+		}
+	case "literal":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("keyenvvar, keyfile, passphrase, salt are mutually exclusive with literal key source")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+	case "derive":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("keyenvvar, keyfile, key are mutually exclusive with derive key source")
+		}
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+	default:
+		return fmt.Errorf("unsupported key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+	k := make([]byte, 32)
+	copy(k, key)
+	return &Encryptor{key: k}, nil
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	gcm           cipher.AEAD
+	h             hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		return &encryptWriter{err: err}
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return &encryptWriter{err: err}
+	}
+
+	return &encryptWriter{
+		w:   w,
+		key: e.key,
+		gcm: gcm,
+		h:   hmac.New(sha256.New, e.key),
+		buf: make([]byte, 0, 64*1024),
+	}
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	ew.headerWritten = true
+	header := []byte{0x4F, 0x44, 0x01}
+	_, err := ew.w.Write(header)
+	return err
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if ew.closed {
+		return 0, io.ErrClosedPipe
+	}
+	if err := ew.ensureHeader(); err != nil {
+		return 0, err
+	}
+
+	total := len(p)
+	const maxChunk = 64 * 1024
+
+	for len(p) > 0 {
+		space := maxChunk - len(ew.buf)
+		if space > len(p) {
+			space = len(p)
+		}
+		ew.buf = append(ew.buf, p[:space]...)
+		p = p[space:]
+
+		if len(ew.buf) == maxChunk {
+			if err := ew.flushChunk(); err != nil {
+				return 0, err
+			}
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, 12)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce, ew.buf, nil)
+	payloadLen := uint32(len(nonce) + len(ciphertext))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], payloadLen)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	ew.h.Write(lenBuf[:])
+
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	ew.h.Write(nonce)
+
+	if _, err := ew.w.Write(ciphertext); err != nil {
+		return err
+	}
+	ew.h.Write(ciphertext)
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(); err != nil {
+			return err
+		}
+	}
+
+	sentinel := []byte{0x00, 0x00, 0x00, 0x00}
+	if _, err := ew.w.Write(sentinel); err != nil {
+		return err
+	}
+
+	mac := ew.h.Sum(nil)
+	if _, err := ew.w.Write(mac); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+type decryptReader struct {
+	r   io.Reader
+	key []byte
+	gcm cipher.AEAD
+	h   hash.Hash
+
+	init     bool
+	initErr  error
+	done     bool
+	plainBuf []byte
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	k := make([]byte, 32)
+	copy(k, key)
+
+	return &decryptReader{
+		r:   r,
+		key: k,
+	}, nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		if dr.initErr != nil {
+			return 0, dr.initErr
+		}
+		return 0, nil
+	}
+
+	if dr.initErr != nil {
+		return 0, dr.initErr
+	}
+
+	if !dr.init {
+		dr.init = true
+		block, err := aes.NewCipher(dr.key)
+		if err != nil {
+			dr.initErr = fmt.Errorf("failed to create cipher: %w", err)
+			return 0, dr.initErr
+		}
+		gcm, err := cipher.NewGCM(block)
+		if err != nil {
+			dr.initErr = fmt.Errorf("failed to create GCM: %w", err)
+			return 0, dr.initErr
+		}
+		dr.gcm = gcm
+		dr.h = hmac.New(sha256.New, dr.key)
+
+		var header [3]byte
+		if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				dr.initErr = fmt.Errorf("invalid header: truncated header: %w", err)
+			} else {
+				dr.initErr = fmt.Errorf("invalid header: %w", err)
+			}
+			return 0, dr.initErr
+		}
+
+		if header[0] != 0x4F || header[1] != 0x44 {
+			dr.initErr = fmt.Errorf("invalid header: magic mismatch (got 0x%02x 0x%02x)", header[0], header[1])
+			return 0, dr.initErr
+		}
+
+		if header[2] != 0x01 {
+			dr.initErr = fmt.Errorf("unsupported version: 0x%02x", header[2])
+			return 0, dr.initErr
+		}
+	}
+
+	for len(p) > 0 {
+		if len(dr.plainBuf) > 0 {
+			n := copy(p, dr.plainBuf)
+			dr.plainBuf = dr.plainBuf[n:]
+			return n, nil
+		}
+
+		if dr.done {
+			return 0, io.EOF
+		}
+
+		var lenBuf [4]byte
+		if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+			dr.initErr = fmt.Errorf("truncated data: %w", err)
+			return 0, dr.initErr
+		}
+
+		chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+		if chunkLen == 0 {
+			dr.done = true
+			var expectedHMAC [32]byte
+			if _, err := io.ReadFull(dr.r, expectedHMAC[:]); err != nil {
+				dr.initErr = fmt.Errorf("truncated data: failed to read HMAC: %w", err)
+				return 0, dr.initErr
+			}
+			actualHMAC := dr.h.Sum(nil)
+			if !hmac.Equal(actualHMAC, expectedHMAC[:]) {
+				dr.initErr = fmt.Errorf("integrity check failed: HMAC mismatch")
+				return 0, dr.initErr
+			}
+			return 0, io.EOF
+		}
+
+		if chunkLen < 12+16 {
+			dr.initErr = fmt.Errorf("truncated data: chunk length %d too short", chunkLen)
+			return 0, dr.initErr
+		}
+
+		payload := make([]byte, chunkLen)
+		if _, err := io.ReadFull(dr.r, payload); err != nil {
+			dr.initErr = fmt.Errorf("truncated data: %w", err)
+			return 0, dr.initErr
+		}
+
+		dr.h.Write(lenBuf[:])
+		dr.h.Write(payload)
+
+		nonce := payload[:12]
+		ciphertext := payload[12:]
+
+		plaintext, err := dr.gcm.Open(nil, nonce, ciphertext, nil)
+		if err != nil {
+			dr.initErr = fmt.Errorf("decryption failed: %w", err)
+			return 0, dr.initErr
+		}
+
+		dr.plainBuf = plaintext
+	}
+
+	return 0, nil
+}
+
+func decodeBase64Key(s string) ([]byte, error) {
+	b, err := base64.StdEncoding.DecodeString(s)
+	if err == nil {
+		return b, nil
+	}
+	b, err = base64.RawStdEncoding.DecodeString(s)
+	if err == nil {
+		return b, nil
+	}
+	b, err = base64.URLEncoding.DecodeString(s)
+	if err == nil {
+		return b, nil
+	}
+	b, err = base64.RawURLEncoding.DecodeString(s)
+	if err == nil {
+		return b, nil
+	}
+	return nil, err
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if !cfg.Enabled {
+		return nil, nil
+	}
+
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+
+	src := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch src {
+	case "env":
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key env var %q is not set", cfg.KeyEnvVar)
+		}
+		val = strings.TrimSpace(val)
+		key, err := decodeBase64Key(val)
+		if err != nil {
+			return nil, fmt.Errorf("encryption key from env var %q is invalid base64: %w", cfg.KeyEnvVar, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key from env var %q must be 32 bytes, got %d", ErrInvalidKey, cfg.KeyEnvVar, len(key))
+		}
+		return key, nil
+
+	case "file":
+		data, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", cfg.KeyFile, err)
+		}
+		val := strings.TrimSpace(string(data))
+		key, err := decodeBase64Key(val)
+		if err != nil {
+			return nil, fmt.Errorf("encryption key from file %q is invalid base64: %w", cfg.KeyFile, err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key from file %q must be 32 bytes, got %d", ErrInvalidKey, cfg.KeyFile, len(key))
+		}
+		return key, nil
+
+	case "literal":
+		val := strings.TrimSpace(cfg.Key)
+		key, err := decodeBase64Key(val)
+		if err != nil {
+			return nil, fmt.Errorf("encryption key from literal is invalid base64: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key from literal must be 32 bytes, got %d", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "derive":
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("passphrase cannot be empty for key derivation")
+		}
+		saltVal := strings.TrimSpace(cfg.Salt)
+		saltBytes, err := decodeBase64Key(saltVal)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, fmt.Errorf("salt must be at least 16 bytes, got %d bytes", len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, 4096, 32, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..43c80ce
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,250 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptorKeyLength(t *testing.T) {
+	_, err := NewEncryptor([]byte("too short"))
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	key := make([]byte, 32)
+	_, err = io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+	assert.NotNil(t, enc)
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("Hello, World! This is a test of AES-256-GCM streaming encryption.")
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	n, err := w.Write(plaintext)
+	require.NoError(t, err)
+	assert.Equal(t, len(plaintext), n)
+
+	err = w.Close()
+	require.NoError(t, err)
+
+	// Idempotent Close
+	err = w.Close()
+	require.NoError(t, err)
+
+	r, err := DecryptReader(&buf, key)
+	require.NoError(t, err)
+
+	decrypted, err := io.ReadAll(r)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, decrypted)
+}
+
+func TestEncryptNonUnique(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("Same plaintext content for both encryptions.")
+
+	var buf1, buf2 bytes.Buffer
+	w1 := enc.EncryptWriter(&buf1)
+	_, err = w1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w1.Close())
+
+	w2 := enc.EncryptWriter(&buf2)
+	_, err = w2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes(), "Two encryptions of same plaintext must differ")
+}
+
+func TestLargeDataChunking(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// 200KB of data to test multiple 64KB chunks
+	largeData := make([]byte, 200*1024)
+	_, err = io.ReadFull(rand.Reader, largeData)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write(largeData)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	r, err := DecryptReader(&buf, key)
+	require.NoError(t, err)
+
+	decrypted, err := io.ReadAll(r)
+	require.NoError(t, err)
+	assert.Equal(t, largeData, decrypted)
+}
+
+func TestDecryptHeaderValidation(t *testing.T) {
+	key := make([]byte, 32)
+
+	// Wrong magic
+	badMagic := []byte{0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00}
+	r, err := DecryptReader(bytes.NewReader(badMagic), key)
+	require.NoError(t, err)
+	buf := make([]byte, 100)
+	_, err = r.Read(buf)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+
+	// Unsupported version
+	badVersion := []byte{0x4F, 0x44, 0x02, 0x00, 0x00, 0x00, 0x00}
+	r, err = DecryptReader(bytes.NewReader(badVersion), key)
+	require.NoError(t, err)
+	_, err = r.Read(buf)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+}
+
+func TestDecryptIntegrityFailure(t *testing.T) {
+	key := make([]byte, 32)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write([]byte("Test data"))
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	encBytes := buf.Bytes()
+	// Corrupt a byte in HMAC at the end
+	encBytes[len(encBytes)-1] ^= 0xFF
+
+	r, err := DecryptReader(bytes.NewReader(encBytes), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+}
+
+func TestDecryptWrongKey(t *testing.T) {
+	key1 := make([]byte, 32)
+	key1[0] = 1
+	key2 := make([]byte, 32)
+	key2[0] = 2
+
+	enc, err := NewEncryptor(key1)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write([]byte("Test data"))
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	r, err := DecryptReader(&buf, key2)
+	require.NoError(t, err)
+	_, err = io.ReadAll(r)
+	require.Error(t, err)
+}
+
+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	cfg := Config{Enabled: false}
+	assert.NoError(t, cfg.Validate())
+
+	// Enabled, missing key source
+	cfg = Config{Enabled: true}
+	assert.Error(t, cfg.Validate())
+
+	// Env source valid
+	cfg = Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, cfg.Validate())
+
+	// Case-insensitive source
+	cfg = Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, cfg.Validate())
+
+	// Env source with extra fields -> mutually exclusive error
+	cfg = Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", KeyFile: "file.txt"}
+	err := cfg.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// Literal source valid
+	cfg = Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString(make([]byte, 32))}
+	assert.NoError(t, cfg.Validate())
+
+	// Derive source valid
+	salt := base64.StdEncoding.EncodeToString(make([]byte, 16))
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "secretpassphrase", Salt: salt}
+	assert.NoError(t, cfg.Validate())
+}
+
+func TestLoadKey(t *testing.T) {
+	rawKey := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, rawKey)
+	require.NoError(t, err)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// Env
+	t.Setenv("TEST_ENC_KEY", b64Key)
+	cfg := Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_ENC_KEY"}
+	loadedKey, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loadedKey)
+
+	// Missing Env
+	cfg = Config{Enabled: true, KeySource: "env", KeyEnvVar: "UNSET_KEY_ENV_VAR"}
+	_, err = LoadKey(cfg)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey) || bytes.Contains([]byte(err.Error()), []byte("encryption")) || bytes.Contains([]byte(err.Error()), []byte("key")))
+
+	// File
+	tmpDir := t.TempDir()
+	keyFilePath := filepath.Join(tmpDir, "key.txt")
+	require.NoError(t, os.WriteFile(keyFilePath, []byte(b64Key+"\n"), 0600))
+	cfg = Config{Enabled: true, KeySource: "file", KeyFile: keyFilePath}
+	loadedKey, err = LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loadedKey)
+
+	// Literal
+	cfg = Config{Enabled: true, KeySource: "literal", Key: b64Key}
+	loadedKey, err = LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loadedKey)
+
+	// Derive
+	saltB64 := base64.StdEncoding.EncodeToString([]byte("1234567890123456"))
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "mysecretpassphrase", Salt: saltB64}
+	loadedKey, err = LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Len(t, loadedKey, 32)
+}
