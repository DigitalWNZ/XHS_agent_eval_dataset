+func TestStorageReadWriteCloserPipelineRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	for i := range key {
+		key[i] = byte(i + 1)
+	}
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	prs, writer, closer := storageReadWriteCloser(1, true, enc)
+	originalData := []byte("SELECT * FROM users; INSERT INTO users VALUES (1, 'Alice');")
+
+	go func() {
+		writer.Write(originalData)
+		closer.Close()
+	}()
+
+	dr, err := encryption.DecryptReader(prs[0], key)
+	require.NoError(t, err)
+
+	gr, err := gzip.NewReader(dr)
+	require.NoError(t, err)
+
+	decompressed, err := io.ReadAll(gr)
+	require.NoError(t, err)
+
+	assert.Equal(t, originalData, decompressed)
+}
