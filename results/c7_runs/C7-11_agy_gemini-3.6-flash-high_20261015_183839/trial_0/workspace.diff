 	// TODO(roberts): finish the implementation of this.
 }
+
+const (
+	maxEncodedShapes        = 10000000
+	maxEncodedCells         = 100000000
+	maxEncodedClippedShapes = 1000000
+	maxEncodedCellEdges     = 10000000
+)
+
+type encodable interface {
+	Encode(w io.Writer) error
+}
+
+type decodable interface {
+	Decode(r io.Reader) error
+}
+
+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUint32(uint32(s.maxEdgesPerCell))
+	e.writeUint32(uint32(s.nextID))
+
+	for id := int32(0); id < s.nextID; id++ {
+		shape := s.shapes[id]
+		if shape == nil {
+			e.writeUint32(uint32(typeTagNone))
+			continue
+		}
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			e.err = fmt.Errorf("unencodable shape type at id %d", id)
+			return
+		}
+		e.writeUint32(uint32(tag))
+		switch sh := shape.(type) {
+		case encodable:
+			if err := sh.Encode(e.w); err != nil {
+				e.err = err
+				return
+			}
+		default:
+			e.err = fmt.Errorf("shape type %T at id %d does not implement Encode", shape, id)
+			return
+		}
+	}
+
+	e.writeUint32(uint32(len(s.cells)))
+	for _, cellID := range s.cells {
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUint32(0)
+			continue
+		}
+		e.writeUint32(uint32(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUint32(uint32(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUint32(uint32(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUint32(uint32(edgeID))
+			}
+		}
+	}
+}
+
+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.Reset()
+
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	s.maxEdgesPerCell = int(d.readUint32())
+	nextID := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+	s.nextID = int32(nextID)
+
+	for id := int32(0); id < s.nextID; id++ {
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return
+		}
+		if tag == typeTagNone {
+			continue
+		}
+
+		var shape Shape
+		switch tag {
+		case typeTagPolygon:
+			shape = new(Polygon)
+		case typeTagPolyline:
+			shape = new(Polyline)
+		case typeTagPointVector:
+			shape = new(PointVector)
+		case typeTagLaxPolyline:
+			shape = new(LaxPolyline)
+		case typeTagLaxPolygon:
+			shape = new(LaxPolygon)
+		case typeTagLoop:
+			shape = new(Loop)
+		case typeTagLaxLoop:
+			shape = new(LaxLoop)
+		default:
+			d.err = fmt.Errorf("unknown shape typeTag %d at shape id %d", tag, id)
+			return
+		}
+
+		switch dec := shape.(type) {
+		case decodable:
+			if err := dec.Decode(d.r); err != nil {
+				d.err = err
+				return
+			}
+		default:
+			d.err = fmt.Errorf("shape type %T at id %d does not implement Decode", shape, id)
+			return
+		}
+
+		s.shapes[id] = shape
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	s.cells = make([]CellID, 0, min(int(numCells), 10000))
+	s.cellMap = make(map[CellID]*ShapeIndexCell, min(int(numCells), 10000))
+
+	for i := 0; i < int(numCells); i++ {
+		cellID := CellID(d.readUint64())
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapes {
+			d.err = fmt.Errorf("too many clipped shapes (%d; max is %d)", numClipped, maxEncodedClippedShapes)
+			return
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		for j := 0; j < int(numClipped); j++ {
+			shapeID := int32(d.readUint32())
+			containsCenter := d.readBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			if numEdges > maxEncodedCellEdges {
+				d.err = fmt.Errorf("too many cell edges (%d; max is %d)", numEdges, maxEncodedCellEdges)
+				return
+			}
+
+			clipped := &clippedShape{
+				shapeID:        shapeID,
+				containsCenter: containsCenter,
+				edges:          make([]int, numEdges),
+			}
+			for e := 0; e < int(numEdges); e++ {
+				clipped.edges[e] = int(d.readUint32())
+			}
+			cell.shapes[j] = clipped
+		}
+
+		s.cells = append(s.cells, cellID)
+		s.cellMap[cellID] = cell
+	}
+
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+	s.status = fresh
+}
