+// Encode encodes the LaxPolygon.
+func (p *LaxPolygon) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	p.encode(e)
+	return e.err
+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUint32(uint32(p.numLoops))
+	if p.numLoops == 0 {
+		return
+	}
+	if p.numLoops == 1 {
+		e.writeUint32(uint32(p.numVerts))
+	} else {
+		for i := 0; i < p.numLoops; i++ {
+			e.writeUint32(uint32(p.numLoopVertices(i)))
+		}
+	}
+	for _, v := range p.vertices {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	nloops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	p.numLoops = int(nloops)
+	if p.numLoops == 0 {
+		p.numVerts = 0
+		p.vertices = nil
+		p.cumulativeVertices = nil
+		return
+	}
+
+	if p.numLoops == 1 {
+		nvert := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if nvert > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", nvert, maxEncodedVertices)
+			return
+		}
+		p.numVerts = int(nvert)
+		p.vertices = make([]Point, nvert)
+		for i := range p.vertices {
+			p.vertices[i].X = d.readFloat64()
+			p.vertices[i].Y = d.readFloat64()
+			p.vertices[i].Z = d.readFloat64()
+		}
+		p.cumulativeVertices = nil
+		return
+	}
+
+	loopVerts := make([]int, p.numLoops)
+	var totalVerts int
+	for i := 0; i < p.numLoops; i++ {
+		nv := int(d.readUint32())
+		if d.err != nil {
+			return
+		}
+		if nv > maxEncodedVertices {
+			d.err = fmt.Errorf("too many loop vertices (%d; max is %d)", nv, maxEncodedVertices)
+			return
+		}
+		loopVerts[i] = nv
+		totalVerts += nv
+		if totalVerts > maxEncodedVertices {
+			d.err = fmt.Errorf("total vertices exceed max (%d; max is %d)", totalVerts, maxEncodedVertices)
+			return
+		}
+	}
+
+	p.cumulativeVertices = make([]int, p.numLoops+1)
+	p.cumulativeVertices[0] = 0
+	for i, nv := range loopVerts {
+		p.cumulativeVertices[i+1] = p.cumulativeVertices[i] + nv
+	}
+
+	p.vertices = make([]Point, totalVerts)
+	for i := range p.vertices {
+		p.vertices[i].X = d.readFloat64()
+		p.vertices[i].Y = d.readFloat64()
+		p.vertices[i].Z = d.readFloat64()
+	}
+	p.numVerts = 0
+}
