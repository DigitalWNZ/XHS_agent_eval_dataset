+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	index := NewShapeIndex()
+	s0 := Polyline(parsePoints("0:0, 0:1"))
+	index.Add(&s0)
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	validData := buf.Bytes()
+
+	for i := 0; i < len(validData); i++ {
+		truncated := validData[:i]
+		decoded := NewShapeIndex()
+		if err := decoded.Decode(bytes.NewReader(truncated)); err == nil {
+			t.Errorf("Decode on truncated stream of length %d succeeded, expected error", i)
+		}
+	}
+
+	corruptedVer := append([]byte(nil), validData...)
+	corruptedVer[0] = 99
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(corruptedVer)); err == nil {
+		t.Errorf("Decode with corrupted version byte succeeded, expected error")
+	}
+
+	corruptedTag := append([]byte(nil), validData...)
+	if len(corruptedTag) >= 13 {
+		corruptedTag[9] = 0xFF
+		corruptedTag[10] = 0xFF
+		corruptedTag[11] = 0x00
+		corruptedTag[12] = 0x00
+		decoded := NewShapeIndex()
+		if err := decoded.Decode(bytes.NewReader(corruptedTag)); err == nil {
+			t.Errorf("Decode with corrupted shape tag succeeded, expected error")
+		}
+	}
+}
