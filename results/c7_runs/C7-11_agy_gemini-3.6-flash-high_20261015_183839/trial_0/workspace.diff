+		t.Errorf("polygon dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idPL).Dimension(), 1; got != want {
+		t.Errorf("polyline dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idLoop).Dimension(), 2; got != want {
+		t.Errorf("loop dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idPV).Dimension(), 0; got != want {
+		t.Errorf("pointVector dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idLaxPL).Dimension(), 1; got != want {
+		t.Errorf("laxPolyline dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idLaxPoly).Dimension(), 2; got != want {
+		t.Errorf("laxPolygon dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idLaxPoly).NumChains(), 2; got != want {
+		t.Errorf("laxPolygon NumChains() = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idLaxPoly).Chain(0).Length, 0; got != want {
+		t.Errorf("laxPolygon Chain(0).Length = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idLaxLoop).Dimension(), 2; got != want {
+		t.Errorf("laxLoop dimension = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idEmptyPL).NumEdges(), 0; got != want {
+		t.Errorf("emptyPolyline NumEdges() = %d, want %d", got, want)
+	}
+	if got, want := decoded.Shape(idEmptyPV).NumEdges(), 0; got != want {
+		t.Errorf("emptyPointVector NumEdges() = %d, want %d", got, want)
+	}
+
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+}
