+func TestShapeIndexDecodeOversizedAllocations(t *testing.T) {
+	var buf bytes.Buffer
+	e := &encoder{w: &buf}
+	e.writeInt8(encodingVersion)
+	e.writeUint32(10)         // maxEdgesPerCell
+	e.writeUint32(1000000000) // nextID > maxEncodedShapes
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err == nil {
+		t.Errorf("Decode with oversized nextID succeeded, expected error")
+	}
+
+	buf.Reset()
+	e = &encoder{w: &buf}
+	e.writeInt8(encodingVersion)
+	e.writeUint32(10)         // maxEdgesPerCell
+	e.writeUint32(0)          // nextID
+	e.writeUint32(1000000000) // numCells > maxEncodedCells
+
+	decoded = NewShapeIndex()
+	if err := decoded.Decode(&buf); err == nil {
+		t.Errorf("Decode with oversized numCells succeeded, expected error")
+	}
+}
