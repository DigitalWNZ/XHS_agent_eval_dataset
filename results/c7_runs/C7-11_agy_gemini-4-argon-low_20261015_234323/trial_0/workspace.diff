+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	// Generate a valid non-trivial encoded index first.
+	index := makeShapeIndex("0:0 | 1:1 # 0:0, 2:2 | 3:3, 4:4, 5:5 # 10:10, 10:20, 20:10; 12:12, 14:12, 12:14 | full | empty")
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// 1. Empty input
+	var dec ShapeIndex
+	if err := dec.Decode(bytes.NewReader(nil)); err == nil {
+		t.Errorf("expected error decoding empty input")
+	}
+
+	// 2. Every truncated prefix of validBytes must return an error and not panic.
+	for n := 0; n < len(validBytes); n++ {
+		var d ShapeIndex
+		if err := d.Decode(bytes.NewReader(validBytes[:n])); err == nil {
+			t.Errorf("expected error for truncated prefix of length %d/%d", n, len(validBytes))
+		}
+	}
+
+	// 3. Single-byte bit flips across the buffer must not panic.
+	for i := range validBytes {
+		for _, mask := range []byte{0x01, 0x7f, 0xff} {
+			corrupted := bytes.Clone(validBytes)
+			corrupted[i] ^= mask
+			var d ShapeIndex
+			_ = d.Decode(bytes.NewReader(corrupted))
+		}
+	}
+
+	// 4. Oversized allocation requests
+	makeOversizedStream := func(fn func(e *encoder)) []byte {
+		var b bytes.Buffer
+		e := &encoder{w: &b}
+		fn(e)
+		return b.Bytes()
+	}
+
+	oversizedCases := []struct {
+		name string
+		data []byte
+	}{
+		{
+			name: "unsupported version",
+			data: makeOversizedStream(func(e *encoder) {
+				e.writeInt8(99)
