+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if got.Len() != want.Len() {
+		t.Fatalf("index Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("index NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("index nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	for id := int32(0); id < want.nextID; id++ {
+		ws := want.Shape(id)
+		gs := got.Shape(id)
+		if (ws == nil) != (gs == nil) {
+			t.Fatalf("Shape(%d) nil mismatch: got %v, want %v", id, gs, ws)
+		}
+		if ws != nil {
+			assertShapeEqual(t, gs, ws)
+		}
+	}
+
+	// Verify cells without calling Build on got (got should already be fresh).
+	if !got.IsFresh() {
+		t.Errorf("decoded index should be fresh immediately after Decode")
+	}
+	if len(got.cells) != len(want.cells) {
+		t.Fatalf("len(cells) = %d, want %d", len(got.cells), len(want.cells))
+	}
+	for i, cid := range want.cells {
+		if got.cells[i] != cid {
+			t.Fatalf("cells[%d] = %v, want %v", i, got.cells[i], cid)
+		}
+		wc := want.cellMap[cid]
+		gc := got.cellMap[cid]
+		if len(gc.shapes) != len(wc.shapes) {
+			t.Fatalf("cell %v len(shapes) = %d, want %d", cid, len(gc.shapes), len(wc.shapes))
+		}
+		for j, wcs := range wc.shapes {
+			gcs := gc.shapes[j]
+			if gcs.shapeID != wcs.shapeID || gcs.containsCenter != wcs.containsCenter {
+				t.Errorf("cell %v clipped[%d] = (%d, %v), want (%d, %v)", cid, j, gcs.shapeID, gcs.containsCenter, wcs.shapeID, wcs.containsCenter)
+			}
+			if len(gcs.edges) != len(wcs.edges) {
+				t.Fatalf("cell %v clipped[%d] len(edges) = %d, want %d", cid, j, len(gcs.edges), len(wcs.edges))
+			}
+			for k, e := range wcs.edges {
+				if gcs.edges[k] != e {
+					t.Errorf("cell %v clipped[%d] edge[%d] = %d, want %d", cid, j, k, gcs.edges[k], e)
+				}
+			}
+		}
+	}
+}
