+// Encode encodes the ShapeIndex to the given writer.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if w == nil {
+		return fmt.Errorf("cannot encode ShapeIndex to nil writer")
+	}
+	s.Build()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
