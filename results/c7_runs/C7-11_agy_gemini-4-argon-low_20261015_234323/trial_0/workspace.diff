+	var decoded ShapeIndex
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+
+	if decoded.Shape(id0) != nil {
+		t.Errorf("expected Shape(%d) to be nil", id0)
+	}
+	if decoded.Shape(id2) != nil {
+		t.Errorf("expected Shape(%d) to be nil", id2)
+	}
+	if decoded.Shape(id1) == nil {
+		t.Errorf("expected Shape(%d) to be non-nil", id1)
+	}
