+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUvarint(uint64(maxEdges))
+	e.writeInt32(s.nextID)
+
+	var shapeIDs []int32
+	for id, sh := range s.shapes {
+		if sh != nil {
+			shapeIDs = append(shapeIDs, id)
+		}
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUvarint(uint64(len(shapeIDs)))
+	for _, id := range shapeIDs {
+		if e.err != nil {
+			return
+		}
+		e.writeInt32(id)
+		s.encodeShape(e, s.shapes[id])
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cid := range s.cells {
+		if e.err != nil {
+			return
+		}
+		cid.encode(e)
+		cell := s.cellMap[cid]
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, cs := range cell.shapes {
+			e.writeInt32(cs.shapeID)
+			e.writeBool(cs.containsCenter)
+			e.writeUvarint(uint64(len(cs.edges)))
+			for _, edgeID := range cs.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+}
+
+func (s *ShapeIndex) encodeShape(e *encoder, sh Shape) {
+	switch v := sh.(type) {
+	case *Polygon:
+		e.writeUvarint(uint64(typeTagPolygon))
+		v.encodeLossless(e)
+	case *Polyline:
+		e.writeUvarint(uint64(typeTagPolyline))
+		v.encode(e)
+	case *PointVector:
+		e.writeUvarint(uint64(typeTagPointVector))
+		pts := *v
+		if len(pts) > maxEncodedVertices {
+			e.err = fmt.Errorf("too many points (%d; max is %d)", len(pts), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(len(pts)))
+		for _, pt := range pts {
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
+	case *LaxPolyline:
+		e.writeUvarint(uint64(typeTagLaxPolyline))
+		if len(v.vertices) > maxEncodedVertices {
+			e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(v.vertices), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(len(v.vertices)))
+		for _, pt := range v.vertices {
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
+	case *LaxPolygon:
+		e.writeUvarint(uint64(typeTagLaxPolygon))
+		if v.numLoops > maxEncodedLoops {
+			e.err = fmt.Errorf("too many loops (%d; max is %d)", v.numLoops, maxEncodedLoops)
+			return
+		}
+		if v.numVertices() > maxEncodedVertices {
+			e.err = fmt.Errorf("too many vertices (%d; max is %d)", v.numVertices(), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(v.numLoops))
+		for i := range v.numLoops {
+			n := v.numLoopVertices(i)
+			e.writeUvarint(uint64(n))
+			for j := range n {
+				pt := v.loopVertex(i, j)
+				e.writeFloat64(pt.X)
+				e.writeFloat64(pt.Y)
+				e.writeFloat64(pt.Z)
+			}
+		}
+	case *Loop:
+		e.writeUvarint(uint64(shapeTagLoop))
+		v.encode(e)
+	case *LaxLoop:
+		e.writeUvarint(uint64(shapeTagLaxLoop))
+		if len(v.vertices) > maxEncodedVertices {
+			e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(v.vertices), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(len(v.vertices)))
+		for _, pt := range v.vertices {
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
+	default:
+		// Generic fallback for any other Shape implementation (e.g. edgeVectorShape).
+		e.writeUvarint(uint64(typeTagNone))
+		dim := sh.Dimension()
+		e.writeUint8(uint8(dim))
+		ref := sh.ReferencePoint()
+		e.writeBool(ref.Contained)
+		e.writeFloat64(ref.Point.X)
+		e.writeFloat64(ref.Point.Y)
+		e.writeFloat64(ref.Point.Z)
+
+		numChains := sh.NumChains()
+		numEdges := sh.NumEdges()
+		if numChains > maxEncodedLoops || numEdges > maxEncodedVertices {
+			e.err = fmt.Errorf("shape too large to encode (%d chains, %d edges)", numChains, numEdges)
+			return
+		}
+		e.writeUvarint(uint64(numChains))
+		for i := range numChains {
+			c := sh.Chain(i)
+			e.writeUvarint(uint64(c.Start))
+			e.writeUvarint(uint64(c.Length))
+		}
+		e.writeUvarint(uint64(numEdges))
+		for i := range numEdges {
+			ed := sh.Edge(i)
+			e.writeFloat64(ed.V0.X)
+			e.writeFloat64(ed.V0.Y)
+			e.writeFloat64(ed.V0.Z)
+			e.writeFloat64(ed.V1.X)
+			e.writeFloat64(ed.V1.Y)
+			e.writeFloat64(ed.V1.Z)
+		}
+	}
+}
