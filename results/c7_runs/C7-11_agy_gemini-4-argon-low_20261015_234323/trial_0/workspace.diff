+// Decode decodes the ShapeIndex from the given reader.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if r == nil {
+		return fmt.Errorf("cannot decode ShapeIndex from nil reader")
+	}
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("unsupported version %d", version)
+		return
+	}
+
+	maxEdges := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if maxEdges == 0 || maxEdges > maxEncodedClippedEdges {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell %d", maxEdges)
+		return
+	}
+
+	nextID := d.readInt32()
+	if d.err != nil {
+		return
+	}
+	if nextID < 0 || nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("invalid nextID %d", nextID)
+		return
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxEncodedShapes || int64(numShapes) > int64(nextID) {
+		d.err = fmt.Errorf("too many shapes (%d; nextID is %d)", numShapes, nextID)
+		return
+	}
+
+	shapes := make(map[int32]Shape, numShapes)
+	prevShapeID := int32(-1)
+	for range numShapes {
+		id := d.readInt32()
+		if d.err != nil {
+			return
+		}
+		if id < 0 || id >= nextID || id <= prevShapeID {
+			d.err = fmt.Errorf("invalid or out-of-order shape ID %d", id)
+			return
+		}
+		prevShapeID = id
+
+		sh := s.decodeShape(d)
+		if d.err != nil {
+			return
+		}
+		shapes[id] = sh
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedShapeIndexCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedShapeIndexCells)
+		return
+	}
+
+	cells := make([]CellID, numCells)
+	cellMap := make(map[CellID]*ShapeIndexCell, numCells)
+	var prevCellID CellID
+	for i := range numCells {
+		var cid CellID
+		cid.decode(d)
+		if d.err != nil {
+			return
+		}
+		if !cid.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID %v", cid)
+			return
+		}
+		if i > 0 && cid.RangeMin() <= prevCellID.RangeMax() {
+			d.err = fmt.Errorf("cells not in strictly increasing non-overlapping order: %v after %v", cid, prevCellID)
+			return
+		}
+		prevCellID = cid
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapes || numClipped > numShapes {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; total shapes %d)", numClipped, numShapes)
+			return
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		prevClippedShapeID := int32(-1)
+		for j := range int(numClipped) {
+			shapeID := d.readInt32()
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if shapeID <= prevClippedShapeID {
+				d.err = fmt.Errorf("clipped shape IDs not in increasing order: %d after %d", shapeID, prevClippedShapeID)
+				return
+			}
+			prevClippedShapeID = shapeID
+
+			sh, ok := shapes[shapeID]
+			if !ok || sh == nil {
+				d.err = fmt.Errorf("clipped shape references unknown shape ID %d", shapeID)
+				return
+			}
+			shapeNumEdges := sh.NumEdges()
+			if numEdges > maxEncodedClippedEdges || int(numEdges) > shapeNumEdges {
+				d.err = fmt.Errorf("too many clipped edges (%d; shape has %d)", numEdges, shapeNumEdges)
+				return
+			}
+			if containsCenter && sh.Dimension() != 2 {
+				d.err = fmt.Errorf("clipped shape for non-polygon shape %d has containsCenter=true", shapeID)
+				return
+			}
+
+			cs := newClippedShape(shapeID, int(numEdges))
+			cs.containsCenter = containsCenter
+			prevEdgeID := -1
+			for k := range int(numEdges) {
+				edgeID := d.readUvarint()
+				if d.err != nil {
+					return
+				}
+				if int(edgeID) < 0 || int(edgeID) >= shapeNumEdges || int(edgeID) <= prevEdgeID {
+					d.err = fmt.Errorf("invalid or out-of-order clipped edge ID %d (shape has %d edges)", edgeID, shapeNumEdges)
+					return
+				}
+				prevEdgeID = int(edgeID)
+				cs.edges[k] = int(edgeID)
+			}
+			cell.shapes[j] = cs
+		}
+
+		cells[i] = cid
+		cellMap[cid] = cell
+	}
+
+	s.maxEdgesPerCell = int(maxEdges)
+	s.shapes = shapes
+	s.nextID = nextID
+	s.cells = cells
+	s.cellMap = cellMap
+	s.pendingAdditionsPos = nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+}
+
+func (s *ShapeIndex) decodeShape(d *decoder) Shape {
+	tag := typeTag(d.readUvarint())
+	if d.err != nil {
+		return nil
+	}
+	switch tag {
+	case typeTagPolygon:
+		p := new(Polygon)
+		version := int8(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		switch version {
+		case encodingVersion:
+			p.decode(d)
+		case encodingCompressedVersion:
+			p.decodeCompressed(d)
+		default:
+			d.err = fmt.Errorf("unsupported polygon version %d", version)
+			return nil
+		}
+		return p
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		return p
+	case typeTagPointVector:
+		n := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many points (%d; max is %d)", n, maxEncodedVertices)
+			return nil
+		}
+		pts := make(PointVector, n)
+		for i := range pts {
+			pts[i].X = d.readFloat64()
+			pts[i].Y = d.readFloat64()
+			pts[i].Z = d.readFloat64()
+			if d.err != nil {
+				return nil
+			}
+		}
+		return &pts
+	case typeTagLaxPolyline:
+		n := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+			return nil
+		}
+		pts := make([]Point, n)
+		for i := range pts {
+			pts[i].X = d.readFloat64()
+			pts[i].Y = d.readFloat64()
+			pts[i].Z = d.readFloat64()
+			if d.err != nil {
+				return nil
+			}
+		}
+		return LaxPolylineFromPoints(pts)
+	case typeTagLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numLoops > maxEncodedLoops {
+			d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+			return nil
+		}
+		loops := make([][]Point, numLoops)
+		var totalVerts uint64
+		for i := range loops {
+			n := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if n > maxEncodedVertices || totalVerts+n > maxEncodedVertices {
+				d.err = fmt.Errorf("too many vertices in LaxPolygon (%d; max is %d)", totalVerts+n, maxEncodedVertices)
+				return nil
+			}
+			totalVerts += n
+			pts := make([]Point, n)
+			for j := range pts {
+				pts[j].X = d.readFloat64()
+				pts[j].Y = d.readFloat64()
+				pts[j].Z = d.readFloat64()
+				if d.err != nil {
+					return nil
+				}
+			}
+			loops[i] = pts
+		}
+		return LaxPolygonFromPoints(loops)
+	case shapeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		return l
+	case shapeTagLaxLoop:
+		n := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+			return nil
+		}
+		pts := make([]Point, n)
+		for i := range pts {
+			pts[i].X = d.readFloat64()
+			pts[i].Y = d.readFloat64()
+			pts[i].Z = d.readFloat64()
+			if d.err != nil {
+				return nil
+			}
+		}
+		return LaxLoopFromPoints(pts)
+	case typeTagNone:
+		dim := int(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		if dim < 0 || dim > 2 {
+			d.err = fmt.Errorf("invalid shape dimension %d", dim)
+			return nil
+		}
+		var ref ReferencePoint
+		ref.Contained = d.readBool()
+		ref.Point.X = d.readFloat64()
+		ref.Point.Y = d.readFloat64()
+		ref.Point.Z = d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+
+		numChains := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numChains > maxEncodedLoops {
+			d.err = fmt.Errorf("too many chains (%d; max is %d)", numChains, maxEncodedLoops)
+			return nil
+		}
+		chains := make([]Chain, numChains)
+		for i := range chains {
+			start := d.readUvarint()
+			length := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if start > maxEncodedVertices || length > maxEncodedVertices {
+				d.err = fmt.Errorf("invalid chain start %d or length %d", start, length)
+				return nil
+			}
+			chains[i] = Chain{Start: int(start), Length: int(length)}
+		}
+
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > maxEncodedVertices {
+			d.err = fmt.Errorf("too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+			return nil
+		}
+		for i, c := range chains {
+			if c.Start < 0 || c.Length < 0 || c.Start+c.Length > int(numEdges) {
+				d.err = fmt.Errorf("chain %d out of bounds (start %d, length %d, numEdges %d)", i, c.Start, c.Length, numEdges)
+				return nil
+			}
+			if i == 0 && c.Start != 0 {
+				d.err = fmt.Errorf("chain 0 must start at 0, got %d", c.Start)
+				return nil
+			}
+			if i > 0 && c.Start != chains[i-1].Start+chains[i-1].Length {
+				d.err = fmt.Errorf("chain %d start %d does not match previous chain end %d", i, c.Start, chains[i-1].Start+chains[i-1].Length)
+				return nil
+			}
+			if i == len(chains)-1 && c.Start+c.Length != int(numEdges) {
+				d.err = fmt.Errorf("last chain end %d does not match numEdges %d", c.Start+c.Length, numEdges)
+				return nil
+			}
+		}
+		if len(chains) == 0 && numEdges > 0 {
+			d.err = fmt.Errorf("shape has %d edges but 0 chains", numEdges)
+			return nil
+		}
+
+		edges := make([]Edge, numEdges)
+		for i := range edges {
+			edges[i].V0.X = d.readFloat64()
+			edges[i].V0.Y = d.readFloat64()
+			edges[i].V0.Z = d.readFloat64()
+			edges[i].V1.X = d.readFloat64()
+			edges[i].V1.Y = d.readFloat64()
+			edges[i].V1.Z = d.readFloat64()
+			if d.err != nil {
+				return nil
+			}
+		}
+		return &decodedGenericShape{
+			dim:    dim,
+			ref:    ref,
+			chains: chains,
+			edges:  edges,
+		}
+	default:
+		d.err = fmt.Errorf("unsupported shape type tag %d", tag)
+		return nil
+	}
+}
+
+type decodedGenericShape struct {
+	dim    int
+	ref    ReferencePoint
+	chains []Chain
+	edges  []Edge
+}
+
+func (s *decodedGenericShape) NumEdges() int                  { return len(s.edges) }
+func (s *decodedGenericShape) Edge(i int) Edge                { return s.edges[i] }
+func (s *decodedGenericShape) ReferencePoint() ReferencePoint { return s.ref }
+func (s *decodedGenericShape) NumChains() int                 { return len(s.chains) }
+func (s *decodedGenericShape) Chain(chainID int) Chain        { return s.chains[chainID] }
+func (s *decodedGenericShape) ChainEdge(chainID, offset int) Edge {
+	return s.edges[s.chains[chainID].Start+offset]
+}
+func (s *decodedGenericShape) ChainPosition(edgeID int) ChainPosition {
+	// Binary search for the first chain whose Start + Length > edgeID.
+	i := sort.Search(len(s.chains), func(i int) bool {
+		return s.chains[i].Start+s.chains[i].Length > edgeID
+	})
+	if i >= len(s.chains) {
+		i = max(0, len(s.chains)-1)
+	}
+	return ChainPosition{ChainID: i, Offset: edgeID - s.chains[i].Start}
+}
+func (s *decodedGenericShape) Dimension() int    { return s.dim }
+func (s *decodedGenericShape) IsEmpty() bool     { return defaultShapeIsEmpty(s) }
+func (s *decodedGenericShape) IsFull() bool      { return defaultShapeIsFull(s) }
+func (s *decodedGenericShape) typeTag() typeTag  { return typeTagNone }
+func (s *decodedGenericShape) privateInterface() {}
