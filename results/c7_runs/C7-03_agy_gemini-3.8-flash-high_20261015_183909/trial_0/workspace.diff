+                    Prefetch('house', queryset=House.objects.only('address'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            house = queryset.first()
+        self.assertIn('address', house.get_deferred_fields())
+        room_house = house.rooms.all()[0].house
+        self.assertIn('name', room_house.get_deferred_fields())
+        self.assertNotIn('address', room_house.get_deferred_fields())
+        with self.assertNumQueries(0):
+            self.assertEqual(room_house.address, '123 Main St')
+        with self.assertNumQueries(1):
+            self.assertEqual(room_house.name, 'House 1')
+
+        # OneToOne forward, then ReverseOneToOne back
+        queryset = House.objects.only('name', 'main_room').prefetch_related(
+            Prefetch(
+                'main_room',
+                queryset=Room.objects.prefetch_related(
+                    Prefetch('main_room_of', queryset=House.objects.only('address', 'main_room'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            house = queryset.first()
+        self.assertIn('address', house.get_deferred_fields())
+        inner_house = house.main_room.main_room_of
+        self.assertIn('name', inner_house.get_deferred_fields())
+        self.assertNotIn('address', inner_house.get_deferred_fields())
+        with self.assertNumQueries(0):
+            self.assertEqual(inner_house.address, '123 Main St')
+        with self.assertNumQueries(1):
+            self.assertEqual(inner_house.name, 'House 1')
+
+        # ReverseOneToOne, then OneToOne forward back
+        queryset = Room.objects.filter(main_room_of__isnull=False).only('name').prefetch_related(
+            Prefetch(
+                'main_room_of',
+                queryset=House.objects.prefetch_related(
+                    Prefetch('main_room', queryset=Room.objects.only('name'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            room = queryset.first()
