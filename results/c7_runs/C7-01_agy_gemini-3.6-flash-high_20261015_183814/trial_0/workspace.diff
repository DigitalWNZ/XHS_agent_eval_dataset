index 00000000..e6798ad9
--- /dev/null
+++ b/drizzle-orm/src/sql/expressions/window.ts
@@ -0,0 +1,324 @@
+import type { AnyColumn } from '~/column.ts';
+import { Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { SQL, SQLWrapper } from '../sql.ts';
+import { sql } from '../sql.ts';
+
+export interface FrameBoundary {
+	readonly type: 'unboundedPreceding' | 'currentRow' | 'unboundedFollowing' | 'preceding' | 'following';
+	readonly position: number;
+	getSQL(): SQL;
+}
+
+class UnboundedPrecedingBoundary implements FrameBoundary, SQLWrapper {
+	static readonly [entityKind]: string = 'UnboundedPrecedingBoundary';
+	readonly type = 'unboundedPreceding' as const;
+	readonly position = -Infinity;
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+	getSQL(): SQL {
+		return sql`unbounded preceding`;
+	}
+}
+
+class CurrentRowBoundary implements FrameBoundary, SQLWrapper {
+	static readonly [entityKind]: string = 'CurrentRowBoundary';
+	readonly type = 'currentRow' as const;
+	readonly position = 0;
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+	getSQL(): SQL {
+		return sql`current row`;
+	}
+}
+
+class UnboundedFollowingBoundary implements FrameBoundary, SQLWrapper {
+	static readonly [entityKind]: string = 'UnboundedFollowingBoundary';
+	readonly type = 'unboundedFollowing' as const;
+	readonly position = Infinity;
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+	getSQL(): SQL {
+		return sql`unbounded following`;
+	}
+}
+
+class RelativeBoundary implements FrameBoundary, SQLWrapper {
+	static readonly [entityKind]: string = 'RelativeBoundary';
+	constructor(
+		readonly type: 'preceding' | 'following',
+		readonly offset: number,
+	) {
+		if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+			throw new Error(`${type} expects a non-negative integer, received ${offset}`);
+		}
+	}
+
+	get position(): number {
+		return this.type === 'preceding' ? -this.offset : this.offset;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(String(this.offset))} ${sql.raw(this.type)}`;
+	}
+}
+
+export const unboundedPreceding: FrameBoundary = new UnboundedPrecedingBoundary();
+export const currentRow: FrameBoundary = new CurrentRowBoundary();
+export const unboundedFollowing: FrameBoundary = new UnboundedFollowingBoundary();
+
+export function preceding(offset: number): FrameBoundary {
+	return new RelativeBoundary('preceding', offset);
+}
+
+export function following(offset: number): FrameBoundary {
+	return new RelativeBoundary('following', offset);
+}
+
+export class Frame implements SQLWrapper {
+	static readonly [entityKind]: string = 'Frame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly from: FrameBoundary,
+		readonly to?: FrameBoundary,
+	) {
+		if (to !== undefined && from.position > to.position) {
+			throw new Error("Invalid frame specification: 'from' boundary cannot be ordered after 'to' boundary");
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		if (this.to !== undefined) {
+			return sql`${sql.raw(this.type)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.from.getSQL()}`;
+	}
+}
+
+export function rows(spec: { from: FrameBoundary; to?: FrameBoundary }): Frame {
+	return new Frame('rows', spec.from, spec.to);
+}
+
+export function range(spec: { from: FrameBoundary; to?: FrameBoundary }): Frame {
+	return new Frame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: SQLWrapper | Frame;
+}
+
+export class WindowBuilder<TValue = unknown> {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	constructor(readonly windowSql: SQL<TValue>) {}
+
+	over(spec?: WindowSpec | string): SQL<TValue> {
+		let res: SQL<TValue>;
+		if (typeof spec === 'string') {
+			res = sql`${this.windowSql} over ${sql.identifier(spec)}`;
+		} else if (!spec || (spec.partitionBy === undefined && spec.orderBy === undefined && spec.frame === undefined)) {
+			res = sql`${this.windowSql} over ()`;
+		} else {
+			const chunks: SQL[] = [];
+
+			if (spec.partitionBy) {
+				const pb = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+				if (pb.length > 0) {
+					chunks.push(sql`partition by ${sql.join(pb, sql`, `)}`);
+				}
+			}
+
+			if (spec.orderBy) {
+				const ob = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+				if (ob.length > 0) {
+					chunks.push(sql`order by ${sql.join(ob, sql`, `)}`);
+				}
+			}
+
+			if (spec.frame) {
+				chunks.push(sql`${spec.frame}`);
+			}
+
+			if (chunks.length === 0) {
+				res = sql`${this.windowSql} over ()`;
+			} else {
+				res = sql`${this.windowSql} over (${sql.join(chunks, sql` `)})`;
+			}
+		}
+
+		if (this.windowSql.decoder) {
+			res.decoder = this.windowSql.decoder;
+		}
+
+		return res;
+	}
+}
+
+export type SelectedDataType<T> = T extends Column ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+// Ranking helpers
+export function rowNumber(): WindowBuilder<number> {
+	return new WindowBuilder(sql`row_number()`.mapWith(Number));
+}
+
+export function rank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`rank()`.mapWith(Number));
+}
+
+export function denseRank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`dense_rank()`.mapWith(Number));
+}
+
+export function ntile(n: number): WindowBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile requires a positive integer argument, received: ${n}`);
+	}
+	return new WindowBuilder(sql`ntile(${sql.raw(String(n))})`.mapWith(Number));
+}
+
+export function percentRank(): WindowBuilder<string> {
+	return new WindowBuilder(sql`percent_rank()`.mapWith(String));
+}
+
+export function cumeDist(): WindowBuilder<string> {
+	return new WindowBuilder(sql`cume_dist()`.mapWith(String));
+}
+
+// Offset helpers
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowBuilder<SelectedDataType<T> | null>;
+export function lag<T extends SQLWrapper, D>(
+	expression: T,
+	offset: number,
+	defaultValue: D,
+): WindowBuilder<NonNullable<SelectedDataType<T>> | (D extends SQLWrapper ? SelectedDataType<D> : D)>;
+export function lag(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowBuilder<any> {
+	let s: SQL;
+	if (offset !== undefined) {
+		if (defaultValue !== undefined) {
+			s = sql`lag(${expression}, ${sql.raw(String(offset))}, ${defaultValue})`;
+		} else {
+			s = sql`lag(${expression}, ${sql.raw(String(offset))})`;
+		}
+	} else {
+		s = sql`lag(${expression})`;
+	}
+	if (is(expression, Column)) {
+		s.mapWith(expression);
+	}
+	return new WindowBuilder(s);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowBuilder<SelectedDataType<T> | null>;
+export function lead<T extends SQLWrapper, D>(
+	expression: T,
+	offset: number,
+	defaultValue: D,
+): WindowBuilder<NonNullable<SelectedDataType<T>> | (D extends SQLWrapper ? SelectedDataType<D> : D)>;
+export function lead(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowBuilder<any> {
+	let s: SQL;
+	if (offset !== undefined) {
+		if (defaultValue !== undefined) {
+			s = sql`lead(${expression}, ${sql.raw(String(offset))}, ${defaultValue})`;
+		} else {
+			s = sql`lead(${expression}, ${sql.raw(String(offset))})`;
+		}
+	} else {
+		s = sql`lead(${expression})`;
+	}
+	if (is(expression, Column)) {
+		s.mapWith(expression);
+	}
+	return new WindowBuilder(s);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<SelectedDataType<T> | null> {
+	const s = sql`first_value(${expression})`;
+	if (is(expression, Column)) {
+		s.mapWith(expression);
+	}
+	return new WindowBuilder(s as any);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<SelectedDataType<T> | null> {
+	const s = sql`last_value(${expression})`;
+	if (is(expression, Column)) {
+		s.mapWith(expression);
+	}
+	return new WindowBuilder(s as any);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowBuilder<SelectedDataType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue requires a positive integer argument, received: ${n}`);
+	}
+	const s = sql`nth_value(${expression}, ${sql.raw(String(n))})`;
+	if (is(expression, Column)) {
+		s.mapWith(expression);
+	}
+	return new WindowBuilder(s as any);
+}
+
+// Aggregates
+export function windowSum(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`sum(${expression})`.mapWith(String));
+}
+
+export function windowAvg(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`avg(${expression})`.mapWith(String));
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const s = sql`min(${expression})`.mapWith(is(expression, Column) ? expression : String);
+	return new WindowBuilder(s as any);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const s = sql`max(${expression})`.mapWith(is(expression, Column) ? expression : String);
+	return new WindowBuilder(s as any);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowBuilder<number> {
+	return new WindowBuilder(sql`count(${expression || sql.raw('*')})`.mapWith(Number));
+}
