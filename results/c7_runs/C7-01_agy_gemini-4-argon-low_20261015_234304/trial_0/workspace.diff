new file mode 100644
index 00000000..cff3c5be
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,462 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, noopDecoder, SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameBoundType =
+	| 'unbounded preceding'
+	| 'preceding'
+	| 'current row'
+	| 'following'
+	| 'unbounded following';
+
+export class WindowFrameBound {
+	static readonly [entityKind]: string = 'WindowFrameBound';
+
+	constructor(
+		readonly type: WindowFrameBoundType,
+		readonly offset?: number,
+	) {}
+}
+
+export const unboundedPreceding = new WindowFrameBound('unbounded preceding');
+export const currentRow = new WindowFrameBound('current row');
+export const unboundedFollowing = new WindowFrameBound('unbounded following');
+
+export function preceding(offset: number): WindowFrameBound {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() expects a non-negative integer, received: ${offset}`);
+	}
+	return new WindowFrameBound('preceding', offset);
+}
+
+export function following(offset: number): WindowFrameBound {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() expects a non-negative integer, received: ${offset}`);
+	}
+	return new WindowFrameBound('following', offset);
+}
+
+export type WindowFrameMode = 'rows' | 'range';
+
+export interface WindowFrameBounds {
+	from: WindowFrameBound;
+	to?: WindowFrameBound;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	readonly from: WindowFrameBound;
+	readonly to: WindowFrameBound;
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		bounds: WindowFrameBounds | WindowFrameBound,
+	) {
+		if (is(bounds, WindowFrameBound)) {
+			this.from = bounds;
+			this.to = currentRow;
+		} else {
+			this.from = bounds.from;
+			this.to = bounds.to ?? currentRow;
+		}
+		validateFrameBounds(mode, this.from, this.to);
+	}
+
+	getSQL(): SQL {
+		return sql.raw(`${this.mode} between ${formatFrameBound(this.from)} and ${formatFrameBound(this.to)}`);
+	}
+}
+
+function getBoundOrder(bound: WindowFrameBound): number {
+	switch (bound.type) {
+		case 'unbounded preceding':
+			return 0;
+		case 'preceding':
+			return 1;
+		case 'current row':
+			return 2;
+		case 'following':
+			return 3;
+		case 'unbounded following':
+			return 4;
+	}
+}
+
+function validateFrameBounds(mode: WindowFrameMode, from: WindowFrameBound, to: WindowFrameBound): void {
+	if (!is(from, WindowFrameBound)) {
+		throw new Error(`${mode}() requires a valid "from" frame boundary`);
+	}
+	if (!is(to, WindowFrameBound)) {
+		throw new Error(`${mode}() requires a valid "to" frame boundary`);
+	}
+	const fromOrder = getBoundOrder(from);
+	const toOrder = getBoundOrder(to);
+	if (fromOrder > toOrder) {
+		throw new Error(
+			`${mode}() invalid frame bounds: "from" (${formatFrameBound(from)}) cannot be ordered after "to" (${
+				formatFrameBound(to)
+			})`,
+		);
+	}
+	if (from.type === 'unbounded following') {
+		throw new Error(
+			`${mode}() invalid frame bounds: "from" cannot be unbounded following`,
+		);
+	}
+	if (to.type === 'unbounded preceding') {
+		throw new Error(
+			`${mode}() invalid frame bounds: "from" (${formatFrameBound(from)}) cannot be ordered after "to" (unbounded preceding)`,
+		);
+	}
+	if (from.type === 'preceding' && to.type === 'preceding' && from.offset! < to.offset!) {
+		throw new Error(
+			`${mode}() invalid frame bounds: "from" (${formatFrameBound(from)}) cannot be ordered after "to" (${
+				formatFrameBound(to)
+			})`,
+		);
+	}
+	if (from.type === 'following' && to.type === 'following' && from.offset! > to.offset!) {
+		throw new Error(
+			`${mode}() invalid frame bounds: "from" (${formatFrameBound(from)}) cannot be ordered after "to" (${
+				formatFrameBound(to)
+			})`,
+		);
+	}
+}
+
+function formatFrameBound(bound: WindowFrameBound): string {
+	switch (bound.type) {
+		case 'unbounded preceding':
+			return 'unbounded preceding';
+		case 'preceding':
+			return `${bound.offset} preceding`;
+		case 'current row':
+			return 'current row';
+		case 'following':
+			return `${bound.offset} following`;
+		case 'unbounded following':
+			return 'unbounded following';
+	}
+}
+
+export function rows(bounds: WindowFrameBounds | WindowFrameBound): WindowFrame {
+	return new WindowFrame('rows', bounds);
+}
+
+export function range(bounds: WindowFrameBounds | WindowFrameBound): WindowFrame {
+	return new WindowFrame('range', bounds);
+}
+
+export type WindowSpecInput = AnyColumn | SQL | SQL.Aliased | SQLWrapper;
+
+export interface WindowSpec {
+	partitionBy?: WindowSpecInput | WindowSpecInput[];
+	orderBy?: WindowSpecInput | WindowSpecInput[];
+	frame?: WindowFrame;
+}
+
+export interface NamedWindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot be whitespace-only');
+	}
+}
+
+export function buildWindowSpecSQL(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionItems = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionItems.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionItems, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderItems = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderItems.length > 0) {
+			parts.push(sql`order by ${sql.join(orderItems, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		parts.push(spec.frame.getSQL());
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function buildWindowClause(windows: NamedWindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	const defs = windows.map(({ name, spec }) => {
+		const specSql = buildWindowSpecSQL(spec);
+		return sql`${sql.identifier(name)} as (${specSql})`;
+	});
+
+	return sql` window ${sql.join(defs, sql`, `)}`;
+}
+
+export class WindowFunction<T = unknown> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare _: {
+		brand: 'WindowFunction';
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder: DriverValueDecoder<T, any> = noopDecoder,
+	) {}
+
+	over(specOrName?: WindowSpec | string): SQL<T> {
+		if (typeof specOrName === 'string') {
+			validateWindowName(specOrName);
+			return sql<T>`${this.fnSql} over ${sql.identifier(specOrName)}`.mapWith(this.decoder);
+		}
+
+		const specSql = buildWindowSpecSQL(specOrName);
+		return sql<T>`${this.fnSql} over (${specSql})`.mapWith(this.decoder);
+	}
+
+	getSQL(): SQL<T> {
+		return this.over();
+	}
+}
+
+export type GetWindowValueData<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: T extends SQLWrapper ? unknown
+	: T;
+
+function getExpressionDecoder(expression: unknown): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+function toValueChunk(value: unknown, referenceExpr?: unknown): SQL {
+	if (typeof value === 'number') {
+		if (!Number.isFinite(value)) {
+			throw new Error(`Invalid numeric value in window function: ${value}`);
+		}
+		return sql.raw(String(value));
+	}
+	if (value === null) {
+		return sql.raw('null');
+	}
+	if (is(value, Column) || is(value, SQL) || is(value, SQL.Aliased)) {
+		return sql`${value}`;
+	}
+	if (value !== null && value !== undefined && typeof (value as any).getSQL === 'function') {
+		return (value as SQLWrapper).getSQL();
+	}
+	if (is(referenceExpr, Column)) {
+		return sql`${sql.param(value, referenceExpr)}`;
+	}
+	return sql`${value}`;
+}
+
+function validatePositiveInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 1) {
+		throw new Error(`${fnName}() expects a positive integer (>= 1), received: ${value}`);
+	}
+}
+
+function validateOffsetInteger(fnName: string, offset: number): void {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`${fnName}() offset must be a non-negative integer, received: ${offset}`);
+	}
+}
+
+// ==================== Ranking Helpers ====================
+
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`row_number()`, { mapFromDriverValue: Number });
+}
+
+export function rank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`rank()`, { mapFromDriverValue: Number });
+}
+
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`dense_rank()`, { mapFromDriverValue: Number });
+}
+
+export function ntile(buckets: number): WindowFunction<number> {
+	validatePositiveInteger('ntile', buckets);
+	return new WindowFunction<number>(sql`ntile(${sql.raw(String(buckets))})`, { mapFromDriverValue: Number });
+}
+
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`percent_rank()`, { mapFromDriverValue: Number });
+}
+
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`cume_dist()`, { mapFromDriverValue: Number });
+}
+
+// ==================== Offset / Value Helpers ====================
+
+export function lag<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowValueData<T> | null>;
+export function lag<
+	T extends SQLWrapper | AnyColumn,
+	TDefault extends GetWindowValueData<T> | SQLWrapper | AnyColumn | null,
+>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	null extends TDefault ? GetWindowValueData<T> | null : NonNullable<GetWindowValueData<T>>
+>;
+export function lag(
+	expression: SQLWrapper | AnyColumn,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (arguments.length >= 3 && defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		validateOffsetInteger('lag', resolvedOffset);
+		const defaultChunk = toValueChunk(defaultValue, expression);
+		return new WindowFunction(
+			sql`lag(${expression}, ${sql.raw(String(resolvedOffset))}, ${defaultChunk})`,
+			decoder,
+		);
+	}
+	if (offset !== undefined) {
+		validateOffsetInteger('lag', offset);
+		return new WindowFunction(
+			sql`lag(${expression}, ${sql.raw(String(offset))})`,
+			decoder,
+		);
+	}
+	return new WindowFunction(sql`lag(${expression})`, decoder);
+}
+
+export function lead<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowValueData<T> | null>;
+export function lead<
+	T extends SQLWrapper | AnyColumn,
+	TDefault extends GetWindowValueData<T> | SQLWrapper | AnyColumn | null,
+>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	null extends TDefault ? GetWindowValueData<T> | null : NonNullable<GetWindowValueData<T>>
+>;
+export function lead(
+	expression: SQLWrapper | AnyColumn,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (arguments.length >= 3 && defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		validateOffsetInteger('lead', resolvedOffset);
+		const defaultChunk = toValueChunk(defaultValue, expression);
+		return new WindowFunction(
+			sql`lead(${expression}, ${sql.raw(String(resolvedOffset))}, ${defaultChunk})`,
+			decoder,
+		);
+	}
+	if (offset !== undefined) {
+		validateOffsetInteger('lead', offset);
+		return new WindowFunction(
+			sql`lead(${expression}, ${sql.raw(String(offset))})`,
+			decoder,
+		);
+	}
+	return new WindowFunction(sql`lead(${expression})`, decoder);
+}
+
+export function firstValue<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+): WindowFunction<GetWindowValueData<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, getExpressionDecoder(expression));
+}
+
+export function lastValue<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+): WindowFunction<GetWindowValueData<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, getExpressionDecoder(expression));
+}
+
+export function nthValue<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+	n: number,
+): WindowFunction<GetWindowValueData<T> | null> {
+	validatePositiveInteger('nthValue', n);
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+// ==================== Window Aggregate Helpers ====================
+
+export function windowSum(expression: SQLWrapper | AnyColumn): WindowFunction<string | null> {
+	return new WindowFunction<string | null>(sql`sum(${expression})`, { mapFromDriverValue: String });
+}
+
+export function windowAvg(expression: SQLWrapper | AnyColumn): WindowFunction<string | null> {
+	return new WindowFunction<string | null>(sql`avg(${expression})`, { mapFromDriverValue: String });
+}
+
+export function windowMin<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : T extends SQL<infer U> ? U : T extends SQL.Aliased<infer U> ? U : string) | null> {
+	return new WindowFunction(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	) as any;
+}
+
+export function windowMax<T extends SQLWrapper | AnyColumn>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : T extends SQL<infer U> ? U : T extends SQL.Aliased<infer U> ? U : string) | null> {
+	return new WindowFunction(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	) as any;
+}
+
+export function windowCount(expression?: SQLWrapper | AnyColumn): WindowFunction<number> {
+	return new WindowFunction<number>(
+		sql`count(${expression || sql.raw('*')})`,
+		{ mapFromDriverValue: Number },
+	);
+}
