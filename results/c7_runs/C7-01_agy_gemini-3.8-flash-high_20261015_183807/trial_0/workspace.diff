+	offset?: number | SQLWrapper,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<
+	[TDefault] extends [undefined] ? (InferExpressionType<T> | null) : Exclude<InferExpressionType<T>, null>
+>;
+export function lag(
+	value: SQLWrapper,
+	offset?: number | SQLWrapper,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	const valueChunk = isSQLWrapper(value) ? value.getSQL() : value;
+	let fnSql: SQL;
+
+	if (defaultValue !== undefined) {
+		const offsetChunk = offset !== undefined ? toPositionalArgChunk(offset) : sql.raw('1');
+		const defaultChunk = toPositionalArgChunk(defaultValue);
+		fnSql = sql`lag(${valueChunk}, ${offsetChunk}, ${defaultChunk})`;
+	} else if (offset !== undefined) {
+		const offsetChunk = toPositionalArgChunk(offset);
+		fnSql = sql`lag(${valueChunk}, ${offsetChunk})`;
+	} else {
+		fnSql = sql`lag(${valueChunk})`;
+	}
+
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(fnSql, decoder);
+}
+
+export function lead<T extends SQLWrapper>(
+	value: T,
+	offset?: number | SQLWrapper,
