diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..088fa9a5
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,381 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import type { DriverValueDecoder, SQLWrapper } from '../sql.ts';
+import { isSQLWrapper, type SQL, sql } from '../sql.ts';
+
+export interface SelectedWindow {
+	name: string;
+	spec: WindowSpec | SQLWrapper | string;
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<SQLWrapper | AnyColumn | SQL.Aliased>;
+	orderBy?: ValueOrArray<SQLWrapper | AnyColumn | SQL.Aliased>;
+	frame?: Frame | SQLWrapper;
+}
+
+export interface FrameBoundary extends SQLWrapper {
+	readonly type: 'unbounded-preceding' | 'preceding' | 'current-row' | 'following' | 'unbounded-following';
+	readonly value?: number;
+	readonly offsetOrder: number;
+	getSQL(): SQL;
+}
+
+export class FrameBoundaryImpl implements FrameBoundary {
+	static readonly [entityKind]: string = 'FrameBoundary';
+
+	constructor(
+		readonly type: 'unbounded-preceding' | 'preceding' | 'current-row' | 'following' | 'unbounded-following',
+		readonly offsetOrder: number,
+		readonly value?: number,
+	) {}
+
+	getSQL(): SQL {
+		switch (this.type) {
+			case 'unbounded-preceding':
+				return sql`unbounded preceding`;
+			case 'preceding':
+				return sql`${sql.raw(this.value!.toString())} preceding`;
+			case 'current-row':
+				return sql`current row`;
+			case 'following':
+				return sql`${sql.raw(this.value!.toString())} following`;
+			case 'unbounded-following':
+				return sql`unbounded following`;
+		}
+	}
+}
+
+export const unboundedPreceding: FrameBoundary = new FrameBoundaryImpl('unbounded-preceding', -Infinity);
+export const currentRow: FrameBoundary = new FrameBoundaryImpl('current-row', 0);
+export const unboundedFollowing: FrameBoundary = new FrameBoundaryImpl('unbounded-following', Infinity);
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding expects a non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundaryImpl('preceding', -offset, offset);
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following expects a non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundaryImpl('following', offset, offset);
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class Frame implements SQLWrapper {
+	static readonly [entityKind]: string = 'Frame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly from: FrameBoundary,
+		readonly to?: FrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		if (this.to) {
+			return sql`${sql.raw(this.type)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.from.getSQL()}`;
+	}
+}
+
+function checkFrameSpec(spec: FrameSpec): void {
+	if (!spec || !spec.from) {
+		throw new Error("Frame specification must include a 'from' boundary");
+	}
+	if (spec.to !== undefined && spec.from.offsetOrder > spec.to.offsetOrder) {
+		throw new Error(`Invalid frame: 'from' boundary cannot be ordered after 'to' boundary`);
+	}
+}
+
+export function rows(spec: FrameSpec): Frame {
+	checkFrameSpec(spec);
+	return new Frame('rows', spec.from, spec.to);
+}
+
+export function range(spec: FrameSpec): Frame {
+	checkFrameSpec(spec);
+	return new Frame('range', spec.from, spec.to);
+}
+
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be non-empty');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot be whitespace-only');
+	}
+}
+
+export function buildWindowSpec(spec: WindowSpec): SQL {
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitions = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitions.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitions, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orders = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orders.length > 0) {
+			parts.push(sql`order by ${sql.join(orders, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		parts.push(isSQLWrapper(spec.frame) ? spec.frame.getSQL() : (spec.frame as unknown as SQL));
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function buildWindowDefinition(name: string, spec: WindowSpec | SQLWrapper | string): SQL {
+	validateWindowName(name);
+	if (typeof spec === 'string') {
+		validateWindowName(spec);
+		return sql`${sql.identifier(name)} as (${sql.identifier(spec)})`;
+	}
+	if (isSQLWrapper(spec)) {
+		return sql`${sql.identifier(name)} as (${spec.getSQL()})`;
+	}
+	const specSql = buildWindowSpec(spec);
+	return sql`${sql.identifier(name)} as (${specSql})`;
+}
+
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare _: {
+		brand: 'WindowFunctionBuilder';
+		type: T;
+	};
+
+	constructor(
+		private readonly sqlChunk: SQL,
+		private readonly decoder?:
+			| DriverValueDecoder<any, any>
+			| DriverValueDecoder<any, any>['mapFromDriverValue']
+			| undefined,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			const query = sql`${this.sqlChunk} over ${sql.identifier(spec)}`;
+			if (this.decoder) {
+				query.mapWith(this.decoder as any);
+			}
+			return query as SQL<T>;
+		}
+
+		const windowSpecSql = spec ? buildWindowSpec(spec) : sql.empty();
+		const overClause = windowSpecSql.queryChunks.length > 0 ? sql`over (${windowSpecSql})` : sql`over ()`;
+		const query = sql`${this.sqlChunk} ${overClause}`;
+		if (this.decoder) {
+			query.mapWith(this.decoder as any);
+		}
+		return query as SQL<T>;
+	}
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number | SQLWrapper): WindowFunctionBuilder<number> {
+	if (typeof n === 'number' && (!Number.isInteger(n) || n <= 0)) {
+		throw new Error(`ntile: argument must be a positive integer, received ${n}`);
+	}
+	const nChunk = typeof n === 'number' ? sql.raw(n.toString()) : (isSQLWrapper(n) ? n.getSQL() : n);
+	return new WindowFunctionBuilder(sql`ntile(${nChunk})`, Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`cume_dist()`, Number);
+}
+
+export type InferExpressionType<T> = T extends Column ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQLWrapper ? unknown
+	: any;
+
+function toPositionalArgChunk(arg: unknown): SQL | unknown {
+	if (typeof arg === 'number') {
+		return sql.raw(arg.toString());
+	}
+	if (isSQLWrapper(arg)) {
+		return arg.getSQL();
+	}
+	return arg;
+}
+
+export function lag<T extends SQLWrapper>(
+	value: T,
+	offset?: number | SQLWrapper,
