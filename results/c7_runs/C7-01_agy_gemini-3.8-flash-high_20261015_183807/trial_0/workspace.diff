+	offset?: number | SQLWrapper,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<
+	[TDefault] extends [undefined] ? (InferExpressionType<T> | null) : Exclude<InferExpressionType<T>, null>
+>;
+export function lead(
+	value: SQLWrapper,
+	offset?: number | SQLWrapper,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	const valueChunk = isSQLWrapper(value) ? value.getSQL() : value;
+	let fnSql: SQL;
+
+	if (defaultValue !== undefined) {
+		const offsetChunk = offset !== undefined ? toPositionalArgChunk(offset) : sql.raw('1');
+		const defaultChunk = toPositionalArgChunk(defaultValue);
+		fnSql = sql`lead(${valueChunk}, ${offsetChunk}, ${defaultChunk})`;
+	} else if (offset !== undefined) {
+		const offsetChunk = toPositionalArgChunk(offset);
+		fnSql = sql`lead(${valueChunk}, ${offsetChunk})`;
+	} else {
+		fnSql = sql`lead(${valueChunk})`;
+	}
+
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(fnSql, decoder);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<InferExpressionType<T> | null> {
+	const valueChunk = isSQLWrapper(value) ? value.getSQL() : value;
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(sql`first_value(${valueChunk})`, decoder) as any;
+}
+
+export function lastValue<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<InferExpressionType<T> | null> {
+	const valueChunk = isSQLWrapper(value) ? value.getSQL() : value;
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(sql`last_value(${valueChunk})`, decoder) as any;
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	n: number | SQLWrapper,
+): WindowFunctionBuilder<InferExpressionType<T> | null> {
+	if (typeof n === 'number' && (!Number.isInteger(n) || n <= 0)) {
+		throw new Error(`nthValue: argument must be a positive integer, received ${n}`);
+	}
+	const valueChunk = isSQLWrapper(value) ? value.getSQL() : value;
+	const nChunk = typeof n === 'number' ? sql.raw(n.toString()) : (isSQLWrapper(n) ? n.getSQL() : n);
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(sql`nth_value(${valueChunk}, ${nChunk})`, decoder) as any;
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	const exprChunk = isSQLWrapper(expression) ? expression.getSQL() : expression;
+	return new WindowFunctionBuilder(sql`sum(${exprChunk})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	const exprChunk = isSQLWrapper(expression) ? expression.getSQL() : expression;
+	return new WindowFunctionBuilder(sql`avg(${exprChunk})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const exprChunk = isSQLWrapper(expression) ? expression.getSQL() : expression;
+	return new WindowFunctionBuilder(
+		sql`min(${exprChunk})`,
+		is(expression, Column) ? expression : String,
+	) as any;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const exprChunk = isSQLWrapper(expression) ? expression.getSQL() : expression;
+	return new WindowFunctionBuilder(
+		sql`max(${exprChunk})`,
+		is(expression, Column) ? expression : String,
+	) as any;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	if (expression === undefined) {
+		return new WindowFunctionBuilder(sql`count(*)`, Number);
+	}
+	const exprChunk = isSQLWrapper(expression) ? expression.getSQL() : expression;
+	return new WindowFunctionBuilder(sql`count(${exprChunk})`, Number);
+}
