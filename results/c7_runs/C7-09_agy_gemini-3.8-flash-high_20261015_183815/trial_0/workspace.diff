+		require.NotNil(t, p1.spec.consistentHash)
+		assert.False(t, p1.spec.consistentHash.disable)
+		require.Len(t, p1.spec.consistentHash.headers, 1)
+		assert.Equal(t, "x-foo", p1.spec.consistentHash.headers[0].HeaderName)
+	})
+
+	t.Run("merged result produces hash policies in canonical type order", func(t *testing.T) {
+		p1 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					queryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q1"}},
+				},
+			},
+		}
+		p2 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-foo"}},
+				},
+			},
+		}
+
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, ref2, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		policies := p1.spec.consistentHash.buildHashPolicies()
+		require.Len(t, policies, 2)
+		// Headers must come first, then queryParameters!
+		assert.NotNil(t, policies[0].GetHeader())
+		assert.Equal(t, "x-foo", policies[0].GetHeader().GetHeaderName())
+		assert.NotNil(t, policies[1].GetQueryParameter())
+		assert.Equal(t, "q1", policies[1].GetQueryParameter().GetName())
+	})
+}
+
+func TestValidate(t *testing.T) {
+	t.Run("nil ir passes validation", func(t *testing.T) {
+		var ir *consistentHashIR
+		assert.NoError(t, ir.Validate())
+	})
+
+	t.Run("empty ir passes validation", func(t *testing.T) {
+		ir := &consistentHashIR{}
+		assert.NoError(t, ir.Validate())
+	})
+
+	t.Run("disable true with other fields fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			disable: true,
+			headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-user"}},
+		}
+		assert.Error(t, ir.Validate())
+	})
+
+	t.Run("empty headerName fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{{HeaderName: ""}},
+		}
+		assert.Error(t, ir.Validate())
+	})
+
+	t.Run("invalid regex fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "x-user",
+					RegexRewrite: &kgateway.RegexRewrite{
+						Pattern:      "[invalid(",
+						Substitution: "sub",
+					},
+				},
+			},
+		}
+		assert.Error(t, ir.Validate())
+	})
+
+	t.Run("empty regex pattern fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "x-user",
+					RegexRewrite: &kgateway.RegexRewrite{
+						Pattern:      "",
+						Substitution: "sub",
+					},
+				},
+			},
+		}
+		assert.Error(t, ir.Validate())
+	})
+
+	t.Run("invalid cookie TTL fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c", TTL: ptr.To("not-a-duration")},
+			},
+		}
+		assert.Error(t, ir.Validate())
+
+		irNegative := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c", TTL: ptr.To("-5s")},
+			},
+		}
+		assert.Error(t, irNegative.Validate())
+	})
+
+	t.Run("empty cookie name fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{{Name: ""}},
+		}
+		assert.Error(t, ir.Validate())
+	})
+
+	t.Run("empty query param name fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			queryParameters: []kgateway.ConsistentHashQueryParameter{{Name: ""}},
+		}
+		assert.Error(t, ir.Validate())
+	})
+
+	t.Run("empty filter state key fails validation", func(t *testing.T) {
+		ir := &consistentHashIR{
+			filterState: []kgateway.ConsistentHashFilterState{{Key: ""}},
+		}
+		assert.Error(t, ir.Validate())
+	})
+}
