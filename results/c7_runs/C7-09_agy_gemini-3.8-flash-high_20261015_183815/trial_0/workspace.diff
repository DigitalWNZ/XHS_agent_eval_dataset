+		},
+		{
+			name: "different sourceIP terminal not equal",
+			c1: &consistentHashIR{
+				sourceIP: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			},
+			c2: &consistentHashIR{
+				sourceIP: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(false)},
+			},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			result := tt.c1.Equals(tt.c2)
+			assert.Equal(t, tt.expected, result)
+
+			// Test symmetry
+			reverseResult := tt.c2.Equals(tt.c1)
+			assert.Equal(t, result, reverseResult)
+		})
+	}
+}
