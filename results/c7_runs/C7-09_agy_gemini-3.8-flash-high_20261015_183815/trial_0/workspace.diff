+}
+
+func unionHeaders(h1, h2 []kgateway.ConsistentHashHeader) []kgateway.ConsistentHashHeader {
+	seen := make(map[string]struct{}, len(h1)+len(h2))
+	res := make([]kgateway.ConsistentHashHeader, 0, len(h1)+len(h2))
+	for _, h := range h1 {
+		key := strings.ToLower(h.HeaderName)
+		if _, exists := seen[key]; !exists {
+			seen[key] = struct{}{}
+			res = append(res, h)
+		}
+	}
+	for _, h := range h2 {
+		key := strings.ToLower(h.HeaderName)
+		if _, exists := seen[key]; !exists {
+			seen[key] = struct{}{}
+			res = append(res, h)
+		}
+	}
+	if len(res) == 0 {
+		return nil
+	}
+	return res
+}
+
+func unionCookies(c1, c2 []kgateway.ConsistentHashCookie) []kgateway.ConsistentHashCookie {
+	seen := make(map[string]struct{}, len(c1)+len(c2))
+	res := make([]kgateway.ConsistentHashCookie, 0, len(c1)+len(c2))
+	for _, c := range c1 {
+		if _, exists := seen[c.Name]; !exists {
+			seen[c.Name] = struct{}{}
+			res = append(res, c)
+		}
+	}
+	for _, c := range c2 {
+		if _, exists := seen[c.Name]; !exists {
+			seen[c.Name] = struct{}{}
+			res = append(res, c)
+		}
+	}
+	if len(res) == 0 {
+		return nil
+	}
+	return res
+}
+
+func unionQueryParameters(q1, q2 []kgateway.ConsistentHashQueryParameter) []kgateway.ConsistentHashQueryParameter {
+	seen := make(map[string]struct{}, len(q1)+len(q2))
+	res := make([]kgateway.ConsistentHashQueryParameter, 0, len(q1)+len(q2))
+	for _, q := range q1 {
+		if _, exists := seen[q.Name]; !exists {
+			seen[q.Name] = struct{}{}
+			res = append(res, q)
+		}
+	}
+	for _, q := range q2 {
+		if _, exists := seen[q.Name]; !exists {
+			seen[q.Name] = struct{}{}
+			res = append(res, q)
+		}
+	}
+	if len(res) == 0 {
