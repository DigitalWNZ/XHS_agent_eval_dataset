+func TestCookieTTLAndAttributes(t *testing.T) {
+	t.Run("ttl in Go duration format", func(t *testing.T) {
+		ir := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name: "cookie-1",
+					TTL:  ptr.To("1h30m"),
+				},
+			},
+		}
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 1)
+		cookie := policies[0].GetCookie()
+		require.NotNil(t, cookie)
+		assert.Equal(t, durationpb.New(90*time.Minute), cookie.GetTtl())
+	})
+
+	t.Run("ttl in integer seconds format", func(t *testing.T) {
+		ir := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name: "cookie-2",
+					TTL:  ptr.To("3600"),
+				},
+			},
+		}
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 1)
+		cookie := policies[0].GetCookie()
+		require.NotNil(t, cookie)
+		assert.Equal(t, durationpb.New(3600*time.Second), cookie.GetTtl())
+	})
+
+	t.Run("ttl zero is session cookie", func(t *testing.T) {
+		ir := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name: "cookie-session",
+					TTL:  ptr.To("0"),
+				},
+			},
+		}
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 1)
+		cookie := policies[0].GetCookie()
+		require.NotNil(t, cookie)
+		assert.Equal(t, durationpb.New(0), cookie.GetTtl())
+	})
+
+	t.Run("attributes passed through as-is", func(t *testing.T) {
+		ir := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name: "cookie-attr",
+					Path: ptr.To("/test"),
+					Attributes: []kgateway.CookieAttribute{
+						{Name: "SameSite", Value: "Strict"},
+						{Name: "Secure", Value: ""},
+						{Name: "HttpOnly", Value: "true"},
+					},
+				},
+			},
+		}
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 1)
+		cookie := policies[0].GetCookie()
+		require.NotNil(t, cookie)
+		assert.Equal(t, "/test", cookie.GetPath())
+		require.Len(t, cookie.GetAttributes(), 3)
+		assert.Equal(t, "SameSite", cookie.GetAttributes()[0].GetName())
+		assert.Equal(t, "Strict", cookie.GetAttributes()[0].GetValue())
+		assert.Equal(t, "Secure", cookie.GetAttributes()[1].GetName())
+		assert.Equal(t, "", cookie.GetAttributes()[1].GetValue())
+		assert.Equal(t, "HttpOnly", cookie.GetAttributes()[2].GetName())
+		assert.Equal(t, "true", cookie.GetAttributes()[2].GetValue())
+	})
+}
