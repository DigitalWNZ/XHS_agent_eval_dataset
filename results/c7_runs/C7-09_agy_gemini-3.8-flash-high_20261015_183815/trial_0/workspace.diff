+func TestBuildHashPolicies(t *testing.T) {
+	t.Run("empty consistentHash defaults to single sourceIp with terminal=false", func(t *testing.T) {
+		ir := &consistentHashIR{}
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 1)
+		require.NotNil(t, policies[0].GetConnectionProperties())
+		assert.True(t, policies[0].GetConnectionProperties().GetSourceIp())
+		assert.False(t, policies[0].Terminal)
+	})
+
+	t.Run("disable=true produces no hash policies", func(t *testing.T) {
+		ir := &consistentHashIR{disable: true}
+		policies := ir.buildHashPolicies()
+		assert.Nil(t, policies)
+	})
+
+	t.Run("canonical type order: headers, cookies, queryParameters, filterState, sourceIp", func(t *testing.T) {
+		ir := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user", Terminal: ptr.To(false)},
+			},
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session", Terminal: ptr.To(false)},
+			},
+			queryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "id", Terminal: ptr.To(false)},
+			},
+			filterState: []kgateway.ConsistentHashFilterState{
+				{Key: "custom_key", Terminal: ptr.To(false)},
+			},
+			sourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: ptr.To(true),
+			},
+		}
+
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 5)
+
+		// 1. Headers
+		assert.NotNil(t, policies[0].GetHeader())
+		assert.Equal(t, "x-user", policies[0].GetHeader().GetHeaderName())
+		assert.False(t, policies[0].Terminal)
+
+		// 2. Cookies
+		assert.NotNil(t, policies[1].GetCookie())
+		assert.Equal(t, "session", policies[1].GetCookie().GetName())
+		assert.False(t, policies[1].Terminal)
+
+		// 3. QueryParameters
+		assert.NotNil(t, policies[2].GetQueryParameter())
+		assert.Equal(t, "id", policies[2].GetQueryParameter().GetName())
+		assert.False(t, policies[2].Terminal)
+
+		// 4. FilterState
+		assert.NotNil(t, policies[3].GetFilterState())
+		assert.Equal(t, "custom_key", policies[3].GetFilterState().GetKey())
+		assert.False(t, policies[3].Terminal)
+
+		// 5. SourceIP
+		assert.NotNil(t, policies[4].GetConnectionProperties())
+		assert.True(t, policies[4].GetConnectionProperties().GetSourceIp())
+		assert.True(t, policies[4].Terminal)
+	})
+
+	t.Run("sub-fields specified without sourceIp does not add sourceIp", func(t *testing.T) {
+		ir := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user"},
+			},
+		}
+		policies := ir.buildHashPolicies()
+		require.Len(t, policies, 1)
+		assert.NotNil(t, policies[0].GetHeader())
+		assert.Nil(t, policies[0].GetConnectionProperties())
+	})
+}
