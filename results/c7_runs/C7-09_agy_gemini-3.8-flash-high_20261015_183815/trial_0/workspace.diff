+func TestConstructConsistentHash(t *testing.T) {
+	t.Run("nil spec produces nil IR", func(t *testing.T) {
+		outSpec := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{}, outSpec)
+		require.NoError(t, err)
+		assert.Nil(t, outSpec.consistentHash)
+	})
+
+	t.Run("empty spec produces non-nil IR", func(t *testing.T) {
+		outSpec := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{},
+		}, outSpec)
+		require.NoError(t, err)
+		require.NotNil(t, outSpec.consistentHash)
+		assert.False(t, outSpec.consistentHash.disable)
+		assert.Empty(t, outSpec.consistentHash.headers)
+		assert.Empty(t, outSpec.consistentHash.cookies)
+		assert.Empty(t, outSpec.consistentHash.queryParameters)
+		assert.Empty(t, outSpec.consistentHash.filterState)
+		assert.Nil(t, outSpec.consistentHash.sourceIP)
+	})
+
+	t.Run("disable true with no other fields produces valid IR", func(t *testing.T) {
+		outSpec := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: ptr.To(true),
+			},
+		}, outSpec)
+		require.NoError(t, err)
+		require.NotNil(t, outSpec.consistentHash)
+		assert.True(t, outSpec.consistentHash.disable)
+	})
+
+	t.Run("disable true with other fields returns error", func(t *testing.T) {
+		// With headers
+		outSpec := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: ptr.To(true),
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-foo"}},
+			},
+		}, outSpec)
+		assert.Error(t, err)
+		assert.Contains(t, err.Error(), "when disable is true, no other fields may be set")
+
+		// With cookies
+		err = constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: ptr.To(true),
+				Cookies: []kgateway.ConsistentHashCookie{{Name: "session"}},
+			},
+		}, outSpec)
+		assert.Error(t, err)
+
+		// With queryParameters
+		err = constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable:         ptr.To(true),
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+			},
+		}, outSpec)
+		assert.Error(t, err)
+
+		// With filterState
+		err = constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable:     ptr.To(true),
+				FilterState: []kgateway.ConsistentHashFilterState{{Key: "k"}},
+			},
+		}, outSpec)
+		assert.Error(t, err)
+
+		// With sourceIp
+		err = constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable:  ptr.To(true),
+				SourceIP: &kgateway.ConsistentHashSourceIP{},
+			},
+		}, outSpec)
+		assert.Error(t, err)
+	})
+
+	t.Run("deduplication within single policy preserves first occurrence and casing", func(t *testing.T) {
+		outSpec := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User-Id", Terminal: ptr.To(true)},
+					{HeaderName: "x-user-id", Terminal: ptr.To(false)},
+					{HeaderName: "X-USER-ID", Terminal: ptr.To(false)},
+					{HeaderName: "Authorization"},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", Path: ptr.To("/app1")},
+					{Name: "session", Path: ptr.To("/app2")},
+					{Name: "token"},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "user"},
+					{Name: "user"},
+					{Name: "User"}, // Case-sensitive: "User" != "user"
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "fs1"},
+					{Key: "fs1"},
+					{Key: "fs2"},
+				},
+			},
+		}, outSpec)
+		require.NoError(t, err)
+		require.NotNil(t, outSpec.consistentHash)
+
+		// Headers deduplicated case-insensitively, preserving first occurrence and casing
+		require.Len(t, outSpec.consistentHash.headers, 2)
+		assert.Equal(t, "X-User-Id", outSpec.consistentHash.headers[0].HeaderName)
+		assert.True(t, *outSpec.consistentHash.headers[0].Terminal)
+		assert.Equal(t, "Authorization", outSpec.consistentHash.headers[1].HeaderName)
+
+		// Cookies deduplicated
+		require.Len(t, outSpec.consistentHash.cookies, 2)
+		assert.Equal(t, "session", outSpec.consistentHash.cookies[0].Name)
+		assert.Equal(t, "/app1", *outSpec.consistentHash.cookies[0].Path)
+		assert.Equal(t, "token", outSpec.consistentHash.cookies[1].Name)
+
+		// QueryParameters: case-sensitive deduplication
+		require.Len(t, outSpec.consistentHash.queryParameters, 2)
+		assert.Equal(t, "user", outSpec.consistentHash.queryParameters[0].Name)
+		assert.Equal(t, "User", outSpec.consistentHash.queryParameters[1].Name)
+
+		// FilterState deduplicated
+		require.Len(t, outSpec.consistentHash.filterState, 2)
+		assert.Equal(t, "fs1", outSpec.consistentHash.filterState[0].Key)
+		assert.Equal(t, "fs2", outSpec.consistentHash.filterState[1].Key)
+	})
+}
