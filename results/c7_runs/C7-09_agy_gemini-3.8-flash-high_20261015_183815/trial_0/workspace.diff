+}
+
+func unionFilterState(f1, f2 []kgateway.ConsistentHashFilterState) []kgateway.ConsistentHashFilterState {
+	seen := make(map[string]struct{}, len(f1)+len(f2))
+	res := make([]kgateway.ConsistentHashFilterState, 0, len(f1)+len(f2))
+	for _, f := range f1 {
+		if _, exists := seen[f.Key]; !exists {
+			seen[f.Key] = struct{}{}
+			res = append(res, f)
+		}
+	}
+	for _, f := range f2 {
+		if _, exists := seen[f.Key]; !exists {
+			seen[f.Key] = struct{}{}
+			res = append(res, f)
+		}
+	}
+	if len(res) == 0 {
+		return nil
+	}
+	return res
+}
+
+func parseCookieTTL(ttlStr string) (*durationpb.Duration, error) {
+	if ttlStr == "" {
+		return nil, nil
+	}
+	// Try Go duration format first
+	if d, err := time.ParseDuration(ttlStr); err == nil {
+		if d < 0 {
+			return nil, fmt.Errorf("cookie ttl cannot be negative: %s", ttlStr)
+		}
+		return durationpb.New(d), nil
+	}
+	// Try plain integer seconds
+	if sec, err := strconv.ParseInt(ttlStr, 10, 64); err == nil {
+		if sec < 0 {
+			return nil, fmt.Errorf("cookie ttl cannot be negative: %s", ttlStr)
+		}
+		return durationpb.New(time.Duration(sec) * time.Second), nil
+	}
+	return nil, fmt.Errorf("invalid cookie ttl: %q, must be Go duration format (e.g. 1h30m) or integer seconds (e.g. 3600)", ttlStr)
+}
+
+func equalBoolPtr(b1, b2 *bool) bool {
+	if b1 == nil && b2 == nil {
+		return true
+	}
+	if b1 == nil || b2 == nil {
+		return false
+	}
+	return *b1 == *b2
+}
+
+func equalStringPtr(s1, s2 *string) bool {
+	if s1 == nil && s2 == nil {
+		return true
+	}
+	if s1 == nil || s2 == nil {
+		return false
+	}
+	return *s1 == *s2
+}
