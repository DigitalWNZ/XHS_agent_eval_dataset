+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { queryKey } from '@tanstack/query-test-utils'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  isPersisterRestoreResult,
+  reconcileQueryState,
+} from '..'
+import type { InfiniteData, QueryState } from '..'
+
+describe('createPersisterRestoreResult & query restoration', () => {
+  let queryClient: QueryClient
+  let queryCache: QueryCache
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    queryClient = new QueryClient()
+    queryCache = queryClient.getQueryCache()
+  })
+
+  afterEach(() => {
+    queryClient.clear()
+    vi.useRealTimers()
+  })
+
+  it('should create a valid persister restore result marker', () => {
+    const state: QueryState<string> = {
+      data: 'persisted-data',
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 1,
+      error: null,
+      errorUpdatedAt: 0,
+      errorUpdateCount: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'success',
+      fetchStatus: 'idle',
+    }
+
+    const restoreResult = createPersisterRestoreResult({
+      data: 'persisted-data',
+      state,
+    })
+
+    expect(isPersisterRestoreResult(restoreResult)).toBe(true)
+    expect(isPersisterRestoreResult({ data: 'foo', state })).toBe(false)
+    expect(isPersisterRestoreResult(null)).toBe(false)
+    expect(isPersisterRestoreResult(undefined)).toBe(false)
+    expect(restoreResult.data).toBe('persisted-data')
+    expect(restoreResult.state).toBe(state)
+  })
+
+  it('prefetchQuery should adopt restored state without triggering cache success callbacks', async () => {
+    const key = queryKey()
+    const onSuccessSpy = vi.fn()
+    const onSettledSpy = vi.fn()
+
+    const customCache = new QueryCache({
+      onSuccess: onSuccessSpy,
+      onSettled: onSettledSpy,
+    })
+    const client = new QueryClient({ queryCache: customCache })
+
+    const persistedError = new Error('persisted refetch error')
+    const persistedState: QueryState<string> = {
+      data: 'cached-data',
+      dataUpdatedAt: 1234,
+      dataUpdateCount: 2,
+      error: persistedError,
+      errorUpdatedAt: 5678,
+      errorUpdateCount: 3,
+      fetchFailureCount: 4,
+      fetchFailureReason: persistedError,
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    await client.prefetchQuery({
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh-data'),
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'cached-data',
+          state: persistedState,
+        }),
+    })
+
+    const query = customCache.find({ queryKey: key })!
+    expect(query).toBeDefined()
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('error')
+    expect(query.state.data).toBe('cached-data')
+    expect(query.state.error).toBe(persistedError)
+    expect(query.state.dataUpdatedAt).toBe(1234)
+    expect(query.state.errorUpdatedAt).toBe(5678)
+    expect(query.state.fetchFailureCount).toBe(4)
+    expect(query.state.fetchFailureReason).toBe(persistedError)
+    expect(query.state.dataUpdateCount).toBe(2)
+    expect(query.state.errorUpdateCount).toBe(3)
+    expect(query.state.isInvalidated).toBe(true)
+
+    expect(onSuccessSpy).not.toHaveBeenCalled()
+    expect(onSettledSpy).not.toHaveBeenCalled()
+
+    const observer = new QueryObserver(client, { queryKey: key })
+    const result = observer.getCurrentResult()
+    expect(result.status).toBe('error')
+    expect(result.isError).toBe(true)
+    expect(result.data).toBe('cached-data')
+    expect(result.isRefetchError).toBe(true)
+    expect(result.failureCount).toBe(4)
+    expect(result.dataUpdatedAt).toBe(1234)
+    expect(result.errorUpdatedAt).toBe(5678)
+    expect(result.isStale).toBe(true)
+  })
+
+  it('prefetchQuery should preserve infinite query pagination state when restored', async () => {
+    const key = queryKey()
+    const infiniteData: InfiniteData<string, number> = {
+      pages: ['page 1', 'page 2', 'page 3'],
+      pageParams: [1, 2, 3],
+    }
+
+    const persistedError = new Error('page 3 failed on refetch')
+    const persistedState: QueryState<InfiniteData<string, number>> = {
+      data: infiniteData,
+      dataUpdatedAt: 2000,
+      dataUpdateCount: 3,
+      error: persistedError,
+      errorUpdatedAt: 3000,
+      errorUpdateCount: 1,
+      fetchFailureCount: 2,
+      fetchFailureReason: persistedError,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => Promise.resolve(infiniteData),
+      persister: () =>
+        createPersisterRestoreResult({
+          data: infiniteData,
+          state: persistedState,
+        }),
+    })
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query.state.data).toEqual(infiniteData)
+    expect(
+      (query.state.data as InfiniteData<string, number>).pageParams,
+    ).toEqual([1, 2, 3])
+    expect(query.state.status).toBe('error')
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.fetchFailureCount).toBe(2)
+  })
+
+  it('query observer should expose restored snapshot state with isRefetchError', async () => {
+    const key = queryKey()
+    const error = new Error('persisted error')
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh'),
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'restored-data',
+          state: {
+            data: 'restored-data',
+            dataUpdatedAt: 100,
+            dataUpdateCount: 1,
+            error,
+            errorUpdatedAt: 200,
+            errorUpdateCount: 1,
+            fetchFailureCount: 3,
+            fetchFailureReason: error,
+            isInvalidated: false,
+            status: 'error',
+            fetchStatus: 'idle',
+          },
+        }),
+    })
+
+    const unsubscribe = observer.subscribe(vi.fn())
+    await vi.advanceTimersByTimeAsync(0)
+
+    const result = observer.getCurrentResult()
+    expect(result.data).toBe('restored-data')
+    expect(result.error).toBe(error)
+    expect(result.status).toBe('error')
+    expect(result.isError).toBe(true)
+    expect(result.isRefetchError).toBe(true)
+    expect(result.failureCount).toBe(3)
+    expect(result.dataUpdatedAt).toBe(100)
+    expect(result.errorUpdatedAt).toBe(200)
+    expect(result.fetchStatus).toBe('idle')
+
+    unsubscribe()
+  })
+
+  describe('reconcileQueryState', () => {
+    it('should keep newer live data while adopting newer persisted error state', () => {
+      const liveState: QueryState<string> = {
+        data: 'live-newer-data',
+        dataUpdatedAt: 200,
+        dataUpdateCount: 2,
+        error: null,
+        errorUpdatedAt: 50,
+        errorUpdateCount: 1,
+        fetchFailureCount: 0,
+        fetchFailureReason: null,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'success',
+        fetchStatus: 'idle',
+      }
+
+      const persistedError = new Error('persisted-newer-error')
+      const persistedState: QueryState<string> = {
+        data: 'persisted-older-data',
+        dataUpdatedAt: 100,
+        dataUpdateCount: 1,
+        error: persistedError,
+        errorUpdatedAt: 150,
+        errorUpdateCount: 2,
+        fetchFailureCount: 3,
+        fetchFailureReason: persistedError,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      // Keeps newer live data:
+      expect(reconciled.data).toBe('live-newer-data')
+      expect(reconciled.dataUpdatedAt).toBe(200)
+      expect(reconciled.dataUpdateCount).toBe(2)
+
+      // Adopts newer persisted error:
+      expect(reconciled.error).toBe(persistedError)
+      expect(reconciled.errorUpdatedAt).toBe(150)
+      expect(reconciled.fetchFailureCount).toBe(3)
+      expect(reconciled.fetchFailureReason).toBe(persistedError)
+
+      // Status remains error, and because data is present, observer will see isRefetchError
+      expect(reconciled.status).toBe('error')
+      expect(reconciled.fetchStatus).toBe('idle')
+    })
+
+    it('should keep newer persisted data while adopting newer live error state (inverse rule)', () => {
+      const liveError = new Error('live-newer-error')
+      const liveState: QueryState<string> = {
+        data: 'live-older-data',
+        dataUpdatedAt: 100,
+        dataUpdateCount: 1,
+        error: liveError,
+        errorUpdatedAt: 250,
+        errorUpdateCount: 2,
+        fetchFailureCount: 2,
+        fetchFailureReason: liveError,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string> = {
+        data: 'persisted-newer-data',
+        dataUpdatedAt: 200,
+        dataUpdateCount: 2,
+        error: null,
+        errorUpdatedAt: 50,
+        errorUpdateCount: 1,
+        fetchFailureCount: 0,
+        fetchFailureReason: null,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'success',
+        fetchStatus: 'idle',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      // Keeps newer persisted data:
+      expect(reconciled.data).toBe('persisted-newer-data')
+      expect(reconciled.dataUpdatedAt).toBe(200)
+
+      // Keeps newer live error:
+      expect(reconciled.error).toBe(liveError)
+      expect(reconciled.errorUpdatedAt).toBe(250)
+      expect(reconciled.fetchFailureCount).toBe(2)
+      expect(reconciled.fetchFailureReason).toBe(liveError)
+
+      // Status is error and data is present -> refetch error
+      expect(reconciled.status).toBe('error')
+      expect(reconciled.fetchStatus).toBe('idle')
+    })
+
+    it('should preserve invalidation if either side is invalidated', () => {
+      const liveState: QueryState<string> = {
+        data: 'data',
+        dataUpdatedAt: 100,
+        dataUpdateCount: 1,
+        error: null,
+        errorUpdatedAt: 0,
+        errorUpdateCount: 0,
+        fetchFailureCount: 0,
+        fetchFailureReason: null,
+        fetchMeta: null,
+        isInvalidated: true,
+        status: 'success',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: Partial<QueryState<string>> = {
+        data: 'data',
+        dataUpdatedAt: 100,
+        isInvalidated: false,
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+      expect(reconciled.isInvalidated).toBe(true)
+
+      const liveNotInvalidated: QueryState<string> = {
+        ...liveState,
+        isInvalidated: false,
+      }
+      const persistedInvalidated: Partial<QueryState<string>> = {
+        ...persistedState,
+        isInvalidated: true,
+      }
+
+      const reconciled2 = reconcileQueryState(
+        liveNotInvalidated,
+        persistedInvalidated,
+      )
+      expect(reconciled2.isInvalidated).toBe(true)
+    })
+  })
+})
