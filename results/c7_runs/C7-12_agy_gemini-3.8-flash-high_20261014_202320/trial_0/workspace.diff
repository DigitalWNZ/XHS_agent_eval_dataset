+import { describe, expect, test, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  isPersisterRestoreResult,
+  persisterRestoreMarker,
+  reconcileQueryState,
+} from '..'
+import { queryKey } from '@tanstack/query-test-utils'
+import type { QueryState } from '..'
+
+describe('createPersisterRestoreResult & persisterRestore', () => {
+  test('createPersisterRestoreResult marks the object as restored snapshot', () => {
+    const error = new Error('persisted error')
+    const state: QueryState<string, Error> = {
+      data: 'persisted data',
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 1,
+      error,
+      errorUpdatedAt: 2000,
+      errorUpdateCount: 1,
+      fetchFailureCount: 2,
+      fetchFailureReason: error,
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const result = createPersisterRestoreResult({
+      data: 'persisted data',
+      state,
+    })
+
+    expect(result.data).toBe('persisted data')
+    expect(result.state).toBe(state)
+    expect(result[persisterRestoreMarker]).toBe(true)
+    expect(isPersisterRestoreResult(result)).toBe(true)
+    expect(isPersisterRestoreResult({ data: 'plain' })).toBe(false)
+    expect(isPersisterRestoreResult(null)).toBe(false)
+  })
+
+  test('query.fetch adopts restored snapshot with refetch error, idle fetchStatus, and counters', async () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+    const error = new Error('persisted error')
+
+    const persistedState: QueryState<string, Error> = {
+      data: 'cached data',
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 1,
+      error,
+      errorUpdatedAt: 2000,
+      errorUpdateCount: 1,
+      fetchFailureCount: 3,
+      fetchFailureReason: error,
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const queryFn = vi.fn(async () => 'fresh data')
+    const persister = vi.fn(async () => {
+      return createPersisterRestoreResult({
+        data: 'cached data',
+        state: persistedState,
+      })
+    })
+
+    // Listen to query cache to verify no 'success' action is dispatched
+    const actions: Array<string> = []
+    const unsubscribe = queryCache.subscribe((event) => {
+      if (event.type === 'updated' && event.action) {
+        actions.push(event.action.type)
+      }
+    })
+
+    const query = queryCache.build(queryClient, {
+      queryKey: key,
+      queryFn,
+      persister,
+    })
+
+    const fetchResult = await query.fetch()
+
+    expect(fetchResult).toBe('cached data')
+    expect(queryFn).not.toHaveBeenCalled()
+    expect(persister).toHaveBeenCalledTimes(1)
+
+    // Check adopted state
+    expect(query.state.data).toBe('cached data')
+    expect(query.state.error).toBe(error)
+    expect(query.state.status).toBe('error')
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.fetchFailureCount).toBe(3)
+    expect(query.state.fetchFailureReason).toBe(error)
+    expect(query.state.dataUpdatedAt).toBe(1000)
+    expect(query.state.errorUpdatedAt).toBe(2000)
+    expect(query.state.dataUpdateCount).toBe(1)
+    expect(query.state.errorUpdateCount).toBe(1)
+    expect(query.state.isInvalidated).toBe(true)
+
+    // Ensure normal fetch success was NOT dispatched
+    expect(actions).not.toContain('success')
+
+    // Query observer observing this query should report isRefetchError: true
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      queryFn,
+      persister,
+    })
+    const observerResult = observer.getCurrentResult()
+    expect(observerResult.isRefetchError).toBe(true)
+    expect(observerResult.isError).toBe(true)
+    expect(observerResult.isSuccess).toBe(false)
+    expect(observerResult.data).toBe('cached data')
+    expect(observerResult.error).toBe(error)
+    expect(observerResult.failureCount).toBe(3)
+    expect(observerResult.dataUpdatedAt).toBe(1000)
+    expect(observerResult.errorUpdatedAt).toBe(2000)
+
+    unsubscribe()
+  })
+
+  test('prefetchQuery adopts restored snapshot via persister option', async () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+    const error = new Error('network error')
+
+    const persistedState: QueryState<string, Error> = {
+      data: 'restored data',
+      dataUpdatedAt: 500,
+      dataUpdateCount: 1,
+      error,
+      errorUpdatedAt: 1500,
+      errorUpdateCount: 1,
+      fetchFailureCount: 2,
+      fetchFailureReason: error,
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: async () => 'from network',
+      persister: async () =>
+        createPersisterRestoreResult({
+          data: 'restored data',
+          state: persistedState,
+        }),
+    })
+
+    const query = queryCache.find({ queryKey: key })
+    expect(query).toBeDefined()
+    expect(query!.state.data).toBe('restored data')
+    expect(query!.state.error).toBe(error)
+    expect(query!.state.status).toBe('error')
+    expect(query!.state.fetchStatus).toBe('idle')
+    expect(query!.state.fetchFailureCount).toBe(2)
+  })
+
+  test('restores infinite query pagination state (pages & pageParams)', async () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+
+    const infiniteData = {
+      pages: ['page 1', 'page 2'],
+      pageParams: [1, 2],
+    }
+
+    const persistedState: QueryState<typeof infiniteData, Error> = {
+      data: infiniteData,
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 2,
+      error: null,
+      errorUpdatedAt: 0,
+      errorUpdateCount: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'success',
+      fetchStatus: 'idle',
+    }
+
+    const query = queryCache.build(queryClient, {
+      queryKey: key,
+      queryFn: async () => infiniteData,
+      persister: async () =>
+        createPersisterRestoreResult({
+          data: infiniteData,
+          state: persistedState,
+        }),
+    })
+
+    await query.fetch()
+
+    expect(query.state.data).toEqual({
+      pages: ['page 1', 'page 2'],
+      pageParams: [1, 2],
+    })
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('success')
+  })
+
+  test('QueryObserver preserves failureCount and timestamp metadata during mount', () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+    const error = new Error('persisted refetch failure')
+
+    // Simulate query restored into cache
+    const restoredState: QueryState<string, Error> = {
+      data: 'stale data',
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 1,
+      error,
+      errorUpdatedAt: 2000,
+      errorUpdateCount: 1,
+      fetchFailureCount: 4,
+      fetchFailureReason: error,
+      fetchMeta: null,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    queryCache.build(queryClient, { queryKey: key }, restoredState)
+
+    // Observer with _optimisticResults (as used by React / adapters during mount)
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      queryFn: async () => 'refetched data',
+      _optimisticResults: 'optimistic',
+    })
+
+    const initialResult = observer.getCurrentResult()
+
+    // Must reflect persisted failure count, timestamps, and refetch error
+    expect(initialResult.failureCount).toBe(4)
+    expect(initialResult.failureReason).toBe(error)
+    expect(initialResult.error).toBe(error)
+    expect(initialResult.dataUpdatedAt).toBe(1000)
+    expect(initialResult.errorUpdatedAt).toBe(2000)
+    expect(initialResult.isRefetchError).toBe(true)
+    expect(initialResult.data).toBe('stale data')
+  })
+
+  describe('reconcileQueryState', () => {
+    test('live has newer data, persisted has newer error metadata -> refetch error with newer data and newer error', () => {
+      const liveError = new Error('live error')
+      const persistedError = new Error('persisted error')
+
+      const liveState: QueryState<string, Error> = {
+        data: 'live data',
+        dataUpdatedAt: 3000, // Newer data
+        dataUpdateCount: 2,
+        error: liveError,
+        errorUpdatedAt: 1000,
+        errorUpdateCount: 1,
+        fetchFailureCount: 1,
+        fetchFailureReason: liveError,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string, Error> = {
+        data: 'persisted data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 1,
+        error: persistedError,
+        errorUpdatedAt: 4000, // Newer error
+        errorUpdateCount: 2,
+        fetchFailureCount: 3,
+        fetchFailureReason: persistedError,
+        fetchMeta: null,
+        isInvalidated: true,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      expect(reconciled.data).toBe('live data')
+      expect(reconciled.dataUpdatedAt).toBe(3000)
+      expect(reconciled.dataUpdateCount).toBe(2)
+
+      expect(reconciled.error).toBe(persistedError)
+      expect(reconciled.errorUpdatedAt).toBe(4000)
+      expect(reconciled.fetchFailureCount).toBe(3)
+      expect(reconciled.status).toBe('error')
+      expect(reconciled.isInvalidated).toBe(true)
+    })
+
+    test('inverse rule: persisted has newer data, live has newer error -> refetch error keeping newer data and newer error', () => {
+      const liveError = new Error('live error')
+      const persistedError = new Error('persisted error')
+
+      const liveState: QueryState<string, Error> = {
+        data: 'live data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 1,
+        error: liveError,
+        errorUpdatedAt: 4000, // Newer error
+        errorUpdateCount: 2,
+        fetchFailureCount: 2,
+        fetchFailureReason: liveError,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string, Error> = {
+        data: 'persisted data',
+        dataUpdatedAt: 3000, // Newer data
+        dataUpdateCount: 2,
+        error: persistedError,
+        errorUpdatedAt: 1000,
+        errorUpdateCount: 1,
+        fetchFailureCount: 1,
+        fetchFailureReason: persistedError,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      // Newer data must not be discarded because live had newer error
+      expect(reconciled.data).toBe('persisted data')
+      expect(reconciled.dataUpdatedAt).toBe(3000)
+
+      // Newer error must be adopted
+      expect(reconciled.error).toBe(liveError)
+      expect(reconciled.errorUpdatedAt).toBe(4000)
+      expect(reconciled.fetchFailureCount).toBe(2)
+      expect(reconciled.status).toBe('error')
+    })
+
+    test('live has newer data with no error -> does not resurrect older persisted error', () => {
+      const persistedError = new Error('old persisted error')
+
+      const liveState: QueryState<string, Error> = {
+        data: 'live data',
+        dataUpdatedAt: 3000, // Succeeded at 3000
+        dataUpdateCount: 2,
+        error: null,
+        errorUpdatedAt: 0,
+        errorUpdateCount: 0,
+        fetchFailureCount: 0,
+        fetchFailureReason: null,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'success',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string, Error> = {
+        data: 'persisted data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 1,
+        error: persistedError,
+        errorUpdatedAt: 2000, // Error was at 2000, prior to live success at 3000
+        errorUpdateCount: 1,
+        fetchFailureCount: 1,
+        fetchFailureReason: persistedError,
+        fetchMeta: null,
+        isInvalidated: true,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      expect(reconciled.data).toBe('live data')
+      expect(reconciled.dataUpdatedAt).toBe(3000)
+      expect(reconciled.error).toBe(null)
+      expect(reconciled.status).toBe('success')
+    })
+
+    test('persisted has newer data with no error -> does not retain older live error', () => {
+      const liveError = new Error('old live error')
+
+      const liveState: QueryState<string, Error> = {
+        data: 'live data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 1,
+        error: liveError,
+        errorUpdatedAt: 2000, // Error was at 2000
+        errorUpdateCount: 1,
+        fetchFailureCount: 1,
+        fetchFailureReason: liveError,
+        fetchMeta: null,
+        isInvalidated: true,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string, Error> = {
+        data: 'persisted data',
+        dataUpdatedAt: 3000, // Succeeded at 3000
+        dataUpdateCount: 2,
+        error: null,
+        errorUpdatedAt: 0,
+        errorUpdateCount: 0,
+        fetchFailureCount: 0,
+        fetchFailureReason: null,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'success',
+        fetchStatus: 'idle',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      expect(reconciled.data).toBe('persisted data')
+      expect(reconciled.dataUpdatedAt).toBe(3000)
+      expect(reconciled.error).toBe(null)
+      expect(reconciled.status).toBe('success')
+    })
+  })
+})
