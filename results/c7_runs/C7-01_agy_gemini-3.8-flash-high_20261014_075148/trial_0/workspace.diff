+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define BASE 1000000000ULL
+
+typedef struct {
+    uint32_t *d;
+    int len;
+    int cap;
+} BigInt;
+
+static void bi_init(BigInt *n, uint32_t val) {
+    n->cap = 16;
+    n->d = (uint32_t *)malloc(n->cap * sizeof(uint32_t));
+    n->d[0] = val;
+    n->len = 1;
+}
+
+static void bi_free(BigInt *n) {
+    free(n->d);
+}
+
+static void bi_add(const BigInt *a, const BigInt *b, BigInt *res) {
+    int max_len = (a->len > b->len) ? a->len : b->len;
+    if (res->cap < max_len + 2) {
+        res->cap = (max_len + 2) * 2;
+        res->d = (uint32_t *)realloc(res->d, res->cap * sizeof(uint32_t));
+    }
+    uint64_t carry = 0;
+    int i = 0;
+    while (i < max_len || carry) {
+        uint64_t sum = carry;
+        if (i < a->len) sum += a->d[i];
+        if (i < b->len) sum += b->d[i];
+        res->d[i] = (uint32_t)(sum % BASE);
+        carry = sum / BASE;
+        i++;
+    }
+    res->len = i;
+}
+
+static void bi_print(const BigInt *n) {
+    if (n->len == 0) {
+        printf("0\n");
+        return;
+    }
+    printf("%u", n->d[n->len - 1]);
+    for (int i = n->len - 2; i >= 0; i--) {
+        printf("%09u", n->d[i]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) return 1;
+    long long n = atoll(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    BigInt fib_prev, fib_curr, fib_next;
+    bi_init(&fib_prev, 0);
+    bi_init(&fib_curr, 1);
+    bi_init(&fib_next, 0);
+
+    for (long long i = 0; i < n; i++) {
+        bi_add(&fib_prev, &fib_curr, &fib_next);
+        BigInt tmp = fib_prev;
+        fib_prev = fib_curr;
+        fib_curr = fib_next;
+        fib_next = tmp;
+    }
+    bi_print(&fib_prev);
+    bi_free(&fib_prev);
+    bi_free(&fib_curr);
+    bi_free(&fib_next);
+    return 0;
+}
