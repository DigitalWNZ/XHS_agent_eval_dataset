+func TestConfigValidate(t *testing.T) {
+	assert.NoError(t, Config{}.Validate())
+	assert.NoError(t, Config{KeySource: "bogus", Key: "x", KeyFile: "y"}.Validate())
+
+	assert.Error(t, Config{Enabled: true}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "bogus"}.Validate())
+
+	assert.NoError(t, Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "X"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "file", KeyFile: "/k"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "Literal", Key: "abc"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s"}.Validate())
+
+	assert.Error(t, Config{Enabled: true, KeySource: "env"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "file"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "literal"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Passphrase: "p"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Salt: "s"}.Validate())
+
+	assert.ErrorContains(t, Config{Enabled: true, KeySource: "env", KeyEnvVar: "X", Key: "k"}.Validate(), "mutually exclusive")
+	assert.ErrorContains(t, Config{Enabled: true, KeySource: "file", KeyFile: "f", Passphrase: "p"}.Validate(), "mutually exclusive")
+	assert.ErrorContains(t, Config{Enabled: true, KeySource: "literal", Key: "k", KeyEnvVar: "X"}.Validate(), "mutually exclusive")
+	assert.ErrorContains(t, Config{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", KeyFile: "f"}.Validate(), "mutually exclusive")
+}
+
+func TestLoadKey(t *testing.T) {
+	key := testKey(t)
+	encoded := base64.StdEncoding.EncodeToString(key)
+
+	t.Setenv("ONEDUMP_TEST_KEY", encoded)
+	got, err := LoadKey(Config{KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, key, got)
+
+	_, err = LoadKey(Config{KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY_UNSET"})
+	assert.Error(t, err)
+
+	file := filepath.Join(t.TempDir(), "key")
+	require.NoError(t, os.WriteFile(file, []byte("  "+encoded+"\n"), 0600))
+	got, err = LoadKey(Config{KeySource: "file", KeyFile: file})
+	require.NoError(t, err)
+	assert.Equal(t, key, got)
+
+	got, err = LoadKey(Config{KeySource: "literal", Key: encoded})
+	require.NoError(t, err)
+	assert.Equal(t, key, got)
+
+	_, err = LoadKey(Config{KeySource: "literal", Key: base64.StdEncoding.EncodeToString([]byte("short"))})
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	salt := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{1}, 16))
+	k1, err := LoadKey(Config{KeySource: "derive", Passphrase: "secret", Salt: salt})
+	require.NoError(t, err)
+	k2, err := LoadKey(Config{KeySource: "derive", Passphrase: "secret", Salt: salt})
+	require.NoError(t, err)
+	assert.Len(t, k1, KeySize)
+	assert.Equal(t, k1, k2)
+
+	_, err = LoadKey(Config{KeySource: "derive", Passphrase: "secret", Salt: base64.StdEncoding.EncodeToString([]byte("short"))})
+	assert.Error(t, err)
+	_, err = LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: salt})
+	assert.Error(t, err)
+}
