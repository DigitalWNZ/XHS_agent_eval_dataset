diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..b71c56e
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,158 @@
+package encryption
+
+import (
+	"crypto/pbkdf2"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	deriveIterations = 600_000
+)
+
+// Config describes whether a dump should be encrypted and where the key comes from.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (cfg Config) source() string {
+	return strings.ToLower(strings.TrimSpace(cfg.KeySource))
+}
+
+// Validate checks the config. Disabled configs are always valid.
+func (cfg Config) Validate() error {
+	if !cfg.Enabled {
+		return nil
+	}
+
+	return cfg.validateSource()
+}
+
+func (cfg Config) validateSource() error {
+	type field struct {
+		name  string
+		value string
+	}
+
+	keyEnvVar := field{"keyenvvar", cfg.KeyEnvVar}
+	keyFile := field{"keyfile", cfg.KeyFile}
+	key := field{"key", cfg.Key}
+	passphrase := field{"passphrase", cfg.Passphrase}
+	salt := field{"salt", cfg.Salt}
+
+	var required, forbidden []field
+
+	source := cfg.source()
+	switch source {
+	case "":
+		return errors.New("encryption key source is required")
+	case KeySourceEnv:
+		required = []field{keyEnvVar}
+		forbidden = []field{keyFile, key, passphrase, salt}
+	case KeySourceFile:
+		required = []field{keyFile}
+		forbidden = []field{keyEnvVar, key, passphrase, salt}
+	case KeySourceLiteral:
+		required = []field{key}
+		forbidden = []field{keyEnvVar, keyFile, passphrase, salt}
+	case KeySourceDerive:
+		required = []field{passphrase, salt}
+		forbidden = []field{keyEnvVar, keyFile, key}
+	default:
+		return fmt.Errorf("unsupported encryption key source %q, must be one of env, file, literal, derive", cfg.KeySource)
+	}
+
+	var errs error
+	for _, f := range required {
+		if strings.TrimSpace(f.value) == "" {
+			errs = errors.Join(errs, fmt.Errorf("encryption key source %q requires %s", source, f.name))
+		}
+	}
+
+	for _, f := range forbidden {
+		if strings.TrimSpace(f.value) != "" {
+			errs = errors.Join(errs, fmt.Errorf("encryption %s is mutually exclusive with key source %q", f.name, source))
+		}
+	}
+
+	return errs
+}
+
+// LoadKey loads the 32-byte encryption key described by cfg.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateSource(); err != nil {
+		return nil, err
+	}
+
+	switch cfg.source() {
+	case KeySourceEnv:
+		value, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || strings.TrimSpace(value) == "" {
+			return nil, fmt.Errorf("encryption key env var %s is not set", cfg.KeyEnvVar)
+		}
+		return decodeKey(value, "env var "+cfg.KeyEnvVar)
+	case KeySourceFile:
+		content, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file: %w", err)
+		}
+		return decodeKey(string(content), "file "+cfg.KeyFile)
+	case KeySourceLiteral:
+		return decodeKey(cfg.Key, "literal key")
+	case KeySourceDerive:
+		return deriveKey(cfg.Passphrase, cfg.Salt)
+	}
+
+	return nil, fmt.Errorf("unsupported encryption key source %q", cfg.KeySource)
+}
+
+func decodeKey(encoded, origin string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(encoded))
+	if err != nil {
+		return nil, fmt.Errorf("%w: %s is not valid base64: %v", ErrInvalidKey, origin, err)
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key from %s must be %d bytes, got %d", ErrInvalidKey, origin, KeySize, len(key))
+	}
+
+	return key, nil
+}
+
+func deriveKey(passphrase, encodedSalt string) ([]byte, error) {
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, errors.New("encryption passphrase must not be empty")
+	}
+
+	salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(encodedSalt))
+	if err != nil {
+		return nil, fmt.Errorf("encryption salt is not valid base64: %w", err)
+	}
+
+	if len(salt) < MinSaltSize {
+		return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", MinSaltSize, len(salt))
+	}
+
+	key, err := pbkdf2.Key(sha256.New, passphrase, salt, deriveIterations, KeySize)
+	if err != nil {
+		return nil, fmt.Errorf("failed to derive encryption key: %w", err)
+	}
+
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..bc5b7b2
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,316 @@
+// Package encryption provides AES-256-GCM streaming encryption for dump files.
+//
+// Stream format:
+//
+//	header:   0x4F 0x44 (magic) | 0x01 (version)
+//	chunks:   [4-byte big-endian length][12-byte nonce][ciphertext + 16-byte tag] ...
+//	sentinel: 4 zero bytes
+//	trailer:  32-byte HMAC-SHA256 (keyed with the encryption key) over all bytes between header and sentinel
+package encryption
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize           = 32
+	MaxChunkSize      = 64 * 1024
+	nonceSize         = 12
+	tagSize           = 16
+	lengthSize        = 4
+	macSize           = sha256.Size
+	version      byte = 0x01
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid encryption key")
+
+	magic = []byte{0x4F, 0x44}
+)
+
+type Encryptor struct {
+	key  []byte
+	aead cipher.AEAD
+}
+
+// NewEncryptor creates an encryptor from a 32-byte AES-256 key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	aead, err := newAEAD(key)
+	if err != nil {
+		return nil, err
+	}
+
+	k := make([]byte, len(key))
+	copy(k, key)
+
+	return &Encryptor{key: k, aead: aead}, nil
+}
+
+func newAEAD(key []byte) (cipher.AEAD, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	return cipher.NewGCM(block)
+}
+
+// EncryptWriter returns a writer that encrypts everything written to it and writes the result to w.
+// Close must be called to flush the final chunk and write the trailer; it does not close w.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:    w,
+		aead: e.aead,
+		mac:  hmac.New(sha256.New, e.key),
+		buf:  make([]byte, 0, MaxChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+
+	ew.headerWritten = true
+	header := append(append([]byte{}, magic...), version)
+	_, err := ew.w.Write(header)
+	return err
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("encryption: write to closed writer")
+	}
+
+	if ew.err != nil {
+		return 0, ew.err
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		ew.err = err
+		return 0, err
+	}
+
+	written := 0
+	for len(p) > 0 {
+		n := min(MaxChunkSize-len(ew.buf), len(p))
+		ew.buf = append(ew.buf, p[:n]...)
+		p = p[n:]
+		written += n
+
+		if len(ew.buf) == MaxChunkSize {
+			if err := ew.flushChunk(); err != nil {
+				ew.err = err
+				return written, err
+			}
+		}
+	}
+
+	return written, nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("encryption: failed to generate nonce: %w", err)
+	}
+
+	out := make([]byte, lengthSize, lengthSize+nonceSize+len(ew.buf)+tagSize)
+	binary.BigEndian.PutUint32(out, uint32(nonceSize+len(ew.buf)+tagSize))
+	out = append(out, nonce...)
+	out = ew.aead.Seal(out, nonce, ew.buf, nil)
+
+	ew.mac.Write(out)
+	ew.buf = ew.buf[:0]
+
+	_, err := ew.w.Write(out)
+	return err
+}
+
+// Close flushes remaining data and writes the sentinel and HMAC. It is idempotent.
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return ew.err
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	if err := ew.flushChunk(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	trailer := make([]byte, lengthSize, lengthSize+macSize)
+	trailer = ew.mac.Sum(trailer)
+
+	if _, err := ew.w.Write(trailer); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+// DecryptReader returns a reader that decrypts a stream produced by EncryptWriter.
+// The stream is read lazily: header, integrity and authentication errors are returned from Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	aead, err := newAEAD(key)
+	if err != nil {
+		return nil, err
+	}
+
+	return &decryptReader{
+		r:    bufio.NewReader(r),
+		aead: aead,
+		mac:  hmac.New(sha256.New, key),
+	}, nil
+}
+
+type decryptReader struct {
+	r       io.Reader
+	aead    cipher.AEAD
+	mac     hash.Hash
+	started bool
+	done    bool
+	plain   []byte
+	err     error
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	for len(dr.plain) == 0 {
+		if dr.err != nil {
+			return 0, dr.err
+		}
+
+		if dr.done {
+			return 0, io.EOF
+		}
+
+		if err := dr.next(); err != nil {
+			dr.err = err
+		}
+	}
+
+	n := copy(p, dr.plain)
+	dr.plain = dr.plain[n:]
+	return n, nil
+}
+
+func unexpected(err error) error {
+	if errors.Is(err, io.EOF) {
+		return io.ErrUnexpectedEOF
+	}
+	return err
+}
+
+func (dr *decryptReader) readHeader() error {
+	header := make([]byte, len(magic)+1)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		return fmt.Errorf("encryption: invalid header: %w", unexpected(err))
+	}
+
+	if !bytes.Equal(header[:len(magic)], magic) {
+		return errors.New("encryption: invalid header: bad magic bytes")
+	}
+
+	if header[len(magic)] != version {
+		return fmt.Errorf("encryption: unsupported version %d", header[len(magic)])
+	}
+
+	return nil
+}
+
+// next reads and decrypts the next chunk, or verifies the trailer when the sentinel is reached.
+func (dr *decryptReader) next() error {
+	if !dr.started {
+		dr.started = true
+		if err := dr.readHeader(); err != nil {
+			return err
+		}
+	}
+
+	lenBuf := make([]byte, lengthSize)
+	if _, err := io.ReadFull(dr.r, lenBuf); err != nil {
+		return fmt.Errorf("encryption: truncated stream: %w", unexpected(err))
+	}
+
+	length := binary.BigEndian.Uint32(lenBuf)
+	if length == 0 {
+		return dr.verifyTrailer()
+	}
+
+	if length <= nonceSize+tagSize || length > nonceSize+MaxChunkSize+tagSize {
+		return fmt.Errorf("encryption: invalid chunk length %d", length)
+	}
+
+	chunk := make([]byte, length)
+	if _, err := io.ReadFull(dr.r, chunk); err != nil {
+		return fmt.Errorf("encryption: truncated stream: %w", unexpected(err))
+	}
+
+	dr.mac.Write(lenBuf)
+	dr.mac.Write(chunk)
+
+	plain, err := dr.aead.Open(nil, chunk[:nonceSize], chunk[nonceSize:], nil)
+	if err != nil {
+		return fmt.Errorf("encryption: failed to decrypt chunk (wrong key or corrupted data): %w", err)
+	}
+
+	dr.plain = plain
+	return nil
+}
+
+func (dr *decryptReader) verifyTrailer() error {
+	expected := make([]byte, macSize)
+	if _, err := io.ReadFull(dr.r, expected); err != nil {
+		return fmt.Errorf("encryption: integrity check failed: truncated HMAC: %w", unexpected(err))
+	}
+
+	if !hmac.Equal(expected, dr.mac.Sum(nil)) {
+		return errors.New("encryption: integrity check failed: HMAC mismatch")
+	}
+
+	dr.done = true
+	return nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..9c374f3
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,174 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func testKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, KeySize)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+	return key
+}
+
+func encrypt(t *testing.T, key, plain []byte) []byte {
+	t.Helper()
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write(plain)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	require.NoError(t, w.Close())
+	return buf.Bytes()
+}
+
+func decrypt(key, data []byte) ([]byte, error) {
+	r, err := DecryptReader(bytes.NewReader(data), key)
+	if err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+func TestNewEncryptorInvalidKey(t *testing.T) {
+	for _, n := range []int{0, 16, 31, 33} {
+		_, err := NewEncryptor(make([]byte, n))
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+}
+
+func TestRoundTrip(t *testing.T) {
+	key := testKey(t)
+	for _, size := range []int{0, 1, MaxChunkSize - 1, MaxChunkSize, MaxChunkSize + 1, 3*MaxChunkSize + 17} {
+		plain := make([]byte, size)
+		_, _ = rand.Read(plain)
+
+		data := encrypt(t, key, plain)
+		assert.Equal(t, []byte{0x4F, 0x44, 0x01}, data[:3])
+
+		got, err := decrypt(key, data)
+		require.NoError(t, err, "size %d", size)
+		assert.True(t, bytes.Equal(plain, got), "size %d", size)
+	}
+}
+
+func TestEncryptionIsRandomized(t *testing.T) {
+	key := testKey(t)
+	plain := bytes.Repeat([]byte("a"), 2*MaxChunkSize)
+	a := encrypt(t, key, plain)
+	b := encrypt(t, key, plain)
+	assert.NotEqual(t, a, b)
+
+	// nonces of the two chunks in one stream differ
+	chunk := 4 + 12 + MaxChunkSize + 16
+	n1 := a[3+4 : 3+4+12]
+	n2 := a[3+chunk+4 : 3+chunk+4+12]
+	assert.NotEqual(t, n1, n2)
+}
+
+func TestDecryptErrors(t *testing.T) {
+	key := testKey(t)
+	data := encrypt(t, key, []byte("hello world"))
+
+	bad := append([]byte{}, data...)
+	bad[0] = 0x00
+	_, err := decrypt(key, bad)
+	assert.ErrorContains(t, err, "invalid header")
+
+	bad = append([]byte{}, data...)
+	bad[2] = 0x02
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "unsupported version")
+
+	bad = append([]byte{}, data...)
+	bad[len(bad)-1] ^= 0xFF
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "integrity")
+
+	_, err = decrypt(testKey(t), data)
+	assert.Error(t, err)
+
+	for i := 0; i < len(data); i++ {
+		_, err = decrypt(key, data[:i])
+		assert.Error(t, err, "truncated at %d", i)
+	}
+
+	_, err = DecryptReader(bytes.NewReader(data), []byte("short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+}
