+func TestStorageReadWriteCloserEncrypted(t *testing.T) {
+	assert := assert.New(t)
+	key := bytes.Repeat([]byte{7}, encryption.KeySize)
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.Nil(err)
+
+	plain := bytes.Repeat([]byte("onedump encrypted data "), 10000)
+	readers, writer, closer := storageReadWriteCloser(2, true, encryptor)
+
+	go func() {
+		_, _ = writer.Write(plain)
+		_ = closer.Close()
+	}()
+
+	var wg sync.WaitGroup
+	outputs := make([][]byte, len(readers))
+	for i, r := range readers {
+		wg.Add(1)
+		go func(i int, r io.Reader) {
+			defer wg.Done()
+			outputs[i], _ = io.ReadAll(r)
+		}(i, r)
+	}
+	wg.Wait()
+
+	for _, out := range outputs {
+		dr, err := encryption.DecryptReader(bytes.NewReader(out), key)
+		assert.Nil(err)
+		gr, err := gzip.NewReader(dr)
+		assert.Nil(err)
+		got, err := io.ReadAll(gr)
+		assert.Nil(err)
+		assert.Equal(plain, got)
+	}
+}
