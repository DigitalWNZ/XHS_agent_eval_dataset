+// Load the encryption key and build the encryptor if the job requires encryption.
+func (handler *JobHandler) getEncryptor() (*encryption.Encryptor, error) {
+	job := handler.Job
+
+	if !job.Encrypted() {
+		return nil, nil
+	}
+
+	if err := job.Encryption.Validate(); err != nil {
+		return nil, fmt.Errorf("invalid encryption config: %w", err)
+	}
+
+	key, err := encryption.LoadKey(job.Encryption)
+	if err != nil {
+		return nil, fmt.Errorf("could not load encryption key: %w", err)
+	}
+
+	encryptor, err := encryption.NewEncryptor(key)
+	if err != nil {
+		return nil, fmt.Errorf("invalid encryption key: %w", err)
+	}
+
+	return encryptor, nil
+}
