+func TestStorageReadWriteCloserEncrypted(t *testing.T) {
+	assert := assert.New(t)
+	key := bytes.Repeat([]byte{7}, 32)
+	enc, err := encryption.NewEncryptor(key)
+	assert.NoError(err)
+
+	readers, writer, closer := storageReadWriteCloser(2, true, enc)
+	original := bytes.Repeat([]byte("onedump data "), 20000)
+
+	go func() {
+		_, _ = writer.Write(original)
+		_ = closer.Close()
+	}()
+
+	var wg sync.WaitGroup
+	results := make([][]byte, len(readers))
+	for i, r := range readers {
+		wg.Add(1)
+		go func(i int, r io.Reader) {
+			defer wg.Done()
+			results[i], _ = io.ReadAll(r)
+		}(i, r)
+	}
+	wg.Wait()
+
+	for _, data := range results {
+		dr, err := encryption.DecryptReader(bytes.NewReader(data), key)
+		assert.NoError(err)
+		gr, err := gzip.NewReader(dr)
+		assert.NoError(err)
+		got, err := io.ReadAll(gr)
+		assert.NoError(err)
+		assert.Equal(original, got)
+	}
+}
