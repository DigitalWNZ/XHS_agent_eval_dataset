+		return
+	}
+	g.dimension = int(dim)
+	g.refPoint.Point.X = d.readFloat64()
+	g.refPoint.Point.Y = d.readFloat64()
+	g.refPoint.Point.Z = d.readFloat64()
+	g.refPoint.Contained = d.readBool()
