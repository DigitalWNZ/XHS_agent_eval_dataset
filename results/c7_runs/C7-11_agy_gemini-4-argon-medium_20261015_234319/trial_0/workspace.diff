+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	// 1. Empty reader
+	idx := NewShapeIndex()
+	if err := idx.Decode(bytes.NewReader(nil)); err == nil {
+		t.Errorf("expected error decoding empty byte slice, got nil")
+	}
+
+	// Build a valid index with several shapes and cells
+	validIndex := makeShapeIndex("0:0 | 1:1 # 0:0, 2:2, 4:4 # 0:0, 0:5, 5:5, 5:0; 1:1, 1:2, 2:2, 2:1")
+	p := makePolygon("10:10, 10:12, 12:12", false)
+	validIndex.Add(p)
+	validIndex.Add(LoopFromPoints(parsePoints("20:20, 20:22, 22:22")))
+	var validBuf bytes.Buffer
+	if err := validIndex.Encode(&validBuf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := validBuf.Bytes()
+
+	// 2. Every truncated prefix of validBytes must return an error without panicking
+	for i := 0; i < len(validBytes); i++ {
+		decoded := NewShapeIndex()
+		if err := decoded.Decode(bytes.NewReader(validBytes[:i])); err == nil {
+			t.Errorf("expected error on truncated input of length %d/%d, got nil", i, len(validBytes))
+		}
+	}
+
+	// 3. Single-byte corruptions across the buffer must not panic
+	for i := 0; i < len(validBytes); i++ {
+		corrupted := append([]byte(nil), validBytes...)
+		corrupted[i] ^= 0xff
+		decoded := NewShapeIndex()
+		_ = decoded.Decode(bytes.NewReader(corrupted))
+	}
+
+	// 4. Specific malformed headers & oversized allocation requests
+	makeMalformed := func(fn func(e *encoder)) []byte {
+		var b bytes.Buffer
+		e := &encoder{w: &b}
+		fn(e)
+		return b.Bytes()
+	}
+
+	malformedCases := []struct {
+		name string
+		data []byte
+	}{
+		{
+			name: "bad version",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(99)
+			}),
+		},
+		{
+			name: "zero maxEdgesPerCell",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(0)
+			}),
+		},
+		{
+			name: "oversized maxEdgesPerCell",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(math.MaxUint64)
+			}),
+		},
+		{
+			name: "negative nextID",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(-1)
+			}),
+		},
+		{
+			name: "oversized nextID",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(math.MaxInt32)
+				e.writeUint32(0)
+				e.writeUint32(0)
+			}),
+		},
+		{
+			name: "oversized numShapes",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(100)
+				e.writeUint32(math.MaxUint32)
+			}),
+		},
+		{
+			name: "numShapes greater than nextID",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(1)
+				e.writeUint32(2)
+			}),
+		},
+		{
+			name: "unknown shape typeTag",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(1)
+				e.writeUint32(1)
+				e.writeInt32(0)
+				e.writeUint32(9999)
+			}),
+		},
+		{
+			name: "oversized PointVector vertices",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(1)
+				e.writeUint32(1)
+				e.writeInt32(0)
+				e.writeUint32(uint32(typeTagPointVector))
