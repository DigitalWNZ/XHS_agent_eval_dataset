+func encodeGenericFromShape(e *encoder, shape Shape) {
+	numEdges := shape.NumEdges()
+	if numEdges > maxEncodedVertices {
+		e.err = fmt.Errorf("too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+		return
+	}
+	numChains := shape.NumChains()
+	if numChains > maxEncodedChainsPerShape {
+		e.err = fmt.Errorf("too many chains (%d; max is %d)", numChains, maxEncodedChainsPerShape)
+		return
+	}
+	g := genericShape{
+		dimension: shape.Dimension(),
+		refPoint:  shape.ReferencePoint(),
+		edges:     make([]Edge, numEdges),
+		chains:    make([]Chain, numChains),
+	}
+	for i := range numEdges {
+		g.edges[i] = shape.Edge(i)
+	}
+	for i := range numChains {
+		g.chains[i] = shape.Chain(i)
+	}
