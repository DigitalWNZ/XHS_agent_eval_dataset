+	t.Helper()
+	if (a == nil) != (b == nil) {
+		t.Fatalf("shape nil mismatch: got %v, want %v", a, b)
+	}
+	if a == nil {
+		return
+	}
+	if a.Dimension() != b.Dimension() {
+		t.Errorf("Dimension() = %d, want %d", a.Dimension(), b.Dimension())
+	}
+	if a.NumEdges() != b.NumEdges() {
+		t.Fatalf("NumEdges() = %d, want %d", a.NumEdges(), b.NumEdges())
+	}
+	for i := 0; i < a.NumEdges(); i++ {
+		if a.Edge(i) != b.Edge(i) {
+			t.Errorf("Edge(%d) = %v, want %v", i, a.Edge(i), b.Edge(i))
+		}
+	}
+	if a.NumChains() != b.NumChains() {
+		t.Fatalf("NumChains() = %d, want %d", a.NumChains(), b.NumChains())
+	}
+	for c := 0; c < a.NumChains(); c++ {
+		ca, cb := a.Chain(c), b.Chain(c)
+		if ca != cb {
+			t.Fatalf("Chain(%d) = %v, want %v", c, ca, cb)
+		}
+		for offset := 0; offset < ca.Length; offset++ {
+			if a.ChainEdge(c, offset) != b.ChainEdge(c, offset) {
+				t.Errorf("ChainEdge(%d, %d) = %v, want %v", c, offset, a.ChainEdge(c, offset), b.ChainEdge(c, offset))
+			}
+		}
+	}
+	for i := 0; i < a.NumEdges(); i++ {
+		if a.ChainPosition(i) != b.ChainPosition(i) {
+			t.Errorf("ChainPosition(%d) = %v, want %v", i, a.ChainPosition(i), b.ChainPosition(i))
+		}
+	}
+	if a.IsEmpty() != b.IsEmpty() {
+		t.Errorf("IsEmpty() = %v, want %v", a.IsEmpty(), b.IsEmpty())
+	}
+	if a.IsFull() != b.IsFull() {
+		t.Errorf("IsFull() = %v, want %v", a.IsFull(), b.IsFull())
+	}
+	if a.ReferencePoint().Contained != b.ReferencePoint().Contained {
+		t.Errorf("ReferencePoint().Contained = %v, want %v", a.ReferencePoint().Contained, b.ReferencePoint().Contained)
+	}
+	if a.typeTag() != b.typeTag() {
+		t.Errorf("typeTag() = %v, want %v", a.typeTag(), b.typeTag())
+	}
+}
+
+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	for id := int32(0); id < want.nextID; id++ {
+		assertShapeEqual(t, got.Shape(id), want.Shape(id))
+	}
+
+	// Verify spatial cell structure without calling Build on got!
+	if !got.IsFresh() {
+		t.Errorf("decoded ShapeIndex should be fresh without calling Build()")
+	}
+	if len(got.cells) != len(want.cells) {
+		t.Fatalf("len(cells) = %d, want %d", len(got.cells), len(want.cells))
+	}
+	for i := range want.cells {
+		cid := want.cells[i]
+		if got.cells[i] != cid {
+			t.Fatalf("cells[%d] = %v, want %v", i, got.cells[i], cid)
+		}
+		gotCell := got.cellMap[cid]
+		wantCell := want.cellMap[cid]
+		if (gotCell == nil) != (wantCell == nil) {
+			t.Fatalf("cellMap[%v] nil mismatch", cid)
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Fatalf("cell %v len(shapes) = %d, want %d", cid, len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for j := range wantCell.shapes {
+			gc := gotCell.shapes[j]
+			wc := wantCell.shapes[j]
+			if gc.shapeID != wc.shapeID || gc.containsCenter != wc.containsCenter {
+				t.Errorf("cell %v shape %d = (%d, %v), want (%d, %v)",
+					cid, j, gc.shapeID, gc.containsCenter, wc.shapeID, wc.containsCenter)
+			}
+			if len(gc.edges) != len(wc.edges) {
+				t.Fatalf("cell %v shape %d len(edges) = %d, want %d", cid, j, len(gc.edges), len(wc.edges))
+			}
+			for k := range wc.edges {
+				if gc.edges[k] != wc.edges[k] {
+					t.Errorf("cell %v shape %d edge[%d] = %d, want %d", cid, j, k, gc.edges[k], wc.edges[k])
+				}
+			}
+		}
+	}
+
+	quadraticValidate(t, got)
+	testIteratorMethods(t, got)
+}
