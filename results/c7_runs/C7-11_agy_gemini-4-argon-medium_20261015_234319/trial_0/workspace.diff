+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	s.Reset()
+
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	maxEdges := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if maxEdges == 0 || maxEdges > maxEncodedEdgesPerCell {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell: %d", maxEdges)
+		return
+	}
+
+	nextID := d.readInt32()
+	if d.err != nil {
+		return
+	}
+	if nextID < 0 || nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("invalid nextID: %d", nextID)
+		return
+	}
+
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxEncodedShapes || int64(numShapes) > int64(nextID) {
+		d.err = fmt.Errorf("invalid numShapes: %d (nextID: %d)", numShapes, nextID)
+		return
+	}
+
+	shapes := make(map[int32]Shape, numShapes)
+	for range numShapes {
+		id := d.readInt32()
+		tag := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if id < 0 || id >= nextID {
+			d.err = fmt.Errorf("invalid shape ID %d (nextID %d)", id, nextID)
+			return
+		}
+		if _, exists := shapes[id]; exists {
+			d.err = fmt.Errorf("duplicate shape ID %d", id)
+			return
+		}
+
+		var shape Shape
+		switch tag {
+		case uint32(typeTagPolygon):
+			p := new(Polygon)
+			v := int8(d.readUint8())
+			if d.err != nil {
+				return
+			}
+			switch v {
+			case encodingVersion:
+				p.decode(d)
+			case encodingCompressedVersion:
+				p.decodeCompressed(d)
+			default:
+				d.err = fmt.Errorf("unsupported polygon version %d", v)
+				return
+			}
+			shape = p
+		case uint32(typeTagPolyline):
+			p := new(Polyline)
+			p.decode(d)
+			shape = p
+		case uint32(typeTagPointVector):
+			p := new(PointVector)
+			p.decode(d)
+			shape = p
+		case uint32(typeTagLaxPolyline):
+			p := new(LaxPolyline)
+			p.decode(d)
+			shape = p
+		case uint32(typeTagLaxPolygon):
+			p := new(LaxPolygon)
+			p.decode(d)
+			shape = p
+		case shapeTypeTagLoop:
+			l := new(Loop)
+			l.decode(d)
+			shape = l
+		case shapeTypeTagLaxLoop:
+			l := new(LaxLoop)
+			l.decode(d)
+			shape = l
+		case shapeTypeTagGeneric:
+			g := new(genericShape)
+			g.decode(d)
+			shape = g
+		default:
+			d.err = fmt.Errorf("unsupported shape type tag %d", tag)
+			return
+		}
+		if d.err != nil {
+			return
+		}
+		shapes[id] = shape
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	cells := make([]CellID, numCells)
+	cellMap := make(map[CellID]*ShapeIndexCell, numCells)
+	for i := range numCells {
+		cid := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !cid.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID %v at index %d", cid, i)
+			return
+		}
+		if i > 0 && cid <= cells[i-1] {
+			d.err = fmt.Errorf("cell IDs not strictly increasing at index %d: %v <= %v", i, cid, cells[i-1])
+			return
+		}
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped > numShapes {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; numShapes is %d)", numClipped, numShapes)
+			return
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		prevShapeID := int32(-1)
+		for j := range numClipped {
+			shapeID := d.readInt32()
+			containsCenter := d.readBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			if shapeID <= prevShapeID {
+				d.err = fmt.Errorf("clipped shape IDs not strictly increasing: %d <= %d", shapeID, prevShapeID)
+				return
+			}
+			prevShapeID = shapeID
+
+			shape, ok := shapes[shapeID]
+			if !ok || shape == nil {
+				d.err = fmt.Errorf("clipped shape references unknown shape ID %d", shapeID)
+				return
+			}
+			shapeNumEdges := shape.NumEdges()
+			if int64(numEdges) > int64(shapeNumEdges) || numEdges > maxEncodedEdgesPerCell {
+				d.err = fmt.Errorf("too many edges in clipped shape (%d; shape has %d)", numEdges, shapeNumEdges)
+				return
+			}
+
+			clipped := newClippedShape(shapeID, int(numEdges))
+			clipped.containsCenter = containsCenter
+			prevEdgeID := int32(-1)
+			for k := range numEdges {
+				edgeID := d.readInt32()
+				if d.err != nil {
+					return
+				}
+				if edgeID <= prevEdgeID || int(edgeID) >= shapeNumEdges {
+					d.err = fmt.Errorf("invalid or out-of-order edge ID %d (prev %d, max %d)", edgeID, prevEdgeID, shapeNumEdges)
+					return
+				}
+				prevEdgeID = edgeID
+				clipped.edges[k] = int(edgeID)
+			}
+			cell.shapes[j] = clipped
+		}
+
+		cells[i] = cid
+		cellMap[cid] = cell
+	}
+
+	s.maxEdgesPerCell = int(maxEdges)
+	s.shapes = shapes
+	s.nextID = nextID
+	s.pendingAdditionsPos = nextID
+	s.pendingRemovals = nil
+	s.cells = cells
+	s.cellMap = cellMap
+	atomic.StoreInt32(&s.status, fresh)
 }
