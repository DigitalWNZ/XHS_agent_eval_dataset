+				e.writeUvarint(10)
+				e.writeInt32(0)
+				e.writeUint32(0)
+				e.writeUint32(math.MaxUint32)
+			}),
+		},
+		{
+			name: "invalid cell ID in cell list",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(0)
+				e.writeUint32(0)
+				e.writeUint32(1)
+				e.writeUint64(0) // invalid CellID
+				e.writeUint32(0)
+			}),
+		},
+		{
+			name: "clipped shape referencing non-existent shapeID",
+			data: makeMalformed(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeInt32(1)
+				e.writeUint32(0) // 0 shapes
+				e.writeUint32(1) // 1 cell
+				e.writeUint64(uint64(CellIDFromFace(0)))
+				e.writeUint32(1) // 1 clipped shape, but numShapes is 0
+			}),
+		},
+		{
+			name: "varint overflow",
+			data: append([]byte{byte(encodingVersion)}, bytes.Repeat([]byte{0x80}, 15)...),
+		},
+	}
+
+	for _, tc := range malformedCases {
+		t.Run(tc.name, func(t *testing.T) {
+			decoded := NewShapeIndex()
+			if err := decoded.Decode(bytes.NewReader(tc.data)); err == nil {
+				t.Errorf("case %q: expected error, got nil", tc.name)
+			}
+		})
+	}
+	_ = binary.LittleEndian
+}
