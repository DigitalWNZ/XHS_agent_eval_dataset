+func TestShapeIndexEncodeDecodeNonContiguousShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	s0 := makeLaxPolyline("0:0, 0:2")
+	s1 := makeLaxPolygon("0:0, 0:5, 5:5, 5:0")
+	s2 := makeLaxPolyline("1:1, 2:2")
+	s3 := makePolygon("10:10, 10:15, 15:15, 15:10", false)
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+	id3 := index.Add(s3)
+
+	// Remove s0 (before build) and s2 (after build)
+	index.Remove(s0)
+	index.Build()
+	index.Remove(s2)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(id0) != nil {
+		t.Errorf("expected removed shape %d to be nil, got %v", id0, decoded.Shape(id0))
+	}
+	if decoded.Shape(id1) == nil {
+		t.Errorf("expected shape %d to be present", id1)
+	}
+	if decoded.Shape(id2) != nil {
+		t.Errorf("expected removed shape %d to be nil, got %v", id2, decoded.Shape(id2))
+	}
+	if decoded.Shape(id3) == nil {
+		t.Errorf("expected shape %d to be present", id3)
+	}
+
+	assertShapeIndexEqual(t, decoded, index)
+
+	// Verify queries work on decoded index without calling Build
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(parsePoint("2:2")) {
+		t.Errorf("ContainsPointQuery expected true for 2:2 in s1")
+	}
+	if !cpq.ShapeContains(decoded.Shape(id1), parsePoint("2:2")) {
+		t.Errorf("ShapeContains expected true for s1 at 2:2")
+	}
+	if !cpq.ShapeContains(decoded.Shape(id3), parsePoint("12:12")) {
+		t.Errorf("ShapeContains expected true for s3 at 12:12")
+	}
+	if cpq.Contains(parsePoint("20:20")) {
+		t.Errorf("ContainsPointQuery expected false for 20:20")
+	}
+
+	ceq := NewCrossingEdgeQuery(decoded)
+	edgeMap := ceq.CrossingsEdgeMap(parsePoint("-1:2"), parsePoint("6:2"), CrossingTypeAll)
+	if len(edgeMap[decoded.Shape(id1)]) == 0 {
+		t.Errorf("CrossingEdgeQuery expected crossings for s1")
+	}
+
+	closest := NewClosestEdgeQuery(decoded, NewClosestEdgeQueryOptions().MaxResults(5))
+	res := closest.FindEdges(NewMinDistanceToPointTarget(parsePoint("12:12")))
+	if len(res) == 0 || res[0].ShapeID() != id3 {
+		t.Errorf("ClosestEdgeQuery expected shape %d, got %v", id3, res)
+	}
+
+	// Verify EdgeIterator works on decoded index with gaps
+	verifyEdgeIterator(t, decoded)
+}
