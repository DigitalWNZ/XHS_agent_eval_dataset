+
+// Encode encodes the LaxPolygon.
+func (p *LaxPolygon) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	p.encode(e)
+	return e.err
+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUint32(uint32(p.numLoops))
+	if e.err != nil {
+		return
+	}
+	if p.numLoops > maxEncodedLoops {
+		e.err = fmt.Errorf("too many loops (%d; max is %d)", p.numLoops, maxEncodedLoops)
+		return
+	}
+	numVertices := p.numVertices()
+	if numVertices > maxEncodedVertices {
+		e.err = fmt.Errorf("too many vertices (%d; max is %d)", numVertices, maxEncodedVertices)
+		return
+	}
+	e.writeUint32(uint32(numVertices))
+	for _, v := range p.vertices {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+	if p.numLoops > 1 {
+		for _, cv := range p.cumulativeVertices {
+			e.writeUint32(uint32(cv))
+		}
+	}
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	nloops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	nvertices := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nvertices > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", nvertices, maxEncodedVertices)
+		return
+	}
+	*p = LaxPolygon{
+		numLoops: int(nloops),
+	}
+	if nvertices > 0 {
+		p.vertices = make([]Point, nvertices)
+		for i := range p.vertices {
+			p.vertices[i].X = d.readFloat64()
+			p.vertices[i].Y = d.readFloat64()
+			p.vertices[i].Z = d.readFloat64()
+			if d.err != nil {
+				return
+			}
+		}
+	}
+	if p.numLoops <= 1 {
+		if p.numLoops == 0 && nvertices != 0 {
+			d.err = fmt.Errorf("invalid LaxPolygon: 0 loops with %d vertices", nvertices)
+			return
+		}
+		p.numVerts = int(nvertices)
+	} else {
+		p.cumulativeVertices = make([]int, p.numLoops+1)
+		for i := range p.cumulativeVertices {
+			cv := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			if cv > nvertices {
+				d.err = fmt.Errorf("cumulative vertex count %d exceeds total vertices %d", cv, nvertices)
+				return
+			}
+			if i > 0 && int(cv) < p.cumulativeVertices[i-1] {
+				d.err = fmt.Errorf("cumulative vertices not monotonic at %d", i)
+				return
+			}
+			p.cumulativeVertices[i] = int(cv)
+		}
+		if p.cumulativeVertices[0] != 0 || p.cumulativeVertices[p.numLoops] != int(nvertices) {
+			d.err = fmt.Errorf("invalid cumulative vertices bounds: [%d, %d] for %d vertices",
+				p.cumulativeVertices[0], p.cumulativeVertices[p.numLoops], nvertices)
+			return
+		}
+	}
 }
 
