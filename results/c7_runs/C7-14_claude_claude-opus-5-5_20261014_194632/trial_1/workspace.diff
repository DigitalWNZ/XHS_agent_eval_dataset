+func TestShapeIndexDecodeOversized(t *testing.T) {
+	uv := func(xs ...uint64) []byte {
+		var out []byte
+		for _, x := range xs {
+			out = binary.AppendUvarint(out, x)
+		}
+		return out
+	}
+	version := []byte{shapeIndexEncodingVersion}
+	cat := func(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+	huge := uint64(1) << 62
+
+	tests := []struct {
+		name string
+		data []byte
+	}{
+		{"empty input", nil},
+		{"bad version", cat([]byte{99}, uv(10, 0, 0, 0))},
+		{"huge maxEdgesPerCell", cat(version, uv(huge))},
+		{"huge nextID", cat(version, uv(10, huge))},
+		{"numShapes > nextID", cat(version, uv(10, 1, 2))},
+		{"huge numCells", cat(version, uv(10, 0, 0, huge))},
+		{"huge point count", cat(version, uv(10, 1, 1, 0, shapeIndexTagPointVector, maxEncodedVertices))},
+		{"too many points", cat(version, uv(10, 1, 1, 0, shapeIndexTagPointVector, huge))},
+		{"huge loop count", cat(version, uv(10, 1, 1, 0, shapeIndexTagLaxPolygon, huge))},
+		{"huge polygon loops", cat(version, uv(10, 1, 1, 0, shapeIndexTagPolygon), []byte{0}, uv(maxEncodedLoops))},
+		{"huge generic chains", cat(version, uv(10, 1, 1, 0, shapeIndexTagGeneric), []byte{1, 0}, make([]byte, 24), uv(1<<31-1))},
+		{"unknown tag", cat(version, uv(10, 1, 1, 0, 1000))},
+		{"invalid cell", cat(version, uv(10, 0, 0, 1), make([]byte, 8))},
+		{"cell references missing shape", cat(version, uv(10, 0, 0, 1),
+			binary.LittleEndian.AppendUint64(nil, uint64(CellIDFromFace(0))), uv(1, 0))},
+		{"clipped edge out of range", cat(version, uv(10, 1, 1, 0, shapeIndexTagPointVector, 0, 1),
+			binary.LittleEndian.AppendUint64(nil, uint64(CellIDFromFace(0))), uv(1, 0), []byte{0}, uv(1, 0))},
+	}
+	for _, test := range tests {
+		var got ShapeIndex
+		if err := got.Decode(bytes.NewReader(test.data)); err == nil {
+			t.Errorf("%s: Decode() succeeded, want error", test.name)
+		}
+	}
+}
