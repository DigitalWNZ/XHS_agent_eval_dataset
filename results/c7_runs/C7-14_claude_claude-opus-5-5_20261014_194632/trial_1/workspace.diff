+func TestShapeIndexEncodeDecodeRoundTrip(t *testing.T) {
+	for name, shapes := range testShapeIndexShapes() {
+		t.Run(name, func(t *testing.T) {
+			index := NewShapeIndex()
+			for _, s := range shapes {
+				index.Add(s)
+			}
+			index.Build()
+			got := roundTripShapeIndex(t, index)
+			checkShapeIndexesEqual(t, index, got)
+		})
+	}
+}
