+func TestShapeIndexEncodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	a := makeLaxPolyline("0:0, 1:1")
+	b := makeLaxPolyline("2:2, 3:3")
+	c := makeLaxPolyline("4:4, 5:5")
+	index.Add(a)
+	index.Add(b)
+	index.Add(c)
+	index.Build()
+	// Remove a shape that was never indexed to leave a hole in the ID space.
+	d := makeLaxPolyline("6:6, 7:7")
+	index.Add(d)
+	index.Remove(b)
+	index.Remove(d)
+
+	got := roundTripShapeIndex(t, index)
+	if got.Shape(1) != nil {
+		t.Errorf("removed shape 1 present after decoding")
+	}
+	for id, want := range map[int32]Shape{0: a, 2: c} {
+		if got.Shape(id) == nil {
+			t.Fatalf("shape %d missing after decoding", id)
+		}
+		checkShapesEqual(t, id, want, got.Shape(id))
+	}
+	if got.nextID != 4 {
+		t.Errorf("nextID = %d, want 4", got.nextID)
+	}
+	for it := got.Iterator(); !it.Done(); it.Next() {
+		for _, clipped := range it.IndexCell().shapes {
+			if got.Shape(clipped.shapeID) == nil {
+				t.Errorf("cell %v references missing shape %d", it.CellID(), clipped.shapeID)
+			}
+		}
+	}
+
+}
