+func encodedTestIndex(t testing.TB) []byte {
+	index := NewShapeIndex()
+	for _, shapes := range testShapeIndexShapes() {
+		for _, s := range shapes {
+			index.Add(s)
+		}
+	}
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func TestShapeIndexDecodeTruncated(t *testing.T) {
+	data := encodedTestIndex(t)
+	for i := range len(data) {
+		var got ShapeIndex
+		if err := got.Decode(bytes.NewReader(data[:i])); err == nil {
+			t.Fatalf("Decode() of %d/%d bytes succeeded, want error", i, len(data))
+		}
+	}
+}
+
+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	data := encodedTestIndex(t)
+	r := rand.New(rand.NewSource(2))
+	for range 2000 {
+		corrupt := append([]byte(nil), data...)
+		for range 1 + r.Intn(4) {
+			corrupt[r.Intn(len(corrupt))] = byte(r.Intn(256))
+		}
+		var got ShapeIndex
+		// Must not panic; errors are expected but not required, since a
+		// corrupted float is still a valid encoding.
+		if err := got.Decode(bytes.NewReader(corrupt)); err == nil {
+			for it := got.Iterator(); !it.Done(); it.Next() {
+			}
+		}
+	}
+}
