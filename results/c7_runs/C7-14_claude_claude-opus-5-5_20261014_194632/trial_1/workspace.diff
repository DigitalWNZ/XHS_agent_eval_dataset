+// checkShapeIndexesEqual verifies that two indexes have the same shapes
+// and the same cell structure.
+func checkShapeIndexesEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+	if want.Len() != got.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if want.nextID != got.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	if want.maxEdgesPerCell != got.maxEdgesPerCell {
+		t.Errorf("maxEdgesPerCell = %d, want %d", got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+	for id, shape := range want.shapes {
+		gotShape := got.Shape(id)
+		if gotShape == nil {
+			t.Errorf("shape %d missing after decoding", id)
+			continue
+		}
+		checkShapesEqual(t, id, shape, gotShape)
+	}
+
+	wantIt, gotIt := want.Iterator(), got.Iterator()
+	for ; !wantIt.Done(); wantIt.Next() {
+		if gotIt.Done() {
+			t.Fatalf("decoded index is missing cell %v", wantIt.CellID())
+		}
+		if wantIt.CellID() != gotIt.CellID() {
+			t.Fatalf("cell = %v, want %v", gotIt.CellID(), wantIt.CellID())
+		}
+		if !reflect.DeepEqual(wantIt.IndexCell().shapes, gotIt.IndexCell().shapes) {
+			t.Errorf("cell %v contents differ", wantIt.CellID())
+		}
+		gotIt.Next()
+	}
+	if !gotIt.Done() {
+		t.Errorf("decoded index has extra cell %v", gotIt.CellID())
+	}
+}
+
+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("Encode() produced no data")
+	}
+	got := &ShapeIndex{}
+	if err := got.Decode(&buf); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	if !got.IsFresh() {
+		t.Errorf("decoded index is not fresh")
+	}
+	return got
+}
