+func testShapeIndexShapes() map[string][]Shape {
+	pv := PointVector(parsePoints("0:0, 1:1, -2:3"))
+	emptyPV := PointVector{}
+	polyline := makePolyline("0:0, 0:10, 10:10")
+	shortPolyline := makePolyline("5:5")
+	edges := edgeVectorShapeFromPoints(parsePoint("1:1"), parsePoint("2:2"))
+	edges.Add(parsePoint("3:3"), parsePoint("4:5"))
+
+	return map[string][]Shape{
+		"empty":       nil,
+		"polygon":     {makePolygon("0:0, 0:5, 5:5, 5:0; 1:1, 1:2, 2:2, 2:1", true)},
+		"emptyPoly":   {&Polygon{}},
+		"fullPoly":    {FullPolygon()},
+		"loop":        {makeLoop("0:0, 0:5, 5:0")},
+		"emptyLoop":   {EmptyLoop()},
+		"fullLoop":    {FullLoop()},
+		"regularLoop": {RegularLoop(parsePoint("10:10"), s1.Degree, 200)},
+		"polyline":    {polyline, shortPolyline},
+		"pointVector": {&pv, &emptyPV},
+		"laxPolyline": {makeLaxPolyline("0:0, 1:1, 2:0"), makeLaxPolyline("")},
+		"laxPolygon": {
+			makeLaxPolygon("0:0, 0:5, 5:5, 5:0; 1:1; 2:2, 3:3"),
+			makeLaxPolygon("full; 1:1"),
+			makeLaxPolygon(""),
+		},
+		"laxLoop":   {LaxLoopFromPoints(parsePoints("0:0, 0:3, 3:0")), LaxLoopFromPoints(nil)},
+		"generic":   {edges},
+		"mixedSets": {&pv, polyline, makeLaxPolygon("10:10, 10:20, 20:20"), makePolygon("-5:-5, -5:-1, -1:-1", true)},
+	}
+}
