+// checkShapesEqual verifies that two shapes describe the same geometry.
+func checkShapesEqual(t *testing.T, id int32, want, got Shape) {
+	t.Helper()
+	if _, generic := got.(*encodedShape); !generic {
+		if reflect.TypeOf(want) != reflect.TypeOf(got) {
+			t.Errorf("shape %d: type = %T, want %T", id, got, want)
+			return
+		}
+	}
+	if want.Dimension() != got.Dimension() {
+		t.Errorf("shape %d: Dimension() = %d, want %d", id, got.Dimension(), want.Dimension())
+	}
+	if want.ReferencePoint() != got.ReferencePoint() {
+		t.Errorf("shape %d: ReferencePoint() = %v, want %v", id, got.ReferencePoint(), want.ReferencePoint())
+	}
+	if want.IsEmpty() != got.IsEmpty() || want.IsFull() != got.IsFull() {
+		t.Errorf("shape %d: IsEmpty/IsFull = %v/%v, want %v/%v", id, got.IsEmpty(), got.IsFull(), want.IsEmpty(), want.IsFull())
+	}
+	if want.NumEdges() != got.NumEdges() {
+		t.Errorf("shape %d: NumEdges() = %d, want %d", id, got.NumEdges(), want.NumEdges())
+		return
+	}
+	for e := range want.NumEdges() {
+		if want.Edge(e) != got.Edge(e) {
+			t.Errorf("shape %d: Edge(%d) = %v, want %v", id, e, got.Edge(e), want.Edge(e))
+		}
+		if want.ChainPosition(e) != got.ChainPosition(e) {
+			t.Errorf("shape %d: ChainPosition(%d) = %v, want %v", id, e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+	if want.NumChains() != got.NumChains() {
+		t.Errorf("shape %d: NumChains() = %d, want %d", id, got.NumChains(), want.NumChains())
+		return
+	}
+	for c := range want.NumChains() {
+		if want.Chain(c) != got.Chain(c) {
+			t.Errorf("shape %d: Chain(%d) = %v, want %v", id, c, got.Chain(c), want.Chain(c))
+		}
+	}
+}
