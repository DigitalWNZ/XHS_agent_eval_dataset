+func FuzzDecodeShapeIndex(f *testing.F) {
+	f.Add(encodedTestIndex(f))
+	var buf bytes.Buffer
+	NewShapeIndex().Encode(&buf)
+	f.Add(buf.Bytes())
+	f.Fuzz(func(t *testing.T, data []byte) {
+		var index ShapeIndex
+		if err := index.Decode(bytes.NewReader(data)); err != nil {
+			return
+		}
+		// Re-encoding a successfully decoded index must also succeed.
+		var out bytes.Buffer
+		if err := index.Encode(&out); err != nil {
+			t.Fatalf("Encode() of decoded index failed: %v", err)
+		}
+	})
+}
