+func TestShapeIndexEncodeEmpty(t *testing.T) {
+	var buf bytes.Buffer
+	if err := NewShapeIndex().Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Errorf("empty index encoded to no bytes")
+	}
+	got := &ShapeIndex{}
+	if err := got.Decode(&buf); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	if got.Len() != 0 {
+		t.Errorf("Len() = %d, want 0", got.Len())
+	}
+	if it := got.Iterator(); !it.Done() {
+		t.Errorf("decoded empty index has cell %v", it.CellID())
+	}
+}
