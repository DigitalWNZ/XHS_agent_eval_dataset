+func TestShapeIndexEncodeLarge(t *testing.T) {
+	r := rand.New(rand.NewSource(1))
+	index := NewShapeIndex()
+	for range 20 {
+		index.Add(RegularLoop(randomPoint(r), s1.Angle(r.Float64())*s1.Degree*5, 50+r.Intn(200)))
+	}
+	pts := make(PointVector, 500)
+	for i := range pts {
+		pts[i] = randomPoint(r)
+	}
+	index.Add(&pts)
+	index.Build()
+
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexesEqual(t, index, got)
+
+	wantQ := NewContainsPointQuery(index, VertexModelSemiOpen)
+	gotQ := NewContainsPointQuery(got, VertexModelSemiOpen)
+	for range 1000 {
+		p := randomPoint(r)
+		if w, g := len(wantQ.ContainingShapes(p)), len(gotQ.ContainingShapes(p)); w != g {
+			t.Errorf("ContainingShapes(%v) has %d shapes, want %d", p, g, w)
+		}
+	}
+}
