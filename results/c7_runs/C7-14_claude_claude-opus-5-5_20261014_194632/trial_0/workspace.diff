+package s2
+
+import (
+	"bytes"
+	"encoding/binary"
+	"reflect"
+	"testing"
+)
+
+func encodeShapeIndex(t *testing.T, index *ShapeIndex) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	data := encodeShapeIndex(t, index)
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	return got
+}
+
+// checkShapeIndexEqual verifies that two built indexes have identical shapes,
+// IDs and cell contents.
+func checkShapeIndexEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+	want.Build()
+	if !got.IsFresh() {
+		t.Errorf("decoded index is not fresh")
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	for id, ws := range want.shapes {
+		gs := got.Shape(id)
+		if gs == nil {
+			t.Fatalf("shape %d missing after decode", id)
+		}
+		if reflect.TypeOf(gs) != reflect.TypeOf(ws) {
+			t.Errorf("shape %d type = %T, want %T", id, gs, ws)
+		}
+		if gs.NumEdges() != ws.NumEdges() || gs.NumChains() != ws.NumChains() ||
+			gs.Dimension() != ws.Dimension() || gs.ReferencePoint() != ws.ReferencePoint() {
+			t.Errorf("shape %d properties differ", id)
+		}
+		for e := 0; e < ws.NumEdges(); e++ {
+			if gs.Edge(e) != ws.Edge(e) {
+				t.Errorf("shape %d edge %d = %v, want %v", id, e, gs.Edge(e), ws.Edge(e))
+			}
+		}
+		for c := 0; c < ws.NumChains(); c++ {
+			if gs.Chain(c) != ws.Chain(c) {
+				t.Errorf("shape %d chain %d = %v, want %v", id, c, gs.Chain(c), ws.Chain(c))
+			}
+		}
+	}
+	if !reflect.DeepEqual(got.cells, want.cells) && !(len(got.cells) == 0 && len(want.cells) == 0) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	for _, id := range want.cells {
+		gc := got.cellMap[id]
+		// Removed shapes may leave stale clipped shapes behind; these are
+		// not encoded.
+		var wshapes []*clippedShape
+		for _, cs := range want.cellMap[id].shapes {
+			if want.Shape(cs.shapeID) != nil {
+				wshapes = append(wshapes, cs)
+			}
+		}
+		if gc == nil || len(gc.shapes) != len(wshapes) {
+			t.Fatalf("cell %v differs", id)
+		}
+		for i := range wshapes {
+			w, g := wshapes[i], gc.shapes[i]
+			if w.shapeID != g.shapeID || w.containsCenter != g.containsCenter ||
+				!reflect.DeepEqual(append([]int{}, w.edges...), append([]int{}, g.edges...)) {
+				t.Errorf("cell %v clipped shape %d = %+v, want %+v", id, i, g, w)
+			}
+		}
+	}
+}
+
+func TestShapeIndexEncodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	data := encodeShapeIndex(t, index)
+	if len(data) == 0 {
+		t.Fatalf("empty index encoded to zero bytes")
+	}
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, index, got)
+	if !got.Iterator().Done() {
+		t.Errorf("decoded empty index has cells")
+	}
+}
