+func TestShapeIndexEncodeAllShapeTypes(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2", true))
+	index.Add(makePolyline("20:20, 21:22, 23:25"))
+	pv := PointVector(parsePoints("30:30 | 31:31 | -5:-5"))
+	index.Add(&pv)
+	index.Add(makeLaxPolyline("40:40, 41:41"))
+	index.Add(makeLaxPolygon("50:50, 50:55, 55:55; 51:51, 51:52, 52:52"))
+	index.Add(makeLoop("-20:-20, -20:-10, -10:-10, -10:-20"))
+	index.Add(LaxLoopFromPoints(parsePoints("-40:-40, -40:-30, -30:-30")))
+	index.Add(FullPolygon())
+	index.Add(PolygonFromLoops(nil))
+	index.Add(EmptyLoop())
+	index.Add(FullLoop())
+
+	// Encode without an explicit Build.
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, index, got)
+
+	// Queries work on the decoded index.
+	q := NewContainsPointQuery(got, VertexModelSemiOpen)
+	p := PointFromLatLng(LatLngFromDegrees(1, 1))
+	if want := NewContainsPointQuery(index, VertexModelSemiOpen).ContainingShapes(p); len(want) != len(q.ContainingShapes(p)) {
+		t.Errorf("ContainingShapes differ after decode")
+	}
+	if !q.Contains(PointFromLatLng(LatLngFromDegrees(-15, -15))) {
+		t.Errorf("decoded index should contain point in loop")
+	}
+
+	// The decoded index re-encodes to the same bytes.
+	if a, b := encodeShapeIndex(t, index), encodeShapeIndex(t, got); !bytes.Equal(a, b) {
+		t.Errorf("re-encoding decoded index produced different bytes")
+	}
+}
