+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0", true))
+	index.Add(makePolyline("20:20, 21:22"))
+	index.Add(makeLaxPolygon("50:50, 50:55, 55:55; 51:51, 51:52, 52:52"))
+	data := encodeShapeIndex(t, index)
+
+	if err := NewShapeIndex().Decode(bytes.NewReader(nil)); err == nil {
+		t.Errorf("Decode(empty) succeeded")
+	}
+	for i := 0; i < len(data); i++ {
+		if err := NewShapeIndex().Decode(bytes.NewReader(data[:i])); err == nil {
+			t.Errorf("Decode(truncated to %d bytes) succeeded", i)
+		}
+	}
+	// Corrupt each byte in turn; decoding must never panic.
+	for i := 0; i < len(data); i++ {
+		for _, x := range []byte{0xff, 0x80, 0x01} {
+			c := append([]byte(nil), data...)
+			c[i] ^= x
+			_ = NewShapeIndex().Decode(bytes.NewReader(c))
+		}
+	}
+
+	var huge [binary.MaxVarintLen64]byte
+	n := binary.PutUvarint(huge[:], 1<<62)
+	oversized := [][]byte{
+		// Huge shape count.
+		append([]byte{shapeIndexEncodingVersion, 10, 0x80, 0x80, 0x80, 0x80, 0x07}, huge[:n]...),
+		// One polyline with a huge vertex count.
+		append([]byte{shapeIndexEncodingVersion, 10, 1, 1, 0, byte(shapeKindPolyline)}, huge[:n]...),
+		// One polyline with a large but allowed vertex count and no data.
+		{shapeIndexEncodingVersion, 10, 1, 1, 0, byte(shapeKindPolyline), 0x80, 0x80, 0x80, 0x10},
+		// Huge cell count.
+		append([]byte{shapeIndexEncodingVersion, 10, 0, 0}, huge[:n]...),
+		// Unknown version.
+		{99},
+	}
+	for i, c := range oversized {
+		if err := NewShapeIndex().Decode(bytes.NewReader(c)); err == nil {
+			t.Errorf("Decode(oversized case %d) succeeded", i)
+		}
+	}
+
+	// A failed decode leaves the destination unchanged.
+	dst := NewShapeIndex()
+	dst.Add(makePolyline("1:1, 2:2"))
+	if err := dst.Decode(bytes.NewReader(data[:len(data)-1])); err == nil {
+		t.Fatalf("Decode(truncated) succeeded")
+	}
+	if dst.Len() != 1 {
+		t.Errorf("failed Decode modified the index")
+	}
+}
