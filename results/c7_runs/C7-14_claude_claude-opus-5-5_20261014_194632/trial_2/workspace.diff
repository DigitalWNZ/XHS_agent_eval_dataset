+package s2
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"hash/crc32"
+	"reflect"
+	"testing"
+)
+
+func encodeShapeIndex(t *testing.T, index *ShapeIndex) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	data := encodeShapeIndex(t, index)
+	got := &ShapeIndex{}
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	return got
+}
+
+// checkShapesEqual verifies that two shapes have the same type and geometry.
+func checkShapesEqual(t *testing.T, id int32, want, got Shape) {
+	t.Helper()
+	if reflect.TypeOf(want) != reflect.TypeOf(got) {
+		t.Errorf("shape %d: type = %T, want %T", id, got, want)
+		return
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("shape %d: Dimension() = %d, want %d", id, got.Dimension(), want.Dimension())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("shape %d: ReferencePoint() = %v, want %v", id, got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.IsEmpty() != want.IsEmpty() || got.IsFull() != want.IsFull() {
+		t.Errorf("shape %d: IsEmpty/IsFull mismatch", id)
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("shape %d: NumEdges() = %d, want %d", id, got.NumEdges(), want.NumEdges())
+	}
+	for e := 0; e < want.NumEdges(); e++ {
+		if got.Edge(e) != want.Edge(e) {
+			t.Errorf("shape %d: Edge(%d) = %v, want %v", id, e, got.Edge(e), want.Edge(e))
+		}
+		if got.ChainPosition(e) != want.ChainPosition(e) {
+			t.Errorf("shape %d: ChainPosition(%d) = %v, want %v", id, e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("shape %d: NumChains() = %d, want %d", id, got.NumChains(), want.NumChains())
+	}
+	for c := 0; c < want.NumChains(); c++ {
+		if got.Chain(c) != want.Chain(c) {
+			t.Errorf("shape %d: Chain(%d) = %v, want %v", id, c, got.Chain(c), want.Chain(c))
+		}
+	}
+}
+
+// checkShapeIndexesEqual verifies that the decoded index matches the original.
+func checkShapeIndexesEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded index is not fresh")
+	}
+	if got.Len() != want.Len() || got.nextID != want.nextID {
+		t.Errorf("Len() = %d, nextID = %d, want %d, %d", got.Len(), got.nextID, want.Len(), want.nextID)
+	}
+	if got.maxEdgesPerCell != want.maxEdgesPerCell {
+		t.Errorf("maxEdgesPerCell = %d, want %d", got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+	for id, shape := range want.shapes {
+		checkShapesEqual(t, id, shape, got.Shape(id))
+	}
+
+	// Check the cells before any iterator call could trigger an update.
+	if !reflect.DeepEqual(got.cells, want.cells) && !(len(got.cells) == 0 && len(want.cells) == 0) {
+		t.Errorf("cells = %v, want %v", got.cells, want.cells)
+	}
+	if !reflect.DeepEqual(got.cellMap, want.cellMap) {
+		t.Errorf("cellMap differs after round trip")
+	}
+
+	wantIt, gotIt := want.Iterator(), got.Iterator()
+	for ; !wantIt.Done() && !gotIt.Done(); wantIt.Next() {
+		if gotIt.CellID() != wantIt.CellID() {
+			t.Errorf("iterator CellID = %v, want %v", gotIt.CellID(), wantIt.CellID())
+		}
+		if !reflect.DeepEqual(gotIt.IndexCell(), wantIt.IndexCell()) {
+			t.Errorf("iterator cell %v differs", wantIt.CellID())
+		}
+		gotIt.Next()
+	}
+	if !wantIt.Done() || !gotIt.Done() {
+		t.Errorf("iterators finished at different times")
+	}
+}
