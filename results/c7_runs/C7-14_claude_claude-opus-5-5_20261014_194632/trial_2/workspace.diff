+func TestShapeIndexDecodeLeavesIndexOnError(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolyline("0:0, 1:1"))
+	data := encodeShapeIndex(t, index)
+
+	target := NewShapeIndex()
+	target.Add(makeLoop("5:5, 5:6, 6:6"))
+	target.Build()
+	if err := target.Decode(bytes.NewReader(data[:len(data)-1])); err == nil {
+		t.Fatalf("Decode() of truncated data succeeded")
+	}
+	if _, ok := target.Shape(0).(*Loop); !ok || target.Len() != 1 {
+		t.Errorf("failed Decode() modified the index")
+	}
