+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2", true))
+	index.Add(makeLoop("20:20, 20:25, 25:25"))
+	index.Add(makePolyline("-10:-10, -11:-12"))
+	index.Add(LaxLoopFromPoints(parsePoints("-30:-30, -30:-25, -25:-25")))
+	index.Add(makeLaxPolygon("50:50, 50:55, 55:55; 51:51, 52:52, 51:53"))
+	index.Add(makeLaxPolyline("40:40, 41:41"))
+	index.Add(&PointVector{parsePoint("3:3")})
+	data := encodeShapeIndex(t, index)
+
+	// Every truncation must fail.
+	for n := 0; n < len(data); n++ {
+		var s ShapeIndex
+		if err := s.Decode(bytes.NewReader(data[:n])); err == nil {
+			t.Fatalf("Decode() of %d/%d bytes succeeded, want error", n, len(data))
+		}
+	}
+
+	// Every single byte corruption must fail.
+	for i := range data {
+		for _, mask := range []byte{0x01, 0x80, 0xff} {
+			corrupt := append([]byte(nil), data...)
+			corrupt[i] ^= mask
+			var s ShapeIndex
+			if err := s.Decode(bytes.NewReader(corrupt)); err == nil {
+				t.Fatalf("Decode() with byte %d ^ %#x succeeded, want error", i, mask)
+			}
+		}
+	}
+}
