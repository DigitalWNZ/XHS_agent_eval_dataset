+func TestShapeIndexDecodeOversizedCounts(t *testing.T) {
+	uv := func(xs ...uint64) []byte {
+		var out []byte
+		for _, x := range xs {
+			out = binary.AppendUvarint(out, x)
+		}
+		return out
+	}
+	header := func(xs ...uint64) []byte {
+		return append([]byte{shapeIndexEncodingVersion}, uv(xs...)...)
+	}
+	tests := map[string][]byte{
+		"empty input":     {},
+		"bad version":     {99},
+		"huge varint":     append([]byte{1}, bytes.Repeat([]byte{0xff}, 20)...),
+		"zero max edges":  header(0, 0, 0, 0, 0),
+		"nextID overflow": header(10, 1<<40),
+		"too many shapes": header(10, 2, 0, 3),
+		"pending > next":  header(10, 2, 3),
+		// A shape claiming a huge number of vertices with no data behind it.
+		"huge polyline": header(10, 1<<31-1, 0, 1<<31-1, 0,
+			uint64(shapeIndexShapePolyline), maxEncodedVertices),
+		"too many vertices": header(10, 1, 0, 1, 0,
+			uint64(shapeIndexShapePolyline), maxEncodedVertices+1),
+		"huge polygon": header(10, 1, 0, 1, 0,
+			uint64(shapeIndexShapePolygon), maxEncodedLoops),
+		"huge lax polygon": header(10, 1, 0, 1, 0,
+			uint64(shapeIndexShapeLaxPolygon), 2, maxEncodedVertices, maxEncodedVertices),
+		"unknown shape type": header(10, 1, 0, 1, 0, 99),
+		"huge cells":         header(10, 0, 0, 0, 1<<31-1),
+		"shape out of range": header(10, 1, 0, 1, 1, uint64(shapeIndexShapePointVector), 0),
+	}
+	for name, data := range tests {
+		var s ShapeIndex
+		if err := s.Decode(bytes.NewReader(data)); err == nil {
+			t.Errorf("%s: Decode() succeeded, want error", name)
+		}
+	}
+
+	// A structurally valid index whose cell references an edge that does
+	// not exist must fail even if the checksum is correct.
+	body := header(10, 1, 1, 1, 0, uint64(shapeIndexShapePointVector), 0, 1)
+	body = binary.LittleEndian.AppendUint64(body, uint64(CellIDFromFace(0)))
+	body = append(body, uv(1, 0)...)
+	body = append(body, 0)
+	body = append(body, uv(1, 0)...)
+	body = binary.LittleEndian.AppendUint32(body, crc32.Checksum(body, shapeIndexCRCTable))
+	var s ShapeIndex
+	if err := s.Decode(bytes.NewReader(body)); err == nil {
+		t.Errorf("Decode() with invalid edge reference succeeded, want error")
+	}
+}
