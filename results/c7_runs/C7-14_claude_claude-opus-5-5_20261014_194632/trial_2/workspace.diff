+		makeLoop("full"),
+		makePolyline("-10:-10, -11:-12, -13:-10"),
+		makePolyline(""),
+		makePolyline("5:5"),
+		&pv,
+		&PointVector{},
+		makeLaxPolyline("40:40, 41:41, 40:42"),
+		makeLaxPolyline(""),
+		LaxLoopFromPoints(parsePoints("-30:-30, -30:-25, -25:-25")),
+		&LaxLoop{},
+		makeLaxPolygon("50:50, 50:55, 55:55; 51:51, 52:52, 51:53"),
+		makeLaxPolygon("60:60, 60:65, 65:65"),
+		makeLaxPolygon(""),
+		makeLaxPolygon("full"),
+		makeLaxPolygon("70:70, 70:75, 75:75; full; empty; 71:71"),
+	}
+
+	for _, build := range []bool{true, false} {
+		t.Run(fmt.Sprintf("build=%v", build), func(t *testing.T) {
+			index := NewShapeIndex()
+			for _, s := range shapes {
+				index.Add(s)
+			}
+			if build {
+				index.Build()
+			}
+			got := roundTripShapeIndex(t, index)
+			checkShapeIndexesEqual(t, index, got)
+
+			// Queries should give identical results.
+			wantQ := NewContainsPointQuery(index, VertexModelSemiOpen)
+			gotQ := NewContainsPointQuery(got, VertexModelSemiOpen)
+			for i := 0; i < 500; i++ {
+				p := randomPoint()
+				if w, g := wantQ.Contains(p), gotQ.Contains(p); w != g {
+					t.Errorf("Contains(%v) = %v, want %v", p, g, w)
+				}
+			}
+			quadraticValidate(t, got)
+		})
+	}
+}
