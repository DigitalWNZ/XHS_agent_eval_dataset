+func TestShapeIndexEncodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	a := makePolyline("0:0, 1:1")
+	b := makePolyline("2:2, 3:3")
+	c := makeLoop("5:5, 5:6, 6:6")
+	index.Add(a)
+	index.Add(b)
+	index.Add(c)
+	index.Remove(b) // Removed before the index is built, leaving an ID gap.
+
+	data := encodeShapeIndex(t, index)
+	got := &ShapeIndex{}
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	if got.Shape(1) != nil {
+		t.Errorf("Shape(1) = %v, want nil", got.Shape(1))
+	}
+	if _, ok := got.Shape(0).(*Polyline); !ok {
+		t.Errorf("Shape(0) = %T, want *Polyline", got.Shape(0))
+	}
+	if got.nextID != 3 {
+		t.Errorf("nextID = %d, want 3", got.nextID)
+	}
+	if id := got.Add(makePolyline("7:7, 8:8")); id != 3 {
+		t.Errorf("Add() after decode = %d, want 3", id)
+	}
+}
