+package encryption
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func generateTestKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	for _, length := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		key := make([]byte, length)
+		enc, err := NewEncryptor(key)
+		assert.Nil(t, enc)
+		assert.ErrorIs(t, err, ErrInvalidKey, "length %d should wrap ErrInvalidKey", length)
