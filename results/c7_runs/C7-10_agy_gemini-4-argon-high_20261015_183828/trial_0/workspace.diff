+func TestDecryptReaderErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Invalid key length on DecryptReader
+	_, err = DecryptReader(bytes.NewReader(nil), []byte("short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// Lazy init: bad magic does not error in DecryptReader, errors in Read with "invalid header"
+	badMagic := []byte{0x00, 0x00, 0x01, 0, 0, 0, 0}
+	dr, err := DecryptReader(bytes.NewReader(badMagic), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.ErrorContains(t, err, "invalid header")
+
+	// Unsupported version: errors in Read with "unsupported version"
+	badVersion := []byte{0x4F, 0x44, 0x02, 0, 0, 0, 0}
+	dr, err = DecryptReader(bytes.NewReader(badVersion), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.ErrorContains(t, err, "unsupported version")
+
+	// Valid encrypted data
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("secret database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validStream := buf.Bytes()
+
+	// Wrong key must fail
+	wrongKey := generateTestKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validStream), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Corrupted HMAC must fail with "integrity"
+	tamperedHMAC := make([]byte, len(validStream))
+	copy(tamperedHMAC, validStream)
+	tamperedHMAC[len(tamperedHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(tamperedHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.ErrorContains(t, err, "integrity")
+
+	// Truncated streams must error
+	for _, cut := range []int{0, 1, 2, 3, 5, 10, len(validStream) - 33, len(validStream) - 10, len(validStream) - 1} {
+		dr, err = DecryptReader(bytes.NewReader(validStream[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "truncated length %d should error", cut)
+	}
+}
