+func TestStreamFormatAndUniqueNonces(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := bytes.Repeat([]byte("A"), maxChunkSize*2+1234)
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+
+	raw := buf.Bytes()
+	require.True(t, len(raw) > 3+4+32)
+
+	// Header: 0x4F 0x44 0x01
+	assert.Equal(t, byte(0x4F), raw[0])
+	assert.Equal(t, byte(0x44), raw[1])
+	assert.Equal(t, byte(0x01), raw[2])
+
+	offset := 3
+	seenNonces := make(map[string]bool)
+	chunkCount := 0
+
+	for {
+		require.True(t, offset+4 <= len(raw))
+		chunkLen := binary.BigEndian.Uint32(raw[offset : offset+4])
+		offset += 4
+		if chunkLen == 0 {
+			break
+		}
+		chunkCount++
+		require.True(t, chunkLen <= uint32(nonceSize+maxChunkSize+gcmTagSize))
+		require.True(t, offset+int(chunkLen) <= len(raw))
+
+		nonce := raw[offset : offset+nonceSize]
+		nonceHex := string(nonce)
+		assert.False(t, seenNonces[nonceHex], "duplicate nonce found in chunk %d", chunkCount)
+		seenNonces[nonceHex] = true
+
+		offset += int(chunkLen)
+	}
+
+	assert.Equal(t, 3, chunkCount)
+
+	// Remaining 32 bytes must be HMAC-SHA256 over all bytes between header (3) and sentinel (offset-4)
+	assert.Equal(t, len(raw)-offset, 32)
+	expectedMAC := raw[offset:]
+	mac := hmac.New(sha256.New, key)
+	mac.Write(raw[3 : offset-4])
+	assert.True(t, hmac.Equal(expectedMAC, mac.Sum(nil)))
+}
