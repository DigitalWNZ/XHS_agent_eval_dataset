diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..8be6a61
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,206 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	minSaltSize  = 16
+	pbkdf2Rounds = 100000
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"key_source"`
+	KeyEnvVar  string `yaml:"key_env_var"`
+	KeyFile    string `yaml:"key_file"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled    bool   `yaml:"enabled"`
+		KeySource  string `yaml:"key_source"`
+		KeySource2 string `yaml:"keysource"`
+		KeySource3 string `yaml:"key-source"`
+		KeyEnvVar  string `yaml:"key_env_var"`
+		KeyEnvVar2 string `yaml:"keyenvvar"`
+		KeyEnvVar3 string `yaml:"key-env-var"`
+		KeyFile    string `yaml:"key_file"`
+		KeyFile2   string `yaml:"keyfile"`
+		KeyFile3   string `yaml:"key-file"`
+		Key        string `yaml:"key"`
+		Passphrase string `yaml:"passphrase"`
+		Salt       string `yaml:"salt"`
+	}
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySource2, raw.KeySource3)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVar2, raw.KeyEnvVar3)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFile2, raw.KeyFile3)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+	return nil
+}
+
+func firstNonEmpty(vals ...string) string {
+	for _, v := range vals {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateEnabled()
+}
+
+func (c Config) validateEnabled() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasPassphrase := strings.TrimSpace(c.Passphrase) != ""
+	hasSalt := strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case KeySourceEnv:
+		hasOther := hasFile || hasLiteral || hasPassphrase || hasSalt
+		if !hasEnv && hasOther {
+			return errors.New("key_env_var is required for env key source; key source fields are mutually exclusive")
+		}
+		if !hasEnv {
+			return errors.New("key_env_var is required when encryption key source is env")
+		}
+		if hasOther {
+			return errors.New("env key source fields are mutually exclusive with other key source fields")
+		}
+	case KeySourceFile:
+		hasOther := hasEnv || hasLiteral || hasPassphrase || hasSalt
+		if !hasFile && hasOther {
+			return errors.New("key_file is required for file key source; key source fields are mutually exclusive")
+		}
+		if !hasFile {
+			return errors.New("key_file is required when encryption key source is file")
+		}
+		if hasOther {
+			return errors.New("file key source fields are mutually exclusive with other key source fields")
+		}
+	case KeySourceLiteral:
+		hasOther := hasEnv || hasFile || hasPassphrase || hasSalt
+		if !hasLiteral && hasOther {
+			return errors.New("key is required for literal key source; key source fields are mutually exclusive")
+		}
+		if !hasLiteral {
+			return errors.New("key is required when encryption key source is literal")
+		}
+		if hasOther {
+			return errors.New("literal key source fields are mutually exclusive with other key source fields")
+		}
+	case KeySourceDerive:
+		hasOther := hasEnv || hasFile || hasLiteral
+		if (!hasPassphrase || !hasSalt) && hasOther {
+			return errors.New("passphrase and salt are required for derive key source; key source fields are mutually exclusive")
+		}
+		if !hasPassphrase {
+			return errors.New("passphrase is required when encryption key source is derive")
+		}
+		if !hasSalt {
+			return errors.New("salt is required when encryption key source is derive")
+		}
+		if hasOther {
+			return errors.New("derive key source fields are mutually exclusive with other key source fields")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateEnabled(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envVar := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envVar)
+		}
+		return decodeAndValidateBase64Key(strings.TrimSpace(val), fmt.Sprintf("env var %q", envVar))
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		if trimmed == "" {
+			return nil, fmt.Errorf("%w: encryption key file %q is empty", ErrInvalidKey, filePath)
+		}
+		return decodeAndValidateBase64Key(trimmed, fmt.Sprintf("file %q", filePath))
+
+	case KeySourceLiteral:
+		trimmed := strings.TrimSpace(cfg.Key)
+		return decodeAndValidateBase64Key(trimmed, "literal key")
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("encryption passphrase must not be empty")
+		}
+		saltBytes, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(saltBytes) < minSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", minSaltSize, len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, pbkdf2Rounds, aesKeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
+
+func decodeAndValidateBase64Key(b64Str, sourceDesc string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(b64Str)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode base64 encryption key from %s: %w", sourceDesc, err)
+	}
+	if len(key) != aesKeySize {
+		return nil, fmt.Errorf("%w: encryption key from %s must be %d bytes, got %d", ErrInvalidKey, sourceDesc, aesKeySize, len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..6af92a3
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,321 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	magicByte1     = 0x4F
+	magicByte2     = 0x44
+	streamVersion  = 0x01
+	maxChunkSize   = 64 * 1024
+	nonceSize      = 12
+	gcmTagSize     = 16
+	lengthPrefSize = 4
+	hmacSize       = 32
+	aesKeySize     = 32
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+)
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != aesKeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, aesKeySize, len(key))
+	}
+	keyCopy := make([]byte, aesKeySize)
+	copy(keyCopy, key)
+	return &Encryptor{key: keyCopy}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		return &encryptWriter{err: err}
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return &encryptWriter{err: err}
+	}
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, e.key),
+	}
+}
+
+func (e *Encryptor) DecryptReader(r io.Reader) (io.Reader, error) {
+	return DecryptReader(r, e.key)
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := [3]byte{magicByte1, magicByte2, streamVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			return err
+		}
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce, plaintext, nil)
+	chunkLen := uint32(len(nonce) + len(ciphertext))
+
+	var lenBuf [lengthPrefSize]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	ew.mac.Write(lenBuf[:])
+
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	ew.mac.Write(nonce)
+
+	if _, err := ew.w.Write(ciphertext); err != nil {
+		return err
+	}
+	ew.mac.Write(ciphertext)
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if ew.closed {
+		return 0, errors.New("write to closed encrypt writer")
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	ew.buf = append(ew.buf, p...)
+	for len(ew.buf) >= maxChunkSize {
+		if err := ew.writeChunk(ew.buf[:maxChunkSize]); err != nil {
+			ew.err = err
+			return 0, err
+		}
+		ew.buf = ew.buf[maxChunkSize:]
+	}
+
+	return len(p), nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return err
+		}
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.writeChunk(ew.buf); err != nil {
+			ew.err = err
+			return err
+		}
+		ew.buf = nil
+	}
+
+	var sentinel [lengthPrefSize]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		ew.err = err
+		return err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != aesKeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, aesKeySize, len(key))
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	keyCopy := make([]byte, aesKeySize)
+	copy(keyCopy, key)
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r               io.Reader
+	gcm             cipher.AEAD
+	mac             hash.Hash
+	initialized     bool
+	eof             bool
+	err             error
+	plainBuf        []byte
+	hasPendingChunk bool
+	pendingChunkLen uint32
+}
+
+func (d *decryptReader) Read(p []byte) (int, error) {
+	if d.err != nil {
+		return 0, d.err
+	}
+
+	if !d.initialized {
+		d.initialized = true
+		var header [3]byte
+		if _, err := io.ReadFull(d.r, header[:]); err != nil {
+			d.err = fmt.Errorf("invalid header: truncated stream: %w", io.ErrUnexpectedEOF)
+			return 0, d.err
+		}
+		if header[0] != magicByte1 || header[1] != magicByte2 {
+			d.err = fmt.Errorf("invalid header: bad magic bytes 0x%02x 0x%02x", header[0], header[1])
+			return 0, d.err
+		}
+		if header[2] != streamVersion {
+			d.err = fmt.Errorf("unsupported version: 0x%02x", header[2])
+			return 0, d.err
+		}
+	}
+
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	totalCopied := 0
+	for {
+		if len(d.plainBuf) > 0 {
+			n := copy(p[totalCopied:], d.plainBuf)
+			d.plainBuf = d.plainBuf[n:]
+			totalCopied += n
+			if len(d.plainBuf) > 0 {
+				return totalCopied, nil
+			}
+		}
+
+		if d.eof {
+			if totalCopied > 0 {
+				return totalCopied, nil
+			}
+			return 0, io.EOF
+		}
+
+		var chunkLen uint32
+		if d.hasPendingChunk {
+			chunkLen = d.pendingChunkLen
+			d.hasPendingChunk = false
+		} else {
+			var lenBuf [lengthPrefSize]byte
+			if _, err := io.ReadFull(d.r, lenBuf[:]); err != nil {
+				d.err = fmt.Errorf("truncated encrypted stream reading chunk length: %w", io.ErrUnexpectedEOF)
+				return 0, d.err
+			}
+			chunkLen = binary.BigEndian.Uint32(lenBuf[:])
+			if chunkLen == 0 {
+				var expectedMAC [hmacSize]byte
+				if _, err := io.ReadFull(d.r, expectedMAC[:]); err != nil {
+					d.err = fmt.Errorf("truncated encrypted stream reading HMAC: %w", io.ErrUnexpectedEOF)
+					return 0, d.err
+				}
+				actualMAC := d.mac.Sum(nil)
+				if !hmac.Equal(actualMAC, expectedMAC[:]) {
+					d.err = errors.New("integrity check failed: HMAC verification failed")
+					return 0, d.err
+				}
+				d.eof = true
+				if totalCopied > 0 {
+					return totalCopied, nil
+				}
+				return 0, io.EOF
+			}
+			if chunkLen < uint32(nonceSize+gcmTagSize) || chunkLen > uint32(nonceSize+maxChunkSize+gcmTagSize) {
+				d.err = fmt.Errorf("invalid chunk length %d: corrupted or truncated stream", chunkLen)
+				return 0, d.err
+			}
+			d.mac.Write(lenBuf[:])
+		}
+
+		if totalCopied == len(p) {
+			d.hasPendingChunk = true
+			d.pendingChunkLen = chunkLen
+			return totalCopied, nil
+		}
+
+		payload := make([]byte, chunkLen)
+		if _, err := io.ReadFull(d.r, payload); err != nil {
+			d.err = fmt.Errorf("truncated encrypted stream reading chunk payload: %w", io.ErrUnexpectedEOF)
+			return 0, d.err
+		}
+		d.mac.Write(payload)
+
+		nonce := payload[:nonceSize]
+		ciphertext := payload[nonceSize:]
+		plaintext, err := d.gcm.Open(nil, nonce, ciphertext, nil)
+		if err != nil {
+			d.err = fmt.Errorf("decryption failed (integrity check failed): %w", err)
+			return 0, d.err
+		}
+		d.plainBuf = plaintext
+	}
+}
