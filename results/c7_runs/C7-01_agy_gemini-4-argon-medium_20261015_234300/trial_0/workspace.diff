diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..b82d14fe
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,342 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import { type DriverValueDecoder, noopDecoder, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameBoundaryKind =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly kind: WindowFrameBoundaryKind,
+		readonly order: number,
+		readonly offset: number | undefined,
+		private readonly boundarySql: SQL,
+	) {}
+
+	getSQL(): SQL {
+		return this.boundarySql;
+	}
+}
+
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary(
+	'unboundedPreceding',
+	0,
+	undefined,
+	sql.raw('unbounded preceding'),
+);
+
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary(
+	'currentRow',
+	2,
+	undefined,
+	sql.raw('current row'),
+);
+
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary(
+	'unboundedFollowing',
+	4,
+	undefined,
+	sql.raw('unbounded following'),
+);
+
+export function preceding(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() requires a non-negative integer argument, received ${offset}`);
+	}
+	return new WindowFrameBoundary('preceding', 1, offset, sql`${sql.raw(String(offset))} preceding`);
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() requires a non-negative integer argument, received ${offset}`);
+	}
+	return new WindowFrameBoundary('following', 3, offset, sql`${sql.raw(String(offset))} following`);
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: 'rows' | 'range',
+		readonly from: WindowFrameBoundary,
+		readonly to: WindowFrameBoundary,
+		private readonly frameSql: SQL,
+	) {}
+
+	getSQL(): SQL {
+		return this.frameSql;
+	}
+}
+
+function validateFrameBounds(from: WindowFrameBoundary, to: WindowFrameBoundary): void {
+	const isInvalidOrder =
+		from.order > to.order
+		|| (from.kind === 'preceding' && to.kind === 'preceding' && from.offset! < to.offset!)
+		|| (from.kind === 'following' && to.kind === 'following' && from.offset! > to.offset!)
+		|| from.kind === 'unboundedFollowing'
+		|| to.kind === 'unboundedPreceding';
+
+	if (isInvalidOrder) {
+		throw new Error('Invalid window frame: "from" boundary cannot be ordered after "to" boundary');
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	validateFrameBounds(spec.from, spec.to);
+	return new WindowFrame(
+		'rows',
+		spec.from,
+		spec.to,
+		sql`rows between ${spec.from.getSQL()} and ${spec.to.getSQL()}`,
+	);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	validateFrameBounds(spec.from, spec.to);
+	return new WindowFrame(
+		'range',
+		spec.from,
+		spec.to,
+		sql`range between ${spec.from.getSQL()} and ${spec.to.getSQL()}`,
+	);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot be whitespace-only');
+	}
+}
+
+export function buildWindowSpecSql(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const chunks: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionBy = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionBy.length > 0) {
+			chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderBy = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderBy.length > 0) {
+			chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		chunks.push(spec.frame.getSQL());
+	}
+
+	if (chunks.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare _: {
+		brand: 'WindowFunction';
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder: DriverValueDecoder<T, any> | DriverValueDecoder<T, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(spec: WindowSpec | string = {}): SQL<T> {
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			return sql<T>`${this.fnSql} over ${sql.identifier(spec)}`.mapWith(this.decoder) as SQL<T>;
+		}
+
+		const overSql = buildWindowSpecSql(spec);
+		return sql<T>`${this.fnSql} over (${overSql})`.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type WindowExpressionData<T extends SQLWrapper> =
+	T extends AnyColumn
+		? T['_']['data']
+		: T extends SQL<infer U>
+		? U
+		: T extends SQL.Aliased<infer U>
+		? U
+		: unknown;
+
+function extractDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`dense_rank()`, Number);
+}
+
+export function ntile(buckets: number): WindowFunction<number> {
+	if (typeof buckets !== 'number' || !Number.isInteger(buckets) || buckets < 1) {
+		throw new Error(`ntile() requires a positive integer argument, received ${buckets}`);
+	}
+	return new WindowFunction<number>(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`cume_dist()`, Number);
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<WindowExpressionData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<WindowExpressionData<T>> | SQLWrapper,
+): WindowFunction<NonNullable<WindowExpressionData<T>>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: NonNullable<WindowExpressionData<T>> | SQLWrapper,
+): WindowFunction<any> {
+	const decoder = extractDecoder(expression);
+	if (defaultValue !== undefined) {
+		const offsetChunk = sql.raw(String(offset ?? 1));
+		const defaultChunk = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: bindIfParam(defaultValue, expression);
+		return new WindowFunction(sql`lag(${expression}, ${offsetChunk}, ${defaultChunk})`, decoder);
+	}
+	if (offset !== undefined) {
+		return new WindowFunction(sql`lag(${expression}, ${sql.raw(String(offset))})`, decoder);
+	}
+	return new WindowFunction(sql`lag(${expression})`, decoder);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<WindowExpressionData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<WindowExpressionData<T>> | SQLWrapper,
+): WindowFunction<NonNullable<WindowExpressionData<T>>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: NonNullable<WindowExpressionData<T>> | SQLWrapper,
+): WindowFunction<any> {
+	const decoder = extractDecoder(expression);
+	if (defaultValue !== undefined) {
+		const offsetChunk = sql.raw(String(offset ?? 1));
+		const defaultChunk = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: bindIfParam(defaultValue, expression);
+		return new WindowFunction(sql`lead(${expression}, ${offsetChunk}, ${defaultChunk})`, decoder);
+	}
+	if (offset !== undefined) {
+		return new WindowFunction(sql`lead(${expression}, ${sql.raw(String(offset))})`, decoder);
+	}
+	return new WindowFunction(sql`lead(${expression})`, decoder);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<WindowExpressionData<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, extractDecoder(expression));
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<WindowExpressionData<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, extractDecoder(expression));
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<WindowExpressionData<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() requires a positive integer argument, received ${n}`);
+	}
+	return new WindowFunction(sql`nth_value(${expression}, ${sql.raw(String(n))})`, extractDecoder(expression));
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction<string | null>(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction<string | null>(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : T extends SQL<infer U> ? U : T extends SQL.Aliased<infer U> ? U : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : String) as any;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : T extends SQL<infer U> ? U : T extends SQL.Aliased<infer U> ? U : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : String) as any;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction<number>(sql`count(${expression || sql.raw('*')})`, Number);
+}
