+    def test_only_related_queryset(self):
+        house = House.objects.create(name='Villa', address='123 Main St')
+        room = Room.objects.create(name='Living Room', house=house)
+        house.main_room = room
+        house.save()
+
+        # Reverse OneToOneField
+        queryset = House.objects.filter(id=house.id).only('name', 'main_room').prefetch_related(
+            Prefetch(
+                'main_room',
+                queryset=Room.objects.prefetch_related(
+                    Prefetch('main_room_of', queryset=House.objects.only('address', 'main_room'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            h = queryset.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(h.main_room.main_room_of.address, '123 Main St')
+
+        # Forward OneToOneField
+        queryset = Room.objects.filter(id=room.id).only('name').prefetch_related(
+            Prefetch(
+                'main_room_of',
+                queryset=House.objects.prefetch_related(
+                    Prefetch('main_room', queryset=Room.objects.only('name'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            r = queryset.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(r.main_room_of.main_room.name, 'Living Room')
+
+        # Reverse ForeignKey
+        book = BookWithYear.objects.create(title='Poems', published_year=2010)
+        review = BookReview.objects.create(book=book, notes='Great')
+        queryset = BookWithYear.objects.filter(id=book.id).only('title').prefetch_related(
+            Prefetch(
+                'bookreview_set',
+                queryset=BookReview.objects.prefetch_related(
+                    Prefetch('book', queryset=BookWithYear.objects.only('published_year'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            b = queryset.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(b.bookreview_set.all()[0].book.published_year, 2010)
+
+        # Forward ForeignKey
+        queryset = BookReview.objects.filter(id=review.id).only('notes', 'book').prefetch_related(
+            Prefetch(
+                'book',
+                queryset=BookWithYear.objects.prefetch_related(
+                    Prefetch('bookreview_set', queryset=BookReview.objects.only('notes', 'book'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            rev = queryset.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(rev.book.bookreview_set.all()[0].notes, 'Great')
+
 
