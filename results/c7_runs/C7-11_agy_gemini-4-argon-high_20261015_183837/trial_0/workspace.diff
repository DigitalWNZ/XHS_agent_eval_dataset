+func TestShapeIndexEncodeDecodeShapeIDsAndQueriesWithoutBuild(t *testing.T) {
+	idx := NewShapeIndex()
+	s0 := makePolyline("0:0, 0:2, 2:2")
+	s1 := makePolygon("0:0, 0:10, 10:10, 10:0", true)
+	pv2 := PointVector{parsePoint("5:5"), parsePoint("20:20")}
+	s3 := LaxPolylineFromPoints(parsePoints("-5:-5, -5:0, 0:-5"))
+	s4 := LaxPolygonFromPoints([][]Point{parsePoints("-10:-10, -10:-2, -2:-2, -2:-10")})
+
+	id0 := idx.Add(s0)
+	id1 := idx.Add(s1)
+	id2 := idx.Add(&pv2)
+	id3 := idx.Add(s3)
+	id4 := idx.Add(s4)
+
+	// Remove shapes 0 and 2 before encoding so remaining IDs are 1, 3, 4.
+	idx.Remove(s0)
+	idx.Remove(&pv2)
+
+	// Encode WITHOUT calling idx.Build() explicitly!
+	if idx.IsFresh() {
+		t.Fatalf("expected index to be stale before Encode")
+	}
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Fatalf("expected decoded index to be fresh immediately without Build()")
+	}
+	if decoded.Shape(id0) != nil || decoded.Shape(id2) != nil {
+		t.Fatalf("removed shape IDs %d and %d should be nil after Decode", id0, id2)
+	}
+	if decoded.Shape(id1) == nil || decoded.Shape(id3) == nil || decoded.Shape(id4) == nil {
+		t.Fatalf("surviving shape IDs %d, %d, %d must be non-nil", id1, id3, id4)
+	}
+	assertShapeIndexEqual(t, decoded, idx)
+
+	// Verify queries work on decoded without calling Build().
+	cpqOrig := NewContainsPointQuery(idx, VertexModelSemiOpen)
+	cpqDec := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	testPts := []Point{
+		parsePoint("5:5"),
+		parsePoint("-5:-5"),
+		parsePoint("15:15"),
+		parsePoint("0:0"),
+	}
+	for _, pt := range testPts {
+		if got, want := cpqDec.Contains(pt), cpqOrig.Contains(pt); got != want {
+			t.Errorf("Contains(%v) = %v, want %v", pt, got, want)
+		}
+		gotShapes := cpqDec.ContainingShapes(pt)
+		wantShapes := cpqOrig.ContainingShapes(pt)
+		if len(gotShapes) != len(wantShapes) {
+			t.Errorf("ContainingShapes(%v) len = %d, want %d", pt, len(gotShapes), len(wantShapes))
+		}
+	}
+
+	// Verify ClosestEdgeQuery works without Build() and returns identical shapeID/edgeID.
+	opts := NewClosestEdgeQueryOptions()
+	ceqOrig := NewClosestEdgeQuery(idx, opts)
+	ceqDec := NewClosestEdgeQuery(decoded, opts)
+	for _, pt := range testPts {
+		target := NewMinDistanceToPointTarget(pt)
+		rOrig := ceqOrig.FindEdges(target)
+		rDec := ceqDec.FindEdges(target)
+		if !reflect.DeepEqual(rDec, rOrig) {
+			t.Errorf("FindEdges(%v) = %+v, want %+v", pt, rDec, rOrig)
+		}
+	}
+
+	// Verify adding a new shape after Decode gets nextID (5).
+	s5 := makePolyline("40:40, 40:45")
+	id5 := decoded.Add(s5)
+	if id5 != id4+1 {
+		t.Errorf("Add after Decode returned ID %d, want %d", id5, id4+1)
+	}
+	quadraticValidate(t, decoded)
+}
