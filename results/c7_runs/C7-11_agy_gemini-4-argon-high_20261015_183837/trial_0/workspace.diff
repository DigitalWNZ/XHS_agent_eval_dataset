+	crc := crc32.NewIEEE()
+	e := &encoder{w: io.MultiWriter(w, crc)}
+	s.encode(e)
+	if e.err != nil {
+		return e.err
+	}
+	sum := crc.Sum32()
+	e.w = w
+	e.writeUint32(sum)
+	return e.err
