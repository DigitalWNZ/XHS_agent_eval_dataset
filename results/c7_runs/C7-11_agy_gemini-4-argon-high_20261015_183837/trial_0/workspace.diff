+	s.mu.Lock()
+	s.shapes = decoded.shapes
+	s.nextID = decoded.nextID
+	s.maxEdgesPerCell = decoded.maxEdgesPerCell
+	s.cells = decoded.cells
+	s.cellMap = decoded.cellMap
+	s.pendingAdditionsPos = decoded.nextID
+	s.pendingRemovals = nil
