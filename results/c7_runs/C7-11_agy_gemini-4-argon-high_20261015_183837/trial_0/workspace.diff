+
+func encodeShape(e *encoder, shape Shape) {
+	switch v := shape.(type) {
+	case *Polygon:
+		e.writeUint32(uint32(typeTagPolygon))
+		v.encodeLossless(e)
+	case *Polyline:
+		e.writeUint32(uint32(typeTagPolyline))
+		v.encode(e)
+	case *PointVector:
+		e.writeUint32(uint32(typeTagPointVector))
+		v.encode(e)
+	case *LaxPolyline:
+		e.writeUint32(uint32(typeTagLaxPolyline))
+		v.encode(e)
+	case *LaxPolygon:
+		e.writeUint32(uint32(typeTagLaxPolygon))
+		v.encode(e)
+	case *Loop:
+		e.writeUint32(uint32(typeTagLoop))
+		v.encode(e)
+	case *LaxLoop:
+		e.writeUint32(uint32(typeTagLaxLoop))
+		v.encode(e)
+	default:
+		e.writeUint32(uint32(typeTagGeneric))
+		encodeGenericShape(e, shape)
+	}
+}
+
+func decodeShape(d *decoder) Shape {
+	tag := typeTag(d.readUint32())
+	if d.err != nil {
+		return nil
+	}
+	switch tag {
+	case typeTagPolygon:
+		version := int8(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		poly := new(Polygon)
+		switch version {
+		case encodingVersion:
+			poly.decode(d)
+		case encodingCompressedVersion:
+			poly.decodeCompressed(d)
+		default:
+			d.err = fmt.Errorf("unsupported polygon version %d", version)
+			return nil
+		}
+		return poly
+	case typeTagPolyline:
+		var poly Polyline
+		poly.decode(d)
+		return &poly
+	case typeTagPointVector:
+		var pv PointVector
+		pv.decode(d)
+		return &pv
+	case typeTagLaxPolyline:
+		lp := new(LaxPolyline)
+		lp.decode(d)
+		return lp
+	case typeTagLaxPolygon:
+		lp := new(LaxPolygon)
+		lp.decode(d)
+		return lp
+	case typeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		return l
+	case typeTagLaxLoop:
+		ll := new(LaxLoop)
+		ll.decode(d)
+		return ll
+	case typeTagGeneric:
+		return decodeGenericShape(d)
+	default:
+		d.err = fmt.Errorf("unsupported shape type tag %d", tag)
+		return nil
+	}
+}
+
+func encodeGenericShape(e *encoder, shape Shape) {
+	numEdges := shape.NumEdges()
+	numChains := shape.NumChains()
+	if numEdges > maxEncodedVertices || numChains > maxEncodedVertices {
+		e.err = fmt.Errorf("generic shape too large (edges: %d, chains: %d)", numEdges, numChains)
+		return
+	}
+	e.writeInt8(encodingVersion)
+	e.writeInt32(int32(shape.Dimension()))
+	e.writeBool(shape.IsEmpty())
+	e.writeBool(shape.IsFull())
+	ref := shape.ReferencePoint()
+	e.writeFloat64(ref.Point.X)
+	e.writeFloat64(ref.Point.Y)
+	e.writeFloat64(ref.Point.Z)
+	e.writeBool(ref.Contained)
+	e.writeUint32(uint32(numEdges))
+	for i := range numEdges {
+		edge := shape.Edge(i)
+		e.writeFloat64(edge.V0.X)
+		e.writeFloat64(edge.V0.Y)
+		e.writeFloat64(edge.V0.Z)
+		e.writeFloat64(edge.V1.X)
+		e.writeFloat64(edge.V1.Y)
+		e.writeFloat64(edge.V1.Z)
+	}
+	e.writeUint32(uint32(numChains))
+	for i := range numChains {
+		chain := shape.Chain(i)
+		e.writeInt32(int32(chain.Start))
+		e.writeInt32(int32(chain.Length))
+	}
+}
+
+func decodeGenericShape(d *decoder) *genericShape {
+	version := d.readInt8()
+	if d.err != nil {
+		return nil
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode generic shape version %d; my version: %d", version, encodingVersion)
+		return nil
+	}
+	dim := int(int32(d.readUint32()))
+	isEmptyRaw := d.readUint8()
+	isFullRaw := d.readUint8()
+	var refPt Point
+	refPt.X = d.readFloat64()
+	refPt.Y = d.readFloat64()
+	refPt.Z = d.readFloat64()
+	refContainedRaw := d.readUint8()
+	if d.err != nil {
+		return nil
+	}
+	if dim < 0 || dim > 2 {
+		d.err = fmt.Errorf("invalid generic shape dimension %d", dim)
+		return nil
+	}
+	if isEmptyRaw > 1 || isFullRaw > 1 || refContainedRaw > 1 {
+		d.err = errors.New("invalid boolean in generic shape")
+		return nil
+	}
+	numEdges := d.readUint32()
+	if d.err != nil {
+		return nil
+	}
+	if numEdges > maxEncodedVertices {
+		d.err = fmt.Errorf("too many edges in generic shape (%d; max is %d)", numEdges, maxEncodedVertices)
+		return nil
+	}
+	edges := make([]Edge, 0, min(int(numEdges), 1024))
+	for range numEdges {
+		var edge Edge
+		edge.V0.X = d.readFloat64()
+		edge.V0.Y = d.readFloat64()
+		edge.V0.Z = d.readFloat64()
+		edge.V1.X = d.readFloat64()
+		edge.V1.Y = d.readFloat64()
+		edge.V1.Z = d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		edges = append(edges, edge)
+	}
+	numChains := d.readUint32()
+	if d.err != nil {
+		return nil
+	}
+	if numChains > maxEncodedVertices {
+		d.err = fmt.Errorf("too many chains in generic shape (%d; max is %d)", numChains, maxEncodedVertices)
+		return nil
+	}
+	chains := make([]Chain, 0, min(int(numChains), 1024))
+	for range numChains {
+		start := int(int32(d.readUint32()))
+		length := int(int32(d.readUint32()))
+		if d.err != nil {
+			return nil
+		}
+		if start < 0 || length < 0 || start > len(edges) || length > len(edges)-start {
+			d.err = fmt.Errorf("invalid chain (%d, %d) for %d edges", start, length, len(edges))
+			return nil
+		}
+		chains = append(chains, Chain{Start: start, Length: length})
+	}
+	return &genericShape{
+		dimension: dim,
+		refPoint:  ReferencePoint{Point: refPt, Contained: refContainedRaw == 1},
+		isEmpty:   isEmptyRaw == 1,
+		isFull:    isFullRaw == 1,
+		chains:    chains,
+		edges:     edges,
+	}
+}
