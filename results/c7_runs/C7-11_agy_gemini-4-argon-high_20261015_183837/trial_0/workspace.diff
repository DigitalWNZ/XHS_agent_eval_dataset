+func isFinitePoint(p Point) bool {
+	return !math.IsNaN(p.X) && !math.IsInf(p.X, 0) &&
+		!math.IsNaN(p.Y) && !math.IsInf(p.Y, 0) &&
+		!math.IsNaN(p.Z) && !math.IsInf(p.Z, 0)
+}
+
+func isValidDecodedRect(r Rect) bool {
+	return !math.IsNaN(r.Lat.Lo) && !math.IsInf(r.Lat.Lo, 0) &&
+		!math.IsNaN(r.Lat.Hi) && !math.IsInf(r.Lat.Hi, 0) &&
+		!math.IsNaN(r.Lng.Lo) && !math.IsInf(r.Lng.Lo, 0) &&
+		!math.IsNaN(r.Lng.Hi) && !math.IsInf(r.Lng.Hi, 0) &&
+		r.IsValid()
+}
+
+func validateDecodedShape(shape Shape) error {
+	if shape == nil {
+		return errors.New("decoded nil shape")
+	}
+	switch v := shape.(type) {
+	case *Loop:
+		if v.depth < 0 || !isValidDecodedRect(v.bound) {
+			return errors.New("invalid decoded Loop metadata")
+		}
+		for _, pt := range v.vertices {
+			if !isFinitePoint(pt) {
+				return errors.New("non-finite point in decoded Loop")
+			}
+		}
+	case *Polygon:
+		if !isValidDecodedRect(v.bound) {
+			return errors.New("invalid decoded Polygon bound")
+		}
+		for _, l := range v.loops {
+			if l.depth < 0 || !isValidDecodedRect(l.bound) {
+				return errors.New("invalid decoded Polygon loop metadata")
+			}
+			for _, pt := range l.vertices {
+				if !isFinitePoint(pt) {
+					return errors.New("non-finite point in decoded Polygon")
+				}
+			}
+		}
+	case *Polyline:
+		for _, pt := range *v {
+			if !isFinitePoint(pt) {
+				return errors.New("non-finite point in decoded Polyline")
+			}
+		}
+	case *PointVector:
+		for _, pt := range *v {
+			if !isFinitePoint(pt) {
+				return errors.New("non-finite point in decoded PointVector")
+			}
+		}
+	case *LaxPolyline:
+		for _, pt := range v.vertices {
+			if !isFinitePoint(pt) {
+				return errors.New("non-finite point in decoded LaxPolyline")
+			}
+		}
+	case *LaxPolygon:
+		for _, pt := range v.vertices {
+			if !isFinitePoint(pt) {
+				return errors.New("non-finite point in decoded LaxPolygon")
+			}
+		}
+	case *LaxLoop:
+		for _, pt := range v.vertices {
+			if !isFinitePoint(pt) {
+				return errors.New("non-finite point in decoded LaxLoop")
+			}
+		}
+	case *genericShape:
+		if !isFinitePoint(v.refPoint.Point) {
+			return errors.New("non-finite reference point in decoded generic shape")
+		}
+		for _, e := range v.edges {
+			if !isFinitePoint(e.V0) || !isFinitePoint(e.V1) {
+				return errors.New("non-finite edge point in decoded generic shape")
+			}
+		}
+	}
+	return nil
+}
