+	maxEdgesPerCell := int(int32(d.readUint32()))
+	if d.err != nil {
+		return
+	}
+	if maxEdgesPerCell <= 0 || maxEdgesPerCell > maxEncodedVertices {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell: %d", maxEdgesPerCell)
