+	expectedCRC := cr.crc.Sum32()
+	d.r = br
+	gotCRC := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if gotCRC != expectedCRC {
+		return fmt.Errorf("shapeindex checksum mismatch: got %#x, want %#x", gotCRC, expectedCRC)
+	}
