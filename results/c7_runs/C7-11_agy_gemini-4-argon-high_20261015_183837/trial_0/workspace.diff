+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Fatalf("decoded ShapeIndex must be fresh without calling Build()")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.nextID != want.nextID {
+		t.Fatalf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	for id := int32(0); id < want.nextID+2; id++ {
+		assertShapesEqual(t, id, got.Shape(id), want.Shape(id))
+	}
+	if !reflect.DeepEqual(got.cells, want.cells) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	if len(got.cellMap) != len(want.cellMap) {
+		t.Fatalf("len(cellMap) = %d, want %d", len(got.cellMap), len(want.cellMap))
+	}
+	for _, cellID := range want.cells {
+		gotCell := got.cellMap[cellID]
+		wantCell := want.cellMap[cellID]
+		if gotCell == nil || wantCell == nil {
+			t.Fatalf("cell %v nil mismatch: got %v, want %v", cellID, gotCell, wantCell)
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Fatalf("cell %v len(shapes) = %d, want %d", cellID, len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for i := range wantCell.shapes {
+			gc := gotCell.shapes[i]
+			wc := wantCell.shapes[i]
+			if gc.shapeID != wc.shapeID || gc.containsCenter != wc.containsCenter || !reflect.DeepEqual(gc.edges, wc.edges) {
+				t.Errorf("cell %v clipped[%d] = %+v, want %+v", cellID, i, gc, wc)
+			}
+		}
+	}
+}
