+
+// Encode encodes the LaxPolygon.
+func (p *LaxPolygon) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	p.encode(e)
+	return e.err
+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUint32(uint32(p.numLoops))
+	for i := range p.numLoops {
+		e.writeUint32(uint32(p.numLoopVertices(i)))
+	}
+	nverts := p.numVertices()
+	for i := range nverts {
+		v := p.vertices[i]
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	nloops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	loopSizes := make([]int, 0, min(int(nloops), 1024))
+	var totalVerts uint64
+	for range nloops {
+		lv := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if lv > maxEncodedVertices || totalVerts+uint64(lv) > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", totalVerts+uint64(lv), maxEncodedVertices)
+			return
+		}
+		totalVerts += uint64(lv)
+		loopSizes = append(loopSizes, int(lv))
+	}
+	verts := make([]Point, 0, min(int(totalVerts), 1024))
+	for range totalVerts {
+		var v Point
+		v.X = d.readFloat64()
+		v.Y = d.readFloat64()
+		v.Z = d.readFloat64()
+		if d.err != nil {
+			return
+		}
+		verts = append(verts, v)
+	}
+	*p = LaxPolygon{}
+	p.numLoops = int(nloops)
+	switch p.numLoops {
+	case 0:
+		p.numVerts = 0
+		p.vertices = nil
+	case 1:
+		p.numVerts = len(verts)
+		p.vertices = verts
+	default:
+		p.cumulativeVertices = make([]int, p.numLoops+1)
+		numVertices := 0
+		for i, lv := range loopSizes {
+			p.cumulativeVertices[i] = numVertices
+			numVertices += lv
+		}
+		p.cumulativeVertices[p.numLoops] = numVertices
+		p.vertices = verts
+	}
 }
 
