+func TestConstructConsistentHash_Deduplication(t *testing.T) {
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-Id", Terminal: ptr.To(true)},
+				{HeaderName: "x-user-id", Terminal: ptr.To(false)}, // duplicate, case-insensitive
+				{HeaderName: "X-Other", Terminal: ptr.To(false)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session", TTL: ptr.To("1h")},
+				{Name: "session", TTL: ptr.To("2h")}, // duplicate, case-sensitive
+				{Name: "Session", TTL: ptr.To("3h")}, // different casing = different cookie
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "userId", Terminal: ptr.To(true)},
+				{Name: "userId", Terminal: ptr.To(false)}, // duplicate
+				{Name: "userid", Terminal: ptr.To(false)}, // different casing
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "stateKey", Terminal: ptr.To(true)},
+				{Key: "stateKey", Terminal: ptr.To(false)}, // duplicate
+				{Key: "statekey", Terminal: ptr.To(false)}, // different casing
+			},
+		},
+	}
+
+	var out trafficPolicySpecIr
+	err := constructConsistentHash(spec, &out)
+	require.NoError(t, err)
+
+	// Headers: 2 entries, first casing preserved, terminal from first preserved
+	require.Len(t, out.consistentHash.headers, 2)
+	assert.Equal(t, "X-User-Id", out.consistentHash.headers[0].headerName)
+	assert.True(t, out.consistentHash.headers[0].terminal)
+	assert.Equal(t, "X-Other", out.consistentHash.headers[1].headerName)
+
+	// Cookies: 2 entries ("session" and "Session")
+	require.Len(t, out.consistentHash.cookies, 2)
+	assert.Equal(t, "session", out.consistentHash.cookies[0].name)
+	assert.Equal(t, int64(3600), out.consistentHash.cookies[0].ttl.Seconds)
+	assert.Equal(t, "Session", out.consistentHash.cookies[1].name)
+	assert.Equal(t, int64(10800), out.consistentHash.cookies[1].ttl.Seconds)
+
+	// QueryParams: 2 entries ("userId" and "userid")
+	require.Len(t, out.consistentHash.queryParameters, 2)
+	assert.Equal(t, "userId", out.consistentHash.queryParameters[0].name)
+	assert.True(t, out.consistentHash.queryParameters[0].terminal)
+	assert.Equal(t, "userid", out.consistentHash.queryParameters[1].name)
+
+	// FilterState: 2 entries ("stateKey" and "statekey")
+	require.Len(t, out.consistentHash.filterState, 2)
+	assert.Equal(t, "stateKey", out.consistentHash.filterState[0].key)
+	assert.True(t, out.consistentHash.filterState[0].terminal)
+	assert.Equal(t, "statekey", out.consistentHash.filterState[1].key)
+}
