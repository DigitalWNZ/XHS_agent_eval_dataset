+func TestConstructConsistentHash_CookieTTL(t *testing.T) {
+	tests := []struct {
+		name        string
+		ttl         string
+		expectedSec int64
+		expectErr   bool
+	}{
+		{name: "Go duration 1h30m", ttl: "1h30m", expectedSec: 5400},
+		{name: "Go duration 30s", ttl: "30s", expectedSec: 30},
+		{name: "plain integer seconds 3600", ttl: "3600", expectedSec: 3600},
+		{name: "zero seconds string", ttl: "0", expectedSec: 0},
+		{name: "negative duration", ttl: "-1h", expectErr: true},
+		{name: "negative seconds", ttl: "-10", expectErr: true},
+		{name: "invalid format", ttl: "not-a-duration", expectErr: true},
