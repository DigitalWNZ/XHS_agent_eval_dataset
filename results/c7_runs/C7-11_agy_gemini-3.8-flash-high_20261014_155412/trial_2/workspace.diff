+func TestConsistentHash_MergeTrafficPolicies(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	t.Run("array fields union with higher priority first, deduplicated by key", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User-Id", Terminal: ptr.To(true)},
+					{HeaderName: "X-Role", Terminal: ptr.To(false)},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", TTL: ptr.To("1h")},
+				},
+			},
+		}
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "x-user-id", Terminal: ptr.To(false)}, // duplicate of p1 (case-insensitive)
+					{HeaderName: "X-Tenant-Id", Terminal: ptr.To(true)},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", TTL: ptr.To("2h")}, // duplicate of p1
+					{Name: "pref", TTL: ptr.To("3600")},
+				},
+			},
+		}
+
+		var s1, s2 trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(p1Spec, &s1))
+		require.NoError(t, constructConsistentHash(p2Spec, &s2))
+
+		p1Att := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Name: "policy1", Namespace: "default"},
+			PolicyIr:  &TrafficPolicy{spec: s1},
+		}
+		p2Att := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Name: "policy2", Namespace: "default"},
+			PolicyIr:  &TrafficPolicy{spec: s2},
+		}
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{p1Att, p2Att}, mergeTrafficPolicies, "")
+		mergedTP := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		// Check headers: X-User-Id (p1), X-Role (p1), X-Tenant-Id (p2)
+		headers := mergedTP.spec.consistentHash.headers
+		require.Len(t, headers, 3)
+		assert.Equal(t, "X-User-Id", headers[0].headerName)
+		assert.True(t, headers[0].terminal) // p1's terminal value
+		assert.Equal(t, "X-Role", headers[1].headerName)
+		assert.Equal(t, "X-Tenant-Id", headers[2].headerName)
+
+		// Check cookies: session (p1), pref (p2)
+		cookies := mergedTP.spec.consistentHash.cookies
+		require.Len(t, cookies, 2)
+		assert.Equal(t, "session", cookies[0].name)
+		assert.Equal(t, int64(3600), cookies[0].ttl.Seconds) // p1's 1h
+		assert.Equal(t, "pref", cookies[1].name)
+
+		// Check merge origins: both contributed
+		refs := merged.MergeOrigins["consistentHash"]
+		assert.True(t, refs.Has("gateway.kgateway.dev/TrafficPolicy/default/policy1"))
+		assert.True(t, refs.Has("gateway.kgateway.dev/TrafficPolicy/default/policy2"))
+	})
+
+	t.Run("sourceIp scalar retains higher-priority value even when unset", func(t *testing.T) {
+		// p1 has headers, sourceIp unset
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-Trace-Id"},
+				},
+			},
+		}
+		// p2 has sourceIp set
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			},
+		}
+
+		var s1, s2 trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(p1Spec, &s1))
+		require.NoError(t, constructConsistentHash(p2Spec, &s2))
+
+		p1Att := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Name: "p1"},
+			PolicyIr:  &TrafficPolicy{spec: s1},
+		}
+		p2Att := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Name: "p2"},
+			PolicyIr:  &TrafficPolicy{spec: s2},
+		}
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{p1Att, p2Att}, mergeTrafficPolicies, "")
+		mergedTP := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		// p1 sourceIp was unset -> merged sourceIp MUST be unset (nil)!
+		assert.Nil(t, mergedTP.spec.consistentHash.sourceIp)
+
+		// RouteAction output must only have X-Trace-Id and NO sourceIp
+		route := &envoyroutev3.Route{Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}}}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		require.Len(t, route.GetRoute().HashPolicy, 1)
+		assert.Equal(t, "X-Trace-Id", route.GetRoute().HashPolicy[0].GetHeader().HeaderName)
+	})
+
+	t.Run("sourceIp scalar retains higher-priority value when set", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			},
+		}
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(false)},
+			},
+		}
+
+		var s1, s2 trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(p1Spec, &s1))
+		require.NoError(t, constructConsistentHash(p2Spec, &s2))
+
+		p1Att := ir.PolicyAtt{GroupKind: gk, PolicyRef: &ir.AttachedPolicyRef{Name: "p1"}, PolicyIr: &TrafficPolicy{spec: s1}}
+		p2Att := ir.PolicyAtt{GroupKind: gk, PolicyRef: &ir.AttachedPolicyRef{Name: "p2"}, PolicyIr: &TrafficPolicy{spec: s2}}
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{p1Att, p2Att}, mergeTrafficPolicies, "")
+		mergedTP := merged.PolicyIr.(*TrafficPolicy)
+
+		require.NotNil(t, mergedTP.spec.consistentHash.sourceIp)
+		assert.True(t, mergedTP.spec.consistentHash.sourceIp.terminal) // retains p1's terminal=true
+	})
+
+	t.Run("higher-priority disable suppresses lower-priority policies", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: ptr.To(true),
+			},
+		}
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-Gateway-Header"},
+				},
+				SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			},
+		}
+
+		var s1, s2 trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(p1Spec, &s1))
+		require.NoError(t, constructConsistentHash(p2Spec, &s2))
+
+		p1Att := ir.PolicyAtt{GroupKind: gk, PolicyRef: &ir.AttachedPolicyRef{Name: "p1"}, PolicyIr: &TrafficPolicy{spec: s1}}
+		p2Att := ir.PolicyAtt{GroupKind: gk, PolicyRef: &ir.AttachedPolicyRef{Name: "p2"}, PolicyIr: &TrafficPolicy{spec: s2}}
