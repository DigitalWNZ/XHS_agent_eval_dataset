+func TestConsistentHashIR_Equals(t *testing.T) {
+	ir1 := &consistentHashIR{
+		headers: []HashPolicyHeaderIR{
+			{
+				headerName: "X-User-Id",
+				terminal:   true,
+				regexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+					Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^user-(.*)$"},
+					Substitution: "\\1",
+				},
+			},
+		},
+		cookies: []HashPolicyCookieIR{
+			{
+				name:     "session",
+				path:     "/api",
+				ttl:      durationpb.New(time.Hour),
+				terminal: false,
+				attributes: []*envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+					{Name: "SameSite", Value: "Strict"},
+				},
+			},
+		},
+		queryParameters: []HashPolicyQueryParameterIR{
+			{name: "param1", terminal: true},
+		},
+		filterState: []HashPolicyFilterStateIR{
+			{key: "filter_key", terminal: false},
+		},
+		sourceIp: &HashPolicySourceIPIR{terminal: true},
+	}
+
+	ir2 := ir1.Clone()
+
+	assert.True(t, ir1.Equals(ir2))
+	assert.True(t, ir2.Equals(ir1))
+
+	// Nil cases
+	var nilIR *consistentHashIR
+	assert.True(t, nilIR.Equals(nil))
+	assert.False(t, ir1.Equals(nil))
+	assert.False(t, nilIR.Equals(ir1))
+
+	// Disabled mismatch
+	diffDisabled := ir1.Clone()
+	diffDisabled.disabled = true
+	assert.False(t, ir1.Equals(diffDisabled))
+
+	// Header mismatch
+	diffHeader := ir1.Clone()
+	diffHeader.headers[0].headerName = "X-Other"
+	assert.False(t, ir1.Equals(diffHeader))
+
+	// Cookie mismatch
+	diffCookie := ir1.Clone()
+	diffCookie.cookies[0].name = "other_cookie"
+	assert.False(t, ir1.Equals(diffCookie))
+
+	// QueryParam mismatch
+	diffQP := ir1.Clone()
+	diffQP.queryParameters[0].terminal = false
+	assert.False(t, ir1.Equals(diffQP))
+
+	// FilterState mismatch
+	diffFS := ir1.Clone()
+	diffFS.filterState[0].key = "other_key"
+	assert.False(t, ir1.Equals(diffFS))
+
+	// SourceIp mismatch
+	diffSourceIP := ir1.Clone()
+	diffSourceIP.sourceIp.terminal = false
+	assert.False(t, ir1.Equals(diffSourceIP))
+
+	diffSourceIPNil := ir1.Clone()
+	diffSourceIPNil.sourceIp = nil
+	assert.False(t, ir1.Equals(diffSourceIPNil))
+}
