+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(out.consistentHash, route)
+
+	hp := route.GetRoute().HashPolicy
+	require.Len(t, hp, 5)
+
+	// 1. Headers
+	assert.NotNil(t, hp[0].GetHeader())
+	assert.Equal(t, "headerName", hp[0].GetHeader().HeaderName)
+	assert.Equal(t, "^(.*)$", hp[0].GetHeader().RegexRewrite.Pattern.Regex)
+	assert.Equal(t, "$1", hp[0].GetHeader().RegexRewrite.Substitution)
+	assert.True(t, hp[0].Terminal)
+
+	// 2. Cookies
+	assert.NotNil(t, hp[1].GetCookie())
+	assert.Equal(t, "cookieName", hp[1].GetCookie().Name)
+	assert.Equal(t, "/", hp[1].GetCookie().Path)
+	assert.Equal(t, int64(3600), hp[1].GetCookie().Ttl.Seconds)
+
+	// 3. QueryParameters
+	assert.NotNil(t, hp[2].GetQueryParameter())
+	assert.Equal(t, "qpName", hp[2].GetQueryParameter().Name)
+
+	// 4. FilterState
+	assert.NotNil(t, hp[3].GetFilterState())
+	assert.Equal(t, "fsKey", hp[3].GetFilterState().Key)
+	assert.True(t, hp[3].Terminal)
+
+	// 5. SourceIp
+	assert.NotNil(t, hp[4].GetConnectionProperties())
+	assert.True(t, hp[4].GetConnectionProperties().SourceIp)
+	assert.False(t, hp[4].Terminal)
+}
