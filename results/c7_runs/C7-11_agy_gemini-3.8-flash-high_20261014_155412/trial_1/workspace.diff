+func TestMergePoliciesFullPipeline(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	// Child policy (HTTPRoute level, priority 100)
+	pChildSpec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-Id", Terminal: true},
+			},
+		},
+	}
+	pChildIR := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(pChildSpec, pChildIR))
+
+	// Parent policy (Gateway level, priority 0)
+	pParentSpec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user-id", Terminal: false},
+				{HeaderName: "X-Session-Id"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "pref"},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: true},
+		},
+	}
+	pParentIR := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(pParentSpec, pParentIR))
+
+	childPolicy := ir.PolicyAtt{
+		GroupKind:            gk,
+		PolicyRef:            &ir.AttachedPolicyRef{Name: "child-policy"},
+		PolicyIr:             &TrafficPolicy{ct: time.Now(), spec: *pChildIR},
+		HierarchicalPriority: 100,
+	}
+	parentPolicy := ir.PolicyAtt{
+		GroupKind:            gk,
+		PolicyRef:            &ir.AttachedPolicyRef{Name: "parent-policy"},
+		PolicyIr:             &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: *pParentIR},
+		HierarchicalPriority: 0,
+	}
+
+	mergedAtt := policy.MergePolicies([]ir.PolicyAtt{childPolicy, parentPolicy}, mergeTrafficPolicies, "")
+	mergedTP, ok := mergedAtt.PolicyIr.(*TrafficPolicy)
+	require.True(t, ok)
+	require.NotNil(t, mergedTP.spec.consistentHash)
+
+	// Check merge origins contains both policies under "consistentHash"
+	refs := mergedAtt.MergeOrigins.Get("consistentHash")
+	assert.Contains(t, refs, childPolicy.PolicyRef.ID())
+	assert.Contains(t, refs, parentPolicy.PolicyRef.ID())
+
+	// Check merged result:
+	// Headers: X-User-Id (from child, terminal=true), X-Session-Id (from parent)
+	require.Len(t, mergedTP.spec.consistentHash.headers, 2)
+	assert.Equal(t, "X-User-Id", mergedTP.spec.consistentHash.headers[0].HeaderName)
+	assert.True(t, mergedTP.spec.consistentHash.headers[0].Terminal)
+	assert.Equal(t, "X-Session-Id", mergedTP.spec.consistentHash.headers[1].HeaderName)
+
+	// Cookies: pref (from parent)
+	require.Len(t, mergedTP.spec.consistentHash.cookies, 1)
+	assert.Equal(t, "pref", mergedTP.spec.consistentHash.cookies[0].Name)
+
+	// SourceIP: child had unset, so retains unset!
+	assert.Nil(t, mergedTP.spec.consistentHash.sourceIP)
+
+	// Canonical order: headers (2), cookies (1)
+	require.Len(t, mergedTP.spec.consistentHash.hashPolicies, 3)
+	assert.Equal(t, "X-User-Id", mergedTP.spec.consistentHash.hashPolicies[0].GetHeader().HeaderName)
+	assert.Equal(t, "X-Session-Id", mergedTP.spec.consistentHash.hashPolicies[1].GetHeader().HeaderName)
+	assert.Equal(t, "pref", mergedTP.spec.consistentHash.hashPolicies[2].GetCookie().Name)
+}
