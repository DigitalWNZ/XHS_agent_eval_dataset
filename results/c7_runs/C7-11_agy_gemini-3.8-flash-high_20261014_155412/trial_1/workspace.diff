+func TestMergeConsistentHash(t *testing.T) {
+	t.Run("merging two policies unions arrays with higher-priority first, dedupes, re-sorts", func(t *testing.T) {
+		// p1 is higher-priority (e.g. HTTPRoute level)
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User-Id", Terminal: true},
+					{HeaderName: "X-Trace-Id"},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", TTL: "1h"},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "uid"},
+				},
+				// sourceIp is unset in p1
+			},
+		}
+		p1IR := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(p1Spec, p1IR))
+		p1 := &TrafficPolicy{spec: *p1IR}
+
+		// p2 is lower-priority (e.g. Gateway level)
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "x-user-id", Terminal: false}, // duplicate of p1 (case-insensitive)
+					{HeaderName: "X-App-Id"},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", TTL: "2h"}, // duplicate of p1
+					{Name: "tracker"},
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "fs1"},
+				},
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: true},
+			},
+		}
+		p2IR := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(p2Spec, p2IR))
+		p2 := &TrafficPolicy{spec: *p2IR}
+
+		mergeOrigins := ir.MergeOrigins{}
+		p2Ref := &ir.AttachedPolicyRef{Name: "p2"}
+
+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		// Verify merge metadata records "consistentHash"
+		require.Contains(t, mergeOrigins, "consistentHash")
+		assert.True(t, mergeOrigins["consistentHash"].Has(p2Ref.ID()))
+
+		merged := p1.spec.consistentHash
+		require.NotNil(t, merged)
+
+		// 1. Array fields unioned with higher-priority entries first, deduplicated by key
+		// Headers: "X-User-Id" (first kept, casing preserved), "X-Trace-Id", "X-App-Id"
+		require.Len(t, merged.headers, 3)
+		assert.Equal(t, "X-User-Id", merged.headers[0].HeaderName)
+		assert.True(t, merged.headers[0].Terminal)
+		assert.Equal(t, "X-Trace-Id", merged.headers[1].HeaderName)
+		assert.Equal(t, "X-App-Id", merged.headers[2].HeaderName)
+
+		// Cookies: "session" (p1 TTL=1h kept), "tracker"
+		require.Len(t, merged.cookies, 2)
+		assert.Equal(t, "session", merged.cookies[0].Name)
+		assert.Equal(t, "1h", merged.cookies[0].TTL)
+		assert.Equal(t, "tracker", merged.cookies[1].Name)
+
+		// QueryParameters: "uid" from p1
+		require.Len(t, merged.queryParameters, 1)
+		assert.Equal(t, "uid", merged.queryParameters[0].Name)
+
+		// FilterState: "fs1" from p2
+		require.Len(t, merged.filterState, 1)
+		assert.Equal(t, "fs1", merged.filterState[0].Key)
+
+		// 2. "The sourceIp scalar retains the higher-priority policy's value even when unset."
+		// p1 had sourceIp unset (nil), so merged.sourceIP MUST remain nil!
+		assert.Nil(t, merged.sourceIP)
+
+		// 3. Merged hash policies re-sorted into canonical type order:
+		// headers (3), cookies (2), queryParameters (1), filterState (1), sourceIp (0) = 7 total
+		require.Len(t, merged.hashPolicies, 7)
+		assert.NotNil(t, merged.hashPolicies[0].GetHeader())
+		assert.Equal(t, "X-User-Id", merged.hashPolicies[0].GetHeader().HeaderName)
+		assert.NotNil(t, merged.hashPolicies[1].GetHeader())
+		assert.Equal(t, "X-Trace-Id", merged.hashPolicies[1].GetHeader().HeaderName)
+		assert.NotNil(t, merged.hashPolicies[2].GetHeader())
+		assert.Equal(t, "X-App-Id", merged.hashPolicies[2].GetHeader().HeaderName)
+
+		assert.NotNil(t, merged.hashPolicies[3].GetCookie())
+		assert.Equal(t, "session", merged.hashPolicies[3].GetCookie().Name)
+		assert.NotNil(t, merged.hashPolicies[4].GetCookie())
+		assert.Equal(t, "tracker", merged.hashPolicies[4].GetCookie().Name)
+
+		assert.NotNil(t, merged.hashPolicies[5].GetQueryParameter())
+		assert.Equal(t, "uid", merged.hashPolicies[5].GetQueryParameter().Name)
+
+		assert.NotNil(t, merged.hashPolicies[6].GetFilterState())
+		assert.Equal(t, "fs1", merged.hashPolicies[6].GetFilterState().Key)
+	})
+
+	t.Run("sourceIp retains higher-priority value when set", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: false},
+			},
