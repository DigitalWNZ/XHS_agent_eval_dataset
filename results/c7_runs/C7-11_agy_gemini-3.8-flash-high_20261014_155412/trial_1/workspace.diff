+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		// Retains p1's value: Terminal=false
+		require.NotNil(t, p1.spec.consistentHash.sourceIP)
+		assert.False(t, p1.spec.consistentHash.sourceIP.Terminal)
+		require.Len(t, p1.spec.consistentHash.hashPolicies, 1)
+		assert.False(t, p1.spec.consistentHash.hashPolicies[0].Terminal)
+	})
+
+	t.Run("higher-priority disable=true suppresses lower-priority policy", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: true,
+			},
