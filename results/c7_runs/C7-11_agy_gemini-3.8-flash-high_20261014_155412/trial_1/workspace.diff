+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "query_name"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "cookie_name"},
+			},
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "header_name"},
+			},
+		},
+	}
+	err := constructConsistentHash(spec, out)
+	require.NoError(t, err)
+	require.NotNil(t, out.consistentHash)
+
+	// Verify entries are built in canonical type order: headers, cookies, queryParameters, filterState, sourceIp
+	require.Len(t, out.consistentHash.hashPolicies, 5)
+
+	// 1. Header
+	require.NotNil(t, out.consistentHash.hashPolicies[0].GetHeader())
+	assert.Equal(t, "header_name", out.consistentHash.hashPolicies[0].GetHeader().HeaderName)
+
+	// 2. Cookie
+	require.NotNil(t, out.consistentHash.hashPolicies[1].GetCookie())
+	assert.Equal(t, "cookie_name", out.consistentHash.hashPolicies[1].GetCookie().Name)
+
+	// 3. QueryParameter
