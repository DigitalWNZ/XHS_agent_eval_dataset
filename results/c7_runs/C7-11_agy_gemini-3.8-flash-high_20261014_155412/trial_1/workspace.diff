+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	_ policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p2.spec.consistentHash == nil {
+		return
+	}
+
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = p2.spec.consistentHash.clone()
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// When disable is true on higher-priority policy, suppress lower-priority policy.
+	if p1.spec.consistentHash.disable {
+		return
+	}
+
+	// When disable is true on lower-priority policy, it is suppressed by higher-priority policy.
+	if p2.spec.consistentHash.disable {
+		return
+	}
+
+	// Union array fields with higher-priority (p1) entries first, deduplicated by key.
+	p1.spec.consistentHash.headers = unionHeaders(p1.spec.consistentHash.headers, p2.spec.consistentHash.headers)
+	p1.spec.consistentHash.cookies = unionCookies(p1.spec.consistentHash.cookies, p2.spec.consistentHash.cookies)
+	p1.spec.consistentHash.queryParameters = unionQueryParameters(p1.spec.consistentHash.queryParameters, p2.spec.consistentHash.queryParameters)
+	p1.spec.consistentHash.filterState = unionFilterState(p1.spec.consistentHash.filterState, p2.spec.consistentHash.filterState)
+
+	// "The sourceIp scalar retains the higher-priority policy's value even when unset."
+	// p1 is higher priority, so p1.spec.consistentHash.sourceIP is retained as-is.
+
+	// Re-sort into canonical type order
+	p1.spec.consistentHash.hashPolicies = buildHashPolicies(p1.spec.consistentHash)
+
+	// Merge metadata must record this field as consistentHash under the existing TrafficPolicy merge metadata key.
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
