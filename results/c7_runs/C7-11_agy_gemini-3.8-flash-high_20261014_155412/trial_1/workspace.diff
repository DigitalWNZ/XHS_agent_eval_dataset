+}
+
+func deduplicateQueryParameters(params []kgateway.ConsistentHashQueryParameter) []kgateway.ConsistentHashQueryParameter {
+	if len(params) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(params))
+	result := make([]kgateway.ConsistentHashQueryParameter, 0, len(params))
+	for _, q := range params {
+		if _, exists := seen[q.Name]; exists {
+			continue
