+func TestApplyConsistentHash(t *testing.T) {
+	t.Run("empty consistentHash defaults to single sourceIp with terminal=false", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+
+		ir := &consistentHashIR{disable: false}
+		applyConsistentHash(ir, route)
+
+		action := route.GetRoute()
+		require.NotNil(t, action)
+		require.Len(t, action.HashPolicy, 1)
+		hp := action.HashPolicy[0]
+		assert.False(t, hp.Terminal)
+		assert.True(t, hp.GetConnectionProperties().GetSourceIp())
+	})
+
+	t.Run("disable=true clears existing hash policies and produces none", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{
+					HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{
+						{Terminal: true},
+					},
+				},
+			},
+		}
+
+		ir := &consistentHashIR{disable: true}
+		applyConsistentHash(ir, route)
+
+		action := route.GetRoute()
+		require.NotNil(t, action)
+		assert.Nil(t, action.HashPolicy)
+	})
+
+	t.Run("canonical type order: headers, cookies, queryParameters, filterState, sourceIp", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+
+		ir := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "x-user-id",
+					Terminal:   true,
+					RegexRewrite: &kgateway.RegexRewrite{
+						Pattern:      "^user-(.*)$",
+						Substitution: "$1",
+					},
+				},
+			},
+			cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name:     "session",
+					TTL:      "1h30m",
+					Path:     "/api",
+					Terminal: false,
+					Attributes: []kgateway.CookieAttribute{
+						{Name: "SameSite", Value: "Strict"},
+						{Name: "Secure", Value: "true"},
+					},
+				},
+				{
+					Name: "plain-seconds-cookie",
+					TTL:  "3600",
+				},
+			},
+			queryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "query_param", Terminal: true},
+			},
+			filterState: []kgateway.ConsistentHashFilterState{
+				{Key: "custom_key", Terminal: false},
+			},
+			sourceIp: &kgateway.ConsistentHashSourceIP{
+				Terminal: true,
+			},
+		}
+
+		applyConsistentHash(ir, route)
+
+		action := route.GetRoute()
+		require.NotNil(t, action)
+		require.Len(t, action.HashPolicy, 6)
+
+		// 1. Header
+		hp0 := action.HashPolicy[0]
+		assert.True(t, hp0.Terminal)
+		require.NotNil(t, hp0.GetHeader())
+		assert.Equal(t, "x-user-id", hp0.GetHeader().HeaderName)
+		require.NotNil(t, hp0.GetHeader().RegexRewrite)
+		assert.Equal(t, "^user-(.*)$", hp0.GetHeader().RegexRewrite.GetPattern().GetRegex())
+		assert.Equal(t, "$1", hp0.GetHeader().RegexRewrite.Substitution)
+
+		// 2. Cookie 1 (with TTL "1h30m" -> 5400s, path, attributes)
+		hp1 := action.HashPolicy[1]
+		assert.False(t, hp1.Terminal)
+		require.NotNil(t, hp1.GetCookie())
+		assert.Equal(t, "session", hp1.GetCookie().Name)
+		assert.Equal(t, durationpb.New(90*time.Minute), hp1.GetCookie().Ttl)
+		assert.Equal(t, "/api", hp1.GetCookie().Path)
+		require.Len(t, hp1.GetCookie().Attributes, 2)
+		assert.Equal(t, "SameSite", hp1.GetCookie().Attributes[0].Name)
+		assert.Equal(t, "Strict", hp1.GetCookie().Attributes[0].Value)
+		assert.Equal(t, "Secure", hp1.GetCookie().Attributes[1].Name)
+		assert.Equal(t, "true", hp1.GetCookie().Attributes[1].Value)
+
+		// Cookie 2 (plain seconds "3600" -> 3600s)
+		hp2 := action.HashPolicy[2]
+		require.NotNil(t, hp2.GetCookie())
+		assert.Equal(t, "plain-seconds-cookie", hp2.GetCookie().Name)
+		assert.Equal(t, durationpb.New(3600*time.Second), hp2.GetCookie().Ttl)
+
+		// 3. Query Parameter
+		hp3 := action.HashPolicy[3]
+		assert.True(t, hp3.Terminal)
+		require.NotNil(t, hp3.GetQueryParameter())
+		assert.Equal(t, "query_param", hp3.GetQueryParameter().Name)
+
+		// 4. Filter State
+		hp4 := action.HashPolicy[4]
+		assert.False(t, hp4.Terminal)
+		require.NotNil(t, hp4.GetFilterState())
+		assert.Equal(t, "custom_key", hp4.GetFilterState().Key)
+
+		// 5. Source IP
+		hp5 := action.HashPolicy[5]
+		assert.True(t, hp5.Terminal)
+		require.NotNil(t, hp5.GetConnectionProperties())
+		assert.True(t, hp5.GetConnectionProperties().GetSourceIp())
+	})
+}
