+func TestConsistentHashIREqualsAndValidate(t *testing.T) {
+	t.Run("Equals", func(t *testing.T) {
+		a := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-A", RegexRewrite: &kgateway.RegexRewrite{Pattern: "p", Substitution: "s"}},
+			},
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c", Attributes: []kgateway.CookieAttribute{{Name: "k", Value: "v"}}},
+			},
+			queryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+			filterState:     []kgateway.ConsistentHashFilterState{{Key: "f"}},
+			sourceIp:        &kgateway.ConsistentHashSourceIP{Terminal: true},
+		}
+
+		b := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-A", RegexRewrite: &kgateway.RegexRewrite{Pattern: "p", Substitution: "s"}},
+			},
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c", Attributes: []kgateway.CookieAttribute{{Name: "k", Value: "v"}}},
+			},
+			queryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+			filterState:     []kgateway.ConsistentHashFilterState{{Key: "f"}},
+			sourceIp:        &kgateway.ConsistentHashSourceIP{Terminal: true},
+		}
+
+		assert.True(t, a.Equals(b))
+		assert.True(t, a.Equals(a))
+		assert.False(t, a.Equals(nil))
+
+		diffHeader := cloneConsistentHash(a)
+		diffHeader.headers[0].HeaderName = "X-B"
+		assert.False(t, a.Equals(diffHeader))
+
+		diffDisable := cloneConsistentHash(a)
+		diffDisable.disable = true
+		assert.False(t, a.Equals(diffDisable))
+
+		diffSourceIp := cloneConsistentHash(a)
+		diffSourceIp.sourceIp.Terminal = false
+		assert.False(t, a.Equals(diffSourceIp))
+	})
+
+	t.Run("Validate", func(t *testing.T) {
+		valid := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-A", RegexRewrite: &kgateway.RegexRewrite{Pattern: "^foo.*", Substitution: "bar"}},
+			},
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c", TTL: "1h30m"},
+			},
+		}
+		assert.NoError(t, valid.Validate())
+
+		invalidRegex := &consistentHashIR{
+			headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-A", RegexRewrite: &kgateway.RegexRewrite{Pattern: "[invalid", Substitution: "bar"}},
+			},
+		}
+		assert.Error(t, invalidRegex.Validate())
+
+		invalidTTL := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c", TTL: "invalid"},
+			},
+		}
+		assert.Error(t, invalidTTL.Validate())
+
+		invalidDisable := &consistentHashIR{
+			disable: true,
+			headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-A"}},
+		}
+		assert.Error(t, invalidDisable.Validate())
+	})
+}
