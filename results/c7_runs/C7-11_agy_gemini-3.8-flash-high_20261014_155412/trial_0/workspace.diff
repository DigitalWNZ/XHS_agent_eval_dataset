+func TestConstructConsistentHash(t *testing.T) {
+	t.Run("nil spec produces nil IR", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{}, out)
+		require.NoError(t, err)
+		assert.Nil(t, out.consistentHash)
+	})
+
+	t.Run("empty consistentHash produces non-nil IR with disable false", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		assert.False(t, out.consistentHash.disable)
+		assert.Empty(t, out.consistentHash.headers)
+		assert.Empty(t, out.consistentHash.cookies)
+		assert.Empty(t, out.consistentHash.queryParameters)
+		assert.Empty(t, out.consistentHash.filterState)
+		assert.Nil(t, out.consistentHash.sourceIp)
+	})
+
+	t.Run("disable true alone succeeds", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: true,
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		assert.True(t, out.consistentHash.disable)
+	})
+
+	t.Run("disable true with other fields errors", func(t *testing.T) {
+		testCases := []struct {
+			name string
+			ch   *kgateway.ConsistentHash
+		}{
+			{
+				name: "disable with headers",
+				ch: &kgateway.ConsistentHash{
+					Disable: true,
+					Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-foo"}},
+				},
+			},
+			{
+				name: "disable with cookies",
+				ch: &kgateway.ConsistentHash{
+					Disable: true,
+					Cookies: []kgateway.ConsistentHashCookie{{Name: "sess"}},
+				},
+			},
+			{
+				name: "disable with queryParameters",
+				ch: &kgateway.ConsistentHash{
+					Disable:         true,
+					QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "qp"}},
+				},
+			},
+			{
+				name: "disable with filterState",
+				ch: &kgateway.ConsistentHash{
+					Disable:     true,
+					FilterState: []kgateway.ConsistentHashFilterState{{Key: "fs"}},
+				},
+			},
+			{
+				name: "disable with sourceIp",
+				ch: &kgateway.ConsistentHash{
+					Disable:  true,
+					SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true},
+				},
+			},
+		}
+
+		for _, tc := range testCases {
+			t.Run(tc.name, func(t *testing.T) {
+				out := &trafficPolicySpecIr{}
+				err := constructConsistentHash(kgateway.TrafficPolicySpec{
+					ConsistentHash: tc.ch,
+				}, out)
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "when disable is true, no other fields may be set")
+			})
+		}
+	})
+
+	t.Run("headers deduplicated case-insensitively preserving first casing", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User-ID", Terminal: false},
+					{HeaderName: "x-user-id", Terminal: true},
+					{HeaderName: "X-USER-ID", Terminal: true},
+					{HeaderName: "Authorization", Terminal: false},
+				},
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		require.Len(t, out.consistentHash.headers, 2)
+		assert.Equal(t, "X-User-ID", out.consistentHash.headers[0].HeaderName)
+		assert.False(t, out.consistentHash.headers[0].Terminal)
+		assert.Equal(t, "Authorization", out.consistentHash.headers[1].HeaderName)
+	})
+
+	t.Run("cookies deduplicated case-sensitively", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", Path: "/a"},
+					{Name: "session", Path: "/b"},
+					{Name: "Session", Path: "/c"},
+				},
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		require.Len(t, out.consistentHash.cookies, 2)
+		assert.Equal(t, "session", out.consistentHash.cookies[0].Name)
+		assert.Equal(t, "/a", out.consistentHash.cookies[0].Path)
+		assert.Equal(t, "Session", out.consistentHash.cookies[1].Name)
+		assert.Equal(t, "/c", out.consistentHash.cookies[1].Path)
+	})
+
+	t.Run("queryParameters deduplicated case-sensitively", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "user", Terminal: true},
+					{Name: "user", Terminal: false},
+					{Name: "User", Terminal: false},
+				},
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		require.Len(t, out.consistentHash.queryParameters, 2)
+		assert.Equal(t, "user", out.consistentHash.queryParameters[0].Name)
+		assert.True(t, out.consistentHash.queryParameters[0].Terminal)
+		assert.Equal(t, "User", out.consistentHash.queryParameters[1].Name)
+	})
+
+	t.Run("filterState deduplicated case-sensitively", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "key1", Terminal: true},
+					{Key: "key1", Terminal: false},
+					{Key: "Key1", Terminal: false},
+				},
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		require.Len(t, out.consistentHash.filterState, 2)
+		assert.Equal(t, "key1", out.consistentHash.filterState[0].Key)
+		assert.True(t, out.consistentHash.filterState[0].Terminal)
+		assert.Equal(t, "Key1", out.consistentHash.filterState[1].Key)
+	})
+
+	t.Run("header regexRewrite validation", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "x-foo",
+						RegexRewrite: &kgateway.RegexRewrite{
+							Pattern:      "[invalid(regex",
+							Substitution: "sub",
+						},
+					},
+				},
+			},
+		}, out)
+		require.Error(t, err)
+	})
+
+	t.Run("cookie TTL valid formats", func(t *testing.T) {
+		validTTLs := []string{"1h30m", "3600", "0", "0s", "500ms", "10s"}
+		for _, ttl := range validTTLs {
+			out := &trafficPolicySpecIr{}
+			err := constructConsistentHash(kgateway.TrafficPolicySpec{
+				ConsistentHash: &kgateway.ConsistentHash{
+					Cookies: []kgateway.ConsistentHashCookie{
+						{Name: "sess", TTL: ttl},
+					},
+				},
+			}, out)
+			require.NoError(t, err, "expected valid TTL: %s", ttl)
+		}
+	})
+
+	t.Run("cookie TTL invalid formats", func(t *testing.T) {
+		invalidTTLs := []string{"not-a-duration", "-5s", "-100", "abc"}
+		for _, ttl := range invalidTTLs {
+			out := &trafficPolicySpecIr{}
+			err := constructConsistentHash(kgateway.TrafficPolicySpec{
+				ConsistentHash: &kgateway.ConsistentHash{
+					Cookies: []kgateway.ConsistentHashCookie{
+						{Name: "sess", TTL: ttl},
+					},
+				},
+			}, out)
+			require.Error(t, err, "expected error for TTL: %s", ttl)
+		}
+	})
+}
