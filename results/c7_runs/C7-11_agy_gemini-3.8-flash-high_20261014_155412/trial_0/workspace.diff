+func TestMergeConsistentHash(t *testing.T) {
+	t.Run("union array fields with higher priority entries first, deduplicated", func(t *testing.T) {
+		p1Ref := &ir.AttachedPolicyRef{Name: "p1-higher"}
+		p2Ref := &ir.AttachedPolicyRef{Name: "p2-lower"}
+
+		p1 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-User-ID", Terminal: false},
+					},
+					cookies: []kgateway.ConsistentHashCookie{
+						{Name: "sess", Path: "/p1"},
+					},
+					queryParameters: []kgateway.ConsistentHashQueryParameter{
+						{Name: "id", Terminal: false},
+					},
+					filterState: []kgateway.ConsistentHashFilterState{
+						{Key: "state1", Terminal: false},
+					},
+					sourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true},
+				},
+			},
+		}
+
+		p2 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "x-user-id", Terminal: true}, // duplicate (case-insensitive)
+						{HeaderName: "X-App-ID", Terminal: true},
+					},
+					cookies: []kgateway.ConsistentHashCookie{
+						{Name: "sess", Path: "/p2"}, // duplicate
+						{Name: "other_sess", Path: "/p2"},
+					},
+					queryParameters: []kgateway.ConsistentHashQueryParameter{
+						{Name: "id", Terminal: true}, // duplicate
+						{Name: "token", Terminal: true},
+					},
+					filterState: []kgateway.ConsistentHashFilterState{
+						{Key: "state1", Terminal: true}, // duplicate
+						{Key: "state2", Terminal: true},
+					},
+					sourceIp: &kgateway.ConsistentHashSourceIP{Terminal: false}, // should be ignored
+				},
+			},
+		}
+
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		require.NotNil(t, p1.spec.consistentHash)
+
+		// Headers unioned: higher-priority first, duplicate dropped, casing preserved
+		require.Len(t, p1.spec.consistentHash.headers, 2)
+		assert.Equal(t, "X-User-ID", p1.spec.consistentHash.headers[0].HeaderName)
+		assert.False(t, p1.spec.consistentHash.headers[0].Terminal) // from p1
+		assert.Equal(t, "X-App-ID", p1.spec.consistentHash.headers[1].HeaderName)
+
+		// Cookies unioned
+		require.Len(t, p1.spec.consistentHash.cookies, 2)
+		assert.Equal(t, "sess", p1.spec.consistentHash.cookies[0].Name)
+		assert.Equal(t, "/p1", p1.spec.consistentHash.cookies[0].Path) // from p1
+		assert.Equal(t, "other_sess", p1.spec.consistentHash.cookies[1].Name)
+
+		// QueryParameters unioned
+		require.Len(t, p1.spec.consistentHash.queryParameters, 2)
+		assert.Equal(t, "id", p1.spec.consistentHash.queryParameters[0].Name)
+		assert.False(t, p1.spec.consistentHash.queryParameters[0].Terminal) // from p1
+		assert.Equal(t, "token", p1.spec.consistentHash.queryParameters[1].Name)
+
+		// FilterState unioned
+		require.Len(t, p1.spec.consistentHash.filterState, 2)
+		assert.Equal(t, "state1", p1.spec.consistentHash.filterState[0].Key)
+		assert.False(t, p1.spec.consistentHash.filterState[0].Terminal) // from p1
+		assert.Equal(t, "state2", p1.spec.consistentHash.filterState[1].Key)
+
+		// sourceIp scalar retains higher-priority policy's value
+		require.NotNil(t, p1.spec.consistentHash.sourceIp)
+		assert.True(t, p1.spec.consistentHash.sourceIp.Terminal) // p1 has Terminal: true
+
+		// Merge metadata records consistentHash
+		assert.True(t, mergeOrigins["consistentHash"].Has(p2Ref.ID()))
+		_ = p1Ref
+	})
+
+	t.Run("sourceIp retains higher priority policy value even when unset", func(t *testing.T) {
+		p2Ref := &ir.AttachedPolicyRef{Name: "p2-lower"}
+
+		p1 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-User"},
+					},
+					sourceIp: nil, // UNSET in higher-priority policy
+				},
+			},
+		}
+
+		p2 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-Other"},
+					},
+					sourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true}, // set in lower-priority policy
+				},
+			},
+		}
+
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		require.NotNil(t, p1.spec.consistentHash)
+		// sourceIp MUST remain nil because higher-priority policy had it unset!
+		assert.Nil(t, p1.spec.consistentHash.sourceIp)
+		require.Len(t, p1.spec.consistentHash.headers, 2)
+	})
+
+	t.Run("higher priority disable=true suppresses lower priority policy", func(t *testing.T) {
+		p2Ref := &ir.AttachedPolicyRef{Name: "p2-lower"}
+
+		p1 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					disable: true,
+				},
+			},
+		}
+
+		p2 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-Foo"},
+					},
+					sourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true},
+				},
+			},
+		}
+
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		require.NotNil(t, p1.spec.consistentHash)
+		assert.True(t, p1.spec.consistentHash.disable)
+		assert.Empty(t, p1.spec.consistentHash.headers)
+		assert.Nil(t, p1.spec.consistentHash.sourceIp)
+	})
+
+	t.Run("lower priority disable=true does not suppress higher priority policy", func(t *testing.T) {
+		p2Ref := &ir.AttachedPolicyRef{Name: "p2-lower"}
+
+		p1 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					disable: false,
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-Foo"},
+					},
+				},
+			},
+		}
+
+		p2 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					disable: true,
+				},
+			},
+		}
+
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		require.NotNil(t, p1.spec.consistentHash)
+		assert.False(t, p1.spec.consistentHash.disable)
+		require.Len(t, p1.spec.consistentHash.headers, 1)
+		assert.Equal(t, "X-Foo", p1.spec.consistentHash.headers[0].HeaderName)
+	})
+
+	t.Run("first policy merged sets consistentHash and records origin", func(t *testing.T) {
+		p2Ref := &ir.AttachedPolicyRef{Name: "p-first"}
+
+		p1 := &TrafficPolicy{} // empty accumulator
+		p2 := &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-First"}},
+				},
+			},
+		}
+
+		mergeOrigins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		require.NotNil(t, p1.spec.consistentHash)
+		assert.Equal(t, sets.New(p2Ref.ID()), mergeOrigins["consistentHash"])
+	})
+
+	t.Run("full policy merge pipeline via policy.MergePolicies", func(t *testing.T) {
+		ref1 := &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Name: "tp-route"}
+		ref2 := &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Name: "tp-gw"}
+
+		// Route policy (higher priority)
+		pol1 := ir.PolicyAtt{
+			HierarchicalPriority: 0,
+			PolicyRef:            ref1,
+			PolicyIr: &TrafficPolicy{
+				spec: trafficPolicySpecIr{
+					consistentHash: &consistentHashIR{
+						headers: []kgateway.ConsistentHashHeader{
+							{HeaderName: "X-Route-Header"},
+						},
+					},
+				},
+			},
+		}
+
+		// Gateway policy (lower priority)
+		pol2 := ir.PolicyAtt{
+			HierarchicalPriority: -1,
+			PolicyRef:            ref2,
+			PolicyIr: &TrafficPolicy{
+				spec: trafficPolicySpecIr{
+					consistentHash: &consistentHashIR{
+						headers: []kgateway.ConsistentHashHeader{
+							{HeaderName: "X-Gw-Header"},
+						},
+						sourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true},
+					},
+				},
+			},
+		}
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{pol1, pol2}, mergeTrafficPolicies, "")
+		mergedTP, ok := merged.PolicyIr.(*TrafficPolicy)
+		require.True(t, ok)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		// Headers unioned: route header first, gw header second
+		require.Len(t, mergedTP.spec.consistentHash.headers, 2)
+		assert.Equal(t, "X-Route-Header", mergedTP.spec.consistentHash.headers[0].HeaderName)
+		assert.Equal(t, "X-Gw-Header", mergedTP.spec.consistentHash.headers[1].HeaderName)
+
+		// sourceIp was unset on pol1, so it MUST remain unset on mergedTP!
+		assert.Nil(t, mergedTP.spec.consistentHash.sourceIp)
+
+		// MergeOrigins records both policies under "consistentHash"
+		origins := merged.MergeOrigins["consistentHash"]
+		assert.True(t, origins.Has(ref1.ID()))
+		assert.True(t, origins.Has(ref2.ID()))
+	})
+}
