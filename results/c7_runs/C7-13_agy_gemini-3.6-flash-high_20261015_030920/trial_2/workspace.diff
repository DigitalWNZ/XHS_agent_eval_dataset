+
+	readers, writer, closer := storageReadWriteCloser(1, true, enc)
+
+	go func() {
+		_, err := writer.Write(plaintext)
+		assert.NoError(err)
+		assert.NoError(closer.Close())
+	}()
+
+	// Round-trip output through DecryptReader then gzip.NewReader
+	decR, err := encryption.DecryptReader(readers[0], key)
+	assert.NoError(err)
+
+	gzR, err := gzip.NewReader(decR)
+	assert.NoError(err)
+
+	restored, err := io.ReadAll(gzR)
+	assert.NoError(err)
+	assert.NoError(gzR.Close())
+
+	assert.Equal(plaintext, restored)
+}
