+func TestStorageReadWriteCloserEncryptionRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	for i := range key {
+		key[i] = byte(i + 1)
+	}
+
+	enc, err := encryption.NewEncryptor(key)
+	assert.NoError(t, err)
+
+	originalData := []byte("SELECT * FROM users; -- Test SQL dump data for encryption pipeline")
+
+	// Test both compress=true and compress=false
+	for _, compress := range []bool{true, false} {
+		readers, writer, closer := storageReadWriteCloser(1, compress, enc)
+
+		go func() {
+			_, err := writer.Write(originalData)
+			assert.NoError(t, err)
+			assert.NoError(t, closer.Close())
+		}()
+
+		// Output pipeline reader
+		r := readers[0]
+
+		// 1. First DecryptReader
+		decryptedReader, err := encryption.DecryptReader(r, key)
+		assert.NoError(t, err)
+
+		var finalReader io.Reader = decryptedReader
+
+		// 2. Then gzip.NewReader if compressed
+		if compress {
+			gzReader, err := gzip.NewReader(decryptedReader)
+			assert.NoError(t, err)
+			defer gzReader.Close()
+			finalReader = gzReader
+		}
+
+		result, err := io.ReadAll(finalReader)
+		assert.NoError(t, err)
+		assert.Equal(t, originalData, result)
+	}
+}
