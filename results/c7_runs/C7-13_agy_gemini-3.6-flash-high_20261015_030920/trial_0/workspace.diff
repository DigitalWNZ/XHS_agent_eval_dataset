diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..dee6194
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,433 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+	"sync"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+var ErrInvalidKey = errors.New("invalid key: key must be 32 bytes")
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("key length %d is invalid: %w", len(key), ErrInvalidKey)
+	}
+	keyCopy := make([]byte, 32)
+	copy(keyCopy, key)
+	return &Encryptor{key: keyCopy}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return newEncryptWriter(w, e.key)
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	closed        bool
+	headerWritten bool
+	mu            sync.Mutex
+}
+
+const chunkSize = 64 * 1024 // 64KB
+
+func newEncryptWriter(w io.Writer, key []byte) *encryptWriter {
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		panic(err)
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		panic(err)
+	}
+	mac := hmac.New(sha256.New, key)
+	return &encryptWriter{
+		w:    w,
+		key:  key,
+		aead: aead,
+		mac:  mac,
+	}
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{0x4F, 0x44, 0x01}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	ew.mu.Lock()
+	defer ew.mu.Unlock()
+
+	if ew.closed {
+		return 0, errors.New("write to closed EncryptWriter")
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		return 0, err
+	}
+
+	total := len(p)
+	ew.buf = append(ew.buf, p...)
+
+	for len(ew.buf) >= chunkSize {
+		chunk := ew.buf[:chunkSize]
+		if err := ew.flushChunk(chunk); err != nil {
+			return 0, err
+		}
+		ew.buf = ew.buf[chunkSize:]
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) flushChunk(chunk []byte) error {
+	nonce := make([]byte, 12)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertextAndTag := ew.aead.Seal(nil, nonce, chunk, nil)
+	length := uint32(len(nonce) + len(ciphertextAndTag))
+
+	lenBuf := make([]byte, 4)
+	binary.BigEndian.PutUint32(lenBuf, length)
+
+	if _, err := ew.w.Write(lenBuf); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(ciphertextAndTag); err != nil {
+		return err
+	}
+
+	ew.mac.Write(lenBuf)
+	ew.mac.Write(nonce)
+	ew.mac.Write(ciphertextAndTag)
+
+	return nil
+}
+
+func (ew *encryptWriter) Close() error {
+	ew.mu.Lock()
+	defer ew.mu.Unlock()
+
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.writeHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = nil
+	}
+
+	sentinel := []byte{0x00, 0x00, 0x00, 0x00}
+	if _, err := ew.w.Write(sentinel); err != nil {
+		return err
+	}
+
+	hmacSum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(hmacSum); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	decrypted   *bytes.Reader
+	initialized bool
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("key length %d is invalid: %w", len(key), ErrInvalidKey)
+	}
+	keyCopy := make([]byte, 32)
+	copy(keyCopy, key)
+	return &decryptReader{
+		r:   r,
+		key: keyCopy,
+	}, nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			return 0, err
+		}
+	}
+	return dr.decrypted.Read(p)
+}
+
+func (dr *decryptReader) init() error {
+	dr.initialized = true
+
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return fmt.Errorf("failed to create cipher: %w", err)
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	header := make([]byte, 3)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return errors.New("truncated data: missing header")
+		}
+		return fmt.Errorf("failed to read header: %w", err)
+	}
+
+	if header[0] != 0x4F || header[1] != 0x44 {
+		return fmt.Errorf("invalid header magic: %x%x", header[0], header[1])
+	}
+	if header[2] != 0x01 {
+		return fmt.Errorf("unsupported version: %d", header[2])
+	}
+
+	mac := hmac.New(sha256.New, dr.key)
+	var plaintextBuf bytes.Buffer
+
+	for {
+		lenBuf := make([]byte, 4)
+		_, err := io.ReadFull(dr.r, lenBuf)
+		if err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return errors.New("truncated data: missing length prefix or sentinel")
+			}
+			return fmt.Errorf("failed to read chunk length: %w", err)
+		}
+
+		length := binary.BigEndian.Uint32(lenBuf)
+		if length == 0 {
+			break
+		}
+
+		if length < 28 {
+			return errors.New("truncated data: invalid chunk length")
+		}
+
+		chunkData := make([]byte, length)
+		if _, err := io.ReadFull(dr.r, chunkData); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return errors.New("truncated data: incomplete chunk")
+			}
+			return fmt.Errorf("failed to read chunk: %w", err)
+		}
+
+		mac.Write(lenBuf)
+		mac.Write(chunkData)
+
+		nonce := chunkData[:12]
+		ciphertextAndTag := chunkData[12:]
+
+		plaintextChunk, err := aead.Open(nil, nonce, ciphertextAndTag, nil)
+		if err != nil {
+			return fmt.Errorf("failed to decrypt chunk (wrong key or corrupt data): %w", err)
+		}
+
+		plaintextBuf.Write(plaintextChunk)
+	}
+
+	expectedHMAC := make([]byte, 32)
+	if _, err := io.ReadFull(dr.r, expectedHMAC); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return errors.New("truncated data: missing HMAC")
+		}
+		return fmt.Errorf("failed to read HMAC: %w", err)
+	}
+
+	calculatedHMAC := mac.Sum(nil)
+	if !hmac.Equal(calculatedHMAC, expectedHMAC) {
+		return errors.New("integrity check failed: HMAC mismatch")
+	}
+
+	dr.decrypted = bytes.NewReader(plaintextBuf.Bytes())
+	return nil
+}
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"key-source"`
+	KeyEnvVar  string `yaml:"key-env-var"`
+	KeyFile    string `yaml:"key-file"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (cfg Config) Validate() error {
+	if !cfg.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when enabled")
+	}
+
+	switch source {
+	case "env":
+		if cfg.KeyFile != "" || cfg.Key != "" || cfg.Passphrase != "" || cfg.Salt != "" {
+			return errors.New("fields key-file, key, passphrase, salt are mutually exclusive with env key source")
+		}
+		if strings.TrimSpace(cfg.KeyEnvVar) == "" {
+			return errors.New("key-env-var is required for env key source")
+		}
+	case "file":
+		if cfg.KeyEnvVar != "" || cfg.Key != "" || cfg.Passphrase != "" || cfg.Salt != "" {
+			return errors.New("fields key-env-var, key, passphrase, salt are mutually exclusive with file key source")
+		}
+		if strings.TrimSpace(cfg.KeyFile) == "" {
+			return errors.New("key-file is required for file key source")
+		}
+	case "literal":
+		if cfg.KeyEnvVar != "" || cfg.KeyFile != "" || cfg.Passphrase != "" || cfg.Salt != "" {
+			return errors.New("fields key-env-var, key-file, passphrase, salt are mutually exclusive with literal key source")
+		}
+		if strings.TrimSpace(cfg.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+	case "derive":
+		if cfg.KeyEnvVar != "" || cfg.KeyFile != "" || cfg.Key != "" {
+			return errors.New("fields key-env-var, key-file, key are mutually exclusive with derive key source")
+		}
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return errors.New("passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(cfg.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+	default:
+		return fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	if b, err := base64.StdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.RawStdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.URLEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	return base64.RawURLEncoding.DecodeString(s)
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		if cfg.KeyEnvVar == "" {
+			return nil, errors.New("encryption key env var name is required")
+		}
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || val == "" {
+			return nil, fmt.Errorf("encryption key environment variable %s is unset or empty", cfg.KeyEnvVar)
+		}
+		keyBytes, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode encryption key from env var %s: %w", cfg.KeyEnvVar, err)
+		}
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("encryption key from env var %s must be 32 bytes, got %d: %w", cfg.KeyEnvVar, len(keyBytes), ErrInvalidKey)
+		}
+		return keyBytes, nil
+
+	case "file":
+		if cfg.KeyFile == "" {
+			return nil, errors.New("encryption key file path is required")
+		}
+		data, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %s: %w", cfg.KeyFile, err)
+		}
+		keyBytes, err := decodeBase64(string(data))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode encryption key from file %s: %w", cfg.KeyFile, err)
+		}
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("encryption key from file %s must be 32 bytes, got %d: %w", cfg.KeyFile, len(keyBytes), ErrInvalidKey)
+		}
+		return keyBytes, nil
+
+	case "literal":
+		if cfg.Key == "" {
+			return nil, errors.New("literal encryption key is required")
+		}
+		keyBytes, err := decodeBase64(cfg.Key)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode literal encryption key: %w", err)
+		}
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("literal encryption key must be 32 bytes, got %d: %w", len(keyBytes), ErrInvalidKey)
+		}
+		return keyBytes, nil
+
+	case "derive":
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("passphrase cannot be empty for encryption key derivation")
+		}
+		saltBytes, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode salt for encryption key derivation: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, fmt.Errorf("encryption key salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+		keyBytes := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, 10000, 32, sha256.New)
+		return keyBytes, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..fbea2b3
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,340 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptor(t *testing.T) {
+	validKey := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, validKey)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(validKey)
+	assert.NoError(t, err)
+	assert.NotNil(t, enc)
+
+	// Short key
+	shortKey := make([]byte, 16)
+	_, err = NewEncryptor(shortKey)
+	assert.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	// Long key
+	longKey := make([]byte, 64)
+	_, err = NewEncryptor(longKey)
+	assert.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	// Nil key
+	_, err = NewEncryptor(nil)
+	assert.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+}
+
+func TestEncryptWriterDecryptReaderRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		size int
+	}{
+		{"Empty", 0},
+		{"Small", 100},
+		{"SingleChunkMax", 64 * 1024},
+		{"MultiChunkExact", 128 * 1024},
+		{"MultiChunkPartial", 150 * 1024},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			plaintext := make([]byte, tc.size)
+			if tc.size > 0 {
+				_, err := io.ReadFull(rand.Reader, plaintext)
+				require.NoError(t, err)
+			}
+
+			enc, err := NewEncryptor(key)
+			require.NoError(t, err)
+
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+
+			n, err := ew.Write(plaintext)
+			require.NoError(t, err)
+			assert.Equal(t, tc.size, n)
+
+			err = ew.Close()
+			require.NoError(t, err)
+
+			// Verify header magic and version
+			ciphertext := buf.Bytes()
+			require.GreaterOrEqual(t, len(ciphertext), 3+4+32) // header(3) + sentinel(4) + hmac(32)
+			assert.Equal(t, byte(0x4F), ciphertext[0])
+			assert.Equal(t, byte(0x44), ciphertext[1])
+			assert.Equal(t, byte(0x01), ciphertext[2])
+
+			// Decrypt
+			dr, err := DecryptReader(bytes.NewReader(ciphertext), key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, plaintext, decrypted)
+		})
+	}
+}
+
+func TestTwoEncryptionsDiffer(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	plaintext := []byte("Hello, world! This is a test for unique encryption outputs.")
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+}
+
+func TestEncryptWriterCloseIdempotent(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("test data"))
+	require.NoError(t, err)
+
+	err1 := ew.Close()
+	require.NoError(t, err1)
+	len1 := buf.Len()
+
+	err2 := ew.Close()
+	require.NoError(t, err2)
+	len2 := buf.Len()
+
+	assert.Equal(t, len1, len2)
+}
+
+func TestDecryptReaderErrors(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("sensitive data"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+
+	originalData := buf.Bytes()
+
+	t.Run("InvalidHeader", func(t *testing.T) {
+		badHeader := make([]byte, len(originalData))
+		copy(badHeader, originalData)
+		badHeader[0] = 0x00 // bad magic
+
+		dr, err := DecryptReader(bytes.NewReader(badHeader), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid header")
+	})
+
+	t.Run("UnsupportedVersion", func(t *testing.T) {
+		badVersion := make([]byte, len(originalData))
+		copy(badVersion, originalData)
+		badVersion[2] = 0x02 // unsupported version
+
+		dr, err := DecryptReader(bytes.NewReader(badVersion), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported version")
+	})
+
+	t.Run("HMACMismatchIntegrity", func(t *testing.T) {
+		tampered := make([]byte, len(originalData))
+		copy(tampered, originalData)
+		// Tamper with the HMAC at the end
+		tampered[len(tampered)-1] ^= 0xFF
+
+		dr, err := DecryptReader(bytes.NewReader(tampered), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "integrity")
+	})
+
+	t.Run("WrongKey", func(t *testing.T) {
+		wrongKey := make([]byte, 32)
+		wrongKey[0] = key[0] ^ 0xFF
+
+		dr, err := DecryptReader(bytes.NewReader(originalData), wrongKey)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("TruncatedDataHeader", func(t *testing.T) {
+		dr, err := DecryptReader(bytes.NewReader(originalData[:2]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("TruncatedDataBody", func(t *testing.T) {
+		dr, err := DecryptReader(bytes.NewReader(originalData[:len(originalData)-10]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+}
