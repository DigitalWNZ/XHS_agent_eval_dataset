+func TestLoadKey(t *testing.T) {
+	validKey32 := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, validKey32)
+	require.NoError(t, err)
+	validKeyBase64 := base64.StdEncoding.EncodeToString(validKey32)
+
+	t.Run("env", func(t *testing.T) {
+		os.Setenv("TEST_ENC_KEY", validKeyBase64)
+		defer os.Unsetenv("TEST_ENC_KEY")
+
+		cfg := Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_ENC_KEY"}
+		key, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, validKey32, key)
+
+		// Unset env var
+		cfgUnset := Config{Enabled: true, KeySource: "env", KeyEnvVar: "UNSET_ENC_KEY"}
+		_, err = LoadKey(cfgUnset)
+		require.Error(t, err)
+		// Must contain "encryption" or "key"
+		errMsg := strings.ToLower(err.Error())
+		assert.True(t, strings.Contains(errMsg, "encryption") || strings.Contains(errMsg, "key"))
+	})
+
+	t.Run("file", func(t *testing.T) {
+		tmpDir := t.TempDir()
+		keyFile := filepath.Join(tmpDir, "key.txt")
+		err := os.WriteFile(keyFile, []byte(validKeyBase64+"\n"), 0600)
+		require.NoError(t, err)
+
+		cfg := Config{Enabled: true, KeySource: "file", KeyFile: keyFile}
+		key, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, validKey32, key)
+	})
+
+	t.Run("literal", func(t *testing.T) {
+		cfg := Config{Enabled: true, KeySource: "literal", Key: validKeyBase64}
+		key, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, validKey32, key)
+	})
+
+	t.Run("derive", func(t *testing.T) {
+		salt := make([]byte, 16)
+		_, err := io.ReadFull(rand.Reader, salt)
+		require.NoError(t, err)
+		saltBase64 := base64.StdEncoding.EncodeToString(salt)
+
+		cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "my-passphrase", Salt: saltBase64}
+		key1, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Len(t, key1, 32)
+
+		// Deterministic
+		key2, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, key1, key2)
+
+		// Short salt error
+		shortSalt := base64.StdEncoding.EncodeToString([]byte("short"))
+		cfgShortSalt := Config{Enabled: true, KeySource: "derive", Passphrase: "my-passphrase", Salt: shortSalt}
+		_, err = LoadKey(cfgShortSalt)
+		require.Error(t, err)
+
+		// Empty passphrase error
+		cfgEmptyPass := Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: saltBase64}
+		_, err = LoadKey(cfgEmptyPass)
+		require.Error(t, err)
+	})
+}
