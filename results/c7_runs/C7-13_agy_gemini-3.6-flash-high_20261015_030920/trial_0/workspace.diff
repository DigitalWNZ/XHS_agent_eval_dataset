+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	disabledCfg := Config{Enabled: false}
+	assert.NoError(t, disabledCfg.Validate())
+
+	// Enabled with empty source
+	emptySourceCfg := Config{Enabled: true}
+	assert.Error(t, emptySourceCfg.Validate())
+
+	// Enabled with unsupported source
+	unsupportedSourceCfg := Config{Enabled: true, KeySource: "invalid"}
+	assert.Error(t, unsupportedSourceCfg.Validate())
+
+	// env source - valid
+	validEnv := Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, validEnv.Validate())
+
+	// env source - case insensitive
+	validEnvUpper := Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, validEnvUpper.Validate())
+
+	// env source - mutually exclusive
+	mutuallyExclusiveEnv := Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", KeyFile: "some/file"}
+	err := mutuallyExclusiveEnv.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// file source - valid
+	validFile := Config{Enabled: true, KeySource: "file", KeyFile: "path/to/key"}
+	assert.NoError(t, validFile.Validate())
+
+	// literal source - valid
+	validLiteral := Config{Enabled: true, KeySource: "literal", Key: "base64key"}
+	assert.NoError(t, validLiteral.Validate())
+
+	// derive source - valid
+	validDerive := Config{Enabled: true, KeySource: "derive", Passphrase: "secretpassphrase", Salt: "base64salt123456"}
+	assert.NoError(t, validDerive.Validate())
+
+	// derive source - missing salt
+	missingSaltDerive := Config{Enabled: true, KeySource: "derive", Passphrase: "secretpassphrase"}
+	assert.Error(t, missingSaltDerive.Validate())
+}
