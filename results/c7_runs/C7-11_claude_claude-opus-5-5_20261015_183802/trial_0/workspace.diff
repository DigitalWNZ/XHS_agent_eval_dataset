+func TestShapeIndexEncodeRemovedAfterBuild(t *testing.T) {
+	index := NewShapeIndex()
+	a := makePolyline("0:0, 1:1")
+	b := makePolyline("0:0, 1:1")
+	index.Add(a)
+	index.Add(b)
+	index.Build()
+	index.Remove(b)
+
+	got := roundTripShapeIndex(t, index)
+	if got.Shape(0) == nil || got.Shape(1) != nil {
+		t.Fatalf("shape IDs not preserved")
+	}
+	for it := got.Iterator(); !it.Done(); it.Next() {
+		for _, c := range it.IndexCell().shapes {
+			if got.Shape(c.shapeID) == nil {
+				t.Errorf("cell %v references removed shape %d", it.CellID(), c.shapeID)
+			}
+		}
+	}
