+
+// The ShapeIndex encoding stores both the shapes (keyed by their shape IDs)
+// and the complete cell structure of the index, so that a decoded index can
+// be queried and iterated immediately without having to be rebuilt.
+//
+// The layout is:
+//
+//	int8     version
+//	uvarint  maxEdgesPerCell
+//	uvarint  nextID
+//	uvarint  number of shapes
+//	  per shape (in increasing shape ID order):
+//	    uvarint  shape ID
+//	    uvarint  shape tag
+//	    ...      shape specific payload
+//	uvarint  number of cells
+//	  per cell (in increasing CellID order):
+//	    uint64   CellID
+//	    uvarint  number of clipped shapes
+//	      per clipped shape (in increasing shape ID order):
+//	        uvarint  shape ID
+//	        bool     containsCenter
+//	        uvarint  number of edges
+//	        uvarint  edge IDs, delta encoded
+//
+// This is a Go specific format and is not compatible with the C++
+// EncodedS2ShapeIndex encoding.
+
+const shapeIndexEncodingVersion = int8(1)
+
+// Shape tags used within the ShapeIndex encoding. The publicly defined
+// shape type tags are reused where they exist.
+const (
+	shapeIndexTagPolygon     = uint64(typeTagPolygon)
+	shapeIndexTagPolyline    = uint64(typeTagPolyline)
+	shapeIndexTagPointVector = uint64(typeTagPointVector)
+	shapeIndexTagLaxPolyline = uint64(typeTagLaxPolyline)
+	shapeIndexTagLaxPolygon  = uint64(typeTagLaxPolygon)
+	shapeIndexTagLoop        = uint64(6)
+	shapeIndexTagLaxLoop     = uint64(7)
+	// shapeIndexTagGeneric is used for any other Shape implementation. The
+	// shape is stored as its raw edges, chains, dimension, and reference
+	// point, and decodes as a generic Shape with identical behavior.
+	shapeIndexTagGeneric = uint64(8)
+)
+
+const (
+	// maxEncodedShapes guards allocations when decoding the number of shapes.
+	maxEncodedShapes = math.MaxInt32
+	// maxEncodedEdges guards the number of edges or chains in a single shape.
+	maxEncodedEdges = maxEncodedVertices
+	// maxEncodedCells guards the number of cells in an index.
+	maxEncodedCells = 1 << 31
+	// maxDecodePrealloc caps how many elements are allocated up front based
+	// on an untrusted count. Larger slices are grown as data is actually read,
+	// so truncated or corrupted input cannot force huge allocations.
+	maxDecodePrealloc = 1024
+)
+
+// Encode encodes the ShapeIndex, including all of its shapes and its cell
+// structure. Any pending updates are applied before encoding.
+//
+// All shapes defined in this package are supported.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	s.maybeApplyUpdates()
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	ids := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		e.writeUvarint(uint64(id))
+		encodeIndexShape(e, s.shapes[id])
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, id := range s.cells {
+		cell := s.cellMap[id]
+		e.writeUint64(uint64(id))
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		// Skip clipped shapes whose shape has since been removed from the
+		// index, so that every encoded reference points at an encoded shape.
+		live := 0
+		for _, c := range cell.shapes {
+			if s.shapes[c.shapeID] != nil {
+				live++
+			}
+		}
+		e.writeUvarint(uint64(live))
+		for _, c := range cell.shapes {
+			if s.shapes[c.shapeID] == nil {
+				continue
+			}
+			e.writeUvarint(uint64(c.shapeID))
+			e.writeBool(c.containsCenter)
+			e.writeUvarint(uint64(len(c.edges)))
+			prev := 0
+			for _, edge := range c.edges {
+				e.writeUvarint(uint64(edge - prev))
+				prev = edge
+			}
+		}
+	}
+}
+
+// Decode decodes a ShapeIndex previously written by Encode, replacing the
+// current contents of s. The decoded index is fully built: shape IDs are
+// preserved and the cell structure is restored, so no call to Build is needed.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	return s.decode(&decoder{r: asByteReader(r)})
+}
+
+func (s *ShapeIndex) decode(d *decoder) error {
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return decodeErr(d.err)
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("s2: cannot decode ShapeIndex version %d", version)
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	nextID := d.readUvarint()
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return decodeErr(d.err)
+	}
+	if maxEdgesPerCell > math.MaxInt32 {
+		return fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+	if nextID > maxEncodedShapes {
+		return fmt.Errorf("s2: invalid next shape ID %d", nextID)
+	}
+	if numShapes > nextID {
+		return fmt.Errorf("s2: number of shapes (%d) exceeds next shape ID (%d)", numShapes, nextID)
+	}
+
+	shapes := make(map[int32]Shape, min(numShapes, maxDecodePrealloc))
+	prevID := int64(-1)
+	for range numShapes {
+		id := d.readUvarint()
+		if d.err != nil {
+			return decodeErr(d.err)
+		}
+		if int64(id) <= prevID || id >= nextID {
+			return fmt.Errorf("s2: invalid or out of order shape ID %d", id)
+		}
+		prevID = int64(id)
+		shape, err := decodeIndexShape(d)
+		if err != nil {
+			return err
+		}
+		shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return decodeErr(d.err)
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("s2: too many cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+	cells := make([]CellID, 0, min(numCells, maxDecodePrealloc))
+	cellMap := make(map[CellID]*ShapeIndexCell, min(numCells, maxDecodePrealloc))
+	for range numCells {
+		id := CellID(d.readUint64())
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return decodeErr(d.err)
+		}
+		if !id.IsValid() {
+			return fmt.Errorf("s2: invalid CellID %v in ShapeIndex", uint64(id))
+		}
+		if n := len(cells); n > 0 && cells[n-1].RangeMax() >= id.RangeMin() {
+			return fmt.Errorf("s2: CellID %v is out of order or overlaps the previous cell", id)
+		}
+		if numClipped > numShapes {
+			return fmt.Errorf("s2: cell %v has too many shapes (%d)", id, numClipped)
+		}
+
+		cell := &ShapeIndexCell{shapes: make([]*clippedShape, 0, min(numClipped, maxDecodePrealloc))}
+		prevShape := int64(-1)
+		for range numClipped {
+			shapeID := d.readUvarint()
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return decodeErr(d.err)
+			}
+			if int64(shapeID) <= prevShape || shapeID >= nextID {
+				return fmt.Errorf("s2: invalid or out of order shape ID %d in cell %v", shapeID, id)
+			}
+			prevShape = int64(shapeID)
+			shape, ok := shapes[int32(shapeID)]
+			if !ok {
+				return fmt.Errorf("s2: cell %v references missing shape %d", id, shapeID)
+			}
+			shapeEdges := uint64(shape.NumEdges())
+			if numEdges > shapeEdges {
+				return fmt.Errorf("s2: cell %v has %d edges for shape %d with %d edges", id, numEdges, shapeID, shapeEdges)
+			}
+
+			c := &clippedShape{
+				shapeID:        int32(shapeID),
+				containsCenter: containsCenter,
+				edges:          make([]int, numEdges),
+			}
+			var edge uint64
+			for i := range c.edges {
+				delta := d.readUvarint()
+				if d.err != nil {
+					return decodeErr(d.err)
+				}
+				if i > 0 && delta == 0 {
+					return fmt.Errorf("s2: duplicate edge in cell %v for shape %d", id, shapeID)
+				}
+				if delta >= shapeEdges || edge+delta >= shapeEdges {
+					return fmt.Errorf("s2: edge ID out of range in cell %v for shape %d", id, shapeID)
+				}
+				edge += delta
+				c.edges[i] = int(edge)
+			}
+			cell.shapes = append(cell.shapes, c)
+		}
+		cells = append(cells, id)
+		cellMap[id] = cell
+	}
+
+	if len(cells) == 0 {
+		cells = nil
+	}
+
+	s.mu.Lock()
+	s.shapes = shapes
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+	return nil
+}
+
+// decodeErr converts an end of input error into an unexpected EOF, since a
+// valid encoding never ends early.
+func decodeErr(err error) error {
+	if errors.Is(err, io.EOF) {
+		return io.ErrUnexpectedEOF
+	}
+	return err
+}
+
+// encodeIndexShape writes the tag and payload of the given shape.
+func encodeIndexShape(e *encoder, shape Shape) {
+	switch sh := shape.(type) {
+	case *Polygon:
+		e.writeUvarint(shapeIndexTagPolygon)
+		e.writeBool(sh.hasHoles)
+		e.writeUvarint(uint64(len(sh.loops)))
+		for _, l := range sh.loops {
+			encodeIndexLoop(e, l)
+		}
+		encodeIndexRect(e, sh.bound)
+	case *Loop:
+		e.writeUvarint(shapeIndexTagLoop)
+		encodeIndexLoop(e, sh)
+	case *Polyline:
+		e.writeUvarint(shapeIndexTagPolyline)
+		encodeIndexPoints(e, *sh)
+	case *PointVector:
+		e.writeUvarint(shapeIndexTagPointVector)
+		encodeIndexPoints(e, *sh)
+	case *LaxPolyline:
+		e.writeUvarint(shapeIndexTagLaxPolyline)
+		encodeIndexPoints(e, sh.vertices)
+	case *LaxLoop:
+		e.writeUvarint(shapeIndexTagLaxLoop)
+		encodeIndexPoints(e, sh.vertices[:sh.numVertices])
+	case *LaxPolygon:
+		e.writeUvarint(shapeIndexTagLaxPolygon)
+		e.writeUvarint(uint64(sh.numLoops))
+		for i := 0; i < sh.numLoops; i++ {
+			n := sh.numLoopVertices(i)
+			e.writeUvarint(uint64(n))
+			for j := 0; j < n; j++ {
+				encodeIndexPoint(e, sh.loopVertex(i, j))
+			}
+		}
+	default:
+		e.writeUvarint(shapeIndexTagGeneric)
+		e.writeUvarint(uint64(shape.Dimension()))
+		ref := shape.ReferencePoint()
+		encodeIndexPoint(e, ref.Point)
+		e.writeBool(ref.Contained)
+		numEdges := shape.NumEdges()
+		e.writeUvarint(uint64(numEdges))
+		for i := range numEdges {
+			edge := shape.Edge(i)
+			encodeIndexPoint(e, edge.V0)
+			encodeIndexPoint(e, edge.V1)
+		}
+		numChains := shape.NumChains()
+		e.writeUvarint(uint64(numChains))
+		for i := range numChains {
+			c := shape.Chain(i)
+			e.writeUvarint(uint64(c.Start))
+			e.writeUvarint(uint64(c.Length))
+		}
+	}
+}
+
+// decodeIndexShape reads a shape written by encodeIndexShape.
+func decodeIndexShape(d *decoder) (Shape, error) {
+	tag := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	switch tag {
+	case shapeIndexTagPolygon:
+		p := &Polygon{}
+		p.hasHoles = d.readBool()
+		numLoops, err := readCount(d, maxEncodedLoops, "loops")
+		if err != nil {
+			return nil, err
+		}
+		p.loops = make([]*Loop, 0, min(numLoops, maxDecodePrealloc))
+		for range numLoops {
+			l, err := decodeIndexLoop(d)
+			if err != nil {
+				return nil, err
+			}
+			p.loops = append(p.loops, l)
+			p.numVertices += len(l.vertices)
+		}
+		if p.bound, err = decodeIndexRect(d); err != nil {
+			return nil, err
+		}
+		p.subregionBound = ExpandForSubregions(p.bound)
+		p.initEdgesAndIndex()
+		return p, nil
+	case shapeIndexTagLoop:
+		return decodeIndexLoop(d)
+	case shapeIndexTagPolyline:
+		pts, err := decodeIndexPoints(d)
+		if err != nil {
+			return nil, err
+		}
+		p := Polyline(pts)
+		return &p, nil
+	case shapeIndexTagPointVector:
+		pts, err := decodeIndexPoints(d)
+		if err != nil {
+			return nil, err
+		}
+		p := PointVector(pts)
+		return &p, nil
+	case shapeIndexTagLaxPolyline:
+		pts, err := decodeIndexPoints(d)
+		if err != nil {
+			return nil, err
+		}
+		return &LaxPolyline{vertices: pts}, nil
+	case shapeIndexTagLaxLoop:
+		pts, err := decodeIndexPoints(d)
+		if err != nil {
+			return nil, err
+		}
+		return &LaxLoop{numVertices: len(pts), vertices: pts}, nil
+	case shapeIndexTagLaxPolygon:
+		numLoops, err := readCount(d, maxEncodedLoops, "loops")
+		if err != nil {
+			return nil, err
+		}
+		loops := make([][]Point, 0, min(numLoops, maxDecodePrealloc))
+		total := 0
+		for range numLoops {
+			pts, err := decodeIndexPoints(d)
+			if err != nil {
+				return nil, err
+			}
+			if total += len(pts); total > maxEncodedVertices {
+				return nil, fmt.Errorf("s2: too many vertices (max is %d)", maxEncodedVertices)
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops), nil
+	case shapeIndexTagGeneric:
+		return decodeGenericShape(d)
+	default:
+		return nil, fmt.Errorf("s2: unknown shape tag %d", tag)
+	}
+}
+
+// readCount reads a count and verifies it does not exceed limit.
+func readCount(d *decoder, limit uint64, what string) (uint64, error) {
+	n := d.readUvarint()
+	if d.err != nil {
+		return 0, decodeErr(d.err)
+	}
+	if n > limit {
+		return 0, fmt.Errorf("s2: too many %s (%d; max is %d)", what, n, limit)
+	}
+	return n, nil
+}
+
+func encodeIndexPoint(e *encoder, p Point) {
+	e.writeFloat64(p.X)
+	e.writeFloat64(p.Y)
+	e.writeFloat64(p.Z)
+}
+
+func encodeIndexPoints(e *encoder, pts []Point) {
+	e.writeUvarint(uint64(len(pts)))
+	for _, p := range pts {
+		encodeIndexPoint(e, p)
+	}
+}
+
+func decodeIndexPoint(d *decoder) (Point, error) {
+	var p Point
+	p.X = d.readFloat64()
+	p.Y = d.readFloat64()
+	p.Z = d.readFloat64()
+	return p, decodeErr(d.err)
+}
+
+func decodeIndexPoints(d *decoder) ([]Point, error) {
+	n, err := readCount(d, maxEncodedVertices, "vertices")
+	if err != nil {
+		return nil, err
+	}
+	pts := make([]Point, 0, min(n, maxDecodePrealloc))
+	for range n {
+		p, err := decodeIndexPoint(d)
+		if err != nil {
+			return nil, err
+		}
+		pts = append(pts, p)
+	}
+	return pts, nil
+}
+
+func encodeIndexRect(e *encoder, r Rect) {
+	e.writeFloat64(r.Lat.Lo)
+	e.writeFloat64(r.Lat.Hi)
+	e.writeFloat64(r.Lng.Lo)
+	e.writeFloat64(r.Lng.Hi)
+}
+
+func decodeIndexRect(d *decoder) (Rect, error) {
+	var r Rect
+	r.Lat.Lo = d.readFloat64()
+	r.Lat.Hi = d.readFloat64()
+	r.Lng.Lo = d.readFloat64()
+	r.Lng.Hi = d.readFloat64()
+	return r, decodeErr(d.err)
+}
+
+func encodeIndexLoop(e *encoder, l *Loop) {
+	encodeIndexPoints(e, l.vertices)
+	e.writeBool(l.originInside)
+	e.writeUvarint(uint64(l.depth))
+	encodeIndexRect(e, l.bound)
+}
+
+func decodeIndexLoop(d *decoder) (*Loop, error) {
+	pts, err := decodeIndexPoints(d)
+	if err != nil {
+		return nil, err
+	}
+	l := &Loop{vertices: pts}
+	l.originInside = d.readBool()
+	depth := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if depth > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid loop depth %d", depth)
+	}
+	l.depth = int(depth)
+	if l.bound, err = decodeIndexRect(d); err != nil {
+		return nil, err
+	}
+	l.subregionBound = ExpandForSubregions(l.bound)
+	l.index = NewShapeIndex()
+	l.index.Add(l)
+	return l, nil
+}
+
+func decodeGenericShape(d *decoder) (Shape, error) {
+	dim := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if dim > 2 {
+		return nil, fmt.Errorf("s2: invalid shape dimension %d", dim)
+	}
+	g := &genericShape{dimension: int(dim)}
+	p, err := decodeIndexPoint(d)
+	if err != nil {
+		return nil, err
+	}
+	g.ref = ReferencePoint{Point: p, Contained: d.readBool()}
+
+	numEdges, err := readCount(d, maxEncodedEdges, "edges")
+	if err != nil {
+		return nil, err
+	}
+	g.edges = make([]Edge, 0, min(numEdges, maxDecodePrealloc))
+	for range numEdges {
+		v0, err := decodeIndexPoint(d)
+		if err != nil {
+			return nil, err
+		}
+		v1, err := decodeIndexPoint(d)
+		if err != nil {
+			return nil, err
+		}
+		g.edges = append(g.edges, Edge{v0, v1})
+	}
+
+	numChains, err := readCount(d, maxEncodedEdges, "chains")
+	if err != nil {
+		return nil, err
+	}
+	g.chains = make([]Chain, 0, min(numChains, maxDecodePrealloc))
+	next := uint64(0)
+	for range numChains {
+		start := d.readUvarint()
+		length := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		if start != next || length > numEdges-start {
+			return nil, fmt.Errorf("s2: invalid chain (start %d, length %d)", start, length)
+		}
+		next = start + length
+		g.chains = append(g.chains, Chain{Start: int(start), Length: int(length)})
+	}
+	if next != numEdges {
+		return nil, fmt.Errorf("s2: chains cover %d of %d edges", next, numEdges)
+	}
+	return g, nil
+}
+
+// genericShape is a Shape that stores its edges and chains explicitly. It is
+// used to decode shapes that do not have a dedicated encoding.
+type genericShape struct {
+	edges     []Edge
+	chains    []Chain
+	dimension int
+	ref       ReferencePoint
+}
+
+func (g *genericShape) NumEdges() int                  { return len(g.edges) }
+func (g *genericShape) Edge(e int) Edge                { return g.edges[e] }
+func (g *genericShape) ReferencePoint() ReferencePoint { return g.ref }
+func (g *genericShape) NumChains() int                 { return len(g.chains) }
+func (g *genericShape) Chain(i int) Chain              { return g.chains[i] }
+func (g *genericShape) ChainEdge(i, j int) Edge        { return g.edges[g.chains[i].Start+j] }
+func (g *genericShape) ChainPosition(e int) ChainPosition {
+	// Find the first chain that starts after e, the chain before it contains e.
+	i := sort.Search(len(g.chains), func(i int) bool { return g.chains[i].Start > e }) - 1
+	return ChainPosition{i, e - g.chains[i].Start}
+}
+func (g *genericShape) Dimension() int    { return g.dimension }
+func (g *genericShape) IsEmpty() bool     { return defaultShapeIsEmpty(g) }
+func (g *genericShape) IsFull() bool      { return defaultShapeIsFull(g) }
+func (g *genericShape) typeTag() typeTag  { return typeTagNone }
+func (g *genericShape) privateInterface() {}
