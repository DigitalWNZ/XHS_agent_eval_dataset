+func TestShapeIndexEncodeWithoutBuild(t *testing.T) {
+	index := NewShapeIndex()
+	for i := 0; i < 20; i++ {
+		index.Add(RegularLoop(randomPoint(), s1.Degree*10, 50))
+	}
+	// Encode before any explicit Build.
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	got := NewShapeIndex()
+	if err := got.Decode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	checkShapeIndexEqual(t, got, index)
+	if len(got.cells) == 0 {
+		t.Errorf("decoded index has no cells")
+	}
+}
