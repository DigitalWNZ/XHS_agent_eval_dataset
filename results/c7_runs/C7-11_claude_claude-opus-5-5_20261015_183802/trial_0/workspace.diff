+func TestShapeIndexDecodeTruncated(t *testing.T) {
+	data := encodedTestIndex(t)
+	for i := 0; i < len(data); i++ {
+		if err := NewShapeIndex().Decode(bytes.NewReader(data[:i])); err == nil {
+			t.Errorf("Decode of %d/%d bytes succeeded", i, len(data))
+		}
+	}
+}
+
+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	data := encodedTestIndex(t)
+	for i := range data {
+		for _, v := range []byte{0x00, 0xff, data[i] ^ 0x01, data[i] ^ 0x80} {
+			c := append([]byte(nil), data...)
+			c[i] = v
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						t.Fatalf("Decode panicked with byte %d = %#x: %v", i, v, r)
+					}
+				}()
+				index := NewShapeIndex()
+				if index.Decode(bytes.NewReader(c)) == nil {
+					// If decoding succeeds the result must be usable.
+					for it := index.Iterator(); !it.Done(); it.Next() {
+					}
+				}
+			}()
+		}
+	}
+}
