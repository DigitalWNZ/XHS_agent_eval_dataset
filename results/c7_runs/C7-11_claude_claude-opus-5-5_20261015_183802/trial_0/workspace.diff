+func TestShapeIndexEncodeAllShapeTypes(t *testing.T) {
+	pv := PointVector(parsePoints("0:0 | 1:1 | 2:2"))
+	evs := &edgeVectorShape{}
+	evs.Add(parsePoint("5:5"), parsePoint("6:6"))
+	evs.Add(parsePoint("7:7"), parsePoint("8:8"))
+
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 8:2, 8:8, 2:8", true))
+	index.Add(makeLoop("20:20, 20:30, 30:30"))
+	index.Add(makePolyline("-10:-10, -20:-20, -30:-10"))
+	index.Add(&pv)
+	index.Add(makeLaxPolyline("40:40, 50:50, 40:60"))
+	index.Add(LaxLoopFromPoints(parsePoints("-40:-40, -40:-50, -50:-50")))
+	index.Add(makeLaxPolygon("60:60, 60:70, 70:70; 62:62, 64:62, 64:64; ; 65:65"))
+	index.Add(evs)
+	index.Add(FullPolygon())
+	index.Add(PolygonFromLoops([]*Loop{EmptyLoop()}))
+	index.Add(RegularLoop(PointFromCoords(1, 1, 1), s1.Degree*5, 200))
+	index.Build()
+
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, got, index)
+
+	for i, want := range []Shape{index.Shape(0), index.Shape(1), index.Shape(2), index.Shape(3),
+		index.Shape(4), index.Shape(5), index.Shape(6)} {
+		if reflect.TypeOf(got.Shape(int32(i))) != reflect.TypeOf(want) {
+			t.Errorf("shape %d type = %T, want %T", i, got.Shape(int32(i)), want)
+		}
+	}
+
+	// Queries must work without rebuilding.
+	q := NewContainsPointQuery(got, VertexModelSemiOpen)
+	if !q.Contains(parsePoint("1:1")) {
+		t.Errorf("Contains(1:1) = false, want true")
+	}
+	wantQ := NewContainsPointQuery(index, VertexModelSemiOpen)
+	for _, p := range parsePoints("1:1 | 5:5 | 25:27 | 63:63 | -80:10") {
+		if g, w := q.ContainingShapes(p), wantQ.ContainingShapes(p); len(g) != len(w) {
+			t.Errorf("ContainingShapes(%v) = %d shapes, want %d", p, len(g), len(w))
+		}
+	}
+}
