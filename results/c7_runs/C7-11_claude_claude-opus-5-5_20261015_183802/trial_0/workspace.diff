+func TestShapeIndexEncodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, got, index)
+	if it := got.Iterator(); !it.Done() {
+		t.Errorf("iterator of empty decoded index is not done")
+	}
+}
