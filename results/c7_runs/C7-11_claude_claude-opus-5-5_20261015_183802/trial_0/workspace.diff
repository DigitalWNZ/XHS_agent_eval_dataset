+func TestShapeIndexDecodeOversized(t *testing.T) {
+	huge := binary.AppendUvarint(nil, 1<<62)
+	tests := map[string][]byte{
+		"empty":    {},
+		"version":  {99},
+		"nextID":   append([]byte{1, 10}, huge...),
+		"numShape": append([]byte{1, 10, 5}, huge...),
+		// One polyline shape claiming an enormous number of vertices.
+		"vertices": append([]byte{1, 10, 1, 1, 0, byte(shapeIndexTagPolyline)}, binary.AppendUvarint(nil, maxEncodedVertices)...),
+		"numCells": append([]byte{1, 10, 0, 0}, huge...),
+		"cells":    append([]byte{1, 10, 0, 0}, binary.AppendUvarint(nil, maxEncodedCells)...),
+	}
+	for name, data := range tests {
+		if err := NewShapeIndex().Decode(bytes.NewReader(data)); err == nil {
+			t.Errorf("%s: Decode succeeded, want error", name)
+		}
+	}
+}
