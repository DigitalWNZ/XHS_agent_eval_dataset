+func TestShapeIndexEncodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	a := makePolyline("0:0, 1:1")
+	b := makePolyline("2:2, 3:3")
+	c := makePolyline("4:4, 5:5")
+	index.Add(a)
+	index.Add(b)
+	index.Add(c)
+	index.Remove(b)
+
+	got := roundTripShapeIndex(t, index)
