+func encodedTestIndex(t *testing.T) []byte {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 8:2, 8:8, 2:8", true))
+	index.Add(makePolyline("-10:-10, -20:-20, -30:-10"))
