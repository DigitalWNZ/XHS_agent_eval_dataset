+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() = %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("Encode() produced no bytes")
+	}
+	got := NewShapeIndex()
+	if err := got.Decode(&buf); err != nil {
+		t.Fatalf("Decode() = %v", err)
+	}
+	return got
+}
+
+// checkShapeIndexEqual verifies the shapes and cell structure of two indexes match.
+func checkShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	want.Build()
+	if !got.IsFresh() {
+		t.Errorf("decoded index is not fresh")
+	}
+	if got.Len() != want.Len() || got.nextID != want.nextID {
+		t.Fatalf("Len, nextID = %d, %d, want %d, %d", got.Len(), got.nextID, want.Len(), want.nextID)
+	}
+	for id, ws := range want.shapes {
+		gs := got.Shape(id)
+		if gs == nil {
+			t.Fatalf("shape %d missing", id)
+		}
+		if gs.Dimension() != ws.Dimension() || gs.NumEdges() != ws.NumEdges() || gs.NumChains() != ws.NumChains() {
+			t.Fatalf("shape %d: dim/edges/chains = %d/%d/%d, want %d/%d/%d", id,
+				gs.Dimension(), gs.NumEdges(), gs.NumChains(), ws.Dimension(), ws.NumEdges(), ws.NumChains())
+		}
+		if gs.ReferencePoint() != ws.ReferencePoint() {
+			t.Errorf("shape %d: ReferencePoint = %v, want %v", id, gs.ReferencePoint(), ws.ReferencePoint())
+		}
+		for e := 0; e < ws.NumEdges(); e++ {
+			if gs.Edge(e) != ws.Edge(e) || gs.ChainPosition(e) != ws.ChainPosition(e) {
+				t.Fatalf("shape %d edge %d differs", id, e)
+			}
+		}
+		for c := 0; c < ws.NumChains(); c++ {
+			if gs.Chain(c) != ws.Chain(c) {
+				t.Fatalf("shape %d chain %d = %v, want %v", id, c, gs.Chain(c), ws.Chain(c))
+			}
+		}
+	}
+	if !reflect.DeepEqual(got.cells, want.cells) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	for _, id := range want.cells {
+		if !reflect.DeepEqual(got.cellMap[id], want.cellMap[id]) {
+			t.Fatalf("cell %v = %+v, want %+v", id, got.cellMap[id], want.cellMap[id])
+		}
+	}
+}
