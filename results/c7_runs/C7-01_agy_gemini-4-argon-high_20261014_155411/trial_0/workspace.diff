+#/*
+import sys
+
+def fib(n):
+    a, b = 0, 1
+    for _ in range(n):
+        a, b = b, a + b
+    return a
+
+if __name__ == "__main__":
+    print(fib(int(sys.argv[1])))
+r"""
+#*/
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long n = strtol(argv[1], NULL, 10);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    size_t cap = (size_t)(n / 9) + 4;
+    uint32_t *a = calloc(cap, sizeof(uint32_t));
+    uint32_t *b = calloc(cap, sizeof(uint32_t));
+    a[0] = 0;
+    b[0] = 1;
+    size_t len = 1;
+    const uint32_t BASE = 1000000000U;
+    for (long i = 0; i < n; i++) {
+        uint64_t carry = 0;
+        for (size_t j = 0; j < len; j++) {
+            uint64_t sum = (uint64_t)a[j] + b[j] + carry;
+            a[j] = b[j];
+            b[j] = (uint32_t)(sum % BASE);
+            carry = sum / BASE;
+        }
+        if (carry) {
+            a[len] = b[len];
+            b[len] = (uint32_t)carry;
+            len++;
+        }
+    }
+    size_t idx = len - 1;
+    while (idx > 0 && a[idx] == 0) {
+        idx--;
+    }
+    printf("%u", a[idx]);
+    while (idx > 0) {
+        idx--;
+        printf("%09u", a[idx]);
+    }
+    printf("\n");
+    free(a);
+    free(b);
+    return 0;
+}
+//"""
