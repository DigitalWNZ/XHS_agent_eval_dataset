+func assertShapeEqual(t *testing.T, got, want Shape) {
+	t.Helper()
+	if (got == nil) != (want == nil) {
+		t.Fatalf("shape nil mismatch: got %v, want %v", got, want)
+	}
+	if got == nil {
+		return
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("Dimension() = %d, want %d", got.Dimension(), want.Dimension())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("IsEmpty() = %v, want %v", got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("IsFull() = %v, want %v", got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("ReferencePoint() = %v, want %v", got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	for e := 0; e < want.NumEdges(); e++ {
+		if got.Edge(e) != want.Edge(e) {
+			t.Errorf("Edge(%d) = %v, want %v", e, got.Edge(e), want.Edge(e))
+		}
+		if got.ChainPosition(e) != want.ChainPosition(e) {
+			t.Errorf("ChainPosition(%d) = %v, want %v", e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("NumChains() = %d, want %d", got.NumChains(), want.NumChains())
+	}
+	for c := 0; c < want.NumChains(); c++ {
+		if got.Chain(c) != want.Chain(c) {
+			t.Errorf("Chain(%d) = %v, want %v", c, got.Chain(c), want.Chain(c))
+		}
+		for offset := 0; offset < want.Chain(c).Length; offset++ {
+			if got.ChainEdge(c, offset) != want.ChainEdge(c, offset) {
+				t.Errorf("ChainEdge(%d, %d) = %v, want %v", c, offset, got.ChainEdge(c, offset), want.ChainEdge(c, offset))
+			}
+		}
+	}
+}
+
+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded index IsFresh() = false, want true")
+	}
+	if got.Len() != want.Len() {
+		t.Errorf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	if got.maxEdgesPerCell != want.maxEdgesPerCell {
+		t.Errorf("maxEdgesPerCell = %d, want %d", got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+	for id := int32(0); id < want.nextID; id++ {
+		assertShapeEqual(t, got.Shape(id), want.Shape(id))
+	}
+	if !reflect.DeepEqual(got.cells, want.cells) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	if !reflect.DeepEqual(got.cellMap, want.cellMap) {
+		t.Errorf("cellMap = %#v, want %#v", got.cellMap, want.cellMap)
+	}
+}
