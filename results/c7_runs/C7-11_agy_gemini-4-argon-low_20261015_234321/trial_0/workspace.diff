+// go test -fuzz=FuzzDecodeShapeIndex github.com/golang/geo/s2
+func FuzzDecodeShapeIndex(f *testing.F) {
+	seeds := []*ShapeIndex{
+		NewShapeIndex(),
+		makeShapeIndex("0:0 | 1:1 # 0:0, 2:2, 4:4 # 0:0, 0:10, 10:10, 10:0"),
+		makeShapeIndex("# # empty | full"),
+	}
+	for _, idx := range seeds {
+		var buf bytes.Buffer
+		if err := idx.Encode(&buf); err != nil {
+			f.Fatalf("Encode error: %v", err)
+		}
+		f.Add(buf.Bytes())
+	}
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		var idx ShapeIndex
+		if err := idx.Decode(bytes.NewReader(data)); err != nil {
+			return
+		}
+		if !idx.IsFresh() {
+			t.Errorf("IsFresh() = false after Decode")
+		}
+		for it := idx.Iterator(); !it.Done(); it.Next() {
+			_ = it.CellID()
+			_ = it.IndexCell()
+		}
+	})
