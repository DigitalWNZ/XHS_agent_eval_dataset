+	return e.err
+}
+
+func (l *LaxLoop) encode(e *encoder) {
+	if l.numVertices > maxEncodedVertices {
+		e.err = fmt.Errorf("too many vertices (%d; max is %d)", l.numVertices, maxEncodedVertices)
+		return
+	}
