+func TestShapeIndexDecodeMalformedInput(t *testing.T) {
+	// 1. Build a valid non-trivial index and test all truncated prefixes.
+	index := makeShapeIndex("0:0 | 1:1 # 0:0, 2:2, 4:4 # 0:0, 0:10, 10:10, 10:0; 2:2, 8:2, 8:8, 2:8")
+	var validBuf bytes.Buffer
+	if err := index.Encode(&validBuf); err != nil {
+		t.Fatalf("Encode() error: %v", err)
+	}
+	validBytes := validBuf.Bytes()
+
+	for truncLen := 0; truncLen < len(validBytes); truncLen++ {
+		var dec ShapeIndex
+		if err := dec.Decode(bytes.NewReader(validBytes[:truncLen])); err == nil {
+			t.Errorf("Decode(truncated at %d/%d) succeeded, want error", truncLen, len(validBytes))
+		}
+	}
+
+	// 2. Single-byte bit-flip corruptions across the encoded stream must never panic.
+	for i := range validBytes {
+		for _, mask := range []byte{0x01, 0x04, 0x10, 0x80, 0xff} {
+			corrupted := append([]byte(nil), validBytes...)
+			corrupted[i] ^= mask
+			var dec ShapeIndex
+			_ = dec.Decode(bytes.NewReader(corrupted))
+		}
+	}
+
+	// 3. Explicit malformed / oversized allocation cases.
+	putUvarint := func(vals ...uint64) []byte {
+		var b []byte
+		var tmp [binary.MaxVarintLen64]byte
+		for _, v := range vals {
+			n := binary.PutUvarint(tmp[:], v)
+			b = append(b, tmp[:n]...)
+		}
+		return b
+	}
+
+	header := uint64(10)<<2 | uint64(encodingVersion)
+
+	malformedCases := []struct {
+		name string
+		data []byte
+	}{
+		{
+			name: "empty stream",
+			data: nil,
+		},
+		{
+			name: "unsupported version 2",
+			data: putUvarint(uint64(10)<<2 | 2),
+		},
+		{
+			name: "zero maxEdgesPerCell",
+			data: putUvarint(uint64(0)<<2 | uint64(encodingVersion)),
+		},
+		{
+			name: "oversized maxEdgesPerCell",
+			data: putUvarint((uint64(maxEncodedEdgesPerCell)+1)<<2 | uint64(encodingVersion)),
+		},
+		{
+			name: "oversized numShapes",
+			data: putUvarint(header, uint64(maxEncodedShapes)+1),
+		},
+		{
+			name: "huge varint numShapes",
+			data: putUvarint(header, 1<<60),
+		},
+		{
+			name: "unknown shape typeTag",
+			data: putUvarint(header, 1, 999),
+		},
+		{
+			name: "oversized PointVector count",
+			data: func() []byte {
+				b := putUvarint(header, 1, uint64(typeTagPointVector))
+				b = append(b, byte(encodingVersion))
+				b = append(b, putUvarint(uint64(maxEncodedVertices)+1)...)
+				return b
+			}(),
+		},
+		{
+			name: "oversized LaxPolyline count",
+			data: func() []byte {
+				b := putUvarint(header, 1, uint64(typeTagLaxPolyline))
+				b = append(b, byte(encodingVersion))
+				b = append(b, putUvarint(uint64(maxEncodedVertices)+1)...)
+				return b
+			}(),
+		},
+		{
+			name: "oversized LaxPolygon loops",
+			data: func() []byte {
+				b := putUvarint(header, 1, uint64(typeTagLaxPolygon))
+				b = append(b, byte(encodingVersion))
+				b = append(b, putUvarint(uint64(maxEncodedLoops)+1)...)
+				return b
+			}(),
+		},
+		{
+			name: "oversized LaxPolygon vertices",
+			data: func() []byte {
+				b := putUvarint(header, 1, uint64(typeTagLaxPolygon))
+				b = append(b, byte(encodingVersion))
+				b = append(b, putUvarint(1, uint64(maxEncodedVertices)+1)...)
+				return b
+			}(),
+		},
+		{
+			name: "oversized numCells",
+			data: putUvarint(header, 0, uint64(maxEncodedIndexCells)+1),
+		},
+		{
+			name: "invalid CellID in cell list",
+			data: func() []byte {
+				b := putUvarint(header, 0, 1)
+				var cid [8]byte // CellID(0) is invalid
+				b = append(b, cid[:]...)
+				b = append(b, putUvarint(0)...)
+				return b
+			}(),
+		},
+		{
+			name: "unsorted CellIDs",
+			data: func() []byte {
+				b := putUvarint(header, 0, 2)
+				var cid [8]byte
+				binary.LittleEndian.PutUint64(cid[:], uint64(CellIDFromFace(2)))
+				b = append(b, cid[:]...)
+				b = append(b, putUvarint(0)...)
+				binary.LittleEndian.PutUint64(cid[:], uint64(CellIDFromFace(1)))
+				b = append(b, cid[:]...)
+				b = append(b, putUvarint(0)...)
+				return b
+			}(),
+		},
+		{
+			name: "clipped shape references out-of-range shapeID",
+			data: func() []byte {
+				b := putUvarint(header, 1, uint64(typeTagNone), 1)
+				var cid [8]byte
+				binary.LittleEndian.PutUint64(cid[:], uint64(CellIDFromFace(0)))
+				b = append(b, cid[:]...)
+				b = append(b, putUvarint(1, 5)...) // 1 clipped shape, shapeID=5 (>= nextID=1)
+				return b
+			}(),
+		},
+		{
+			name: "clipped shape references nil (removed) shapeID",
+			data: func() []byte {
+				b := putUvarint(header, 1, uint64(typeTagNone), 1)
+				var cid [8]byte
+				binary.LittleEndian.PutUint64(cid[:], uint64(CellIDFromFace(0)))
+				b = append(b, cid[:]...)
+				b = append(b, putUvarint(1, 0)...) // 1 clipped shape, shapeID=0 (which is typeTagNone)
+				return b
+			}(),
+		},
+	}
+
+	for _, tc := range malformedCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var dec ShapeIndex
+			if err := dec.Decode(bytes.NewReader(tc.data)); err == nil {
+				t.Errorf("Decode(%s) = nil, want error", tc.name)
+			}
+		})
+	}
+}
