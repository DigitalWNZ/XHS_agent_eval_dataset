+	idPVEmpty := index.Add(&pvEmpty)
+	idPV := index.Add(&pv)
+
+	// 2. Polyline (empty, 1 vertex / 0 edges, multi-vertex)
+	plEmpty := Polyline{}
+	plOne := Polyline(parsePoints("5:5"))
+	pl := makePolyline("0:0, 0:10, 10:20, 20:30")
+	idPLEmpty := index.Add(&plEmpty)
+	idPLOne := index.Add(&plOne)
+	idPL := index.Add(pl)
+
+	// 3. LaxPolyline (empty, 1 vertex / 0 edges, multi-vertex)
+	lplEmpty := LaxPolylineFromPoints(nil)
+	lplOne := LaxPolylineFromPoints(parsePoints("6:6"))
+	lpl := makeLaxPolyline("1:1, 2:3, 4:5")
+	idLPLEmpty := index.Add(lplEmpty)
+	idLPLOne := index.Add(lplOne)
+	idLPL := index.Add(lpl)
+
+	// 4. Loop (EmptyLoop, FullLoop, regular Loop)
+	loopEmpty := EmptyLoop()
+	loopFull := FullLoop()
+	loopReg := makeLoop("10:10, 10:20, 20:20, 20:10")
+	idLoopEmpty := index.Add(loopEmpty)
+	idLoopFull := index.Add(loopFull)
