+func (g *genericShape) Edge(i int) Edge                { return g.edges[i] }
+func (g *genericShape) ReferencePoint() ReferencePoint { return g.referencePoint }
+func (g *genericShape) NumChains() int                 { return len(g.chains) }
+func (g *genericShape) Chain(chainID int) Chain        { return g.chains[chainID] }
+func (g *genericShape) ChainEdge(chainID, offset int) Edge {
+	return g.edges[g.chains[chainID].Start+offset]
+}
+func (g *genericShape) ChainPosition(edgeID int) ChainPosition {
+	if len(g.chains) <= 1 {
+		return ChainPosition{0, edgeID}
+	}
+	chainID := sort.Search(len(g.chains), func(i int) bool {
+		return g.chains[i].Start > edgeID
+	}) - 1
+	if chainID < 0 {
+		chainID = 0
+	}
+	return ChainPosition{chainID, edgeID - g.chains[chainID].Start}
+}
+func (g *genericShape) Dimension() int    { return g.dimension }
+func (g *genericShape) IsEmpty() bool     { return defaultShapeIsEmpty(g) }
+func (g *genericShape) IsFull() bool      { return defaultShapeIsFull(g) }
+func (g *genericShape) typeTag() typeTag  { return typeTagNone }
+func (g *genericShape) privateInterface() {}
+
+// Encode encodes the ShapeIndex to w.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.Build()
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	if s.nextID < 0 || s.nextID > maxEncodedShapes {
+		e.err = fmt.Errorf("too many shapes (%d; max is %d)", s.nextID, maxEncodedShapes)
+		return
+	}
+	if len(s.cells) > maxEncodedIndexCells {
+		e.err = fmt.Errorf("too many index cells (%d; max is %d)", len(s.cells), maxEncodedIndexCells)
+		return
+	}
+
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUvarint(uint64(maxEdges)<<2 | uint64(encodingVersion))
+	e.writeUvarint(uint64(s.nextID))
+
+	for id := int32(0); id < s.nextID; id++ {
+		if e.err != nil {
+			return
+		}
+		shape := s.shapes[id]
+		if shape == nil {
+			e.writeUvarint(uint64(typeTagNone))
+			continue
+		}
+		encodeShape(e, shape)
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		if e.err != nil {
+			return
+		}
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+}
+
+func encodeShape(e *encoder, shape Shape) {
+	switch sh := shape.(type) {
+	case *Polygon:
+		e.writeUvarint(uint64(typeTagPolygon))
+		sh.encode(e)
+	case *Polyline:
+		e.writeUvarint(uint64(typeTagPolyline))
+		sh.encode(e)
+	case *PointVector:
+		e.writeUvarint(uint64(typeTagPointVector))
+		sh.encode(e)
+	case *LaxPolyline:
+		e.writeUvarint(uint64(typeTagLaxPolyline))
+		sh.encode(e)
+	case *LaxPolygon:
+		e.writeUvarint(uint64(typeTagLaxPolygon))
+		sh.encode(e)
+	case *Loop:
+		e.writeUvarint(uint64(encodedShapeTagLoop))
+		sh.encode(e)
+	case *LaxLoop:
+		e.writeUvarint(uint64(encodedShapeTagLaxLoop))
+		sh.encode(e)
+	default:
+		encodeGenericShape(e, shape)
+	}
+}
+
+func encodeGenericShape(e *encoder, shape Shape) {
+	numEdges := shape.NumEdges()
+	numChains := shape.NumChains()
+	if numEdges > maxEncodedVertices || numChains > maxEncodedChainsPerShape {
+		e.err = fmt.Errorf("generic shape too large (edges=%d, chains=%d)", numEdges, numChains)
+		return
+	}
+	e.writeUvarint(uint64(encodedShapeTagGenericChains))
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(shape.Dimension()))
+	ref := shape.ReferencePoint()
+	e.writeFloat64(ref.Point.X)
+	e.writeFloat64(ref.Point.Y)
+	e.writeFloat64(ref.Point.Z)
+	e.writeBool(ref.Contained)
+	e.writeUvarint(uint64(numEdges))
+	for i := range numEdges {
+		edge := shape.Edge(i)
+		e.writeFloat64(edge.V0.X)
+		e.writeFloat64(edge.V0.Y)
+		e.writeFloat64(edge.V0.Z)
+		e.writeFloat64(edge.V1.X)
+		e.writeFloat64(edge.V1.Y)
+		e.writeFloat64(edge.V1.Z)
+	}
+	e.writeUvarint(uint64(numChains))
+	for i := range numChains {
+		ch := shape.Chain(i)
+		e.writeUvarint(uint64(ch.Start))
+		e.writeUvarint(uint64(ch.Length))
+	}
+}
+
+// Decode decodes the ShapeIndex from r.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	maxEdgesAndVersion := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	version := int8(maxEdgesAndVersion & 3)
+	if version != encodingVersion {
+		d.err = fmt.Errorf("unsupported ShapeIndex encoding version %d", version)
+		return
+	}
+	maxEdgesPerCell := maxEdgesAndVersion >> 2
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > maxEncodedEdgesPerCell {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell %d", maxEdgesPerCell)
+		return
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+
+	shapes := make(map[int32]Shape)
+	for id := uint64(0); id < nextID; id++ {
+		tag := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if tag == uint64(typeTagNone) {
+			continue
+		}
+		shape := decodeShape(d, uint32(tag))
+		if d.err != nil {
+			return
+		}
+		shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedIndexCells {
+		d.err = fmt.Errorf("too many index cells (%d; max is %d)", numCells, maxEncodedIndexCells)
+		return
+	}
+
+	cellMap := make(map[CellID]*ShapeIndexCell, numCells)
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, numCells)
+	}
+
+	for i := uint64(0); i < numCells; i++ {
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID %v at index %d", cellID, i)
+			return
+		}
+		if i > 0 && cellID <= cells[i-1] {
+			d.err = fmt.Errorf("cell IDs not in strictly increasing order at index %d: %v <= %v", i, cellID, cells[i-1])
+			return
+		}
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapes || numClipped > nextID {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, nextID)
+			return
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		prevShapeID := int32(-1)
+		for j := uint64(0); j < numClipped; j++ {
+			shapeIDVal := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if shapeIDVal >= nextID {
+				d.err = fmt.Errorf("clipped shapeID %d out of range [0, %d)", shapeIDVal, nextID)
+				return
+			}
+			shapeID := int32(shapeIDVal)
+			if shapeID <= prevShapeID {
+				d.err = fmt.Errorf("clipped shapeIDs not in strictly increasing order: %d <= %d", shapeID, prevShapeID)
+				return
+			}
+			prevShapeID = shapeID
+
+			shape := shapes[shapeID]
+			if shape == nil {
+				d.err = fmt.Errorf("clipped shape references nil shapeID %d", shapeID)
+				return
+			}
+
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			shapeNumEdges := uint64(shape.NumEdges())
+			if numEdges > maxEncodedEdgesPerCell || numEdges > shapeNumEdges {
+				d.err = fmt.Errorf("too many edges in clipped shape (%d; shape has %d)", numEdges, shapeNumEdges)
+				return
+			}
+
+			clipped := newClippedShape(shapeID, int(numEdges))
+			clipped.containsCenter = containsCenter
+			prevEdgeID := -1
+			for k := uint64(0); k < numEdges; k++ {
+				edgeIDVal := d.readUvarint()
+				if d.err != nil {
+					return
+				}
+				if edgeIDVal >= shapeNumEdges {
+					d.err = fmt.Errorf("clipped edgeID %d out of range [0, %d)", edgeIDVal, shapeNumEdges)
+					return
+				}
+				edgeID := int(edgeIDVal)
+				if edgeID <= prevEdgeID {
+					d.err = fmt.Errorf("clipped edgeIDs not in strictly increasing order: %d <= %d", edgeID, prevEdgeID)
+					return
+				}
+				prevEdgeID = edgeID
+				clipped.edges[k] = edgeID
+			}
+			cell.shapes[j] = clipped
+		}
+
+		cells[i] = cellID
+		cellMap[cellID] = cell
+	}
+
+	if d.err != nil {
+		return
+	}
+
+	s.mu.Lock()
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+}
+
+func decodeShape(d *decoder, tag uint32) Shape {
+	switch typeTag(tag) {
+	case typeTagPolygon:
+		p := new(Polygon)
+		version := int8(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		switch version {
+		case encodingVersion:
+			p.decode(d)
+		case encodingCompressedVersion:
+			p.decodeCompressed(d)
+		default:
+			d.err = fmt.Errorf("unsupported Polygon version %d", version)
+			return nil
+		}
+		return p
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		return p
+	case typeTagPointVector:
+		p := new(PointVector)
+		p.decode(d)
+		return p
+	case typeTagLaxPolyline:
+		p := new(LaxPolyline)
+		p.decode(d)
+		return p
+	case typeTagLaxPolygon:
+		p := new(LaxPolygon)
+		p.decode(d)
+		return p
+	default:
+		switch tag {
+		case encodedShapeTagLoop:
+			l := new(Loop)
+			l.decode(d)
+			return l
+		case encodedShapeTagLaxLoop:
+			l := new(LaxLoop)
+			l.decode(d)
+			return l
+		case encodedShapeTagGenericChains:
+			return decodeGenericShape(d)
+		default:
+			d.err = fmt.Errorf("unsupported shape type tag %d", tag)
+			return nil
+		}
+	}
+}
+
+func decodeGenericShape(d *decoder) Shape {
+	version := d.readInt8()
+	if d.err != nil {
+		return nil
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("unsupported generic shape version %d", version)
+		return nil
+	}
+	dim := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if dim > 2 {
+		d.err = fmt.Errorf("invalid shape dimension %d", dim)
+		return nil
+	}
+	var ref ReferencePoint
+	ref.Point.X = d.readFloat64()
+	ref.Point.Y = d.readFloat64()
+	ref.Point.Z = d.readFloat64()
+	ref.Contained = d.readBool()
+	numEdges := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numEdges > maxEncodedVertices {
+		d.err = fmt.Errorf("too many edges in generic shape (%d; max is %d)", numEdges, maxEncodedVertices)
+		return nil
+	}
+	var edges []Edge
+	if numEdges > 0 {
+		edges = make([]Edge, numEdges)
+		for i := range edges {
+			edges[i].V0.X = d.readFloat64()
+			edges[i].V0.Y = d.readFloat64()
+			edges[i].V0.Z = d.readFloat64()
+			edges[i].V1.X = d.readFloat64()
+			edges[i].V1.Y = d.readFloat64()
+			edges[i].V1.Z = d.readFloat64()
+		}
+	}
+	numChains := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numChains > maxEncodedChainsPerShape {
+		d.err = fmt.Errorf("too many chains in generic shape (%d; max is %d)", numChains, maxEncodedChainsPerShape)
+		return nil
+	}
+	if numEdges > 0 && numChains == 0 {
+		d.err = fmt.Errorf("generic shape with %d edges must have at least 1 chain", numEdges)
+		return nil
+	}
+	var chains []Chain
+	if numChains > 0 {
+		chains = make([]Chain, numChains)
+		expectedStart := uint64(0)
+		for i := range chains {
+			start := d.readUvarint()
+			length := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if start != expectedStart || length > numEdges-start {
+				d.err = fmt.Errorf("invalid chain %d: start=%d, length=%d (expected start=%d, numEdges=%d)", i, start, length, expectedStart, numEdges)
+				return nil
+			}
+			chains[i] = Chain{Start: int(start), Length: int(length)}
+			expectedStart += length
+		}
+		if expectedStart != numEdges {
+			d.err = fmt.Errorf("chains cover %d edges, want %d", expectedStart, numEdges)
+			return nil
+		}
+	}
+	if d.err != nil {
+		return nil
+	}
+	return &genericShape{
+		dimension:      int(dim),
+		edges:          edges,
+		chains:         chains,
+		referencePoint: ref,
+	}
+}
