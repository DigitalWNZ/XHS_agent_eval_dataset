+func TestShapeIndexEncodeDecodePreservesShapeIDsAndQueries(t *testing.T) {
+	index := NewShapeIndex()
+	s0 := makeLaxPolyline("0:0, 0:5")
+	s1 := makeLaxPolygon("0:0, 0:10, 10:10, 10:0")
+	s2 := makeLaxPolyline("20:20, 25:25")
+	s3 := makePolygon("-10:-10, -10:-1, -1:-1, -1:-10", true)
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+	id3 := index.Add(s3)
+
+	// Remove s0 and s2 before Build so IDs have gaps (only 1 and 3 remain).
+	index.Remove(s0)
+	index.Remove(s2)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode() error: %v", err)
+	}
+
+	if decoded.Shape(id0) != nil {
+		t.Errorf("decoded.Shape(%d) = %v, want nil", id0, decoded.Shape(id0))
+	}
+	if decoded.Shape(id1) == nil {
+		t.Fatalf("decoded.Shape(%d) = nil, want non-nil", id1)
+	}
+	if decoded.Shape(id2) != nil {
+		t.Errorf("decoded.Shape(%d) = %v, want nil", id2, decoded.Shape(id2))
+	}
+	if decoded.Shape(id3) == nil {
+		t.Fatalf("decoded.Shape(%d) = nil, want non-nil", id3)
+	}
+
+	assertShapeIndexEqual(t, decoded, index)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+	verifyEdgeIterator(t, decoded)
+
+	// Verify queries work without calling Build() on decoded.
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(parsePoint("5:5")) {
+		t.Errorf("ContainsPointQuery(5:5) = false, want true")
+	}
+	if !cpq.ShapeContains(decoded.Shape(id1), parsePoint("5:5")) {
+		t.Errorf("ShapeContains(id1, 5:5) = false, want true")
+	}
+	if !cpq.ShapeContains(decoded.Shape(id3), parsePoint("-5:-5")) {
+		t.Errorf("ShapeContains(id3, -5:-5) = false, want true")
+	}
+	if cpq.Contains(parsePoint("50:50")) {
+		t.Errorf("ContainsPointQuery(50:50) = true, want false")
+	}
+
+	ceq := NewCrossingEdgeQuery(decoded)
+	crossings := ceq.Crossings(parsePoint("-1:5"), parsePoint("1:5"), decoded.Shape(id1), CrossingTypeAll)
+	if len(crossings) != 1 {
+		t.Errorf("CrossingEdgeQuery crossings = %v, want 1 crossing", crossings)
+	}
+
+	eq := NewClosestEdgeQuery(decoded, NewClosestEdgeQueryOptions().IncludeInteriors(true).MaxResults(1))
+	results := eq.FindEdges(NewMinDistanceToPointTarget(parsePoint("5:5")))
+	if len(results) == 0 || results[0].ShapeID() != id1 {
+		t.Errorf("ClosestEdgeQuery results = %v, want ShapeID %d", results, id1)
+	}
+}
