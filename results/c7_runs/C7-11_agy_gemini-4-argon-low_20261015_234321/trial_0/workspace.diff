+	return ChainPosition{nextLoop - 1, e - p.cumulativeVertices[nextLoop-1]}
+}
+
+// Encode encodes the LaxPolygon.
+func (p *LaxPolygon) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	p.encode(e)
+	return e.err
+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	if p.numLoops > maxEncodedLoops {
+		e.err = fmt.Errorf("too many loops (%d; max is %d)", p.numLoops, maxEncodedLoops)
+		return
+	}
+	if len(p.vertices) > maxEncodedVertices {
+		e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(p.vertices), maxEncodedVertices)
+		return
+	}
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(p.numLoops))
+	e.writeUvarint(uint64(len(p.vertices)))
+	for _, v := range p.vertices {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+	if p.numLoops > 1 {
+		for _, cv := range p.cumulativeVertices {
+			e.writeUvarint(uint64(cv))
+		}
+	}
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	numLoops := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+	numVerts := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numVerts > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", numVerts, maxEncodedVertices)
+		return
+	}
+	if numLoops == 0 && numVerts != 0 {
+		d.err = fmt.Errorf("LaxPolygon with 0 loops cannot have %d vertices", numVerts)
+		return
+	}
+	var vertices []Point
+	if numVerts > 0 {
+		vertices = make([]Point, numVerts)
+		for i := range vertices {
+			vertices[i].X = d.readFloat64()
+			vertices[i].Y = d.readFloat64()
+			vertices[i].Z = d.readFloat64()
+		}
+	}
+	var cumulativeVertices []int
+	if numLoops > 1 {
+		cumulativeVertices = make([]int, numLoops+1)
+		for i := range cumulativeVertices {
+			cv := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if cv > numVerts {
+				d.err = fmt.Errorf("invalid cumulative vertex count %d (total vertices %d)", cv, numVerts)
+				return
+			}
+			if i > 0 && int(cv) < cumulativeVertices[i-1] {
+				d.err = fmt.Errorf("cumulative vertex counts must be non-decreasing")
+				return
+			}
+			cumulativeVertices[i] = int(cv)
+		}
+		if cumulativeVertices[0] != 0 || cumulativeVertices[numLoops] != int(numVerts) {
+			d.err = fmt.Errorf("invalid cumulative vertex endpoints: start=%d, end=%d, want 0 and %d", cumulativeVertices[0], cumulativeVertices[numLoops], numVerts)
+			return
+		}
+	}
+	if d.err != nil {
+		return
+	}
+	*p = LaxPolygon{
+		numLoops:           int(numLoops),
+		vertices:           vertices,
+		cumulativeVertices: cumulativeVertices,
+	}
+	if numLoops <= 1 {
+		p.numVerts = int(numVerts)
+	}
 }
 
