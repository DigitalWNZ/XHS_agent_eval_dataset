+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("empty index encoded to 0 bytes, want non-empty byte stream")
+	}
+
+	decoded := NewShapeIndex()
+	// Populate decoded with dummy data first to verify Decode overwrites it.
+	decoded.Add(makeLaxPolyline("0:0, 1:1"))
+	decoded.Build()
+
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode() error: %v", err)
+	}
+	assertShapeIndexEqual(t, decoded, index)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+}
