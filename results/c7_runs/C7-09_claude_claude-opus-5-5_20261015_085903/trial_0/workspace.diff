diff --git a/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go b/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go
index b20f4a9ac..2197761f3 100644
--- a/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go
+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go
@@ -61,6 +61,7 @@ func MergeTrafficPolicies(
 		mergeURLRewrite,
 		mergeAPIKeyAuth,
 		mergeOAuth,
+		mergeConsistentHash,
 	}
 
 	for _, mergeFunc := range mergeFuncs {
@@ -621,6 +622,58 @@ func mergeURLRewrite(
 	defaultMerge(p1, p2, p2Ref, p2MergeOrigins, opts, mergeOrigins, accessor, "urlRewrite")
 }
 
+// mergeConsistentHash unions the hash policies of p1 and p2, giving priority to the higher priority policy's
+// entries. p1 is the higher priority policy except for OverridableDeepMerge where p2 is preferred.
+// OverridableShallowMerge replaces p1 with p2.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	const fieldName = "consistentHash"
+	if p2.spec.consistentHash == nil {
+		return
+	}
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = p2.spec.consistentHash
+		mergeOrigins.SetOne(fieldName, p2Ref, p2MergeOrigins)
+		return
+	}
+
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		if p1.spec.consistentHash.disable {
+			// a disabled higher priority policy suppresses lower priority hash policies
+			return
+		}
+		merged := mergeConsistentHashIR(p1.spec.consistentHash, p2.spec.consistentHash)
+		if merged == p1.spec.consistentHash {
+			return
+		}
+		p1.spec.consistentHash = merged
+		mergeOrigins.Append(fieldName, p2Ref, p2MergeOrigins)
+
+	case policy.OverridableDeepMerge:
+		if p2.spec.consistentHash.disable {
+			p1.spec.consistentHash = p2.spec.consistentHash
+			mergeOrigins.SetOne(fieldName, p2Ref, p2MergeOrigins)
+			return
+		}
+		p1.spec.consistentHash = mergeConsistentHashIR(p2.spec.consistentHash, p1.spec.consistentHash)
+		mergeOrigins.Append(fieldName, p2Ref, p2MergeOrigins)
+
+	case policy.OverridableShallowMerge:
+		p1.spec.consistentHash = p2.spec.consistentHash
+		mergeOrigins.SetOne(fieldName, p2Ref, p2MergeOrigins)
+
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", fieldName)
+	}
