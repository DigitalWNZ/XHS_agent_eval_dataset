@@ -0,0 +1,162 @@
+package trafficpolicy
+
+import (
+	"testing"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+func headerHP(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: name},
+		},
+		Terminal: terminal,
+	}
+}
+
+func queryHP(name string) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+			QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: name},
+		},
+	}
+}
+
+func assertHashPolicies(t *testing.T, expected, actual []*envoyroutev3.RouteAction_HashPolicy) {
+	t.Helper()
+	require.Len(t, actual, len(expected))
+	for i := range expected {
+		assert.True(t, proto.Equal(expected[i], actual[i]), "index %d: expected %v, got %v", i, expected[i], actual[i])
+	}
+}
+
+func construct(t *testing.T, ch *kgateway.ConsistentHash) *consistentHashIR {
+	t.Helper()
+	out := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, out))
+	return out.consistentHash
+}
+
+func TestConstructConsistentHash(t *testing.T) {
+	t.Run("nil spec", func(t *testing.T) {
+		assert.Nil(t, construct(t, nil))
+	})
+
+	t.Run("empty defaults to source ip", func(t *testing.T) {
+		got := construct(t, &kgateway.ConsistentHash{})
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)}, got.hashPolicies())
+	})
+
+	t.Run("disable", func(t *testing.T) {
+		got := construct(t, &kgateway.ConsistentHash{Disable: ptr.To(true)})
+		assert.True(t, got.disable)
+		assert.Nil(t, got.hashPolicies())
+	})
+
+	t.Run("canonical order and dedupe", func(t *testing.T) {
+		got := construct(t, &kgateway.ConsistentHash{
+			SourceIP:        &kgateway.SourceIPHashPolicy{Terminal: ptr.To(true)},
+			FilterState:     []kgateway.FilterStateHashPolicy{{Key: "fs"}, {Key: "fs", Terminal: ptr.To(true)}},
+			QueryParameters: []kgateway.QueryParameterHashPolicy{{Name: "q"}, {Name: "q", Terminal: ptr.To(true)}},
+			Cookies: []kgateway.CookieHashPolicy{
+				{
+					Name:       "c",
+					TTL:        ptr.To("1h30m"),
+					Path:       ptr.To("/"),
+					Attributes: []kgateway.CookieHashAttribute{{Name: "SameSite", Value: "Strict"}},
+				},
+				{Name: "c"},
+				{Name: "d", TTL: ptr.To("3600")},
+			},
+			Headers: []kgateway.HeaderHashPolicy{
+				{HeaderName: "X-User", RegexRewrite: &kgateway.HashRegexRewrite{Pattern: "^(.*)$", Substitution: `\1`}},
+				{HeaderName: "x-user", Terminal: ptr.To(true)},
+			},
+		})
+		require.Len(t, got.policies, 6)
+		assert.Equal(t, "X-User", got.policies[0].GetHeader().GetHeaderName())
+		assert.Equal(t, "^(.*)$", got.policies[0].GetHeader().GetRegexRewrite().GetPattern().GetRegex())
+		assert.False(t, got.policies[0].GetTerminal())
+		assert.Equal(t, "c", got.policies[1].GetCookie().GetName())
+		assert.True(t, proto.Equal(durationpb.New(90*time.Minute), got.policies[1].GetCookie().GetTtl()))
+		assert.Equal(t, "/", got.policies[1].GetCookie().GetPath())
+		assert.Equal(t, "SameSite", got.policies[1].GetCookie().GetAttributes()[0].GetName())
+		assert.Equal(t, "d", got.policies[2].GetCookie().GetName())
+		assert.True(t, proto.Equal(durationpb.New(time.Hour), got.policies[2].GetCookie().GetTtl()))
+		assert.Equal(t, "q", got.policies[3].GetQueryParameter().GetName())
+		assert.False(t, got.policies[3].GetTerminal())
+		assert.Equal(t, "fs", got.policies[4].GetFilterState().GetKey())
+		assert.True(t, got.policies[5].GetConnectionProperties().GetSourceIp())
+		assert.True(t, got.policies[5].GetTerminal())
+		assert.NoError(t, got.Validate())
+	})
+
+	t.Run("invalid ttl", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{
+			Cookies: []kgateway.CookieHashPolicy{{Name: "c", TTL: ptr.To("bogus")}},
+		}}, out)
+		assert.Error(t, err)
+	})
+
+	t.Run("invalid regex", func(t *testing.T) {
+		got := construct(t, &kgateway.ConsistentHash{
+			Headers: []kgateway.HeaderHashPolicy{{HeaderName: "x", RegexRewrite: &kgateway.HashRegexRewrite{Pattern: "(", Substitution: ""}}},
+		})
+		assert.Error(t, got.Validate())
+	})
+}
+
+func TestMergeConsistentHash(t *testing.T) {
+	mk := func(ch *consistentHashIR) *TrafficPolicy {
+		return &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: ch}}
+	}
+	p2Ref := &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Name: "p2", Namespace: "default"}
+
+	t.Run("union with higher priority first and canonical order", func(t *testing.T) {
+		p1 := mk(&consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("X-A", true), queryHP("q")}})
+		p2 := mk(&consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x-a", false), headerHP("x-b", false), sourceIPHashPolicy(true)}})
+		origins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, origins, TrafficPolicyMergeOpts{})
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+			headerHP("X-A", true), headerHP("x-b", false), queryHP("q"),
+		}, p1.spec.consistentHash.policies)
+		assert.Equal(t, []string{p2Ref.ID()}, origins.Get("consistentHash"))
+	})
+
+	t.Run("disabled higher priority suppresses", func(t *testing.T) {
+		p1 := mk(&consistentHashIR{disable: true})
+		p2 := mk(&consistentHashIR{policies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x", false)}})
+		mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{Strategy: policy.AugmentedDeepMerge}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		assert.Nil(t, p1.spec.consistentHash.hashPolicies())
+	})
+
+	t.Run("unset p1 takes p2", func(t *testing.T) {
+		p1 := mk(nil)
+		p2 := mk(&consistentHashIR{})
+		origins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, origins, TrafficPolicyMergeOpts{})
+		assert.Same(t, p2.spec.consistentHash, p1.spec.consistentHash)
+		assert.Equal(t, []string{p2Ref.ID()}, origins.Get("consistentHash"))
+	})
+}
+
+func TestApplyConsistentHash(t *testing.T) {
+	action := &envoyroutev3.RouteAction{HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x", false)}}
+	applyConsistentHash(&consistentHashIR{disable: true}, action)
+	assert.Nil(t, action.GetHashPolicy())
+
+	applyConsistentHash(&consistentHashIR{}, action)
+	assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)}, action.GetHashPolicy())
+}
