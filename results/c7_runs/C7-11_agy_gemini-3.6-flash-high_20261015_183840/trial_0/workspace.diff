+func TestShapeIndexEncodeDecodeSparseIDs(t *testing.T) {
+	p1 := PointFromLatLng(LatLngFromDegrees(0, 0))
+	p2 := PointFromLatLng(LatLngFromDegrees(0, 1))
+	p3 := PointFromLatLng(LatLngFromDegrees(1, 0))
+
+	index := NewShapeIndex()
+	s0 := polylineFromPoints(p1, p2)
+	s1 := polylineFromPoints(p2, p3)
+	s2 := polylineFromPoints(p3, p1)
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+
+	// Remove middle shape
+	index.Remove(s1)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 2 {
+		t.Errorf("decoded.Len() = %d, want 2", decoded.Len())
+	}
+
+	if decoded.Shape(id0) == nil {
+		t.Errorf("shape ID %d should exist", id0)
+	}
+	if decoded.Shape(id1) != nil {
+		t.Errorf("shape ID %d should be nil (removed)", id1)
+	}
+	if decoded.Shape(id2) == nil {
+		t.Errorf("shape ID %d should exist", id2)
+	}
+
+	// Verify cell contents reference valid shapes
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		cell := it.IndexCell()
+		for _, clipped := range cell.shapes {
+			if clipped.shapeID == id1 {
+				t.Errorf("cell references removed shape ID %d", id1)
+			}
+			if decoded.Shape(clipped.shapeID) == nil {
+				t.Errorf("cell references non-existent shape ID %d", clipped.shapeID)
+			}
+		}
+	}
+}
