+	index.Add(onePtPolyline)
+	index.Add(&emptyPV)
+	index.Add(emptyLaxPolyline)
+	index.Add(emptyLaxPolygon)
+	index.Add(fullLaxPolygon)
+	index.Add(multiLaxPolygon)
