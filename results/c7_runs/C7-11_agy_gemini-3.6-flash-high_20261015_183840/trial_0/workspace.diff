+func TestShapeIndexDecodeMalformedInput(t *testing.T) {
+	p1 := PointFromLatLng(LatLngFromDegrees(0, 0))
+	p2 := PointFromLatLng(LatLngFromDegrees(0, 10))
+	p3 := PointFromLatLng(LatLngFromDegrees(10, 0))
+
+	index := NewShapeIndex()
+	index.Add(polylineFromPoints(p1, p2, p3))
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	validData := buf.Bytes()
+
+	// 1. Truncated input at every length
+	for i := 0; i < len(validData); i++ {
+		truncated := validData[:i]
+		decoded := NewShapeIndex()
+		err := decoded.Decode(bytes.NewReader(truncated))
+		if err == nil {
+			t.Errorf("expected error for truncated length %d, got nil", i)
+		}
+	}
+
+	// 2. Corrupted version byte
+	corruptVersion := append([]byte(nil), validData...)
+	corruptVersion[0] = 99
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(corruptVersion)); err == nil {
+		t.Error("expected error for corrupt version, got nil")
+	}
+
+	// 3. Unknown shape tag
+	corruptTag := append([]byte(nil), validData...)
+	// In header: version(1 byte), maxEdges(4 bytes), nextID(4 bytes) -> offset 9 is tag
+	if len(corruptTag) > 9+4 {
+		binary.LittleEndian.PutUint32(corruptTag[9:], 9999)
+		decoded = NewShapeIndex()
+		if err := decoded.Decode(bytes.NewReader(corruptTag)); err == nil {
+			t.Error("expected error for unknown shape tag, got nil")
+		}
+	}
+
+	// 4. Oversized shape count request
+	oversizedShapes := make([]byte, 13)
+	oversizedShapes[0] = 1                                         // version
+	binary.LittleEndian.PutUint32(oversizedShapes[1:], 10)         // maxEdgesPerCell
+	binary.LittleEndian.PutUint32(oversizedShapes[5:], 0x7FFFFFFF) // nextID = huge!
+	binary.LittleEndian.PutUint32(oversizedShapes[9:], 0)          // numCells
+	decoded = NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(oversizedShapes)); err == nil {
+		t.Error("expected error for oversized nextID, got nil")
+	}
+
+	// 5. Oversized cell count request
+	oversizedCells := make([]byte, 13)
+	oversizedCells[0] = 1                                         // version
+	binary.LittleEndian.PutUint32(oversizedCells[1:], 10)         // maxEdgesPerCell
+	binary.LittleEndian.PutUint32(oversizedCells[5:], 0)          // nextID
+	binary.LittleEndian.PutUint32(oversizedCells[9:], 0x7FFFFFFF) // numCells = huge!
+	decoded = NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(oversizedCells)); err == nil {
+		t.Error("expected error for oversized numCells, got nil")
+	}
+}
