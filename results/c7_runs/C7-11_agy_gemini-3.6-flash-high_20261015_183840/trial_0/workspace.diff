+		if dec.IsEmpty() != orig.IsEmpty() {
+			t.Errorf("shape %d IsEmpty = %v, want %v", id, dec.IsEmpty(), orig.IsEmpty())
+		}
+		if dec.IsFull() != orig.IsFull() {
+			t.Errorf("shape %d IsFull = %v, want %v", id, dec.IsFull(), orig.IsFull())
+		}
+	}
