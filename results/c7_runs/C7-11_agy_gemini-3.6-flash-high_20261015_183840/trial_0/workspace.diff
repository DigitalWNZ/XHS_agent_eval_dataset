+
+	ids := []int32{id0, id1, id2, id3, id4, id5, id6}
+	for _, id := range ids {
+		orig := index.Shape(id)
+		dec := decoded.Shape(id)
+		if dec == nil {
+			t.Fatalf("decoded.Shape(%d) is nil", id)
