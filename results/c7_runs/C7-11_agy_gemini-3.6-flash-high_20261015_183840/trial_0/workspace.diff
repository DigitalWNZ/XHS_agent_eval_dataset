+	// 7. LaxLoop
+	laxLoop := LaxLoopFromPoints([]Point{p1, p2, p3})
+
+	index := NewShapeIndex()
+	id0 := index.Add(poly)
+	id1 := index.Add(polyline)
+	id2 := index.Add(&pv)
+	id3 := index.Add(laxPolyline)
+	id4 := index.Add(laxPolygon)
+	id5 := index.Add(loop)
+	id6 := index.Add(laxLoop)
