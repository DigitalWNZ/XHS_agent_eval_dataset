 	// TODO(roberts): finish the implementation of this.
 }
+
+const shapeIndexEncodingVersion = int8(1)
+
+const (
+	maxEncodedShapes        = 10000000
+	maxEncodedCells         = 10000000
+	maxClippedShapesPerCell = 1000000
+)
+
+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeUint32(uint32(s.maxEdgesPerCell))
+	e.writeUint32(uint32(s.nextID))
+
+	for id := int32(0); id < s.nextID; id++ {
+		shape, ok := s.shapes[id]
+		if !ok || shape == nil {
+			e.writeUint32(uint32(typeTagNone))
+			continue
+		}
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			return fmt.Errorf("shape at ID %d has no type tag", id)
+		}
+		e.writeUint32(uint32(tag))
+		if err := encodeShape(e.w, tag, shape); err != nil {
+			return err
+		}
+	}
+
+	e.writeUint32(uint32(len(s.cells)))
+	for _, cellID := range s.cells {
+		cellID.encode(e)
+		cell := s.cellMap[cellID]
+		numShapes := 0
+		if cell != nil {
+			numShapes = len(cell.shapes)
+		}
+		e.writeUint32(uint32(numShapes))
+		for i := 0; i < numShapes; i++ {
+			clipped := cell.shapes[i]
+			e.writeUint32(uint32(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUint32(uint32(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUint32(uint32(edgeID))
+			}
+		}
+	}
+
+	return e.err
+}
+
+func encodeShape(w io.Writer, tag typeTag, shape Shape) error {
+	switch tag {
+	case typeTagPolygon:
+		p, ok := shape.(*Polygon)
+		if !ok {
+			return fmt.Errorf("expected *Polygon for tag %d, got %T", tag, shape)
+		}
+		return p.Encode(w)
+	case typeTagPolyline:
+		p, ok := shape.(*Polyline)
+		if !ok {
+			return fmt.Errorf("expected *Polyline for tag %d, got %T", tag, shape)
+		}
+		return p.Encode(w)
+	case typeTagPointVector:
+		pv, ok := shape.(*PointVector)
+		if !ok {
+			return fmt.Errorf("expected *PointVector for tag %d, got %T", tag, shape)
+		}
+		return pv.Encode(w)
+	case typeTagLaxPolyline:
+		lp, ok := shape.(*LaxPolyline)
+		if !ok {
+			return fmt.Errorf("expected *LaxPolyline for tag %d, got %T", tag, shape)
+		}
+		return lp.Encode(w)
+	case typeTagLaxPolygon:
+		lp, ok := shape.(*LaxPolygon)
+		if !ok {
+			return fmt.Errorf("expected *LaxPolygon for tag %d, got %T", tag, shape)
+		}
+		return lp.Encode(w)
+	case typeTagLaxLoop:
+		ll, ok := shape.(*LaxLoop)
+		if !ok {
+			return fmt.Errorf("expected *LaxLoop for tag %d, got %T", tag, shape)
+		}
+		return ll.Encode(w)
+	case typeTagLoop:
+		l, ok := shape.(*Loop)
+		if !ok {
+			return fmt.Errorf("expected *Loop for tag %d, got %T", tag, shape)
+		}
+		return l.Encode(w)
+	default:
+		return fmt.Errorf("unsupported shape type tag %d", tag)
+	}
+}
+
+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) (err error) {
+	defer func() {
+		if rec := recover(); rec != nil {
+			err = fmt.Errorf("corrupt ShapeIndex encoding: %v", rec)
+		}
+	}()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	d := &decoder{r: asByteReader(r)}
+	version := d.readInt8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("unsupported ShapeIndex encoding version %d", version)
+	}
+
+	maxEdgesPerCell := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > 1000000 {
+		return fmt.Errorf("invalid maxEdgesPerCell: %d", maxEdgesPerCell)
+	}
+
+	nextID := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID > maxEncodedShapes {
+		return fmt.Errorf("too many shapes (%d; max is %d)", nextID, maxEncodedShapes)
+	}
+
+	shapes := make(map[int32]Shape, nextID)
+	for id := int32(0); id < int32(nextID); id++ {
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return d.err
+		}
+		if tag == typeTagNone {
+			continue
+		}
+
+		shape, err := decodeShape(d, tag)
+		if err != nil {
+			return err
+		}
+		shapes[id] = shape
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+
+	cellMap := make(map[CellID]*ShapeIndexCell, numCells)
+	cells := make([]CellID, 0, numCells)
+
+	for i := uint32(0); i < numCells; i++ {
+		var cellID CellID
+		cellID.decode(d)
+		if d.err != nil {
+			return d.err
+		}
+		if !cellID.IsValid() {
+			return fmt.Errorf("invalid CellID in index: %v", cellID)
+		}
+
+		numShapes := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+		if numShapes > maxClippedShapesPerCell {
+			return fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numShapes, maxClippedShapesPerCell)
+		}
+
+		cell := NewShapeIndexCell(int(numShapes))
+		for j := uint32(0); j < numShapes; j++ {
+			shapeID := int32(d.readUint32())
+			containsCenter := d.readBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return d.err
+			}
+
+			if shapeID < 0 || shapeID >= int32(nextID) {
+				return fmt.Errorf("invalid shapeID %d in cell", shapeID)
+			}
+			if numEdges > maxEncodedVertices {
+				return fmt.Errorf("too many edges in clipped shape (%d; max is %d)", numEdges, maxEncodedVertices)
+			}
+
+			clipped := newClippedShape(shapeID, int(numEdges))
+			clipped.containsCenter = containsCenter
+
+			sh := shapes[shapeID]
+			numShapeEdges := 0
+			if sh != nil {
+				numShapeEdges = sh.NumEdges()
+			}
+
+			for e := uint32(0); e < numEdges; e++ {
+				edgeID := int(d.readUint32())
+				if d.err != nil {
+					return d.err
+				}
+				if edgeID < 0 || (sh != nil && edgeID >= numShapeEdges) {
+					return fmt.Errorf("invalid edgeID %d for shapeID %d", edgeID, shapeID)
+				}
+				clipped.edges[e] = edgeID
+			}
+
+			cell.shapes[j] = clipped
+		}
+
+		cellMap[cellID] = cell
+		cells = append(cells, cellID)
+	}
+
+	if d.err != nil {
+		return d.err
+	}
+
+	s.shapes = shapes
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.cellMap = cellMap
+	s.cells = cells
+	s.status = fresh
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+
+	return nil
+}
+
+func decodeShape(d *decoder, tag typeTag) (Shape, error) {
+	switch tag {
+	case typeTagPolygon:
+		p := &Polygon{}
+		if err := p.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPolyline:
+		p := &Polyline{}
+		if err := p.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPointVector:
+		pv := &PointVector{}
+		if err := pv.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return pv, nil
+	case typeTagLaxPolyline:
+		lp := &LaxPolyline{}
+		if err := lp.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return lp, nil
+	case typeTagLaxPolygon:
+		lp := &LaxPolygon{}
+		if err := lp.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return lp, nil
+	case typeTagLaxLoop:
+		ll := &LaxLoop{}
+		if err := ll.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return ll, nil
+	case typeTagLoop:
+		l := &Loop{}
+		if err := l.Decode(d.r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	default:
+		return nil, fmt.Errorf("unknown shape type tag %d", tag)
+	}
+}
