+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 7 {
+		t.Fatalf("decoded.Len() = %d, want 7", decoded.Len())
+	}
+
+	for id := int32(0); id < 7; id++ {
+		orig := index.Shape(id)
+		dec := decoded.Shape(id)
+		if dec.NumEdges() != orig.NumEdges() {
+			t.Errorf("shape %d NumEdges = %d, want %d", id, dec.NumEdges(), orig.NumEdges())
+		}
+		if dec.NumChains() != orig.NumChains() {
+			t.Errorf("shape %d NumChains = %d, want %d", id, dec.NumChains(), orig.NumChains())
