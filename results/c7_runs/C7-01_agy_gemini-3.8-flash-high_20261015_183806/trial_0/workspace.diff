+
+	test('preceding and following non-zero are never parameters', () => {
+		const q = pgDialect.sqlToQuery(
+			rowNumber().over({ frame: rows({ from: preceding(5), to: following(10) }) }),
+		);
+		expect(q.sql).toBe('row_number() over (rows between 5 preceding and 10 following)');
+		expect(q.params).toEqual([]);
