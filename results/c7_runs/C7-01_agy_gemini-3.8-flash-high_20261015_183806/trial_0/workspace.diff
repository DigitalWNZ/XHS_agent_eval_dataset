+describe('ntile and nthValue argument validation', () => {
+	test('ntile rejects zero', () => {
+		expect(() => ntile(0)).toThrowError(/ntile.*0/);
+	});
+
+	test('ntile rejects negative', () => {
+		expect(() => ntile(-3)).toThrowError(/ntile.*-3/);
+	});
+
+	test('ntile rejects non-integer', () => {
+		expect(() => ntile(2.5)).toThrowError(/ntile.*2\.5/);
+	});
+
+	test('nthValue rejects zero', () => {
+		expect(() => nthValue(pgUsers.id, 0)).toThrowError(/nthValue.*0/);
+	});
+
+	test('nthValue rejects negative', () => {
+		expect(() => nthValue(pgUsers.id, -1)).toThrowError(/nthValue.*-1/);
+	});
+
+	test('nthValue rejects non-integer', () => {
+		expect(() => nthValue(pgUsers.id, 1.5)).toThrowError(/nthValue.*1\.5/);
+	});
+});
