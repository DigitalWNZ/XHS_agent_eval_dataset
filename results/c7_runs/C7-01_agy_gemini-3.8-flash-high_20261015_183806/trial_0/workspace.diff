+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import type { DriverValueDecoder } from '../sql.ts';
+import { isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type InferColumnData<T> = T extends Column<any> ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: T extends SQLWrapper ? any
+	: T;
+
+export type InferDefaultValue<T> = T extends Column<any> ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: T;
+
+export interface FrameBoundary {
+	readonly type: 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing';
+	readonly offset?: number;
+	readonly order: number;
+	getSQL(): SQL;
+}
+
+export const unboundedPreceding: FrameBoundary = {
+	type: 'unboundedPreceding',
+	order: -Infinity,
+	getSQL(): SQL {
+		return sql`unbounded preceding`;
+	},
+};
+
+export const currentRow: FrameBoundary = {
+	type: 'currentRow',
+	order: 0,
+	getSQL(): SQL {
+		return sql`current row`;
+	},
+};
+
+export const unboundedFollowing: FrameBoundary = {
+	type: 'unboundedFollowing',
+	order: Infinity,
+	getSQL(): SQL {
+		return sql`unbounded following`;
+	},
+};
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding: expected a non-negative integer, received ${offset}`);
+	}
+	return {
+		type: 'preceding',
+		offset,
+		order: -offset,
+		getSQL(): SQL {
+			return sql`${sql.raw(String(offset))} preceding`;
+		},
+	};
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following: expected a non-negative integer, received ${offset}`);
+	}
+	return {
+		type: 'following',
+		offset,
+		order: offset,
+		getSQL(): SQL {
+			return sql`${sql.raw(String(offset))} following`;
+		},
+	};
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class Frame implements SQLWrapper {
+	static readonly [entityKind]: string = 'Frame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly from: FrameBoundary,
+		readonly to?: FrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		if (this.to) {
+			return sql`${sql.raw(this.type)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.from.getSQL()}`;
+	}
+}
+
+function createFrame(type: 'rows' | 'range', spec: FrameSpec | FrameBoundary, toArg?: FrameBoundary): Frame {
+	let from: FrameBoundary;
+	let to: FrameBoundary | undefined;
+
+	if (spec && typeof spec === 'object' && 'from' in spec) {
+		from = spec.from;
+		to = spec.to;
+	} else if (spec && typeof spec === 'object' && 'type' in spec) {
+		from = spec as FrameBoundary;
+		to = toArg;
+	} else {
+		throw new Error('Frame specification must include a "from" boundary');
+	}
+
+	if (!from || typeof from.order !== 'number') {
+		throw new Error('Frame specification must include a valid "from" boundary');
+	}
+
+	const toOrder = to !== undefined ? to.order : (from.order > 0 ? 0 : undefined);
+	if (toOrder !== undefined && from.order > toOrder) {
+		throw new Error(`The "from" boundary must not be ordered after the "to" boundary in ${type} frame`);
+	}
+
+	return new Frame(type, from, to);
+}
+
+export function rows(spec: FrameSpec | FrameBoundary, toArg?: FrameBoundary): Frame {
+	return createFrame('rows', spec, toArg);
+}
+
+export function range(spec: FrameSpec | FrameBoundary, toArg?: FrameBoundary): Frame {
+	return createFrame('range', spec, toArg);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<SQLWrapper>;
+	orderBy?: ValueOrArray<SQLWrapper>;
+	frame?: Frame | SQLWrapper;
+}
+
+export function buildWindowSpec(spec?: WindowSpec | SQLWrapper | string): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+	if (typeof spec === 'string') {
+		return sql`${sql.identifier(spec)}`;
+	}
+	if (isSQLWrapper(spec)) {
+		return spec.getSQL();
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionList.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderList.length > 0) {
+			parts.push(sql`order by ${sql.join(orderList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		const frameSql = isSQLWrapper(spec.frame) ? spec.frame.getSQL() : spec.frame;
+		parts.push(frameSql as SQL);
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not contain only whitespace');
+	}
+}
+
+export class WindowFunctionBuilder<T> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare _: {
+		brand: 'WindowFunctionBuilder';
+		type: T;
+	};
+
+	private decoder?: DriverValueDecoder<T, any> | ((value: any) => T);
+
+	constructor(protected readonly sqlFn: SQL) {}
+
+	mapWith(decoder: DriverValueDecoder<T, any> | ((value: any) => T)): this {
+		this.decoder = decoder;
+		return this;
+	}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		let overClause: SQL;
+
+		if (typeof spec === 'string') {
+			overClause = sql` over ${sql.identifier(spec)}`;
+		} else if (!spec) {
+			overClause = sql` over ()`;
+		} else {
+			const inner = buildWindowSpec(spec);
+			if (inner.queryChunks.length === 0) {
+				overClause = sql` over ()`;
+			} else {
+				overClause = sql` over (${inner})`;
+			}
+		}
+
+		const resultSql = sql<T>`${this.sqlFn}${overClause}`;
+		if (this.decoder) {
+			resultSql.mapWith(this.decoder as any);
+		}
+		return resultSql;
+	}
+
+	as(alias: string): SQL.Aliased<T> {
+		return this.over().as(alias);
+	}
+
+	getSQL(): SQL<T> {
+		return this.over();
+	}
+}
+
+// Ranking helpers
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`row_number()`).mapWith(Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`rank()`).mapWith(Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`dense_rank()`).mapWith(Number);
+}
+
+export function ntile(n: number): WindowFunctionBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile: expected a positive integer, received ${n}`);
+	}
+	return new WindowFunctionBuilder<number>(sql`ntile(${sql.raw(String(n))})`).mapWith(Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`percent_rank()`).mapWith(Number);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`cume_dist()`).mapWith(Number);
+}
+
+// Offset helpers
+export function lag<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowFunctionBuilder<InferColumnData<T> | null>;
+export function lag<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunctionBuilder<NonNullable<InferColumnData<T>> | InferDefaultValue<TDefault>>;
+export function lag<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<any> {
+	let fnSql: SQL;
+
+	if (offset === undefined && defaultValue === undefined) {
+		fnSql = sql`lag(${value})`;
+	} else if (defaultValue === undefined) {
+		fnSql = sql`lag(${value}, ${sql.raw(String(offset))})`;
+	} else {
+		const off = offset === undefined ? 1 : offset;
+		fnSql = sql`lag(${value}, ${sql.raw(String(off))}, ${defaultValue})`;
+	}
+
+	const builder = new WindowFunctionBuilder(fnSql);
+	if (is(value, Column)) {
+		builder.mapWith(value as any);
+	}
+	return builder;
+}
+
+export function lead<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowFunctionBuilder<InferColumnData<T> | null>;
+export function lead<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunctionBuilder<NonNullable<InferColumnData<T>> | InferDefaultValue<TDefault>>;
+export function lead<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<any> {
+	let fnSql: SQL;
+
+	if (offset === undefined && defaultValue === undefined) {
+		fnSql = sql`lead(${value})`;
+	} else if (defaultValue === undefined) {
+		fnSql = sql`lead(${value}, ${sql.raw(String(offset))})`;
+	} else {
+		const off = offset === undefined ? 1 : offset;
+		fnSql = sql`lead(${value}, ${sql.raw(String(off))}, ${defaultValue})`;
+	}
+
+	const builder = new WindowFunctionBuilder(fnSql);
+	if (is(value, Column)) {
+		builder.mapWith(value as any);
+	}
+	return builder;
+}
+
+export function firstValue<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<InferColumnData<T> | null> {
+	const builder = new WindowFunctionBuilder<InferColumnData<T> | null>(sql`first_value(${value})`);
+	if (is(value, Column)) {
+		builder.mapWith(value as any);
+	}
+	return builder;
+}
+
+export function lastValue<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<InferColumnData<T> | null> {
+	const builder = new WindowFunctionBuilder<InferColumnData<T> | null>(sql`last_value(${value})`);
+	if (is(value, Column)) {
+		builder.mapWith(value as any);
+	}
+	return builder;
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	nth: number,
+): WindowFunctionBuilder<InferColumnData<T> | null> {
+	if (typeof nth !== 'number' || !Number.isInteger(nth) || nth <= 0) {
+		throw new Error(`nthValue: expected a positive integer, received ${nth}`);
+	}
+	const builder = new WindowFunctionBuilder<InferColumnData<T> | null>(
+		sql`nth_value(${value}, ${sql.raw(String(nth))})`,
+	);
+	if (is(value, Column)) {
+		builder.mapWith(value as any);
+	}
+	return builder;
+}
+
+// Aggregate helpers
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder<string | null>(sql`sum(${expression})`).mapWith(String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder<string | null>(sql`avg(${expression})`).mapWith(String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const builder = new WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null>(
+		sql`min(${expression})`,
+	);
+	builder.mapWith(is(expression, Column) ? expression : (String as any));
+	return builder;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const builder = new WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null>(
+		sql`max(${expression})`,
+	);
+	builder.mapWith(is(expression, Column) ? expression : (String as any));
+	return builder;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	const fnSql = expression ? sql`count(${expression})` : sql`count(*)`;
+	return new WindowFunctionBuilder<number>(fnSql).mapWith(Number);
+}
