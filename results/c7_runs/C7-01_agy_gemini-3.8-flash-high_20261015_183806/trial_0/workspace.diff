+describe('OVER specifications', () => {
+	test('empty over() appends "over ()"', () => {
+		expect(pgDialect.sqlToQuery(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(pgDialect.sqlToQuery(rowNumber().over({})).sql).toBe('row_number() over ()');
+		expect(pgDialect.sqlToQuery(rowNumber().over({ partitionBy: undefined, orderBy: undefined, frame: undefined })).sql)
+			.toBe('row_number() over ()');
+	});
+
+	test('named window reference compiles to OVER followed by quoted name without parentheses', () => {
+		expect(pgDialect.sqlToQuery(rowNumber().over('my_window')).sql).toBe('row_number() over "my_window"');
+		expect(mysqlDialect.sqlToQuery(rowNumber().over('my_window')).sql).toBe('row_number() over `my_window`');
+		expect(sqliteDialect.sqlToQuery(rowNumber().over('my_window')).sql).toBe('row_number() over "my_window"');
+	});
+
+	test('inline spec with partitionBy, orderBy, and frame', () => {
+		const query = rowNumber().over({
+			partitionBy: pgUsers.name,
+			orderBy: desc(pgUsers.salary),
+			frame: rows({ from: unboundedPreceding, to: currentRow }),
+		});
+		expect(pgDialect.sqlToQuery(query).sql).toBe(
+			'row_number() over (partition by "users"."name" order by "users"."salary" desc rows between unbounded preceding and current row)',
+		);
+	});
+
+	test('inline spec with array partitionBy and orderBy', () => {
+		const query = rowNumber().over({
+			partitionBy: [pgUsers.id, pgUsers.name],
