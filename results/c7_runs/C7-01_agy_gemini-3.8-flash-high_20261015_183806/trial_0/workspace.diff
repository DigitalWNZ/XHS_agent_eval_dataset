+describe('Frame constructors and boundary validation', () => {
+	test('preceding and following reject negative and non-integers referencing helper name', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(1.5)).toThrowError(/preceding/);
+		expect(() => following(-1)).toThrowError(/following/);
+		expect(() => following(2.7)).toThrowError(/following/);
+	});
+
+	test('rows and range frame boundary order validation referencing "from"', () => {
+		expect(() => rows({ from: following(1), to: currentRow })).toThrowError(/from/);
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+		expect(() => rows({ from: following(5), to: following(2) })).toThrowError(/from/);
+		expect(() => rows({ from: preceding(2), to: preceding(5) })).toThrowError(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: currentRow })).toThrowError(/from/);
+		expect(() => rows({ from: following(1) })).toThrowError(/from/);
+		expect(() => range({ from: following(1), to: currentRow })).toThrowError(/from/);
+		expect(() => rows({} as any)).toThrowError(/from/);
+	});
+
+	test('rows and range compile correctly', () => {
+		const r1 = rows({ from: unboundedPreceding, to: currentRow });
+		expect(pgDialect.sqlToQuery(r1.getSQL()).sql).toBe('rows between unbounded preceding and current row');
+
+		const r2 = range({ from: currentRow, to: unboundedFollowing });
+		expect(pgDialect.sqlToQuery(r2.getSQL()).sql).toBe('range between current row and unbounded following');
+
+		const r3 = rows({ from: preceding(2), to: following(3) });
+		expect(pgDialect.sqlToQuery(r3.getSQL()).sql).toBe('rows between 2 preceding and 3 following');
+
+		const r4 = rows({ from: unboundedPreceding });
+		expect(pgDialect.sqlToQuery(r4.getSQL()).sql).toBe('rows unbounded preceding');
+
+		const r5 = rows({ from: currentRow, to: currentRow });
+		expect(pgDialect.sqlToQuery(r5.getSQL()).sql).toBe('rows between current row and current row');
+	});
+});
