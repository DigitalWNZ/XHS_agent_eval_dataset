+describe('Type inference for value-access functions', () => {
+	test('firstValue, lastValue, nthValue are typed nullable', () => {
+		const fv = firstValue(pgUsers.id).over();
+		expectTypeOf(fv).toEqualTypeOf<SQL<number | null>>();
+
+		const lv = lastValue(pgUsers.name).over();
+		expectTypeOf(lv).toEqualTypeOf<SQL<string | null>>();
+
+		const nv = nthValue(pgUsers.id, 2).over();
+		expectTypeOf(nv).toEqualTypeOf<SQL<number | null>>();
+	});
+
+	test('lag and lead are typed nullable when default is omitted', () => {
+		const l1 = lag(pgUsers.id).over();
+		expectTypeOf(l1).toEqualTypeOf<SQL<number | null>>();
+
+		const l2 = lag(pgUsers.id, 1).over();
+		expectTypeOf(l2).toEqualTypeOf<SQL<number | null>>();
+
+		const ld1 = lead(pgUsers.name).over();
+		expectTypeOf(ld1).toEqualTypeOf<SQL<string | null>>();
+
+		const ld2 = lead(pgUsers.name, 2).over();
+		expectTypeOf(ld2).toEqualTypeOf<SQL<string | null>>();
+	});
+
+	test('lag and lead strip null when default value is provided', () => {
+		const lDefault = lag(pgUsers.id, 1, 0).over();
+		expectTypeOf(lDefault).toEqualTypeOf<SQL<number>>();
+
+		const ldDefault = lead(pgUsers.name, 1, 'none').over();
+		expectTypeOf(ldDefault).toEqualTypeOf<SQL<string>>();
+
+		// When column is already nullable (salary: number | null):
+		const lNullableWithDefault = lag(pgUsers.salary, 1, 0).over();
+		expectTypeOf(lNullableWithDefault).toEqualTypeOf<SQL<number>>();
