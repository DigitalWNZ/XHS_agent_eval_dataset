+describe('Window function helpers (snake_case SQL names & return types)', () => {
+	test('ranking helpers compile to snake_case names', () => {
+		expect(pgDialect.sqlToQuery(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(pgDialect.sqlToQuery(rank().over()).sql).toBe('rank() over ()');
+		expect(pgDialect.sqlToQuery(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(pgDialect.sqlToQuery(ntile(4).over()).sql).toBe('ntile(4) over ()');
+		expect(pgDialect.sqlToQuery(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(pgDialect.sqlToQuery(cumeDist().over()).sql).toBe('cume_dist() over ()');
+	});
+
+	test('offset helpers compile to snake_case names', () => {
+		expect(pgDialect.sqlToQuery(lag(pgUsers.id).over()).sql).toBe('lag("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(lead(pgUsers.id).over()).sql).toBe('lead("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(firstValue(pgUsers.id).over()).sql).toBe('first_value("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(lastValue(pgUsers.id).over()).sql).toBe('last_value("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(nthValue(pgUsers.id, 2).over()).sql).toBe('nth_value("users"."id", 2) over ()');
+	});
+
+	test('aggregates compile to correct SQL names', () => {
+		expect(pgDialect.sqlToQuery(windowSum(pgUsers.id).over()).sql).toBe('sum("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(windowAvg(pgUsers.id).over()).sql).toBe('avg("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(windowMin(pgUsers.id).over()).sql).toBe('min("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(windowMax(pgUsers.id).over()).sql).toBe('max("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(windowCount(pgUsers.id).over()).sql).toBe('count("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(windowCount().over()).sql).toBe('count(*) over ()');
+	});
+});
