+describe('Positional-argument trailing optional arguments', () => {
+	test('lag optional offset and default', () => {
+		expect(pgDialect.sqlToQuery(lag(pgUsers.id).over()).sql).toBe('lag("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(lag(pgUsers.id, 2).over()).sql).toBe('lag("users"."id", 2) over ()');
+		const q = pgDialect.sqlToQuery(lag(pgUsers.id, 2, 0).over());
+		expect(q.sql).toBe('lag("users"."id", 2, $1) over ()');
+		expect(q.params).toEqual([0]);
+	});
+
+	test('lead optional offset and default', () => {
+		expect(pgDialect.sqlToQuery(lead(pgUsers.id).over()).sql).toBe('lead("users"."id") over ()');
+		expect(pgDialect.sqlToQuery(lead(pgUsers.id, 3).over()).sql).toBe('lead("users"."id", 3) over ()');
+		const q = pgDialect.sqlToQuery(lead(pgUsers.id, 3, 99).over());
+		expect(q.sql).toBe('lead("users"."id", 3, $1) over ()');
+		expect(q.params).toEqual([99]);
+	});
+
+	test('windowCount with and without argument', () => {
+		expect(pgDialect.sqlToQuery(windowCount().over()).sql).toBe('count(*) over ()');
+		expect(pgDialect.sqlToQuery(windowCount(pgUsers.id).over()).sql).toBe('count("users"."id") over ()');
+	});
+});
