diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..a33f265
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,477 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const (
+	chunkSize   = 64 * 1024 // 64KB
+	magic1      = 0x4F
+	magic2      = 0x44
+	version1    = 0x01
+	nonceSize   = 12
+	tagSize     = 16
+	hmacSize    = 32
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key length")
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"key_source"`
+	KeyEnvVar  string `yaml:"key_env_var"`
+	KeyFile    string `yaml:"key_file"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when enabled")
+	}
+
+	switch source {
+	case "env":
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("key_env_var is required for env key source")
+		}
+	case "file":
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("key_file is required for file key source")
+		}
+	case "literal":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+	case "derive":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+		saltBytes, err := decodeBase64(strings.TrimSpace(c.Salt))
+		if err != nil {
+			return fmt.Errorf("invalid base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return errors.New("salt must be at least 16 bytes")
+		}
+	default:
+		return fmt.Errorf("unsupported key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	data, err := base64.StdEncoding.DecodeString(s)
+	if err != nil {
+		data, err = base64.RawStdEncoding.DecodeString(s)
+	}
+	return data, err
+}
+
+func decodeBase64Key(s string) ([]byte, error) {
+	data, err := decodeBase64(s)
+	if err != nil {
+		return nil, err
+	}
+	if len(data) != 32 {
+		return nil, fmt.Errorf("key must be 32 bytes, got %d: %w", len(data), ErrInvalidKey)
+	}
+	return data, nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		if strings.TrimSpace(cfg.KeyEnvVar) == "" {
+			return nil, errors.New("encryption key environment variable name is required")
+		}
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %s is not set", cfg.KeyEnvVar)
+		}
+		key, err := decodeBase64Key(strings.TrimSpace(val))
+		if err != nil {
+			return nil, fmt.Errorf("invalid encryption key in env var %s: %w", cfg.KeyEnvVar, err)
+		}
+		return key, nil
+
+	case "file":
+		if strings.TrimSpace(cfg.KeyFile) == "" {
+			return nil, errors.New("encryption key file path is required")
+		}
+		data, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file: %w", err)
+		}
+		key, err := decodeBase64Key(strings.TrimSpace(string(data)))
+		if err != nil {
+			return nil, fmt.Errorf("invalid encryption key in file %s: %w", cfg.KeyFile, err)
+		}
+		return key, nil
+
+	case "literal":
+		if strings.TrimSpace(cfg.Key) == "" {
+			return nil, errors.New("encryption key is required")
+		}
+		key, err := decodeBase64Key(strings.TrimSpace(cfg.Key))
+		if err != nil {
+			return nil, fmt.Errorf("invalid encryption inline key: %w", err)
+		}
+		return key, nil
+
+	case "derive":
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("empty passphrase rejected for key derivation")
+		}
+		if strings.TrimSpace(cfg.Salt) == "" {
+			return nil, errors.New("salt is required for key derivation")
+		}
+		saltBytes, err := decodeBase64(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, errors.New("salt must be at least 16 bytes")
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, 4096, 32, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("encryption key must be 32 bytes: %w", ErrInvalidKey)
+	}
+	k := make([]byte, 32)
+	copy(k, key)
+	return &Encryptor{key: k}, nil
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		panic(err)
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		panic(err)
+	}
+	mac := hmac.New(sha256.New, e.key)
+	return &encryptWriter{
+		w:    w,
+		key:  e.key,
+		aead: aead,
+		mac:  mac,
+		buf:  make([]byte, 0, chunkSize),
+	}
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{magic1, magic2, version1}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(chunk []byte) error {
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.aead.Seal(nil, nonce, chunk, nil)
+	chunkLen := uint32(len(nonce) + len(ciphertext))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	ew.mac.Write(lenBuf[:])
+
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	ew.mac.Write(nonce)
+
+	if _, err := ew.w.Write(ciphertext); err != nil {
+		return err
+	}
+	ew.mac.Write(ciphertext)
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed EncryptWriter")
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		space := chunkSize - len(ew.buf)
+		if space > len(p) {
+			ew.buf = append(ew.buf, p...)
+			totalWritten += len(p)
+			break
+		}
+		ew.buf = append(ew.buf, p[:space]...)
+		p = p[space:]
+		totalWritten += space
+
+		if err := ew.writeChunk(ew.buf); err != nil {
+			return totalWritten, err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.writeChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = nil
+	}
+
+	var sentinel [4]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		return err
+	}
+
+	hmacVal := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(hmacVal); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	aead        cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	done        bool
+	outBuf      []byte
+	outOffset   int
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("encryption key must be 32 bytes: %w", ErrInvalidKey)
+	}
+	k := make([]byte, 32)
+	copy(k, key)
+	return &decryptReader{
+		r:   r,
+		key: k,
+	}, nil
+}
+
+func (dr *decryptReader) init() error {
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return err
+	}
+	dr.aead = aead
+	dr.mac = hmac.New(sha256.New, dr.key)
+
+	var header [3]byte
+	_, err = io.ReadFull(dr.r, header[:])
+	if err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated data while reading header: %w", err)
+		}
+		return err
+	}
+
+	if header[0] != magic1 || header[1] != magic2 {
+		return errors.New("invalid header: magic bytes mismatch")
+	}
+
+	if header[2] != version1 {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			return 0, err
+		}
+	}
+
+	if dr.outOffset < len(dr.outBuf) {
+		n := copy(p, dr.outBuf[dr.outOffset:])
+		dr.outOffset += n
+		if dr.outOffset == len(dr.outBuf) {
+			dr.outBuf = dr.outBuf[:0]
+			dr.outOffset = 0
+		}
+		return n, nil
+	}
+
+	if dr.done {
+		return 0, io.EOF
+	}
+
+	for {
+		var lenBuf [4]byte
+		_, err := io.ReadFull(dr.r, lenBuf[:])
+		if err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return 0, fmt.Errorf("truncated data while reading chunk length: %w", err)
+			}
+			return 0, err
+		}
+
+		chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+
+		if chunkLen == 0 {
+			var hmacBuf [32]byte
+			_, err := io.ReadFull(dr.r, hmacBuf[:])
+			if err != nil {
+				if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+					return 0, fmt.Errorf("truncated data while reading hmac: %w", err)
+				}
+				return 0, err
+			}
+
+			expectedHMAC := hmacBuf[:]
+			computedHMAC := dr.mac.Sum(nil)
+
+			if !hmac.Equal(expectedHMAC, computedHMAC) {
+				return 0, errors.New("integrity check failed: HMAC mismatch")
+			}
+
+			dr.done = true
+			return 0, io.EOF
+		}
+
+		dr.mac.Write(lenBuf[:])
+
+		payload := make([]byte, chunkLen)
+		_, err = io.ReadFull(dr.r, payload)
+		if err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return 0, fmt.Errorf("truncated data while reading chunk body: %w", err)
+			}
+			return 0, err
+		}
+
+		dr.mac.Write(payload)
+
+		if chunkLen < nonceSize+tagSize {
+			return 0, errors.New("integrity check failed: invalid chunk size")
+		}
+
+		nonce := payload[:nonceSize]
+		ciphertextWithTag := payload[nonceSize:]
+
+		plaintext, err := dr.aead.Open(nil, nonce, ciphertextWithTag, nil)
+		if err != nil {
+			return 0, fmt.Errorf("integrity check failed: %w", err)
+		}
+
+		if len(plaintext) == 0 {
+			continue
+		}
+
+		dr.outBuf = plaintext
+		dr.outOffset = 0
+
+		n := copy(p, dr.outBuf)
+		dr.outOffset += n
+		if dr.outOffset == len(dr.outBuf) {
+			dr.outBuf = dr.outBuf[:0]
+			dr.outOffset = 0
+		}
+		return n, nil
+	}
+}
