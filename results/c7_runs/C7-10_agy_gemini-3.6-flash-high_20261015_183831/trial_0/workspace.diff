+++ b/encryption/encryption_test.go
@@ -0,0 +1,271 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptor(t *testing.T) {
+	key32 := make([]byte, 32)
+	enc, err := NewEncryptor(key32)
+	require.NoError(t, err)
+	assert.NotNil(t, enc)
+
+	key16 := make([]byte, 16)
+	_, err = NewEncryptor(key16)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+}
+
+func TestEncryptDecryptRoundtrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Test data > 64KB (e.g. 150KB)
+	originalData := make([]byte, 150*1024)
+	_, err = rand.Read(originalData)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+
+	// Write in multiple small chunks
+	chunkSize := 1024
+	for i := 0; i < len(originalData); i += chunkSize {
+		end := i + chunkSize
+		if end > len(originalData) {
+			end = len(originalData)
+		}
+		n, werr := ew.Write(originalData[i:end])
+		require.NoError(t, werr)
+		assert.Equal(t, end-i, n)
+	}
+
+	// Test idempotency of Close
+	require.NoError(t, ew.Close())
+	require.NoError(t, ew.Close())
+
+	encryptedData := buf.Bytes()
+	assert.True(t, len(encryptedData) > len(originalData))
+
+	// Decrypt
+	dr, err := DecryptReader(bytes.NewReader(encryptedData), key)
+	require.NoError(t, err)
+
+	decryptedData, err := io.ReadAll(dr)
+	require.NoError(t, err)
+	assert.Equal(t, originalData, decryptedData)
+}
+
+func TestNonceUniqueness(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("hello world repeating content")
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+}
+
+func TestDecryptErrors(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("secret payload")
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+
+	validEncrypted := buf.Bytes()
+
+	t.Run("invalid key length for DecryptReader", func(t *testing.T) {
+		_, err := DecryptReader(bytes.NewReader(validEncrypted), make([]byte, 16))
+		require.Error(t, err)
+		assert.True(t, errors.Is(err, ErrInvalidKey))
+	})
+
+	t.Run("wrong magic", func(t *testing.T) {
+		corrupted := append([]byte(nil), validEncrypted...)
+		corrupted[0] = 0x00
+		dr, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid header")
+	})
+
+	t.Run("unsupported version", func(t *testing.T) {
+		corrupted := append([]byte(nil), validEncrypted...)
+		corrupted[2] = 0x02
+		dr, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported version")
+	})
+
+	t.Run("corrupted ciphertext / integrity failure", func(t *testing.T) {
+		corrupted := append([]byte(nil), validEncrypted...)
+		// Flip a bit in the middle of ciphertext
+		corrupted[20] ^= 0xFF
+		dr, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "integrity")
+	})
+
+	t.Run("wrong key", func(t *testing.T) {
+		wrongKey := make([]byte, 32)
+		wrongKey[0] = 0xFF
+		dr, err := DecryptReader(bytes.NewReader(validEncrypted), wrongKey)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("truncated header", func(t *testing.T) {
+		dr, err := DecryptReader(bytes.NewReader(validEncrypted[:2]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("truncated chunk", func(t *testing.T) {
+		dr, err := DecryptReader(bytes.NewReader(validEncrypted[:10]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+}
+
+func TestConfigValidate(t *testing.T) {
+	// Disabled config is valid
+	cfg := Config{Enabled: false}
+	assert.NoError(t, cfg.Validate())
+
+	// Enabled with empty source
+	cfg = Config{Enabled: true}
+	assert.Error(t, cfg.Validate())
+
+	// Enabled with unsupported source
+	cfg = Config{Enabled: true, KeySource: "invalid"}
+	assert.Error(t, cfg.Validate())
+
+	// Env source valid
+	cfg = Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}
+	assert.NoError(t, cfg.Validate())
+
+	// Env source mutually exclusive error
+	cfg = Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", KeyFile: "file.txt"}
+	err := cfg.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// File source valid
+	cfg = Config{Enabled: true, KeySource: "file", KeyFile: "key.txt"}
+	assert.NoError(t, cfg.Validate())
+
+	// Literal source valid
+	cfg = Config{Enabled: true, KeySource: "literal", Key: "base64key"}
+	assert.NoError(t, cfg.Validate())
+
+	// Derive source valid
+	salt16 := base64.StdEncoding.EncodeToString(make([]byte, 16))
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: salt16}
+	assert.NoError(t, cfg.Validate())
+
+	// Derive short salt error
+	salt10 := base64.StdEncoding.EncodeToString(make([]byte, 10))
+	cfg = Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: salt10}
+	assert.Error(t, cfg.Validate())
+}
+
+func TestLoadKey(t *testing.T) {
+	rawKey := make([]byte, 32)
+	_, err := rand.Read(rawKey)
+	require.NoError(t, err)
+	encodedKey := base64.StdEncoding.EncodeToString(rawKey)
+
+	t.Run("env", func(t *testing.T) {
+		t.Setenv("TEST_KEY_ENV", encodedKey)
+		key, err := LoadKey(Config{KeySource: "env", KeyEnvVar: "TEST_KEY_ENV"})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, key)
+
+		// Unset env
+		_, err = LoadKey(Config{KeySource: "env", KeyEnvVar: "UNSET_KEY_ENV"})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "key")
+	})
+
+	t.Run("literal", func(t *testing.T) {
+		key, err := LoadKey(Config{KeySource: "literal", Key: encodedKey})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, key)
+	})
+
+	t.Run("file", func(t *testing.T) {
+		tmpFile, err := os.CreateTemp("", "keyfile")
+		require.NoError(t, err)
+		defer os.Remove(tmpFile.Name())
+
+		_, err = tmpFile.WriteString("  " + encodedKey + " \n")
+		require.NoError(t, err)
+		tmpFile.Close()
+
+		key, err := LoadKey(Config{KeySource: "file", KeyFile: tmpFile.Name()})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, key)
+	})
+
+	t.Run("derive", func(t *testing.T) {
+		salt := base64.StdEncoding.EncodeToString([]byte("1234567890123456"))
+		cfg := Config{KeySource: "derive", Passphrase: "secretpassphrase", Salt: salt}
+
+		key1, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Len(t, key1, 32)
+
+		// Deterministic check
+		key2, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, key1, key2)
+
+		// Empty passphrase rejected
+		_, err = LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: salt})
+		require.Error(t, err)
+	})
+}
