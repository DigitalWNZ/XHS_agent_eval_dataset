+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	nloops := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	loops := make([][]Point, 0, min(int(nloops), 1024))
+	var totalVertices uint64
+	for range nloops {
+		nv := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if nv > maxEncodedVertices || totalVertices+nv > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", nv, maxEncodedVertices)
+			return
+		}
+		totalVertices += nv
+		pts := make([]Point, 0, min(int(nv), 1024))
+		for range nv {
+			pt := d.readPoint()
+			if d.err != nil {
+				return
+			}
+			pts = append(pts, pt)
+		}
+		loops = append(loops, pts)
+	}
+	*p = *LaxPolygonFromPoints(loops)
 }
 
