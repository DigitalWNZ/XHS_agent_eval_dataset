+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	// Verify that got is already fresh without calling Build().
+	if !got.IsFresh() {
+		t.Fatalf("decoded ShapeIndex is not fresh immediately after Decode")
+	}
+
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.nextID != want.nextID {
+		t.Fatalf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	if got.maxEdgesPerCell != want.maxEdgesPerCell {
+		t.Errorf("maxEdgesPerCell = %d, want %d", got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+
+	for id := int32(0); id < want.nextID; id++ {
+		assertShapeEqual(t, id, got.Shape(id), want.Shape(id))
+	}
+
+	if !slices.Equal(got.cells, want.cells) {
+		t.Fatalf("cells mismatch: got %d cells %v, want %d cells %v", len(got.cells), got.cells, len(want.cells), want.cells)
+	}
+	if len(got.cellMap) != len(want.cellMap) {
+		t.Fatalf("len(cellMap) = %d, want %d", len(got.cellMap), len(want.cellMap))
+	}
+	for _, cellID := range want.cells {
+		gotCell := got.cellMap[cellID]
+		wantCell := want.cellMap[cellID]
+		if gotCell == nil {
+			t.Fatalf("missing cell %v in decoded cellMap", cellID)
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Fatalf("cell %v len(shapes) = %d, want %d", cellID, len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for i, wantClipped := range wantCell.shapes {
+			gotClipped := gotCell.shapes[i]
+			if gotClipped.shapeID != wantClipped.shapeID {
+				t.Errorf("cell %v clipped[%d].shapeID = %d, want %d", cellID, i, gotClipped.shapeID, wantClipped.shapeID)
+			}
+			if gotClipped.containsCenter != wantClipped.containsCenter {
+				t.Errorf("cell %v clipped[%d].containsCenter = %v, want %v", cellID, i, gotClipped.containsCenter, wantClipped.containsCenter)
+			}
+			if !slices.Equal(gotClipped.edges, wantClipped.edges) {
+				t.Errorf("cell %v clipped[%d].edges = %v, want %v", cellID, i, gotClipped.edges, wantClipped.edges)
+			}
+		}
+	}
+
+	quadraticValidate(t, got)
+	testIteratorMethods(t, got)
+}
