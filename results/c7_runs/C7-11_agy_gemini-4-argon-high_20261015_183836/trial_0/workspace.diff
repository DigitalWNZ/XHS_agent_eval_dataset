+// genericShape is used to round-trip custom Shape implementations that are not
+// one of the built-in s2 Shape types.
+type genericShape struct {
+	edges     []Edge
+	chains    []Chain
+	refPt     ReferencePoint
+	dimension int
+	isEmpty   bool
+	isFull    bool
+	tag       typeTag
+}
+
+func (g *genericShape) NumEdges() int                  { return len(g.edges) }
+func (g *genericShape) Edge(i int) Edge                { return g.edges[i] }
+func (g *genericShape) ReferencePoint() ReferencePoint { return g.refPt }
+func (g *genericShape) NumChains() int                 { return len(g.chains) }
+func (g *genericShape) Chain(i int) Chain              { return g.chains[i] }
+func (g *genericShape) ChainEdge(i, j int) Edge        { return g.edges[g.chains[i].Start+j] }
+func (g *genericShape) Dimension() int                 { return g.dimension }
+func (g *genericShape) IsEmpty() bool                  { return g.isEmpty }
+func (g *genericShape) IsFull() bool                   { return g.isFull }
+func (g *genericShape) typeTag() typeTag               { return g.tag }
+func (g *genericShape) privateInterface()              {}
+func (g *genericShape) ChainPosition(edgeID int) ChainPosition {
+	for i := len(g.chains) - 1; i >= 0; i-- {
+		if g.chains[i].Length > 0 && edgeID >= g.chains[i].Start && edgeID < g.chains[i].Start+g.chains[i].Length {
+			return ChainPosition{i, edgeID - g.chains[i].Start}
+		}
+	}
+	return ChainPosition{0, edgeID}
+}
+
+func encodeShape(e *encoder, s Shape) {
+	if e.err != nil {
+		return
+	}
+	if s == nil {
+		e.err = errors.New("s2: cannot encode nil shape")
+		return
+	}
+	switch v := s.(type) {
+	case *Polygon:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil Polygon")
+			return
+		}
+		e.writeUint8(shapeTypePolygon)
+		if v.numVertices == 0 {
+			v.encodeCompressed(e, MaxLevel, nil)
+		} else {
+			v.encodeLossless(e)
+		}
+	case *Polyline:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil Polyline")
+			return
+		}
+		e.writeUint8(shapeTypePolyline)
+		v.encode(e)
+	case *PointVector:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil PointVector")
+			return
+		}
+		e.writeUint8(shapeTypePointVector)
+		v.encode(e)
+	case *LaxPolyline:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil LaxPolyline")
+			return
+		}
+		e.writeUint8(shapeTypeLaxPolyline)
+		v.encode(e)
+	case *LaxPolygon:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil LaxPolygon")
+			return
+		}
+		e.writeUint8(shapeTypeLaxPolygon)
+		v.encode(e)
+	case *Loop:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil Loop")
+			return
+		}
+		e.writeUint8(shapeTypeLoop)
+		v.encode(e)
+	case *LaxLoop:
+		if v == nil {
+			e.err = errors.New("s2: cannot encode nil LaxLoop")
+			return
+		}
+		e.writeUint8(shapeTypeLaxLoop)
+		v.encode(e)
+	default:
+		e.writeUint8(shapeTypeCustom)
+		e.writeUint8(uint8(s.Dimension()))
+		e.writeBool(s.IsEmpty())
+		e.writeBool(s.IsFull())
+		e.writeUint32(uint32(s.typeTag()))
+		ref := s.ReferencePoint()
+		e.writeBool(ref.Contained)
+		e.writePoint(ref.Point)
+		numChains := s.NumChains()
+		e.writeUvarint(uint64(numChains))
+		for i := range numChains {
+			ch := s.Chain(i)
+			e.writeUvarint(uint64(ch.Start))
+			e.writeUvarint(uint64(ch.Length))
+		}
+		numEdges := s.NumEdges()
+		e.writeUvarint(uint64(numEdges))
+		for i := range numEdges {
+			edge := s.Edge(i)
+			e.writePoint(edge.V0)
+			e.writePoint(edge.V1)
+		}
+	}
+}
+
+func decodeShape(d *decoder) Shape {
+	if d.err != nil {
+		return nil
+	}
+	kind := d.readUint8()
+	if d.err != nil {
+		return nil
+	}
+	switch kind {
+	case shapeTypePolygon:
+		p := new(Polygon)
+		p.decodeWithDecoder(d)
+		return p
+	case shapeTypePolyline:
+		p := new(Polyline)
+		p.decode(d)
+		return p
+	case shapeTypePointVector:
+		p := new(PointVector)
+		p.decode(d)
+		return p
+	case shapeTypeLaxPolyline:
+		p := new(LaxPolyline)
+		p.decode(d)
+		return p
+	case shapeTypeLaxPolygon:
+		p := new(LaxPolygon)
+		p.decode(d)
+		return p
+	case shapeTypeLoop:
+		l := new(Loop)
+		l.decode(d)
+		return l
+	case shapeTypeLaxLoop:
+		l := new(LaxLoop)
+		l.decode(d)
+		return l
+	case shapeTypeCustom:
+		dim := d.readUint8()
+		if d.err != nil {
+			return nil
+		}
+		if dim > 2 {
+			d.err = fmt.Errorf("s2: invalid custom shape dimension %d", dim)
+			return nil
+		}
+		isEmpty := d.readBool()
+		isFull := d.readBool()
+		tag := typeTag(d.readUint32())
+		contained := d.readBool()
+		pt := d.readPoint()
+		if d.err != nil {
+			return nil
+		}
+		ref := ReferencePoint{Point: pt, Contained: contained}
+		numChains := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numChains > maxEncodedCount {
+			d.err = fmt.Errorf("s2: too many chains in custom shape (%d)", numChains)
+			return nil
+		}
+		chains := make([]Chain, 0, min(int(numChains), 1024))
+		for range numChains {
+			start := d.readUvarint()
+			length := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if start > maxEncodedCount || length > maxEncodedCount {
+				d.err = fmt.Errorf("s2: invalid chain bounds (%d, %d)", start, length)
+				return nil
+			}
+			chains = append(chains, Chain{Start: int(start), Length: int(length)})
+		}
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > maxEncodedCount {
+			d.err = fmt.Errorf("s2: too many edges in custom shape (%d)", numEdges)
+			return nil
+		}
+		for _, ch := range chains {
+			if uint64(ch.Start)+uint64(ch.Length) > numEdges {
+				d.err = fmt.Errorf("s2: chain (%d, %d) exceeds numEdges %d", ch.Start, ch.Length, numEdges)
+				return nil
+			}
+		}
+		edges := make([]Edge, 0, min(int(numEdges), 1024))
+		for range numEdges {
+			v0 := d.readPoint()
+			v1 := d.readPoint()
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, Edge{V0: v0, V1: v1})
+		}
+		return &genericShape{
+			edges:     edges,
+			chains:    chains,
+			refPt:     ref,
+			dimension: int(dim),
+			isEmpty:   isEmpty,
+			isFull:    isFull,
+			tag:       tag,
+		}
+	default:
+		d.err = fmt.Errorf("s2: unknown shape type tag %d", kind)
+		return nil
+	}
+}
