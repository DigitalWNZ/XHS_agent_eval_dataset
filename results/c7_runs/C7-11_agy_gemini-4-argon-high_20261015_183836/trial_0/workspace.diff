+// Decode reconstructs the ShapeIndex from r, restoring all shapes with their
+// original IDs and the complete spatial cell structure so queries and iteration
+// work without calling Build.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if r == nil {
+		return errors.New("s2: nil reader")
+	}
+
+	hr := &hashingByteReader{
+		r: asByteReader(r),
+		h: crc32.NewIEEE(),
+	}
+	d := &decoder{r: hr}
+
+	version := d.readUint8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("s2: unsupported ShapeIndex version %d", version)
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > maxEncodedCount {
+		return fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID > maxEncodedCount {
+		return fmt.Errorf("s2: nextID %d exceeds maximum %d", nextID, maxEncodedCount)
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numShapes > nextID {
+		return fmt.Errorf("s2: numShapes %d exceeds nextID %d", numShapes, nextID)
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), 1024))
+	prevShapeID := int32(-1)
+	for range numShapes {
+		rawID := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if rawID >= nextID {
+			return fmt.Errorf("s2: shape ID %d >= nextID %d", rawID, nextID)
+		}
+		id := int32(rawID)
+		if id <= prevShapeID {
+			return fmt.Errorf("s2: shape IDs not strictly increasing (%d <= %d)", id, prevShapeID)
+		}
+		prevShapeID = id
+
+		shape := decodeShape(d)
+		if d.err != nil {
+			return d.err
+		}
+		if shape == nil {
+			return errors.New("s2: decoded nil shape")
+		}
+		shapes[id] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCount {
+		return fmt.Errorf("s2: numCells %d exceeds maximum %d", numCells, maxEncodedCount)
+	}
+	if numShapes == 0 && numCells > 0 {
+		return fmt.Errorf("s2: non-zero numCells %d for index with no shapes", numCells)
+	}
+
+	cells := make([]CellID, 0, min(int(numCells), 1024))
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), 1024))
+	var prevCellID CellID
+	for i := range numCells {
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return d.err
+		}
+		if !cellID.IsValid() {
+			return fmt.Errorf("s2: invalid CellID %d in ShapeIndex", uint64(cellID))
+		}
+		if i > 0 {
+			if cellID <= prevCellID {
+				return fmt.Errorf("s2: cell IDs not strictly increasing (%v <= %v)", cellID, prevCellID)
+			}
+			if cellID.RangeMin() <= prevCellID.RangeMax() {
+				return fmt.Errorf("s2: overlapping cell IDs (%v and %v)", prevCellID, cellID)
+			}
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped == 0 || numClipped > numShapes {
+			return fmt.Errorf("s2: invalid clipped shape count %d (numShapes=%d)", numClipped, numShapes)
+		}
+
+		indexCell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, min(int(numClipped), 1024)),
+		}
+		prevClippedShapeID := int32(-1)
+		for range numClipped {
+			cShapeIDRaw := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if cShapeIDRaw >= nextID {
+				return fmt.Errorf("s2: clipped shape ID %d >= nextID %d", cShapeIDRaw, nextID)
+			}
+			cShapeID := int32(cShapeIDRaw)
+			if cShapeID <= prevClippedShapeID {
+				return fmt.Errorf("s2: clipped shape IDs not strictly increasing (%d <= %d)", cShapeID, prevClippedShapeID)
+			}
+			prevClippedShapeID = cShapeID
+
+			shape, ok := shapes[cShapeID]
+			if !ok || shape == nil {
+				return fmt.Errorf("s2: clipped shape references unknown shape ID %d", cShapeID)
+			}
+
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if containsCenter && shape.Dimension() != 2 {
+				return fmt.Errorf("s2: clipped shape %d has containsCenter=true but dimension=%d", cShapeID, shape.Dimension())
+			}
+			shapeNumEdges := uint64(shape.NumEdges())
+			if numEdges > shapeNumEdges {
+				return fmt.Errorf("s2: clipped shape %d has %d edges, exceeding shape edge count %d", cShapeID, numEdges, shapeNumEdges)
+			}
+			if !containsCenter && numEdges == 0 {
+				return fmt.Errorf("s2: empty clipped shape %d in cell %v", cShapeID, cellID)
+			}
+
+			edges := make([]int, 0, min(int(numEdges), 1024))
+			prevEdgeID := -1
+			for range numEdges {
+				edgeIDRaw := d.readUvarint()
+				if d.err != nil {
+					return d.err
+				}
+				if edgeIDRaw >= shapeNumEdges {
+					return fmt.Errorf("s2: clipped edge ID %d >= shape edge count %d", edgeIDRaw, shapeNumEdges)
+				}
+				edgeID := int(edgeIDRaw)
+				if edgeID <= prevEdgeID {
+					return fmt.Errorf("s2: clipped edge IDs not strictly increasing (%d <= %d)", edgeID, prevEdgeID)
+				}
+				prevEdgeID = edgeID
+				edges = append(edges, edgeID)
+			}
+
+			indexCell.shapes = append(indexCell.shapes, &clippedShape{
+				shapeID:        cShapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = indexCell
+	}
+
+	gotCRC := hr.h.Sum32()
+	hr.h = nil
+	wantCRC := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if gotCRC != wantCRC {
+		return fmt.Errorf("s2: ShapeIndex checksum mismatch: got %#08x, want %#08x", gotCRC, wantCRC)
+	}
+
+	s.mu.Lock()
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	s.cells = cells
+	s.cellMap = cellMap
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+
+	return nil
+}
