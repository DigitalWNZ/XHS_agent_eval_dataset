+const (
+	shapeIndexEncodingVersion uint8 = 1
+
+	shapeTypePolygon uint8 = iota + 1
+	shapeTypePolyline
+	shapeTypePointVector
+	shapeTypeLaxPolyline
+	shapeTypeLaxPolygon
+	shapeTypeLoop
+	shapeTypeLaxLoop
+	shapeTypeCustom
+
+	maxEncodedCount = 10000000
