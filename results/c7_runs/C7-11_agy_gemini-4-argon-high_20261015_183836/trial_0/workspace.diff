+// Encode encodes the ShapeIndex, including all shapes and the full spatial cell structure.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if w == nil {
+		return errors.New("s2: nil writer")
+	}
+
+	// Ensure any pending additions or removals are applied so the spatial cell
+	// structure is complete prior to encoding.
+	s.Build()
+
+	var buf bytes.Buffer
+	e := &encoder{w: &buf}
+
+	e.writeUint8(shapeIndexEncodingVersion)
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUvarint(uint64(maxEdges))
+
+	if s.nextID < 0 {
+		return fmt.Errorf("s2: invalid nextID %d", s.nextID)
+	}
+	e.writeUvarint(uint64(s.nextID))
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id, shape := range s.shapes {
+		if shape != nil {
+			shapeIDs = append(shapeIDs, id)
+		}
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUvarint(uint64(len(shapeIDs)))
+	for _, id := range shapeIDs {
+		if id < 0 || id >= s.nextID {
+			return fmt.Errorf("s2: shape ID %d out of range [0, %d)", id, s.nextID)
+		}
+		e.writeUvarint(uint64(id))
+		encodeShape(e, s.shapes[id])
+		if e.err != nil {
+			return e.err
+		}
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			return fmt.Errorf("s2: missing cell %v in cellMap", cellID)
+		}
+		e.writeUint64(uint64(cellID))
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+		if e.err != nil {
+			return e.err
+		}
+	}
+
+	checksum := crc32.ChecksumIEEE(buf.Bytes())
+	e.writeUint32(checksum)
+	if e.err != nil {
+		return e.err
+	}
+
+	_, err := w.Write(buf.Bytes())
+	return err
+}
