+type hashingByteReader struct {
+	r io.ByteReader
+	h hash.Hash32
+}
+
+func (hr *hashingByteReader) Read(p []byte) (int, error) {
+	if r, ok := hr.r.(io.Reader); ok {
+		n, err := r.Read(p)
+		if n > 0 && hr.h != nil {
+			_, _ = hr.h.Write(p[:n])
+		}
+		return n, err
+	}
+	for i := range p {
+		b, err := hr.r.ReadByte()
+		if err != nil {
+			return i, err
+		}
+		p[i] = b
+		if hr.h != nil {
+			_, _ = hr.h.Write([]byte{b})
+		}
+	}
+	return len(p), nil
+}
+
+func (hr *hashingByteReader) ReadByte() (byte, error) {
+	b, err := hr.r.ReadByte()
+	if err == nil && hr.h != nil {
+		_, _ = hr.h.Write([]byte{b})
+	}
+	return b, err
+}
