diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..e9b36f49
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,377 @@
+import { type AnyColumn, Column, type GetColumnData } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import { type DriverValueDecoder, noopDecoder, SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameUnit = 'rows' | 'range';
+
+export type WindowFrameBoundaryType =
+	| 'unbounded preceding'
+	| 'preceding'
+	| 'current row'
+	| 'following'
+	| 'unbounded following';
+
+export class WindowFrameBoundary {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly type: WindowFrameBoundaryType,
+		readonly offset?: number,
+	) {}
+
+	/** @internal */
+	get rank(): number {
+		switch (this.type) {
+			case 'unbounded preceding':
+				return 0;
+			case 'preceding':
+				return 1;
+			case 'current row':
+				return 2;
+			case 'following':
+				return 3;
+			case 'unbounded following':
+				return 4;
+		}
+	}
+
+	/** @internal */
+	toSQL(): SQL {
+		switch (this.type) {
+			case 'unbounded preceding':
+				return sql.raw('unbounded preceding');
+			case 'preceding':
+				return sql.raw(`${this.offset} preceding`);
+			case 'current row':
+				return sql.raw('current row');
+			case 'following':
+				return sql.raw(`${this.offset} following`);
+			case 'unbounded following':
+				return sql.raw('unbounded following');
+		}
+	}
+}
+
+export const unboundedPreceding = new WindowFrameBoundary('unbounded preceding');
+export const currentRow = new WindowFrameBoundary('current row');
+export const unboundedFollowing = new WindowFrameBoundary('unbounded following');
+
+export function preceding(offset: number): WindowFrameBoundary {
+	if (!Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() expects a non-negative integer, received: ${offset}`);
+	}
+	return new WindowFrameBoundary('preceding', offset);
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	if (!Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() expects a non-negative integer, received: ${offset}`);
+	}
+	return new WindowFrameBoundary('following', offset);
+}
+
+export interface WindowFrameBoundarySpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+export class WindowFrame {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	readonly from: WindowFrameBoundary;
+	readonly to: WindowFrameBoundary;
+
+	constructor(
+		readonly unit: WindowFrameUnit,
+		spec: WindowFrameBoundarySpec,
+	) {
+		if (!spec || !(spec.from instanceof WindowFrameBoundary) || !(spec.to instanceof WindowFrameBoundary)) {
+			throw new Error(`${unit}() expects a { from, to } boundary specification`);
+		}
+		if (spec.from.rank > spec.to.rank) {
+			throw new Error(`Invalid window frame: "from" boundary (${spec.from.type}) cannot come after "to" boundary (${spec.to.type})`);
+		}
+		this.from = spec.from;
+		this.to = spec.to;
+	}
+
+	/** @internal */
+	toSQL(): SQL {
+		return sql`${sql.raw(this.unit)} between ${this.from.toSQL()} and ${this.to.toSQL()}`;
+	}
+}
+
+export function rows(spec: WindowFrameBoundarySpec): WindowFrame {
+	return new WindowFrame('rows', spec);
+}
+
+export function range(spec: WindowFrameBoundarySpec): WindowFrame {
+	return new WindowFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinitionConfig {
+	name: string;
+	spec: WindowSpec;
+}
+
+/** @internal */
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot be whitespace-only');
+	}
+}
+
+/** @internal */
+export function buildWindowSpecSQL(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.raw('()');
+	}
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionList.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderList.length > 0) {
+			parts.push(sql`order by ${sql.join(orderList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		parts.push(spec.frame.toSQL());
+	}
+
+	if (parts.length === 0) {
+		return sql.raw('()');
+	}
+
+	return sql`(${sql.join(parts, sql` `)})`;
+}
+
+/** @internal */
+export function buildWindowClause(windows: WindowDefinitionConfig[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+	const defs = windows.map(({ name, spec }) => sql`${sql.identifier(name)} as ${buildWindowSpecSQL(spec)}`);
+	return sql` window ${sql.join(defs, sql`, `)}`;
+}
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	constructor(
+		private readonly expr: SQL<T>,
+		private readonly decoder: DriverValueDecoder<T, any> = noopDecoder,
+	) {}
+
+	over(specOrName?: WindowSpec | string): SQL<T> {
+		if (typeof specOrName === 'string') {
+			validateWindowName(specOrName);
+			return sql.join([
+				...this.expr.queryChunks,
+				sql` over ${sql.identifier(specOrName)}`,
+			]).mapWith(this.decoder) as SQL<T>;
+		}
+		const specSQL = buildWindowSpecSQL(specOrName);
+		return sql.join([
+			...this.expr.queryChunks,
+			sql` over `,
+			...specSQL.queryChunks,
+		]).mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type GetWindowData<T extends SQLWrapper, TMode extends 'query' | 'raw' = 'query'> = T extends Column
+	? GetColumnData<T, TMode>
+	: T extends SQL<infer U>
+	? U
+	: T extends SQL.Aliased<infer U>
+	? U
+	: unknown;
+
+function getExpressionDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, { mapFromDriverValue: Number });
+}
+
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, { mapFromDriverValue: Number });
+}
+
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, { mapFromDriverValue: Number });
+}
+
+export function ntile(buckets: number): WindowFunction<number> {
+	if (!Number.isInteger(buckets) || buckets <= 0) {
+		throw new Error(`ntile() expects a positive integer, received: ${buckets}`);
+	}
+	return new WindowFunction(sql`ntile(${sql.raw(String(buckets))})`, { mapFromDriverValue: Number });
+}
+
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, { mapFromDriverValue: Number });
+}
+
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, { mapFromDriverValue: Number });
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowData<T, 'raw'> | null>;
+export function lag<T extends SQLWrapper, TDefault extends GetWindowData<T, 'raw'> | null | SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	TDefault extends null ? GetWindowData<T, 'raw'> | null
+		: TDefault extends SQL<infer U> ? GetWindowData<T, 'raw'> | U
+		: TDefault extends SQL.Aliased<infer U> ? GetWindowData<T, 'raw'> | U
+		: TDefault extends Column ? GetWindowData<T, 'raw'> | GetColumnData<TDefault, 'query'>
+		: GetWindowData<T, 'raw'> | TDefault
+>;
+export function lag(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (offset !== undefined && (!Number.isInteger(offset) || offset < 0)) {
+		throw new Error(`lag() offset must be a non-negative integer, received: ${offset}`);
+	}
+	const args: SQLChunk[] = [expression];
+	if (defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		args.push(sql.raw(String(resolvedOffset)));
+		args.push(defaultValue === null ? sql.raw('null') : bindIfParam(defaultValue, expression));
+	} else if (offset !== undefined) {
+		args.push(sql.raw(String(offset)));
+	}
+	const joinedArgs = sql.join(args, sql`, `);
+	return new WindowFunction(sql.join([sql.raw('lag('), ...joinedArgs.queryChunks, sql.raw(')')]), decoder);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowData<T, 'raw'> | null>;
+export function lead<T extends SQLWrapper, TDefault extends GetWindowData<T, 'raw'> | null | SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	TDefault extends null ? GetWindowData<T, 'raw'> | null
+		: TDefault extends SQL<infer U> ? GetWindowData<T, 'raw'> | U
+		: TDefault extends SQL.Aliased<infer U> ? GetWindowData<T, 'raw'> | U
+		: TDefault extends Column ? GetWindowData<T, 'raw'> | GetColumnData<TDefault, 'query'>
+		: GetWindowData<T, 'raw'> | TDefault
+>;
+export function lead(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (offset !== undefined && (!Number.isInteger(offset) || offset < 0)) {
+		throw new Error(`lead() offset must be a non-negative integer, received: ${offset}`);
+	}
+	const args: SQLChunk[] = [expression];
+	if (defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		args.push(sql.raw(String(resolvedOffset)));
+		args.push(defaultValue === null ? sql.raw('null') : bindIfParam(defaultValue, expression));
+	} else if (offset !== undefined) {
+		args.push(sql.raw(String(offset)));
+	}
+	const joinedArgs = sql.join(args, sql`, `);
+	return new WindowFunction(sql.join([sql.raw('lead('), ...joinedArgs.queryChunks, sql.raw(')')]), decoder);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowData<T, 'raw'> | null> {
+	const decoder = getExpressionDecoder(expression);
+	return new WindowFunction(sql`first_value(${expression})`, decoder);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowData<T, 'raw'> | null> {
+	const decoder = getExpressionDecoder(expression);
+	return new WindowFunction(sql`last_value(${expression})`, decoder);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<GetWindowData<T, 'raw'> | null> {
+	if (!Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue() expects a positive integer, received: ${n}`);
+	}
+	const decoder = getExpressionDecoder(expression);
+	return new WindowFunction(sql`nth_value(${expression}, ${sql.raw(String(n))})`, decoder);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, { mapFromDriverValue: String });
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, { mapFromDriverValue: String });
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	) as any;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	) as any;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(
+		sql`count(${expression || sql.raw('*')})`,
+		{ mapFromDriverValue: Number },
+	);
+}
