+		// 5-6: QueryParameters
+		assert.Equal(t, "user", policies[4].GetQueryParameter().GetName())
+		assert.True(t, policies[4].GetTerminal())
+		assert.Equal(t, "region", policies[5].GetQueryParameter().GetName())
+		assert.False(t, policies[5].GetTerminal())
+
+		// 7-8: FilterState
+		assert.Equal(t, "io.envoy.state1", policies[6].GetFilterState().GetKey())
+		assert.True(t, policies[6].GetTerminal())
+		assert.Equal(t, "io.envoy.state2", policies[7].GetFilterState().GetKey())
+		assert.False(t, policies[7].GetTerminal())
+
+		// 9: SourceIp
+		require.NotNil(t, policies[8].GetConnectionProperties())
+		assert.True(t, policies[8].GetConnectionProperties().GetSourceIp())
+		assert.True(t, policies[8].GetTerminal())
