+		merged := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+		assert.False(t, tp.spec.consistentHash.disable)
+
+		hps := tp.spec.consistentHash.hashPolicies
+		// Expected in canonical order:
+		// 1. Header: X-Shared (from high, terminal=true)
+		// 2. Header: X-High (from high)
+		// 3. Header: X-Low (from low)
+		// 4. Cookie: cookie-shared (from high, path=/high)
+		// 5. Cookie: cookie-low (from low)
+		// 6. QueryParameter: qp-low (from low)
+		// 7. FilterState: fs-high (from high)
+		// 8. FilterState: fs-low (from low)
+		// (No sourceIp because high had sourceIp unset!)
+		require.Len(t, hps, 8)
+		assert.Equal(t, "X-Shared", hps[0].GetHeader().GetHeaderName())
+		assert.True(t, hps[0].GetTerminal())
+		assert.Equal(t, "X-High", hps[1].GetHeader().GetHeaderName())
+		assert.Equal(t, "X-Low", hps[2].GetHeader().GetHeaderName())
+
+		assert.Equal(t, "cookie-shared", hps[3].GetCookie().GetName())
+		assert.Equal(t, "/high", hps[3].GetCookie().GetPath())
+		assert.Equal(t, "cookie-low", hps[4].GetCookie().GetName())
+
+		assert.Equal(t, "qp-low", hps[5].GetQueryParameter().GetName())
+
+		assert.Equal(t, "fs-high", hps[6].GetFilterState().GetKey())
+		assert.True(t, hps[6].GetTerminal())
+		assert.Equal(t, "fs-low", hps[7].GetFilterState().GetKey())
+
+		// Verify mergeOrigins records both policies under "consistentHash"
+		origins := merged.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-pol",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-pol",
+		}, origins)
+	})
+
+	t.Run("high sourceIp is retained when set", func(t *testing.T) {
+		high := makePolicyAtt("high-pol", kgateway.ConsistentHash{
+			SourceIp: &kgateway.SourceIPHashPolicy{Terminal: false},
+		}, 0, "")
+		low := makePolicyAtt("low-pol", kgateway.ConsistentHash{
+			Headers:  []kgateway.HeaderHashPolicy{{HeaderName: "X-Low"}},
+			SourceIp: &kgateway.SourceIPHashPolicy{Terminal: true},
+		}, 0, "")
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+		hps := tp.spec.consistentHash.hashPolicies
+		// Canonical order: Header(X-Low) then SourceIp(terminal=false from high)
+		require.Len(t, hps, 2)
+		assert.Equal(t, "X-Low", hps[0].GetHeader().GetHeaderName())
+		require.NotNil(t, hps[1].GetConnectionProperties())
+		assert.True(t, hps[1].GetConnectionProperties().GetSourceIp())
+		assert.False(t, hps[1].GetTerminal())
+	})
+
+	t.Run("disable on higher-priority policy suppresses broader-scoped policy", func(t *testing.T) {
+		high := makePolicyAtt("rule-disable", kgateway.ConsistentHash{
+			Disable: true,
+		}, 0, "")
+		low := makePolicyAtt("route-hash", kgateway.ConsistentHash{
+			Headers: []kgateway.HeaderHashPolicy{{HeaderName: "X-Route"}},
+		}, 0, "")
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+		assert.True(t, tp.spec.consistentHash.disable)
+
+		route := &envoyroutev3.Route{Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}}}
+		applyConsistentHash(tp.spec.consistentHash, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+
+		origins := merged.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/rule-disable",
+		}, origins)
+	})
+}
