+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+// hashPolicyKeys returns a readable "type:key" summary of each hash policy for assertions.
+func hashPolicyKeys(hps []*envoyroutev3.RouteAction_HashPolicy) []string {
+	var out []string
+	for _, hp := range hps {
+		var s string
+		switch {
+		case hp.GetHeader() != nil:
+			s = "header:" + hp.GetHeader().GetHeaderName()
+		case hp.GetCookie() != nil:
+			s = "cookie:" + hp.GetCookie().GetName()
+		case hp.GetQueryParameter() != nil:
+			s = "query:" + hp.GetQueryParameter().GetName()
+		case hp.GetFilterState() != nil:
+			s = "filterState:" + hp.GetFilterState().GetKey()
+		case hp.GetConnectionProperties().GetSourceIp():
+			s = "sourceIp"
+		}
+		if hp.GetTerminal() {
+			s += "!"
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+func buildConsistentHash(t *testing.T, in *kgateway.ConsistentHash) *consistentHashIR {
+	t.Helper()
+	out := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: in}, out))
+	return out.consistentHash
+}
+
+func TestConstructConsistentHash(t *testing.T) {
+	t.Run("unset produces no IR", func(t *testing.T) {
+		assert.Nil(t, buildConsistentHash(t, nil))
+	})
+
+	t.Run("empty defaults to non-terminal sourceIp", func(t *testing.T) {
+		c := buildConsistentHash(t, &kgateway.ConsistentHash{})
+		assert.Equal(t, []string{"sourceIp"}, hashPolicyKeys(c.hashPolicies))
+	})
+
+	t.Run("disable produces no hash policies", func(t *testing.T) {
+		c := buildConsistentHash(t, &kgateway.ConsistentHash{Disable: ptr.To(true)})
+		assert.True(t, c.disable)
+		assert.Empty(t, c.hashPolicies)
+	})
+
+	t.Run("canonical order and dedupe", func(t *testing.T) {
+		c := buildConsistentHash(t, &kgateway.ConsistentHash{
+			SourceIP:        &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			FilterState:     []kgateway.ConsistentHashFilterState{{Key: "k"}, {Key: "k", Terminal: ptr.To(true)}},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}, {Name: "q", Terminal: ptr.To(true)}},
+			Cookies:         []kgateway.ConsistentHashCookie{{Name: "c", Terminal: ptr.To(true)}, {Name: "c"}},
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User"},
+				{HeaderName: "x-user", Terminal: ptr.To(true)},
+				{HeaderName: "x-other"},
+			},
+		})
+		assert.Equal(t, []string{
+			"header:X-User", "header:x-other", "cookie:c!", "query:q", "filterState:k", "sourceIp!",
+		}, hashPolicyKeys(c.hashPolicies))
+	})
+
+	t.Run("header regex rewrite", func(t *testing.T) {
+		c := buildConsistentHash(t, &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{{
+				HeaderName:   "x-user",
+				RegexRewrite: &kgateway.ConsistentHashRegexRewrite{Pattern: "^u-(.*)$", Substitution: `\1`},
+			}},
+		})
+		rr := c.hashPolicies[0].GetHeader().GetRegexRewrite()
+		require.NotNil(t, rr)
+		assert.Equal(t, "^u-(.*)$", rr.GetPattern().GetRegex())
+		assert.Equal(t, `\1`, rr.GetSubstitution())
+		assert.NoError(t, c.Validate())
+	})
+
+	t.Run("cookie ttl, path and attributes", func(t *testing.T) {
+		c := buildConsistentHash(t, &kgateway.ConsistentHash{
+			Cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name: "a",
+					TTL:  ptr.To("1h30m"),
+					Path: ptr.To("/"),
+					Attributes: []kgateway.ConsistentHashCookieAttribute{
+						{Name: "SameSite", Value: ptr.To("Lax")},
+						{Name: "Secure"},
+					},
+				},
+				{Name: "b", TTL: ptr.To("3600")},
+			},
+		})
+		a := c.hashPolicies[0].GetCookie()
+		assert.Equal(t, 90*time.Minute, a.GetTtl().AsDuration())
+		assert.Equal(t, "/", a.GetPath())
+		require.Len(t, a.GetAttributes(), 2)
+		assert.Equal(t, "SameSite", a.GetAttributes()[0].GetName())
+		assert.Equal(t, "Lax", a.GetAttributes()[0].GetValue())
+		assert.Equal(t, "Secure", a.GetAttributes()[1].GetName())
+		assert.Empty(t, a.GetAttributes()[1].GetValue())
+		assert.Equal(t, time.Hour, c.hashPolicies[1].GetCookie().GetTtl().AsDuration())
+	})
+
+	t.Run("invalid cookie ttl", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{
+			Cookies: []kgateway.ConsistentHashCookie{{Name: "a", TTL: ptr.To("bogus")}},
+		}}, out)
+		assert.ErrorContains(t, err, `invalid consistentHash cookie "a" ttl`)
+	})
+
+	t.Run("invalid regex fails validation", func(t *testing.T) {
+		c := buildConsistentHash(t, &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{{
+				HeaderName:   "x-user",
+				RegexRewrite: &kgateway.ConsistentHashRegexRewrite{Pattern: "(", Substitution: ""},
+			}},
+		})
+		assert.ErrorContains(t, c.Validate(), "invalid consistentHash header regexRewrite pattern")
+	})
+}
+
+func TestConsistentHashIREquals(t *testing.T) {
+	a := buildConsistentHash(t, &kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x"}}})
+	b := buildConsistentHash(t, &kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x"}}})
+	c := buildConsistentHash(t, &kgateway.ConsistentHash{Headers: []kgateway.ConsistentHashHeader{{HeaderName: "y"}}})
+	d := buildConsistentHash(t, &kgateway.ConsistentHash{Disable: ptr.To(true)})
+
+	var nilIR *consistentHashIR
+	assert.True(t, nilIR.Equals(nilIR), "nil IRs should be equal")
+	assert.False(t, nilIR.Equals(a), "nil and non-nil should not be equal")
+	assert.True(t, a.Equals(b), "identical IRs should be equal")
+	assert.False(t, a.Equals(c), "different headers should not be equal")
+	assert.False(t, a.Equals(d), "disabled IR should not equal enabled IR")
+}
+
+func TestMergeConsistentHash(t *testing.T) {
+	p1Ref := &ir.AttachedPolicyRef{Name: "p1"}
+	p2Ref := &ir.AttachedPolicyRef{Name: "p2"}
+
+	high := &kgateway.ConsistentHash{
+		Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-a", Terminal: ptr.To(true)}},
+		Cookies: []kgateway.ConsistentHashCookie{{Name: "c1"}},
+	}
+	low := &kgateway.ConsistentHash{
+		Headers:         []kgateway.ConsistentHashHeader{{HeaderName: "X-A"}, {HeaderName: "x-b"}},
+		QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+		SourceIP:        &kgateway.ConsistentHashSourceIP{},
+	}
+
+	tests := []struct {
+		name     string
+		p1, p2   *kgateway.ConsistentHash
+		strategy policy.MergeStrategy
+		want     []string
+		disabled bool
+		origins  []string
+	}{
+		{
+			name:     "p2 only",
+			p2:       low,
+			strategy: policy.AugmentedShallowMerge,
+			want:     []string{"header:X-A", "header:x-b", "query:q", "sourceIp"},
+			origins:  []string{p2Ref.ID()},
+		},
+		{
+			name:     "union with p1 preferred, sourceIp from p1 even when unset",
+			p1:       high,
+			p2:       low,
+			strategy: policy.AugmentedShallowMerge,
+			want:     []string{"header:x-a!", "header:x-b", "cookie:c1", "query:q"},
+			origins:  []string{p1Ref.ID(), p2Ref.ID()},
+		},
+		{
+			name:     "union with p2 preferred under overridable strategy",
+			p1:       low,
+			p2:       high,
+			strategy: policy.OverridableShallowMerge,
+			want:     []string{"header:x-a!", "header:x-b", "cookie:c1", "query:q"},
+			origins:  []string{p1Ref.ID(), p2Ref.ID()},
+		},
+		{
+			name:     "p1 disabled suppresses p2",
+			p1:       &kgateway.ConsistentHash{Disable: ptr.To(true)},
+			p2:       low,
+			strategy: policy.AugmentedShallowMerge,
+			disabled: true,
+			origins:  []string{p1Ref.ID()},
+		},
+		{
+			name:     "p2 disabled ignored when p1 preferred",
+			p1:       high,
+			p2:       &kgateway.ConsistentHash{Disable: ptr.To(true)},
+			strategy: policy.AugmentedDeepMerge,
+			want:     []string{"header:x-a!", "cookie:c1"},
+			origins:  []string{p1Ref.ID()},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p1 := &TrafficPolicy{}
+			p2 := &TrafficPolicy{}
+			mergeOrigins := ir.MergeOrigins{}
+			if tt.p1 != nil {
+				p1.spec.consistentHash = buildConsistentHash(t, tt.p1)
+				mergeOrigins.SetOne("consistentHash", p1Ref, nil)
+			}
+			p2.spec.consistentHash = buildConsistentHash(t, tt.p2)
+			p2Before := hashPolicyKeys(p2.spec.consistentHash.hashPolicies)
+
+			mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{Strategy: tt.strategy}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+			got := p1.spec.consistentHash
+			require.NotNil(t, got)
+			assert.Equal(t, tt.disabled, got.disable)
+			assert.Equal(t, tt.want, hashPolicyKeys(got.hashPolicies))
+			assert.ElementsMatch(t, tt.origins, mergeOrigins.Get("consistentHash"))
+			assert.Equal(t, p2Before, hashPolicyKeys(p2.spec.consistentHash.hashPolicies), "p2 IR must not be modified")
+		})
+	}
+}
+
+func TestApplyConsistentHash(t *testing.T) {
+	action := &envoyroutev3.RouteAction{
+		HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(true)},
+	}
+	applyConsistentHash(buildConsistentHash(t, &kgateway.ConsistentHash{Disable: ptr.To(true)}), action)
+	assert.Empty(t, action.GetHashPolicy(), "disable should clear existing hash policies")
+
+	applyConsistentHash(buildConsistentHash(t, &kgateway.ConsistentHash{}), action)
+	assert.Equal(t, []string{"sourceIp"}, hashPolicyKeys(action.GetHashPolicy()))
+
+	applyConsistentHash(nil, action)
+	assert.Equal(t, []string{"sourceIp"}, hashPolicyKeys(action.GetHashPolicy()), "nil IR should not modify action")
+}
