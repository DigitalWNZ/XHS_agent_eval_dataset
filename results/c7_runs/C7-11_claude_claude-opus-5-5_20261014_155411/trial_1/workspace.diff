+metadata:
+  name: consistent-hash-full-secondary
+  creationTimestamp: "2024-01-02T00:00:00Z"
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-full
+  consistentHash:
+    headers:
+      - headerName: X-Tenant
+        terminal: true
+      - headerName: x-region
+    cookies:
+      - name: session
+        ttl: "60"
+    queryParameters:
+      - name: account
+    filterState:
+      - key: custom.key
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-empty
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-empty
+  consistentHash: {}
