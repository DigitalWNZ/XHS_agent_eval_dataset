+kind: HTTPRoute
+metadata:
+  name: route-full
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "route-full.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: route-empty
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "route-empty.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-full
+  creationTimestamp: "2024-01-01T00:00:00Z"
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
