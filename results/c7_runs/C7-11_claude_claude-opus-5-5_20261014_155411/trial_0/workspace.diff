+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+	newAtt := func(name string, ct time.Time, ch *consistentHashIR) ir.PolicyAtt {
+		return ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: name},
+			PolicyIr:  &TrafficPolicy{ct: ct, spec: trafficPolicySpecIr{consistentHash: ch}},
+		}
+	}
+	now := time.Now()
+
+	t.Run("union with higher priority first", func(t *testing.T) {
+		p1 := newAtt("p1", now, &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("X-User", true),
+			filterStateHash("k"),
+		}})
+		p2 := newAtt("p2", now.Add(time.Minute), &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("x-user", false),
+			headerHash("x-tenant", false),
+			queryHash("q"),
+			sourceIPHashPolicy(true),
+		}})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+		ch := merged.PolicyIr.(*TrafficPolicy).spec.consistentHash
+		require.NotNil(t, ch)
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("X-User", true),
+			headerHash("x-tenant", false),
+			queryHash("q"),
+			filterStateHash("k"),
+		}, ch.hashPolicies)
+		assert.ElementsMatch(t, []string{p1.PolicyRef.ID(), p2.PolicyRef.ID()}, merged.MergeOrigins.Get("consistentHash"))
+	})
+
+	t.Run("higher priority disable suppresses", func(t *testing.T) {
+		p1 := newAtt("p1", now, &consistentHashIR{disable: true})
+		p2 := newAtt("p2", now.Add(time.Minute), &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{queryHash("q")}})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+		ch := merged.PolicyIr.(*TrafficPolicy).spec.consistentHash
+		require.NotNil(t, ch)
+		assert.True(t, ch.disable)
+		assert.Empty(t, ch.hashPolicies)
+		assert.Equal(t, []string{p1.PolicyRef.ID()}, merged.MergeOrigins.Get("consistentHash"))
+	})
+
+	t.Run("route disable suppresses gateway policy", func(t *testing.T) {
+		route := newAtt("route", now, &consistentHashIR{disable: true})
+		route.HierarchicalPriority = 1
+		gw := newAtt("gw", now, &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{queryHash("q")}})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{route, gw}, mergeTrafficPolicies, "")
+		ch := merged.PolicyIr.(*TrafficPolicy).spec.consistentHash
+		require.NotNil(t, ch)
+		assert.True(t, ch.disable)
+
+		action := &envoyroutev3.RouteAction{HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{queryHash("other")}}
+		applyConsistentHash(ch, action)
+		assert.Empty(t, action.GetHashPolicy())
+	})
+}
