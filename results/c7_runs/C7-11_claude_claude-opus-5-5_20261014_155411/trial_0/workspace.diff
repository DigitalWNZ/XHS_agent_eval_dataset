+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	// Hash policies are always unioned across policies (regardless of shallow or deep merge)
+	// with the higher priority policy's entries taking precedence.
+	p2Hash := p2.spec.consistentHash
+	if p2Hash == nil {
+		return
+	}
+	p1Hash := p1.spec.consistentHash
+	if p1Hash == nil {
+		p1.spec.consistentHash = p2Hash
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		// p1 has higher priority
+		p1.spec.consistentHash = mergeConsistentHashIR(p1Hash, p2Hash)
+		if !p1Hash.disable && !p2Hash.disable {
+			mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+		}
+
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		// p2 has higher priority
+		p1.spec.consistentHash = mergeConsistentHashIR(p2Hash, p1Hash)
+		if p2Hash.disable || p1Hash.disable {
+			mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		} else {
+			mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+		}
+
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", "consistentHash")
+	}
+}
+
