+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+func headerHash(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: name},
+		},
+	}
+}
+
+func queryHash(name string) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+			QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: name},
+		},
+	}
+}
+
+func assertHashPolicies(t *testing.T, expected, actual []*envoyroutev3.RouteAction_HashPolicy) {
+	t.Helper()
+	require.Len(t, actual, len(expected))
+	for i := range expected {
+		assert.True(t, proto.Equal(expected[i], actual[i]), "hash policy %d: expected %v, got %v", i, expected[i], actual[i])
+	}
+}
+
+func TestConstructConsistentHash(t *testing.T) {
+	t.Run("nil spec", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{}, out))
+		assert.Nil(t, out.consistentHash)
+	})
+
+	t.Run("empty spec defaults to source IP", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{}}, out))
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{newSourceIPHashPolicy(false)}, out.consistentHash.hashPolicies())
+	})
+
+	t.Run("disable", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{Disable: ptr.To(true)}}, out))
+		assert.True(t, out.consistentHash.disable)
+		assert.Empty(t, out.consistentHash.hashPolicies(), "disabled policy should produce no hash policies")
+	})
+
+	t.Run("dedup and canonical order", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		spec := kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{
+			SourceIP:        &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}, {Name: "q", Terminal: ptr.To(true)}},
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Foo", Terminal: ptr.To(true)},
+				{HeaderName: "x-foo"},
+				{HeaderName: "x-bar"},
+			},
+		}}
+		require.NoError(t, constructConsistentHash(spec, out))
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("X-Foo", true),
+			headerHash("x-bar", false),
+			queryHash("q"),
+			newSourceIPHashPolicy(true),
+		}, out.consistentHash.hashPolicies())
+	})
+
+	t.Run("invalid cookie ttl", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		spec := kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{
+			Cookies: []kgateway.ConsistentHashCookie{{Name: "c", TTL: ptr.To("bogus")}},
+		}}
+		assert.Error(t, constructConsistentHash(spec, out))
+	})
+}
+
+func TestParseCookieTTL(t *testing.T) {
+	tests := []struct {
+		in       string
+		expected time.Duration
+		wantErr  bool
+	}{
+		{in: "3600", expected: time.Hour},
+		{in: "1h30m", expected: 90 * time.Minute},
+		{in: "0", expected: 0},
+		{in: "-5", wantErr: true},
+		{in: "-1s", wantErr: true},
+		{in: "abc", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.in, func(t *testing.T) {
+			d, err := parseCookieTTL(tt.in)
+			if tt.wantErr {
+				assert.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected, d)
+		})
+	}
+}
+
+func TestConsistentHashValidate(t *testing.T) {
+	out := &trafficPolicySpecIr{}
+	spec := kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{
+		Headers: []kgateway.ConsistentHashHeader{{
+			HeaderName:   "x-foo",
+			RegexRewrite: &kgateway.ConsistentHashRegexRewrite{Pattern: "(", Substitution: ""},
+		}},
+	}}
+	require.NoError(t, constructConsistentHash(spec, out))
+	assert.Error(t, out.consistentHash.Validate(), "invalid regex should fail validation")
+}
+
+func TestConsistentHashIREquals(t *testing.T) {
+	a := &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHash("x", false)}}
+	b := &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHash("x", false)}}
+	c := &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHash("x", true)}}
+	assert.True(t, a.Equals(b))
+	assert.False(t, a.Equals(c))
+	assert.False(t, a.Equals(&consistentHashIR{disable: true}))
+	assert.True(t, (*consistentHashIR)(nil).Equals((*consistentHashIR)(nil)))
+	assert.False(t, a.Equals((*consistentHashIR)(nil)))
+}
+
+func TestMergeConsistentHash(t *testing.T) {
+	newPolicy := func(ch *consistentHashIR) *TrafficPolicy {
+		return &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: ch}}
+	}
+
+	t.Run("union with higher priority first and canonical order", func(t *testing.T) {
+		p1 := newPolicy(&consistentHashIR{
+			headers:         []*envoyroutev3.RouteAction_HashPolicy{headerHash("X-Shared", true)},
+			queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryHash("q")},
+		})
+		p2Ch := &consistentHashIR{
+			headers:  []*envoyroutev3.RouteAction_HashPolicy{headerHash("x-shared", false), headerHash("x-b", false)},
+			sourceIP: newSourceIPHashPolicy(true),
+		}
+		p2 := newPolicy(p2Ch)
+		origins := ir.MergeOrigins{}
+		p2Ref := &ir.AttachedPolicyRef{Name: "p2"}
+		mergeConsistentHash(p1, p2, p2Ref, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, origins, TrafficPolicyMergeOpts{})
+
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("X-Shared", true),
+			headerHash("x-b", false),
+			queryHash("q"),
+		}, p1.spec.consistentHash.hashPolicies())
+		assert.Equal(t, []string{p2Ref.ID()}, origins.Get("consistentHash"))
+		assert.Len(t, p2Ch.headers, 2, "lower priority IR must not be modified")
+	})
+
+	t.Run("higher priority disable suppresses lower priority", func(t *testing.T) {
+		p1 := newPolicy(&consistentHashIR{disable: true})
+		p2 := newPolicy(&consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHash("x", false)}})
+		origins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, origins, TrafficPolicyMergeOpts{})
+		assert.True(t, p1.spec.consistentHash.disable)
+		assert.Empty(t, origins.Get("consistentHash"))
+	})
+
+	t.Run("overridable prefers p2", func(t *testing.T) {
+		p1 := newPolicy(&consistentHashIR{
+			headers:  []*envoyroutev3.RouteAction_HashPolicy{headerHash("x-a", false)},
+			sourceIP: newSourceIPHashPolicy(false),
+		})
+		p2 := newPolicy(&consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHash("x-b", false)}})
+		mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{Strategy: policy.OverridableShallowMerge}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("x-b", false),
+			headerHash("x-a", false),
+		}, p1.spec.consistentHash.hashPolicies())
+	})
+}
+
+func TestApplyConsistentHash(t *testing.T) {
+	route := &envoyroutev3.Route{Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{
+		HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{headerHash("existing", false)},
+	}}}
+	applyConsistentHash(&consistentHashIR{disable: true}, route)
+	assert.Empty(t, route.GetRoute().GetHashPolicy(), "disable should clear hash policies")
+
+	applyConsistentHash(&consistentHashIR{sourceIP: newSourceIPHashPolicy(false)}, route)
+	assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{newSourceIPHashPolicy(false)}, route.GetRoute().GetHashPolicy())
+}
