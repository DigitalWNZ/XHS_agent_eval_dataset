+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: full-route
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "full-route.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: empty-route
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "empty-route.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: disabled-route
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "disabled-route.example.com"
+  rules:
+    - name: enabled
+      matches:
+        - path:
+            type: PathPrefix
+            value: /enabled
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: disabled
+      matches:
+        - path:
+            type: PathPrefix
+            value: /disabled
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-wide-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: disabled-route
+  consistentHash:
+    headers:
+      - headerName: x-route-hash
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: full-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: full-route
+  consistentHash:
+    sourceIp:
+      terminal: true
+    filterState:
+      - key: io.istio.peer_principal
+        terminal: true
+      - key: io.istio.peer_principal
+    queryParameters:
+      - name: user
+      - name: user
+        terminal: true
+    cookies:
+      - name: session
+        ttl: 1h30m
+        path: /
+        attributes:
+          - name: SameSite
+            value: Strict
+          - name: Secure
+        terminal: true
+      - name: tracker
+        ttl: "3600"
+      - name: session
+        ttl: 10s
+    headers:
+      - headerName: X-User-Id
+        regexRewrite:
+          pattern: "^user-(.*)$"
+          substitution: "\\1"
+        terminal: true
+      - headerName: x-user-id
+      - headerName: x-tenant
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: empty-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: empty-route
+  consistentHash: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: disabled-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: disabled-route
+      sectionName: disabled
+  consistentHash:
+    disable: true
