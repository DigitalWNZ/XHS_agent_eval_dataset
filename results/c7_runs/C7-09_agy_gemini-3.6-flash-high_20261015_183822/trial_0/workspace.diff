+func TestMergeConsistentHash(t *testing.T) {
+	t.Run("union array fields with higher priority first, deduplicated, re-sorted to canonical order", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "c1"},
+				},
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-H1"},
+				},
+			},
+		}
+		p1Ir := trafficPolicySpecIr{}
+		constructConsistentHash(p1Spec, &p1Ir)
+		p1 := &TrafficPolicy{spec: p1Ir}
+
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "x-h1"}, // duplicate, should be skipped
+					{HeaderName: "X-H2"},
+				},
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			},
+		}
+		p2Ir := trafficPolicySpecIr{}
+		constructConsistentHash(p2Spec, &p2Ir)
+		p2 := &TrafficPolicy{spec: p2Ir}
+
+		mergeOrigins := ir.MergeOrigins{}
+		p2Ref := &ir.AttachedPolicyRef{}
+		p2MergeOrigins := ir.MergeOrigins{}
+
+		MergeTrafficPolicies(p1, p2, p2Ref, p2MergeOrigins, policy.MergeOptions{}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		// Check merged IR
+		policies := buildEnvoyHashPolicies(p1.spec.consistentHash)
+		require.Len(t, policies, 3)
+
+		// Canonical order: Headers (X-H1, X-H2), Cookies (c1), SourceIP (nil because p1 retains its unset value)
+		assert.Equal(t, "X-H1", policies[0].GetHeader().GetHeaderName())
+		assert.Equal(t, "X-H2", policies[1].GetHeader().GetHeaderName())
+		assert.Equal(t, "c1", policies[2].GetCookie().GetName())
+
+		// Verify merge metadata origin was recorded
+		assert.NotEmpty(t, mergeOrigins["consistentHash"])
+	})
+
+	t.Run("higher priority sourceIp retains value even when unset", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-Header"}},
+			},
+		}
+		p1Ir := trafficPolicySpecIr{}
+		constructConsistentHash(p1Spec, &p1Ir)
+		p1 := &TrafficPolicy{spec: p1Ir}
+
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+			},
+		}
+		p2Ir := trafficPolicySpecIr{}
+		constructConsistentHash(p2Spec, &p2Ir)
+		p2 := &TrafficPolicy{spec: p2Ir}
+
+		mergeOrigins := ir.MergeOrigins{}
+		MergeTrafficPolicies(p1, p2, &ir.AttachedPolicyRef{}, ir.MergeOrigins{}, policy.MergeOptions{}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+		// sourceIp on p1 was unset (nil), so it remains unset!
+		assert.Nil(t, p1.spec.consistentHash.sourceIp)
+
+		policies := buildEnvoyHashPolicies(p1.spec.consistentHash)
+		require.Len(t, policies, 1)
+		assert.Equal(t, "X-Header", policies[0].GetHeader().GetHeaderName())
+	})
+
+	t.Run("higher priority disable=true suppresses all lower priority fields", func(t *testing.T) {
+		p1Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: ptr.To(true),
+			},
+		}
+		p1Ir := trafficPolicySpecIr{}
+		constructConsistentHash(p1Spec, &p1Ir)
+		p1 := &TrafficPolicy{spec: p1Ir}
+
+		p2Spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-Header"}},
+			},
+		}
+		p2Ir := trafficPolicySpecIr{}
+		constructConsistentHash(p2Spec, &p2Ir)
+		p2 := &TrafficPolicy{spec: p2Ir}
+
+		MergeTrafficPolicies(p1, p2, &ir.AttachedPolicyRef{}, ir.MergeOrigins{}, policy.MergeOptions{}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+
+		policies := buildEnvoyHashPolicies(p1.spec.consistentHash)
+		assert.Nil(t, policies)
+	})
+}
