+func TestConstructAndBuildConsistentHash(t *testing.T) {
+	t.Run("empty consistentHash defaults to single sourceIp with terminal=false", func(t *testing.T) {
+		spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{},
+		}
+		out := trafficPolicySpecIr{}
+		constructConsistentHash(spec, &out)
+
+		require.NotNil(t, out.consistentHash)
+		policies := buildEnvoyHashPolicies(out.consistentHash)
+		require.Len(t, policies, 1)
+
+		connProps := policies[0].GetConnectionProperties()
+		require.NotNil(t, connProps)
+		assert.True(t, connProps.GetSourceIp())
+		assert.False(t, policies[0].GetTerminal())
+	})
+
+	t.Run("disable=true produces nil hash policies", func(t *testing.T) {
+		spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: ptr.To(true),
+			},
+		}
+		out := trafficPolicySpecIr{}
+		constructConsistentHash(spec, &out)
+
+		require.NotNil(t, out.consistentHash)
+		assert.True(t, *out.consistentHash.disable)
+
+		policies := buildEnvoyHashPolicies(out.consistentHash)
+		assert.Nil(t, policies)
+	})
+
+	t.Run("deduplication within single policy preserves first occurrence", func(t *testing.T) {
+		spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User-Id", Terminal: ptr.To(true)},
+					{HeaderName: "x-user-id", Terminal: ptr.To(false)}, // duplicate, case-insensitive
+					{HeaderName: "X-Other"},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", TTL: "3600"},
+					{Name: "session", TTL: "7200"}, // duplicate
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "param1"},
+					{Name: "param1"},
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "key1"},
+					{Key: "key1"},
+				},
+			},
+		}
+		out := trafficPolicySpecIr{}
+		constructConsistentHash(spec, &out)
+
+		policies := buildEnvoyHashPolicies(out.consistentHash)
+		require.Len(t, policies, 5) // 2 headers + 1 cookie + 1 qp + 1 filterState
+
+		// Header 0: X-User-Id (casing preserved, terminal=true)
+		assert.Equal(t, "X-User-Id", policies[0].GetHeader().GetHeaderName())
+		assert.True(t, policies[0].GetTerminal())
+
+		// Header 1: X-Other
+		assert.Equal(t, "X-Other", policies[1].GetHeader().GetHeaderName())
+
+		// Cookie: session
+		assert.Equal(t, "session", policies[2].GetCookie().GetName())
+
+		// QueryParameter: param1
+		assert.Equal(t, "param1", policies[3].GetQueryParameter().GetName())
+	})
+
+	t.Run("all sub-fields built in canonical type order", func(t *testing.T) {
+		spec := kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "fs1"},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "qp1"},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{
+						Name: "c1",
+						TTL:  "1h30m",
+						Path: "/app",
+						Attributes: []kgateway.CookieAttribute{
+							{Name: "SameSite", Value: "Strict"},
+						},
+					},
+				},
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "X-Auth",
+						RegexRewrite: &kgateway.RegexRewrite{
+							Pattern:      "^Prefix-(.*)$",
+							Substitution: "\\1",
+						},
+					},
+				},
+			},
+		}
+		out := trafficPolicySpecIr{}
+		constructConsistentHash(spec, &out)
+
+		policies := buildEnvoyHashPolicies(out.consistentHash)
+		require.Len(t, policies, 5)
+
+		// Order MUST be: headers, cookies, queryParameters, filterState, sourceIp
+		assert.NotNil(t, policies[0].GetHeader())
+		assert.Equal(t, "X-Auth", policies[0].GetHeader().GetHeaderName())
+		assert.Equal(t, "^Prefix-(.*)$", policies[0].GetHeader().GetRegexRewrite().GetPattern().GetRegex())
+		assert.Equal(t, "\\1", policies[0].GetHeader().GetRegexRewrite().GetSubstitution())
+
+		assert.NotNil(t, policies[1].GetCookie())
+		assert.Equal(t, "c1", policies[1].GetCookie().GetName())
+		assert.Equal(t, "/app", policies[1].GetCookie().GetPath())
+		assert.Equal(t, int64((1*time.Hour+30*time.Minute)/time.Second), policies[1].GetCookie().GetTtl().GetSeconds())
+		require.Len(t, policies[1].GetCookie().GetAttributes(), 1)
+		assert.Equal(t, "SameSite", policies[1].GetCookie().GetAttributes()[0].GetName())
+		assert.Equal(t, "Strict", policies[1].GetCookie().GetAttributes()[0].GetValue())
+
+		assert.NotNil(t, policies[2].GetQueryParameter())
+		assert.Equal(t, "qp1", policies[2].GetQueryParameter().GetName())
+
+		assert.NotNil(t, policies[3].GetFilterState())
+		assert.Equal(t, "fs1", policies[3].GetFilterState().GetKey())
+
+		assert.NotNil(t, policies[4].GetConnectionProperties())
+		assert.True(t, policies[4].GetConnectionProperties().GetSourceIp())
+		assert.True(t, policies[4].GetTerminal())
+	})
+}
