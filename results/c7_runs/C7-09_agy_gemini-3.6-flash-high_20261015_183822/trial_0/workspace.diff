+	})
+
+	t.Run("invalid cookie ttl returns error", func(t *testing.T) {
+		ch := &consistentHashIR{
+			cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1", TTL: "invalid-ttl"},
+			},
+		}
+		err := ch.Validate()
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid cookie ttl")
+	})
+}
