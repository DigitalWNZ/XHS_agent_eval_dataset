+func assertShapeEqual(t *testing.T, id int32, got, want Shape) {
+	t.Helper()
+	if (got == nil) != (want == nil) {
+		t.Fatalf("shape %d nil mismatch: got %v, want %v", id, got, want)
+	}
+	if got == nil {
+		return
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("shape %d Dimension() = %d, want %d", id, got.Dimension(), want.Dimension())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("shape %d IsEmpty() = %v, want %v", id, got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("shape %d IsFull() = %v, want %v", id, got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("shape %d ReferencePoint() = %v, want %v", id, got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("shape %d NumEdges() = %d, want %d", id, got.NumEdges(), want.NumEdges())
+	}
+	for e := 0; e < want.NumEdges(); e++ {
+		if got.Edge(e) != want.Edge(e) {
+			t.Errorf("shape %d Edge(%d) = %v, want %v", id, e, got.Edge(e), want.Edge(e))
+		}
+		if got.ChainPosition(e) != want.ChainPosition(e) {
+			t.Errorf("shape %d ChainPosition(%d) = %v, want %v", id, e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("shape %d NumChains() = %d, want %d", id, got.NumChains(), want.NumChains())
+	}
+	for c := 0; c < want.NumChains(); c++ {
+		chGot := got.Chain(c)
+		chWant := want.Chain(c)
+		if chGot != chWant {
+			t.Fatalf("shape %d Chain(%d) = %v, want %v", id, c, chGot, chWant)
+		}
+		for offset := 0; offset < chWant.Length; offset++ {
+			if got.ChainEdge(c, offset) != want.ChainEdge(c, offset) {
+				t.Errorf("shape %d ChainEdge(%d, %d) = %v, want %v", id, c, offset, got.ChainEdge(c, offset), want.ChainEdge(c, offset))
+			}
+		}
+	}
+}
+
+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded ShapeIndex should be fresh without calling Build()")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	for id := int32(0); id < want.nextID; id++ {
+		assertShapeEqual(t, id, got.Shape(id), want.Shape(id))
+	}
+	if !reflect.DeepEqual(got.cells, want.cells) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	for _, cid := range want.cells {
+		cGot := got.cellMap[cid]
+		cWant := want.cellMap[cid]
+		if !reflect.DeepEqual(cGot, cWant) {
+			t.Errorf("cellMap[%v] = %+v, want %+v", cid, cGot, cWant)
+		}
+	}
+}
