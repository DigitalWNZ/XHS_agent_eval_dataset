+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.Build()
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUvarint(uint64(maxEdges))
+
+	if s.nextID < 0 || s.nextID > maxEncodedShapes {
+		if e.err == nil {
+			e.err = fmt.Errorf("invalid nextID (%d; max is %d)", s.nextID, maxEncodedShapes)
+		}
+		return
+	}
+	e.writeUvarint(uint64(s.nextID))
+
+	for id := int32(0); id < s.nextID; id++ {
+		if e.err != nil {
+			return
+		}
+		shape := s.shapes[id]
+		if shape == nil {
+			e.writeUvarint(uint64(typeTagNone))
+			continue
+		}
+		encodeShape(e, shape)
+	}
+
+	if len(s.cells) > maxEncodedCells {
+		if e.err == nil {
+			e.err = fmt.Errorf("too many cells (%d; max is %d)", len(s.cells), maxEncodedCells)
+		}
+		return
+	}
+	e.writeUvarint(uint64(len(s.cells)))
+
+	for _, cellID := range s.cells {
+		if e.err != nil {
+			return
+		}
+		cellID.encode(e)
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+}
+
+func encodeShape(e *encoder, shape Shape) {
+	switch sh := shape.(type) {
+	case *Polygon:
+		e.writeUvarint(uint64(typeTagPolygon))
+		sh.encode(e)
+	case *Polyline:
+		e.writeUvarint(uint64(typeTagPolyline))
+		sh.encode(e)
+	case *PointVector:
+		e.writeUvarint(uint64(typeTagPointVector))
+		if len(*sh) > maxEncodedVertices {
+			e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(*sh), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(len(*sh)))
+		for _, pt := range *sh {
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
+	case *LaxPolyline:
+		e.writeUvarint(uint64(typeTagLaxPolyline))
+		if len(sh.vertices) > maxEncodedVertices {
+			e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(sh.vertices), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(len(sh.vertices)))
+		for _, pt := range sh.vertices {
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
+	case *LaxPolygon:
+		e.writeUvarint(uint64(typeTagLaxPolygon))
+		if sh.numLoops > maxEncodedLoops {
+			e.err = fmt.Errorf("too many loops (%d; max is %d)", sh.numLoops, maxEncodedLoops)
+			return
+		}
+		if len(sh.vertices) > maxEncodedVertices {
+			e.err = fmt.Errorf("too many vertices (%d; max is %d)", len(sh.vertices), maxEncodedVertices)
+			return
+		}
+		e.writeUvarint(uint64(sh.numLoops))
+		for i := 0; i < sh.numLoops; i++ {
+			n := sh.numLoopVertices(i)
+			e.writeUvarint(uint64(n))
+			for j := 0; j < n; j++ {
+				pt := sh.loopVertex(i, j)
+				e.writeFloat64(pt.X)
+				e.writeFloat64(pt.Y)
+				e.writeFloat64(pt.Z)
