+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > 10000 {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell: %d", maxEdgesPerCell)
+		return
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+
+	shapes := make(map[int32]Shape)
+	var totalVertices uint64
+	for id := uint64(0); id < nextID; id++ {
+		if d.err != nil {
+			return
+		}
+		tag := typeTag(d.readUvarint())
+		if d.err != nil {
+			return
+		}
+		if tag == typeTagNone {
+			continue
+		}
+		shape := decodeShape(d, tag)
+		if d.err != nil {
+			return
+		}
+		totalVertices += uint64(shape.NumEdges())
+		if totalVertices > maxEncodedVertices {
+			d.err = fmt.Errorf("too many total edges in index (%d; max is %d)", totalVertices, maxEncodedVertices)
+			return
+		}
+		shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(numCells, 1024))
+	}
+	cellMap := make(map[CellID]*ShapeIndexCell, min(numCells, 1024))
+	var totalClippedShapes uint64
+	var totalClippedEdges uint64
+
+	for i := uint64(0); i < numCells; i++ {
+		var cellID CellID
+		cellID.decode(d)
+		if d.err != nil {
+			return
+		}
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID: %v", cellID)
+			return
+		}
+		if i > 0 && cellID <= cells[i-1] {
+			d.err = fmt.Errorf("cells not in strictly increasing order: %v <= %v", cellID, cells[i-1])
+			return
+		}
+		if i > 0 && cells[i-1].RangeMax() >= cellID.RangeMin() {
+			d.err = fmt.Errorf("overlapping cells: %v and %v", cells[i-1], cellID)
+			return
+		}
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped > uint64(len(shapes)) || numClipped > maxEncodedShapes {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; active shapes: %d)", numClipped, len(shapes))
+			return
+		}
+		totalClippedShapes += numClipped
+		if totalClippedShapes > maxEncodedCells {
+			d.err = fmt.Errorf("too many total clipped shapes (%d; max is %d)", totalClippedShapes, maxEncodedCells)
+			return
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		prevShapeID := int32(-1)
+		for j := uint64(0); j < numClipped; j++ {
+			rawShapeID := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if rawShapeID >= nextID {
+				d.err = fmt.Errorf("clipped shapeID %d out of range [0, %d)", rawShapeID, nextID)
+				return
+			}
+			shapeID := int32(rawShapeID)
+			if shapeID <= prevShapeID {
+				d.err = fmt.Errorf("clipped shapeIDs not in strictly increasing order: %d <= %d", shapeID, prevShapeID)
+				return
+			}
+			prevShapeID = shapeID
+
+			shape := shapes[shapeID]
+			if shape == nil {
+				d.err = fmt.Errorf("clipped shape references nil shape %d", shapeID)
+				return
+			}
+
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			shapeNumEdges := uint64(shape.NumEdges())
+			if numEdges > shapeNumEdges {
+				d.err = fmt.Errorf("clipped shape has %d edges, but shape %d only has %d edges", numEdges, shapeID, shapeNumEdges)
+				return
+			}
+			totalClippedEdges += numEdges
+			if totalClippedEdges > maxEncodedVertices {
+				d.err = fmt.Errorf("too many total clipped edges (%d; max is %d)", totalClippedEdges, maxEncodedVertices)
+				return
+			}
+
+			clipped := newClippedShape(shapeID, int(numEdges))
+			clipped.containsCenter = containsCenter
+			prevEdgeID := -1
+			for k := uint64(0); k < numEdges; k++ {
+				rawEdgeID := d.readUvarint()
+				if d.err != nil {
+					return
+				}
+				if rawEdgeID >= shapeNumEdges {
+					d.err = fmt.Errorf("clipped edgeID %d out of range [0, %d)", rawEdgeID, shapeNumEdges)
+					return
+				}
+				edgeID := int(rawEdgeID)
+				if edgeID <= prevEdgeID {
+					d.err = fmt.Errorf("clipped edgeIDs not in strictly increasing order: %d <= %d", edgeID, prevEdgeID)
+					return
+				}
+				prevEdgeID = edgeID
+				clipped.edges[k] = edgeID
+			}
+			cell.shapes[j] = clipped
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = cell
+	}
+
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+	s.cells = cells
+	s.cellMap = cellMap
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+}
+
+func readPoints(d *decoder, n uint64) []Point {
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+	const chunkSize = 4096
+	pts := make([]Point, 0, min(n, chunkSize))
+	for i := uint64(0); i < n; i++ {
+		x := d.readFloat64()
+		y := d.readFloat64()
+		z := d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, Point{r3.Vector{X: x, Y: y, Z: z}})
+	}
+	return pts
+}
+
+func decodeShape(d *decoder, tag typeTag) Shape {
+	switch tag {
+	case typeTagPolygon:
+		p := new(Polygon)
+		version := int8(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		switch version {
+		case encodingVersion:
+			p.decode(d)
+		case encodingCompressedVersion:
+			p.decodeCompressed(d)
+		default:
+			d.err = fmt.Errorf("unsupported polygon version %d", version)
+			return nil
+		}
+		return p
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		return p
+	case typeTagPointVector:
+		n := d.readUvarint()
+		pts := PointVector(readPoints(d, n))
+		if d.err != nil {
+			return nil
+		}
+		return &pts
+	case typeTagLaxPolyline:
+		n := d.readUvarint()
+		pts := readPoints(d, n)
+		if d.err != nil {
+			return nil
+		}
+		return LaxPolylineFromPoints(pts)
+	case typeTagLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numLoops > maxEncodedLoops {
+			d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+			return nil
+		}
+		loops := make([][]Point, 0, min(numLoops, 1024))
+		var totalVerts uint64
+		for i := uint64(0); i < numLoops; i++ {
+			n := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if n > maxEncodedVertices || totalVerts+n > maxEncodedVertices {
+				d.err = fmt.Errorf("too many vertices (%d; max is %d)", totalVerts+n, maxEncodedVertices)
+				return nil
+			}
+			totalVerts += n
+			pts := readPoints(d, n)
+			if d.err != nil {
+				return nil
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops)
+	case typeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		return l
+	case typeTagLaxLoop:
+		n := d.readUvarint()
+		pts := readPoints(d, n)
+		if d.err != nil {
+			return nil
+		}
+		return LaxLoopFromPoints(pts)
+	case typeTagGenericEdge:
+		dim := int(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		if dim > 2 {
+			d.err = fmt.Errorf("invalid shape dimension: %d", dim)
+			return nil
+		}
+		var ref ReferencePoint
+		ref.Point.X = d.readFloat64()
+		ref.Point.Y = d.readFloat64()
+		ref.Point.Z = d.readFloat64()
+		ref.Contained = d.readBool()
+
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > maxEncodedVertices {
+			d.err = fmt.Errorf("too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+			return nil
+		}
+		edges := make([]Edge, 0, min(numEdges, 4096))
+		for i := uint64(0); i < numEdges; i++ {
+			var e Edge
+			e.V0.X = d.readFloat64()
+			e.V0.Y = d.readFloat64()
+			e.V0.Z = d.readFloat64()
+			e.V1.X = d.readFloat64()
+			e.V1.Y = d.readFloat64()
+			e.V1.Z = d.readFloat64()
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, e)
+		}
+
+		numChains := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numChains > maxEncodedLoops {
+			d.err = fmt.Errorf("too many chains (%d; max is %d)", numChains, maxEncodedLoops)
+			return nil
+		}
+		chains := make([]Chain, 0, min(numChains, 1024))
+		expectedStart := uint64(0)
+		for i := uint64(0); i < numChains; i++ {
+			start := d.readUvarint()
+			length := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if start != expectedStart || length > numEdges-start {
+				d.err = fmt.Errorf("invalid chain %d: start=%d, length=%d (expected start=%d, numEdges=%d)", i, start, length, expectedStart, numEdges)
+				return nil
+			}
+			chains = append(chains, Chain{Start: int(start), Length: int(length)})
+			expectedStart += length
+		}
+		if numChains == 0 && numEdges > 0 {
+			d.err = fmt.Errorf("shape has %d edges but 0 chains", numEdges)
+			return nil
+		}
+		if numChains > 0 && expectedStart != numEdges {
+			d.err = fmt.Errorf("chains cover %d edges, want %d", expectedStart, numEdges)
+			return nil
+		}
+		return &decodedGenericShape{
+			dim:    dim,
+			ref:    ref,
+			edges:  edges,
+			chains: chains,
+		}
+	default:
+		d.err = fmt.Errorf("unsupported shape type tag: %d", tag)
+		return nil
+	}
+}
+
+type decodedGenericShape struct {
+	dim    int
+	ref    ReferencePoint
+	edges  []Edge
+	chains []Chain
+}
+
+func (g *decodedGenericShape) NumEdges() int                  { return len(g.edges) }
+func (g *decodedGenericShape) Edge(i int) Edge                { return g.edges[i] }
+func (g *decodedGenericShape) ReferencePoint() ReferencePoint { return g.ref }
+func (g *decodedGenericShape) NumChains() int                 { return len(g.chains) }
+func (g *decodedGenericShape) Chain(chainID int) Chain        { return g.chains[chainID] }
+func (g *decodedGenericShape) ChainEdge(chainID, offset int) Edge {
+	return g.edges[g.chains[chainID].Start+offset]
+}
+func (g *decodedGenericShape) ChainPosition(edgeID int) ChainPosition {
+	// Binary search for chain containing edgeID.
+	i := sort.Search(len(g.chains), func(c int) bool {
+		return g.chains[c].Start+g.chains[c].Length > edgeID
+	})
+	if i < len(g.chains) {
+		return ChainPosition{ChainID: i, Offset: edgeID - g.chains[i].Start}
+	}
+	return ChainPosition{ChainID: 0, Offset: edgeID}
+}
+func (g *decodedGenericShape) Dimension() int    { return g.dim }
+func (g *decodedGenericShape) IsEmpty() bool     { return defaultShapeIsEmpty(g) }
+func (g *decodedGenericShape) IsFull() bool      { return defaultShapeIsFull(g) }
+func (g *decodedGenericShape) typeTag() typeTag  { return typeTagNone }
+func (g *decodedGenericShape) privateInterface() {}
+
