+		assert.False(t, out.consistentHash.hashPolicies[3].GetTerminal())
+
+		// FilterState "k1" keeps Terminal=false
+		assert.Equal(t, "k1", out.consistentHash.hashPolicies[4].GetFilterState().GetKey())
+		assert.False(t, out.consistentHash.hashPolicies[4].GetTerminal())
+	})
+}
