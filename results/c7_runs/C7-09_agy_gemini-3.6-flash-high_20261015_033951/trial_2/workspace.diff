+def make_msgid(idstring=None, domain=None):
+    """Returns a string suitable for a RFC 2822 compliant Message-ID, e.g:
+
+    <142823664002.83313.2964821812836262923@A-Main-Computer.local>
+
+    The optional idstring argument is a string used to strengthen the
+    uniqueness of the message id.  The optional domain argument provides the
+    portion of the message id after the '@'.  It defaults to the connection's
+    hostname.
+    """
+    if domain is None:
+        domain = DNS_NAME
+    return _make_msgid(idstring, domain=str(domain).encode('idna').decode('ascii'))
+
