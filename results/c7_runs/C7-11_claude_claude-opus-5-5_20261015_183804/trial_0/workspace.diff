+// checkIndexesEqual compares two indexes without building the second one.
+func checkIndexesEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+	want.Build()
+	if !got.IsFresh() {
+		t.Fatalf("decoded index is not fresh")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	for id := int32(0); id < want.nextID; id++ {
+		ws, gs := want.Shape(id), got.Shape(id)
+		if (ws == nil) != (gs == nil) {
+			t.Fatalf("Shape(%d) = %v, want %v", id, gs, ws)
+		}
+		if ws != nil {
+			checkShapesEqual(t, id, ws, gs)
+		}
+	}
+	if !slices.Equal(got.cells, want.cells) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	wi, gi := want.Iterator(), got.Iterator()
+	for ; !wi.Done(); wi.Next() {
+		if gi.Done() || gi.CellID() != wi.CellID() {
+			t.Fatalf("iterator mismatch at %v", wi.CellID())
+		}
+		wc, gc := wi.IndexCell(), gi.IndexCell()
+		if len(wc.shapes) != len(gc.shapes) {
+			t.Fatalf("cell %v: %d clipped shapes, want %d", wi.CellID(), len(gc.shapes), len(wc.shapes))
+		}
+		for i := range wc.shapes {
+			if !reflect.DeepEqual(wc.shapes[i], gc.shapes[i]) {
+				t.Errorf("cell %v: clipped %d = %+v, want %+v", wi.CellID(), i, gc.shapes[i], wc.shapes[i])
+			}
+		}
+		gi.Next()
+	}
+	if !gi.Done() {
+		t.Errorf("decoded index has extra cells")
+	}
+}
+
+func allShapesIndex() *ShapeIndex {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2", true))
+	index.Add(makePolyline("20:20, 21:21, 22:20"))
+	pv := PointVector(parsePoints("30:30, 31:31, -5:170"))
+	index.Add(&pv)
+	index.Add(makeLaxPolyline("-10:-10, -11:-12, -14:-10"))
+	index.Add(makeLaxPolygon("40:40, 40:45, 45:45; full; 50:50, 50:55, 55:55, 55:50"))
+	index.Add(makeLoop("-30:-30, -30:-20, -20:-20, -20:-30"))
+	index.Add(LaxLoopFromPoints(parsePoints("60:60, 60:70, 70:70")))
+	index.Add(RegularLoop(PointFromLatLng(LatLngFromDegrees(-60, 100)), s1.Degree*20, 500))
+	return index
+}
