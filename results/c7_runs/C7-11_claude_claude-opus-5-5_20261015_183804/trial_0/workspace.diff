+func TestShapeIndexEncodeDecodeAllShapes(t *testing.T) {
+	index := allShapesIndex()
+	got := roundTripShapeIndex(t, index)
+	checkIndexesEqual(t, index, got)
+	testIteratorMethods(t, got)
+	quadraticValidate(t, got)
+
+	// Queries on the decoded index must match the original.
+	wq := NewContainsPointQuery(index, VertexModelSemiOpen)
+	gq := NewContainsPointQuery(got, VertexModelSemiOpen)
+	for i := 0; i < 1000; i++ {
+		p := randomPoint()
+		if w, g := wq.Contains(p), gq.Contains(p); w != g {
+			t.Errorf("Contains(%v) = %v, want %v", p, g, w)
+		}
+	}
+	p := parsePoint("5:1")
+	if !gq.Contains(p) {
+		t.Errorf("decoded index should contain %v", p)
+	}
+	if gq.Contains(parsePoint("5:5")) {
+		t.Errorf("decoded index should not contain point in hole")
+	}
+
+	// The decoded polygon and loop retain their own functionality.
+	if !got.Shape(0).(*Polygon).ContainsPoint(p) {
+		t.Errorf("decoded polygon should contain %v", p)
+	}
+	if !got.Shape(5).(*Loop).ContainsPoint(parsePoint("-25:-25")) {
+		t.Errorf("decoded loop should contain -25:-25")
+	}
+
+	// Re-encoding the decoded index gives identical bytes.
+	if !bytes.Equal(encodeShapeIndex(t, index), encodeShapeIndex(t, got)) {
+		t.Errorf("re-encoding decoded index produced different bytes")
+	}
+}
