+// smallShapesIndex has one shape of each kind, with few vertices, so that
+// byte-by-byte corruption tests stay fast.
+func smallShapesIndex() *ShapeIndex {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2", true))
+	index.Add(makePolyline("20:20, 21:21"))
+	pv := PointVector(parsePoints("30:30, -5:170"))
+	index.Add(&pv)
+	index.Add(makeLaxPolyline("-10:-10, -11:-12"))
+	index.Add(makeLaxPolygon("40:40, 40:45, 45:45; full"))
+	index.Add(makeLoop("-30:-30, -30:-20, -20:-20"))
+	index.Add(LaxLoopFromPoints(parsePoints("60:60, 60:70, 70:70")))
+	index.Add(edgeVectorShapeFromPoints(parsePoint("1:1"), parsePoint("2:2")))
+	return index
+}
+
+func TestShapeIndexDecodeTruncated(t *testing.T) {
+	data := encodeShapeIndex(t, smallShapesIndex())
+	for n := 0; n < len(data); n++ {
+		if err := NewShapeIndex().Decode(bytes.NewReader(data[:n])); err == nil {
+			t.Fatalf("Decode(truncated to %d of %d bytes) succeeded, want error", n, len(data))
+		}
+	}
+}
+
+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	data := encodeShapeIndex(t, smallShapesIndex())
+	corrupt := make([]byte, len(data))
+	for i := range data {
+		for _, x := range []byte{0x01, 0x80, 0xff} {
+			copy(corrupt, data)
+			corrupt[i] ^= x
+			// Must not panic; an error or a successful decode are both fine.
+			_ = NewShapeIndex().Decode(bytes.NewReader(corrupt))
+		}
+	}
+}
+
+func TestShapeIndexDecodeOversized(t *testing.T) {
+	uv := func(x uint64) []byte { return binary.AppendUvarint(nil, x) }
+	cat := func(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+	header := func(nextID, numShapes uint64) []byte {
+		return cat([]byte{shapeIndexEncodingVersion}, uv(10), uv(nextID), uv(numShapes))
+	}
+	huge := uint64(1) << 62
+
+	tests := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", nil},
+		{"bad version", []byte{99}},
+		{"zero maxEdgesPerCell", cat([]byte{shapeIndexEncodingVersion}, uv(0), uv(0), uv(0), uv(0))},
+		{"huge nextID", header(huge, 0)},
+		{"more shapes than IDs", header(1, 2)},
+		{"huge vertex count", cat(header(1, 1), uv(0), []byte{byte(shapeKindPolyline)}, uv(huge))},
+		{"large vertex count, no data", cat(header(1, 1), uv(0), []byte{byte(shapeKindPolyline)}, uv(maxEncodedVertices))},
+		{"huge loop count", cat(header(1, 1), uv(0), []byte{byte(shapeKindPolygon), 0}, uv(huge))},
+		{"large loop count, no data", cat(header(1, 1), uv(0), []byte{byte(shapeKindLaxPolygon)}, uv(maxEncodedLoops))},
+		{"unknown shape kind", cat(header(1, 1), uv(0), []byte{200})},
+		{"shape ID out of range", cat(header(1, 1), uv(5), []byte{byte(shapeKindPolyline)}, uv(0))},
+		{"huge cell count", cat(header(0, 0), uv(huge))},
+		{"large cell count, no data", cat(header(0, 0), uv(maxEncodedCells))},
+		{"invalid cell ID", cat(header(0, 0), uv(1), make([]byte, 8), uv(0))},
+		{"cell references unknown shape", cat(header(0, 0), uv(1),
+			binary.LittleEndian.AppendUint64(nil, uint64(CellIDFromFace(0))), uv(1), uv(0), []byte{0}, uv(0))},
+		{"edge out of range", cat(header(1, 1), uv(0), []byte{byte(shapeKindPolyline)}, uv(0), uv(1),
+			binary.LittleEndian.AppendUint64(nil, uint64(CellIDFromFace(0))), uv(1), uv(0), []byte{0}, uv(1), uv(0))},
+	}
+	for _, test := range tests {
+		if err := NewShapeIndex().Decode(bytes.NewReader(test.data)); err == nil {
+			t.Errorf("%s: Decode() succeeded, want error", test.name)
+		}
+	}
+}
