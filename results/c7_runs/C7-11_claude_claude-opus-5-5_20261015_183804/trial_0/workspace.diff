+func TestShapeIndexEncodeDecodeZeroEdgeShapes(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(&Polygon{})
+	index.Add(FullPolygon())
+	index.Add(&Polyline{})
+	index.Add(&PointVector{})
+	index.Add(makeLaxPolyline(""))
+	index.Add(makeLaxPolygon(""))
+	index.Add(makeLaxPolygon("full"))
+	index.Add(LaxLoopFromPoints(nil))
+	index.Add(EmptyLoop())
+	index.Add(FullLoop())
+	index.Add(&edgeVectorShape{})
+	got := roundTripShapeIndex(t, index)
+	checkIndexesEqual(t, index, got)
+
+	q := NewContainsPointQuery(got, VertexModelSemiOpen)
+	if !q.Contains(parsePoint("1:1")) {
+		t.Errorf("index with full polygon should contain every point")
+	}
+}
