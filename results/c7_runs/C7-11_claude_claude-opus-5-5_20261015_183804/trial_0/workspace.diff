+func TestShapeIndexEncodeDecodeMixedChains(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makeLaxPolygon("0:0, 0:5, 5:5; full; 10:10, 10:15, 15:15, 15:10; 20:20, 20:21, 21:21"))
+	evs := &edgeVectorShape{}
+	evs.Add(parsePoint("1:1"), parsePoint("2:2"))
+	evs.Add(parsePoint("3:3"), parsePoint("-4:4"))
+	index.Add(evs)
+	pv := PointVector(parsePoints("1:1, 2:2, 3:3, 4:4"))
+	index.Add(&pv)
+	got := roundTripShapeIndex(t, index)
+	checkIndexesEqual(t, index, got)
+}
