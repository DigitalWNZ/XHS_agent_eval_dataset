+func TestShapeIndexEncodeDecodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	a := makePolyline("0:0, 1:1")
+	b := makePolyline("2:2, 3:3")
+	c := makePolyline("4:4, 5:5")
+	d := makePolygon("10:10, 10:20, 20:20", false)
+	index.Add(a)
+	index.Add(b)
+	index.Add(c)
+	index.Add(d)
+	index.Remove(a)
+	index.Remove(c)
+
+	got := roundTripShapeIndex(t, index)
+	checkIndexesEqual(t, index, got)
+	if got.Shape(0) != nil || got.Shape(1) == nil || got.Shape(2) != nil || got.Shape(3) == nil {
+		t.Errorf("shape IDs were not preserved")
+	}
+	quadraticValidate(t, got)
+
+	// Every clipped shape in the decoded cells must refer to the same
+	// shape (by ID) as in the original index.
+	it := got.Iterator()
+	seen := map[int32]bool{}
+	for ; !it.Done(); it.Next() {
+		for _, cs := range it.IndexCell().shapes {
+			seen[cs.shapeID] = true
+		}
+	}
+	if !seen[1] || !seen[3] || seen[0] || seen[2] {
+		t.Errorf("decoded cells reference shape IDs %v, want {1, 3}", seen)
+	}
+
+	// New shapes added after decoding get fresh IDs.
+	if id := got.Add(makePolyline("8:8, 9:9")); id != 4 {
+		t.Errorf("Add() after decode = %d, want 4", id)
+	}
+}
+
+func TestShapeIndexEncodeDecodeAddAfterDecode(t *testing.T) {
+	// A decoded empty index can be populated and built normally.
+	got := roundTripShapeIndex(t, NewShapeIndex())
+	want := NewShapeIndex()
+	for _, index := range []*ShapeIndex{got, want} {
+		index.Add(makePolyline("0:0, 1:1, 2:0"))
+		index.Add(makePolygon("10:10, 10:20, 20:20", false))
+	}
+	checkIndexesEqual(t, want, roundTripShapeIndex(t, got))
+	got.Build()
+	quadraticValidate(t, got)
+}
+
+func TestShapeIndexEncodeWithoutBuild(t *testing.T) {
+	index := allShapesIndex()
+	if index.IsFresh() {
+		t.Fatalf("index should not be fresh before Build")
+	}
+	got := roundTripShapeIndex(t, index)
+	checkIndexesEqual(t, index, got)
+	if len(got.cells) == 0 {
+		t.Errorf("decoded index has no cells")
+	}
+}
+
+func TestShapeIndexDecodeReplacesContents(t *testing.T) {
+	data := encodeShapeIndex(t, allShapesIndex())
+	index := makeShapeIndex("1:1 # 2:2, 3:3 # 0:0, 0:1, 1:0")
+	index.Build()
+	if err := index.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() = %v", err)
+	}
+	checkIndexesEqual(t, allShapesIndex(), index)
+}
