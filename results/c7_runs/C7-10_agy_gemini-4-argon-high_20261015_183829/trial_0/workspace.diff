+func generateTestKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	for _, size := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		key := make([]byte, size)
+		enc, err := NewEncryptor(key)
+		assert.Nil(t, enc)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+
+	validKey := generateTestKey(t)
+	enc, err := NewEncryptor(validKey)
+	require.NoError(t, err)
+	assert.NotNil(t, enc)
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	sizes := []int{
+		0,
+		1,
+		16,
+		1024,
+		MaxChunkSize - 1,
+		MaxChunkSize,
+		MaxChunkSize + 1,
+		MaxChunkSize*2 + 500,
+		MaxChunkSize * 3,
+	}
+
+	for _, size := range sizes {
+		plaintext := make([]byte, size)
+		_, err := io.ReadFull(rand.Reader, plaintext)
+		require.NoError(t, err)
+
+		var buf bytes.Buffer
+		ew := enc.EncryptWriter(&buf)
+		n, err := ew.Write(plaintext)
+		require.NoError(t, err)
+		assert.Equal(t, size, n)
+		require.NoError(t, ew.Close())
+		// Idempotent Close
+		require.NoError(t, ew.Close())
+
+		dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+		require.NoError(t, err)
+		decrypted, err := io.ReadAll(dr)
+		require.NoError(t, err)
+		assert.True(t, bytes.Equal(plaintext, decrypted), "mismatch for size %d", size)
+	}
+}
+
+func TestWireFormatAndUniqueNonces(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := bytes.Repeat([]byte("onedump-streaming-test-data!"), 6000) // > 160KB (3 chunks)
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	// Two encryptions of same plaintext must differ
+	assert.False(t, bytes.Equal(buf1.Bytes(), buf2.Bytes()))
+
+	// Verify wire format of buf1:
+	// 3-byte header: 0x4F 0x44 0x01
+	data := buf1.Bytes()
+	require.Greater(t, len(data), 3+4+32)
+	assert.Equal(t, byte(0x4F), data[0])
+	assert.Equal(t, byte(0x44), data[1])
+	assert.Equal(t, byte(0x01), data[2])
+
+	// Parse chunks between header and sentinel
+	pos := 3
+	nonces := make(map[string]bool)
+	chunkCount := 0
+	for {
+		require.LessOrEqual(t, pos+4, len(data))
+		chunkLen := binary.BigEndian.Uint32(data[pos : pos+4])
+		if chunkLen == 0 {
+			break
+		}
+		chunkCount++
+		pos += 4
+		require.LessOrEqual(t, pos+int(chunkLen), len(data))
+		assert.LessOrEqual(t, int(chunkLen), MaxChunkSize+nonceSize+tagSize)
+
+		nonce := string(data[pos : pos+nonceSize])
+		assert.False(t, nonces[nonce], "duplicate nonce found in chunk %d", chunkCount)
+		nonces[nonce] = true
+
+		pos += int(chunkLen)
+	}
+	assert.Equal(t, 3, chunkCount)
+
+	// Verify 4-byte zero sentinel
+	sentinelStart := pos
+	assert.Equal(t, []byte{0, 0, 0, 0}, data[sentinelStart:sentinelStart+4])
+
+	// Verify 32-byte HMAC-SHA256 over all bytes between header and sentinel
+	hmacStart := sentinelStart + 4
+	assert.Equal(t, len(data), hmacStart+32)
+	mac := hmac.New(sha256.New, key)
+	mac.Write(data[3:sentinelStart])
+	expectedMAC := mac.Sum(nil)
+	assert.Equal(t, expectedMAC, data[hmacStart:])
+}
+
+func TestDecryptReaderErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("secret database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	// 1. Lazy init: invalid magic does not fail in DecryptReader, fails in Read with "invalid header"
+	badMagic := make([]byte, len(validBytes))
+	copy(badMagic, validBytes)
+	badMagic[0] = 0x00
+	dr, err := DecryptReader(bytes.NewReader(badMagic), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+
+	// 2. Unsupported version: fails in Read with "unsupported version"
+	badVersion := make([]byte, len(validBytes))
+	copy(badVersion, validBytes)
+	badVersion[2] = 0x02
+	dr, err = DecryptReader(bytes.NewReader(badVersion), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+
+	// 3. Corrupted HMAC: fails in Read with "integrity"
+	badHMAC := make([]byte, len(validBytes))
+	copy(badHMAC, validBytes)
+	badHMAC[len(badHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(badHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+
+	// 4. Wrong key: must fail
+	wrongKey := generateTestKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validBytes), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// 5. Truncated data at every prefix length must error
+	for cut := 0; cut < len(validBytes); cut++ {
+		dr, err := DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		assert.Error(t, err, "expected error for truncated length %d", cut)
+	}
+}
