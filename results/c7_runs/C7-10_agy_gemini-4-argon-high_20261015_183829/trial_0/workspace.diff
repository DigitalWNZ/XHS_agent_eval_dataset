+func TestLoadKey(t *testing.T) {
+	rawKey := generateTestKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// 1. env source
+	t.Setenv("ONEDUMP_TEST_ENC_KEY", b64Key)
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_ENC_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Unset env var -> error
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_UNSET_ENC_KEY"})
+	require.Error(t, err)
+
+	// 2. file source (trimmed)
+	tmpDir := t.TempDir()
+	keyPath := filepath.Join(tmpDir, "key.txt")
+	require.NoError(t, os.WriteFile(keyPath, []byte("  \n"+b64Key+"\n\t "), 0600))
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: keyPath})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// 3. literal source
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Non-32-byte key in literal -> error
+	shortB64 := base64.StdEncoding.EncodeToString([]byte("short-key"))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: shortB64})
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, ErrInvalidKey))
+
+	// 4. derive source
+	saltBytes := []byte("0123456789abcdef") // 16 bytes
+	b64Salt := base64.StdEncoding.EncodeToString(saltBytes)
+	k1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Len(t, k1, 32)
+
+	k2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Equal(t, k1, k2)
+
+	k3, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "different passphrase", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.NotEqual(t, k1, k3)
+
+	// Short salt (< 16 bytes) rejected
+	shortSalt := base64.StdEncoding.EncodeToString([]byte("15-bytes-salt!!"))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: shortSalt})
+	require.Error(t, err)
+
+	// Empty passphrase rejected
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt})
+	require.Error(t, err)
+}
