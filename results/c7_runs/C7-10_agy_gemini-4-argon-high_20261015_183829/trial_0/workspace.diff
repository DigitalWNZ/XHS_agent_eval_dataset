diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..5e4a0c4
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,208 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+// Config holds configuration for dump encryption.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// UnmarshalYAML supports multiple naming conventions (flat, snake_case, kebab-case) for YAML keys.
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled         bool   `yaml:"enabled"`
+		KeySource       string `yaml:"keysource"`
+		KeySourceSnake  string `yaml:"key_source"`
+		KeySourceKebab  string `yaml:"key-source"`
+		KeyEnvVar       string `yaml:"keyenvvar"`
+		KeyEnvVarSnake  string `yaml:"key_env_var"`
+		KeyEnvVarKebab  string `yaml:"key-env-var"`
+		KeyFile         string `yaml:"keyfile"`
+		KeyFileSnake    string `yaml:"key_file"`
+		KeyFileKebab    string `yaml:"key-file"`
+		Key             string `yaml:"key"`
+		Passphrase      string `yaml:"passphrase"`
+		Salt            string `yaml:"salt"`
+	}
+
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySourceSnake, raw.KeySourceKebab)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVarSnake, raw.KeyEnvVarKebab)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFileSnake, raw.KeyFileKebab)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+
+	return nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+// Validate validates the encryption configuration.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	return validateEnabledConfig(c)
+}
+
+func validateEnabledConfig(c Config) error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasPassphrase := strings.TrimSpace(c.Passphrase) != ""
+	hasSalt := strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case KeySourceEnv:
+		if hasFile || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key source fields are mutually exclusive: env source requires key_env_var and forbids other source fields")
+		}
+		if !hasEnv {
+			return errors.New("encryption key_env_var is required when key source is env")
+		}
+	case KeySourceFile:
+		if hasEnv || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key source fields are mutually exclusive: file source requires key_file and forbids other source fields")
+		}
+		if !hasFile {
+			return errors.New("encryption key_file is required when key source is file")
+		}
+	case KeySourceLiteral:
+		if hasEnv || hasFile || hasPassphrase || hasSalt {
+			return errors.New("encryption key source fields are mutually exclusive: literal source requires key and forbids other source fields")
+		}
+		if !hasLiteral {
+			return errors.New("encryption key is required when key source is literal")
+		}
+	case KeySourceDerive:
+		if hasEnv || hasFile || hasLiteral {
+			return errors.New("encryption key source fields are mutually exclusive: derive source requires passphrase and salt and forbids other source fields")
+		}
+		if !hasPassphrase {
+			return errors.New("encryption passphrase is required when key source is derive")
+		}
+		if !hasSalt {
+			return errors.New("encryption salt is required when key source is derive")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+// LoadKey loads or derives a 32-byte encryption key based on the provided Config.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := validateEnabledConfig(cfg); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envName)
+		}
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(val))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from environment variable %q: %w", envName, err)
+		}
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: encryption key from environment variable %q must be %d bytes, got %d", ErrInvalidKey, envName, KeySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		if trimmed == "" {
+			return nil, fmt.Errorf("%w: encryption key file %q is empty", ErrInvalidKey, filePath)
+		}
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %q: %w", filePath, err)
+		}
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: encryption key from file %q must be %d bytes, got %d", ErrInvalidKey, filePath, KeySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceLiteral:
+		trimmed := strings.TrimSpace(cfg.Key)
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 literal encryption key: %w", err)
+		}
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: literal encryption key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+		salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(salt) < MinSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", MinSaltSize, len(salt))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, pbkdf2Iterations, KeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..3a292d2
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,348 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize        = 32
+	MaxChunkSize   = 64 * 1024
+	nonceSize      = 12
+	tagSize        = 16
+	headerSize     = 3
+	sentinelSize   = 4
+	hmacSize       = 32
+	currentVersion = 0x01
+)
+
+var (
+	magicBytes    = [2]byte{0x4F, 0x44}
+	ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+)
+
+// Encryptor handles AES-256-GCM streaming encryption.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor with a 32-byte AES-256 key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	return &Encryptor{
+		key: keyCopy,
+	}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts written data using AES-256-GCM in chunks up to 64KB.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		return &encryptWriter{w: w, err: err}
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return &encryptWriter{w: w, err: err}
+	}
+
+	return &encryptWriter{
+		w:    w,
+		aead: aead,
+		mac:  hmac.New(sha256.New, e.key),
+		buf:  make([]byte, 0, MaxChunkSize),
+	}
+}
+
+// DecryptReader method on Encryptor for convenience.
+func (e *Encryptor) DecryptReader(r io.Reader) (io.Reader, error) {
+	return DecryptReader(r, e.key)
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+
+	header := [headerSize]byte{magicBytes[0], magicBytes[1], currentVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return err
+	}
+
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	sealed := ew.aead.Seal(nil, nonce, plaintext, nil)
+	chunkLen := uint32(len(nonce) + len(sealed))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	ew.mac.Write(lenBuf[:])
+	ew.mac.Write(nonce)
+	ew.mac.Write(sealed)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(sealed); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if ew.closed {
+		return 0, errors.New("encryption writer is already closed")
+	}
+
+	totalWritten := len(p)
+	for len(p) > 0 {
+		space := MaxChunkSize - len(ew.buf)
+		toCopy := len(p)
+		if toCopy > space {
+			toCopy = space
+		}
+
+		ew.buf = append(ew.buf, p[:toCopy]...)
+		p = p[toCopy:]
+
+		if len(ew.buf) == MaxChunkSize {
+			if err := ew.writeChunk(ew.buf); err != nil {
+				ew.err = err
+				return 0, err
+			}
+			ew.buf = ew.buf[:0]
+		}
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.writeChunk(ew.buf); err != nil {
+			ew.err = err
+			return err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	var sentinel [sentinelSize]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		ew.err = err
+		return err
+	}
+
+	digest := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(digest); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+// DecryptReader returns an io.Reader that decrypts a stream produced by EncryptWriter.
+// Initialization of the stream header is performed lazily on the first Read call.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, err
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	return &decryptReader{
+		r:    r,
+		aead: aead,
+		mac:  hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r          io.Reader
+	aead       cipher.AEAD
+	mac        hash.Hash
+	plainBuf   []byte
+	headerRead bool
+	eof        bool
+	err        error
+}
+
+func (dr *decryptReader) readHeader() error {
+	var header [headerSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("invalid header: truncated encrypted stream: %w", io.ErrUnexpectedEOF)
+		}
+		return fmt.Errorf("invalid header: %w", err)
+	}
+
+	if header[0] != magicBytes[0] || header[1] != magicBytes[1] {
+		return fmt.Errorf("invalid header: unexpected magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+
+	if header[2] != currentVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	dr.headerRead = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream reading chunk length: %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		// Zero sentinel reached; read and verify 32-byte HMAC-SHA256.
+		var expectedMAC [hmacSize]byte
+		if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return fmt.Errorf("truncated encrypted stream reading HMAC: %w", io.ErrUnexpectedEOF)
+			}
+			return err
+		}
+
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC[:]) {
+			return errors.New("integrity check failed: HMAC verification failed")
+		}
+
+		dr.eof = true
+		return nil
+	}
+
+	minChunkLen := uint32(nonceSize + tagSize)
+	maxChunkLen := uint32(MaxChunkSize + nonceSize + tagSize)
+	if chunkLen < minChunkLen || chunkLen > maxChunkLen {
+		return fmt.Errorf("invalid chunk length %d: integrity check failed or truncated data", chunkLen)
+	}
+
+	chunkBuf := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkBuf); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted chunk data: %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	dr.mac.Write(lenBuf[:])
+	dr.mac.Write(chunkBuf)
+
+	nonce := chunkBuf[:nonceSize]
+	ciphertextWithTag := chunkBuf[nonceSize:]
+
+	plaintext, err := dr.aead.Open(nil, nonce, ciphertextWithTag, nil)
+	if err != nil {
+		return fmt.Errorf("decryption failed (wrong key or integrity check failed): %w", err)
+	}
+
+	dr.plainBuf = append(dr.plainBuf, plaintext...)
+	if len(plaintext) < MaxChunkSize {
+		return dr.readNextChunk()
+	}
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.headerRead {
+		if err := dr.readHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.plainBuf) == 0 && !dr.eof {
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if len(dr.plainBuf) > 0 {
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+
+	dr.err = io.EOF
+	return 0, io.EOF
+}
