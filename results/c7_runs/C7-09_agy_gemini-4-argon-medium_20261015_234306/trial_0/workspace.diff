--- a/api/tests/cel_test.go
+++ b/api/tests/cel_test.go
@@ -3,6 +3,10 @@ package tests
 import (
 	"testing"
 
+	"github.com/stretchr/testify/require"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"sigs.k8s.io/yaml"
+
 	"github.com/kgateway-dev/kgateway/v2/test/crvalidation"
 )
 
@@ -10,3 +14,118 @@ func TestCRDs(t *testing.T) {
 	v := NewKgatewayValidator(t)
 	crvalidation.TestCRValidation(t, v, "testdata")
 }
+
+func TestConsistentHashCELValidation(t *testing.T) {
+	v := NewKgatewayValidator(t)
+
+	tests := []struct {
+		name    string
+		yaml    string
+		wantErr bool
+	}{
+		{
+			name: "empty consistentHash is valid",
+			yaml: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-empty-ch
+spec:
+  consistentHash: {}
+`,
+			wantErr: false,
+		},
+		{
+			name: "disable true alone is valid",
+			yaml: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-ch
+spec:
+  consistentHash:
+    disable: true
+`,
+			wantErr: false,
+		},
+		{
+			name: "disable true with headers is invalid",
+			yaml: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-with-headers
+spec:
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: X-Foo
+`,
+			wantErr: true,
+		},
+		{
+			name: "disable true with sourceIp is invalid",
+			yaml: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-with-sourceip
+spec:
+  consistentHash:
+    disable: true
+    sourceIp:
+      terminal: true
+`,
+			wantErr: true,
+		},
+		{
+			name: "all consistentHash sub-fields are valid",
+			yaml: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-full-ch
+spec:
+  consistentHash:
+    headers:
+    - headerName: X-User-Id
+      regexRewrite:
+        pattern: "^user-(.*)"
+        substitution: "\\1"
+      terminal: true
+    cookies:
+    - name: session-id
+      ttl: "3600"
+      path: /
+      attributes:
+      - name: SameSite
+        value: Lax
+      - name: Secure
+        value: "true"
+      terminal: false
+    queryParameters:
+    - name: user
+      terminal: false
+    filterState:
+    - key: envoy.network.application_protocol
+      terminal: false
+    sourceIp:
+      terminal: true
+`,
+			wantErr: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			obj := &unstructured.Unstructured{}
+			require.NoError(t, yaml.Unmarshal([]byte(tt.yaml), obj))
+			err := v.ValidateCustomResource(obj)
+			if tt.wantErr {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
