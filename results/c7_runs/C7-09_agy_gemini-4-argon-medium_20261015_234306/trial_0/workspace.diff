+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	buildPolicy := func(name string, ch *kgateway.ConsistentHash) ir.PolicyAtt {
+		spec := trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, &spec)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{
+				Group:     "gateway.kgateway.dev",
+				Kind:      "TrafficPolicy",
+				Namespace: "default",
+				Name:      name,
+			},
+			PolicyIr: &TrafficPolicy{
+				ct:   time.Now(),
+				spec: spec,
+			},
+		}
+	}
+
+	t.Run("unions array fields with higher priority first, deduplicates by key, re-sorts canonically, and retains unset sourceIp", func(t *testing.T) {
+		pHigh := buildPolicy("high-pol", &kgateway.ConsistentHash{
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1", Path: "/high", Terminal: false},
+			},
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Shared", Terminal: false},
+				{HeaderName: "X-High", Terminal: true},
+			},
+			// SourceIp intentionally unset on high-pol
+		})
+
+		pLow := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared", Terminal: true}, // duplicate (case-insensitive)
+				{HeaderName: "X-Low", Terminal: false},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1", Path: "/low", Terminal: true}, // duplicate
+				{Name: "c2", Path: "/low2", Terminal: false},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "q1", Terminal: false},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs1", Terminal: true},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIP{
+				Terminal: true,
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP, ok := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.True(t, ok)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		// Expected order:
+		// 0: Header X-Shared (from high-pol)
+		// 1: Header X-High (from high-pol)
+		// 2: Header X-Low (from low-pol)
+		// 3: Cookie c1 (from high-pol)
+		// 4: Cookie c2 (from low-pol)
+		// 5: QueryParameter q1 (from low-pol)
+		// 6: FilterState fs1 (from low-pol)
+		// (No SourceIp because high-pol had SourceIp unset)
+		require.Len(t, hps, 7)
+
+		assert.Equal(t, "X-Shared", hps[0].GetHeader().GetHeaderName())
+		assert.False(t, hps[0].GetTerminal())
+		assert.Equal(t, "X-High", hps[1].GetHeader().GetHeaderName())
+		assert.True(t, hps[1].GetTerminal())
+		assert.Equal(t, "X-Low", hps[2].GetHeader().GetHeaderName())
+		assert.False(t, hps[2].GetTerminal())
+
+		assert.Equal(t, "c1", hps[3].GetCookie().GetName())
+		assert.Equal(t, "/high", hps[3].GetCookie().GetPath())
+		assert.Equal(t, "c2", hps[4].GetCookie().GetName())
+		assert.Equal(t, "/low2", hps[4].GetCookie().GetPath())
+
+		assert.Equal(t, "q1", hps[5].GetQueryParameter().GetName())
+		assert.Equal(t, "fs1", hps[6].GetFilterState().GetKey())
+
+		// Verify merge metadata records consistentHash with both policies
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-pol",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-pol",
+		}, origins)
+	})
+
+	t.Run("retains higher priority sourceIp when set", func(t *testing.T) {
+		pHigh := buildPolicy("high-pol", &kgateway.ConsistentHash{
+			SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: false},
+		})
+		pLow := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "X-Low"}},
+			SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 2)
+		assert.Equal(t, "X-Low", hps[0].GetHeader().GetHeaderName())
+		require.NotNil(t, hps[1].GetConnectionProperties())
+		assert.False(t, hps[1].GetTerminal())
+	})
+
+	t.Run("disable on higher priority policy suppresses inherited policies", func(t *testing.T) {
+		pHigh := buildPolicy("high-disable", &kgateway.ConsistentHash{
+			Disable: true,
+		})
+		pLow := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-Low"}},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+		assert.Empty(t, mergedTP.spec.consistentHash.hashPolicies)
+
+		// Apply to route and verify no hash policies are produced
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		assert.Empty(t, route.GetRoute().GetHashPolicy())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-disable",
+		}, origins)
+	})
+
+	t.Run("empty higher priority consistentHash merged with lower priority policy does not inherit lower sourceIp", func(t *testing.T) {
+		pHigh := buildPolicy("high-empty", &kgateway.ConsistentHash{})
+		pLow := buildPolicy("low-pol", &kgateway.ConsistentHash{
+			Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "X-Low"}},
+			SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: true},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 1)
+		assert.Equal(t, "X-Low", hps[0].GetHeader().GetHeaderName())
+	})
+}
