+func TestApplyConsistentHash(t *testing.T) {
+	t.Run("empty consistentHash sets single sourceIp hash policy on RouteAction", func(t *testing.T) {
+		pass := NewGatewayTranslationPass(ir.GwTranslationCtx{}, nil)
+		outSpec := trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{},
+		}, &outSpec))
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		err := pass.ApplyForRoute(&ir.RouteContext{
+			Policy: &TrafficPolicy{spec: outSpec},
+		}, route)
+		require.NoError(t, err)
+		require.Len(t, route.GetRoute().GetHashPolicy(), 1)
+		assert.True(t, route.GetRoute().GetHashPolicy()[0].GetConnectionProperties().GetSourceIp())
+		assert.False(t, route.GetRoute().GetHashPolicy()[0].GetTerminal())
+	})
+
+	t.Run("invalid cookie ttl or regex returns error in constructConsistentHash", func(t *testing.T) {
+		outSpec := trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "c1", TTL: "not-a-duration"},
+				},
+			},
+		}, &outSpec)
+		require.Error(t, err)
+
+		err = constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "c1", TTL: "-10"},
+				},
+			},
+		}, &outSpec)
+		require.Error(t, err)
+
+		err = constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "X-Test",
+						RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+							Pattern: "[invalid(",
+						},
+					},
+				},
+			},
+		}, &outSpec)
+		require.Error(t, err)
+	})
+}
