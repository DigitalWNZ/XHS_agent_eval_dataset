+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "state1", Terminal: true},
+					{Key: "state1", Terminal: false},
+				},
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		require.Len(t, out.consistentHash.hashPolicies, 4)
+
+		// Header keeps first occurrence casing and terminal value
+		assert.Equal(t, "X-My-Header", out.consistentHash.hashPolicies[0].GetHeader().GetHeaderName())
+		assert.False(t, out.consistentHash.hashPolicies[0].GetTerminal())
+
+		// Cookie keeps first occurrence
+		assert.Equal(t, "my-cookie", out.consistentHash.hashPolicies[1].GetCookie().GetName())
+		assert.Equal(t, "/first", out.consistentHash.hashPolicies[1].GetCookie().GetPath())
+		assert.False(t, out.consistentHash.hashPolicies[1].GetTerminal())
+
+		// QueryParameter keeps first occurrence
+		assert.Equal(t, "param1", out.consistentHash.hashPolicies[2].GetQueryParameter().GetName())
+		assert.False(t, out.consistentHash.hashPolicies[2].GetTerminal())
+
+		// FilterState keeps first occurrence
+		assert.Equal(t, "state1", out.consistentHash.hashPolicies[3].GetFilterState().GetKey())
+		assert.True(t, out.consistentHash.hashPolicies[3].GetTerminal())
+	})
+}
