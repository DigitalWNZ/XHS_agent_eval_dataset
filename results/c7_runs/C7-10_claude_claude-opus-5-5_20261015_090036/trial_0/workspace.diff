+func TestValidate(t *testing.T) {
+	assert := assert.New(t)
+
+	assert.NoError(Config{}.Validate())
+	assert.NoError(Config{KeySource: "bogus", Key: "x", KeyFile: "y"}.Validate())
+
+	assert.Error(Config{Enabled: true}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "bogus"}.Validate())
+
+	assert.NoError(Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "K"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "env"}.Validate())
+	assert.ErrorContains(Config{Enabled: true, KeySource: "env", KeyEnvVar: "K", Key: "x"}.Validate(), "mutually exclusive")
+
+	assert.NoError(Config{Enabled: true, KeySource: "File", KeyFile: "/k"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "file"}.Validate())
+	assert.ErrorContains(Config{Enabled: true, KeySource: "file", KeyFile: "/k", Passphrase: "p"}.Validate(), "mutually exclusive")
+
+	assert.NoError(Config{Enabled: true, KeySource: "literal", Key: "abc"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "literal"}.Validate())
+	assert.ErrorContains(Config{Enabled: true, KeySource: "literal", Key: "abc", KeyEnvVar: "K"}.Validate(), "mutually exclusive")
+
+	assert.NoError(Config{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "derive", Passphrase: "p"}.Validate())
+	assert.Error(Config{Enabled: true, KeySource: "derive", Salt: "s"}.Validate())
+	assert.ErrorContains(Config{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", KeyFile: "/k"}.Validate(), "mutually exclusive")
+}
