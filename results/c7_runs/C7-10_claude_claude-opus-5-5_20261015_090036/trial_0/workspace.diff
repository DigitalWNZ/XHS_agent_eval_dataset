+func TestLoadKey(t *testing.T) {
+	assert := assert.New(t)
+	key := testKey(t)
+	encoded := base64.StdEncoding.EncodeToString(key)
+
+	t.Setenv("ONEDUMP_TEST_KEY", encoded)
+	got, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.NoError(err)
+	assert.Equal(key, got)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY_UNSET"})
+	assert.Error(err)
+
+	t.Setenv("ONEDUMP_TEST_SHORT", base64.StdEncoding.EncodeToString(key[:16]))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_SHORT"})
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	file := filepath.Join(t.TempDir(), "key")
+	assert.NoError(os.WriteFile(file, []byte("  "+encoded+"\n"), 0600))
+	got, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file})
+	assert.NoError(err)
+	assert.Equal(key, got)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file + "missing"})
+	assert.Error(err)
+
+	got, err = LoadKey(Config{Enabled: true, KeySource: "Literal", Key: encoded})
+	assert.NoError(err)
+	assert.Equal(key, got)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: "not base64!"})
+	assert.Error(err)
+
+	salt := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{1}, 16))
+	k1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: salt})
+	assert.NoError(err)
+	assert.Len(k1, KeySize)
+	k2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: salt})
+	assert.NoError(err)
+	assert.Equal(k1, k2)
+	k3, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "other", Salt: salt})
+	assert.NoError(err)
+	assert.NotEqual(k1, k3)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: salt})
+	assert.Error(err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: base64.StdEncoding.EncodeToString(make([]byte, 15))})
+	assert.Error(err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "unknown"})
+	assert.Error(err)
+}
