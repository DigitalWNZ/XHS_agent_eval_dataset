+func TestPolicyMerge_DisableSuppressesInherited(t *testing.T) {
+	// Requirement 2: When disable is true, any inherited from broader-scoped policies are suppressed.
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+	ref1 := &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "child-disable"}
+	ref2 := &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "parent-hash"}
+
+	child := ir.PolicyAtt{
+		GroupKind:            gk,
+		PolicyRef:            ref1,
+		HierarchicalPriority: 2, // higher priority (child route)
+		PolicyIr: &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					hasConsistentHash: true,
+					disable:           true,
+				},
+			},
+		},
+	}
+
+	parent := ir.PolicyAtt{
+		GroupKind:            gk,
+		PolicyRef:            ref2,
+		HierarchicalPriority: 1, // lower priority (parent gateway)
+		PolicyIr: &TrafficPolicy{
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					hasConsistentHash: true,
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-Trace"},
+					},
+					sourceIP: &kgateway.ConsistentHashSourceIP{},
+				},
+			},
+		},
+	}
+
+	merged := policy.MergePolicies([]ir.PolicyAtt{child, parent}, mergeTrafficPolicies, "")
