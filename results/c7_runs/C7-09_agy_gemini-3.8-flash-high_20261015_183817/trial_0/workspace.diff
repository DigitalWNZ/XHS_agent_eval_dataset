+func TestPolicyMerge(t *testing.T) {
+	// Requirement 7: When multiple TrafficPolicies target the same route, array fields must be unioned
+	// across both policies with the higher-priority policy's entries first, deduplicated by key.
+	// The merged result must be re-sorted into canonical type order.
+	// The sourceIp scalar retains the higher-priority policy's value even when unset.
+	// Requirement 8: Merge metadata must record this field as consistentHash under the existing TrafficPolicy merge metadata key.
+
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+	ref1 := &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "high-prio"}
+	ref2 := &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "low-prio"}
+
+	p1 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: ref1,
+		PolicyIr: &TrafficPolicy{
+			ct: time.Now(),
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					hasConsistentHash: true,
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "X-User", Terminal: ptr.To(true)},
+					},
+					queryParameters: []kgateway.ConsistentHashQueryParameter{
+						{Name: "param1", Terminal: ptr.To(false)},
+					},
+					// sourceIp is unset!
+				},
+			},
+		},
+	}
+
+	p2 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: ref2,
+		PolicyIr: &TrafficPolicy{
+			ct: time.Now().Add(-time.Hour),
+			spec: trafficPolicySpecIr{
+				consistentHash: &consistentHashIR{
+					hasConsistentHash: true,
+					headers: []kgateway.ConsistentHashHeader{
+						{HeaderName: "x-user", Terminal: ptr.To(false)}, // duplicate with different casing/terminal
+						{HeaderName: "X-Tenant", Terminal: ptr.To(false)},
+					},
+					cookies: []kgateway.ConsistentHashCookie{
+						{Name: "session", TTL: ptr.To("10m")},
+					},
+					sourceIP: &kgateway.ConsistentHashSourceIP{
+						Terminal: ptr.To(true),
+					},
+				},
+			},
+		},
+	}
+
+	merged := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+	mergedTP, ok := merged.PolicyIr.(*TrafficPolicy)
+	require.True(t, ok)
+	require.NotNil(t, mergedTP.spec.consistentHash)
+
+	// Verify headers: X-User (from high-prio kept) and X-Tenant (from low-prio)
+	require.Len(t, mergedTP.spec.consistentHash.headers, 2)
+	assert.Equal(t, "X-User", mergedTP.spec.consistentHash.headers[0].HeaderName)
+	assert.True(t, *mergedTP.spec.consistentHash.headers[0].Terminal)
+	assert.Equal(t, "X-Tenant", mergedTP.spec.consistentHash.headers[1].HeaderName)
+
+	// Verify cookies: session (from low-prio)
+	require.Len(t, mergedTP.spec.consistentHash.cookies, 1)
+	assert.Equal(t, "session", mergedTP.spec.consistentHash.cookies[0].Name)
+
+	// Verify queryParameters: param1 (from high-prio)
+	require.Len(t, mergedTP.spec.consistentHash.queryParameters, 1)
+	assert.Equal(t, "param1", mergedTP.spec.consistentHash.queryParameters[0].Name)
+
+	// Verify sourceIp: scalar retains high-prio value even when unset!
+	assert.Nil(t, mergedTP.spec.consistentHash.sourceIP)
+
+	// Verify built hash policies order: headers, cookies, queryParameters
+	policies := buildHashPolicies(mergedTP.spec.consistentHash)
+	require.Len(t, policies, 4)
+	assert.NotNil(t, policies[0].GetHeader())
+	assert.Equal(t, "X-User", policies[0].GetHeader().HeaderName)
+	assert.NotNil(t, policies[1].GetHeader())
+	assert.Equal(t, "X-Tenant", policies[1].GetHeader().HeaderName)
+	assert.NotNil(t, policies[2].GetCookie())
+	assert.Equal(t, "session", policies[2].GetCookie().Name)
+	assert.NotNil(t, policies[3].GetQueryParameter())
+	assert.Equal(t, "param1", policies[3].GetQueryParameter().Name)
+
+	// Verify Requirement 8: Merge metadata records this field as consistentHash
+	origins := merged.MergeOrigins.Get("consistentHash")
+	require.NotNil(t, origins)
+	assert.Contains(t, origins, ref1.ID())
+	assert.Contains(t, origins, ref2.ID())
+}
