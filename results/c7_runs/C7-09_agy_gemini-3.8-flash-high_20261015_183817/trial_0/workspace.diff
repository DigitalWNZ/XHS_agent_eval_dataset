+func TestCanonicalTypeOrder(t *testing.T) {
+	// Requirement 3: Hash policy entries are built in canonical type order:
+	// headers, cookies, queryParameters, filterState, sourceIp.
+	ir := &consistentHashIR{
+		// Defined in reverse order
+		sourceIP: &kgateway.ConsistentHashSourceIP{
+			Terminal: ptr.To(false),
+		},
+		filterState: []kgateway.ConsistentHashFilterState{
+			{Key: "fs1", Terminal: ptr.To(true)},
+		},
+		queryParameters: []kgateway.ConsistentHashQueryParameter{
+			{Name: "qp1", Terminal: ptr.To(false)},
+		},
+		cookies: []kgateway.ConsistentHashCookie{
+			{Name: "ck1", Terminal: ptr.To(false)},
+		},
+		headers: []kgateway.ConsistentHashHeader{
+			{HeaderName: "h1", Terminal: ptr.To(true)},
+		},
+	}
+
+	policies := buildHashPolicies(ir)
+	require.Len(t, policies, 5)
+
+	// 1. headers
+	assert.NotNil(t, policies[0].GetHeader())
+	assert.Equal(t, "h1", policies[0].GetHeader().HeaderName)
+	assert.True(t, policies[0].Terminal)
+
+	// 2. cookies
+	assert.NotNil(t, policies[1].GetCookie())
+	assert.Equal(t, "ck1", policies[1].GetCookie().Name)
+	assert.False(t, policies[1].Terminal)
+
+	// 3. queryParameters
+	assert.NotNil(t, policies[2].GetQueryParameter())
+	assert.Equal(t, "qp1", policies[2].GetQueryParameter().Name)
+	assert.False(t, policies[2].Terminal)
+
+	// 4. filterState
+	assert.NotNil(t, policies[3].GetFilterState())
+	assert.Equal(t, "fs1", policies[3].GetFilterState().Key)
+	assert.True(t, policies[3].Terminal)
+
+	// 5. sourceIp
+	assert.NotNil(t, policies[4].GetConnectionProperties())
+	assert.True(t, policies[4].GetConnectionProperties().SourceIp)
+	assert.False(t, policies[4].Terminal)
+}
