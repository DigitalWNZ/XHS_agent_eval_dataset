+func TestCookieTTLAndAttributes(t *testing.T) {
+	// Requirement 6: Cookie ttl accepts Go duration format (e.g. "1h30m") or plain integer seconds (e.g. "3600").
+	// Cookie attributes are passed through to Envoy as-is.
+	ir := &consistentHashIR{
+		cookies: []kgateway.ConsistentHashCookie{
+			{
+				Name: "c1",
+				TTL:  ptr.To("1h30m"),
+				Path: ptr.To("/api"),
+				Attributes: []kgateway.ConsistentHashCookieAttribute{
+					{Name: "SameSite", Value: "Strict"},
+					{Name: "Secure", Value: ""},
+				},
+			},
+			{
+				Name: "c2",
+				TTL:  ptr.To("3600"),
+			},
+			{
+				Name: "c3",
+				TTL:  ptr.To("0"),
+			},
+		},
+	}
+
+	policies := buildHashPolicies(ir)
+	require.Len(t, policies, 3)
+
+	c1 := policies[0].GetCookie()
+	require.NotNil(t, c1)
+	assert.Equal(t, "c1", c1.Name)
+	assert.Equal(t, "/api", c1.Path)
+	assert.Equal(t, int64(5400), c1.Ttl.Seconds)
+	require.Len(t, c1.Attributes, 2)
+	assert.Equal(t, "SameSite", c1.Attributes[0].Name)
+	assert.Equal(t, "Strict", c1.Attributes[0].Value)
+	assert.Equal(t, "Secure", c1.Attributes[1].Name)
+	assert.Equal(t, "", c1.Attributes[1].Value)
+
+	c2 := policies[1].GetCookie()
+	require.NotNil(t, c2)
+	assert.Equal(t, "c2", c2.Name)
+	assert.Equal(t, int64(3600), c2.Ttl.Seconds)
+
+	c3 := policies[2].GetCookie()
+	require.NotNil(t, c3)
