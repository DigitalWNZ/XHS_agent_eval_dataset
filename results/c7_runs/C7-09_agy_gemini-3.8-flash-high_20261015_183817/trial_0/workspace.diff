+func TestConstructConsistentHash_EmptyDefaultsToSourceIp(t *testing.T) {
+	// Requirement 1: When consistentHash is set (even as empty {}), RouteAction must include hash_policy entries.
+	// If no sub-fields are specified, default to a single sourceIp hash policy with terminal=false.
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{},
+	}
+	out := &trafficPolicySpecIr{}
+	constructConsistentHash(spec, out)
+	require.NotNil(t, out.consistentHash)
+	assert.True(t, out.consistentHash.hasConsistentHash)
+	assert.False(t, out.consistentHash.disable)
+
+	pass := &trafficPolicyPluginGwPass{}
+	routeAction := &envoyroutev3.RouteAction{}
+	pass.handleConsistentHash(routeAction, out.consistentHash)
+
+	require.Len(t, routeAction.HashPolicy, 1)
+	hp := routeAction.HashPolicy[0]
+	assert.False(t, hp.Terminal)
+	connProp := hp.GetConnectionProperties()
+	require.NotNil(t, connProp)
+	assert.True(t, connProp.SourceIp)
+}
