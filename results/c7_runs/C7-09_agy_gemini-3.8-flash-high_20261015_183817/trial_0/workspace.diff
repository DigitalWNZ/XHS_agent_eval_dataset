+func TestDeduplication(t *testing.T) {
+	// Requirement 4: Within each array field, entries must be deduplicated by their identifying key
+	// (headerName for headers, name for cookies and queryParameters, key for filterState).
+	// If duplicates exist, only the first occurrence is kept.
+	// Header deduplication is case-insensitive, preserving casing of the first occurrence.
+	ir := &consistentHashIR{
+		headers: []kgateway.ConsistentHashHeader{
+			{HeaderName: "X-My-Header", Terminal: ptr.To(true)},
+			{HeaderName: "x-my-header", Terminal: ptr.To(false)},
+			{HeaderName: "X-OTHER-HEADER", Terminal: ptr.To(false)},
+		},
+		cookies: []kgateway.ConsistentHashCookie{
+			{Name: "cookieA", TTL: ptr.To("10s")},
+			{Name: "cookieA", TTL: ptr.To("20s")},
+			{Name: "cookieB", TTL: ptr.To("30s")},
+		},
+		queryParameters: []kgateway.ConsistentHashQueryParameter{
+			{Name: "paramA", Terminal: ptr.To(true)},
+			{Name: "paramA", Terminal: ptr.To(false)},
+			{Name: "paramB", Terminal: ptr.To(false)},
+		},
+		filterState: []kgateway.ConsistentHashFilterState{
+			{Key: "keyA", Terminal: ptr.To(true)},
+			{Key: "keyA", Terminal: ptr.To(false)},
+			{Key: "keyB", Terminal: ptr.To(false)},
+		},
+	}
+
+	policies := buildHashPolicies(ir)
+	require.Len(t, policies, 8)
+
+	// Headers: 2 items, preserving casing of first occurrence ("X-My-Header")
+	require.NotNil(t, policies[0].GetHeader())
+	assert.Equal(t, "X-My-Header", policies[0].GetHeader().HeaderName)
+	assert.True(t, policies[0].Terminal)
+	require.NotNil(t, policies[1].GetHeader())
+	assert.Equal(t, "X-OTHER-HEADER", policies[1].GetHeader().HeaderName)
+
+	// Cookies: 2 items ("cookieA", "cookieB"), first cookieA kept (10s)
+	require.NotNil(t, policies[2].GetCookie())
+	assert.Equal(t, "cookieA", policies[2].GetCookie().Name)
+	assert.Equal(t, int64(10), policies[2].GetCookie().Ttl.Seconds)
+	require.NotNil(t, policies[3].GetCookie())
+	assert.Equal(t, "cookieB", policies[3].GetCookie().Name)
+
+	// Query params: 2 items ("paramA", "paramB")
+	require.NotNil(t, policies[4].GetQueryParameter())
+	assert.Equal(t, "paramA", policies[4].GetQueryParameter().Name)
+	assert.True(t, policies[4].Terminal)
+	require.NotNil(t, policies[5].GetQueryParameter())
+	assert.Equal(t, "paramB", policies[5].GetQueryParameter().Name)
+
+	// Filter state: 2 items ("keyA", "keyB")
+	require.NotNil(t, policies[6].GetFilterState())
+	assert.Equal(t, "keyA", policies[6].GetFilterState().Key)
+	assert.True(t, policies[6].Terminal)
+	require.NotNil(t, policies[7].GetFilterState())
+	assert.Equal(t, "keyB", policies[7].GetFilterState().Key)
+}
