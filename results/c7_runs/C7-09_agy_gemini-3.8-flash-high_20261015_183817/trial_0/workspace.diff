+		},
+		cookies: []kgateway.ConsistentHashCookie{
+			{
+				Name: "c1",
+				TTL:  ptr.To("1h"),
+				Path: ptr.To("/"),
+				Attributes: []kgateway.ConsistentHashCookieAttribute{
+					{Name: "attr1", Value: "val1"},
+				},
+				Terminal: ptr.To(false),
+			},
+		},
+		queryParameters: []kgateway.ConsistentHashQueryParameter{
+			{Name: "q1", Terminal: ptr.To(true)},
+		},
+		filterState: []kgateway.ConsistentHashFilterState{
+			{Key: "f1", Terminal: ptr.To(false)},
+		},
+		sourceIP: &kgateway.ConsistentHashSourceIP{
+			Terminal: ptr.To(true),
+		},
+	}
+
+	assert.True(t, ir1.Equals(ir1))
+
+	ir2 := &consistentHashIR{
+		hasConsistentHash: true,
+		disable:           false,
+		headers: []kgateway.ConsistentHashHeader{
+			{
+				HeaderName: "h1",
+				Terminal:   ptr.To(true),
+				RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+					Pattern:      "p1",
+					Substitution: "s1",
+				},
+			},
+		},
+		cookies: []kgateway.ConsistentHashCookie{
+			{
+				Name: "c1",
+				TTL:  ptr.To("1h"),
+				Path: ptr.To("/"),
+				Attributes: []kgateway.ConsistentHashCookieAttribute{
+					{Name: "attr1", Value: "val1"},
+				},
+				Terminal: ptr.To(false),
+			},
+		},
+		queryParameters: []kgateway.ConsistentHashQueryParameter{
+			{Name: "q1", Terminal: ptr.To(true)},
+		},
+		filterState: []kgateway.ConsistentHashFilterState{
+			{Key: "f1", Terminal: ptr.To(false)},
+		},
+		sourceIP: &kgateway.ConsistentHashSourceIP{
+			Terminal: ptr.To(true),
+		},
+	}
+	assert.True(t, ir1.Equals(ir2))
+
+	// different header
+	irDiffHeader := cloneConsistentHash(ir1)
+	irDiffHeader.headers[0].HeaderName = "h2"
+	assert.False(t, ir1.Equals(irDiffHeader))
+
+	// different disable
+	irDiffDisable := cloneConsistentHash(ir1)
+	irDiffDisable.disable = true
+	assert.False(t, ir1.Equals(irDiffDisable))
+
+	// different sourceIp
+	irDiffSourceIP := cloneConsistentHash(ir1)
+	irDiffSourceIP.sourceIP.Terminal = ptr.To(false)
+	assert.False(t, ir1.Equals(irDiffSourceIP))
+
+	// nil vs non-nil
+	var nilIR *consistentHashIR
+	assert.True(t, nilIR.Equals(nil))
+	assert.False(t, ir1.Equals(nil))
+	assert.False(t, nilIR.Equals(ir1))
+}
