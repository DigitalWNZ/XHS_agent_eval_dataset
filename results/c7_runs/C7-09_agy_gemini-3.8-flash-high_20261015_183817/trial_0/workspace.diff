+func TestConsistentHash_Equals(t *testing.T) {
+	ir1 := &consistentHashIR{
+		hasConsistentHash: true,
+		disable:           false,
+		headers: []kgateway.ConsistentHashHeader{
+			{
+				HeaderName: "h1",
