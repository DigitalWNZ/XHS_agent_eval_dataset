+func FuzzShapeIndexDecode(f *testing.F) {
+	index := NewShapeIndex()
+	for _, s := range allBuiltinShapes() {
+		index.Add(s)
+	}
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		f.Fatal(err)
+	}
+	f.Add(buf.Bytes())
+	buf.Reset()
+	if err := NewShapeIndex().Encode(&buf); err != nil {
+		f.Fatal(err)
+	}
+	f.Add(buf.Bytes())
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		got := NewShapeIndex()
+		if err := got.Decode(bytes.NewReader(data)); err != nil {
+			return
+		}
+		// Anything that decodes must re-encode to the same bytes.
+		var out bytes.Buffer
+		if err := got.Encode(&out); err != nil {
+			t.Fatalf("Encode() of decoded index failed: %v", err)
+		}
+		if !bytes.HasPrefix(data, out.Bytes()) {
+			t.Errorf("re-encoding a decoded index changed it")
+		}
+	})
+}
