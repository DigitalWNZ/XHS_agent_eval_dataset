+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	index := NewShapeIndex()
+	for _, s := range allBuiltinShapes() {
+		index.Add(s)
+	}
+	data := encodeShapeIndex(t, index)
+
+	if err := NewShapeIndex().Decode(bytes.NewReader(nil)); err == nil {
+		t.Errorf("Decode(empty) succeeded")
+	}
+	for n := 0; n < len(data); n++ {
+		if err := NewShapeIndex().Decode(bytes.NewReader(data[:n])); err == nil {
+			t.Fatalf("Decode() of data truncated to %d bytes succeeded", n)
+		}
+	}
+	for i := range data {
+		corrupt := append([]byte(nil), data...)
+		corrupt[i] ^= 0x5a
+		if err := NewShapeIndex().Decode(bytes.NewReader(corrupt)); err == nil {
+			t.Fatalf("Decode() of data with byte %d corrupted succeeded", i)
+		}
+	}
+
+	// A failed decode leaves the index unchanged.
+	dst := NewShapeIndex()
+	dst.Add(makePolyline("0:0, 1:1"))
+	if err := dst.Decode(bytes.NewReader(data[:len(data)/2])); err == nil || dst.Len() != 1 {
+		t.Errorf("failed Decode() modified the index")
+	}
+
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < 2000; i++ {
+		garbage := make([]byte, rng.Intn(200))
+		rng.Read(garbage)
+		if i%2 == 0 && len(garbage) >= 5 {
+			copy(garbage, data[:5]) // valid header
+		}
+		_ = NewShapeIndex().Decode(bytes.NewReader(garbage))
+	}
+}
