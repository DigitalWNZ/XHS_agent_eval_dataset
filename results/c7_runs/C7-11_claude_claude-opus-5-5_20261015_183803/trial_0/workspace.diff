+func TestShapeIndexEncodeAllShapeTypes(t *testing.T) {
+	index := NewShapeIndex()
+	for _, s := range allBuiltinShapes() {
+		index.Add(s)
+	}
+	index.Build()
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, got, index)
+
+	// Each shape on its own, too.
+	for _, s := range allBuiltinShapes() {
+		index := NewShapeIndex()
+		index.Add(s)
+		checkShapeIndexEqual(t, roundTripShapeIndex(t, index), index)
+	}
+
+	// Polygon and Loop internals are restored exactly.
+	p := got.Shape(0).(*Polygon)
+	wp := index.Shape(0).(*Polygon)
+	if p.hasHoles != wp.hasHoles || p.bound != wp.bound || p.numVertices != wp.numVertices ||
+		p.NumLoops() != wp.NumLoops() || p.Loop(1).depth != wp.Loop(1).depth {
+		t.Errorf("decoded polygon state differs")
+	}
+	if p.Validate() != nil || !p.Contains(wp) || !wp.Contains(p) {
+		t.Errorf("decoded polygon is not equivalent")
+	}
+	if !got.Shape(2).(*Polygon).IsFull() || !got.Shape(1).(*Polygon).IsEmpty() {
+		t.Errorf("full/empty polygons not preserved")
+	}
+	if !got.Shape(5).(*Loop).IsEmpty() || !got.Shape(6).(*Loop).IsFull() {
+		t.Errorf("full/empty loops not preserved")
+	}
+}
