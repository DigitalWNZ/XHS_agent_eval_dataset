+package s2
+
+import (
+	"bufio"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"hash/crc32"
+	"io"
+	"math"
+	"sync/atomic"
+)
+
+// The ShapeIndex encoding is laid out as follows (all integers are uvarints
+// unless noted otherwise):
+//
+//	magic            uint32 (little endian)
+//	version          uint8
+//	maxEdgesPerCell
+//	nextID
+//	numShapes
+//	numShapes x {shapeID, shapeKind uint8, shape payload}
+//	numCells
+//	numCells x {cellID uint64, numClipped,
+//	            numClipped x {shapeID, containsCenter uint8, numEdges, numEdges x edgeID}}
+//	checksum         uint32 (little endian), CRC-32C of all preceding bytes
+//
+// Shapes are written in increasing order of shape ID, and cells in increasing
+// order of CellID. The cell structure is stored verbatim so that a decoded
+// index can be queried without being rebuilt.
+const (
+	shapeIndexEncodingMagic   = uint32(0x58444953) // "SIDX"
+	shapeIndexEncodingVersion = uint8(1)
+
+	// The initial capacity used when decoding a slice whose length comes from
+	// the input. Larger slices grow as data is actually read, so a corrupt
+	// length can't force a huge allocation up front.
+	maxDecodePrealloc = 1024
+)
+
+// shapeKind identifies the concrete Shape type of an encoded shape.
+type shapeKind uint8
+
+const (
+	shapeKindPolygon shapeKind = iota + 1
+	shapeKindPolyline
+	shapeKindPointVector
+	shapeKindLaxPolyline
+	shapeKindLaxPolygon
+	shapeKindLoop
+	shapeKindLaxLoop
+)
+
+var crc32cTable = crc32.MakeTable(crc32.Castagnoli)
+
+// Encode encodes the ShapeIndex, including all of its shapes (with their IDs)
+// and its cell structure. Any pending updates are applied first, so the index
+// need not have been built explicitly.
+//
+// All shapes in the index must be one of the built-in Shape types: *Polygon,
+// *Polyline, *Loop, *PointVector, *LaxPolyline, *LaxPolygon, or *LaxLoop.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	bw := bufio.NewWriter(w)
+	crc := crc32.New(crc32cTable)
+	e := &encoder{w: io.MultiWriter(bw, crc)}
+
+	e.writeUint32(shapeIndexEncodingMagic)
+	e.writeUint8(shapeIndexEncodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	e.writeUvarint(uint64(len(s.shapes)))
+	for id := int32(0); id < s.nextID && e.err == nil; id++ {
+		shape, ok := s.shapes[id]
+		if !ok {
+			continue
+		}
+		e.writeUvarint(uint64(id))
+		encodeShape(e, shape)
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		cell := s.cellMap[cellID]
+		e.writeUint64(uint64(cellID))
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edge := range clipped.edges {
+				e.writeUvarint(uint64(edge))
+			}
+		}
+	}
+	if e.err != nil {
+		return e.err
+	}
+
+	// The checksum itself is written outside the CRC.
+	e.w = bw
+	e.writeUint32(crc.Sum32())
+	if e.err != nil {
+		return e.err
+	}
+	return bw.Flush()
+}
+
+// Decode replaces the contents of the ShapeIndex with the index encoded in r
+// by Encode. The decoded index is fresh: it can be queried and iterated
+// without calling Build. If an error is returned, the index is left unchanged.
+func (s *ShapeIndex) Decode(r io.Reader) (err error) {
+	cr := &crcReader{r: asByteReader(r), crc: crc32.New(crc32cTable)}
+	d := &decoder{r: cr}
+
+	// Decoding validates its input, but guard against any remaining
+	// inconsistency in corrupt data turning into a panic.
+	defer func() {
+		if p := recover(); p != nil {
+			err = fmt.Errorf("s2: corrupt ShapeIndex encoding: %v", p)
+		}
+	}()
+
+	dec, err := decodeShapeIndex(d)
+	if err != nil {
+		return err
+	}
+
+	sum := cr.crc.Sum32()
+	var buf [4]byte
+	if _, err := io.ReadFull(cr.r, buf[:]); err != nil {
+		return decodeErr(err)
+	}
+	if binary.LittleEndian.Uint32(buf[:]) != sum {
+		return errors.New("s2: ShapeIndex encoding checksum mismatch")
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.shapes = dec.shapes
+	s.maxEdgesPerCell = dec.maxEdgesPerCell
+	s.nextID = dec.nextID
+	s.cellMap = dec.cellMap
+	s.cells = dec.cells
+	s.pendingAdditionsPos = dec.nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	return nil
+}
+
+// decodeErr converts the low-level EOF errors from a truncated input into
+// io.ErrUnexpectedEOF, since a valid encoding never ends early.
+func decodeErr(err error) error {
+	if err == io.EOF {
+		return io.ErrUnexpectedEOF
+	}
+	return err
+}
+
+// decodeShapeIndex decodes everything but the trailing checksum into a new
+// ShapeIndex.
+func decodeShapeIndex(d *decoder) (*ShapeIndex, error) {
+	if magic := d.readUint32(); d.err == nil && magic != shapeIndexEncodingMagic {
+		return nil, fmt.Errorf("s2: not a ShapeIndex encoding (magic %#x)", magic)
+	}
+	if version := d.readUint8(); d.err == nil && version != shapeIndexEncodingVersion {
+		return nil, fmt.Errorf("s2: unsupported ShapeIndex encoding version %d", version)
+	}
+	maxEdgesPerCell := d.readUvarint()
+	nextID := d.readUvarint()
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if maxEdgesPerCell > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+	if nextID > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid next shape ID %d", nextID)
+	}
+	if numShapes > nextID {
+		return nil, fmt.Errorf("s2: %d shapes exceeds next shape ID %d", numShapes, nextID)
+	}
+
+	s := &ShapeIndex{
+		maxEdgesPerCell: int(maxEdgesPerCell),
+		nextID:          int32(nextID),
+		shapes:          make(map[int32]Shape, min(numShapes, maxDecodePrealloc)),
+		cellMap:         make(map[CellID]*ShapeIndexCell),
+		status:          fresh,
+	}
+
+	prevID := int64(-1)
+	for i := uint64(0); i < numShapes; i++ {
+		id := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		if id >= nextID || int64(id) <= prevID {
+			return nil, fmt.Errorf("s2: invalid or out of order shape ID %d", id)
+		}
+		prevID = int64(id)
+		shape := decodeShape(d)
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		s.shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if numCells > 0 {
+		s.cells = make([]CellID, 0, min(numCells, maxDecodePrealloc))
+	}
+	for i := uint64(0); i < numCells; i++ {
+		cellID := CellID(d.readUint64())
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		if !cellID.IsValid() {
+			return nil, fmt.Errorf("s2: invalid CellID %v in ShapeIndex encoding", cellID)
+		}
+		if n := len(s.cells); n > 0 && cellID.RangeMin() <= s.cells[n-1].RangeMax() {
+			return nil, fmt.Errorf("s2: CellID %v is out of order or overlaps %v", cellID, s.cells[n-1])
+		}
+
+		cell := &ShapeIndexCell{shapes: make([]*clippedShape, 0, min(numClipped, maxDecodePrealloc))}
+		prevShapeID := int64(-1)
+		for j := uint64(0); j < numClipped; j++ {
+			clipped, err := decodeClippedShape(d, s.shapes, prevShapeID)
+			if err != nil {
+				return nil, err
+			}
+			prevShapeID = int64(clipped.shapeID)
+			cell.shapes = append(cell.shapes, clipped)
+		}
+		s.cells = append(s.cells, cellID)
+		s.cellMap[cellID] = cell
+	}
+	return s, nil
+}
+
+// decodeClippedShape decodes one clipped shape of an index cell, checking that
+// it refers to a decoded shape whose ID is greater than prevShapeID and that
+// all of its edges exist.
+func decodeClippedShape(d *decoder, shapes map[int32]Shape, prevShapeID int64) (*clippedShape, error) {
+	shapeID := d.readUvarint()
+	containsCenter := readStrictBool(d)
+	numEdges := d.readUvarint()
+	if d.err != nil {
+		return nil, decodeErr(d.err)
+	}
+	if int64(shapeID) <= prevShapeID || shapeID > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: invalid or out of order shape ID %d in index cell", shapeID)
+	}
+	shape, ok := shapes[int32(shapeID)]
+	if !ok {
+		return nil, fmt.Errorf("s2: index cell refers to unknown shape ID %d", shapeID)
+	}
+	shapeEdges := uint64(shape.NumEdges())
+	if numEdges > shapeEdges {
+		return nil, fmt.Errorf("s2: index cell has %d edges for shape %d with only %d edges", numEdges, shapeID, shapeEdges)
+	}
+
+	clipped := &clippedShape{
+		shapeID:        int32(shapeID),
+		containsCenter: containsCenter,
+		edges:          make([]int, 0, min(numEdges, maxDecodePrealloc)),
+	}
+	for k := uint64(0); k < numEdges; k++ {
+		edge := d.readUvarint()
+		if d.err != nil {
+			return nil, decodeErr(d.err)
+		}
+		if edge >= shapeEdges {
+			return nil, fmt.Errorf("s2: edge %d out of range for shape %d with %d edges", edge, shapeID, shapeEdges)
+		}
+		clipped.edges = append(clipped.edges, int(edge))
+	}
+	return clipped, nil
+}
+
+// encodeShape writes the kind and contents of one of the built-in Shape types.
+func encodeShape(e *encoder, shape Shape) {
+	switch s := shape.(type) {
+	case *Polygon:
+		e.writeUint8(uint8(shapeKindPolygon))
+		e.writeBool(s.hasHoles)
+		s.bound.encode(e)
+		s.subregionBound.encode(e)
+		e.writeUvarint(uint64(len(s.loops)))
+		for _, l := range s.loops {
+			encodeLoopFields(e, l)
+		}
+	case *Loop:
+		e.writeUint8(uint8(shapeKindLoop))
+		encodeLoopFields(e, s)
+	case *Polyline:
+		e.writeUint8(uint8(shapeKindPolyline))
+		encodePoints(e, *s)
+	case *PointVector:
+		e.writeUint8(uint8(shapeKindPointVector))
+		encodePoints(e, *s)
+	case *LaxPolyline:
+		e.writeUint8(uint8(shapeKindLaxPolyline))
+		encodePoints(e, s.vertices)
+	case *LaxLoop:
+		e.writeUint8(uint8(shapeKindLaxLoop))
+		encodePoints(e, s.vertices[:s.numVertices])
+	case *LaxPolygon:
+		e.writeUint8(uint8(shapeKindLaxPolygon))
+		e.writeUvarint(uint64(s.numLoops))
+		for i := 0; i < s.numLoops; i++ {
+			n := s.numLoopVertices(i)
+			e.writeUvarint(uint64(n))
+			for j := 0; j < n; j++ {
+				encodePoint(e, s.loopVertex(i, j))
+			}
+		}
+	default:
+		if e.err == nil {
+			e.err = fmt.Errorf("s2: cannot encode shape of type %T in ShapeIndex", shape)
+		}
+	}
+}
+
+// decodeShape reads a shape written by encodeShape.
+func decodeShape(d *decoder) Shape {
+	kind := shapeKind(d.readUint8())
+	if d.err != nil {
+		return nil
+	}
+	switch kind {
+	case shapeKindPolygon:
+		p := &Polygon{}
+		p.hasHoles = readStrictBool(d)
+		p.bound.decode(d)
+		p.subregionBound.decode(d)
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		p.loops = make([]*Loop, 0, min(numLoops, maxDecodePrealloc))
+		for i := uint64(0); i < numLoops && d.err == nil; i++ {
+			l := decodeLoopFields(d)
+			p.loops = append(p.loops, l)
+			p.numVertices += len(l.vertices)
+		}
+		if d.err != nil {
+			return nil
+		}
+		if len(p.loops) == 0 {
+			p.loops = nil
+		}
+		p.initEdgesAndIndex()
+		return p
+	case shapeKindLoop:
+		l := decodeLoopFields(d)
+		if d.err != nil {
+			return nil
+		}
+		return l
+	case shapeKindPolyline:
+		p := Polyline(decodePoints(d))
+		return &p
+	case shapeKindPointVector:
+		p := PointVector(decodePoints(d))
+		return &p
+	case shapeKindLaxPolyline:
+		return LaxPolylineFromPoints(decodePoints(d))
+	case shapeKindLaxLoop:
+		return LaxLoopFromPoints(decodePoints(d))
+	case shapeKindLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		loops := make([][]Point, 0, min(numLoops, maxDecodePrealloc))
+		for i := uint64(0); i < numLoops && d.err == nil; i++ {
+			loops = append(loops, decodePoints(d))
+		}
+		if d.err != nil {
+			return nil
+		}
+		return LaxPolygonFromPoints(loops)
+	default:
+		d.err = fmt.Errorf("s2: unknown shape kind %d in ShapeIndex encoding", kind)
+		return nil
+	}
+}
+
+// encodeLoopFields writes the vertices and the derived state of a Loop so it
+// can be restored exactly, without recomputation.
+func encodeLoopFields(e *encoder, l *Loop) {
+	encodePoints(e, l.vertices)
+	e.writeBool(l.originInside)
+	e.writeUvarint(uint64(l.depth))
+	l.bound.encode(e)
+	l.subregionBound.encode(e)
+}
+
+func decodeLoopFields(d *decoder) *Loop {
+	l := &Loop{vertices: decodePoints(d)}
+	l.originInside = readStrictBool(d)
+	depth := d.readUvarint()
+	l.bound.decode(d)
+	l.subregionBound.decode(d)
+	if d.err == nil && depth > math.MaxInt32 {
+		d.err = fmt.Errorf("s2: invalid loop depth %d", depth)
+	}
+	l.depth = int(depth)
+	l.index = NewShapeIndex()
+	l.index.Add(l)
+	return l
+}
+
+func encodePoint(e *encoder, p Point) {
+	e.writeFloat64(p.X)
+	e.writeFloat64(p.Y)
+	e.writeFloat64(p.Z)
+}
+
+func encodePoints(e *encoder, pts []Point) {
+	e.writeUvarint(uint64(len(pts)))
+	for _, p := range pts {
+		encodePoint(e, p)
+	}
+}
+
+// decodePoints reads a slice written by encodePoints. A zero length decodes
+// to a nil slice.
+func decodePoints(d *decoder) []Point {
+	n := d.readUvarint()
+	if d.err != nil || n == 0 {
+		return nil
+	}
+	pts := make([]Point, 0, min(n, maxDecodePrealloc))
+	for i := uint64(0); i < n && d.err == nil; i++ {
+		var p Point
+		p.X = d.readFloat64()
+		p.Y = d.readFloat64()
+		p.Z = d.readFloat64()
+		pts = append(pts, p)
+	}
+	return pts
+}
+
+// readStrictBool reads a bool written by encoder.writeBool, rejecting any
+// byte other than 0 or 1.
+func readStrictBool(d *decoder) bool {
+	b := d.readUint8()
+	if d.err == nil && b > 1 {
+		d.err = fmt.Errorf("s2: invalid bool value %d", b)
+	}
+	return b == 1
+}
+
+// crcReader is a byteReader that computes a checksum of the bytes read.
+type crcReader struct {
+	r   byteReader
+	crc hash.Hash32
+}
+
+func (c *crcReader) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	c.crc.Write(p[:n])
+	return n, err
+}
+
+func (c *crcReader) ReadByte() (byte, error) {
+	b, err := c.r.ReadByte()
+	if err == nil {
+		c.crc.Write([]byte{b})
+	}
+	return b, err
+}
