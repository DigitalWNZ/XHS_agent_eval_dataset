+func TestShapeIndexDecodeOversizedCounts(t *testing.T) {
+	header := func() []byte {
+		b := binary.LittleEndian.AppendUint32(nil, shapeIndexEncodingMagic)
+		return append(b, shapeIndexEncodingVersion)
+	}
+	huge := uint64(1) << 62
+	tests := map[string][]byte{
+		"maxEdgesPerCell": binary.AppendUvarint(header(), huge),
+		"nextID":          binary.AppendUvarint(binary.AppendUvarint(header(), 10), huge),
+		"numShapes":       binary.AppendUvarint(binary.AppendUvarint(binary.AppendUvarint(header(), 10), 100), huge),
+		"numCells": binary.AppendUvarint(
+			binary.AppendUvarint(binary.AppendUvarint(binary.AppendUvarint(header(), 10), 0), 0), huge),
+		"numVertices": binary.AppendUvarint(append(binary.AppendUvarint(
+			binary.AppendUvarint(binary.AppendUvarint(binary.AppendUvarint(header(), 10), 1), 1), 0),
+			byte(shapeKindPolyline)), huge),
+		"numLoops": binary.AppendUvarint(append(binary.AppendUvarint(
+			binary.AppendUvarint(binary.AppendUvarint(binary.AppendUvarint(header(), 10), 1), 1), 0),
+			byte(shapeKindLaxPolygon)), huge),
+	}
+	for name, data := range tests {
+		if err := NewShapeIndex().Decode(bytes.NewReader(data)); err == nil {
+			t.Errorf("%s: Decode() with oversized count succeeded", name)
+		}
+	}
+}
