+func TestShapeIndexEncodeAddAfterDecode(t *testing.T) {
+	index := NewShapeIndex()
+	shapes := allBuiltinShapes()
+	for _, s := range shapes {
+		index.Add(s)
+	}
+	// Removing shapes before the index is built leaves gaps in the IDs.
+	index.Remove(shapes[1])
+	index.Remove(shapes[4])
+	index.Remove(shapes[len(shapes)-1])
+
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, got, index)
+
+	// New shapes get fresh IDs and are indexed correctly.
+	id := got.Add(makePolyline("50:50, 51:51, 52:50"))
+	if id != index.nextID {
+		t.Errorf("Add() after decode = %d, want %d", id, index.nextID)
+	}
+	got.Add(makePolygon("-20:-20, -20:-10, -10:-10, -10:-20", true))
+	quadraticValidate(t, got)
+
+	found := false
+	for _, cell := range got.cellMap {
+		if cell.findByShapeID(id) != nil {
+			found = true
+		}
+	}
+	if !found {
+		t.Errorf("shape added after decode was not indexed")
+	}
+}
