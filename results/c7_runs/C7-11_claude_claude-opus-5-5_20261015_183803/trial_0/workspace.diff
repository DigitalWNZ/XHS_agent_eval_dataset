+
+func encodeShapeIndex(t *testing.T, index *ShapeIndex) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(encodeShapeIndex(t, index))); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	return got
+}
+
+// checkShapeIndexEqual verifies that two indexes have the same shapes (by ID)
+// and the same cell structure.
+func checkShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded index is not fresh")
+	}
+	if got.Len() != want.Len() || got.nextID != want.nextID {
+		t.Fatalf("got %d shapes, nextID %d; want %d, %d", got.Len(), got.nextID, want.Len(), want.nextID)
+	}
+	for id, ws := range want.shapes {
+		gs := got.Shape(id)
+		if gs == nil {
+			t.Fatalf("shape %d missing after decode", id)
+		}
+		if reflect.TypeOf(gs) != reflect.TypeOf(ws) {
+			t.Errorf("shape %d: type %T, want %T", id, gs, ws)
+		}
+		if gs.NumEdges() != ws.NumEdges() || gs.NumChains() != ws.NumChains() ||
+			gs.Dimension() != ws.Dimension() || gs.ReferencePoint() != ws.ReferencePoint() {
+			t.Errorf("shape %d: properties differ after decode", id)
+		}
+		for e := 0; e < ws.NumEdges(); e++ {
+			if gs.Edge(e) != ws.Edge(e) {
+				t.Errorf("shape %d edge %d = %v, want %v", id, e, gs.Edge(e), ws.Edge(e))
+			}
+		}
+		for c := 0; c < ws.NumChains(); c++ {
+			if gs.Chain(c) != ws.Chain(c) {
+				t.Errorf("shape %d chain %d = %v, want %v", id, c, gs.Chain(c), ws.Chain(c))
+			}
+		}
+	}
+
+	want.Build()
+	if !reflect.DeepEqual(got.cells, want.cells) {
+		t.Fatalf("cells = %v, want %v", got.cells, want.cells)
+	}
+	for _, id := range want.cells {
+		if !reflect.DeepEqual(got.cellMap[id], want.cellMap[id]) {
+			t.Errorf("cell %v: contents differ after decode", id)
+		}
+	}
+}
