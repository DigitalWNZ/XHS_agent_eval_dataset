+func TestShapeIndexEncodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	shapes := allBuiltinShapes()
+	for _, s := range shapes {
+		index.Add(s)
+	}
+	index.Build()
+	index.Remove(shapes[0])
+	index.Remove(shapes[3])
+	index.Remove(shapes[len(shapes)-1])
+
+	got := roundTripShapeIndex(t, index)
+	checkShapeIndexEqual(t, got, index)
+	if got.Shape(0) != nil || got.Shape(3) != nil {
+		t.Errorf("removed shapes reappeared after decode")
+	}
+	for _, cell := range got.cellMap {
+		if cell.findByShapeID(0) != nil || cell.findByShapeID(3) != nil {
+			t.Errorf("removed shapes still referenced by index cells")
+		}
+	}
+	quadraticValidate(t, got)
+
+}
