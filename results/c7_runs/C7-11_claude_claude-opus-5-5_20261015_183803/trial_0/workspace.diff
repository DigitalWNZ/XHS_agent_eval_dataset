+func TestShapeIndexEncodeEmpty(t *testing.T) {
+	data := encodeShapeIndex(t, NewShapeIndex())
+	if len(data) == 0 {
+		t.Fatal("empty index encoded to no bytes")
+	}
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	if got.Len() != 0 || len(got.cells) != 0 {
+		t.Errorf("decoded empty index has %d shapes, %d cells", got.Len(), len(got.cells))
+	}
+
+	// Decoding into a zero value works too.
+	var zero ShapeIndex
+	if err := zero.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode() into zero value failed: %v", err)
+	}
+	zero.Add(makePolyline("0:0, 1:1"))
+	if zero.NumEdges() != 1 || len(zero.Iterator().index.cells) == 0 {
+		t.Errorf("index decoded into zero value is not usable")
+	}
+}
