+func TestLoadKey(t *testing.T) {
+	rawKey := generateTestKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// 1. env source
+	t.Setenv("TEST_ONEDUMP_ENC_KEY", b64Key)
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_ONEDUMP_ENC_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// unset env var -> error
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "UNSET_ONEDUMP_ENC_KEY"})
+	require.Error(t, err)
+
+	// 2. file source (trimmed)
+	tmpDir := t.TempDir()
+	keyFile := filepath.Join(tmpDir, "key.txt")
+	require.NoError(t, os.WriteFile(keyFile, []byte("  \n"+b64Key+"\n\t "), 0600))
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: keyFile})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// 3. literal source
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// literal non-32-byte key -> error
+	shortB64 := base64.StdEncoding.EncodeToString([]byte("short-key"))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: shortB64})
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// 4. derive source
+	salt16 := make([]byte, 16)
+	_, err = io.ReadFull(rand.Reader, salt16)
+	require.NoError(t, err)
+	b64Salt := base64.StdEncoding.EncodeToString(salt16)
+
+	derived1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Len(t, derived1, 32)
+
+	derived2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.Equal(t, derived1, derived2)
+
+	derivedDiffPass, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "other passphrase", Salt: b64Salt})
+	require.NoError(t, err)
+	assert.NotEqual(t, derived1, derivedDiffPass)
+
+	// salt < 16 bytes -> error
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: shortSalt})
+	require.Error(t, err)
+
+	// empty passphrase -> error
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt})
+	require.Error(t, err)
+}
