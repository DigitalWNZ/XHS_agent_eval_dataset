diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..e702478
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,199 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+// Config holds the encryption configuration for a dump job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func firstNonEmpty(vals ...string) string {
+	for _, v := range vals {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+// UnmarshalYAML supports multiple YAML key naming conventions (e.g., keysource, key_source, key-source).
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled    bool   `yaml:"enabled"`
+		KeySource  string `yaml:"keysource"`
+		KeySource2 string `yaml:"key_source"`
+		KeySource3 string `yaml:"key-source"`
+		KeyEnvVar  string `yaml:"keyenvvar"`
+		KeyEnvVar2 string `yaml:"key_env_var"`
+		KeyEnvVar3 string `yaml:"key-env-var"`
+		KeyFile    string `yaml:"keyfile"`
+		KeyFile2   string `yaml:"key_file"`
+		KeyFile3   string `yaml:"key-file"`
+		Key        string `yaml:"key"`
+		Passphrase string `yaml:"passphrase"`
+		Salt       string `yaml:"salt"`
+	}
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySource2, raw.KeySource3)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVar2, raw.KeyEnvVar3)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFile2, raw.KeyFile3)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+
+	return nil
+}
+
+// Validate checks whether the encryption configuration is valid.
+// Disabled configs are always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateSourceAndFields()
+}
+
+func (c Config) validateSourceAndFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case KeySourceEnv:
+		var errs []error
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			errs = append(errs, errors.New("encryption key source 'env' fields are mutually exclusive with other key source fields"))
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			errs = append(errs, errors.New("encryption key env var (KeyEnvVar) is required for 'env' key source"))
+		}
+		return errors.Join(errs...)
+
+	case KeySourceFile:
+		var errs []error
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			errs = append(errs, errors.New("encryption key source 'file' fields are mutually exclusive with other key source fields"))
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			errs = append(errs, errors.New("encryption key file (KeyFile) is required for 'file' key source"))
+		}
+		return errors.Join(errs...)
+
+	case KeySourceLiteral:
+		var errs []error
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			errs = append(errs, errors.New("encryption key source 'literal' fields are mutually exclusive with other key source fields"))
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			errs = append(errs, errors.New("encryption key (Key) is required for 'literal' key source"))
+		}
+		return errors.Join(errs...)
+
+	case KeySourceDerive:
+		var errs []error
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			errs = append(errs, errors.New("encryption key source 'derive' fields are mutually exclusive with other key source fields"))
+		}
+		if strings.TrimSpace(c.Passphrase) == "" {
+			errs = append(errs, errors.New("encryption key passphrase is required for 'derive' key source"))
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			errs = append(errs, errors.New("encryption key salt is required for 'derive' key source"))
+		}
+		return errors.Join(errs...)
+
+	default:
+		return fmt.Errorf("unsupported encryption key source: %q", c.KeySource)
+	}
+}
+
+// LoadKey loads or derives a 32-byte encryption key based on the provided Config.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateSourceAndFields(); err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("%w: encryption key environment variable %q is not set or empty", ErrInvalidKey, envName)
+		}
+		return decodeBase64Key(strings.TrimSpace(val), KeySourceEnv)
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		return decodeBase64Key(strings.TrimSpace(string(data)), KeySourceFile)
+
+	case KeySourceLiteral:
+		return decodeBase64Key(strings.TrimSpace(cfg.Key), KeySourceLiteral)
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, fmt.Errorf("%w: encryption key passphrase cannot be empty", ErrInvalidKey)
+		}
+		saltBytes, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("%w: invalid base64 encryption key salt: %v", ErrInvalidKey, err)
+		}
+		if len(saltBytes) < MinSaltSize {
+			return nil, fmt.Errorf("%w: encryption key salt must be at least %d bytes, got %d", ErrInvalidKey, MinSaltSize, len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, pbkdf2Iterations, KeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("%w: unsupported encryption key source: %q", ErrInvalidKey, cfg.KeySource)
+	}
+}
+
+func decodeBase64Key(encoded string, source string) ([]byte, error) {
+	if encoded == "" {
+		return nil, fmt.Errorf("%w: empty encryption key from %s source", ErrInvalidKey, source)
+	}
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("%w: failed to decode base64 encryption key from %s source: %v", ErrInvalidKey, source, err)
+	}
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: encryption key from %s source must be %d bytes, got %d", ErrInvalidKey, source, KeySize, len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..eddab94
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,305 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize       = 32
+	NonceSize     = 12
+	TagSize       = 16
+	MaxChunkSize  = 64 * 1024
+	HeaderSize    = 3
+	MagicByte1    = 0x4F
+	MagicByte2    = 0x44
+	FormatVersion = 0x01
+	HMACSize      = 32
+)
+
+var ErrInvalidKey = errors.New("invalid encryption key")
+
+// Encryptor performs AES-256-GCM streaming encryption.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor with a 32-byte AES-256 key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: encryption key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &Encryptor{key: k}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts written data using AES-256-GCM streaming.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	var gcm cipher.AEAD
+	if err == nil {
+		gcm, err = cipher.NewGCM(block)
+	}
+
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, e.key),
+		err: err,
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	header := [HeaderSize]byte{MagicByte1, MagicByte2, FormatVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return fmt.Errorf("failed to write encryption header: %w", err)
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	nonce := make([]byte, NonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	sealed := ew.gcm.Seal(nil, nonce, plaintext, nil)
+	chunkLen := uint32(len(nonce) + len(sealed))
+
+	frame := make([]byte, 4+int(chunkLen))
+	binary.BigEndian.PutUint32(frame[:4], chunkLen)
+	copy(frame[4:4+NonceSize], nonce)
+	copy(frame[4+NonceSize:], sealed)
+
+	ew.mac.Write(frame)
+	if _, err := ew.w.Write(frame); err != nil {
+		return fmt.Errorf("failed to write encrypted chunk: %w", err)
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed encryption writer")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return 0, err
+		}
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		chunkSize := len(p)
+		if chunkSize > MaxChunkSize {
+			chunkSize = MaxChunkSize
+		}
+		if err := ew.writeChunk(p[:chunkSize]); err != nil {
+			ew.err = err
+			return totalWritten, err
+		}
+		totalWritten += chunkSize
+		p = p[chunkSize:]
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+	if ew.err != nil {
+		return ew.err
+	}
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return err
+		}
+	}
+
+	var trailer [4 + HMACSize]byte
+	sum := ew.mac.Sum(nil)
+	copy(trailer[4:], sum)
+
+	if _, err := ew.w.Write(trailer[:]); err != nil {
+		ew.err = fmt.Errorf("failed to write encryption trailer: %w", err)
+		return ew.err
+	}
+
+	return nil
+}
+
+// DecryptReader returns an io.Reader that decrypts an AES-256-GCM encrypted stream.
+// Stream header initialization and validation occur lazily on Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: encryption key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, k),
+	}, nil
+}
+
+type decryptReader struct {
+	r          io.Reader
+	gcm        cipher.AEAD
+	mac        hash.Hash
+	headerRead bool
+	eof        bool
+	plainBuf   []byte
+	err        error
+}
+
+func (dr *decryptReader) initHeader() error {
+	if dr.r == nil {
+		return errors.New("invalid header: nil reader")
+	}
+
+	var header [HeaderSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		return fmt.Errorf("invalid header: truncated stream: %v", err)
+	}
+
+	if header[0] != MagicByte1 || header[1] != MagicByte2 {
+		return fmt.Errorf("invalid header: unexpected magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+
+	if header[2] != FormatVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	dr.headerRead = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream while reading chunk length: %v", err)
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		var expectedMAC [HMACSize]byte
+		if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+			return fmt.Errorf("truncated encrypted stream while reading HMAC trailer: %v", err)
+		}
+
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC[:]) {
+			return errors.New("integrity check failed: HMAC mismatch")
+		}
+
+		dr.eof = true
+		return nil
+	}
+
+	minChunkPayload := uint32(NonceSize + TagSize)
+	maxChunkPayload := uint32(MaxChunkSize + NonceSize + TagSize)
+	if chunkLen < minChunkPayload || chunkLen > maxChunkPayload {
+		return fmt.Errorf("invalid chunk length %d: integrity check failed", chunkLen)
+	}
+
+	dr.mac.Write(lenBuf[:])
+
+	chunkBuf := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkBuf); err != nil {
+		return fmt.Errorf("truncated encrypted stream while reading chunk payload: %v", err)
+	}
+
+	dr.mac.Write(chunkBuf)
+
+	nonce := chunkBuf[:NonceSize]
+	ciphertextWithTag := chunkBuf[NonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertextWithTag, nil)
+	if err != nil {
+		return fmt.Errorf("chunk decryption failed (integrity check error): %w", err)
+	}
+
+	dr.plainBuf = append(dr.plainBuf, plaintext...)
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.headerRead {
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	totalCopied := 0
+	for totalCopied < len(p) {
+		if len(dr.plainBuf) > 0 {
+			n := copy(p[totalCopied:], dr.plainBuf)
+			dr.plainBuf = dr.plainBuf[n:]
+			totalCopied += n
+			continue
+		}
+
+		if dr.eof {
+			break
+		}
+
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return totalCopied, err
+		}
+	}
+
+	if totalCopied == 0 && dr.eof {
+		return 0, io.EOF
+	}
+
+	return totalCopied, nil
+}
