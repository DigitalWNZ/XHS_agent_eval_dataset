+func TestDecryptReaderLazyInitAndErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Lazy init: should not read from r until Read is called
+	dr, err := DecryptReader(panicReader{}, key)
+	require.NoError(t, err)
+	require.NotNil(t, dr)
+
+	// Invalid header magic
+	dr, err = DecryptReader(bytes.NewReader([]byte{0x00, 0x00, 0x01, 0, 0, 0, 0}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+
+	// Unsupported version
+	dr, err = DecryptReader(bytes.NewReader([]byte{0x4F, 0x44, 0x02, 0, 0, 0, 0}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+
+	// Encrypt valid stream for further tamper/truncation tests
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("sensitive database dump content"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	// Wrong key must fail
+	wrongKey := generateTestKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validBytes), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Corrupted HMAC must return error containing "integrity"
+	corruptedHMAC := make([]byte, len(validBytes))
+	copy(corruptedHMAC, validBytes)
+	corruptedHMAC[len(corruptedHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(corruptedHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+
+	// Truncated data at every possible prefix length must error
+	for cut := 0; cut < len(validBytes); cut++ {
+		dr, err := DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "expected error for truncated stream of length %d/%d", cut, len(validBytes))
+	}
+}
