@@ -0,0 +1,306 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func generateTestKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+
+	for _, badLen := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		badKey := make([]byte, badLen)
+		_, err := NewEncryptor(badKey)
+		require.Error(t, err)
+		assert.True(t, errors.Is(err, ErrInvalidKey), "expected ErrInvalidKey for key length %d, got: %v", badLen, err)
+	}
+}
+
+func TestStreamFormatAndRoundTrip(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name      string
+		plaintext []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("SELECT * FROM users WHERE id = 1;")},
+		{"exact_64KB", bytes.Repeat([]byte("A"), 64*1024)},
+		{"multi_chunk_200KB", bytes.Repeat([]byte("0123456789abcdef"), (200*1024)/16)},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+			if len(tc.plaintext) > 0 {
+				n, err := ew.Write(tc.plaintext)
+				require.NoError(t, err)
+				assert.Equal(t, len(tc.plaintext), n)
+			}
+			require.NoError(t, ew.Close())
+			// Idempotent close
+			require.NoError(t, ew.Close())
+
+			raw := buf.Bytes()
+			require.GreaterOrEqual(t, len(raw), HeaderSize+4+HMACSize)
+
+			// Verify 3-byte header: 0x4F 0x44 0x01
+			assert.Equal(t, byte(0x4F), raw[0])
+			assert.Equal(t, byte(0x44), raw[1])
+			assert.Equal(t, byte(0x01), raw[2])
+
+			// Parse chunks until 4-byte zero sentinel
+			offset := HeaderSize
+			nonces := make(map[string]bool)
+			chunkCount := 0
+			for {
+				require.LessOrEqual(t, offset+4, len(raw))
+				chunkLen := binary.BigEndian.Uint32(raw[offset : offset+4])
+				if chunkLen == 0 {
+					break
+				}
+				chunkCount++
+				offset += 4
+				require.LessOrEqual(t, offset+int(chunkLen), len(raw))
+				assert.LessOrEqual(t, int(chunkLen), MaxChunkSize+NonceSize+TagSize)
+
+				nonce := string(raw[offset : offset+NonceSize])
+				assert.False(t, nonces[nonce], "duplicate nonce in chunk %d", chunkCount)
+				nonces[nonce] = true
+
+				offset += int(chunkLen)
+			}
+
+			// Verify HMAC over all bytes between header and sentinel
+			betweenHeaderAndSentinel := raw[HeaderSize:offset]
+			sentinelBytes := raw[offset : offset+4]
+			assert.Equal(t, []byte{0, 0, 0, 0}, sentinelBytes)
+			actualHMAC := raw[offset+4:]
+			assert.Len(t, actualHMAC, HMACSize)
+
+			mac := hmac.New(sha256.New, key)
+			mac.Write(betweenHeaderAndSentinel)
+			expectedHMAC := mac.Sum(nil)
+			assert.Equal(t, expectedHMAC, actualHMAC)
+
+			// Round-trip via DecryptReader
+			dr, err := DecryptReader(bytes.NewReader(raw), key)
+			require.NoError(t, err)
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.plaintext, decrypted)
+		})
+	}
+}
