diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..772c002
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,211 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	MinSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled      bool   `yaml:"enabled"`
+		KeySource    string `yaml:"keysource"`
+		KeySourceSnk string `yaml:"key_source"`
+		KeySourceKeb string `yaml:"key-source"`
+		KeyEnvVar    string `yaml:"keyenvvar"`
+		KeyEnvVarSnk string `yaml:"key_env_var"`
+		KeyEnvVarKeb string `yaml:"key-env-var"`
+		KeyFile      string `yaml:"keyfile"`
+		KeyFileSnk   string `yaml:"key_file"`
+		KeyFileKeb   string `yaml:"key-file"`
+		Key          string `yaml:"key"`
+		Passphrase   string `yaml:"passphrase"`
+		Salt         string `yaml:"salt"`
+	}
+
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySourceSnk, raw.KeySourceKeb)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVarSnk, raw.KeyEnvVarKeb)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFileSnk, raw.KeyFileKeb)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+
+	return nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	return c.validateSourceAndFields()
+}
+
+func (c Config) validateSourceAndFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case KeySourceEnv:
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption key source fields are mutually exclusive: env source only allows KeyEnvVar")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("encryption KeyEnvVar is required when key source is env")
+		}
+	case KeySourceFile:
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption key source fields are mutually exclusive: file source only allows KeyFile")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("encryption KeyFile is required when key source is file")
+		}
+	case KeySourceLiteral:
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption key source fields are mutually exclusive: literal source only allows Key")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("encryption Key is required when key source is literal")
+		}
+	case KeySourceDerive:
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("encryption key source fields are mutually exclusive: derive source only allows Passphrase and Salt")
+		}
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption Passphrase is required when key source is derive")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption Salt is required when key source is derive")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %q", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateSourceAndFields(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+
+	switch source {
+	case KeySourceEnv:
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envName)
+		}
+
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(val))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from environment variable %q: %w", envName, err)
+		}
+
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: decoded key from environment variable %q has %d bytes, expected %d", ErrInvalidKey, envName, len(key), KeySize)
+		}
+
+		return key, nil
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		raw, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+
+		trimmed := strings.TrimSpace(string(raw))
+		if trimmed == "" {
+			return nil, fmt.Errorf("%w: encryption key file %q is empty", ErrInvalidKey, filePath)
+		}
+
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %q: %w", filePath, err)
+		}
+
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: decoded key from file %q has %d bytes, expected %d", ErrInvalidKey, filePath, len(key), KeySize)
+		}
+
+		return key, nil
+
+	case KeySourceLiteral:
+		trimmed := strings.TrimSpace(cfg.Key)
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode literal base64 encryption key: %w", err)
+		}
+
+		if len(key) != KeySize {
+			return nil, fmt.Errorf("%w: literal key has %d bytes, expected %d", ErrInvalidKey, len(key), KeySize)
+		}
+
+		return key, nil
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+
+		salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 salt for encryption key derivation: %w", err)
+		}
+
+		if len(salt) < MinSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", MinSaltSize, len(salt))
+		}
+
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, pbkdf2Iterations, KeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %q", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..1bb82c1
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,340 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	KeySize      = 32
+	MaxChunkSize = 64 * 1024 // 64KB
+	NonceSize    = 12
+	TagSize      = 16
+	MagicByte1   = 0x4F
+	MagicByte2   = 0x44
+	Version1     = 0x01
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+)
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	return &Encryptor{
+		key: keyCopy,
+	}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		// Key length is already validated in NewEncryptor.
+		panic(err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		panic(err)
+	}
+
+	mac := hmac.New(sha256.New, e.key)
+
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: mac,
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	headerWritten bool
+	closed        bool
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := [3]byte{MagicByte1, MagicByte2, Version1}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	var nonce [NonceSize]byte
+	if _, err := io.ReadFull(rand.Reader, nonce[:]); err != nil {
+		return fmt.Errorf("failed to generate random nonce: %w", err)
+	}
+
+	sealedLen := len(plaintext) + ew.gcm.Overhead()
+	chunkLen := uint32(NonceSize + sealedLen)
+
+	frame := make([]byte, 4+NonceSize, 4+NonceSize+sealedLen)
+	binary.BigEndian.PutUint32(frame[:4], chunkLen)
+	copy(frame[4:4+NonceSize], nonce[:])
+	frame = ew.gcm.Seal(frame, nonce[:], plaintext, nil)
+
+	ew.mac.Write(frame)
+
+	if _, err := ew.w.Write(frame); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed encrypt writer")
+	}
+
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		chunkSize := len(p)
+		if chunkSize > MaxChunkSize {
+			chunkSize = MaxChunkSize
+		}
+
+		if err := ew.writeChunk(p[:chunkSize]); err != nil {
+			return totalWritten, err
+		}
+
+		p = p[chunkSize:]
+		totalWritten += chunkSize
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	var sentinel [4]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		return err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	keyCopy := make([]byte, KeySize)
+	copy(keyCopy, key)
+
+	return &decryptReader{
+		r:   r,
+		key: keyCopy,
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	eof         bool
+	buf         []byte
+	nextLen     uint32
+	err         error
+}
+
+func (d *decryptReader) init() error {
+	if d.r == nil {
+		return errors.New("invalid header: nil reader")
+	}
+
+	block, err := aes.NewCipher(d.key)
+	if err != nil {
+		return fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return err
+	}
+
+	d.gcm = gcm
+	d.mac = hmac.New(sha256.New, d.key)
+
+	var header [3]byte
+	if _, err := io.ReadFull(d.r, header[:]); err != nil {
+		return fmt.Errorf("invalid header: truncated stream: %v", err)
+	}
+
+	if header[0] != MagicByte1 || header[1] != MagicByte2 {
+		return fmt.Errorf("invalid header: unexpected magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+
+	if header[2] != Version1 {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(d.r, lenBuf[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream: failed to read chunk length or sentinel: %v", err)
+	}
+
+	d.nextLen = binary.BigEndian.Uint32(lenBuf[:])
+	if d.nextLen == 0 {
+		if err := d.verifyHMAC(); err != nil {
+			return err
+		}
+		d.eof = true
+		return nil
+	}
+
+	d.mac.Write(lenBuf[:])
+	return nil
+}
+
+func (d *decryptReader) verifyHMAC() error {
+	var expectedMAC [32]byte
+	if _, err := io.ReadFull(d.r, expectedMAC[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream: failed to read HMAC trailer: %v", err)
+	}
+
+	actualMAC := d.mac.Sum(nil)
+	if !hmac.Equal(actualMAC, expectedMAC[:]) {
+		return errors.New("integrity check failed: HMAC verification failed")
+	}
+
+	return nil
+}
+
+func (d *decryptReader) readNextChunk() error {
+	minChunkLen := uint32(d.gcm.NonceSize() + d.gcm.Overhead())
+	maxChunkLen := uint32(MaxChunkSize) + minChunkLen
+
+	if d.nextLen < minChunkLen || d.nextLen > maxChunkLen {
+		return fmt.Errorf("invalid chunk length %d: integrity check failed", d.nextLen)
+	}
+
+	chunkBuf := make([]byte, d.nextLen)
+	if _, err := io.ReadFull(d.r, chunkBuf); err != nil {
+		return fmt.Errorf("truncated encrypted stream: failed to read chunk payload: %v", err)
+	}
+
+	d.mac.Write(chunkBuf)
+
+	nonceSize := d.gcm.NonceSize()
+	nonce := chunkBuf[:nonceSize]
+	ciphertext := chunkBuf[nonceSize:]
+
+	plaintext, err := d.gcm.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decryption failed: integrity check failed: %w", err)
+	}
+
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(d.r, lenBuf[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream: missing next chunk length or sentinel: %v", err)
+	}
+
+	d.nextLen = binary.BigEndian.Uint32(lenBuf[:])
+	if d.nextLen == 0 {
+		if err := d.verifyHMAC(); err != nil {
+			return err
+		}
+		d.eof = true
+	} else {
+		d.mac.Write(lenBuf[:])
+	}
+
+	d.buf = plaintext
+	return nil
+}
+
+func (d *decryptReader) Read(p []byte) (int, error) {
+	if d.err != nil {
+		return 0, d.err
+	}
+
+	if !d.initialized {
+		d.initialized = true
+		if err := d.init(); err != nil {
+			d.err = err
+			return 0, d.err
+		}
+	}
+
+	if len(p) == 0 {
+		if d.eof && len(d.buf) == 0 {
+			return 0, io.EOF
+		}
+		return 0, nil
+	}
+
+	totalRead := 0
+	for len(p) > 0 {
+		if len(d.buf) == 0 {
+			if d.eof {
+				if totalRead > 0 {
+					return totalRead, nil
+				}
+				return 0, io.EOF
+			}
+
+			if err := d.readNextChunk(); err != nil {
+				d.err = err
+				return 0, d.err
+			}
+		}
+
+		n := copy(p, d.buf)
+		d.buf = d.buf[n:]
+		p = p[n:]
+		totalRead += n
+	}
+
+	return totalRead, nil
+}
