@@ -0,0 +1,313 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func randomKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, KeySize)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+
+	for _, length := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		badKey := make([]byte, length)
+		enc, err := NewEncryptor(badKey)
+		assert.Nil(t, enc)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("SELECT * FROM users WHERE id = 1;")},
+		{"exact_64kb", bytes.Repeat([]byte("A"), MaxChunkSize)},
+		{"multi_chunk_200kb", bytes.Repeat([]byte("0123456789abcdef"), 12800)}, // 200KB
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+			n, err := ew.Write(tc.data)
+			require.NoError(t, err)
+			assert.Equal(t, len(tc.data), n)
+			require.NoError(t, ew.Close())
+
+			// Idempotent close
+			require.NoError(t, ew.Close())
+
+			dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.data, decrypted)
+		})
+	}
+}
+
+func TestStreamWireFormatAndUniqueNonces(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// 150KB -> 3 chunks (64KB, 64KB, 22KB)
+	plaintext := bytes.Repeat([]byte("x"), 150*1024)
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	// Two encryptions of same plaintext must differ
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	raw := buf1.Bytes()
+	require.Greater(t, len(raw), 3+4+32)
+
+	// Check 3-byte header: 0x4F 0x44 0x01
+	assert.Equal(t, byte(0x4F), raw[0])
+	assert.Equal(t, byte(0x44), raw[1])
+	assert.Equal(t, byte(0x01), raw[2])
+
+	offset := 3
+	nonces := make(map[string]bool)
+	chunkCount := 0
+
+	for {
+		require.LessOrEqual(t, offset+4, len(raw))
+		chunkLen := binary.BigEndian.Uint32(raw[offset : offset+4])
+		offset += 4
+		if chunkLen == 0 {
+			break
+		}
+		chunkCount++
+		// Max chunk length is 64KB + 12B nonce + 16B tag
+		assert.LessOrEqual(t, int(chunkLen), MaxChunkSize+NonceSize+TagSize)
+		require.LessOrEqual(t, offset+int(chunkLen), len(raw))
+
+		nonce := raw[offset : offset+NonceSize]
+		nonceStr := string(nonce)
+		assert.False(t, nonces[nonceStr], "duplicate nonce found in chunk %d", chunkCount)
+		nonces[nonceStr] = true
+
+		offset += int(chunkLen)
+	}
+
+	assert.Equal(t, 3, chunkCount)
+
+	// Verify 32-byte HMAC-SHA256 over all bytes between header (3) and sentinel (offset-4)
+	sentinelStart := offset - 4
+	expectedMAC := raw[offset:]
+	assert.Len(t, expectedMAC, 32)
+
+	mac := hmac.New(sha256.New, key)
+	mac.Write(raw[3:sentinelStart])
+	assert.True(t, hmac.Equal(mac.Sum(nil), expectedMAC))
+}
+
+func TestDecryptReaderLazyInitAndErrors(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Reject non-32-byte key in DecryptReader
+	_, err = DecryptReader(bytes.NewReader(nil), []byte("short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// Lazy init: bad header does not fail in DecryptReader constructor, fails in Read
+	dr, err := DecryptReader(bytes.NewReader([]byte{0x00, 0x00, 0x01}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+
+	// Unsupported version
+	dr, err = DecryptReader(bytes.NewReader([]byte{0x4F, 0x44, 0x02, 0, 0, 0, 0}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+
+	// Prepare valid encrypted data
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("sensitive database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := buf.Bytes()
+
+	// Corrupted HMAC (last byte flipped)
+	badHMAC := append([]byte(nil), validBytes...)
+	badHMAC[len(badHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(badHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+
+	// Wrong key
+	wrongKey := randomKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validBytes), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Truncated streams at various offsets
+	for _, cut := range []int{0, 1, 2, 3, 5, 15, len(validBytes) - 36, len(validBytes) - 32, len(validBytes) - 10, len(validBytes) - 1} {
+		dr, err = DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "expected error for truncated length %d", cut)
+	}
+}
