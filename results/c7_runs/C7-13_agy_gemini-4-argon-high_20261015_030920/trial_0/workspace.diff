+func TestStorageReadWriteCloserEncryptionAndGzip(t *testing.T) {
+	key := make([]byte, encryption.KeySize)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	original := []byte("CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(255));\nINSERT INTO users VALUES (1, 'Alice');\n")
+
+	readers, writer, closer := storageReadWriteCloser(2, true, enc)
+	require.Len(t, readers, 2)
+
+	var wg sync.WaitGroup
+	outputs := make([][]byte, len(readers))
+	readErrs := make([]error, len(readers))
+	for i := range readers {
+		wg.Add(1)
+		go func(idx int) {
+			defer wg.Done()
+			outputs[idx], readErrs[idx] = io.ReadAll(readers[idx])
+		}(i)
+	}
+
+	_, wErr := writer.Write(original)
+	require.NoError(t, wErr)
+	require.NoError(t, closer.Close())
+	wg.Wait()
+
+	for i := range readers {
+		require.NoError(t, readErrs[i])
+
+		decReader, err := encryption.DecryptReader(bytes.NewReader(outputs[i]), key)
+		require.NoError(t, err)
+
+		gzReader, err := gzip.NewReader(decReader)
+		require.NoError(t, err)
+
+		decompressed, err := io.ReadAll(gzReader)
+		require.NoError(t, err)
+		require.NoError(t, gzReader.Close())
+
+		assert.Equal(t, original, decompressed)
+	}
+}
