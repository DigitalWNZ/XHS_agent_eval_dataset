+		KeyEnvVar: missingEnv,
+	}
+	tmpFile := t.TempDir() + "/backup.sql"
+	jobWithStorage.Storage.Local = []*local.Local{{Path: tmpFile}}
+
+	res2 := NewJobHandler(jobWithStorage).Do()
+	require.Error(t, res2.Error)
+	msg2 := strings.ToLower(res2.Error.Error())
+	assert.True(t, strings.Contains(msg2, "encryption") || strings.Contains(msg2, "key"))
+	_, statErr := os.Stat(tmpFile)
+	assert.True(t, errors.Is(statErr, os.ErrNotExist))
+
+	// Valid inline key round-trip test via storageReadWriteCloser without compress
+	key := make([]byte, encryption.KeySize)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	b64Key := base64.StdEncoding.EncodeToString(key)
+
+	loadedKey, err := encryption.LoadKey(encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       b64Key,
+	})
+	require.NoError(t, err)
+	assert.Equal(t, key, loadedKey)
 }
 
