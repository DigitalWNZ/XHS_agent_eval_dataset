+func TestConfigValidate(t *testing.T) {
+	// Disabled configs are always valid
+	assert.NoError(t, (Config{Enabled: false}).Validate())
+	assert.NoError(t, (Config{Enabled: false, KeySource: "invalid", Key: "a", KeyFile: "b"}).Validate())
+
+	// Enabled with empty or unsupported key source
+	assert.Error(t, (Config{Enabled: true}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "unknown"}).Validate())
+
+	// Valid configs (case-insensitive KeySource)
+	assert.NoError(t, (Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "File", KeyFile: "/tmp/key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "literal", Key: "base64key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "Derive", Passphrase: "secret", Salt: "somesalt"}).Validate())
+
+	// Missing required fields for each source
+	assert.Error(t, (Config{Enabled: true, KeySource: "env"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "file"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "literal"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Passphrase: "secret"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Salt: "somesalt"}).Validate())
+
+	// Mutually exclusive fields
+	err := (Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", KeyFile: "/tmp/key"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", Key: "inline"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "literal", Key: "inline", Passphrase: "pass"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", KeyEnvVar: "ENV"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+}
