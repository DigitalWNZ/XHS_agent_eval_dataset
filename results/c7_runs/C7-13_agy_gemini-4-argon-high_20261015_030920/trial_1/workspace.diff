+func TestTwoEncryptionsDifferAndUniqueNoncesPerChunk(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// 200KB payload (> 3 chunks of 64KB)
+	plaintext := bytes.Repeat([]byte("onedump-encryption-test-payload-"), 6400)
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	// Parse chunks from buf1 and verify unique nonces
+	raw := buf1.Bytes()
+	offset := 3
+	seenNonces := make(map[string]bool)
+	chunkCount := 0
+	for {
+		chunkLen := binary.BigEndian.Uint32(raw[offset : offset+4])
+		offset += 4
+		if chunkLen == 0 {
+			break
+		}
+		chunkCount++
+		assert.LessOrEqual(t, int(chunkLen), maxChunkSize+nonceSize+tagSize)
+		nonce := string(raw[offset : offset+nonceSize])
+		assert.False(t, seenNonces[nonce], "duplicate nonce found in chunk %d", chunkCount)
+		seenNonces[nonce] = true
+		offset += int(chunkLen)
+	}
+	assert.GreaterOrEqual(t, chunkCount, 4)
+
+	// Verify full round-trip
+	dr, err := DecryptReader(bytes.NewReader(raw), key)
+	require.NoError(t, err)
+	decrypted, err := io.ReadAll(dr)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, decrypted)
+}
