diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..f524931
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,194 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	minSaltBytes     = 16
+	pbkdf2Iterations = 100000
+)
+
+// Config holds the encryption configuration for a job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// UnmarshalYAML supports multiple YAML naming conventions (e.g. keysource, key_source, key-source).
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled     bool   `yaml:"enabled"`
+		KeySource   string `yaml:"keysource"`
+		KeySourceUS string `yaml:"key_source"`
+		KeySourceHy string `yaml:"key-source"`
+		KeyEnvVar   string `yaml:"keyenvvar"`
+		KeyEnvVarUS string `yaml:"key_env_var"`
+		KeyEnvVarHy string `yaml:"key-env-var"`
+		KeyFile     string `yaml:"keyfile"`
+		KeyFileUS   string `yaml:"key_file"`
+		KeyFileHy   string `yaml:"key-file"`
+		Key         string `yaml:"key"`
+		Passphrase  string `yaml:"passphrase"`
+		Salt        string `yaml:"salt"`
+	}
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySourceUS, raw.KeySourceHy)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVarUS, raw.KeyEnvVarHy)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFileUS, raw.KeyFileHy)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+	return nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+// Validate checks that the encryption configuration is valid.
+// Disabled configurations are always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateSourceAndFields()
+}
+
+func (c Config) validateSourceAndFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := c.KeyEnvVar != ""
+	hasFile := c.KeyFile != ""
+	hasKey := c.Key != ""
+	hasPassphrase := c.Passphrase != ""
+	hasSalt := c.Salt != ""
+
+	switch source {
+	case KeySourceEnv:
+		if hasFile || hasKey || hasPassphrase || hasSalt {
+			return errors.New("encryption key source fields are mutually exclusive: env source only allows KeyEnvVar")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("encryption key env var is required for env key source")
+		}
+	case KeySourceFile:
+		if hasEnv || hasKey || hasPassphrase || hasSalt {
+			return errors.New("encryption key source fields are mutually exclusive: file source only allows KeyFile")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("encryption key file is required for file key source")
+		}
+	case KeySourceLiteral:
+		if hasEnv || hasFile || hasPassphrase || hasSalt {
+			return errors.New("encryption key source fields are mutually exclusive: literal source only allows Key")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("encryption key is required for literal key source")
+		}
+	case KeySourceDerive:
+		if hasEnv || hasFile || hasKey {
+			return errors.New("encryption key source fields are mutually exclusive: derive source only allows Passphrase and Salt")
+		}
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption salt is required for derive key source")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %q", c.KeySource)
+	}
+
+	return nil
+}
+
+// LoadKey loads or derives a 32-byte encryption key based on cfg.
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateSourceAndFields(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envName)
+		}
+		return decodeBase64Key(strings.TrimSpace(val), "environment variable "+envName)
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		return decodeBase64Key(strings.TrimSpace(string(data)), "file "+filePath)
+
+	case KeySourceLiteral:
+		return decodeBase64Key(strings.TrimSpace(cfg.Key), "literal configuration")
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, fmt.Errorf("%w: encryption passphrase cannot be empty", ErrInvalidKey)
+		}
+		salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(salt) < minSaltBytes {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", minSaltBytes, len(salt))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, pbkdf2Iterations, keySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %q", cfg.KeySource)
+	}
+}
+
+func decodeBase64Key(encoded, sourceDesc string) ([]byte, error) {
+	if encoded == "" {
+		return nil, fmt.Errorf("%w: empty encryption key from %s", ErrInvalidKey, sourceDesc)
+	}
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("%w: invalid base64 encryption key from %s: %v", ErrInvalidKey, sourceDesc, err)
+	}
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: encryption key from %s must be %d bytes, got %d", ErrInvalidKey, sourceDesc, keySize, len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..1c78dd6
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,323 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	magicByte1    byte = 0x4F
+	magicByte2    byte = 0x44
+	streamVersion byte = 0x01
+
+	headerSize   = 3
+	lengthSize   = 4
+	nonceSize    = 12
+	tagSize      = 16
+	hmacSize     = sha256.Size
+	keySize      = 32
+	maxChunkSize = 64 * 1024
+)
+
+var (
+	// ErrInvalidKey is returned when an encryption key is not 32 bytes or is otherwise invalid.
+	ErrInvalidKey = errors.New("invalid encryption key: must be 32 bytes")
+)
+
+// Encryptor performs AES-256-GCM streaming encryption.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor for a 32-byte AES-256 key.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, keySize)
+	copy(keyCopy, key)
+
+	return &Encryptor{key: keyCopy}, nil
+}
+
+// EncryptWriter returns an io.WriteCloser that encrypts written data using AES-256-GCM
+// in chunks up to 64KB, writing the result to w.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	var gcm cipher.AEAD
+	if err == nil {
+		gcm, err = cipher.NewGCM(block)
+	}
+
+	return &encryptWriter{
+		w:   w,
+		key: e.key,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, e.key),
+		err: err,
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := [headerSize]byte{magicByte1, magicByte2, streamVersion}
+	if err := writeAll(ew.w, header[:]); err != nil {
+		return fmt.Errorf("failed to write encryption header: %w", err)
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	if err := ew.writeHeader(); err != nil {
+		return err
+	}
+
+	var nonce [nonceSize]byte
+	if _, err := io.ReadFull(rand.Reader, nonce[:]); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	sealed := ew.gcm.Seal(nil, nonce[:], plaintext, nil)
+	chunkLen := uint32(nonceSize + len(sealed))
+
+	var lenBuf [lengthSize]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	ew.mac.Write(lenBuf[:])
+	ew.mac.Write(nonce[:])
+	ew.mac.Write(sealed)
+
+	if err := writeAll(ew.w, lenBuf[:]); err != nil {
+		return fmt.Errorf("failed to write chunk length: %w", err)
+	}
+	if err := writeAll(ew.w, nonce[:]); err != nil {
+		return fmt.Errorf("failed to write chunk nonce: %w", err)
+	}
+	if err := writeAll(ew.w, sealed); err != nil {
+		return fmt.Errorf("failed to write encrypted chunk: %w", err)
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write on closed EncryptWriter")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		chunk := p
+		if len(chunk) > maxChunkSize {
+			chunk = p[:maxChunkSize]
+		}
+		if err := ew.writeChunk(chunk); err != nil {
+			ew.err = err
+			return 0, err
+		}
+		p = p[len(chunk):]
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.writeHeader(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	var sentinel [lengthSize]byte
+	if err := writeAll(ew.w, sentinel[:]); err != nil {
+		ew.err = fmt.Errorf("failed to write sentinel: %w", err)
+		return ew.err
+	}
+
+	digest := ew.mac.Sum(nil)
+	if err := writeAll(ew.w, digest); err != nil {
+		ew.err = fmt.Errorf("failed to write HMAC: %w", err)
+		return ew.err
+	}
+
+	return nil
+}
+
+func writeAll(w io.Writer, buf []byte) error {
+	for len(buf) > 0 {
+		n, err := w.Write(buf)
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+		buf = buf[n:]
+	}
+	return nil
+}
+
+// DecryptReader returns an io.Reader that decrypts a stream produced by EncryptWriter.
+// Initialization from r is lazy and errors occur during Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	keyCopy := make([]byte, keySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	plainBuf    []byte
+	initialized bool
+	done        bool
+	err         error
+}
+
+func (dr *decryptReader) initHeader() error {
+	var header [headerSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		return fmt.Errorf("invalid header: truncated stream: %w", io.ErrUnexpectedEOF)
+	}
+	if header[0] != magicByte1 || header[1] != magicByte2 {
+		return fmt.Errorf("invalid header: unexpected magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+	if header[2] != streamVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [lengthSize]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		return fmt.Errorf("truncated encrypted stream reading chunk length: %w", io.ErrUnexpectedEOF)
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		var expectedMAC [hmacSize]byte
+		if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+			return fmt.Errorf("truncated encrypted stream reading HMAC: %w", io.ErrUnexpectedEOF)
+		}
+
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC[:]) {
+			return errors.New("stream HMAC integrity verification failed")
+		}
+
+		dr.done = true
+		return nil
+	}
+
+	minChunkLen := uint32(nonceSize + tagSize)
+	maxAllowedChunkLen := uint32(maxChunkSize + nonceSize + tagSize)
+	if chunkLen < minChunkLen || chunkLen > maxAllowedChunkLen {
+		return fmt.Errorf("chunk integrity check failed: invalid chunk length %d", chunkLen)
+	}
+
+	chunkBuf := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkBuf); err != nil {
+		return fmt.Errorf("truncated encrypted stream reading chunk data: %w", io.ErrUnexpectedEOF)
+	}
+
+	dr.mac.Write(lenBuf[:])
+	dr.mac.Write(chunkBuf)
+
+	nonce := chunkBuf[:nonceSize]
+	ciphertextWithTag := chunkBuf[nonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertextWithTag, nil)
+	if err != nil {
+		return fmt.Errorf("chunk decryption integrity check failed: %w", err)
+	}
+
+	dr.plainBuf = append(dr.plainBuf, plaintext...)
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.initialized {
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.plainBuf) <= len(p) && !dr.done {
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if len(dr.plainBuf) > 0 {
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+
+	dr.err = io.EOF
+	return 0, io.EOF
+}
