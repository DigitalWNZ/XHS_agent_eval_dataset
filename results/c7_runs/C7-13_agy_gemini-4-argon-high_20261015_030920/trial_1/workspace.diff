+func TestDecryptReaderErrors(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("secret database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	t.Run("lazy init errors in Read not DecryptReader", func(t *testing.T) {
+		badStream := []byte{0x00, 0x00, 0x01}
+		dr, err := DecryptReader(bytes.NewReader(badStream), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid header")
+	})
+
+	t.Run("unsupported version", func(t *testing.T) {
+		corrupted := bytes.Clone(validBytes)
+		corrupted[2] = 0x02
+		dr, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported version")
+	})
+
+	t.Run("HMAC integrity failure", func(t *testing.T) {
+		corrupted := bytes.Clone(validBytes)
+		corrupted[len(corrupted)-1] ^= 0xFF
+		dr, err := DecryptReader(bytes.NewReader(corrupted), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "integrity")
+	})
+
+	t.Run("wrong key fails", func(t *testing.T) {
+		wrongKey := randomKey(t)
+		dr, err := DecryptReader(bytes.NewReader(validBytes), wrongKey)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("truncated data errors", func(t *testing.T) {
+		cutoffs := []int{0, 1, 2, 3, 5, 10, len(validBytes) - 36, len(validBytes) - 32, len(validBytes) - 1}
+		for _, cutoff := range cutoffs {
+			dr, err := DecryptReader(bytes.NewReader(validBytes[:cutoff]), key)
+			require.NoError(t, err)
+			_, err = io.ReadAll(dr)
+			require.Errorf(t, err, "expected error for cutoff %d", cutoff)
+			assert.NotErrorIs(t, err, io.EOF)
+		}
+	})
+}
