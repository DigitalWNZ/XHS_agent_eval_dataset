+func TestLoadKey(t *testing.T) {
+	rawKey := randomKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	t.Run("env source", func(t *testing.T) {
+		t.Setenv("ONEDUMP_TEST_ENC_KEY", b64Key)
+		loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_ENC_KEY"})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+
+		_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_UNSET_ENC_KEY"})
+		require.Error(t, err)
+	})
+
+	t.Run("file source", func(t *testing.T) {
+		tmpFile := filepath.Join(t.TempDir(), "key.txt")
+		require.NoError(t, os.WriteFile(tmpFile, []byte("  \n"+b64Key+"\n\t "), 0600))
+
+		loaded, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: tmpFile})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+	})
+
+	t.Run("literal source", func(t *testing.T) {
+		loaded, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+
+		shortB64 := base64.StdEncoding.EncodeToString([]byte("short-key"))
+		_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: shortB64})
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	})
+
+	t.Run("derive source", func(t *testing.T) {
+		saltBytes := make([]byte, 16)
+		_, err := io.ReadFull(rand.Reader, saltBytes)
+		require.NoError(t, err)
+		b64Salt := base64.StdEncoding.EncodeToString(saltBytes)
+
+		cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt}
+		k1, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Len(t, k1, 32)
+
+		k2, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, k1, k2)
+
+		// Short salt (< 16 bytes) rejected
+		shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+		_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: shortSalt})
+		require.Error(t, err)
+
+		// Empty passphrase rejected
+		_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt})
+		require.Error(t, err)
+	})
+}
