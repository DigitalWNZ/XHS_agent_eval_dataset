@@ -0,0 +1,333 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func randomKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	for _, size := range []int{0, 1, 16, 24, 31, 33, 64} {
+		key := make([]byte, size)
+		enc, err := NewEncryptor(key)
+		assert.Nil(t, enc)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+
+	validKey := randomKey(t)
+	enc, err := NewEncryptor(validKey)
+	require.NoError(t, err)
+	assert.NotNil(t, enc)
+}
+
+func TestStreamFormatAndRoundTrip(t *testing.T) {
+	key := randomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("SELECT * FROM users WHERE id = 1;")
+	var buf bytes.Buffer
+
+	ew := enc.EncryptWriter(&buf)
+	n, err := ew.Write(plaintext)
+	require.NoError(t, err)
+	assert.Equal(t, len(plaintext), n)
+	require.NoError(t, ew.Close())
+
+	raw := buf.Bytes()
+	// Header: 0x4F 0x44 0x01
+	require.GreaterOrEqual(t, len(raw), 3+4+12+len(plaintext)+16+4+32)
+	assert.Equal(t, byte(0x4F), raw[0])
+	assert.Equal(t, byte(0x44), raw[1])
+	assert.Equal(t, byte(0x01), raw[2])
+
+	// First chunk length
+	chunkLen := binary.BigEndian.Uint32(raw[3:7])
+	assert.Equal(t, uint32(12+len(plaintext)+16), chunkLen)
+
+	// Zero sentinel right after first chunk
+	sentinelOffset := 3 + 4 + int(chunkLen)
+	sentinel := binary.BigEndian.Uint32(raw[sentinelOffset : sentinelOffset+4])
+	assert.Equal(t, uint32(0), sentinel)
+
+	// 32-byte HMAC over bytes between header and sentinel
+	macOffset := sentinelOffset + 4
+	assert.Equal(t, len(raw), macOffset+32)
+	expectedMAC := hmac.New(sha256.New, key)
+	expectedMAC.Write(raw[3:sentinelOffset])
+	assert.Equal(t, expectedMAC.Sum(nil), raw[macOffset:])
+
+	// Round-trip via DecryptReader
+	dr, err := DecryptReader(bytes.NewReader(raw), key)
+	require.NoError(t, err)
+	decrypted, err := io.ReadAll(dr)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, decrypted)
+}
