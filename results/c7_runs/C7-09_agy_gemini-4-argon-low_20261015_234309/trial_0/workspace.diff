+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+
+		action := &envoyroutev3.RouteAction{}
+		applyConsistentHash(out.consistentHash, action)
+
+		// Expect: 2 headers + 2 cookies + 2 queryParams + 2 filterStates + 1 sourceIp = 9
+		require.Len(t, action.HashPolicy, 9)
+
+		// 0: Header X-Custom-Header with regexRewrite
+		h0 := action.HashPolicy[0].GetHeader()
+		require.NotNil(t, h0)
+		assert.Equal(t, "X-Custom-Header", h0.GetHeaderName())
+		assert.False(t, action.HashPolicy[0].GetTerminal())
+		require.NotNil(t, h0.GetRegexRewrite())
+		assert.Equal(t, "^prefix-(.*)$", h0.GetRegexRewrite().GetPattern().GetRegex())
+		assert.Equal(t, "\\1", h0.GetRegexRewrite().GetSubstitution())
+
+		// 1: Header X-Second-Header
+		h1 := action.HashPolicy[1].GetHeader()
+		require.NotNil(t, h1)
+		assert.Equal(t, "X-Second-Header", h1.GetHeaderName())
+		assert.True(t, action.HashPolicy[1].GetTerminal())
+
+		// 2: Cookie session_id (TTL 1h30m = 5400s)
+		c0 := action.HashPolicy[2].GetCookie()
+		require.NotNil(t, c0)
+		assert.Equal(t, "session_id", c0.GetName())
+		assert.Equal(t, "/app", c0.GetPath())
+		assert.Equal(t, durationpb.New(90*time.Minute), c0.GetTtl())
+		assert.True(t, action.HashPolicy[2].GetTerminal())
+		require.Len(t, c0.GetAttributes(), 2)
+		assert.Equal(t, "SameSite", c0.GetAttributes()[0].GetName())
+		assert.Equal(t, "Strict", c0.GetAttributes()[0].GetValue())
+		assert.Equal(t, "Secure", c0.GetAttributes()[1].GetName())
+		assert.Equal(t, "true", c0.GetAttributes()[1].GetValue())
+
+		// 3: Cookie plain_seconds_cookie (TTL "3600" = 3600s)
+		c1 := action.HashPolicy[3].GetCookie()
+		require.NotNil(t, c1)
+		assert.Equal(t, "plain_seconds_cookie", c1.GetName())
+		assert.Equal(t, durationpb.New(3600*time.Second), c1.GetTtl())
+		assert.False(t, action.HashPolicy[3].GetTerminal())
+
+		// 4: QueryParameter user_id
+		q0 := action.HashPolicy[4].GetQueryParameter()
+		require.NotNil(t, q0)
+		assert.Equal(t, "user_id", q0.GetName())
+		assert.True(t, action.HashPolicy[4].GetTerminal())
+
+		// 5: QueryParameter tenant_id
+		q1 := action.HashPolicy[5].GetQueryParameter()
+		require.NotNil(t, q1)
+		assert.Equal(t, "tenant_id", q1.GetName())
+		assert.False(t, action.HashPolicy[5].GetTerminal())
+
+		// 6: FilterState envoy.network.transport_socket.original_dst_address
+		fs0 := action.HashPolicy[6].GetFilterState()
+		require.NotNil(t, fs0)
+		assert.Equal(t, "envoy.network.transport_socket.original_dst_address", fs0.GetKey())
+		assert.True(t, action.HashPolicy[6].GetTerminal())
+
+		// 7: FilterState custom_key
+		fs1 := action.HashPolicy[7].GetFilterState()
+		require.NotNil(t, fs1)
+		assert.Equal(t, "custom_key", fs1.GetKey())
+		assert.False(t, action.HashPolicy[7].GetTerminal())
+
+		// 8: SourceIp
+		sip := action.HashPolicy[8].GetConnectionProperties()
+		require.NotNil(t, sip)
+		assert.True(t, sip.GetSourceIp())
+		assert.True(t, action.HashPolicy[8].GetTerminal())
+	})
+
+	t.Run("invalid cookie TTL returns error", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{
+						Name: "bad_ttl",
+						TTL:  new("not-a-duration"),
+					},
+				},
+			},
+		}, out)
+		require.Error(t, err)
+	})
+
+	t.Run("invalid header regex returns error", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "x-bad",
+						RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+							Pattern: "[unclosed",
+						},
+					},
+				},
+			},
+		}, out)
+		require.Error(t, err)
+	})
+}
