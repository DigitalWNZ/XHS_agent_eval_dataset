+func TestMergeConsistentHashPolicies(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	buildPolicyAtt := func(name string, ch *kgateway.ConsistentHash, hierarchicalPriority int, inheritedPriority apiannotations.InheritedPolicyPriorityValue) ir.PolicyAtt {
+		specIr := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, specIr)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind:               gk,
+			PolicyRef:               &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: name},
+			PolicyIr:                &TrafficPolicy{ct: time.Now(), spec: *specIr},
+			HierarchicalPriority:    hierarchicalPriority,
+			InheritedPolicyPriority: inheritedPriority,
+		}
+	}
+
+	t.Run("union across policies on same route, deduplicated, re-sorted, sourceIp retains higher-priority unset", func(t *testing.T) {
+		// Higher priority policy has headers, queryParameters, no sourceIp
+		pHigh := buildPolicyAtt("p-high", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Req-Id", Terminal: new(true)},
+				{HeaderName: "X-Shared", Terminal: new(false)},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "qp-high", Terminal: new(true)},
+			},
+			// SourceIp is unset (nil)
+		}, 0, "")
+
+		// Lower priority policy has headers (with duplicate x-shared), cookies, filterState, and sourceIp
+		pLow := buildPolicyAtt("p-low", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared", Terminal: new(true)},
+				{HeaderName: "X-Low-Only", Terminal: new(false)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c-low", TTL: new("60s")},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "qp-high", Terminal: new(false)},
+				{Name: "qp-low", Terminal: new(true)},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs-low"},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIp{
+				Terminal: new(true),
+			},
+		}, 0, "")
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		// Check merge metadata records consistentHash with both policies
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/p-high",
+			"gateway.kgateway.dev/TrafficPolicy/default/p-low",
+		}, origins)
+
+		action := &envoyroutev3.RouteAction{}
+		applyConsistentHash(mergedTP.spec.consistentHash, action)
+
+		// Expected canonical order:
+		// Headers: X-Req-Id (high), X-Shared (high, terminal=false), X-Low-Only (low)
+		// Cookies: c-low (low)
+		// QueryParameters: qp-high (high, terminal=true), qp-low (low)
+		// FilterState: fs-low (low)
+		// SourceIp: omitted because high had SourceIp == nil!
+		require.Len(t, action.HashPolicy, 7)
+
+		assert.Equal(t, "X-Req-Id", action.HashPolicy[0].GetHeader().GetHeaderName())
+		assert.True(t, action.HashPolicy[0].GetTerminal())
+
+		assert.Equal(t, "X-Shared", action.HashPolicy[1].GetHeader().GetHeaderName())
+		assert.False(t, action.HashPolicy[1].GetTerminal())
+
+		assert.Equal(t, "X-Low-Only", action.HashPolicy[2].GetHeader().GetHeaderName())
+		assert.False(t, action.HashPolicy[2].GetTerminal())
+
+		assert.Equal(t, "c-low", action.HashPolicy[3].GetCookie().GetName())
+
+		assert.Equal(t, "qp-high", action.HashPolicy[4].GetQueryParameter().GetName())
+		assert.True(t, action.HashPolicy[4].GetTerminal())
+
+		assert.Equal(t, "qp-low", action.HashPolicy[5].GetQueryParameter().GetName())
+		assert.True(t, action.HashPolicy[5].GetTerminal())
+
+		assert.Equal(t, "fs-low", action.HashPolicy[6].GetFilterState().GetKey())
+	})
+
+	t.Run("sourceIp retains higher-priority policy value when set", func(t *testing.T) {
+		pHigh := buildPolicyAtt("p-high", &kgateway.ConsistentHash{
+			SourceIp: &kgateway.ConsistentHashSourceIp{Terminal: new(false)},
+		}, 0, "")
+		pLow := buildPolicyAtt("p-low", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Low"},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIp{Terminal: new(true)},
+		}, 0, "")
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+
+		action := &envoyroutev3.RouteAction{}
+		applyConsistentHash(mergedTP.spec.consistentHash, action)
+
+		// Canonical order: Header X-Low first, then SourceIp (terminal=false from pHigh)
+		require.Len(t, action.HashPolicy, 2)
+		assert.Equal(t, "X-Low", action.HashPolicy[0].GetHeader().GetHeaderName())
+		require.NotNil(t, action.HashPolicy[1].GetConnectionProperties())
+		assert.True(t, action.HashPolicy[1].GetConnectionProperties().GetSourceIp())
+		assert.False(t, action.HashPolicy[1].GetTerminal())
+	})
+
+	t.Run("disable on higher-priority policy suppresses inherited broader-scoped policy", func(t *testing.T) {
+		pChild := buildPolicyAtt("p-child", &kgateway.ConsistentHash{
+			Disable: new(true),
+		}, 0, "")
+		pParent := buildPolicyAtt("p-parent", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Parent"},
+			},
+		}, -1, "")
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pChild, pParent}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/p-child",
+		}, origins)
+
+		action := &envoyroutev3.RouteAction{}
+		applyConsistentHash(mergedTP.spec.consistentHash, action)
+		assert.Nil(t, action.HashPolicy)
+	})
+}
