+func TestConsistentHashCRDValidation(t *testing.T) {
+	v := tests.NewKgatewayValidator(t)
+
+	validateYAML := func(t *testing.T, raw string) error {
+		obj := &unstructured.Unstructured{}
+		require.NoError(t, yaml.Unmarshal([]byte(raw), obj))
+		return v.ValidateCustomResource(obj)
+	}
+
+	t.Run("valid empty consistentHash", func(t *testing.T) {
+		err := validateYAML(t, `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-empty-ch
+spec:
+  consistentHash: {}
+`)
+		assert.NoError(t, err)
+	})
+
+	t.Run("valid disable=true alone", func(t *testing.T) {
+		err := validateYAML(t, `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-ch
+spec:
+  consistentHash:
+    disable: true
+`)
+		assert.NoError(t, err)
+	})
+
+	t.Run("invalid disable=true with headers", func(t *testing.T) {
+		err := validateYAML(t, `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-disable-ch
+spec:
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-foo
+`)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "when disable is true, no other consistentHash fields may be set")
+	})
+
+	t.Run("invalid disable=true with sourceIp", func(t *testing.T) {
+		err := validateYAML(t, `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-disable-sourceip
+spec:
+  consistentHash:
+    disable: true
+    sourceIp: {}
+`)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "when disable is true, no other consistentHash fields may be set")
+	})
+
+	t.Run("valid full consistentHash config", func(t *testing.T) {
+		err := validateYAML(t, `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-full-ch
+spec:
+  consistentHash:
+    headers:
+    - headerName: x-user-id
+      regexRewrite:
+        pattern: "^(.*)-id$"
+        substitution: "\\1"
+      terminal: true
+    cookies:
+    - name: session
+      ttl: "1h30m"
+      path: "/api"
+      attributes:
+      - name: SameSite
+        value: Strict
+      - name: Secure
+        value: "true"
+      terminal: false
+    queryParameters:
+    - name: tenant
+      terminal: true
+    filterState:
+    - key: envoy.network.transport_socket.original_dst_address
+      terminal: false
+    sourceIp:
+      terminal: true
+`)
+		assert.NoError(t, err)
+	})
+}
