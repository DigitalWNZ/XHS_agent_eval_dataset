+func TestConsistentHashIREquals(t *testing.T) {
+	headerPolicy := func(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+		return &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: terminal,
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+					HeaderName: name,
+				},
+			},
+		}
+	}
+
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        PolicySubIR
+		expected bool
+	}{
+		{
+			name:     "both nil",
+			a:        nil,
+			b:        (*consistentHashIR)(nil),
+			expected: true,
+		},
+		{
+			name:     "nil vs non-nil",
+			a:        nil,
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "non-nil vs nil",
+			a:        &consistentHashIR{},
+			b:        (*consistentHashIR)(nil),
+			expected: false,
+		},
+		{
+			name:     "different sub-IR type",
+			a:        &consistentHashIR{},
+			b:        &urlRewriteIR{},
+			expected: false,
+		},
+		{
+			name:     "same empty",
+			a:        &consistentHashIR{},
+			b:        &consistentHashIR{},
+			expected: true,
+		},
+		{
+			name:     "different disable",
+			a:        &consistentHashIR{disable: true},
+			b:        &consistentHashIR{disable: false},
+			expected: false,
+		},
+		{
+			name:     "different hasSourceIp",
+			a:        &consistentHashIR{hasSourceIp: true},
+			b:        &consistentHashIR{hasSourceIp: false},
+			expected: false,
+		},
+		{
+			name:     "same policies",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-foo", true)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-foo", true)}},
+			expected: true,
+		},
+		{
+			name:     "different policies",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-foo", true)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerPolicy("x-bar", true)}},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.a.Equals(tt.b))
+		})
+	}
+}
