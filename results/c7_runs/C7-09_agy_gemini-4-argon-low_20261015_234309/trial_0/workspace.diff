+								HeaderName: "x-test",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^(.*)-suffix$"},
+									Substitution: "\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+			expectError: false,
+		},
+		{
+			name: "invalid header regex",
+			ir: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
