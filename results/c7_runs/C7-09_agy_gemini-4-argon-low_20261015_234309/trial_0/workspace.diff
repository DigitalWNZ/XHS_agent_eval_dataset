+		assert.Nil(t, out.consistentHash)
+	})
+
+	t.Run("empty consistentHash {} defaults at apply time to sourceIp terminal=false", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		assert.False(t, out.consistentHash.disable)
+		assert.False(t, out.consistentHash.hasSourceIp)
+		assert.Empty(t, out.consistentHash.hashPolicies)
+
+		action := &envoyroutev3.RouteAction{}
+		applyConsistentHash(out.consistentHash, action)
+		require.Len(t, action.HashPolicy, 1)
+		assert.False(t, action.HashPolicy[0].Terminal)
+		require.NotNil(t, action.HashPolicy[0].GetConnectionProperties())
+		assert.True(t, action.HashPolicy[0].GetConnectionProperties().GetSourceIp())
+	})
+
+	t.Run("disable true produces no hash policies and suppresses existing", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: new(true),
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		assert.True(t, out.consistentHash.disable)
+
+		action := &envoyroutev3.RouteAction{
+			HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{defaultSourceIpHashPolicy()},
+		}
+		applyConsistentHash(out.consistentHash, action)
+		assert.Nil(t, action.HashPolicy)
+	})
+
+	t.Run("disable true with other fields returns error", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable:  new(true),
+				SourceIp: &kgateway.ConsistentHashSourceIp{},
+			},
+		}, out)
+		require.Error(t, err)
+	})
+
+	t.Run("canonical ordering and deduplication", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "X-Custom-Header",
+						Terminal:   new(false),
+						RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+							Pattern:      "^prefix-(.*)$",
+							Substitution: "\\1",
+						},
+					},
+					{
+						// Duplicate with different casing should be ignored, keeping first casing and settings
+						HeaderName: "x-custom-header",
+						Terminal:   new(true),
+					},
+					{
+						HeaderName: "X-Second-Header",
+						Terminal:   new(true),
+					},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{
+						Name:     "session_id",
+						TTL:      new("1h30m"),
+						Path:     new("/app"),
+						Terminal: new(true),
+						Attributes: []kgateway.ConsistentHashCookieAttribute{
+							{Name: "SameSite", Value: "Strict"},
+							{Name: "Secure", Value: "true"},
+						},
+					},
+					{
+						// Duplicate cookie name should be ignored
+						Name:     "session_id",
+						TTL:      new("60"),
+						Path:     new("/other"),
+						Terminal: new(false),
+					},
+					{
+						Name: "plain_seconds_cookie",
+						TTL:  new("3600"),
+					},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "user_id", Terminal: new(true)},
+					{Name: "user_id", Terminal: new(false)},
+					{Name: "tenant_id"},
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "envoy.network.transport_socket.original_dst_address", Terminal: new(true)},
+					{Key: "envoy.network.transport_socket.original_dst_address", Terminal: new(false)},
+					{Key: "custom_key"},
+				},
+				SourceIp: &kgateway.ConsistentHashSourceIp{
+					Terminal: new(true),
+				},
+			},
