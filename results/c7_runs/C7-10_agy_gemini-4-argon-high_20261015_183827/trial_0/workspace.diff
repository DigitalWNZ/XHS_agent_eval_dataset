+func TestLoadKey(t *testing.T) {
+	rawKey := generateTestKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	t.Run("env", func(t *testing.T) {
+		const envName = "TEST_ONEDUMP_ENC_KEY"
+		t.Setenv(envName, b64Key)
+
+		loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: envName})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+
+		os.Unsetenv(envName)
+		_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: envName})
+		require.Error(t, err)
+	})
+
+	t.Run("file", func(t *testing.T) {
+		tmpDir := t.TempDir()
+		keyFile := filepath.Join(tmpDir, "key.txt")
+		require.NoError(t, os.WriteFile(keyFile, []byte("  \n"+b64Key+"\n\t "), 0600))
+
+		loaded, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: keyFile})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+	})
+
+	t.Run("literal", func(t *testing.T) {
+		loaded, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+		require.NoError(t, err)
+		assert.Equal(t, rawKey, loaded)
+
+		// Wrong decoded key size
+		shortB64 := base64.StdEncoding.EncodeToString([]byte("short-key"))
+		_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: shortB64})
+		require.Error(t, err)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	})
+
+	t.Run("derive", func(t *testing.T) {
+		salt := make([]byte, 16)
+		_, err := rand.Read(salt)
+		require.NoError(t, err)
+		b64Salt := base64.StdEncoding.EncodeToString(salt)
+
+		k1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt})
+		require.NoError(t, err)
+		require.Len(t, k1, 32)
+
+		// Deterministic
+		k2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "correct horse battery staple", Salt: b64Salt})
+		require.NoError(t, err)
+		assert.Equal(t, k1, k2)
+
+		// Different passphrase -> different key
+		k3, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "other passphrase", Salt: b64Salt})
+		require.NoError(t, err)
+		assert.NotEqual(t, k1, k3)
+
+		// Short salt (< 16 bytes) rejected
+		shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+		_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: shortSalt})
+		require.Error(t, err)
+
+		// Empty passphrase rejected
+		_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: b64Salt})
+		require.Error(t, err)
+	})
+}
