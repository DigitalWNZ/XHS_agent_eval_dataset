+func TestNewEncryptorKeyValidation(t *testing.T) {
+	for _, length := range []int{0, 1, 15, 16, 24, 31, 33, 64} {
+		_, err := NewEncryptor(make([]byte, length))
+		require.Error(t, err)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+
+	enc, err := NewEncryptor(make([]byte, 32))
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("hello onedump encryption")},
+		{"exact_64kb", bytes.Repeat([]byte("A"), 64*1024)},
+		{"multi_chunk_200kb", bytes.Repeat([]byte("0123456789abcdef"), (200*1024)/16+3)},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+			n, err := ew.Write(tc.data)
+			require.NoError(t, err)
+			assert.Equal(t, len(tc.data), n)
+			require.NoError(t, ew.Close())
+			// Idempotent Close
+			require.NoError(t, ew.Close())
+
+			dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.data, decrypted)
+		})
+	}
+}
+
+func TestStreamFormatAndUniqueNonces(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// 150KB plaintext -> 3 chunks (64KB, 64KB, 22KB)
+	plaintext := bytes.Repeat([]byte("X"), 150*1024)
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	// Two encryptions of same plaintext must differ
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	// Verify header, chunks, unique nonces, zero sentinel, and trailing HMAC
+	raw := buf1.Bytes()
+	require.True(t, len(raw) > 3+4+32)
+	assert.Equal(t, []byte{0x4F, 0x44, 0x01}, raw[:3])
+
+	offset := 3
+	seenNonces := make(map[string]bool)
+	chunkCount := 0
+	for {
+		require.True(t, offset+4 <= len(raw))
+		chunkLen := binary.BigEndian.Uint32(raw[offset : offset+4])
+		offset += 4
+		if chunkLen == 0 {
+			break
+		}
+		chunkCount++
+		require.True(t, offset+int(chunkLen) <= len(raw))
+		nonce := raw[offset : offset+12]
+		nonceHex := string(nonce)
+		assert.False(t, seenNonces[nonceHex], "duplicate nonce found in chunk %d", chunkCount)
+		seenNonces[nonceHex] = true
+		offset += int(chunkLen)
+	}
+	assert.Equal(t, 3, chunkCount)
+
+	// Remaining 32 bytes must be HMAC-SHA256 over raw[3 : offset-4]
+	require.Equal(t, offset+32, len(raw))
+	expectedMAC := raw[offset : offset+32]
+	mac := hmac.New(sha256.New, key)
+	mac.Write(raw[3 : offset-4])
+	assert.True(t, hmac.Equal(mac.Sum(nil), expectedMAC))
+}
+
+func TestDecryptReaderLazyInitAndErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("secret database dump"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	t.Run("invalid_magic", func(t *testing.T) {
+		bad := append([]byte(nil), validBytes...)
+		bad[0] = 0x00
+		// Lazy init: DecryptReader succeeds, Read fails
+		dr, err := DecryptReader(bytes.NewReader(bad), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+	})
+
+	t.Run("unsupported_version", func(t *testing.T) {
+		bad := append([]byte(nil), validBytes...)
+		bad[2] = 0x02
+		dr, err := DecryptReader(bytes.NewReader(bad), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+	})
+
+	t.Run("hmac_failure", func(t *testing.T) {
+		bad := append([]byte(nil), validBytes...)
+		bad[len(bad)-1] ^= 0xFF
+		dr, err := DecryptReader(bytes.NewReader(bad), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+		assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+	})
+
+	t.Run("wrong_key", func(t *testing.T) {
+		wrongKey := generateTestKey(t)
+		dr, err := DecryptReader(bytes.NewReader(validBytes), wrongKey)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err)
+	})
+
+	t.Run("truncated_data", func(t *testing.T) {
+		for _, cut := range []int{0, 1, 2, 3, 5, 15, len(validBytes) - 36, len(validBytes) - 32, len(validBytes) - 10} {
+			dr, err := DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+			require.NoError(t, err)
+			_, err = io.ReadAll(dr)
+			require.Error(t, err, "expected error for truncated length %d", cut)
+		}
+	})
+}
