+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	assert.NoError(t, (Config{Enabled: false}).Validate())
+	assert.NoError(t, (Config{Enabled: false, KeySource: "invalid", Key: "foo", KeyFile: "bar"}).Validate())
+
+	// Empty / unsupported key source when enabled
+	assert.Error(t, (Config{Enabled: true}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "vault"}).Validate())
+
+	// Case-insensitive valid sources
+	assert.NoError(t, (Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "File", KeyFile: "/path/to/key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "Literal", Key: "base64key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "DeRiVe", Passphrase: "pass", Salt: "salt"}).Validate())
+
+	// Missing required fields for each source
+	assert.Error(t, (Config{Enabled: true, KeySource: "env"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "file"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "literal"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Passphrase: "pass"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Salt: "salt"}).Validate())
+
+	// Mutually exclusive fields
+	err := (Config{Enabled: true, KeySource: "env", KeyEnvVar: "K", KeyFile: "F"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "file", KeyFile: "F", Key: "L"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "literal", Key: "L", Passphrase: "P"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "derive", Passphrase: "P", Salt: "S", KeyEnvVar: "K"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+}
