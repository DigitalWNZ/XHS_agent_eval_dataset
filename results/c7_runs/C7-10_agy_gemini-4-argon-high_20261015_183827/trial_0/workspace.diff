diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..ccf10f8
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,197 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	minSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw struct {
+		Enabled    bool   `yaml:"enabled"`
+		KeySource  string `yaml:"keysource"`
+		KeySourceU string `yaml:"key_source"`
+		KeySourceH string `yaml:"key-source"`
+		KeyEnvVar  string `yaml:"keyenvvar"`
+		KeyEnvVarU string `yaml:"key_env_var"`
+		KeyEnvVarH string `yaml:"key-env-var"`
+		KeyFile    string `yaml:"keyfile"`
+		KeyFileU   string `yaml:"key_file"`
+		KeyFileH   string `yaml:"key-file"`
+		Key        string `yaml:"key"`
+		Passphrase string `yaml:"passphrase"`
+		Salt       string `yaml:"salt"`
+	}
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySourceU, raw.KeySourceH)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVarU, raw.KeyEnvVarH)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFileU, raw.KeyFileH)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+	return nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateSourceAndFields()
+}
+
+func (c Config) validateSourceAndFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasPassphrase := c.Passphrase != ""
+	hasSalt := strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case KeySourceEnv:
+		if hasFile || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key configuration fields are mutually exclusive: env source only allows keyenvvar")
+		}
+		if !hasEnv {
+			return errors.New("encryption keyenvvar is required for env key source")
+		}
+	case KeySourceFile:
+		if hasEnv || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key configuration fields are mutually exclusive: file source only allows keyfile")
+		}
+		if !hasFile {
+			return errors.New("encryption keyfile is required for file key source")
+		}
+	case KeySourceLiteral:
+		if hasEnv || hasFile || hasPassphrase || hasSalt {
+			return errors.New("encryption key configuration fields are mutually exclusive: literal source only allows key")
+		}
+		if !hasLiteral {
+			return errors.New("encryption key is required for literal key source")
+		}
+	case KeySourceDerive:
+		if hasEnv || hasFile || hasLiteral {
+			return errors.New("encryption key configuration fields are mutually exclusive: derive source only allows passphrase and salt")
+		}
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption passphrase is required for derive key source")
+		}
+		if !hasSalt {
+			return errors.New("encryption salt is required for derive key source")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %q", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateSourceAndFields(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envVar := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envVar)
+		}
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(val))
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 encryption key in environment variable %q: %w", envVar, err)
+		}
+		if len(key) != aesKeySize {
+			return nil, fmt.Errorf("%w: expected %d bytes from environment variable %q, got %d", ErrInvalidKey, aesKeySize, envVar, len(key))
+		}
+		return key, nil
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 encryption key in file %q: %w", filePath, err)
+		}
+		if len(key) != aesKeySize {
+			return nil, fmt.Errorf("%w: expected %d bytes from file %q, got %d", ErrInvalidKey, aesKeySize, filePath, len(key))
+		}
+		return key, nil
+
+	case KeySourceLiteral:
+		trimmed := strings.TrimSpace(cfg.Key)
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 literal encryption key: %w", err)
+		}
+		if len(key) != aesKeySize {
+			return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, aesKeySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+		salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 encryption salt: %w", err)
+		}
+		if len(salt) < minSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", minSaltSize, len(salt))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, pbkdf2Iterations, aesKeySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %q", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..61b1349
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,362 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	magicByte1    byte = 0x4F
+	magicByte2    byte = 0x44
+	formatVersion byte = 0x01
+
+	maxChunkSize = 64 * 1024
+	aesKeySize   = 32
+	nonceSize    = 12
+	gcmTagSize   = 16
+	hmacSize     = 32
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid encryption key: must be 32 bytes")
+)
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != aesKeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, aesKeySize, len(key))
+	}
+
+	keyCopy := make([]byte, aesKeySize)
+	copy(keyCopy, key)
+
+	return &Encryptor{key: keyCopy}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		return &encryptWriter{w: w, initErr: err}
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return &encryptWriter{w: w, initErr: err}
+	}
+
+	mac := hmac.New(sha256.New, e.key)
+
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: mac,
+		buf: make([]byte, 0, maxChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	initErr       error
+}
+
+func (ew *encryptWriter) writeHeaderIfNeeded() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := [3]byte{magicByte1, magicByte2, formatVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	sealed := ew.gcm.Seal(nil, nonce, plaintext, nil)
+	chunkLen := uint32(len(nonce) + len(sealed))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	ew.mac.Write(lenBuf[:])
+	ew.mac.Write(nonce)
+	ew.mac.Write(sealed)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(sealed); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.initErr != nil {
+		return 0, ew.initErr
+	}
+	if ew.closed {
+		return 0, errors.New("write to closed encrypt writer")
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	if err := ew.writeHeaderIfNeeded(); err != nil {
+		return 0, err
+	}
+
+	total := len(p)
+	ew.buf = append(ew.buf, p...)
+
+	for len(ew.buf) >= maxChunkSize {
+		if err := ew.writeChunk(ew.buf[:maxChunkSize]); err != nil {
+			return 0, err
+		}
+		ew.buf = ew.buf[maxChunkSize:]
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.initErr != nil {
+		return ew.initErr
+	}
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.writeHeaderIfNeeded(); err != nil {
+		return err
+	}
+
+	for len(ew.buf) > 0 {
+		n := len(ew.buf)
+		if n > maxChunkSize {
+			n = maxChunkSize
+		}
+		if err := ew.writeChunk(ew.buf[:n]); err != nil {
+			return err
+		}
+		ew.buf = ew.buf[n:]
+	}
+
+	var sentinel [4]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		return err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != aesKeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, aesKeySize, len(key))
+	}
+
+	keyCopy := make([]byte, aesKeySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, err
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	mac := hmac.New(sha256.New, keyCopy)
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: mac,
+	}, nil
+}
+
+type decryptReader struct {
+	r               io.Reader
+	gcm             cipher.AEAD
+	mac             hash.Hash
+	headerRead      bool
+	eof             bool
+	err             error
+	plainBuf        []byte
+	pendingChunkLen uint32
+	hasPendingChunk bool
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	if !dr.headerRead {
+		if err := dr.readHeader(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+		dr.headerRead = true
+	}
+
+	for len(dr.plainBuf) == 0 && !dr.eof {
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+	}
+
+	if len(dr.plainBuf) > 0 {
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+
+	return 0, io.EOF
+}
+
+func (dr *decryptReader) readHeader() error {
+	if dr.r == nil {
+		return errors.New("invalid header: nil reader")
+	}
+
+	var header [3]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("invalid header: truncated stream: %w", io.ErrUnexpectedEOF)
+		}
+		return fmt.Errorf("invalid header: %w", err)
+	}
+
+	if header[0] != magicByte1 || header[1] != magicByte2 {
+		return fmt.Errorf("invalid header: unexpected magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+
+	if header[2] != formatVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	return nil
+}
+
+func (dr *decryptReader) verifySentinelHMAC() error {
+	var expectedMAC [hmacSize]byte
+	if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream: incomplete HMAC (integrity check failed): %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	actualMAC := dr.mac.Sum(nil)
+	if !hmac.Equal(actualMAC, expectedMAC[:]) {
+		return errors.New("integrity check failed: HMAC mismatch")
+	}
+
+	dr.eof = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var chunkLen uint32
+	if dr.hasPendingChunk {
+		chunkLen = dr.pendingChunkLen
+		dr.hasPendingChunk = false
+	} else {
+		var lenBuf [4]byte
+		if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return fmt.Errorf("truncated encrypted stream: unexpected EOF reading chunk length (integrity check failed): %w", io.ErrUnexpectedEOF)
+			}
+			return err
+		}
+		chunkLen = binary.BigEndian.Uint32(lenBuf[:])
+		if chunkLen == 0 {
+			return dr.verifySentinelHMAC()
+		}
+		dr.mac.Write(lenBuf[:])
+	}
+
+	const minChunkLen = nonceSize + gcmTagSize
+	const maxAllowedChunkLen = maxChunkSize + nonceSize + gcmTagSize
+	if chunkLen < minChunkLen || chunkLen > maxAllowedChunkLen {
+		return fmt.Errorf("integrity check failed: invalid or truncated chunk length %d", chunkLen)
+	}
+
+	chunkBuf := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkBuf); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream: incomplete chunk data (integrity check failed): %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	dr.mac.Write(chunkBuf)
+
+	nonce := chunkBuf[:nonceSize]
+	ciphertextWithTag := chunkBuf[nonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertextWithTag, nil)
+	if err != nil {
+		return fmt.Errorf("integrity check or key verification failed during chunk decryption: %w", err)
+	}
+
+	// Read next 4-byte length prefix so sentinel + HMAC are verified immediately on the last chunk.
+	var nextLenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, nextLenBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream: missing sentinel after chunk (integrity check failed): %w", io.ErrUnexpectedEOF)
+		}
+		return err
+	}
+
+	nextLen := binary.BigEndian.Uint32(nextLenBuf[:])
+	if nextLen == 0 {
+		if err := dr.verifySentinelHMAC(); err != nil {
+			return err
+		}
+	} else {
+		dr.mac.Write(nextLenBuf[:])
+		dr.pendingChunkLen = nextLen
+		dr.hasPendingChunk = true
+	}
+
+	dr.plainBuf = append(dr.plainBuf, plaintext...)
+	return nil
+}
