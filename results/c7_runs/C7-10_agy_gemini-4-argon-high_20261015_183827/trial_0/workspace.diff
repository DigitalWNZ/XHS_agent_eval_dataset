+		KeyEnvVar: "ONEDUMP_NONEXISTENT_KEY_ENV",
+	}
+	jobWithStorage.Storage.Local = []*local.Local{{Path: "/tmp/should-not-be-created.sql"}}
+
+	res2 := NewJobHandler(jobWithStorage).Do()
+	require.Error(t, res2.Error)
+	errMsg2 := strings.ToLower(res2.Error.Error())
+	assert.True(t, strings.Contains(errMsg2, "encryption") || strings.Contains(errMsg2, "key"))
+}
+
+func TestDoWithEncryptionAndGzip(t *testing.T) {
+	privateKey, err := testutils.GenerateRSAPrivateKey()
+	require.NoError(t, err)
+
+	key := make([]byte, 32)
+	_, err = rand.Read(key)
+	require.NoError(t, err)
+
+	tmpDir := t.TempDir()
+	dumpFile := tmpDir + "/backup.sql"
+	expectedSavedFile := tmpDir + "/backup.sql.gz.enc"
+
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+
+	sshJob := config.NewJob(
+		"ssh-enc",
+		"mysqldump",
+		testDBDsn,
+		config.WithSshHost(listener.Addr().String()),
+		config.WithSshUser("root"),
+		config.WithSshKey(privateKey),
+		config.WithGzip(true),
+		config.WithEncryption(encryption.Config{
+			Enabled:   true,
+			KeySource: "env",
+			KeyEnvVar: "TEST_JOB_HANDLER_ENC_KEY",
+		}),
+	)
+	t.Setenv("TEST_JOB_HANDLER_ENC_KEY", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
+	encKey, err := encryption.LoadKey(sshJob.Encryption)
+	require.NoError(t, err)
+
+	sshJob.Storage.Local = []*local.Local{{Path: dumpFile}}
+
+	sshConfig := &ssh.ServerConfig{
+		PublicKeyCallback: func(c ssh.ConnMetadata, pubKey ssh.PublicKey) (*ssh.Permissions, error) {
+			return &ssh.Permissions{}, nil
+		},
+	}
+	private, err := ssh.ParsePrivateKey([]byte(privateKey))
+	require.NoError(t, err)
+	sshConfig.AddHostKey(private)
+
+	finishCh := make(chan * config.Job, 1)
+	var jobErr error
+	go func() {
+		res := NewJobHandler(sshJob).Do()
+		jobErr = res.Error
+		finishCh <- sshJob
+	}()
+
+	nConn, err := listener.Accept()
+	require.NoError(t, err)
+	_, chans, reqs, err := ssh.NewServerConn(nConn, sshConfig)
+	require.NoError(t, err)
+	go ssh.DiscardRequests(reqs)
+
+	newChannel := <-chans
+	channel, requests, err := newChannel.Accept()
+	require.NoError(t, err)
+	req := <-requests
+	req.Reply(true, nil)
+
+	expectedPayload := "CREATE TABLE test (id INT);\nINSERT INTO test VALUES (1);\n"
+	_, err = channel.Write([]byte(expectedPayload))
+	require.NoError(t, err)
+	_, err = channel.SendRequest("exit-status", false, []byte{0, 0, 0, 0})
+	require.NoError(t, err)
+	require.NoError(t, channel.Close())
+
+	<-finishCh
+	require.NoError(t, jobErr)
+
+	encryptedData, err := os.ReadFile(expectedSavedFile)
+	require.NoError(t, err)
+
+	decReader, err := encryption.DecryptReader(bytes.NewReader(encryptedData), encKey)
+	require.NoError(t, err)
+	gzReader, err := gzip.NewReader(decReader)
+	require.NoError(t, err)
+	defer gzReader.Close()
+
+	decompressed, err := io.ReadAll(gzReader)
+	require.NoError(t, err)
+	assert.Equal(t, expectedPayload, string(decompressed))
 }
 
