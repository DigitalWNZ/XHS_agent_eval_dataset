+func TestStorageReadWriteCloserEncrypted(t *testing.T) {
+	assert := assert.New(t)
+
+	key := make([]byte, encryption.KeySize)
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.NoError(err)
+
+	original := bytes.Repeat([]byte("onedump encrypted pipeline\n"), 10000)
+
+	readers, writer, closer := storageReadWriteCloser(2, true, encryptor)
+
+	go func() {
+		_, err := writer.Write(original)
+		assert.NoError(err)
+		assert.NoError(closer.Close())
+	}()
+
+	var wg sync.WaitGroup
+	results := make([][]byte, len(readers))
+	for i, r := range readers {
+		wg.Add(1)
+		go func(i int, r io.Reader) {
+			defer wg.Done()
+			data, err := io.ReadAll(r)
+			assert.NoError(err)
+			results[i] = data
+		}(i, r)
+	}
+	wg.Wait()
+
+	for _, data := range results {
+		dr, err := encryption.DecryptReader(bytes.NewReader(data), key)
+		assert.NoError(err)
+		gr, err := gzip.NewReader(dr)
+		assert.NoError(err)
+		plain, err := io.ReadAll(gr)
+		assert.NoError(err)
+		assert.Equal(original, plain)
+	}
