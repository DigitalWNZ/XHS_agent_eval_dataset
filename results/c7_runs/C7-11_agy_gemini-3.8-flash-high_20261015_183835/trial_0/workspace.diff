+
+	plineEmpty := &Polyline{}
+	id1 := index.Add(plineEmpty)
+
+	polyEmpty := makePolygon("", true)
+	id2 := index.Add(polyEmpty)
+
+	loopEmpty := EmptyLoop()
+	id3 := index.Add(loopEmpty)
+
+	laxPlineEmpty := LaxPolylineFromPoints(nil)
+	id4 := index.Add(laxPlineEmpty)
+
+	laxPolyEmpty := LaxPolygonFromPoints(nil)
+	id5 := index.Add(laxPolyEmpty)
+
+	laxLoopEmpty := LaxLoopFromPoints(nil)
+	id6 := index.Add(laxLoopEmpty)
+
+	// Full shapes (0 edges, 1 chain, full sphere)
+	polyFull := makePolygon("full", true)
+	id7 := index.Add(polyFull)
+
+	loopFull := FullLoop()
+	id8 := index.Add(loopFull)
+
+	laxPolyFull := LaxPolygonFromPoints([][]Point{{}})
+	id9 := index.Add(laxPolyFull)
+
+	// Mixed chain counts
+	pv5 := &PointVector{
+		PointFromLatLng(LatLngFromDegrees(1, 1)),
+		PointFromLatLng(LatLngFromDegrees(2, 2)),
+		PointFromLatLng(LatLngFromDegrees(3, 3)),
+		PointFromLatLng(LatLngFromDegrees(4, 4)),
+		PointFromLatLng(LatLngFromDegrees(5, 5)),
+	}
+	id10 := index.Add(pv5)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	indexesEqual(t, index, decoded)
+
+	// Check zero-edge properties
+	for _, id := range []int32{id0, id1, id2, id3, id4, id5, id6} {
+		sh := decoded.Shape(id)
+		if sh.NumEdges() != 0 {
+			t.Fatalf("shape %d NumEdges() = %d, want 0", id, sh.NumEdges())
+		}
+		if !sh.IsEmpty() {
+			t.Fatalf("shape %d IsEmpty() should be true", id)
+		}
+	}
+
+	// Check full shapes properties
+	for _, id := range []int32{id7, id8, id9} {
+		sh := decoded.Shape(id)
+		if sh.NumEdges() != 0 {
+			t.Fatalf("full shape %d NumEdges() = %d, want 0", id, sh.NumEdges())
+		}
+		if sh.NumChains() != 1 {
+			t.Fatalf("full shape %d NumChains() = %d, want 1", id, sh.NumChains())
+		}
+		if !sh.IsFull() {
+			t.Fatalf("full shape %d IsFull() should be true", id)
+		}
+	}
+
+	// Check mixed chains shape
+	sh10 := decoded.Shape(id10)
+	if sh10.NumEdges() != 5 {
+		t.Fatalf("PointVector NumEdges = %d, want 5", sh10.NumEdges())
+	}
+	if sh10.NumChains() != 5 {
+		t.Fatalf("PointVector NumChains = %d, want 5", sh10.NumChains())
+	}
+	for c := 0; c < 5; c++ {
+		ch := sh10.Chain(c)
+		if ch.Start != c || ch.Length != 1 {
+			t.Fatalf("Chain(%d) = %v, want Start=%d, Length=1", c, ch, c)
+		}
+	}
+}
