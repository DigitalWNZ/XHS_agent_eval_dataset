+func TestShapeIndexCorruptedBytesDetailed(t *testing.T) {
+	// Build a valid 1-polyline index
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 10:10, 20:20"))
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	t.Run("invalid cell ID", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		// Look for the cell ID in validBytes.
+		// Header: 1 (version) + 4 (maxEdges) + 4 (nextID) + 4 (numShapes)
+		// Shape 0: 4 (shapeID) + 4 (typeTag) + Polyline(1 + 4 + 3*24) = 8 + 77 = 85 bytes
+		// Total before cells: 13 + 85 = 98 bytes
+		// numCells at offset 98: 4 bytes
+		// cell 0 ID at offset 102: 8 bytes
+		// Put an invalid cell ID (e.g. 0) at cell 0
+		binary.LittleEndian.PutUint64(corrupted[102:110], 0)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatal("expected error on invalid cell ID, got nil")
+		}
+	})
+
+	t.Run("cell shape references non-existent shape ID", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		// After cell 0 ID (102..110), numClipped is at 110..114 (uint32).
+		// First clipped shape's shapeID is at 114..118 (int32).
+		// Put a non-existent shapeID, e.g. 99
+		binary.LittleEndian.PutUint32(corrupted[114:118], 99)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatal("expected error on non-existent shape ID in cell, got nil")
+		}
+	})
+
+	t.Run("clipped shape edge ID out of bounds", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		// At 114..118 is shapeID (0).
+		// At 118 is containsCenter (1 byte bool).
+		// At 119..123 is numEdges (uint32).
+		// At 123..127 is first edgeID (int32).
+		// Total edges in polyline is 2 (edge 0 and edge 1).
+		// Put edgeID = 50.
+		binary.LittleEndian.PutUint32(corrupted[123:127], 50)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatal("expected error on out of bounds edge ID in clipped shape, got nil")
+		}
+	})
+
+	t.Run("containsCenter on polyline", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		// Set containsCenter byte at 118 to 1 (true)
+		corrupted[118] = 1
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatal("expected error when polyline has containsCenter=true, got nil")
+		}
+	})
+
+	t.Run("corrupted boolean byte (not 0 or 1)", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		corrupted[118] = 42
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatal("expected error on corrupted boolean byte, got nil")
+		}
+	})
+}
