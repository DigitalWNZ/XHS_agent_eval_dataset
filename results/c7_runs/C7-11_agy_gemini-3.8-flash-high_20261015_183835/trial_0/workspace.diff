+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatal("encoded byte stream must be non-empty for empty index")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 0 {
+		t.Fatalf("decoded.Len() = %d, want 0", decoded.Len())
+	}
+	if !decoded.IsFresh() {
+		t.Fatal("decoded index should be fresh without Build")
+	}
+	if len(decoded.cells) != 0 {
+		t.Fatalf("len(decoded.cells) = %d, want 0", len(decoded.cells))
+	}
+
+	it := decoded.Iterator()
+	if !it.Done() {
+		t.Fatal("iterator on empty index should be Done")
+	}
+}
