+// loops returns the loops of vertices that define this LaxPolygon.
+func (p *LaxPolygon) loops() [][]Point {
+	if p.numLoops == 0 {
+		return nil
+	}
+	if p.numLoops == 1 {
+		res := make([]Point, p.numVerts)
+		copy(res, p.vertices[:p.numVerts])
+		return [][]Point{res}
+	}
+	res := make([][]Point, p.numLoops)
+	for i := 0; i < p.numLoops; i++ {
+		start := p.cumulativeVertices[i]
+		end := p.cumulativeVertices[i+1]
+		loop := make([]Point, end-start)
+		copy(loop, p.vertices[start:end])
+		res[i] = loop
+	}
+	return res
+}
+
+// Encode encodes the LaxPolygon.
+func (p *LaxPolygon) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	p.encode(e)
+	return e.err
+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	loops := p.loops()
+	e.writeUint32(uint32(len(loops)))
+	for _, loop := range loops {
+		e.writeUint32(uint32(len(loop)))
+		for _, pt := range loop {
+			e.writeFloat64(pt.X)
+			e.writeFloat64(pt.Y)
+			e.writeFloat64(pt.Z)
+		}
+	}
+}
+
+// Decode decodes the LaxPolygon.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: cannot decode LaxPolygon version %d", version)
+		return
+	}
+	nloops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("s2: too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	loops := make([][]Point, 0, min(int(nloops), 1024))
+	for i := uint32(0); i < nloops; i++ {
+		nverts := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if nverts > maxEncodedVertices {
+			d.err = fmt.Errorf("s2: too many vertices in loop (%d; max is %d)", nverts, maxEncodedVertices)
+			return
+		}
+		loop := make([]Point, 0, min(int(nverts), 1024))
+		for j := uint32(0); j < nverts; j++ {
+			pt := d.readPoint()
+			if d.err != nil {
+				return
+			}
+			loop = append(loop, pt)
+		}
+		loops = append(loops, loop)
+	}
+	*p = *LaxPolygonFromPoints(loops)
+}
