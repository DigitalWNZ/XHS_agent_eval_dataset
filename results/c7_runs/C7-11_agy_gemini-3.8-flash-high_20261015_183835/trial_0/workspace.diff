+func TestShapeIndexAllBuiltinShapeTypesRoundTrip(t *testing.T) {
+	index := NewShapeIndex()
+
+	// 1. Polygon
+	poly := makePolygon("10:10, 10:20, 20:20, 20:10; 12:12, 18:12, 18:18, 12:18", true)
+	idPoly := index.Add(poly)
+
+	// 2. Polyline
+	pline := makePolyline("0:0, 0:1, 1:1, 1:2")
+	idPline := index.Add(pline)
+
+	// 3. PointVector
+	pv := &PointVector{
+		PointFromLatLng(LatLngFromDegrees(5, 5)),
+		PointFromLatLng(LatLngFromDegrees(6, 6)),
+		PointFromLatLng(LatLngFromDegrees(7, 7)),
+	}
+	idPV := index.Add(pv)
+
+	// 4. LaxPolyline
+	lpPoints := []Point{
+		PointFromLatLng(LatLngFromDegrees(20, 20)),
+		PointFromLatLng(LatLngFromDegrees(21, 21)),
+		PointFromLatLng(LatLngFromDegrees(22, 22)),
+	}
+	laxPline := LaxPolylineFromPoints(lpPoints)
+	idLaxPline := index.Add(laxPline)
+
+	// 5. LaxPolygon
+	laxPolyLoops := [][]Point{
+		{
+			PointFromLatLng(LatLngFromDegrees(30, 30)),
+			PointFromLatLng(LatLngFromDegrees(30, 40)),
+			PointFromLatLng(LatLngFromDegrees(40, 40)),
+			PointFromLatLng(LatLngFromDegrees(40, 30)),
+		},
+		{
+			PointFromLatLng(LatLngFromDegrees(32, 32)),
+			PointFromLatLng(LatLngFromDegrees(38, 32)),
+			PointFromLatLng(LatLngFromDegrees(38, 38)),
+			PointFromLatLng(LatLngFromDegrees(32, 38)),
+		},
+	}
+	laxPoly := LaxPolygonFromPoints(laxPolyLoops)
+	idLaxPoly := index.Add(laxPoly)
+
+	// 6. Loop
+	loop := makeLoop("50:50, 50:60, 60:60, 60:50")
+	idLoop := index.Add(loop)
+
+	// 7. LaxLoop
+	laxLoopPoints := []Point{
+		PointFromLatLng(LatLngFromDegrees(70, 70)),
+		PointFromLatLng(LatLngFromDegrees(70, 80)),
+		PointFromLatLng(LatLngFromDegrees(80, 80)),
+		PointFromLatLng(LatLngFromDegrees(80, 70)),
+	}
+	laxLoop := LaxLoopFromPoints(laxLoopPoints)
+	idLaxLoop := index.Add(laxLoop)
+
+	// Explicit Build before encode
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	// Verify exact structure match
+	indexesEqual(t, index, decoded)
+
+	// Verify shape IDs match and shapes can be retrieved
+	if _, ok := decoded.Shape(idPoly).(*Polygon); !ok {
+		t.Fatalf("shape at %d is not *Polygon", idPoly)
+	}
+	if _, ok := decoded.Shape(idPline).(*Polyline); !ok {
+		t.Fatalf("shape at %d is not *Polyline", idPline)
+	}
+	if _, ok := decoded.Shape(idPV).(*PointVector); !ok {
+		t.Fatalf("shape at %d is not *PointVector", idPV)
+	}
+	if _, ok := decoded.Shape(idLaxPline).(*LaxPolyline); !ok {
+		t.Fatalf("shape at %d is not *LaxPolyline", idLaxPline)
+	}
+	if _, ok := decoded.Shape(idLaxPoly).(*LaxPolygon); !ok {
+		t.Fatalf("shape at %d is not *LaxPolygon", idLaxPoly)
+	}
+	if _, ok := decoded.Shape(idLoop).(*Loop); !ok {
+		t.Fatalf("shape at %d is not *Loop", idLoop)
+	}
+	if _, ok := decoded.Shape(idLaxLoop).(*LaxLoop); !ok {
+		t.Fatalf("shape at %d is not *LaxLoop", idLaxLoop)
+	}
+}
