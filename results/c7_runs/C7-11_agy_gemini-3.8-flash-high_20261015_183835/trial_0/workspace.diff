+// Helper to compare two shapes for equality of edges and chains.
+func shapesEqual(a, b Shape) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	if reflect.TypeOf(a) != reflect.TypeOf(b) {
+		return false
+	}
+	if a.NumEdges() != b.NumEdges() {
+		return false
+	}
+	if a.NumChains() != b.NumChains() {
+		return false
+	}
+	if a.Dimension() != b.Dimension() {
+		return false
+	}
+	if a.IsEmpty() != b.IsEmpty() {
+		return false
+	}
+	if a.IsFull() != b.IsFull() {
+		return false
+	}
+	for i := 0; i < a.NumEdges(); i++ {
+		ea := a.Edge(i)
+		eb := b.Edge(i)
+		if ea != eb {
+			return false
+		}
+	}
+	for i := 0; i < a.NumChains(); i++ {
+		ca := a.Chain(i)
+		cb := b.Chain(i)
+		if ca != cb {
+			return false
+		}
+	}
+	return true
+}
+
+func indexesEqual(t *testing.T, a, b *ShapeIndex) {
+	t.Helper()
+	if a.Len() != b.Len() {
+		t.Fatalf("index len mismatch: %d vs %d", a.Len(), b.Len())
+	}
+	if a.NumEdges() != b.NumEdges() {
+		t.Fatalf("index numEdges mismatch: %d vs %d", a.NumEdges(), b.NumEdges())
+	}
+	if a.nextID != b.nextID {
+		t.Fatalf("index nextID mismatch: %d vs %d", a.nextID, b.nextID)
+	}
+
+	for id, shapeA := range a.shapes {
+		shapeB := b.Shape(id)
+		if shapeB == nil {
+			t.Fatalf("shape ID %d missing from decoded index", id)
+		}
+		if !shapesEqual(shapeA, shapeB) {
+			t.Fatalf("shape ID %d mismatch: got %#v, want %#v", id, shapeB, shapeA)
+		}
+	}
+
+	if len(a.cells) != len(b.cells) {
+		t.Fatalf("index cell count mismatch: %d vs %d", len(a.cells), len(b.cells))
+	}
+	for i, cellID := range a.cells {
+		if b.cells[i] != cellID {
+			t.Fatalf("cell[%d] mismatch: got %v, want %v", i, b.cells[i], cellID)
+		}
+		cellA := a.cellMap[cellID]
+		cellB := b.cellMap[cellID]
+		if len(cellA.shapes) != len(cellB.shapes) {
+			t.Fatalf("cell %v clipped shapes count mismatch: %d vs %d", cellID, len(cellB.shapes), len(cellA.shapes))
+		}
+		for j, csA := range cellA.shapes {
+			csB := cellB.shapes[j]
+			if csA.shapeID != csB.shapeID {
+				t.Fatalf("cell %v cs[%d] shapeID mismatch: got %d, want %d", cellID, j, csB.shapeID, csA.shapeID)
+			}
+			if csA.containsCenter != csB.containsCenter {
+				t.Fatalf("cell %v cs[%d] containsCenter mismatch: got %v, want %v", cellID, j, csB.containsCenter, csA.containsCenter)
+			}
+			if len(csA.edges) != len(csB.edges) {
+				t.Fatalf("cell %v cs[%d] edges count mismatch: %d vs %d", cellID, j, len(csB.edges), len(csA.edges))
+			}
+			for k, edgeA := range csA.edges {
+				if csB.edges[k] != edgeA {
+					t.Fatalf("cell %v cs[%d] edge[%d] mismatch: got %d, want %d", cellID, j, k, csB.edges[k], edgeA)
+				}
+			}
+		}
+	}
+}
