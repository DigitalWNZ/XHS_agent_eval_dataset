+func TestShapeIndexSpatialQueriesWithoutBuild(t *testing.T) {
+	index := NewShapeIndex()
+	poly := makePolygon("0:0, 0:20, 20:20, 20:0", true)
+	index.Add(poly)
+	pline := makePolyline("-5:-5, 25:25")
+	index.Add(pline)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Fatal("decoded index must be fresh")
+	}
+
+	// Test CrossingEdgeQuery without calling Build()
+	qOrig := NewCrossingEdgeQuery(index)
+	qDec := NewCrossingEdgeQuery(decoded)
+
+	a := PointFromLatLng(LatLngFromDegrees(5, -5))
+	b := PointFromLatLng(LatLngFromDegrees(5, 25))
+
+	origCrossings := qOrig.Crossings(a, b, index.Shape(0), CrossingTypeAll)
+	decCrossings := qDec.Crossings(a, b, decoded.Shape(0), CrossingTypeAll)
+
+	if !reflect.DeepEqual(origCrossings, decCrossings) {
+		t.Fatalf("Crossings mismatch: orig=%v, dec=%v", origCrossings, decCrossings)
+	}
+	if len(decCrossings) == 0 {
+		t.Fatal("expected crossings, got none")
+	}
+
+	// Test ContainsPointQuery without calling Build()
+	cqOrig := NewContainsPointQuery(index, VertexModelSemiOpen)
+	cqDec := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+
+	ptInside := PointFromLatLng(LatLngFromDegrees(10, 10))
+	ptOutside := PointFromLatLng(LatLngFromDegrees(30, 30))
+
+	if cqOrig.Contains(ptInside) != cqDec.Contains(ptInside) {
+		t.Fatalf("Contains(ptInside) mismatch: %v vs %v", cqOrig.Contains(ptInside), cqDec.Contains(ptInside))
+	}
+	if !cqDec.Contains(ptInside) {
+		t.Fatal("expected ptInside to be contained")
+	}
+
+	if cqOrig.Contains(ptOutside) != cqDec.Contains(ptOutside) {
+		t.Fatalf("Contains(ptOutside) mismatch: %v vs %v", cqOrig.Contains(ptOutside), cqDec.Contains(ptOutside))
+	}
+	if cqDec.Contains(ptOutside) {
+		t.Fatal("expected ptOutside to not be contained")
+	}
+}
