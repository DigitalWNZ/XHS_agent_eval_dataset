+			}
+		}
+	}
+}
+
+func encodeShape(e *encoder, s Shape) error {
+	switch sh := s.(type) {
+	case *Polygon:
+		sh.encode(e)
+	case *Polyline:
+		sh.encode(e)
+	case *PointVector:
+		sh.encode(e)
+	case *LaxPolyline:
+		sh.encode(e)
+	case *LaxPolygon:
+		sh.encode(e)
+	case *Loop:
+		sh.encode(e)
+	case *LaxLoop:
+		sh.encode(e)
+	default:
+		return fmt.Errorf("s2: unsupported shape type %T", s)
+	}
+	return e.err
+}
+
+// Decode decodes a ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) (err error) {
+	if r == nil {
+		return fmt.Errorf("s2: nil reader")
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	defer func() {
+		if rec := recover(); rec != nil {
+			s.Reset()
+			err = fmt.Errorf("s2: panic while decoding ShapeIndex: %v", rec)
+		}
+	}()
+
+	s.Reset()
+
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	if d.err != nil {
+		s.Reset()
+		return d.err
+	}
+	return nil
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != shapeIndexEncodingVersion {
+		d.err = fmt.Errorf("s2: unsupported ShapeIndex version %d", version)
+		return
+	}
+
+	maxEdges := d.readInt32()
+	if d.err != nil {
+		return
+	}
+	if maxEdges <= 0 || maxEdges > 1000000 {
+		d.err = fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdges)
+		return
+	}
+	s.maxEdgesPerCell = int(maxEdges)
+
+	nextID := d.readInt32()
+	if d.err != nil {
+		return
+	}
+	if nextID < 0 || nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("s2: invalid nextID %d", nextID)
+		return
+	}
+
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxEncodedShapes {
+		d.err = fmt.Errorf("s2: too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+		return
+	}
+	if int32(numShapes) > nextID {
+		d.err = fmt.Errorf("s2: numShapes (%d) exceeds nextID (%d)", numShapes, nextID)
+		return
+	}
+
+	var maxShapeID int32 = -1
+	for i := uint32(0); i < numShapes; i++ {
+		shapeID := d.readInt32()
+		if d.err != nil {
+			return
+		}
+		if shapeID < 0 || shapeID >= nextID {
+			d.err = fmt.Errorf("s2: invalid shape ID %d (nextID is %d)", shapeID, nextID)
+			return
+		}
+		if s.shapes[shapeID] != nil {
+			d.err = fmt.Errorf("s2: duplicate shape ID %d", shapeID)
+			return
+		}
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return
+		}
+		shape, err := decodeShape(d, tag)
+		if err != nil {
+			d.err = err
+			return
+		}
+		if shape == nil {
+			d.err = fmt.Errorf("s2: decoded nil shape for ID %d", shapeID)
+			return
+		}
+		s.shapes[shapeID] = shape
+		if shapeID > maxShapeID {
+			maxShapeID = shapeID
+		}
+	}
+
+	if nextID < maxShapeID+1 {
+		nextID = maxShapeID + 1
+	}
+	s.nextID = nextID
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("s2: too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	s.cells = make([]CellID, 0, min(int(numCells), 1024))
+	for i := uint32(0); i < numCells; i++ {
+		cellIDRaw := d.readUint64()
+		if d.err != nil {
+			return
+		}
+		cellID := CellID(cellIDRaw)
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("s2: invalid cell ID %v", cellID)
+			return
+		}
+		if len(s.cells) > 0 && cellID <= s.cells[len(s.cells)-1] {
+			d.err = fmt.Errorf("s2: cells out of order: %v <= %v", cellID, s.cells[len(s.cells)-1])
+			return
+		}
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapes {
+			d.err = fmt.Errorf("s2: too many clipped shapes in cell (%d; max is %d)", numClipped, maxEncodedClippedShapes)
+			return
+		}
+		if numClipped > numShapes {
+			d.err = fmt.Errorf("s2: cell contains %d clipped shapes, but index only has %d shapes", numClipped, numShapes)
+			return
+		}
+
+		cell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, min(int(numClipped), 64)),
+		}
+
+		for j := uint32(0); j < numClipped; j++ {
+			shID := d.readInt32()
+			if d.err != nil {
+				return
+			}
+			shape, ok := s.shapes[shID]
+			if !ok {
+				d.err = fmt.Errorf("s2: clipped shape references non-existent shape ID %d", shID)
+				return
+			}
+			if len(cell.shapes) > 0 && shID <= cell.shapes[len(cell.shapes)-1].shapeID {
+				d.err = fmt.Errorf("s2: clipped shapes in cell out of order: %d <= %d", shID, cell.shapes[len(cell.shapes)-1].shapeID)
+				return
+			}
+
+			containsCenter := d.readBool()
+			if d.err != nil {
+				return
+			}
+			if shape.Dimension() != 2 && containsCenter {
+				d.err = fmt.Errorf("s2: shape ID %d with dimension %d cannot contain cell center", shID, shape.Dimension())
+				return
+			}
+
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			if numEdges > maxEncodedEdgesPerClippedShape {
+				d.err = fmt.Errorf("s2: too many edges in clipped shape (%d; max is %d)", numEdges, maxEncodedEdgesPerClippedShape)
+				return
+			}
+			if int(numEdges) > shape.NumEdges() {
+				d.err = fmt.Errorf("s2: clipped shape has %d edges, but shape ID %d has only %d edges", numEdges, shID, shape.NumEdges())
+				return
+			}
+
+			cs := &clippedShape{
+				shapeID:        shID,
+				containsCenter: containsCenter,
+				edges:          make([]int, 0, min(int(numEdges), 64)),
+			}
+
+			for k := uint32(0); k < numEdges; k++ {
+				edgeID := d.readInt32()
+				if d.err != nil {
+					return
+				}
+				if edgeID < 0 || int(edgeID) >= shape.NumEdges() {
+					d.err = fmt.Errorf("s2: invalid edge ID %d in clipped shape (shape ID %d has %d edges)", edgeID, shID, shape.NumEdges())
+					return
+				}
+				if len(cs.edges) > 0 && int(edgeID) <= cs.edges[len(cs.edges)-1] {
+					d.err = fmt.Errorf("s2: edge IDs in clipped shape out of order: %d <= %d", edgeID, cs.edges[len(cs.edges)-1])
+					return
+				}
+				cs.edges = append(cs.edges, int(edgeID))
+			}
+			cell.shapes = append(cell.shapes, cs)
+		}
+
+		s.cellMap[cellID] = cell
+		s.cells = append(s.cells, cellID)
+	}
+
+	atomic.StoreInt32(&s.status, fresh)
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+}
+
+func decodeShape(d *decoder, tag typeTag) (Shape, error) {
+	switch tag {
+	case typeTagPolygon:
+		p := new(Polygon)
+		version := int8(d.readUint8())
+		if d.err != nil {
+			return nil, d.err
+		}
+		switch version {
+		case encodingVersion:
+			p.decode(d)
+		case encodingCompressedVersion:
+			p.decodeCompressed(d)
+		default:
+			return nil, fmt.Errorf("s2: unsupported Polygon version %d", version)
+		}
+		if d.err != nil {
+			return nil, d.err
+		}
+		return p, nil
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		if d.err != nil {
+			return nil, d.err
+		}
+		return p, nil
+	case typeTagPointVector:
+		pv := new(PointVector)
+		pv.decode(d)
+		if d.err != nil {
+			return nil, d.err
+		}
+		return pv, nil
+	case typeTagLaxPolyline:
+		lp := new(LaxPolyline)
+		lp.decode(d)
+		if d.err != nil {
+			return nil, d.err
+		}
+		return lp, nil
+	case typeTagLaxPolygon:
+		lp := new(LaxPolygon)
+		lp.decode(d)
+		if d.err != nil {
+			return nil, d.err
+		}
+		return lp, nil
+	case typeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		if d.err != nil {
+			return nil, d.err
+		}
+		return l, nil
+	case typeTagLaxLoop:
+		ll := new(LaxLoop)
+		ll.decode(d)
+		if d.err != nil {
+			return nil, d.err
+		}
+		return ll, nil
+	default:
+		return nil, fmt.Errorf("s2: unsupported shape type tag %d", tag)
+	}
+}
