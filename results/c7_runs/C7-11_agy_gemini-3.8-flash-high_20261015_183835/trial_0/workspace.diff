+func TestShapeIndexDecodeMalformedInput(t *testing.T) {
+	// 1. Truncated data: various lengths
+	validIndex := NewShapeIndex()
+	validIndex.Add(makePolyline("0:0, 1:1, 2:2"))
+	validIndex.Add(makePolygon("10:10, 10:20, 20:20, 20:10", true))
+	validIndex.Build()
+
+	var buf bytes.Buffer
+	if err := validIndex.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// Empty bytes
+	idx := NewShapeIndex()
+	if err := idx.Decode(bytes.NewReader(nil)); err == nil {
+		t.Fatal("Decode(nil) should return error")
+	}
+	if err := idx.Decode(nil); err == nil {
+		t.Fatal("Decode with nil reader should return error")
+	}
+
+	// Truncate at every possible length
+	for length := 1; length < len(validBytes); length++ {
+		truncated := validBytes[:length]
+		idx = NewShapeIndex()
+		err := idx.Decode(bytes.NewReader(truncated))
+		if err == nil {
+			t.Fatalf("expected error on truncated data at length %d/%d, got nil", length, len(validBytes))
+		}
+	}
+
+	// 2. Corrupted version
+	corrupted := append([]byte(nil), validBytes...)
+	corrupted[0] = 99 // version 99
+	idx = NewShapeIndex()
+	if err := idx.Decode(bytes.NewReader(corrupted)); err == nil {
+		t.Fatal("expected error on corrupted version, got nil")
+	}
+
+	// 3. Corrupted shape type tag
+	// Build an index with 1 polyline, modify its tag
+	var pBuf bytes.Buffer
+	pIndex := NewShapeIndex()
+	pIndex.Add(makePolyline("0:0, 1:1"))
+	pIndex.Build()
+	if err := pIndex.Encode(&pBuf); err != nil {
+		t.Fatal(err)
+	}
+	pBytes := pBuf.Bytes()
+	// Header: 1 (version) + 4 (maxEdges) + 4 (nextID) + 4 (numShapes) = 13 bytes
+	// Then: 4 (shapeID) + 4 (typeTag)
+	corruptedTag := append([]byte(nil), pBytes...)
+	// offset 17..20 is typeTag
+	binary.LittleEndian.PutUint32(corruptedTag[17:21], 9999)
+	idx = NewShapeIndex()
+	if err := idx.Decode(bytes.NewReader(corruptedTag)); err == nil {
+		t.Fatal("expected error on corrupted shape type tag, got nil")
+	}
+
+	// 4. Oversized allocation requests
+	tests := []struct {
+		name string
+		data []byte
+	}{
+		{
+			name: "oversized numShapes (MaxUint32)",
+			data: func() []byte {
+				var b bytes.Buffer
+				b.WriteByte(1)                                                // version
+				binary.Write(&b, binary.LittleEndian, int32(10))              // maxEdges
+				binary.Write(&b, binary.LittleEndian, int32(100))             // nextID
+				binary.Write(&b, binary.LittleEndian, uint32(math.MaxUint32)) // numShapes
+				return b.Bytes()
+			}(),
+		},
+		{
+			name: "oversized numShapes (100,000,000)",
+			data: func() []byte {
+				var b bytes.Buffer
+				b.WriteByte(1)
+				binary.Write(&b, binary.LittleEndian, int32(10))
+				binary.Write(&b, binary.LittleEndian, int32(100))
+				binary.Write(&b, binary.LittleEndian, uint32(100000000))
+				return b.Bytes()
+			}(),
+		},
+		{
+			name: "oversized numCells (MaxUint32)",
+			data: func() []byte {
+				var b bytes.Buffer
+				b.WriteByte(1)
+				binary.Write(&b, binary.LittleEndian, int32(10))
+				binary.Write(&b, binary.LittleEndian, int32(0))
+				binary.Write(&b, binary.LittleEndian, uint32(0))              // 0 shapes
+				binary.Write(&b, binary.LittleEndian, uint32(math.MaxUint32)) // numCells
+				return b.Bytes()
+			}(),
+		},
+		{
+			name: "negative nextID",
+			data: func() []byte {
+				var b bytes.Buffer
+				b.WriteByte(1)
+				binary.Write(&b, binary.LittleEndian, int32(10))
+				binary.Write(&b, binary.LittleEndian, int32(-5)) // negative nextID
+				binary.Write(&b, binary.LittleEndian, uint32(0))
+				return b.Bytes()
+			}(),
+		},
+		{
+			name: "invalid maxEdges (0)",
+			data: func() []byte {
+				var b bytes.Buffer
+				b.WriteByte(1)
+				binary.Write(&b, binary.LittleEndian, int32(0)) // maxEdges 0
+				return b.Bytes()
+			}(),
+		},
+		{
+			name: "invalid maxEdges (negative)",
+			data: func() []byte {
+				var b bytes.Buffer
+				b.WriteByte(1)
+				binary.Write(&b, binary.LittleEndian, int32(-10))
+				return b.Bytes()
+			}(),
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			idx := NewShapeIndex()
+			if err := idx.Decode(bytes.NewReader(tc.data)); err == nil {
+				t.Fatalf("%s: expected error, got nil", tc.name)
+			}
+		})
+	}
+}
