new file mode 100644
index 00000000..d3bb017a
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,348 @@
+import type { AnyColumn, GetColumnData } from '~/column.ts';
+import { Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { SQLWrapper } from '../sql.ts';
+import { isSQLWrapper, SQL, sql } from '../sql.ts';
+
+export type FrameBoundaryType =
+	| 'unboundedPreceding'
+	| 'currentRow'
+	| 'unboundedFollowing'
+	| 'preceding'
+	| 'following';
+
+export interface FrameBoundary {
+	type: FrameBoundaryType;
+	value?: number;
+}
+
+export const unboundedPreceding: FrameBoundary = Object.freeze({
+	type: 'unboundedPreceding',
+});
+
+export const currentRow: FrameBoundary = Object.freeze({
+	type: 'currentRow',
+});
+
+export const unboundedFollowing: FrameBoundary = Object.freeze({
+	type: 'unboundedFollowing',
+});
+
+export function preceding(n: number): FrameBoundary {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 0) {
+		throw new Error(`preceding requires a non-negative integer argument, received: ${n}`);
+	}
+	return { type: 'preceding', value: n };
+}
+
+export function following(n: number): FrameBoundary {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 0) {
+		throw new Error(`following requires a non-negative integer argument, received: ${n}`);
+	}
+	return { type: 'following', value: n };
+}
+
+export interface FrameSpec {
+	type: 'rows' | 'range';
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+function getBoundaryRank(boundary: FrameBoundary): number {
+	switch (boundary.type) {
+		case 'unboundedPreceding':
+			return -Infinity;
+		case 'preceding':
+			return -(boundary.value ?? 0);
+		case 'currentRow':
+			return 0;
+		case 'following':
+			return boundary.value ?? 0;
+		case 'unboundedFollowing':
+			return Infinity;
+	}
+}
+
+function validateFrameSpec(type: 'rows' | 'range', spec: { from: FrameBoundary; to?: FrameBoundary }) {
+	if (!spec || !spec.from) {
+		throw new Error(`Frame specification requires 'from' boundary`);
+	}
+	if (spec.to !== undefined) {
+		const fromRank = getBoundaryRank(spec.from);
+		const toRank = getBoundaryRank(spec.to);
+		if (fromRank > toRank) {
+			throw new Error(`Invalid ${type} frame: 'from' boundary cannot be ordered after 'to' boundary`);
+		}
+	}
+}
+
+export function rows(spec: { from: FrameBoundary; to?: FrameBoundary }): FrameSpec {
+	validateFrameSpec('rows', spec);
+	return { type: 'rows', from: spec.from, to: spec.to };
+}
+
+export function range(spec: { from: FrameBoundary; to?: FrameBoundary }): FrameSpec {
+	validateFrameSpec('range', spec);
+	return { type: 'range', from: spec.from, to: spec.to };
+}
+
+function renderBoundary(boundary: FrameBoundary): SQL {
+	switch (boundary.type) {
+		case 'unboundedPreceding':
+			return sql`unbounded preceding`;
+		case 'currentRow':
+			return sql`current row`;
+		case 'unboundedFollowing':
+			return sql`unbounded following`;
+		case 'preceding':
+			return sql`${sql.raw((boundary.value ?? 0).toString())} preceding`;
+		case 'following':
+			return sql`${sql.raw((boundary.value ?? 0).toString())} following`;
+	}
+}
+
+export function renderFrame(frame: FrameSpec): SQL {
+	if (frame.to !== undefined) {
+		return sql`${sql.raw(frame.type)} between ${renderBoundary(frame.from)} and ${renderBoundary(frame.to)}`;
+	}
+	return sql`${sql.raw(frame.type)} ${renderBoundary(frame.from)}`;
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | AnyColumn | (SQLWrapper | AnyColumn)[];
+	orderBy?: SQLWrapper | AnyColumn | (SQLWrapper | AnyColumn)[];
+	frame?: FrameSpec;
+}
+
+export function renderWindowSpec(spec?: WindowSpec | string): SQL {
+	if (!spec) {
+		return sql``;
+	}
+	if (typeof spec === 'string') {
+		return sql`${sql.identifier(spec)}`;
+	}
+
+	const chunks: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionByList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByList.length > 0) {
+			chunks.push(sql`partition by ${sql.join(partitionByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderByList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByList.length > 0) {
+			chunks.push(sql`order by ${sql.join(orderByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		chunks.push(renderFrame(spec.frame));
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+export function buildOverSQL<T>(
+	fnSQL: SQL,
+	spec?: WindowSpec | string,
+	mapFromDriverValue?: (value: any) => any,
+): SQL<T> {
+	let overClause: SQL;
+	if (!spec || (typeof spec === 'object' && Object.keys(spec).length === 0)) {
+		overClause = sql`over ()`;
+	} else if (typeof spec === 'string') {
+		overClause = sql`over ${sql.identifier(spec)}`;
+	} else {
+		const rendered = renderWindowSpec(spec);
+		if (rendered.queryChunks.length === 0) {
+			overClause = sql`over ()`;
+		} else {
+			overClause = sql`over (${rendered})`;
+		}
+	}
+
+	const resultSQL = sql<T>`${fnSQL} ${overClause}`;
+	if (mapFromDriverValue) {
+		return resultSQL.mapWith(mapFromDriverValue);
+	}
+	return resultSQL;
+}
+
+export class WindowFunctionBuilder<TSelected> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	constructor(
+		private sqlFn: SQL,
+		private mapFromDriverValue?: (value: any) => any,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<TSelected> {
+		return buildOverSQL<TSelected>(this.sqlFn, spec, this.mapFromDriverValue);
+	}
+
+	getSQL(): SQL<TSelected> {
+		return buildOverSQL<TSelected>(this.sqlFn, undefined, this.mapFromDriverValue);
+	}
+}
+
+type GetExpressionType<T> = T extends Column<any>
+	? GetColumnData<T>
+	: T extends SQL<infer U>
+	? U
+	: T extends SQLWrapper
+	? unknown
+	: T;
+
+// Ranking Helpers
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number): WindowFunctionBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile requires a positive integer argument, received: ${n}`);
+	}
+	return new WindowFunctionBuilder(sql`ntile(${sql.raw(n.toString())})`, Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<string> {
+	return new WindowFunctionBuilder(sql`percent_rank()`, String);
+}
+
+export function cumeDist(): WindowFunctionBuilder<string> {
+	return new WindowFunctionBuilder(sql`cume_dist()`, String);
+}
+
+// Offset Helpers
+export function lag<
+	T extends SQLWrapper,
+	TDefault extends SQLWrapper | unknown = undefined,
+>(
+	value: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<
+	TDefault extends undefined
+		? GetExpressionType<T> | null
+		: GetExpressionType<T>
+> {
+	let sqlFn: SQL;
+	if (defaultValue !== undefined) {
+		const defaultSql = isSQLWrapper(defaultValue) ? defaultValue : sql`${defaultValue}`;
+		if (offset !== undefined) {
+			sqlFn = sql`lag(${value}, ${sql.raw(offset.toString())}, ${defaultSql})`;
+		} else {
+			sqlFn = sql`lag(${value}, 1, ${defaultSql})`;
+		}
+	} else if (offset !== undefined) {
+		sqlFn = sql`lag(${value}, ${sql.raw(offset.toString())})`;
+	} else {
+		sqlFn = sql`lag(${value})`;
+	}
+
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(sqlFn, decoder ? (v) => decoder.mapFromDriverValue(v) : undefined) as any;
+}
+
+export function lead<
+	T extends SQLWrapper,
+	TDefault extends SQLWrapper | unknown = undefined,
+>(
+	value: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<
+	TDefault extends undefined
+		? GetExpressionType<T> | null
+		: GetExpressionType<T>
+> {
+	let sqlFn: SQL;
+	if (defaultValue !== undefined) {
+		const defaultSql = isSQLWrapper(defaultValue) ? defaultValue : sql`${defaultValue}`;
+		if (offset !== undefined) {
+			sqlFn = sql`lead(${value}, ${sql.raw(offset.toString())}, ${defaultSql})`;
+		} else {
+			sqlFn = sql`lead(${value}, 1, ${defaultSql})`;
+		}
+	} else if (offset !== undefined) {
+		sqlFn = sql`lead(${value}, ${sql.raw(offset.toString())})`;
+	} else {
+		sqlFn = sql`lead(${value})`;
+	}
+
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowFunctionBuilder(sqlFn, decoder ? (v) => decoder.mapFromDriverValue(v) : undefined) as any;
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetExpressionType<T> | null> {
+	const sqlFn = sql`first_value(${expression})`;
+	const decoder = is(expression, Column) ? expression : undefined;
+	return new WindowFunctionBuilder(sqlFn, decoder ? (v) => decoder.mapFromDriverValue(v) : undefined);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetExpressionType<T> | null> {
+	const sqlFn = sql`last_value(${expression})`;
+	const decoder = is(expression, Column) ? expression : undefined;
+	return new WindowFunctionBuilder(sqlFn, decoder ? (v) => decoder.mapFromDriverValue(v) : undefined);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<GetExpressionType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue requires a positive integer argument, received: ${n}`);
+	}
+	const sqlFn = sql`nth_value(${expression}, ${sql.raw(n.toString())})`;
+	const decoder = is(expression, Column) ? expression : undefined;
+	return new WindowFunctionBuilder(sqlFn, decoder ? (v) => decoder.mapFromDriverValue(v) : undefined);
+}
+
+// Aggregates
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetExpressionType<T> | null> {
+	const decoder = is(expression, Column) ? expression : undefined;
+	return new WindowFunctionBuilder(
+		sql`min(${expression})`,
+		decoder ? (v) => decoder.mapFromDriverValue(v) : undefined,
+	) as any;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetExpressionType<T> | null> {
+	const decoder = is(expression, Column) ? expression : undefined;
+	return new WindowFunctionBuilder(
+		sql`max(${expression})`,
+		decoder ? (v) => decoder.mapFromDriverValue(v) : undefined,
+	) as any;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	const sqlFn = expression ? sql`count(${expression})` : sql`count(*)`;
+	return new WindowFunctionBuilder(sqlFn, Number);
+}
