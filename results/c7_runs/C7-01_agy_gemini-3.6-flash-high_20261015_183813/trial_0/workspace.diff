@@ -0,0 +1,46 @@
+import type { Equal } from 'type-tests/utils.ts';
+import { Expect } from 'type-tests/utils.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import {
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	rowNumber,
+} from '~/index.ts';
+import { drizzle } from '~/node-postgres/index.ts';
+
+const users = pgTable('users', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	age: integer('age').notNull(),
+});
+
+const db = drizzle({} as any);
+
+async function windowTypeTests() {
+	const res = await db
+		.select({
+			rn: rowNumber().over(),
+			first: firstValue(users.name).over(),
+			last: lastValue(users.age).over(),
+			nth: nthValue(users.age, 2).over(),
+			lagNull: lag(users.age).over(),
+			lagWithDefault: lag(users.age, 1, 0).over(),
+			leadNull: lead(users.age).over(),
+			leadWithDefault: lead(users.age, 1, 0).over(),
+		})
+		.from(users);
+
+	type Row = (typeof res)[number];
+
+	Expect<Equal<Row['rn'], number>>();
+	Expect<Equal<Row['first'], string | null>>();
+	Expect<Equal<Row['last'], number | null>>();
+	Expect<Equal<Row['nth'], number | null>>();
+	Expect<Equal<Row['lagNull'], number | null>>();
+	Expect<Equal<Row['lagWithDefault'], number>>();
+	Expect<Equal<Row['leadNull'], number | null>>();
+	Expect<Equal<Row['leadWithDefault'], number>>();
+}
