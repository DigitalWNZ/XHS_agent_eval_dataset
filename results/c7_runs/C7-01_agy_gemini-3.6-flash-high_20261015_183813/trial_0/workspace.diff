diff --git a/drizzle-orm/tests/window.test.ts b/drizzle-orm/tests/window.test.ts
new file mode 100644
index 00000000..1cbac09c
--- /dev/null
+++ b/drizzle-orm/tests/window.test.ts
@@ -0,0 +1,214 @@
+import { describe, expect, it } from 'vitest';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { pgTable, serial, text, integer } from '~/pg-core/index.ts';
+import { mysqlTable, varchar, int } from '~/mysql-core/index.ts';
+import { sqliteTable, text as sqliteText, integer as sqliteInt } from '~/sqlite-core/index.ts';
+import { PgDialect } from '~/pg-core/dialect.ts';
+import { MySqlDialect } from '~/mysql-core/dialect.ts';
+import { SQLiteDialect } from '~/sqlite-core/dialect.ts';
+import { PgSelectBuilder } from '~/pg-core/query-builders/select.ts';
+import { MySqlSelectBuilder } from '~/mysql-core/query-builders/select.ts';
+import { SQLiteSelectBuilder } from '~/sqlite-core/query-builders/select.ts';
+import { desc } from '~/sql/expressions/select.ts';
+
+const users = pgTable('users', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	age: integer('age').notNull(),
+});
+
+describe('Window Functions & Expressions', () => {
+	it('compile ranking helpers to correct snake_case SQL names', () => {
+		const dialect = new PgDialect();
+
+		expect(dialect.sqlToQuery(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(dialect.sqlToQuery(rank().over()).sql).toBe('rank() over ()');
+		expect(dialect.sqlToQuery(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(dialect.sqlToQuery(ntile(4).over()).sql).toBe('ntile(4) over ()');
+		expect(dialect.sqlToQuery(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(dialect.sqlToQuery(cumeDist().over()).sql).toBe('cume_dist() over ()');
+	});
+
+	it('compile offset helpers to correct snake_case SQL names and handle optional trailing arguments', () => {
+		const dialect = new PgDialect();
+
+		expect(dialect.sqlToQuery(lag(users.age).over()).sql).toBe('lag("users"."age") over ()');
+		expect(dialect.sqlToQuery(lag(users.age, 2).over()).sql).toBe('lag("users"."age", 2) over ()');
+		expect(dialect.sqlToQuery(lag(users.age, 2, 0).over()).sql).toBe('lag("users"."age", 2, $1) over ()');
+		expect(dialect.sqlToQuery(lead(users.age).over()).sql).toBe('lead("users"."age") over ()');
+		expect(dialect.sqlToQuery(lead(users.age, 3).over()).sql).toBe('lead("users"."age", 3) over ()');
+		expect(dialect.sqlToQuery(lead(users.age, 3, 0).over()).sql).toBe('lead("users"."age", 3, $1) over ()');
+		expect(dialect.sqlToQuery(firstValue(users.age).over()).sql).toBe('first_value("users"."age") over ()');
+		expect(dialect.sqlToQuery(lastValue(users.age).over()).sql).toBe('last_value("users"."age") over ()');
+		expect(dialect.sqlToQuery(nthValue(users.age, 5).over()).sql).toBe('nth_value("users"."age", 5) over ()');
+	});
+
+	it('compile aggregate helpers correctly', () => {
+		const dialect = new PgDialect();
+
+		expect(dialect.sqlToQuery(windowSum(users.age).over()).sql).toBe('sum("users"."age") over ()');
+		expect(dialect.sqlToQuery(windowAvg(users.age).over()).sql).toBe('avg("users"."age") over ()');
+		expect(dialect.sqlToQuery(windowMin(users.age).over()).sql).toBe('min("users"."age") over ()');
+		expect(dialect.sqlToQuery(windowMax(users.age).over()).sql).toBe('max("users"."age") over ()');
+		expect(dialect.sqlToQuery(windowCount().over()).sql).toBe('count(*) over ()');
+		expect(dialect.sqlToQuery(windowCount(users.age).over()).sql).toBe('count("users"."age") over ()');
+	});
+
+	it('numeric positional arguments never become bound query parameters, even when zero', () => {
+		const dialect = new PgDialect();
+
+		const query1 = dialect.sqlToQuery(ntile(1).over());
+		expect(query1.sql).toBe('ntile(1) over ()');
+		expect(query1.params).toEqual([]);
+
+		const query2 = dialect.sqlToQuery(lag(users.age, 0).over());
+		expect(query2.sql).toBe('lag("users"."age", 0) over ()');
+		expect(query2.params).toEqual([]);
+
+		const query3 = dialect.sqlToQuery(lead(users.age, 0).over());
+		expect(query3.sql).toBe('lead("users"."age", 0) over ()');
+		expect(query3.params).toEqual([]);
+
+		const query4 = dialect.sqlToQuery(nthValue(users.age, 1).over());
+		expect(query4.sql).toBe('nth_value("users"."age", 1) over ()');
+		expect(query4.params).toEqual([]);
+
+		const query5 = dialect.sqlToQuery(
+			rowNumber().over({
+				frame: rows({ from: preceding(0), to: following(0) }),
+			}),
+		);
+		expect(query5.sql).toBe('row_number() over (rows between 0 preceding and 0 following)');
+		expect(query5.params).toEqual([]);
+	});
+
+	it('rejects non-positive integer arguments for ntile and nthValue', () => {
+		expect(() => ntile(0)).toThrowError(/ntile.*0/);
+		expect(() => ntile(-1)).toThrowError(/ntile.*-1/);
+		expect(() => ntile(1.5)).toThrowError(/ntile.*1\.5/);
+
+		expect(() => nthValue(users.age, 0)).toThrowError(/nthValue.*0/);
+		expect(() => nthValue(users.age, -2)).toThrowError(/nthValue.*-2/);
+		expect(() => nthValue(users.age, 2.7)).toThrowError(/nthValue.*2\.7/);
+	});
+
+	it('rejects negative and non-integer arguments for preceding and following', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(1.5)).toThrowError(/preceding/);
+		expect(() => following(-5)).toThrowError(/following/);
+		expect(() => following(2.2)).toThrowError(/following/);
+	});
+
+	it('rows and range frame constructors reject spec where from is ordered after to', () => {
+		expect(() => rows({ from: following(2), to: preceding(1) })).toThrowError(/from/);
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+		expect(() => range({ from: unboundedFollowing, to: currentRow })).toThrowError(/from/);
+		expect(() => range({ from: following(5), to: following(2) })).toThrowError(/from/);
+	});
+
+	it('empty OVER specification appends over ()', () => {
+		const dialect = new PgDialect();
+
+		expect(dialect.sqlToQuery(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(dialect.sqlToQuery(rowNumber().over({})).sql).toBe('row_number() over ()');
+	});
+
+	it('named window references compile to OVER followed by quoted name without parentheses', () => {
+		const dialect = new PgDialect();
+
+		expect(dialect.sqlToQuery(rowNumber().over('w')).sql).toBe('row_number() over "w"');
+	});
+
+	it('inline spec partitionBy, orderBy, and frame compile correctly', () => {
+		const dialect = new PgDialect();
+
+		const query = dialect.sqlToQuery(
+			windowSum(users.age).over({
+				partitionBy: [users.name],
+				orderBy: [desc(users.age)],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+		);
+
+		expect(query.sql).toBe(
+			'sum("users"."age") over (partition by "users"."name" order by "users"."age" desc rows between unbounded preceding and current row)',
+		);
+	});
+
+	it('query builder .window() method rejects empty or whitespace-only names', () => {
+		const dialect = new PgDialect();
+		const qb = new PgSelectBuilder({ fields: undefined, session: undefined, dialect }).from(users);
+
+		expect(() => qb.window('', { partitionBy: users.id })).toThrowError(/non-empty/i);
+		expect(() => qb.window('   ', { partitionBy: users.id })).toThrowError(/whitespace/i);
+	});
+
+	it('named window definitions compile to a WINDOW clause before ORDER BY', () => {
+		const dialect = new PgDialect();
+		const qb = new PgSelectBuilder({
+			fields: {
+				id: users.id,
+				rn: rowNumber().over('w'),
+			},
+			session: undefined,
+			dialect,
+		})
+			.from(users)
+			.window('w', { partitionBy: users.id })
+			.orderBy(users.name);
+
+		const query = qb.toSQL();
+		expect(query.sql).toBe(
+			'select "id", row_number() over "w" from "users" window "w" as (partition by "users"."id") order by "users"."name"',
+		);
+	});
+
+	it('.window(name, spec) is available on select builders across all supported dialects', () => {
+		const pgDialect = new PgDialect();
+		const pgQuery = new PgSelectBuilder({ fields: undefined, session: undefined, dialect: pgDialect })
+			.from(users)
+			.window('w1', { partitionBy: users.id })
+			.toSQL();
+		expect(pgQuery.sql).toContain('window "w1" as (partition by "users"."id")');
+
+		const mysqlDialect = new MySqlDialect();
+		const mysqlUsers = mysqlTable('users', { id: int('id').primaryKey(), name: varchar('name', { length: 255 }) });
+		const mysqlQuery = new MySqlSelectBuilder({ fields: undefined, session: undefined, dialect: mysqlDialect })
+			.from(mysqlUsers)
+			.window('w1', { partitionBy: mysqlUsers.id })
+			.toSQL();
+		expect(mysqlQuery.sql).toContain('window `w1` as (partition by `users`.`id`)');
+
+		const sqliteDialect = new SQLiteDialect();
+		const sqliteUsers = sqliteTable('users', { id: sqliteInt('id').primaryKey(), name: sqliteText('name') });
+		const sqliteQuery = new SQLiteSelectBuilder({ fields: undefined, session: undefined, dialect: sqliteDialect })
+			.from(sqliteUsers)
+			.window('w1', { partitionBy: sqliteUsers.id })
+			.toSQL();
+		expect(sqliteQuery.sql).toContain('window "w1" as (partition by "users"."id")');
+	});
+});
