diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..0dca2c58
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,405 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import { type DriverValueDecoder, noopDecoder, SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameBoundType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+export class WindowFrameBound implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBound';
+
+	constructor(
+		readonly type: WindowFrameBoundType,
+		readonly sql: string,
+		readonly offset?: number,
+	) {}
+
+	getSQL(): SQL {
+		return sql.raw(this.sql);
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding = new WindowFrameBound('unboundedPreceding', 'unbounded preceding');
+
+export const currentRow = new WindowFrameBound('currentRow', 'current row');
+
+export const unboundedFollowing = new WindowFrameBound('unboundedFollowing', 'unbounded following');
+
+export function preceding(offset: number): WindowFrameBound {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() expects a non-negative integer, received ${offset}`);
+	}
+	return new WindowFrameBound('preceding', `${offset} preceding`, offset);
+}
+
+export function following(offset: number): WindowFrameBound {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() expects a non-negative integer, received ${offset}`);
+	}
+	return new WindowFrameBound('following', `${offset} following`, offset);
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBound;
+	to: WindowFrameBound;
+}
+
+export type WindowFrameMode = 'rows' | 'range';
+
+const boundOrder: Record<WindowFrameBoundType, number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+function validateWindowFrameBounds(from: WindowFrameBound, to: WindowFrameBound): void {
+	const fromOrder = boundOrder[from.type];
+	const toOrder = boundOrder[to.type];
+
+	if (
+		fromOrder > toOrder
+		|| (from.type === 'preceding' && to.type === 'preceding' && from.offset! < to.offset!)
+		|| (from.type === 'following' && to.type === 'following' && from.offset! > to.offset!)
+	) {
+		throw new Error(
+			`Invalid window frame: "from" boundary (${from.sql}) cannot be ordered after "to" boundary (${to.sql})`,
+		);
+	}
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		readonly from: WindowFrameBound,
+		readonly to: WindowFrameBound,
+	) {}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(this.mode)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	validateWindowFrameBounds(spec.from, spec.to);
+	return new WindowFrame('rows', spec.from, spec.to);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	validateWindowFrameBounds(spec.from, spec.to);
+	return new WindowFrame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must be a non-empty string and cannot be whitespace-only');
+	}
+}
+
+export function buildWindowSpecSql(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionByArray = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByArray.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderByArray = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByArray.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		parts.push(spec.frame.getSQL());
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function buildWindowsSql(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	const windowDefs = windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpecSql(spec)})`);
+
+	return sql` window ${sql.join(windowDefs, sql`, `)}`;
+}
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder:
+			| DriverValueDecoder<any, any>
+			| DriverValueDecoder<any, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		let result: SQL<T>;
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			result = sql`${this.fnSql} over ${sql.identifier(spec)}` as SQL<T>;
+		} else {
+			const specSql = buildWindowSpecSql(spec);
+			result = sql`${this.fnSql} over (${specSql})` as SQL<T>;
+		}
+		return result.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type GetWindowValueType<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> | SQL.Aliased<infer U> ? U
+	: unknown;
+
+function getExpressionDecoder(
+	expression: SQLWrapper,
+): DriverValueDecoder<any, any> | DriverValueDecoder<any, any>['mapFromDriverValue'] {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+function formatWindowArg(value: unknown, expression: SQLWrapper): SQLChunk {
+	if (typeof value === 'number') {
+		return sql.raw(String(value));
+	}
+	return bindIfParam(value, expression);
+}
+
+/**
+ * Returns the number of the current row within its partition, counting from 1.
+ */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+/**
+ * Returns the rank of the current row, with gaps.
+ */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+/**
+ * Returns the rank of the current row, without gaps.
+ */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+/**
+ * Divides the rows in an ordered partition into `buckets` buckets and assigns a bucket number to each row.
+ */
+export function ntile(buckets: number): WindowFunction<number> {
+	if (typeof buckets !== 'number' || !Number.isInteger(buckets) || buckets < 1) {
+		throw new Error(`ntile() expects a positive integer, received ${buckets}`);
+	}
+	return new WindowFunction(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+/**
+ * Returns the relative rank of the current row: `(rank - 1) / (total_partition_rows - 1)`.
+ */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+/**
+ * Returns the cumulative distribution of a value within a group of values.
+ */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+/**
+ * Returns the value of `expression` evaluated at the row that is `offset` rows before the current row within the partition.
+ */
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowValueType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<GetWindowValueType<T>> | SQLWrapper,
+): WindowFunction<NonNullable<GetWindowValueType<T>>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (defaultValue !== undefined) {
+		const offsetChunk = offset === undefined ? sql.raw('1') : sql.raw(String(offset));
+		const defaultChunk = formatWindowArg(defaultValue, expression);
+		return new WindowFunction(sql`lag(${expression}, ${offsetChunk}, ${defaultChunk})`, decoder);
+	}
+	if (offset !== undefined) {
+		return new WindowFunction(sql`lag(${expression}, ${sql.raw(String(offset))})`, decoder);
+	}
+	return new WindowFunction(sql`lag(${expression})`, decoder);
+}
+
+/**
+ * Returns the value of `expression` evaluated at the row that is `offset` rows after the current row within the partition.
+ */
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<GetWindowValueType<T>> | SQLWrapper,
+): WindowFunction<NonNullable<GetWindowValueType<T>>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (defaultValue !== undefined) {
+		const offsetChunk = offset === undefined ? sql.raw('1') : sql.raw(String(offset));
+		const defaultChunk = formatWindowArg(defaultValue, expression);
+		return new WindowFunction(sql`lead(${expression}, ${offsetChunk}, ${defaultChunk})`, decoder);
+	}
+	if (offset !== undefined) {
+		return new WindowFunction(sql`lead(${expression}, ${sql.raw(String(offset))})`, decoder);
+	}
+	return new WindowFunction(sql`lead(${expression})`, decoder);
+}
+
+/**
+ * Returns the value of `expression` evaluated at the first row of the window frame.
+ */
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowValueType<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, getExpressionDecoder(expression));
+}
+
+/**
+ * Returns the value of `expression` evaluated at the last row of the window frame.
+ */
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowValueType<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, getExpressionDecoder(expression));
+}
+
+/**
+ * Returns the value of `expression` evaluated at the `n`th row of the window frame (counting from 1).
+ */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<GetWindowValueType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() expects a positive integer, received ${n}`);
+	}
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+/**
+ * Returns the sum of `expression` across the window frame.
+ */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+/**
+ * Returns the average of `expression` across the window frame.
+ */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+/**
+ * Returns the minimum value of `expression` across the window frame.
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : String,
+	);
+}
+
+/**
+ * Returns the maximum value of `expression` across the window frame.
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : String,
+	);
+}
+
+/**
+ * Returns the count of values in `expression` (or all rows if omitted) across the window frame.
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression || sql.raw('*')})`, Number);
+}
