@@ -0,0 +1,408 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { Subquery } from '~/subquery.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import {
+	type DriverValueDecoder,
+	isSQLWrapper,
+	noopDecoder,
+	SQL,
+	sql,
+	type SQLWrapper,
+} from '../sql.ts';
+
+export type WindowFrameMode = 'rows' | 'range';
+
+export type WindowFrameBoundType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+export class WindowFrameBound implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBound';
+
+	constructor(
+		readonly type: WindowFrameBoundType,
+		readonly offset?: number,
+	) {}
+
+	getSQL(): SQL {
+		switch (this.type) {
+			case 'unboundedPreceding': {
+				return sql.raw('unbounded preceding');
+			}
+			case 'preceding': {
+				return sql.raw(`${this.offset} preceding`);
+			}
+			case 'currentRow': {
+				return sql.raw('current row');
+			}
+			case 'following': {
+				return sql.raw(`${this.offset} following`);
+			}
+			case 'unboundedFollowing': {
+				return sql.raw('unbounded following');
+			}
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding: WindowFrameBound = new WindowFrameBound('unboundedPreceding');
+export const currentRow: WindowFrameBound = new WindowFrameBound('currentRow');
+export const unboundedFollowing: WindowFrameBound = new WindowFrameBound('unboundedFollowing');
+
+export function preceding(offset: number): WindowFrameBound {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() requires a non-negative integer argument, received ${offset}`);
+	}
+	return new WindowFrameBound('preceding', offset);
+}
+
+export function following(offset: number): WindowFrameBound {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() requires a non-negative integer argument, received ${offset}`);
+	}
+	return new WindowFrameBound('following', offset);
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBound;
+	to: WindowFrameBound;
+}
+
+const boundOrder: Record<WindowFrameBoundType, number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+function validateFrameBounds(from: WindowFrameBound, to: WindowFrameBound, fnName: string): void {
+	const fromRank = boundOrder[from.type];
+	const toRank = boundOrder[to.type];
+
+	if (fromRank > toRank) {
+		throw new Error(
+			`${fnName}(): invalid window frame - "from" boundary (${from.type}) cannot be ordered after "to" boundary (${to.type})`,
+		);
+	}
+
+	if (from.type === 'unboundedFollowing') {
+		throw new Error(`${fnName}(): invalid window frame - "from" boundary cannot be unboundedFollowing`);
+	}
+
+	if (to.type === 'unboundedPreceding') {
+		throw new Error(
+			`${fnName}(): invalid window frame - "from" boundary cannot be ordered at or after "to" boundary (unboundedPreceding)`,
+		);
+	}
+
+	if (from.type === 'preceding' && to.type === 'preceding' && from.offset! < to.offset!) {
+		throw new Error(
+			`${fnName}(): invalid window frame - "from" boundary (${from.offset} preceding) is ordered after "to" boundary (${to.offset} preceding)`,
+		);
+	}
+
+	if (from.type === 'following' && to.type === 'following' && from.offset! > to.offset!) {
+		throw new Error(
+			`${fnName}(): invalid window frame - "from" boundary (${from.offset} following) is ordered after "to" boundary (${to.offset} following)`,
+		);
+	}
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		readonly from: WindowFrameBound,
+		readonly to: WindowFrameBound,
+	) {}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(this.mode)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	validateFrameBounds(spec.from, spec.to, 'rows');
+	return new WindowFrame('rows', spec.from, spec.to);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	validateFrameBounds(spec.from, spec.to, 'range');
+	return new WindowFrame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must be a non-empty string and cannot be whitespace-only');
+	}
+}
+
+export function buildWindowSpecSql(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const clauses: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionList.length > 0) {
+			clauses.push(sql`partition by ${sql.join(partitionList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderList.length > 0) {
+			clauses.push(sql`order by ${sql.join(orderList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		clauses.push(spec.frame.getSQL());
+	}
+
+	if (clauses.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(clauses, sql` `);
+}
+
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder:
+			| DriverValueDecoder<T, any>
+			| DriverValueDecoder<T, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		let query: SQL;
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			query = sql`${this.fnSql} over ${sql.identifier(spec)}`;
+		} else {
+			const specSql = buildWindowSpecSql(spec);
+			query = sql`${this.fnSql} over (${specSql})`;
+		}
+		return query.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type WindowValueType<T extends SQLWrapper> = T extends AnyColumn
+	? T['_']['data']
+	: T extends SQL<infer U>
+	? U
+	: T extends SQL.Aliased<infer U>
+	? U
+	: unknown;
+
+export type WindowNonNullValueType<T extends SQLWrapper> = Exclude<WindowValueType<T>, null | undefined>;
+
+export type WindowDefaultValue<T extends SQLWrapper> = T extends AnyColumn
+	? T['_']['data'] | SQLWrapper
+	: T extends SQL<infer U>
+	? (unknown extends U ? unknown : Exclude<U, null | undefined> | SQLWrapper)
+	: T extends SQL.Aliased<infer U>
+	? (unknown extends U ? unknown : Exclude<U, null | undefined> | SQLWrapper)
+	: unknown;
+
+function getExpressionDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	if (is(expression, Subquery)) {
+		return expression._.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(buckets: number): WindowFunctionBuilder<number> {
+	if (typeof buckets !== 'number' || !Number.isInteger(buckets) || buckets < 1) {
+		throw new Error(`ntile() requires a positive integer argument, received ${buckets}`);
+	}
+	return new WindowFunctionBuilder(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`cume_dist()`, Number);
+}
+
+function buildOffsetWindowFn<T extends SQLWrapper>(
+	fnName: 'lag' | 'lead',
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (offset === undefined && defaultValue === undefined) {
+		return new WindowFunctionBuilder(sql`${sql.raw(fnName)}(${expression})`, decoder);
+	}
+	const resolvedOffset = offset ?? 1;
+	const offsetChunk = sql.raw(String(resolvedOffset));
+	if (defaultValue === undefined) {
+		return new WindowFunctionBuilder(sql`${sql.raw(fnName)}(${expression}, ${offsetChunk})`, decoder);
+	}
+	const defaultChunk = typeof defaultValue === 'number'
+		? sql.raw(String(defaultValue))
+		: isSQLWrapper(defaultValue)
+		? defaultValue
+		: bindIfParam(defaultValue, expression);
+	return new WindowFunctionBuilder(
+		sql`${sql.raw(fnName)}(${expression}, ${offsetChunk}, ${defaultChunk})`,
+		decoder,
+	);
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValueType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: WindowDefaultValue<T>,
+): WindowFunctionBuilder<WindowNonNullValueType<T>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: WindowDefaultValue<T>,
+): WindowFunctionBuilder<any> {
+	return buildOffsetWindowFn('lag', expression, offset, defaultValue);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: WindowDefaultValue<T>,
+): WindowFunctionBuilder<WindowNonNullValueType<T>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: WindowDefaultValue<T>,
+): WindowFunctionBuilder<any> {
+	return buildOffsetWindowFn('lead', expression, offset, defaultValue);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<WindowValueType<T> | null> {
+	return new WindowFunctionBuilder(
+		sql`first_value(${expression})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<WindowValueType<T> | null> {
+	return new WindowFunctionBuilder(
+		sql`last_value(${expression})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<WindowValueType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() requires a positive integer argument, received ${n}`);
+	}
+	return new WindowFunctionBuilder(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : String,
+	) as any;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : String,
+	) as any;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
