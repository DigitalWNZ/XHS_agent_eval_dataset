+import { Expect } from 'type-tests/utils.ts';
+import {
+	asc,
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	type SQL,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const employees = pgTable('employees', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	department: text('department').notNull(),
+	salary: integer('salary').notNull(),
+	bonus: integer('bonus'),
+});
+
+// Direct SQL<T> return types
+const rnExpr = rowNumber().over();
+Expect<Equal<SQL<number>, typeof rnExpr>>;
+
+const rankExpr = rank().over({ partitionBy: employees.department });
+Expect<Equal<SQL<number>, typeof rankExpr>>;
+
+const denseRankExpr = denseRank().over({ orderBy: desc(employees.salary) });
+Expect<Equal<SQL<number>, typeof denseRankExpr>>;
+
+const ntileExpr = ntile(4).over();
+Expect<Equal<SQL<number>, typeof ntileExpr>>;
+
+const percentRankExpr = percentRank().over();
+Expect<Equal<SQL<number>, typeof percentRankExpr>>;
+
+const cumeDistExpr = cumeDist().over();
+Expect<Equal<SQL<number>, typeof cumeDistExpr>>;
+
+// Value-access functions are typed nullable; lag and lead strip null when a default value is provided
+const lagNullable1 = lag(employees.salary).over();
+Expect<Equal<SQL<number | null>, typeof lagNullable1>>;
+
+const lagNullable2 = lag(employees.salary, 2).over();
+Expect<Equal<SQL<number | null>, typeof lagNullable2>>;
+
+const lagNonNull = lag(employees.salary, 1, 0).over();
+Expect<Equal<SQL<number>, typeof lagNonNull>>;
+
+const lagNonNullFromNullableCol = lag(employees.bonus, 1, 0).over();
+Expect<Equal<SQL<number>, typeof lagNonNullFromNullableCol>>;
+
+const leadNullable1 = lead(employees.name).over();
+Expect<Equal<SQL<string | null>, typeof leadNullable1>>;
+
+const leadNullable2 = lead(employees.name, 1).over();
+Expect<Equal<SQL<string | null>, typeof leadNullable2>>;
+
+const leadNonNull = lead(employees.name, 1, 'none').over();
+Expect<Equal<SQL<string>, typeof leadNonNull>>;
+
+const firstValExpr = firstValue(employees.salary).over();
+Expect<Equal<SQL<number | null>, typeof firstValExpr>>;
+
+const lastValExpr = lastValue(employees.name).over();
+Expect<Equal<SQL<string | null>, typeof lastValExpr>>;
+
+const nthValExpr = nthValue(employees.salary, 2).over();
+Expect<Equal<SQL<number | null>, typeof nthValExpr>>;
+
+// Aggregates
+const sumExpr = windowSum(employees.salary).over({
+	frame: rows({ from: unboundedPreceding, to: currentRow }),
+});
+Expect<Equal<SQL<string | null>, typeof sumExpr>>;
+
+const avgExpr = windowAvg(employees.salary).over({
+	frame: range({ from: preceding(1), to: following(1) }),
+});
+Expect<Equal<SQL<string | null>, typeof avgExpr>>;
+
+const minExpr = windowMin(employees.salary).over({
+	frame: rows({ from: currentRow, to: unboundedFollowing }),
+});
+Expect<Equal<SQL<number | null>, typeof minExpr>>;
+
+const maxExpr = windowMax(employees.name).over();
+Expect<Equal<SQL<string | null>, typeof maxExpr>>;
+
+const countExpr = windowCount().over();
+Expect<Equal<SQL<number>, typeof countExpr>>;
+
+const countColExpr = windowCount(employees.id).over();
+Expect<Equal<SQL<number>, typeof countColExpr>>;
+
+// Select query result type inference with .window()
+const result = await db
+	.select({
+		id: employees.id,
+		rn: rowNumber().over('w'),
+		prevSalary: lag(employees.salary).over('w'),
+		prevSalaryWithDefault: lag(employees.salary, 1, 0).over('w'),
+		nextName: lead(employees.name).over('w'),
+		nextNameWithDefault: lead(employees.name, 1, 'N/A').over('w'),
+		firstSal: firstValue(employees.salary).over('w'),
+		lastSal: lastValue(employees.salary).over('w'),
+		secondSal: nthValue(employees.salary, 2).over('w'),
+		runningTotal: windowSum(employees.salary).over('w'),
+		avgSal: windowAvg(employees.salary).over('w'),
+		minSal: windowMin(employees.salary).over('w'),
+		maxSal: windowMax(employees.salary).over('w'),
+		totalCount: windowCount().over('w'),
+	})
+	.from(employees)
+	.window('w', {
+		partitionBy: employees.department,
+		orderBy: asc(employees.salary),
+	});
+
+Expect<
+	Equal<
+		{
+			id: number;
+			rn: number;
+			prevSalary: number | null;
+			prevSalaryWithDefault: number;
+			nextName: string | null;
+			nextNameWithDefault: string;
+			firstSal: number | null;
+			lastSal: number | null;
+			secondSal: number | null;
+			runningTotal: string | null;
+			avgSal: string | null;
