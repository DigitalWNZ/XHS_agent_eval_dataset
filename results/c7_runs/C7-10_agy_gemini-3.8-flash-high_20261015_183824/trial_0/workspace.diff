+	require.NotNil(t, res.Error, "must fail fast when key env var is missing")
+
+	errStr := strings.ToLower(res.Error.Error())
+	assert.True(t, strings.Contains(errStr, "encryption") || strings.Contains(errStr, "key"),
+		"missing key env var error must contain 'encryption' or 'key', got: %s", res.Error.Error())
 }
 
