+func TestHMACIntegrityFailure(t *testing.T) {
+	key := make([]byte, 32)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("test integrity"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+
+	encData := buf.Bytes()
+
+	// Corrupt the last byte (part of HMAC)
+	corruptHMAC := make([]byte, len(encData))
+	copy(corruptHMAC, encData)
+	corruptHMAC[len(corruptHMAC)-1] ^= 0xFF
+
+	dr, err := DecryptReader(bytes.NewReader(corruptHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+}
