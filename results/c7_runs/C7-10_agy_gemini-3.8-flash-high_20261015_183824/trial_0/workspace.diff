+func TestStorageReadWriteCloserPipeline(t *testing.T) {
+	key := make([]byte, 32)
+	for i := range key {
+		key[i] = byte(i + 1)
+	}
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	originalData := []byte("CREATE TABLE users (id INT, name VARCHAR(255));\nINSERT INTO users VALUES (1, 'Alice');\n")
+
+	// Test count = 2 (fanout to 2 storages)
+	readers, writer, closer := storageReadWriteCloser(2, true, enc)
+	require.Len(t, readers, 2)
+
+	var readData1, readData2 []byte
+	var readErr1, readErr2 error
+	var readWg sync.WaitGroup
+	readWg.Add(2)
+
+	go func() {
+		defer readWg.Done()
+		readData1, readErr1 = io.ReadAll(readers[0])
+	}()
+	go func() {
+		defer readWg.Done()
+		readData2, readErr2 = io.ReadAll(readers[1])
+	}()
+
+	_, err = writer.Write(originalData)
+	require.NoError(t, err)
+
+	err = closer.Close()
+	require.NoError(t, err)
+
+	readWg.Wait()
+	require.NoError(t, readErr1)
+	require.NoError(t, readErr2)
+
+	// Two encryptions should differ because each branch uses unique nonces
+	assert.NotEqual(t, readData1, readData2)
+
+	// Round-trip through DecryptReader then gzip.NewReader back to original data
+	for idx, readData := range [][]byte{readData1, readData2} {
+		dr, err := encryption.DecryptReader(strings.NewReader(string(readData)), key)
+		require.NoError(t, err, "branch %d DecryptReader failed", idx)
+
+		gzr, err := gzip.NewReader(dr)
+		require.NoError(t, err, "branch %d gzip.NewReader failed", idx)
+
+		decrypted, err := io.ReadAll(gzr)
+		require.NoError(t, err, "branch %d io.ReadAll failed", idx)
+		require.NoError(t, gzr.Close())
+
+		assert.Equal(t, originalData, decrypted, "branch %d data mismatch", idx)
+	}
+}
