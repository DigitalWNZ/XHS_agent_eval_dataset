+func TestLoadKey(t *testing.T) {
+	rawKey := make([]byte, 32)
+	for i := range rawKey {
+		rawKey[i] = byte(i + 1)
+	}
+	keyB64 := base64.StdEncoding.EncodeToString(rawKey)
+
+	// Literal
+	loaded, err := LoadKey(Config{KeySource: "literal", Key: keyB64})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Env
+	t.Setenv("TEST_ENCRYPTION_KEY", keyB64)
+	loaded, err = LoadKey(Config{KeySource: "env", KeyEnvVar: "TEST_ENCRYPTION_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Missing env var error must contain encryption or key
+	_, err = LoadKey(Config{KeySource: "env", KeyEnvVar: "NON_EXISTENT_VAR_12345"})
+	require.Error(t, err)
+	errLower := strings.ToLower(err.Error())
+	assert.True(t, strings.Contains(errLower, "encryption") || strings.Contains(errLower, "key"))
+
+	// File (with surrounding whitespace/newlines)
+	tmpDir := t.TempDir()
+	keyFilePath := filepath.Join(tmpDir, "test.key")
+	err = os.WriteFile(keyFilePath, []byte("  \n"+keyB64+"\n  \n"), 0600)
+	require.NoError(t, err)
+
+	loaded, err = LoadKey(Config{KeySource: "file", KeyFile: keyFilePath})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Derive: deterministic 32-byte key
+	saltBytes := make([]byte, 16)
+	saltBytes[0] = 42
+	saltB64 := base64.StdEncoding.EncodeToString(saltBytes)
+
+	k1, err := LoadKey(Config{KeySource: "derive", Passphrase: "password123", Salt: saltB64})
+	require.NoError(t, err)
+	assert.Len(t, k1, 32)
+
+	// Deterministic
+	k2, err := LoadKey(Config{KeySource: "derive", Passphrase: "password123", Salt: saltB64})
+	require.NoError(t, err)
+	assert.Equal(t, k1, k2)
+
+	// Different passphrase produces different key
+	k3, err := LoadKey(Config{KeySource: "derive", Passphrase: "password456", Salt: saltB64})
+	require.NoError(t, err)
+	assert.NotEqual(t, k1, k3)
+
+	// Salt < 16 bytes rejected
+	shortSaltB64 := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	_, err = LoadKey(Config{KeySource: "derive", Passphrase: "password123", Salt: shortSaltB64})
+	assert.Error(t, err)
+
+	// Empty passphrase rejected
+	_, err = LoadKey(Config{KeySource: "derive", Passphrase: "", Salt: saltB64})
+	assert.Error(t, err)
+}
