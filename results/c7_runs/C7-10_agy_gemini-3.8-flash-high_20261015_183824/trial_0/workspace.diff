+func TestConfigValidation(t *testing.T) {
+	// Disabled config is always valid
+	assert.NoError(t, Config{Enabled: false}.Validate())
+	assert.NoError(t, Config{Enabled: false, KeySource: "invalid"}.Validate())
+
+	// Enabled with empty source
+	assert.Error(t, Config{Enabled: true}.Validate())
+
+	// Enabled with unsupported source
+	assert.Error(t, Config{Enabled: true, KeySource: "foo"}.Validate())
+
+	validKey32 := base64.StdEncoding.EncodeToString(make([]byte, 32))
+	validSalt16 := base64.StdEncoding.EncodeToString(make([]byte, 16))
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+
+	// Source: env
+	assert.NoError(t, Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_KEY"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "TEST_KEY"}.Validate()) // Case-insensitive
+	assert.Error(t, Config{Enabled: true, KeySource: "env"}.Validate())                          // missing KeyEnvVar
+
+	// Mutually exclusive for env
+	err := Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_KEY", Key: validKey32}.Validate()
+	assert.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	err = Config{Enabled: true, KeySource: "env", KeyEnvVar: "TEST_KEY", KeyFile: "file.key"}.Validate()
+	assert.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// Source: file
+	assert.NoError(t, Config{Enabled: true, KeySource: "file", KeyFile: "key.txt"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "file"}.Validate()) // missing KeyFile
+	err = Config{Enabled: true, KeySource: "file", KeyFile: "key.txt", KeyEnvVar: "TEST"}.Validate()
+	assert.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// Source: literal
+	assert.NoError(t, Config{Enabled: true, KeySource: "literal", Key: validKey32}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "literal"}.Validate()) // missing Key
+	err = Config{Enabled: true, KeySource: "literal", Key: validKey32, KeyEnvVar: "TEST"}.Validate()
+	assert.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+
+	// Source: derive
+	assert.NoError(t, Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: validSalt16}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: validSalt16}.Validate())     // empty passphrase
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: ""}.Validate())        // missing salt
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: shortSalt}.Validate()) // salt < 16 bytes
+	err = Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: validSalt16, Key: validKey32}.Validate()
+	assert.Error(t, err)
+	assert.Contains(t, err.Error(), "mutually exclusive")
+}
