diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..5f4b45c
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,469 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/argon2"
+)
+
+const (
+	ChunkSize  = 64 * 1024
+	nonceSize  = 12
+	tagSize    = 16
+	headerSize = 3
+	macSize    = 32
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key")
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateKeySource()
+}
+
+func (c Config) validateKeySource() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source cannot be empty")
+	}
+
+	switch source {
+	case "env":
+		if c.KeyFile != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("keyenvvar is required for env key source")
+		}
+	case "file":
+		if c.KeyEnvVar != "" || c.Key != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("keyfile is required for file key source")
+		}
+	case "literal":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Passphrase != "" || c.Salt != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+		keyBytes, err := decodeBase64(c.Key)
+		if err != nil {
+			return fmt.Errorf("invalid base64 key: %w", err)
+		}
+		if len(keyBytes) != 32 {
+			return fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(keyBytes))
+		}
+	case "derive":
+		if c.KeyEnvVar != "" || c.KeyFile != "" || c.Key != "" {
+			return errors.New("encryption config fields are mutually exclusive")
+		}
+		if c.Passphrase == "" {
+			return errors.New("empty passphrase rejected")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+		saltBytes, err := decodeBase64(c.Salt)
+		if err != nil {
+			return fmt.Errorf("invalid base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return errors.New("salt must be at least 16 bytes")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	data, err := base64.StdEncoding.DecodeString(s)
+	if err == nil {
+		return data, nil
+	}
+	if rawData, rawErr := base64.RawStdEncoding.DecodeString(s); rawErr == nil {
+		return rawData, nil
+	}
+	if urlData, urlErr := base64.URLEncoding.DecodeString(s); urlErr == nil {
+		return urlData, nil
+	}
+	if rawURLErr, rawErr := base64.RawURLEncoding.DecodeString(s); rawErr == nil {
+		return rawURLErr, nil
+	}
+	return nil, err
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateKeySource(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+		key, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "file":
+		content, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file: %w", err)
+		}
+		trimmed := strings.TrimSpace(string(content))
+		key, err := decodeBase64(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "literal":
+		key, err := decodeBase64(cfg.Key)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key: %w", err)
+		}
+		if len(key) != 32 {
+			return nil, fmt.Errorf("%w: encryption key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("empty passphrase rejected")
+		}
+		saltBytes, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, errors.New("salt must be at least 16 bytes")
+		}
+		key := argon2.IDKey([]byte(cfg.Passphrase), saltBytes, 1, 64*1024, 4, 32)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+}
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+	k := make([]byte, 32)
+	copy(k, key)
+	return &Encryptor{key: k}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	if err != nil {
+		panic(err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		panic(err)
+	}
+	return &encryptWriter{
+		key: e.key,
+		w:   w,
+		gcm: gcm,
+		h:   hmac.New(sha256.New, e.key),
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	key           []byte
+	w             io.Writer
+	gcm           cipher.AEAD
+	h             hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if !ew.headerWritten {
+		header := []byte{0x4F, 0x44, 0x01}
+		if _, err := ew.w.Write(header); err != nil {
+			return err
+		}
+		ew.headerWritten = true
+	}
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce, ew.buf, nil)
+	totalChunkLen := uint32(len(nonce) + len(ciphertext))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], totalChunkLen)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(ciphertext); err != nil {
+		return err
+	}
+
+	ew.h.Write(lenBuf[:])
+	ew.h.Write(nonce)
+	ew.h.Write(ciphertext)
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed EncryptWriter")
+	}
+	if err := ew.writeHeader(); err != nil {
+		return 0, err
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		needed := ChunkSize - len(ew.buf)
+		if len(p) < needed {
+			ew.buf = append(ew.buf, p...)
+			break
+		}
+		ew.buf = append(ew.buf, p[:needed]...)
+		p = p[needed:]
+		if err := ew.flushChunk(); err != nil {
+			return 0, err
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if err := ew.writeHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(); err != nil {
+			return err
+		}
+	}
+
+	sentinel := []byte{0x00, 0x00, 0x00, 0x00}
+	if _, err := ew.w.Write(sentinel); err != nil {
+		return err
+	}
+
+	mac := ew.h.Sum(nil)
+	if _, err := ew.w.Write(mac); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+	if r == nil {
+		return nil, errors.New("reader cannot be nil")
+	}
+	k := make([]byte, 32)
+	copy(k, key)
+	return &decryptReader{
+		r:   r,
+		key: k,
+	}, nil
+}
+
+type decryptReader struct {
+	r         io.Reader
+	key       []byte
+	gcm       cipher.AEAD
+	h         hash.Hash
+	buf       []byte
+	bufOffset int
+	init      bool
+	eof       bool
+	err       error
+}
+
+func (dr *decryptReader) initialize() error {
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return err
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return err
+	}
+	dr.gcm = gcm
+	dr.h = hmac.New(sha256.New, dr.key)
+
+	header := make([]byte, headerSize)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		return fmt.Errorf("truncated data: %w", err)
+	}
+
+	if header[0] != 0x4F || header[1] != 0x44 {
+		return fmt.Errorf("invalid header: expected magic 0x4F 0x44, got 0x%02x 0x%02x", header[0], header[1])
+	}
+
+	if header[2] != 0x01 {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+
+	dr.init = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		return fmt.Errorf("truncated data: %w", err)
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		mac := make([]byte, macSize)
+		if _, err := io.ReadFull(dr.r, mac); err != nil {
+			return fmt.Errorf("truncated data: %w", err)
+		}
+
+		expectedMac := dr.h.Sum(nil)
+		if !hmac.Equal(mac, expectedMac) {
+			return errors.New("integrity check failed: HMAC mismatch")
+		}
+
+		dr.eof = true
+		return nil
+	}
+
+	if chunkLen < nonceSize+tagSize {
+		return fmt.Errorf("invalid chunk: length %d too short", chunkLen)
+	}
+	if chunkLen > 10*ChunkSize {
+		return fmt.Errorf("invalid chunk: length %d too large", chunkLen)
+	}
+
+	chunkData := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkData); err != nil {
+		return fmt.Errorf("truncated data: %w", err)
+	}
+
+	dr.h.Write(lenBuf[:])
+	dr.h.Write(chunkData)
+
+	nonce := chunkData[:nonceSize]
+	ciphertext := chunkData[nonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decryption failed: %w", err)
+	}
+
+	dr.buf = plaintext
+	dr.bufOffset = 0
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.init {
+		if err := dr.initialize(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for {
+		if dr.bufOffset < len(dr.buf) {
+			n := copy(p, dr.buf[dr.bufOffset:])
+			dr.bufOffset += n
+			return n, nil
+		}
+
+		if dr.eof {
+			return 0, io.EOF
+		}
+
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..3cdd514
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,395 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptorKeyValidation(t *testing.T) {
+	// Valid 32-byte key
+	validKey := make([]byte, 32)
+	enc, err := NewEncryptor(validKey)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+
+	// Non-32-byte keys must fail and wrap ErrInvalidKey
+	for _, size := range []int{0, 16, 24, 31, 33, 64} {
+		key := make([]byte, size)
+		enc, err := NewEncryptor(key)
+		assert.Error(t, err, "size %d should be rejected", size)
+		assert.True(t, errors.Is(err, ErrInvalidKey), "error for size %d must wrap ErrInvalidKey", size)
+		assert.Nil(t, enc)
+	}
+}
+
+func TestStreamingEncryptionRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("hello world")},
+		{"exact_1_chunk", make([]byte, ChunkSize)},
+		{"1_chunk_plus_1", make([]byte, ChunkSize+1)},
+		{"multi_chunks", make([]byte, ChunkSize*3+1234)},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			if len(tc.data) > 0 && tc.name != "small" {
+				_, err := rand.Read(tc.data)
+				require.NoError(t, err)
+			}
+
+			// Encrypt
+			var encBuf bytes.Buffer
+			ew := enc.EncryptWriter(&encBuf)
+			n, err := ew.Write(tc.data)
+			require.NoError(t, err)
+			assert.Equal(t, len(tc.data), n)
+			require.NoError(t, ew.Close())
+
+			// Close should be idempotent
+			require.NoError(t, ew.Close())
+
+			// Decrypt
+			dr, err := DecryptReader(&encBuf, key)
+			require.NoError(t, err)
+
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.data, decrypted)
+		})
+	}
+}
+
+func TestEncryptionNoncesAndCiphertextDifference(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := []byte("The quick brown fox jumps over the lazy dog.")
+
+	var buf1, buf2 bytes.Buffer
+
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes(), "Two encryptions of same plaintext must differ")
+}
+
+func TestHeaderValidation(t *testing.T) {
+	key := make([]byte, 32)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("test"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+
+	encData := buf.Bytes()
+	require.GreaterOrEqual(t, len(encData), 3)
+
+	// Wrong magic
+	corruptMagic := make([]byte, len(encData))
+	copy(corruptMagic, encData)
+	corruptMagic[0] = 0x00
+	dr, err := DecryptReader(bytes.NewReader(corruptMagic), key)
+	require.NoError(t, err) // lazy init
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "invalid header")
+
+	// Unsupported version
+	corruptVersion := make([]byte, len(encData))
+	copy(corruptVersion, encData)
+	corruptVersion[2] = 0x02
+	dr, err = DecryptReader(bytes.NewReader(corruptVersion), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "unsupported version")
+}
