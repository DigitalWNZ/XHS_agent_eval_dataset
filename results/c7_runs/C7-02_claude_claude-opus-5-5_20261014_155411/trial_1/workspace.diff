diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1 @@
+WITH a AS (SELECT s.wordid, COUNT(DISTINCT s.synsetid) AS ts, COUNT(*) AS tn, COUNT(DISTINCT y.domainid) AS dd, COUNT(DISTINCT y.posid) AS dp FROM senses s JOIN synsets y ON y.synsetid = s.synsetid GROUP BY s.wordid HAVING ts >= 2 AND dd >= 2 AND tn >= 2), t AS (SELECT w.wordid, w.word, a.ts, a.tn, a.dd, a.dp FROM a JOIN words w ON w.wordid = a.wordid ORDER BY a.tn DESC, a.ts DESC, a.dd DESC, w.wordid ASC LIMIT 500), c AS (SELECT wordid, synsetid, n, ROW_NUMBER() OVER (PARTITION BY wordid ORDER BY n DESC, synsetid ASC) AS rn FROM (SELECT s.wordid, s.synsetid, COUNT(*) AS n FROM senses s WHERE s.wordid IN (SELECT wordid FROM t) GROUP BY s.wordid, s.synsetid)) SELECT t.wordid AS word_id, t.word AS word, t.ts AS total_synsets, t.tn AS total_senses, t.dd AS distinct_domains, t.dp AS distinct_posids, c.synsetid AS top_synsetid, c.n AS top_synset_sense_count FROM t LEFT JOIN c ON c.wordid = t.wordid AND c.rn = 1 ORDER BY t.tn DESC, t.ts DESC, t.dd DESC, t.wordid ASC;
