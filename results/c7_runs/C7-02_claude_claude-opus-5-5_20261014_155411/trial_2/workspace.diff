diff --git a/sol.sql b/sol.sql
new file mode 100644
--- /dev/null
+++ b/sol.sql
@@ -0,0 +1,18 @@
+WITH ws AS (
+  SELECT wordid, synsetid, COUNT(*) AS c FROM senses GROUP BY wordid, synsetid
+),
+agg AS (
+  SELECT ws.wordid, COUNT(*) AS total_synsets, SUM(ws.c) AS total_senses,
+         COUNT(DISTINCT syn.domainid) AS distinct_domains, COUNT(DISTINCT syn.posid) AS distinct_posids,
+         MAX(ws.c * 1000000 - ws.synsetid) AS k
+  FROM ws JOIN synsets syn ON syn.synsetid = ws.synsetid
+  GROUP BY ws.wordid
+  HAVING total_synsets >= 2 AND distinct_domains >= 2
+  ORDER BY total_senses DESC, total_synsets DESC, distinct_domains DESC, ws.wordid ASC
+  LIMIT 500
+)
+SELECT a.wordid AS word_id, w.word AS word, a.total_synsets, a.total_senses, a.distinct_domains, a.distinct_posids,
+       1000000 - a.k % 1000000 AS top_synsetid,
+       a.k / 1000000 + 1 AS top_synset_sense_count
+FROM agg a JOIN words w ON w.wordid = a.wordid
+ORDER BY a.total_senses DESC, a.total_synsets DESC, a.distinct_domains DESC, a.wordid ASC;
