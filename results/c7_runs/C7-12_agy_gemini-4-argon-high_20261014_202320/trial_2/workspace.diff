+const PERSISTER_RESTORE_SYMBOL = Symbol.for(
+  'tanstack.query.persisterRestoreResult',
+)
+
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  data: TData
+  state: Partial<QueryState<any, TError>>
+  readonly [PERSISTER_RESTORE_SYMBOL]: true
+}
+
+export function createPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(result: {
+  data: TData
+  state: Partial<QueryState<any, TError>>
+}): PersisterRestoreResult<TData, TError> {
+  const data = resolveRestoredData(
+    result.data,
+    result.state.data,
+    (result.state as { pageParams?: unknown }).pageParams,
+  ) as TData
+  const state = normalizeRestoredState<TData, TError>(data, result.state)
+  return {
+    data,
+    state,
+    [PERSISTER_RESTORE_SYMBOL]: true,
+  }
+}
+
+export function isPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(value: unknown): value is PersisterRestoreResult<TData, TError> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    PERSISTER_RESTORE_SYMBOL in value &&
+    (value as Record<symbol, unknown>)[PERSISTER_RESTORE_SYMBOL] === true
+  )
+}
+
+export function resolveRestoredData<TData>(
+  data: TData | undefined,
+  stateData: TData | undefined,
+  fallbackPageParams?: unknown,
+): TData | undefined {
+  const candidate = data !== undefined ? data : stateData
+  if (
+    typeof candidate === 'object' &&
+    candidate !== null &&
+    ('pages' in candidate ||
+      'pageParams' in candidate ||
+      (typeof stateData === 'object' &&
+        stateData !== null &&
+        ('pages' in stateData || 'pageParams' in stateData)))
+  ) {
+    const dataRecord =
+      typeof data === 'object' && data !== null
+        ? (data as Record<string, unknown>)
+        : {}
+    const stateDataRecord =
+      typeof stateData === 'object' && stateData !== null
+        ? (stateData as Record<string, unknown>)
+        : {}
+    const dataPageParams = dataRecord.pageParams
+    const statePageParams = stateDataRecord.pageParams
+    const pageParams =
+      Array.isArray(dataPageParams) && dataPageParams.length > 0
+        ? dataPageParams
+        : Array.isArray(statePageParams) && statePageParams.length > 0
+          ? statePageParams
+          : (dataPageParams ?? statePageParams ?? fallbackPageParams)
+    const pages = dataRecord.pages ?? stateDataRecord.pages
+    return {
+      ...stateDataRecord,
+      ...dataRecord,
+      ...(pages !== undefined ? { pages } : {}),
+      ...(pageParams !== undefined ? { pageParams } : {}),
+    } as TData
