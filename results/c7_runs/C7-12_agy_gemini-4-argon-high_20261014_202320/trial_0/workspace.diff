+
+export function createPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(
+  input: PersisterRestoreInput<TData, TError>,
+): PersisterRestoreResult<TData, TError> {
+  const result = {
+    data: input.data,
+    state: input.state,
+  } as PersisterRestoreResult<TData, TError>
+
+  Object.defineProperty(result, PERSISTER_RESTORE_RESULT_SYMBOL, {
+    value: true,
+    enumerable: false,
+    configurable: true,
+  })
+
+  return result
+}
+
+export function isPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(value: unknown): value is PersisterRestoreResult<TData, TError> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    Boolean((value as Record<symbol, unknown>)[PERSISTER_RESTORE_RESULT_SYMBOL])
+  )
+}
+
+export function markPersisterRestoreResultConsumed(
+  value: PersisterRestoreResult<any, any>,
+): void {
+  Object.defineProperty(value, PERSISTER_RESTORE_CONSUMED_SYMBOL, {
+    value: true,
+    enumerable: false,
+    configurable: true,
+  })
+}
+
+export function isPersisterRestoreResultConsumed(
+  value: PersisterRestoreResult<any, any> | undefined,
+): boolean {
+  return Boolean(
+    value &&
+      (value as unknown as Record<symbol, unknown>)[
+        PERSISTER_RESTORE_CONSUMED_SYMBOL
+      ],
+  )
+}
+
+export function normalizeInfiniteQueryData<TData>(
+  data: TData | undefined,
+  fallbackData: unknown,
+): TData | undefined {
+  if (
+    data !== undefined &&
+    typeof data === 'object' &&
+    data !== null &&
+    'pages' in data &&
+    Array.isArray((data as any).pages)
+  ) {
+    const infiniteData = data as unknown as InfiniteData<unknown>
+    const fallbackInfinite =
+      typeof fallbackData === 'object' &&
+      fallbackData !== null &&
+      'pages' in fallbackData
+        ? (fallbackData as InfiniteData<unknown>)
+        : undefined
+    if (
+      (!Array.isArray(infiniteData.pageParams) ||
+        (infiniteData.pageParams.length === 0 &&
+          infiniteData.pages.length > 0)) &&
+      Array.isArray(fallbackInfinite?.pageParams)
+    ) {
+      return {
+        ...infiniteData,
+        pageParams: [...fallbackInfinite.pageParams],
+      } as unknown as TData
+    }
+  }
+  return data
+}
