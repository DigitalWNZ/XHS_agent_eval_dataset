+        queryKey: infiniteKey,
+        queryFn: ({ pageParam }) => Promise.resolve(`p${pageParam}`),
+        initialPageParam: 1,
+        getNextPageParam: (_lastPage, _allPages, lastPageParam) =>
+          lastPageParam < 3 ? lastPageParam + 1 : undefined,
+        persister: () =>
+          Promise.resolve(
