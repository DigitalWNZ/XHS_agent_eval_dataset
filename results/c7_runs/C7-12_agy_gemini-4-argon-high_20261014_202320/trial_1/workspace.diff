+import { provideZonelessChangeDetection } from '@angular/core'
+import { TestBed } from '@angular/core/testing'
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import { queryKey } from '@tanstack/query-test-utils'
+import {
+  QueryCache,
+  QueryClient,
+  createPersisterRestoreResult,
+  injectInfiniteQuery,
+  injectQuery,
+  provideTanStackQuery,
+} from '..'
+
+describe('fine grained persister', () => {
+  let queryCache: QueryCache
+  let queryClient: QueryClient
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    queryCache = new QueryCache()
+    queryClient = new QueryClient({ queryCache })
+    TestBed.configureTestingModule({
+      providers: [
+        provideZonelessChangeDetection(),
+        provideTanStackQuery(queryClient),
+      ],
+    })
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  test('should preserve refetch error state, counters, timestamps, and infinite pagination when restoring from persister', async () => {
+    const key = queryKey()
+    const infiniteKey = queryKey()
+    const now = Date.now()
+    const error = new Error('Persisted refetch error')
+
+    const query = TestBed.runInInjectionContext(() =>
+      injectQuery(() => ({
+        queryKey: key,
+        queryFn: () => Promise.resolve('Fresh data'),
+        persister: () =>
+          Promise.resolve(
+            createPersisterRestoreResult({
+              data: 'Cached data',
+              state: {
+                data: 'Cached data',
+                dataUpdateCount: 2,
+                dataUpdatedAt: now - 1000,
+                error,
+                errorUpdateCount: 3,
+                errorUpdatedAt: now - 500,
+                fetchFailureCount: 2,
+                fetchFailureReason: error,
+                fetchMeta: null,
+                isInvalidated: true,
+                status: 'error',
+                fetchStatus: 'idle',
+              },
+            }),
+          ),
+        staleTime: 10000,
+      })),
+    )
+
+    const infiniteQuery = TestBed.runInInjectionContext(() =>
+      injectInfiniteQuery(() => ({
+        queryKey: infiniteKey,
+        queryFn: ({ pageParam }) => Promise.resolve(`p${pageParam}`),
+        initialPageParam: 1,
+        getNextPageParam: (_lastPage, _allPages, lastPageParam) =>
+          lastPageParam < 3 ? lastPageParam + 1 : undefined,
+        persister: () =>
+          Promise.resolve(
+            createPersisterRestoreResult({
+              data: {
+                pages: ['p1', 'p2'],
+                pageParams: [1, 2],
+              },
+              state: {
+                data: {
+                  pages: ['p1', 'p2'],
+                  pageParams: [1, 2],
+                },
+                dataUpdateCount: 2,
+                dataUpdatedAt: now - 200,
+                error: null,
+                errorUpdateCount: 0,
+                errorUpdatedAt: 0,
+                fetchFailureCount: 0,
+                fetchFailureReason: null,
+                fetchMeta: null,
+                isInvalidated: false,
+                status: 'success',
+                fetchStatus: 'idle',
+              },
+            }),
+          ),
+        staleTime: 10000,
+      })),
+    )
+
+    await vi.advanceTimersByTimeAsync(0)
+
+    expect(query.data()).toBe('Cached data')
+    expect(query.dataUpdatedAt()).toBe(now - 1000)
+    expect(query.error()).toBe(error)
+    expect(query.errorUpdatedAt()).toBe(now - 500)
+    expect(query.errorUpdateCount()).toBe(3)
+    expect(query.failureCount()).toBe(2)
+    expect(query.failureReason()).toBe(error)
+    expect(query.status()).toBe('error')
+    expect(query.fetchStatus()).toBe('idle')
+    expect(query.isError()).toBe(true)
+    expect(query.isRefetchError()).toBe(true)
+    expect(query.isStale()).toBe(true)
+
+    expect(infiniteQuery.data()).toEqual({
+      pages: ['p1', 'p2'],
+      pageParams: [1, 2],
+    })
+    expect(infiniteQuery.dataUpdatedAt()).toBe(now - 200)
+    expect(infiniteQuery.status()).toBe('success')
+    expect(infiniteQuery.fetchStatus()).toBe('idle')
+    expect(infiniteQuery.hasNextPage()).toBe(true)
+  })
+})
