+  })
+
+  const queryCache = new QueryCache()
+  const queryClient = new QueryClient({ queryCache })
+
+  it('should preserve refetch error state, counters, timestamps, and infinite pagination when restoring from persister', async () => {
+    const key = queryKey()
+    const infiniteKey = queryKey()
+    const now = Date.now()
+    const error = new Error('Persisted refetch error')
+
+    let queryResult: ReturnType<typeof useQuery<string, Error>> | undefined
+    let infiniteResult: ReturnType<typeof useInfiniteQuery<string, Error>> | undefined
+
+    function Page() {
+      const q = useQuery(() => ({
+        queryKey: key,
+        queryFn: () => Promise.resolve('Fresh data'),
+        persister: () =>
+          Promise.resolve(
+            createPersisterRestoreResult({
+              data: 'Cached data',
+              state: {
+                data: 'Cached data',
