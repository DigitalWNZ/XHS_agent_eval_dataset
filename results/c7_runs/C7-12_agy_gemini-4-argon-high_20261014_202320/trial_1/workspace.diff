+export function normalizeRestoredQueryState<
+  TData = unknown,
+  TError = DefaultError,
+>(
+  baseState: QueryState<TData, TError> | undefined,
+  result: {
+    data?: TData
+    state?: Partial<QueryState<TData, TError>>
+  },
+  options: QueryOptions<any, any, any, any>,
+): QueryState<TData, TError> {
+  const state = result.state
+  let rawData = result.data !== undefined ? result.data : state?.data
+
+  if (isPlainObject(rawData) && 'pages' in rawData) {
+    const stateData = isPlainObject(state?.data) ? state.data : undefined
+    rawData = {
+      ...stateData,
+      ...rawData,
+      pages: (rawData as any).pages ?? (stateData as any)?.pages ?? [],
+      pageParams:
+        (rawData as any).pageParams ??
+        (stateData as any)?.pageParams ??
+        (state as any)?.pageParams ??
+        [],
+    } as TData
+  }
+
+  const data =
+    rawData === undefined
+      ? undefined
+      : replaceData(baseState?.data, rawData, options)
+
+  const error = (state?.error ?? null) as TError | null
+  const status: QueryStatus =
+    state?.status === 'error' || error !== null
+      ? 'error'
+      : data !== undefined
+        ? 'success'
+        : (state?.status ?? 'pending')
+
+  const dataUpdatedAt =
+    state?.dataUpdatedAt ?? (data !== undefined ? Date.now() : 0)
+  const dataUpdateCount =
+    state?.dataUpdateCount ?? (data !== undefined ? 1 : 0)
+  const errorUpdatedAt =
+    state?.errorUpdatedAt ?? (error !== null ? Date.now() : 0)
+  const errorUpdateCount =
+    state?.errorUpdateCount ?? (error !== null ? 1 : 0)
+
+  const fetchFailureCount =
+    state?.fetchFailureCount ??
+    (state as { failureCount?: number } | undefined)?.failureCount ??
+    0
+  const fetchFailureReason =
+    state?.fetchFailureReason !== undefined
+      ? state.fetchFailureReason
+      : (state as { failureReason?: TError | null } | undefined)
+            ?.failureReason !== undefined
+        ? (state as { failureReason?: TError | null }).failureReason!
+        : error
+
+  return {
+    data,
+    dataUpdateCount,
+    dataUpdatedAt,
+    error,
+    errorUpdateCount,
+    errorUpdatedAt,
+    fetchFailureCount,
+    fetchFailureReason,
+    fetchMeta: state?.fetchMeta ?? null,
+    isInvalidated: state?.isInvalidated ?? false,
+    status,
+    fetchStatus: 'idle',
+  }
+}
+
+export function reconcileRestoredQueryState<
+  TData = unknown,
+  TError = DefaultError,
+>(
+  live: QueryState<TData, TError>,
+  persisted: QueryState<TData, TError>,
+  options: QueryOptions<any, any, any, any>,
+): QueryState<TData, TError> {
+  const isLiveUninitialized =
+    live.data === undefined &&
+    live.error === null &&
+    live.dataUpdatedAt === 0 &&
+    live.errorUpdatedAt === 0 &&
+    live.dataUpdateCount === 0 &&
+    live.errorUpdateCount === 0 &&
+    live.fetchFailureCount === 0 &&
+    !live.isInvalidated
+
+  if (isLiveUninitialized) {
+    return persisted
+  }
+
+  const usePersistedData =
+    persisted.data !== undefined &&
+    (live.data === undefined || persisted.dataUpdatedAt >= live.dataUpdatedAt)
+
+  const data = usePersistedData
+    ? replaceData(live.data, persisted.data as TData, options)
+    : live.data
+  const dataUpdatedAt = usePersistedData
+    ? persisted.dataUpdatedAt
+    : live.dataUpdatedAt
+  const dataUpdateCount = usePersistedData
+    ? persisted.dataUpdateCount
+    : live.dataUpdateCount
+
+  let usePersistedError: boolean
+  if (persisted.errorUpdatedAt !== live.errorUpdatedAt) {
+    usePersistedError = persisted.errorUpdatedAt > live.errorUpdatedAt
+  } else if (persisted.errorUpdatedAt === 0) {
+    if (persisted.error !== null && live.error === null) {
+      usePersistedError = true
+    } else if (live.error !== null && persisted.error === null) {
+      usePersistedError = false
+    } else {
+      usePersistedError = usePersistedData
+    }
+  } else {
+    usePersistedError = usePersistedData
+  }
+
+  const errorSource = usePersistedError ? persisted : live
+  const error = errorSource.error
+  const errorUpdatedAt = errorSource.errorUpdatedAt
+  const errorUpdateCount = errorSource.errorUpdateCount
+  const fetchFailureCount = errorSource.fetchFailureCount
+  const fetchFailureReason = errorSource.fetchFailureReason
+
+  const status: QueryStatus =
+    error !== null || errorSource.status === 'error'
+      ? 'error'
+      : data !== undefined
+        ? 'success'
+        : 'pending'
+
+  const isInvalidated =
+    status === 'error'
+      ? Boolean(
+          errorSource.isInvalidated ||
+            live.isInvalidated ||
+            persisted.isInvalidated,
+        )
+      : persisted.dataUpdatedAt === live.dataUpdatedAt
+        ? Boolean(live.isInvalidated || persisted.isInvalidated)
+        : usePersistedData
+          ? persisted.isInvalidated
+          : live.isInvalidated
+
+  const fetchMeta =
+    (usePersistedError ? persisted.fetchMeta : live.fetchMeta) ??
+    persisted.fetchMeta ??
+    live.fetchMeta ??
+    null
+
+  return {
+    data,
+    dataUpdateCount,
+    dataUpdatedAt,
+    error,
+    errorUpdateCount,
+    errorUpdatedAt,
+    fetchFailureCount,
+    fetchFailureReason,
+    fetchMeta,
+    isInvalidated,
+    status,
+    fetchStatus: 'idle',
+  }
+}
