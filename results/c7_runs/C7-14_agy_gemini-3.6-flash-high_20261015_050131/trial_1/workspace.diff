+func TestSpatialCellStructurePreserved(t *testing.T) {
+	index := NewShapeIndex()
+
+	// Add complex geometry to generate multiple cells
+	for i := 0; i < 20; i++ {
+		lat := float64(i)
+		pl := PolylineFromLatLngs([]LatLng{
+			LatLngFromDegrees(lat, 0),
+			LatLngFromDegrees(lat, 10),
+			LatLngFromDegrees(lat+0.5, 20),
+		})
+		index.Add(pl)
+	}
+	index.Build()
+
+	origCellCount := len(index.cells)
+	if origCellCount == 0 {
+		t.Fatalf("Original index has 0 cells")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if len(decoded.cells) != origCellCount {
+		t.Fatalf("Decoded cell count = %d, want %d", len(decoded.cells), origCellCount)
+	}
+
+	// Verify exact cell IDs match
+	if !reflect.DeepEqual(decoded.cells, index.cells) {
+		t.Fatalf("Decoded cell IDs do not match original cell IDs")
+	}
+
+	// Compare iteration output
+	itOrig := index.Iterator()
+	itDec := decoded.Iterator()
+
+	for !itOrig.Done() {
+		if itDec.Done() {
+			t.Fatalf("Decoded iterator reached end prematurely")
+		}
+		if itOrig.CellID() != itDec.CellID() {
+			t.Fatalf("CellID mismatch: got %v, want %v", itDec.CellID(), itOrig.CellID())
+		}
+		cellOrig := itOrig.IndexCell()
+		cellDec := itDec.IndexCell()
+
+		if len(cellOrig.shapes) != len(cellDec.shapes) {
+			t.Fatalf("Cell %v clipped shape count mismatch: got %d, want %d",
+				itOrig.CellID(), len(cellDec.shapes), len(cellOrig.shapes))
+		}
+
+		for k, csOrig := range cellOrig.shapes {
+			csDec := cellDec.shapes[k]
+			if csOrig.shapeID != csDec.shapeID {
+				t.Fatalf("clippedShape.shapeID mismatch: %d vs %d", csDec.shapeID, csOrig.shapeID)
+			}
+			if csOrig.containsCenter != csDec.containsCenter {
+				t.Fatalf("clippedShape.containsCenter mismatch")
+			}
+			if !reflect.DeepEqual(csOrig.edges, csDec.edges) {
+				t.Fatalf("clippedShape.edges mismatch: %v vs %v", csDec.edges, csOrig.edges)
+			}
+		}
+
+		itOrig.Next()
+		itDec.Next()
+	}
+	if !itDec.Done() {
+		t.Fatalf("Decoded iterator did not reach end")
+	}
+}
