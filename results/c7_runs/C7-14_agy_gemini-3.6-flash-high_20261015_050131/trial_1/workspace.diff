diff --git a/s2/shapeindex.go b/s2/shapeindex.go
index 60f7257..7678e01 100644
--- a/s2/shapeindex.go
+++ b/s2/shapeindex.go
@@ -15,6 +15,8 @@
 package s2
 
 import (
+	"fmt"
+	"io"
 	"math"
 	"slices"
 	"sort"
@@ -1540,3 +1542,298 @@ func maxLevelForEdge(edge Edge) int {
 func (s *ShapeIndex) removeShapeInternal(removed *removedShape, allEdges [][]faceEdge, t *tracker) {
 	// TODO(roberts): finish the implementation of this.
 }
+
+const (
+	maxEncodedShapes                = 10000000
+	maxEncodedCells                 = 10000000
+	maxEncodedClippedShapes         = 1000000
+	maxEncodedEdgesPerClippedShape = 10000000
+)
+
+type encodableShape interface {
+	Encode(w io.Writer) error
+}
+
+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+
+	e.writeUint32(uint32(s.maxEdgesPerCell))
+	e.writeUint32(uint32(s.nextID))
+
+	e.writeUint32(uint32(len(s.shapes)))
+
+	// Sort shape IDs for deterministic output
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		shapeIDs = append(shapeIDs, id)
+	}
+	slices.Sort(shapeIDs)
+
+	for _, id := range shapeIDs {
+		shape := s.shapes[id]
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			e.err = fmt.Errorf("cannot encode shape with typeTagNone (shape ID %d)", id)
+			return
+		}
+
+		e.writeUint32(uint32(id))
+		e.writeUint32(uint32(tag))
+
+		if es, ok := shape.(encodableShape); ok {
+			if err := es.Encode(e.w); err != nil {
+				e.err = err
+				return
+			}
+		} else {
+			e.err = fmt.Errorf("shape ID %d (tag %d) does not implement Encode", id, tag)
+			return
+		}
+	}
+
+	e.writeUint32(uint32(len(s.cells)))
+	for _, cellID := range s.cells {
+		e.writeUint64(uint64(cellID))
+
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.err = fmt.Errorf("missing cellMap entry for cell ID %v", cellID)
+			return
+		}
+
+		e.writeUint32(uint32(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUint32(uint32(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUint32(uint32(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUint32(uint32(edgeID))
+			}
+		}
+	}
+}
+
+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.shapes = make(map[int32]Shape)
+	s.cellMap = make(map[CellID]*ShapeIndexCell)
+	s.cells = nil
+	s.nextID = 0
+	s.pendingRemovals = nil
+	s.pendingAdditionsPos = 0
+
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	if d.err != nil {
+		s.shapes = make(map[int32]Shape)
+		s.cellMap = make(map[CellID]*ShapeIndexCell)
+		s.cells = nil
+		s.nextID = 0
+		s.pendingRemovals = nil
+		s.pendingAdditionsPos = 0
+		atomic.StoreInt32(&s.status, fresh)
+		return d.err
+	}
+
+	atomic.StoreInt32(&s.status, fresh)
+	return nil
+}
+
+func decodeShape(tag typeTag, r io.Reader) (Shape, error) {
+	switch tag {
+	case typeTagPolygon:
+		p := &Polygon{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPolyline:
+		p := &Polyline{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPointVector:
+		p := &PointVector{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolyline:
+		p := &LaxPolyline{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolygon:
+		p := &LaxPolygon{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLoop:
+		l := &Loop{}
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	case typeTagLaxLoop:
+		l := &LaxLoop{}
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	default:
+		return nil, fmt.Errorf("unsupported shape typeTag %d", tag)
+	}
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("cannot decode version %d", version)
+		return
+	}
+
+	maxEdges := d.readUint32()
+	nextID := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	s.maxEdgesPerCell = int(maxEdges)
+	s.nextID = int32(nextID)
+
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+		return
+	}
+
+	s.shapes = make(map[int32]Shape, numShapes)
+	var maxShapeID int32 = -1
+
+	for range numShapes {
+		if d.err != nil {
+			return
+		}
+		shapeID := int32(d.readUint32())
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return
+		}
+
+		shape, err := decodeShape(tag, d.r)
+		if err != nil {
+			d.err = err
+			return
+		}
+
+		s.shapes[shapeID] = shape
+		if shapeID > maxShapeID {
+			maxShapeID = shapeID
+		}
+	}
+
+	if s.nextID <= maxShapeID {
+		s.nextID = maxShapeID + 1
+	}
+	s.pendingAdditionsPos = int32(len(s.shapes))
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	s.cells = make([]CellID, numCells)
+	s.cellMap = make(map[CellID]*ShapeIndexCell, numCells)
+
+	var prevCellID CellID
+	for i := range numCells {
+		if d.err != nil {
+			return
+		}
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if i > 0 && cellID <= prevCellID {
+			d.err = fmt.Errorf("cell IDs out of order or duplicate: %v <= %v", cellID, prevCellID)
+			return
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapes {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, maxEncodedClippedShapes)
+			return
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		for j := range numClipped {
+			if d.err != nil {
+				return
+			}
+			shapeID := int32(d.readUint32())
+			containsCenter := d.readBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			if numEdges > maxEncodedEdgesPerClippedShape {
+				d.err = fmt.Errorf("too many edges in clipped shape (%d)", numEdges)
+				return
+			}
+
+			sh, exists := s.shapes[shapeID]
+			if !exists {
+				d.err = fmt.Errorf("clipped shape references non-existent shape ID %d", shapeID)
+				return
+			}
+
+			cs := newClippedShape(shapeID, int(numEdges))
+			cs.containsCenter = containsCenter
+
+			for k := range numEdges {
+				edgeID := int(d.readUint32())
+				if edgeID < 0 || edgeID >= sh.NumEdges() {
+					d.err = fmt.Errorf("clipped shape edge ID %d out of bounds for shape %d (numEdges=%d)", edgeID, shapeID, sh.NumEdges())
+					return
+				}
+				cs.edges[k] = edgeID
+			}
+
+			cell.shapes[j] = cs
+		}
+
+		s.cells[i] = cellID
+		s.cellMap[cellID] = cell
+	}
+}
