+func TestShapeIndexShapeIDsPreserved(t *testing.T) {
+	index := NewShapeIndex()
+
+	pv := &PointVector{parsePoint("0:0"), parsePoint("1:1")}
+	pl := PolylineFromLatLngs([]LatLng{LatLngFromDegrees(0, 0), LatLngFromDegrees(1, 1)})
+	lp := LaxPolygonFromPoints([][]Point{parsePoints("0:0, 0:2, 2:2, 2:0")})
+
+	id0 := index.Add(pv) // 0
+	id1 := index.Add(pl) // 1
+	id2 := index.Add(lp) // 2
+
+	if id0 != 0 || id1 != 1 || id2 != 2 {
+		t.Fatalf("Assigned shape IDs = %d, %d, %d; want 0, 1, 2", id0, id1, id2)
+	}
+
+	index.Remove(pl) // Remove ID 1
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(0) == nil {
+		t.Errorf("Shape(0) is nil after decode, expected PointVector")
+	}
+	if decoded.Shape(1) != nil {
+		t.Errorf("Shape(1) is not nil after decode, expected removed shape")
+	}
+	if decoded.Shape(2) == nil {
+		t.Errorf("Shape(2) is nil after decode, expected LaxPolygon")
+	}
+
+	// Adding a new shape should get ID 3 (since nextID was 3 or higher)
+	newShape := &PointVector{parsePoint("5:5")}
+	id3 := decoded.Add(newShape)
+	if id3 < 3 {
+		t.Errorf("New shape ID = %d, want >= 3", id3)
+	}
+}
