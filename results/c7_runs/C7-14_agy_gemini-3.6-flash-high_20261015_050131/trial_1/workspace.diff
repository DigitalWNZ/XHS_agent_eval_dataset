+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	if buf.Len() == 0 {
+		t.Fatalf("Expected non-empty byte stream for empty ShapeIndex, got 0 bytes")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Len() != 0 {
+		t.Errorf("Len() = %d, want 0", decoded.Len())
+	}
+	if !decoded.IsFresh() {
+		t.Errorf("IsFresh() = false, want true")
+	}
+	it := decoded.Iterator()
+	if !it.Done() {
+		t.Errorf("Iterator on empty decoded index should be Done immediately")
+	}
+}
+
+func TestShapeIndexEncodeDecodeUnbuilt(t *testing.T) {
+	index := NewShapeIndex()
+	poly := PolygonFromOrientedLoops([]*Loop{
+		RegularLoop(PointFromLatLng(LatLngFromDegrees(0, 0)), s1.Angle(5)*s1.Degree, 4),
+	})
+	index.Add(poly)
+
+	if index.IsFresh() {
+		t.Fatalf("Index should not be fresh before Build")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Errorf("Decoded index IsFresh() = false, want true")
+	}
+	if decoded.Len() != 1 {
+		t.Errorf("Decoded Len() = %d, want 1", decoded.Len())
+	}
+
+	// Verify queries work on decoded index without calling Build()
+	p := PointFromLatLng(LatLngFromDegrees(0, 0))
+	query := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !query.Contains(p) {
+		t.Errorf("ContainsPointQuery failed on decoded unbuilt index")
+	}
+}
