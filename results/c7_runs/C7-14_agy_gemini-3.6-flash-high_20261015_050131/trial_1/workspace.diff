+func TestZeroEdgeShapesAndMixedChains(t *testing.T) {
+	index := NewShapeIndex()
+
+	emptyPoly := &Polygon{}
+	emptyPVec := &PointVector{}
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+	fullLaxPoly := LaxPolygonFromPoints([][]Point{{}}) // 1 loop, 0 vertices -> full polygon
+
+	id0 := index.Add(emptyPoly)
+	id1 := index.Add(emptyPVec)
+	id2 := index.Add(emptyLaxPoly)
+	id3 := index.Add(fullLaxPoly)
+
+	mixedLaxPoly := LaxPolygonFromPoints([][]Point{
+		parsePoints("0:0, 0:3, 3:3, 3:0"), // 4 edges
+		{},                                 // full loop (0 edges)
+		parsePoints("1:1, 1:2, 2:2"),       // 3 edges
+	})
+	id4 := index.Add(mixedLaxPoly)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	s0 := decoded.Shape(id0)
+	if s0 == nil || s0.NumEdges() != 0 || !s0.IsEmpty() {
+		t.Errorf("s0 emptyPoly failed: %v", s0)
+	}
+
+	s1 := decoded.Shape(id1)
+	if s1 == nil || s1.NumEdges() != 0 || !s1.IsEmpty() {
+		t.Errorf("s1 emptyPVec failed: %v", s1)
+	}
+
+	s2 := decoded.Shape(id2)
+	if s2 == nil || s2.NumEdges() != 0 || !s2.IsEmpty() {
+		t.Errorf("s2 emptyLaxPoly failed: %v", s2)
+	}
+
+	s3 := decoded.Shape(id3)
+	if s3 == nil || s3.NumEdges() != 0 || !s3.IsFull() {
+		t.Errorf("s3 fullLaxPoly failed: %v", s3)
+	}
+
+	s4 := decoded.Shape(id4)
+	if s4 == nil || s4.NumChains() != 3 || s4.NumEdges() != 7 {
+		t.Errorf("s4 mixedLaxPoly failed: NumChains=%d (want 3), NumEdges=%d (want 7)", s4.NumChains(), s4.NumEdges())
+	}
+}
