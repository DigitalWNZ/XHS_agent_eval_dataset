+func TestAllBuiltInShapeTypesRoundTrip(t *testing.T) {
+	shapes := []struct {
+		name  string
+		shape Shape
+	}{
+		{
+			name:  "Polygon",
+			shape: PolygonFromOrientedLoops([]*Loop{RegularLoop(PointFromLatLng(LatLngFromDegrees(10, 10)), s1.Angle(2)*s1.Degree, 4)}),
+		},
+		{
+			name:  "Polyline",
+			shape: PolylineFromLatLngs([]LatLng{LatLngFromDegrees(0, 0), LatLngFromDegrees(1, 1), LatLngFromDegrees(2, 0)}),
+		},
+		{
+			name:  "PointVector",
+			shape: &PointVector{parsePoint("0:0"), parsePoint("1:1"), parsePoint("2:2")},
+		},
+		{
+			name:  "LaxPolyline",
+			shape: LaxPolylineFromPoints(parsePoints("0:0, 1:1, 2:2")),
+		},
+		{
+			name:  "LaxPolygon",
+			shape: LaxPolygonFromPoints([][]Point{parsePoints("0:0, 0:2, 2:2, 2:0")}),
+		},
+		{
+			name:  "Loop",
+			shape: RegularLoop(PointFromLatLng(LatLngFromDegrees(20, 20)), s1.Angle(3)*s1.Degree, 5),
+		},
+		{
+			name:  "LaxLoop",
+			shape: LaxLoopFromPoints(parsePoints("0:0, 0:1, 1:1, 1:0")),
+		},
+	}
+
+	for _, tc := range shapes {
+		t.Run(tc.name, func(t *testing.T) {
+			index := NewShapeIndex()
+			id := index.Add(tc.shape)
+			index.Build()
+
+			var buf bytes.Buffer
+			if err := index.Encode(&buf); err != nil {
+				t.Fatalf("Encode failed for %s: %v", tc.name, err)
+			}
+
+			decoded := NewShapeIndex()
+			if err := decoded.Decode(&buf); err != nil {
+				t.Fatalf("Decode failed for %s: %v", tc.name, err)
+			}
+
+			sh := decoded.Shape(id)
+			if sh == nil {
+				t.Fatalf("Shape(%d) is nil for %s", id, tc.name)
+			}
+			if sh.NumEdges() != tc.shape.NumEdges() {
+				t.Errorf("NumEdges() = %d, want %d for %s", sh.NumEdges(), tc.shape.NumEdges(), tc.name)
+			}
+			if sh.Dimension() != tc.shape.Dimension() {
+				t.Errorf("Dimension() = %d, want %d for %s", sh.Dimension(), tc.shape.Dimension(), tc.name)
+			}
+			if sh.NumChains() != tc.shape.NumChains() {
+				t.Errorf("NumChains() = %d, want %d for %s", sh.NumChains(), tc.shape.NumChains(), tc.name)
+			}
+			for i := 0; i < sh.NumEdges(); i++ {
+				e1 := tc.shape.Edge(i)
+				e2 := sh.Edge(i)
+				if !e1.V0.ApproxEqual(e2.V0) || !e1.V1.ApproxEqual(e2.V1) {
+					t.Errorf("Edge(%d) mismatch: got %v, want %v for %s", i, e2, e1, tc.name)
+				}
+			}
+		})
+	}
+}
