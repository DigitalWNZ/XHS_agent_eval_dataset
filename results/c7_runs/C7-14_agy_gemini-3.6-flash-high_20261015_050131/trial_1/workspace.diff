+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("cannot decode version %d", version)
+		return
+	}
+
+	nloops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+
+	loops := make([][]Point, nloops)
+	var totalVerts uint64
+	loopSizes := make([]uint32, nloops)
+	for i := range nloops {
+		sz := d.readUint32()
+		loopSizes[i] = sz
+		totalVerts += uint64(sz)
+	}
+	if d.err != nil {
+		return
+	}
+	if totalVerts > uint64(maxEncodedVertices) {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", totalVerts, maxEncodedVertices)
+		return
+	}
+
+	for i, sz := range loopSizes {
+		pts := make([]Point, sz)
+		for j := range sz {
+			pts[j].X = d.readFloat64()
+			pts[j].Y = d.readFloat64()
+			pts[j].Z = d.readFloat64()
+		}
+		loops[i] = pts
+	}
+	if d.err != nil {
+		return
+	}
+
+	*p = *LaxPolygonFromPoints(loops)
+}
