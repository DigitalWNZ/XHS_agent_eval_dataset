+func TestDecodeMalformedInput(t *testing.T) {
+	// 1. Valid encoded index for base testing
+	index := NewShapeIndex()
+	poly := PolygonFromOrientedLoops([]*Loop{
+		RegularLoop(PointFromLatLng(LatLngFromDegrees(0, 0)), s1.Angle(10)*s1.Degree, 6),
+	})
+	index.Add(poly)
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// 2. Truncated data test
+	for i := 0; i < len(validBytes); i++ {
+		truncated := validBytes[:i]
+		decoded := NewShapeIndex()
+		err := decoded.Decode(bytes.NewReader(truncated))
+		if err == nil {
+			t.Errorf("Truncating to %d/%d bytes succeeded; expected error", i, len(validBytes))
+		}
+	}
+
+	// 3. Invalid version
+	corruptedVersion := append([]byte(nil), validBytes...)
+	corruptedVersion[0] = 99 // unsupported version
+	if err := NewShapeIndex().Decode(bytes.NewReader(corruptedVersion)); err == nil {
+		t.Errorf("Expected error for invalid version, got nil")
+	}
+
+	// 4. Oversized allocation requests
+	testOversized := func(name string, mutate func([]byte) []byte) {
+		t.Run(name, func(t *testing.T) {
+			b := mutate(append([]byte(nil), validBytes...))
+			decoded := NewShapeIndex()
+			if err := decoded.Decode(bytes.NewReader(b)); err == nil {
+				t.Errorf("%s: expected error for oversized count, got nil", name)
+			}
+		})
+	}
+
+	// Mutate numShapes to 0x7FFFFFFF (at byte offset: 1 (version) + 4 (maxEdges) + 4 (nextID) = byte 9)
+	testOversized("OversizedNumShapes", func(b []byte) []byte {
+		binary.LittleEndian.PutUint32(b[9:13], 0x7FFFFFFF)
+		return b
+	})
+
+	// Mutate numCells to 0x7FFFFFFF
+	testOversized("OversizedNumCells", func(b []byte) []byte {
+		var buf2 bytes.Buffer
+		enc := &encoder{w: &buf2}
+		enc.writeInt8(1)           // version
+		enc.writeUint32(10)        // maxEdges
+		enc.writeUint32(0)         // nextID
+		enc.writeUint32(0)         // numShapes = 0
+		enc.writeUint32(0x7FFFFFF) // numCells = huge
+		return buf2.Bytes()
+	})
+}
