+func TestShapeIndexEncodeDecodeBuiltInShapes(t *testing.T) {
+	index := NewShapeIndex()
+
+	pv := &PointVector{PointFromLatLng(LatLngFromDegrees(10, 20)), PointFromLatLng(LatLngFromDegrees(30, 40))}
+	pl := makePolyline("0:0, 0:10, 10:10")
+	pg := makePolygon("0:0, 0:5, 5:5, 5:0", false)
+	lpl := LaxPolylineFromPoints(parsePoints("10:10, 20:20, 30:30"))
+	lpg := LaxPolygonFromPolygon(makePolygon("20:20, 20:25, 25:25, 25:20", false))
+
+	id0 := index.Add(pv)
+	id1 := index.Add(pl)
+	id2 := index.Add(pg)
+	id3 := index.Add(lpl)
+	id4 := index.Add(lpg)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("ShapeIndex.Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("ShapeIndex.Decode failed: %v", err)
+	}
+
+	if got, want := decoded.Len(), 5; got != want {
+		t.Errorf("decoded.Len() = %d, want %d", got, want)
+	}
+
+	s0, ok := decoded.Shape(id0).(*PointVector)
+	if !ok || s0.NumEdges() != pv.NumEdges() {
+		t.Errorf("Shape %d type/edges mismatch: got %v", id0, decoded.Shape(id0))
+	}
+	for i := range *pv {
+		if (*s0)[i] != (*pv)[i] {
+			t.Errorf("PointVector point %d mismatch: got %v, want %v", i, (*s0)[i], (*pv)[i])
+		}
+	}
+
+	s1, ok := decoded.Shape(id1).(*Polyline)
+	if !ok || s1.NumEdges() != pl.NumEdges() {
+		t.Errorf("Shape %d type/edges mismatch: got %v", id1, decoded.Shape(id1))
+	}
+
+	s2, ok := decoded.Shape(id2).(*Polygon)
+	if !ok || s2.NumEdges() != pg.NumEdges() {
+		t.Errorf("Shape %d type/edges mismatch: got %v", id2, decoded.Shape(id2))
+	}
+
+	s3, ok := decoded.Shape(id3).(*LaxPolyline)
+	if !ok || s3.NumEdges() != lpl.NumEdges() {
+		t.Errorf("Shape %d type/edges mismatch: got %v", id3, decoded.Shape(id3))
+	}
+
+	s4, ok := decoded.Shape(id4).(*LaxPolygon)
+	if !ok || s4.NumEdges() != lpg.NumEdges() {
+		t.Errorf("Shape %d type/edges mismatch: got %v", id4, decoded.Shape(id4))
+	}
+
+	// Verify spatial queries work identically on original and decoded
+	pt := PointFromLatLng(LatLngFromDegrees(2, 2))
+	qOrig := NewContainsPointQuery(index, VertexModelSemiOpen)
+	qDec := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+
+	if got, want := qDec.ShapeContains(decoded.Shape(id2), pt), qOrig.ShapeContains(index.Shape(id2), pt); got != want {
+		t.Errorf("qDec.ShapeContains = %v, want %v", got, want)
+	}
+}
