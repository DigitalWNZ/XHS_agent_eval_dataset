@@ -1540,3 +1542,263 @@ func maxLevelForEdge(edge Edge) int {
 func (s *ShapeIndex) removeShapeInternal(removed *removedShape, allEdges [][]faceEdge, t *tracker) {
 	// TODO(roberts): finish the implementation of this.
 }
+
+const (
+	shapeIndexEncodingVersion = int8(1)
+	maxEncodedShapes          = 10000000
+	maxEncodedCells           = 10000000
+	maxClippedShapesPerCell   = 1000000
+	maxEdgesPerClippedShape   = 10000000
+)
+
+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	e := &encoder{w: w}
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	// Write shapes.
+	e.writeUvarint(uint64(len(s.shapes)))
+
+	// Sort shape IDs for deterministic output.
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		shapeIDs = append(shapeIDs, id)
+	}
+	slices.Sort(shapeIDs)
+
+	for _, id := range shapeIDs {
+		shape := s.shapes[id]
+		e.writeUvarint(uint64(id))
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			return fmt.Errorf("cannot encode shape ID %d with typeTagNone", id)
+		}
+		e.writeUint32(uint32(tag))
+		if enc, ok := shape.(interface{ Encode(io.Writer) error }); ok {
+			if err := enc.Encode(e.w); err != nil {
+				return err
+			}
+		} else {
+			return fmt.Errorf("shape type %T for ID %d does not support Encode", shape, id)
+		}
+	}
+
+	// Write cells.
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		cell := s.cellMap[cellID]
+		e.writeUint64(uint64(cellID))
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+
+	return e.err
+}
+
+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.Reset()
+
+	d := &decoder{r: asByteReader(r)}
+	version := d.readInt8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("can't decode ShapeIndex version %d; my version: %d", version, shapeIndexEncodingVersion)
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > 10000 {
+		return fmt.Errorf("invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID > math.MaxInt32 {
+		return fmt.Errorf("nextID %d exceeds MaxInt32", nextID)
+	}
+	s.nextID = int32(nextID)
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numShapes > maxEncodedShapes {
+		return fmt.Errorf("too many shapes in index (%d; max is %d)", numShapes, maxEncodedShapes)
+	}
+	if uint64(s.nextID) < numShapes {
+		return fmt.Errorf("invalid shape count %d for nextID %d", numShapes, s.nextID)
+	}
+
+	s.shapes = make(map[int32]Shape, numShapes)
+	for i := uint64(0); i < numShapes; i++ {
+		id := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if id >= uint64(s.nextID) {
+			return fmt.Errorf("shape ID %d exceeds nextID %d", id, s.nextID)
+		}
+		shapeID := int32(id)
+		if _, exists := s.shapes[shapeID]; exists {
+			return fmt.Errorf("duplicate shape ID %d in encoded stream", shapeID)
+		}
+
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return d.err
+		}
+
+		var shape Shape
+		switch tag {
+		case typeTagPolygon:
+			p := &Polygon{}
+			if err := p.Decode(d.r); err != nil {
+				return fmt.Errorf("decoding Polygon for shape ID %d: %w", shapeID, err)
+			}
+			shape = p
+		case typeTagPolyline:
+			p := &Polyline{}
+			if err := p.Decode(d.r); err != nil {
+				return fmt.Errorf("decoding Polyline for shape ID %d: %w", shapeID, err)
+			}
+			shape = p
+		case typeTagPointVector:
+			p := &PointVector{}
+			if err := p.Decode(d.r); err != nil {
+				return fmt.Errorf("decoding PointVector for shape ID %d: %w", shapeID, err)
+			}
+			shape = p
+		case typeTagLaxPolyline:
+			l := &LaxPolyline{}
+			if err := l.Decode(d.r); err != nil {
+				return fmt.Errorf("decoding LaxPolyline for shape ID %d: %w", shapeID, err)
+			}
+			shape = l
+		case typeTagLaxPolygon:
+			p := &LaxPolygon{}
+			if err := p.Decode(d.r); err != nil {
+				return fmt.Errorf("decoding LaxPolygon for shape ID %d: %w", shapeID, err)
+			}
+			shape = p
+		default:
+			return fmt.Errorf("unknown shape type tag %d for shape ID %d", tag, shapeID)
+		}
+
+		s.shapes[shapeID] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("too many cells in index (%d; max is %d)", numCells, maxEncodedCells)
+	}
+
+	s.cells = make([]CellID, 0, numCells)
+	s.cellMap = make(map[CellID]*ShapeIndexCell, numCells)
+
+	var prevCellID CellID
+	for i := uint64(0); i < numCells; i++ {
+		rawCellID := d.readUint64()
+		if d.err != nil {
+			return d.err
+		}
+		cellID := CellID(rawCellID)
+		if !cellID.IsValid() {
+			return fmt.Errorf("invalid CellID %v in index cell %d", cellID, i)
+		}
+		if i > 0 && cellID <= prevCellID {
+			return fmt.Errorf("index cells out of order: %v <= %v", cellID, prevCellID)
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped > maxClippedShapesPerCell {
+			return fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, maxClippedShapesPerCell)
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		for j := uint64(0); j < numClipped; j++ {
+			rawShapeID := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if rawShapeID >= uint64(s.nextID) {
+				return fmt.Errorf("clipped shape ID %d exceeds nextID %d", rawShapeID, s.nextID)
+			}
+			shapeID := int32(rawShapeID)
+			shape, ok := s.shapes[shapeID]
+			if !ok {
+				return fmt.Errorf("clipped shape references missing shape ID %d", shapeID)
+			}
+
+			containsCenter := d.readBool()
+			if d.err != nil {
+				return d.err
+			}
+
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if numEdges > maxEdgesPerClippedShape {
+				return fmt.Errorf("too many edges in clipped shape (%d; max is %d)", numEdges, maxEdgesPerClippedShape)
+			}
+
+			numShapeEdges := shape.NumEdges()
+			edges := make([]int, numEdges)
+			for k := uint64(0); k < numEdges; k++ {
+				edgeID := d.readUvarint()
+				if d.err != nil {
+					return d.err
+				}
+				if edgeID >= uint64(numShapeEdges) {
+					return fmt.Errorf("edge ID %d out of range for shape %d (num edges: %d)", edgeID, shapeID, numShapeEdges)
+				}
+				edges[k] = int(edgeID)
+			}
+
+			cell.shapes[j] = &clippedShape{
+				shapeID:        shapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			}
+		}
+
+		s.cells = append(s.cells, cellID)
+		s.cellMap[cellID] = cell
+	}
+
+	s.pendingAdditionsPos = s.nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+
+	return nil
+}
+
