+func TestShapeIndexEncodeDecodeZeroEdgesAndMixedChains(t *testing.T) {
+	index := NewShapeIndex()
+
+	pvEmpty := &PointVector{}
+	plEmpty := &Polyline{}
+	lplEmpty := &LaxPolyline{}
+	pgEmpty := makePolygon("", false)
+	lpgEmpty := LaxPolygonFromPoints(nil)
+	lpgFull := LaxPolygonFromPoints([][]Point{{}})
+	lpgMixed := LaxPolygonFromPoints([][]Point{{}, parsePoints("0:0, 0:2, 2:2, 2:0")})
+
+	id0 := index.Add(pvEmpty)
+	id1 := index.Add(plEmpty)
+	id2 := index.Add(lplEmpty)
+	id3 := index.Add(pgEmpty)
+	id4 := index.Add(lpgEmpty)
+	id5 := index.Add(lpgFull)
+	id6 := index.Add(lpgMixed)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	s0 := decoded.Shape(id0)
+	if s0.NumEdges() != 0 || s0.NumChains() != 0 {
+		t.Errorf("s0: NumEdges=%d, NumChains=%d", s0.NumEdges(), s0.NumChains())
+	}
+
+	s1 := decoded.Shape(id1)
+	if s1.NumEdges() != 0 || s1.NumChains() != 0 {
+		t.Errorf("s1: NumEdges=%d, NumChains=%d", s1.NumEdges(), s1.NumChains())
+	}
+
+	s2 := decoded.Shape(id2)
+	if s2.NumEdges() != 0 || s2.NumChains() != 0 {
+		t.Errorf("s2: NumEdges=%d, NumChains=%d", s2.NumEdges(), s2.NumChains())
+	}
+
+	s3 := decoded.Shape(id3)
+	if s3.NumEdges() != 0 || s3.NumChains() != 0 {
+		t.Errorf("s3: NumEdges=%d, NumChains=%d", s3.NumEdges(), s3.NumChains())
+	}
+
+	s4 := decoded.Shape(id4)
+	if s4.NumEdges() != 0 || s4.NumChains() != 0 || !s4.IsEmpty() {
+		t.Errorf("s4: NumEdges=%d, NumChains=%d, IsEmpty=%v", s4.NumEdges(), s4.NumChains(), s4.IsEmpty())
+	}
+
+	s5 := decoded.Shape(id5)
+	if s5.NumEdges() != 0 || s5.NumChains() != 1 || !s5.IsFull() {
+		t.Errorf("s5: NumEdges=%d, NumChains=%d, IsFull=%v", s5.NumEdges(), s5.NumChains(), s5.IsFull())
+	}
+	if ch := s5.Chain(0); ch.Start != 0 || ch.Length != 0 {
+		t.Errorf("s5 chain 0: %v, want Chain{0, 0}", ch)
+	}
+
+	s6 := decoded.Shape(id6)
+	if s6.NumEdges() != 4 || s6.NumChains() != 2 {
+		t.Errorf("s6: NumEdges=%d, NumChains=%d", s6.NumEdges(), s6.NumChains())
+	}
+	if ch0 := s6.Chain(0); ch0.Start != 0 || ch0.Length != 0 {
+		t.Errorf("s6 chain 0: %v, want Chain{0, 0}", ch0)
+	}
+	if ch1 := s6.Chain(1); ch1.Start != 0 || ch1.Length != 4 {
+		t.Errorf("s6 chain 1: %v, want Chain{0, 4}", ch1)
+	}
+}
