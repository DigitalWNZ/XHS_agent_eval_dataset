+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	numLoops := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+
+	loops := make([][]Point, numLoops)
+	var totalVertices uint64
+	for i := uint64(0); i < numLoops; i++ {
+		numVerts := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		totalVertices += numVerts
+		if totalVertices > maxEncodedVertices {
+			d.err = fmt.Errorf("too many total vertices (%d; max is %d)", totalVertices, maxEncodedVertices)
+			return
+		}
+		loops[i] = make([]Point, numVerts)
+	}
+
+	for i := range loops {
+		for j := range loops[i] {
+			loops[i][j].X = d.readFloat64()
+			loops[i][j].Y = d.readFloat64()
+			loops[i][j].Z = d.readFloat64()
+		}
+	}
+
+	if d.err != nil {
+		return
+	}
+
+	*p = *LaxPolygonFromPoints(loops)
+}
