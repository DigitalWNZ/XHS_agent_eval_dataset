+func TestShapeIndexEncodeDecodeWithoutBuild(t *testing.T) {
+	index := NewShapeIndex()
+
+	index.Add(makePolyline("0:0, 0:10"))
+	index.Add(makePolygon("0:0, 0:5, 5:5, 5:0", false))
+
+	// Explicitly DO NOT call index.Build() before Encode.
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Errorf("decoded.IsFresh() = false, want true")
+	}
+
+	var cellCount int
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		cellCount++
+	}
+	if cellCount == 0 {
+		t.Errorf("decoded iterator yielded 0 cells")
+	}
+
+	q := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	pt := PointFromLatLng(LatLngFromDegrees(2, 2))
+	if !q.ShapeContains(decoded.Shape(1), pt) {
+		t.Errorf("ContainsPointQuery failed on decoded index without Build")
+	}
+}
