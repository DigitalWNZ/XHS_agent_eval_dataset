+func TestShapeIndexDecodeMalformedInput(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolyline("0:0, 0:10, 10:10"))
+	index.Add(makePolygon("0:0, 0:5, 5:5, 5:0", false))
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// Truncated data test
+	for i := 0; i < len(validBytes); i++ {
+		decoded := NewShapeIndex()
+		err := decoded.Decode(bytes.NewReader(validBytes[:i]))
+		if err == nil {
+			t.Errorf("Decode(validBytes[:%d]) succeeded, want error", i)
+		}
+	}
+
+	// Corrupted bytes test
+	rng := rand.New(rand.NewSource(42))
+	for i := 0; i < 100; i++ {
+		corrupted := append([]byte(nil), validBytes...)
+		numCorruptions := rng.Intn(5) + 1
+		for c := 0; c < numCorruptions; c++ {
+			idx := rng.Intn(len(corrupted))
+			corrupted[idx] ^= byte(rng.Intn(255) + 1)
+		}
+		decoded := NewShapeIndex()
+		// Must not panic!
+		_ = decoded.Decode(bytes.NewReader(corrupted))
+	}
+
+	// Oversized allocation request test
+	var oversizedBuf bytes.Buffer
+	e := &encoder{w: &oversizedBuf}
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeUvarint(10)          // maxEdgesPerCell
+	e.writeUvarint(100000000)   // nextID
+	e.writeUvarint(999999999)   // numShapes (oversized!)
+	e.writeUvarint(0)           // numCells
+	decoded := NewShapeIndex()
+	err := decoded.Decode(&oversizedBuf)
+	if err == nil {
+		t.Errorf("Decode with oversized numShapes succeeded, want error")
+	}
+}
