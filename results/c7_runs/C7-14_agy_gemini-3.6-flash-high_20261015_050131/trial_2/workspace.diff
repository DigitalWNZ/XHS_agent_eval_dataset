+func TestShapeIndexEncodeDecodeShapeIDsSurvive(t *testing.T) {
+	index := NewShapeIndex()
+
+	s0 := makePolyline("0:0, 0:1")
+	s1 := makePolyline("1:1, 1:2")
+	s2 := makePolyline("2:2, 2:3")
+	s3 := makePolyline("3:3, 3:4")
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+	id3 := index.Add(s3)
+
+	index.Remove(s1)
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(id0) == nil {
+		t.Errorf("Shape %d should be present", id0)
+	}
+	if decoded.Shape(id1) != nil {
+		t.Errorf("Shape %d should be nil (removed)", id1)
+	}
+	if decoded.Shape(id2) == nil {
+		t.Errorf("Shape %d should be present", id2)
+	}
+	if decoded.Shape(id3) == nil {
+		t.Errorf("Shape %d should be present", id3)
+	}
+
+	s4 := makePolyline("4:4, 4:5")
+	id4 := decoded.Add(s4)
+	if id4 != 4 {
+		t.Errorf("decoded.Add returned ID %d, want 4", id4)
+	}
+}
