+func TestShapeIndexEncodeDecodeZeroEdgesAndMixedChains(t *testing.T) {
+	index := NewShapeIndex()
+
+	emptyPtVec := &PointVector{}
+	emptyLaxPline := LaxPolylineFromPoints(nil)
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+	fullLaxPoly := LaxPolygonFromPoints([][]Point{{}})
+	mixedLaxPoly := LaxPolygonFromPoints([][]Point{{}, {PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0), PointFromCoords(0, 0, 1)}})
+
+	fullPoly := makePolygon("full", true)
+
+	id0 := index.Add(emptyPtVec)
+	id1 := index.Add(emptyLaxPline)
+	id2 := index.Add(emptyLaxPoly)
+	id3 := index.Add(fullLaxPoly)
+	id4 := index.Add(mixedLaxPoly)
+	id5 := index.Add(fullPoly)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if got, want := decoded.Len(), 6; got != want {
+		t.Fatalf("decoded.Len() = %d, want %d", got, want)
+	}
+
+	checks := []struct {
+		id        int32
+		numEdges  int
+		numChains int
+		isEmpty   bool
+		isFull    bool
+	}{
+		{id: id0, numEdges: 0, numChains: 0, isEmpty: true, isFull: false},
+		{id: id1, numEdges: 0, numChains: 0, isEmpty: true, isFull: false},
+		{id: id2, numEdges: 0, numChains: 0, isEmpty: true, isFull: false},
+		{id: id3, numEdges: 0, numChains: 1, isEmpty: false, isFull: true},
+		{id: id4, numEdges: 3, numChains: 2, isEmpty: false, isFull: false},
+		{id: id5, numEdges: 0, numChains: 1, isEmpty: false, isFull: true},
+	}
+
+	for _, check := range checks {
+		shape := decoded.Shape(check.id)
+		if shape == nil {
+			t.Fatalf("decoded.Shape(%d) is nil", check.id)
+		}
+		if got := shape.NumEdges(); got != check.numEdges {
+			t.Errorf("Shape(%d).NumEdges() = %d, want %d", check.id, got, check.numEdges)
+		}
+		if got := shape.NumChains(); got != check.numChains {
+			t.Errorf("Shape(%d).NumChains() = %d, want %d", check.id, got, check.numChains)
+		}
+		if got := shape.IsEmpty(); got != check.isEmpty {
+			t.Errorf("Shape(%d).IsEmpty() = %v, want %v", check.id, got, check.isEmpty)
+		}
+		if got := shape.IsFull(); got != check.isFull {
+			t.Errorf("Shape(%d).IsFull() = %v, want %v", check.id, got, check.isFull)
+		}
+	}
+}
