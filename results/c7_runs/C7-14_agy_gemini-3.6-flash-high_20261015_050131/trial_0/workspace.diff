+func (p *LaxPolygon) decode(d *decoder) {
+	*p = LaxPolygon{}
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	numLoops := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+
+	loopLengths := make([]int, numLoops)
+	var totalVertices uint64
+	for i := range numLoops {
+		n := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many loop vertices (%d; max is %d)", n, maxEncodedVertices)
+			return
+		}
+		loopLengths[i] = int(n)
+		totalVertices += n
+		if totalVertices > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", totalVertices, maxEncodedVertices)
+			return
+		}
+	}
+
+	vertices := make([]Point, totalVertices)
+	for i := range vertices {
+		vertices[i].X = d.readFloat64()
+		vertices[i].Y = d.readFloat64()
+		vertices[i].Z = d.readFloat64()
+	}
+	if d.err != nil {
+		return
+	}
+
+	p.numLoops = int(numLoops)
+	switch p.numLoops {
+	case 0:
+		p.numVerts = 0
+		p.vertices = nil
+	case 1:
+		p.numVerts = int(totalVertices)
+		p.vertices = vertices
+	default:
+		p.cumulativeVertices = make([]int, p.numLoops+1)
+		cum := 0
+		for i, l := range loopLengths {
+			p.cumulativeVertices[i] = cum
+			cum += l
+		}
+		p.cumulativeVertices[p.numLoops] = cum
+		p.vertices = vertices
+	}
+}
