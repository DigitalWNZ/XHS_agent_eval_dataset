+func TestShapeIndexEncodeDecodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+
+	s0 := makePolyline("0:0, 1:1")
+	s1 := makePolyline("2:2, 3:3")
+	s2 := makePolyline("4:4, 5:5")
+
+	id0 := index.Add(s0) // 0
+	id1 := index.Add(s1) // 1
+	id2 := index.Add(s2) // 2
+
+	if id0 != 0 || id1 != 1 || id2 != 2 {
+		t.Fatalf("unexpected shape IDs: %d, %d, %d", id0, id1, id2)
+	}
+
+	index.Remove(s0) // Remove shape 0
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(0) != nil {
+		t.Errorf("decoded.Shape(0) = %v, want nil", decoded.Shape(0))
+	}
+
+	if decoded.Shape(1) == nil || decoded.Shape(1).NumEdges() != s1.NumEdges() {
+		t.Errorf("decoded.Shape(1) failed to round-trip properly")
+	}
+
+	if decoded.Shape(2) == nil || decoded.Shape(2).NumEdges() != s2.NumEdges() {
+		t.Errorf("decoded.Shape(2) failed to round-trip properly")
+	}
+
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		cell := it.IndexCell()
+		for _, clipped := range cell.shapes {
+			if clipped.shapeID == 0 {
+				t.Errorf("found removed shape ID 0 in index cell %v", it.CellID())
+			}
+		}
+	}
+}
