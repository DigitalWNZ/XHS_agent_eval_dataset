+
+const (
+	maxEncodedShapes = 10000000
+	maxEncodedCells  = 10000000
+)
+
+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	// Encode shapes for each ID from 0 to nextID - 1
+	for id := int32(0); id < s.nextID; id++ {
+		shape := s.shapes[id]
+		if shape == nil {
+			e.writeUvarint(uint64(typeTagNone))
+			continue
+		}
+
+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			e.err = fmt.Errorf("cannot encode shape of typeTag %d at index %d", tag, id)
+			return
+		}
+
+		e.writeUvarint(uint64(tag))
+		switch sh := shape.(type) {
+		case *Polygon:
+			sh.encode(e)
+		case *Polyline:
+			sh.encode(e)
+		case *PointVector:
+			sh.encode(e)
+		case *LaxPolyline:
+			sh.encode(e)
+		case *LaxPolygon:
+			sh.encode(e)
+		default:
+			if enc, ok := shape.(interface{ Encode(io.Writer) error }); ok {
+				if err := enc.Encode(e.w); err != nil {
+					e.err = err
+					return
+				}
+			} else {
+				e.err = fmt.Errorf("shape at index %d of type %T does not support encoding", id, shape)
+				return
+			}
+		}
+	}
+
+	// Encode spatial cells
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, cs := range cell.shapes {
+			e.writeUvarint(uint64(cs.shapeID))
+			e.writeBool(cs.containsCenter)
+			e.writeUvarint(uint64(len(cs.edges)))
+			for _, edgeID := range cs.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+}
+
+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
