+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	s.Reset()
+
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	maxEdges := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	s.maxEdgesPerCell = int(maxEdges)
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("nextID too large (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+	s.nextID = int32(nextID)
+
+	// Decode shapes
+	s.shapes = make(map[int32]Shape, s.nextID)
+	for id := int32(0); id < s.nextID; id++ {
+		tag := typeTag(d.readUvarint())
+		if d.err != nil {
+			return
+		}
+
+		switch tag {
+		case typeTagNone:
+			s.shapes[id] = nil
+		case typeTagPolygon:
+			p := &Polygon{}
+			if err := p.Decode(d.r); err != nil {
+				d.err = err
+				return
+			}
+			s.shapes[id] = p
+		case typeTagPolyline:
+			p := &Polyline{}
+			if err := p.Decode(d.r); err != nil {
+				d.err = err
+				return
+			}
+			s.shapes[id] = p
+		case typeTagPointVector:
+			p := &PointVector{}
+			if err := p.Decode(d.r); err != nil {
+				d.err = err
+				return
+			}
+			s.shapes[id] = p
+		case typeTagLaxPolyline:
+			l := &LaxPolyline{}
+			if err := l.Decode(d.r); err != nil {
+				d.err = err
+				return
+			}
+			s.shapes[id] = l
+		case typeTagLaxPolygon:
+			l := &LaxPolygon{}
+			if err := l.Decode(d.r); err != nil {
+				d.err = err
+				return
+			}
+			s.shapes[id] = l
+		default:
+			d.err = fmt.Errorf("unsupported shape typeTag %d at index %d", tag, id)
+			return
+		}
+	}
+
+	// Decode spatial cells
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("numCells too large (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	s.cells = make([]CellID, 0, numCells)
+	s.cellMap = make(map[CellID]*ShapeIndexCell, numCells)
+
+	for range numCells {
+		if d.err != nil {
+			return
+		}
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+
+		numClippedShapes := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClippedShapes > maxEncodedShapes {
+			d.err = fmt.Errorf("numClippedShapes too large (%d; max is %d)", numClippedShapes, maxEncodedShapes)
+			return
+		}
+
+		cell := NewShapeIndexCell(0)
+		cell.shapes = make([]*clippedShape, 0, numClippedShapes)
+
+		for range numClippedShapes {
+			if d.err != nil {
+				return
+			}
+			shapeID := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if shapeID >= uint64(s.nextID) {
+				d.err = fmt.Errorf("invalid shapeID %d in cell (nextID is %d)", shapeID, s.nextID)
+				return
+			}
+
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if numEdges > maxEncodedVertices {
+				d.err = fmt.Errorf("numEdges too large (%d; max is %d)", numEdges, maxEncodedVertices)
+				return
+			}
