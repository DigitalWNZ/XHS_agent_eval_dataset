+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:5, 5:5, 5:0", true))
+	index.Add(makePolyline("0:0, 1:1, 2:2"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	validBytes := buf.Bytes()
+
+	// 1. Truncated data: test every prefix length.
+	for i := 0; i < len(validBytes)-1; i++ {
+		decoded := NewShapeIndex()
+		err := decoded.Decode(bytes.NewReader(validBytes[:i]))
+		if err == nil {
+			t.Errorf("Decode(truncated %d/%d bytes) succeeded, want error", i, len(validBytes))
+		}
+	}
+
+	// 2. Corrupted version
+	corruptedVer := append([]byte(nil), validBytes...)
+	corruptedVer[0] = 99
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(corruptedVer)); err == nil {
+		t.Errorf("Decode(corrupted version) succeeded, want error")
+	}
+
+	// 3. Oversized allocation requests
+	var oversizedBuf bytes.Buffer
+	e := &encoder{w: &oversizedBuf}
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(10)        // maxEdgesPerCell
+	e.writeUvarint(100000000) // nextID > maxEncodedShapes
+
+	decoded = NewShapeIndex()
+	if err := decoded.Decode(&oversizedBuf); err == nil {
+		t.Errorf("Decode(oversized nextID) succeeded, want error")
+	}
+}
