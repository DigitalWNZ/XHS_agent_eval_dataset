+func TestShapeIndexEncodeDecodeAllShapeTypes(t *testing.T) {
+	index := NewShapeIndex()
+
+	poly := makePolygon("0:0, 0:5, 5:5, 5:0", true)
+	pline := makePolyline("0:0, 1:1, 2:2")
+	ptVec := &PointVector{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0)}
+	laxPline := LaxPolylineFromPoints([]Point{PointFromCoords(0, 0, 1), PointFromCoords(0, 1, 0)})
+	laxPoly := LaxPolygonFromPoints([][]Point{{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0), PointFromCoords(0, 0, 1)}})
+
+	id0 := index.Add(poly)
+	id1 := index.Add(pline)
+	id2 := index.Add(ptVec)
+	id3 := index.Add(laxPline)
+	id4 := index.Add(laxPoly)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if got, want := decoded.Len(), 5; got != want {
+		t.Fatalf("decoded.Len() = %d, want %d", got, want)
+	}
+
+	expectedIDs := []int32{id0, id1, id2, id3, id4}
+	for _, id := range expectedIDs {
+		origShape := index.Shape(id)
+		decShape := decoded.Shape(id)
+
+		if decShape == nil {
+			t.Fatalf("decoded.Shape(%d) is nil", id)
+		}
+
+		if got, want := decShape.Dimension(), origShape.Dimension(); got != want {
+			t.Errorf("Shape(%d).Dimension() = %d, want %d", id, got, want)
+		}
+
+		if got, want := decShape.NumEdges(), origShape.NumEdges(); got != want {
+			t.Errorf("Shape(%d).NumEdges() = %d, want %d", id, got, want)
+		}
+
+		if got, want := decShape.NumChains(), origShape.NumChains(); got != want {
+			t.Errorf("Shape(%d).NumChains() = %d, want %d", id, got, want)
+		}
+
+		for e := 0; e < origShape.NumEdges(); e++ {
+			if got, want := decShape.Edge(e), origShape.Edge(e); got != want {
+				t.Errorf("Shape(%d).Edge(%d) = %v, want %v", id, e, got, want)
+			}
+		}
+	}
+}
