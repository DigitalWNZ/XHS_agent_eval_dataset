+func TestConsistentHashIREqualsAndValidate(t *testing.T) {
+	var nilIR *consistentHashIR
+	assert.True(t, nilIR.Equals(nilIR))
+	assert.NoError(t, nilIR.Validate())
+
+	out1 := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "X-Test",
+					RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+						Pattern:      "^a(.*)",
+						Substitution: "b\\1",
+					},
+				},
+			},
+		},
+	}, out1))
+
+	out2 := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "X-Test",
+					RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+						Pattern:      "^a(.*)",
+						Substitution: "b\\1",
+					},
+				},
+			},
+		},
+	}, out2))
+
+	out3 := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{},
+	}, out3))
+
+	assert.True(t, out1.consistentHash.Equals(out2.consistentHash))
+	assert.False(t, out1.consistentHash.Equals(out3.consistentHash))
+	assert.False(t, out1.consistentHash.Equals(nilIR))
+	assert.NoError(t, out1.consistentHash.Validate())
+	assert.NoError(t, out3.consistentHash.Validate())
+}
