+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: empty-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "empty.example.com"
+  rules:
+    - name: rule-empty
+      matches:
+        - path:
+            type: PathPrefix
+            value: /empty
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "example.com"
+  rules:
+    - name: rule-merged
+      matches:
+        - path:
+            type: PathPrefix
+            value: /merged
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: rule-disabled
+      matches:
+        - path:
+            type: PathPrefix
+            value: /disabled
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-base-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+  consistentHash:
+    headers:
+      - headerName: x-shared-header
+        terminal: false
+      - headerName: x-route-header
+    cookies:
+      - name: session-cookie
+        ttl: "3600"
+        path: /
+        attributes:
+          - name: SameSite
+            value: Lax
+        terminal: false
+    sourceIp:
+      terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-empty-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: empty-hash-route
+      sectionName: rule-empty
+  consistentHash: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-merged-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule-merged
+  consistentHash:
+    headers:
+      - headerName: X-Shared-Header
+        regexRewrite:
+          pattern: "^prefix-(.*)"
+          substitution: "\\1"
+        terminal: true
+    queryParameters:
+      - name: user_id
+        terminal: false
+    filterState:
+      - key: envoy.network.transport_socket.original_dst_address
+        terminal: false
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-disabled-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule-disabled
+  consistentHash:
+    disable: true
