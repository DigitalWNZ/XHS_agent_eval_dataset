+			},
+			// SourceIp is unset in high priority
+		}, t0, 0, "")
+
+		pLow := makePol("p-low", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared", Terminal: new(false)},
