+func TestConsistentHashMerge(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	makePol := func(name string, ch *kgateway.ConsistentHash, ct time.Time, hPriority int, priority apiannotations.InheritedPolicyPriorityValue) ir.PolicyAtt {
+		outSpec := trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, &outSpec)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind:               gk,
+			PolicyRef:               &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: name},
+			PolicyIr:                &TrafficPolicy{ct: ct, spec: outSpec},
+			HierarchicalPriority:    hPriority,
+			InheritedPolicyPriority: priority,
+		}
+	}
+
+	t0 := time.Now()
