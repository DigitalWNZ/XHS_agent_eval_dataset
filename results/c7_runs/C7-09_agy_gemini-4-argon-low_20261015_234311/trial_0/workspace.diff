+package kgateway
+
+// ConsistentHash configures per-route consistent hash policies on Envoy RouteAction.
+// +kubebuilder:validation:XValidation:rule="!has(self.disable) || !self.disable || (!has(self.headers) && !has(self.cookies) && !has(self.queryParameters) && !has(self.filterState) && !has(self.sourceIp))",message="when disable is true, no other consistentHash fields may be set"
+type ConsistentHash struct {
+	// Disable suppresses consistent hashing on a route.
+	// When true, no other fields may be set, no hash policies are produced, and any
+	// inherited from broader-scoped policies are suppressed.
+	// +optional
+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers specifies request headers to use for consistent hashing.
+	// +optional
+	Headers []ConsistentHashHeader `json:"headers,omitempty"`
+
+	// Cookies specifies cookies to use for consistent hashing.
+	// +optional
+	Cookies []ConsistentHashCookie `json:"cookies,omitempty"`
+
+	// QueryParameters specifies URL query parameters to use for consistent hashing.
+	// +optional
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies per-request filterState keys to use for consistent hashing.
+	// +optional
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIp configures consistent hashing based on the request's source IP address.
+	// +optional
+	SourceIp *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader configures a header-based hash policy.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the request header that will be used to obtain the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	HeaderName string `json:"headerName"`
+
+	// RegexRewrite, if specified, rewrites the request header value using a regular expression
+	// before producing the hash key.
+	// +optional
+	RegexRewrite *ConsistentHashRegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal, if true and a hash key is available after evaluating this policy, causes Envoy
+	// to skip subsequent policies and use the key as-is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashRegexRewrite specifies how to rewrite a header value using a regular expression.
+type ConsistentHashRegexRewrite struct {
+	// Pattern is the regex pattern to match against the header value.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Pattern string `json:"pattern"`
+
+	// Substitution is the replacement string for the matched pattern.
+	// +optional
+	Substitution string `json:"substitution,omitempty"`
+}
+
+// ConsistentHashCookie configures a cookie-based hash policy.
+type ConsistentHashCookie struct {
+	// Name is the name of the cookie that will be used to obtain the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// TTL specifies the time to live of the cookie as a Go duration string (e.g. "1h30m")
+	// or plain integer seconds (e.g. "3600"). If specified, a cookie with the TTL will be
+	// generated if the cookie is not present.
+	// +optional
+	TTL *string `json:"ttl,omitempty"`
+
+	// Path is the name of the path for the cookie.
+	// +optional
+	Path *string `json:"path,omitempty"`
+
+	// Attributes specifies additional attributes (such as SameSite, Secure, etc.) for the cookie
+	// when generating a new cookie.
+	// +optional
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal, if true and a hash key is available after evaluating this policy, causes Envoy
+	// to skip subsequent policies and use the key as-is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute defines an additional attribute for an HTTP cookie.
+type ConsistentHashCookieAttribute struct {
+	// Name is the name of the cookie attribute.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// Value is the optional value of the cookie attribute.
+	// +optional
+	Value string `json:"value,omitempty"`
+}
+
+// ConsistentHashQueryParameter configures a query-parameter-based hash policy.
+type ConsistentHashQueryParameter struct {
+	// Name is the name of the URL query parameter that will be used to obtain the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Name string `json:"name"`
+
+	// Terminal, if true and a hash key is available after evaluating this policy, causes Envoy
+	// to skip subsequent policies and use the key as-is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState configures a filter-state-based hash policy.
+type ConsistentHashFilterState struct {
+	// Key is the name of the Object in the per-request filterState.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	Key string `json:"key"`
+
+	// Terminal, if true and a hash key is available after evaluating this policy, causes Envoy
+	// to skip subsequent policies and use the key as-is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashSourceIP configures a source-IP-based hash policy.
+type ConsistentHashSourceIP struct {
+	// Terminal, if true and a hash key is available after evaluating this policy, causes Envoy
+	// to skip subsequent policies and use the key as-is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
