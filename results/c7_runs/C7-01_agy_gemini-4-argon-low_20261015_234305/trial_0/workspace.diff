diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..f66a5cfe
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,376 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import { type DriverValueDecoder, noopDecoder, SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameBoundaryType =
+	| 'unbounded preceding'
+	| 'preceding'
+	| 'current row'
+	| 'following'
+	| 'unbounded following';
+
+const boundaryOrder: Record<WindowFrameBoundaryType, number> = {
+	'unbounded preceding': 0,
+	preceding: 1,
+	'current row': 2,
+	following: 3,
+	'unbounded following': 4,
+};
+
+export interface WindowFrameBoundary {
+	readonly type: WindowFrameBoundaryType;
+	readonly offset?: number;
+}
+
+export const unboundedPreceding: WindowFrameBoundary = {
+	type: 'unbounded preceding',
+};
+
+export const currentRow: WindowFrameBoundary = {
+	type: 'current row',
+};
+
+export const unboundedFollowing: WindowFrameBoundary = {
+	type: 'unbounded following',
+};
+
+function validateBoundaryOffset(fnName: string, offset: number): void {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`${fnName}() requires a non-negative integer offset, received ${offset}`);
+	}
+}
+
+export function preceding(offset: number): WindowFrameBoundary {
+	validateBoundaryOffset('preceding', offset);
+	return {
+		type: 'preceding',
+		offset,
+	};
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	validateBoundaryOffset('following', offset);
+	return {
+		type: 'following',
+		offset,
+	};
+}
+
+export interface WindowFrameBounds {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+export interface WindowFrame {
+	readonly mode: 'rows' | 'range';
+	readonly from: WindowFrameBoundary;
+	readonly to: WindowFrameBoundary;
+}
+
+function validateFrameBounds(fnName: string, bounds: WindowFrameBounds): void {
+	const fromRank = boundaryOrder[bounds.from.type];
+	const toRank = boundaryOrder[bounds.to.type];
+	if (fromRank === undefined || toRank === undefined) {
+		throw new Error(`${fnName}() received an invalid frame boundary in "from" or "to"`);
+	}
+	if (fromRank > toRank) {
+		throw new Error(
+			`${fnName}() frame "from" boundary (${bounds.from.type}) must not be ordered after "to" boundary (${bounds.to.type})`,
+		);
+	}
+}
+
+export function rows(bounds: WindowFrameBounds): WindowFrame {
+	validateFrameBounds('rows', bounds);
+	return {
+		mode: 'rows',
+		from: bounds.from,
+		to: bounds.to,
+	};
+}
+
+export function range(bounds: WindowFrameBounds): WindowFrame {
+	validateFrameBounds('range', bounds);
+	return {
+		mode: 'range',
+		from: bounds.from,
+		to: bounds.to,
+	};
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not be whitespace only');
+	}
+}
+
+function buildBoundarySQL(boundary: WindowFrameBoundary): SQL {
+	switch (boundary.type) {
+		case 'unbounded preceding': {
+			return sql.raw('unbounded preceding');
+		}
+		case 'preceding': {
+			return sql.raw(`${boundary.offset} preceding`);
+		}
+		case 'current row': {
+			return sql.raw('current row');
+		}
+		case 'following': {
+			return sql.raw(`${boundary.offset} following`);
+		}
+		case 'unbounded following': {
+			return sql.raw('unbounded following');
+		}
+	}
+}
+
+export function buildWindowSpecSQL(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const items = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (items.length > 0) {
+			parts.push(sql`partition by ${sql.join(items, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const items = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (items.length > 0) {
+			parts.push(sql`order by ${sql.join(items, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		const fromSql = buildBoundarySQL(spec.frame.from);
+		const toSql = buildBoundarySQL(spec.frame.to);
+		parts.push(sql`${sql.raw(spec.frame.mode)} between ${fromSql} and ${toSql}`);
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function buildWindowsClauseSQL(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+	const defs = windows.map((w) => sql`${sql.identifier(w.name)} as (${buildWindowSpecSQL(w.spec)})`);
+	return sql` window ${sql.join(defs, sql`, `)}`;
+}
+
+export class WindowFunction<T> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	constructor(
+		private readonly expr: SQL,
+		private readonly decoder: DriverValueDecoder<T, any> = noopDecoder,
+	) {}
+
+	over(specOrName?: WindowSpec | string): SQL<T> {
+		let overClause: SQL;
+		if (typeof specOrName === 'string') {
+			validateWindowName(specOrName);
+			overClause = sql`over ${sql.identifier(specOrName)}`;
+		} else {
+			overClause = sql`over (${buildWindowSpecSQL(specOrName)})`;
+		}
+
+		const result = sql`${this.expr} ${overClause}`;
+		return result.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+function validatePositiveInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() requires a positive integer argument, received ${value}`);
+	}
+}
+
+function validateNonNegativeInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${fnName}() requires a non-negative integer offset, received ${value}`);
+	}
+}
+
+export type InferWindowExprType<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+function getExprDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+// Ranking helpers
+
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`row_number()`, { mapFromDriverValue: Number });
+}
+
+export function rank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`rank()`, { mapFromDriverValue: Number });
+}
+
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`dense_rank()`, { mapFromDriverValue: Number });
+}
+
+export function ntile(buckets: number): WindowFunction<number> {
+	validatePositiveInteger('ntile', buckets);
+	return new WindowFunction<number>(sql`ntile(${sql.raw(String(buckets))})`, { mapFromDriverValue: Number });
+}
+
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`percent_rank()`, { mapFromDriverValue: Number });
+}
+
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction<number>(sql`cume_dist()`, { mapFromDriverValue: Number });
+}
+
+// Offset / Value-access helpers
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<InferWindowExprType<T> | null>;
+export function lag<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	| Exclude<InferWindowExprType<T>, null>
+	| (TDefault extends null ? null : TDefault extends SQLWrapper ? InferWindowExprType<TDefault> : TDefault)
+>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const args: SQLChunk[] = [expression];
+	if (offset !== undefined) {
+		validateNonNegativeInteger('lag', offset);
+		args.push(sql.raw(String(offset)));
+		if (defaultValue !== undefined) {
+			args.push(bindIfParam(defaultValue, expression));
+		}
+	} else if (defaultValue !== undefined) {
+		args.push(sql.raw('1'), bindIfParam(defaultValue, expression));
+	}
+	return new WindowFunction(sql`lag(${sql.join(args, sql`, `)})`, getExprDecoder(expression));
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<InferWindowExprType<T> | null>;
+export function lead<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	| Exclude<InferWindowExprType<T>, null>
+	| (TDefault extends null ? null : TDefault extends SQLWrapper ? InferWindowExprType<TDefault> : TDefault)
+>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const args: SQLChunk[] = [expression];
+	if (offset !== undefined) {
+		validateNonNegativeInteger('lead', offset);
+		args.push(sql.raw(String(offset)));
+		if (defaultValue !== undefined) {
+			args.push(bindIfParam(defaultValue, expression));
+		}
+	} else if (defaultValue !== undefined) {
+		args.push(sql.raw('1'), bindIfParam(defaultValue, expression));
+	}
+	return new WindowFunction(sql`lead(${sql.join(args, sql`, `)})`, getExprDecoder(expression));
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<InferWindowExprType<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, getExprDecoder(expression));
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<InferWindowExprType<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, getExprDecoder(expression));
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<InferWindowExprType<T> | null> {
+	validatePositiveInteger('nthValue', n);
+	return new WindowFunction(sql`nth_value(${expression}, ${sql.raw(String(n))})`, getExprDecoder(expression));
+}
+
+// Aggregate window helpers
+
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, { mapFromDriverValue: String });
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, { mapFromDriverValue: String });
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	) as any;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	) as any;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression || sql.raw('*')})`, { mapFromDriverValue: Number });
+}
