+    def test_has_key_number(self):
+        obj = NullableJSONModel.objects.create(
+            value={
+                "1111": "value",
+                "2222": "value",
+                "foo": "value",
+            }
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_key="1111"),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_key=1111),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_keys=["1111", "2222"]),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_keys=[1111, 2222]),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_keys=["1111", "foo"]),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_keys=[1111, "foo"]),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_any_keys=["1111", "9999"]),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_any_keys=[1111, 9999]),
+            [obj],
+        )
+        self.assertSequenceEqual(
+            NullableJSONModel.objects.filter(value__has_any_keys=["1111", "foo"]),
+            [self.objs[6], self.objs[7], obj],
+        )
+        self.assertSequenceEqual(
