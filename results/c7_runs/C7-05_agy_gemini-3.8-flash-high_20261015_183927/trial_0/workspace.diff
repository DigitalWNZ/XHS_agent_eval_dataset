diff --git a/test_scratch.py b/test_scratch.py
new file mode 100644
index 0000000000..e015be47b8
--- /dev/null
+++ b/test_scratch.py
@@ -0,0 +1,100 @@
+from django.conf import settings
+if not settings.configured:
+    settings.configure(
+        DATABASES={
+            "default": {
+                "ENGINE": "django.db.backends.sqlite3",
+                "NAME": ":memory:",
+            }
+        },
+        INSTALLED_APPS=[
+            "django.contrib.contenttypes",
+            "django.contrib.auth",
+            "tests.model_fields",
+        ],
+        DEFAULT_AUTO_FIELD="django.db.models.AutoField",
+    )
+import django
+django.setup()
+
+from django.db import connection
+from django.db.models import F, Q
+from django.db.models.fields.json import HasKey, HasKeys, HasAnyKeys, KeyTransform
+from django.db.models.sql import Query
+from tests.model_fields.models import NullableJSONModel
+
+query = Query(NullableJSONModel)
+compiler = query.get_compiler(connection=connection)
+
+# Test HasKey on SQLite
+lookup = HasKey(NullableJSONModel._meta.get_field("value"), "1111")
+sql, params = lookup.as_sqlite(compiler, connection)
+print("SQLite has_key sql:", sql, params)
+assert "JSON_TYPE" in sql
+assert params[-1] == '$."1111"'
+
+# Test HasKeys on SQLite
+lookup = HasKeys(NullableJSONModel._meta.get_field("value"), ["1111", "2222"])
+sql, params = lookup.as_sqlite(compiler, connection)
+print("SQLite has_keys sql:", sql, params)
+assert " AND " in sql
+assert params[-2:] == ('$."1111"', '$."2222"')
+
+# Test HasAnyKeys on SQLite
+lookup = HasAnyKeys(NullableJSONModel._meta.get_field("value"), ["1111", "2222"])
+sql, params = lookup.as_sqlite(compiler, connection)
+print("SQLite has_any_keys sql:", sql, params)
+assert " OR " in sql
+assert params[-2:] == ('$."1111"', '$."2222"')
+
+# Test HasKey on MySQL
+class MySQLConnection:
+    vendor = "mysql"
+    mysql_is_mariadb = False
+lookup = HasKey(NullableJSONModel._meta.get_field("value"), "1111")
+sql, params = lookup.as_mysql(compiler, MySQLConnection())
+print("MySQL has_key sql:", sql, params)
+assert "JSON_CONTAINS_PATH" in sql
+assert params[-1] == '$."1111"'
+
+# Test HasKeys on MySQL
+lookup = HasKeys(NullableJSONModel._meta.get_field("value"), ["1111", "2222"])
+sql, params = lookup.as_mysql(compiler, MySQLConnection())
+print("MySQL has_keys sql:", sql, params)
+assert "JSON_CONTAINS_PATH" in sql and " AND " in sql
+assert params[-2:] == ('$."1111"', '$."2222"')
+
+# Test HasAnyKeys on MySQL
+lookup = HasAnyKeys(NullableJSONModel._meta.get_field("value"), ["1111", "2222"])
+sql, params = lookup.as_mysql(compiler, MySQLConnection())
+print("MySQL has_any_keys sql:", sql, params)
+assert "JSON_CONTAINS_PATH" in sql and " OR " in sql
+assert params[-2:] == ('$."1111"', '$."2222"')
+
+# Test HasKey on Oracle
+class OracleConnection:
+    vendor = "oracle"
+lookup = HasKey(NullableJSONModel._meta.get_field("value"), "1111")
+sql, params = lookup.as_oracle(compiler, OracleConnection())
+print("Oracle has_key sql:", sql, params)
+assert "JSON_EXISTS" in sql
+assert '$."1111"' in sql
+assert params == []
+
+# Test HasKeys on Oracle
+lookup = HasKeys(NullableJSONModel._meta.get_field("value"), ["1111", "2222"])
+sql, params = lookup.as_oracle(compiler, OracleConnection())
+print("Oracle has_keys sql:", sql, params)
+assert "JSON_EXISTS" in sql and " AND " in sql
+assert '$."1111"' in sql and '$."2222"' in sql
+assert params == []
+
+# Test HasAnyKeys on Oracle
+lookup = HasAnyKeys(NullableJSONModel._meta.get_field("value"), ["1111", "2222"])
+sql, params = lookup.as_oracle(compiler, OracleConnection())
+print("Oracle has_any_keys sql:", sql, params)
+assert "JSON_EXISTS" in sql and " OR " in sql
+assert '$."1111"' in sql and '$."2222"' in sql
+assert params == []
+
+print("ALL BACKEND SQL CHECKS PASSED!")
