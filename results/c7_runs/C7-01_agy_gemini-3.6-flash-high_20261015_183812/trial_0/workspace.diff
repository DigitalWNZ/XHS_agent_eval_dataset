new file mode 100644
index 00000000..919d9261
--- /dev/null
+++ b/drizzle-orm/src/sql/expressions/window.ts
@@ -0,0 +1,312 @@
+import type { GetColumnData } from '~/column.ts';
+import { Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { isSQLWrapper, Name, sql, SQL, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export interface FrameBoundary {
+	readonly order: number;
+	getSQL(): SQL;
+}
+
+export const unboundedPreceding: FrameBoundary = {
+	order: -Infinity,
+	getSQL() {
+		return sql`unbounded preceding`;
+	},
+};
+
+export const currentRow: FrameBoundary = {
+	order: 0,
+	getSQL() {
+		return sql`current row`;
+	},
+};
+
+export const unboundedFollowing: FrameBoundary = {
+	order: Infinity,
+	getSQL() {
+		return sql`unbounded following`;
+	},
+};
+
+export function preceding(n: number): FrameBoundary {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 0) {
+		throw new Error(`preceding expects a non-negative integer, received ${n}`);
+	}
+	return {
+		order: -n,
+		getSQL() {
+			return sql`${sql.raw(String(n))} preceding`;
+		},
+	};
+}
+
+export function following(n: number): FrameBoundary {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 0) {
+		throw new Error(`following expects a non-negative integer, received ${n}`);
+	}
+	return {
+		order: n,
+		getSQL() {
+			return sql`${sql.raw(String(n))} following`;
+		},
+	};
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	readonly type: 'rows' | 'range';
+	readonly spec: FrameSpec;
+
+	constructor(type: 'rows' | 'range', spec: FrameSpec) {
+		this.type = type;
+		this.spec = spec;
+		if (spec.from && spec.to && spec.from.order > spec.to.order) {
+			throw new Error('Invalid frame specification: "from" boundary cannot be ordered after "to" boundary');
+		}
+	}
+
+	getSQL(): SQL {
+		const typeSql = sql.raw(this.type);
+		if (this.spec.to) {
+			return sql`${typeSql} between ${this.spec.from.getSQL()} and ${this.spec.to.getSQL()}`;
+		}
+		return sql`${typeSql} ${this.spec.from.getSQL()}`;
+	}
+}
+
+export function rows(spec: FrameSpec | FrameBoundary): WindowFrame {
+	const frameSpec: FrameSpec = 'getSQL' in spec ? { from: spec as FrameBoundary } : (spec as FrameSpec);
+	return new WindowFrame('rows', frameSpec);
+}
+
+export function range(spec: FrameSpec | FrameBoundary): WindowFrame {
+	const frameSpec: FrameSpec = 'getSQL' in spec ? { from: spec as FrameBoundary } : (spec as FrameSpec);
+	return new WindowFrame('range', frameSpec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[] | SQL;
+	orderBy?: SQLWrapper | SQLWrapper[] | SQL;
+	frame?: WindowFrame | FrameSpec;
+}
+
+export function windowSpecToSql(spec: WindowSpec): SQL {
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionByParts = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByParts.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByParts, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderByParts = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByParts.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByParts, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		const frameObj = is(spec.frame, WindowFrame)
+			? (spec.frame as WindowFrame)
+			: new WindowFrame('rows', spec.frame as FrameSpec);
+		parts.push(frameObj.getSQL());
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function overToSql(spec?: WindowSpec | string): SQL {
+	if (spec === undefined) {
+		return sql` over ()`;
+	}
+
+	if (typeof spec === 'string') {
+		if (spec.length === 0) {
+			throw new Error('Window name must be a non-empty string');
+		}
+		if (spec.trim().length === 0) {
+			throw new Error('Window name cannot be whitespace-only');
+		}
+		return sql` over ${sql.identifier(spec)}`;
+	}
+
+	const inner = windowSpecToSql(spec);
+	if (inner.queryChunks.length === 0) {
+		return sql` over ()`;
+	}
+
+	return sql` over (${inner})`;
+}
+
+export class WindowBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	constructor(
+		private fnSql: SQL,
+		private decoder?: any,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		const result = sql`${this.fnSql}${overToSql(spec)}`;
+		if (this.decoder) {
+			result.mapWith(this.decoder);
+		}
+		return result as SQL<T>;
+	}
+}
+
+export type GetSQLType<T> = T extends Column<any> ? GetColumnData<T>
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: T extends SQLWrapper ? unknown
+	: T;
+
+// Ranking helpers
+export function rowNumber(): WindowBuilder<number> {
+	return new WindowBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number): WindowBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile expects a positive integer, received ${n}`);
+	}
+	return new WindowBuilder(sql`ntile(${sql.raw(String(n))})`, Number);
+}
+
+export function percentRank(): WindowBuilder<string> {
+	return new WindowBuilder(sql`percent_rank()`, String);
+}
+
+export function cumeDist(): WindowBuilder<string> {
+	return new WindowBuilder(sql`cume_dist()`, String);
+}
+
+// Offset helpers
+export function lag<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowBuilder<GetSQLType<T> | null>;
+export function lag<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset: number | undefined,
+	defaultValue: TDefault | SQLWrapper,
+): WindowBuilder<NonNullable<GetSQLType<T>> | GetSQLType<TDefault>>;
+export function lag(
+	value: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowBuilder<any> {
+	const decoder = is(value, Column) ? value : undefined;
+	const chunks: SQLChunk[] = [sql`lag(`, value];
+
+	if (offset !== undefined || defaultValue !== undefined) {
+		const offsetNum = offset ?? 1;
+		chunks.push(sql`, ${sql.raw(String(offsetNum))}`);
+		if (defaultValue !== undefined) {
+			const defaultChunk = isSQLWrapper(defaultValue) ? defaultValue : sql`${defaultValue}`;
+			chunks.push(sql`, ${defaultChunk}`);
+		}
+	}
+	chunks.push(sql`)`);
+
+	return new WindowBuilder(sql.join(chunks), decoder);
+}
+
+export function lead<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowBuilder<GetSQLType<T> | null>;
+export function lead<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset: number | undefined,
+	defaultValue: TDefault | SQLWrapper,
+): WindowBuilder<NonNullable<GetSQLType<T>> | GetSQLType<TDefault>>;
+export function lead(
+	value: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowBuilder<any> {
+	const decoder = is(value, Column) ? value : undefined;
+	const chunks: SQLChunk[] = [sql`lead(`, value];
+
+	if (offset !== undefined || defaultValue !== undefined) {
+		const offsetNum = offset ?? 1;
+		chunks.push(sql`, ${sql.raw(String(offsetNum))}`);
+		if (defaultValue !== undefined) {
+			const defaultChunk = isSQLWrapper(defaultValue) ? defaultValue : sql`${defaultValue}`;
+			chunks.push(sql`, ${defaultChunk}`);
+		}
+	}
+	chunks.push(sql`)`);
+
+	return new WindowBuilder(sql.join(chunks), decoder);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	value: T,
+): WindowBuilder<GetSQLType<T> | null> {
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(sql`first_value(${value})`, decoder);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	value: T,
+): WindowBuilder<GetSQLType<T> | null> {
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(sql`last_value(${value})`, decoder);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	n: number,
+): WindowBuilder<GetSQLType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue expects a positive integer, received ${n}`);
+	}
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(sql`nth_value(${value}, ${sql.raw(String(n))})`, decoder);
+}
+
+// Aggregate helpers
+export function windowSum(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(expression: T): WindowBuilder<GetSQLType<T> | null> {
+	const decoder = is(expression, Column) ? expression : String;
+	return new WindowBuilder(sql`min(${expression})`, decoder);
+}
+
+export function windowMax<T extends SQLWrapper>(expression: T): WindowBuilder<GetSQLType<T> | null> {
+	const decoder = is(expression, Column) ? expression : String;
+	return new WindowBuilder(sql`max(${expression})`, decoder);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowBuilder<number> {
+	return new WindowBuilder(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
