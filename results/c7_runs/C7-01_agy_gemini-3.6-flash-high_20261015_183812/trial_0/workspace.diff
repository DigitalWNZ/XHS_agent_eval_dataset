+import type { Equal } from 'type-tests/utils.ts';
+import { Expect } from 'type-tests/utils.ts';
+import {
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	rowNumber,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import type { SQL } from '~/sql/sql.ts';
+
+const users = pgTable('users', {
+	id: integer('id').notNull(),
+	name: text('name').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+// Test rowNumber
+const rn = rowNumber().over();
+Expect<Equal<typeof rn, SQL<number>>>;
+
+// Test windowCount
+const wc = windowCount().over();
+Expect<Equal<typeof wc, SQL<number>>>;
+
+// Test windowSum
+const ws = windowSum(users.salary).over();
+Expect<Equal<typeof ws, SQL<string | null>>>;
+
+// Test windowAvg
+const wa = windowAvg(users.salary).over();
+Expect<Equal<typeof wa, SQL<string | null>>>;
+
+// Test firstValue (value access functions typed nullable)
+const fv = firstValue(users.name).over();
+Expect<Equal<typeof fv, SQL<string | null>>>;
+
+const lv = lastValue(users.salary).over();
+Expect<Equal<typeof lv, SQL<number | null>>>;
+
+const nv = nthValue(users.salary, 2).over();
+Expect<Equal<typeof nv, SQL<number | null>>>;
+
+// Test lag without default value (typed nullable)
+const lagNoDefault = lag(users.name).over();
+Expect<Equal<typeof lagNoDefault, SQL<string | null>>>;
+
+// Test lag with default value (null stripped!)
+const lagWithDefault = lag(users.name, 1, 'none').over();
+Expect<Equal<typeof lagWithDefault, SQL<string>>>;
+
+const leadWithDefault = lead(users.salary, 1, 0).over();
+Expect<Equal<typeof leadWithDefault, SQL<number>>>;
