+const pgDialect = new PgDialect();
+const mysqlDialect = new MySqlDialect();
+const sqliteDialect = new SQLiteDialect();
+
+const users = pgTable('users', {
+	id: integer('id').primaryKey(),
+	name: text('name').notNull(),
+	dept: text('dept').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+const mysqlUsers = mysqlTable('users', {
+	id: int('id').primaryKey(),
+	name: varchar('name', { length: 255 }).notNull(),
+	dept: varchar('dept', { length: 255 }).notNull(),
+	salary: int('salary').notNull(),
+});
+
+const sqliteUsers = sqliteTable('users', {
+	id: sqliteInt('id').primaryKey(),
+	name: sqliteText('name').notNull(),
+	dept: sqliteText('dept').notNull(),
+	salary: sqliteInt('salary').notNull(),
+});
+
+describe('Window functions & expressions', () => {
+	test('Ranking helpers compile to snake_case SQL names', () => {
+		expect(pgDialect.sqlToQuery(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(pgDialect.sqlToQuery(rank().over()).sql).toBe('rank() over ()');
+		expect(pgDialect.sqlToQuery(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(pgDialect.sqlToQuery(ntile(4).over()).sql).toBe('ntile(4) over ()');
+		expect(pgDialect.sqlToQuery(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(pgDialect.sqlToQuery(cumeDist().over()).sql).toBe('cume_dist() over ()');
+	});
+
+	test('Offset & value-access helpers compile to correct SQL names and params', () => {
+		expect(pgDialect.sqlToQuery(lag(users.salary).over()).sql).toBe('lag("users"."salary") over ()');
+		expect(pgDialect.sqlToQuery(lag(users.salary, 2).over()).sql).toBe('lag("users"."salary", 2) over ()');
+		expect(pgDialect.sqlToQuery(lag(users.salary, 2, 0).over()).sql).toBe('lag("users"."salary", 2, $1) over ()');
+		expect(pgDialect.sqlToQuery(lag(users.salary, undefined, 0).over()).sql).toBe('lag("users"."salary", 1, $1) over ()');
+
+		expect(pgDialect.sqlToQuery(lead(users.salary).over()).sql).toBe('lead("users"."salary") over ()');
+		expect(pgDialect.sqlToQuery(lead(users.salary, 3).over()).sql).toBe('lead("users"."salary", 3) over ()');
+
+		expect(pgDialect.sqlToQuery(firstValue(users.salary).over()).sql).toBe('first_value("users"."salary") over ()');
+		expect(pgDialect.sqlToQuery(lastValue(users.salary).over()).sql).toBe('last_value("users"."salary") over ()');
+		expect(pgDialect.sqlToQuery(nthValue(users.salary, 3).over()).sql).toBe('nth_value("users"."salary", 3) over ()');
+	});
+
+	test('Aggregate window functions compile to correct SQL names', () => {
+		expect(pgDialect.sqlToQuery(windowSum(users.salary).over()).sql).toBe('sum("users"."salary") over ()');
