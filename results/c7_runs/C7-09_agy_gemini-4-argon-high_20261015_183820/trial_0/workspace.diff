+		err := constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		assert.False(t, out.consistentHash.disable)
+		require.Len(t, out.consistentHash.hashPolicies, 1)
+		hp := out.consistentHash.hashPolicies[0]
+		assert.False(t, hp.GetTerminal())
+		require.NotNil(t, hp.GetConnectionProperties())
+		assert.True(t, hp.GetConnectionProperties().GetSourceIp())
