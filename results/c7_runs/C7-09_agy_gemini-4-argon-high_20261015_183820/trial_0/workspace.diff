+func TestConsistentHashApplyForRouteAndYAML(t *testing.T) {
+	rawYAML := `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: test-consistent-hash
+  namespace: default
+spec:
+  consistentHash:
+    headers:
+      - headerName: X-User-Id
+        regexRewrite:
+          pattern: "^user-(.*)"
+          substitution: "\\1"
+        terminal: true
+    cookies:
+      - name: session
+        ttl: 1h30m
+        path: /api
+        attributes:
+          - name: SameSite
+            value: Lax
+          - name: Secure
+            value: "true"
+        terminal: false
+    queryParameters:
+      - name: tenant
+        terminal: true
+    filterState:
+      - key: io.envoyproxy.filter_state
+        terminal: false
+    sourceIp:
+      terminal: true
+`
+	var tp kgateway.TrafficPolicy
+	require.NoError(t, yaml.Unmarshal([]byte(rawYAML), &tp))
+
+	var specIr trafficPolicySpecIr
+	require.NoError(t, constructConsistentHash(tp.Spec, &specIr))
+
+	plugin := &trafficPolicyPluginGwPass{}
+	outRoute := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	require.NoError(t, plugin.ApplyForRoute(&ir.RouteContext{
+		Policy: &TrafficPolicy{spec: specIr},
+	}, outRoute))
+
+	hps := outRoute.GetRoute().GetHashPolicy()
+	require.Len(t, hps, 5)
+	assert.Equal(t, "X-User-Id", hps[0].GetHeader().GetHeaderName())
+	assert.Equal(t, "session", hps[1].GetCookie().GetName())
+	assert.Equal(t, "tenant", hps[2].GetQueryParameter().GetName())
+	assert.Equal(t, "io.envoyproxy.filter_state", hps[3].GetFilterState().GetKey())
+	assert.True(t, hps[4].GetConnectionProperties().GetSourceIp())
+}
