+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	t.Run("unions array fields in priority order, deduplicates, re-sorts into canonical order, and retains higher-priority unset sourceIp", func(t *testing.T) {
+		var highSpec, lowSpec trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-High-Header", Terminal: new(false)},
+					{HeaderName: "X-Shared", Terminal: new(true)},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "high_qp", Terminal: new(false)},
+				},
+				// sourceIp is intentionally unset on high-priority policy
+			},
+		}, &highSpec))
+
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "x-shared", Terminal: new(false)}, // case-insensitive duplicate of X-Shared
+					{HeaderName: "X-Low-Header", Terminal: new(true)},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "low_cookie", TTL: new("120")},
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "low_fs"},
+				},
+				SourceIP: &kgateway.ConsistentHashSourceIP{
+					Terminal: new(true),
+				},
+			},
+		}, &lowSpec))
+
+		attHigh := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "high-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: highSpec},
+		}
+		attLow := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "low-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: lowSpec},
+		}
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{attHigh, attLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		// Expect: 3 headers (X-High-Header, X-Shared, X-Low-Header), 1 cookie (low_cookie), 1 qp (high_qp), 1 filterState (low_fs), NO sourceIp!
+		require.Len(t, hps, 6)
+
+		assert.Equal(t, "X-High-Header", hps[0].GetHeader().GetHeaderName())
+		assert.False(t, hps[0].GetTerminal())
+
+		assert.Equal(t, "X-Shared", hps[1].GetHeader().GetHeaderName())
+		assert.True(t, hps[1].GetTerminal())
+
+		assert.Equal(t, "X-Low-Header", hps[2].GetHeader().GetHeaderName())
+		assert.True(t, hps[2].GetTerminal())
+
+		assert.Equal(t, "low_cookie", hps[3].GetCookie().GetName())
+		assert.Equal(t, "high_qp", hps[4].GetQueryParameter().GetName())
+		assert.Equal(t, "low_fs", hps[5].GetFilterState().GetKey())
+
+		// Verify merge origins metadata records consistentHash
+		origins := mergedAtt.MergeOrigins["consistentHash"]
+		require.NotNil(t, origins)
+		assert.True(t, origins.Has("gateway.kgateway.dev/TrafficPolicy/default/high-policy"))
+		assert.True(t, origins.Has("gateway.kgateway.dev/TrafficPolicy/default/low-policy"))
+	})
+
+	t.Run("retains higher-priority set sourceIp over lower-priority sourceIp", func(t *testing.T) {
+		var highSpec, lowSpec trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIP: &kgateway.ConsistentHashSourceIP{
+					Terminal: new(true),
+				},
+			},
+		}, &highSpec))
+
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-From-Low"},
+				},
+				SourceIP: &kgateway.ConsistentHashSourceIP{
+					Terminal: new(false),
+				},
+			},
+		}, &lowSpec))
+
+		attHigh := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "high-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: highSpec},
+		}
+		attLow := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "low-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: lowSpec},
+		}
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{attHigh, attLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 2)
+
+		// Canonical order: Header first, then SourceIP (with high-priority terminal=true)
+		assert.Equal(t, "X-From-Low", hps[0].GetHeader().GetHeaderName())
+		require.NotNil(t, hps[1].GetConnectionProperties())
+		assert.True(t, hps[1].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hps[1].GetTerminal())
+	})
+
+	t.Run("disable=true on higher-priority policy suppresses broader-scoped policy", func(t *testing.T) {
+		var highSpec, lowSpec trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: new(true),
+			},
+		}, &highSpec))
+
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-Broader"},
+				},
+			},
+		}, &lowSpec))
+
+		attHigh := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "narrow-disable"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: highSpec},
+		}
+		attLow := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "broad-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: lowSpec},
+		}
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{attHigh, attLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+		assert.Empty(t, mergedTP.spec.consistentHash.hashPolicies)
+
+		// Verify route application produces no hash_policy
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		assert.Empty(t, route.GetRoute().GetHashPolicy())
+	})
+}
