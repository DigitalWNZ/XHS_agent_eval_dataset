+							Pattern:      "^prefix-(.*)",
+							Substitution: "\\1",
+						},
+						Terminal: new(false),
+					},
+					{
+						// Duplicate with different casing - should be ignored, keeping first occurrence
+						HeaderName: "x-custom-header",
+						Terminal:   new(true),
+					},
+					{
+						HeaderName: "X-Second-Header",
+						Terminal:   new(true),
+					},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{
+						Name: "session_id",
+						TTL:  new("1h30m"),
+						Path: new("/app"),
+						Attributes: []kgateway.ConsistentHashCookieAttribute{
+							{Name: "SameSite", Value: "Strict"},
+							{Name: "Secure", Value: "true"},
+						},
+						Terminal: new(true),
+					},
+					{
+						// Duplicate cookie name - should be ignored
+						Name: "session_id",
+						TTL:  new("60"),
+					},
+					{
+						Name: "plain_seconds_cookie",
+						TTL:  new("3600"),
+					},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "user_id", Terminal: new(false)},
+					{Name: "user_id", Terminal: new(true)}, // Duplicate
+					{Name: "tenant_id", Terminal: new(true)},
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "envoy.network.transport_socket.original_dst_address", Terminal: new(false)},
