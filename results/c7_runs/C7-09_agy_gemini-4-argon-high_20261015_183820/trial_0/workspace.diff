+  consistentHash:
+    disable: true
+    sourceIp:
+      terminal: false
+`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "no other fields may be set when disable is true")
+	})
+
+	t.Run("valid full consistentHash", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
