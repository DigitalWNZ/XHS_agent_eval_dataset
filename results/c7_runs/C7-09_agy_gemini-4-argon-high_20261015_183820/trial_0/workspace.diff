+func TestConsistentHashIRValidate(t *testing.T) {
+	tests := []struct {
+		name        string
+		ir          *consistentHashIR
+		expectError bool
+	}{
+		{
+			name:        "nil IR is valid",
+			ir:          nil,
+			expectError: false,
+		},
+		{
+			name:        "disabled IR is valid",
+			ir:          &consistentHashIR{disable: true},
