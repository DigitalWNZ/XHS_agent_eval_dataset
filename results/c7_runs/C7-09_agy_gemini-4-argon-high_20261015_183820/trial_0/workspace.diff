+				},
+				SourceIP: &kgateway.ConsistentHashSourceIP{
+					Terminal: new(true),
+				},
+			},
+		}, out)
+		require.NoError(t, err)
+		require.NotNil(t, out.consistentHash)
+		hps := out.consistentHash.hashPolicies
+		require.Len(t, hps, 8)
+
+		// 0, 1: Headers
+		require.NotNil(t, hps[0].GetHeader())
+		assert.Equal(t, "X-Custom-Header", hps[0].GetHeader().GetHeaderName())
+		assert.False(t, hps[0].GetTerminal())
+		require.NotNil(t, hps[0].GetHeader().GetRegexRewrite())
+		assert.Equal(t, "^prefix-(.*)", hps[0].GetHeader().GetRegexRewrite().GetPattern().GetRegex())
+		assert.Equal(t, "\\1", hps[0].GetHeader().GetRegexRewrite().GetSubstitution())
+
+		require.NotNil(t, hps[1].GetHeader())
+		assert.Equal(t, "X-Second-Header", hps[1].GetHeader().GetHeaderName())
+		assert.True(t, hps[1].GetTerminal())
+
+		// 2, 3: Cookies
+		require.NotNil(t, hps[2].GetCookie())
+		assert.Equal(t, "session_id", hps[2].GetCookie().GetName())
+		assert.Equal(t, durationpb.New(90*time.Minute), hps[2].GetCookie().GetTtl())
+		assert.Equal(t, "/app", hps[2].GetCookie().GetPath())
+		assert.True(t, hps[2].GetTerminal())
+		require.Len(t, hps[2].GetCookie().GetAttributes(), 2)
+		assert.Equal(t, "SameSite", hps[2].GetCookie().GetAttributes()[0].GetName())
+		assert.Equal(t, "Strict", hps[2].GetCookie().GetAttributes()[0].GetValue())
+		assert.Equal(t, "Secure", hps[2].GetCookie().GetAttributes()[1].GetName())
+		assert.Equal(t, "true", hps[2].GetCookie().GetAttributes()[1].GetValue())
+
+		require.NotNil(t, hps[3].GetCookie())
+		assert.Equal(t, "plain_seconds_cookie", hps[3].GetCookie().GetName())
+		assert.Equal(t, durationpb.New(3600*time.Second), hps[3].GetCookie().GetTtl())
+		assert.False(t, hps[3].GetTerminal())
+
+		// 4, 5: QueryParameters
+		require.NotNil(t, hps[4].GetQueryParameter())
+		assert.Equal(t, "user_id", hps[4].GetQueryParameter().GetName())
+		assert.False(t, hps[4].GetTerminal())
+
+		require.NotNil(t, hps[5].GetQueryParameter())
+		assert.Equal(t, "tenant_id", hps[5].GetQueryParameter().GetName())
+		assert.True(t, hps[5].GetTerminal())
+
+		// 6: FilterState
+		require.NotNil(t, hps[6].GetFilterState())
+		assert.Equal(t, "envoy.network.transport_socket.original_dst_address", hps[6].GetFilterState().GetKey())
+		assert.False(t, hps[6].GetTerminal())
+
+		// 7: SourceIP
+		require.NotNil(t, hps[7].GetConnectionProperties())
+		assert.True(t, hps[7].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hps[7].GetTerminal())
+	})
+}
