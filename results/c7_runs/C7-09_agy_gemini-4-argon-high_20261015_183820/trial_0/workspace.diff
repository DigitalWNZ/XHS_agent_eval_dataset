+metadata:
+  name: valid-disable
+  namespace: default
+spec:
+  consistentHash:
+    disable: true
+`, nil)
+		assert.NoError(t, err)
+	})
+
+	t.Run("invalid disable=true with other fields", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: invalid-disable-with-source-ip
+  namespace: default
