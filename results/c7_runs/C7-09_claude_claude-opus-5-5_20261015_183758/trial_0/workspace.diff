+			strategy: policy.AugmentedShallowMerge,
+			p1:       hp(headerHP("X-A", true), queryHP("q")),
+			p2:       hp(headerHP("x-a", false), headerHP("x-b", false), cookieHP("c"), queryHP("q"), filterStateHP("fs")),
+			expected: hp(headerHP("X-A", true), headerHP("x-b", false), cookieHP("c"), queryHP("q"), filterStateHP("fs")),
+			origins:  []string{"p1", "p2"},
+		},
+		{
+			name:     "sourceIp retained from preferred policy even when unset",
+			strategy: policy.AugmentedDeepMerge,
+			p1:       hp(headerHP("x", false)),
+			p2:       hp(sourceIPHashPolicy(true)),
+			expected: hp(headerHP("x", false)),
+			origins:  []string{"p1"},
+		},
+		{
+			name:     "sourceIp kept from preferred policy",
+			strategy: policy.AugmentedDeepMerge,
+			p1:       hp(sourceIPHashPolicy(false)),
+			p2:       hp(headerHP("x", false), sourceIPHashPolicy(true)),
+			expected: hp(headerHP("x", false), sourceIPHashPolicy(false)),
+			origins:  []string{"p1", "p2"},
+		},
+		{
+			name:     "overridable prefers p2",
+			strategy: policy.OverridableShallowMerge,
+			p1:       hp(headerHP("x", false), sourceIPHashPolicy(false)),
+			p2:       hp(headerHP("X", true), cookieHP("c")),
+			expected: hp(headerHP("X", true), cookieHP("c")),
+			origins:  []string{"p1", "p2"},
+		},
+		{
+			name:     "p1 disable wins",
+			strategy: policy.AugmentedShallowMerge,
+			p1:       &consistentHashIR{disable: true},
+			p2:       hp(headerHP("x", false)),
+			expected: &consistentHashIR{disable: true},
+			origins:  []string{"p1"},
+		},
+		{
+			name:     "p2 disable ignored when p1 preferred",
+			strategy: policy.AugmentedDeepMerge,
+			p1:       hp(headerHP("x", false)),
+			p2:       &consistentHashIR{disable: true},
+			expected: hp(headerHP("x", false)),
+			origins:  []string{"p1"},
+		},
+		{
+			name:     "p2 disable wins when p2 preferred",
+			strategy: policy.OverridableDeepMerge,
+			p1:       hp(headerHP("x", false)),
+			p2:       &consistentHashIR{disable: true},
+			expected: &consistentHashIR{disable: true},
+			origins:  []string{"p2"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p1 := newPolicy(tt.p1)
+			p2 := newPolicy(tt.p2)
+			var p1Orig []*envoyroutev3.RouteAction_HashPolicy
+			if tt.p1 != nil {
+				p1Orig = append(p1Orig, tt.p1.hashPolicies...)
+			}
+
+			mergeOrigins := ir.MergeOrigins{}
+			if tt.p1 != nil {
+				mergeOrigins.SetOne(consistentHashFieldName, &ir.AttachedPolicyRef{Name: "p1"}, nil)
+			}
+			MergeTrafficPolicies(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil,
+				policy.MergeOptions{Strategy: tt.strategy}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+			require.NotNil(t, p1.spec.consistentHash)
+			assert.Equal(t, tt.expected.disable, p1.spec.consistentHash.disable)
+			assertHashPolicies(t, tt.expected.hashPolicies, p1.spec.consistentHash.hashPolicies)
+
+			var names []string
+			for ref := range mergeOrigins[consistentHashFieldName] {
+				names = append(names, ref)
+			}
+			assert.Len(t, names, len(tt.origins), "unexpected merge origins: %v", names)
+
+			// the original IR must not be mutated
+			if tt.p1 != nil {
+				assertHashPolicies(t, p1Orig, tt.p1.hashPolicies)
+			}
+		})
+	}
+}
+
+func TestMergePoliciesConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+	now := time.Now()
+	p1 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "p1"},
+		PolicyIr: &TrafficPolicy{ct: now, spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{cookieHP("c"), sourceIPHashPolicy(false)},
+		}}},
+	}
+	p2 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "p2"},
+		PolicyIr: &TrafficPolicy{ct: now.Add(time.Minute), spec: trafficPolicySpecIr{consistentHash: &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x", false), cookieHP("c"), sourceIPHashPolicy(true)},
+		}}},
+	}
+
+	merged := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+	tp := merged.PolicyIr.(*TrafficPolicy)
+	require.NotNil(t, tp.spec.consistentHash)
+	assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+		headerHP("x", false), cookieHP("c"), sourceIPHashPolicy(false),
+	}, tp.spec.consistentHash.hashPolicies)
+	assert.Len(t, merged.MergeOrigins[consistentHashFieldName], 2, "both policies should be recorded as merge origins")
+}
