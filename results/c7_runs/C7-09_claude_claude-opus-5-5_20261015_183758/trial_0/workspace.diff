+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: route-merge
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "merge.example.com"
+  rules:
+    - backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: route-disable
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "disable.example.com"
+  rules:
+    - name: rule-0
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-level-consistent-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-inherit
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-disable
+  consistentHash: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-consistent-hash-a
+  creationTimestamp: "2024-01-01T00:00:00Z"
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-merge
+  consistentHash:
+    sourceIp:
+      terminal: true
+    queryParameters:
+      - name: user
+    headers:
+      - headerName: X-User
+        terminal: true
+        regexRewrite:
+          pattern: "^(.*)-.*$"
+          substitution: "\\1"
+      - headerName: x-user
+    cookies:
+      - name: session
+        ttl: 1h30m
+        path: /
+        attributes:
+          - name: SameSite
+            value: Strict
+          - name: Secure
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-consistent-hash-b
+  creationTimestamp: "2024-01-02T00:00:00Z"
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-merge
+  consistentHash:
+    headers:
+      - headerName: x-user
+      - headerName: x-tenant
+    cookies:
+      - name: other
+        ttl: "3600"
+    filterState:
+      - key: io.istio.peer
+        terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-disable-consistent-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: route-disable
+      sectionName: rule-0
+  consistentHash:
+    disable: true
