+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+const consistentHashFieldName = "consistentHash"
+
+type consistentHashIR struct {
+	// disable suppresses hash policies on the route, including inherited ones
+	disable bool
+	// hashPolicies are the hash policies in canonical type order:
+	// headers, cookies, queryParameters, filterState, sourceIp
+	hashPolicies []*envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil && otherConsistentHash == nil {
+		return true
+	}
+	if c == nil || otherConsistentHash == nil {
+		return false
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	return slices.EqualFunc(c.hashPolicies, otherConsistentHash.hashPolicies, func(a, b *envoyroutev3.RouteAction_HashPolicy) bool {
+		return proto.Equal(a, b)
+	})
+}
+
+// Validate performs validation on the consistent hash component.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	var errs []error
+	for _, hp := range c.hashPolicies {
+		if rr := hp.GetHeader().GetRegexRewrite(); rr != nil {
+			if err := regexutils.CheckRegexString(rr.GetPattern().GetRegex()); err != nil {
+				errs = append(errs, fmt.Errorf("invalid consistentHash header %q regexRewrite pattern: %w", hp.GetHeader().GetHeaderName(), err))
+			}
+		}
+		if err := hp.ValidateAll(); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+	ch := spec.ConsistentHash
+
+	if ch.Disable != nil && *ch.Disable {
+		out.consistentHash = &consistentHashIR{disable: true}
+		return nil
+	}
+
+	var errs []error
+	hashPolicies := make([]*envoyroutev3.RouteAction_HashPolicy, 0,
+		len(ch.Headers)+len(ch.Cookies)+len(ch.QueryParameters)+len(ch.FilterState)+1)
+
+	for _, h := range ch.Headers {
+		header := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: h.HeaderName,
+		}
+		if h.RegexRewrite != nil {
+			header.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: h.RegexRewrite.Pattern,
+				},
+				Substitution: h.RegexRewrite.Substitution,
+			}
+		}
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{Header: header},
+			Terminal:        boolValue(h.Terminal),
+		})
+	}
+
+	for _, c := range ch.Cookies {
+		cookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: c.Name,
+		}
+		if c.TTL != nil {
+			ttl, err := parseCookieTTL(*c.TTL)
+			if err != nil {
+				errs = append(errs, fmt.Errorf("invalid consistentHash cookie %q ttl: %w", c.Name, err))
+			} else {
+				cookie.Ttl = durationpb.New(ttl)
+			}
+		}
+		if c.Path != nil {
+			cookie.Path = *c.Path
+		}
+		for _, attr := range c.Attributes {
+			cookie.Attributes = append(cookie.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attr.Name,
+				Value: attr.Value,
+			})
+		}
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{Cookie: cookie},
+			Terminal:        boolValue(c.Terminal),
+		})
+	}
+
+	for _, q := range ch.QueryParameters {
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: q.Name,
+				},
+			},
+			Terminal: boolValue(q.Terminal),
+		})
+	}
+
+	for _, f := range ch.FilterState {
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: f.Key,
+				},
+			},
+			Terminal: boolValue(f.Terminal),
+		})
+	}
+
+	if ch.SourceIP != nil {
+		hashPolicies = append(hashPolicies, sourceIPHashPolicy(boolValue(ch.SourceIP.Terminal)))
+	}
+
+	// Default to hashing on the source IP when no hash policies are specified
+	if len(hashPolicies) == 0 {
+		hashPolicies = append(hashPolicies, sourceIPHashPolicy(false))
+	}
+
+	out.consistentHash = &consistentHashIR{
+		hashPolicies: dedupeHashPolicies(hashPolicies),
+	}
+	return errors.Join(errs...)
+}
+
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+		Terminal: terminal,
+	}
+}
+
+func boolValue(b *bool) bool {
+	return b != nil && *b
+}
+
+// parseCookieTTL parses a cookie TTL given either as a Go duration string (e.g. "1h30m")
+// or as a plain integer number of seconds (e.g. "3600").
+func parseCookieTTL(s string) (time.Duration, error) {
+	var d time.Duration
+	if secs, err := strconv.ParseInt(s, 10, 64); err == nil {
+		d = time.Duration(secs) * time.Second
+	} else {
+		d, err = time.ParseDuration(s)
+		if err != nil {
+			return 0, err
+		}
+	}
+	if d < 0 {
+		return 0, fmt.Errorf("ttl must not be negative: %q", s)
+	}
+	return d, nil
+}
+
+// hashPolicyTypeOrder returns the canonical order of the hash policy type:
+// headers, cookies, queryParameters, filterState, sourceIp
+func hashPolicyTypeOrder(hp *envoyroutev3.RouteAction_HashPolicy) int {
+	switch hp.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return 0
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return 1
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return 2
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return 3
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return 4
+	default:
+		return 5
+	}
+}
+
+// hashPolicyKey returns the identifying key of the hash policy used for deduplication.
+// Header names are compared case-insensitively.
+func hashPolicyKey(hp *envoyroutev3.RouteAction_HashPolicy) string {
+	switch hp.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return "header/" + strings.ToLower(hp.GetHeader().GetHeaderName())
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return "cookie/" + hp.GetCookie().GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return "queryParameter/" + hp.GetQueryParameter().GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return "filterState/" + hp.GetFilterState().GetKey()
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return "sourceIp"
+	default:
+		return ""
+	}
+}
+
+// dedupeHashPolicies returns the hash policies deduplicated by their identifying key,
+// keeping the first occurrence, and sorted in canonical type order. The relative order
+// of hash policies of the same type is preserved.
+func dedupeHashPolicies(hashPolicies []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	seen := make(map[string]struct{}, len(hashPolicies))
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(hashPolicies))
+	for _, hp := range hashPolicies {
+		key := hashPolicyKey(hp)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, hp)
+	}
+	slices.SortStableFunc(out, func(a, b *envoyroutev3.RouteAction_HashPolicy) int {
+		return hashPolicyTypeOrder(a) - hashPolicyTypeOrder(b)
+	})
+	return out
+}
+
+// applyConsistentHash applies the consistent hash configuration to the Envoy route action.
+func applyConsistentHash(consistentHash *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if consistentHash == nil || action == nil {
+		return
+	}
+	if consistentHash.disable {
+		action.HashPolicy = nil
+		return
+	}
+	action.HashPolicy = consistentHash.hashPolicies
+}
+
+// mergeConsistentHash merges the consistent hash configuration of p2 into p1.
+// The hash policies of both policies are unioned with the preferred policy's entries first,
+// deduplicated by their identifying key, and sorted in canonical type order. The sourceIp
+// hash policy is only retained from the preferred policy. If either policy disables
+// consistent hashing, the preferred policy is used as-is.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	p2Field := p2.spec.consistentHash
+	if p2Field == nil {
+		return
+	}
+
+	p1Field := p1.spec.consistentHash
+	if p1Field == nil {
+		p1.spec.consistentHash = p2Field
+		mergeOrigins.SetOne(consistentHashFieldName, p2Ref, p2MergeOrigins)
+		return
+	}
+
+	var preferP2 bool
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		preferP2 = false
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		preferP2 = true
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", consistentHashFieldName)
+		return
+	}
+
+	if p1Field.disable || p2Field.disable {
+		if preferP2 {
+			p1.spec.consistentHash = p2Field
+			mergeOrigins.SetOne(consistentHashFieldName, p2Ref, p2MergeOrigins)
+		}
+		return
+	}
+
+	hi, lo := p1Field, p2Field
+	if preferP2 {
+		hi, lo = p2Field, p1Field
+	}
+
+	// Always build a new slice so that the original slices in the IRs are never modified
+	combined := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(hi.hashPolicies)+len(lo.hashPolicies))
+	combined = append(combined, hi.hashPolicies...)
+	for _, hp := range lo.hashPolicies {
+		// the sourceIp scalar is only retained from the preferred policy
+		if hp.GetConnectionProperties() != nil {
+			continue
+		}
+		combined = append(combined, hp)
+	}
+	merged := dedupeHashPolicies(combined)
+
+	// p2 contributes to the merged result if it is preferred or if any of its entries were added
+	if !preferP2 && len(merged) == len(p1Field.hashPolicies) {
+		return
+	}
+	p1.spec.consistentHash = &consistentHashIR{hashPolicies: merged}
+	mergeOrigins.Append(consistentHashFieldName, p2Ref, p2MergeOrigins)
+}
