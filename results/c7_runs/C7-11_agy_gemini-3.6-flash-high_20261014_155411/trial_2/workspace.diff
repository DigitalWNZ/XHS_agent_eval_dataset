+						},
+					},
+				},
+				Cookies: []kgateway.ConsistentHashCookie{
+					{
+						Name: "c1",
+						TTL:  "10m",
+					},
+					{
+						Name: "c2",
+						TTL:  "600",
+					},
+				},
+			},
+		}
+		assert.NoError(t, ch.Validate())
+	})
+}
