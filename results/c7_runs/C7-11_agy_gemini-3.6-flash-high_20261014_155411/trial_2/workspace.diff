+
+	t.Run("valid configuration passes validation", func(t *testing.T) {
+		ch := &consistentHashIR{
+			policy: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "X-Test",
