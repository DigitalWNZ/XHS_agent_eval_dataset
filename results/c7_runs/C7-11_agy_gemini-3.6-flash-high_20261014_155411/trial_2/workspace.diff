+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "X-Test",
+						RegexRewrite: &kgateway.RegexRewrite{
+							Pattern: "[invalid",
+						},
+					},
+				},
+			},
+		}
+		assert.Error(t, ch.Validate())
+	})
+
+	t.Run("invalid ttl string", func(t *testing.T) {
