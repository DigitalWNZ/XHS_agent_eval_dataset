+func TestConsistentHashMerge(t *testing.T) {
+	p1Spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user-id"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "sess_p1"},
+			},
+			// sourceIp is unset on p1
+		},
+	}
+
+	p2Spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-ID"}, // Duplicate case-insensitively with p1
+				{HeaderName: "x-tenant"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "sess_p2"},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIp{
+				Terminal: true,
+			},
+		},
+	}
+
+	p1 := &TrafficPolicy{}
+	constructConsistentHash(p1Spec, &p1.spec)
+
+	p2 := &TrafficPolicy{}
+	constructConsistentHash(p2Spec, &p2.spec)
+
+	p2Ref := &ir.AttachedPolicyRef{}
+	p2MergeOrigins := ir.MergeOrigins{}
+	mergeOrigins := ir.MergeOrigins{}
+
+	opts := policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}
+	mergeConsistentHash(p1, p2, p2Ref, p2MergeOrigins, opts, mergeOrigins, TrafficPolicyMergeOpts{})
+
+	merged := p1.spec.consistentHash.policy
+	require.NotNil(t, merged)
+
+	// Headers: p1 first, then p2, deduplicated by case-insensitive name
+	require.Len(t, merged.Headers, 2)
+	assert.Equal(t, "x-user-id", merged.Headers[0].HeaderName)
+	assert.Equal(t, "x-tenant", merged.Headers[1].HeaderName)
+
+	// Cookies: p1 first, then p2
+	require.Len(t, merged.Cookies, 2)
+	assert.Equal(t, "sess_p1", merged.Cookies[0].Name)
+	assert.Equal(t, "sess_p2", merged.Cookies[1].Name)
+
+	// sourceIp scalar retains higher-priority policy's value (unset / nil)
+	assert.Nil(t, merged.SourceIp)
+
+	// Check merge origins
+	assert.Contains(t, mergeOrigins, "consistentHash")
+}
