+func TestConstructConsistentHash_Deduplication(t *testing.T) {
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-Id", Terminal: ptr.To(true)},
+				{HeaderName: "x-user-id", Terminal: ptr.To(false)},
+				{HeaderName: "X-Device-Type"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session_id", TTL: "1h30m"},
+				{Name: "session_id", TTL: "2h"},
+				{Name: "other_cookie"},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "param1"},
+				{Name: "param1"},
+				{Name: "param2"},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "key1"},
+				{Key: "key1"},
+				{Key: "key2"},
+			},
+		},
+	}
+	out := &trafficPolicySpecIr{}
+	constructConsistentHash(spec, out)
+
+	require.NotNil(t, out.consistentHash)
+
+	// Headers: deduplicated case-insensitively, preserving first occurrence ("X-User-Id")
+	require.Len(t, out.consistentHash.headers, 2)
+	assert.Equal(t, "X-User-Id", out.consistentHash.headers[0].HeaderName)
+	assert.True(t, *out.consistentHash.headers[0].Terminal)
+	assert.Equal(t, "X-Device-Type", out.consistentHash.headers[1].HeaderName)
+
+	// Cookies: deduplicated case-sensitively
+	require.Len(t, out.consistentHash.cookies, 2)
+	assert.Equal(t, "session_id", out.consistentHash.cookies[0].Name)
+	assert.Equal(t, "1h30m", out.consistentHash.cookies[0].TTL)
+	assert.Equal(t, "other_cookie", out.consistentHash.cookies[1].Name)
+
+	// Query parameters
+	require.Len(t, out.consistentHash.queryParameters, 2)
+	assert.Equal(t, "param1", out.consistentHash.queryParameters[0].Name)
+	assert.Equal(t, "param2", out.consistentHash.queryParameters[1].Name)
+
+	// Filter state
+	require.Len(t, out.consistentHash.filterState, 2)
+	assert.Equal(t, "key1", out.consistentHash.filterState[0].Key)
+	assert.Equal(t, "key2", out.consistentHash.filterState[1].Key)
+}
