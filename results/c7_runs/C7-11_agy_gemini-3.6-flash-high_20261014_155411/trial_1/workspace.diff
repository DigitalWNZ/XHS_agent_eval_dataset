+func TestParseTTL(t *testing.T) {
+	d, err := parseTTL("1h30m")
+	require.NoError(t, err)
+	assert.Equal(t, 90*time.Minute, d)
+
+	d, err = parseTTL("3600")
+	require.NoError(t, err)
+	assert.Equal(t, 3600*time.Second, d)
+
+	d, err = parseTTL("0")
+	require.NoError(t, err)
+	assert.Equal(t, time.Duration(0), d)
+
+	_, err = parseTTL("-10s")
+	require.Error(t, err)
+
+	_, err = parseTTL("invalid")
+	require.Error(t, err)
+}
