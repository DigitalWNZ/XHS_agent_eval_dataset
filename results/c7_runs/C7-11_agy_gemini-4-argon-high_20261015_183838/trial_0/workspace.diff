+// Encode encodes the ShapeIndex to the given writer.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if s == nil {
+		return errors.New("s2: cannot encode nil ShapeIndex")
+	}
+	if w == nil {
+		return errors.New("s2: cannot encode ShapeIndex to nil writer")
+	}
+	s.Build()
+
+	crc := crc32.NewIEEE()
+	e := &encoder{w: io.MultiWriter(w, crc)}
+	s.encode(e)
+	if e.err != nil {
+		return e.err
+	}
+
+	var crcBuf [4]byte
+	binary.LittleEndian.PutUint32(crcBuf[:], crc.Sum32())
+	_, err := w.Write(crcBuf[:])
+	return err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUint32(uint32(maxEdges))
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	nextID := s.nextID
+	for id, shape := range s.shapes {
+		if shape == nil {
+			continue
+		}
+		if id < 0 {
+			e.err = fmt.Errorf("s2: negative shape ID %d", id)
+			return
+		}
+		shapeIDs = append(shapeIDs, id)
+		if id >= nextID {
+			nextID = id + 1
+		}
+	}
+	if nextID < 0 {
+		nextID = 0
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUint32(uint32(nextID))
+	e.writeUint32(uint32(len(shapeIDs)))
+	for _, id := range shapeIDs {
+		e.writeUint32(uint32(id))
+		encodeIndexShape(e, s.shapes[id])
+		if e.err != nil {
+			return
+		}
+	}
+
+	cells := s.cells
+	if len(cells) != len(s.cellMap) {
+		cells = make([]CellID, 0, len(s.cellMap))
+		for cid := range s.cellMap {
+			cells = append(cells, cid)
+		}
+		slices.Sort(cells)
+	}
+
+	e.writeUint32(uint32(len(cells)))
+	for _, cid := range cells {
+		e.writeUint64(uint64(cid))
+		cell := s.cellMap[cid]
+		if cell == nil {
+			e.writeUint32(0)
+			continue
+		}
+		e.writeUint32(uint32(len(cell.shapes)))
+		for _, cs := range cell.shapes {
+			e.writeUint32(uint32(cs.shapeID))
+			e.writeBool(cs.containsCenter)
+			e.writeUint32(uint32(len(cs.edges)))
+			for _, edgeID := range cs.edges {
+				e.writeUint32(uint32(edgeID))
+			}
+		}
+	}
+}
+
+func encodeIndexPoint(e *encoder, pt Point) {
+	e.writeFloat64(pt.X)
+	e.writeFloat64(pt.Y)
+	e.writeFloat64(pt.Z)
+}
+
+func encodeIndexPoints(e *encoder, pts []Point) {
+	e.writeBool(pts == nil)
+	e.writeUint32(uint32(len(pts)))
+	for _, pt := range pts {
+		encodeIndexPoint(e, pt)
+	}
+}
+
+func encodeIndexLoop(e *encoder, l *Loop) {
+	encodeIndexPoints(e, l.vertices)
+	e.writeBool(l.originInside)
+	e.writeInt32(int32(l.depth))
+	l.bound.encode(e)
+	l.subregionBound.encode(e)
+	e.writeBool(l.index != nil)
+}
+
+func encodeIndexShape(e *encoder, shape Shape) {
+	switch sh := shape.(type) {
+	case *Polygon:
+		e.writeUint8(shapeKindPolygon)
+		e.writeBool(sh.hasHoles)
+		e.writeUint32(uint32(len(sh.loops)))
+		for _, l := range sh.loops {
+			encodeIndexLoop(e, l)
+		}
+		sh.bound.encode(e)
+		sh.subregionBound.encode(e)
+		e.writeBool(sh.index != nil)
+
+	case *Polyline:
+		e.writeUint8(shapeKindPolyline)
+		encodeIndexPoints(e, *sh)
+
+	case *PointVector:
+		e.writeUint8(shapeKindPointVector)
+		encodeIndexPoints(e, *sh)
+
+	case *LaxPolyline:
+		e.writeUint8(shapeKindLaxPolyline)
+		encodeIndexPoints(e, sh.vertices)
+
+	case *LaxPolygon:
+		e.writeUint8(shapeKindLaxPolygon)
+		e.writeUint32(uint32(sh.numLoops))
+		for i := 0; i < sh.numLoops; i++ {
+			n := sh.numLoopVertices(i)
+			e.writeUint32(uint32(n))
+			for j := 0; j < n; j++ {
+				encodeIndexPoint(e, sh.loopVertex(i, j))
+			}
+		}
+
+	case *Loop:
+		e.writeUint8(shapeKindLoop)
+		encodeIndexLoop(e, sh)
+
+	case *LaxLoop:
+		e.writeUint8(shapeKindLaxLoop)
+		encodeIndexPoints(e, sh.vertices)
+
+	default:
+		e.writeUint8(shapeKindGeneric)
+		e.writeUint8(uint8(sh.Dimension()))
+		e.writeUint32(uint32(sh.typeTag()))
+		ref := sh.ReferencePoint()
+		e.writeBool(ref.Contained)
+		encodeIndexPoint(e, ref.Point)
+		e.writeBool(sh.IsEmpty())
+		e.writeBool(sh.IsFull())
+		numChains := sh.NumChains()
+		e.writeUint32(uint32(numChains))
+		for c := 0; c < numChains; c++ {
+			ch := sh.Chain(c)
+			e.writeUint32(uint32(ch.Start))
+			e.writeUint32(uint32(ch.Length))
+		}
+		numEdges := sh.NumEdges()
+		e.writeUint32(uint32(numEdges))
+		for i := 0; i < numEdges; i++ {
+			edge := sh.Edge(i)
+			encodeIndexPoint(e, edge.V0)
+			encodeIndexPoint(e, edge.V1)
+		}
+	}
+}
