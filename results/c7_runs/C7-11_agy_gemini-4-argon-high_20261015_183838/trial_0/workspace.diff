+
+	case shapeKindLaxLoop:
+		pts := d.readPoints()
+		if d.err != nil {
+			return nil
+		}
+		return &LaxLoop{
+			numVertices: len(pts),
+			vertices:    pts,
+		}
+
+	case shapeKindGeneric:
+		dim := d.readUint8()
+		if d.err != nil {
+			return nil
+		}
+		if dim > 2 {
+			d.err = fmt.Errorf("s2: invalid shape dimension %d", dim)
