+func TestShapeIndexEncodeDecodeZeroEdgeAndMixedChains(t *testing.T) {
+	p0 := PointFromLatLng(LatLngFromDegrees(1, 1))
+	p1 := PointFromLatLng(LatLngFromDegrees(2, 2))
+	p2 := PointFromLatLng(LatLngFromDegrees(3, 2))
+	p3 := PointFromLatLng(LatLngFromDegrees(10, 10))
+	p4 := PointFromLatLng(LatLngFromDegrees(10, 15))
+	p5 := PointFromLatLng(LatLngFromDegrees(15, 12))
+
+	emptyPoly := &Polygon{}
+	fullPoly := FullPolygon()
+	emptyLoop := EmptyLoop()
+	fullLoop := FullLoop()
+	emptyPolyline := Polyline(nil)
+	oneVertPolyline := Polyline{p0}
+	emptyPointVec := PointVector(nil)
+	emptyLaxPolyline := LaxPolylineFromPoints(nil)
+	oneVertLaxPolyline := LaxPolylineFromPoints([]Point{p0})
+	emptyLaxLoop := LaxLoopFromPoints(nil)
+	oneVertLaxLoop := LaxLoopFromPoints([]Point{p0})
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+	fullLaxPoly := LaxPolygonFromPoints([][]Point{{}})
+	// LaxPolygon with mixed chain lengths: 0 (full shell), 1 (degenerate point hole),
+	// 2 (sibling pair), and 3 (triangle).
+	mixedChainLaxPoly := LaxPolygonFromPoints([][]Point{
+		{},
+		{p0},
+		{p1, p2},
+		{p3, p4, p5},
+	})
+
+	zeroAndMixedShapes := []Shape{
+		emptyPoly,
+		fullPoly,
+		emptyLoop,
+		fullLoop,
+		&emptyPolyline,
+		&oneVertPolyline,
+		&emptyPointVec,
+		emptyLaxPolyline,
+		oneVertLaxPolyline,
+		emptyLaxLoop,
+		oneVertLaxLoop,
+		emptyLaxPoly,
+		fullLaxPoly,
+		mixedChainLaxPoly,
+	}
+
+	// Round-trip each zero-edge / mixed-chain shape individually.
+	for _, sh := range zeroAndMixedShapes {
+		idx := NewShapeIndex()
+		idx.Add(sh)
+		roundTripShapeIndex(t, idx)
+	}
+
+	// Round-trip all of them together in a single index along with multi-chain PointVector and Polygon.
+	multiPointVec := PointVector{p0, p1, p2, p3}
+	multiLoopPoly := concentricLoopsPolygon(PointFromLatLng(LatLngFromDegrees(-20, -20)), 3, 6)
+
+	idx := NewShapeIndex()
+	for _, sh := range zeroAndMixedShapes {
+		idx.Add(sh)
+	}
+	idx.Add(&multiPointVec)
+	idx.Add(multiLoopPoly)
+
+	decoded := roundTripShapeIndex(t, idx)
+
+	// Verify point containment works on full / mixed shapes in the decoded index.
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.ShapeContains(decoded.Shape(1), p0) { // fullPoly
+		t.Errorf("decoded fullPoly should contain %v", p0)
+	}
+	if cpq.ShapeContains(decoded.Shape(0), p0) { // emptyPoly
+		t.Errorf("decoded emptyPoly should not contain %v", p0)
+	}
+	if !cpq.ShapeContains(decoded.Shape(3), p0) { // fullLoop
+		t.Errorf("decoded fullLoop should contain %v", p0)
+	}
+	if cpq.ShapeContains(decoded.Shape(2), p0) { // emptyLoop
+		t.Errorf("decoded emptyLoop should not contain %v", p0)
+	}
+}
