+		hasHoles := d.readStrictBool()
+		nloops := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nloops > maxEncodedIndexLoops {
+			d.err = fmt.Errorf("s2: too many loops in Polygon (%d)", nloops)
+			return nil
+		}
+		loops := make([]*Loop, 0, min(int(nloops), maxInitialSliceAlloc))
+		for range nloops {
+			l := d.decodeLoop()
+			if d.err != nil {
+				return nil
+			}
+			loops = append(loops, l)
+		}
+		bound := d.readRect()
+		subregionBound := d.readRect()
+		hasIndex := d.readStrictBool()
+		if d.err != nil {
+			return nil
+		}
+		p := &Polygon{
+			loops:          loops,
+			hasHoles:       hasHoles,
+			bound:          bound,
+			subregionBound: subregionBound,
+		}
+		for _, l := range p.loops {
+			p.numVertices += len(l.vertices)
+		}
+		p.initEdgesAndIndex()
+		if !hasIndex {
+			p.index = nil
+			if nloops == 0 {
+				p.loops = nil
+			}
+		}
+		return p
+
+	case shapeKindPolyline:
+		pts := d.readPoints()
+		if d.err != nil {
+			return nil
+		}
+		pl := Polyline(pts)
+		return &pl
+
+	case shapeKindPointVector:
+		pts := d.readPoints()
+		if d.err != nil {
+			return nil
+		}
+		pv := PointVector(pts)
+		return &pv
+
+	case shapeKindLaxPolyline:
+		pts := d.readPoints()
+		if d.err != nil {
+			return nil
+		}
+		return &LaxPolyline{vertices: pts}
+
+	case shapeKindLaxPolygon:
+		nloops := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nloops > maxEncodedIndexLoops {
+			d.err = fmt.Errorf("s2: too many loops in LaxPolygon (%d)", nloops)
+			return nil
