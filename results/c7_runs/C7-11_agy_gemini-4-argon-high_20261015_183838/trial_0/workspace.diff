+func TestShapeIndexEncodeDecodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	s0 := makePolygon("0:0, 0:4, 4:4, 4:0", true)
+	s1Shape := makePolyline("10:10, 10:15, 15:15")
+	s2Shape := makePolygon("20:20, 20:25, 25:25, 25:20", true)
+	s3Shape := &PointVector{PointFromLatLng(LatLngFromDegrees(-5, -5))}
+	s4Shape := makeLaxPolyline("-20:-20, -20:-15, -15:-15")
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1Shape)
+	id2 := index.Add(s2Shape)
+	id3 := index.Add(s3Shape)
+	id4 := index.Add(s4Shape)
+
+	if id0 != 0 || id1 != 1 || id2 != 2 || id3 != 3 || id4 != 4 {
+		t.Fatalf("unexpected initial shape IDs: %d, %d, %d, %d, %d", id0, id1, id2, id3, id4)
+	}
+
+	// Remove shapes 1 and 3 before Build, then build and add/remove another shape.
+	index.Remove(s1Shape)
+	index.Remove(s3Shape)
+	index.Build()
+
+	s5Shape := makeLoop("-30:0, -30:5, -25:5, -25:0")
+	id5 := index.Add(s5Shape)
+	if id5 != 5 {
+		t.Fatalf("id5 = %d, want 5", id5)
+	}
+	index.Remove(s2Shape)
+
+	decoded := roundTripShapeIndex(t, index)
+
+	// Surviving shapes must be at IDs 0, 4, 5; removed shapes at 1, 2, 3 must be nil.
+	for _, removedID := range []int32{1, 2, 3} {
+		if got := decoded.Shape(removedID); got != nil {
+			t.Errorf("decoded.Shape(%d) = %v, want nil", removedID, got)
+		}
+	}
+	for _, survivingID := range []int32{0, 4, 5} {
+		if got := decoded.Shape(survivingID); got == nil {
+			t.Errorf("decoded.Shape(%d) = nil, want non-nil", survivingID)
+		}
+	}
+
+	// Verify all cell clippedShape references point to valid surviving shapes.
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		for _, cs := range it.IndexCell().shapes {
+			sh := decoded.Shape(cs.shapeID)
+			if sh == nil {
+				t.Fatalf("cell %v references nil shape ID %d", it.CellID(), cs.shapeID)
+			}
+			for _, edgeID := range cs.edges {
+				if edgeID < 0 || edgeID >= sh.NumEdges() {
+					t.Fatalf("cell %v shape %d has out-of-range edgeID %d (NumEdges=%d)", it.CellID(), cs.shapeID, edgeID, sh.NumEdges())
+				}
+			}
+		}
+	}
+
+	// Adding a new shape to the decoded index should continue from nextID (6).
+	s6Shape := makePolyline("40:40, 41:41")
+	if gotID := decoded.Add(s6Shape); gotID != 6 {
+		t.Errorf("decoded.Add() returned ID %d, want 6", gotID)
+	}
+}
+
+func makeRawShapeIndexWithChecksum(payload []byte) []byte {
+	out := make([]byte, len(payload)+4)
+	copy(out, payload)
+	binary.LittleEndian.PutUint32(out[len(payload):], crc32.ChecksumIEEE(payload))
+	return out
+}
