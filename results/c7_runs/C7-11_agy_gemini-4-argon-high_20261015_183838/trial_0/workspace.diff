+func assertShapeEqual(t *testing.T, id int32, got, want Shape) {
+	t.Helper()
+	if got.Dimension() != want.Dimension() {
+		t.Fatalf("shape %d: Dimension() = %d, want %d", id, got.Dimension(), want.Dimension())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("shape %d: NumEdges() = %d, want %d", id, got.NumEdges(), want.NumEdges())
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("shape %d: NumChains() = %d, want %d", id, got.NumChains(), want.NumChains())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Fatalf("shape %d: IsEmpty() = %v, want %v", id, got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Fatalf("shape %d: IsFull() = %v, want %v", id, got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Fatalf("shape %d: ReferencePoint() = %+v, want %+v", id, got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.typeTag() != want.typeTag() {
+		t.Fatalf("shape %d: typeTag() = %v, want %v", id, got.typeTag(), want.typeTag())
+	}
+
+	for e := 0; e < want.NumEdges(); e++ {
+		if got.Edge(e) != want.Edge(e) {
+			t.Fatalf("shape %d: Edge(%d) = %+v, want %+v", id, e, got.Edge(e), want.Edge(e))
+		}
+		if got.ChainPosition(e) != want.ChainPosition(e) {
+			t.Fatalf("shape %d: ChainPosition(%d) = %+v, want %+v", id, e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+
+	for c := 0; c < want.NumChains(); c++ {
+		gotChain := got.Chain(c)
+		wantChain := want.Chain(c)
+		if gotChain != wantChain {
+			t.Fatalf("shape %d: Chain(%d) = %+v, want %+v", id, c, gotChain, wantChain)
+		}
+		for offset := 0; offset < wantChain.Length; offset++ {
+			if got.ChainEdge(c, offset) != want.ChainEdge(c, offset) {
+				t.Fatalf("shape %d: ChainEdge(%d, %d) = %+v, want %+v", id, c, offset, got.ChainEdge(c, offset), want.ChainEdge(c, offset))
+			}
+		}
+	}
+
+	switch want.(type) {
+	case *Polygon, *Polyline, *PointVector, *LaxPolyline, *LaxPolygon, *Loop, *LaxLoop:
+		if reflect.TypeOf(got) != reflect.TypeOf(want) {
+			t.Fatalf("shape %d: concrete type = %T, want %T", id, got, want)
+		}
+	}
+}
+
+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Fatalf("decoded ShapeIndex IsFresh() = false, want true (must not require Build)")
+	}
+	want.Build()
+
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.maxEdgesPerCell != want.maxEdgesPerCell {
+		t.Fatalf("maxEdgesPerCell = %d, want %d", got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+	if got.nextID != want.nextID {
+		t.Fatalf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+
+	for id := int32(0); id <= want.nextID; id++ {
+		gs := got.Shape(id)
+		ws := want.Shape(id)
+		if (gs == nil) != (ws == nil) {
+			t.Fatalf("Shape(%d) nil = %v, want nil = %v", id, gs == nil, ws == nil)
+		}
+		if ws != nil {
+			assertShapeEqual(t, id, gs, ws)
+		}
+	}
+
+	// Verify the spatial cell structure directly before any iterator/query calls.
+	if len(got.cells) != len(want.cells) {
+		t.Fatalf("len(cells) = %d, want %d", len(got.cells), len(want.cells))
+	}
+	if len(got.cellMap) != len(want.cellMap) {
+		t.Fatalf("len(cellMap) = %d, want %d", len(got.cellMap), len(want.cellMap))
+	}
+	for i, cid := range want.cells {
+		if got.cells[i] != cid {
+			t.Fatalf("cells[%d] = %v, want %v", i, got.cells[i], cid)
+		}
+		gotCell := got.cellMap[cid]
+		wantCell := want.cellMap[cid]
+		if gotCell == nil || wantCell == nil {
+			t.Fatalf("cellMap[%v] = %v, want %v", cid, gotCell, wantCell)
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Fatalf("cell %v: len(shapes) = %d, want %d", cid, len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for j, wcs := range wantCell.shapes {
+			gcs := gotCell.shapes[j]
+			if gcs.shapeID != wcs.shapeID || gcs.containsCenter != wcs.containsCenter || !reflect.DeepEqual(gcs.edges, wcs.edges) {
+				t.Fatalf("cell %v clippedShape[%d] = %+v, want %+v", cid, j, gcs, wcs)
+			}
+		}
+	}
+
+	testIteratorMethods(t, got)
+	quadraticValidate(t, got)
+}
+
+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("Encode() produced empty byte stream")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	assertShapeIndexEqual(t, decoded, index)
+	return decoded
+}
+
+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	empty := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := empty.Encode(&buf); err != nil {
+		t.Fatalf("Encode() on empty index failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("empty ShapeIndex encoded to 0 bytes, want non-empty stream")
+	}
+
+	// Decode into a new empty index.
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+	assertShapeIndexEqual(t, decoded, empty)
+
+	// Decode into an already-populated index to ensure state is replaced.
+	populated := makeShapeIndex("0:0 | 1:1 # 0:0, 0:2 # 0:0, 0:5, 5:0")
+	populated.Build()
+	if err := populated.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() into populated index failed: %v", err)
+	}
+	assertShapeIndexEqual(t, populated, empty)
+}
