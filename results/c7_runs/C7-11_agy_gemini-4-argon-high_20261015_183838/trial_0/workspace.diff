+type crcByteReader struct {
+	r   byteReader
+	crc hash.Hash32
+}
+
+func (c *crcByteReader) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	if n > 0 {
+		_, _ = c.crc.Write(p[:n])
+	}
+	return n, err
+}
+
+func (c *crcByteReader) ReadByte() (byte, error) {
+	b, err := c.r.ReadByte()
+	if err == nil {
+		_, _ = c.crc.Write([]byte{b})
+	}
+	return b, err
+}
+
+type shapeIndexDecoder struct {
+	decoder
+	totalVerts uint64
+}
+
+func (d *shapeIndexDecoder) readStrictBool() bool {
+	if d.err != nil {
+		return false
+	}
+	b := d.readUint8()
+	if d.err != nil {
+		return false
+	}
+	if b > 1 {
+		d.err = fmt.Errorf("s2: invalid bool value %d", b)
+		return false
+	}
+	return b == 1
+}
+
+func (d *shapeIndexDecoder) readFiniteFloat64() float64 {
+	v := d.readFloat64()
+	if d.err != nil {
+		return 0
+	}
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		d.err = errors.New("s2: invalid float64 (NaN or Inf)")
+		return 0
+	}
+	return v
+}
+
+func (d *shapeIndexDecoder) readPoint() Point {
+	x := d.readFiniteFloat64()
+	y := d.readFiniteFloat64()
+	z := d.readFiniteFloat64()
+	return Point{r3.Vector{X: x, Y: y, Z: z}}
+}
+
+func (d *shapeIndexDecoder) readRawPoints(n uint32) []Point {
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedIndexVertices || d.totalVerts+uint64(n) > maxEncodedIndexTotalVerts {
+		d.err = fmt.Errorf("s2: too many vertices (%d)", n)
+		return nil
+	}
+	d.totalVerts += uint64(n)
+	pts := make([]Point, 0, min(int(n), maxInitialSliceAlloc))
+	for range n {
+		pt := d.readPoint()
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, pt)
+	}
+	return pts
+}
+
+func (d *shapeIndexDecoder) readPoints() []Point {
+	isNil := d.readStrictBool()
+	n := d.readUint32()
+	if d.err != nil {
+		return nil
+	}
+	if isNil && n != 0 {
+		d.err = errors.New("s2: non-zero count for nil slice")
+		return nil
+	}
+	pts := d.readRawPoints(n)
+	if d.err != nil {
+		return nil
+	}
+	if isNil {
+		return nil
+	}
+	return pts
+}
+
+func (d *shapeIndexDecoder) readRect() Rect {
+	var r Rect
+	if d.err != nil {
+		return r
+	}
+	if version := d.readUint8(); int8(version) != encodingVersion {
+		if d.err == nil {
+			d.err = fmt.Errorf("s2: unsupported Rect version %d", version)
+		}
+		return r
+	}
+	r.Lat.Lo = d.readFiniteFloat64()
+	r.Lat.Hi = d.readFiniteFloat64()
+	r.Lng.Lo = d.readFiniteFloat64()
+	r.Lng.Hi = d.readFiniteFloat64()
+	return r
+}
+
+func (d *shapeIndexDecoder) decodeLoop() *Loop {
+	pts := d.readPoints()
+	originInside := d.readStrictBool()
+	depth := int32(d.readUint32())
+	if d.err != nil {
+		return nil
+	}
+	if depth < 0 || depth > maxEncodedIndexLoops {
+		d.err = fmt.Errorf("s2: invalid loop depth %d", depth)
+		return nil
+	}
+	bound := d.readRect()
+	subregionBound := d.readRect()
+	hasIndex := d.readStrictBool()
+	if d.err != nil {
+		return nil
+	}
+	l := &Loop{
+		vertices:       pts,
+		originInside:   originInside,
+		depth:          int(depth),
+		bound:          bound,
+		subregionBound: subregionBound,
+	}
+	if hasIndex {
+		l.index = NewShapeIndex()
+		l.index.Add(l)
+	}
+	return l
+}
+
+func (d *shapeIndexDecoder) decodeShape() Shape {
+	kind := d.readUint8()
+	if d.err != nil {
+		return nil
