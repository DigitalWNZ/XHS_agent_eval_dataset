+func FuzzShapeIndexDecode(f *testing.F) {
+	empty := NewShapeIndex()
+	var emptyBuf bytes.Buffer
+	_ = empty.Encode(&emptyBuf)
+	f.Add(emptyBuf.Bytes())
+
+	rich := NewShapeIndex()
+	rich.Add(makePolygon("0:0, 0:5, 5:5, 5:0", true))
+	rich.Add(makePolyline("1:1, 2:2, 3:1"))
+	pv := PointVector{PointFromLatLng(LatLngFromDegrees(4, 4))}
+	rich.Add(&pv)
+	rich.Add(makeLaxPolyline("6:6, 7:8"))
+	rich.Add(makeLaxPolygon("10:10, 10:12, 12:12"))
+	rich.Add(makeLoop("-5:-5, -5:-1, -1:-1, -1:-5"))
+	rich.Add(LaxLoopFromPoints([]Point{
+		PointFromLatLng(LatLngFromDegrees(-10, 0)),
+		PointFromLatLng(LatLngFromDegrees(-10, 2)),
+		PointFromLatLng(LatLngFromDegrees(-8, 2)),
+	}))
+	rich.Add(edgeVectorShapeFromPoints(
+		PointFromLatLng(LatLngFromDegrees(20, 20)),
+		PointFromLatLng(LatLngFromDegrees(21, 21)),
+	))
+	var richBuf bytes.Buffer
+	_ = rich.Encode(&richBuf)
+	f.Add(richBuf.Bytes())
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		idx := NewShapeIndex()
+		_ = idx.Decode(bytes.NewReader(data))
+
+		// Also test with a valid CRC32 appended so the fuzzer exercises structural decoding.
+		withCRC := makeRawShapeIndexWithChecksum(data)
+		idx2 := NewShapeIndex()
+		if err := idx2.Decode(bytes.NewReader(withCRC)); err == nil {
+			_ = idx2.Len()
+			_ = idx2.NumEdges()
+			for it := idx2.Iterator(); !it.Done(); it.Next() {
+				_ = it.CellID()
+				_ = it.IndexCell()
+			}
+		}
+	})
+}
