+func TestShapeIndexEncodeDecodeWithoutExplicitBuild(t *testing.T) {
+	index := NewShapeIndex()
+	poly := makePolygon("0:0, 0:10, 10:10, 10:0", true)
+	line := makePolyline("-5:5, 5:5, 15:5")
+	pts := PointVector{
+		PointFromLatLng(LatLngFromDegrees(5, 5)),
+		PointFromLatLng(LatLngFromDegrees(20, 20)),
+	}
+	index.Add(poly)
+	index.Add(line)
+	index.Add(&pts)
+
+	if index.IsFresh() {
+		t.Fatalf("newly populated ShapeIndex before Build() should not be fresh")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() without explicit Build() failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+
+	// Verify the spatial cell structure is already populated before any query or Build call.
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded.IsFresh() = false, want true")
+	}
+	if len(decoded.cells) == 0 || len(decoded.cellMap) == 0 {
+		t.Fatalf("decoded cells (%d) or cellMap (%d) is empty before Build", len(decoded.cells), len(decoded.cellMap))
+	}
+
+	// Exercise iteration and queries directly on decoded without calling Build.
+	insidePt := PointFromLatLng(LatLngFromDegrees(3, 3))
+	outsidePt := PointFromLatLng(LatLngFromDegrees(-10, -10))
+
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(insidePt) {
+		t.Errorf("ContainsPointQuery.Contains(insidePt) = false, want true")
+	}
+	if cpq.Contains(outsidePt) {
+		t.Errorf("ContainsPointQuery.Contains(outsidePt) = true, want false")
+	}
+
+	ceq := NewCrossingEdgeQuery(decoded)
+	crossings := ceq.Crossings(
+		PointFromLatLng(LatLngFromDegrees(5, -2)),
+		PointFromLatLng(LatLngFromDegrees(5, 12)),
+		decoded.Shape(0),
+		CrossingTypeAll,
+	)
+	if len(crossings) == 0 {
+		t.Errorf("CrossingEdgeQuery.Crossings found no crossings on decoded index")
+	}
+	edgeMap := ceq.CrossingsEdgeMap(
+		PointFromLatLng(LatLngFromDegrees(5, -2)),
+		PointFromLatLng(LatLngFromDegrees(5, 12)),
+		CrossingTypeAll,
+	)
+	if len(edgeMap) == 0 {
+		t.Errorf("CrossingEdgeQuery.CrossingsEdgeMap found no crossings on decoded index")
+	}
+
+	closestQuery := NewClosestEdgeQuery(decoded, NewClosestEdgeQueryOptions())
+	target := NewMinDistanceToPointTarget(PointFromLatLng(LatLngFromDegrees(0, 5)))
+	results := closestQuery.FindEdges(target)
+	if len(results) == 0 {
+		t.Errorf("ClosestEdgeQuery returned empty results on decoded index")
+	}
+
+	region := decoded.Region()
+	if !region.CapBound().ContainsPoint(insidePt) {
+		t.Errorf("ShapeIndexRegion.CapBound().ContainsPoint(insidePt) = false, want true")
+	}
+
+	assertShapeIndexEqual(t, decoded, index)
+}
