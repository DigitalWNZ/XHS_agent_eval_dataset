+		refContained := d.readStrictBool()
+		refPoint := d.readPoint()
+		isEmpty := d.readStrictBool()
+		isFull := d.readStrictBool()
+		nchains := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nchains > maxEncodedIndexVertices {
+			d.err = fmt.Errorf("s2: too many chains (%d)", nchains)
+			return nil
+		}
+		chains := make([]Chain, 0, min(int(nchains), maxInitialSliceAlloc))
+		for range nchains {
+			start := d.readUint32()
+			length := d.readUint32()
+			if d.err != nil {
+				return nil
+			}
+			if start > maxEncodedIndexVertices || length > maxEncodedIndexVertices {
+				d.err = errors.New("s2: invalid chain bounds")
+				return nil
+			}
+			chains = append(chains, Chain{Start: int(start), Length: int(length)})
+		}
+		nedges := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nedges > maxEncodedIndexVertices || d.totalVerts+uint64(nedges)*2 > maxEncodedIndexTotalVerts {
+			d.err = fmt.Errorf("s2: too many edges (%d)", nedges)
+			return nil
+		}
+		d.totalVerts += uint64(nedges) * 2
+		edges := make([]Edge, 0, min(int(nedges), maxInitialSliceAlloc))
+		for range nedges {
+			v0 := d.readPoint()
+			v1 := d.readPoint()
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, Edge{V0: v0, V1: v1})
+		}
+		for _, ch := range chains {
+			if ch.Start < 0 || ch.Length < 0 || ch.Start+ch.Length > len(edges) {
+				d.err = errors.New("s2: chain out of edge bounds")
+				return nil
+			}
+		}
+		return &genericShape{
+			dimension: int(dim),
+			tag:       tag,
+			refPoint:  ReferencePoint{Point: refPoint, Contained: refContained},
+			isEmpty:   isEmpty,
+			isFull:    isFull,
+			chains:    chains,
+			edges:     edges,
+		}
+
+	default:
+		d.err = fmt.Errorf("s2: unknown encoded shape kind %d", kind)
+		return nil
+	}
+}
+
+// Decode decodes the ShapeIndex from the given reader.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if s == nil {
+		return errors.New("s2: cannot decode into nil ShapeIndex")
+	}
+	if r == nil {
+		return errors.New("s2: cannot decode ShapeIndex from nil reader")
+	}
+	br := asByteReader(r)
+	crc := crc32.NewIEEE()
+	cr := &crcByteReader{r: br, crc: crc}
+	d := &shapeIndexDecoder{
+		decoder: decoder{r: cr},
+	}
+	s.decode(d, crc)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *shapeIndexDecoder, crc hash.Hash32) {
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: unsupported ShapeIndex version %d", version)
+		return
+	}
+
+	maxEdgesPerCell := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > maxEncodedIndexEdgesPerCell {
+		d.err = fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdgesPerCell)
+		return
+	}
+
+	nextID := d.readUint32()
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedIndexShapes || numShapes > nextID || numShapes > maxEncodedIndexShapes {
+		d.err = fmt.Errorf("s2: invalid shape counts (nextID=%d, numShapes=%d)", nextID, numShapes)
+		return
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), maxInitialSliceAlloc))
+	prevShapeID := int32(-1)
+	for i := uint32(0); i < numShapes; i++ {
+		id := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if id >= nextID || (i > 0 && int32(id) <= prevShapeID) {
+			d.err = fmt.Errorf("s2: invalid shape ID %d", id)
+			return
+		}
+		prevShapeID = int32(id)
+		sh := d.decodeShape()
+		if d.err != nil {
+			return
+		}
+		shapes[int32(id)] = sh
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedIndexCells || (numShapes == 0 && numCells > 0) {
+		d.err = fmt.Errorf("s2: invalid cell count %d", numCells)
+		return
+	}
+
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(int(numCells), maxInitialSliceAlloc))
+	}
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), maxInitialSliceAlloc))
+	var totalClippedEdges uint64
+
+	for i := uint32(0); i < numCells; i++ {
+		cid := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !cid.IsValid() || (i > 0 && cid.RangeMin() <= cells[i-1].RangeMax()) {
+			d.err = fmt.Errorf("s2: invalid or out-of-order cell ID %v", cid)
+			return
+		}
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped > numShapes || numClipped > maxEncodedIndexShapes {
+			d.err = fmt.Errorf("s2: too many clipped shapes in cell (%d)", numClipped)
+			return
+		}
+
+		clippedShapes := make([]*clippedShape, 0, min(int(numClipped), maxInitialSliceAlloc))
+		prevClippedShapeID := int32(-1)
+		for j := uint32(0); j < numClipped; j++ {
+			cShapeID := d.readUint32()
+			containsCenter := d.readStrictBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+			if cShapeID >= nextID || (j > 0 && int32(cShapeID) <= prevClippedShapeID) {
+				d.err = fmt.Errorf("s2: invalid clipped shape ID %d", cShapeID)
+				return
+			}
+			shape := shapes[int32(cShapeID)]
+			if shape == nil {
+				d.err = fmt.Errorf("s2: clipped shape references missing shape ID %d", cShapeID)
+				return
+			}
+			prevClippedShapeID = int32(cShapeID)
+
+			shapeNumEdges := uint32(shape.NumEdges())
+			if numEdges > shapeNumEdges || totalClippedEdges+uint64(numEdges) > maxEncodedIndexTotalVerts {
+				d.err = fmt.Errorf("s2: too many clipped edges (%d > %d)", numEdges, shapeNumEdges)
+				return
+			}
+			totalClippedEdges += uint64(numEdges)
+
+			edges := make([]int, 0, min(int(numEdges), maxInitialSliceAlloc))
+			prevEdgeID := -1
+			for k := uint32(0); k < numEdges; k++ {
+				edgeID := d.readUint32()
+				if d.err != nil {
+					return
+				}
+				if edgeID >= shapeNumEdges || (k > 0 && int(edgeID) <= prevEdgeID) {
+					d.err = fmt.Errorf("s2: invalid clipped edge ID %d", edgeID)
+					return
+				}
+				prevEdgeID = int(edgeID)
+				edges = append(edges, int(edgeID))
+			}
+
+			clippedShapes = append(clippedShapes, &clippedShape{
+				shapeID:        int32(cShapeID),
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		cells = append(cells, cid)
+		cellMap[cid] = &ShapeIndexCell{shapes: clippedShapes}
+	}
+
+	gotCRC := crc.Sum32()
+	wantCRC := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if gotCRC != wantCRC {
+		d.err = fmt.Errorf("s2: ShapeIndex checksum mismatch: got %#08x, want %#08x", gotCRC, wantCRC)
+		return
+	}
+
+	s.mu.Lock()
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+}
