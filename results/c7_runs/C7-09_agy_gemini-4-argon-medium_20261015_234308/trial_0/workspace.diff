+func TestConsistentHashIREquals(t *testing.T) {
+	headerHP := &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+				HeaderName: "x-user-id",
+			},
+		},
+		Terminal: true,
+	}
+	sourceIPHP := &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        PolicySubIR
+		expected bool
+	}{
+		{
+			name:     "both nil are equal",
+			a:        nil,
+			b:        (*consistentHashIR)(nil),
+			expected: true,
+		},
+		{
+			name:     "nil vs non-nil are not equal",
+			a:        nil,
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "non-nil vs nil are not equal",
+			a:        &consistentHashIR{},
+			b:        (*consistentHashIR)(nil),
+			expected: false,
+		},
+		{
+			name:     "different PolicySubIR type is not equal",
+			a:        &consistentHashIR{},
+			b:        &urlRewriteIR{},
+			expected: false,
+		},
+		{
+			name:     "different disable flag is not equal",
+			a:        &consistentHashIR{disable: true},
+			b:        &consistentHashIR{disable: false},
+			expected: false,
+		},
+		{
+			name:     "same hash policies are equal",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP}},
+			expected: true,
+		},
+		{
+			name:     "different hash policies are not equal",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHP}},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.a.Equals(tt.b))
+		})
+	}
+}
