+		assert.Equal(t, "fs-high", hps[5].GetFilterState().GetKey())
+		assert.True(t, hps[5].GetTerminal())
+		assert.Equal(t, "fs-low", hps[6].GetFilterState().GetKey())
+		assert.False(t, hps[6].GetTerminal())
+
+		// Merge origins must record both policies under "consistentHash"
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-policy",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-policy",
+		}, origins)
+	})
+
+	t.Run("disable on higher-priority policy suppresses inherited broader-scoped policy", func(t *testing.T) {
+		highSpec := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Disable: true,
+			},
+		}, highSpec))
+
+		lowSpec := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "x-user"},
+				},
+			},
+		}, lowSpec))
+
+		p1 := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "rule-disable-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: *highSpec},
+		}
+		p2 := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "route-broad-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: *lowSpec},
+		}
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+		assert.Empty(t, mergedTP.spec.consistentHash.hashPolicies)
+
+		// Apply to route should produce no hash policies
+		outRoute := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		plugin := &trafficPolicyPluginGwPass{}
+		require.NoError(t, plugin.ApplyForRoute(&ir.RouteContext{Policy: mergedTP}, outRoute))
+		assert.Empty(t, outRoute.GetRoute().GetHashPolicy())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/rule-disable-policy",
+		}, origins)
+	})
+
+	t.Run("sourceIp set on higher-priority policy is retained over lower-priority policy", func(t *testing.T) {
+		highSpec := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				SourceIp: &kgateway.ConsistentHashSourceIp{Terminal: false},
+			},
+		}, highSpec))
+
+		lowSpec := &trafficPolicySpecIr{}
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "x-user", Terminal: true},
+				},
+				SourceIp: &kgateway.ConsistentHashSourceIp{Terminal: true},
+			},
+		}, lowSpec))
+
+		p1 := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "high-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: *highSpec},
+		}
+		p2 := ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Group: gk.Group, Kind: gk.Kind, Namespace: "default", Name: "low-policy"},
+			PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: *lowSpec},
+		}
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		// Canonical order: headers first, then sourceIp (from high with terminal=false)
+		require.Len(t, hps, 2)
+		assert.Equal(t, "x-user", hps[0].GetHeader().GetHeaderName())
+		assert.True(t, hps[0].GetTerminal())
+		require.NotNil(t, hps[1].GetConnectionProperties())
+		assert.True(t, hps[1].GetConnectionProperties().GetSourceIp())
+		assert.False(t, hps[1].GetTerminal())
+	})
+}
