+		assert.False(t, hps[3].GetTerminal())
+
+		// 5-6: QueryParameters
+		assert.Equal(t, "user", hps[4].GetQueryParameter().GetName())
+		assert.True(t, hps[4].GetTerminal())
+		assert.Equal(t, "tenant", hps[5].GetQueryParameter().GetName())
+		assert.False(t, hps[5].GetTerminal())
+
+		// 7-8: FilterState
+		assert.Equal(t, "filter-key-1", hps[6].GetFilterState().GetKey())
+		assert.True(t, hps[6].GetTerminal())
+		assert.Equal(t, "filter-key-2", hps[7].GetFilterState().GetKey())
+		assert.False(t, hps[7].GetTerminal())
+
+		// 9: SourceIp
+		require.NotNil(t, hps[8].GetConnectionProperties())
+		assert.True(t, hps[8].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hps[8].GetTerminal())
