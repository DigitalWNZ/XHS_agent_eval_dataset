+  consistentHash: {}
+`,
+		},
+		{
+			name: "valid disable true alone",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-ch
+spec:
+  consistentHash:
+    disable: true
+`,
+		},
+		{
+			name: "valid full consistentHash config",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-full-ch
+spec:
+  consistentHash:
+    headers:
+    - headerName: x-user
+      regexRewrite:
+        pattern: "^user-(.*)"
+        substitution: "\\1"
+      terminal: true
+    cookies:
+    - name: session
+      ttl: 1h30m
+      path: /
+      attributes:
+      - name: SameSite
