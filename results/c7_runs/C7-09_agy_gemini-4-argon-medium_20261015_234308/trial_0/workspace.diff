+			name:        "nil IR is valid",
+			ir:          nil,
+			expectError: false,
+		},
+		{
+			name:        "empty IR is valid",
+			ir:          &consistentHashIR{},
+			expectError: false,
+		},
+		{
+			name: "valid header with regex rewrite",
+			ir: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-user",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^user-(.*)"},
+									Substitution: "\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+			expectError: false,
+		},
+		{
+			name: "invalid regex in header regex rewrite",
+			ir: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-user",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "[invalid("},
+									Substitution: "\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+			expectError: true,
+		},
