+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: empty-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "empty.example.com"
+  rules:
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /empty
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: empty-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: empty-hash-route
+  consistentHash: {}
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: merge-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "merge.example.com"
+  rules:
+    - name: rule-merge
+      matches:
+        - path:
+            type: PathPrefix
+            value: /merge
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: rule-disable
+      matches:
+        - path:
+            type: PathPrefix
+            value: /disable
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: merge-hash-route
+  consistentHash:
+    headers:
+      - headerName: x-shared
+        terminal: false
+      - headerName: x-route
+        terminal: true
+    cookies:
+      - name: c-shared
+        ttl: 120s
+      - name: c-route
+        ttl: "3600"
+        path: /api
+        attributes:
+          - name: SameSite
+            value: Strict
+        terminal: true
+    queryParameters:
+      - name: q-route
+        terminal: true
+    filterState:
+      - key: fs-route
+        terminal: false
+    sourceIp:
+      terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-merge-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: merge-hash-route
+      sectionName: rule-merge
+  consistentHash:
+    headers:
+      - headerName: X-Shared
+        regexRewrite:
+          pattern: "^v1-(.*)"
+          substitution: "\\1"
+        terminal: true
+      - headerName: x-rule
+        terminal: false
+    cookies:
+      - name: c-shared
+        ttl: 1h30m
+        terminal: false
+    queryParameters:
+      - name: q-rule
+        terminal: false
+    filterState:
+      - key: fs-rule
+        terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-disable-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: merge-hash-route
+      sectionName: rule-disable
+  consistentHash:
+    disable: true
