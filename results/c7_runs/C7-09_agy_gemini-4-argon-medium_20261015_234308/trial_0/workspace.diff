+      terminal: false
+    queryParameters:
+    - name: id
+      terminal: true
+    filterState:
+    - key: filter.key
+      terminal: false
+    sourceIp:
+      terminal: true
+`,
+		},
+		{
+			name: "invalid disable true with headers",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-headers
+spec:
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-user
+`,
+			wantErr: "when disable is true, no other fields may be set",
+		},
+		{
+			name: "invalid disable true with cookies",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-cookies
+spec:
+  consistentHash:
+    disable: true
+    cookies:
+    - name: session
+`,
+			wantErr: "when disable is true, no other fields may be set",
+		},
+		{
+			name: "invalid disable true with queryParameters",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-qp
+spec:
+  consistentHash:
+    disable: true
+    queryParameters:
+    - name: id
+`,
+			wantErr: "when disable is true, no other fields may be set",
+		},
+		{
+			name: "invalid disable true with filterState",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-fs
+spec:
+  consistentHash:
+    disable: true
+    filterState:
+    - key: k
+`,
+			wantErr: "when disable is true, no other fields may be set",
+		},
+		{
+			name: "invalid disable true with sourceIp",
+			yamlStr: `
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-invalid-sourceip
+spec:
+  consistentHash:
+    disable: true
+    sourceIp:
+      terminal: true
+`,
+			wantErr: "when disable is true, no other fields may be set",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			obj := &unstructured.Unstructured{}
+			require.NoError(t, yaml.Unmarshal([]byte(tc.yamlStr), obj))
+			err := v.ValidateCustomResource(obj)
+			if tc.wantErr == "" {
+				assert.NoError(t, err)
+			} else {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tc.wantErr)
+			}
+		})
+	}
+}
