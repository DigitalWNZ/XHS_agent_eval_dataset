+func TestApplyConsistentHash(t *testing.T) {
+	t.Run("nil consistentHash leaves RouteAction untouched", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+		applyConsistentHash(nil, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+	})
+
+	t.Run("disable=true clears any hash policies on RouteAction", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{
+					HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{defaultSourceIPHashPolicy()},
+				},
+			},
+		}
+		applyConsistentHash(&consistentHashIR{disable: true}, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+	})
+
+	t.Run("empty consistentHashIR defaults to single sourceIp policy with terminal=false", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+		applyConsistentHash(&consistentHashIR{}, route)
+		require.Len(t, route.GetRoute().GetHashPolicy(), 1)
+		assert.True(t, route.GetRoute().GetHashPolicy()[0].GetConnectionProperties().GetSourceIp())
+		assert.False(t, route.GetRoute().GetHashPolicy()[0].GetTerminal())
+	})
+}
