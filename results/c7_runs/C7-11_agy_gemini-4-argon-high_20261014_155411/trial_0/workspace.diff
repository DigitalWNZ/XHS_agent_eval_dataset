+func TestMergeConsistentHash(t *testing.T) {
+	gk := wellknown.TrafficPolicyGVK.GroupKind()
+
+	buildPolicyAtt := func(name string, ch *kgateway.ConsistentHash, hierarchy int, priority apiannotations.InheritedPolicyPriorityValue) ir.PolicyAtt {
+		specIr := trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, &specIr)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{
+				Group:     gk.Group,
+				Kind:      gk.Kind,
+				Namespace: "default",
+				Name:      name,
+			},
+			PolicyIr:                &TrafficPolicy{ct: time.Now(), spec: specIr},
+			HierarchicalPriority:    hierarchy,
+			InheritedPolicyPriority: priority,
+		}
+	}
+
+	t.Run("multiple policies union array fields, deduplicate, re-sort into canonical order, and retain high-priority unset sourceIp", func(t *testing.T) {
+		// High-priority policy has header X-First, cookie c1, filterState fs1, and NO sourceIp
+		high := buildPolicyAtt("high-policy", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-First", Terminal: new(false)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1", Path: new("/high")},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs1", Terminal: new(true)},
+			},
+		}, 0, "")
+
+		// Low-priority policy has duplicate header x-first (different case), new header x-second,
+		// duplicate cookie c1, new cookie c2, queryParameter qp1, filterState fs2, and sourceIp
+		low := buildPolicyAtt("low-policy", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-first", Terminal: new(true)},
+				{HeaderName: "x-second", Terminal: new(false)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1", Path: new("/low")},
+				{Name: "c2", Path: new("/low2")},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "qp1", Terminal: new(false)},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs1", Terminal: new(false)},
+				{Key: "fs2", Terminal: new(false)},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		}, 0, "")
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.False(t, mergedTP.spec.consistentHash.disable)
+
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		// Expected in canonical order:
+		// 0: Header "X-First" (from high, terminal=false)
+		// 1: Header "x-second" (from low, terminal=false)
+		// 2: Cookie "c1" (from high, path=/high)
+		// 3: Cookie "c2" (from low, path=/low2)
+		// 4: QueryParameter "qp1" (from low)
+		// 5: FilterState "fs1" (from high, terminal=true)
+		// 6: FilterState "fs2" (from low, terminal=false)
+		// NO SourceIp (because high had unset sourceIp)
+		require.Len(t, hps, 7)
+
+		assert.Equal(t, "X-First", hps[0].GetHeader().GetHeaderName())
+		assert.False(t, hps[0].GetTerminal())
+		assert.Equal(t, "x-second", hps[1].GetHeader().GetHeaderName())
+
+		assert.Equal(t, "c1", hps[2].GetCookie().GetName())
+		assert.Equal(t, "/high", hps[2].GetCookie().GetPath())
+		assert.Equal(t, "c2", hps[3].GetCookie().GetName())
+		assert.Equal(t, "/low2", hps[3].GetCookie().GetPath())
+
+		assert.Equal(t, "qp1", hps[4].GetQueryParameter().GetName())
+
+		assert.Equal(t, "fs1", hps[5].GetFilterState().GetKey())
+		assert.True(t, hps[5].GetTerminal())
+		assert.Equal(t, "fs2", hps[6].GetFilterState().GetKey())
+		assert.False(t, hps[6].GetTerminal())
+
+		// Merge metadata records consistentHash with both policies
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-policy",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-policy",
+		}, origins)
+	})
+
+	t.Run("high-priority sourceIp is retained when set", func(t *testing.T) {
+		high := buildPolicyAtt("high-policy", &kgateway.ConsistentHash{
+			SourceIp: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		}, 0, "")
+		low := buildPolicyAtt("low-policy", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-low"},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(false),
+			},
+		}, 0, "")
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 2)
+		// Re-sorted into canonical order: Header first, then SourceIp
+		assert.Equal(t, "x-low", hps[0].GetHeader().GetHeaderName())
+		require.NotNil(t, hps[1].GetConnectionProperties())
+		assert.True(t, hps[1].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hps[1].GetTerminal())
+	})
+
+	t.Run("disable=true on narrower-scoped policy suppresses broader-scoped policy", func(t *testing.T) {
+		narrow := buildPolicyAtt("narrow-disable", &kgateway.ConsistentHash{
+			Disable: new(true),
+		}, 0, "")
+		broad := buildPolicyAtt("broad-hash", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-broad"},
+			},
+		}, -1, "")
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{narrow, broad}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/narrow-disable",
+		}, origins)
+	})
+
+	t.Run("prefer parent hierarchy (OverridableShallowMerge) uses parent as higher priority", func(t *testing.T) {
+		child := buildPolicyAtt("child-policy", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared", Terminal: new(false)},
+				{HeaderName: "x-child", Terminal: new(false)},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		}, 0, apiannotations.ShallowMergePreferParent)
+
+		parent := buildPolicyAtt("parent-policy", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Shared", Terminal: new(true)},
+				{HeaderName: "X-Parent", Terminal: new(false)},
+			},
+		}, -1, apiannotations.ShallowMergePreferParent)
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{child, parent}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		// Parent is higher priority: X-Shared (from parent, terminal=true), X-Parent (from parent), x-child (from child), NO sourceIp (unset in parent)
+		require.Len(t, hps, 3)
+		assert.Equal(t, "X-Shared", hps[0].GetHeader().GetHeaderName())
+		assert.True(t, hps[0].GetTerminal())
+		assert.Equal(t, "X-Parent", hps[1].GetHeader().GetHeaderName())
+		assert.Equal(t, "x-child", hps[2].GetHeader().GetHeaderName())
+	})
+}
