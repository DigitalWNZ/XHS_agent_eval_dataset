+		assert.Equal(t, "SameSite", hps[1].GetCookie().GetAttributes()[0].GetName())
+		assert.Equal(t, "Strict", hps[1].GetCookie().GetAttributes()[0].GetValue())
+		assert.Equal(t, "Secure", hps[1].GetCookie().GetAttributes()[1].GetName())
+		assert.Equal(t, "true", hps[1].GetCookie().GetAttributes()[1].GetValue())
+		assert.False(t, hps[1].GetTerminal())
+
+		require.NotNil(t, hps[2].GetCookie())
+		assert.Equal(t, "plain-seconds-cookie", hps[2].GetCookie().GetName())
+		assert.Equal(t, durationpb.New(3600*time.Second), hps[2].GetCookie().GetTtl())
+		assert.False(t, hps[2].GetTerminal())
+
+		// 3. QueryParameter
+		require.NotNil(t, hps[3].GetQueryParameter())
+		assert.Equal(t, "qp-name", hps[3].GetQueryParameter().GetName())
+		assert.True(t, hps[3].GetTerminal())
+
+		// 4. FilterState
+		require.NotNil(t, hps[4].GetFilterState())
