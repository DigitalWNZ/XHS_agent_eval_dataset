+		assert.False(t, hps[4].GetTerminal())
+
+		// 5. SourceIp
+		require.NotNil(t, hps[5].GetConnectionProperties())
+		assert.True(t, hps[5].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hps[5].GetTerminal())
