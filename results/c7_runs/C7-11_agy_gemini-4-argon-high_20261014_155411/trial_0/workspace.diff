+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "example.com"
+  rules:
+    - name: rule0
+      matches:
+        - path:
+            type: PathPrefix
+            value: /merged
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: rule1
+      matches:
+        - path:
+            type: PathPrefix
+            value: /disabled
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: rule2
+      matches:
+        - path:
+            type: PathPrefix
+            value: /inherited
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: empty-consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "empty.example.com"
+  rules:
+    - name: rule0
+      matches:
+        - path:
+            type: PathPrefix
+            value: /empty
+      backendRefs:
+        - name: example-svc
+          port: 8000
+      filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: gateway.kgateway.dev
+            kind: TrafficPolicy
+            name: empty-consistent-hash-policy
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-consistent-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+  consistentHash:
+    headers:
+      - headerName: x-session-id
+        terminal: true
+      - headerName: x-route-header
+    cookies:
+      - name: session
+        ttl: "3600"
+        path: /
+        attributes:
+          - name: SameSite
+            value: Lax
+    sourceIp:
+      terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule0-consistent-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule0
+  consistentHash:
+    headers:
+      - headerName: X-Session-ID
+        regexRewrite:
+          pattern: "^prefix-(.*)"
+          substitution: "\\1"
+        terminal: false
+    queryParameters:
+      - name: user_id
+        terminal: false
+    filterState:
+      - key: envoy.network.transport_socket.original_dst_address
+        terminal: false
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule1-disable-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule1
+  consistentHash:
+    disable: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: empty-consistent-hash-policy
+spec:
+  consistentHash: {}
