+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		// Expect: Header(X-Req-Id), Header(X-Org-Id), Cookie(c1), QueryParam(q1), QueryParam(q2), FilterState(fs1). No SourceIp!
+		require.Len(t, hps, 6)
+
+		assert.Equal(t, "X-Req-Id", hps[0].GetHeader().GetHeaderName())
+		assert.True(t, hps[0].GetTerminal())
+		assert.Equal(t, "X-Org-Id", hps[1].GetHeader().GetHeaderName())
+		assert.Equal(t, "c1", hps[2].GetCookie().GetName())
+		assert.Equal(t, "q1", hps[3].GetQueryParameter().GetName())
+		assert.True(t, hps[3].GetTerminal())
+		assert.Equal(t, "q2", hps[4].GetQueryParameter().GetName())
+		assert.Equal(t, "fs1", hps[5].GetFilterState().GetKey())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high",
+			"gateway.kgateway.dev/TrafficPolicy/default/low",
+		}, origins)
+	})
+
+	t.Run("higher priority sourceIp retained and resorted after lower priority array fields", func(t *testing.T) {
+		pHigh := buildPolicyAtt("high", &kgateway.ConsistentHash{
+			Headers: []kgateway.HeaderHashPolicy{
+				{HeaderName: "X-A"},
+			},
+			SourceIp: &kgateway.SourceIpHashPolicy{
+				Terminal: new(true),
+			},
+		})
+		pLow := buildPolicyAtt("low", &kgateway.ConsistentHash{
+			Cookies: []kgateway.CookieHashPolicy{
+				{Name: "c1"},
+			},
+			SourceIp: &kgateway.SourceIpHashPolicy{
+				Terminal: new(false),
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 3)
+		assert.Equal(t, "X-A", hps[0].GetHeader().GetHeaderName())
+		assert.Equal(t, "c1", hps[1].GetCookie().GetName())
+		require.NotNil(t, hps[2].GetConnectionProperties())
+		assert.True(t, hps[2].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hps[2].GetTerminal())
+	})
+
+	t.Run("disable=true in higher priority suppresses lower priority", func(t *testing.T) {
+		pHigh := buildPolicyAtt("high", &kgateway.ConsistentHash{
+			Disable: new(true),
+		})
+		pLow := buildPolicyAtt("low", &kgateway.ConsistentHash{
+			Headers: []kgateway.HeaderHashPolicy{
+				{HeaderName: "X-A"},
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disable)
+		assert.Empty(t, mergedTP.spec.consistentHash.hashPolicies)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.Equal(t, []string{"gateway.kgateway.dev/TrafficPolicy/default/high"}, origins)
+	})
+
+	t.Run("higher priority empty consistentHash retains unset sourceIp when merged with lower priority", func(t *testing.T) {
+		pHigh := buildPolicyAtt("high", &kgateway.ConsistentHash{})
+		pLow := buildPolicyAtt("low", &kgateway.ConsistentHash{
+			Headers: []kgateway.HeaderHashPolicy{
+				{HeaderName: "X-From-Low"},
+			},
+			SourceIp: &kgateway.SourceIpHashPolicy{
+				Terminal: new(true),
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 1)
+		assert.Equal(t, "X-From-Low", hps[0].GetHeader().GetHeaderName())
+	})
+
+	t.Run("middle priority disable=true suppresses lowest priority while retaining highest priority", func(t *testing.T) {
+		pHigh := buildPolicyAtt("high", &kgateway.ConsistentHash{
+			Headers: []kgateway.HeaderHashPolicy{
+				{HeaderName: "X-High"},
+			},
+		})
+		pMid := buildPolicyAtt("mid", &kgateway.ConsistentHash{
+			Disable: new(true),
+		})
+		pLow := buildPolicyAtt("low", &kgateway.ConsistentHash{
+			Cookies: []kgateway.CookieHashPolicy{
+				{Name: "c-low"},
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pHigh, pMid, pLow}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		hps := mergedTP.spec.consistentHash.hashPolicies
+		require.Len(t, hps, 1)
+		assert.Equal(t, "X-High", hps[0].GetHeader().GetHeaderName())
+	})
+}
