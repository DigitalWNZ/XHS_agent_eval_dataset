+func TestConsistentHashCRDValidation(t *testing.T) {
+	root := fsutils.GetModuleRoot()
+	dirs := []string{filepath.Join(root, "pkg/kgateway/crds/gateway-crds.yaml")}
+	dir, err := os.ReadDir(filepath.Join(root, "install/helm/kgateway-crds/templates/"))
+	require.NoError(t, err)
+	for _, d := range dir {
+		if strings.HasSuffix(d.Name(), ".yaml") {
+			dirs = append(dirs, filepath.Join(root, "install/helm/kgateway-crds/templates", d.Name()))
+		}
+	}
+	v, err := crd.NewValidatorFromFiles(dirs...)
+	require.NoError(t, err)
+
+	validateYAML := func(yamlStr string) error {
+		obj := &unstructured.Unstructured{}
+		require.NoError(t, yaml.Unmarshal([]byte(yamlStr), obj))
+		return v.ValidateCustomResource(obj)
+	}
+
+	require.NoError(t, validateYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: valid-disable
+spec:
+  consistentHash:
+    disable: true
+`))
+
+	require.NoError(t, validateYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: valid-empty
+spec:
+  consistentHash: {}
+`))
+
+	require.NoError(t, validateYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: valid-full
+spec:
+  consistentHash:
+    headers:
+    - headerName: x-user
+      regexRewrite:
+        pattern: "^user-(.*)"
+        substitution: "\\1"
+      terminal: true
+    cookies:
+    - name: session
+      ttl: "3600"
+      path: "/api"
+      attributes:
+      - name: SameSite
+        value: Strict
+      terminal: false
+    queryParameters:
+    - name: user_id
+      terminal: true
+    filterState:
+    - key: envoy.network.transport_socket.original_dst_address
+      terminal: false
+    sourceIp:
+      terminal: true
+`))
+
+	err = validateYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: invalid-disable-with-headers
+spec:
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-user
+`)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "when disable is true, no other fields may be set")
+}
