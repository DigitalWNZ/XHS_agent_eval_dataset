+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
