+								HeaderName: "x-user",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^user-(.*)"},
+									Substitution: "\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+			expectError: false,
+		},
+		{
+			name: "invalid header regex rewrite",
+			ir: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
