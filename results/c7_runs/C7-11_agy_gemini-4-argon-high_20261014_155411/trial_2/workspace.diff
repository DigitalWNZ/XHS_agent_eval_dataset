+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule-merged
+  consistentHash:
+    headers:
+      - headerName: X-Shared
+        regexRewrite:
+          pattern: "^prefix-(.*)"
+          substitution: "\\1"
+        terminal: true
+    queryParameters:
+      - name: tenant
+    filterState:
+      - key: envoy.network.application_protocol
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-disabled-consistent-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule-disabled
+  consistentHash:
+    disable: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: empty-consistent-hash-policy
+spec:
+  consistentHash: {}
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: empty-ch-route
