index a04effb82..8c1a770a4 100644
--- a/api/tests/cel_test.go
+++ b/api/tests/cel_test.go
@@ -3,6 +3,8 @@ package tests
 import (
 	"testing"
 
+	"github.com/stretchr/testify/require"
+
 	"github.com/kgateway-dev/kgateway/v2/test/crvalidation"
 )
 
@@ -10,3 +12,100 @@ func TestCRDs(t *testing.T) {
 	v := NewKgatewayValidator(t)
 	crvalidation.TestCRValidation(t, v, "testdata")
 }
+
+func TestTrafficPolicyConsistentHashCEL(t *testing.T) {
+	v := NewKgatewayValidator(t)
+
+	t.Run("valid empty consistentHash", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-empty-ch
+spec:
+  consistentHash: {}
+`, nil)
+		require.NoError(t, err)
+	})
+
+	t.Run("valid disable=true alone", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-ch
+spec:
+  consistentHash:
+    disable: true
+`, nil)
+		require.NoError(t, err)
+	})
+
+	t.Run("invalid disable=true with headers", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-with-headers
+spec:
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-user
+`, nil)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "when disable is true, no other fields may be set")
+	})
+
+	t.Run("invalid disable=true with sourceIp", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-disable-with-source-ip
+spec:
+  consistentHash:
+    disable: true
+    sourceIp:
+      terminal: true
+`, nil)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "when disable is true, no other fields may be set")
+	})
+
+	t.Run("valid full consistentHash config", func(t *testing.T) {
+		err := v.ValidateCustomResourceYAML(`
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: tp-full-ch
+spec:
+  consistentHash:
+    headers:
+    - headerName: x-user
+      regexRewrite:
+        pattern: "^u-(.*)"
+        substitution: "\\1"
+      terminal: true
+    cookies:
+    - name: session
+      ttl: "3600"
+      path: /app
+      attributes:
+      - name: SameSite
+        value: Lax
+      - name: Secure
+        value: "true"
+      terminal: false
+    queryParameters:
+    - name: uid
+      terminal: true
+    filterState:
+    - key: envoy.network.application_protocol
+      terminal: false
+    sourceIp:
+      terminal: true
+`, nil)
+		require.NoError(t, err)
+	})
+}
