+func TestConsistentHashIREquals(t *testing.T) {
+	headerHP := func(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+		return &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+					HeaderName: name,
+				},
+			},
+			Terminal: terminal,
+		}
+	}
+
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        *consistentHashIR
+		expected bool
+	}{
+		{
+			name:     "both nil",
+			a:        nil,
+			b:        nil,
+			expected: true,
+		},
+		{
+			name:     "nil vs non-nil",
+			a:        nil,
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "non-nil vs nil",
+			a:        &consistentHashIR{},
+			b:        nil,
+			expected: false,
+		},
+		{
+			name:     "disabled vs enabled",
+			a:        &consistentHashIR{disabled: true},
+			b:        &consistentHashIR{disabled: false},
+			expected: false,
+		},
+		{
+			name: "equal hashPolicies",
+			a: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x-user", true)},
+			},
+			b: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x-user", true)},
+			},
+			expected: true,
+		},
+		{
+			name: "different hashPolicies",
+			a: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x-user", true)},
+			},
+			b: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHP("x-user", false)},
+			},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.a.Equals(tt.b))
+		})
+	}
+}
