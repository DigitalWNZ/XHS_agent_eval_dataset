+
+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	buildPolicyAtt := func(name string, ch *kgateway.ConsistentHash) ir.PolicyAtt {
+		outSpec := trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, &outSpec)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{
+				Group:     "gateway.kgateway.dev",
+				Kind:      "TrafficPolicy",
+				Namespace: "default",
+				Name:      name,
+			},
+			PolicyIr: &TrafficPolicy{
+				spec: outSpec,
+			},
+		}
+	}
+
+	t.Run("unions arrays with higher-priority first, deduplicates, re-sorts canonically, and retains unset sourceIp from high", func(t *testing.T) {
+		// High-priority policy has headers, queryParameters, and NO sourceIp
+		high := buildPolicyAtt("high-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Request-Id", Terminal: new(true)},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "q1", Terminal: new(true)},
+			},
+		})
+
+		// Low-priority policy has overlapping header (different case), new header, cookies, filterState, and sourceIp
+		low := buildPolicyAtt("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-request-id", Terminal: new(false)},
+				{HeaderName: "X-Org-Id", Terminal: new(false)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "sid", TTL: ptr.To("600")},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "q1", Terminal: new(false)},
+				{Name: "q2"},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs1"},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		mergedTP, ok := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.True(t, ok)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		hp := route.GetRoute().GetHashPolicy()
+
+		// Canonical order: headers (X-Request-Id, X-Org-Id), cookies (sid), queryParameters (q1, q2), filterState (fs1).
+		// No sourceIp because high-pol had sourceIp unset!
+		require.Len(t, hp, 6)
+
+		assert.Equal(t, "X-Request-ID-check", func() string {
+			if hp[0].GetHeader().GetHeaderName() == "X-Request-Id" && hp[0].GetTerminal() {
+				return "X-Request-ID-check"
+			}
+			return hp[0].GetHeader().GetHeaderName()
+		}())
+		assert.Equal(t, "X-Org-Id", hp[1].GetHeader().GetHeaderName())
+		assert.Equal(t, "sid", hp[2].GetCookie().GetName())
+		assert.Equal(t, "q1", hp[3].GetQueryParameter().GetName())
+		assert.True(t, hp[3].GetTerminal())
+		assert.Equal(t, "q2", hp[4].GetQueryParameter().GetName())
+		assert.Equal(t, "fs1", hp[5].GetFilterState().GetKey())
+
+		// Verify merge metadata records consistentHash
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-pol",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-pol",
+		}, origins)
+	})
+
+	t.Run("retains high sourceIp when set and places it at the end of canonical order", func(t *testing.T) {
+		high := buildPolicyAtt("high-pol", &kgateway.ConsistentHash{
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		})
+		low := buildPolicyAtt("low-pol", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user"},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(false),
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		hp := route.GetRoute().GetHashPolicy()
+		require.Len(t, hp, 2)
+		assert.Equal(t, "x-user", hp[0].GetHeader().GetHeaderName())
+		require.NotNil(t, hp[1].GetConnectionProperties())
+		assert.True(t, hp[1].GetConnectionProperties().GetSourceIp())
+		assert.True(t, hp[1].GetTerminal())
+	})
+
+	t.Run("disable=true on higher-priority policy suppresses broader-scoped policy", func(t *testing.T) {
+		high := buildPolicyAtt("narrow-disable", &kgateway.ConsistentHash{
+			Disable: new(true),
+		})
+		low := buildPolicyAtt("broad-hash", &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user"},
+			},
+		})
+
+		mergedAtt := policy.MergePolicies([]ir.PolicyAtt{high, low}, mergeTrafficPolicies, "")
+		mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, mergedTP.spec.consistentHash)
+		assert.True(t, mergedTP.spec.consistentHash.disabled)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}},
+		}
+		applyConsistentHash(mergedTP.spec.consistentHash, route)
+		assert.Empty(t, route.GetRoute().GetHashPolicy())
+
+		origins := mergedAtt.MergeOrigins.Get("consistentHash")
+		assert.Equal(t, []string{"gateway.kgateway.dev/TrafficPolicy/default/narrow-disable"}, origins)
+	})
+}
