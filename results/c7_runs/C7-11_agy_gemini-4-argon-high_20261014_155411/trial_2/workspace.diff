+            kind: TrafficPolicy
+            name: empty-consistent-hash-policy
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-consistent-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+  consistentHash:
+    headers:
+      - headerName: x-user-id
+      - headerName: x-shared
+    cookies:
+      - name: sid
+        ttl: "3600"
+        path: /
+        attributes:
+          - name: SameSite
+            value: Lax
+    sourceIp:
+      terminal: true
+---
