+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p2.spec.consistentHash == nil {
+		return
+	}
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = p2.spec.consistentHash.clone()
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	high, low := p1.spec.consistentHash, p2.spec.consistentHash
+	p2IsHigher := opts.Strategy == policy.OverridableShallowMerge || opts.Strategy == policy.OverridableDeepMerge
+	if p2IsHigher {
+		high, low = p2.spec.consistentHash, p1.spec.consistentHash
+	}
+
+	if high.disabled {
+		p1.spec.consistentHash = &consistentHashIR{disabled: true}
+		if p2IsHigher {
+			mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		}
+		return
+	}
+
+	if low.disabled {
+		if p2IsHigher {
+			p1.spec.consistentHash = high.clone()
+			mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		}
+		return
+	}
+
+	p1.spec.consistentHash = mergeConsistentHashIRs(high, low)
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
