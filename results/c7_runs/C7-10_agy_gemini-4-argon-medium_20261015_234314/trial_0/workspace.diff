+func TestStorageReadWriteCloserGzipAndEncryptRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	readers, writer, closer := storageReadWriteCloser(1, true, enc)
+	require.Len(t, readers, 1)
+
+	original := bytes.Repeat([]byte("CREATE TABLE users (id INT PRIMARY KEY);\n"), 2500)
+
+	go func() {
+		_, _ = writer.Write(original)
+		_ = closer.Close()
+	}()
+
+	raw, err := io.ReadAll(readers[0])
+	require.NoError(t, err)
+
+	dr, err := encryption.DecryptReader(bytes.NewReader(raw), key)
+	require.NoError(t, err)
+
+	gr, err := gzip.NewReader(dr)
+	require.NoError(t, err)
+
+	decompressed, err := io.ReadAll(gr)
+	require.NoError(t, err)
+	require.NoError(t, gr.Close())
+
+	assert.Equal(t, original, decompressed)
+}
