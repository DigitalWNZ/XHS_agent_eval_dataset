diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..52e98fa
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,202 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+	"gopkg.in/yaml.v3"
+)
+
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+
+	minSaltSize      = 16
+	pbkdf2Iterations = 100000
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(value *yaml.Node) error {
+	var raw map[string]any
+	if err := value.Decode(&raw); err != nil {
+		return err
+	}
+	for k, v := range raw {
+		switch strings.ToLower(strings.ReplaceAll(strings.ReplaceAll(k, "_", ""), "-", "")) {
+		case "enabled":
+			if b, ok := v.(bool); ok {
+				c.Enabled = b
+			}
+		case "keysource":
+			if s, ok := v.(string); ok {
+				c.KeySource = s
+			}
+		case "keyenvvar":
+			if s, ok := v.(string); ok {
+				c.KeyEnvVar = s
+			}
+		case "keyfile":
+			if s, ok := v.(string); ok {
+				c.KeyFile = s
+			}
+		case "key":
+			if s, ok := v.(string); ok {
+				c.Key = s
+			}
+		case "passphrase":
+			if s, ok := v.(string); ok {
+				c.Passphrase = s
+			}
+		case "salt":
+			if s, ok := v.(string); ok {
+				c.Salt = s
+			}
+		}
+	}
+	return nil
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	return c.validateFields()
+}
+
+func (c Config) validateFields() error {
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasPassphrase := strings.TrimSpace(c.Passphrase) != ""
+	hasSalt := strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case KeySourceEnv:
+		if hasFile || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key source 'env' fields are mutually exclusive with other key source fields")
+		}
+		if !hasEnv {
+			return errors.New("encryption key_env_var is required for 'env' key source")
+		}
+	case KeySourceFile:
+		if hasEnv || hasLiteral || hasPassphrase || hasSalt {
+			return errors.New("encryption key source 'file' fields are mutually exclusive with other key source fields")
+		}
+		if !hasFile {
+			return errors.New("encryption key_file is required for 'file' key source")
+		}
+	case KeySourceLiteral:
+		if hasEnv || hasFile || hasPassphrase || hasSalt {
+			return errors.New("encryption key source 'literal' fields are mutually exclusive with other key source fields")
+		}
+		if !hasLiteral {
+			return errors.New("encryption key is required for 'literal' key source")
+		}
+	case KeySourceDerive:
+		if hasEnv || hasFile || hasLiteral {
+			return errors.New("encryption key source 'derive' fields are mutually exclusive with other key source fields")
+		}
+		if !hasPassphrase {
+			return errors.New("encryption passphrase is required for 'derive' key source")
+		}
+		if !hasSalt {
+			return errors.New("encryption salt is required for 'derive' key source")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if err := cfg.validateFields(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case KeySourceEnv:
+		envVar := strings.TrimSpace(cfg.KeyEnvVar)
+		val, ok := os.LookupEnv(envVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envVar)
+		}
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(val))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from environment variable %q: %w", envVar, err)
+		}
+		if len(key) != keySize {
+			return nil, fmt.Errorf("%w: decoded encryption key from environment variable %q must be %d bytes, got %d", ErrInvalidKey, envVar, keySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceFile:
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		if trimmed == "" {
+			return nil, fmt.Errorf("%w: encryption key file %q is empty", ErrInvalidKey, filePath)
+		}
+		key, err := base64.StdEncoding.DecodeString(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %q: %w", filePath, err)
+		}
+		if len(key) != keySize {
+			return nil, fmt.Errorf("%w: decoded encryption key from file %q must be %d bytes, got %d", ErrInvalidKey, filePath, keySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceLiteral:
+		raw := strings.TrimSpace(cfg.Key)
+		key, err := base64.StdEncoding.DecodeString(raw)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode inline base64 encryption key: %w", err)
+		}
+		if len(key) != keySize {
+			return nil, fmt.Errorf("%w: decoded inline encryption key must be %d bytes, got %d", ErrInvalidKey, keySize, len(key))
+		}
+		return key, nil
+
+	case KeySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+		saltBytes, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(saltBytes) < minSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", minSaltSize, len(saltBytes))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, pbkdf2Iterations, keySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..c71a186
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,315 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	magicByte1     byte = 0x4F
+	magicByte2     byte = 0x44
+	currentVersion byte = 0x01
+
+	headerSize   = 3
+	lengthSize   = 4
+	nonceSize    = 12
+	gcmTagSize   = 16
+	hmacSize     = 32
+	keySize      = 32
+	maxChunkSize = 64 * 1024 // 64KB
+)
+
+var ErrInvalidKey = errors.New("invalid encryption key: key must be 32 bytes")
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	keyCopy := make([]byte, keySize)
+	copy(keyCopy, key)
+	return &Encryptor{key: keyCopy}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	var gcm cipher.AEAD
+	if err == nil {
+		gcm, err = cipher.NewGCM(block)
+	}
+	return &encryptWriter{
+		w:   w,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, e.key),
+		err: err,
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	headerWritten bool
+	closed        bool
+	err           error
+	lastNonce     [nonceSize]byte
+	hasLastNonce  bool
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := [headerSize]byte{magicByte1, magicByte2, currentVersion}
+	if _, err := ew.w.Write(header[:]); err != nil {
+		return fmt.Errorf("failed to write encryption header: %w", err)
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) nextNonce() ([nonceSize]byte, error) {
+	var nonce [nonceSize]byte
+	for {
+		if _, err := io.ReadFull(rand.Reader, nonce[:]); err != nil {
+			return nonce, fmt.Errorf("failed to generate nonce: %w", err)
+		}
+		if !ew.hasLastNonce || nonce != ew.lastNonce {
+			ew.lastNonce = nonce
+			ew.hasLastNonce = true
+			return nonce, nil
+		}
+	}
+}
+
+func (ew *encryptWriter) writeChunk(chunk []byte) error {
+	nonce, err := ew.nextNonce()
+	if err != nil {
+		return err
+	}
+
+	ciphertextWithTag := ew.gcm.Seal(nil, nonce[:], chunk, nil)
+	payloadLen := uint32(nonceSize + len(ciphertextWithTag))
+
+	var lenBuf [lengthSize]byte
+	binary.BigEndian.PutUint32(lenBuf[:], payloadLen)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return fmt.Errorf("failed to write chunk length: %w", err)
+	}
+	if _, err := ew.w.Write(nonce[:]); err != nil {
+		return fmt.Errorf("failed to write chunk nonce: %w", err)
+	}
+	if _, err := ew.w.Write(ciphertextWithTag); err != nil {
+		return fmt.Errorf("failed to write chunk ciphertext: %w", err)
+	}
+
+	ew.mac.Write(lenBuf[:])
+	ew.mac.Write(nonce[:])
+	ew.mac.Write(ciphertextWithTag)
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed encrypt writer")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+	if err := ew.ensureHeader(); err != nil {
+		ew.err = err
+		return 0, err
+	}
+
+	total := 0
+	for len(p) > 0 {
+		n := len(p)
+		if n > maxChunkSize {
+			n = maxChunkSize
+		}
+		if err := ew.writeChunk(p[:n]); err != nil {
+			ew.err = err
+			return total, err
+		}
+		total += n
+		p = p[n:]
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		ew.err = err
+		return err
+	}
+
+	var sentinel [lengthSize]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		ew.err = fmt.Errorf("failed to write sentinel: %w", err)
+		return ew.err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		ew.err = fmt.Errorf("failed to write HMAC: %w", err)
+		return ew.err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+	keyCopy := make([]byte, keySize)
+	copy(keyCopy, key)
+
+	block, err := aes.NewCipher(keyCopy)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create cipher: %w", err)
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	initialized bool
+	eof         bool
+	err         error
+	buf         []byte
+}
+
+func (dr *decryptReader) initHeader() error {
+	var header [headerSize]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("invalid header: truncated stream: %w", io.ErrUnexpectedEOF)
+		}
+		return fmt.Errorf("invalid header: %w", err)
+	}
+	if header[0] != magicByte1 || header[1] != magicByte2 {
+		return fmt.Errorf("invalid header: bad magic bytes 0x%02x 0x%02x", header[0], header[1])
+	}
+	if header[2] != currentVersion {
+		return fmt.Errorf("unsupported version: 0x%02x", header[2])
+	}
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [lengthSize]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream reading chunk length: %w", io.ErrUnexpectedEOF)
+		}
+		return fmt.Errorf("failed to read chunk length: %w", err)
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		var expectedMAC [hmacSize]byte
+		if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return fmt.Errorf("truncated encrypted stream reading HMAC: %w", io.ErrUnexpectedEOF)
+			}
+			return fmt.Errorf("failed to read HMAC: %w", err)
+		}
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC[:]) {
+			return errors.New("stream integrity check failed: HMAC mismatch")
+		}
+		dr.eof = true
+		return nil
+	}
+
+	const minChunkPayload = nonceSize + gcmTagSize
+	const maxChunkPayload = 16*1024*1024 + minChunkPayload
+	if chunkLen < minChunkPayload || chunkLen > maxChunkPayload {
+		return fmt.Errorf("corrupted chunk length %d: integrity check failed", chunkLen)
+	}
+
+	chunkData := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkData); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated encrypted stream reading chunk payload: %w", io.ErrUnexpectedEOF)
+		}
+		return fmt.Errorf("failed to read chunk payload: %w", err)
+	}
+
+	dr.mac.Write(lenBuf[:])
+	dr.mac.Write(chunkData)
+
+	nonce := chunkData[:nonceSize]
+	ciphertextWithTag := chunkData[nonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertextWithTag, nil)
+	if err != nil {
+		return fmt.Errorf("chunk decryption failed (wrong key or integrity check failed): %w", err)
+	}
+
+	dr.buf = plaintext
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.initialized {
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.buf) == 0 {
+		if dr.eof {
+			return 0, io.EOF
+		}
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	n := copy(p, dr.buf)
+	dr.buf = dr.buf[n:]
+	return n, nil
+}
