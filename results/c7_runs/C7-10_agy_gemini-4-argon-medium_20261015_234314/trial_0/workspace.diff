+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	assert.NoError(t, (Config{Enabled: false}).Validate())
+	assert.NoError(t, (Config{Enabled: false, KeySource: "invalid", Key: "abc", KeyFile: "def"}).Validate())
+
+	// Empty or unsupported source when enabled
+	assert.Error(t, (Config{Enabled: true}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "kms"}).Validate())
+
+	// Valid sources (case-insensitive)
+	assert.NoError(t, (Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "ONEDUMP_KEY"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "File", KeyFile: "/tmp/key"}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "Literal", Key: "dGVzdA=="}).Validate())
+	assert.NoError(t, (Config{Enabled: true, KeySource: "DERIVE", Passphrase: "secret", Salt: "c2FsdHNhbHRzYWx0c2FsdA=="}).Validate())
+
+	// Missing required field per source
+	assert.Error(t, (Config{Enabled: true, KeySource: "env"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "file"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "literal"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Passphrase: "secret"}).Validate())
+	assert.Error(t, (Config{Enabled: true, KeySource: "derive", Salt: "c2FsdA=="}).Validate())
+
+	// Mutually exclusive fields
+	err := (Config{Enabled: true, KeySource: "env", KeyEnvVar: "K", KeyFile: "/f"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "file", KeyFile: "/f", Key: "k"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "literal", Key: "k", Passphrase: "p"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+
+	err = (Config{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", KeyEnvVar: "E"}).Validate()
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive")
+}
