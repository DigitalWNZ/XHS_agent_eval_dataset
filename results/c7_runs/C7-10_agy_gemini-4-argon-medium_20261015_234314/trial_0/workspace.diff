@@ -0,0 +1,285 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func generateTestKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+	return key
+}
+
+func TestNewEncryptor(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+	require.NotNil(t, enc)
+
+	for _, invalidLen := range []int{0, 1, 16, 24, 31, 33, 64} {
+		badKey := make([]byte, invalidLen)
+		_, err := NewEncryptor(badKey)
+		require.Error(t, err)
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	testCases := []struct {
+		name      string
+		plaintext []byte
+	}{
+		{"empty", []byte{}},
+		{"small", []byte("hello world, onedump encryption!")},
+		{"exact_64kb", bytes.Repeat([]byte("A"), 64*1024)},
+		{"multi_chunk_200kb", bytes.Repeat([]byte("0123456789abcdef"), (200*1024)/16)},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			ew := enc.EncryptWriter(&buf)
+			if len(tc.plaintext) > 0 {
+				n, err := ew.Write(tc.plaintext)
+				require.NoError(t, err)
+				assert.Equal(t, len(tc.plaintext), n)
+			}
+			require.NoError(t, ew.Close())
+			// Idempotent close
+			require.NoError(t, ew.Close())
+
+			dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+			require.NoError(t, err)
+			decrypted, err := io.ReadAll(dr)
+			require.NoError(t, err)
+			assert.Equal(t, tc.plaintext, decrypted)
+		})
+	}
+}
+
+func TestStreamFormatAndUniqueNonces(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	plaintext := bytes.Repeat([]byte("chunk-data-"), 20000) // ~220KB -> 4 chunks
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, ew2.Close())
+
+	// Two encryptions of same plaintext must differ
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	// Inspect wire format of buf1
+	data := buf1.Bytes()
+	require.Greater(t, len(data), 3+4+32)
+	assert.Equal(t, []byte{0x4F, 0x44, 0x01}, data[:3])
+
+	pos := 3
+	seenNonces := make(map[[12]byte]bool)
+	chunkCount := 0
+	for {
+		require.LessOrEqual(t, pos+4, len(data))
+		chunkLen := binary.BigEndian.Uint32(data[pos : pos+4])
+		pos += 4
+		if chunkLen == 0 {
+			break
+		}
+		chunkCount++
+		assert.LessOrEqual(t, int(chunkLen), 64*1024+12+16)
+		var nonce [12]byte
+		copy(nonce[:], data[pos:pos+12])
+		assert.False(t, seenNonces[nonce], "duplicate nonce in chunk %d", chunkCount)
+		seenNonces[nonce] = true
+		pos += int(chunkLen)
+	}
+	assert.Equal(t, 4, chunkCount)
+	// 32-byte HMAC follows sentinel
+	assert.Equal(t, len(data), pos+32)
+}
+
+func TestDecryptReaderErrors(t *testing.T) {
+	key := generateTestKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Invalid key on DecryptReader creation
+	_, err = DecryptReader(bytes.NewReader(nil), []byte("short"))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// Lazy init: bad header does not error until Read
+	badMagicStream := []byte{0x00, 0x00, 0x01, 0, 0, 0, 0}
+	dr, err := DecryptReader(bytes.NewReader(badMagicStream), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+
+	// Unsupported version
+	badVersionStream := []byte{0x4F, 0x44, 0x02, 0, 0, 0, 0}
+	dr, err = DecryptReader(bytes.NewReader(badVersionStream), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+
+	// Valid encryption for tamper/truncation/wrong-key tests
+	var validBuf bytes.Buffer
+	ew := enc.EncryptWriter(&validBuf)
+	_, err = ew.Write([]byte("sensitive database dump content"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validBytes := validBuf.Bytes()
+
+	// Wrong key must fail
+	wrongKey := generateTestKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validBytes), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Tampered HMAC must fail with "integrity"
+	tamperedHMAC := make([]byte, len(validBytes))
+	copy(tamperedHMAC, validBytes)
+	tamperedHMAC[len(tamperedHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(tamperedHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+
+	// Truncated data must error at every cut point
+	for cut := range len(validBytes) {
+		dr, err := DecryptReader(bytes.NewReader(validBytes[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "expected error for truncated length %d", cut)
+		assert.NotErrorIs(t, err, io.EOF)
+	}
+}
