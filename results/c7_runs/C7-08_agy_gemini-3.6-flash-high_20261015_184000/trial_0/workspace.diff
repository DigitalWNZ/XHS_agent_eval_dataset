+def test_resolve_proxies_no_proxy_bypass():
+    class FakeRequest:
+        url = 'http://example.com'
+
+    proxies = {'http': 'http://user:pass@proxy:8080', 'no_proxy': 'example.com'}
+    resolved = resolve_proxies(FakeRequest(), proxies)
+    assert resolved == {}
+
+
+def test_rebuild_proxies_all_scheme():
+    from requests.sessions import Session
+    from requests.models import Request
+
+    proxies = {'all': 'http://user:pass@proxy:8080'}
+    req = Request('GET', 'https://example.org/').prepare()
+    session = Session()
+    new_proxies = session.rebuild_proxies(req, proxies)
+    assert new_proxies == {'all': 'http://user:pass@proxy:8080'}
+    assert req.headers.get('Proxy-Authorization') == 'Basic dXNlcjpwYXNz'
