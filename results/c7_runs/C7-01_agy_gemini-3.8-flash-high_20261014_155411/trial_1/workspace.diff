+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define BASE 1000000000ULL
+
+typedef struct {
+    uint32_t *digits;
+    size_t len;
+    size_t cap;
+} BigInt;
+
+static void bigint_init(BigInt *b, size_t cap) {
+    b->cap = (cap < 16) ? 16 : cap;
+    b->digits = (uint32_t *)calloc(b->cap, sizeof(uint32_t));
+    b->len = 1;
+}
+
+static void bigint_free(BigInt *b) {
+    free(b->digits);
+    b->digits = NULL;
+    b->len = 0;
+    b->cap = 0;
+}
+
+static void bigint_set_u64(BigInt *b, uint64_t val) {
+    b->len = 0;
+    if (val == 0) {
+        b->digits[0] = 0;
+        b->len = 1;
+        return;
+    }
+    while (val > 0) {
+        if (b->len >= b->cap) {
+            b->cap *= 2;
+            b->digits = (uint32_t *)realloc(b->digits, b->cap * sizeof(uint32_t));
+        }
+        b->digits[b->len++] = (uint32_t)(val % BASE);
+        val /= BASE;
+    }
+}
+
+static void bigint_add(BigInt *res, const BigInt *a, const BigInt *b) {
+    size_t max_len = (a->len > b->len) ? a->len : b->len;
+    if (res->cap <= max_len + 1) {
+        res->cap = (max_len + 1) * 2;
+        res->digits = (uint32_t *)realloc(res->digits, res->cap * sizeof(uint32_t));
+    }
+    uint64_t carry = 0;
+    size_t i = 0;
+    for (; i < max_len || carry; i++) {
+        uint64_t sum = carry;
+        if (i < a->len) sum += a->digits[i];
+        if (i < b->len) sum += b->digits[i];
+        res->digits[i] = (uint32_t)(sum % BASE);
+        carry = sum / BASE;
+    }
+    res->len = i;
+}
+
+static void bigint_print(const BigInt *b) {
+    if (b->len == 0) {
+        printf("0\n");
+        return;
+    }
+    printf("%u", b->digits[b->len - 1]);
+    for (size_t i = b->len - 1; i > 0; i--) {
+        printf("%09u", b->digits[i - 1]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) return 1;
+    long long n = atoll(argv[1]);
+    if (n < 0) return 1;
+    if (n == 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+
+    BigInt a, b, c;
+    bigint_init(&a, 16);
+    bigint_init(&b, 16);
+    bigint_init(&c, 16);
+    bigint_set_u64(&a, 0);
+    bigint_set_u64(&b, 1);
+
+    for (long long i = 2; i <= n; i++) {
+        bigint_add(&c, &a, &b);
+        BigInt tmp = a;
+        a = b;
+        b = c;
+        c = tmp;
+    }
+    bigint_print(&b);
+
+    bigint_free(&a);
+    bigint_free(&b);
+    bigint_free(&c);
+    return 0;
+}
