+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define BASE 1000000000ULL
+
+typedef struct {
+    uint32_t *d;
+    int len;
+    int cap;
+} BigInt;
+
+static void bi_init(BigInt *b, uint32_t val) {
+    b->cap = 16;
+    b->d = (uint32_t *)malloc(b->cap * sizeof(uint32_t));
+    b->d[0] = val;
+    b->len = 1;
+}
+
+static void bi_add(BigInt *res, const BigInt *a, const BigInt *b) {
+    int max_len = a->len > b->len ? a->len : b->len;
+    if (res->cap < max_len + 2) {
+        res->cap = (max_len + 2) * 2;
+        res->d = (uint32_t *)realloc(res->d, res->cap * sizeof(uint32_t));
+    }
+    uint64_t carry = 0;
+    int i = 0;
+    while (i < max_len || carry) {
+        uint64_t sum = carry;
+        if (i < a->len) sum += a->d[i];
+        if (i < b->len) sum += b->d[i];
+        res->d[i] = (uint32_t)(sum % BASE);
+        carry = sum / BASE;
+        i++;
+    }
+    res->len = i;
+}
+
+static void bi_print(const BigInt *b) {
+    printf("%u", b->d[b->len - 1]);
+    for (int i = b->len - 2; i >= 0; i--) {
+        printf("%09u", b->d[i]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    char *endptr = NULL;
+    long long n = strtoll(argv[1], &endptr, 10);
+    if (endptr == argv[1] || n < 0) return 1;
+
+    if (n == 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+
+    BigInt a, b, c;
+    bi_init(&a, 0);
+    bi_init(&b, 1);
+    bi_init(&c, 0);
+
+    for (long long i = 2; i <= n; i++) {
+        bi_add(&c, &a, &b);
+        BigInt tmp = a;
+        a = b;
+        b = c;
+        c = tmp;
+    }
+
+    bi_print(&b);
+    free(a.d);
+    free(b.d);
+    free(c.d);
+    return 0;
+}
