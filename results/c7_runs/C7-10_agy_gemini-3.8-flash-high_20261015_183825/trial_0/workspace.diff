+func TestMissingKeyEnvVarErrorWithAndWithoutStorages(t *testing.T) {
+	// With 0 storages:
+	jobNoStorage := config.NewJob("no-storage", "mysql", testDBDsn, config.WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "NON_EXISTENT_VAR_ABCXYZ",
+	}))
+	hNoStorage := NewJobHandler(jobNoStorage)
+	resNoStorage := hNoStorage.Do()
+	require.Error(t, resNoStorage.Error)
+	errMsgNoStorage := strings.ToLower(resNoStorage.Error.Error())
+	assert.True(t, strings.Contains(errMsgNoStorage, "encryption") || strings.Contains(errMsgNoStorage, "key"),
+		"error without storages must contain 'encryption' or 'key', got: %s", resNoStorage.Error.Error())
+
+	errSaveNoStorage := hNoStorage.Save()
+	require.Error(t, errSaveNoStorage)
+	errMsgSaveNoStorage := strings.ToLower(errSaveNoStorage.Error())
+	assert.True(t, strings.Contains(errMsgSaveNoStorage, "encryption") || strings.Contains(errMsgSaveNoStorage, "key"),
+		"Save() error without storages must contain 'encryption' or 'key', got: %s", errSaveNoStorage.Error())
+
+	// With storages configured:
+	jobWithStorage := config.NewJob("with-storage", "mysql", testDBDsn, config.WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "NON_EXISTENT_VAR_ABCXYZ",
+	}))
+	jobWithStorage.Storage.Local = append(jobWithStorage.Storage.Local, &local.Local{Path: "/tmp/some-dump.sql"})
+	hWithStorage := NewJobHandler(jobWithStorage)
+	resWithStorage := hWithStorage.Do()
+	require.Error(t, resWithStorage.Error)
+	errMsgWithStorage := strings.ToLower(resWithStorage.Error.Error())
+	assert.True(t, strings.Contains(errMsgWithStorage, "encryption") || strings.Contains(errMsgWithStorage, "key"),
+		"error with storages must contain 'encryption' or 'key', got: %s", resWithStorage.Error.Error())
+
+	errSaveWithStorage := hWithStorage.Save()
+	require.Error(t, errSaveWithStorage)
+	errMsgSaveWithStorage := strings.ToLower(errSaveWithStorage.Error())
+	assert.True(t, strings.Contains(errMsgSaveWithStorage, "encryption") || strings.Contains(errMsgSaveWithStorage, "key"),
+		"Save() error with storages must contain 'encryption' or 'key', got: %s", errSaveWithStorage.Error())
+}
