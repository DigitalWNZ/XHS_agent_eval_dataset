+			errorMsg:    "when disable is true, no other fields may be set",
+		},
+		{
+			name: "valid regex in header passes validation",
+			ir: &consistentHashIR{
+				headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "x-user-id",
+						RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+							Pattern:      "^user-(.*)",
