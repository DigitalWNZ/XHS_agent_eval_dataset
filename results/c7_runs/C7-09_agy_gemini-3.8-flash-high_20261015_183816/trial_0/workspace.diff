+		a        *consistentHashIR
+		b        *consistentHashIR
+		expected bool
+	}{
+		{
+			name:     "both nil are equal",
+			a:        nil,
+			b:        nil,
+			expected: true,
+		},
+		{
+			name:     "nil vs non-nil are not equal",
+			a:        nil,
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "non-nil vs nil are not equal",
+			a:        &consistentHashIR{},
+			b:        nil,
+			expected: false,
+		},
+		{
+			name: "same disable is equal",
+			a: &consistentHashIR{
+				disable: ptr.To(true),
+			},
+			b: &consistentHashIR{
+				disable: ptr.To(true),
+			},
+			expected: true,
+		},
+		{
+			name: "different disable is not equal",
+			a: &consistentHashIR{
+				disable: ptr.To(true),
+			},
+			b: &consistentHashIR{
+				disable: ptr.To(false),
+			},
+			expected: false,
+		},
+		{
+			name: "same hash policies are equal",
+			a: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						Terminal: true,
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-user-id",
+							},
+						},
+					},
+				},
+			},
+			b: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						Terminal: true,
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-user-id",
+							},
+						},
+					},
+				},
+			},
+			expected: true,
+		},
+		{
+			name: "different hash policies are not equal",
+			a: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						Terminal: true,
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-user-id",
+							},
+						},
