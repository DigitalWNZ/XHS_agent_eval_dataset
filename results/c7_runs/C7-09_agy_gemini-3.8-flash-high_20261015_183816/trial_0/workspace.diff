+			errorMsg:    "when disable is true, no other fields may be set",
+		},
+		{
+			name: "disable true with queryParameters fails validation",
+			ir: &consistentHashIR{
+				disable: ptr.To(true),
+				queryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "param"},
+				},
+			},
+			expectError: true,
+			errorMsg:    "when disable is true, no other fields may be set",
+		},
+		{
+			name: "disable true with filterState fails validation",
+			ir: &consistentHashIR{
+				disable: ptr.To(true),
+				filterState: []kgateway.ConsistentHashFilterState{
+					{Key: "fs_key"},
+				},
+			},
+			expectError: true,
