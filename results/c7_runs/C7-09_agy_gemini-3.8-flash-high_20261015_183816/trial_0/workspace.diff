+func TestMergeTrafficPolicies_ConsistentHash_UnionAndDeduplication(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	// p1 is higher priority (e.g. HTTPRoute rule level)
+	var spec1 trafficPolicySpecIr
+	err := constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-ID", Terminal: ptr.To(true)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session", TTL: ptr.To("1h")},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: ptr.To(false),
+			},
+		},
+	}, &spec1)
+	require.NoError(t, err)
+
+	// p2 is lower priority (e.g. route level or parent)
+	var spec2 trafficPolicySpecIr
+	err = constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user-id", Terminal: ptr.To(false)},  // duplicate, case-insensitive
+				{HeaderName: "X-Trace-ID", Terminal: ptr.To(false)}, // new
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session", TTL: ptr.To("2h")}, // duplicate
+				{Name: "tracker"},                    // new
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "q", Terminal: ptr.To(true)},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs_key", Terminal: ptr.To(false)},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: ptr.To(true), // should be ignored; higher priority sourceIp wins
+			},
+		},
+	}, &spec2)
+	require.NoError(t, err)
+
+	p1 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "policy-child"},
+		PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: spec1},
+	}
+	p2 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "policy-parent"},
+		PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: spec2},
+	}
+
+	mergedAtt := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+	mergedTP, ok := mergedAtt.PolicyIr.(*TrafficPolicy)
+	require.True(t, ok)
+	require.NotNil(t, mergedTP.spec.consistentHash)
+
+	hps := mergedTP.spec.consistentHash.hashPolicies
+	// Expected canonical order: headers (2), cookies (2), queryParameters (1), filterState (1), sourceIp (1) = 7
+	require.Len(t, hps, 7)
+
+	// 1. Headers: X-User-ID (first occurrence kept with casing and terminal=true), then X-Trace-ID
+	require.NotNil(t, hps[0].GetHeader())
+	assert.Equal(t, "X-User-ID", hps[0].GetHeader().GetHeaderName())
+	assert.True(t, hps[0].GetTerminal())
+
+	require.NotNil(t, hps[1].GetHeader())
+	assert.Equal(t, "X-Trace-ID", hps[1].GetHeader().GetHeaderName())
+	assert.False(t, hps[1].GetTerminal())
+
+	// 2. Cookies: session (higher-priority 1h kept), then tracker
+	require.NotNil(t, hps[2].GetCookie())
+	assert.Equal(t, "session", hps[2].GetCookie().GetName())
+	assert.Equal(t, 1*time.Hour, hps[2].GetCookie().GetTtl().AsDuration())
+
+	require.NotNil(t, hps[3].GetCookie())
+	assert.Equal(t, "tracker", hps[3].GetCookie().GetName())
+
+	// 3. QueryParameters: q
+	require.NotNil(t, hps[4].GetQueryParameter())
+	assert.Equal(t, "q", hps[4].GetQueryParameter().GetName())
+	assert.True(t, hps[4].GetTerminal())
+
+	// 4. FilterState: fs_key
+	require.NotNil(t, hps[5].GetFilterState())
+	assert.Equal(t, "fs_key", hps[5].GetFilterState().GetKey())
+	assert.False(t, hps[5].GetTerminal())
+
+	// 5. SourceIP: retains higher-priority value (terminal=false)
+	require.NotNil(t, hps[6].GetConnectionProperties())
+	assert.True(t, hps[6].GetConnectionProperties().GetSourceIp())
+	assert.False(t, hps[6].GetTerminal())
+
+	// Merge metadata check (Requirement 8)
+	origins := mergedAtt.MergeOrigins.Get("consistentHash")
+	require.Len(t, origins, 2)
+	assert.Contains(t, origins, p1.PolicyRef.ID())
+	assert.Contains(t, origins, p2.PolicyRef.ID())
+}
