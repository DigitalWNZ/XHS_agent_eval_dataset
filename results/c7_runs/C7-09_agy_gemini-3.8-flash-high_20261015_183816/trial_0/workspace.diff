+func TestApplyConsistentHash(t *testing.T) {
+	t.Run("nil IR does nothing", func(t *testing.T) {
+		route := &envoyroutev3.Route{Action: &envoyroutev3.Route_Route{Route: &envoyroutev3.RouteAction{}}}
+		applyConsistentHash(nil, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+	})
+
+	t.Run("nil route does nothing", func(t *testing.T) {
+		ir := &consistentHashIR{
+			hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{{Terminal: true}},
+		}
+		applyConsistentHash(ir, nil)
+	})
+
+	t.Run("disable=true clears hash policy on RouteAction", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{
+					HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{
+						{Terminal: true},
+					},
+				},
+			},
+		}
+		ir := &consistentHashIR{
+			disable: ptr.To(true),
+		}
+		applyConsistentHash(ir, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+	})
+
+	t.Run("sets hash policy on RouteAction", func(t *testing.T) {
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		expected := []*envoyroutev3.RouteAction_HashPolicy{
+			{
+				Terminal: false,
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+					ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+						SourceIp: true,
+					},
+				},
+			},
+		}
+		ir := &consistentHashIR{
+			hashPolicies: expected,
+		}
+		applyConsistentHash(ir, route)
+		assert.Equal(t, expected, route.GetRoute().GetHashPolicy())
+	})
+}
