+				},
+			},
+			expectError: true,
+			errorMsg:    "invalid ttl in cookie",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.ir.Validate()
+			if tt.expectError {
+				require.Error(t, err)
