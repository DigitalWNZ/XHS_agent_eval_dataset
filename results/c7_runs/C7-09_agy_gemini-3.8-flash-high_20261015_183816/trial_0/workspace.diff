+	p1 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "p1-disable"},
+		PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: spec1},
+	}
+	p2 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "p2-active"},
+		PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: spec2},
+	}
+
+	mergedAtt := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+	mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+
+	// Consistent hashing is disabled; any inherited policies suppressed
+	require.NotNil(t, mergedTP.spec.consistentHash)
+	assert.True(t, *mergedTP.spec.consistentHash.disable)
+	assert.Empty(t, mergedTP.spec.consistentHash.hashPolicies)
+
+	// Since p2 was suppressed, only p1 is in merge origins
+	origins := mergedAtt.MergeOrigins.Get("consistentHash")
+	assert.Contains(t, origins, p1.PolicyRef.ID())
+	assert.NotContains(t, origins, p2.PolicyRef.ID())
+}
+
+func TestMergeTrafficPolicies_ConsistentHash_LowerDisableIgnoredByHigher(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	// p1 has headers
+	var spec1 trafficPolicySpecIr
+	err := constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Header"},
+			},
+		},
+	}, &spec1)
+	require.NoError(t, err)
+
+	// p2 has disable: true
+	var spec2 trafficPolicySpecIr
+	err = constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Disable: ptr.To(true),
+		},
+	}, &spec2)
+	require.NoError(t, err)
+
+	p1 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "p1-active"},
+		PolicyIr:  &TrafficPolicy{ct: time.Now(), spec: spec1},
+	}
+	p2 := ir.PolicyAtt{
+		GroupKind: gk,
+		PolicyRef: &ir.AttachedPolicyRef{Name: "p2-disable"},
+		PolicyIr:  &TrafficPolicy{ct: time.Now().Add(time.Minute), spec: spec2},
+	}
+
+	mergedAtt := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+	mergedTP := mergedAtt.PolicyIr.(*TrafficPolicy)
+
+	// Higher priority wins; p2's disable is ignored
+	require.NotNil(t, mergedTP.spec.consistentHash)
+	assert.Nil(t, mergedTP.spec.consistentHash.disable)
+	require.Len(t, mergedTP.spec.consistentHash.hashPolicies, 1)
+	assert.Equal(t, "X-Header", mergedTP.spec.consistentHash.hashPolicies[0].GetHeader().GetHeaderName())
+}
