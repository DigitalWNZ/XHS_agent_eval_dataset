new file mode 100644
index 00000000..e3d219fd
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,448 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { SQL, sql, type SQLWrapper } from '../sql.ts';
+
+type ValueOf<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+/**
+ * Validates a window name used in a `WINDOW` clause or an `OVER <name>` reference.
+ */
+export function validateWindowName(name: string): string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not consist only of whitespace');
+	}
+	return name;
+}
+
+function assertNonNegativeInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${fnName}() expects a non-negative integer, received ${String(value)}`);
+	}
+}
+
+function assertPositiveInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() expects a positive integer, received ${String(value)}`);
+	}
+}
+
+/** Renders a number as an inline SQL literal so it never becomes a bound parameter. */
+function rawNumber(value: number): SQL {
+	return sql.raw(String(value));
+}
+
+function positionalValue(value: unknown): unknown {
+	if (typeof value === 'number' && Number.isFinite(value)) {
+		return rawNumber(value);
+	}
+	return value;
+}
+
+// ---------------------------------------------------------------------------
+// Frame boundaries
+// ---------------------------------------------------------------------------
+
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly kind: 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing',
+		readonly offset?: number | SQLWrapper,
+	) {}
+
+	/** @internal */
+	get rank(): number {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return 0;
+			}
+			case 'preceding': {
+				return 1;
+			}
+			case 'currentRow': {
+				return 2;
+			}
+			case 'following': {
+				return 3;
+			}
+			case 'unboundedFollowing': {
+				return 4;
+			}
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return sql.raw('unbounded preceding');
+			}
+			case 'currentRow': {
+				return sql.raw('current row');
+			}
+			case 'unboundedFollowing': {
+				return sql.raw('unbounded following');
+			}
+			case 'preceding':
+			case 'following': {
+				const offset = typeof this.offset === 'number' ? rawNumber(this.offset) : this.offset;
+				return sql`${offset} ${sql.raw(this.kind)}`;
+			}
+		}
+	}
+}
+
+/** `UNBOUNDED PRECEDING` frame boundary. */
+export const unboundedPreceding = new WindowFrameBoundary('unboundedPreceding');
+/** `CURRENT ROW` frame boundary. */
+export const currentRow = new WindowFrameBoundary('currentRow');
+/** `UNBOUNDED FOLLOWING` frame boundary. */
+export const unboundedFollowing = new WindowFrameBoundary('unboundedFollowing');
+
+/**
+ * `<offset> PRECEDING` frame boundary.
+ *
+ * @param offset a non-negative integer, or an SQL expression (e.g. an interval for `range` frames)
+ */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	if (typeof offset === 'number' || typeof offset !== 'object' || offset === null) {
+		assertNonNegativeInteger('preceding', offset as number);
+	}
+	return new WindowFrameBoundary('preceding', offset);
+}
+
+/**
+ * `<offset> FOLLOWING` frame boundary.
+ *
+ * @param offset a non-negative integer, or an SQL expression (e.g. an interval for `range` frames)
+ */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	if (typeof offset === 'number' || typeof offset !== 'object' || offset === null) {
+		assertNonNegativeInteger('following', offset as number);
+	}
+	return new WindowFrameBoundary('following', offset);
+}
+
+// ---------------------------------------------------------------------------
+// Frames
+// ---------------------------------------------------------------------------
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: 'rows' | 'range',
+		readonly from: WindowFrameBoundary,
+		readonly to?: WindowFrameBoundary,
+	) {}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		if (this.to === undefined) {
+			return sql`${sql.raw(this.mode)} ${this.from}`;
+		}
+		return sql`${sql.raw(this.mode)} between ${this.from} and ${this.to}`;
+	}
+}
+
+function buildFrame(mode: 'rows' | 'range', spec: WindowFrameSpec): WindowFrame {
+	const { from, to } = spec ?? {} as WindowFrameSpec;
+	if (!is(from, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects a "from" frame boundary`);
+	}
+	if (to !== undefined && !is(to, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects "to" to be a frame boundary`);
+	}
+	if (from.kind === 'unboundedFollowing') {
+		throw new Error(`${mode}(): "from" boundary cannot be unboundedFollowing`);
+	}
+	if (to !== undefined) {
+		if (to.kind === 'unboundedPreceding') {
+			throw new Error(`${mode}(): "to" boundary cannot be unboundedPreceding`);
+		}
+		let outOfOrder = from.rank > to.rank;
+		if (
+			!outOfOrder && from.kind === to.kind && typeof from.offset === 'number' && typeof to.offset === 'number'
+		) {
+			outOfOrder = from.kind === 'preceding' ? from.offset < to.offset : from.offset > to.offset;
+		}
+		if (outOfOrder) {
+			throw new Error(`${mode}(): "from" boundary must not come after the "to" boundary`);
+		}
+	}
+	return new WindowFrame(mode, from, to);
+}
+
+/**
+ * Builds a `ROWS` frame clause.
+ *
+ * @example
+ * ```ts
+ * rows({ from: unboundedPreceding, to: currentRow })
+ * // rows between unbounded preceding and current row
+ * ```
+ */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/**
+ * Builds a `RANGE` frame clause.
+ *
+ * @example
+ * ```ts
+ * range({ from: preceding(1), to: following(1) })
+ * // range between 1 preceding and 1 following
+ * ```
+ */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+// ---------------------------------------------------------------------------
+// Window specification
+// ---------------------------------------------------------------------------
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+function toArray<T>(value: T | T[] | undefined): T[] {
+	if (value === undefined) return [];
+	return Array.isArray(value) ? value : [value];
+}
+
+/** Builds the inside of a window specification (without surrounding parentheses). */
+export function buildWindowSpec(spec: WindowSpec = {}): SQL {
+	const parts: SQL[] = [];
+	const partitionBy = toArray(spec.partitionBy);
+	if (partitionBy.length > 0) {
+		parts.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+	const orderBy = toArray(spec.orderBy);
+	if (orderBy.length > 0) {
+		parts.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+	if (spec.frame) {
+		parts.push(sql`${spec.frame}`);
+	}
+	return sql.join(parts, sql` `);
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+/** Builds a ` window "a" as (...), "b" as (...)` clause, or `undefined` if there are no definitions. */
+export function buildWindowClause(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+// ---------------------------------------------------------------------------
+// Window function builder
+// ---------------------------------------------------------------------------
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: {
+		readonly type: T;
+	};
+
+	constructor(
+		/** @internal */
+		readonly fn: SQL,
+		/** @internal */
+		readonly decoder?: SQL['decoder'] | AnyColumn,
+	) {}
+
+	/**
+	 * Applies the window function over an inline window specification or a named window.
+	 *
+	 * @example
+	 * ```ts
+	 * rowNumber().over({ partitionBy: users.city, orderBy: desc(users.age) })
+	 * rowNumber().over('w')
+	 * ```
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		const result = typeof spec === 'string'
+			? sql`${this.fn} over ${sql.identifier(validateWindowName(spec))}`
+			: sql`${this.fn} over (${buildWindowSpec(spec)})`;
+		if (this.decoder !== undefined) {
+			result.mapWith(this.decoder as any);
+		}
+		return result as SQL<T>;
+	}
+}
+
+function decoderOf(expression: SQLWrapper): SQL['decoder'] | AnyColumn | undefined {
+	if (is(expression, Column)) return expression;
+	if (is(expression, SQL)) return expression.decoder;
+	if (is(expression, SQL.Aliased)) return expression.sql.decoder;
+	return undefined;
+}
+
+// Ranking functions
+
+/** `row_number()` — the number of the current row within its partition, counting from 1. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, { mapFromDriverValue: Number });
+}
+
+/** `rank()` — rank of the current row with gaps. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, { mapFromDriverValue: Number });
+}
+
+/** `dense_rank()` — rank of the current row without gaps. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, { mapFromDriverValue: Number });
+}
+
+/** `ntile(n)` — divides the partition into `n` buckets and returns the bucket number. */
+export function ntile(buckets: number): WindowFunction<number> {
+	assertPositiveInteger('ntile', buckets);
+	return new WindowFunction(sql`ntile(${rawNumber(buckets)})`, { mapFromDriverValue: Number });
+}
+
+/** `percent_rank()` — relative rank of the current row: (rank - 1) / (total rows - 1). */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, { mapFromDriverValue: Number });
+}
+
+/** `cume_dist()` — cumulative distribution of the current row. */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, { mapFromDriverValue: Number });
+}
+
+// Offset / value functions
+
+function offsetFunction(
+	name: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultValue: unknown,
+): WindowFunction<any> {
+	if (offset !== undefined) {
+		assertNonNegativeInteger(name, offset);
+	}
+	const args: unknown[] = [expression];
+	if (offset !== undefined || defaultValue !== undefined) {
+		args.push(rawNumber(offset ?? 1));
+	}
+	if (defaultValue !== undefined) {
+		args.push(positionalValue(defaultValue));
+	}
+	return new WindowFunction(
+		sql`${sql.raw(name)}(${sql.join(args.map((a) => sql`${a}`), sql`, `)})`,
+		decoderOf(expression),
+	);
+}
+
+/**
+ * `lag(expression[, offset[, default]])` — value of `expression` at the row `offset` rows before the current row.
+ * The result is nullable unless a default value is provided.
+ */
+export function lag<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<ValueOf<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: ValueOf<T> | SQLWrapper,
+): WindowFunction<NonNullable<ValueOf<T>>>;
+export function lag(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lag', expression, offset, defaultValue);
+}
+
+/**
+ * `lead(expression[, offset[, default]])` — value of `expression` at the row `offset` rows after the current row.
+ * The result is nullable unless a default value is provided.
+ */
+export function lead<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<ValueOf<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: ValueOf<T> | SQLWrapper,
+): WindowFunction<NonNullable<ValueOf<T>>>;
+export function lead(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lead', expression, offset, defaultValue);
+}
+
+/** `first_value(expression)` — value of `expression` at the first row of the window frame. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<ValueOf<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, decoderOf(expression));
+}
+
+/** `last_value(expression)` — value of `expression` at the last row of the window frame. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<ValueOf<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, decoderOf(expression));
+}
+
+/** `nth_value(expression, n)` — value of `expression` at the `n`-th row of the window frame (counting from 1). */
+export function nthValue<T extends SQLWrapper>(expression: T, n: number): WindowFunction<ValueOf<T> | null> {
+	assertPositiveInteger('nthValue', n);
+	return new WindowFunction(sql`nth_value(${expression}, ${rawNumber(n)})`, decoderOf(expression));
+}
+
+// Aggregate window functions
+
+/** `sum(expression)` used as a window function. */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, { mapFromDriverValue: String });
+}
+
+/** `avg(expression)` used as a window function. */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, { mapFromDriverValue: String });
+}
+
+/** `min(expression)` used as a window function. */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	);
+}
+
+/** `max(expression)` used as a window function. */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : { mapFromDriverValue: String },
+	);
+}
+
+/** `count(expression)` (or `count(*)` without an argument) used as a window function. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, { mapFromDriverValue: Number });
+}
