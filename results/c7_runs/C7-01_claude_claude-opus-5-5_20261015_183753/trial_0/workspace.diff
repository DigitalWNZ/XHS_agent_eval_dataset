diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..66dc8bda
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,125 @@
+import { describe, expect, expectTypeOf, test } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int, mysqlTable } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { PgDialect } from '~/pg-core/dialect.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { int as ssInt, singlestoreTable } from '~/singlestore-core/index.ts';
+import { drizzle as ssDrizzle } from '~/singlestore/index.ts';
+import type { SQL } from '~/sql/sql.ts';
+import { integer as sqliteInt, sqliteTable } from '~/sqlite-core/index.ts';
+
+const users = pgTable('users', { id: integer('id').notNull(), city: text('city'), age: integer('age') });
+const db = pgDrizzle.mock();
+const dialect = new PgDialect();
+
+describe('window functions', () => {
+	test('names', () => {
+		const cases: [any, string][] = [
+			[rowNumber(), 'row_number()'],
+			[rank(), 'rank()'],
+			[denseRank(), 'dense_rank()'],
+			[ntile(4), 'ntile(4)'],
+			[percentRank(), 'percent_rank()'],
+			[cumeDist(), 'cume_dist()'],
+			[lag(users.age), 'lag("users"."age")'],
+			[lag(users.age, 0), 'lag("users"."age", 0)'],
+			[lead(users.age, 2, 0), 'lead("users"."age", 2, 0)'],
+			[firstValue(users.age), 'first_value("users"."age")'],
+			[lastValue(users.age), 'last_value("users"."age")'],
+			[nthValue(users.age, 2), 'nth_value("users"."age", 2)'],
+			[windowSum(users.age), 'sum("users"."age")'],
+			[windowAvg(users.age), 'avg("users"."age")'],
+			[windowMin(users.age), 'min("users"."age")'],
+			[windowMax(users.age), 'max("users"."age")'],
+			[windowCount(), 'count(*)'],
+		];
+		for (const [fn, expected] of cases) {
+			const q = dialect.sqlToQuery(fn.over());
+			expect(q.sql).toBe(`${expected} over ()`);
+			expect(q.params).toEqual([]);
+		}
+	});
+
+	test('spec + frame', () => {
+		const q = dialect.sqlToQuery(
+			windowSum(users.age).over({
+				partitionBy: users.city,
+				orderBy: [desc(users.age), users.id],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+		);
+		expect(q.sql).toBe(
+			'sum("users"."age") over (partition by "users"."city" order by "users"."age" desc, "users"."id" rows between unbounded preceding and current row)',
+		);
+		expect(dialect.sqlToQuery(range({ from: preceding(0), to: following(3) }).getSQL()).sql).toBe(
+			'range between 0 preceding and 3 following',
+		);
+		expect(rows({ from: currentRow, to: unboundedFollowing })).toBeTruthy();
+	});
+
+	test('errors', () => {
+		expect(() => ntile(0)).toThrow(/ntile.*0/);
+		expect(() => nthValue(users.age, 1.5)).toThrow(/nthValue.*1\.5/);
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => following(1.5)).toThrow(/following/);
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrow(/from/);
+		expect(() => range({ from: preceding(1), to: preceding(3) })).toThrow(/from/);
+		expect(() => db.select().from(users).window('', {})).toThrow(/non-empty/);
+		expect(() => db.select().from(users).window('  ', {})).toThrow(/whitespace/);
+	});
+
+	test('named windows', () => {
+		const q = db.select({ id: users.id, rn: rowNumber().over('w') }).from(users).where(undefined)
+			.window('w', { partitionBy: users.city }).orderBy(users.id).toSQL();
+		expect(q.sql).toBe(
+			'select "id", row_number() over "w" from "users" window "w" as (partition by "users"."city") order by "users"."id"',
+		);
+		const m = mysqlTable('t', { a: int('a') });
+		expect(
+			mysqlDrizzle.mock().select({ r: rank().over('w') }).from(m).window('w', { orderBy: m.a }).toSQL().sql,
+		).toBe('select rank() over `w` from `t` window `w` as (order by `t`.`a`)');
+		const s = sqliteTable('t', { a: sqliteInt('a') });
+		expect(sqliteDrizzle(':memory:').select().from(s).window('w', {}).toSQL().sql).toBe(
+			'select "a" from "t" window "w" as ()',
+		);
+		const ss = singlestoreTable('t', { a: ssInt('a') });
+		expect(ssDrizzle.mock().select().from(ss).window('w', {}).toSQL().sql).toBe(
+			'select `a` from `t` window `w` as ()',
+		);
+	});
+
+	test('types', () => {
+		expectTypeOf(lag(users.age).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(lag(users.age, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(firstValue(users.id).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(rowNumber().over()).toEqualTypeOf<SQL<number>>();
+	});
+});
