+def make_msgid(idstring=None, domain=None):
+    """Returns a string suitable for a RFC 2822 compliant Message-ID, e.g:
+
+    <1450180262.10521.1.camel@Example.com>
+
+    Optional idstring if given is a string used to strengthen the
+    uniqueness of the message id.  Optional domain if given provides the
+    portion of the message id after the '@'.  It defaults to the local
+    hostname.
+    """
+    if domain is None:
+        domain = DNS_NAME
+    domain = str(domain).encode('idna').decode('ascii')
+    return _make_msgid(idstring, domain)
+
