+// Helper to compare two shapes for equality.
+func compareShapes(t *testing.T, id int32, s1, s2 Shape) {
+	t.Helper()
+	if s1 == nil || s2 == nil {
+		if s1 != s2 {
+			t.Errorf("shape %d: nil mismatch: %v vs %v", id, s1, s2)
+		}
+		return
+	}
+	if reflect.TypeOf(s1) != reflect.TypeOf(s2) {
+		t.Errorf("shape %d: type mismatch: got %T, want %T", id, s2, s1)
+		return
+	}
+	if s1.typeTag() != s2.typeTag() {
+		t.Errorf("shape %d: typeTag mismatch: got %v, want %v", id, s2.typeTag(), s1.typeTag())
+	}
+	if s1.NumEdges() != s2.NumEdges() {
+		t.Errorf("shape %d: NumEdges mismatch: got %d, want %d", id, s2.NumEdges(), s1.NumEdges())
+	}
+	if s1.NumChains() != s2.NumChains() {
+		t.Errorf("shape %d: NumChains mismatch: got %d, want %d", id, s2.NumChains(), s1.NumChains())
+	}
+	if s1.Dimension() != s2.Dimension() {
+		t.Errorf("shape %d: Dimension mismatch: got %d, want %d", id, s2.Dimension(), s1.Dimension())
+	}
+	if s1.IsEmpty() != s2.IsEmpty() {
+		t.Errorf("shape %d: IsEmpty mismatch: got %v, want %v", id, s2.IsEmpty(), s1.IsEmpty())
+	}
+	if s1.IsFull() != s2.IsFull() {
+		t.Errorf("shape %d: IsFull mismatch: got %v, want %v", id, s2.IsFull(), s1.IsFull())
+	}
+
+	for i := 0; i < s1.NumEdges(); i++ {
+		e1 := s1.Edge(i)
+		e2 := s2.Edge(i)
+		if e1.V0 != e2.V0 || e1.V1 != e2.V1 {
+			t.Errorf("shape %d: Edge(%d) mismatch: got %v, want %v", id, i, e2, e1)
+		}
+	}
+
+	for i := 0; i < s1.NumChains(); i++ {
+		c1 := s1.Chain(i)
+		c2 := s2.Chain(i)
+		if c1 != c2 {
+			t.Errorf("shape %d: Chain(%d) mismatch: got %v, want %v", id, i, c2, c1)
+		}
+	}
+}
+
+// Helper to compare spatial cells of two ShapeIndexes.
+func compareSpatialCells(t *testing.T, orig, dec *ShapeIndex) {
+	t.Helper()
+	if len(orig.cells) != len(dec.cells) {
+		t.Fatalf("cells length mismatch: got %d, want %d", len(dec.cells), len(orig.cells))
+	}
+	for i, cellID := range orig.cells {
+		if dec.cells[i] != cellID {
+			t.Fatalf("cellID[%d] mismatch: got %v, want %v", i, dec.cells[i], cellID)
+		}
+		origCell := orig.cellMap[cellID]
+		decCell := dec.cellMap[cellID]
+		if len(origCell.shapes) != len(decCell.shapes) {
+			t.Fatalf("cell %v clipped shapes count mismatch: got %d, want %d", cellID, len(decCell.shapes), len(origCell.shapes))
+		}
+		for j, csOrig := range origCell.shapes {
+			csDec := decCell.shapes[j]
+			if csDec.shapeID != csOrig.shapeID {
+				t.Errorf("cell %v shape[%d] ID mismatch: got %d, want %d", cellID, j, csDec.shapeID, csOrig.shapeID)
+			}
+			if csDec.containsCenter != csOrig.containsCenter {
+				t.Errorf("cell %v shape[%d] containsCenter mismatch: got %v, want %v", cellID, j, csDec.containsCenter, csOrig.containsCenter)
+			}
+			if !reflect.DeepEqual(csDec.edges, csOrig.edges) {
+				t.Errorf("cell %v shape[%d] edges mismatch: got %v, want %v", cellID, j, csDec.edges, csOrig.edges)
+			}
+		}
+	}
+}
