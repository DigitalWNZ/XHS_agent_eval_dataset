+func TestShapeIndexShapeIDsSurvive(t *testing.T) {
+	idx := NewShapeIndex()
+	s0 := makePolyline("0:0, 1:1")
+	s1 := makePolyline("1:1, 2:2")
+	s2 := makePolyline("2:2, 3:3")
+
+	id0 := idx.Add(s0)
+	id1 := idx.Add(s1)
+	id2 := idx.Add(s2)
+
+	if id0 != 0 || id1 != 1 || id2 != 2 {
+		t.Fatalf("unexpected initial IDs: %d, %d, %d", id0, id1, id2)
+	}
+
+	// Remove shape 1
+	idx.Remove(s1)
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if dec.Shape(1) != nil {
+		t.Errorf("shape 1 should be nil after removal and decoding")
+	}
+	if dec.Shape(0) == nil || dec.Shape(2) == nil {
+		t.Fatalf("shape 0 or 2 is nil in decoded index")
+	}
+	compareShapes(t, 0, idx.Shape(0), dec.Shape(0))
+	compareShapes(t, 2, idx.Shape(2), dec.Shape(2))
+
+	// Verify cell references point to 0 and 2
+	for it := dec.Iterator(); !it.Done(); it.Next() {
+		cell := it.IndexCell()
+		for _, cs := range cell.shapes {
+			if cs.shapeID != 0 && cs.shapeID != 2 {
+				t.Errorf("unexpected cell reference to shapeID %d", cs.shapeID)
+			}
+		}
+	}
+
+	// Adding a new shape should get ID 3 (nextID was preserved)
+	s3 := makePolyline("4:4, 5:5")
+	id3 := dec.Add(s3)
+	if id3 != 3 {
+		t.Errorf("new shape got ID %d, want 3", id3)
+	}
+}
