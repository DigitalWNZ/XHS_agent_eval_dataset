+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("cannot decode LaxPolygon version %d; my version: %d", version, encodingVersion)
+		return
+	}
+	numLoops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+
+	loopSizes := make([]int, 0, min(int(numLoops), 1024))
+	var totalVerts int
+	for range numLoops {
+		sz := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if sz > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices in loop (%d; max is %d)", sz, maxEncodedVertices)
+			return
+		}
+		totalVerts += int(sz)
+		if totalVerts > maxEncodedVertices {
+			d.err = fmt.Errorf("too many total vertices (%d; max is %d)", totalVerts, maxEncodedVertices)
+			return
+		}
+		loopSizes = append(loopSizes, int(sz))
+	}
+
+	loops := make([][]Point, numLoops)
+	for i, sz := range loopSizes {
+		loop := make([]Point, 0, min(sz, 1024))
+		for range sz {
+			pt := d.readPoint()
+			if d.err != nil {
+				return
+			}
+			loop = append(loop, pt)
+		}
+		loops[i] = loop
+	}
+
+	lp := LaxPolygonFromPoints(loops)
+	*p = *lp
+}
