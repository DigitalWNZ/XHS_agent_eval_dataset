+func TestShapeIndexQueriesWorkWithoutBuild(t *testing.T) {
+	idx := NewShapeIndex()
+	poly := makePolygon("0:0, 0:4, 4:4, 4:0", true)
+	pline := makePolyline("1:1, 3:3")
+	idx.Add(poly)
+	idx.Add(pline)
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	// 1. LocatePoint
+	ptInside := PointFromLatLng(LatLngFromDegrees(2, 2))
+	it := dec.Iterator()
+	if !it.LocatePoint(ptInside) {
+		t.Errorf("LocatePoint(ptInside) returned false")
+	}
+
+	// 2. LocateCellID
+	cellTarget := cellIDFromPoint(ptInside)
+	rel := it.LocateCellID(cellTarget)
+	if rel == Disjoint {
+		t.Errorf("LocateCellID returned Disjoint, expected Indexed or Subdivided")
+	}
+
+	// 3. ContainsPointQuery
+	cpq := NewContainsPointQuery(dec, VertexModelSemiOpen)
+	if !cpq.Contains(ptInside) {
+		t.Errorf("ContainsPointQuery returned false for interior point")
+	}
+	ptOutside := PointFromLatLng(LatLngFromDegrees(10, 10))
+	if cpq.Contains(ptOutside) {
+		t.Errorf("ContainsPointQuery returned true for exterior point")
+	}
+
+	// 4. CrossingEdgeQuery
+	ceq := NewCrossingEdgeQuery(dec)
+	crossEdgeP0 := PointFromLatLng(LatLngFromDegrees(2, -1))
+	crossEdgeP1 := PointFromLatLng(LatLngFromDegrees(2, 1))
+	edges := ceq.Crossings(crossEdgeP0, crossEdgeP1, dec.Shape(0), CrossingTypeAll)
+	if len(edges) == 0 {
+		t.Errorf("CrossingEdgeQuery found 0 crossings, expected at least 1")
+	}
+
+	// 5. ShapeIndexRegion
+	region := dec.Region()
+	capBound := region.CapBound()
+	if capBound.IsEmpty() {
+		t.Errorf("ShapeIndexRegion.CapBound() is empty")
+	}
+	if !capBound.ContainsPoint(ptInside) {
+		t.Errorf("CapBound does not contain ptInside")
+	}
+}
