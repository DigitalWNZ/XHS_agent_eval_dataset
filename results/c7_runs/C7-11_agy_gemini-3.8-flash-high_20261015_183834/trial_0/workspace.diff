+func TestShapeIndexMixedChainCounts(t *testing.T) {
+	idx := NewShapeIndex()
+
+	p1 := PointFromCoords(1, 0, 0)
+	p2 := PointFromCoords(0, 1, 0)
+	p3 := PointFromCoords(0, 0, 1)
+	p4 := PointFromCoords(-1, 0, 0)
+	p5 := PointFromCoords(0, -1, 0)
+
+	// LaxPolygon with mixed chains:
+	// chain 0: 4 vertices (4 edges)
+	// chain 1: 0 vertices (0 edges - full degeneracy)
+	// chain 2: 1 vertex (1 degenerate edge)
+	// chain 3: 2 vertices (2 edges)
+	// chain 4: 3 vertices (3 edges)
+	mixedLoops := [][]Point{
+		{p1, p2, p3, p4},
+		{},
+		{p5},
+		{p1, p2},
+		{p3, p4, p5},
+	}
+	laxPolyMixed := LaxPolygonFromPoints(mixedLoops)
+	idLaxPoly := idx.Add(laxPolyMixed)
+
+	// Polygon with 2 loops
+	poly2 := PolygonFromLoops([]*Loop{
+		makeLoop("0:0, 0:4, 4:4, 4:0"),
+		makeLoop("1:1, 1:2, 2:2, 2:1"),
+	})
+	idPoly2 := idx.Add(poly2)
+
+	// PointVector with 5 points (5 chains)
+	pv5 := PointVector{p1, p2, p3, p4, p5}
+	idPv5 := idx.Add(&pv5)
+
+	// Polyline (1 chain)
+	pline := makePolyline("0:0, 1:1, 2:2")
+	idPline := idx.Add(pline)
+
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	for _, id := range []int32{idLaxPoly, idPoly2, idPv5, idPline} {
+		compareShapes(t, id, idx.Shape(id), dec.Shape(id))
+	}
+
+	// Verify chain lengths for the mixed LaxPolygon
+	decLax := dec.Shape(idLaxPoly)
+	if decLax.NumChains() != 5 {
+		t.Fatalf("mixed LaxPolygon NumChains = %d, want 5", decLax.NumChains())
+	}
+	expectedChainLens := []int{4, 0, 1, 2, 3}
+	for i, wantLen := range expectedChainLens {
+		c := decLax.Chain(i)
+		if c.Length != wantLen {
+			t.Errorf("chain %d length = %d, want %d", i, c.Length, wantLen)
+		}
+	}
+
+	compareSpatialCells(t, idx, dec)
+}
