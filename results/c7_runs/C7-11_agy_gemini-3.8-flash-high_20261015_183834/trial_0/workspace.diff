+		}
+		if !decFull.IsFull() {
+			t.Errorf("decFull should be full")
+		}
+
+		// Mixed loops
+		p1 := PointFromCoords(1, 0, 0)
+		p2 := PointFromCoords(0, 1, 0)
+		p3 := PointFromCoords(0, 0, 1)
+		mixedLoops := [][]Point{
+			{p1, p2, p3},
+			{},
+			{p1},
+			{p2, p3},
+		}
+		lpMixed := LaxPolygonFromPoints(mixedLoops)
+		var bufMixed bytes.Buffer
+		if err := lpMixed.Encode(&bufMixed); err != nil {
+			t.Fatalf("lpMixed.Encode failed: %v", err)
+		}
+		var decMixed LaxPolygon
+		if err := decMixed.Decode(&bufMixed); err != nil {
+			t.Fatalf("decMixed.Decode failed: %v", err)
+		}
+		if decMixed.NumChains() != 4 {
+			t.Errorf("decMixed.NumChains() = %d, want 4", decMixed.NumChains())
+		}
+		if decMixed.NumEdges() != lpMixed.NumEdges() {
+			t.Errorf("decMixed.NumEdges() = %d, want %d", decMixed.NumEdges(), lpMixed.NumEdges())
+		}
+
+		// Malformed: oversized loops
+		var bufBad bytes.Buffer
+		bufBad.WriteByte(1)
+		binary.Write(&bufBad, binary.LittleEndian, uint32(math.MaxUint32))
+		var decBad LaxPolygon
+		if err := decBad.Decode(&bufBad); err == nil {
+			t.Errorf("expected error for oversized LaxPolygon loops, got nil")
+		}
+	})
+
+	t.Run("LaxLoop", func(t *testing.T) {
+		// Empty
+		ll0 := LaxLoopFromPoints(nil)
+		var buf0 bytes.Buffer
+		if err := ll0.Encode(&buf0); err != nil {
+			t.Fatalf("ll0.Encode failed: %v", err)
+		}
+		var dec0 LaxLoop
+		if err := dec0.Decode(&buf0); err != nil {
+			t.Fatalf("dec0.Decode failed: %v", err)
+		}
+		if !dec0.IsEmpty() {
+			t.Errorf("dec0 should be empty")
+		}
+
+		// Non-empty
+		pts := []Point{PointFromCoords(1, 0, 0), PointFromCoords(0, 1, 0), PointFromCoords(0, 0, 1)}
+		ll1 := LaxLoopFromPoints(pts)
+		var buf1 bytes.Buffer
+		if err := ll1.Encode(&buf1); err != nil {
+			t.Fatalf("ll1.Encode failed: %v", err)
+		}
+		var dec1 LaxLoop
+		if err := dec1.Decode(&buf1); err != nil {
+			t.Fatalf("dec1.Decode failed: %v", err)
+		}
+		if dec1.NumEdges() != 3 {
+			t.Errorf("dec1.NumEdges() = %d, want 3", dec1.NumEdges())
+		}
+
+		// Malformed: oversized
+		var bufBad bytes.Buffer
+		bufBad.WriteByte(1)
+		binary.Write(&bufBad, binary.LittleEndian, uint32(math.MaxUint32))
+		var decBad LaxLoop
+		if err := decBad.Decode(&bufBad); err == nil {
+			t.Errorf("expected error for oversized LaxLoop, got nil")
+		}
+	})
+}
