+  function restorePersistedQuery(
+    queryClient: QueryClient,
+    persistedQuery: PersistedQuery,
+  ) {
+    const queryCache = queryClient.getQueryCache()
+    const persistedState: QueryState = {
+      ...persistedQuery.state,
+      fetchStatus: 'idle',
+      fetchMeta: null,
+    }
+    const existing = queryCache.get(persistedQuery.queryHash)
+
+    if (!existing) {
+      queryCache.build(
+        queryClient,
+        {
+          queryKey: persistedQuery.queryKey,
+          queryHash: persistedQuery.queryHash,
+        },
+        persistedState,
+      )
+      return
+    }
+
+    // Merge data freshness and error freshness independently
+    const current = existing.state
+    const dataSource =
+      persistedState.data !== undefined &&
+      (current.data === undefined ||
+        persistedState.dataUpdatedAt > current.dataUpdatedAt)
+        ? persistedState
+        : current
+    const errorSource =
+      persistedState.errorUpdatedAt > current.errorUpdatedAt
+        ? persistedState
+        : current
+
+    const data = dataSource.data
+    const error = errorSource.error
+    const hasNewerError =
+      error != null && errorSource.errorUpdatedAt >= dataSource.dataUpdatedAt
+
+    let status: QueryState['status']
+    if (hasNewerError) {
+      status = 'error'
+    } else if (data !== undefined) {
+      status = 'success'
+    } else {
+      status = errorSource.status === 'error' ? 'error' : current.status
+    }
+
+    existing.setState({
+      data,
+      dataUpdateCount: Math.max(
+        current.dataUpdateCount,
+        persistedState.dataUpdateCount,
+      ),
+      dataUpdatedAt: dataSource.dataUpdatedAt,
+      error: hasNewerError || status === 'error' ? error : null,
+      errorUpdateCount: Math.max(
+        current.errorUpdateCount,
+        persistedState.errorUpdateCount,
+      ),
+      errorUpdatedAt: errorSource.errorUpdatedAt,
+      fetchFailureCount: hasNewerError
+        ? errorSource.fetchFailureCount
+        : dataSource.fetchFailureCount,
+      fetchFailureReason: hasNewerError
