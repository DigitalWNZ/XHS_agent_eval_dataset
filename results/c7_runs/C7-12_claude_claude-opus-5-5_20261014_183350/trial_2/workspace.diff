+/**
+ * Prepares a persisted query state to be adopted by a query:
+ * a restored query is never in-flight.
+ */
+function restorableState(state: QueryState): QueryState {
+  return {
+    ...state,
+    fetchStatus: 'idle',
+    fetchMeta: null,
+  }
+}
+
+/**
+ * Merges a persisted query state into the state of a query that already
+ * exists in memory. Data freshness and error freshness are reconciled
+ * independently, so that newer data is never discarded in favour of an older
+ * snapshot only because that snapshot carries a newer error (and vice versa).
+ *
+ * Returns `undefined` if the persisted state carries nothing newer.
+ */
+function mergeQueryStates(
+  current: QueryState,
+  persisted: QueryState,
+): Partial<QueryState> | undefined {
+  const persistedDataIsNewer =
+    persisted.data !== undefined &&
+    persisted.dataUpdatedAt > current.dataUpdatedAt
+  const persistedErrorIsNewer =
+    persisted.error != null && persisted.errorUpdatedAt > current.errorUpdatedAt
+
+  if (!persistedDataIsNewer && !persistedErrorIsNewer) {
+    return
+  }
+
+  const dataSource = persistedDataIsNewer ? persisted : current
+  const errorSource = persistedErrorIsNewer ? persisted : current
+
+  const data = dataSource.data
+  const dataUpdatedAt = dataSource.dataUpdatedAt
+  const errorIsCurrent =
+    errorSource.error != null && errorSource.errorUpdatedAt >= dataUpdatedAt
+
+  return {
+    data,
+    dataUpdatedAt,
+    dataUpdateCount: Math.max(
+      current.dataUpdateCount,
+      persisted.dataUpdateCount,
+    ),
+    error: errorIsCurrent || data === undefined ? errorSource.error : null,
+    errorUpdatedAt: errorSource.errorUpdatedAt,
+    errorUpdateCount: Math.max(
+      current.errorUpdateCount,
+      persisted.errorUpdateCount,
+    ),
+    fetchFailureCount: (errorIsCurrent ? errorSource : dataSource)
+      .fetchFailureCount,
+    fetchFailureReason: (errorIsCurrent ? errorSource : dataSource)
+      .fetchFailureReason,
+    isInvalidated:
+      dataSource.isInvalidated || (errorIsCurrent && errorSource.isInvalidated),
+    status: errorIsCurrent
+      ? 'error'
+      : data !== undefined
+        ? 'success'
+        : errorSource.error != null
+          ? 'error'
+          : current.status,
+  }
+}
