+++ b/encryption/encryption_test.go
@@ -0,0 +1,183 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func testKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, KeySize)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+	return key
+}
+
+func encrypt(t *testing.T, key, plain []byte) []byte {
+	t.Helper()
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := enc.EncryptWriter(&buf)
+	_, err = w.Write(plain)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	require.NoError(t, w.Close())
+
+	return buf.Bytes()
+}
+
+func decrypt(key, data []byte) ([]byte, error) {
+	r, err := DecryptReader(bytes.NewReader(data), key)
+	if err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+func TestNewEncryptorInvalidKey(t *testing.T) {
+	for _, n := range []int{0, 16, 31, 33} {
+		_, err := NewEncryptor(make([]byte, n))
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	}
+}
+
+func TestRoundTrip(t *testing.T) {
+	key := testKey(t)
+	for _, size := range []int{0, 1, ChunkSize - 1, ChunkSize, ChunkSize + 1, 3*ChunkSize + 17} {
+		plain := make([]byte, size)
+		_, _ = rand.Read(plain)
+
+		data := encrypt(t, key, plain)
+		assert.Equal(t, []byte{0x4F, 0x44, 0x01}, data[:3])
+
+		got, err := decrypt(key, data)
+		require.NoError(t, err, "size %d", size)
+		assert.Equal(t, plain, got)
+	}
+}
+
+func TestFormatAndUniqueNonces(t *testing.T) {
+	key := testKey(t)
+	plain := bytes.Repeat([]byte("a"), 2*ChunkSize+5)
+	data := encrypt(t, key, plain)
+
+	body := data[HeaderSize:]
+	nonces := map[string]bool{}
+	for {
+		length := binary.BigEndian.Uint32(body[:4])
+		if length == 0 {
+			body = body[4:]
+			break
+		}
+		nonce := string(body[4 : 4+NonceSize])
+		assert.False(t, nonces[nonce])
+		nonces[nonce] = true
+		body = body[4+length:]
+	}
+	assert.Len(t, nonces, 3)
+	assert.Len(t, body, MACSize)
+
+	assert.NotEqual(t, data, encrypt(t, key, plain))
+}
+
+func TestDecryptErrors(t *testing.T) {
+	key := testKey(t)
+	data := encrypt(t, key, []byte("hello world"))
+
+	bad := append([]byte{}, data...)
+	bad[0] = 0x00
+	_, err := decrypt(key, bad)
+	assert.ErrorContains(t, err, "invalid header")
+
+	bad = append([]byte{}, data...)
+	bad[2] = 0x02
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "unsupported version")
+
+	bad = append([]byte{}, data...)
+	bad[len(bad)-1] ^= 0xFF
+	_, err = decrypt(key, bad)
+	assert.ErrorContains(t, err, "integrity")
+
+	_, err = decrypt(testKey(t), data)
+	assert.Error(t, err)
+
+	_, err = decrypt(testKey(t), encrypt(t, key, nil))
+	assert.ErrorContains(t, err, "integrity")
+
+	for _, n := range []int{1, 3, 10, len(data) - 40, len(data) - 1} {
+		_, err = decrypt(key, data[:n])
+		assert.Error(t, err, "truncated at %d", n)
+	}
+}
+
+func TestValidate(t *testing.T) {
+	assert.NoError(t, Config{}.Validate())
+	assert.NoError(t, Config{KeySource: "bogus", Key: "x", KeyFile: "y"}.Validate())
+
+	assert.Error(t, Config{Enabled: true}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "kms"}.Validate())
+
+	assert.NoError(t, Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "K"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "file", KeyFile: "/k"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "Literal", Key: "abc"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s"}.Validate())
+
+	assert.Error(t, Config{Enabled: true, KeySource: "env"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Passphrase: "p"}.Validate())
+
+	err := Config{Enabled: true, KeySource: "env", KeyEnvVar: "K", Key: "abc"}.Validate()
+	assert.ErrorContains(t, err, "mutually exclusive")
+	err = Config{Enabled: true, KeySource: "literal", Key: "abc", Salt: "s"}.Validate()
+	assert.ErrorContains(t, err, "mutually exclusive")
+}
+
+func TestLoadKey(t *testing.T) {
+	key := testKey(t)
+	encoded := base64.StdEncoding.EncodeToString(key)
+
+	t.Setenv("ONEDUMP_TEST_KEY", encoded)
+	got, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	require.NoError(t, err)
+	assert.Equal(t, key, got)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY_UNSET"})
+	assert.Error(t, err)
+
+	file := filepath.Join(t.TempDir(), "key")
+	require.NoError(t, os.WriteFile(file, []byte("  "+encoded+"\n"), 0600))
+	got, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file})
+	require.NoError(t, err)
+	assert.Equal(t, key, got)
+
+	got, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: encoded})
+	require.NoError(t, err)
+	assert.Equal(t, key, got)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString([]byte("short"))})
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	salt := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte{7}, 16))
+	k1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: salt})
+	require.NoError(t, err)
+	k2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: salt})
+	require.NoError(t, err)
+	assert.Len(t, k1, KeySize)
+	assert.Equal(t, k1, k2)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: salt})
+	assert.Error(t, err)
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: base64.StdEncoding.EncodeToString([]byte("short"))})
+	assert.Error(t, err)
+}
