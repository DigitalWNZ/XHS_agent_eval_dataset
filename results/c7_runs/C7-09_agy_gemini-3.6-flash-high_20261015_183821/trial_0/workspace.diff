+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash_test.go
@@ -0,0 +1,353 @@
+package trafficpolicy
+
+import (
+	"testing"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+func TestConsistentHash_DefaultSourceIp(t *testing.T) {
+	// Requirement 1: When consistentHash is set as empty {}, default to a single sourceIp hash policy with terminal=false
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{},
+	}
+	outSpec := trafficPolicySpecIr{}
+	constructConsistentHash(spec, &outSpec)
+
+	require.NotNil(t, outSpec.consistentHash)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(outSpec.consistentHash, route)
+
+	action := route.GetRoute()
+	require.Len(t, action.HashPolicy, 1)
+	assert.False(t, action.HashPolicy[0].Terminal)
+	connProp := action.HashPolicy[0].GetConnectionProperties()
+	require.NotNil(t, connProp)
+	assert.True(t, connProp.SourceIp)
+}
+
+func TestConsistentHash_Disable(t *testing.T) {
+	// Requirement 2: When disable is true, no hash policies are produced and existing suppressed
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Disable: ptr.To(true),
+		},
+	}
+	outSpec := trafficPolicySpecIr{}
+	constructConsistentHash(spec, &outSpec)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{
+				HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{
+					{Terminal: true},
+				},
+			},
+		},
+	}
+	applyConsistentHash(outSpec.consistentHash, route)
+
+	action := route.GetRoute()
+	assert.Nil(t, action.HashPolicy)
+}
+
+func TestConsistentHash_ValidationDisableWithFields(t *testing.T) {
+	// When disable is true, no other fields may be set
+	ir := &consistentHashIR{
+		disable: ptr.To(true),
+		headers: []kgateway.ConsistentHashHeader{
+			{HeaderName: "X-Header"},
+		},
+	}
+	err := ir.Validate()
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "when disable is true, no other fields may be set")
+}
+
+func TestConsistentHash_CanonicalTypeOrder(t *testing.T) {
+	// Requirement 3: Canonical type order: headers, cookies, queryParameters, filterState, sourceIp
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			SourceIp: &kgateway.ConsistentHashSourceIp{Terminal: true},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs1"},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "qp1"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1"},
+			},
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "h1"},
+			},
+		},
+	}
+	outSpec := trafficPolicySpecIr{}
+	constructConsistentHash(spec, &outSpec)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(outSpec.consistentHash, route)
+
+	action := route.GetRoute()
+	require.Len(t, action.HashPolicy, 5)
+
+	// 0: Header
+	assert.Equal(t, "h1", action.HashPolicy[0].GetHeader().HeaderName)
+	// 1: Cookie
+	assert.Equal(t, "c1", action.HashPolicy[1].GetCookie().Name)
+	// 2: QueryParameter
+	assert.Equal(t, "qp1", action.HashPolicy[2].GetQueryParameter().Name)
+	// 3: FilterState
+	assert.Equal(t, "fs1", action.HashPolicy[3].GetFilterState().Key)
+	// 4: SourceIp
+	assert.True(t, action.HashPolicy[4].GetConnectionProperties().SourceIp)
+	assert.True(t, action.HashPolicy[4].Terminal)
+}
+
+func TestConsistentHash_Deduplication(t *testing.T) {
+	// Requirement 4: Deduplication by key; Header deduplication case-insensitive, preserving casing of first occurrence
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-Id", Terminal: true},
+				{HeaderName: "x-user-id", Terminal: false},
+				{HeaderName: "X-Session-Id"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "sess", Path: "/a"},
+				{Name: "sess", Path: "/b"},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "param1"},
+				{Name: "param1"},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "key1"},
+				{Key: "key1"},
+			},
+		},
+	}
+	outSpec := trafficPolicySpecIr{}
+	constructConsistentHash(spec, &outSpec)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(outSpec.consistentHash, route)
+
+	action := route.GetRoute()
+	// Should have 2 headers, 1 cookie, 1 query parameter, 1 filter state
+	require.Len(t, action.HashPolicy, 5)
+
+	// Headers: preserves first occurrence casing ("X-User-Id") and properties
+	assert.Equal(t, "X-User-Id", action.HashPolicy[0].GetHeader().HeaderName)
+	assert.True(t, action.HashPolicy[0].Terminal)
+	assert.Equal(t, "X-Session-Id", action.HashPolicy[1].GetHeader().HeaderName)
+
+	// Cookie: keeps first occurrence (path "/a")
+	assert.Equal(t, "sess", action.HashPolicy[2].GetCookie().Name)
+	assert.Equal(t, "/a", action.HashPolicy[2].GetCookie().Path)
+
+	// QueryParameter
+	assert.Equal(t, "param1", action.HashPolicy[3].GetQueryParameter().Name)
+
+	// FilterState
+	assert.Equal(t, "key1", action.HashPolicy[4].GetFilterState().Key)
+}
+
+func TestConsistentHash_RegexRewrite(t *testing.T) {
+	// Requirement 5: Header regexRewrite
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "Authorization",
+					RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+						Pattern:      "^Bearer (.*)$",
+						Substitution: "\\1",
+					},
+				},
+			},
+		},
+	}
+	outSpec := trafficPolicySpecIr{}
+	constructConsistentHash(spec, &outSpec)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(outSpec.consistentHash, route)
+
+	action := route.GetRoute()
+	require.Len(t, action.HashPolicy, 1)
+
+	headerPolicy := action.HashPolicy[0].GetHeader()
+	require.NotNil(t, headerPolicy)
+	assert.Equal(t, "Authorization", headerPolicy.HeaderName)
+	require.NotNil(t, headerPolicy.RegexRewrite)
