+func TestConsistentHash_MergePolicies(t *testing.T) {
+	// Requirement 7 & 8: Merge multiple policies targeting same route:
+	// - Union array fields with higher priority policy's entries first, deduplicated by key
+	// - Re-sorted into canonical type order
+	// - sourceIp scalar retains higher-priority policy's value even when unset
+	// - Merge metadata records consistentHash
+
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	// Higher priority policy (p1)
+	p1IR := &TrafficPolicy{}
+	constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-User-ID", Terminal: true},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session", Path: "/app1"},
+			},
+			// sourceIp is unset in p1
+		},
+	}, &p1IR.spec)
+
+	// Lower priority policy (p2)
+	p2IR := &TrafficPolicy{}
+	constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-user-id", Terminal: false}, // duplicate, p1 wins
+				{HeaderName: "X-Trace-ID"},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "session", Path: "/app2"}, // duplicate, p1 wins
+				{Name: "auth"},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "debug"},
+			},
+			SourceIp: &kgateway.ConsistentHashSourceIp{Terminal: true}, // p1 unset, so sourceIp stays unset!
+		},
+	}, &p2IR.spec)
+
+	pol1 := ir.PolicyAtt{
+		GroupKind:            gk,
+		PolicyRef:            &ir.AttachedPolicyRef{Name: "p1-higher"},
+		PolicyIr:             p1IR,
+		HierarchicalPriority: 10,
+	}
+	pol2 := ir.PolicyAtt{
+		GroupKind:            gk,
+		PolicyRef:            &ir.AttachedPolicyRef{Name: "p2-lower"},
+		PolicyIr:             p2IR,
+		HierarchicalPriority: 5,
+	}
+
+	mergedAtt := policy.MergePolicies([]ir.PolicyAtt{pol1, pol2}, mergeTrafficPolicies, "")
+	mergedIR, ok := mergedAtt.PolicyIr.(*TrafficPolicy)
+	require.True(t, ok)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(mergedIR.spec.consistentHash, route)
+
+	action := route.GetRoute()
+	// Headers: X-User-ID (from p1), X-Trace-ID (from p2)
+	// Cookies: session (path /app1 from p1), auth (from p2)
+	// QueryParameters: debug (from p2)
+	// SourceIp: nil (p1 retained nil value)
+	require.Len(t, action.HashPolicy, 5)
+
+	assert.Equal(t, "X-User-ID", action.HashPolicy[0].GetHeader().HeaderName)
+	assert.True(t, action.HashPolicy[0].Terminal)
+	assert.Equal(t, "X-Trace-ID", action.HashPolicy[1].GetHeader().HeaderName)
+
+	assert.Equal(t, "session", action.HashPolicy[2].GetCookie().Name)
+	assert.Equal(t, "/app1", action.HashPolicy[2].GetCookie().Path)
+	assert.Equal(t, "auth", action.HashPolicy[3].GetCookie().Name)
+
+	assert.Equal(t, "debug", action.HashPolicy[4].GetQueryParameter().Name)
+
+	// Check merge origins
+	origins := mergedAtt.MergeOrigins.Get("consistentHash")
+	require.NotEmpty(t, origins)
+}
