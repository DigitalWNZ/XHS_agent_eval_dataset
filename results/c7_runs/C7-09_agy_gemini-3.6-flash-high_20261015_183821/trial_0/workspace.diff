+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	if p2 == nil || p2.spec.consistentHash == nil {
+		return
+	}
+
+	if p1.spec.consistentHash == nil {
+		p1.spec.consistentHash = cloneConsistentHashIR(p2.spec.consistentHash)
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// Both p1 and p2 have consistentHash set.
+	// If p1 (higher priority) has disable=true, p1 remains disabled.
+	if ptr.Deref(p1.spec.consistentHash.disable, false) {
+		return
+	}
+
+	// Array fields are unioned with higher priority (p1) first, deduplicated by key.
+	p1.spec.consistentHash.headers = dedupHeaders(append(p1.spec.consistentHash.headers, p2.spec.consistentHash.headers...))
+	p1.spec.consistentHash.cookies = dedupCookies(append(p1.spec.consistentHash.cookies, p2.spec.consistentHash.cookies...))
+	p1.spec.consistentHash.queryParameters = dedupQueryParameters(append(p1.spec.consistentHash.queryParameters, p2.spec.consistentHash.queryParameters...))
+	p1.spec.consistentHash.filterState = dedupFilterState(append(p1.spec.consistentHash.filterState, p2.spec.consistentHash.filterState...))
+
+	// The sourceIp scalar retains the higher-priority policy's value even when unset.
+
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
+
+func cloneConsistentHashIR(in *consistentHashIR) *consistentHashIR {
+	if in == nil {
+		return nil
+	}
+	out := &consistentHashIR{
+		disable:         in.disable,
+		headers:         slices.Clone(in.headers),
+		cookies:         slices.Clone(in.cookies),
+		queryParameters: slices.Clone(in.queryParameters),
+		filterState:     slices.Clone(in.filterState),
+		sourceIp:        in.sourceIp,
+	}
+	return out
+}
