+func TestConsistentHash_CookieTTLAndAttributes(t *testing.T) {
+	// Requirement 6: Cookie ttl (Go duration format & integer seconds) and attributes pass-through
+	spec := kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Cookies: []kgateway.ConsistentHashCookie{
+				{
+					Name: "cookie1",
+					TTL:  "1h30m",
+					Attributes: []kgateway.ConsistentHashCookieAttribute{
+						{Name: "SameSite", Value: "Lax"},
+						{Name: "Secure"},
+					},
+				},
+				{
+					Name: "cookie2",
+					TTL:  "3600",
+				},
+			},
+		},
+	}
+	outSpec := trafficPolicySpecIr{}
+	constructConsistentHash(spec, &outSpec)
+
+	route := &envoyroutev3.Route{
+		Action: &envoyroutev3.Route_Route{
+			Route: &envoyroutev3.RouteAction{},
+		},
+	}
+	applyConsistentHash(outSpec.consistentHash, route)
+
+	action := route.GetRoute()
+	require.Len(t, action.HashPolicy, 2)
+
+	// Cookie 1: "1h30m" -> 5400s
+	c1 := action.HashPolicy[0].GetCookie()
+	require.NotNil(t, c1)
+	assert.Equal(t, "cookie1", c1.Name)
+	assert.Equal(t, durationpb.New(5400*time.Second), c1.Ttl)
+	require.Len(t, c1.Attributes, 2)
+	assert.Equal(t, "SameSite", c1.Attributes[0].Name)
+	assert.Equal(t, "Lax", c1.Attributes[0].Value)
+	assert.Equal(t, "Secure", c1.Attributes[1].Name)
+	assert.Equal(t, "", c1.Attributes[1].Value)
+
+	// Cookie 2: "3600" -> 3600s
+	c2 := action.HashPolicy[1].GetCookie()
+	require.NotNil(t, c2)
+	assert.Equal(t, "cookie2", c2.Name)
+	assert.Equal(t, durationpb.New(3600*time.Second), c2.Ttl)
+}
