+func TestConfigValidate(t *testing.T) {
+	// Disabled config is always valid
+	assert.NoError(t, Config{Enabled: false}.Validate())
+	assert.NoError(t, Config{Enabled: false, KeySource: "invalid", Key: "foo", KeyFile: "bar"}.Validate())
+
+	// Enabled with empty or unsupported source
+	assert.Error(t, Config{Enabled: true}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "unknown"}.Validate())
+
+	// Case-insensitive valid sources
+	assert.NoError(t, Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "File", KeyFile: "/tmp/key"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "LiTeRaL", Key: "abc"}.Validate())
+	assert.NoError(t, Config{Enabled: true, KeySource: "DERIVE", Passphrase: "pass", Salt: "salt"}.Validate())
+
+	// Missing required fields for each source
+	assert.Error(t, Config{Enabled: true, KeySource: "env"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "file"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "literal"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Passphrase: "pass"}.Validate())
+	assert.Error(t, Config{Enabled: true, KeySource: "derive", Salt: "salt"}.Validate())
+
+	// Mutually exclusive fields
+	exclCases := []Config{
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", KeyFile: "f"},
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", Key: "k"},
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", Passphrase: "p"},
+		{Enabled: true, KeySource: "env", KeyEnvVar: "K", Salt: "s"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", KeyEnvVar: "K"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", Key: "k"},
+		{Enabled: true, KeySource: "file", KeyFile: "f", Passphrase: "p"},
+		{Enabled: true, KeySource: "literal", Key: "k", KeyEnvVar: "K"},
+		{Enabled: true, KeySource: "literal", Key: "k", KeyFile: "f"},
+		{Enabled: true, KeySource: "literal", Key: "k", Salt: "s"},
+		{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", KeyEnvVar: "K"},
+		{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", KeyFile: "f"},
+		{Enabled: true, KeySource: "derive", Passphrase: "p", Salt: "s", Key: "k"},
+	}
+
+	for i, tc := range exclCases {
+		err := tc.Validate()
+		require.Error(t, err, "case %d", i)
+		assert.Contains(t, strings.ToLower(err.Error()), "mutually exclusive", "case %d", i)
+	}
+}
