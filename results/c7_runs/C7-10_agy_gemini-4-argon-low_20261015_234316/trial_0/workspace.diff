+func TestStorageReadWriteCloserEncryptionRoundTrip(t *testing.T) {
+	key := make([]byte, 32)
+	_, err := io.ReadFull(rand.Reader, key)
+	require.NoError(t, err)
+
+	enc, err := encryption.NewEncryptor(key)
+	require.NoError(t, err)
+
+	originalData := bytes.Repeat([]byte("CREATE TABLE users (id INT PRIMARY KEY);\n"), 5000)
+
+	readers, writer, closer := storageReadWriteCloser(2, true, enc)
+	require.Len(t, readers, 2)
+
+	var wg sync.WaitGroup
+	outputs := make([][]byte, 2)
+	readErrs := make([]error, 2)
+
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		go func(idx int) {
+			defer wg.Done()
+			outputs[idx], readErrs[idx] = io.ReadAll(readers[idx])
+		}(i)
+	}
+
+	_, err = writer.Write(originalData)
+	require.NoError(t, err)
+	require.NoError(t, closer.Close())
+
+	wg.Wait()
+
+	for i := 0; i < 2; i++ {
+		require.NoError(t, readErrs[i])
+
+		dr, err := encryption.DecryptReader(bytes.NewReader(outputs[i]), key)
+		require.NoError(t, err)
+
+		gr, err := gzip.NewReader(dr)
+		require.NoError(t, err)
+
+		decompressed, err := io.ReadAll(gr)
+		require.NoError(t, err)
+		require.NoError(t, gr.Close())
+
+		assert.Equal(t, originalData, decompressed)
+	}
+}
