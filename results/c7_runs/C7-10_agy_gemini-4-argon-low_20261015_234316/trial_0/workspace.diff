+	res2 := NewJobHandler(jobWithStorage).Do()
+	require.Error(t, res2.Error)
+	errLower2 := strings.ToLower(res2.Error.Error())
+	assert.True(t, strings.Contains(errLower2, "encryption") || strings.Contains(errLower2, "key"), "error was: %v", res2.Error)
+	_ = base64.StdEncoding
+}
