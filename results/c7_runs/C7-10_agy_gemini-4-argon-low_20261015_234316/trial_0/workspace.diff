+func TestStreamFormatAndNonces(t *testing.T) {
+	key := generateRandomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// 2.5 chunks -> 3 chunks total
+	plain := bytes.Repeat([]byte("A"), 64*1024*2+1024)
+
+	var buf1, buf2 bytes.Buffer
+	ew1 := enc.EncryptWriter(&buf1)
+	_, err = ew1.Write(plain)
+	require.NoError(t, ew1.Close())
+
+	ew2 := enc.EncryptWriter(&buf2)
+	_, err = ew2.Write(plain)
+	require.NoError(t, ew2.Close())
+
+	// Two encryptions of same plaintext must differ
+	assert.NotEqual(t, buf1.Bytes(), buf2.Bytes())
+
+	data := buf1.Bytes()
+	// Header: 0x4F 0x44 0x01
+	require.True(t, len(data) >= 3+4+32)
+	assert.Equal(t, byte(0x4F), data[0])
+	assert.Equal(t, byte(0x44), data[1])
+	assert.Equal(t, byte(0x01), data[2])
+
+	// Parse chunks and check nonces are unique
+	offset := 3
+	nonces := make(map[string]bool)
+	chunkCount := 0
+	for {
+		require.True(t, offset+4 <= len(data))
+		chunkLen := binary.BigEndian.Uint32(data[offset : offset+4])
+		if chunkLen == 0 {
+			break
+		}
+		offset += 4
+		chunkCount++
+		require.True(t, offset+int(chunkLen) <= len(data))
+		nonce := string(data[offset : offset+12])
+		assert.False(t, nonces[nonce], "duplicate nonce found")
+		nonces[nonce] = true
+		offset += int(chunkLen)
+	}
+	assert.Equal(t, 3, chunkCount)
+
+	// Verify sentinel + 32-byte HMAC
+	sentinelOffset := offset
+	assert.Equal(t, []byte{0, 0, 0, 0}, data[sentinelOffset:sentinelOffset+4])
+	assert.Equal(t, sentinelOffset+4+32, len(data))
+
+	mac := hmac.New(sha256.New, key)
+	mac.Write(data[3:sentinelOffset])
+	expectedMAC := mac.Sum(nil)
+	assert.Equal(t, expectedMAC, data[sentinelOffset+4:])
+}
