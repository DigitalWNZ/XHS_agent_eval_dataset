diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..73be2e4
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,543 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const (
+	magicByte0 = 0x4F
+	magicByte1 = 0x44
+	version01  = 0x01
+	headerSize = 3
+
+	maxChunkSize = 64 * 1024 // 64KB
+	nonceSize    = 12
+	tagSize      = 16
+	hmacSize     = 32
+	keySize      = 32
+	minSaltSize  = 16
+
+	pbkdf2Iterations = 100000
+)
+
+var (
+	ErrInvalidKey        = errors.New("invalid encryption key: must be 32 bytes")
+	ErrInvalidHeader     = errors.New("invalid header")
+	ErrUnsupportedVer    = errors.New("unsupported version")
+	ErrIntegrityFailure  = errors.New("integrity check failed")
+	ErrTruncatedData     = errors.New("truncated encrypted data")
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled" json:"enabled"`
+	KeySource  string `yaml:"keysource" json:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar" json:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile" json:"keyfile"`
+	Key        string `yaml:"key" json:"key"`
+	Passphrase string `yaml:"passphrase" json:"passphrase"`
+	Salt       string `yaml:"salt" json:"salt"`
+}
+
+func (c *Config) UnmarshalYAML(unmarshal func(interface{}) error) error {
+	var raw struct {
+		Enabled      bool   `yaml:"enabled"`
+		KeySource    string `yaml:"keysource"`
+		KeySourceAlt string `yaml:"key_source"`
+		KeySourceHyp string `yaml:"key-source"`
+		Source       string `yaml:"source"`
+		KeyEnvVar    string `yaml:"keyenvvar"`
+		KeyEnvVarAlt string `yaml:"key_env_var"`
+		KeyEnvVarHyp string `yaml:"key-env-var"`
+		KeyFile      string `yaml:"keyfile"`
+		KeyFileAlt   string `yaml:"key_file"`
+		KeyFileHyp   string `yaml:"key-file"`
+		Key          string `yaml:"key"`
+		Passphrase   string `yaml:"passphrase"`
+		Salt         string `yaml:"salt"`
+	}
+	if err := unmarshal(&raw); err != nil {
+		return err
+	}
+	c.Enabled = raw.Enabled
+	c.KeySource = firstNonEmpty(raw.KeySource, raw.KeySourceAlt, raw.KeySourceHyp, raw.Source)
+	c.KeyEnvVar = firstNonEmpty(raw.KeyEnvVar, raw.KeyEnvVarAlt, raw.KeyEnvVarHyp)
+	c.KeyFile = firstNonEmpty(raw.KeyFile, raw.KeyFileAlt, raw.KeyFileHyp)
+	c.Key = raw.Key
+	c.Passphrase = raw.Passphrase
+	c.Salt = raw.Salt
+	return nil
+}
+
+func firstNonEmpty(vals ...string) string {
+	for _, v := range vals {
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	hasEnv := strings.TrimSpace(c.KeyEnvVar) != ""
+	hasFile := strings.TrimSpace(c.KeyFile) != ""
+	hasLiteral := strings.TrimSpace(c.Key) != ""
+	hasDerive := strings.TrimSpace(c.Passphrase) != "" || strings.TrimSpace(c.Salt) != ""
+
+	switch source {
+	case "env":
+		if !hasEnv {
+			return errors.New("encryption key_env_var is required for env key source")
+		}
+		if hasFile || hasLiteral || hasDerive {
+			return errors.New("encryption key source fields are mutually exclusive")
+		}
+	case "file":
+		if !hasFile {
+			return errors.New("encryption key_file is required for file key source")
+		}
+		if hasEnv || hasLiteral || hasDerive {
+			return errors.New("encryption key source fields are mutually exclusive")
+		}
+	case "literal":
+		if !hasLiteral {
+			return errors.New("encryption key is required for literal key source")
+		}
+		if hasEnv || hasFile || hasDerive {
+			return errors.New("encryption key source fields are mutually exclusive")
+		}
+	case "derive":
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("encryption passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("encryption salt is required for derive key source")
+		}
+		if hasEnv || hasFile || hasLiteral {
+			return errors.New("encryption key source fields are mutually exclusive")
+		}
+	default:
+		return fmt.Errorf("unsupported encryption key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	if b, err := base64.StdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.RawStdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.URLEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	return base64.RawURLEncoding.DecodeString(s)
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	cfg.Enabled = true
+	if err := cfg.Validate(); err != nil {
+		return nil, fmt.Errorf("encryption config validation failed: %w", err)
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		envName := strings.TrimSpace(cfg.KeyEnvVar)
+		if envName == "" {
+			return nil, errors.New("encryption key environment variable name is empty")
+		}
+		val, ok := os.LookupEnv(envName)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set or empty", envName)
+		}
+		key, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from env %q: %w", envName, err)
+		}
+		if len(key) != keySize {
+			return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "file":
+		filePath := strings.TrimSpace(cfg.KeyFile)
+		if filePath == "" {
+			return nil, errors.New("encryption key file path is empty")
+		}
+		data, err := os.ReadFile(filePath)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %q: %w", filePath, err)
+		}
+		trimmed := strings.TrimSpace(string(data))
+		if trimmed == "" {
+			return nil, fmt.Errorf("encryption key file %q is empty", filePath)
+		}
+		key, err := decodeBase64(trimmed)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %q: %w", filePath, err)
+		}
+		if len(key) != keySize {
+			return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "literal":
+		lit := strings.TrimSpace(cfg.Key)
+		if lit == "" {
+			return nil, errors.New("encryption literal key is empty")
+		}
+		key, err := decodeBase64(lit)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 literal encryption key: %w", err)
+		}
+		if len(key) != keySize {
+			return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+		}
+		return key, nil
+
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("encryption passphrase cannot be empty")
+		}
+		saltStr := strings.TrimSpace(cfg.Salt)
+		if saltStr == "" {
+			return nil, errors.New("encryption salt cannot be empty")
+		}
+		salt, err := decodeBase64(saltStr)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption salt: %w", err)
+		}
+		if len(salt) < minSaltSize {
+			return nil, fmt.Errorf("encryption salt must be at least %d bytes, got %d", minSaltSize, len(salt))
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, pbkdf2Iterations, keySize, sha256.New)
+		return key, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source: %s", cfg.KeySource)
+	}
+}
+
+type Encryptor struct {
+	key []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, keySize, len(key))
+	}
+	keyCopy := make([]byte, keySize)
+	copy(keyCopy, key)
+	return &Encryptor{key: keyCopy}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	block, err := aes.NewCipher(e.key)
+	var gcm cipher.AEAD
+	if err == nil {
+		gcm, err = cipher.NewGCM(block)
+	}
+	mac := hmac.New(sha256.New, e.key)
+	return &encryptWriter{
+		w:       w,
+		gcm:     gcm,
+		mac:     mac,
+		buf:     make([]byte, 0, maxChunkSize),
+		initErr: err,
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	mac           io.Writer
+	hmacHash      func() []byte
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	initErr       error
+}
+
+func (ew *encryptWriter) ensureHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{magicByte0, magicByte1, version01}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk(plain []byte) error {
+	if len(plain) == 0 {
+		return nil
+	}
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return err
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce, plain, nil)
+	chunkLen := uint32(len(nonce) + len(ciphertext))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	// Write to HMAC (covers all bytes between header and sentinel)
+	_, _ = ew.mac.Write(lenBuf[:])
+	_, _ = ew.mac.Write(nonce)
+	_, _ = ew.mac.Write(ciphertext)
+
+	if _, err := ew.w.Write(lenBuf[:]); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(nonce); err != nil {
+		return err
+	}
+	if _, err := ew.w.Write(ciphertext); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.initErr != nil {
+		return 0, ew.initErr
+	}
+	if ew.closed {
+		return 0, errors.New("write on closed EncryptWriter")
+	}
+
+	totalWritten := 0
+	for len(p) > 0 {
+		space := maxChunkSize - len(ew.buf)
+		toCopy := len(p)
+		if toCopy > space {
+			toCopy = space
+		}
+		ew.buf = append(ew.buf, p[:toCopy]...)
+		p = p[toCopy:]
+		totalWritten += toCopy
+
+		if len(ew.buf) == maxChunkSize {
+			if err := ew.flushChunk(ew.buf); err != nil {
+				return totalWritten, err
+			}
+			ew.buf = ew.buf[:0]
+		}
+	}
+
+	return totalWritten, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.initErr != nil {
+		return ew.initErr
+	}
+
+	if err := ew.ensureHeader(); err != nil {
+		return err
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = ew.buf[:0]
+	}
+
+	// Write 4 zero bytes sentinel
+	var sentinel [4]byte
+	if _, err := ew.w.Write(sentinel[:]); err != nil {
+		return err
+	}
+
+	// Write 32-byte HMAC-SHA256
+	h, ok := ew.mac.(interface{ Sum([]byte) []byte })
+	if !ok {
+		return errors.New("internal hmac error")
+	}
+	sum := h.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != keySize {
+		return nil, fmt.Errorf("%w: expected %d bytes, got %d", ErrInvalidKey, keySize, len(key))
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	keyCopy := make([]byte, keySize)
+	copy(keyCopy, key)
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		mac: hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	gcm         cipher.AEAD
+	mac         interface {
+		io.Writer
+		Sum([]byte) []byte
+	}
+	initialized bool
+	done        bool
+	err         error
+	plainBuf    []byte
+}
+
+func (dr *decryptReader) initHeader() error {
+	var header [headerSize]byte
+	_, err := io.ReadFull(dr.r, header[:])
+	if err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("%w: %v", ErrInvalidHeader, ErrTruncatedData)
+		}
+		return err
+	}
+	if header[0] != magicByte0 || header[1] != magicByte1 {
+		return fmt.Errorf("%w: bad magic bytes", ErrInvalidHeader)
+	}
+	if header[2] != version01 {
+		return fmt.Errorf("%w: version 0x%02x", ErrUnsupportedVer, header[2])
+	}
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readNextChunk() error {
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("%w: missing chunk length or sentinel", ErrTruncatedData)
+		}
+		return err
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		// Sentinel reached; read and verify 32-byte HMAC
+		var expectedMAC [hmacSize]byte
+		if _, err := io.ReadFull(dr.r, expectedMAC[:]); err != nil {
+			if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+				return fmt.Errorf("%w: truncated HMAC", ErrTruncatedData)
+			}
+			return err
+		}
+		actualMAC := dr.mac.Sum(nil)
+		if !hmac.Equal(actualMAC, expectedMAC[:]) {
+			return fmt.Errorf("%w: HMAC verification failed", ErrIntegrityFailure)
+		}
+		dr.done = true
+		return io.EOF
+	}
+
+	minChunkPayload := uint32(nonceSize + tagSize)
+	maxChunkPayload := uint32(nonceSize + maxChunkSize + tagSize)
+	if chunkLen < minChunkPayload || chunkLen > maxChunkPayload {
+		return fmt.Errorf("%w: invalid chunk length %d", ErrIntegrityFailure, chunkLen)
+	}
+
+	payload := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, payload); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("%w: truncated chunk payload", ErrTruncatedData)
+		}
+		return err
+	}
+
+	_, _ = dr.mac.Write(lenBuf[:])
+	_, _ = dr.mac.Write(payload)
+
+	nonce := payload[:nonceSize]
+	ciphertext := payload[nonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("%w: chunk authentication failed: %v", ErrIntegrityFailure, err)
+	}
+
+	dr.plainBuf = plaintext
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	if !dr.initialized {
+		if err := dr.initHeader(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.plainBuf) == 0 {
+		if dr.done {
+			return 0, io.EOF
+		}
+		if err := dr.readNextChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	n := copy(p, dr.plainBuf)
+	dr.plainBuf = dr.plainBuf[n:]
+	return n, nil
+}
