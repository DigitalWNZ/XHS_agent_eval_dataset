+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	key := generateRandomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	sizes := []int{
+		0,
+		1,
+		100,
+		64*1024 - 1,
+		64 * 1024,
+		64*1024 + 1,
+		128 * 1024,
+		200 * 1024,
+	}
+
+	for _, size := range sizes {
+		plain := make([]byte, size)
+		_, err := io.ReadFull(rand.Reader, plain)
+		require.NoError(t, err)
+
+		var buf bytes.Buffer
+		ew := enc.EncryptWriter(&buf)
+
+		// Write in small pieces or all at once
+		if size > 1000 {
+			_, err = ew.Write(plain[:500])
+			require.NoError(t, err)
+			_, err = ew.Write(plain[500:])
+			require.NoError(t, err)
+		} else {
+			_, err = ew.Write(plain)
+			require.NoError(t, err)
+		}
+		require.NoError(t, ew.Close())
+		// Close is idempotent
+		require.NoError(t, ew.Close())
+
+		dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+		require.NoError(t, err)
+
+		decrypted, err := io.ReadAll(dr)
+		require.NoError(t, err)
+		assert.Equal(t, plain, decrypted, "mismatch for size %d", size)
+	}
+}
