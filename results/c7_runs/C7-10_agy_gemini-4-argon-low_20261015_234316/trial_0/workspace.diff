+func TestDecryptReaderLazyAndErrors(t *testing.T) {
+	key := generateRandomKey(t)
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Invalid key length to DecryptReader
+	_, err = DecryptReader(bytes.NewReader(nil), []byte("short"))
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// Lazy init: bad header does not fail in DecryptReader, only in Read
+	dr, err := DecryptReader(bytes.NewReader([]byte{0x00, 0x00, 0x01}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "invalid header")
+
+	// Unsupported version
+	dr, err = DecryptReader(bytes.NewReader([]byte{0x4F, 0x44, 0x02}), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "unsupported version")
+
+	// Valid encrypted stream
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("secret message"))
+	require.NoError(t, err)
+	require.NoError(t, ew.Close())
+	validData := buf.Bytes()
+
+	// Wrong key must fail
+	wrongKey := generateRandomKey(t)
+	dr, err = DecryptReader(bytes.NewReader(validData), wrongKey)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+
+	// Corrupted HMAC must return error containing "integrity"
+	corruptHMAC := make([]byte, len(validData))
+	copy(corruptHMAC, validData)
+	corruptHMAC[len(corruptHMAC)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(corruptHMAC), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+
+	// Empty stream HMAC tampered
+	var emptyBuf bytes.Buffer
+	ewEmpty := enc.EncryptWriter(&emptyBuf)
+	require.NoError(t, ewEmpty.Close())
+	emptyData := emptyBuf.Bytes()
+	emptyData[len(emptyData)-1] ^= 0xFF
+	dr, err = DecryptReader(bytes.NewReader(emptyData), key)
+	require.NoError(t, err)
+	_, err = io.ReadAll(dr)
+	require.Error(t, err)
+	assert.Contains(t, strings.ToLower(err.Error()), "integrity")
+
+	// Truncated data at various points must error
+	for cut := 0; cut < len(validData); cut++ {
+		dr, err = DecryptReader(bytes.NewReader(validData[:cut]), key)
+		require.NoError(t, err)
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "expected error for truncated length %d", cut)
+	}
+}
