+func TestLoadKey(t *testing.T) {
+	rawKey := generateRandomKey(t)
+	b64Key := base64.StdEncoding.EncodeToString(rawKey)
+
+	// 1. env source
+	envName := "ONEDUMP_TEST_ENC_KEY"
+	t.Setenv(envName, b64Key)
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: envName})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Unset env var -> error
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_UNSET_VAR_XYZ"})
+	require.Error(t, err)
+
+	// 2. file source (with whitespace trimming)
+	tmpDir := t.TempDir()
+	keyFile := filepath.Join(tmpDir, "key.txt")
+	require.NoError(t, os.WriteFile(keyFile, []byte("  \n"+b64Key+"\n\t "), 0600))
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: keyFile})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// 3. literal source
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: b64Key})
+	require.NoError(t, err)
+	assert.Equal(t, rawKey, loaded)
+
+	// Wrong length key in literal
+	shortKeyB64 := base64.StdEncoding.EncodeToString([]byte("shortkey"))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: shortKeyB64})
+	require.Error(t, err)
+	assert.ErrorIs(t, err, ErrInvalidKey)
+
+	// 4. derive source
+	salt := make([]byte, 16)
+	_, err = io.ReadFull(rand.Reader, salt)
+	require.NoError(t, err)
+	saltB64 := base64.StdEncoding.EncodeToString(salt)
+
+	derived1, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-secret-passphrase", Salt: saltB64})
+	require.NoError(t, err)
+	assert.Len(t, derived1, 32)
+
+	// Deterministic
+	derived2, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-secret-passphrase", Salt: saltB64})
+	require.NoError(t, err)
+	assert.Equal(t, derived1, derived2)
+
+	// Different passphrase -> different key
+	derived3, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "other-passphrase", Salt: saltB64})
+	require.NoError(t, err)
+	assert.NotEqual(t, derived1, derived3)
+
+	// Short salt (< 16 bytes) rejected
+	shortSaltB64 := base64.StdEncoding.EncodeToString([]byte("123456789012345"))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "my-secret-passphrase", Salt: shortSaltB64})
+	require.Error(t, err)
+
+	// Empty passphrase rejected
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: saltB64})
+	require.Error(t, err)
+}
