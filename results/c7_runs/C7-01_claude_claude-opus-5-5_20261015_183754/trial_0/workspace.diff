diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..eae13ebe
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,172 @@
+import { describe, expect, expectTypeOf, test } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	type SQL,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int as mysqlInt, mysqlTable } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { integer as sqliteInt, sqliteTable } from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	department: text('department').notNull(),
+	salary: integer('salary').notNull(),
+	bonus: integer('bonus'),
+});
+
+const db = pgDrizzle.mock();
+
+function compile(field: SQL<unknown>) {
+	return db.select({ v: field }).from(employees).toSQL();
+}
+
+describe('window functions', () => {
+	test('ranking functions', () => {
+		expect(compile(rowNumber().over()).sql).toBe('select row_number() over () from "employees"');
+		expect(compile(rank().over({ orderBy: desc(employees.salary) })).sql).toBe(
+			'select rank() over (order by "employees"."salary" desc) from "employees"',
+		);
+		expect(compile(denseRank().over({ partitionBy: employees.department, orderBy: employees.salary })).sql).toBe(
+			'select dense_rank() over (partition by "employees"."department" order by "employees"."salary") from "employees"',
+		);
+		expect(compile(ntile(4).over({})).sql).toBe(
+			'select ntile(4) over () from "employees"',
+		);
+		expect(compile(ntile(4).over()).params).toEqual([]);
+		expect(compile(percentRank().over()).sql).toBe('select percent_rank() over () from "employees"');
+		expect(compile(cumeDist().over()).sql).toBe('select cume_dist() over () from "employees"');
+	});
+
+	test('offset functions', () => {
+		expect(compile(lag(employees.salary).over()).sql).toBe('select lag("employees"."salary") over () from "employees"');
+		const q = compile(lag(employees.salary, 0, 0).over());
+		expect(q.sql).toBe('select lag("employees"."salary", 0, 0) over () from "employees"');
+		expect(q.params).toEqual([]);
+		expect(compile(lead(employees.salary, 2).over()).sql).toBe(
+			'select lead("employees"."salary", 2) over () from "employees"',
+		);
+		expect(compile(firstValue(employees.salary).over()).sql).toBe(
+			'select first_value("employees"."salary") over () from "employees"',
+		);
+		expect(compile(lastValue(employees.salary).over()).sql).toBe(
+			'select last_value("employees"."salary") over () from "employees"',
+		);
+		expect(compile(nthValue(employees.salary, 2).over()).sql).toBe(
+			'select nth_value("employees"."salary", 2) over () from "employees"',
+		);
+	});
+
+	test('aggregates', () => {
+		expect(compile(windowSum(employees.salary).over()).sql).toBe(
+			'select sum("employees"."salary") over () from "employees"',
+		);
+		expect(compile(windowAvg(employees.salary).over()).sql).toBe(
+			'select avg("employees"."salary") over () from "employees"',
+		);
+		expect(compile(windowMin(employees.salary).over()).sql).toBe(
+			'select min("employees"."salary") over () from "employees"',
+		);
+		expect(compile(windowMax(employees.salary).over()).sql).toBe(
+			'select max("employees"."salary") over () from "employees"',
+		);
+		expect(compile(windowCount().over()).sql).toBe('select count(*) over () from "employees"');
+		expect(compile(windowCount(employees.id).over()).sql).toBe(
+			'select count("employees"."id") over () from "employees"',
+		);
+	});
+
+	test('frames', () => {
+		expect(
+			compile(
+				windowSum(employees.salary).over({
+					orderBy: employees.id,
+					frame: rows({ from: unboundedPreceding, to: currentRow }),
+				}),
+			).sql,
+		).toBe(
+			'select sum("employees"."salary") over (order by "employees"."id" rows between unbounded preceding and current row) from "employees"',
+		);
+		const q = compile(
+			windowAvg(employees.salary).over({
+				orderBy: employees.id,
+				frame: range({ from: preceding(0), to: following(3) }),
+			}),
+		);
+		expect(q.sql).toBe(
+			'select avg("employees"."salary") over (order by "employees"."id" range between 0 preceding and 3 following) from "employees"',
+		);
+		expect(q.params).toEqual([]);
+		expect(rows({ from: currentRow, to: unboundedFollowing })).toBeDefined();
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrow(/from/);
+		expect(() => range({ from: following(3), to: following(1) })).toThrow(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: unboundedFollowing })).toThrow(/from/);
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => following(1.5)).toThrow(/following/);
+	});
+
+	test('argument validation', () => {
+		expect(() => ntile(0)).toThrow(/ntile.*0/);
+		expect(() => ntile(1.5)).toThrow(/ntile.*1\.5/);
+		expect(() => nthValue(employees.salary, -1)).toThrow(/nthValue.*-1/);
+	});
+
+	test('named windows', () => {
+		const q = db.select({ r: rank().over('w') }).from(employees)
+			.window('w', { partitionBy: employees.department, orderBy: desc(employees.salary) })
+			.orderBy(employees.id)
+			.toSQL();
+		expect(q.sql).toBe(
+			'select rank() over "w" from "employees" window "w" as (partition by "employees"."department" order by "employees"."salary" desc) order by "employees"."id"',
+		);
+		expect(() => db.select().from(employees).window('', {})).toThrow(/non-empty/);
+		expect(() => db.select().from(employees).window('   ', {})).toThrow(/whitespace/);
+	});
+
+	test('window method across dialects', () => {
+		const m = mysqlTable('t', { id: mysqlInt('id') });
+		expect(
+			mysqlDrizzle.mock().select({ r: rowNumber().over('w') }).from(m).window('w', { orderBy: m.id }).toSQL().sql,
+		).toBe('select row_number() over `w` from `t` window `w` as (order by `t`.`id`)');
+		const s = sqliteTable('t', { id: sqliteInt('id') });
+		const sdb = sqliteDrizzle(':memory:');
+		expect(sdb.select({ r: rowNumber().over('w') }).from(s).window('w', { orderBy: s.id }).toSQL().sql).toBe(
+			'select row_number() over "w" from "t" window "w" as (order by "t"."id")',
+		);
+	});
+
+	test('types', () => {
+		expectTypeOf(rowNumber().over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(lag(employees.bonus).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(lag(employees.bonus, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(lead(employees.salary, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(firstValue(employees.salary).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(nthValue(employees.salary, 1).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(windowCount().over()).toEqualTypeOf<SQL<number>>();
+	});
+});
