diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..73194b0c
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,459 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+/** Infers the TypeScript data type of a column or SQL expression. */
+export type InferWindowExpressionType<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+type WindowSpecItem = SQLWrapper;
+
+export type WindowFrameBoundaryKind =
+	| 'unbounded preceding'
+	| 'preceding'
+	| 'current row'
+	| 'following'
+	| 'unbounded following';
+
+/** A single boundary of a window frame, e.g. `unbounded preceding` or `3 following`. */
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly kind: WindowFrameBoundaryKind,
+		readonly offset?: number | SQLWrapper,
+	) {}
+
+	/** @internal Ordering rank used to validate `from <= to`. `undefined` if not statically known. */
+	get rank(): number | undefined {
+		switch (this.kind) {
+			case 'unbounded preceding': {
+				return Number.NEGATIVE_INFINITY;
+			}
+			case 'current row': {
+				return 0;
+			}
+			case 'unbounded following': {
+				return Number.POSITIVE_INFINITY;
+			}
+			case 'preceding': {
+				return typeof this.offset === 'number' ? -this.offset : undefined;
+			}
+			case 'following': {
+				return typeof this.offset === 'number' ? this.offset : undefined;
+			}
+		}
+	}
+
+	/** @internal */
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		if (this.offset === undefined) {
+			return sql.raw(this.kind);
+		}
+		const offset = typeof this.offset === 'number' ? sql.raw(String(this.offset)) : this.offset;
+		return sql`${offset} ${sql.raw(this.kind)}`;
+	}
+}
+
+/** `unbounded preceding` frame boundary */
+export const unboundedPreceding = new WindowFrameBoundary('unbounded preceding');
+/** `current row` frame boundary */
+export const currentRow = new WindowFrameBoundary('current row');
+/** `unbounded following` frame boundary */
+export const unboundedFollowing = new WindowFrameBoundary('unbounded following');
+
+function frameOffset(fnName: string, offset: number | SQLWrapper): number | SQLWrapper {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset < 0) {
+			throw new Error(`${fnName}() expects a non-negative integer, received: ${offset}`);
+		}
+		return offset;
+	}
+	if (!isSQLWrapper(offset)) {
+		throw new Error(`${fnName}() expects a non-negative integer or SQL expression, received: ${String(offset)}`);
+	}
+	return offset;
+}
+
+/** `<offset> preceding` frame boundary */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	return new WindowFrameBoundary('preceding', frameOffset('preceding', offset));
+}
+
+/** `<offset> following` frame boundary */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	return new WindowFrameBoundary('following', frameOffset('following', offset));
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+/** A window frame clause, e.g. `rows between unbounded preceding and current row`. */
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: 'rows' | 'range',
+		readonly from: WindowFrameBoundary,
+		readonly to?: WindowFrameBoundary,
+	) {}
+
+	/** @internal */
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		if (this.to === undefined) {
+			return sql`${sql.raw(this.mode)} ${this.from}`;
+		}
+		return sql`${sql.raw(this.mode)} between ${this.from} and ${this.to}`;
+	}
+}
+
+function buildFrame(mode: 'rows' | 'range', spec: WindowFrameSpec): WindowFrame {
+	if (!spec || !is(spec.from, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects a "from" frame boundary`);
+	}
+	const { from, to } = spec;
+	if (to !== undefined && !is(to, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects "to" to be a frame boundary`);
+	}
+	if (from.kind === 'unbounded following') {
+		throw new Error(`${mode}(): "from" boundary cannot be unbounded following`);
+	}
+	if (to?.kind === 'unbounded preceding') {
+		throw new Error(`${mode}(): "to" boundary cannot be unbounded preceding`);
+	}
+	if (to !== undefined) {
+		const fromRank = from.rank;
+		const toRank = to.rank;
+		if (fromRank !== undefined && toRank !== undefined && fromRank > toRank) {
+			throw new Error(`${mode}(): "from" boundary (${from.kind}) must not come after "to" boundary (${to.kind})`);
+		}
+		// Statically unknown offsets: still reject obvious ordering violations based on direction
+		if (
+			(fromRank === undefined || toRank === undefined)
+			&& directionRank(from.kind) > directionRank(to.kind)
+		) {
+			throw new Error(`${mode}(): "from" boundary (${from.kind}) must not come after "to" boundary (${to.kind})`);
+		}
+	}
+	return new WindowFrame(mode, from, to);
+}
+
+function directionRank(kind: WindowFrameBoundaryKind): number {
+	switch (kind) {
+		case 'unbounded preceding': {
+			return 0;
+		}
+		case 'preceding': {
+			return 1;
+		}
+		case 'current row': {
+			return 2;
+		}
+		case 'following': {
+			return 3;
+		}
+		case 'unbounded following': {
+			return 4;
+		}
+	}
+}
+
+/**
+ * Builds a `rows` window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * windowSum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * })
+ * ```
+ */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/**
+ * Builds a `range` window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * windowAvg(prices.value).over({
+ *   orderBy: prices.day,
+ *   frame: range({ from: preceding(3), to: following(3) }),
+ * })
+ * ```
+ */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: WindowSpecItem | WindowSpecItem[];
+	orderBy?: WindowSpecItem | WindowSpecItem[];
+	frame?: WindowFrame;
+}
+
+function toList(value: WindowSpecItem | WindowSpecItem[] | undefined): WindowSpecItem[] {
+	if (value === undefined) return [];
+	return Array.isArray(value) ? value : [value];
+}
+
+/** @internal Builds the parenthesized window specification, e.g. `(partition by ... order by ...)`. */
+export function buildWindowSpec(spec: WindowSpec | undefined): SQL {
+	const parts: SQL[] = [];
+	const partitionBy = toList(spec?.partitionBy);
+	if (partitionBy.length > 0) {
+		parts.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+	const orderBy = toList(spec?.orderBy);
+	if (orderBy.length > 0) {
+		parts.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+	if (spec?.frame !== undefined) {
+		if (!is(spec.frame, WindowFrame)) {
+			throw new Error('Window "frame" must be built with rows() or range()');
+		}
+		parts.push(spec.frame.getSQL());
+	}
+	return sql`(${sql.join(parts, sql` `)})`;
+}
+
+/** @internal Validates a named window identifier. */
+export function validateWindowName(name: unknown): asserts name is string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not consist only of whitespace');
+	}
+}
+
+/** @internal Builds a single `"name" as (...)` named window definition. */
+export function buildWindowDefinition(name: string, spec: WindowSpec): SQL {
+	validateWindowName(name);
+	return sql`${sql.identifier(name)} as ${buildWindowSpec(spec)}`;
+}
+
+/** @internal Builds the ` window ...` clause from named window definitions. */
+export function buildWindowClause(windows: SQL[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	return sql` window ${sql.join(windows, sql`, `)}`;
+}
+
+type Decoder = DriverValueDecoder<any, any> | DriverValueDecoder<any, any>['mapFromDriverValue'];
+
+/**
+ * A window function call that must be completed with `.over()`.
+ */
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: {
+		readonly type: T;
+	};
+
+	constructor(
+		/** @internal */
+		readonly call: SQL,
+		/** @internal */
+		readonly decoder?: Decoder,
+	) {}
+
+	/**
+	 * Adds an `over` clause.
+	 *
+	 * @param spec an inline window specification, or the name of a window defined with `.window()`.
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		let result: SQL;
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			result = sql`${this.call} over ${sql.identifier(spec)}`;
+		} else {
+			result = sql`${this.call} over ${buildWindowSpec(spec)}`;
+		}
+		if (this.decoder) {
+			result = result.mapWith(this.decoder);
+		}
+		return result as SQL<T>;
+	}
+}
+
+function decoderOf(expression: SQLWrapper): Decoder | undefined {
+	if (is(expression, Column)) return expression;
+	if (is(expression, SQL)) return expression.decoder;
+	if (is(expression, SQL.Aliased)) return expression.sql.decoder;
+	return undefined;
+}
+
+function positiveInteger(fnName: string, value: number): SQL {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() expects a positive integer, received: ${String(value)}`);
+	}
+	return sql.raw(String(value));
+}
+
+function nonNegativeInteger(fnName: string, value: number): SQL {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${fnName}() expects a non-negative integer offset, received: ${String(value)}`);
+	}
+	return sql.raw(String(value));
+}
+
+function defaultValue(value: unknown): SQLWrapper {
+	if (typeof value === 'number' && Number.isFinite(value)) {
+		return sql.raw(String(value));
+	}
+	if (isSQLWrapper(value)) {
+		return value;
+	}
+	return sql`${value}`;
+}
+
+/** `row_number()` window function. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+/** `rank()` window function. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+/** `dense_rank()` window function. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+/** `ntile(buckets)` window function. `buckets` must be a positive integer. */
+export function ntile(buckets: number): WindowFunction<number> {
+	return new WindowFunction(sql`ntile(${positiveInteger('ntile', buckets)})`, Number);
+}
+
+/** `percent_rank()` window function. */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+/** `cume_dist()` window function. */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+function offsetFunction(
+	name: 'lag' | 'lead',
+	expression: SQLWrapper,
+	args: unknown[],
+): WindowFunction<any> {
+	const [offset, defaultVal] = args;
+	const chunks: SQLWrapper[] = [expression];
+	if (args.length >= 1 && offset !== undefined) {
+		chunks.push(nonNegativeInteger(name, offset as number));
+	}
+	if (args.length >= 2 && defaultVal !== undefined) {
+		if (chunks.length === 1) chunks.push(sql.raw('1'));
+		chunks.push(defaultValue(defaultVal));
+	}
+	return new WindowFunction(sql`${sql.raw(name)}(${sql.join(chunks, sql`, `)})`, decoderOf(expression));
+}
+
+/**
+ * `lag(expression[, offset[, default]])` window function.
+ *
+ * The result is nullable unless a default value is provided.
+ */
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<InferWindowExpressionType<T> | null>;
+export function lag<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<NonNullable<InferWindowExpressionType<T>>>;
+export function lag(expression: SQLWrapper, ...args: unknown[]): WindowFunction<any> {
+	return offsetFunction('lag', expression, args);
+}
+
+/**
+ * `lead(expression[, offset[, default]])` window function.
+ *
+ * The result is nullable unless a default value is provided.
+ */
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<InferWindowExpressionType<T> | null>;
+export function lead<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<NonNullable<InferWindowExpressionType<T>>>;
+export function lead(expression: SQLWrapper, ...args: unknown[]): WindowFunction<any> {
+	return offsetFunction('lead', expression, args);
+}
+
+/** `first_value(expression)` window function. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowExpressionType<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, decoderOf(expression));
+}
+
+/** `last_value(expression)` window function. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowExpressionType<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, decoderOf(expression));
+}
+
+/** `nth_value(expression, n)` window function. `n` must be a positive integer. */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<InferWindowExpressionType<T> | null> {
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${positiveInteger('nthValue', n)})`,
+		decoderOf(expression),
+	);
+}
+
+/** `sum(expression)` used as a window function. */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+/** `avg(expression)` used as a window function. */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+/** `min(expression)` used as a window function. */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `max(expression)` used as a window function. */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `count(expression)` used as a window function. Emits `count(*)` when called without an argument. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
