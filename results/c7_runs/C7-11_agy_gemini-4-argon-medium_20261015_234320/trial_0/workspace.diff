+	index.Add(LaxLoopFromPoints(parsePoints("3:3, 3:4")))
+	index.Add(LaxLoopFromPoints(parsePoints("10:10, 10:12, 12:12, 12:10")))
+
+	// 6. Polygon (empty, full, 1 loop, multi-loop with hole)
+	index.Add(&Polygon{})
+	index.Add(PolygonFromLoops(nil))
+	index.Add(FullPolygon())
+	index.Add(makePolygon("0:0, 0:5, 5:5, 5:0", true))
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:4, 4:4, 4:2", true))
+
+	// 7. LaxPolygon (empty, full, 1 loop, multi-loop with mixed chain counts)
+	index.Add(LaxPolygonFromPoints(nil))
+	index.Add(LaxPolygonFromPoints([][]Point{{}}))
+	index.Add(LaxPolygonFromPoints([][]Point{parsePoints("7:7")}))
+	index.Add(LaxPolygonFromPoints([][]Point{
+		parsePoints("0:0, 0:8, 8:8, 8:0"),
+		parsePoints("1:1, 3:3, 1:3"),
+		parsePoints("5:5, 5:6, 6:6, 6:5, 5:5"),
+	}))
+
+	// 8. edgeVectorShape (0 edges, 1 edge, multiple edges)
+	emptyEVS := &edgeVectorShape{}
+	multiEVS := &edgeVectorShape{}
+	multiEVS.Add(parsePoint("0:0"), parsePoint("1:1"))
+	multiEVS.Add(parsePoint("2:2"), parsePoint("3:3"))
+	index.Add(emptyEVS)
+	index.Add(multiEVS)
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	assertShapeIndexesEqual(t, decoded, index)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+
+	// Verify concrete types survived for all built-in exported Shape types.
+	if _, ok := decoded.Shape(0).(*PointVector); !ok {
+		t.Errorf("Shape(0) type = %T, want *PointVector", decoded.Shape(0))
+	}
+	if _, ok := decoded.Shape(3).(*Polyline); !ok {
+		t.Errorf("Shape(3) type = %T, want *Polyline", decoded.Shape(3))
+	}
+	if _, ok := decoded.Shape(6).(*LaxPolyline); !ok {
+		t.Errorf("Shape(6) type = %T, want *LaxPolyline", decoded.Shape(6))
+	}
+	if _, ok := decoded.Shape(9).(*Loop); !ok {
+		t.Errorf("Shape(9) type = %T, want *Loop", decoded.Shape(9))
+	}
+	if _, ok := decoded.Shape(12).(*LaxLoop); !ok {
+		t.Errorf("Shape(12) type = %T, want *LaxLoop", decoded.Shape(12))
+	}
+	if _, ok := decoded.Shape(16).(*Polygon); !ok {
+		t.Errorf("Shape(16) type = %T, want *Polygon", decoded.Shape(16))
+	}
+	if _, ok := decoded.Shape(21).(*LaxPolygon); !ok {
+		t.Errorf("Shape(21) type = %T, want *LaxPolygon", decoded.Shape(21))
+	}
+}
