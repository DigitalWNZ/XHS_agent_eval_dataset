+// Encode encodes the ShapeIndex.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if s == nil {
+		return errors.New("cannot encode nil ShapeIndex")
+	}
+	if w == nil {
+		return errors.New("cannot encode ShapeIndex to nil writer")
+	}
+	cw := &crcWriter{w: w, hash: crc32.NewIEEE()}
+	e := &encoder{w: cw}
+	s.encode(e, cw)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder, cw *crcWriter) {
+	s.maybeApplyUpdates()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	nextID := s.nextID
+	for id, sh := range s.shapes {
+		if sh == nil {
+			continue
+		}
+		if id < 0 {
+			e.err = fmt.Errorf("invalid negative shape ID %d", id)
+			return
+		}
+		shapeIDs = append(shapeIDs, id)
+		if id >= nextID {
+			nextID = id + 1
+		}
+	}
+	slices.Sort(shapeIDs)
+	if nextID < 0 {
+		nextID = 0
+	}
+
+	cells := s.cells
+	if len(cells) == 0 && len(s.cellMap) > 0 {
+		cells = make([]CellID, 0, len(s.cellMap))
+		for cid := range s.cellMap {
+			cells = append(cells, cid)
+		}
+		slices.Sort(cells)
+	}
+
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(maxEdges))
+	e.writeUvarint(uint64(nextID))
+	e.writeUvarint(uint64(len(shapeIDs)))
+
+	for _, id := range shapeIDs {
+		if e.err != nil {
+			return
+		}
+		e.writeUvarint(uint64(id))
+		encodeShapeIndexShape(e, s.shapes[id])
+	}
+
+	e.writeUvarint(uint64(len(cells)))
+	for _, cid := range cells {
+		if e.err != nil {
+			return
+		}
+		cell := s.cellMap[cid]
+		e.writeUint64(uint64(cid))
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(uint32(clipped.shapeID)))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+
+	if e.err != nil {
+		return
+	}
+	sum := cw.hash.Sum32()
+	rawEnc := &encoder{w: cw.w}
+	rawEnc.writeUint32(sum)
+	e.err = rawEnc.err
+}
+
+// Decode decodes the ShapeIndex.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if s == nil {
+		return errors.New("cannot decode into nil ShapeIndex")
+	}
+	if r == nil {
+		return errors.New("cannot decode ShapeIndex from nil reader")
+	}
+	br := asByteReader(r)
+	cr := &crcByteReader{r: br, hash: crc32.NewIEEE()}
+	d := &decoder{r: cr}
+	s.decode(d, cr)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder, cr *crcByteReader) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > maxEncodedEdgesPerCell {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell (%d; max is %d)", maxEdgesPerCell, maxEncodedEdgesPerCell)
+		return
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("nextID too large (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numShapes > nextID || numShapes > maxEncodedShapes {
+		d.err = fmt.Errorf("invalid shape count %d (nextID=%d, max=%d)", numShapes, nextID, maxEncodedShapes)
+		return
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), maxInitialSliceAlloc))
+	prevShapeID := int32(-1)
+	for range numShapes {
+		idVal := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if idVal >= nextID {
+			d.err = fmt.Errorf("shape ID %d out of range [0, %d)", idVal, nextID)
+			return
+		}
+		id := int32(idVal)
+		if id <= prevShapeID {
+			d.err = fmt.Errorf("shape IDs not in strictly increasing order: %d <= %d", id, prevShapeID)
+			return
+		}
+		prevShapeID = id
+
+		sh := decodeShapeIndexShape(d)
+		if d.err != nil {
+			return
+		}
+		shapes[id] = sh
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(int(numCells), maxInitialSliceAlloc))
+	}
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), maxInitialSliceAlloc))
+
+	for i := uint64(0); i < numCells; i++ {
+		cid := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !cid.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID %#x", uint64(cid))
+			return
+		}
+		if i > 0 && cid.RangeMin() <= cells[i-1].RangeMax() {
+			d.err = fmt.Errorf("cells not in strictly increasing non-overlapping order at index %d", i)
+			return
+		}
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped > numShapes {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, numShapes)
+			return
+		}
+
+		clippedShapes := make([]*clippedShape, 0, min(int(numClipped), maxInitialSliceAlloc))
+		prevClippedID := int32(-1)
+		for range numClipped {
+			cShapeIDVal := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if cShapeIDVal >= nextID {
+				d.err = fmt.Errorf("clipped shape ID %d out of range [0, %d)", cShapeIDVal, nextID)
+				return
+			}
+			cShapeID := int32(cShapeIDVal)
+			if cShapeID <= prevClippedID {
+				d.err = fmt.Errorf("clipped shape IDs not in strictly increasing order: %d <= %d", cShapeID, prevClippedID)
+				return
+			}
+			prevClippedID = cShapeID
+
+			sh, ok := shapes[cShapeID]
+			if !ok || sh == nil {
+				d.err = fmt.Errorf("clipped shape references non-existent shape ID %d", cShapeID)
+				return
+			}
+
+			containsCenterByte := d.readUint8()
+			if d.err != nil {
+				return
+			}
+			if containsCenterByte > 1 {
+				d.err = fmt.Errorf("invalid containsCenter flag %d", containsCenterByte)
+				return
+			}
+			containsCenter := containsCenterByte == 1
+			if containsCenter && sh.Dimension() != 2 {
+				d.err = fmt.Errorf("non-polygon shape %d cannot contain cell center", cShapeID)
+				return
+			}
+
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			shapeNumEdges := uint64(sh.NumEdges())
+			if numEdges > shapeNumEdges {
+				d.err = fmt.Errorf("clipped shape edge count %d exceeds shape %d edge count %d", numEdges, cShapeID, shapeNumEdges)
+				return
+			}
+
+			edges := make([]int, 0, min(int(numEdges), maxInitialSliceAlloc))
+			prevEdgeID := -1
+			for range numEdges {
+				edgeIDVal := d.readUvarint()
+				if d.err != nil {
+					return
+				}
+				if edgeIDVal >= shapeNumEdges {
+					d.err = fmt.Errorf("clipped edge ID %d out of range [0, %d)", edgeIDVal, shapeNumEdges)
+					return
+				}
+				edgeID := int(edgeIDVal)
+				if edgeID <= prevEdgeID {
+					d.err = fmt.Errorf("clipped edge IDs not in strictly increasing order: %d <= %d", edgeID, prevEdgeID)
+					return
+				}
+				prevEdgeID = edgeID
+				edges = append(edges, edgeID)
+			}
+
+			clippedShapes = append(clippedShapes, &clippedShape{
+				shapeID:        cShapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		cells = append(cells, cid)
+		cellMap[cid] = &ShapeIndexCell{shapes: clippedShapes}
+	}
+
+	gotCRC := cr.hash.Sum32()
+	rawDec := &decoder{r: cr.r}
+	wantCRC := rawDec.readUint32()
+	if rawDec.err != nil {
+		d.err = rawDec.err
+		return
+	}
+	if gotCRC != wantCRC {
+		d.err = fmt.Errorf("shapeindex checksum mismatch: got %#x, want %#x", gotCRC, wantCRC)
+		return
+	}
+
+	s.mu.Lock()
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.shapes = shapes
+	s.cells = cells
+	s.cellMap = cellMap
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+}
+
+func writeShapeIndexPoint(e *encoder, p Point) {
+	e.writeFloat64(p.X)
+	e.writeFloat64(p.Y)
+	e.writeFloat64(p.Z)
+}
+
+func readShapeIndexPoint(d *decoder) Point {
+	x := d.readFloat64()
+	y := d.readFloat64()
+	z := d.readFloat64()
+	if d.err != nil {
+		return Point{}
+	}
+	if math.IsNaN(x) || math.IsNaN(y) || math.IsNaN(z) ||
+		math.IsInf(x, 0) || math.IsInf(y, 0) || math.IsInf(z, 0) {
+		d.err = fmt.Errorf("invalid point coordinates (%v, %v, %v)", x, y, z)
+		return Point{}
+	}
+	return Point{r3.Vector{X: x, Y: y, Z: z}}
+}
+
+func readShapeIndexPoints(d *decoder, n uint64) []Point {
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+	pts := make([]Point, 0, min(int(n), maxInitialSliceAlloc))
+	for range n {
+		pt := readShapeIndexPoint(d)
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, pt)
+	}
+	return pts
+}
+
+func validatePointsFinite(d *decoder, pts []Point) {
+	if d.err != nil {
+		return
+	}
+	for _, pt := range pts {
+		if math.IsNaN(pt.X) || math.IsNaN(pt.Y) || math.IsNaN(pt.Z) ||
+			math.IsInf(pt.X, 0) || math.IsInf(pt.Y, 0) || math.IsInf(pt.Z, 0) {
+			d.err = fmt.Errorf("invalid point coordinates (%v, %v, %v)", pt.X, pt.Y, pt.Z)
+			return
+		}
+	}
+}
+
+func encodeShapeIndexShape(e *encoder, shape Shape) {
+	switch sh := shape.(type) {
+	case *Polygon:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *Polygon")
+			return
+		}
+		e.writeUvarint(uint64(typeTagPolygon))
+		sh.encodeLossless(e)
+	case *Polyline:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *Polyline")
+			return
+		}
+		e.writeUvarint(uint64(typeTagPolyline))
+		sh.encode(e)
+	case *PointVector:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *PointVector")
+			return
+		}
+		e.writeUvarint(uint64(typeTagPointVector))
+		e.writeUvarint(uint64(len(*sh)))
+		for _, pt := range *sh {
+			writeShapeIndexPoint(e, pt)
+		}
+	case *LaxPolyline:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *LaxPolyline")
+			return
+		}
+		e.writeUvarint(uint64(typeTagLaxPolyline))
+		e.writeUvarint(uint64(len(sh.vertices)))
+		for _, pt := range sh.vertices {
+			writeShapeIndexPoint(e, pt)
+		}
+	case *LaxPolygon:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *LaxPolygon")
+			return
+		}
+		e.writeUvarint(uint64(typeTagLaxPolygon))
+		e.writeUvarint(uint64(sh.numLoops))
+		for i := range sh.numLoops {
+			nv := sh.numLoopVertices(i)
+			e.writeUvarint(uint64(nv))
+			for j := range nv {
+				writeShapeIndexPoint(e, sh.loopVertex(i, j))
+			}
+		}
+	case *Loop:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *Loop")
+			return
+		}
+		e.writeUvarint(uint64(shapeIndexTypeTagLoop))
+		sh.encode(e)
+	case *LaxLoop:
+		if sh == nil {
+			e.err = errors.New("cannot encode nil *LaxLoop")
+			return
+		}
+		e.writeUvarint(uint64(shapeIndexTypeTagLaxLoop))
+		e.writeUvarint(uint64(sh.numVertices))
+		for i := range sh.numVertices {
+			writeShapeIndexPoint(e, sh.vertices[i])
+		}
+	default:
+		if shape == nil {
+			e.err = errors.New("cannot encode nil Shape")
+			return
+		}
+		e.writeUvarint(uint64(shapeIndexTypeTagGeneric))
+		e.writeUint8(uint8(shape.Dimension()))
+		e.writeBool(shape.IsEmpty())
+		e.writeBool(shape.IsFull())
+		e.writeUvarint(uint64(shape.typeTag()))
+		ref := shape.ReferencePoint()
+		e.writeBool(ref.Contained)
+		writeShapeIndexPoint(e, ref.Point)
+		numChains := shape.NumChains()
+		e.writeUvarint(uint64(numChains))
+		for c := range numChains {
+			ch := shape.Chain(c)
+			e.writeUvarint(uint64(ch.Start))
+			e.writeUvarint(uint64(ch.Length))
+		}
+		numEdges := shape.NumEdges()
+		e.writeUvarint(uint64(numEdges))
+		for i := range numEdges {
+			ed := shape.Edge(i)
+			writeShapeIndexPoint(e, ed.V0)
+			writeShapeIndexPoint(e, ed.V1)
+		}
+	}
+}
+
+func decodeShapeIndexShape(d *decoder) Shape {
+	tag := typeTag(d.readUvarint())
+	if d.err != nil {
+		return nil
+	}
+	switch tag {
+	case typeTagPolygon:
+		ver := d.readInt8()
+		if d.err != nil {
+			return nil
+		}
+		if ver != encodingVersion {
+			d.err = fmt.Errorf("unsupported polygon version %d", ver)
+			return nil
+		}
+		p := new(Polygon)
+		p.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		if !p.bound.IsValid() {
+			d.err = errors.New("invalid polygon bound")
+			return nil
+		}
+		for _, l := range p.loops {
+			if !l.bound.IsValid() || l.depth < 0 || l.depth > maxEncodedLoops {
+				d.err = errors.New("invalid loop in polygon")
+				return nil
+			}
+			validatePointsFinite(d, l.vertices)
+			if d.err != nil {
+				return nil
+			}
+		}
+		return p
+
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		validatePointsFinite(d, *p)
+		if d.err != nil {
+			return nil
+		}
+		return p
+
+	case typeTagPointVector:
+		n := d.readUvarint()
+		pts := readShapeIndexPoints(d, n)
+		if d.err != nil {
+			return nil
+		}
+		pv := PointVector(pts)
+		return &pv
+
+	case typeTagLaxPolyline:
+		n := d.readUvarint()
+		pts := readShapeIndexPoints(d, n)
+		if d.err != nil {
+			return nil
+		}
+		return LaxPolylineFromPoints(pts)
+
+	case typeTagLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numLoops > maxEncodedLoops {
+			d.err = fmt.Errorf("too many loops in LaxPolygon (%d; max is %d)", numLoops, maxEncodedLoops)
+			return nil
+		}
+		loops := make([][]Point, 0, min(int(numLoops), maxInitialSliceAlloc))
+		var totalVerts uint64
+		for range numLoops {
+			nv := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if nv > maxEncodedVertices || totalVerts+nv > maxEncodedVertices {
+				d.err = fmt.Errorf("too many vertices in LaxPolygon")
+				return nil
+			}
+			totalVerts += nv
+			pts := readShapeIndexPoints(d, nv)
+			if d.err != nil {
+				return nil
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops)
+
+	case shapeIndexTypeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		if !l.bound.IsValid() || l.depth < 0 || l.depth > maxEncodedLoops {
+			d.err = errors.New("invalid decoded loop")
+			return nil
+		}
+		validatePointsFinite(d, l.vertices)
+		if d.err != nil {
+			return nil
+		}
+		return l
+
+	case shapeIndexTypeTagLaxLoop:
+		n := d.readUvarint()
+		pts := readShapeIndexPoints(d, n)
+		if d.err != nil {
+			return nil
+		}
+		if n == 0 {
+			return &LaxLoop{}
+		}
+		return LaxLoopFromPoints(pts)
+
+	case shapeIndexTypeTagGeneric:
+		dim := int(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		if dim < 0 || dim > 2 {
+			d.err = fmt.Errorf("invalid generic shape dimension %d", dim)
+			return nil
+		}
+		isEmptyByte := d.readUint8()
+		isFullByte := d.readUint8()
+		origTag := d.readUvarint()
+		containedByte := d.readUint8()
+		if d.err != nil {
+			return nil
+		}
+		if isEmptyByte > 1 || isFullByte > 1 || containedByte > 1 || origTag > uint64(math.MaxUint32) {
+			d.err = errors.New("invalid generic shape header flags")
+			return nil
+		}
+		refPt := readShapeIndexPoint(d)
+		if d.err != nil {
+			return nil
+		}
+		numChains := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numChains > maxEncodedVertices {
+			d.err = fmt.Errorf("too many chains (%d; max is %d)", numChains, maxEncodedVertices)
+			return nil
+		}
+		chains := make([]Chain, 0, min(int(numChains), maxInitialSliceAlloc))
+		for range numChains {
+			start := d.readUvarint()
+			length := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if start > maxEncodedVertices || length > maxEncodedVertices {
+				d.err = fmt.Errorf("invalid chain range (%d, %d)", start, length)
+				return nil
+			}
+			chains = append(chains, Chain{Start: int(start), Length: int(length)})
+		}
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > maxEncodedVertices {
+			d.err = fmt.Errorf("too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+			return nil
+		}
+		for _, ch := range chains {
+			if ch.Start < 0 || ch.Length < 0 || uint64(ch.Start) > numEdges || uint64(ch.Length) > numEdges-uint64(ch.Start) {
+				d.err = fmt.Errorf("invalid chain (%d, %d) for numEdges %d", ch.Start, ch.Length, numEdges)
+				return nil
+			}
+		}
+		edges := make([]Edge, 0, min(int(numEdges), maxInitialSliceAlloc))
+		for range numEdges {
+			v0 := readShapeIndexPoint(d)
+			v1 := readShapeIndexPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, Edge{V0: v0, V1: v1})
+		}
+		return &genericShape{
+			dimension: dim,
+			refPoint:  ReferencePoint{Point: refPt, Contained: containedByte == 1},
+			isEmpty:   isEmptyByte == 1,
+			isFull:    isFullByte == 1,
+			tag:       typeTag(origTag),
+			chains:    chains,
+			edges:     edges,
+		}
+
+	default:
+		d.err = fmt.Errorf("unsupported shape type tag %d", tag)
+		return nil
+	}
+}
