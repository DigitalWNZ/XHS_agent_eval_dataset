+func FuzzDecodeShapeIndex(f *testing.F) {
+	idx1 := NewShapeIndex()
+	idx2 := makeShapeIndex("0:0 | 1:1 # 0:0, 1:1, 2:2 # 0:0, 0:5, 5:5, 5:0")
+	for _, idx := range []*ShapeIndex{idx1, idx2} {
+		var buf bytes.Buffer
+		if err := idx.Encode(&buf); err != nil {
+			f.Fatalf("Encode failed: %v", err)
+		}
+		f.Add(buf.Bytes())
+	}
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		var idx ShapeIndex
+		if err := idx.Decode(bytes.NewReader(data)); err != nil {
+			return
+		}
+		if !idx.IsFresh() {
+			t.Errorf("decoded index is not fresh")
+		}
+		for it := idx.Iterator(); !it.Done(); it.Next() {
+			_ = it.CellID()
+			_ = it.IndexCell()
+		}
+	})
+}
