+func TestShapeIndexEncodeDecodePreservesShapeIDsAndCellStructure(t *testing.T) {
+	index := NewShapeIndex()
+	s0 := makePolyline("0:0, 0:2, 2:2")
+	s1 := makePolyline("10:10, 10:12, 12:12")
+	s2 := makePolygon("0:0, 0:6, 6:6, 6:0; 1:1, 1:2, 2:2, 2:1", true)
+	s3 := PointVector(parsePoints("3:3, 4:4, 5:5"))
+
+	id0 := index.Add(s0)
+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+	id3 := index.Add(&s3)
+
+	if id0 != 0 || id1 != 1 || id2 != 2 || id3 != 3 {
+		t.Fatalf("unexpected shape IDs: %d, %d, %d, %d", id0, id1, id2, id3)
+	}
+
+	// Remove shape 1 so shape IDs have a gap (0, 2, 3).
+	index.Remove(s1)
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	var decoded ShapeIndex
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(0) == nil {
+		t.Errorf("Shape(0) should be non-nil")
+	}
+	if decoded.Shape(1) != nil {
+		t.Errorf("Shape(1) should be nil after removal, got %v", decoded.Shape(1))
+	}
+	if decoded.Shape(2) == nil {
+		t.Errorf("Shape(2) should be non-nil")
+	}
+	if decoded.Shape(3) == nil {
+		t.Errorf("Shape(3) should be non-nil")
+	}
+	assertShapeIndexesEqual(t, &decoded, index)
+	quadraticValidate(t, &decoded)
+	testIteratorMethods(t, &decoded)
+
+	// Verify ClosestEdgeQuery, CrossingEdgeQuery, ContainsPointQuery, and Region on decoded index.
+	ceq := NewClosestEdgeQuery(&decoded, NewClosestEdgeQueryOptions().MaxResults(1).IncludeInteriors(false))
+	target := NewMinDistanceToPointTarget(parsePoint("3:3"))
+	results := ceq.FindEdges(target)
+	if len(results) != 1 || results[0].ShapeID() != 3 {
+		t.Errorf("ClosestEdgeQuery results = %v, want ShapeID 3", results)
+	}
+
+	cpq := NewContainsPointQuery(&decoded, VertexModelSemiOpen)
+	if !cpq.Contains(parsePoint("4:4")) {
+		t.Errorf("ContainsPointQuery(4:4) = false, want true")
+	}
+	if cpq.Contains(parsePoint("1.5:1.5")) {
+		t.Errorf("ContainsPointQuery(1.5:1.5 in hole) = true, want false")
+	}
+}
