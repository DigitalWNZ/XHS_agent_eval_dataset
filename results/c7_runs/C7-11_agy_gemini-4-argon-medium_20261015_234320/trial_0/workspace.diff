+	// 4. Loop (EmptyLoop, FullLoop, regular Loop)
+	index.Add(EmptyLoop())
+	index.Add(FullLoop())
+	index.Add(makeLoop("0:0, 0:4, 4:4, 4:0"))
+
+	// 5. LaxLoop (empty, 1 vertex, 2 vertices, multi-vertex)
+	index.Add(LaxLoopFromLoop(EmptyLoop()))
