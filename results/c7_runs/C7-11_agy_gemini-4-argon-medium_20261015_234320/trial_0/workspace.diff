+func assertShapesEqual(t *testing.T, got, want Shape) {
+	t.Helper()
+	if (got == nil) != (want == nil) {
+		t.Fatalf("shape nil mismatch: got %v, want %v", got, want)
+	}
+	if got == nil {
+		return
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("Dimension() = %d, want %d", got.Dimension(), want.Dimension())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("IsEmpty() = %v, want %v", got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("IsFull() = %v, want %v", got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("ReferencePoint() = %v, want %v", got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	for e := 0; e < want.NumEdges(); e++ {
+		if got.Edge(e) != want.Edge(e) {
+			t.Errorf("Edge(%d) = %v, want %v", e, got.Edge(e), want.Edge(e))
+		}
+		if got.ChainPosition(e) != want.ChainPosition(e) {
+			t.Errorf("ChainPosition(%d) = %v, want %v", e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("NumChains() = %d, want %d", got.NumChains(), want.NumChains())
+	}
+	for c := 0; c < want.NumChains(); c++ {
+		gotChain := got.Chain(c)
+		wantChain := want.Chain(c)
+		if gotChain != wantChain {
+			t.Fatalf("Chain(%d) = %v, want %v", c, gotChain, wantChain)
+		}
+		for offset := 0; offset < wantChain.Length; offset++ {
+			if got.ChainEdge(c, offset) != want.ChainEdge(c, offset) {
+				t.Errorf("ChainEdge(%d, %d) = %v, want %v", c, offset, got.ChainEdge(c, offset), want.ChainEdge(c, offset))
+			}
+		}
+	}
+}
+
+func assertShapeIndexesEqual(t *testing.T, got, want *ShapeIndex) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded ShapeIndex should be fresh without calling Build()")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	for id := int32(0); id < want.nextID; id++ {
+		assertShapesEqual(t, got.Shape(id), want.Shape(id))
+	}
+
+	if len(got.cells) != len(want.cells) {
+		t.Fatalf("len(cells) = %d, want %d", len(got.cells), len(want.cells))
+	}
+	for i, cid := range want.cells {
+		if got.cells[i] != cid {
+			t.Fatalf("cells[%d] = %v, want %v", i, got.cells[i], cid)
+		}
+		gotCell := got.cellMap[cid]
+		wantCell := want.cellMap[cid]
+		if (gotCell == nil) != (wantCell == nil) {
+			t.Fatalf("cellMap[%v] nil mismatch: got %v, want %v", cid, gotCell, wantCell)
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Fatalf("cell %v len(shapes) = %d, want %d", cid, len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for j, wantClipped := range wantCell.shapes {
+			gotClipped := gotCell.shapes[j]
+			if gotClipped.shapeID != wantClipped.shapeID {
+				t.Errorf("cell %v clipped[%d].shapeID = %d, want %d", cid, j, gotClipped.shapeID, wantClipped.shapeID)
+			}
+			if gotClipped.containsCenter != wantClipped.containsCenter {
+				t.Errorf("cell %v clipped[%d].containsCenter = %v, want %v", cid, j, gotClipped.containsCenter, wantClipped.containsCenter)
+			}
+			if len(gotClipped.edges) != len(wantClipped.edges) {
+				t.Fatalf("cell %v clipped[%d] len(edges) = %d, want %d", cid, j, len(gotClipped.edges), len(wantClipped.edges))
+			}
+			for k, wantEdge := range wantClipped.edges {
+				if gotClipped.edges[k] != wantEdge {
+					t.Errorf("cell %v clipped[%d].edges[%d] = %d, want %d", cid, j, k, gotClipped.edges[k], wantEdge)
+				}
+			}
+		}
+	}
+}
