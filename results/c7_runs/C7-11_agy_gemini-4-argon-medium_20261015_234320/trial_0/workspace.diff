+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode empty index failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("empty ShapeIndex must encode to a non-empty byte stream")
+	}
+
+	var decoded ShapeIndex
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode empty index failed: %v", err)
+	}
+	assertShapeIndexesEqual(t, &decoded, index)
+	quadraticValidate(t, &decoded)
+	testIteratorMethods(t, &decoded)
+}
