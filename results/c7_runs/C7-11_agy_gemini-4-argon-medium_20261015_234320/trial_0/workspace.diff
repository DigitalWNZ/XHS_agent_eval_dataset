+func TestShapeIndexEncodeDecodeWithoutExplicitBuild(t *testing.T) {
+	index := NewShapeIndex()
+	pv := PointVector(parsePoints("0:0, 1:1, 2:2"))
+	index.Add(&pv)
+	index.Add(makePolyline("0:0, 0:5, 5:5"))
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0", true))
+
+	if index.IsFresh() {
+		t.Fatalf("index should not be fresh before Build or Encode")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := &ShapeIndex{}
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	// Verify that decoded index is already built and works without calling Build().
+	if !decoded.IsFresh() {
+		t.Errorf("decoded index must be fresh immediately after Decode")
+	}
+	if len(decoded.cells) == 0 {
+		t.Errorf("decoded index must have spatial cells populated without calling Build")
+	}
+	assertShapeIndexesEqual(t, decoded, index)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+
+	// Verify queries work directly on decoded without Build().
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(parsePoint("5:5")) {
+		t.Errorf("ContainsPointQuery should report 5:5 inside polygon")
+	}
+	if cpq.Contains(parsePoint("20:20")) {
+		t.Errorf("ContainsPointQuery should report 20:20 outside polygon")
+	}
+}
