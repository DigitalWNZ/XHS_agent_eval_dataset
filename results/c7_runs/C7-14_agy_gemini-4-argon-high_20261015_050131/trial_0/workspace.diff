+func assertShapeIndexRoundTrip(t *testing.T, orig *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode() failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("Encode() produced empty byte stream")
+	}
+
+	decoded := &ShapeIndex{}
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() failed: %v", err)
+	}
+
+	// Verify decoded index is fresh immediately without calling Build().
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded.IsFresh() = false, want true without calling Build()")
+	}
+	if decoded.Len() != orig.Len() {
+		t.Fatalf("decoded.Len() = %d, want %d", decoded.Len(), orig.Len())
+	}
+	if decoded.NumEdges() != orig.NumEdges() {
+		t.Fatalf("decoded.NumEdges() = %d, want %d", decoded.NumEdges(), orig.NumEdges())
+	}
+	if decoded.nextID != orig.nextID {
+		t.Fatalf("decoded.nextID = %d, want %d", decoded.nextID, orig.nextID)
+	}
+
+	for id := int32(0); id <= orig.nextID+1; id++ {
+		assertShapeEqual(t, id, decoded.Shape(id), orig.Shape(id))
+	}
+
+	// Verify full spatial cell structure directly without triggering Build().
+	if !reflect.DeepEqual(decoded.cells, orig.cells) {
+		t.Fatalf("decoded.cells = %v, want %v", decoded.cells, orig.cells)
+	}
+	if len(decoded.cellMap) != len(orig.cellMap) {
+		t.Fatalf("len(decoded.cellMap) = %d, want %d", len(decoded.cellMap), len(orig.cellMap))
+	}
+	for _, cellID := range orig.cells {
+		origCell := orig.cellMap[cellID]
+		gotCell := decoded.cellMap[cellID]
+		if gotCell == nil {
+			t.Fatalf("missing cell %v in decoded.cellMap", cellID)
+		}
+		if len(gotCell.shapes) != len(origCell.shapes) {
+			t.Fatalf("cell %v shapes len = %d, want %d", cellID, len(gotCell.shapes), len(origCell.shapes))
+		}
+		for i, wantClipped := range origCell.shapes {
+			gotClipped := gotCell.shapes[i]
+			if gotClipped.shapeID != wantClipped.shapeID ||
+				gotClipped.containsCenter != wantClipped.containsCenter ||
+				!reflect.DeepEqual(gotClipped.edges, wantClipped.edges) {
+				t.Fatalf("cell %v clipped[%d] = %+v, want %+v", cellID, i, gotClipped, wantClipped)
+			}
+			if found := gotCell.findByShapeID(wantClipped.shapeID); found != gotClipped {
+				t.Fatalf("cell %v findByShapeID(%d) = %v, want %v", cellID, wantClipped.shapeID, found, gotClipped)
+			}
+		}
+	}
+
+	// Iterate using NewShapeIndexIterator directly (does not call maybeApplyUpdates).
+	rawIt := NewShapeIndexIterator(decoded, IteratorBegin)
+	origIt := NewShapeIndexIterator(orig, IteratorBegin)
+	for !origIt.Done() {
+		if rawIt.Done() {
+			t.Fatalf("rawIt finished early at %v", origIt.CellID())
+		}
+		if rawIt.CellID() != origIt.CellID() {
+			t.Fatalf("rawIt.CellID() = %v, want %v", rawIt.CellID(), origIt.CellID())
+		}
+		rawIt.Next()
+		origIt.Next()
+	}
+	if !rawIt.Done() {
+		t.Fatalf("rawIt not Done after origIt finished")
+	}
+
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+	return decoded
+}
