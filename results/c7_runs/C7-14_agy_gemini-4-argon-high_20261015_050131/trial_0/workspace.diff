+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+	id3 := index.Add(s3)
+	id4 := index.Add(&pv4)
+
+	// Remove s1 and s3 BEFORE Build().
+	index.Remove(s1)
+	index.Remove(s3)
+
+	if index.IsFresh() {
+		t.Fatalf("expected index to be stale before Encode")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode unbuilt index failed: %v", err)
+	}
