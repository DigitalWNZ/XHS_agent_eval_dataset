+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded index should be fresh")
+	}
+	if decoded.Shape(id0) == nil || decoded.Shape(id2) == nil || decoded.Shape(id4) == nil {
+		t.Fatalf("expected shapes %d, %d, %d to be present", id0, id2, id4)
+	}
+	if decoded.Shape(id1) != nil || decoded.Shape(id3) != nil {
+		t.Fatalf("expected removed shapes %d, %d to be nil", id1, id3)
+	}
+
+	assertShapeEqual(t, id0, decoded.Shape(id0), s0)
+	assertShapeEqual(t, id2, decoded.Shape(id2), s2)
+	assertShapeEqual(t, id4, decoded.Shape(id4), &pv4)
+	quadraticValidate(t, decoded)
+
+	// Adding a new shape to decoded must continue from nextID (5).
+	s5 := makePolyline("5:5, 6:6")
+	if gotID := decoded.Add(s5); gotID != 5 {
