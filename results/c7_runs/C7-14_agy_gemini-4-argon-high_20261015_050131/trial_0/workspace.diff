+		}
+		if math.IsNaN(ed.V0.X) || math.IsInf(ed.V0.X, 0) || math.IsNaN(ed.V0.Y) || math.IsInf(ed.V0.Y, 0) || math.IsNaN(ed.V0.Z) || math.IsInf(ed.V0.Z, 0) ||
+			math.IsNaN(ed.V1.X) || math.IsInf(ed.V1.X, 0) || math.IsNaN(ed.V1.Y) || math.IsInf(ed.V1.Y, 0) || math.IsNaN(ed.V1.Z) || math.IsInf(ed.V1.Z, 0) {
