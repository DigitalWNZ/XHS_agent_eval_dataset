+	emptyLaxPL := LaxPolylineFromPoints(nil)
+	oneVertLaxPL := LaxPolylineFromPoints(parsePoints("6:6"))
+	emptyLoop := EmptyLoop()
+	emptyLaxLoop := LaxLoopFromPoints(nil)
+	emptyLaxPoly := LaxPolygonFromPoints(nil)
+
+	// Zero-edge full shapes (1 chain of length 0, Dimension 2, IsFull=true).
+	fullPoly := FullPolygon()
+	fullLoop := FullLoop()
+	fullLaxPoly := LaxPolygonFromPoints([][]Point{{}})
+
+	// Mixed chain counts:
+	// - 1-vertex LaxLoop (1 chain, 1 degenerate edge)
+	degLaxLoop := LaxLoopFromPoints(parsePoints("1:1"))
+	// - 4-point PointVector (4 chains of length 1)
+	multiPV := PointVector(parsePoints("0:0, 0:1, 1:0, 1:1"))
+	// - 3-loop LaxPolygon including a 1-vertex degenerate loop and a 2-vertex sibling pair loop
+	multiLaxPoly := LaxPolygonFromPoints([][]Point{
+		parsePoints("0:0, 0:5, 5:5, 5:0"),
+		parsePoints("2:2"),
+		parsePoints("3:3, 3:4"),
+	})
+
+	index.Add(emptyPoly)
+	index.Add(&emptyPV)
+	index.Add(&emptyPL)
+	index.Add(&oneVertPL)
+	index.Add(emptyLaxPL)
+	index.Add(oneVertLaxPL)
+	index.Add(emptyLoop)
+	index.Add(emptyLaxLoop)
+	index.Add(emptyLaxPoly)
+	index.Add(fullPoly)
+	index.Add(fullLoop)
+	index.Add(fullLaxPoly)
+	index.Add(degLaxLoop)
+	index.Add(&multiPV)
+	index.Add(multiLaxPoly)
+
+	decoded := assertShapeIndexRoundTrip(t, index)
+
+	// Verify ContainsPointQuery sees the full shapes at any point on the sphere.
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(PointFromCoords(1, 0, 0)) {
+		t.Errorf("expected ContainsPointQuery on index with full shapes to contain point")
+	}
+}
