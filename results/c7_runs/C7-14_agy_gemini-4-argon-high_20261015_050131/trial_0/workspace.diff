+type crcWriter struct {
+	w io.Writer
+	h hash.Hash32
+}
+
+func (cw *crcWriter) Write(p []byte) (int, error) {
+	_, _ = cw.h.Write(p)
+	return cw.w.Write(p)
+}
+
+type crcByteReader struct {
+	r byteReader
+	h hash.Hash32
+}
+
+func (cr *crcByteReader) Read(p []byte) (int, error) {
+	n, err := cr.r.Read(p)
+	if n > 0 {
+		_, _ = cr.h.Write(p[:n])
+	}
+	return n, err
+}
+
+func (cr *crcByteReader) ReadByte() (byte, error) {
+	b, err := cr.r.ReadByte()
+	if err == nil {
+		_, _ = cr.h.Write([]byte{b})
+	}
+	return b, err
+}
