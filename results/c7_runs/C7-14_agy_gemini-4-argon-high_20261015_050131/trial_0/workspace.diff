+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	// Build a non-trivial index with multiple shape types and cells.
+	index := NewShapeIndex()
+	pv := PointVector(parsePoints("0:0, 1:1"))
+	index.Add(&pv)
+	index.Add(makePolyline("0:0, 0:3, 3:3"))
+	index.Add(makePolygon("0:0, 0:5, 5:5, 5:0; 1:1, 1:2, 2:2, 2:1", false))
+	index.Add(LoopFromPoints(parsePoints("-5:-5, -5:-1, -1:-1, -1:-5")))
+	index.Add(LaxPolylineFromPoints(parsePoints("2:2, 2:4")))
+	index.Add(LaxLoopFromPoints(parsePoints("6:6, 6:8, 8:8")))
+	index.Add(LaxPolygonFromPoints([][]Point{parsePoints("10:10, 10:12, 12:12")}))
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// 1. Test every truncated prefix (0 .. len-1).
+	for n := 0; n < len(validBytes); n++ {
+		var dec ShapeIndex
+		if err := dec.Decode(bytes.NewReader(validBytes[:n])); err == nil {
+			t.Fatalf("Decode succeeded on truncated input of length %d/%d", n, len(validBytes))
+		}
+	}
+
+	// 2. Test single-byte corruption at every position in the stream.
+	for i := range validBytes {
+		corrupted := bytes.Clone(validBytes)
+		corrupted[i] ^= 0x55
+		var dec ShapeIndex
+		if err := dec.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("Decode succeeded on corrupted byte at offset %d/%d", i, len(validBytes))
+		}
+	}
+
+	// 3. Test crafted streams with oversized allocation requests and invalid fields.
+	makeStreamWithCRC := func(fn func(e *encoder)) []byte {
+		var b bytes.Buffer
+		cw := &crcWriter{w: &b, h: crc32.NewIEEE()}
+		e := &encoder{w: cw}
+		fn(e)
+		te := &encoder{w: &b}
+		te.writeUint32(cw.h.Sum32())
+		return b.Bytes()
+	}
+
+	malformedCases := []struct {
+		name string
+		data []byte
+	}{
+		{
+			name: "unsupported_version",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(99)
+			}),
+		},
+		{
+			name: "zero_maxEdgesPerCell",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(0)
+				e.writeUvarint(0)
+				e.writeUvarint(0)
+			}),
+		},
+		{
+			name: "huge_maxEdgesPerCell",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(1 << 40)
+				e.writeUvarint(0)
+				e.writeUvarint(0)
+			}),
+		},
+		{
+			name: "huge_nextID",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1 << 40)
+				e.writeUvarint(0)
+			}),
+		},
+		{
+			name: "numShapes_exceeds_nextID",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(5)
+			}),
+		},
+		{
+			name: "huge_numShapes_truncated",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(5000000)
+				e.writeUvarint(5000000)
+			}),
+		},
+		{
+			name: "unknown_shape_type_tag",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)   // shapeID 0
+				e.writeUvarint(123) // invalid typeTag
+			}),
+		},
+		{
+			name: "oversized_polyline_vertices",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPolyline))
+				e.writeInt8(encodingVersion)
+				e.writeUint32(0xffffffff)
+			}),
+		},
+		{
+			name: "large_polyline_vertices_truncated",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPolyline))
+				e.writeInt8(encodingVersion)
+				e.writeUint32(10000000) // < maxEncodedVertices but no vertex data
+			}),
+		},
+		{
+			name: "oversized_polygon_loops",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPolygon))
+				e.writeInt8(encodingVersion)
+				e.writeBool(true)
+				e.writeBool(false)
+				e.writeUint32(0xffffffff)
+			}),
+		},
+		{
+			name: "oversized_compressed_polygon_loops",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPolygon))
+				e.writeInt8(encodingCompressedVersion)
+				e.writeUint8(MaxLevel)
+				e.writeUvarint(1 << 63) // negative if cast to int!
+			}),
+		},
+		{
+			name: "oversized_laxpolygon_loops",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagLaxPolygon))
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(1 << 50)
+			}),
+		},
+		{
+			name: "nan_vertex_in_pointvector",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPointVector))
+				e.writeInt8(encodingVersion)
+				e.writeUint32(1)
+				e.writeFloat64(math.NaN())
+				e.writeFloat64(0)
+				e.writeFloat64(1)
+			}),
+		},
+		{
+			name: "huge_numCells",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(1 << 50)
+			}),
+		},
+		{
+			name: "invalid_cellID",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPointVector))
+				e.writeInt8(encodingVersion)
+				e.writeUint32(0)
+				e.writeUvarint(1) // 1 cell
+				e.writeUint64(0)  // invalid CellID(0)
+			}),
+		},
+		{
+			name: "clipped_shape_missing_shapeID",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(2) // nextID = 2
+				e.writeUvarint(1) // 1 shape (shapeID 0)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPointVector))
+				e.writeInt8(encodingVersion)
+				e.writeUint32(1)
+				e.writeFloat64(1)
+				e.writeFloat64(0)
+				e.writeFloat64(0)
+				e.writeUvarint(1) // 1 cell
+				e.writeUint64(uint64(CellIDFromFace(0)))
+				e.writeUvarint(1) // 1 clipped shape
+				e.writeUvarint(1) // references missing shapeID 1
+				e.writeBool(false)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+			}),
+		},
+		{
+			name: "clipped_shape_edgeID_out_of_range",
+			data: makeStreamWithCRC(func(e *encoder) {
+				e.writeInt8(encodingVersion)
+				e.writeUvarint(10)
+				e.writeUvarint(1)
+				e.writeUvarint(1)
+				e.writeUvarint(0)
+				e.writeUvarint(uint64(typeTagPointVector))
+				e.writeInt8(encodingVersion)
+				e.writeUint32(1)
+				e.writeFloat64(1)
+				e.writeFloat64(0)
+				e.writeFloat64(0)
+				e.writeUvarint(1) // 1 cell
+				e.writeUint64(uint64(CellIDFromFace(0)))
+				e.writeUvarint(1) // 1 clipped shape
+				e.writeUvarint(0) // shapeID 0 (1 edge)
+				e.writeBool(false)
+				e.writeUvarint(1)
+				e.writeUvarint(5) // edgeID 5 out of range!
+			}),
+		},
+	}
+
+	for _, tc := range malformedCases {
+		t.Run(tc.name, func(t *testing.T) {
+			var dec ShapeIndex
+			if err := dec.Decode(bytes.NewReader(tc.data)); err == nil {
+				t.Errorf("Decode(%s) succeeded, want error", tc.name)
+			}
+		})
+	}
