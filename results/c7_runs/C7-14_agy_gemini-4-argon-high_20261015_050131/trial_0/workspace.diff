+func encodeGenericShape(e *encoder, sh Shape) {
+	numEdges := sh.NumEdges()
+	numChains := sh.NumChains()
+	if numEdges > maxEncodedVertices || numChains > maxEncodedVertices {
+		e.err = fmt.Errorf("generic shape too large (edges=%d, chains=%d)", numEdges, numChains)
+		return
+	}
+	e.writeUint8(uint8(sh.Dimension()))
+	e.writeBool(sh.IsEmpty())
+	e.writeBool(sh.IsFull())
+	rp := sh.ReferencePoint()
+	isOrigin := rp.Point == OriginPoint()
+	e.writeBool(isOrigin)
+	e.writeBool(rp.Contained)
+	if !isOrigin {
+		e.writeFloat64(rp.Point.X)
+		e.writeFloat64(rp.Point.Y)
+		e.writeFloat64(rp.Point.Z)
+	}
+	e.writeUvarint(uint64(numEdges))
+	for i := range numEdges {
+		edge := sh.Edge(i)
+		e.writeFloat64(edge.V0.X)
+		e.writeFloat64(edge.V0.Y)
+		e.writeFloat64(edge.V0.Z)
+		e.writeFloat64(edge.V1.X)
+		e.writeFloat64(edge.V1.Y)
+		e.writeFloat64(edge.V1.Z)
+	}
+	e.writeUvarint(uint64(numChains))
+	for i := range numChains {
+		ch := sh.Chain(i)
+		e.writeUvarint(uint64(ch.Start))
+		e.writeUvarint(uint64(ch.Length))
+	}
