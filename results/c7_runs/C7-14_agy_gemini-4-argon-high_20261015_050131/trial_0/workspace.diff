+		p.decode(d)
+		return p
+	case typeTagLaxPolygon:
+		p := new(LaxPolygon)
+		p.decode(d)
+		return p
+	case typeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		return l
+	case typeTagLaxLoop:
+		l := new(LaxLoop)
+		l.decode(d)
+		return l
+	case typeTagGeneric:
+		return decodeGenericShape(d)
+	default:
+		d.err = fmt.Errorf("unsupported shape type tag: %d", tag)
+		return nil
+	}
+}
+
+// Encode encodes the ShapeIndex to w, building the index first if it has pending updates.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if s.shapes == nil {
+		s.shapes = make(map[int32]Shape)
+	}
+	if s.cellMap == nil {
+		s.cellMap = make(map[CellID]*ShapeIndexCell)
+	}
+	if s.maxEdgesPerCell == 0 {
+		s.maxEdgesPerCell = 10
+	}
+	s.Build()
+
+	cw := &crcWriter{w: w, h: crc32.NewIEEE()}
+	e := &encoder{w: cw}
+
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id, sh := range s.shapes {
+		if sh != nil {
+			shapeIDs = append(shapeIDs, id)
+		}
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUvarint(uint64(len(shapeIDs)))
+	for _, id := range shapeIDs {
+		e.writeUvarint(uint64(id))
+		encodeIndexShape(e, s.shapes[id])
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+
+	if e.err != nil {
+		return e.err
+	}
+	te := &encoder{w: w}
+	te.writeUint32(cw.h.Sum32())
+	return te.err
+}
+
+// Decode decodes the ShapeIndex from r, restoring both shapes and the full spatial cell structure.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	br := asByteReader(r)
+	cr := &crcByteReader{r: br, h: crc32.NewIEEE()}
+	d := &decoder{r: cr}
+
+	version := d.readInt8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != encodingVersion {
+		return fmt.Errorf("s2: cannot decode ShapeIndex version %d", version)
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	nextID := d.readUvarint()
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > 10000 {
+		return fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+	if nextID > maxEncodedShapes {
+		return fmt.Errorf("s2: nextID %d exceeds maximum %d", nextID, maxEncodedShapes)
+	}
+	if numShapes > nextID || numShapes > maxEncodedShapes {
+		return fmt.Errorf("s2: invalid shape count %d (nextID=%d)", numShapes, nextID)
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), 4096))
+	prevShapeID := int32(-1)
+	for range numShapes {
+		id := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if id >= nextID {
+			return fmt.Errorf("s2: shape ID %d out of range (nextID=%d)", id, nextID)
+		}
+		shapeID := int32(id)
+		if shapeID <= prevShapeID {
+			return fmt.Errorf("s2: shape IDs not strictly increasing (%d after %d)", shapeID, prevShapeID)
+		}
+		prevShapeID = shapeID
+
+		sh := decodeIndexShape(d)
+		if d.err != nil {
+			return d.err
+		}
+		if sh == nil {
+			return errors.New("s2: decoded nil shape")
+		}
+		shapes[shapeID] = sh
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("s2: too many cells (%d; max is %d)", numCells, maxEncodedCells)
+	}
+	if numCells > 0 && len(shapes) == 0 {
+		return errors.New("s2: non-empty cells in empty ShapeIndex")
+	}
+
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(int(numCells), 4096))
+	}
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), 4096))
+	var prevCellID CellID
+	for i := range numCells {
+		rawCellID := d.readUint64()
+		if d.err != nil {
+			return d.err
+		}
+		cellID := CellID(rawCellID)
+		if !cellID.IsValid() {
+			return fmt.Errorf("s2: invalid CellID %#x at cell %d", rawCellID, i)
+		}
+		if i > 0 && cellID.RangeMin() <= prevCellID.RangeMax() {
+			return fmt.Errorf("s2: cell IDs not strictly increasing and disjoint at cell %d", i)
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped == 0 || numClipped > uint64(len(shapes)) {
+			return fmt.Errorf("s2: invalid clipped shape count %d in cell %d", numClipped, i)
+		}
+
+		cell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, min(int(numClipped), 4096)),
+		}
+		prevClippedID := int32(-1)
+		for range numClipped {
+			cShapeIDVal := d.readUvarint()
+			containsCenter := d.readBool()
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if cShapeIDVal >= nextID {
+				return fmt.Errorf("s2: clipped shapeID %d out of range", cShapeIDVal)
+			}
+			cShapeID := int32(cShapeIDVal)
+			if cShapeID <= prevClippedID {
+				return fmt.Errorf("s2: clipped shapeIDs not strictly increasing (%d after %d)", cShapeID, prevClippedID)
+			}
+			prevClippedID = cShapeID
+
+			sh, ok := shapes[cShapeID]
+			if !ok || sh == nil {
+				return fmt.Errorf("s2: clipped shape references missing shapeID %d", cShapeID)
+			}
+			if containsCenter && sh.Dimension() != 2 {
+				return fmt.Errorf("s2: containsCenter set on shapeID %d with dimension %d", cShapeID, sh.Dimension())
+			}
+			maxShapeEdges := uint64(sh.NumEdges())
+			if numEdges > maxShapeEdges {
+				return fmt.Errorf("s2: clipped shape has %d edges, shape %d only has %d", numEdges, cShapeID, maxShapeEdges)
+			}
+			if !containsCenter && numEdges == 0 {
+				return fmt.Errorf("s2: empty clipped shape for shape %d in cell %d", cShapeID, i)
+			}
+
+			edges := make([]int, 0, min(int(numEdges), 4096))
+			prevEdgeID := -1
+			for range numEdges {
+				edgeIDVal := d.readUvarint()
+				if d.err != nil {
+					return d.err
+				}
+				if edgeIDVal >= maxShapeEdges {
+					return fmt.Errorf("s2: clipped edgeID %d out of range (max %d)", edgeIDVal, maxShapeEdges)
+				}
+				edgeID := int(edgeIDVal)
+				if edgeID <= prevEdgeID {
+					return fmt.Errorf("s2: clipped edgeIDs not strictly increasing (%d after %d)", edgeID, prevEdgeID)
+				}
+				prevEdgeID = edgeID
+				edges = append(edges, edgeID)
+			}
+
+			cell.shapes = append(cell.shapes, &clippedShape{
+				shapeID:        cShapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = cell
+	}
+
+	gotCRC := cr.h.Sum32()
+	td := &decoder{r: br}
+	wantCRC := td.readUint32()
+	if td.err != nil {
+		return td.err
+	}
+	if gotCRC != wantCRC {
+		return fmt.Errorf("s2: ShapeIndex checksum mismatch: got %#08x, want %#08x", gotCRC, wantCRC)
+	}
+
+	s.mu.Lock()
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.shapes = shapes
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+	return nil
+}
