+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	// 1. Nil receiver / writer / reader checks.
+	var nilIndex *ShapeIndex
+	var buf bytes.Buffer
+	if err := nilIndex.Encode(&buf); err == nil {
+		t.Errorf("nil ShapeIndex.Encode should return error")
+	}
+	if err := NewShapeIndex().Encode(nil); err == nil {
+		t.Errorf("ShapeIndex.Encode(nil) should return error")
+	}
+	if err := nilIndex.Decode(&buf); err == nil {
+		t.Errorf("nil ShapeIndex.Decode should return error")
+	}
+	if err := NewShapeIndex().Decode(nil); err == nil {
+		t.Errorf("ShapeIndex.Decode(nil) should return error")
+	}
+	if err := NewShapeIndex().Decode(bytes.NewReader(nil)); err == nil {
+		t.Errorf("ShapeIndex.Decode(empty) should return error")
+	}
+
+	// 2. Build a rich ShapeIndex containing all shape types and test every truncation
+	// and single-byte corruption offset.
+	rich := NewShapeIndex()
+	rich.Add(makePolygon("0:0, 0:4, 4:4, 4:0", true))
+	rich.Add(makePolyline("1:1, 2:3, 3:1"))
+	pv := PointVector(parsePoints("0:0, 2:2"))
+	rich.Add(&pv)
+	rich.Add(LaxPolylineFromPoints(parsePoints("5:5, 6:6")))
+	rich.Add(LaxPolygonFromPoints([][]Point{parsePoints("0:0, 0:2, 2:0"), parsePoints("5:5, 5:7, 7:5")}))
+	rich.Add(makeLoop("-2:-2, -2:-1, -1:-1, -1:-2"))
+	rich.Add(LaxLoopFromPoints(parsePoints("-4:-4, -4:-3, -3:-3")))
+	rich.Add(edgeVectorShapeFromPoints(parsePoint("8:8"), parsePoint("9:9")))
+
+	var richBuf bytes.Buffer
+	if err := rich.Encode(&richBuf); err != nil {
+		t.Fatalf("rich.Encode failed: %v", err)
+	}
+	encoded := richBuf.Bytes()
+
+	// Every truncated prefix must return an error without panicking.
+	for i := range len(encoded) {
+		idx := NewShapeIndex()
+		if err := idx.Decode(bytes.NewReader(encoded[:i])); err == nil {
+			t.Errorf("Decode of truncated input (len %d/%d) succeeded; want error", i, len(encoded))
+		}
+	}
+
+	// Flipping bits at any byte position must return an error without panicking.
+	for i := range len(encoded) {
+		corrupted := slices.Clone(encoded)
+		corrupted[i] ^= 0x55
+		idx := NewShapeIndex()
+		if err := idx.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Errorf("Decode of corrupted byte at index %d succeeded; want error", i)
+		}
+	}
+
+	// 3. Hand-crafted malformed payloads with valid CRC32 checksums to exercise
+	// every bounds, allocation, and structural validation path in Decode.
+	validPt := parsePoint("0:0")
+	validCell := CellIDFromFace(0)
+	childCell := validCell.Children()[0]
+
+	var malformedPayloads [][]byte
+
+	// Bad encoding version
+	malformedPayloads = append(malformedPayloads, []byte{99, 10, 0, 0, 0})
+
+	// Overflow uvarint for maxEdgesPerCell
+	malformedPayloads = append(malformedPayloads, []byte{byte(encodingVersion), 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x02})
+
+	// Zero maxEdgesPerCell
+	malformedPayloads = append(malformedPayloads, []byte{byte(encodingVersion), 0, 0, 0, 0})
+
+	// Oversized maxEdgesPerCell
+	{
+		b := []byte{byte(encodingVersion)}
+		b = appendUvarint(b, 1<<60)
+		b = appendUvarint(b, 0)
+		b = appendUvarint(b, 0)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Oversized nextID
+	{
+		b := []byte{byte(encodingVersion), 10}
+		b = appendUvarint(b, 1<<60)
+		b = appendUvarint(b, 0)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// numShapes > nextID
+	{
+		b := []byte{byte(encodingVersion), 10}
+		b = appendUvarint(b, 1) // nextID = 1
+		b = appendUvarint(b, 2) // numShapes = 2 > nextID
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Shape ID >= nextID
+	{
+		b := []byte{byte(encodingVersion), 10}
+		b = appendUvarint(b, 1) // nextID = 1
+		b = appendUvarint(b, 1) // numShapes = 1
+		b = appendUvarint(b, 1) // shapeID = 1 >= nextID
+		b = append(b, shapeWireTagPolyline, 0, 0)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Duplicate/unsorted shape IDs
+	{
+		b := []byte{byte(encodingVersion), 10}
+		b = appendUvarint(b, 3) // nextID = 3
+		b = appendUvarint(b, 2) // numShapes = 2
+		b = appendUvarint(b, 1) // shapeID = 1
+		b = append(b, shapeWireTagPolyline, 0, 0)
+		b = appendUvarint(b, 1) // duplicate shapeID = 1
+		b = append(b, shapeWireTagPolyline, 0, 0)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Unknown shape wire tag
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, 250, 0}
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Oversized point slice allocation request in Polyline
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolyline, 1}
+		b = appendUvarint(b, 1<<62)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Invalid bool byte in readPointSlice
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolyline, 2, 0, 0}
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Nil point slice with non-zero length
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolyline, 0, 1}
+		b = appendPointLE(b, validPt)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Non-finite point coordinate (NaN and +Inf)
+	for _, badFloat := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPointVector, 1, 1}
+		b = appendFloat64LE(b, badFloat)
+		b = appendFloat64LE(b, 0)
+		b = appendFloat64LE(b, 1)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Invalid Loop flags
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagLoop, 0xff}
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Invalid Polygon flags
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolygon, 0xff}
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Oversized Polygon nloops
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolygon, 1}
+		b = appendUvarint(b, 1<<60)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Oversized LaxPolygon numLoops
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagLaxPolygon}
+		b = appendUvarint(b, 1<<60)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Generic shape with invalid dimension (3)
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagGeneric, 3, 0}
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Generic shape with oversized edge count
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagGeneric, 1, 0}
+		b = appendPointLE(b, validPt)
+		b = appendUint32LE(b, 0)
+		b = appendUvarint(b, 1<<60)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Generic shape with 1 edge but 0 chains
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagGeneric, 1, 0}
+		b = appendPointLE(b, validPt)
+		b = appendUint32LE(b, 0)
+		b = appendUvarint(b, 1) // 1 edge
+		b = appendPointLE(b, validPt)
+		b = appendPointLE(b, validPt)
+		b = appendUvarint(b, 0) // 0 chains
+		b = appendUvarint(b, 0) // 0 cells
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Oversized numCells
+	{
+		b := []byte{byte(encodingVersion), 10, 0, 0}
+		b = appendUvarint(b, 1<<60)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Invalid CellID (0)
+	{
+		b := []byte{byte(encodingVersion), 10, 0, 0, 1}
+		b = appendUint64LE(b, 0) // invalid CellID
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Overlapping CellIDs (face cell followed by its child cell)
+	{
+		b := []byte{byte(encodingVersion), 10, 0, 0, 2}
+		b = appendUint64LE(b, uint64(validCell))
+		b = appendUvarint(b, 0)
+		b = appendUint64LE(b, uint64(childCell))
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Unsorted CellIDs (face 1 followed by face 0)
+	{
+		b := []byte{byte(encodingVersion), 10, 0, 0, 2}
+		b = appendUint64LE(b, uint64(CellIDFromFace(1)))
+		b = appendUvarint(b, 0)
+		b = appendUint64LE(b, uint64(CellIDFromFace(0)))
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Clipped shape referencing missing shapeID (nextID=2, shape 1 present, cell references shape 0)
+	{
+		b := []byte{byte(encodingVersion), 10, 2, 1, 1, shapeWireTagPolyline, 0, 0, 1}
+		b = appendUint64LE(b, uint64(validCell))
+		b = appendUvarint(b, 1) // 1 clipped shape
+		b = appendUvarint(b, 0) // shapeID 0 (missing)
+		b = append(b, 0)        // containsCenter = false
+		b = appendUvarint(b, 0) // 0 edges
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Clipped shape with containsCenter = true on a 1D Polyline shape
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolyline, 0, 0, 1}
+		b = appendUint64LE(b, uint64(validCell))
+		b = appendUvarint(b, 1) // 1 clipped shape
+		b = appendUvarint(b, 0) // shapeID 0
+		b = append(b, 1)        // containsCenter = true (invalid for 1D shape)
+		b = appendUvarint(b, 0) // 0 edges
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Clipped shape with edgeID out of range (shape has 0 edges, clipped claims 1 edge)
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPolyline, 0, 0, 1}
+		b = appendUint64LE(b, uint64(validCell))
+		b = appendUvarint(b, 1) // 1 clipped shape
+		b = appendUvarint(b, 0) // shapeID 0
+		b = append(b, 0)        // containsCenter = false
+		b = appendUvarint(b, 1) // 1 edge (exceeds shape's 0 edges)
+		b = appendUvarint(b, 0)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	// Clipped shape with duplicate/unsorted edge IDs
+	{
+		b := []byte{byte(encodingVersion), 10, 1, 1, 0, shapeWireTagPointVector, 1, 2}
+		b = appendPointLE(b, validPt)
+		b = appendPointLE(b, validPt)
+		b = appendUvarint(b, 1) // 1 cell
+		b = appendUint64LE(b, uint64(validCell))
+		b = appendUvarint(b, 1) // 1 clipped shape
+		b = appendUvarint(b, 0) // shapeID 0
+		b = append(b, 0)        // containsCenter = false
+		b = appendUvarint(b, 2) // 2 edges
+		b = appendUvarint(b, 1) // edgeID 1
+		b = appendUvarint(b, 0) // edgeID 0 (unsorted)
+		malformedPayloads = append(malformedPayloads, b)
+	}
+
+	for i, payload := range malformedPayloads {
+		stream := withShapeIndexCRC(payload)
+		idx := NewShapeIndex()
+		if err := idx.Decode(bytes.NewReader(stream)); err == nil {
+			t.Errorf("malformed payload #%d decoded without error; want error", i)
+		}
+	}
+
+	// Also verify that an failing Writer during Encode returns an error cleanly.
+	for limit := range len(encoded) {
+		fw := &failingWriter{limit: limit}
+		if err := rich.Encode(fw); err == nil {
+			t.Errorf("Encode to failingWriter(limit=%d) succeeded; want error", limit)
+		}
+	}
+}
+
+type failingWriter struct {
+	written int
+	limit   int
+}
+
+func (f *failingWriter) Write(p []byte) (int, error) {
+	if f.written+len(p) > f.limit {
+		n := max(0, f.limit-f.written)
+		f.written += n
+		return n, io.ErrShortWrite
+	}
+	f.written += len(p)
+	return len(p), nil
+}
