+	idLaxPolyline := index.Add(laxPolyline)
+	idLaxPolySingle := index.Add(laxPolySingle)
+	idLaxPolyMulti := index.Add(laxPolyMulti)
+	idLoop1 := index.Add(loop1)
+	idLoopHole := index.Add(loopHole)
+	idLaxLoop := index.Add(laxLoop)
+	idEV := index.Add(evShape)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("ShapeIndex.Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("ShapeIndex.Decode failed: %v", err)
+	}
+
+	// Check concrete types for all built-in shapes.
+	if _, ok := decoded.Shape(idPoly1).(*Polygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polygon", idPoly1, decoded.Shape(idPoly1))
+	}
+	if gotPoly, ok := decoded.Shape(idPolyHole).(*Polygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polygon", idPolyHole, decoded.Shape(idPolyHole))
+	} else {
+		if !gotPoly.ContainsPoint(parsePoint("22:22")) || gotPoly.ContainsPoint(parsePoint("30:30")) {
+			t.Errorf("decoded polygon with hole containment mismatch")
+		}
+	}
+	if _, ok := decoded.Shape(idManyLoops).(*Polygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polygon", idManyLoops, decoded.Shape(idManyLoops))
+	}
+	if _, ok := decoded.Shape(idPolyline).(*Polyline); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polyline", idPolyline, decoded.Shape(idPolyline))
+	}
+	if _, ok := decoded.Shape(idPV).(*PointVector); !ok {
+		t.Errorf("Shape(%d) type = %T, want *PointVector", idPV, decoded.Shape(idPV))
+	}
+	if _, ok := decoded.Shape(idLaxPolyline).(*LaxPolyline); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxPolyline", idLaxPolyline, decoded.Shape(idLaxPolyline))
+	}
+	if _, ok := decoded.Shape(idLaxPolySingle).(*LaxPolygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxPolygon", idLaxPolySingle, decoded.Shape(idLaxPolySingle))
+	}
+	if _, ok := decoded.Shape(idLaxPolyMulti).(*LaxPolygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxPolygon", idLaxPolyMulti, decoded.Shape(idLaxPolyMulti))
+	}
+	if _, ok := decoded.Shape(idLoop1).(*Loop); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Loop", idLoop1, decoded.Shape(idLoop1))
+	}
+	if gotLoop, ok := decoded.Shape(idLoopHole).(*Loop); !ok || gotLoop.depth != 1 {
+		t.Errorf("Shape(%d) = %T (depth %d), want *Loop with depth 1", idLoopHole, decoded.Shape(idLoopHole), gotLoop.depth)
+	}
+	if _, ok := decoded.Shape(idLaxLoop).(*LaxLoop); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxLoop", idLaxLoop, decoded.Shape(idLaxLoop))
+	}
+	if decoded.Shape(idEV) == nil {
+		t.Errorf("Shape(%d) should not be nil", idEV)
+	}
+
+	assertShapeIndexEqual(t, decoded, index, false)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+
+	// Verify queries work on decoded without calling Build().
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(parsePoint("5:5")) {
+		t.Errorf("ContainsPointQuery(5:5) = false, want true")
+	}
+	if !cpq.ShapeContains(decoded.Shape(idPoly1), parsePoint("5:5")) {
+		t.Errorf("ShapeContains(poly1, 5:5) = false, want true")
+	}
+	if cpq.ShapeContains(decoded.Shape(idPolyHole), parsePoint("30:30")) {
+		t.Errorf("ShapeContains(polyWithHole, 30:30) = true, want false (inside hole)")
+	}
+
+	ceq := NewClosestEdgeQuery(decoded, NewClosestEdgeQueryOptions())
+	target := NewMinDistanceToPointTarget(parsePoint("5:5"))
+	results := ceq.FindEdges(target)
+	if len(results) == 0 {
+		t.Errorf("FindEdges returned empty results on decoded index")
+	}
+
+	crossQ := NewCrossingEdgeQuery(decoded)
+	crossings := crossQ.CrossingsEdgeMap(parsePoint("-1:0.5"), parsePoint("3:0.5"), CrossingTypeAll)
+	if len(crossings) == 0 {
+		t.Errorf("CrossingsEdgeMap found no crossings on decoded index")
+	}
+}
