+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex, requireSameType bool) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded index IsFresh() = false, want true")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("got.Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("got.NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	if got.maxEdgesPerCell != want.maxEdgesPerCell {
+		t.Errorf("got.maxEdgesPerCell = %d, want %d", got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("got.nextID = %d, want %d", got.nextID, want.nextID)
+	}
+
+	for id := int32(0); id < want.nextID+2; id++ {
+		assertShapeEqual(t, id, got.Shape(id), want.Shape(id), requireSameType)
+	}
+
+	if !slices.Equal(got.cells, want.cells) {
+		t.Fatalf("got.cells = %v, want %v", got.cells, want.cells)
+	}
+	if len(got.cellMap) != len(want.cellMap) {
+		t.Fatalf("len(got.cellMap) = %d, want %d", len(got.cellMap), len(want.cellMap))
+	}
+	for _, cellID := range want.cells {
+		gCell := got.cellMap[cellID]
+		wCell := want.cellMap[cellID]
+		if gCell == nil || wCell == nil {
+			t.Fatalf("cellMap[%v]: got %v, want %v", cellID, gCell, wCell)
+		}
+		if len(gCell.shapes) != len(wCell.shapes) {
+			t.Fatalf("cell %v numClipped = %d, want %d", cellID, len(gCell.shapes), len(wCell.shapes))
+		}
+		for i := range wCell.shapes {
+			gc := gCell.shapes[i]
+			wc := wCell.shapes[i]
+			if gc.shapeID != wc.shapeID || gc.containsCenter != wc.containsCenter || !slices.Equal(gc.edges, wc.edges) {
+				t.Errorf("cell %v clipped[%d] = %+v, want %+v", cellID, i, gc, wc)
+			}
+			if got.Shape(gc.shapeID) == nil {
+				t.Errorf("cell %v references nil Shape(%d)", cellID, gc.shapeID)
+			}
+		}
+	}
+}
