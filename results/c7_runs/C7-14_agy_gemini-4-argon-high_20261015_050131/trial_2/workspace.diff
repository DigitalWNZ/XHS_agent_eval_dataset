+// genericShape is a fallback Shape implementation used to round-trip non-standard
+// Shape types (such as test-only Shape implementations) through ShapeIndex encoding.
+type genericShape struct {
+	dimension int
+	isEmpty   bool
+	isFull    bool
+	refPoint  ReferencePoint
+	tag       typeTag
+	edges     []Edge
+	chains    []Chain
+}
+
+var _ Shape = (*genericShape)(nil)
+
+func (g *genericShape) NumEdges() int                  { return len(g.edges) }
+func (g *genericShape) Edge(i int) Edge                { return g.edges[i] }
+func (g *genericShape) ReferencePoint() ReferencePoint { return g.refPoint }
+func (g *genericShape) NumChains() int                 { return len(g.chains) }
+func (g *genericShape) Chain(chainID int) Chain        { return g.chains[chainID] }
+func (g *genericShape) ChainEdge(chainID, offset int) Edge {
+	return g.edges[g.chains[chainID].Start+offset]
+}
+func (g *genericShape) ChainPosition(edgeID int) ChainPosition {
+	i := sort.Search(len(g.chains), func(c int) bool {
+		return g.chains[c].Start+g.chains[c].Length > edgeID
+	})
+	if i >= len(g.chains) {
+		return ChainPosition{ChainID: 0, Offset: edgeID}
+	}
+	return ChainPosition{ChainID: i, Offset: edgeID - g.chains[i].Start}
+}
+func (g *genericShape) Dimension() int    { return g.dimension }
+func (g *genericShape) IsEmpty() bool     { return g.isEmpty }
+func (g *genericShape) IsFull() bool      { return g.isFull }
+func (g *genericShape) typeTag() typeTag  { return g.tag }
+func (g *genericShape) privateInterface() {}
