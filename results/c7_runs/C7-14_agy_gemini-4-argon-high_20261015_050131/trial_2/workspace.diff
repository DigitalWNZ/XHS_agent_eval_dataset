+	id1 := index.Add(s1)
+	id2 := index.Add(s2)
+
+	// Remove s0 before Build().
+	index.Remove(s0)
+	index.Build()
+
+	// Add s3 and s4 after Build(), and remove s2 after Build().
+	id3 := index.Add(s3)
+	id4 := index.Add(s4)
+	index.Remove(s2)
