+// Encode encodes the ShapeIndex, including all shapes and the full spatial cell structure.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if s == nil {
+		return errors.New("s2: cannot encode nil ShapeIndex")
+	}
+	if w == nil {
+		return errors.New("s2: cannot encode ShapeIndex to nil writer")
+	}
+
+	s.mu.Lock()
+	if s.shapes == nil {
+		s.shapes = make(map[int32]Shape)
+	}
+	if s.cellMap == nil {
+		s.cellMap = make(map[CellID]*ShapeIndexCell)
+	}
+	if s.maxEdgesPerCell <= 0 {
+		s.maxEdgesPerCell = 10
+	}
+	s.mu.Unlock()
+
+	s.Build()
+
+	cw := &crcWriter{w: w, crc: crc32.NewIEEE()}
+	e := &encoder{w: cw}
+
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+
+	ids := make([]int32, 0, len(s.shapes))
+	maxID := int32(-1)
+	for id, shape := range s.shapes {
+		if shape == nil {
+			continue
+		}
+		if id < 0 {
+			return fmt.Errorf("s2: negative shape ID %d", id)
+		}
+		ids = append(ids, id)
+		if id > maxID {
+			maxID = id
+		}
+	}
+	slices.Sort(ids)
+
+	nextID := s.nextID
+	if maxID >= nextID {
+		nextID = maxID + 1
+	}
+	if nextID < 0 {
+		nextID = 0
+	}
+
+	e.writeUvarint(uint64(nextID))
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		e.writeUvarint(uint64(id))
+		encodeIndexShape(e, s.shapes[id])
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		var clippedShapes []*clippedShape
+		if cell != nil {
+			clippedShapes = cell.shapes
+		}
+		e.writeUvarint(uint64(len(clippedShapes)))
+		for _, clipped := range clippedShapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+
+	checksum := cw.crc.Sum32()
+	trailer := &encoder{w: w, err: e.err}
+	trailer.writeUint32(checksum)
+	return trailer.err
+}
+
+// Decode decodes the ShapeIndex from r, restoring all shapes with their original IDs
+// and the full spatial cell structure so the index is immediately ready for queries.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if s == nil {
+		return errors.New("s2: cannot decode into nil ShapeIndex")
+	}
+	if r == nil {
+		return errors.New("s2: cannot decode ShapeIndex from nil reader")
+	}
+
+	cr := &crcByteReader{r: asByteReader(r), crc: crc32.NewIEEE()}
+	d := &decoder{r: cr}
+
+	version := d.readInt8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != encodingVersion {
+		return fmt.Errorf("s2: unsupported ShapeIndex encoding version %d", version)
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdgesPerCell == 0 || maxEdgesPerCell > maxEncodedShapeIndexElements {
+		return fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdgesPerCell)
+	}
+
+	nextID := d.readUvarint()
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if nextID > maxEncodedShapeIndexElements {
+		return fmt.Errorf("s2: nextID %d exceeds maximum %d", nextID, maxEncodedShapeIndexElements)
+	}
+	if numShapes > nextID || numShapes > maxEncodedShapeIndexElements {
+		return fmt.Errorf("s2: invalid numShapes %d (nextID %d)", numShapes, nextID)
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), maxInitialShapeIndexAlloc))
+	prevShapeID := int32(-1)
+	for range int(numShapes) {
+		idU := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if idU >= nextID {
+			return fmt.Errorf("s2: shape ID %d out of range [0, %d)", idU, nextID)
+		}
+		id := int32(idU)
+		if id <= prevShapeID {
+			return fmt.Errorf("s2: non-increasing or duplicate shape ID %d (previous %d)", id, prevShapeID)
+		}
+		prevShapeID = id
+
+		shape := decodeIndexShape(d)
+		if d.err != nil {
+			return d.err
+		}
+		shapes[id] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedShapeIndexElements {
+		return fmt.Errorf("s2: too many cells (%d; max is %d)", numCells, maxEncodedShapeIndexElements)
+	}
+
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(int(numCells), maxInitialShapeIndexAlloc))
+	}
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), maxInitialShapeIndexAlloc))
+
+	for i := range int(numCells) {
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return d.err
+		}
+		if !cellID.IsValid() {
+			return fmt.Errorf("s2: invalid cell ID %v", cellID)
+		}
+		if i > 0 && cellID.RangeMin() <= cells[i-1].RangeMax() {
+			return fmt.Errorf("s2: unsorted or overlapping cell IDs (%v after %v)", cellID, cells[i-1])
+		}
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped > uint64(len(shapes)) {
+			return fmt.Errorf("s2: cell has %d clipped shapes, index only has %d shapes", numClipped, len(shapes))
+		}
+
+		cell := NewShapeIndexCell(int(numClipped))
+		prevClippedShapeID := int32(-1)
+		for j := range int(numClipped) {
+			shapeIDU := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			if shapeIDU >= nextID {
+				return fmt.Errorf("s2: clipped shape ID %d out of range [0, %d)", shapeIDU, nextID)
+			}
+			shapeID := int32(shapeIDU)
+			if shapeID <= prevClippedShapeID {
+				return fmt.Errorf("s2: unsorted or duplicate clipped shape ID %d", shapeID)
+			}
+			prevClippedShapeID = shapeID
+
+			shape := shapes[shapeID]
+			if shape == nil {
+				return fmt.Errorf("s2: clipped shape references missing shape ID %d", shapeID)
+			}
+
+			containsCenter := readStrictBool(d)
+			if d.err != nil {
+				return d.err
+			}
+			if containsCenter && shape.Dimension() != 2 {
+				return fmt.Errorf("s2: non-polygon shape %d cannot contain cell center", shapeID)
+			}
+
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return d.err
+			}
+			shapeNumEdges := uint64(shape.NumEdges())
+			if numEdges > shapeNumEdges {
+				return fmt.Errorf("s2: clipped shape has %d edges, shape %d only has %d", numEdges, shapeID, shapeNumEdges)
+			}
+
+			clipped := newClippedShape(shapeID, int(numEdges))
+			clipped.containsCenter = containsCenter
+			prevEdgeID := -1
+			for k := range int(numEdges) {
+				edgeIDU := d.readUvarint()
+				if d.err != nil {
+					return d.err
+				}
+				if edgeIDU >= shapeNumEdges {
+					return fmt.Errorf("s2: clipped edge ID %d out of range [0, %d)", edgeIDU, shapeNumEdges)
+				}
+				edgeID := int(edgeIDU)
+				if edgeID <= prevEdgeID {
+					return fmt.Errorf("s2: unsorted or duplicate edge ID %d in clipped shape", edgeID)
+				}
+				prevEdgeID = edgeID
+				clipped.edges[k] = edgeID
+			}
+			cell.shapes[j] = clipped
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = cell
+	}
+
+	wantCRC := cr.crc.Sum32()
+	gotCRC := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if gotCRC != wantCRC {
+		return fmt.Errorf("s2: ShapeIndex checksum mismatch: got %#x, want %#x", gotCRC, wantCRC)
+	}
+
+	s.mu.Lock()
+	s.shapes = shapes
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+
+	return nil
+}
+
+func readStrictBool(d *decoder) bool {
+	b := d.readUint8()
+	if d.err != nil {
+		return false
+	}
+	if b != 0 && b != 1 {
+		d.err = fmt.Errorf("s2: invalid bool byte %d", b)
+		return false
+	}
+	return b == 1
+}
+
+func writeRawPoint(e *encoder, p Point) {
+	e.writeFloat64(p.X)
+	e.writeFloat64(p.Y)
+	e.writeFloat64(p.Z)
+}
+
+func readRawPoint(d *decoder) Point {
+	x := d.readFloat64()
+	y := d.readFloat64()
+	z := d.readFloat64()
+	if d.err != nil {
+		return Point{}
+	}
+	if math.IsNaN(x) || math.IsInf(x, 0) ||
+		math.IsNaN(y) || math.IsInf(y, 0) ||
+		math.IsNaN(z) || math.IsInf(z, 0) {
+		d.err = errors.New("s2: non-finite point coordinate")
+		return Point{}
+	}
+	return Point{r3.Vector{X: x, Y: y, Z: z}}
+}
+
+func writeRawRect(e *encoder, r Rect) {
+	e.writeFloat64(r.Lat.Lo)
+	e.writeFloat64(r.Lat.Hi)
+	e.writeFloat64(r.Lng.Lo)
+	e.writeFloat64(r.Lng.Hi)
+}
+
+func readRawRect(d *decoder) Rect {
+	latLo := d.readFloat64()
+	latHi := d.readFloat64()
+	lngLo := d.readFloat64()
+	lngHi := d.readFloat64()
+	if d.err != nil {
+		return Rect{}
+	}
+	if math.IsNaN(latLo) || math.IsInf(latLo, 0) ||
+		math.IsNaN(latHi) || math.IsInf(latHi, 0) ||
+		math.IsNaN(lngLo) || math.IsInf(lngLo, 0) ||
+		math.IsNaN(lngHi) || math.IsInf(lngHi, 0) {
+		d.err = errors.New("s2: non-finite rect coordinate")
+		return Rect{}
+	}
+	return Rect{
+		Lat: r1.Interval{Lo: latLo, Hi: latHi},
+		Lng: s1.Interval{Lo: lngLo, Hi: lngHi},
+	}
+}
+
+func writePointSlice(e *encoder, pts []Point) {
+	e.writeBool(pts != nil)
+	e.writeUvarint(uint64(len(pts)))
+	for _, pt := range pts {
+		writeRawPoint(e, pt)
+	}
+}
+
+func readPointSlice(d *decoder) []Point {
+	nonNil := readStrictBool(d)
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedShapeIndexElements {
+		d.err = fmt.Errorf("s2: point count %d exceeds maximum %d", n, maxEncodedShapeIndexElements)
+		return nil
+	}
+	if !nonNil && n > 0 {
+		d.err = errors.New("s2: nil point slice cannot have non-zero length")
+		return nil
+	}
+	if n == 0 {
+		if nonNil {
+			return []Point{}
+		}
+		return nil
+	}
+	pts := make([]Point, 0, min(int(n), maxInitialShapeIndexAlloc))
+	for range int(n) {
+		pt := readRawPoint(d)
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, pt)
+	}
+	return pts
+}
+
+func encodeIndexLoop(e *encoder, l *Loop) {
+	var flags uint8
+	if l.originInside {
+		flags |= 1
+	}
+	if l.index != nil {
+		flags |= 2
+	}
+	e.writeUint8(flags)
+	e.writeInt32(int32(l.depth))
+	writePointSlice(e, l.vertices)
+	writeRawRect(e, l.bound)
+	writeRawRect(e, l.subregionBound)
+}
+
+func decodeIndexLoop(d *decoder) *Loop {
+	flags := d.readUint8()
+	if d.err != nil {
+		return nil
+	}
+	if flags&^0x03 != 0 {
+		d.err = fmt.Errorf("s2: invalid loop flags %#x", flags)
+		return nil
+	}
+	depth := int32(d.readUint32())
+	pts := readPointSlice(d)
+	bound := readRawRect(d)
+	subregionBound := readRawRect(d)
+	if d.err != nil {
+		return nil
+	}
+	l := &Loop{
+		vertices:       pts,
+		originInside:   (flags & 1) != 0,
+		depth:          int(depth),
+		bound:          bound,
+		subregionBound: subregionBound,
+	}
+	if (flags & 2) != 0 {
+		l.index = NewShapeIndex()
+		l.index.Add(l)
+	}
+	return l
+}
+
+func encodeIndexShape(e *encoder, shape Shape) {
+	switch s := shape.(type) {
+	case *Polygon:
+		e.writeUint8(shapeWireTagPolygon)
+		var flags uint8
+		if s.loops != nil {
+			flags |= 1
+		}
+		if s.index != nil {
+			flags |= 2
+		}
+		if s.hasHoles {
+			flags |= 4
+		}
+		e.writeUint8(flags)
+		e.writeUvarint(uint64(len(s.loops)))
+		e.writeUvarint(uint64(s.numVertices))
+		for _, l := range s.loops {
+			encodeIndexLoop(e, l)
+		}
+		writeRawRect(e, s.bound)
+		writeRawRect(e, s.subregionBound)
+
+	case *Polyline:
+		e.writeUint8(shapeWireTagPolyline)
+		writePointSlice(e, *s)
+
+	case *PointVector:
+		e.writeUint8(shapeWireTagPointVector)
+		writePointSlice(e, *s)
+
+	case *LaxPolyline:
+		e.writeUint8(shapeWireTagLaxPolyline)
+		writePointSlice(e, s.vertices)
+
+	case *LaxPolygon:
+		e.writeUint8(shapeWireTagLaxPolygon)
+		e.writeUvarint(uint64(s.numLoops))
+		if s.numLoops == 1 {
+			writePointSlice(e, s.vertices)
+		} else if s.numLoops > 1 {
+			for i := range s.numLoops {
+				n := s.numLoopVertices(i)
+				start := s.cumulativeVertices[i]
+				writePointSlice(e, s.vertices[start:start+n])
+			}
+		}
+
+	case *Loop:
+		e.writeUint8(shapeWireTagLoop)
+		encodeIndexLoop(e, s)
+
+	case *LaxLoop:
+		e.writeUint8(shapeWireTagLaxLoop)
+		writePointSlice(e, s.vertices)
+
+	default:
+		e.writeUint8(shapeWireTagGeneric)
+		e.writeUint8(uint8(shape.Dimension()))
+		var flags uint8
+		if shape.IsEmpty() {
+			flags |= 1
+		}
+		if shape.IsFull() {
+			flags |= 2
+		}
+		ref := shape.ReferencePoint()
+		if ref.Contained {
+			flags |= 4
+		}
+		e.writeUint8(flags)
+		writeRawPoint(e, ref.Point)
+		e.writeUint32(uint32(shape.typeTag()))
+		numEdges := shape.NumEdges()
+		e.writeUvarint(uint64(numEdges))
+		for i := range numEdges {
+			edge := shape.Edge(i)
+			writeRawPoint(e, edge.V0)
+			writeRawPoint(e, edge.V1)
+		}
+		numChains := shape.NumChains()
+		e.writeUvarint(uint64(numChains))
+		for i := range numChains {
+			chain := shape.Chain(i)
+			e.writeUvarint(uint64(chain.Start))
+			e.writeUvarint(uint64(chain.Length))
+		}
+	}
+}
+
+func decodeIndexShape(d *decoder) Shape {
+	tag := d.readUint8()
+	if d.err != nil {
+		return nil
+	}
+
+	switch tag {
+	case shapeWireTagPolygon:
+		flags := d.readUint8()
+		if d.err != nil {
+			return nil
+		}
+		if flags&^0x07 != 0 {
+			d.err = fmt.Errorf("s2: invalid polygon flags %#x", flags)
+			return nil
+		}
+		nloops := d.readUvarint()
+		numVertices := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if nloops > maxEncodedShapeIndexElements || numVertices > maxEncodedShapeIndexElements {
+			d.err = fmt.Errorf("s2: polygon loop/vertex count (%d/%d) exceeds maximum", nloops, numVertices)
+			return nil
+		}
+		if flags&1 == 0 && nloops > 0 {
+			d.err = errors.New("s2: nil polygon loops with non-zero loop count")
+			return nil
+		}
+		p := &Polygon{
+			hasHoles: (flags & 4) != 0,
+		}
+		totalVertices := uint64(0)
+		if nloops > 0 {
+			p.loops = make([]*Loop, 0, min(int(nloops), maxInitialShapeIndexAlloc))
+			for range int(nloops) {
+				l := decodeIndexLoop(d)
+				if d.err != nil {
+					return nil
+				}
+				if len(l.vertices) == 0 {
+					d.err = errors.New("s2: polygon loop has zero vertices")
+					return nil
+				}
+				totalVertices += uint64(len(l.vertices))
+				if totalVertices > maxEncodedShapeIndexElements {
+					d.err = fmt.Errorf("s2: polygon total vertices %d exceeds maximum %d", totalVertices, maxEncodedShapeIndexElements)
+					return nil
+				}
+				p.loops = append(p.loops, l)
+			}
+		} else if flags&1 != 0 {
+			p.loops = []*Loop{}
+		}
+		if totalVertices != numVertices {
+			d.err = fmt.Errorf("s2: polygon vertex count mismatch: header %d, loops %d", numVertices, totalVertices)
+			return nil
+		}
+		p.bound = readRawRect(d)
+		p.subregionBound = readRawRect(d)
+		if d.err != nil {
+			return nil
+		}
+		p.initEdgesAndIndex()
+		p.numVertices = int(numVertices)
+		if flags&2 == 0 {
+			p.index = nil
+		}
+		return p
+
+	case shapeWireTagPolyline:
+		pts := Polyline(readPointSlice(d))
+		if d.err != nil {
+			return nil
+		}
+		return &pts
+
+	case shapeWireTagPointVector:
+		pts := PointVector(readPointSlice(d))
+		if d.err != nil {
+			return nil
+		}
+		return &pts
+
+	case shapeWireTagLaxPolyline:
+		pts := readPointSlice(d)
+		if d.err != nil {
+			return nil
+		}
+		return &LaxPolyline{vertices: pts}
+
+	case shapeWireTagLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numLoops > maxEncodedShapeIndexElements {
+			d.err = fmt.Errorf("s2: lax polygon loop count %d exceeds maximum %d", numLoops, maxEncodedShapeIndexElements)
+			return nil
+		}
+		switch numLoops {
+		case 0:
+			return &LaxPolygon{}
+		case 1:
+			pts := readPointSlice(d)
+			if d.err != nil {
+				return nil
+			}
+			return &LaxPolygon{
+				numLoops: 1,
+				numVerts: len(pts),
+				vertices: pts,
+			}
+		default:
+			loops := make([][]Point, 0, min(int(numLoops), maxInitialShapeIndexAlloc))
+			totalVerts := 0
+			for range int(numLoops) {
+				pts := readPointSlice(d)
+				if d.err != nil {
+					return nil
+				}
+				totalVerts += len(pts)
+				if totalVerts > maxEncodedShapeIndexElements {
+					d.err = fmt.Errorf("s2: lax polygon total vertices %d exceeds maximum %d", totalVerts, maxEncodedShapeIndexElements)
+					return nil
+				}
+				loops = append(loops, pts)
+			}
+			return LaxPolygonFromPoints(loops)
+		}
+
+	case shapeWireTagLoop:
+		l := decodeIndexLoop(d)
+		if d.err != nil {
+			return nil
+		}
+		return l
+
+	case shapeWireTagLaxLoop:
+		pts := readPointSlice(d)
+		if d.err != nil {
+			return nil
+		}
+		return &LaxLoop{
+			numVertices: len(pts),
+			vertices:    pts,
+		}
+
+	case shapeWireTagGeneric:
+		dim := d.readUint8()
+		flags := d.readUint8()
+		if d.err != nil {
+			return nil
+		}
+		if dim > 2 {
+			d.err = fmt.Errorf("s2: invalid shape dimension %d", dim)
+			return nil
+		}
+		if flags&^0x07 != 0 {
+			d.err = fmt.Errorf("s2: invalid generic shape flags %#x", flags)
+			return nil
+		}
+		refPt := readRawPoint(d)
+		typeTagVal := typeTag(d.readUint32())
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > maxEncodedShapeIndexElements {
+			d.err = fmt.Errorf("s2: generic shape edge count %d exceeds maximum %d", numEdges, maxEncodedShapeIndexElements)
+			return nil
+		}
+		var edges []Edge
+		if numEdges > 0 {
+			edges = make([]Edge, 0, min(int(numEdges), maxInitialShapeIndexAlloc))
+			for range int(numEdges) {
+				v0 := readRawPoint(d)
+				v1 := readRawPoint(d)
+				if d.err != nil {
+					return nil
+				}
+				edges = append(edges, Edge{V0: v0, V1: v1})
+			}
+		}
+		numChains := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numChains > maxEncodedShapeIndexElements {
+			d.err = fmt.Errorf("s2: generic shape chain count %d exceeds maximum %d", numChains, maxEncodedShapeIndexElements)
+			return nil
+		}
+		var chains []Chain
+		if numChains > 0 {
+			chains = make([]Chain, 0, min(int(numChains), maxInitialShapeIndexAlloc))
+			expectedStart := uint64(0)
+			for range int(numChains) {
+				start := d.readUvarint()
+				length := d.readUvarint()
+				if d.err != nil {
+					return nil
+				}
+				if start != expectedStart || length > numEdges-start {
+					d.err = fmt.Errorf("s2: invalid generic shape chain (%d, %d) for %d edges", start, length, numEdges)
+					return nil
+				}
+				expectedStart = start + length
+				chains = append(chains, Chain{Start: int(start), Length: int(length)})
+			}
+			if expectedStart != numEdges {
+				d.err = fmt.Errorf("s2: generic shape chains cover %d edges, want %d", expectedStart, numEdges)
+				return nil
+			}
+		} else if numEdges > 0 {
+			d.err = fmt.Errorf("s2: generic shape has %d edges but 0 chains", numEdges)
+			return nil
+		}
+		return &genericShape{
+			dimension: int(dim),
+			isEmpty:   (flags & 1) != 0,
+			isFull:    (flags & 2) != 0,
+			refPoint:  ReferencePoint{Point: refPt, Contained: (flags & 4) != 0},
+			tag:       typeTagVal,
+			edges:     edges,
+			chains:    chains,
+		}
+
+	default:
+		d.err = fmt.Errorf("s2: unknown shape type tag %d", tag)
+		return nil
+	}
+}
