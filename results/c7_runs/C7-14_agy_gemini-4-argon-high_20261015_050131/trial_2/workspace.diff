+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	index := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("empty ShapeIndex.Encode failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("empty ShapeIndex encoded to 0 bytes; want non-empty byte stream")
+	}
+
+	// Decode into a new ShapeIndex.
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("empty ShapeIndex.Decode failed: %v", err)
+	}
+	assertShapeIndexEqual(t, decoded, index, true)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+
+	// Decode into a zero-value ShapeIndex and into a pre-populated ShapeIndex.
+	var zeroIdx ShapeIndex
+	if err := zeroIdx.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("zero ShapeIndex.Decode failed: %v", err)
+	}
+	assertShapeIndexEqual(t, &zeroIdx, index, true)
+
+	populated := makeShapeIndex("0:0 | 1:1 # 0:0, 0:2 # 0:0, 0:1, 1:0")
+	populated.Build()
+	if err := populated.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("populated ShapeIndex.Decode failed: %v", err)
+	}
+	assertShapeIndexEqual(t, populated, index, true)
+
+	// Also verify zero-value ShapeIndex can Encode directly.
+	var zeroEncode ShapeIndex
+	var buf2 bytes.Buffer
+	if err := zeroEncode.Encode(&buf2); err != nil {
+		t.Fatalf("zero ShapeIndex.Encode failed: %v", err)
+	}
+	if buf2.Len() == 0 {
+		t.Fatalf("zero ShapeIndex encoded to 0 bytes; want non-empty byte stream")
+	}
