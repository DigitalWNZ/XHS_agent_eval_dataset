+// Wire tags for encoding built-in and custom Shape types inside a ShapeIndex.
+const (
+	shapeWireTagPolygon     uint8 = 1
+	shapeWireTagPolyline    uint8 = 2
+	shapeWireTagPointVector uint8 = 3
+	shapeWireTagLaxPolyline uint8 = 4
+	shapeWireTagLaxPolygon  uint8 = 5
+	shapeWireTagLoop        uint8 = 6
