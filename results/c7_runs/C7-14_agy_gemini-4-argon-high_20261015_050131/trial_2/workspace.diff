+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if decoded.Shape(id0) != nil {
+		t.Errorf("removed Shape(%d) should be nil, got %v", id0, decoded.Shape(id0))
+	}
+	if decoded.Shape(id2) != nil {
+		t.Errorf("removed Shape(%d) should be nil, got %v", id2, decoded.Shape(id2))
+	}
+	if decoded.Shape(id1) == nil || decoded.Shape(id3) == nil || decoded.Shape(id4) == nil {
+		t.Fatalf("surviving shapes (%d, %d, %d) must be non-nil", id1, id3, id4)
+	}
+
+	assertShapeIndexEqual(t, decoded, index, true)
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+
+	// Verify adding a new shape after Decode gets the next fresh ID (5) without colliding.
+	s5 := makePolyline("50:50, 51:51")
+	id5 := decoded.Add(s5)
+	if id5 != id4+1 {
+		t.Errorf("decoded.Add assigned ID %d, want %d", id5, id4+1)
+	}
+	quadraticValidate(t, decoded)
+
+	// Also test an index where only 1 shape survives with a non-zero shape ID (e.g., ID 1),
+	// which exercises single-shape optimizations in CrossingEdgeQuery.
+	singleIdx := NewShapeIndex()
+	r0 := makePolyline("0:0, 0:2")
+	r1 := makePolyline("0:0, 2:2, 0:4")
+	singleIdx.Add(r0)
+	survivingID := singleIdx.Add(r1)
+	singleIdx.Remove(r0)
+
+	var singleBuf bytes.Buffer
+	if err := singleIdx.Encode(&singleBuf); err != nil {
+		t.Fatalf("singleIdx.Encode failed: %v", err)
+	}
+	singleDecoded := NewShapeIndex()
+	if err := singleDecoded.Decode(bytes.NewReader(singleBuf.Bytes())); err != nil {
+		t.Fatalf("singleDecoded.Decode failed: %v", err)
+	}
+	assertShapeIndexEqual(t, singleDecoded, singleIdx, true)
+	if singleDecoded.Shape(0) != nil || singleDecoded.Shape(survivingID) == nil {
+		t.Fatalf("singleDecoded shape IDs not preserved: Shape(0)=%v, Shape(%d)=%v", singleDecoded.Shape(0), survivingID, singleDecoded.Shape(survivingID))
+	}
+	crossQ := NewCrossingEdgeQuery(singleDecoded)
+	edges := crossQ.CrossingsEdgeMap(parsePoint("1:0"), parsePoint("1:3"), CrossingTypeAll)
+	if len(edges) == 0 {
+		t.Errorf("expected crossing edges for single surviving shape with ID %d", survivingID)
+	}
+}
