+func TestShapeIndexEncodeDecodeShapeIDsSurviveRemoval(t *testing.T) {
+	// Test both pre-Build and post-Build shape removals so shape IDs are non-contiguous.
+	index := NewShapeIndex()
+	s0 := makePolyline("0:0, 0:5")
+	s1 := makePolygon("10:10, 10:20, 20:20, 20:10", true)
+	s2 := makePolyline("30:30, 30:35")
