+
+	// 6. *Loop
+	loop := makeLoop("-10:-10, -10:-5, -5:-5, -5:-10")
+	idLoop := index.Add(loop)
+
+	// 7. *LaxLoop
+	laxLoop := LaxLoopFromPoints( parsePoints("-20:-20, -20:-15, -15:-15") )
+	idLaxLoop := index.Add(laxLoop)
+
+	// 8. *edgeVectorShape
+	ev := edgeVectorShapeFromPoints(parsePoint("30:30"), parsePoint("32:35"))
+	ev.Add(parsePoint("32:35"), parsePoint("35:30"))
+	idEV := index.Add(ev)
+
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	var decoded ShapeIndex
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	assertShapeIndexEqual(t, &decoded, index, true)
+	quadraticValidate(t, &decoded)
+	testIteratorMethods(t, &decoded)
+
+	// Verify specific shape IDs and types survived
+	if _, ok := decoded.Shape(idPoly).(*Polygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polygon", idPoly, decoded.Shape(idPoly))
+	}
+	if _, ok := decoded.Shape(idPline).(*Polyline); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polyline", idPline, decoded.Shape(idPline))
+	}
+	if _, ok := decoded.Shape(idPts).(*PointVector); !ok {
+		t.Errorf("Shape(%d) type = %T, want *PointVector", idPts, decoded.Shape(idPts))
+	}
+	if _, ok := decoded.Shape(idLaxPline).(*LaxPolyline); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxPolyline", idLaxPline, decoded.Shape(idLaxPline))
+	}
+	if _, ok := decoded.Shape(idLaxPoly).(*LaxPolygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxPolygon", idLaxPoly, decoded.Shape(idLaxPoly))
+	}
+	if _, ok := decoded.Shape(idLoop).(*Loop); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Loop", idLoop, decoded.Shape(idLoop))
+	}
+	if _, ok := decoded.Shape(idLaxLoop).(*LaxLoop); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxLoop", idLaxLoop, decoded.Shape(idLaxLoop))
+	}
+	if _, ok := decoded.Shape(idEV).(*edgeVectorShape); !ok {
+		t.Errorf("Shape(%d) type = %T, want *edgeVectorShape", idEV, decoded.Shape(idEV))
+	}
+
+	// Verify queries work directly on decoded without calling Build()
+	cpq := NewContainsPointQuery(&decoded, VertexModelSemiOpen)
+	insideShell := parsePoint("1:1")
+	insideHole := parsePoint("3:3")
