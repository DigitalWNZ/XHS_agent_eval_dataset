+func assertShapeIndexEqual(t *testing.T, got, want *ShapeIndex, checkConcreteType bool) {
+	t.Helper()
+	if !got.IsFresh() {
+		t.Errorf("decoded ShapeIndex IsFresh() = false, want true without Build()")
+	}
+	if got.Len() != want.Len() {
+		t.Fatalf("Len() = %d, want %d", got.Len(), want.Len())
+	}
+	if got.nextID != want.nextID {
+		t.Fatalf("nextID = %d, want %d", got.nextID, want.nextID)
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	for id := int32(0); id < want.nextID+2; id++ {
+		assertShapesEqual(t, id, got.Shape(id), want.Shape(id), checkConcreteType)
+	}
+	if len(got.cells) != len(want.cells) {
+		t.Fatalf("len(cells) = %d, want %d", len(got.cells), len(want.cells))
+	}
+	for i, cellID := range want.cells {
+		if got.cells[i] != cellID {
+			t.Fatalf("cells[%d] = %v, want %v", i, got.cells[i], cellID)
+		}
+		gotCell := got.cellMap[cellID]
+		wantCell := want.cellMap[cellID]
+		if (gotCell == nil) != (wantCell == nil) {
+			t.Fatalf("cellMap[%v] nil=%v, want nil=%v", cellID, gotCell == nil, wantCell == nil)
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Fatalf("cell %v: len(shapes) = %d, want %d", cellID, len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for j, wc := range wantCell.shapes {
+			gc := gotCell.shapes[j]
+			if gc.shapeID != wc.shapeID {
+				t.Errorf("cell %v clipped[%d].shapeID = %d, want %d", cellID, j, gc.shapeID, wc.shapeID)
+			}
+			if gc.containsCenter != wc.containsCenter {
+				t.Errorf("cell %v clipped[%d].containsCenter = %v, want %v", cellID, j, gc.containsCenter, wc.containsCenter)
+			}
+			if !reflect.DeepEqual(gc.edges, wc.edges) {
+				t.Errorf("cell %v clipped[%d].edges = %v, want %v", cellID, j, gc.edges, wc.edges)
+			}
+		}
+	}
+}
