+func assertShapesEqual(t *testing.T, id int32, got, want Shape, checkConcreteType bool) {
+	t.Helper()
+	if (got == nil) != (want == nil) {
+		t.Fatalf("shape %d: got nil=%v, want nil=%v", id, got == nil, want == nil)
+	}
+	if want == nil {
+		return
+	}
+	if checkConcreteType && reflect.TypeOf(got) != reflect.TypeOf(want) {
+		t.Errorf("shape %d: concrete type = %T, want %T", id, got, want)
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("shape %d: Dimension() = %d, want %d", id, got.Dimension(), want.Dimension())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("shape %d: IsEmpty() = %v, want %v", id, got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("shape %d: IsFull() = %v, want %v", id, got.IsFull(), want.IsFull())
+	}
+	if got.typeTag() != want.typeTag() {
+		t.Errorf("shape %d: typeTag() = %v, want %v", id, got.typeTag(), want.typeTag())
+	}
+	gotRef := got.ReferencePoint()
+	wantRef := want.ReferencePoint()
+	if gotRef.Contained != wantRef.Contained || !gotRef.Point.ApproxEqual(wantRef.Point) {
+		t.Errorf("shape %d: ReferencePoint() = %+v, want %+v", id, gotRef, wantRef)
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("shape %d: NumEdges() = %d, want %d", id, got.NumEdges(), want.NumEdges())
+	}
+	for e := 0; e < want.NumEdges(); e++ {
+		ge := got.Edge(e)
+		we := want.Edge(e)
+		if !ge.V0.ApproxEqual(we.V0) || !ge.V1.ApproxEqual(we.V1) {
+			t.Errorf("shape %d edge %d: got %+v, want %+v", id, e, ge, we)
+		}
+		gp := got.ChainPosition(e)
+		wp := want.ChainPosition(e)
+		if gp != wp {
+			t.Errorf("shape %d ChainPosition(%d) = %+v, want %+v", id, e, gp, wp)
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("shape %d: NumChains() = %d, want %d", id, got.NumChains(), want.NumChains())
+	}
+	for c := 0; c < want.NumChains(); c++ {
+		gc := got.Chain(c)
+		wc := want.Chain(c)
+		if gc != wc {
+			t.Fatalf("shape %d Chain(%d) = %+v, want %+v", id, c, gc, wc)
+		}
+		for offset := 0; offset < wc.Length; offset++ {
+			gce := got.ChainEdge(c, offset)
+			wce := want.ChainEdge(c, offset)
+			if !gce.V0.ApproxEqual(wce.V0) || !gce.V1.ApproxEqual(wce.V1) {
+				t.Errorf("shape %d ChainEdge(%d, %d) = %+v, want %+v", id, c, offset, gce, wce)
+			}
+		}
+	}
+}
