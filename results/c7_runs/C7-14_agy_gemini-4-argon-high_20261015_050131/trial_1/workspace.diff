+func TestShapeIndexMalformedInputs(t *testing.T) {
+	// Build a non-trivial index with all shape types.
+	index := NewShapeIndex()
+	index.Add(makePolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:4, 4:4, 4:2", true))
+	index.Add(makePolyline("0:0, 5:5, 10:0"))
+	pv := PointVector(parsePoints("1:1, 2:2, 3:3"))
+	index.Add(&pv)
+	index.Add(makeLaxPolyline("3:3, 6:6"))
+	index.Add(makeLaxPolygon("5:5, 5:8, 8:8, 8:5"))
+	index.Add(makeLoop("-5:-5, -5:-1, -1:-1, -1:-5"))
+	index.Add(LaxLoopFromPoints(parsePoints("-8:-8, -8:-6, -6:-6")))
+	index.Add(edgeVectorShapeFromPoints(parsePoint("1:2"), parsePoint("3:4")))
+
+	var validBuf bytes.Buffer
+	if err := index.Encode(&validBuf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := validBuf.Bytes()
+
+	t.Run("NilAndEmpty", func(t *testing.T) {
+		idx := NewShapeIndex()
+		if err := idx.Encode(nil); err == nil {
+			t.Errorf("expected error for Encode(nil)")
+		}
+		if err := idx.Decode(nil); err == nil {
+			t.Errorf("expected error for Decode(nil)")
+		}
+		if err := idx.Decode(bytes.NewReader(nil)); err == nil {
+			t.Errorf("expected error for empty reader")
+		}
+	})
+
+	t.Run("TruncatedAtEveryByte", func(t *testing.T) {
+		for cut := 0; cut < len(validBytes); cut++ {
+			idx := NewShapeIndex()
+			err := idx.Decode(bytes.NewReader(validBytes[:cut]))
+			if err == nil {
+				t.Fatalf("expected error for truncated stream of length %d/%d", cut, len(validBytes))
+			}
+		}
+	})
+
+	t.Run("CorruptedSingleByteFlip", func(t *testing.T) {
+		for pos := 0; pos < len(validBytes); pos++ {
+			corrupted := bytes.Clone(validBytes)
+			corrupted[pos] ^= 0x55
+			idx := NewShapeIndex()
+			if err := idx.Decode(bytes.NewReader(corrupted)); err == nil {
+				t.Fatalf("expected error when byte %d/%d is corrupted", pos, len(validBytes))
+			}
+		}
+	})
+
+	t.Run("OversizedAllocationsAndInvalidFields", func(t *testing.T) {
+		makeWithCRC := func(payload []byte) []byte {
+			out := bytes.Clone(payload)
+			var tail [4]byte
+			binary.LittleEndian.PutUint32(tail[:], crc32.ChecksumIEEE(payload))
+			return append(out, tail[:]...)
+		}
+
+		var cases [][]byte
+
+		// 1. Unsupported version
+		badVersion := bytes.Clone(validBytes)
+		badVersion[0] = 99
+		cases = append(cases, badVersion)
+
+		// 2. Zero maxEdgesPerCell
+		{
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(0) // invalid maxEdgesPerCell
+			e.writeUint32(0)
+			e.writeUint32(0)
+			e.writeUint32(0)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 3. Oversized numShapes (0xffffffff)
+		{
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(0xffffffff)
+			e.writeUint32(0xffffffff)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 4. numShapes > nextID
+		{
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1) // nextID
+			e.writeUint32(2) // numShapes > nextID
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 5. Oversized PointVector count (both > maxEncodedVertices and large truncated count <= maxEncodedVertices)
+		for _, count := range []uint32{0xffffffff, maxEncodedVertices + 1, maxEncodedVertices - 1} {
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1)
+			e.writeUint32(1)
+			e.writeUint32(0) // shapeID 0
+			e.writeUint8(uint8(shapeKindPointVector))
+			e.writeUint32(count)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 6. Oversized Polyline vertex count
+		for _, count := range []uint32{0xffffffff, maxEncodedVertices - 1} {
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1)
+			e.writeUint32(1)
+			e.writeUint32(0)
+			e.writeUint8(uint8(shapeKindPolyline))
+			e.writeInt8(encodingVersion)
+			e.writeUint32(count)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 7. Oversized Polygon loop count (lossless and compressed, including uint64 varint overflow)
+		{
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1)
+			e.writeUint32(1)
+			e.writeUint32(0)
+			e.writeUint8(uint8(shapeKindPolygon))
+			e.writeInt8(encodingVersion)
+			e.writeBool(true)
+			e.writeBool(false)
+			e.writeUint32(0xffffffff)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+		for _, uvar := range []uint64{math.MaxUint64, maxEncodedLoops + 1, maxEncodedLoops - 1} {
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1)
+			e.writeUint32(1)
+			e.writeUint32(0)
+			e.writeUint8(uint8(shapeKindPolygon))
+			e.writeInt8(encodingCompressedVersion)
+			e.writeUint8(10) // snapLevel
+			e.writeUvarint(uvar)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 8. Oversized LaxPolygon loop and vertex counts
+		for _, count := range []uint32{0xffffffff, maxEncodedVertices - 1} {
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1)
+			e.writeUint32(1)
+			e.writeUint32(0)
+			e.writeUint8(uint8(shapeKindLaxPolygon))
+			e.writeUint32(1)
+			e.writeUint32(count)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 9. Oversized numCells
+		for _, count := range []uint32{0xffffffff, maxEncodedCells + 1, maxEncodedCells - 1} {
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(1)
+			e.writeUint32(1)
+			e.writeUint32(0)
+			e.writeUint8(uint8(shapeKindPointVector))
+			e.writeUint32(0)
+			e.writeUint32(count)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		// 10. Invalid CellID and clipped shape referencing missing shape ID
+		{
+			var b bytes.Buffer
+			e := &encoder{w: &b}
+			e.writeUint8(shapeIndexEncodingVersion)
+			e.writeUint32(10)
+			e.writeUint32(2) // nextID = 2
+			e.writeUint32(1) // numShapes = 1
+			e.writeUint32(1) // shapeID = 1 (shape 0 is removed)
+			e.writeUint8(uint8(shapeKindPointVector))
+			e.writeUint32(0)
+			e.writeUint32(1) // 1 cell
+			e.writeUint64(uint64(CellIDFromFace(0)))
+			e.writeUint32(1) // 1 clipped shape
+			e.writeUint32(0) // references removed shapeID 0!
+			e.writeBool(false)
+			e.writeUint32(0)
+			cases = append(cases, makeWithCRC(b.Bytes()))
+		}
+
+		for i, tc := range cases {
+			idx := NewShapeIndex()
+			if err := idx.Decode(bytes.NewReader(tc)); err == nil {
+				t.Errorf("case %d: expected error for malformed/oversized input, got nil", i)
+			}
+		}
+	})
+}
