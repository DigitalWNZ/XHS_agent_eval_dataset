+}
+func (g *genericShape) Dimension() int    { return g.dimension }
+func (g *genericShape) IsEmpty() bool     { return g.isEmpty }
+func (g *genericShape) IsFull() bool      { return g.isFull }
+func (g *genericShape) typeTag() typeTag  { return g.tag }
+func (g *genericShape) privateInterface() {}
+
+type hashByteReader struct {
+	r   byteReader
+	h   hash.Hash32
+	one [1]byte
+}
+
+func (hr *hashByteReader) Read(p []byte) (int, error) {
+	n, err := hr.r.Read(p)
+	if n > 0 {
+		_, _ = hr.h.Write(p[:n])
+	}
+	return n, err
+}
+
+func (hr *hashByteReader) ReadByte() (byte, error) {
+	b, err := hr.r.ReadByte()
+	if err == nil {
+		hr.one[0] = b
+		_, _ = hr.h.Write(hr.one[:])
+	}
+	return b, err
+}
+
+// Encode encodes the ShapeIndex to w.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if w == nil {
+		return errors.New("s2: nil writer in ShapeIndex.Encode")
+	}
+	s.maybeApplyUpdates()
+
+	crc := crc32.NewIEEE()
+	mw := io.MultiWriter(w, crc)
+	e := &encoder{w: mw}
+
+	e.writeUint8(shapeIndexEncodingVersion)
+
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUint32(uint32(maxEdges))
+	e.writeUint32(uint32(s.nextID))
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	for id, sh := range s.shapes {
+		if sh != nil {
+			shapeIDs = append(shapeIDs, id)
+		}
+	}
+	slices.Sort(shapeIDs)
+
+	e.writeUint32(uint32(len(shapeIDs)))
+	for _, id := range shapeIDs {
+		e.writeUint32(uint32(id))
+		encodeShapeIndexShape(e, s.shapes[id])
+		if e.err != nil {
+			return e.err
+		}
+	}
+
+	e.writeUint32(uint32(len(s.cells)))
+	for _, cellID := range s.cells {
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUint32(0)
+			continue
+		}
+		e.writeUint32(uint32(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUint32(uint32(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUint32(uint32(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUint32(uint32(edgeID))
+			}
+		}
+	}
+
+	if e.err != nil {
+		return e.err
+	}
+
+	ce := &encoder{w: w}
+	ce.writeUint32(crc.Sum32())
+	return ce.err
+}
+
+func encodeIndexPoint(e *encoder, p Point) {
+	e.writeFloat64(p.X)
+	e.writeFloat64(p.Y)
+	e.writeFloat64(p.Z)
+}
+
+func decodeIndexPoint(d *decoder) Point {
+	x := d.readFloat64()
+	y := d.readFloat64()
+	z := d.readFloat64()
+	if d.err != nil {
+		return Point{}
+	}
+	if math.IsNaN(x) || math.IsInf(x, 0) ||
+		math.IsNaN(y) || math.IsInf(y, 0) ||
+		math.IsNaN(z) || math.IsInf(z, 0) {
+		d.err = errors.New("s2: invalid point coordinates (NaN or Inf)")
+		return Point{}
+	}
+	return Point{r3.Vector{X: x, Y: y, Z: z}}
+}
+
+func readStrictBool(d *decoder) bool {
+	b := d.readUint8()
+	if d.err != nil {
+		return false
+	}
+	if b > 1 {
+		d.err = fmt.Errorf("s2: invalid boolean value %d", b)
+		return false
+	}
+	return b == 1
+}
+
+func encodeShapeIndexShape(e *encoder, sh Shape) {
+	switch v := sh.(type) {
+	case *Polygon:
+		e.writeUint8(uint8(shapeKindPolygon))
+		v.encodeLossless(e)
+	case *Polyline:
+		e.writeUint8(uint8(shapeKindPolyline))
+		v.encode(e)
+	case *PointVector:
+		e.writeUint8(uint8(shapeKindPointVector))
+		if len(*v) > maxEncodedVertices {
+			e.err = fmt.Errorf("s2: too many points in PointVector (%d; max %d)", len(*v), maxEncodedVertices)
+			return
+		}
+		e.writeUint32(uint32(len(*v)))
+		for _, pt := range *v {
+			encodeIndexPoint(e, pt)
+		}
+	case *LaxPolyline:
+		e.writeUint8(uint8(shapeKindLaxPolyline))
+		if len(v.vertices) > maxEncodedVertices {
+			e.err = fmt.Errorf("s2: too many vertices in LaxPolyline (%d; max %d)", len(v.vertices), maxEncodedVertices)
+			return
+		}
+		e.writeUint32(uint32(len(v.vertices)))
+		for _, pt := range v.vertices {
+			encodeIndexPoint(e, pt)
+		}
+	case *LaxPolygon:
+		e.writeUint8(uint8(shapeKindLaxPolygon))
+		if v.numLoops > maxEncodedLoops {
+			e.err = fmt.Errorf("s2: too many loops in LaxPolygon (%d; max %d)", v.numLoops, maxEncodedLoops)
+			return
+		}
+		e.writeUint32(uint32(v.numLoops))
+		for i := range v.numLoops {
+			nv := v.numLoopVertices(i)
+			if nv > maxEncodedVertices {
+				e.err = fmt.Errorf("s2: too many vertices in LaxPolygon loop (%d; max %d)", nv, maxEncodedVertices)
+				return
+			}
+			e.writeUint32(uint32(nv))
+			for j := range nv {
+				encodeIndexPoint(e, v.loopVertex(i, j))
+			}
+		}
+	case *Loop:
+		e.writeUint8(uint8(shapeKindLoop))
+		v.encode(e)
+	case *LaxLoop:
+		e.writeUint8(uint8(shapeKindLaxLoop))
+		if len(v.vertices) > maxEncodedVertices {
+			e.err = fmt.Errorf("s2: too many vertices in LaxLoop (%d; max %d)", len(v.vertices), maxEncodedVertices)
+			return
+		}
+		e.writeUint32(uint32(len(v.vertices)))
+		for _, pt := range v.vertices {
+			encodeIndexPoint(e, pt)
+		}
+	case *edgeVectorShape:
+		e.writeUint8(uint8(shapeKindEdgeVector))
+		if len(v.edges) > maxEncodedVertices {
+			e.err = fmt.Errorf("s2: too many edges in edgeVectorShape (%d; max %d)", len(v.edges), maxEncodedVertices)
+			return
+		}
+		e.writeUint32(uint32(len(v.edges)))
+		for _, edge := range v.edges {
+			encodeIndexPoint(e, edge.V0)
+			encodeIndexPoint(e, edge.V1)
+		}
+	default:
+		e.writeUint8(uint8(shapeKindGeneric))
+		e.writeUint8(uint8(sh.Dimension()))
+		ref := sh.ReferencePoint()
+		encodeIndexPoint(e, ref.Point)
+		e.writeBool(ref.Contained)
+		e.writeBool(sh.IsEmpty())
+		e.writeBool(sh.IsFull())
+		e.writeUint32(uint32(sh.typeTag()))
+
+		numChains := sh.NumChains()
+		if numChains < 0 || numChains > maxEncodedLoops {
+			e.err = fmt.Errorf("s2: invalid chain count %d", numChains)
+			return
+		}
+		e.writeUint32(uint32(numChains))
+		for i := range numChains {
+			ch := sh.Chain(i)
+			e.writeUint32(uint32(ch.Start))
+			e.writeUint32(uint32(ch.Length))
+		}
+
+		numEdges := sh.NumEdges()
+		if numEdges < 0 || numEdges > maxEncodedVertices {
+			e.err = fmt.Errorf("s2: invalid edge count %d", numEdges)
+			return
+		}
+		e.writeUint32(uint32(numEdges))
+		for i := range numEdges {
+			edge := sh.Edge(i)
+			encodeIndexPoint(e, edge.V0)
+			encodeIndexPoint(e, edge.V1)
+		}
+	}
+}
+
+func decodeShapeIndexShape(d *decoder) Shape {
+	kind := encodedShapeKind(d.readUint8())
+	if d.err != nil {
+		return nil
+	}
+
+	switch kind {
+	case shapeKindPolygon:
+		p := new(Polygon)
+		v := int8(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		switch v {
+		case encodingVersion:
+			p.decode(d)
+		case encodingCompressedVersion:
+			p.decodeCompressed(d)
+		default:
+			d.err = fmt.Errorf("s2: unsupported polygon encoding version %d", v)
+			return nil
+		}
+		if d.err != nil {
+			return nil
+		}
+		for _, l := range p.loops {
+			if l.depth < 0 || l.depth > len(p.loops) {
+				d.err = fmt.Errorf("s2: invalid polygon loop depth %d", l.depth)
+				return nil
+			}
+			for _, pt := range l.vertices {
+				if math.IsNaN(pt.X) || math.IsInf(pt.X, 0) ||
+					math.IsNaN(pt.Y) || math.IsInf(pt.Y, 0) ||
+					math.IsNaN(pt.Z) || math.IsInf(pt.Z, 0) {
+					d.err = errors.New("s2: invalid polygon vertex (NaN or Inf)")
+					return nil
+				}
+			}
+		}
+		return p
+
+	case shapeKindPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		for _, pt := range *p {
+			if math.IsNaN(pt.X) || math.IsInf(pt.X, 0) ||
+				math.IsNaN(pt.Y) || math.IsInf(pt.Y, 0) ||
+				math.IsNaN(pt.Z) || math.IsInf(pt.Z, 0) {
+				d.err = errors.New("s2: invalid polyline vertex (NaN or Inf)")
+				return nil
+			}
+		}
+		return p
+
+	case shapeKindPointVector:
+		n := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("s2: too many points in PointVector (%d; max %d)", n, maxEncodedVertices)
+			return nil
+		}
+		pts := make([]Point, 0, min(int(n), maxInitialSliceAlloc))
+		for range int(n) {
+			pt := decodeIndexPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			pts = append(pts, pt)
+		}
+		pv := PointVector(pts)
+		return &pv
+
+	case shapeKindLaxPolyline:
+		n := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("s2: too many vertices in LaxPolyline (%d; max %d)", n, maxEncodedVertices)
+			return nil
+		}
+		pts := make([]Point, 0, min(int(n), maxInitialSliceAlloc))
+		for range int(n) {
+			pt := decodeIndexPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			pts = append(pts, pt)
+		}
+		return LaxPolylineFromPoints(pts)
+
+	case shapeKindLaxPolygon:
+		nLoops := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nLoops > maxEncodedLoops {
+			d.err = fmt.Errorf("s2: too many loops in LaxPolygon (%d; max %d)", nLoops, maxEncodedLoops)
+			return nil
+		}
+		loops := make([][]Point, 0, min(int(nLoops), maxInitialSliceAlloc))
+		var totalVerts uint64
+		for range int(nLoops) {
+			nv := d.readUint32()
+			if d.err != nil {
+				return nil
+			}
+			totalVerts += uint64(nv)
+			if nv > maxEncodedVertices || totalVerts > maxEncodedVertices {
+				d.err = fmt.Errorf("s2: too many vertices in LaxPolygon (%d; max %d)", totalVerts, maxEncodedVertices)
+				return nil
+			}
+			pts := make([]Point, 0, min(int(nv), maxInitialSliceAlloc))
+			for range int(nv) {
+				pt := decodeIndexPoint(d)
+				if d.err != nil {
+					return nil
+				}
+				pts = append(pts, pt)
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops)
+
+	case shapeKindLoop:
+		l := new(Loop)
+		l.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		if l.depth < 0 || l.depth > maxEncodedLoops {
+			d.err = fmt.Errorf("s2: invalid loop depth %d", l.depth)
+			return nil
+		}
+		for _, pt := range l.vertices {
+			if math.IsNaN(pt.X) || math.IsInf(pt.X, 0) ||
+				math.IsNaN(pt.Y) || math.IsInf(pt.Y, 0) ||
+				math.IsNaN(pt.Z) || math.IsInf(pt.Z, 0) {
+				d.err = errors.New("s2: invalid loop vertex (NaN or Inf)")
+				return nil
+			}
+		}
+		return l
+
+	case shapeKindLaxLoop:
+		n := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("s2: too many vertices in LaxLoop (%d; max %d)", n, maxEncodedVertices)
+			return nil
+		}
+		pts := make([]Point, 0, min(int(n), maxInitialSliceAlloc))
+		for range int(n) {
+			pt := decodeIndexPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			pts = append(pts, pt)
+		}
+		return LaxLoopFromPoints(pts)
+
+	case shapeKindEdgeVector:
+		n := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("s2: too many edges in edgeVectorShape (%d; max %d)", n, maxEncodedVertices)
+			return nil
+		}
+		edges := make([]Edge, 0, min(int(n), maxInitialSliceAlloc))
+		for range int(n) {
+			v0 := decodeIndexPoint(d)
+			v1 := decodeIndexPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, Edge{V0: v0, V1: v1})
+		}
+		return &edgeVectorShape{edges: edges}
+
+	case shapeKindGeneric:
+		dim := int(d.readUint8())
+		if d.err != nil {
+			return nil
+		}
+		if dim < 0 || dim > 2 {
+			d.err = fmt.Errorf("s2: invalid shape dimension %d", dim)
+			return nil
+		}
+		refPt := decodeIndexPoint(d)
+		refContained := readStrictBool(d)
+		isEmpty := readStrictBool(d)
+		isFull := readStrictBool(d)
+		tag := typeTag(d.readUint32())
+		nChains := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nChains > maxEncodedLoops {
+			d.err = fmt.Errorf("s2: too many chains in generic shape (%d; max %d)", nChains, maxEncodedLoops)
+			return nil
+		}
+		chains := make([]Chain, 0, min(int(nChains), maxInitialSliceAlloc))
+		expectedStart := uint32(0)
+		for range int(nChains) {
+			start := d.readUint32()
+			length := d.readUint32()
+			if d.err != nil {
+				return nil
+			}
+			if start != expectedStart || length > maxEncodedVertices {
+				d.err = fmt.Errorf("s2: invalid chain range (%d, %d)", start, length)
+				return nil
+			}
+			expectedStart += length
+			chains = append(chains, Chain{Start: int(start), Length: int(length)})
+		}
+		nEdges := d.readUint32()
+		if d.err != nil {
+			return nil
+		}
+		if nEdges > maxEncodedVertices || (nChains > 0 && nEdges != expectedStart) || (nChains == 0 && nEdges != 0) {
+			d.err = fmt.Errorf("s2: invalid edge count %d for chain total %d", nEdges, expectedStart)
+			return nil
+		}
+		edges := make([]Edge, 0, min(int(nEdges), maxInitialSliceAlloc))
+		for range int(nEdges) {
+			v0 := decodeIndexPoint(d)
+			v1 := decodeIndexPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, Edge{V0: v0, V1: v1})
+		}
+		return &genericShape{
+			dimension: dim,
+			refPoint:  ReferencePoint{Point: refPt, Contained: refContained},
+			isEmpty:   isEmpty,
+			isFull:    isFull,
+			tag:       tag,
+			chains:    chains,
+			edges:     edges,
+		}
+
+	default:
+		d.err = fmt.Errorf("s2: unknown encoded shape kind %d", kind)
+		return nil
+	}
+}
+
+// Decode decodes the ShapeIndex from r.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if r == nil {
+		return errors.New("s2: nil reader in ShapeIndex.Decode")
+	}
+	br := asByteReader(r)
+	hr := &hashByteReader{
+		r: br,
+		h: crc32.NewIEEE(),
+	}
+	d := &decoder{r: hr}
+
+	version := d.readUint8()
+	if d.err != nil {
+		return d.err
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("s2: unsupported ShapeIndex encoding version %d", version)
+	}
+
+	maxEdges := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if maxEdges == 0 || maxEdges > maxEncodedVertices {
+		return fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdges)
+	}
+
+	nextID := d.readUint32()
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numShapes > maxEncodedShapes || nextID > maxEncodedShapes || numShapes > nextID {
+		return fmt.Errorf("s2: invalid shape counts (numShapes=%d, nextID=%d)", numShapes, nextID)
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), maxInitialSliceAlloc))
+	prevShapeID := int32(-1)
+	for range int(numShapes) {
+		rawID := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+		if rawID >= nextID {
+			return fmt.Errorf("s2: shape ID %d out of range [0, %d)", rawID, nextID)
+		}
+		id := int32(rawID)
+		if id <= prevShapeID {
+			return fmt.Errorf("s2: unsorted or duplicate shape ID %d after %d", id, prevShapeID)
+		}
+		prevShapeID = id
+
+		sh := decodeShapeIndexShape(d)
+		if d.err != nil {
+			return d.err
+		}
+		if sh == nil {
+			return fmt.Errorf("s2: nil decoded shape for ID %d", id)
+		}
+		shapes[id] = sh
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if numCells > maxEncodedCells {
+		return fmt.Errorf("s2: too many cells (%d; max %d)", numCells, maxEncodedCells)
+	}
+	if numCells > 0 && numShapes == 0 {
+		return errors.New("s2: non-empty cells in ShapeIndex with no shapes")
+	}
+
+	cells := make([]CellID, 0, min(int(numCells), maxInitialSliceAlloc))
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), maxInitialSliceAlloc))
+	var prevCellID CellID
+	for i := range int(numCells) {
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return d.err
+		}
+		if !cellID.IsValid() {
+			return fmt.Errorf("s2: invalid CellID %d at cell index %d", uint64(cellID), i)
+		}
+		if i > 0 {
+			if cellID <= prevCellID {
+				return fmt.Errorf("s2: unsorted or duplicate CellID %v after %v", cellID, prevCellID)
+			}
+			if prevCellID.RangeMax() >= cellID.RangeMin() {
+				return fmt.Errorf("s2: overlapping CellIDs %v and %v", prevCellID, cellID)
+			}
+		}
+		prevCellID = cellID
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return d.err
+		}
+		if numClipped > numShapes {
+			return fmt.Errorf("s2: cell has %d clipped shapes, but index only has %d shapes", numClipped, numShapes)
+		}
+
+		indexCell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, min(int(numClipped), maxInitialSliceAlloc)),
+		}
+		prevClippedShapeID := int32(-1)
+		for range int(numClipped) {
+			rawShapeID := d.readUint32()
+			containsCenter := readStrictBool(d)
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return d.err
+			}
+			if rawShapeID >= nextID {
+				return fmt.Errorf("s2: clipped shape ID %d out of range [0, %d)", rawShapeID, nextID)
+			}
+			shapeID := int32(rawShapeID)
+			if shapeID <= prevClippedShapeID {
+				return fmt.Errorf("s2: unsorted or duplicate clipped shape ID %d", shapeID)
+			}
+			prevClippedShapeID = shapeID
+
+			sh, ok := shapes[shapeID]
+			if !ok {
+				return fmt.Errorf("s2: clipped shape references missing shape ID %d", shapeID)
+			}
+			if containsCenter && sh.Dimension() != 2 {
+				return fmt.Errorf("s2: containsCenter is true for shape %d with dimension %d", shapeID, sh.Dimension())
+			}
+			shapeNumEdges := sh.NumEdges()
+			if int(numEdges) > shapeNumEdges {
+				return fmt.Errorf("s2: clipped shape %d has %d edges, exceeding shape edge count %d", shapeID, numEdges, shapeNumEdges)
+			}
+
+			edges := make([]int, 0, min(int(numEdges), maxInitialSliceAlloc))
+			prevEdgeID := -1
+			for range int(numEdges) {
+				rawEdgeID := d.readUint32()
+				if d.err != nil {
+					return d.err
+				}
+				if int(rawEdgeID) >= shapeNumEdges || int(rawEdgeID) < 0 {
+					return fmt.Errorf("s2: clipped edge ID %d out of range [0, %d)", rawEdgeID, shapeNumEdges)
+				}
+				edgeID := int(rawEdgeID)
+				if edgeID <= prevEdgeID {
+					return fmt.Errorf("s2: unsorted or duplicate clipped edge ID %d", edgeID)
+				}
+				prevEdgeID = edgeID
+				edges = append(edges, edgeID)
+			}
+
+			indexCell.shapes = append(indexCell.shapes, &clippedShape{
+				shapeID:        shapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = indexCell
+	}
+
+	expectedCRC := hr.h.Sum32()
+	d.r = br
+	actualCRC := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if actualCRC != expectedCRC {
+		return fmt.Errorf("s2: ShapeIndex checksum mismatch: got %#08x, want %#08x", actualCRC, expectedCRC)
+	}
+
+	s.mu.Lock()
+	s.maxEdgesPerCell = int(maxEdges)
+	s.nextID = int32(nextID)
+	s.shapes = shapes
+	s.cells = cells
+	s.cellMap = cellMap
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+
+	return nil
+}
