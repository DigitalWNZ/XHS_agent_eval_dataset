+
+		const qNthValue = pgDialect.sqlToQuery(nthValue(usersPg.salary, 2).over().getSQL());
+		expect(qNthValue.params).toEqual([]);
+
+		const qLagZero = pgDialect.sqlToQuery(lag(usersPg.salary, 0).over().getSQL());
+		expect(qLagZero.params).toEqual([]);
+
+		const qLagDefaultZero = pgDialect.sqlToQuery(lag(usersPg.salary, 1, 0).over().getSQL());
+		expect(qLagDefaultZero.params).toEqual([]);
+
+		const qLeadZero = pgDialect.sqlToQuery(lead(usersPg.salary, 0).over().getSQL());
+		expect(qLeadZero.params).toEqual([]);
+
+		const qLeadDefaultZero = pgDialect.sqlToQuery(lead(usersPg.salary, 1, 0).over().getSQL());
+		expect(qLeadDefaultZero.params).toEqual([]);
+
+		const qFrameZero = pgDialect.sqlToQuery(
+			rowNumber().over({
+				frame: rows({ from: preceding(0), to: following(0) }),
+			}).getSQL(),
+		);
+		expect(qFrameZero.params).toEqual([]);
+	});
+
+	test('ntile and nthValue reject non-positive integer arguments with error containing function name and received value', () => {
+		expect(() => ntile(0)).toThrowError(/ntile.*0/);
