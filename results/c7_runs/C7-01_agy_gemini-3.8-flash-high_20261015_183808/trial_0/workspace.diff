diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..c96ce0b8
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,381 @@
+import { Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type SelectedValue<T> = T extends Column ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+export type FrameBoundaryType =
+	| 'unbounded_preceding'
+	| 'preceding'
+	| 'current_row'
+	| 'following'
+	| 'unbounded_following';
+
+export class FrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'FrameBoundary';
+
+	constructor(
+		readonly type: FrameBoundaryType,
+		readonly offset?: number,
+	) {}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		switch (this.type) {
+			case 'unbounded_preceding':
+				return sql.raw('unbounded preceding');
+			case 'current_row':
+				return sql.raw('current row');
+			case 'unbounded_following':
+				return sql.raw('unbounded following');
+			case 'preceding':
+				return sql`${sql.raw(String(this.offset))} preceding`;
+			case 'following':
+				return sql`${sql.raw(String(this.offset))} following`;
+			default:
+				throw new Error(`Unknown frame boundary type: ${this.type}`);
+		}
+	}
+}
+
+export const unboundedPreceding = new FrameBoundary('unbounded_preceding');
+export const currentRow = new FrameBoundary('current_row');
+export const unboundedFollowing = new FrameBoundary('unbounded_following');
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding: offset must be a non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundary('preceding', offset);
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following: offset must be a non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundary('following', offset);
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly from: FrameBoundary,
+		readonly to?: FrameBoundary,
+	) {}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		if (this.to) {
+			return sql`${sql.raw(this.type)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.from.getSQL()}`;
+	}
+}
+
+function getBoundaryOrder(boundary: FrameBoundary): number {
+	switch (boundary.type) {
+		case 'unbounded_preceding':
+			return -Infinity;
+		case 'preceding':
+			return -(boundary.offset ?? 0);
+		case 'current_row':
+			return 0;
+		case 'following':
+			return +(boundary.offset ?? 0);
+		case 'unbounded_following':
+			return Infinity;
+		default:
+			return 0;
+	}
+}
+
+function buildFrame(type: 'rows' | 'range', spec: FrameSpec): WindowFrame {
+	if (!spec || !spec.from) {
+		throw new Error(`The "from" boundary must be provided in ${type}() frame specification`);
+	}
+	if (spec.to && getBoundaryOrder(spec.from) > getBoundaryOrder(spec.to)) {
+		throw new Error(
+			`The "from" boundary must not be ordered after the "to" boundary in ${type}() frame specification`,
+		);
+	}
+	return new WindowFrame(type, spec.from, spec.to);
+}
+
+export function rows(spec: FrameSpec): WindowFrame;
+export function rows(from: FrameBoundary, to?: FrameBoundary): WindowFrame;
+export function rows(
+	specOrFrom: FrameSpec | FrameBoundary,
+	maybeTo?: FrameBoundary,
+): WindowFrame {
+	const spec: FrameSpec = is(specOrFrom, FrameBoundary)
+		? { from: specOrFrom, to: maybeTo }
+		: specOrFrom;
+	return buildFrame('rows', spec);
+}
+
+export function range(spec: FrameSpec): WindowFrame;
+export function range(from: FrameBoundary, to?: FrameBoundary): WindowFrame;
+export function range(
+	specOrFrom: FrameSpec | FrameBoundary,
+	maybeTo?: FrameBoundary,
+): WindowFrame {
+	const spec: FrameSpec = is(specOrFrom, FrameBoundary)
+		? { from: specOrFrom, to: maybeTo }
+		: specOrFrom;
+	return buildFrame('range', spec);
+}
+
+export function validateWindowName(name: string, caller = 'window'): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error(`${caller} name must be non-empty`);
+	}
+	if (name.trim().length === 0) {
+		throw new Error(`${caller} name cannot be whitespace-only`);
+	}
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame | SQLWrapper;
+}
+
+export function buildWindowSpec(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql`()`;
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionByList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByList.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderByList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByList.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		const frameSql = is(spec.frame, SQL)
+			? spec.frame
+			: isSQLWrapper(spec.frame)
+			? spec.frame.getSQL()
+			: (spec.frame as any).getSQL?.();
+		if (frameSql) {
+			parts.push(frameSql);
+		}
+	}
+
+	if (parts.length === 0) {
+		return sql`()`;
+	}
+
+	return sql`(${sql.join(parts, sql` `)})`;
+}
+
+export class WindowBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	constructor(
+		readonly sqlChunk: SQL,
+		protected readonly decoder?:
+			| DriverValueDecoder<T, any>
+			| DriverValueDecoder<T, any>['mapFromDriverValue']
+			| SQLWrapper,
+	) {}
+
+	getSQL(): SQL {
+		return this.sqlChunk;
+	}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		let resultSql: SQL<T>;
+		if (typeof spec === 'string') {
+			validateWindowName(spec, 'window');
+			resultSql = sql`${this.sqlChunk} over ${sql.identifier(spec)}`;
+		} else {
+			const specSql = buildWindowSpec(spec);
+			resultSql = sql`${this.sqlChunk} over ${specSql}`;
+		}
+
+		if (this.decoder) {
+			resultSql.mapWith(this.decoder as any);
+		}
+
+		return resultSql;
+	}
+}
+
+export function rowNumber(): WindowBuilder<number> {
+	return new WindowBuilder<number>(sql`row_number()`, Number);
+}
+
+export function rank(): WindowBuilder<number> {
+	return new WindowBuilder<number>(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowBuilder<number> {
+	return new WindowBuilder<number>(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number): WindowBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile: argument must be a positive integer, received ${n}`);
+	}
+	return new WindowBuilder<number>(sql`ntile(${sql.raw(String(n))})`, Number);
+}
+
+export function percentRank(): WindowBuilder<number> {
+	return new WindowBuilder<number>(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowBuilder<number> {
+	return new WindowBuilder<number>(sql`cume_dist()`, Number);
+}
+
+export function firstValue<T extends SQLWrapper>(value: T): WindowBuilder<SelectedValue<T> | null> {
+	const decoder = is(value, Column) ? value : is(value, SQL) ? value.decoder : undefined;
+	return new WindowBuilder(sql`first_value(${value})`, decoder as any);
+}
+
+export function lastValue<T extends SQLWrapper>(value: T): WindowBuilder<SelectedValue<T> | null> {
+	const decoder = is(value, Column) ? value : is(value, SQL) ? value.decoder : undefined;
+	return new WindowBuilder(sql`last_value(${value})`, decoder as any);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	n: number,
+): WindowBuilder<SelectedValue<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue: argument must be a positive integer, received ${n}`);
+	}
+	const decoder = is(value, Column) ? value : is(value, SQL) ? value.decoder : undefined;
+	return new WindowBuilder(
+		sql`nth_value(${value}, ${sql.raw(String(n))})`,
+		decoder as any,
+	);
+}
+
+export function lag<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowBuilder<SelectedValue<T> | null>;
+export function lag<T extends SQLWrapper, TDefault extends SQLWrapper | unknown>(
+	value: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowBuilder<NonNullable<SelectedValue<T>>>;
+export function lag<T extends SQLWrapper, TDefault extends SQLWrapper | unknown>(
+	value: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowBuilder<
+	TDefault extends undefined ? SelectedValue<T> | null
+		: NonNullable<SelectedValue<T>>
+> {
+	let chunk: SQL;
+	if (defaultValue !== undefined) {
+		const offsetSql = sql.raw(String(offset ?? 1));
+		const defaultSql = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: is(defaultValue, SQL)
+			? defaultValue
+			: isSQLWrapper(defaultValue)
+			? defaultValue.getSQL()
+			: sql`${defaultValue}`;
+		chunk = sql`lag(${value}, ${offsetSql}, ${defaultSql})`;
+	} else if (offset !== undefined) {
+		const offsetSql = sql.raw(String(offset));
+		chunk = sql`lag(${value}, ${offsetSql})`;
+	} else {
+		chunk = sql`lag(${value})`;
+	}
+
+	const decoder = is(value, Column) ? value : is(value, SQL) ? value.decoder : undefined;
+	return new WindowBuilder(chunk, decoder as any) as any;
+}
+
+export function lead<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowBuilder<SelectedValue<T> | null>;
+export function lead<T extends SQLWrapper, TDefault extends SQLWrapper | unknown>(
+	value: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowBuilder<NonNullable<SelectedValue<T>>>;
+export function lead<T extends SQLWrapper, TDefault extends SQLWrapper | unknown>(
+	value: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowBuilder<
+	TDefault extends undefined ? SelectedValue<T> | null
+		: NonNullable<SelectedValue<T>>
+> {
+	let chunk: SQL;
+	if (defaultValue !== undefined) {
+		const offsetSql = sql.raw(String(offset ?? 1));
+		const defaultSql = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: is(defaultValue, SQL)
+			? defaultValue
+			: isSQLWrapper(defaultValue)
+			? defaultValue.getSQL()
+			: sql`${defaultValue}`;
+		chunk = sql`lead(${value}, ${offsetSql}, ${defaultSql})`;
+	} else if (offset !== undefined) {
+		const offsetSql = sql.raw(String(offset));
+		chunk = sql`lead(${value}, ${offsetSql})`;
+	} else {
+		chunk = sql`lead(${value})`;
+	}
+
+	const decoder = is(value, Column) ? value : is(value, SQL) ? value.decoder : undefined;
+	return new WindowBuilder(chunk, decoder as any) as any;
+}
+
+export function windowSum(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder<string | null>(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder<string | null>(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(expression: T): WindowBuilder<SelectedValue<T> | null> {
+	const decoder = is(expression, Column) ? expression : String;
+	return new WindowBuilder(sql`min(${expression})`, decoder as any);
+}
+
+export function windowMax<T extends SQLWrapper>(expression: T): WindowBuilder<SelectedValue<T> | null> {
+	const decoder = is(expression, Column) ? expression : String;
+	return new WindowBuilder(sql`max(${expression})`, decoder as any);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowBuilder<number> {
+	const chunk = expression ? sql`count(${expression})` : sql`count(*)`;
+	return new WindowBuilder<number>(chunk, Number);
+}
