+func TestLoadKeyDerive(t *testing.T) {
+	salt := make([]byte, 16)
+	_, _ = rand.Read(salt)
+	b64Salt := base64.StdEncoding.EncodeToString(salt)
+
+	cfg := Config{KeySource: "derive", Passphrase: "super-secret-passphrase", Salt: b64Salt}
+	key1, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Len(t, key1, 32)
+
+	// Deterministic: repeating with same input returns identical key
+	key2, err := LoadKey(cfg)
+	require.NoError(t, err)
+	assert.Equal(t, key1, key2)
+
+	// Different passphrase produces different key
+	cfgDiffPass := Config{KeySource: "derive", Passphrase: "different-passphrase", Salt: b64Salt}
+	keyDiff, err := LoadKey(cfgDiffPass)
+	require.NoError(t, err)
+	assert.NotEqual(t, key1, keyDiff)
+
+	// Different salt produces different key
+	salt2 := make([]byte, 16)
+	_, _ = rand.Read(salt2)
+	b64Salt2 := base64.StdEncoding.EncodeToString(salt2)
+	cfgDiffSalt := Config{KeySource: "derive", Passphrase: "super-secret-passphrase", Salt: b64Salt2}
+	keyDiffSalt, err := LoadKey(cfgDiffSalt)
+	require.NoError(t, err)
+	assert.NotEqual(t, key1, keyDiffSalt)
+
+	// Empty passphrase fails
+	cfgEmptyPass := Config{KeySource: "derive", Passphrase: "", Salt: b64Salt}
+	_, err = LoadKey(cfgEmptyPass)
+	require.Error(t, err)
+
+	// Short salt (<16 bytes) fails
+	shortSalt := base64.StdEncoding.EncodeToString(make([]byte, 15))
+	cfgShortSalt := Config{KeySource: "derive", Passphrase: "pass", Salt: shortSalt}
+	_, err = LoadKey(cfgShortSalt)
+	require.Error(t, err)
+}
