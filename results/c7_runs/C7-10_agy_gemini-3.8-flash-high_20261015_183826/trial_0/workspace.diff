diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..1e728ac
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,500 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const (
+	magic0    = 0x4F
+	magic1    = 0x44
+	version   = 0x01
+	nonceSize = 12
+	tagSize   = 16
+	ChunkSize = 64 * 1024 // 64KB
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key")
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (cfg Config) Validate() error {
+	if !cfg.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	if source == "" {
+		return errors.New("key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case "env":
+		if strings.TrimSpace(cfg.KeyFile) != "" ||
+			strings.TrimSpace(cfg.Key) != "" ||
+			strings.TrimSpace(cfg.Passphrase) != "" ||
+			strings.TrimSpace(cfg.Salt) != "" {
+			return errors.New("key source fields are mutually exclusive")
+		}
+		if strings.TrimSpace(cfg.KeyEnvVar) == "" {
+			return errors.New("key env var is required for env key source")
+		}
+	case "file":
+		if strings.TrimSpace(cfg.KeyEnvVar) != "" ||
+			strings.TrimSpace(cfg.Key) != "" ||
+			strings.TrimSpace(cfg.Passphrase) != "" ||
+			strings.TrimSpace(cfg.Salt) != "" {
+			return errors.New("key source fields are mutually exclusive")
+		}
+		if strings.TrimSpace(cfg.KeyFile) == "" {
+			return errors.New("key file is required for file key source")
+		}
+	case "literal":
+		if strings.TrimSpace(cfg.KeyEnvVar) != "" ||
+			strings.TrimSpace(cfg.KeyFile) != "" ||
+			strings.TrimSpace(cfg.Passphrase) != "" ||
+			strings.TrimSpace(cfg.Salt) != "" {
+			return errors.New("key source fields are mutually exclusive")
+		}
+		if strings.TrimSpace(cfg.Key) == "" {
+			return errors.New("key is required for literal key source")
+		}
+	case "derive":
+		if strings.TrimSpace(cfg.KeyEnvVar) != "" ||
+			strings.TrimSpace(cfg.KeyFile) != "" ||
+			strings.TrimSpace(cfg.Key) != "" {
+			return errors.New("key source fields are mutually exclusive")
+		}
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return errors.New("empty passphrase rejected")
+		}
+		if strings.TrimSpace(cfg.Salt) == "" {
+			return errors.New("salt is required for derive key source")
+		}
+		saltBytes, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return fmt.Errorf("invalid base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return fmt.Errorf("salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+	default:
+		return fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+
+	return nil
+}
+
+func decodeBase64(s string) ([]byte, error) {
+	s = strings.TrimSpace(s)
+	if b, err := base64.StdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.RawStdEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	if b, err := base64.URLEncoding.DecodeString(s); err == nil {
+		return b, nil
+	}
+	return base64.RawURLEncoding.DecodeString(s)
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	vCfg := cfg
+	vCfg.Enabled = true
+	if err := vCfg.Validate(); err != nil {
+		return nil, err
+	}
+
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+	switch source {
+	case "env":
+		val, ok := os.LookupEnv(strings.TrimSpace(cfg.KeyEnvVar))
+		if !ok {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+		if strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is empty", cfg.KeyEnvVar)
+		}
+		keyBytes, err := decodeBase64(val)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from env var %s: %w", cfg.KeyEnvVar, err)
+		}
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("%w: encryption key must be 32 bytes, got %d", ErrInvalidKey, len(keyBytes))
+		}
+		return keyBytes, nil
+
+	case "file":
+		data, err := os.ReadFile(strings.TrimSpace(cfg.KeyFile))
+		if err != nil {
+			return nil, fmt.Errorf("failed to read encryption key file %s: %w", cfg.KeyFile, err)
+		}
+		keyBytes, err := decodeBase64(string(data))
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 encryption key from file %s: %w", cfg.KeyFile, err)
+		}
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("%w: encryption key must be 32 bytes, got %d", ErrInvalidKey, len(keyBytes))
+		}
+		return keyBytes, nil
+
+	case "literal":
+		keyBytes, err := decodeBase64(cfg.Key)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 literal encryption key: %w", err)
+		}
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("%w: encryption key must be 32 bytes, got %d", ErrInvalidKey, len(keyBytes))
+		}
+		return keyBytes, nil
+
+	case "derive":
+		if cfg.Passphrase == "" {
+			return nil, errors.New("empty passphrase rejected")
+		}
+		saltBytes, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decode base64 salt: %w", err)
+		}
+		if len(saltBytes) < 16 {
+			return nil, fmt.Errorf("salt must be at least 16 bytes, got %d", len(saltBytes))
+		}
+		keyBytes := pbkdf2.Key([]byte(cfg.Passphrase), saltBytes, 100000, 32, sha256.New)
+		if len(keyBytes) != 32 {
+			return nil, fmt.Errorf("%w: derived key must be 32 bytes", ErrInvalidKey)
+		}
+		return keyBytes, nil
+
+	default:
+		return nil, fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+}
+
+type Encryptor struct {
+	key []byte
+	gcm cipher.AEAD
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	keyCopy := make([]byte, len(key))
+	copy(keyCopy, key)
+
+	return &Encryptor{
+		key: keyCopy,
+		gcm: gcm,
+	}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:   w,
+		gcm: e.gcm,
+		h:   hmac.New(sha256.New, e.key),
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	gcm           cipher.AEAD
+	h             hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	if ew.headerWritten {
+		return nil
+	}
+	header := []byte{magic0, magic1, version}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	var nonce [nonceSize]byte
+	if _, err := io.ReadFull(rand.Reader, nonce[:]); err != nil {
+		return fmt.Errorf("failed to generate nonce: %w", err)
+	}
+
+	ciphertext := ew.gcm.Seal(nil, nonce[:], ew.buf, nil)
+	chunkLen := uint32(len(nonce) + len(ciphertext))
+
+	var lenBuf [4]byte
+	binary.BigEndian.PutUint32(lenBuf[:], chunkLen)
+
+	// Feed all bytes between header and sentinel into HMAC
+	ew.h.Write(lenBuf[:])
+	ew.h.Write(nonce[:])
+	ew.h.Write(ciphertext)
+
+	// Write chunk to underlying writer
+	chunk := make([]byte, 4+len(nonce)+len(ciphertext))
+	copy(chunk[:4], lenBuf[:])
+	copy(chunk[4:4+len(nonce)], nonce[:])
+	copy(chunk[4+len(nonce):], ciphertext)
+
+	if _, err := ew.w.Write(chunk); err != nil {
+		return err
+	}
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write to closed EncryptWriter")
+	}
+	if ew.err != nil {
+		return 0, ew.err
+	}
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return 0, err
+		}
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		needed := ChunkSize - len(ew.buf)
+		if len(p) < needed {
+			ew.buf = append(ew.buf, p...)
+			break
+		}
+		ew.buf = append(ew.buf, p[:needed]...)
+		p = p[needed:]
+		if err := ew.flushChunk(); err != nil {
+			ew.err = err
+			return 0, err
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			ew.err = err
+			return err
+		}
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.flushChunk(); err != nil {
+			ew.err = err
+			return err
+		}
+	}
+
+	// Zero sentinel (4 zero bytes) ends chunks, followed by 32-byte HMAC-SHA256
+	trailer := make([]byte, 4+32)
+	mac := ew.h.Sum(nil)
+	copy(trailer[4:], mac)
+
+	if _, err := ew.w.Write(trailer); err != nil {
+		ew.err = err
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes, got %d", ErrInvalidKey, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create GCM: %w", err)
+	}
+
+	keyCopy := make([]byte, len(key))
+	copy(keyCopy, key)
+
+	return &decryptReader{
+		r:   r,
+		gcm: gcm,
+		h:   hmac.New(sha256.New, keyCopy),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	gcm         cipher.AEAD
+	h           hash.Hash
+	plainBuf    []byte
+	initialized bool
+	eof         bool
+	err         error
+}
+
+func (dr *decryptReader) init() error {
+	var header [3]byte
+	if _, err := io.ReadFull(dr.r, header[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return fmt.Errorf("truncated data in header: %w", err)
+		}
+		return fmt.Errorf("failed to read header: %w", err)
+	}
+
+	if header[0] != magic0 || header[1] != magic1 {
+		return fmt.Errorf("invalid header: expected magic 0x%02X 0x%02X, got 0x%02X 0x%02X", magic0, magic1, header[0], header[1])
+	}
+
+	if header[2] != version {
+		return fmt.Errorf("unsupported version: expected 0x%02X, got 0x%02X", version, header[2])
+	}
+
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) nextChunk() error {
+	var lenBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lenBuf[:]); err != nil {
+		return fmt.Errorf("truncated data: stream ended without sentinel: %w", err)
+	}
+
+	chunkLen := binary.BigEndian.Uint32(lenBuf[:])
+	if chunkLen == 0 {
+		// Zero sentinel reached! Read HMAC-SHA256
+		var expectedMac [32]byte
+		if _, err := io.ReadFull(dr.r, expectedMac[:]); err != nil {
+			return fmt.Errorf("truncated data: missing HMAC after sentinel: %w", err)
+		}
+
+		computedMac := dr.h.Sum(nil)
+		if !hmac.Equal(computedMac, expectedMac[:]) {
+			return errors.New("HMAC integrity check failed")
+		}
+
+		dr.eof = true
+		return nil
+	}
+
+	if chunkLen < nonceSize+tagSize {
+		return fmt.Errorf("truncated data: chunk length %d too small", chunkLen)
+	}
+
+	chunkData := make([]byte, chunkLen)
+	if _, err := io.ReadFull(dr.r, chunkData); err != nil {
+		return fmt.Errorf("truncated data: incomplete chunk payload: %w", err)
+	}
+
+	// Feed chunk into HMAC
+	dr.h.Write(lenBuf[:])
+	dr.h.Write(chunkData)
+
+	nonce := chunkData[:nonceSize]
+	ciphertext := chunkData[nonceSize:]
+
+	plaintext, err := dr.gcm.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decryption failed: %w", err)
+	}
+
+	dr.plainBuf = plaintext
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+	}
+
+	if dr.eof && len(dr.plainBuf) == 0 {
+		return 0, io.EOF
+	}
+
+	for len(dr.plainBuf) == 0 && !dr.eof {
+		if err := dr.nextChunk(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+	}
+
+	if len(dr.plainBuf) > 0 {
+		n := copy(p, dr.plainBuf)
+		dr.plainBuf = dr.plainBuf[n:]
+		return n, nil
+	}
+
+	if dr.eof {
+		return 0, io.EOF
+	}
+
+	return 0, nil
+}
