+func TestRoundTripLargeMultiChunk(t *testing.T) {
+	key := make([]byte, 32)
+	_, _ = rand.Read(key)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	// Create >150KB to cross multiple 64KB chunks
+	plaintext := make([]byte, 160*1024)
+	_, _ = rand.Read(plaintext)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	// Write in irregular chunk sizes
+	step := 1024
+	for i := 0; i < len(plaintext); i += step {
+		end := i + step
+		if end > len(plaintext) {
+			end = len(plaintext)
+		}
+		_, err = ew.Write(plaintext[i:end])
+		require.NoError(t, err)
+	}
+	err = ew.Close()
+	require.NoError(t, err)
+
+	dr, err := DecryptReader(&buf, key)
+	require.NoError(t, err)
+
+	decrypted, err := io.ReadAll(dr)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, decrypted)
+}
