@@ -0,0 +1,505 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewEncryptor(t *testing.T) {
+	// Non-32-byte keys must be rejected and wrap ErrInvalidKey
+	badKeys := [][]byte{
+		{},
+		[]byte("short"),
+		make([]byte, 16),
+		make([]byte, 31),
+		make([]byte, 33),
+		make([]byte, 64),
+	}
+
+	for _, k := range badKeys {
+		enc, err := NewEncryptor(k)
+		assert.Nil(t, enc)
+		require.Error(t, err)
+		assert.True(t, errors.Is(err, ErrInvalidKey), "error should wrap ErrInvalidKey")
+	}
+
+	// 32-byte key accepted
+	validKey := make([]byte, 32)
+	_, err := rand.Read(validKey)
+	require.NoError(t, err)
+
+	enc, err := NewEncryptor(validKey)
+	require.NoError(t, err)
+	assert.NotNil(t, enc)
+}
+
+func TestEncryptWriterHeader(t *testing.T) {
+	key := make([]byte, 32)
+	_, _ = rand.Read(key)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	err = ew.Close()
+	require.NoError(t, err)
+
+	out := buf.Bytes()
+	require.GreaterOrEqual(t, len(out), 3)
+	assert.Equal(t, byte(0x4F), out[0])
+	assert.Equal(t, byte(0x44), out[1])
+	assert.Equal(t, byte(0x01), out[2])
+}
+
+func TestEncryptWriterIdempotentClose(t *testing.T) {
+	key := make([]byte, 32)
+	_, _ = rand.Read(key)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, err = ew.Write([]byte("some data"))
+	require.NoError(t, err)
+
+	err = ew.Close()
+	require.NoError(t, err)
+	firstLen := buf.Len()
+
+	// Calling Close again should be a no-op
+	err = ew.Close()
+	require.NoError(t, err)
+	assert.Equal(t, firstLen, buf.Len())
+}
