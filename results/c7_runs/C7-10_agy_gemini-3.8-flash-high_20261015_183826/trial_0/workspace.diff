+func TestDecryptReaderTruncatedData(t *testing.T) {
+	key := make([]byte, 32)
+	_, _ = rand.Read(key)
+
+	enc, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	ew := enc.EncryptWriter(&buf)
+	_, _ = ew.Write([]byte("some reasonable plaintext for truncation testing"))
+	_ = ew.Close()
+
+	full := buf.Bytes()
+
+	// Truncate at various cutoffs
+	cutoffs := []int{
+		1, 2, // header
+		3, 4, 5, 6, // chunk length
+		10, 20, // chunk body
+		len(full) - 34, // sentinel cut
+		len(full) - 10, // HMAC cut
+	}
+
+	for _, c := range cutoffs {
+		if c >= len(full) {
+			continue
+		}
+		dr, err := DecryptReader(bytes.NewReader(full[:c]), key)
+		require.NoError(t, err)
+
+		_, err = io.ReadAll(dr)
+		require.Error(t, err, "truncated stream at length %d must error", c)
+	}
+}
