@@ -0,0 +1,58 @@
+import asyncio
+from typing import Callable, Awaitable, List
+
+async def run_tasks(
+    tasks: list[Callable[[], Awaitable[None]]],
+    max_concurrent: int,
+) -> None:
+    """
+    Run a list of async tasks concurrently with a maximum concurrency limit.
+
+    Args:
+        tasks: A list of callables, each returning an Awaitable[None].
+        max_concurrent: Maximum number of tasks to run concurrently.
+
+    Raises:
+        ValueError: If max_concurrent is less than or equal to 0.
+    """
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be greater than 0")
+
+    tasks_list = list(tasks)
+    if not tasks_list:
+        return
+
+    idx = 0
+    num_tasks = len(tasks_list)
+
+    async def worker() -> None:
+        nonlocal idx
+        while True:
+            if idx >= num_tasks:
+                break
+            current_idx = idx
+            idx += 1
+            await tasks_list[current_idx]()
+
+    num_workers = min(max_concurrent, num_tasks)
+    workers = [asyncio.create_task(worker()) for _ in range(num_workers)]
+
+    try:
+        await asyncio.gather(*workers)
+    except BaseException as exc:
+        # Prevent any unstarted tasks from starting
+        idx = num_tasks
+
+        # Cancel all active worker tasks
+        for w in workers:
+            w.cancel()
+
+        # Wait for all workers to finish execution/cleanup
+        for w in workers:
+            while not w.done():
+                try:
+                    await asyncio.shield(w)
+                except BaseException:
+                    pass
+
+        raise
