+++ b/run.py
@@ -0,0 +1,44 @@
+import asyncio
+import inspect
+from collections.abc import Awaitable, Callable
+
+
+async def run_tasks(
+    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int
+) -> None:
+    """Run a list of async task callables concurrently with a maximum concurrency limit.
+
+    Args:
+        tasks: A list of callables, each returning an Awaitable[None].
+        max_concurrent: The maximum number of tasks to run concurrently.
+
+    Raises:
+        ValueError: If max_concurrent is less than or equal to 0.
+    """
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be greater than 0")
+
+    queue: asyncio.Queue[Callable[[], Awaitable[None]]] = asyncio.Queue()
+    count = 0
+    for task in tasks:
+        queue.put_nowait(task)
+        count += 1
+
+    if count == 0:
+        return
+
+    num_workers = min(count, max_concurrent)
+
+    async def worker() -> None:
+        while True:
+            try:
+                task_fn = queue.get_nowait()
+            except asyncio.QueueEmpty:
+                break
+            res = task_fn()
+            if inspect.isawaitable(res):
+                await res
+
+    async with asyncio.TaskGroup() as tg:
+        for _ in range(num_workers):
+            tg.create_task(worker())
