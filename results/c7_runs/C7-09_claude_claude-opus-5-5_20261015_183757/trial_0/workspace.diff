+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+func headerHash(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: name},
+		},
+		Terminal: terminal,
+	}
+}
+
+func queryHash(name string) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+			QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: name},
+		},
+	}
+}
+
+func buildConsistentHash(t *testing.T, ch *kgateway.ConsistentHash) *consistentHashIR {
+	t.Helper()
+	out := &trafficPolicySpecIr{}
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: ch}, out))
+	return out.consistentHash
+}
+
+func assertHashPolicies(t *testing.T, expected []*envoyroutev3.RouteAction_HashPolicy, ch *consistentHashIR) {
+	t.Helper()
+	actual := ch.hashPolicies()
+	require.Len(t, actual, len(expected))
+	for i := range expected {
+		assert.True(t, proto.Equal(expected[i], actual[i]), "hash policy %d: expected %v, got %v", i, expected[i], actual[i])
+	}
+}
+
+func TestParseCookieTTL(t *testing.T) {
+	tests := []struct {
+		in      string
+		want    time.Duration
+		wantErr bool
+	}{
+		{in: "3600", want: time.Hour},
+		{in: "0", want: 0},
+		{in: "1h30m", want: 90 * time.Minute},
+		{in: "10s", want: 10 * time.Second},
+		{in: "-5", wantErr: true},
+		{in: "abc", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.in, func(t *testing.T) {
+			got, err := parseCookieTTL(tt.in)
+			if tt.wantErr {
+				assert.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
+
+func TestConstructConsistentHash(t *testing.T) {
+	t.Run("nil spec produces no IR", func(t *testing.T) {
+		assert.Nil(t, buildConsistentHash(t, nil))
+	})
+
+	t.Run("empty spec defaults to sourceIp", func(t *testing.T) {
+		ch := buildConsistentHash(t, &kgateway.ConsistentHash{})
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicyEntry(false).policy}, ch)
+	})
+
+	t.Run("disable produces no hash policies", func(t *testing.T) {
+		ch := buildConsistentHash(t, &kgateway.ConsistentHash{Disable: new(true)})
+		require.NotNil(t, ch)
+		assert.Nil(t, ch.hashPolicies())
+	})
+
+	t.Run("canonical order and case-insensitive header dedup", func(t *testing.T) {
+		ch := buildConsistentHash(t, &kgateway.ConsistentHash{
+			SourceIP:        &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}, {Name: "q", Terminal: new(true)}},
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Foo"},
+				{HeaderName: "x-foo", Terminal: new(true)},
+				{HeaderName: "x-bar"},
+			},
+		})
+		assertHashPolicies(t, []*envoyroutev3.RouteAction_HashPolicy{
+			headerHash("X-Foo", false),
+			headerHash("x-bar", false),
+			queryHash("q"),
+			sourceIPHashPolicyEntry(true).policy,
+		}, ch)
+	})
+
+	t.Run("invalid cookie ttl returns error", func(t *testing.T) {
+		out := &trafficPolicySpecIr{}
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHash{
+			Cookies: []kgateway.ConsistentHashCookie{{Name: "c", TTL: new("bogus")}},
+		}}, out)
+		assert.Error(t, err)
+	})
+}
+
+func TestMergeConsistentHash(t *testing.T) {
+	newPolicy := func(ch *consistentHashIR) *TrafficPolicy {
+		return &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: ch}}
+	}
+	hi := buildConsistentHash(t, &kgateway.ConsistentHash{
+		Headers:         []kgateway.ConsistentHashHeader{{HeaderName: "x-shared", Terminal: new(true)}},
+		QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+	})
+	lo := buildConsistentHash(t, &kgateway.ConsistentHash{
+		SourceIP: &kgateway.ConsistentHashSourceIP{},
+		Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "X-Shared"}, {HeaderName: "x-lo"}},
+	})
+	disabled := buildConsistentHash(t, &kgateway.ConsistentHash{Disable: new(true)})
+	unioned := []*envoyroutev3.RouteAction_HashPolicy{
+		headerHash("x-shared", true),
+		headerHash("x-lo", false),
+		queryHash("q"),
+	}
+
+	t.Run("augmented merge unions with p1 first", func(t *testing.T) {
+		p1 := newPolicy(hi)
+		origins := ir.MergeOrigins{}
+		mergeConsistentHash(p1, newPolicy(lo), &ir.AttachedPolicyRef{Name: "lo"}, nil,
+			policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, origins, TrafficPolicyMergeOpts{})
+		assertHashPolicies(t, unioned, p1.spec.consistentHash)
+		assert.Len(t, origins.Get("consistentHash"), 1)
+		// inputs must not be modified
+		assert.Len(t, hi.entries, 2)
+	})
+
+	t.Run("overridable merge unions with p2 first", func(t *testing.T) {
+		p1 := newPolicy(lo)
+		mergeConsistentHash(p1, newPolicy(hi), &ir.AttachedPolicyRef{Name: "hi"}, nil,
+			policy.MergeOptions{Strategy: policy.OverridableDeepMerge}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		assertHashPolicies(t, unioned, p1.spec.consistentHash)
+	})
+
+	t.Run("higher priority disable suppresses lower priority", func(t *testing.T) {
+		p1 := newPolicy(disabled)
+		mergeConsistentHash(p1, newPolicy(lo), &ir.AttachedPolicyRef{Name: "lo"}, nil,
+			policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		assert.Nil(t, p1.spec.consistentHash.hashPolicies())
+	})
+
+	t.Run("lower priority disable is ignored", func(t *testing.T) {
+		p1 := newPolicy(hi)
+		mergeConsistentHash(p1, newPolicy(disabled), &ir.AttachedPolicyRef{Name: "d"}, nil,
+			policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+		assert.True(t, p1.spec.consistentHash.Equals(hi))
+	})
+}
