+// mergeConsistentHash unions the hash policies of p1 and p2, giving precedence to the
+// higher-priority policy as determined by the merge strategy. A disabled policy with higher
+// priority suppresses all hash policies from the lower-priority policy.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	const fieldName = "consistentHash"
+	p1CH, p2CH := p1.spec.consistentHash, p2.spec.consistentHash
+	if p2CH == nil {
+		return
+	}
+	if p1CH == nil {
+		p1.spec.consistentHash = p2CH
+		mergeOrigins.SetOne(fieldName, p2Ref, p2MergeOrigins)
+		return
+	}
+
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		// p1 has higher priority
+		if p1CH.disable || p2CH.disable {
+			return
+		}
+		p1.spec.consistentHash = mergeConsistentHashIR(p1CH, p2CH)
+		mergeOrigins.Append(fieldName, p2Ref, p2MergeOrigins)
+
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		// p2 has higher priority
+		if p1CH.disable || p2CH.disable {
+			p1.spec.consistentHash = p2CH
+			mergeOrigins.SetOne(fieldName, p2Ref, p2MergeOrigins)
+			return
+		}
+		p1.spec.consistentHash = mergeConsistentHashIR(p2CH, p1CH)
+		mergeOrigins.Append(fieldName, p2Ref, p2MergeOrigins)
+
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", fieldName)
+	}
+}
+
