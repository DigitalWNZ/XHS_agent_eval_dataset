+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	for _, idx := range []*ShapeIndex{NewShapeIndex(), {}} {
+		var buf bytes.Buffer
+		if err := idx.Encode(&buf); err != nil {
+			t.Fatalf("Encode() error = %v", err)
+		}
+		if buf.Len() == 0 {
+			t.Fatalf("empty ShapeIndex encoded to 0 bytes")
+		}
+
+		var decoded ShapeIndex
+		if err := decoded.Decode(&buf); err != nil {
+			t.Fatalf("Decode() error = %v", err)
+		}
+		if !decoded.IsFresh() {
+			t.Errorf("decoded.IsFresh() = false, want true")
+		}
+		if decoded.Len() != 0 {
+			t.Errorf("decoded.Len() = %d, want 0", decoded.Len())
+		}
+		if decoded.NumEdges() != 0 {
+			t.Errorf("decoded.NumEdges() = %d, want 0", decoded.NumEdges())
+		}
+		if !decoded.Iterator().Done() {
+			t.Errorf("decoded.Iterator().Done() = false, want true")
+		}
+	}
+}
