+func TestShapeIndexEncodeDecodeUnbuilt(t *testing.T) {
+	idx := NewShapeIndex()
+	pv := PointVector(parsePoints("0:0, 1:1, 2:2"))
+	id0 := idx.Add(&pv)
+	id1 := idx.Add(makePolyline("0:0, 0:5, 5:5"))
+	id2 := idx.Add(makePolygon("10:10, 10:20, 20:20, 20:10", true))
+
+	if idx.IsFresh() {
+		t.Fatalf("expected index to be stale before Encode")
+	}
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error = %v", err)
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode() error = %v", err)
+	}
+
+	// Verify decoded index is already built and ready for queries/iteration without Build().
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded.IsFresh() = false, want true")
+	}
+	if len(decoded.cells) == 0 || len(decoded.cellMap) == 0 {
+		t.Fatalf("decoded spatial cell structure is empty: cells=%d, cellMap=%d", len(decoded.cells), len(decoded.cellMap))
+	}
+
+	assertShapesEqual(t, decoded.Shape(id0), idx.Shape(id0))
+	assertShapesEqual(t, decoded.Shape(id1), idx.Shape(id1))
+	assertShapesEqual(t, decoded.Shape(id2), idx.Shape(id2))
+
+	// Use NewShapeIndexIterator directly (which does not call maybeApplyUpdates) to verify cells exist.
+	rawIter := NewShapeIndexIterator(decoded)
+	if !rawIter.LocatePoint(parsePoint("15:15")) {
+		t.Errorf("LocatePoint(15:15) without Build() failed")
+	}
+
+	cpq := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+	if !cpq.Contains(parsePoint("15:15")) {
+		t.Errorf("ContainsPointQuery(15:15) = false, want true")
+	}
+	if cpq.Contains(parsePoint("50:50")) {
+		t.Errorf("ContainsPointQuery(50:50) = true, want false")
+	}
+
+	quadraticValidate(t, decoded)
+	testIteratorMethods(t, decoded)
+}
