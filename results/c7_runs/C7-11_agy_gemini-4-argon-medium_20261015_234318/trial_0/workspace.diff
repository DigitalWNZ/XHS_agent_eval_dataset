+func TestShapeIndexDecodeMalformed(t *testing.T) {
+	idx := NewShapeIndex()
+	pv := PointVector(parsePoints("0:0, 1:1"))
+	idx.Add(&pv)
+	idx.Add(makePolyline("0:0, 0:5, 5:5"))
+	idx.Add(makePolygon("10:10, 10:20, 20:20, 20:10", true))
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error = %v", err)
+	}
+	validBytes := buf.Bytes()
+
+	// 1. Nil reader and writer.
+	if err := idx.Encode(nil); err == nil {
+		t.Errorf("Encode(nil) = nil, want error")
+	}
+	var dst ShapeIndex
+	if err := dst.Decode(nil); err == nil {
+		t.Errorf("Decode(nil) = nil, want error")
+	}
+
+	// 2. Empty and truncated data at every byte offset.
+	for i := range len(validBytes) {
+		var d ShapeIndex
+		if err := d.Decode(bytes.NewReader(validBytes[:i])); err == nil {
+			t.Errorf("Decode(truncated[:%d]) = nil, want error", i)
+		}
+	}
+
+	// 3. Corrupted bytes at every byte position.
+	for i := range len(validBytes) {
+		corrupted := append([]byte(nil), validBytes...)
+		corrupted[i] ^= 0xff
+		var d ShapeIndex
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Errorf("Decode(corrupted at %d) = nil, want error", i)
+		}
+	}
+
+	// 4. Oversized allocation requests.
+	var hugeVarint [binary.MaxVarintLen64]byte
+	n := binary.PutUvarint(hugeVarint[:], math.MaxUint64)
+	var largeVarint [binary.MaxVarintLen64]byte
+	nLarge := binary.PutUvarint(largeVarint[:], 500000)
+
+	malformedInputs := [][]byte{
+		// Unsupported version
+		{0, 10, 0, 0, 0},
+		{2, 10, 0, 0, 0},
+		{255, 10, 0, 0, 0},
+		// Zero maxEdgesPerCell
+		{1, 0, 0, 0, 0},
+		// Huge maxEdgesPerCell
+		append([]byte{1}, hugeVarint[:n]...),
+		// Huge nextID
+		append([]byte{1, 10}, hugeVarint[:n]...),
+		// Huge numShapes
+		append(append([]byte{1, 10}, largeVarint[:nLarge]...), hugeVarint[:n]...),
+		// Medium-large numShapes on truncated stream (tests bounded slice/map pre-allocation)
+		append(append([]byte{1, 10}, largeVarint[:nLarge]...), largeVarint[:nLarge]...),
+		// Huge numCells on empty shapes
+		append([]byte{1, 10, 1, 0}, hugeVarint[:n]...),
+		// Polygon with huge loop count
+		{1, 10, 1, 1, 0, shapeKindPolygon, 0, 1, 1, 0, 0xff, 0xff, 0xff, 0x7f},
+		// LaxPolygon with huge loop count
+		append([]byte{1, 10, 1, 1, 0, shapeKindLaxPolygon}, hugeVarint[:n]...),
+		// Polyline with huge vertex count
+		append([]byte{1, 10, 1, 1, 0, shapeKindPolyline, 0}, hugeVarint[:n]...),
+		// Polyline with 40M vertex count on short stream
+		{1, 10, 1, 1, 0, shapeKindPolyline, 0, 0x80, 0x90, 0x89, 0x13},
+	}
+
+	for i, input := range malformedInputs {
+		var d ShapeIndex
+		if err := d.Decode(bytes.NewReader(input)); err == nil {
+			t.Errorf("malformedInputs[%d]: Decode() = nil, want error", i)
+		}
+	}
+}
