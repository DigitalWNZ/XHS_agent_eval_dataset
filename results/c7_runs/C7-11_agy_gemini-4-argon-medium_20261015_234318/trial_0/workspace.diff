+func TestShapeIndexEncodeDecodePreservesNonContiguousShapeIDs(t *testing.T) {
+	idx := NewShapeIndex()
+	s0 := makePolyline("0:0, 0:5")
+	s1 := makePolygon("10:10, 10:20, 20:20, 20:10", true)
+	s2 := makePolyline("5:5, 5:10")
+	s3 := makeLoop("-10:-10, -10:-5, -5:-5, -5:-10")
+
+	id0 := idx.Add(s0)
+	id1 := idx.Add(s1)
+	id2 := idx.Add(s2)
+	id3 := idx.Add(s3)
+
+	// Remove shapes 0 and 2 so surviving IDs are 1 and 3.
+	idx.Remove(s0)
+	idx.Remove(s2)
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error = %v", err)
+	}
+
+	var decoded ShapeIndex
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode() error = %v", err)
+	}
+
+	if decoded.Shape(id0) != nil {
+		t.Errorf("decoded.Shape(%d) = %v, want nil", id0, decoded.Shape(id0))
+	}
+	if decoded.Shape(id2) != nil {
+		t.Errorf("decoded.Shape(%d) = %v, want nil", id2, decoded.Shape(id2))
+	}
+	assertShapesEqual(t, decoded.Shape(id1), s1)
+	assertShapesEqual(t, decoded.Shape(id3), s3)
+
+	// Adding a new shape to decoded must receive ID 4 (nextID), not reuse 0 or 2.
+	s4 := makePolyline("1:1, 2:2")
+	if gotID := decoded.Add(s4); gotID != 4 {
+		t.Errorf("decoded.Add() = %d, want 4", gotID)
+	}
+}
