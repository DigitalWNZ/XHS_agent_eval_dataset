+func TestShapeIndexEncodeDecodeQueriesAndGenericShapes(t *testing.T) {
+	idx := NewShapeIndex()
+
+	// Add an edgeVectorShape (non-built-in test shape), a PointVector, a Polyline, and a Polygon.
+	evs := edgeVectorShapeFromPoints(parsePoint("0:0"), parsePoint("0:5"))
+	evs.Add(parsePoint("0:5"), parsePoint("5:5"))
+	idEVS := idx.Add(evs)
+
+	pv := PointVector(parsePoints("2:2, -5:-5"))
+	idPV := idx.Add(&pv)
+
+	poly := makePolyline("-2:2, 6:2")
+	idPoly := idx.Add(poly)
+
+	polygon := makePolygon("0:0, 0:10, 10:10, 10:0", true)
+	idPolygon := idx.Add(polygon)
+
+	// Build, remove a shape, add another shape, and encode without calling Build again.
+	idx.Build()
+	idx.Remove(&pv)
+	pv2 := PointVector(parsePoints("3:3, -8:-8"))
+	idPV2 := idx.Add(&pv2)
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error = %v", err)
+	}
+
+	var decoded ShapeIndex
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode() error = %v", err)
+	}
+
+	if !decoded.IsFresh() {
+		t.Fatalf("decoded.IsFresh() = false, want true")
+	}
+	if decoded.Shape(idPV) != nil {
+		t.Errorf("decoded.Shape(%d) = %v, want nil (was removed)", idPV, decoded.Shape(idPV))
+	}
+	assertShapesEqual(t, decoded.Shape(idEVS), evs)
+	assertShapesEqual(t, decoded.Shape(idPoly), poly)
+	assertShapesEqual(t, decoded.Shape(idPolygon), polygon)
+	assertShapesEqual(t, decoded.Shape(idPV2), &pv2)
+
+	// Verify ContainsPointQuery works without Build.
+	cpqOrig := NewContainsPointQuery(idx, VertexModelClosed)
+	cpqDec := NewContainsPointQuery(&decoded, VertexModelClosed)
+	for _, ptStr := range []string{"5:5", "3:3", "-8:-8", "20:20", "0:0"} {
+		pt := parsePoint(ptStr)
+		if got, want := cpqDec.Contains(pt), cpqOrig.Contains(pt); got != want {
+			t.Errorf("ContainsPointQuery(%s) = %v, want %v", ptStr, got, want)
+		}
+	}
+
+	// Verify CrossingEdgeQuery works without Build.
+	ceqOrig := NewCrossingEdgeQuery(idx)
+	ceqDec := NewCrossingEdgeQuery(&decoded)
+	a, b := parsePoint("-1:1"), parsePoint("1:1")
+	origCrossings := ceqOrig.Crossings(a, b, idx.Shape(idPoly), CrossingTypeAll)
+	decCrossings := ceqDec.Crossings(a, b, decoded.Shape(idPoly), CrossingTypeAll)
+	if !reflect.DeepEqual(decCrossings, origCrossings) {
+		t.Errorf("CrossingEdgeQuery.Crossings = %v, want %v", decCrossings, origCrossings)
+	}
+	origMap := ceqOrig.CrossingsEdgeMap(a, b, CrossingTypeAll)
+	decMap := ceqDec.CrossingsEdgeMap(a, b, CrossingTypeAll)
+	if len(decMap) != len(origMap) {
+		t.Errorf("len(CrossingsEdgeMap) = %d, want %d", len(decMap), len(origMap))
+	}
+
+	// Verify ClosestEdgeQuery and FurthestEdgeQuery work without Build.
+	target := NewMinDistanceToPointTarget(parsePoint("1:1"))
+	origClosest := NewClosestEdgeQuery(idx, nil).FindEdges(target)
+	decClosest := NewClosestEdgeQuery(&decoded, nil).FindEdges(target)
+	if !reflect.DeepEqual(decClosest, origClosest) {
+		t.Errorf("ClosestEdgeQuery.FindEdges = %v, want %v", decClosest, origClosest)
+	}
+
+	maxTarget := NewMaxDistanceToPointTarget(parsePoint("1:1"))
+	origFurthest := NewFurthestEdgeQuery(idx, nil).FindEdges(maxTarget)
+	decFurthest := NewFurthestEdgeQuery(&decoded, nil).FindEdges(maxTarget)
+	if !reflect.DeepEqual(decFurthest, origFurthest) {
+		t.Errorf("FurthestEdgeQuery.FindEdges = %v, want %v", decFurthest, origFurthest)
+	}
+
+	// Verify ShapeIndexRegion works without Build.
+	if got, want := decoded.Region().CellUnionBound(), idx.Region().CellUnionBound(); !reflect.DeepEqual(got, want) {
+		t.Errorf("Region().CellUnionBound() = %v, want %v", got, want)
+	}
+
+	quadraticValidate(t, &decoded)
+	testIteratorMethods(t, &decoded)
+}
