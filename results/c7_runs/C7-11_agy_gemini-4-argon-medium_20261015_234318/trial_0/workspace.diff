+		t.Fatalf("decoded.Len() = %d, want %d", decoded.Len(), idx.Len())
+	}
+	for _, id := range ids {
+		assertShapesEqual(t, decoded.Shape(id), idx.Shape(id))
+	}
+	quadraticValidate(t, &decoded)
+	testIteratorMethods(t, &decoded)
+}
