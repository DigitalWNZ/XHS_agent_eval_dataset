+		t.Errorf("Shape(%d) type = %T, want *LaxPolyline", idLaxPoly, decoded.Shape(idLaxPoly))
+	}
+	if _, ok := decoded.Shape(idLoop).(*Loop); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Loop", idLoop, decoded.Shape(idLoop))
+	}
+	if _, ok := decoded.Shape(idLaxLoop).(*LaxLoop); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxLoop", idLaxLoop, decoded.Shape(idLaxLoop))
+	}
+	if _, ok := decoded.Shape(idPolygon).(*Polygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *Polygon", idPolygon, decoded.Shape(idPolygon))
+	}
+	if _, ok := decoded.Shape(idLaxPolygon).(*LaxPolygon); !ok {
+		t.Errorf("Shape(%d) type = %T, want *LaxPolygon", idLaxPolygon, decoded.Shape(idLaxPolygon))
+	}
+
+	for _, id := range []int32{idPV, idPoly, idLaxPoly, idLoop, idLaxLoop, idPolygon, idLaxPolygon} {
+		assertShapesEqual(t, decoded.Shape(id), idx.Shape(id))
+		if !reflect.DeepEqual(decoded.Shape(id), idx.Shape(id)) {
+			t.Errorf("Shape(%d) DeepEqual mismatch: got %#v, want %#v", id, decoded.Shape(id), idx.Shape(id))
+		}
+	}
+
+	if !reflect.DeepEqual(decoded.cells, idx.cells) {
+		t.Errorf("decoded.cells = %v, want %v", decoded.cells, idx.cells)
+	}
+	if !reflect.DeepEqual(decoded.cellMap, idx.cellMap) {
+		t.Errorf("decoded.cellMap mismatch")
+	}
+
+	quadraticValidate(t, &decoded)
+	testIteratorMethods(t, &decoded)
+}
