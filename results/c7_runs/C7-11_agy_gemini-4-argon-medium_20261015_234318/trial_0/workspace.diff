+	multiChainPV := PointVector(parsePoints("0:0, 1:1, 2:2, 3:3, 4:4"))
+	multiChainLaxPoly := LaxPolygonFromPoints([][]Point{
+		{},
+		parsePoints("0:0"),
+		parsePoints("1:1, 2:2"),
+		parsePoints("10:10, 10:20, 20:20, 20:10"),
+	})
+
+	ids := []int32{
+		idx.Add(&emptyPV),
+		idx.Add(&emptyPoly),
+		idx.Add(&onePtPoly),
+		idx.Add(emptyLaxPoly),
+		idx.Add(onePtLaxPoly),
+		idx.Add(emptyLoop),
+		idx.Add(fullLoop),
+		idx.Add(emptyLaxLoop),
+		idx.Add(emptyPolygon),
+		idx.Add(fullPolygon),
+		idx.Add(emptyLaxPolygon),
+		idx.Add(fullLaxPolygon),
+		idx.Add(&multiChainPV),
+		idx.Add(multiChainLaxPoly),
+	}
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode() error = %v", err)
