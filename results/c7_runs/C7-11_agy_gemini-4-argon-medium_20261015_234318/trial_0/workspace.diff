+func assertShapesEqual(t *testing.T, got, want Shape) {
+	t.Helper()
+	if got == nil || want == nil {
+		if got != want {
+			t.Fatalf("shape nil mismatch: got %v, want %v", got, want)
+		}
+		return
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("Dimension() = %d, want %d", got.Dimension(), want.Dimension())
+	}
+	if got.typeTag() != want.typeTag() {
+		t.Errorf("typeTag() = %v, want %v", got.typeTag(), want.typeTag())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("IsEmpty() = %v, want %v", got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("IsFull() = %v, want %v", got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("ReferencePoint() = %v, want %v", got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Fatalf("NumEdges() = %d, want %d", got.NumEdges(), want.NumEdges())
+	}
+	for e := range want.NumEdges() {
+		if got.Edge(e) != want.Edge(e) {
+			t.Errorf("Edge(%d) = %v, want %v", e, got.Edge(e), want.Edge(e))
+		}
+		if got.ChainPosition(e) != want.ChainPosition(e) {
+			t.Errorf("ChainPosition(%d) = %v, want %v", e, got.ChainPosition(e), want.ChainPosition(e))
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Fatalf("NumChains() = %d, want %d", got.NumChains(), want.NumChains())
+	}
+	for c := range want.NumChains() {
+		chGot := got.Chain(c)
+		chWant := want.Chain(c)
+		if chGot != chWant {
+			t.Fatalf("Chain(%d) = %v, want %v", c, chGot, chWant)
+		}
+		for offset := range chWant.Length {
+			if got.ChainEdge(c, offset) != want.ChainEdge(c, offset) {
+				t.Errorf("ChainEdge(%d, %d) = %v, want %v", c, offset, got.ChainEdge(c, offset), want.ChainEdge(c, offset))
+			}
+		}
+	}
+}
