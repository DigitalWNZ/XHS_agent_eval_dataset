+
+type crcByteReader struct {
+	r byteReader
+	h hash.Hash32
+}
+
+func (c *crcByteReader) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	if n > 0 {
+		_, _ = c.h.Write(p[:n])
+	}
+	return n, err
+}
+
+func (c *crcByteReader) ReadByte() (byte, error) {
+	b, err := c.r.ReadByte()
+	if err == nil {
+		_, _ = c.h.Write([]byte{b})
+	}
+	return b, err
+}
+
+// genericShape is used to round-trip non-built-in Shape implementations (e.g. in tests).
+type genericShape struct {
+	dimension int
+	tag       typeTag
+	refPoint  ReferencePoint
+	isEmpty   bool
+	isFull    bool
+	edges     []Edge
+	chains    []Chain
+}
+
+func (g *genericShape) NumEdges() int                  { return len(g.edges) }
+func (g *genericShape) Edge(i int) Edge                { return g.edges[i] }
+func (g *genericShape) ReferencePoint() ReferencePoint { return g.refPoint }
+func (g *genericShape) NumChains() int                 { return len(g.chains) }
+func (g *genericShape) Chain(chainID int) Chain        { return g.chains[chainID] }
+func (g *genericShape) ChainEdge(chainID, offset int) Edge {
+	return g.edges[g.chains[chainID].Start+offset]
+}
+func (g *genericShape) ChainPosition(edgeID int) ChainPosition {
+	for c, ch := range g.chains {
+		if ch.Length > 0 && edgeID >= ch.Start && edgeID < ch.Start+ch.Length {
+			return ChainPosition{ChainID: c, Offset: edgeID - ch.Start}
+		}
+	}
+	return ChainPosition{ChainID: 0, Offset: edgeID}
+}
+func (g *genericShape) Dimension() int    { return g.dimension }
+func (g *genericShape) IsEmpty() bool     { return g.isEmpty }
+func (g *genericShape) IsFull() bool      { return g.isFull }
+func (g *genericShape) typeTag() typeTag  { return g.tag }
+func (g *genericShape) privateInterface() {}
+
+// Encode encodes the ShapeIndex to the given writer.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	if w == nil {
+		return errors.New("s2: cannot encode ShapeIndex to nil writer")
+	}
+	s.Build()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	hw := crc32.NewIEEE()
+	e := &encoder{w: io.MultiWriter(w, hw)}
+	s.encode(e)
+	if e.err != nil {
+		return e.err
+	}
+
+	trailer := &encoder{w: w}
+	trailer.writeUint32(hw.Sum32())
+	return trailer.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+
+	maxEdges := s.maxEdgesPerCell
+	if maxEdges <= 0 {
+		maxEdges = 10
+	}
+	e.writeUvarint(uint64(maxEdges))
+
+	shapeIDs := make([]int32, 0, len(s.shapes))
+	var maxShapeID int32 = -1
+	for id, shape := range s.shapes {
+		if shape == nil {
+			continue
+		}
+		shapeIDs = append(shapeIDs, id)
+		if id > maxShapeID {
+			maxShapeID = id
+		}
+	}
+	slices.Sort(shapeIDs)
+
+	nextID := s.nextID
+	if maxShapeID+1 > nextID {
+		nextID = maxShapeID + 1
+	}
+	if nextID < 0 {
+		nextID = 0
+	}
+	e.writeUvarint(uint64(nextID))
+	e.writeUvarint(uint64(len(shapeIDs)))
+
+	for _, id := range shapeIDs {
+		if e.err != nil {
+			return
+		}
+		if id < 0 {
+			e.err = fmt.Errorf("s2: invalid negative shape ID %d", id)
+			return
+		}
+		e.writeUvarint(uint64(id))
+		encodeShape(e, s.shapes[id])
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, cellID := range s.cells {
+		if e.err != nil {
+			return
+		}
+		e.writeUint64(uint64(cellID))
+		cell := s.cellMap[cellID]
+		if cell == nil {
+			e.writeUvarint(0)
+			continue
+		}
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+	}
+}
+
+func encodePointsSlice(e *encoder, pts []Point) {
+	e.writeBool(pts == nil)
+	e.writeUvarint(uint64(len(pts)))
+	for _, v := range pts {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+}
+
+func encodeShape(e *encoder, shape Shape) {
+	if e.err != nil {
+		return
+	}
+	switch s := shape.(type) {
+	case *Polygon:
+		e.writeUint8(shapeKindPolygon)
+		e.writeBool(s.loops == nil)
+		s.encodeLossless(e)
+	case *Polyline:
+		e.writeUint8(shapeKindPolyline)
+		encodePointsSlice(e, *s)
+	case *PointVector:
+		e.writeUint8(shapeKindPointVector)
+		encodePointsSlice(e, *s)
+	case *LaxPolyline:
+		e.writeUint8(shapeKindLaxPolyline)
+		encodePointsSlice(e, s.vertices)
+	case *LaxPolygon:
+		e.writeUint8(shapeKindLaxPolygon)
+		e.writeUvarint(uint64(s.numLoops))
+		for i := range s.numLoops {
+			nv := s.numLoopVertices(i)
+			e.writeUvarint(uint64(nv))
+			for j := range nv {
+				v := s.loopVertex(i, j)
+				e.writeFloat64(v.X)
+				e.writeFloat64(v.Y)
+				e.writeFloat64(v.Z)
+			}
+		}
+	case *Loop:
+		e.writeUint8(shapeKindLoop)
+		e.writeBool(s.vertices == nil)
+		s.encode(e)
+	case *LaxLoop:
+		e.writeUint8(shapeKindLaxLoop)
+		encodePointsSlice(e, s.vertices[:s.numVertices])
+	default:
+		e.writeUint8(shapeKindGeneric)
+		e.writeInt8(int8(shape.Dimension()))
+		e.writeUint32(uint32(shape.typeTag()))
+		ref := shape.ReferencePoint()
+		e.writeFloat64(ref.Point.X)
+		e.writeFloat64(ref.Point.Y)
+		e.writeFloat64(ref.Point.Z)
+		e.writeBool(ref.Contained)
+		e.writeBool(shape.IsEmpty())
+		e.writeBool(shape.IsFull())
+
+		numEdges := shape.NumEdges()
+		e.writeUvarint(uint64(numEdges))
+		for i := range numEdges {
+			edge := shape.Edge(i)
+			e.writeFloat64(edge.V0.X)
+			e.writeFloat64(edge.V0.Y)
+			e.writeFloat64(edge.V0.Z)
+			e.writeFloat64(edge.V1.X)
+			e.writeFloat64(edge.V1.Y)
+			e.writeFloat64(edge.V1.Z)
+		}
+
+		numChains := shape.NumChains()
+		e.writeUvarint(uint64(numChains))
+		for c := range numChains {
+			ch := shape.Chain(c)
+			e.writeUvarint(uint64(ch.Start))
+			e.writeUvarint(uint64(ch.Length))
+		}
+	}
+}
+
+// Decode decodes the ShapeIndex from the given reader.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	if r == nil {
+		return errors.New("s2: cannot decode ShapeIndex from nil reader")
+	}
+	cbr := &crcByteReader{
+		r: asByteReader(r),
+		h: crc32.NewIEEE(),
+	}
+	d := &decoder{r: cbr}
+
+	var decoded ShapeIndex
+	decoded.decode(d)
+	if d.err != nil {
+		return d.err
+	}
+
+	gotCRC := cbr.h.Sum32()
+	wantCRC := d.readUint32()
+	if d.err != nil {
+		return d.err
+	}
+	if gotCRC != wantCRC {
+		return fmt.Errorf("s2: ShapeIndex checksum mismatch (got %08x, want %08x)", gotCRC, wantCRC)
+	}
+
+	s.mu.Lock()
+	s.shapes = decoded.shapes
+	s.maxEdgesPerCell = decoded.maxEdgesPerCell
+	s.nextID = decoded.nextID
+	s.cellMap = decoded.cellMap
+	s.cells = decoded.cells
+	s.pendingAdditionsPos = decoded.pendingAdditionsPos
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+	s.mu.Unlock()
+	return nil
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: unsupported ShapeIndex version %d", version)
+		return
+	}
+
+	maxEdges := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if maxEdges == 0 || maxEdges > maxEncodedEdgesPerCell {
+		d.err = fmt.Errorf("s2: invalid maxEdgesPerCell %d", maxEdges)
+		return
+	}
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("s2: nextID too large (%d; max is %d)", nextID, maxEncodedShapes)
+		return
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numShapes > nextID {
+		d.err = fmt.Errorf("s2: numShapes (%d) exceeds nextID (%d)", numShapes, nextID)
+		return
+	}
+
+	shapes := make(map[int32]Shape, min(int(numShapes), 1024))
+	var prevShapeID int32 = -1
+	for i := range numShapes {
+		rawID := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if rawID >= nextID {
+			d.err = fmt.Errorf("s2: shapeID (%d) out of range [0, %d)", rawID, nextID)
+			return
+		}
+		id := int32(rawID)
+		if i > 0 && id <= prevShapeID {
+			d.err = fmt.Errorf("s2: shape IDs not strictly increasing (%d after %d)", id, prevShapeID)
+			return
+		}
+		prevShapeID = id
+
+		shape := decodeShape(d)
+		if d.err != nil {
+			return
+		}
+		shapes[id] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedCells {
+		d.err = fmt.Errorf("s2: too many cells (%d; max is %d)", numCells, maxEncodedCells)
+		return
+	}
+	if numCells > 0 && numShapes == 0 {
+		d.err = errors.New("s2: non-empty cells in index with no shapes")
+		return
+	}
+
+	cellMap := make(map[CellID]*ShapeIndexCell, min(int(numCells), 1024))
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(int(numCells), 1024))
+	}
+
+	for i := range numCells {
+		cellID := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("s2: invalid CellID %d in ShapeIndex", uint64(cellID))
+			return
+		}
+		if i > 0 && cells[i-1].RangeMax() >= cellID.RangeMin() {
+			d.err = fmt.Errorf("s2: non-disjoint or unsorted CellIDs in ShapeIndex (%v then %v)", cells[i-1], cellID)
+			return
+		}
+
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped == 0 || numClipped > numShapes {
+			d.err = fmt.Errorf("s2: invalid clipped shape count %d in cell", numClipped)
+			return
+		}
+
+		cell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, min(int(numClipped), 1024)),
+		}
+		var prevClippedShapeID int32 = -1
+		for j := range numClipped {
+			rawShapeID := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if rawShapeID >= nextID {
+				d.err = fmt.Errorf("s2: clipped shapeID %d out of range", rawShapeID)
+				return
+			}
+			shapeID := int32(rawShapeID)
+			if j > 0 && shapeID <= prevClippedShapeID {
+				d.err = fmt.Errorf("s2: clipped shape IDs not strictly increasing (%d after %d)", shapeID, prevClippedShapeID)
+				return
+			}
+			prevClippedShapeID = shapeID
+
+			shape, ok := shapes[shapeID]
+			if !ok || shape == nil {
+				d.err = fmt.Errorf("s2: clipped shape references unknown shapeID %d", shapeID)
+				return
+			}
+
+			containsCenter := readStrictBool(d)
+			if d.err != nil {
+				return
+			}
+			if containsCenter && shape.Dimension() != 2 {
+				d.err = fmt.Errorf("s2: containsCenter set on shape %d of dimension %d", shapeID, shape.Dimension())
+				return
+			}
+
+			numClippedEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			maxShapeEdges := uint64(shape.NumEdges())
+			if numClippedEdges > maxShapeEdges {
+				d.err = fmt.Errorf("s2: clipped edge count (%d) exceeds shape edge count (%d)", numClippedEdges, maxShapeEdges)
+				return
+			}
+			if numClippedEdges == 0 && !containsCenter {
+				d.err = fmt.Errorf("s2: empty clipped shape %d without containsCenter", shapeID)
+				return
+			}
+
+			edges := make([]int, 0, min(int(numClippedEdges), 1024))
+			prevEdgeID := -1
+			for k := range numClippedEdges {
+				rawEdgeID := d.readUvarint()
+				if d.err != nil {
+					return
+				}
+				if rawEdgeID >= maxShapeEdges {
+					d.err = fmt.Errorf("s2: clipped edgeID (%d) out of range [0, %d)", rawEdgeID, maxShapeEdges)
+					return
+				}
+				edgeID := int(rawEdgeID)
+				if k > 0 && edgeID <= prevEdgeID {
+					d.err = fmt.Errorf("s2: clipped edge IDs not strictly increasing (%d after %d)", edgeID, prevEdgeID)
+					return
+				}
+				prevEdgeID = edgeID
+				edges = append(edges, edgeID)
+			}
+
+			cell.shapes = append(cell.shapes, &clippedShape{
+				shapeID:        shapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		cells = append(cells, cellID)
+		cellMap[cellID] = cell
+	}
+
+	s.shapes = shapes
+	s.maxEdgesPerCell = int(maxEdges)
+	s.nextID = int32(nextID)
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+}
+
+func readStrictBool(d *decoder) bool {
+	if d.err != nil {
+		return false
+	}
+	b := d.readUint8()
+	if d.err != nil {
+		return false
+	}
+	if b > 1 {
+		d.err = fmt.Errorf("s2: invalid boolean value %d", b)
+		return false
+	}
+	return b == 1
+}
+
+func readStrictPoint(d *decoder) Point {
+	if d.err != nil {
+		return Point{}
+	}
+	x := d.readFloat64()
+	y := d.readFloat64()
+	z := d.readFloat64()
+	if d.err != nil {
+		return Point{}
+	}
+	if math.IsNaN(x) || math.IsInf(x, 0) || math.IsNaN(y) || math.IsInf(y, 0) || math.IsNaN(z) || math.IsInf(z, 0) {
+		d.err = errors.New("s2: non-finite point coordinates")
+		return Point{}
+	}
+	return Point{r3.Vector{X: x, Y: y, Z: z}}
+}
+
+func decodePointsSlice(d *decoder) []Point {
+	isNil := readStrictBool(d)
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("s2: too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+	if isNil && n != 0 {
+		d.err = errors.New("s2: nil slice flag set with non-zero length")
+		return nil
+	}
+	if n == 0 {
+		if isNil {
+			return nil
+		}
+		return []Point{}
+	}
+	pts := make([]Point, 0, min(int(n), 1024))
+	for range n {
+		pt := readStrictPoint(d)
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, pt)
+	}
+	return pts
+}
+
+func decodeRectStrict(r *Rect, d *decoder) {
+	r.decode(d)
+	if d.err != nil {
+		return
+	}
+	if math.IsNaN(r.Lat.Lo) || math.IsInf(r.Lat.Lo, 0) ||
+		math.IsNaN(r.Lat.Hi) || math.IsInf(r.Lat.Hi, 0) ||
+		math.IsNaN(r.Lng.Lo) || math.IsInf(r.Lng.Lo, 0) ||
+		math.IsNaN(r.Lng.Hi) || math.IsInf(r.Lng.Hi, 0) {
+		d.err = errors.New("s2: non-finite Rect bound coordinates")
+	}
+}
+
+func decodeLoopStrict(l *Loop, d *decoder, verticesNil bool) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: cannot decode Loop version %d", version)
+		return
+	}
+	nvertices := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if nvertices > maxEncodedVertices {
+		d.err = fmt.Errorf("s2: too many vertices (%d; max is %d)", nvertices, maxEncodedVertices)
+		return
+	}
+	if verticesNil && nvertices != 0 {
+		d.err = errors.New("s2: nil vertices flag set with non-zero vertex count")
+		return
+	}
+	if nvertices == 0 && verticesNil {
+		l.vertices = nil
+	} else {
+		l.vertices = make([]Point, 0, min(int(nvertices), 1024))
+		for range nvertices {
+			pt := readStrictPoint(d)
+			if d.err != nil {
+				return
+			}
+			l.vertices = append(l.vertices, pt)
+		}
+	}
+	l.originInside = readStrictBool(d)
+	depth := int(int32(d.readUint32()))
+	if d.err != nil {
+		return
+	}
+	if depth < 0 || depth > maxEncodedLoops {
+		d.err = fmt.Errorf("s2: invalid loop depth %d", depth)
+		return
+	}
+	l.depth = depth
+	decodeRectStrict(&l.bound, d)
+	if d.err != nil {
+		return
+	}
+	l.index = NewShapeIndex()
+	if nvertices == 0 && l.bound == (Rect{}) {
+		l.subregionBound = Rect{}
+	} else {
+		l.subregionBound = ExpandForSubregions(l.bound)
+	}
+	l.index.Add(l)
+}
+
+func decodePolygonStrict(p *Polygon, d *decoder, loopsNil bool) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: unsupported Polygon version %d", version)
+		return
+	}
+	ownsLoops := readStrictBool(d)
+	p.hasHoles = readStrictBool(d)
+	nloops := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if !ownsLoops {
+		d.err = errors.New("s2: invalid Polygon owns_loops value")
+		return
+	}
+	if nloops > maxEncodedLoops {
+		d.err = fmt.Errorf("s2: too many loops (%d; max is %d)", nloops, maxEncodedLoops)
+		return
+	}
+	if loopsNil && nloops != 0 {
+		d.err = errors.New("s2: nil loops flag set with non-zero loop count")
+		return
+	}
+	if nloops == 0 && loopsNil {
+		p.loops = nil
+	} else {
+		p.loops = make([]*Loop, 0, min(int(nloops), 1024))
+		for range nloops {
+			l := new(Loop)
+			decodeLoopStrict(l, d, false)
+			if d.err != nil {
+				return
+			}
+			if p.numVertices+len(l.vertices) > maxEncodedVertices {
+				d.err = fmt.Errorf("s2: total polygon vertices exceed max (%d)", maxEncodedVertices)
+				return
+			}
+			p.loops = append(p.loops, l)
+			p.numVertices += len(l.vertices)
+		}
+	}
+	decodeRectStrict(&p.bound, d)
+	if d.err != nil {
+		return
+	}
+	if nloops == 0 && p.bound == (Rect{}) {
+		p.subregionBound = Rect{}
+	} else {
+		p.subregionBound = ExpandForSubregions(p.bound)
+	}
+	p.initEdgesAndIndex()
+}
+
+func decodeShape(d *decoder) Shape {
+	kind := d.readUint8()
+	if d.err != nil {
+		return nil
+	}
+	switch kind {
+	case shapeKindPolygon:
+		loopsNil := readStrictBool(d)
+		if d.err != nil {
+			return nil
+		}
+		p := new(Polygon)
+		decodePolygonStrict(p, d, loopsNil)
+		return p
+	case shapeKindPolyline:
+		pts := decodePointsSlice(d)
+		if d.err != nil {
+			return nil
+		}
+		poly := Polyline(pts)
+		return &poly
+	case shapeKindPointVector:
+		pts := decodePointsSlice(d)
+		if d.err != nil {
+			return nil
+		}
+		pv := PointVector(pts)
+		return &pv
+	case shapeKindLaxPolyline:
+		pts := decodePointsSlice(d)
+		if d.err != nil {
+			return nil
+		}
+		return &LaxPolyline{vertices: pts}
+	case shapeKindLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numLoops > maxEncodedLoops {
+			d.err = fmt.Errorf("s2: too many loops in LaxPolygon (%d; max is %d)", numLoops, maxEncodedLoops)
+			return nil
+		}
+		loops := make([][]Point, 0, min(int(numLoops), 1024))
+		var totalVerts uint64
+		for range numLoops {
+			nv := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if nv > maxEncodedVertices || totalVerts+nv > maxEncodedVertices {
+				d.err = fmt.Errorf("s2: too many vertices in LaxPolygon (%d; max is %d)", nv, maxEncodedVertices)
+				return nil
+			}
+			totalVerts += nv
+			pts := make([]Point, 0, min(int(nv), 1024))
+			for range nv {
+				pt := readStrictPoint(d)
+				if d.err != nil {
+					return nil
+				}
+				pts = append(pts, pt)
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops)
+	case shapeKindLoop:
+		verticesNil := readStrictBool(d)
+		if d.err != nil {
+			return nil
+		}
+		l := new(Loop)
+		decodeLoopStrict(l, d, verticesNil)
+		return l
+	case shapeKindLaxLoop:
+		pts := decodePointsSlice(d)
+		if d.err != nil {
+			return nil
+		}
+		return &LaxLoop{
+			numVertices: len(pts),
+			vertices:    pts,
+		}
+	case shapeKindGeneric:
+		dim := int(d.readInt8())
+		tag := typeTag(d.readUint32())
+		refPt := readStrictPoint(d)
+		refContained := readStrictBool(d)
+		isEmpty := readStrictBool(d)
+		isFull := readStrictBool(d)
+		if d.err != nil {
+			return nil
+		}
+		if dim < 0 || dim > 2 {
+			d.err = fmt.Errorf("s2: invalid shape dimension %d", dim)
+			return nil
+		}
+		if refContained && dim != 2 {
+			d.err = fmt.Errorf("s2: non-polygon shape with contained reference point")
+			return nil
+		}
+
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > maxEncodedVertices {
+			d.err = fmt.Errorf("s2: too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+			return nil
+		}
+		edges := make([]Edge, 0, min(int(numEdges), 1024))
+		for range numEdges {
+			v0 := readStrictPoint(d)
+			v1 := readStrictPoint(d)
+			if d.err != nil {
+				return nil
+			}
+			edges = append(edges, Edge{V0: v0, V1: v1})
+		}
+
+		numChains := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numChains > maxEncodedLoops {
+			d.err = fmt.Errorf("s2: too many chains (%d; max is %d)", numChains, maxEncodedLoops)
+			return nil
+		}
+		chains := make([]Chain, 0, min(int(numChains), 1024))
+		for range numChains {
+			start := d.readUvarint()
+			length := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if start > numEdges || length > numEdges-start {
+				d.err = fmt.Errorf("s2: invalid chain (%d, %d) for %d edges", start, length, numEdges)
+				return nil
+			}
+			chains = append(chains, Chain{Start: int(start), Length: int(length)})
+		}
+
+		return &genericShape{
+			dimension: dim,
+			tag:       tag,
+			refPoint:  ReferencePoint{Point: refPt, Contained: refContained},
+			isEmpty:   isEmpty,
+			isFull:    isFull,
+			edges:     edges,
+			chains:    chains,
+		}
+	default:
+		d.err = fmt.Errorf("s2: unknown shape kind %d", kind)
+		return nil
+	}
+}
