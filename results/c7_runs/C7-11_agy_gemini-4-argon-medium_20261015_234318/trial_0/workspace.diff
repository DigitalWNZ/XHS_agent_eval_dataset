+const (
+	shapeKindPolygon uint8 = iota + 1
+	shapeKindPolyline
+	shapeKindPointVector
+	shapeKindLaxPolyline
+	shapeKindLaxPolygon
+	shapeKindLoop
+	shapeKindLaxLoop
+	shapeKindGeneric
+
