+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue?: NoInfer<ExtractWindowValueType<T>> | SQLWrapper | null,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		return new WindowFunctionBuilder(
+			sql`lag(${expression}, ${sql.raw(String(resolvedOffset))}, ${formatPositionalArg(defaultValue, expression)})`,
+			decoder,
+		);
+	}
+	if (offset !== undefined) {
+		return new WindowFunctionBuilder(
+			sql`lag(${expression}, ${sql.raw(String(offset))})`,
+			decoder,
+		);
+	}
+	return new WindowFunctionBuilder(sql`lag(${expression})`, decoder);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NoInfer<Exclude<ExtractWindowValueType<T>, null | undefined>> | SQLWrapper,
+): WindowFunctionBuilder<Exclude<ExtractWindowValueType<T>, null | undefined>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue?: NoInfer<ExtractWindowValueType<T>> | SQLWrapper | null,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	const decoder = getExpressionDecoder(expression);
+	if (defaultValue !== undefined) {
+		const resolvedOffset = offset ?? 1;
+		return new WindowFunctionBuilder(
+			sql`lead(${expression}, ${sql.raw(String(resolvedOffset))}, ${formatPositionalArg(defaultValue, expression)})`,
+			decoder,
+		);
+	}
+	if (offset !== undefined) {
+		return new WindowFunctionBuilder(
+			sql`lead(${expression}, ${sql.raw(String(offset))})`,
+			decoder,
+		);
+	}
+	return new WindowFunctionBuilder(sql`lead(${expression})`, decoder);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null> {
+	return new WindowFunctionBuilder(sql`first_value(${expression})`, getExpressionDecoder(expression));
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null> {
+	return new WindowFunctionBuilder(sql`last_value(${expression})`, getExpressionDecoder(expression));
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<ExtractWindowValueType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() requires a positive integer, received ${n}`);
+	}
+	return new WindowFunctionBuilder(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`, String);
+}
+
+export type WindowMinMaxReturnType<T extends SQLWrapper> =
+	| (T extends AnyColumn ? T['_']['data']
+		: T extends SQL<infer U> ? (unknown extends U ? string : U)
+		: T extends SQL.Aliased<infer U> ? (unknown extends U ? string : U)
+		: string)
+	| null;
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<WindowMinMaxReturnType<T>> {
+	return new WindowFunctionBuilder<WindowMinMaxReturnType<T>>(
+		sql`min(${expression})`,
+		(is(expression, Column) ? expression : String) as any,
+	);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<WindowMinMaxReturnType<T>> {
+	return new WindowFunctionBuilder<WindowMinMaxReturnType<T>>(
+		sql`max(${expression})`,
+		(is(expression, Column) ? expression : String) as any,
+	);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`count(${expression || sql.raw('*')})`, Number);
+}
