+
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder: DriverValueDecoder<T, any> | DriverValueDecoder<T, any>['mapFromDriverValue'] =
+			noopDecoder,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			return sql`${this.fnSql} over ${sql.identifier(spec)}`.mapWith(this.decoder) as SQL<T>;
+		}
+
+		return sql`${this.fnSql} over ${buildWindowSpecSQL(spec)}`.mapWith(this.decoder) as SQL<T>;
+	}
