+
+export type ExtractWindowValueType<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+function getExpressionDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+function formatPositionalArg(value: unknown, expression: SQLWrapper): SQLChunk {
+	if (typeof value === 'number') {
+		return sql.raw(String(value));
+	}
+	if (value === null) {
+		return sql.raw('null');
+	}
+	return bindIfParam(value, expression);
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
