+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy"}
+
+	buildPolicyAtt := func(name string, priority int, inheritedPriority apiannotations.InheritedPolicyPriorityValue, ch kgateway.ConsistentHash) ir.PolicyAtt {
+		var outSpec trafficPolicySpecIr
+		err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: &ch}, &outSpec)
+		require.NoError(t, err)
+		return ir.PolicyAtt{
+			GroupKind:               gk,
+			HierarchicalPriority:    priority,
+			InheritedPolicyPriority: inheritedPriority,
+			PolicyRef: &ir.AttachedPolicyRef{
+				Group:     gk.Group,
+				Kind:      gk.Kind,
+				Namespace: "default",
+				Name:      name,
+			},
+			PolicyIr: &TrafficPolicy{
+				ct:   time.Now(),
+				spec: outSpec,
+			},
+		}
+	}
+
+	t.Run("multiple policies union arrays with higher-priority first, deduplicate, re-sort into canonical order, and retain higher-priority sourceIp even when unset", func(t *testing.T) {
+		// Higher priority policy has headers ["X-Header-A", "X-Shared"], queryParameters ["qp1"], and NO sourceIp (unset)
+		highPol := buildPolicyAtt("high-pol", 0, "", kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Header-A", Terminal: new(false)},
+				{HeaderName: "X-Shared", Terminal: new(true)},
+			},
+			QueryParameters: []kgateway.ConsistentHashQueryParameter{
+				{Name: "qp1", Terminal: new(false)},
+			},
+		})
+		// Lower priority policy has headers ["x-shared", "X-Header-B"], cookies ["c1"], filterState ["fs1"], and sourceIp {terminal: true}
+		lowPol := buildPolicyAtt("low-pol", 0, "", kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared", Terminal: new(false)},
+				{HeaderName: "X-Header-B", Terminal: new(true)},
+			},
+			Cookies: []kgateway.ConsistentHashCookie{
+				{Name: "c1"},
+			},
+			FilterState: []kgateway.ConsistentHashFilterState{
+				{Key: "fs1"},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{
+				Terminal: new(true),
+			},
+		})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{highPol, lowPol}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+
+		expected := []*envoyroutev3.RouteAction_HashPolicy{
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Header-A"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Shared"},
+				},
+				Terminal: true,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Header-B"},
+				},
+				Terminal: true,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+					Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{Name: "c1"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+					QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: "qp1"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+					FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{Key: "fs1"},
+				},
+				Terminal: false,
+			},
+		}
+		assertHashPoliciesEqual(t, expected, tp.spec.consistentHash.policies)
+		assert.Nil(t, tp.spec.consistentHash.sourceIp)
+
+		// Merge metadata must record consistentHash
+		origins := merged.MergeOrigins.Get("consistentHash")
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/high-pol",
+			"gateway.kgateway.dev/TrafficPolicy/default/low-pol",
+		}, origins)
+	})
+
+	t.Run("higher-priority sourceIp is retained when set", func(t *testing.T) {
+		highPol := buildPolicyAtt("high-pol", 0, "", kgateway.ConsistentHash{
+			SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(false)},
+		})
+		lowPol := buildPolicyAtt("low-pol", 0, "", kgateway.ConsistentHash{
+			Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "X-H1"}},
+			SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+		})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{highPol, lowPol}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+
+		expected := []*envoyroutev3.RouteAction_HashPolicy{
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-H1"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+					ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{SourceIp: true},
+				},
+				Terminal: false,
+			},
+		}
+		assertHashPoliciesEqual(t, expected, tp.spec.consistentHash.policies)
+	})
+
+	t.Run("disable=true in child policy suppresses inherited hash policies from broader-scoped policy", func(t *testing.T) {
+		childPol := buildPolicyAtt("child-pol", 0, "", kgateway.ConsistentHash{
+			Disable: new(true),
+		})
+		parentPol := buildPolicyAtt("parent-pol", -1, "", kgateway.ConsistentHash{
+			Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "X-Parent"}},
+			SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+		})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{childPol, parentPol}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+		assert.True(t, tp.spec.consistentHash.disable)
+		assert.Empty(t, tp.spec.consistentHash.policies)
+
+		route := &envoyroutev3.Route{
+			Action: &envoyroutev3.Route_Route{
+				Route: &envoyroutev3.RouteAction{},
+			},
+		}
+		applyConsistentHash(tp.spec.consistentHash, route)
+		assert.Nil(t, route.GetRoute().GetHashPolicy())
+		assert.ElementsMatch(t, []string{
+			"gateway.kgateway.dev/TrafficPolicy/default/child-pol",
+		}, merged.MergeOrigins.Get("consistentHash"))
+	})
+
+	t.Run("OverridableShallowMerge (ShallowMergePreferParent) gives parent priority", func(t *testing.T) {
+		childPol := buildPolicyAtt("child-pol", 0, apiannotations.ShallowMergePreferParent, kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "X-Shared", Terminal: new(false)},
+				{HeaderName: "X-Child", Terminal: new(true)},
+			},
+			SourceIP: &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+		})
+		parentPol := buildPolicyAtt("parent-pol", -1, apiannotations.ShallowMergePreferParent, kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{HeaderName: "x-shared", Terminal: new(true)},
+				{HeaderName: "X-Parent", Terminal: new(false)},
+			},
+		})
+
+		merged := policy.MergePolicies([]ir.PolicyAtt{childPol, parentPol}, mergeTrafficPolicies, "")
+		tp := merged.PolicyIr.(*TrafficPolicy)
+		require.NotNil(t, tp.spec.consistentHash)
+
+		expected := []*envoyroutev3.RouteAction_HashPolicy{
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "x-shared"},
+				},
+				Terminal: true,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Parent"},
+				},
+				Terminal: false,
+			},
+			{
+				PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+					Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: "X-Child"},
+				},
+				Terminal: true,
+			},
+		}
+		assertHashPoliciesEqual(t, expected, tp.spec.consistentHash.policies)
+		assert.Nil(t, tp.spec.consistentHash.sourceIp)
+	})
+}
+
+func TestConsistentHashEqualsAndValidate(t *testing.T) {
+	var spec1, spec2 trafficPolicySpecIr
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "X-Test",
+					RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+						Pattern:      "^a+$",
+						Substitution: "b",
+					},
+				},
+			},
+		},
+	}, &spec1))
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "X-Test",
+					RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+						Pattern:      "^a+$",
+						Substitution: "b",
+					},
+				},
+			},
+		},
+	}, &spec2))
+
+	assert.True(t, spec1.consistentHash.Equals(spec2.consistentHash))
+	assert.NoError(t, spec1.consistentHash.Validate())
+
+	var invalidRegexSpec trafficPolicySpecIr
+	require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+		ConsistentHash: &kgateway.ConsistentHash{
+			Headers: []kgateway.ConsistentHashHeader{
+				{
+					HeaderName: "X-Test",
+					RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+						Pattern:      "[invalid-regex",
+						Substitution: "b",
+					},
+				},
+			},
+		},
+	}, &invalidRegexSpec))
+	assert.Error(t, invalidRegexSpec.consistentHash.Validate())
+}
