+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "example.com"
+  rules:
+    - name: rule-merged
+      matches:
+        - path:
+            type: PathPrefix
+            value: /merged
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: rule-disabled
+      matches:
+        - path:
+            type: PathPrefix
+            value: /disabled
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: rule-default
+      matches:
+        - path:
+            type: PathPrefix
+            value: /default
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-level-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+  consistentHash:
+    headers:
+      - headerName: x-shared-header
+        terminal: false
+      - headerName: x-route-header
+        terminal: true
+    cookies:
+      - name: session-cookie
+        ttl: 1h30m
+        path: /merged
+        attributes:
+          - name: SameSite
+            value: Strict
+          - name: Secure
+        terminal: false
+    filterState:
+      - key: envoy.network.transport_socket.original_dst_address
+        terminal: false
+    sourceIp:
+      terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-merged-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule-merged
+  consistentHash:
+    headers:
+      - headerName: X-Shared-Header
+        regexRewrite:
+          pattern: "^prefix-(.*)$"
+          substitution: "\\1"
+        terminal: true
+      - headerName: X-Rule-Header
+    queryParameters:
+      - name: user_id
+        terminal: false
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-disabled-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: rule-disabled
+  consistentHash:
+    disable: true
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: consistent-hash-empty-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "empty.example.com"
+  rules:
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: empty-consistent-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-empty-route
+  consistentHash: {}
