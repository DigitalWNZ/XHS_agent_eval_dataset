+    def test_nested_prefetch_same_relation_deferred_fields(self):
+        house = House.objects.create(name='My House', address='123 Main St')
+        room = Room.objects.create(name='Living Room', house=house)
+        house.main_room = room
+        house.save()
+
+        # ForeignKey relation back to parent
+        queryset = House.objects.only('address').prefetch_related(
+            Prefetch(
+                'rooms',
+                queryset=Room.objects.prefetch_related(
+                    Prefetch('house', queryset=House.objects.only('name'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            fetched_house = queryset.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(fetched_house.rooms.all()[0].house.name, 'My House')
+
+        # OneToOne relation back to parent
+        queryset = Room.objects.only('name').prefetch_related(
+            Prefetch(
+                'main_room_of',
+                queryset=House.objects.prefetch_related(
+                    Prefetch('main_room', queryset=Room.objects.only('name'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            fetched_room = queryset.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(fetched_room.main_room_of.main_room.name, 'Living Room')
