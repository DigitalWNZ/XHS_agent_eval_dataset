+
+    def test_prefetch_deferred_fields_foreign_key(self):
+        house = House.objects.create(name='Villa', address='123 Main St')
+        Room.objects.create(name='Living Room', house=house)
+        qs = House.objects.only('name').prefetch_related(
+            Prefetch(
+                'rooms',
+                queryset=Room.objects.prefetch_related(
+                    Prefetch('house', queryset=House.objects.only('address'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            house = qs.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(house.rooms.all()[0].house.address, '123 Main St')
+            self.assertEqual(
+                house.rooms.all()[0].house.get_deferred_fields(),
+                {'name', 'owner_id', 'main_room_id'},
+            )
+
+    def test_prefetch_deferred_fields_one_to_one(self):
+        author = Author.objects.create(name='Charlotte_Unique', first_book=self.book1)
+        Bio.objects.create(author=author)
+        qs = Author.objects.filter(id=author.id).only('name').prefetch_related(
+            Prefetch(
+                'bio',
+                queryset=Bio.objects.prefetch_related(
+                    Prefetch('author', queryset=Author.objects.only('name', 'first_book'))
+                ),
+            )
+        )
+        with self.assertNumQueries(3):
+            author = qs.first()
+        with self.assertNumQueries(0):
+            self.assertEqual(author.bio.author.first_book_id, self.book1.id)
