+		tag := shape.typeTag()
+		if tag == typeTagNone {
+			e.err = fmt.Errorf("cannot encode shape with typeTagNone (%T)", shape)
+			return
+		}
+		encodable, ok := shape.(encodableShape)
+		if !ok {
