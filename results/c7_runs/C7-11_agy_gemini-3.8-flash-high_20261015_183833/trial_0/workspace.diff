+
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func decodeShape(tag typeTag, r io.Reader) (Shape, error) {
+	switch tag {
+	case typeTagPolygon:
+		p := &Polygon{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPolyline:
+		p := &Polyline{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagPointVector:
+		p := &PointVector{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLaxPolyline:
+		l := &LaxPolyline{}
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	case typeTagLaxPolygon:
+		p := &LaxPolygon{}
+		if err := p.Decode(r); err != nil {
+			return nil, err
+		}
+		return p, nil
+	case typeTagLoop:
+		l := &Loop{}
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	case typeTagLaxLoop:
+		l := &LaxLoop{}
+		if err := l.Decode(r); err != nil {
+			return nil, err
+		}
+		return l, nil
+	default:
+		return nil, fmt.Errorf("unsupported shape type tag %d", tag)
+	}
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != shapeIndexEncodingVersion {
+		d.err = fmt.Errorf("unsupported ShapeIndex version %d; expected %d", version, shapeIndexEncodingVersion)
+		return
+	}
+
+	maxEdges := d.readInt32()
+	if d.err != nil {
+		return
+	}
+	if maxEdges <= 0 || maxEdges > maxEdgesPerCellLimit {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell %d (must be in range (0, %d])", maxEdges, maxEdgesPerCellLimit)
+		return
+	}
+
+	nextID := d.readInt32()
+	if d.err != nil {
+		return
+	}
+	if nextID < 0 || nextID > maxNextIDLimit {
+		d.err = fmt.Errorf("invalid nextID %d", nextID)
+		return
+	}
+
+	numShapes := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxShapeIndexShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxShapeIndexShapes)
+		return
+	}
+	if int32(numShapes) > nextID {
+		d.err = fmt.Errorf("numShapes %d exceeds nextID %d", numShapes, nextID)
+		return
+	}
+
+	s.shapes = make(map[int32]Shape, min(numShapes, 1024))
+	for i := uint32(0); i < numShapes; i++ {
+		shapeID := d.readInt32()
+		if d.err != nil {
+			return
+		}
+		if shapeID < 0 || shapeID >= nextID {
+			d.err = fmt.Errorf("invalid shape ID %d (must be in range [0, %d))", shapeID, nextID)
+			return
+		}
+		if _, exists := s.shapes[shapeID]; exists {
+			d.err = fmt.Errorf("duplicate shape ID %d", shapeID)
+			return
+		}
+
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return
+		}
+
+		shape, err := decodeShape(tag, d.r)
+		if err != nil {
+			d.err = fmt.Errorf("failed to decode shape ID %d: %w", shapeID, err)
+			return
+		}
+		s.shapes[shapeID] = shape
+	}
+
+	numCells := d.readUint32()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxShapeIndexCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxShapeIndexCells)
+		return
+	}
+
+	s.cells = make([]CellID, 0, min(numCells, 1024))
+	s.cellMap = make(map[CellID]*ShapeIndexCell, min(numCells, 1024))
+
+	for i := uint32(0); i < numCells; i++ {
+		var cellID CellID
+		cellID.decode(d)
+		if d.err != nil {
+			return
+		}
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID: %v", cellID)
+			return
+		}
+		if len(s.cells) > 0 && cellID <= s.cells[len(s.cells)-1] {
+			d.err = fmt.Errorf("cell IDs are not strictly increasing: %v <= %v", cellID, s.cells[len(s.cells)-1])
+			return
+		}
+
+		numClipped := d.readUint32()
+		if d.err != nil {
+			return
+		}
+		if numClipped == 0 {
+			d.err = fmt.Errorf("cell %v has 0 clipped shapes", cellID)
+			return
+		}
+		if numClipped > maxClippedShapesPerCell {
+			d.err = fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numClipped, maxClippedShapesPerCell)
+			return
+		}
+
+		cell := &ShapeIndexCell{
+			shapes: make([]*clippedShape, 0, min(numClipped, 64)),
+		}
+
+		for j := uint32(0); j < numClipped; j++ {
+			cShapeID := d.readInt32()
+			containsCenter := d.readBool()
+			numEdges := d.readUint32()
+			if d.err != nil {
+				return
+			}
+
+			shape, ok := s.shapes[cShapeID]
+			if !ok {
+				d.err = fmt.Errorf("clipped shape references unknown shape ID %d", cShapeID)
+				return
+			}
+			if len(cell.shapes) > 0 && cShapeID <= cell.shapes[len(cell.shapes)-1].shapeID {
+				d.err = fmt.Errorf("clipped shape IDs not strictly increasing in cell: %d <= %d", cShapeID, cell.shapes[len(cell.shapes)-1].shapeID)
+				return
+			}
+			if numEdges == 0 && !containsCenter {
+				d.err = fmt.Errorf("clipped shape ID %d has 0 edges and containsCenter is false", cShapeID)
+				return
+			}
+			if numEdges > maxEdgesPerClippedShape {
+				d.err = fmt.Errorf("too many edges in clipped shape (%d; max is %d)", numEdges, maxEdgesPerClippedShape)
+				return
+			}
+
+			shapeNumEdges := shape.NumEdges()
+			edges := make([]int, 0, min(numEdges, 64))
+			for k := uint32(0); k < numEdges; k++ {
+				edgeID := int(d.readInt32())
+				if d.err != nil {
+					return
+				}
+				if edgeID < 0 || edgeID >= shapeNumEdges {
+					d.err = fmt.Errorf("edge ID %d out of range [0, %d)", edgeID, shapeNumEdges)
+					return
+				}
+				if len(edges) > 0 && edgeID <= edges[len(edges)-1] {
+					d.err = fmt.Errorf("edge IDs not strictly increasing in clipped shape: %d <= %d", edgeID, edges[len(edges)-1])
+					return
+				}
+				edges = append(edges, edgeID)
+			}
+
+			cell.shapes = append(cell.shapes, &clippedShape{
+				shapeID:        cShapeID,
+				containsCenter: containsCenter,
+				edges:          edges,
+			})
+		}
+
+		s.cells = append(s.cells, cellID)
+		s.cellMap[cellID] = cell
+	}
+
+	s.maxEdgesPerCell = int(maxEdges)
+	s.nextID = nextID
+	s.pendingAdditionsPos = nextID
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+}
