+func TestShapeIndexSpatialQueriesWithoutBuild(t *testing.T) {
+	orig := NewShapeIndex()
+	// Add a polygon with a hole
+	poly := makePolygon("0:0, 0:20, 20:20, 20:0; 5:5, 5:15, 15:15, 15:5", false)
+	orig.Add(poly)
+	orig.Build()
+
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	// 1. Point containment query without Build
+	query := NewContainsPointQuery(dec, VertexModelSemiOpen)
+	// Inside the polygon outer shell, outside the hole: (2, 2)
+	inPt := PointFromLatLng(LatLngFromDegrees(2, 2))
+	if !query.Contains(inPt) {
+		t.Fatalf("Contains(2, 2) expected true, got false")
+	}
+	// Inside the hole: (10, 10)
+	holePt := PointFromLatLng(LatLngFromDegrees(10, 10))
+	if query.Contains(holePt) {
+		t.Fatalf("Contains(10, 10) inside hole expected false, got true")
+	}
+	// Outside the polygon: (25, 25)
+	outPt := PointFromLatLng(LatLngFromDegrees(25, 25))
+	if query.Contains(outPt) {
+		t.Fatalf("Contains(25, 25) expected false, got true")
+	}
+
+	// 2. Iterator LocatePoint without Build
+	it := dec.Iterator()
+	if !it.LocatePoint(inPt) {
+		t.Fatalf("LocatePoint(2, 2) failed")
+	}
+	if it.Done() {
+		t.Fatalf("iterator should not be Done after LocatePoint")
+	}
+
+	// 3. ShapeIndexRegion bounds without Build
+	regOrig := orig.Region()
+	regDec := dec.Region()
+	if regOrig.CapBound() != regDec.CapBound() {
+		t.Fatalf("CapBound mismatch: orig=%v, dec=%v", regOrig.CapBound(), regDec.CapBound())
+	}
+	if regOrig.RectBound() != regDec.RectBound() {
+		t.Fatalf("RectBound mismatch: orig=%v, dec=%v", regOrig.RectBound(), regDec.RectBound())
+	}
+
+	// 4. LocateCellID without Build
+	targetCellID := cellIDFromPoint(inPt)
+	rel := dec.Iterator().LocateCellID(targetCellID)
+	if rel == Disjoint {
+		t.Fatalf("LocateCellID returned Disjoint for indexed point")
+	}
+}
