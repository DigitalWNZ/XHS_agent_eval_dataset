+func TestShapeIndexShapeIDsSurviveEncoding(t *testing.T) {
+	orig := NewShapeIndex()
+	s0 := (*PointVector)(&[]Point{PointFromCoords(1, 0, 0)})
+	s1 := makePolyline("0:0, 0:10")
+	s2 := makePolygon("20:20, 20:30, 30:30, 30:20", false)
+
+	id0 := orig.Add(s0)
+	id1 := orig.Add(s1)
+	id2 := orig.Add(s2)
+	orig.Build()
+
+	// Remove shape 1
+	orig.Remove(s1)
+	orig.Build()
+
+	if orig.Shape(id1) != nil {
+		t.Fatalf("expected shape %d to be nil after Remove", id1)
+	}
+
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	if dec.Shape(id0) == nil {
+		t.Fatalf("shape ID %d should exist in decoded index", id0)
+	}
+	if dec.Shape(id1) != nil {
+		t.Fatalf("shape ID %d should NOT exist in decoded index", id1)
+	}
+	if dec.Shape(id2) == nil {
+		t.Fatalf("shape ID %d should exist in decoded index", id2)
+	}
+
+	checkIndexesEqual(t, orig, dec)
+
+	// Verify cell references point to correct shapes
+	it := dec.Iterator()
+	for !it.Done() {
+		cell := it.IndexCell()
+		for _, cs := range cell.shapes {
+			if cs.shapeID == id1 {
+				t.Fatalf("cell references removed shape ID %d", id1)
+			}
+			if cs.shapeID != id0 && cs.shapeID != id2 {
+				t.Fatalf("cell references unexpected shape ID %d", cs.shapeID)
+			}
+			shape := dec.Shape(cs.shapeID)
+			if shape == nil {
+				t.Fatalf("cell shape ID %d does not resolve in decoded index", cs.shapeID)
+			}
+		}
+		it.Next()
+	}
