+	orig.Add(LaxPolylineFromPoints([]Point{}))        // 0 edges, 0 chains
+	orig.Add(LaxPolylineFromPoints(parsePoints("0:0"))) // 1 pt => 0 edges, 0 chains
+	orig.Add(LaxPolygonFromPoints([][]Point{}))       // 0 edges, 0 chains
+	orig.Add(LaxPolygonFromPoints([][]Point{[]Point{}})) // 1 full loop => 0 edges, 1 chain
+	orig.Add(LaxPolygonFromPoints([][]Point{[]Point{}, []Point{}})) // 2 full loops => 0 edges, 2 chains
+	orig.Add(LaxLoopFromPoints([]Point{}))            // 0 edges, 0 chains
+
+	// Mixed chain counts with edges
+	orig.Add(LaxPolygonFromPoints([][]Point{
+		parsePoints("0:0, 0:10, 10:10, 10:0"),
+		parsePoints("2:2, 2:5, 5:5, 5:2"),
+		[]Point{}, // full loop mixed in
+	}))
+
+	orig.Build()
+
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	checkIndexesEqual(t, orig, dec)
+}
