+func TestShapeIndexDecodeCorruptedSemantics(t *testing.T) {
+	validIdx := NewShapeIndex()
+	validIdx.Add(makePolyline("0:0, 0:10, 10:10"))
+	validIdx.Build()
+
+	var validBuf bytes.Buffer
+	if err := validIdx.Encode(&validBuf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := validBuf.Bytes()
+
+	// Corrupt maxEdgesPerCell to 0
+	t.Run("ZeroMaxEdges", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		binary.LittleEndian.PutUint32(corrupted[1:5], 0)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("expected error for maxEdgesPerCell == 0")
+		}
+	})
+
+	// Corrupt nextID to negative
+	t.Run("NegativeNextID", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		binary.LittleEndian.PutUint32(corrupted[5:9], uint32(0xFFFFFFFF)) // -1
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("expected error for negative nextID")
+		}
+	})
+
+	// Corrupt shape typeTag to unknown
+	t.Run("UnknownShapeTypeTag", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		// Offset 13: shapeID (4 bytes), offset 17: typeTag (4 bytes)
+		binary.LittleEndian.PutUint32(corrupted[17:21], 9999)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("expected error for unknown shape typeTag")
+		}
+	})
+}
