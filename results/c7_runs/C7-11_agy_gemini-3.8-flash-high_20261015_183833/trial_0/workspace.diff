+func TestShapeIndexEncodeDecodeEmpty(t *testing.T) {
+	orig := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("encoded empty ShapeIndex must produce non-empty byte stream, got 0 bytes")
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+	if !dec.IsFresh() {
+		t.Fatalf("decoded index IsFresh() is false")
+	}
+	if dec.Len() != 0 {
+		t.Fatalf("decoded index Len() = %d, want 0", dec.Len())
+	}
+	if dec.NumEdges() != 0 {
+		t.Fatalf("decoded index NumEdges() = %d, want 0", dec.NumEdges())
+	}
+	it := dec.Iterator()
+	if !it.Done() {
+		t.Fatalf("iterator for empty index should be Done immediately")
+	}
+}
