+func TestShapeIndexMutateAfterDecode(t *testing.T) {
+	orig := NewShapeIndex()
+	orig.Add(makePolyline("0:0, 0:10"))
+	orig.Build()
+
+	var buf bytes.Buffer
+	if err := orig.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+
+	dec := NewShapeIndex()
+	if err := dec.Decode(&buf); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+
+	// Add a new shape to the decoded index
+	newID := dec.Add(makePolyline("20:20, 20:30"))
+	if newID != 1 {
+		t.Fatalf("expected newID = 1, got %d", newID)
+	}
+
+	// Now build the mutated index
+	dec.Build()
+
+	if dec.Len() != 2 {
+		t.Fatalf("expected Len = 2, got %d", dec.Len())
+	}
+	if dec.NumEdges() != 2 {
+		t.Fatalf("expected NumEdges = 2, got %d", dec.NumEdges())
+	}
+
+	// Both shapes should have cells now
+	edge0 := dec.Shape(0).Edge(0)
+	edge1 := dec.Shape(1).Edge(0)
+	q := NewCrossingEdgeQuery(dec)
+	if len(q.Crossings(edge0.V0, edge0.V1, dec.Shape(0), CrossingTypeAll)) == 0 {
+		t.Fatalf("failed to query edge 0 on mutated decoded index")
+	}
+	if len(q.Crossings(edge1.V0, edge1.V1, dec.Shape(1), CrossingTypeAll)) == 0 {
+		t.Fatalf("failed to query edge 1 on mutated decoded index")
+	}
+}
