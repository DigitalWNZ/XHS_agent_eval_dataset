+func TestShapeIndexDecodeMalformedInput(t *testing.T) {
+	// 1. Nil reader
+	idx := NewShapeIndex()
+	if err := idx.Decode(nil); err == nil {
+		t.Fatalf("expected error decoding nil reader")
+	}
+
+	// 2. Empty stream
+	if err := idx.Decode(bytes.NewReader(nil)); err == nil {
+		t.Fatalf("expected error decoding empty stream")
+	}
+
+	// Create a valid index with multiple shapes and cells to test corruption and truncation
+	validIdx := NewShapeIndex()
+	validIdx.Add(makePolygon("0:0, 0:10, 10:10, 10:0", false))
+	validIdx.Add(makePolyline("20:20, 20:30, 30:30"))
+	validIdx.Add((*PointVector)(&[]Point{PointFromCoords(1, 0, 0)}))
+	validIdx.Build()
+
+	var validBuf bytes.Buffer
+	if err := validIdx.Encode(&validBuf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	validBytes := validBuf.Bytes()
+
+	// 3. Truncated data at every byte boundary
+	t.Run("TruncatedBytes", func(t *testing.T) {
+		for k := 0; k < len(validBytes); k++ {
+			d := NewShapeIndex()
+			err := d.Decode(bytes.NewReader(validBytes[:k]))
+			if err == nil {
+				t.Fatalf("expected error decoding truncated data at length %d/%d", k, len(validBytes))
+			}
+		}
+	})
+
+	// 4. Corrupted version
+	t.Run("CorruptedVersion", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		corrupted[0] = 99 // invalid version
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("expected error decoding invalid version")
+		}
+	})
+
+	// 5. Oversized allocation requests
+	t.Run("OversizedNumShapes", func(t *testing.T) {
+		corrupted := append([]byte(nil), validBytes...)
+		// Header: [version: 1 byte][maxEdges: 4 bytes][nextID: 4 bytes][numShapes: 4 bytes]
+		// Overwrite numShapes at offset 9
+		binary.LittleEndian.PutUint32(corrupted[9:13], 0xFFFFFFFF)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("expected error decoding oversized numShapes")
+		}
+	})
+
+	t.Run("OversizedNumCells", func(t *testing.T) {
+		// Create an empty index to know exact offsets
+		emptyIdx := NewShapeIndex()
+		var emptyBuf bytes.Buffer
+		emptyIdx.Encode(&emptyBuf)
+		emptyBytes := emptyBuf.Bytes()
+		// Header: version(1) + maxEdges(4) + nextID(4) + numShapes(4) = offset 13 is numCells
+		corrupted := append([]byte(nil), emptyBytes...)
+		binary.LittleEndian.PutUint32(corrupted[13:17], 0xFFFFFFFF)
+		d := NewShapeIndex()
+		if err := d.Decode(bytes.NewReader(corrupted)); err == nil {
+			t.Fatalf("expected error decoding oversized numCells")
+		}
+	})
+
+	// 6. Random corrupted bytes / bit flips fuzzing (must not panic)
+	t.Run("CorruptedBytesFuzz", func(t *testing.T) {
+		rng := rand.New(rand.NewSource(42))
+		for iter := 0; iter < 1000; iter++ {
+			corrupted := append([]byte(nil), validBytes...)
+			numCorruptions := 1 + rng.Intn(5)
+			for c := 0; c < numCorruptions; c++ {
+				pos := rng.Intn(len(corrupted))
+				corrupted[pos] ^= byte(1 + rng.Intn(255))
+			}
+			d := NewShapeIndex()
+			// Should return error or succeed, but NEVER panic
+			_ = d.Decode(bytes.NewReader(corrupted))
+		}
+	})
+}
