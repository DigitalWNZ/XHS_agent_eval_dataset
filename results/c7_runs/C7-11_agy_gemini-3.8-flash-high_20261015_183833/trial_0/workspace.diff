+// Helper to compare two shapes for equality.
+func checkShapesEqual(t *testing.T, s1, s2 Shape, shapeID int32) {
+	t.Helper()
+	if s1 == nil && s2 == nil {
+		return
+	}
+	if (s1 == nil) != (s2 == nil) {
+		t.Fatalf("shape %d: one is nil, the other is not", shapeID)
+	}
+	if s1.typeTag() != s2.typeTag() {
+		t.Fatalf("shape %d typeTag mismatch: got %v, want %v", shapeID, s2.typeTag(), s1.typeTag())
+	}
+	if s1.NumEdges() != s2.NumEdges() {
+		t.Fatalf("shape %d NumEdges mismatch: got %v, want %v", shapeID, s2.NumEdges(), s1.NumEdges())
+	}
+	if s1.NumChains() != s2.NumChains() {
+		t.Fatalf("shape %d NumChains mismatch: got %v, want %v", shapeID, s2.NumChains(), s1.NumChains())
+	}
+	if s1.Dimension() != s2.Dimension() {
+		t.Fatalf("shape %d Dimension mismatch: got %v, want %v", shapeID, s2.Dimension(), s1.Dimension())
+	}
+	if s1.IsEmpty() != s2.IsEmpty() {
+		t.Fatalf("shape %d IsEmpty mismatch: got %v, want %v", shapeID, s2.IsEmpty(), s1.IsEmpty())
+	}
+	if s1.IsFull() != s2.IsFull() {
+		t.Fatalf("shape %d IsFull mismatch: got %v, want %v", shapeID, s2.IsFull(), s1.IsFull())
+	}
+	for e := 0; e < s1.NumEdges(); e++ {
+		e1 := s1.Edge(e)
+		e2 := s2.Edge(e)
+		if e1 != e2 {
+			t.Fatalf("shape %d edge %d mismatch: got %v, want %v", shapeID, e, e2, e1)
+		}
+	}
+	for c := 0; c < s1.NumChains(); c++ {
+		c1 := s1.Chain(c)
+		c2 := s2.Chain(c)
+		if c1 != c2 {
+			t.Fatalf("shape %d chain %d mismatch: got %v, want %v", shapeID, c, c2, c1)
+		}
+	}
+}
+
+// Helper to verify two shape indexes are identical in structure and query responses.
+func checkIndexesEqual(t *testing.T, orig, dec *ShapeIndex) {
+	t.Helper()
+	if !dec.IsFresh() {
+		t.Fatalf("decoded index IsFresh() is false; expected true without calling Build")
+	}
+	if orig.Len() != dec.Len() {
+		t.Fatalf("index Len mismatch: got %d, want %d", dec.Len(), orig.Len())
+	}
+	if orig.NumEdges() != dec.NumEdges() {
+		t.Fatalf("index NumEdges mismatch: got %d, want %d", dec.NumEdges(), orig.NumEdges())
+	}
+	if orig.nextID != dec.nextID {
+		t.Fatalf("index nextID mismatch: got %d, want %d", dec.nextID, orig.nextID)
+	}
+
+	for id := int32(0); id < orig.nextID; id++ {
+		s1 := orig.Shape(id)
+		s2 := dec.Shape(id)
+		checkShapesEqual(t, s1, s2, id)
+	}
+
+	// Verify cell structure via iterator without calling Build
+	it1 := orig.Iterator()
+	it2 := dec.Iterator()
+	for !it1.Done() && !it2.Done() {
+		if it1.CellID() != it2.CellID() {
+			t.Fatalf("iterator CellID mismatch: got %v, want %v", it2.CellID(), it1.CellID())
+		}
+		c1 := it1.IndexCell()
+		c2 := it2.IndexCell()
+		if len(c1.shapes) != len(c2.shapes) {
+			t.Fatalf("cell %v clipped shapes len mismatch: got %d, want %d", it1.CellID(), len(c2.shapes), len(c1.shapes))
+		}
+		for i := range c1.shapes {
+			cs1 := c1.shapes[i]
+			cs2 := c2.shapes[i]
+			if cs1.shapeID != cs2.shapeID {
+				t.Fatalf("cell %v clipped shape %d shapeID mismatch: got %d, want %d", it1.CellID(), i, cs2.shapeID, cs1.shapeID)
+			}
+			if cs1.containsCenter != cs2.containsCenter {
+				t.Fatalf("cell %v clipped shape %d containsCenter mismatch: got %v, want %v", it1.CellID(), i, cs2.containsCenter, cs1.containsCenter)
+			}
+			if !reflect.DeepEqual(cs1.edges, cs2.edges) {
+				t.Fatalf("cell %v clipped shape %d edges mismatch: got %v, want %v", it1.CellID(), i, cs2.edges, cs1.edges)
+			}
+		}
+		it1.Next()
+		it2.Next()
+	}
+	if it1.Done() != it2.Done() {
+		t.Fatalf("iterator completion mismatch: it1.Done=%v, it2.Done=%v", it1.Done(), it2.Done())
+	}
+}
