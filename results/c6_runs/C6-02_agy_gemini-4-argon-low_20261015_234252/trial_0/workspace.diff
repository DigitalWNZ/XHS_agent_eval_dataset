+func TestDurabilityWALSyncFailure(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var failSync atomic.Bool
+	injectedSyncErr := errors.New("injected WAL sync failure")
+
+	fs := errorfs.Wrap(vfs.NewMem(), errorfs.InjectorFunc(func(op errorfs.Op) error {
+		if failSync.Load() && (op.Kind == errorfs.OpFileSync || op.Kind == errorfs.OpFileSyncData || op.Kind == errorfs.OpFileSyncTo) &&
+			filepath.Ext(op.Path) == ".log" {
+			return injectedSyncErr
+		}
+		return nil
+	}))
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	d, err := Open("", &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		failSync.Store(false)
+		_ = d.Close()
+	}()
+
+	// Successful commit first.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	seq1, stateErr := d.DurableState()
+	require.NoError(t, stateErr)
+	require.Greater(t, seq1, base.SeqNum(0))
+
+	// Register waiter and notify channel for a future sequence number.
+	futureSeq := seq1 + 10
+	notifyCh := d.DurabilityNotify(futureSeq)
+	waitErrCh := make(chan error, 1)
+	go func() {
+		waitErrCh <- d.WaitForDurability(futureSeq)
+	}()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Inject WAL sync error on next Sync commit.
+	failSync.Store(true)
+	err = d.Set([]byte("k2"), []byte("v2"), &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 99,
+	})
+	require.ErrorIs(t, err, injectedSyncErr)
+
+	// Waiter and notify channel should unblock with the sync error.
+	require.ErrorIs(t, <-waitErrCh, injectedSyncErr)
+	require.ErrorIs(t, <-notifyCh, injectedSyncErr)
+
+	// BatchDurable must have fired with Err != nil.
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEv := events[1]
+	mu.Unlock()
+	require.ErrorIs(t, failEv.Err, injectedSyncErr)
+	require.Equal(t, uint64(99), failEv.CorrelationID)
+	require.Greater(t, failEv.JobID, 0)
+
+	// WaitForJobDurability for the failed job returns the error.
+	require.ErrorIs(t, d.WaitForJobDurability(failEv.JobID), injectedSyncErr)
+
+	// DurableState returns the highest durable seqnum from before the failure and the latched error.
+	seqAfter, stateErr := d.DurableState()
+	require.Equal(t, seq1, seqAfter)
+	require.ErrorIs(t, stateErr, injectedSyncErr)
+
+	// DurabilityStats reflects the failed commit and FirstErr.
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedSyncErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+
+	// Durability error takes precedence over context cancellation.
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, d.WaitForDurabilityContext(canceledCtx, seq1), injectedSyncErr)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(canceledCtx, []base.SeqNum{seq1}), injectedSyncErr)
+	require.ErrorIs(t, d.WaitForJobDurabilityContext(canceledCtx, failEv.JobID), injectedSyncErr)
+}
