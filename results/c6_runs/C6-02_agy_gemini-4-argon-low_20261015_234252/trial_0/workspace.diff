+func TestDurabilityCloseUnblocksWaiters(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+
+	farSeq := base.SeqNum(50000)
+	notifyCh := d.DurabilityNotify(farSeq)
+
+	var wg sync.WaitGroup
+	waitErrs := make([]error, 2)
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		waitErrs[0] = d.WaitForDurability(farSeq)
+	}()
+	go func() {
+		defer wg.Done()
+		waitErrs[1] = d.WaitForDurabilityBatch([]base.SeqNum{farSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 5*time.Second, time.Millisecond)
+
+	require.NoError(t, d.Close())
+	wg.Wait()
+
+	require.Error(t, waitErrs[0])
+	require.Error(t, waitErrs[1])
+	require.Error(t, <-notifyCh)
+
+	// Context already cancelled vs DB closed: close error takes precedence over context cancellation.
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = d.WaitForDurabilityContext(canceledCtx, farSeq)
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+}
