+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// nil / empty slice returns nil immediately even before any commits.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+
+	// WaitForDurability(0) blocks until any commit becomes durable.
+	zeroDone := make(chan error, 1)
+	go func() {
+		zeroDone <- d.WaitForDurability(0)
+	}()
+
+	// Wait until PendingWaiters reflects the blocked goroutine.
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Non-sync commit should not satisfy WaitForDurability(0).
+	require.NoError(t, d.Set([]byte("nosync"), []byte("v"), NoSync))
+	select {
+	case <-zeroDone:
+		t.Fatal("WaitForDurability(0) should not unblock on NoSync commit")
+	case <-time.After(10 * time.Millisecond):
+	}
+
+	// Sync commit unblocks WaitForDurability(0).
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	require.NoError(t, <-zeroDone)
+
+	// Subsequent WaitForDurability(0) and WaitForDurability(b1.SeqNum()) return nil immediately.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(b1.SeqNum()))
+
+	// WaitForDurability for a future sequence number blocks until reached.
+	targetSeq := b1.SeqNum() + 2
+	batchDone := make(chan error, 1)
+	go func() {
+		batchDone <- d.WaitForDurabilityBatch([]base.SeqNum{b1.SeqNum(), targetSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Commit one key (reaches b1.SeqNum()+1, not yet targetSeq).
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	select {
+	case <-batchDone:
+		t.Fatal("WaitForDurabilityBatch should still block")
+	case <-time.After(10 * time.Millisecond):
+	}
+
+	// Commit another key (reaches targetSeq).
+	require.NoError(t, d.Set([]byte("k3"), []byte("v3"), Sync))
+	require.NoError(t, <-batchDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
