+func TestBatchDurableLargeBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var gotInfo BatchDurableInfo
+	var count int
+	d, err := Open("", &Options{
+		FS:           vfs.NewMem(),
+		Logger:       testutils.Logger{T: t},
+		MemTableSize: 256 << 10, // 256 KB, so largeBatchThreshold is 128 KB
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				gotInfo = info
+				count++
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	b := d.NewBatch()
+	largeVal := make([]byte, 150<<10) // > 128 KB
+	require.NoError(t, b.Set([]byte("large-key"), largeVal, nil))
+	expectedSize := len(b.Repr())
+	require.NoError(t, d.Apply(b, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 777,
+	}))
+	// For large batches, d.Apply clears b.data after commit, but BatchSize and KeyCount
+	// in BatchDurableInfo must reflect the committed batch.
+	require.Equal(t, 1, count)
+	require.Equal(t, expectedSize, gotInfo.BatchSize)
+	require.Equal(t, uint32(1), gotInfo.KeyCount)
+	require.Equal(t, uint64(777), gotInfo.CorrelationID)
+	require.Greater(t, gotInfo.ApplyDuration, time.Duration(0))
+	require.Greater(t, gotInfo.SyncDuration, time.Duration(0))
+}
