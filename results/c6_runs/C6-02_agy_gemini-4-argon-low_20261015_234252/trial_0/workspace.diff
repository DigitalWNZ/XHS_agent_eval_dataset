+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var lastJobID atomic.Int64
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID.Store(int64(info.JobID))
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Zero and negative job IDs return "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Never-seen positive job ID returns "unknown" error.
+	err = d.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Perform a Sync commit and check its job ID succeeds.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	firstJob := int(lastJobID.Load())
+	require.Greater(t, firstJob, 0)
+	require.NoError(t, d.WaitForJobDurability(firstJob))
+
+	// Exceed the retention window so firstJob is evicted.
+	for i := 0; i < maxRetainedDurableJobs+10; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("k-%d", i)), []byte("v"), Sync))
+	}
+
+	// Evicted job ID returns "expired" error.
+	err = d.WaitForJobDurability(firstJob)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "expired")
+
+	// Recent job ID within window still succeeds.
+	recentJob := int(lastJobID.Load())
+	require.NoError(t, d.WaitForJobDurability(recentJob))
+
+	// Never-seen job ID still returns "unknown" error.
+	err = d.WaitForJobDurability(recentJob + 1000)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+}
