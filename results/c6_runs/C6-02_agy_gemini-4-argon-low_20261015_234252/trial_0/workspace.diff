+func TestBatchDurableCallbackBasic(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Initial state before any commits.
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+
+	// Non-sync commit must NOT trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("k0"), []byte("v0"), NoSync))
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Sync commit with CorrelationID and multiple keys.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, b.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b.Delete([]byte("k3"), nil))
+	expectedSize := len(b.Repr())
+	expectedCount := b.Count()
+	require.Equal(t, uint32(3), expectedCount)
+
+	require.NoError(t, d.Apply(b, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}))
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev := events[0]
+	mu.Unlock()
+
+	require.Greater(t, ev.JobID, 0)
+	// First commit had 1 key at seq 10, second batch has 3 keys at 11, 12, 13 -> highest seq is 13.
+	require.Equal(t, b.SeqNum()+base.SeqNum(expectedCount)-1, ev.SeqNum)
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev.CorrelationID)
+	require.Equal(t, expectedSize, ev.BatchSize)
+	require.Equal(t, expectedCount, ev.KeyCount)
+
+	// Empty sync batch should not trigger BatchDurable.
+	emptyBatch := d.NewBatch()
+	require.NoError(t, d.Apply(emptyBatch, Sync))
+	mu.Lock()
+	require.Len(t, events, 1)
+	mu.Unlock()
+
+	// Check Metrics.DurableCommitCount and Metrics.DurableCommitDuration.
+	m := d.Metrics()
+	require.Equal(t, uint64(1), m.DurableCommitCount)
+	require.Equal(t, ev.SyncDuration, m.DurableCommitDuration)
+
+	// Check DurableState and DurabilityStats.
+	seq, stateErr = d.DurableState()
+	require.Equal(t, ev.SeqNum, seq)
+	require.NoError(t, stateErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, ev.SeqNum, stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, ev.SyncDuration, stats.CumulativeSyncDuration)
+	require.Equal(t, ev.SyncDuration, stats.MaxSyncDuration)
+}
