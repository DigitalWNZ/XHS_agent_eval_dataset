+func TestBatchDurableApplyNoSyncWait(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 1234,
+	}))
+	require.NoError(t, b.SyncWait())
+	require.NoError(t, b.Close())
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev := events[0]
+	mu.Unlock()
+
+	require.Equal(t, uint64(1234), ev.CorrelationID)
+	require.Equal(t, uint32(1), ev.KeyCount)
+	require.NoError(t, d.WaitForJobDurability(ev.JobID))
+	require.NoError(t, d.WaitForDurability(ev.SeqNum))
+}
+
+func TestDurabilityConcurrent(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var callbackCount atomic.Uint64
+	var jobIDs sync.Map
+
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				callbackCount.Add(1)
+				jobIDs.Store(info.JobID, info.SeqNum)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	const numWriters = 8
+	const writesPerWriter = 25
+	var wg sync.WaitGroup
+
+	for w := 0; w < numWriters; w++ {
+		wg.Add(1)
+		go func(writerID int) {
+			defer wg.Done()
+			for i := 0; i < writesPerWriter; i++ {
+				b := d.NewBatch()
+				key := fmt.Sprintf("w%d-k%d", writerID, i)
+				require.NoError(t, b.Set([]byte(key), []byte("val"), nil))
+				corrID := uint64(writerID*1000 + i)
+				require.NoError(t, d.Apply(b, &WriteOptions{
+					Sync:                true,
+					CommitCorrelationID: corrID,
+				}))
+				seq := b.SeqNum()
+				_ = b.Close()
+
+				require.NoError(t, d.WaitForDurability(seq))
+				ch := d.DurabilityNotify(seq)
+				require.NoError(t, <-ch)
+			}
+		}(w)
+	}
+
+	wg.Wait()
+
+	totalExpected := uint64(numWriters * writesPerWriter)
+	require.Equal(t, totalExpected, callbackCount.Load())
+
+	stats := d.DurabilityStats()
+	require.Equal(t, totalExpected, stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Greater(t, stats.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+
+	m := d.Metrics()
+	require.Equal(t, totalExpected, m.DurableCommitCount)
+	require.Equal(t, stats.CumulativeSyncDuration, m.DurableCommitDuration)
+
+	jobIDs.Range(func(key, value any) bool {
+		jobID := key.(int)
+		require.NoError(t, d.WaitForJobDurability(jobID))
+		return true
+	})
+}
