diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..5a8d1567
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,669 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxRetainedDurableJobs is the maximum number of completed durable jobs
+	// retained for WaitForJobDurability queries before older jobs are evicted.
+	maxRetainedDurableJobs = 4096
+
+	// maxDurabilityNotifySubscribers is the maximum number of concurrent
+	// outstanding DurabilityNotify subscriptions allowed at once.
+	maxDurabilityNotifySubscribers = 4096
+)
+
+var (
+	errDurabilityJobUnknown  = errors.New("pebble: unknown durability job ID")
+	errDurabilityJobExpired  = errors.New("pebble: durability job ID has expired from retention window")
+	errDurabilityNotifyLimit = errors.New("pebble: too many outstanding durability notify subscriptions")
+	errDurabilityWaitClosed  = errors.New("pebble: database closed while waiting for durability")
+)
+
+// DurabilityStats holds a point-in-time snapshot of durability tracking
+// statistics for a DB.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type batchDurabilityState struct {
+	db               *DB
+	jobID            int
+	seqNum           base.SeqNum
+	correlationID    uint64
+	batchSize        int
+	keyCount         uint32
+	startTime        crtime.Mono
+	walWriteDoneTime crtime.Mono
+	applyDoneTime    crtime.Mono
+	finished         atomic.Bool
+}
+
+func (s *batchDurabilityState) prepareJob(startSeq base.SeqNum, count uint32) {
+	if count > 0 {
+		s.seqNum = startSeq + base.SeqNum(count) - 1
+	} else {
+		s.seqNum = startSeq
+	}
+	s.jobID = s.db.durability.registerSyncJob(s.seqNum)
+}
+
+func (s *batchDurabilityState) finish(err error) {
+	if !s.finished.CompareAndSwap(false, true) {
+		return
+	}
+	if s.jobID == 0 {
+		return
+	}
+	now := crtime.NowMono()
+	var applyDuration time.Duration
+	if s.applyDoneTime != 0 && s.startTime != 0 {
+		applyDuration = s.applyDoneTime.Sub(s.startTime)
+	}
+	var syncDuration time.Duration
+	if s.walWriteDoneTime != 0 {
+		syncDuration = now.Sub(s.walWriteDoneTime)
+	} else if s.startTime != 0 {
+		syncDuration = now.Sub(s.startTime)
+	}
+	if err == nil {
+		if applyDuration <= 0 {
+			applyDuration = time.Nanosecond
+		}
+		if syncDuration <= 0 {
+			syncDuration = time.Nanosecond
+		}
+	} else {
+		if applyDuration < 0 {
+			applyDuration = 0
+		}
+		if syncDuration < 0 {
+			syncDuration = 0
+		}
+	}
+
+	s.db.durability.completeSyncJob(s.jobID, s.seqNum, syncDuration, err)
+
+	info := BatchDurableInfo{
+		JobID:         s.jobID,
+		SeqNum:        s.seqNum,
+		Err:           err,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: s.correlationID,
+		BatchSize:     s.batchSize,
+		KeyCount:      s.keyCount,
+	}
+	s.db.opts.EventListener.BatchDurable(info)
+}
+
+type durabilityJobState int8
+
+const (
+	durabilityJobPending durabilityJobState = iota + 1
+	durabilityJobSucceeded
+	durabilityJobFailed
+)
+
+type durabilityJobEntry struct {
+	jobID  int
+	seqNum base.SeqNum
+	state  durabilityJobState
+	err    error
+	done   chan struct{}
+}
+
+type seqWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+}
+
+type notifySubscriber struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityTracker struct {
+	disableWAL             bool
+	batchDurableConfigured bool
+
+	nextJobID    atomic.Int64
+	pendingWaits atomic.Int64
+
+	// Metrics accumulated only when BatchDurable is configured.
+	metricCommitCount    atomic.Uint64
+	metricCommitDuration atomic.Int64
+
+	mu struct {
+		sync.Mutex
+
+		closed                 bool
+		closeErr               error
+		highestDurableSeqNum   base.SeqNum
+		hasAnyDurableCommit    bool
+		firstErr               error
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		// Waiters blocked on WaitForDurability* (including seqNum == 0).
+		seqWaiters []*seqWaiter
+
+		// Outstanding DurabilityNotify subscriptions.
+		notifySubs []*notifySubscriber
+
+		// Job tracking for WaitForJobDurability*.
+		jobs           map[int]*durabilityJobEntry
+		completedOrder []int // FIFO of completed job IDs for bounded retention
+		minRetainedJob int   // highest evicted job ID (or 0 if none evicted)
+		maxAssignedJob int   // highest assigned job ID
+	}
+}
+
+func (t *durabilityTracker) init(disableWAL bool, batchDurableConfigured bool) {
+	t.disableWAL = disableWAL
+	t.batchDurableConfigured = batchDurableConfigured
+	t.mu.jobs = make(map[int]*durabilityJobEntry)
+}
+
+// registerSyncJob allocates a durability job ID and registers it as pending.
+func (t *durabilityTracker) registerSyncJob(seqNum base.SeqNum) int {
+	jobID := int(t.nextJobID.Add(1))
+	t.mu.Lock()
+	if jobID > t.mu.maxAssignedJob {
+		t.mu.maxAssignedJob = jobID
+	}
+	entry := &durabilityJobEntry{
+		jobID:  jobID,
+		seqNum: seqNum,
+		state:  durabilityJobPending,
+		done:   make(chan struct{}),
+	}
+	t.mu.jobs[jobID] = entry
+	if t.mu.closed {
+		entry.state = durabilityJobFailed
+		entry.err = t.terminalErrLocked()
+		close(entry.done)
+		t.recordCompletedJobLocked(jobID)
+	}
+	t.mu.Unlock()
+	return jobID
+}
+
+func (t *durabilityTracker) recordCompletedJobLocked(jobID int) {
+	t.mu.completedOrder = append(t.mu.completedOrder, jobID)
+	for len(t.mu.completedOrder) > maxRetainedDurableJobs {
+		evicted := t.mu.completedOrder[0]
+		t.mu.completedOrder = t.mu.completedOrder[1:]
+		delete(t.mu.jobs, evicted)
+		if evicted > t.mu.minRetainedJob {
+			t.mu.minRetainedJob = evicted
+		}
+	}
+	// Compact slice backing array periodically.
+	if cap(t.mu.completedOrder) > 4*maxRetainedDurableJobs && len(t.mu.completedOrder) <= maxRetainedDurableJobs {
+		cp := make([]int, len(t.mu.completedOrder), maxRetainedDurableJobs*2)
+		copy(cp, t.mu.completedOrder)
+		t.mu.completedOrder = cp
+	}
+}
+
+// completeSyncJob records the completion of a Sync commit's WAL sync phase.
+func (t *durabilityTracker) completeSyncJob(
+	jobID int, seqNum base.SeqNum, syncDuration time.Duration, err error,
+) {
+	if t.batchDurableConfigured {
+		t.metricCommitCount.Add(1)
+		t.metricCommitDuration.Add(int64(syncDuration))
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	t.mu.cumulativeSyncDuration += syncDuration
+	if syncDuration > t.mu.maxSyncDuration {
+		t.mu.maxSyncDuration = syncDuration
+	}
+
+	entry := t.mu.jobs[jobID]
+	if err != nil {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		if entry != nil && entry.state == durabilityJobPending {
+			entry.state = durabilityJobFailed
+			entry.err = err
+			close(entry.done)
+			t.recordCompletedJobLocked(jobID)
+		}
+		// Wake all seqWaiters and notifySubs on error.
+		t.wakeAllWaitersLocked(t.mu.firstErr)
+		return
+	}
+
+	t.mu.totalDurableCommits++
+	t.mu.hasAnyDurableCommit = true
+	if seqNum > t.mu.highestDurableSeqNum {
+		t.mu.highestDurableSeqNum = seqNum
+	}
+
+	if entry != nil && entry.state == durabilityJobPending {
+		entry.state = durabilityJobSucceeded
+		entry.err = nil
+		close(entry.done)
+		t.recordCompletedJobLocked(jobID)
+	}
+
+	// If no error is latched, wake satisfied seqWaiters and notifySubs.
+	if t.mu.firstErr == nil && !t.mu.closed {
+		// Wake seqWaiters whose seqNum <= highestDurableSeqNum (and seqNum == 0 since hasAnyDurableCommit is true).
+		remainingWaiters := t.mu.seqWaiters[:0]
+		for _, w := range t.mu.seqWaiters {
+			if w.seqNum <= t.mu.highestDurableSeqNum {
+				close(w.ch)
+			} else {
+				remainingWaiters = append(remainingWaiters, w)
+			}
+		}
+		for i := len(remainingWaiters); i < len(t.mu.seqWaiters); i++ {
+			t.mu.seqWaiters[i] = nil
+		}
+		t.mu.seqWaiters = remainingWaiters
+
+		// Deliver nil to notifySubs whose seqNum <= highestDurableSeqNum.
+		remainingSubs := t.mu.notifySubs[:0]
+		for _, sub := range t.mu.notifySubs {
+			if sub.seqNum <= t.mu.highestDurableSeqNum {
+				sub.ch <- nil
+				close(sub.ch)
+			} else {
+				remainingSubs = append(remainingSubs, sub)
+			}
+		}
+		for i := len(remainingSubs); i < len(t.mu.notifySubs); i++ {
+			t.mu.notifySubs[i] = nil
+		}
+		t.mu.notifySubs = remainingSubs
+	}
+}
+
+func (t *durabilityTracker) terminalErrLocked() error {
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr
+	}
+	if t.mu.closeErr != nil {
+		return t.mu.closeErr
+	}
+	return errDurabilityWaitClosed
+}
+
+func (t *durabilityTracker) wakeAllWaitersLocked(err error) {
+	if err == nil {
+		err = errDurabilityWaitClosed
+	}
+	for i, w := range t.mu.seqWaiters {
+		close(w.ch)
+		t.mu.seqWaiters[i] = nil
+	}
+	t.mu.seqWaiters = t.mu.seqWaiters[:0]
+
+	for i, sub := range t.mu.notifySubs {
+		sub.ch <- err
+		close(sub.ch)
+		t.mu.notifySubs[i] = nil
+	}
+	t.mu.notifySubs = t.mu.notifySubs[:0]
+}
+
+// close marks the tracker closed and unblocks all waiting goroutines and
+// outstanding notification channels with an error.
+func (t *durabilityTracker) close(closeErr error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closed {
+		return
+	}
+	t.mu.closed = true
+	if closeErr == nil {
+		closeErr = ErrClosed
+	}
+	t.mu.closeErr = closeErr
+
+	termErr := t.terminalErrLocked()
+	t.wakeAllWaitersLocked(termErr)
+
+	for jobID, entry := range t.mu.jobs {
+		if entry.state == durabilityJobPending {
+			entry.state = durabilityJobFailed
+			entry.err = termErr
+			close(entry.done)
+			t.recordCompletedJobLocked(jobID)
+		}
+	}
+}
+
+func (t *durabilityTracker) isSeqSatisfiedLocked(seqNum base.SeqNum) bool {
+	if seqNum == 0 {
+		return t.mu.hasAnyDurableCommit
+	}
+	return t.mu.hasAnyDurableCommit && t.mu.highestDurableSeqNum >= seqNum
+}
+
+func (t *durabilityTracker) removeSeqWaiter(w *seqWaiter) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	for i, elem := range t.mu.seqWaiters {
+		if elem == w {
+			last := len(t.mu.seqWaiters) - 1
+			t.mu.seqWaiters[i] = t.mu.seqWaiters[last]
+			t.mu.seqWaiters[last] = nil
+			t.mu.seqWaiters = t.mu.seqWaiters[:last]
+			break
+		}
+	}
+}
+
+func (t *durabilityTracker) waitForSeqContext(ctx context.Context, seqNum base.SeqNum) error {
+	if t.disableWAL {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t.mu.Lock()
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closed {
+		err := t.terminalErrLocked()
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqSatisfiedLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     make(chan struct{}),
+	}
+	t.mu.seqWaiters = append(t.mu.seqWaiters, w)
+	t.pendingWaits.Add(1)
+	t.mu.Unlock()
+
+	defer t.pendingWaits.Add(-1)
+
+	select {
+	case <-w.ch:
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if t.mu.firstErr != nil {
+			return t.mu.firstErr
+		}
+		if t.isSeqSatisfiedLocked(seqNum) {
+			return nil
+		}
+		return t.terminalErrLocked()
+	case <-ctx.Done():
+		t.removeSeqWaiter(w)
+		// Durability/close errors take precedence over context cancellation.
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if t.mu.firstErr != nil {
+			return t.mu.firstErr
+		}
+		if t.mu.closed {
+			return t.terminalErrLocked()
+		}
+		if t.isSeqSatisfiedLocked(seqNum) {
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) waitForBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if t.disableWAL || len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return t.waitForSeqContext(ctx, maxSeq)
+}
+
+func (t *durabilityTracker) waitForJobContext(ctx context.Context, jobID int) error {
+	if t.disableWAL {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t.mu.Lock()
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closed {
+		err := t.terminalErrLocked()
+		t.mu.Unlock()
+		return err
+	}
+
+	if jobID <= 0 {
+		t.mu.Unlock()
+		return errors.Wrapf(errDurabilityJobUnknown, "job ID %d", errors.Safe(jobID))
+	}
+
+	entry, ok := t.mu.jobs[jobID]
+	if !ok {
+		maxAssigned := t.mu.maxAssignedJob
+		minRetained := t.mu.minRetainedJob
+		t.mu.Unlock()
+		if jobID <= maxAssigned && jobID <= minRetained {
+			return errors.Wrapf(errDurabilityJobExpired, "job ID %d", errors.Safe(jobID))
+		}
+		return errors.Wrapf(errDurabilityJobUnknown, "job ID %d", errors.Safe(jobID))
+	}
+
+	if entry.state != durabilityJobPending {
+		err := entry.err
+		t.mu.Unlock()
+		return err
+	}
+
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+
+	doneCh := entry.done
+	t.pendingWaits.Add(1)
+	t.mu.Unlock()
+
+	defer t.pendingWaits.Add(-1)
+
+	select {
+	case <-doneCh:
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if entry.err != nil {
+			return entry.err
+		}
+		if t.mu.firstErr != nil {
+			return t.mu.firstErr
+		}
+		if entry.state == durabilityJobSucceeded {
+			return nil
+		}
+		return t.terminalErrLocked()
+	case <-ctx.Done():
+		// Durability/close errors take precedence over context cancellation.
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if entry.state != durabilityJobPending && entry.err != nil {
+			return entry.err
+		}
+		if t.mu.firstErr != nil {
+			return t.mu.firstErr
+		}
+		if t.mu.closed {
+			return t.terminalErrLocked()
+		}
+		if entry.state == durabilityJobSucceeded {
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) durableState() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeqNum, t.mu.firstErr
+}
+
+func (t *durabilityTracker) durabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if t.disableWAL {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if t.mu.firstErr != nil {
+		ch <- t.mu.firstErr
+		close(ch)
+		return ch
+	}
+	if t.mu.closed {
+		ch <- t.terminalErrLocked()
+		close(ch)
+		return ch
+	}
+	if t.isSeqSatisfiedLocked(seqNum) {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+	if len(t.mu.notifySubs) >= maxDurabilityNotifySubscribers {
+		ch <- errDurabilityNotifyLimit
+		close(ch)
+		return ch
+	}
+
+	t.mu.notifySubs = append(t.mu.notifySubs, &notifySubscriber{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeqNum,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.pendingWaits.Load(),
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk, or returns an error if WAL sync fails or the DB closes. A sequence
+// number of zero succeeds after any Sync commit becomes durable.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.durability.waitForSeqContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk, the context is cancelled, or an error occurs. Durability and
+// close errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.waitForSeqContext(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.durability.waitForBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk, the context is cancelled, or an error occurs. A nil or
+// empty slice returns nil immediately. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	return d.durability.waitForBatchContext(ctx, seqNums)
+}
+
+// WaitForJobDurability blocks until the commit job identified by jobID becomes
+// durable on disk.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.durability.waitForJobContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the commit job identified by jobID
+// becomes durable on disk, the context is cancelled, or an error occurs.
+// Durability and close errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durability.waitForJobContext(ctx, jobID)
+}
+
+// DurableState returns the highest sequence number known to be durable and the
+// first latched WAL sync error (if any).
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a buffered receive-only channel that delivers nil
+// when seqNum becomes durable, or a non-nil error on WAL sync failure, DB
+// close, or if the subscription limit is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.durabilityNotify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability tracking statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
