+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Subscribe before commit.
+	ch0 := d.DurabilityNotify(0)
+	chFuture := d.DurabilityNotify(base.SeqNumStart + 1)
+
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	require.NoError(t, <-ch0)
+
+	// Already durable seqNum returns pre-filled channel with nil.
+	seq, _ := d.DurableState()
+	chImmediate := d.DurabilityNotify(seq)
+	select {
+	case err := <-chImmediate:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel for already durable seqNum")
+	}
+
+	// Commit second key to satisfy chFuture.
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	require.NoError(t, <-chFuture)
+
+	// Test bounded subscriptions: fill up maxDurabilityNotifySubscribers.
+	var subs []<-chan error
+	farFutureSeq := base.SeqNum(1_000_000)
+	for i := 0; i < maxDurabilityNotifySubscribers; i++ {
+		subs = append(subs, d.DurabilityNotify(farFutureSeq))
+	}
+
+	// Excess caller gets a pre-filled channel with an immediate non-nil error.
+	excessCh := d.DurabilityNotify(farFutureSeq)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected excess subscription to have immediate error in channel")
+	}
+}
