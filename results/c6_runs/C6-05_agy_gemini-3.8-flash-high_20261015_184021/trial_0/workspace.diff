+#/*
+"""
+*/
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define BASE 1000000000ULL
+
+typedef struct {
+    uint32_t *d;
+    int len;
+    int cap;
+} BigInt;
+
+static void init(BigInt *b, uint32_t val) {
+    b->cap = 16;
+    b->d = (uint32_t *)malloc(b->cap * sizeof(uint32_t));
+    b->d[0] = val;
+    b->len = 1;
+}
+
+static void add(const BigInt *a, const BigInt *b, BigInt *res) {
+    int max_len = (a->len > b->len) ? a->len : b->len;
+    if (res->cap < max_len + 1) {
+        res->cap = (max_len + 1) * 2;
+        res->d = (uint32_t *)realloc(res->d, res->cap * sizeof(uint32_t));
+    }
+    uint64_t carry = 0;
+    int i = 0;
+    while (i < max_len || carry) {
+        uint64_t sum = carry;
+        if (i < a->len) sum += a->d[i];
+        if (i < b->len) sum += b->d[i];
+        res->d[i] = (uint32_t)(sum % BASE);
+        carry = sum / BASE;
+        i++;
+    }
+    res->len = i;
+}
+
+static void print_bi(const BigInt *b) {
+    if (b->len == 0) {
+        printf("0\n");
+        return;
+    }
+    printf("%u", b->d[b->len - 1]);
+    for (int i = b->len - 2; i >= 0; i--) {
+        printf("%09u", b->d[i]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long long n = atoll(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+    BigInt a, b, c;
+    init(&a, 0);
+    init(&b, 1);
+    init(&c, 0);
+    for (long long i = 2; i <= n; i++) {
+        add(&a, &b, &c);
+        BigInt tmp = a;
+        a = b;
+        b = c;
+        c = tmp;
+    }
+    print_bi(&b);
+    free(a.d);
+    free(b.d);
+    free(c.d);
+    return 0;
+}
