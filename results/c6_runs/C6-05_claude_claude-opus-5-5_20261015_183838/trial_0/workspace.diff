+/* Decimal bignum Fibonacci: digits stored little-endian, base 1e9. */
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long n = atol(argv[1]);
+    size_t cap = (size_t)(n / 40) + 4;
+    unsigned int *a = calloc(cap, sizeof *a), *b = calloc(cap, sizeof *b);
+    size_t len = 1;
+    a[0] = 0; b[0] = 1;
+    for (long i = 0; i < n; i++) {
+        unsigned int carry = 0;
+        for (size_t j = 0; j < len; j++) {
+            unsigned int s = a[j] + b[j] + carry;
+            carry = s >= 1000000000u;
+            if (carry) s -= 1000000000u;
+            a[j] = b[j];
+            b[j] = s;
+        }
+        if (carry) { a[len] = 0; b[len] = carry; len++; }
+    }
+    size_t k = len;
+    while (k > 1 && a[k - 1] == 0) k--;
+    printf("%u", a[k - 1]);
+    while (k-- > 1) printf("%09u", a[k - 1]);
+    printf("\n");
+    free(a); free(b);
+    return 0;
