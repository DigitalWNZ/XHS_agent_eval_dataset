diff --git a/drizzle-orm/tests/window.test.ts b/drizzle-orm/tests/window.test.ts
new file mode 100644
index 00000000..71b7bfe8
--- /dev/null
+++ b/drizzle-orm/tests/window.test.ts
@@ -0,0 +1,165 @@
+import { expect, test } from 'vitest';
+import {
+	asc,
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, PgDialect, PgSelectBuilder, pgTable as pgTableDef, text } from '~/pg-core/index.ts';
+
+const users = pgTableDef('users', {
+	id: integer('id').notNull(),
+	name: text('name').notNull(),
+	dept: text('dept').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+const dialect = new PgDialect();
+
+test('Ranking helpers compile to correct snake_case SQL names', () => {
+	expect(dialect.sqlToQuery(rowNumber().over()).sql).toBe('row_number() over ()');
+	expect(dialect.sqlToQuery(rank().over()).sql).toBe('rank() over ()');
+	expect(dialect.sqlToQuery(denseRank().over()).sql).toBe('dense_rank() over ()');
+	expect(dialect.sqlToQuery(ntile(4).over()).sql).toBe('ntile(4) over ()');
+	expect(dialect.sqlToQuery(percentRank().over()).sql).toBe('percent_rank() over ()');
+	expect(dialect.sqlToQuery(cumeDist().over()).sql).toBe('cume_dist() over ()');
+});
+
+test('Offset helpers compile correctly and positional args are never bound query parameters', () => {
+	expect(dialect.sqlToQuery(lag(users.salary).over()).sql).toBe('lag("users"."salary") over ()');
+	expect(dialect.sqlToQuery(lag(users.salary, 2).over()).sql).toBe('lag("users"."salary", 2) over ()');
+	expect(dialect.sqlToQuery(lag(users.salary, 0).over()).sql).toBe('lag("users"."salary", 0) over ()');
+	
+	const queryLagDefault = dialect.sqlToQuery(lag(users.salary, 1, 0).over());
+	expect(queryLagDefault.sql).toBe('lag("users"."salary", 1, $1) over ()');
+	expect(queryLagDefault.params).toEqual([0]);
+
+	expect(dialect.sqlToQuery(lead(users.salary).over()).sql).toBe('lead("users"."salary") over ()');
+	expect(dialect.sqlToQuery(lead(users.salary, 3).over()).sql).toBe('lead("users"."salary", 3) over ()');
+	expect(dialect.sqlToQuery(lead(users.salary, 0).over()).sql).toBe('lead("users"."salary", 0) over ()');
+
+	expect(dialect.sqlToQuery(firstValue(users.salary).over()).sql).toBe('first_value("users"."salary") over ()');
+	expect(dialect.sqlToQuery(lastValue(users.salary).over()).sql).toBe('last_value("users"."salary") over ()');
+	expect(dialect.sqlToQuery(nthValue(users.salary, 2).over()).sql).toBe('nth_value("users"."salary", 2) over ()');
+});
+
+test('Aggregate window helpers compile correctly', () => {
+	expect(dialect.sqlToQuery(windowSum(users.salary).over()).sql).toBe('sum("users"."salary") over ()');
+	expect(dialect.sqlToQuery(windowAvg(users.salary).over()).sql).toBe('avg("users"."salary") over ()');
+	expect(dialect.sqlToQuery(windowMin(users.salary).over()).sql).toBe('min("users"."salary") over ()');
+	expect(dialect.sqlToQuery(windowMax(users.salary).over()).sql).toBe('max("users"."salary") over ()');
+	expect(dialect.sqlToQuery(windowCount(users.salary).over()).sql).toBe('count("users"."salary") over ()');
+	expect(dialect.sqlToQuery(windowCount().over()).sql).toBe('count(*) over ()');
+});
+
+test('ntile and nthValue reject non-positive integer arguments', () => {
+	expect(() => ntile(0)).toThrowError(/ntile.*0/);
+	expect(() => ntile(-1)).toThrowError(/ntile.*-1/);
+	expect(() => ntile(1.5)).toThrowError(/ntile.*1\.5/);
+
+	expect(() => nthValue(users.salary, 0)).toThrowError(/nthValue.*0/);
+	expect(() => nthValue(users.salary, -2)).toThrowError(/nthValue.*-2/);
+	expect(() => nthValue(users.salary, 2.5)).toThrowError(/nthValue.*2\.5/);
+});
+
+test('preceding and following reject negative and non-integer arguments', () => {
+	expect(() => preceding(-1)).toThrowError(/preceding/);
+	expect(() => preceding(1.5)).toThrowError(/preceding/);
+
+	expect(() => following(-5)).toThrowError(/following/);
+	expect(() => following(2.2)).toThrowError(/following/);
+});
+
+test('rows and range frame ordering validation', () => {
+	// Valid frames
+	expect(() => rows({ from: unboundedPreceding, to: currentRow })).not.toThrow();
+	expect(() => rows({ from: preceding(2), to: following(2) })).not.toThrow();
+	expect(() => range({ from: currentRow, to: unboundedFollowing })).not.toThrow();
+
+	// Invalid frame: from ordered after to
+	expect(() => rows({ from: following(2), to: preceding(2) })).toThrowError(/from/);
+	expect(() => range({ from: unboundedFollowing, to: unboundedPreceding })).toThrowError(/from/);
+	expect(() => rows({ from: following(1), to: currentRow })).toThrowError(/from/);
+});
+
+test('Inline window specs compile correctly with frames', () => {
+	const spec1 = {
+		partitionBy: users.dept,
+		orderBy: asc(users.salary),
+		frame: rows({ from: unboundedPreceding, to: currentRow }),
+	};
+	const q1 = dialect.sqlToQuery(rowNumber().over(spec1));
+	expect(q1.sql).toBe('row_number() over (partition by "users"."dept" order by "users"."salary" asc rows between unbounded preceding and current row)');
+
+	const spec2 = {
+		orderBy: [asc(users.salary), desc(users.id)],
+		frame: range({ from: preceding(1), to: following(1) }),
+	};
+	const q2 = dialect.sqlToQuery(windowSum(users.salary).over(spec2));
+	expect(q2.sql).toBe('sum("users"."salary") over (order by "users"."salary" asc, "users"."id" desc range between 1 preceding and 1 following)');
+});
+
+test('Named window references compile to OVER "name" without parentheses', () => {
+	const q = dialect.sqlToQuery(rowNumber().over('w'));
+	expect(q.sql).toBe('row_number() over "w"');
+});
+
+test('Named window definitions compile to WINDOW clause before ORDER BY', () => {
+	const q = dialect.sqlToQuery(
+		dialect.buildSelectQuery({
+			table: users,
+			fields: {
+				r: rowNumber().over('w1'),
+				s: windowSum(users.salary).over('w2'),
+			},
+			window: [
+				dialect.sqlToQuery(rowNumber().over('w1')).sql ? undefined : undefined,
+			],
+			setOperators: [],
+		} as any)
+	);
+});
+
+test('.window() method on select builder and validation', () => {
+	const selectBuilder = new PgSelectBuilder({
+		fields: { r: rowNumber().over('w') },
+		session: undefined,
+		dialect,
+	});
+	const qb = selectBuilder.from(users);
+
+	// Test name validation
+	expect(() => qb.window('', { partitionBy: users.dept })).toThrowError(/non-empty/);
+	expect(() => qb.window('   ', { partitionBy: users.dept })).toThrowError(/whitespace/);
+
+	// Chainable window definition
+	const query = qb
+		.window('w', { partitionBy: users.dept, orderBy: asc(users.salary) })
+		.orderBy(users.id);
+
+	const compiled = dialect.sqlToQuery(query.getSQL());
+	expect(compiled.sql).toBe(
+		'select row_number() over "w" from "users" window "w" as (partition by "users"."dept" order by "users"."salary" asc) order by "users"."id"'
+	);
+});
