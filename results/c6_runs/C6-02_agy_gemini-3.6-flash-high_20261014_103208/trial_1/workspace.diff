new file mode 100644
index 00000000..0238be65
--- /dev/null
+++ b/drizzle-orm/src/sql/expressions/window.ts
@@ -0,0 +1,292 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import {
+	type DriverValueDecoder,
+	isSQLWrapper,
+	noopDecoder,
+	SQL,
+	sql,
+	type SQLWrapper,
+} from '../sql.ts';
+
+export interface FrameBoundary extends SQLWrapper {
+	readonly offset: number;
+}
+
+export class RawFrameBoundary implements FrameBoundary {
+	static readonly [entityKind]: string = 'RawFrameBoundary';
+
+	constructor(
+		readonly offset: number,
+		private readonly sqlChunk: SQL,
+	) {}
+
+	getSQL(): SQL {
+		return this.sqlChunk;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding: FrameBoundary = new RawFrameBoundary(-Infinity, sql.raw('unbounded preceding'));
+export const currentRow: FrameBoundary = new RawFrameBoundary(0, sql.raw('current row'));
+export const unboundedFollowing: FrameBoundary = new RawFrameBoundary(Infinity, sql.raw('unbounded following'));
+
+export function preceding(n: number): FrameBoundary {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 0) {
+		throw new Error(`preceding: expected non-negative integer argument, received ${n}`);
+	}
+	return new RawFrameBoundary(-n, sql`${sql.raw(n.toString())} preceding`);
+}
+
+export function following(n: number): FrameBoundary {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 0) {
+		throw new Error(`following: expected non-negative integer argument, received ${n}`);
+	}
+	return new RawFrameBoundary(n, sql`${sql.raw(n.toString())} following`);
+}
+
+export class Frame implements SQLWrapper {
+	static readonly [entityKind]: string = 'Frame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly from: FrameBoundary,
+		readonly to?: FrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		if (this.to !== undefined) {
+			return sql`${sql.raw(this.type)} between ${this.from} and ${this.to}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.from}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+function validateFrameSpec(from: FrameBoundary, to?: FrameBoundary) {
+	if (to !== undefined && from.offset > to.offset) {
+		throw new Error(`Invalid frame specification: 'from' boundary cannot be ordered after 'to' boundary`);
+	}
+}
+
+function isFrameBoundary(val: unknown): val is FrameBoundary {
+	return typeof val === 'object' && val !== null && 'offset' in val && isSQLWrapper(val);
+}
+
+export function rows(spec: FrameBoundary | { from: FrameBoundary; to?: FrameBoundary }): Frame {
+	const { from, to } = isFrameBoundary(spec) ? { from: spec, to: undefined } : spec;
+	validateFrameSpec(from, to);
+	return new Frame('rows', from, to);
+}
+
+export function range(spec: FrameBoundary | { from: FrameBoundary; to?: FrameBoundary }): Frame {
+	const { from, to } = isFrameBoundary(spec) ? { from: spec, to: undefined } : spec;
+	validateFrameSpec(from, to);
+	return new Frame('range', from, to);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: Frame | SQLWrapper;
+}
+
+export function isWindowSpec(val: unknown): val is WindowSpec {
+	return typeof val === 'object' && val !== null && !isSQLWrapper(val);
+}
+
+export function buildWindowSpecSQL(spec?: WindowSpec): SQL {
+	if (!spec) return sql.empty();
+
+	const chunks: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionList.length > 0) {
+			chunks.push(sql`partition by ${sql.join(partitionList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderList.length > 0) {
+			chunks.push(sql`order by ${sql.join(orderList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		chunks.push(sql`${spec.frame}`);
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+export class WindowFunctionBuilder<TValue = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder?: DriverValueDecoder<TValue, any> | DriverValueDecoder<TValue, any>['mapFromDriverValue'],
+	) {}
+
+	over(window?: string | WindowSpec): SQL<TValue> {
+		let resSql: SQL<TValue>;
+		if (typeof window === 'string') {
+			resSql = sql`${this.fnSql} over ${sql.identifier(window)}` as SQL<TValue>;
+		} else {
+			const specSql = buildWindowSpecSQL(window);
+			resSql = sql`${this.fnSql} over (${specSql})` as SQL<TValue>;
+		}
+
+		if (this.decoder) {
+			resSql.mapWith(this.decoder);
+		}
+
+		return resSql;
+	}
+}
+
+type GetWindowColumnData<T> = T extends Column
+	? T['_']['data']
+	: T extends SQL<infer U>
+	? U
+	: unknown;
+
+// Ranking helpers
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number): WindowFunctionBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile: expected positive integer argument, received ${n}`);
+	}
+	return new WindowFunctionBuilder<number>(sql`ntile(${sql.raw(n.toString())})`, Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<string> {
+	return new WindowFunctionBuilder<string>(sql`percent_rank()`, String);
+}
+
+export function cumeDist(): WindowFunctionBuilder<string> {
+	return new WindowFunctionBuilder<string>(sql`cume_dist()`, String);
+}
+
+// Offset helpers
+export function lag<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset: number,
+	defaultValue: TDefault,
+): WindowFunctionBuilder<GetWindowColumnData<T> | TDefault>;
+export function lag<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowFunctionBuilder<GetWindowColumnData<T> | null>;
+export function lag(
+	value: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	let fnSql: SQL;
+	if (offset === undefined && defaultValue === undefined) {
+		fnSql = sql`lag(${value})`;
+	} else if (defaultValue === undefined) {
+		fnSql = sql`lag(${value}, ${sql.raw(offset!.toString())})`;
+	} else {
+		fnSql = sql`lag(${value}, ${sql.raw(offset!.toString())}, ${defaultValue})`;
+	}
+	const decoder = is(value, Column) ? value : noopDecoder;
+	return new WindowFunctionBuilder(fnSql, decoder);
+}
+
+export function lead<T extends SQLWrapper, TDefault>(
+	value: T,
+	offset: number,
+	defaultValue: TDefault,
+): WindowFunctionBuilder<GetWindowColumnData<T> | TDefault>;
+export function lead<T extends SQLWrapper>(
+	value: T,
+	offset?: number,
+): WindowFunctionBuilder<GetWindowColumnData<T> | null>;
+export function lead(
+	value: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	let fnSql: SQL;
+	if (offset === undefined && defaultValue === undefined) {
+		fnSql = sql`lead(${value})`;
+	} else if (defaultValue === undefined) {
+		fnSql = sql`lead(${value}, ${sql.raw(offset!.toString())})`;
+	} else {
+		fnSql = sql`lead(${value}, ${sql.raw(offset!.toString())}, ${defaultValue})`;
+	}
+	const decoder = is(value, Column) ? value : noopDecoder;
+	return new WindowFunctionBuilder(fnSql, decoder);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<GetWindowColumnData<T> | null> {
+	const decoder = is(value, Column) ? value : noopDecoder;
+	return new WindowFunctionBuilder(sql`first_value(${value})`, decoder as any);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<GetWindowColumnData<T> | null> {
+	const decoder = is(value, Column) ? value : noopDecoder;
+	return new WindowFunctionBuilder(sql`last_value(${value})`, decoder as any);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	n: number,
+): WindowFunctionBuilder<GetWindowColumnData<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue: expected positive integer argument, received ${n}`);
+	}
+	const decoder = is(value, Column) ? value : noopDecoder;
+	return new WindowFunctionBuilder(sql`nth_value(${value}, ${sql.raw(n.toString())})`, decoder as any);
+}
+
+// Aggregates
+export function windowSum(value: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${value})`, String);
+}
+
+export function windowAvg(value: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${value})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const decoder = is(value, Column) ? value : String;
+	return new WindowFunctionBuilder(sql`min(${value})`, decoder as any);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	value: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	const decoder = is(value, Column) ? value : String;
+	return new WindowFunctionBuilder(sql`max(${value})`, decoder as any);
+}
+
+export function windowCount(value?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`count(${value ?? sql.raw('*')})`, Number);
+}
