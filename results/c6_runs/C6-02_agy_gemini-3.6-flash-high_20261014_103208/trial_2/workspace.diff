index 00000000..48351360
--- /dev/null
+++ b/drizzle-orm/tests/window.test.ts
@@ -0,0 +1,231 @@
+import { describe, expect, it } from 'vitest';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { pgTable, serial, text, integer } from '~/pg-core/index.ts';
+import { PgDialect } from '~/pg-core/dialect.ts';
+import { MySqlDialect } from '~/mysql-core/dialect.ts';
+import { SQLiteDialect } from '~/sqlite-core/dialect.ts';
+
+const users = pgTable('users', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	dept: text('dept').notNull(),
+	salary: integer('salary').notNull(),
+	age: integer('age'),
+});
+
+const pgDialect = new PgDialect();
+const mySqlDialect = new MySqlDialect();
+const sqliteDialect = new SQLiteDialect();
+
+function toPgSql(wrapper: { getSQL(): any } | any) {
+	const sql = typeof wrapper.getSQL === 'function' ? wrapper.getSQL() : wrapper;
+	return pgDialect.sqlToQuery(sql);
+}
+
+describe('Window Functions', () => {
+	it('compiles ranking helpers to correct snake_case SQL names', () => {
+		expect(toPgSql(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(toPgSql(rank().over()).sql).toBe('rank() over ()');
+		expect(toPgSql(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(toPgSql(ntile(4).over()).sql).toBe('ntile(4) over ()');
+		expect(toPgSql(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(toPgSql(cumeDist().over()).sql).toBe('cume_dist() over ()');
+	});
+
+	it('compiles value access helpers to correct snake_case SQL names', () => {
+		expect(toPgSql(firstValue(users.salary).over()).sql).toBe('first_value("users"."salary") over ()');
+		expect(toPgSql(lastValue(users.salary).over()).sql).toBe('last_value("users"."salary") over ()');
+		expect(toPgSql(nthValue(users.salary, 3).over()).sql).toBe('nth_value("users"."salary", 3) over ()');
+		expect(toPgSql(lag(users.salary).over()).sql).toBe('lag("users"."salary") over ()');
+		expect(toPgSql(lag(users.salary, 2).over()).sql).toBe('lag("users"."salary", 2) over ()');
+		expect(toPgSql(lag(users.salary, 2, 0).over()).sql).toBe('lag("users"."salary", 2, $1) over ()');
+		expect(toPgSql(lead(users.salary).over()).sql).toBe('lead("users"."salary") over ()');
+		expect(toPgSql(lead(users.salary, 2).over()).sql).toBe('lead("users"."salary", 2) over ()');
+		expect(toPgSql(lead(users.salary, 2, 0).over()).sql).toBe('lead("users"."salary", 2, $1) over ()');
+	});
+
+	it('compiles aggregate window helpers to correct snake_case SQL names', () => {
+		expect(toPgSql(windowSum(users.salary).over()).sql).toBe('sum("users"."salary") over ()');
+		expect(toPgSql(windowAvg(users.salary).over()).sql).toBe('avg("users"."salary") over ()');
+		expect(toPgSql(windowMin(users.salary).over()).sql).toBe('min("users"."salary") over ()');
+		expect(toPgSql(windowMax(users.salary).over()).sql).toBe('max("users"."salary") over ()');
+		expect(toPgSql(windowCount().over()).sql).toBe('count(*) over ()');
+		expect(toPgSql(windowCount(users.salary).over()).sql).toBe('count("users"."salary") over ()');
+	});
+
+	it('numeric positional arguments do not become bound query parameters', () => {
+		const query = ntile(4).over();
+		const sqlObj = toPgSql(query);
+		expect(sqlObj.sql).toBe('ntile(4) over ()');
+		expect(sqlObj.params).toEqual([]);
+
+		const lagQuery = lag(users.salary, 0, 0).over();
+		const lagSql = toPgSql(lagQuery);
+		expect(lagSql.sql).toBe('lag("users"."salary", 0, $1) over ()');
+		expect(lagSql.params).toEqual([0]);
+
+		const leadQuery = lead(users.salary, 2).over();
+		const leadSql = toPgSql(leadQuery);
+		expect(leadSql.sql).toBe('lead("users"."salary", 2) over ()');
+		expect(leadSql.params).toEqual([]);
+
+		const nthQuery = nthValue(users.salary, 1).over();
+		const nthSql = toPgSql(nthQuery);
+		expect(nthSql.sql).toBe('nth_value("users"."salary", 1) over ()');
+		expect(nthSql.params).toEqual([]);
+
+		const frameQuery = windowSum(users.salary).over({
+			frame: rows({ from: preceding(0), to: following(5) }),
+		});
+		const frameSql = toPgSql(frameQuery);
+		expect(frameSql.sql).toBe('sum("users"."salary") over (rows between 0 preceding and 5 following)');
+		expect(frameSql.params).toEqual([]);
+	});
+
+	it('ntile and nthValue reject non-positive integer arguments', () => {
+		expect(() => ntile(0)).toThrow(/ntile/);
+		expect(() => ntile(0)).toThrow(/0/);
+		expect(() => ntile(-2)).toThrow(/ntile/);
+		expect(() => ntile(-2)).toThrow(/-2/);
+		expect(() => ntile(1.5)).toThrow(/ntile/);
+
+		expect(() => nthValue(users.salary, 0)).toThrow(/nthValue/);
+		expect(() => nthValue(users.salary, 0)).toThrow(/0/);
+		expect(() => nthValue(users.salary, -5)).toThrow(/nthValue/);
+		expect(() => nthValue(users.salary, -5)).toThrow(/-5/);
+		expect(() => nthValue(users.salary, 2.3)).toThrow(/nthValue/);
+	});
+
+	it('preceding and following reject negative and non-integer arguments', () => {
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => preceding(2.5)).toThrow(/preceding/);
+		expect(() => following(-3)).toThrow(/following/);
+		expect(() => following(1.1)).toThrow(/following/);
+
+		expect(toPgSql(preceding(0)).sql).toBe('0 preceding');
+		expect(toPgSql(following(0)).sql).toBe('0 following');
+	});
+
+	it('rows and range frame constructors reject invalid from/to ordering', () => {
+		expect(() => rows({ from: following(2), to: preceding(1) })).toThrow(/from/);
+		expect(() => range({ from: currentRow, to: preceding(1) })).toThrow(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: unboundedPreceding })).toThrow(/from/);
+
+		expect(() => rows({ from: preceding(2), to: following(1) })).not.toThrow();
+		expect(() => range({ from: unboundedPreceding, to: currentRow })).not.toThrow();
+	});
+
+	it('windowCount() without arguments emits count(*)', () => {
+		expect(toPgSql(windowCount().over()).sql).toBe('count(*) over ()');
+	});
+
+	it('appends "over ()" for empty OVER specifications', () => {
+		expect(toPgSql(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(toPgSql(rowNumber().over({})).sql).toBe('row_number() over ()');
+	});
+
+	it('compiles named window references to OVER name without parentheses', () => {
+		expect(toPgSql(rowNumber().over('w')).sql).toBe('row_number() over "w"');
+		expect(toPgSql(windowSum(users.salary).over('my_window')).sql).toBe('sum("users"."salary") over "my_window"');
+	});
+
+	it('validates window name in .window() method on query builders', () => {
+		expect(() => {
+			pgDialect.buildSelectQuery({
+				fields: {},
+				table: users,
+				setOperators: [],
+			} as any);
+		}).not.toThrow();
+	});
+
+	it('compiles named window definitions to WINDOW clause before ORDER BY in PG', () => {
+		const query = pgDialect.buildSelectQuery({
+			fields: {
+				id: users.id,
+				avgSalary: windowAvg(users.salary).over('w'),
+			},
+			table: users,
+			window: [{ name: 'w', spec: { partitionBy: users.dept } }],
+			orderBy: [users.id],
+			setOperators: [],
+		});
+
+		expect(pgDialect.sqlToQuery(query)).toEqual({
+			sql: 'select "id", avg("users"."salary") over "w" from "users" window "w" as (partition by "users"."dept") order by "users"."id"',
+			params: [],
+		});
+	});
+
+	it('compiles named window definitions in MySQL', () => {
+		const query = mySqlDialect.buildSelectQuery({
+			fields: {
+				id: users.id,
+				rankVal: rank().over('w'),
+			},
+			table: users,
+			window: [{ name: 'w', spec: { orderBy: users.salary } }],
+			orderBy: [users.id],
+			setOperators: [],
+		} as any);
+
+		expect(mySqlDialect.sqlToQuery(query)).toEqual({
+			sql: 'select `id`, rank() over `w` from `users` window `w` as (order by `users`.`salary`) order by `users`.`id`',
+			params: [],
+		});
+	});
+
+	it('compiles named window definitions in SQLite', () => {
+		const query = sqliteDialect.buildSelectQuery({
+			fields: {
+				id: users.id,
+				total: windowSum(users.salary).over('w'),
+			},
+			table: users,
+			window: [{ name: 'w', spec: { partitionBy: users.dept, orderBy: users.salary } }],
+			orderBy: [users.id],
+			setOperators: [],
+		} as any);
+
+		expect(sqliteDialect.sqlToQuery(query)).toEqual({
+			sql: 'select "id", sum("users"."salary") over "w" from "users" window "w" as (partition by "users"."dept" order by "users"."salary") order by "users"."id"',
+			params: [],
+		});
+	});
+
+	it('supports full window spec with partitionBy, orderBy, and frame', () => {
+		const query = windowAvg(users.salary).over({
+			partitionBy: users.dept,
+			orderBy: users.id,
+			frame: rows({ from: unboundedPreceding, to: currentRow }),
+		});
+
+		expect(toPgSql(query).sql).toBe(
+			'avg("users"."salary") over (partition by "users"."dept" order by "users"."id" rows between unbounded preceding and current row)',
+		);
+	});
+});
