--- /dev/null
+++ b/drizzle-orm/src/sql/expressions/window.ts
@@ -0,0 +1,295 @@
+import type { AnyColumn } from '~/column.ts';
+import { Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { DriverValueDecoder, SQLChunk } from '~/sql/sql.ts';
+import { isSQLWrapper, Name, SQL, sql, type SQLWrapper } from '~/sql/sql.ts';
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: SQLWrapper;
+}
+
+export function buildWindowSpec(spec: WindowSpec): SQL {
+	const specParts: SQL[] = [];
+	if (spec.partitionBy !== undefined) {
+		const pb = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (pb.length > 0) {
+			specParts.push(sql`partition by ${sql.join(pb, sql`, `)}`);
+		}
+	}
+	if (spec.orderBy !== undefined) {
+		const ob = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (ob.length > 0) {
+			specParts.push(sql`order by ${sql.join(ob, sql`, `)}`);
+		}
+	}
+	if (spec.frame !== undefined) {
+		const frameSql = isSQLWrapper(spec.frame) ? spec.frame.getSQL() : (spec.frame as SQL);
+		specParts.push(frameSql);
+	}
+	if (specParts.length === 0) {
+		return sql.empty();
+	}
+	return sql.join(specParts, sql` `);
+}
+
+export class WindowBuilder<T = unknown> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	constructor(
+		private fnSql: SQL,
+		private decoder?: DriverValueDecoder<T, any> | AnyColumn | typeof String | typeof Number,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		let overSql: SQL;
+		if (typeof spec === 'string') {
+			overSql = sql` over ${new Name(spec)}`;
+		} else if (!spec) {
+			overSql = sql` over ()`;
+		} else {
+			const specSql = buildWindowSpec(spec);
+			if (specSql.queryChunks.length === 0) {
+				overSql = sql` over ()`;
+			} else {
+				overSql = sql` over (${specSql})`;
+			}
+		}
+
+		const res = sql`${this.fnSql}${overSql}`;
+		if (this.decoder) {
+			res.mapWith(this.decoder as any);
+		}
+		return res as SQL<T>;
+	}
+
+	getSQL(): SQL<T> {
+		return this.over();
+	}
+}
+
+export class FrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'FrameBoundary';
+
+	constructor(
+		readonly type: 'unbounded-preceding' | 'preceding' | 'current-row' | 'following' | 'unbounded-following',
+		readonly rank: number,
+		readonly sqlChunk: SQL,
+	) {}
+
+	getSQL(): SQL {
+		return this.sqlChunk;
+	}
+}
+
+export const unboundedPreceding = new FrameBoundary(
+	'unbounded-preceding',
+	-Infinity,
+	sql`unbounded preceding`,
+);
+
+export const currentRow = new FrameBoundary(
+	'current-row',
+	0,
+	sql`current row`,
+);
+
+export const unboundedFollowing = new FrameBoundary(
+	'unbounded-following',
+	Infinity,
+	sql`unbounded following`,
+);
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset < 0) {
+			throw new Error(`preceding requires a non-negative integer argument, received ${offset}`);
+		}
+	}
+	const rawOffset = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+	return new FrameBoundary('preceding', -offset, sql`${rawOffset} preceding`);
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset < 0) {
+			throw new Error(`following requires a non-negative integer argument, received ${offset}`);
+		}
+	}
+	const rawOffset = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+	return new FrameBoundary('following', offset, sql`${rawOffset} following`);
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly frameType: 'rows' | 'range',
+		readonly spec: FrameSpec,
+	) {
+		if (spec.to !== undefined) {
+			if (spec.from.rank > spec.to.rank) {
+				throw new Error(`Frame 'from' boundary cannot be ordered after 'to' boundary`);
+			}
+		}
+	}
+
+	getSQL(): SQL {
+		if (this.spec.to !== undefined) {
+			return sql`${sql.raw(this.frameType)} between ${this.spec.from.getSQL()} and ${this.spec.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.frameType)} ${this.spec.from.getSQL()}`;
+	}
+}
+
+export function rows(spec: FrameSpec): WindowFrame {
+	return new WindowFrame('rows', spec);
+}
+
+export function range(spec: FrameSpec): WindowFrame {
+	return new WindowFrame('range', spec);
+}
+
+function renderPositionalArg(fnName: string, arg: number | SQLWrapper): SQLChunk {
+	if (typeof arg === 'number') {
+		if (fnName === 'ntile' || fnName === 'nthValue') {
+			if (!Number.isInteger(arg) || arg <= 0) {
+				throw new Error(`${fnName} requires a positive integer argument, received ${arg}`);
+			}
+		}
+		return sql.raw(String(arg));
+	}
+	return arg;
+}
+
+type GetColumnData<T> = T extends AnyColumn
+	? T['_']['data']
+	: T extends SQL<infer U>
+	? U
+	: T extends SQLWrapper
+	? unknown
+	: T;
+
+// Ranking helpers
+export function rowNumber(): WindowBuilder<number> {
+	return new WindowBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number | SQLWrapper): WindowBuilder<number> {
+	return new WindowBuilder(sql`ntile(${renderPositionalArg('ntile', n)})`, Number);
+}
+
+export function percentRank(): WindowBuilder<string> {
+	return new WindowBuilder(sql`percent_rank()`, String);
+}
+
+export function cumeDist(): WindowBuilder<string> {
+	return new WindowBuilder(sql`cume_dist()`, String);
+}
+
+// Offset / Value-access helpers
+export function lag<T extends SQLWrapper, U = undefined>(
+	value: T,
+	offset?: number | SQLWrapper,
+	defaultValue?: U,
+): WindowBuilder<
+	U extends undefined
+		? GetColumnData<T> | null
+		: Exclude<GetColumnData<T>, null> | (U extends AnyColumn ? U['_']['data'] : U extends SQL<infer V> ? V : U)
+> {
+	let fnSql: SQL;
+	if (defaultValue !== undefined) {
+		fnSql = sql`lag(${value}, ${renderPositionalArg('lag', offset!)}, ${defaultValue})`;
+	} else if (offset !== undefined) {
+		fnSql = sql`lag(${value}, ${renderPositionalArg('lag', offset)})`;
+	} else {
+		fnSql = sql`lag(${value})`;
+	}
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(fnSql, decoder as any);
+}
+
+export function lead<T extends SQLWrapper, U = undefined>(
+	value: T,
+	offset?: number | SQLWrapper,
+	defaultValue?: U,
+): WindowBuilder<
+	U extends undefined
+		? GetColumnData<T> | null
+		: Exclude<GetColumnData<T>, null> | (U extends AnyColumn ? U['_']['data'] : U extends SQL<infer V> ? V : U)
+> {
+	let fnSql: SQL;
+	if (defaultValue !== undefined) {
+		fnSql = sql`lead(${value}, ${renderPositionalArg('lead', offset!)}, ${defaultValue})`;
+	} else if (offset !== undefined) {
+		fnSql = sql`lead(${value}, ${renderPositionalArg('lead', offset)})`;
+	} else {
+		fnSql = sql`lead(${value})`;
+	}
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(fnSql, decoder as any);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	value: T,
+): WindowBuilder<GetColumnData<T> | null> {
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(sql`first_value(${value})`, decoder as any);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	value: T,
+): WindowBuilder<GetColumnData<T> | null> {
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(sql`last_value(${value})`, decoder as any);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	nth: number | SQLWrapper,
+): WindowBuilder<GetColumnData<T> | null> {
+	const decoder = is(value, Column) ? value : undefined;
+	return new WindowBuilder(sql`nth_value(${value}, ${renderPositionalArg('nthValue', nth)})`, decoder as any);
+}
+
+// Aggregate window helpers
+export function windowSum(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<GetColumnData<T> | null> {
+	const decoder = is(expression, Column) ? expression : String;
+	return new WindowBuilder(sql`min(${expression})`, decoder as any);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<GetColumnData<T> | null> {
+	const decoder = is(expression, Column) ? expression : String;
+	return new WindowBuilder(sql`max(${expression})`, decoder as any);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowBuilder<number> {
+	const fnSql = expression ? sql`count(${expression})` : sql`count(*)`;
+	return new WindowBuilder(fnSql, Number);
+}
