index 00000000..e14e03da
--- /dev/null
+++ b/drizzle-orm/tests/window.test.ts
@@ -0,0 +1,233 @@
+import { expect, test } from 'vitest';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, PgDialect, pgTable, QueryBuilder, text } from '~/pg-core/index.ts';
+import { int, MySqlDialect, mysqlTable, varchar } from '~/mysql-core/index.ts';
+import { integer as sqliteInteger, SQLiteDialect, sqliteTable, text as sqliteText } from '~/sqlite-core/index.ts';
+
+const pgUsers = pgTable('users', {
+	id: integer('id').notNull(),
+	name: text('name').notNull(),
+	dept: text('dept'),
+	salary: integer('salary').notNull(),
+});
+
+const mySqlUsers = mysqlTable('users', {
+	id: int('id').notNull(),
+	name: varchar('name', { length: 255 }).notNull(),
+	dept: varchar('dept', { length: 255 }),
+	salary: int('salary').notNull(),
+});
+
+const sqliteUsers = sqliteTable('users', {
+	id: sqliteInteger('id').notNull(),
+	name: sqliteText('name').notNull(),
+	dept: sqliteText('dept'),
+	salary: sqliteInteger('salary').notNull(),
+});
+
+test('ranking window helpers compile to correct snake_case SQL names', () => {
+	const dialect = new PgDialect();
+
+	const rNum = rowNumber().over();
+	const rnk = rank().over();
+	const dRnk = denseRank().over();
+	const nt = ntile(4).over();
+	const pRnk = percentRank().over();
+	const cDist = cumeDist().over();
+
+	expect(dialect.sqlToQuery(rNum.getSQL()).sql).toBe('row_number() over ()');
+	expect(dialect.sqlToQuery(rnk.getSQL()).sql).toBe('rank() over ()');
+	expect(dialect.sqlToQuery(dRnk.getSQL()).sql).toBe('dense_rank() over ()');
+	expect(dialect.sqlToQuery(nt.getSQL()).sql).toBe('ntile(4) over ()');
+	expect(dialect.sqlToQuery(pRnk.getSQL()).sql).toBe('percent_rank() over ()');
+	expect(dialect.sqlToQuery(cDist.getSQL()).sql).toBe('cume_dist() over ()');
+});
+
+test('value-access and aggregate window helpers', () => {
+	const dialect = new PgDialect();
+
+	const l1 = lag(pgUsers.salary).over();
+	const l2 = lag(pgUsers.salary, 2).over();
+	const l3 = lag(pgUsers.salary, 2, 0).over();
+	const ld1 = lead(pgUsers.salary).over();
+	const fVal = firstValue(pgUsers.salary).over();
+	const lVal = lastValue(pgUsers.salary).over();
+	const nVal = nthValue(pgUsers.salary, 3).over();
+
+	const wSum = windowSum(pgUsers.salary).over();
+	const wAvg = windowAvg(pgUsers.salary).over();
+	const wMin = windowMin(pgUsers.salary).over();
+	const wMax = windowMax(pgUsers.salary).over();
+	const wCntEmpty = windowCount().over();
+	const wCntCol = windowCount(pgUsers.id).over();
+
+	expect(dialect.sqlToQuery(l1.getSQL()).sql).toBe('lag("users"."salary") over ()');
+	expect(dialect.sqlToQuery(l2.getSQL()).sql).toBe('lag("users"."salary", 2) over ()');
+	expect(dialect.sqlToQuery(l3.getSQL()).sql).toBe('lag("users"."salary", 2, 0) over ()');
+	expect(dialect.sqlToQuery(ld1.getSQL()).sql).toBe('lead("users"."salary") over ()');
+	expect(dialect.sqlToQuery(fVal.getSQL()).sql).toBe('first_value("users"."salary") over ()');
+	expect(dialect.sqlToQuery(lVal.getSQL()).sql).toBe('last_value("users"."salary") over ()');
+	expect(dialect.sqlToQuery(nVal.getSQL()).sql).toBe('nth_value("users"."salary", 3) over ()');
+
+	expect(dialect.sqlToQuery(wSum.getSQL()).sql).toBe('sum("users"."salary") over ()');
+	expect(dialect.sqlToQuery(wAvg.getSQL()).sql).toBe('avg("users"."salary") over ()');
+	expect(dialect.sqlToQuery(wMin.getSQL()).sql).toBe('min("users"."salary") over ()');
+	expect(dialect.sqlToQuery(wMax.getSQL()).sql).toBe('max("users"."salary") over ()');
+	expect(dialect.sqlToQuery(wCntEmpty.getSQL()).sql).toBe('count(*) over ()');
+	expect(dialect.sqlToQuery(wCntCol.getSQL()).sql).toBe('count("users"."id") over ()');
+});
+
+test('numeric positional arguments must never become bound query parameters', () => {
+	const dialect = new PgDialect();
+
+	const nt = ntile(5).over();
+	const lg0 = lag(pgUsers.salary, 0).over();
+	const nth = nthValue(pgUsers.salary, 1).over();
+
+	const qNt = dialect.sqlToQuery(nt.getSQL());
+	const qLg = dialect.sqlToQuery(lg0.getSQL());
+	const qNth = dialect.sqlToQuery(nth.getSQL());
+
+	expect(qNt.params).toEqual([]);
+	expect(qLg.params).toEqual([]);
+	expect(qNth.params).toEqual([]);
+
+	expect(qNt.sql).toBe('ntile(5) over ()');
+	expect(qLg.sql).toBe('lag("users"."salary", 0) over ()');
+	expect(qNth.sql).toBe('nth_value("users"."salary", 1) over ()');
+});
+
+test('ntile and nthValue reject non-positive integer arguments', () => {
+	expect(() => ntile(0)).toThrow(/ntile/);
+	expect(() => ntile(-2)).toThrow(/ntile/);
+	expect(() => ntile(1.5)).toThrow(/ntile/);
+
+	expect(() => nthValue(pgUsers.salary, 0)).toThrow(/nthValue/);
+	expect(() => nthValue(pgUsers.salary, -1)).toThrow(/nthValue/);
+	expect(() => nthValue(pgUsers.salary, 2.5)).toThrow(/nthValue/);
+});
+
+test('preceding and following reject negative and non-integer numeric arguments', () => {
+	expect(() => preceding(-1)).toThrow(/preceding/);
+	expect(() => preceding(1.5)).toThrow(/preceding/);
+
+	expect(() => following(-5)).toThrow(/following/);
+	expect(() => following(2.2)).toThrow(/following/);
+});
+
+test('rows and range frame constructors reject invalid boundary order', () => {
+	expect(() => rows({ from: currentRow, to: preceding(1) })).toThrow(/from/);
+	expect(() => rows({ from: following(5), to: following(2) })).toThrow(/from/);
+	expect(() => range({ from: unboundedFollowing, to: unboundedPreceding })).toThrow(/from/);
+
+	// valid boundaries
+	expect(() => rows({ from: preceding(5), to: preceding(2) })).not.toThrow();
+	expect(() => rows({ from: preceding(1), to: currentRow })).not.toThrow();
+	expect(() => range({ from: unboundedPreceding, to: unboundedFollowing })).not.toThrow();
+});
+
+test('inline OVER specification with partitionBy, orderBy, and frame', () => {
+	const dialect = new PgDialect();
+
+	const expr = rowNumber().over({
+		partitionBy: [pgUsers.dept],
+		orderBy: [pgUsers.salary],
+		frame: rows({ from: preceding(2), to: currentRow }),
+	});
+
+	const query = dialect.sqlToQuery(expr.getSQL());
+	expect(query.sql).toBe(
+		'row_number() over (partition by "users"."dept" order by "users"."salary" rows between 2 preceding and current row)',
+	);
+});
+
+test('named window references compile to OVER followed by quoted name without parentheses', () => {
+	const dialect = new PgDialect();
+	const expr = rowNumber().over('w1');
+	const query = dialect.sqlToQuery(expr.getSQL());
+	expect(query.sql).toBe('row_number() over "w1"');
+});
+
+test('.window() query builder method rejects empty or whitespace names', () => {
+	const qb = new QueryBuilder();
+	const builder = qb.select().from(pgUsers);
+
+	expect(() => builder.window('', {})).toThrow(/non-empty/);
+	expect(() => builder.window('   ', {})).toThrow(/whitespace/);
+});
+
+test('named window definitions compile to WINDOW clause before ORDER BY across dialects', () => {
+	const pgDialect = new PgDialect();
+	const qbPg = new QueryBuilder();
+	const pgQuery = qbPg
+		.select({ id: pgUsers.id })
+		.from(pgUsers)
+		.window('w1', { partitionBy: pgUsers.dept, orderBy: pgUsers.salary })
+		.orderBy(pgUsers.id);
+
+	expect(pgDialect.sqlToQuery(pgQuery.getSQL()).sql).toBe(
+		'select "id" from "users" window "w1" as (partition by "users"."dept" order by "users"."salary") order by "users"."id"',
+	);
+
+	const mysqlDialect = new MySqlDialect();
+	const qbMysql = new MySqlDialect();
+	// Test mysql select builder with window
+	const mysqlSelect = mysqlDialect.buildSelectQuery({
+		table: mySqlUsers,
+		fields: { id: mySqlUsers.id },
+		setOperators: [],
+		window: [
+			{
+				name: 'w1',
+				spec: { partitionBy: mySqlUsers.dept, orderBy: mySqlUsers.salary },
+			},
+		],
+		orderBy: [mySqlUsers.id],
+	});
+
+	expect(mysqlDialect.sqlToQuery(mysqlSelect).sql).toBe(
+		'select `id` from `users` window `w1` as (partition by `users`.`dept` order by `users`.`salary`) order by `users`.`id`',
+	);
+
+	const sqliteDialect = new SQLiteDialect();
+	const sqliteSelect = sqliteDialect.buildSelectQuery({
+		table: sqliteUsers,
+		fields: { id: sqliteUsers.id },
+		setOperators: [],
+		window: [
+			{
+				name: 'w1',
+				spec: { partitionBy: sqliteUsers.dept, orderBy: sqliteUsers.salary },
+			},
+		],
+		orderBy: [sqliteUsers.id],
+	});
+
+	expect(sqliteDialect.sqlToQuery(sqliteSelect).sql).toBe(
+		'select "id" from "users" window "w1" as (partition by "users"."dept" order by "users"."salary") order by "users"."id"',
+	);
+});
