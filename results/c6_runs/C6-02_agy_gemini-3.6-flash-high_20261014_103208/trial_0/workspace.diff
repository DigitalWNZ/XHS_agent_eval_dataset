diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..397abb3a
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,324 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { SelectResultField } from '~/query-builders/select.types.ts';
+import { type DriverValueDecoder, isSQLWrapper, type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export interface FrameBoundary extends SQLWrapper {
+	readonly order: number;
+}
+
+export const unboundedPreceding: FrameBoundary = {
+	order: -Infinity,
+	getSQL() {
+		return sql`unbounded preceding`;
+	},
+};
+
+export const currentRow: FrameBoundary = {
+	order: 0,
+	getSQL() {
+		return sql`current row`;
+	},
+};
+
+export const unboundedFollowing: FrameBoundary = {
+	order: Infinity,
+	getSQL() {
+		return sql`unbounded following`;
+	},
+};
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding requires a non-negative integer argument, received ${offset}`);
+	}
+	return {
+		order: -offset,
+		getSQL() {
+			return sql`${sql.raw(String(offset))} preceding`;
+		},
+	};
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following requires a non-negative integer argument, received ${offset}`);
+	}
+	return {
+		order: offset,
+		getSQL() {
+			return sql`${sql.raw(String(offset))} following`;
+		},
+	};
+}
+
+export interface FrameSpecConfig {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class FrameSpec implements SQLWrapper {
+	static readonly [entityKind]: string = 'FrameSpec';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly config: FrameSpecConfig,
+	) {
+		if (config.to !== undefined && config.from.order > config.to.order) {
+			throw new Error("'from' frame boundary cannot be ordered after 'to' boundary");
+		}
+	}
+
+	getSQL(): SQL {
+		const typeChunk = sql.raw(this.type);
+		if (this.config.to !== undefined) {
+			return sql`${typeChunk} between ${this.config.from.getSQL()} and ${this.config.to.getSQL()}`;
+		}
+		return sql`${typeChunk} ${this.config.from.getSQL()}`;
+	}
+}
+
+export function rows(spec: FrameSpecConfig): FrameSpec {
+	return new FrameSpec('rows', spec);
+}
+
+export function range(spec: FrameSpecConfig): FrameSpec {
+	return new FrameSpec('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: FrameSpec | SQLWrapper;
+}
+
+export function buildWindowSpecSql(spec?: WindowSpec | string): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+	if (typeof spec === 'string') {
+		return sql`${sql.identifier(spec)}`;
+	}
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionByArray = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByArray.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderByArray = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByArray.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		const frameSql = isSQLWrapper(spec.frame) ? spec.frame.getSQL() : (spec.frame as unknown as SQL);
+		parts.push(frameSql);
+	}
+
+	return parts.length > 0 ? sql.join(parts, sql` `) : sql.empty();
+}
+
+export class WindowBuilder<T = unknown> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	declare _: {
+		brand: 'WindowBuilder';
+		type: T;
+	};
+
+	private windowSpec?: WindowSpec | string;
+
+	constructor(
+		private targetSql: SQL,
+		private mapWithFn?: DriverValueDecoder<T, any> | ((val: any) => any),
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		this.windowSpec = spec;
+		return this.getSQL();
+	}
+
+	as(alias: string): SQL.Aliased<T> {
+		return this.getSQL().as(alias);
+	}
+
+	getSQL(): SQL<T> {
+		let overSql: SQL;
+		if (typeof this.windowSpec === 'string') {
+			overSql = sql`over ${sql.identifier(this.windowSpec)}`;
+		} else {
+			const specSql = buildWindowSpecSql(this.windowSpec);
+			overSql = sql`over (${specSql})`;
+		}
+
+		const result = sql`${this.targetSql} ${overSql}`;
+		if (this.mapWithFn) {
+			return result.mapWith(this.mapWithFn as any);
+		}
+		if ((this.targetSql as any).decoder) {
+			result.decoder = (this.targetSql as any).decoder;
+		}
+		return result as SQL<T>;
+	}
+}
+
+function toPositionalArgSql(arg: unknown): SQL {
+	if (typeof arg === 'number') {
+		return sql.raw(String(arg));
+	}
+	if (isSQLWrapper(arg)) {
+		return arg.getSQL();
+	}
+	return sql`${arg}`;
+}
+
+export function rowNumber(): WindowBuilder<number> {
+	return new WindowBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(n: number | SQLWrapper): WindowBuilder<number> {
+	if (typeof n === 'number') {
+		if (!Number.isInteger(n) || n <= 0) {
+			throw new Error(`ntile requires a positive integer argument, received ${n}`);
+		}
+	} else if (!isSQLWrapper(n)) {
+		throw new Error(`ntile requires a positive integer argument, received ${n}`);
+	}
+	return new WindowBuilder(sql`ntile(${toPositionalArgSql(n)})`, Number);
+}
+
+export function percentRank(): WindowBuilder<string> {
+	return new WindowBuilder(sql`percent_rank()`);
+}
+
+export function cumeDist(): WindowBuilder<string> {
+	return new WindowBuilder(sql`cume_dist()`);
+}
+
+export function lag<
+	TColumn extends SQLWrapper,
+	TDefault = undefined,
+>(
+	column: TColumn,
+	offset?: number | SQLWrapper,
+	defaultValue?: TDefault,
+): WindowBuilder<
+	TDefault extends undefined
+		? SelectResultField<TColumn> | null
+		: Exclude<SelectResultField<TColumn>, null> | (TDefault extends SQLWrapper ? SelectResultField<TDefault> : TDefault)
+> {
+	let targetSql: SQL;
+	const colSql = column.getSQL();
+	const decoder = is(column, Column) ? column : (colSql as any).decoder;
+
+	if (offset === undefined && defaultValue === undefined) {
+		targetSql = sql`lag(${column})`;
+	} else if (defaultValue === undefined) {
+		targetSql = sql`lag(${column}, ${toPositionalArgSql(offset)})`;
+	} else {
+		const offSql = offset === undefined ? sql.raw('1') : toPositionalArgSql(offset);
+		targetSql = sql`lag(${column}, ${offSql}, ${toPositionalArgSql(defaultValue)})`;
+	}
+
+	return new WindowBuilder(targetSql, decoder) as any;
+}
+
+export function lead<
+	TColumn extends SQLWrapper,
+	TDefault = undefined,
+>(
+	column: TColumn,
+	offset?: number | SQLWrapper,
+	defaultValue?: TDefault,
+): WindowBuilder<
+	TDefault extends undefined
+		? SelectResultField<TColumn> | null
+		: Exclude<SelectResultField<TColumn>, null> | (TDefault extends SQLWrapper ? SelectResultField<TDefault> : TDefault)
+> {
+	let targetSql: SQL;
+	const colSql = column.getSQL();
+	const decoder = is(column, Column) ? column : (colSql as any).decoder;
+
+	if (offset === undefined && defaultValue === undefined) {
+		targetSql = sql`lead(${column})`;
+	} else if (defaultValue === undefined) {
+		targetSql = sql`lead(${column}, ${toPositionalArgSql(offset)})`;
+	} else {
+		const offSql = offset === undefined ? sql.raw('1') : toPositionalArgSql(offset);
+		targetSql = sql`lead(${column}, ${offSql}, ${toPositionalArgSql(defaultValue)})`;
+	}
+
+	return new WindowBuilder(targetSql, decoder) as any;
+}
+
+export function firstValue<TColumn extends SQLWrapper>(
+	column: TColumn,
+): WindowBuilder<SelectResultField<TColumn> | null> {
+	const colSql = column.getSQL();
+	const decoder = is(column, Column) ? column : (colSql as any).decoder;
+	return new WindowBuilder(sql`first_value(${column})`, decoder) as any;
+}
+
+export function lastValue<TColumn extends SQLWrapper>(
+	column: TColumn,
+): WindowBuilder<SelectResultField<TColumn> | null> {
+	const colSql = column.getSQL();
+	const decoder = is(column, Column) ? column : (colSql as any).decoder;
+	return new WindowBuilder(sql`last_value(${column})`, decoder) as any;
+}
+
+export function nthValue<TColumn extends SQLWrapper>(
+	column: TColumn,
+	offset: number | SQLWrapper,
+): WindowBuilder<SelectResultField<TColumn> | null> {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset <= 0) {
+			throw new Error(`nthValue requires a positive integer argument, received ${offset}`);
+		}
+	} else if (!isSQLWrapper(offset)) {
+		throw new Error(`nthValue requires a positive integer argument, received ${offset}`);
+	}
+	const colSql = column.getSQL();
+	const decoder = is(column, Column) ? column : (colSql as any).decoder;
+	return new WindowBuilder(sql`nth_value(${column}, ${toPositionalArgSql(offset)})`, decoder) as any;
+}
+
+export function windowSum(column: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`sum(${column})`, String);
+}
+
+export function windowAvg(column: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`avg(${column})`, String);
+}
+
+export function windowMin<TColumn extends SQLWrapper>(
+	column: TColumn,
+): WindowBuilder<(TColumn extends AnyColumn ? TColumn['_']['data'] : string) | null> {
+	const decoder = is(column, Column) ? column : String;
+	return new WindowBuilder(sql`min(${column})`, decoder as any) as any;
+}
+
+export function windowMax<TColumn extends SQLWrapper>(
+	column: TColumn,
+): WindowBuilder<(TColumn extends AnyColumn ? TColumn['_']['data'] : string) | null> {
+	const decoder = is(column, Column) ? column : String;
+	return new WindowBuilder(sql`max(${column})`, decoder as any) as any;
+}
+
+export function windowCount(column?: SQLWrapper): WindowBuilder<number> {
+	const expr = column ? sql`count(${column})` : sql`count(*)`;
+	return new WindowBuilder(expr, Number);
+}
