+++ b/scratch/test_full_spec.py
@@ -0,0 +1,161 @@
+import asyncio
+import time
+
+# Prototype implementation of run_tasks
+
+async def run_tasks(tasks: list, max_concurrent: int) -> None:
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be greater than 0")
+    if not tasks:
+        return
+
+    queue = asyncio.Queue()
+    for task in tasks:
+        queue.put_nowait(task)
+
+    async def worker():
+        while not queue.empty():
+            try:
+                task_fn = queue.get_nowait()
+            except asyncio.QueueEmpty:
+                break
+            await task_fn()
+
+    num_workers = min(max_concurrent, len(tasks))
+    worker_tasks = [asyncio.create_task(worker()) for _ in range(num_workers)]
+
+    try:
+        await asyncio.gather(*worker_tasks)
+    except BaseException:
+        # Cancel all workers
+        for w in worker_tasks:
+            if not w.done():
+                w.cancel()
+
+        # Wait for all workers to complete their cleanup
+        while any(not w.done() for w in worker_tasks):
+            try:
+                await asyncio.gather(*[w for w in worker_tasks if not w.done()], return_exceptions=True)
+            except BaseException:
+                pass
+        raise
+
+
+# Tests
+
+async def test_basic():
+    completed = []
+    async def make_task(i):
+        async def t():
+            await asyncio.sleep(0.01)
+            completed.append(i)
+        return t
+
+    tasks = [await make_task(i) for i in range(5)]
+    await run_tasks(tasks, max_concurrent=2)
+    assert sorted(completed) == [0, 1, 2, 3, 4]
+    print("test_basic PASSED")
+
+async def test_max_concurrency():
+    active = 0
+    max_active = 0
+    lock = asyncio.Lock()
+
+    async def make_task():
+        nonlocal active, max_active
+        async with lock:
+            active += 1
+            if active > max_active:
+                max_active = active
+        await asyncio.sleep(0.05)
+        async with lock:
+            active -= 1
+
+    tasks = [make_task for _ in range(10)]
+    await run_tasks(tasks, max_concurrent=3)
+    assert max_active <= 3
+    assert active == 0
+    print(f"test_max_concurrency PASSED (max_active was {max_active})")
+
+async def test_task_cleanup_on_cancel():
+    cleanup_done = []
+
+    async def task_with_cleanup(i):
+        try:
+            await asyncio.sleep(10)
+        except asyncio.CancelledError:
+            await asyncio.sleep(0.05)  # simulate async cleanup work
+            cleanup_done.append(i)
+            raise
+
+    tasks = [lambda i=i: task_with_cleanup(i) for i in range(4)]
+    
+    main_job = asyncio.create_task(run_tasks(tasks, max_concurrent=2))
+    await asyncio.sleep(0.05)  # let first 2 tasks start
+    main_job.cancel()
+
+    try:
+        await main_job
+        assert False, "Should have raised CancelledError"
+    except asyncio.CancelledError:
+        pass
+
+    assert len(cleanup_done) == 2, f"Expected 2 cleanups, got {len(cleanup_done)}"
+    assert sorted(cleanup_done) == [0, 1]
+    print("test_task_cleanup_on_cancel PASSED")
+
+async def test_task_exception():
+    cleanup_done = []
+
+    async def failing_task():
+        await asyncio.sleep(0.02)
+        raise RuntimeError("Task failed!")
+
+    async def slow_task(i):
+        try:
+            await asyncio.sleep(10)
+        except asyncio.CancelledError:
+            await asyncio.sleep(0.02)
+            cleanup_done.append(i)
+            raise
+
+    tasks = [
+        failing_task,
+        lambda: slow_task(1),
+        lambda: slow_task(2),
+    ]
+
+    try:
+        await run_tasks(tasks, max_concurrent=3)
+        assert False, "Should have raised RuntimeError"
+    except RuntimeError as e:
+        assert str(e) == "Task failed!"
+
+    assert len(cleanup_done) == 2, f"Expected 2 cleanups, got {len(cleanup_done)}"
+    print("test_task_exception PASSED")
+
+async def test_empty_tasks():
+    await run_tasks([], 5)
+    print("test_empty_tasks PASSED")
+
+async def test_invalid_max_concurrent():
+    try:
+        await run_tasks([lambda: asyncio.sleep(0)], 0)
+        assert False, "Should have raised ValueError"
+    except ValueError:
+        pass
+
+    try:
+        await run_tasks([lambda: asyncio.sleep(0)], -1)
+        assert False, "Should have raised ValueError"
+    except ValueError:
+        pass
+    print("test_invalid_max_concurrent PASSED")
+
+if __name__ == "__main__":
+    asyncio.run(test_basic())
+    asyncio.run(test_max_concurrency())
+    asyncio.run(test_task_cleanup_on_cancel())
+    asyncio.run(test_task_exception())
+    asyncio.run(test_empty_tasks())
+    asyncio.run(test_invalid_max_concurrent())
