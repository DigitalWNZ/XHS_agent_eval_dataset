+++ b/scratch/test_robust.py
@@ -0,0 +1,104 @@
+import asyncio
+import os
+import signal
+import sys
+
+cleanup_log = []
+
+async def worker(task_id):
+    try:
+        print(f"Task {task_id} starting...")
+        await asyncio.sleep(10)
+    except asyncio.CancelledError:
+        print(f"Task {task_id} caught CancelledError, starting cleanup...")
+        await asyncio.sleep(1)
+        cleanup_log.append(f"Task {task_id}")
+        print(f"Task {task_id} cleaned up")
+        raise
+    finally:
+        print(f"Task {task_id} inside finally")
+
+async def robust_run_tasks(tasks, max_concurrent):
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be >= 1")
+    if not tasks:
+        return
+
+    # Create worker tasks with max_concurrent concurrency
+    # We can use a queue or semaphore.
+    # Let's trace worker pool with queue:
+    queue = asyncio.Queue()
+    for t in tasks:
+        queue.put_nowait(t)
+
+    active_tasks = set()
+    stop_flag = False
+
+    async def worker_loop():
+        while not stop_flag:
+            try:
+                task_fn = queue.get_nowait()
+            except asyncio.QueueEmpty:
+                break
+            try:
+                await task_fn()
+            finally:
+                queue.task_done()
+
+    num_workers = min(max_concurrent, len(tasks))
+    for _ in range(num_workers):
+        t = asyncio.create_task(worker_loop())
+        active_tasks.add(t)
+
+    first_exception = None
+
+    try:
+        # Await all worker tasks
+        await asyncio.gather(*active_tasks)
+    except BaseException as exc:
+        first_exception = exc
+        stop_flag = True
+        # Cancel all active worker tasks
+        for t in active_tasks:
+            if not t.done():
+                t.cancel()
+        
+        # Now wait for ALL worker tasks to complete, even if KeyboardInterrupt/CancelledError is raised again!
+        while active_tasks:
+            pending = [t for t in active_tasks if not t.done()]
+            if not pending:
+                break
+            try:
+                await asyncio.gather(*pending, return_exceptions=True)
+            except BaseException as secondary_exc:
+                # If interrupted again during wait, ensure remaining tasks are still cancelled
+                for t in pending:
+                    if not t.done():
+                        t.cancel()
+
+    if first_exception is not None:
+        raise first_exception
+
+async def runner():
+    tasks = [lambda: worker(1), lambda: worker(2)]
+    
+    async def send_sigint_twice():
+        await asyncio.sleep(0.3)
+        print("Sending SIGINT #1...")
+        os.kill(os.getpid(), signal.SIGINT)
+        await asyncio.sleep(0.3)
+        print("Sending SIGINT #2...")
+        os.kill(os.getpid(), signal.SIGINT)
+
+    asyncio.create_task(send_sigint_twice())
+    try:
+        await robust_run_tasks(tasks, 2)
+    finally:
+        print("Runner finally, cleanup_log:", cleanup_log)
+
+if __name__ == "__main__":
+    try:
+        asyncio.run(runner())
+    except KeyboardInterrupt:
+        print("Caught KeyboardInterrupt in main")
+        print("Final cleanup log:", cleanup_log)
