+++ b/scratch/test_interrupt.py
@@ -0,0 +1,60 @@
+import asyncio
+import signal
+import time
+
+cleanup_log = []
+
+async def worker(task_id, duration):
+    try:
+        print(f"Task {task_id} starting...")
+        await asyncio.sleep(duration)
+        print(f"Task {task_id} completed successfully")
+    except asyncio.CancelledError:
+        print(f"Task {task_id} received CancelledError, starting cleanup...")
+        await asyncio.sleep(0.5)
+        cleanup_log.append(f"Task {task_id} cleaned up")
+        print(f"Task {task_id} cleanup done")
+        raise
+    finally:
+        print(f"Task {task_id} finally block executed")
+
+async def run_tasks_impl(tasks, max_concurrent):
+    sem = asyncio.Semaphore(max_concurrent)
+    active_tasks = set()
+
+    async def run_one(task_fn):
+        async with sem:
+            await task_fn()
+
+    tasks_to_run = []
+    try:
+        async with asyncio.TaskGroup() as tg:
+            for task_fn in tasks:
+                t = tg.create_task(run_one(task_fn))
+                active_tasks.add(t)
+    except ExceptionGroup as eg:
+        print("Caught ExceptionGroup:", eg)
+        raise
+
+async def main():
+    tasks = [
+        lambda: worker(1, 10),
+        lambda: worker(2, 10),
+        lambda: worker(3, 10),
+        lambda: worker(4, 10),
+    ]
+    
+    # We will cancel main task after 1 second to simulate Ctrl+C / Cancellation
+    main_task = asyncio.create_task(run_tasks_impl(tasks, max_concurrent=2))
+    await asyncio.sleep(1)
+    print("Cancelling main_task now...")
+    main_task.cancel()
+    try:
+        await main_task
+    except asyncio.CancelledError:
+        print("main_task cancelled error caught")
+    
+    print("Cleanup log:", cleanup_log)
+
+if __name__ == "__main__":
+    asyncio.run(main())
