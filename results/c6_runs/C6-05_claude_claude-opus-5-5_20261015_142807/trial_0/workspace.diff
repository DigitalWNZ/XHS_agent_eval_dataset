+/* Big integers stored as little-endian base-1e9 limbs. */
+typedef struct { unsigned int *d; size_t n, cap; } big;
+
+static void big_add(big *r, const big *a, const big *b) {
+    size_t n = a->n > b->n ? a->n : b->n;
+    if (r->cap < n + 1) { r->cap = 2 * (n + 1); r->d = realloc(r->d, r->cap * sizeof *r->d); }
+    unsigned long long carry = 0;
+    for (size_t i = 0; i < n; i++) {
+        unsigned long long s = carry;
+        if (i < a->n) s += a->d[i];
+        if (i < b->n) s += b->d[i];
+        r->d[i] = (unsigned int)(s % 1000000000ULL);
+        carry = s / 1000000000ULL;
+    }
+    r->n = n;
+    if (carry) r->d[r->n++] = (unsigned int)carry;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) { fprintf(stderr, "usage: %s N\n", argv[0]); return 1; }
