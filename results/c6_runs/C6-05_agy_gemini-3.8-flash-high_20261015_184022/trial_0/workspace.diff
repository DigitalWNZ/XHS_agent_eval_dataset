+#/*
+import sys
+
+def main():
+    if len(sys.argv) < 2:
+        return
+    sys.set_int_max_str_digits(0)
+    n = int(sys.argv[1])
+    if n < 0:
+        return
+    a, b = 0, 1
+    for _ in range(n):
+        a, b = b, a + b
+    print(a)
+
+if __name__ == "__main__":
+    main()
+"""
+#*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define BASE 1000000000ULL
+
+typedef struct {
+    uint32_t *d;
+    size_t len;
+    size_t cap;
+} BigInt;
+
+static void init(BigInt *b, uint32_t val) {
+    b->cap = 16;
+    b->d = (uint32_t *)malloc(b->cap * sizeof(uint32_t));
+    if (!b->d) exit(1);
+    b->len = 1;
+    b->d[0] = val;
+}
+
+static void add(BigInt *res, const BigInt *x, const BigInt *y) {
+    size_t max_len = (x->len > y->len) ? x->len : y->len;
+    if (res->cap < max_len + 1) {
+        res->cap = (max_len + 1) * 2;
+        uint32_t *new_d = (uint32_t *)realloc(res->d, res->cap * sizeof(uint32_t));
+        if (!new_d) exit(1);
+        res->d = new_d;
+    }
+    uint64_t carry = 0;
+    size_t i = 0;
+    for (; i < max_len; i++) {
+        uint64_t sum = carry;
+        if (i < x->len) sum += x->d[i];
+        if (i < y->len) sum += y->d[i];
+        res->d[i] = (uint32_t)(sum % BASE);
+        carry = sum / BASE;
+    }
+    if (carry) {
+        res->d[i++] = (uint32_t)carry;
+    }
+    res->len = i;
+}
+
+static void print(const BigInt *b) {
+    if (b->len == 0) {
+        printf("0\n");
+        return;
+    }
+    printf("%u", b->d[b->len - 1]);
+    if (b->len > 1) {
+        for (size_t i = b->len - 1; i > 0; i--) {
+            printf("%09u", b->d[i - 1]);
+        }
+    }
+    printf("\n");
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long long n = atoll(argv[1]);
+    if (n < 0) return 1;
+    if (n == 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+    BigInt a, b, c;
+    init(&a, 0);
+    init(&b, 1);
+    init(&c, 0);
+    BigInt *pa = &a, *pb = &b, *pc = &c;
+    for (long long i = 2; i <= n; i++) {
+        add(pc, pa, pb);
+        BigInt *tmp = pa;
+        pa = pb;
+        pb = pc;
+        pc = tmp;
+    }
+    print(pb);
+    free(a.d);
+    free(b.d);
+    free(c.d);
+    return 0;
+}
+
+#/*
+"""
+#*/
