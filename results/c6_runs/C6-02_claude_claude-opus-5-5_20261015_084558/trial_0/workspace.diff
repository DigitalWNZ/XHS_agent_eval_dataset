+// BatchDurableInfo contains info about a Sync commit whose WAL sync has
+// completed.
+type BatchDurableInfo struct {
+	// JobID identifies this event. It may be passed to
+	// DB.WaitForJobDurability. BatchDurable job IDs are allocated from their
+	// own sequence, independent of other events' job IDs.
+	JobID int
+	// SeqNum is the sequence number of the first operation in the batch.
+	SeqNum base.SeqNum
+	// Err is non-nil if the WAL sync failed.
+	Err error
+	// ApplyDuration is the wall-clock time spent applying the batch to the
+	// memtable after it was written to the WAL.
+	ApplyDuration time.Duration
+	// SyncDuration is the wall-clock time from writing the batch to the WAL
+	// until the WAL sync completed and was observed by the committer.
+	SyncDuration time.Duration
+	// CorrelationID is WriteOptions.CommitCorrelationID.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch in bytes.
+	BatchSize int
+	// KeyCount is the number of operations in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error: seqnum %d: %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable: seqnum %d, %d keys, %s; apply %.3fs, sync %.3fs",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.KeyCount),
+		redact.Safe(humanize.Bytes.Int64(int64(i.BatchSize))),
+		redact.Safe(i.ApplyDuration.Seconds()), redact.Safe(i.SyncDuration.Seconds()))
+}
