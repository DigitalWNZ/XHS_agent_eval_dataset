+func TestWaitForJobDurability(t *testing.T) {
+	mem := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	el := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			durableEvents = append(durableEvents, info)
+			mu.Unlock()
+		},
+	}
+
+	d, err := Open("", &Options{
+		FS:            mem,
+		EventListener: &el,
+	})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Zero job ID -> unknown
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// 2. Never seen job ID -> unknown
+	err = d.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// 3. Perform a commit to get a real job ID
+	err = d.Set([]byte("k"), []byte("v"), Sync)
+	require.NoError(t, err)
+
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	jobID := durableEvents[0].JobID
+	mu.Unlock()
+
+	require.NoError(t, d.WaitForJobDurability(jobID))
+	require.NoError(t, d.WaitForJobDurabilityContext(context.Background(), jobID))
+}
