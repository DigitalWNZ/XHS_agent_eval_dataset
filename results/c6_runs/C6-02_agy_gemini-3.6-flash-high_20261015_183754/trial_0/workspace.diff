+func TestWaitForDurability(t *testing.T) {
+	mem := vfs.NewMem()
+	d, err := Open("", &Options{FS: mem})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// seq=0 succeeds after any commit
+	var wg sync.WaitGroup
+	var zeroErr error
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		zeroErr = d.WaitForDurability(0)
+	}()
+
+	err = d.Set([]byte("k1"), []byte("v1"), Sync)
+	require.NoError(t, err)
+
+	wg.Wait()
+	require.NoError(t, zeroErr)
+
+	// Waiting for durable seq
+	durableSeq, durErr := d.DurableState()
+	require.NoError(t, durErr)
+	require.Greater(t, durableSeq, base.SeqNum(0))
+
+	require.NoError(t, d.WaitForDurability(durableSeq))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), durableSeq))
+}
