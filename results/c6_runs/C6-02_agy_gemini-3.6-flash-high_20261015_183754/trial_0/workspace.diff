+func TestContextCancellationVsDurabilityError(t *testing.T) {
+	mem := vfs.NewMem()
+	d, err := Open("", &Options{FS: mem})
+	require.NoError(t, err)
+
+	// Create already durable seq
+	err = d.Set([]byte("k"), []byte("v"), Sync)
+	require.NoError(t, err)
+
+	seq, _ := d.DurableState()
+
+	// Cancelled context, but seq is ALREADY durable -> durability success takes precedence over context cancellation
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(ctx, seq)
+	require.NoError(t, err)
+
+	d.Close()
+}
+
+func TestCloseUnblocksWaiters(t *testing.T) {
+	mem := vfs.NewMem()
+	d, err := Open("", &Options{FS: mem})
+	require.NoError(t, err)
+
+	var wg sync.WaitGroup
+	var waitErr error
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		waitErr = d.WaitForDurability(999999)
+	}()
+
+	// Give goroutine a moment to block
+	time.Sleep(10 * time.Millisecond)
+
+	err = d.Close()
+	require.NoError(t, err)
+
+	wg.Wait()
+	require.Error(t, waitErr)
+}
