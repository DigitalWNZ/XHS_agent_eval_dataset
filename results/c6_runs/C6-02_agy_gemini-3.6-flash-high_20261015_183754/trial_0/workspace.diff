@@ -0,0 +1,310 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/pebble/vfs"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBatchDurableCallback(t *testing.T) {
+	mem := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	el := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			durableEvents = append(durableEvents, info)
+			mu.Unlock()
+		},
+	}
+
+	opts := &Options{
+		FS:            mem,
+		EventListener: &el,
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Non-sync commit should NOT trigger BatchDurable
+	err = d.Set([]byte("key1"), []byte("value1"), NoSync)
+	require.NoError(t, err)
+
+	mu.Lock()
+	require.Len(t, durableEvents, 0)
+	mu.Unlock()
+
+	// 2. Sync commit WITH CommitCorrelationID should trigger BatchDurable
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 4242,
+	}
+	err = d.Set([]byte("key2"), []byte("value2"), wo)
+	require.NoError(t, err)
+
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	ev := durableEvents[0]
+	mu.Unlock()
+
+	require.Greater(t, ev.JobID, 0)
+	require.Greater(t, ev.SeqNum, base.SeqNum(0))
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(4242), ev.CorrelationID)
+	require.Greater(t, ev.BatchSize, 0)
+	require.Equal(t, uint32(1), ev.KeyCount)
+
+	// Verify metrics accumulated since BatchDurable is configured
+	m := d.Metrics()
+	require.Equal(t, uint64(1), m.DurableCommitCount)
+	require.Greater(t, m.DurableCommitDuration, time.Duration(0))
+}
