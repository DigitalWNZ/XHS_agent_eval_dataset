+
+func (d *DB) onBatchDurable(
+	jobID int,
+	seq base.SeqNum,
+	keyCount uint32,
+	correlationID uint64,
+	batchSize int,
+	err error,
+	applyDuration time.Duration,
+	syncDuration time.Duration,
+) {
+	if err == nil {
+		if applyDuration <= 0 {
+			applyDuration = time.Nanosecond
+		}
+		if syncDuration <= 0 {
+			syncDuration = time.Nanosecond
+		}
+	}
+
+	d.durability.onBatchDurable(jobID, seq, keyCount, err, syncDuration)
+
+	if !d.batchDurableConfigured {
+		return
+	}
+
+	if err == nil {
+		d.metricsDurableCommitCount.Add(1)
+		d.metricsDurableCommitDuration.Add(int64(syncDuration))
+	}
+
+	info := BatchDurableInfo{
+		JobID:         jobID,
+		SeqNum:        seq,
+		Err:           err,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: correlationID,
+		BatchSize:     batchSize,
+		KeyCount:      keyCount,
+	}
+
+	d.opts.EventListener.BatchDurable(info)
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+func (d *DB) WaitForDurability(seq base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seq)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable or ctx is cancelled.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seq base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	d.durability.pendingWaiters.Add(1)
+	defer d.durability.pendingWaiters.Add(-1)
+	return d.durability.waitForDurability(ctx, seq)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqs is durable.
+func (d *DB) WaitForDurabilityBatch(seqs []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqs)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqs is durable or ctx is cancelled.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqs []base.SeqNum) error {
+	if len(seqs) == 0 || d.opts.DisableWAL {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqs {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the given job ID is durable.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the given job ID is durable or ctx is cancelled.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	d.durability.pendingWaiters.Add(1)
+	defer d.durability.pendingWaiters.Add(-1)
+	return d.durability.waitForJobDurability(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a receive-only channel that receives nil on success or an error on failure or close.
+func (d *DB) DurabilityNotify(seq base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.durabilityNotify(seq)
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.durabilityStats()
+}
diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..65b56447
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,414 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats contains a snapshot of WAL durability stats.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type seqWaiter struct {
+	seq base.SeqNum
+	ch  chan error
+}
+
+type jobWaiter struct {
+	jobID int
+	ch    chan error
+}
+
+type durabilityManager struct {
+	mu sync.Mutex
+
+	highestDurableSeq base.SeqNum
+	firstErr          error
+	closed            bool
+	closedErr         error
+
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+	pendingWaiters         atomic.Int64
+
+	seqWaiters    []*seqWaiter
+	activeJobs    map[int]*jobWaiter
+	completedJobs map[int]error
+	completedJobsQueue []int
+
+	subscriptions    map[chan error]base.SeqNum
+	maxSubscriptions int
+	maxCompletedJobs int
+
+	minRetainedJobID int
+	maxSeenJobID     int
+}
+
+func newDurabilityManager() *durabilityManager {
+	return &durabilityManager{
+		activeJobs:       make(map[int]*jobWaiter),
+		completedJobs:    make(map[int]error),
+		subscriptions:    make(map[chan error]base.SeqNum),
+		maxSubscriptions: 10000,
+		maxCompletedJobs: 10000,
+		minRetainedJobID: 1,
+	}
+}
+
+func (m *durabilityManager) registerJob(jobID int) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if jobID > m.maxSeenJobID {
+		m.maxSeenJobID = jobID
+	}
+	if _, ok := m.activeJobs[jobID]; !ok {
+		m.activeJobs[jobID] = &jobWaiter{
+			jobID: jobID,
+			ch:    make(chan error, 1),
+		}
+	}
+}
+
+func (m *durabilityManager) onBatchDurable(
+	jobID int, seq base.SeqNum, keyCount uint32, err error, syncDuration time.Duration,
+) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if err != nil {
+		m.totalFailedCommits++
+		if m.firstErr == nil {
+			m.firstErr = err
+		}
+	} else {
+		m.totalDurableCommits++
+		var endSeq base.SeqNum
+		if keyCount > 0 {
+			endSeq = seq + base.SeqNum(keyCount) - 1
+		} else {
+			endSeq = seq
+		}
+		if endSeq > m.highestDurableSeq {
+			m.highestDurableSeq = endSeq
+		}
+		m.cumulativeSyncDuration += syncDuration
+		if syncDuration > m.maxSyncDuration {
+			m.maxSyncDuration = syncDuration
+		}
+	}
+
+	// Record job result
+	if jobID > 0 {
+		if jw, ok := m.activeJobs[jobID]; ok {
+			resErr := err
+			if err == nil && m.firstErr != nil {
+				resErr = m.firstErr
+			}
+			jw.ch <- resErr
+			close(jw.ch)
+			delete(m.activeJobs, jobID)
+		}
+		m.completedJobs[jobID] = err
+		m.completedJobsQueue = append(m.completedJobsQueue, jobID)
+		if len(m.completedJobsQueue) > m.maxCompletedJobs {
+			oldest := m.completedJobsQueue[0]
+			m.completedJobsQueue = m.completedJobsQueue[1:]
+			delete(m.completedJobs, oldest)
+			m.minRetainedJobID = m.completedJobsQueue[0]
+		}
+	}
+
+	m.notifyWaitersLocked()
+}
+
+func (m *durabilityManager) notifyWaitersLocked() {
+	// Notify seqWaiters
+	if len(m.seqWaiters) > 0 {
+		remaining := m.seqWaiters[:0]
+		for _, w := range m.seqWaiters {
+			if m.isDurableLocked(w.seq) {
+				w.ch <- m.firstErr
+				close(w.ch)
+			} else if m.firstErr != nil {
+				w.ch <- m.firstErr
+				close(w.ch)
+			} else if m.closed {
+				w.ch <- m.closedErr
+				close(w.ch)
+			} else {
+				remaining = append(remaining, w)
+			}
+		}
+		m.seqWaiters = remaining
+	}
+
+	// Notify subscriptions
+	for ch, seq := range m.subscriptions {
+		if m.isDurableLocked(seq) {
+			ch <- m.firstErr
+			close(ch)
+			delete(m.subscriptions, ch)
+		} else if m.firstErr != nil {
+			ch <- m.firstErr
+			close(ch)
+			delete(m.subscriptions, ch)
+		} else if m.closed {
+			ch <- m.closedErr
+			close(ch)
+			delete(m.subscriptions, ch)
+		}
+	}
+}
+
+func (m *durabilityManager) isDurableLocked(seq base.SeqNum) bool {
+	if seq == 0 {
+		return (m.totalDurableCommits + m.totalFailedCommits) > 0
+	}
+	return m.highestDurableSeq >= seq
+}
+
+func (m *durabilityManager) waitForDurability(ctx context.Context, seq base.SeqNum) error {
+	m.mu.Lock()
+
+	if m.isDurableLocked(seq) {
+		err := m.firstErr
+		m.mu.Unlock()
+		return err
+	}
+
+	if m.firstErr != nil {
+		err := m.firstErr
+		m.mu.Unlock()
+		return err
+	}
+
+	if m.closed {
+		err := m.closedErr
+		m.mu.Unlock()
+		return err
+	}
+
+	if ctx.Err() != nil {
+		err := ctx.Err()
+		m.mu.Unlock()
+		return err
+	}
+
+	w := &seqWaiter{
+		seq: seq,
+		ch:  make(chan error, 1),
+	}
+	m.seqWaiters = append(m.seqWaiters, w)
+	m.mu.Unlock()
+
+	select {
+	case err := <-w.ch:
+		return err
+	case <-ctx.Done():
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		// Priority check: durability/close errors take precedence over context cancellation
+		if m.isDurableLocked(seq) {
+			m.removeSeqWaiterLocked(w)
+			return m.firstErr
+		}
+		if m.firstErr != nil {
+			m.removeSeqWaiterLocked(w)
+			return m.firstErr
+		}
+		if m.closed {
+			m.removeSeqWaiterLocked(w)
+			return m.closedErr
+		}
+		m.removeSeqWaiterLocked(w)
+		return ctx.Err()
+	}
+}
+
+func (m *durabilityManager) removeSeqWaiterLocked(w *seqWaiter) {
+	for i, sw := range m.seqWaiters {
+		if sw == w {
+			m.seqWaiters = append(m.seqWaiters[:i], m.seqWaiters[i+1:]...)
+			break
+		}
+	}
+}
+
+func (m *durabilityManager) waitForJobDurability(ctx context.Context, jobID int) error {
+	m.mu.Lock()
+
+	if jobID <= 0 || jobID > m.maxSeenJobID {
+		m.mu.Unlock()
+		return errors.Errorf("pebble: unknown job ID %d", jobID)
+	}
+
+	if jobID < m.minRetainedJobID {
+		m.mu.Unlock()
+		return errors.Errorf("pebble: job ID %d expired", jobID)
+	}
+
+	if err, ok := m.completedJobs[jobID]; ok {
+		if m.firstErr != nil && err == nil {
+			err = m.firstErr
+		}
+		m.mu.Unlock()
+		return err
+	}
+
+	if m.firstErr != nil {
+		err := m.firstErr
+		m.mu.Unlock()
+		return err
+	}
+
+	if m.closed {
+		err := m.closedErr
+		m.mu.Unlock()
+		return err
+	}
+
+	if ctx.Err() != nil {
+		err := ctx.Err()
+		m.mu.Unlock()
+		return err
+	}
+
+	jw, ok := m.activeJobs[jobID]
+	if !ok {
+		m.mu.Unlock()
+		return errors.Errorf("pebble: unknown job ID %d", jobID)
+	}
+
+	ch := jw.ch
+	m.mu.Unlock()
+
+	select {
+	case err := <-ch:
+		return err
+	case <-ctx.Done():
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		// Priority check: durability/close errors take precedence over context cancellation
+		if err, ok := m.completedJobs[jobID]; ok {
+			if m.firstErr != nil && err == nil {
+				err = m.firstErr
+			}
+			return err
+		}
+		if m.firstErr != nil {
+			return m.firstErr
+		}
+		if m.closed {
+			return m.closedErr
+		}
+		return ctx.Err()
+	}
+}
+
+func (m *durabilityManager) durableState() (base.SeqNum, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.highestDurableSeq, m.firstErr
+}
+
+func (m *durabilityManager) durabilityNotify(seq base.SeqNum) <-chan error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	ch := make(chan error, 1)
+
+	if m.isDurableLocked(seq) {
+		ch <- m.firstErr
+		return ch
+	}
+
+	if m.firstErr != nil {
+		ch <- m.firstErr
+		return ch
+	}
+
+	if m.closed {
+		ch <- m.closedErr
+		return ch
+	}
+
+	if len(m.subscriptions) >= m.maxSubscriptions {
+		ch <- errors.New("pebble: excess durability subscriptions")
+		return ch
+	}
+
+	m.subscriptions[ch] = seq
+	return ch
+}
+
+func (m *durabilityManager) durabilityStats() DurabilityStats {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	return DurabilityStats{
+		HighestDurableSeqNum:   m.highestDurableSeq,
+		FirstErr:               m.firstErr,
+		PendingWaiters:         m.pendingWaiters.Load(),
+		TotalDurableCommits:    m.totalDurableCommits,
+		TotalFailedCommits:     m.totalFailedCommits,
+		CumulativeSyncDuration: m.cumulativeSyncDuration,
+		MaxSyncDuration:        m.maxSyncDuration,
+	}
+}
+
+func (m *durabilityManager) close(err error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.closed {
+		return
+	}
+
+	m.closed = true
+	if err == nil {
+		err = ErrClosed
+	}
+	m.closedErr = err
+	if m.firstErr == nil {
+		m.firstErr = err
+	}
+
+	// Unblock all active seqWaiters
+	for _, w := range m.seqWaiters {
+		w.ch <- err
+		close(w.ch)
+	}
+	m.seqWaiters = nil
+
+	// Unblock all active jobs
+	for _, jw := range m.activeJobs {
+		jw.ch <- err
+		close(jw.ch)
+	}
+	m.activeJobs = make(map[int]*jobWaiter)
+
+	// Notify subscriptions
+	for ch := range m.subscriptions {
+		ch <- err
+		close(ch)
+	}
+	m.subscriptions = make(map[chan error]base.SeqNum)
+}
