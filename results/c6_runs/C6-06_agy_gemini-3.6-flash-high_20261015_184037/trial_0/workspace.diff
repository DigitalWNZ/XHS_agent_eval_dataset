@@ -0,0 +1,63 @@
+import asyncio
+from collections.abc import Awaitable, Callable
+
+async def run_tasks(
+    tasks: list[Callable[[], Awaitable[None]]],
+    max_concurrent: int,
+) -> None:
+    """
+    Runs a list of async task functions with at most max_concurrent running concurrently.
+    If interrupted or cancelled, ensures running tasks get a chance to run cleanup.
+    """
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be greater than 0")
+
+    tasks_list = list(tasks)
+    if not tasks_list:
+        return
+
+    queue: asyncio.Queue[Callable[[], Awaitable[None]]] = asyncio.Queue()
+    for task_fn in tasks_list:
+        queue.put_nowait(task_fn)
+
+    stop_workers = False
+    first_exception: BaseException | None = None
+
+    async def worker_loop() -> None:
+        nonlocal stop_workers, first_exception
+        while not stop_workers:
+            try:
+                task_fn = queue.get_nowait()
+            except asyncio.QueueEmpty:
+                break
+
+            try:
+                res = task_fn()
+                await res
+            except BaseException as exc:
+                if first_exception is None:
+                    first_exception = exc
+                stop_workers = True
+                raise
+
+    num_workers = int(min(max_concurrent, len(tasks_list)))
+    worker_tasks = [asyncio.create_task(worker_loop()) for _ in range(num_workers)]
+
+    try:
+        await asyncio.gather(*worker_tasks)
+    except BaseException as exc:
+        stop_workers = True
+        if first_exception is None:
+            first_exception = exc
+
+        for wt in worker_tasks:
+            if not wt.done():
+                wt.cancel()
+
+        try:
+            await asyncio.shield(asyncio.gather(*worker_tasks, return_exceptions=True))
+        except asyncio.CancelledError:
+            await asyncio.gather(*worker_tasks, return_exceptions=True)
+
+        if first_exception is not None:
+            raise first_exception
