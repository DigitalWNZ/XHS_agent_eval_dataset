@@ -0,0 +1,124 @@
+import asyncio
+import time
+from typing import Callable, Awaitable
+
+async def run_tasks(tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be positive")
+    if not tasks:
+        return
+
+    queue: asyncio.Queue[Callable[[], Awaitable[None]]] = asyncio.Queue()
+    for t in tasks:
+        queue.put_nowait(t)
+
+    stop_workers = False
+    first_exception: BaseException | None = None
+
+    async def worker():
+        nonlocal stop_workers, first_exception
+        while not stop_workers:
+            try:
+                task_fn = queue.get_nowait()
+            except asyncio.QueueEmpty:
+                break
+
+            try:
+                await task_fn()
+            except BaseException as exc:
+                if first_exception is None:
+                    first_exception = exc
+                stop_workers = True
+                raise
+
+    num_workers = min(max_concurrent, len(tasks))
+    worker_tasks = [asyncio.create_task(worker()) for _ in range(num_workers)]
+
+    try:
+        await asyncio.gather(*worker_tasks)
+    except BaseException as exc:
+        stop_workers = True
+        if first_exception is None:
+            first_exception = exc
+
+        for wt in worker_tasks:
+            if not wt.done():
+                wt.cancel()
+
+        try:
+            await asyncio.shield(asyncio.gather(*worker_tasks, return_exceptions=True))
+        except asyncio.CancelledError:
+            await asyncio.gather(*worker_tasks, return_exceptions=True)
+
+        raise first_exception
+
+async def test_async_cleanup_on_cancel():
+    cleanup_run = []
+
+    async def worker(id):
+        try:
+            await asyncio.sleep(10)
+        finally:
+            print(f"Task {id} starting async cleanup")
+            await asyncio.sleep(0.1)
+            print(f"Task {id} finished async cleanup")
+            cleanup_run.append(id)
+
+    tasks = [lambda i=i: worker(i) for i in range(3)]
+    t = asyncio.create_task(run_tasks(tasks, 2))
+    await asyncio.sleep(0.05)
+    t.cancel()
+    try:
+        await t
+    except asyncio.CancelledError:
+        print("Caught CancelledError as expected")
+
+    assert len(cleanup_run) == 2, f"Expected 2 cleanups, got {len(cleanup_run)}: {cleanup_run}"
+    print(f"Async cleanup test passed! cleanups={cleanup_run}")
+
+async def test_exception_in_task():
+    cleanup_run = []
+
+    async def worker_bad():
+        await asyncio.sleep(0.05)
+        raise RuntimeError("Task failed")
+
+    async def worker_good(id):
+        try:
+            await asyncio.sleep(10)
+        finally:
+            cleanup_run.append(id)
+
+    tasks = [worker_bad] + [lambda i=i: worker_good(i) for i in range(2)]
+    try:
+        await run_tasks(tasks, 2)
+        assert False, "Should have raised RuntimeError"
+    except RuntimeError as e:
+        assert str(e) == "Task failed"
+        print("Caught task exception as expected")
+
+    assert len(cleanup_run) == 1, f"Expected 1 cleanup, got {len(cleanup_run)}: {cleanup_run}"
+    print(f"Exception in task test passed! cleanups={cleanup_run}")
+
+async def test_sync_exception_in_task_fn():
+    def bad_task_fn():
+        raise ValueError("Sync error during task creation")
+
+    async def good_task(id):
+        await asyncio.sleep(0.01)
+
+    tasks = [bad_task_fn, lambda: good_task(1)]
+    try:
+        await run_tasks(tasks, 2)
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert str(e) == "Sync error during task creation"
+        print("Caught sync exception in task_fn as expected")
+
+async def main():
+    await test_async_cleanup_on_cancel()
+    await test_exception_in_task()
+    await test_sync_exception_in_task_fn()
+
+if __name__ == "__main__":
+    asyncio.run(main())
