diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..0b07afb4
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,487 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"container/heap"
+	"context"
+	"reflect"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// ErrDurabilityJobExpired is returned by DB.WaitForJobDurability when the
+// requested job ID was observed, but has since fallen outside of the bounded
+// retention window of durability jobs.
+var ErrDurabilityJobExpired = errors.New("pebble: durability job expired")
+
+// ErrDurabilityJobUnknown is returned by DB.WaitForJobDurability when the
+// requested job ID was never observed as a durability job (including the
+// zero job ID).
+var ErrDurabilityJobUnknown = errors.New("pebble: durability job unknown")
+
+// errTooManyDurabilitySubscriptions is delivered on channels returned by
+// DB.DurabilityNotify when the number of outstanding subscriptions exceeds
+// maxDurabilitySubscriptions.
+var errTooManyDurabilitySubscriptions = errors.New("pebble: too many outstanding durability subscriptions")
+
+const (
+	// durabilityJobRetention is the number of most recent durability jobs whose
+	// outcomes are retained for DB.WaitForJobDurability.
+	durabilityJobRetention = 4096
+	// maxDurabilitySubscriptions bounds the number of outstanding channels
+	// returned by DB.DurabilityNotify.
+	maxDurabilitySubscriptions = 1 << 16
+)
+
+// DurabilityStats is a snapshot of the durability state of a DB. See
+// DB.DurabilityStats.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number known to be durable.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first WAL sync error observed by a sync commit.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in one of
+	// the DB.WaitFor*Durability* methods.
+	PendingWaiters int64
+	// TotalDurableCommits is the number of sync commits that became durable.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the number of sync commits whose WAL sync failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the cumulative WAL sync phase duration of all
+	// sync commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the largest WAL sync phase duration of any sync
+	// commit.
+	MaxSyncDuration time.Duration
+}
+
+// noopBatchDurable is the default EventListener.BatchDurable callback. It is a
+// named function so that the DB can detect whether the user configured a
+// BatchDurable callback.
+func noopBatchDurable(BatchDurableInfo) {}
+
+func isNoopBatchDurable(fn func(BatchDurableInfo)) bool {
+	return fn == nil || reflect.ValueOf(fn).Pointer() == reflect.ValueOf(noopBatchDurable).Pointer()
+}
+
+type durabilityJobResult struct {
+	seqNum base.SeqNum
+	err    error
+}
+
+// durabilityWaiter is a single waiter on a durable sequence number. ch is
+// buffered with capacity 1 and receives exactly one value.
+type durabilityWaiter struct {
+	seqNum base.SeqNum
+	ch     chan error
+	// subscription is true for waiters created by DB.DurabilityNotify.
+	subscription bool
+	// index is the position in the waiter heap, or -1 if removed.
+	index int
+}
+
+type durabilityWaiterHeap []*durabilityWaiter
+
+func (h durabilityWaiterHeap) Len() int           { return len(h) }
+func (h durabilityWaiterHeap) Less(i, j int) bool { return h[i].seqNum < h[j].seqNum }
+func (h durabilityWaiterHeap) Swap(i, j int) {
+	h[i], h[j] = h[j], h[i]
+	h[i].index = i
+	h[j].index = j
+}
+func (h *durabilityWaiterHeap) Push(x any) {
+	w := x.(*durabilityWaiter)
+	w.index = len(*h)
+	*h = append(*h, w)
+}
+func (h *durabilityWaiterHeap) Pop() any {
+	old := *h
+	n := len(old)
+	w := old[n-1]
+	old[n-1] = nil
+	w.index = -1
+	*h = old[:n-1]
+	return w
+}
+
+// durabilityTracker tracks the highest durable sequence number, as observed
+// by sync commits, and the goroutines waiting on durability.
+type durabilityTracker struct {
+	// disabled is set when the WAL is disabled. All waits succeed immediately.
+	disabled bool
+	// eventConfigured is set when the user configured
+	// EventListener.BatchDurable.
+	eventConfigured bool
+
+	pendingWaiters atomic.Int64
+	// Metrics accumulated only when eventConfigured is set.
+	metricCount    atomic.Uint64
+	metricDuration atomic.Int64
+
+	mu struct {
+		sync.Mutex
+		durable  base.SeqNum
+		firstErr error
+		closeErr error
+
+		waiters       durabilityWaiterHeap
+		subscriptions int
+
+		jobs map[int]durabilityJobResult
+		// jobOrder holds job IDs in the order they were recorded, used to evict
+		// the oldest jobs once the retention window is exceeded.
+		jobOrder []int
+		// minJobID is the smallest job ID ever recorded (0 if none).
+		minJobID int
+		// maxEvictedJobID is the largest job ID ever evicted (0 if none).
+		maxEvictedJobID int
+
+		totalDurable    uint64
+		totalFailed     uint64
+		cumulativeSync  time.Duration
+		maxSyncDuration time.Duration
+	}
+}
+
+func newDurabilityTracker(opts *Options) *durabilityTracker {
+	t := &durabilityTracker{
+		disabled:        opts.DisableWAL,
+		eventConfigured: opts.EventListener != nil && !isNoopBatchDurable(opts.EventListener.BatchDurable),
+	}
+	t.mu.jobs = make(map[int]durabilityJobResult)
+	return t
+}
+
+// record records the outcome of a sync commit, waking any waiters that are
+// now satisfied. jobID is zero if no job ID was allocated.
+func (t *durabilityTracker) record(
+	jobID int, seqNum base.SeqNum, count uint32, err error, syncDuration time.Duration,
+) {
+	if t.eventConfigured {
+		t.metricCount.Add(1)
+		t.metricDuration.Add(int64(syncDuration))
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if err != nil {
+		t.mu.totalFailed++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+	} else {
+		t.mu.totalDurable++
+		// The WAL is written sequentially, so a successful sync of this batch
+		// implies everything written before it is durable too.
+		last := seqNum
+		if count > 0 {
+			last = seqNum + base.SeqNum(count) - 1
+		}
+		if last > t.mu.durable {
+			t.mu.durable = last
+		}
+	}
+	t.mu.cumulativeSync += syncDuration
+	if syncDuration > t.mu.maxSyncDuration {
+		t.mu.maxSyncDuration = syncDuration
+	}
+	if jobID > 0 {
+		t.recordJobLocked(jobID, durabilityJobResult{seqNum: seqNum, err: err})
+	}
+	t.notifyLocked()
+}
+
+func (t *durabilityTracker) recordJobLocked(jobID int, res durabilityJobResult) {
+	if t.mu.minJobID == 0 || jobID < t.mu.minJobID {
+		t.mu.minJobID = jobID
+	}
+	t.mu.jobs[jobID] = res
+	t.mu.jobOrder = append(t.mu.jobOrder, jobID)
+	if len(t.mu.jobOrder) > durabilityJobRetention {
+		evicted := t.mu.jobOrder[0]
+		t.mu.jobOrder = t.mu.jobOrder[1:]
+		delete(t.mu.jobs, evicted)
+		if evicted > t.mu.maxEvictedJobID {
+			t.mu.maxEvictedJobID = evicted
+		}
+		// Compact the backing array periodically so it doesn't grow without
+		// bound.
+		if cap(t.mu.jobOrder) > 4*durabilityJobRetention {
+			t.mu.jobOrder = append([]int(nil), t.mu.jobOrder...)
+		}
+	}
+}
+
+// statusLocked returns (true, err) if a wait on seqNum is resolved with err,
+// or (false, nil) if the wait must continue.
+func (t *durabilityTracker) statusLocked(seqNum base.SeqNum) (bool, error) {
+	switch {
+	case seqNum <= t.mu.durable:
+		return true, nil
+	case t.mu.firstErr != nil:
+		return true, t.mu.firstErr
+	case t.mu.closeErr != nil:
+		return true, t.mu.closeErr
+	}
+	return false, nil
+}
+
+func (t *durabilityTracker) notifyLocked() {
+	for len(t.mu.waiters) > 0 {
+		w := t.mu.waiters[0]
+		done, err := t.statusLocked(w.seqNum)
+		if !done {
+			// The heap is ordered by seqNum, and errors resolve every waiter, so
+			// no other waiter can be resolved.
+			return
+		}
+		heap.Pop(&t.mu.waiters)
+		t.resolveLocked(w, err)
+	}
+}
+
+func (t *durabilityTracker) resolveLocked(w *durabilityWaiter, err error) {
+	if w.subscription {
+		t.mu.subscriptions--
+	}
+	w.ch <- err
+}
+
+// close resolves all outstanding waiters with err.
+func (t *durabilityTracker) close(err error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closeErr == nil {
+		t.mu.closeErr = err
+	}
+	t.notifyLocked()
+}
+
+// register returns a channel that receives the outcome of waiting for seqNum.
+// If the outcome is already known, the returned channel is pre-filled and the
+// returned waiter is nil.
+func (t *durabilityTracker) register(
+	seqNum base.SeqNum, subscription bool,
+) (*durabilityWaiter, <-chan error) {
+	ch := make(chan error, 1)
+	if t.disabled {
+		ch <- nil
+		return nil, ch
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if done, err := t.statusLocked(seqNum); done {
+		ch <- err
+		return nil, ch
+	}
+	if subscription {
+		if t.mu.subscriptions >= maxDurabilitySubscriptions {
+			ch <- errTooManyDurabilitySubscriptions
+			return nil, ch
+		}
+		t.mu.subscriptions++
+	}
+	w := &durabilityWaiter{seqNum: seqNum, ch: ch, subscription: subscription}
+	heap.Push(&t.mu.waiters, w)
+	return w, ch
+}
+
+// unregister removes w from the waiter heap if it hasn't been resolved yet.
+func (t *durabilityTracker) unregister(w *durabilityWaiter) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if w.index >= 0 && w.index < len(t.mu.waiters) && t.mu.waiters[w.index] == w {
+		heap.Remove(&t.mu.waiters, w.index)
+		if w.subscription {
+			t.mu.subscriptions--
+		}
+	}
+}
+
+// wait blocks until seqNum is durable, a WAL sync error is observed, the DB
+// is closed, or ctx is done. Durability and close errors take precedence over
+// context cancellation.
+func (t *durabilityTracker) wait(ctx context.Context, seqNum base.SeqNum) error {
+	w, ch := t.register(seqNum, false /* subscription */)
+	if w == nil {
+		return <-ch
+	}
+	t.pendingWaiters.Add(1)
+	defer t.pendingWaiters.Add(-1)
+	select {
+	case err := <-ch:
+		return err
+	case <-ctx.Done():
+		t.unregister(w)
+		// The waiter may have been resolved concurrently with the context being
+		// canceled. Prefer the durability outcome if so.
+		select {
+		case err := <-ch:
+			return err
+		default:
+		}
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) waitForJob(jobID int) error {
+	if t.disabled {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if jobID <= 0 {
+		return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", errors.Safe(jobID))
+	}
+	if res, ok := t.mu.jobs[jobID]; ok {
+		return res.err
+	}
+	if t.mu.minJobID != 0 && jobID >= t.mu.minJobID && jobID <= t.mu.maxEvictedJobID {
+		return errors.Wrapf(ErrDurabilityJobExpired, "job %d", errors.Safe(jobID))
+	}
+	return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", errors.Safe(jobID))
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.durable, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.durable,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.pendingWaiters.Load(),
+		TotalDurableCommits:    t.mu.totalDurable,
+		TotalFailedCommits:     t.mu.totalFailed,
+		CumulativeSyncDuration: t.mu.cumulativeSync,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+// batchDurable records the durability outcome of a sync commit of b and
+// invokes EventListener.BatchDurable. It must be called exactly once per sync
+// commit, after the WAL sync has completed.
+func (d *DB) batchDurable(
+	seqNum base.SeqNum,
+	count uint32,
+	size int,
+	correlationID uint64,
+	applyDuration, syncDuration time.Duration,
+	err error,
+) {
+	// Durations are measured with a monotonic clock, but may still round to
+	// zero on platforms with a coarse clock.
+	applyDuration = max(applyDuration, time.Nanosecond)
+	syncDuration = max(syncDuration, time.Nanosecond)
+
+	var jobID int
+	if d.durability.eventConfigured {
+		// Job IDs are only observable through the BatchDurable callback, so
+		// avoid acquiring DB.mu on the commit path when it isn't configured.
+		jobID = int(d.newJobID())
+	}
+	d.durability.record(jobID, seqNum, count, err, syncDuration)
+	if d.durability.eventConfigured {
+		d.opts.EventListener.BatchDurable(BatchDurableInfo{
+			JobID:         jobID,
+			SeqNum:        seqNum,
+			Err:           err,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: correlationID,
+			BatchSize:     size,
+			KeyCount:      count,
+		})
+	}
+}
+
+// WaitForDurability blocks until the provided sequence number is durable
+// (i.e., a WAL sync covering it has completed), a WAL sync fails, or the DB is
+// closed. A zero sequence number is always durable. If the WAL is disabled,
+// WaitForDurability returns nil immediately.
+//
+// Durability is observed through sync commits: a sequence number written by a
+// non-sync commit becomes durable once a subsequent sync commit completes.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability, but also returns when
+// ctx is done. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.wait(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable. It returns nil immediately if seqNums is empty.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch, but also
+// returns when ctx is done. Durability and close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	// Durability is monotonic, so waiting for the largest sequence number
+	// suffices.
+	maxSeqNum := seqNums[0]
+	for _, s := range seqNums[1:] {
+		maxSeqNum = max(maxSeqNum, s)
+	}
+	return d.durability.wait(ctx, maxSeqNum)
+}
+
+// WaitForJobDurability waits for the sync commit identified by the JobID of a
+// BatchDurableInfo, returning its WAL sync error. Only a bounded number of the
+// most recent jobs are retained: older jobs return an error wrapping
+// ErrDurabilityJobExpired. Job IDs that were never observed (including zero)
+// return an error wrapping ErrDurabilityJobUnknown.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability, but also returns
+// when ctx is done. Durability errors take precedence over context
+// cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	// Job IDs are recorded before they are surfaced through the BatchDurable
+	// callback, so the outcome of any observable job is already known.
+	return d.durability.waitForJob(jobID)
+}
+
+// DurableState returns the highest sequence number known to be durable and
+// the first WAL sync error observed by a sync commit, if any.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a channel that receives a single value once
+// seqNum is durable (nil), or a WAL sync fails or the DB is closed (non-nil).
+// The channel is buffered, so the receiver may read from it at any time. If
+// the outcome is already known, the channel is pre-filled. The number of
+// outstanding subscriptions is bounded; excess callers receive a pre-filled
+// channel with a non-nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	_, ch := d.durability.register(seqNum, true /* subscription */)
+	return ch
+}
+
+// DurabilityStats returns a snapshot of the DB's durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
