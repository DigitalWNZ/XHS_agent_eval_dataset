+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error: seqnum %d: %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable: seqnum %d, %d keys, %d bytes, apply %.1fms, sync %.1fms",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.KeyCount), redact.Safe(i.BatchSize),
+		redact.Safe(i.ApplyDuration.Seconds()*1000), redact.Safe(i.SyncDuration.Seconds()*1000))
+}
