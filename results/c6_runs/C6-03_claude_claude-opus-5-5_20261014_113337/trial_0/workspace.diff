+type BatchDurableInfo struct {
+	// JobID is the ID of the durability job. It may be passed to
+	// DB.WaitForJobDurability.
+	JobID int
+	// SeqNum is the base sequence number of the committed batch.
+	SeqNum base.SeqNum
+	// Err is the WAL sync error, if any.
+	Err error
+	// ApplyDuration is the time spent applying the batch to the memtable.
+	ApplyDuration time.Duration
