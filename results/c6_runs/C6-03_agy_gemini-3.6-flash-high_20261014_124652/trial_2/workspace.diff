+// BatchDurableInfo contains information for a batch durability event.
+type BatchDurableInfo struct {
+	JobID         int
+	SeqNum        base.SeqNum
+	Err           error
+	ApplyDuration time.Duration
+	SyncDuration  time.Duration
+	CorrelationID uint64
+	BatchSize     int
+	KeyCount      uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable seq %s correlation %d error: %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.CorrelationID), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable seq %s correlation %d size %d keys %d apply %.1fms sync %.1fms",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.CorrelationID), redact.Safe(i.BatchSize), redact.Safe(i.KeyCount),
+		redact.Safe(i.ApplyDuration.Seconds()*1000), redact.Safe(i.SyncDuration.Seconds()*1000))
+}
