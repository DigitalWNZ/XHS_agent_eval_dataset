+func TestWaitForDurability(t *testing.T) {
+	mem := vfs.NewMem()
+	opts := &Options{FS: mem}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. WaitForDurability(0) before any commits: blocks until a commit happens
+	var wg sync.WaitGroup
+	wg.Add(1)
+	var waitErr error
+	go func() {
+		defer wg.Done()
+		waitErr = d.WaitForDurability(0)
+	}()
+
+	time.Sleep(20 * time.Millisecond)
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	wg.Wait()
+	require.NoError(t, waitErr)
+
+	// 2. WaitForDurability(0) after a commit: returns immediately
+	require.NoError(t, d.WaitForDurability(0))
+
+	// 3. WaitForDurability for a specific seqnum
+	seq, err := d.DurableState()
+	require.NoError(t, err)
+	require.NoError(t, d.WaitForDurability(seq))
+
+	// 4. Future seqnum wait
+	nextSeq := seq + 1
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		waitErr = d.WaitForDurability(nextSeq)
+	}()
+
+	time.Sleep(20 * time.Millisecond)
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	wg.Wait()
+	require.NoError(t, waitErr)
+}
