+func TestDurabilityStatsAndWaiters(t *testing.T) {
+	mem := vfs.NewMem()
+	opts := &Options{
+		FS: mem,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	stats0 := d.DurabilityStats()
+	require.Equal(t, base.SeqNum(0), stats0.HighestDurableSeqNum)
+	require.NoError(t, stats0.FirstErr)
+	require.Equal(t, int64(0), stats0.PendingWaiters)
+	require.Equal(t, uint64(0), stats0.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats0.TotalFailedCommits)
+
+	// Check PendingWaiters during wait
+	seq, _ := d.DurableState()
+	nextSeq := seq + 1
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		_ = d.WaitForDurability(nextSeq)
+	}()
+
+	time.Sleep(30 * time.Millisecond)
+	stats1 := d.DurabilityStats()
+	require.Equal(t, int64(1), stats1.PendingWaiters)
+
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	wg.Wait()
+
+	// Commit updates stats
+	stats2 := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats2.TotalDurableCommits)
+	require.Greater(t, stats2.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats2.MaxSyncDuration, time.Duration(0))
+}
