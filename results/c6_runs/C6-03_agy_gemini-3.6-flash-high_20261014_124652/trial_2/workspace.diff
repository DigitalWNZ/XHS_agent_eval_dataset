+func TestDurabilityNotifyExcessSubscriptions(t *testing.T) {
+	mem := vfs.NewMem()
+	opts := &Options{FS: mem}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	futureSeq := base.SeqNum(999999)
+	for i := 0; i < maxDurabilitySubscriptions; i++ {
+		_ = d.DurabilityNotify(futureSeq)
+	}
+
+	// Excess caller gets pre-filled channel with immediate error
+	excessCh := d.DurabilityNotify(futureSeq)
+	err = <-excessCh
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "excess")
+}
