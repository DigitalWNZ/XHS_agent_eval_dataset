+func TestBatchDurableCallback(t *testing.T) {
+	mem := vfs.NewMem()
+	var mu sync.Mutex
+	var durableInfos []BatchDurableInfo
+
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			defer mu.Unlock()
+			durableInfos = append(durableInfos, info)
+		},
+	}
+
+	opts := &Options{
+		FS:            mem,
+		EventListener: &listener,
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Sync commit with CommitCorrelationID
+	writeOpts := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}
+	require.NoError(t, d.Set([]byte("key1"), []byte("val1"), writeOpts))
+
+	mu.Lock()
+	require.Len(t, durableInfos, 1)
+	info1 := durableInfos[0]
+	mu.Unlock()
+
+	require.Greater(t, info1.JobID, 0)
+	require.Greater(t, info1.SeqNum, base.SeqNum(0))
+	require.NoError(t, info1.Err)
+	require.Greater(t, info1.ApplyDuration, time.Duration(0))
+	require.Greater(t, info1.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), info1.CorrelationID)
+	require.Greater(t, info1.BatchSize, 0)
+	require.Equal(t, uint32(1), info1.KeyCount)
+
+	// 2. Non-sync commit - must NOT trigger callback
+	noSyncOpts := &WriteOptions{
+		Sync:                false,
+		CommitCorrelationID: 99,
+	}
+	require.NoError(t, d.Set([]byte("key2"), []byte("val2"), noSyncOpts))
+
+	mu.Lock()
+	require.Len(t, durableInfos, 1) // still 1
+	mu.Unlock()
+
+	// 3. Batch commit with multiple keys
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("key3"), []byte("val3"), nil))
+	require.NoError(t, b.Set([]byte("key4"), []byte("val4"), nil))
+	syncOpts2 := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 100,
+	}
+	require.NoError(t, b.Commit(syncOpts2))
+
+	mu.Lock()
+	require.Len(t, durableInfos, 2)
+	info2 := durableInfos[1]
+	mu.Unlock()
+
+	require.Equal(t, uint64(100), info2.CorrelationID)
+	require.Equal(t, uint32(2), info2.KeyCount)
+}
