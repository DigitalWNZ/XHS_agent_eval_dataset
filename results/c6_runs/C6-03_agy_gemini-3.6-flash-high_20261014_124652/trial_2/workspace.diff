+func TestDurabilityNotify(t *testing.T) {
+	mem := vfs.NewMem()
+	opts := &Options{FS: mem}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. DurabilityNotify for a seqnum that is not yet durable
+	seq, _ := d.DurableState()
+	nextSeq := seq + 1
+	ch := d.DurabilityNotify(nextSeq)
+
+	go func() {
+		time.Sleep(20 * time.Millisecond)
+		require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	}()
+
+	notifyErr := <-ch
+	require.NoError(t, notifyErr)
+
+	// 2. DurabilityNotify for already durable seqnum
+	durableSeq, _ := d.DurableState()
+	ch2 := d.DurabilityNotify(durableSeq)
+	require.NoError(t, <-ch2)
+}
