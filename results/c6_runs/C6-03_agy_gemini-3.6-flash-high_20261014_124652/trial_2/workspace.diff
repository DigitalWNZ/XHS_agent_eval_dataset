+func TestMetricsDurableCommit(t *testing.T) {
+	mem := vfs.NewMem()
+
+	// 1. With EventListener.BatchDurable configured
+	opts1 := &Options{
+		FS: mem,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {},
+		},
+	}
+	d1, err := Open("db1", opts1)
+	require.NoError(t, err)
+
+	require.NoError(t, d1.Set([]byte("k1"), []byte("v1"), Sync))
+	m1 := d1.Metrics()
+	require.Equal(t, uint64(1), m1.DurableCommitCount)
+	require.Greater(t, m1.DurableCommitDuration, time.Duration(0))
+	require.NoError(t, d1.Close())
+
+	// 2. WITHOUT EventListener.BatchDurable configured
+	opts2 := &Options{
+		FS: mem,
+	}
+	d2, err := Open("db2", opts2)
+	require.NoError(t, err)
+
+	require.NoError(t, d2.Set([]byte("k1"), []byte("v1"), Sync))
+	m2 := d2.Metrics()
+	require.Equal(t, uint64(0), m2.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m2.DurableCommitDuration)
+	require.NoError(t, d2.Close())
+}
