+func TestWaitForJobDurability(t *testing.T) {
+	mem := vfs.NewMem()
+	var durableJobIDs []int
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: mem,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				durableJobIDs = append(durableJobIDs, info.JobID)
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Unknown job ID 0
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Never-seen job ID
+	err = d.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Commit a write and get its job ID
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+
+	mu.Lock()
+	require.Len(t, durableJobIDs, 1)
+	jobID := durableJobIDs[0]
+	mu.Unlock()
+
+	require.NoError(t, d.WaitForJobDurability(jobID))
+}
