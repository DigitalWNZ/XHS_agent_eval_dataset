+func TestBatchDurableDisableWAL(t *testing.T) {
+	mem := vfs.NewMem()
+	var durableInfos []BatchDurableInfo
+
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			durableInfos = append(durableInfos, info)
+		},
+	}
+
+	opts := &Options{
+		FS:            mem,
+		EventListener: &listener,
+		DisableWAL:    true,
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Commit when DisableWAL is true - must NEVER trigger BatchDurable
+	require.NoError(t, d.Set([]byte("key1"), []byte("val1"), NoSync))
+	require.Empty(t, durableInfos)
+}
