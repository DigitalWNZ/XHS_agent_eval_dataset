+func TestWaitAPIsOnDBClose(t *testing.T) {
+	mem := vfs.NewMem()
+	opts := &Options{FS: mem}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+
+	var err1, err2 error
+	var ch <-chan error
+	var wg sync.WaitGroup
+
+	futureSeq := base.SeqNum(99999)
+
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		err1 = d.WaitForDurability(futureSeq)
+	}()
+	go func() {
+		defer wg.Done()
+		ch = d.DurabilityNotify(futureSeq)
+	}()
+
+	time.Sleep(20 * time.Millisecond)
+	require.NoError(t, d.Close())
+	wg.Wait()
+
+	require.True(t, errors.Is(err1, ErrClosed))
+	require.True(t, errors.Is(<-ch, ErrClosed))
+
+	// Calling after close also returns ErrClosed
+	err2 = d.WaitForJobDurability(1)
+	require.True(t, errors.Is(err2, ErrClosed))
+}
+
+func TestContextCancellationPrecedence(t *testing.T) {
+	mem := vfs.NewMem()
+	opts := &Options{FS: mem}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Cancelled context when NOT durable returns ctx.Err()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(ctx, 99999)
+	require.Error(t, err)
+	require.Equal(t, context.Canceled, err)
+
+	// Cancelled context when IS durable returns nil
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	seq, _ := d.DurableState()
+
+	err = d.WaitForDurabilityContext(ctx, seq)
+	require.NoError(t, err)
+}
