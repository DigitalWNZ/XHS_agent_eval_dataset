diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..e5d6825d
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,480 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats holds a snapshot of durability-related counters and state.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+const maxJobRetention = 10000
+const maxDurabilitySubscriptions = 1000
+
+type jobDurabilityEntry struct {
+	done    bool
+	err     error
+	waiters []chan error
+}
+
+type durabilityNotifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityManager struct {
+	disableWAL             bool
+	batchDurableConfigured bool
+
+	mu struct {
+		sync.Mutex
+		highestDurableSeqNum   base.SeqNum
+		firstErr               error
+		closedErr              error
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		minRetainedJobID int
+		maxSeenJobID     int
+		jobs             map[int]*jobDurabilityEntry
+
+		notifySubs []durabilityNotifySub
+	}
+
+	pendingWaiters        atomic.Int64
+	durableCommitCount    atomic.Uint64
+	durableCommitDuration atomic.Int64 // nanoseconds
+}
+
+func (m *durabilityManager) init(disableWAL bool, batchDurableConfigured bool) {
+	m.disableWAL = disableWAL
+	m.batchDurableConfigured = batchDurableConfigured
+	m.mu.jobs = make(map[int]*jobDurabilityEntry)
+}
+
+func (m *durabilityManager) registerJob(jobID int) {
+	if m.disableWAL || jobID <= 0 {
+		return
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if jobID > m.mu.maxSeenJobID {
+		m.mu.maxSeenJobID = jobID
+	}
+	if m.mu.minRetainedJobID == 0 {
+		m.mu.minRetainedJobID = jobID
+	}
+	if _, ok := m.mu.jobs[jobID]; !ok {
+		m.mu.jobs[jobID] = &jobDurabilityEntry{
+			done: false,
+		}
+	}
+}
+
+func (m *durabilityManager) onBatchDurable(d *DB, info BatchDurableInfo) {
+	if m.disableWAL {
+		return
+	}
+
+	// 1. Fire EventListener callback
+	d.opts.EventListener.BatchDurable(info)
+
+	// 2. Accumulate metrics if batchDurableConfigured
+	if m.batchDurableConfigured && info.Err == nil {
+		m.durableCommitCount.Add(1)
+		m.durableCommitDuration.Add(int64(info.SyncDuration))
+	}
+
+	// 3. Update durability state under lock
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if info.Err == nil {
+		m.mu.totalDurableCommits++
+		m.mu.cumulativeSyncDuration += info.SyncDuration
+		if info.SyncDuration > m.mu.maxSyncDuration {
+			m.mu.maxSyncDuration = info.SyncDuration
+		}
+		endSeqNum := info.SeqNum + base.SeqNum(info.KeyCount)
+		if endSeqNum > m.mu.highestDurableSeqNum {
+			m.mu.highestDurableSeqNum = endSeqNum
+		}
+	} else {
+		m.mu.totalFailedCommits++
+		if m.mu.firstErr == nil {
+			m.mu.firstErr = info.Err
+		}
+	}
+
+	// Update job state
+	if info.JobID > 0 {
+		entry, ok := m.mu.jobs[info.JobID]
+		if !ok {
+			entry = &jobDurabilityEntry{}
+			m.mu.jobs[info.JobID] = entry
+			if info.JobID > m.mu.maxSeenJobID {
+				m.mu.maxSeenJobID = info.JobID
+			}
+			if m.mu.minRetainedJobID == 0 {
+				m.mu.minRetainedJobID = info.JobID
+			}
+		}
+		entry.done = true
+		entry.err = info.Err
+		for _, ch := range entry.waiters {
+			ch <- info.Err
+		}
+		entry.waiters = nil
+
+		m.pruneJobsLocked()
+	}
+
+	// Notify seqNum subscriptions and waiters
+	m.processNotifySubsLocked()
+}
+
+func (m *durabilityManager) pruneJobsLocked() {
+	for len(m.mu.jobs) > maxJobRetention && m.mu.minRetainedJobID <= m.mu.maxSeenJobID {
+		entry, ok := m.mu.jobs[m.mu.minRetainedJobID]
+		if ok && entry.done {
+			delete(m.mu.jobs, m.mu.minRetainedJobID)
+		}
+		m.mu.minRetainedJobID++
+	}
+}
+
+func (m *durabilityManager) onClose(err error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.mu.closedErr == nil {
+		m.mu.closedErr = err
+	}
+	if m.mu.firstErr == nil {
+		m.mu.firstErr = err
+	}
+
+	// Unblock all pending jobs
+	for _, entry := range m.mu.jobs {
+		if !entry.done {
+			entry.done = true
+			entry.err = err
+			for _, ch := range entry.waiters {
+				ch <- err
+			}
+			entry.waiters = nil
+		}
+	}
+
+	// Process notify subs
+	m.processNotifySubsLocked()
+}
+
+func (m *durabilityManager) isDurableLocked(seqNum base.SeqNum) bool {
+	if seqNum == 0 {
+		return m.mu.totalDurableCommits > 0 || m.mu.highestDurableSeqNum > 0
+	}
+	return m.mu.highestDurableSeqNum >= seqNum
+}
+
+func (m *durabilityManager) processNotifySubsLocked() {
+	if len(m.mu.notifySubs) == 0 {
+		return
+	}
+	remaining := m.mu.notifySubs[:0]
+	for _, sub := range m.mu.notifySubs {
+		var deliverErr error
+		delivered := false
+		if m.mu.firstErr != nil {
+			deliverErr = m.mu.firstErr
+			delivered = true
+		} else if m.mu.closedErr != nil {
+			deliverErr = m.mu.closedErr
+			delivered = true
+		} else if m.isDurableLocked(sub.seqNum) {
+			deliverErr = nil
+			delivered = true
+		}
+
+		if delivered {
+			sub.ch <- deliverErr
+		} else {
+			remaining = append(remaining, sub)
+		}
+	}
+	m.mu.notifySubs = remaining
+}
+
+func (m *durabilityManager) DurableState() (base.SeqNum, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	err := m.mu.firstErr
+	if err == nil {
+		err = m.mu.closedErr
+	}
+	return m.mu.highestDurableSeqNum, err
+}
+
+func (m *durabilityManager) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if m.disableWAL {
+		ch <- nil
+		return ch
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.mu.firstErr != nil {
+		ch <- m.mu.firstErr
+		return ch
+	}
+	if m.mu.closedErr != nil {
+		ch <- m.mu.closedErr
+		return ch
+	}
+	if m.isDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+
+	if len(m.mu.notifySubs) >= maxDurabilitySubscriptions {
+		ch <- errors.New("pebble: excess durability subscriptions")
+		return ch
+	}
+
+	m.mu.notifySubs = append(m.mu.notifySubs, durabilityNotifySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (m *durabilityManager) DurabilityStats() DurabilityStats {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	err := m.mu.firstErr
+	if err == nil {
+		err = m.mu.closedErr
+	}
+
+	return DurabilityStats{
+		HighestDurableSeqNum:   m.mu.highestDurableSeqNum,
+		FirstErr:               err,
+		PendingWaiters:         m.pendingWaiters.Load(),
+		TotalDurableCommits:    m.mu.totalDurableCommits,
+		TotalFailedCommits:     m.mu.totalFailedCommits,
+		CumulativeSyncDuration: m.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        m.mu.maxSyncDuration,
+	}
+}
+
+func (m *durabilityManager) WaitForDurability(ctx context.Context, seqNum base.SeqNum) error {
+	if m.disableWAL {
+		return nil
+	}
+
+	m.pendingWaiters.Add(1)
+	defer m.pendingWaiters.Add(-1)
+
+	m.mu.Lock()
+	if m.isDurableLocked(seqNum) {
+		err := m.mu.firstErr
+		if err == nil {
+			err = m.mu.closedErr
+		}
+		m.mu.Unlock()
+		return err
+	}
+	if m.mu.firstErr != nil {
+		err := m.mu.firstErr
+		m.mu.Unlock()
+		return err
+	}
+	if m.mu.closedErr != nil {
+		err := m.mu.closedErr
+		m.mu.Unlock()
+		return err
+	}
+
+	done := make(chan error, 1)
+	m.mu.notifySubs = append(m.mu.notifySubs, durabilityNotifySub{
+		seqNum: seqNum,
+		ch:     done,
+	})
+	m.mu.Unlock()
+
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	select {
+	case err := <-done:
+		return err
+	case <-ctx.Done():
+		m.mu.Lock()
+		defer m.mu.Unlock()
+
+		for i, s := range m.mu.notifySubs {
+			if s.ch == done {
+				m.mu.notifySubs = append(m.mu.notifySubs[:i], m.mu.notifySubs[i+1:]...)
+				break
+			}
+		}
+
+		if m.mu.firstErr != nil {
+			return m.mu.firstErr
+		}
+		if m.mu.closedErr != nil {
+			return m.mu.closedErr
+		}
+		if m.isDurableLocked(seqNum) {
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+func (m *durabilityManager) WaitForDurabilityBatch(
+	ctx context.Context, seqNums []base.SeqNum,
+) error {
+	if m.disableWAL || len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	hasZero := false
+	for _, seq := range seqNums {
+		if seq == 0 {
+			hasZero = true
+		}
+		if seq > maxSeq {
+			maxSeq = seq
+		}
+	}
+	if maxSeq == 0 {
+		return m.WaitForDurability(ctx, 0)
+	}
+	if hasZero {
+		if err := m.WaitForDurability(ctx, 0); err != nil {
+			return err
+		}
+	}
+	return m.WaitForDurability(ctx, maxSeq)
+}
+
+func (m *durabilityManager) WaitForJobDurability(ctx context.Context, jobID int) error {
+	if m.disableWAL {
+		return nil
+	}
+	if jobID <= 0 {
+		return errors.Errorf("pebble: unknown job ID %d", jobID)
+	}
+
+	m.pendingWaiters.Add(1)
+	defer m.pendingWaiters.Add(-1)
+
+	m.mu.Lock()
+
+	if m.mu.closedErr != nil {
+		err := m.mu.closedErr
+		m.mu.Unlock()
+		return err
+	}
+	if jobID > m.mu.maxSeenJobID {
+		m.mu.Unlock()
+		return errors.Errorf("pebble: unknown job ID %d", jobID)
+	}
+	if jobID < m.mu.minRetainedJobID {
+		m.mu.Unlock()
+		return errors.Errorf("pebble: job ID %d expired", jobID)
+	}
+	entry, ok := m.mu.jobs[jobID]
+	if !ok {
+		m.mu.Unlock()
+		return errors.Errorf("pebble: job ID %d expired", jobID)
+	}
+	if entry.done {
+		err := entry.err
+		if err == nil {
+			err = m.mu.firstErr
+		}
+		if err == nil {
+			err = m.mu.closedErr
+		}
+		m.mu.Unlock()
+		return err
+	}
+
+	jobDone := make(chan error, 1)
+	entry.waiters = append(entry.waiters, jobDone)
+	m.mu.Unlock()
+
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	select {
+	case err := <-jobDone:
+		if err != nil {
+			return err
+		}
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		if m.mu.firstErr != nil {
+			return m.mu.firstErr
+		}
+		if m.mu.closedErr != nil {
+			return m.mu.closedErr
+		}
+		return nil
+	case <-ctx.Done():
+		m.mu.Lock()
+		defer m.mu.Unlock()
+
+		for i, ch := range entry.waiters {
+			if ch == jobDone {
+				entry.waiters = append(entry.waiters[:i], entry.waiters[i+1:]...)
+				break
+			}
+		}
+
+		if m.mu.closedErr != nil {
+			return m.mu.closedErr
+		}
+		if entry.done {
+			err := entry.err
+			if err == nil {
+				err = m.mu.firstErr
+			}
+			if err == nil {
+				err = m.mu.closedErr
+			}
+			return err
+		}
+		if m.mu.firstErr != nil {
+			return m.mu.firstErr
+		}
+		return ctx.Err()
+	}
+}
