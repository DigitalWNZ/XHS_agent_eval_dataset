+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/pebble/vfs"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBatchDurableCallback(t *testing.T) {
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				durableEvents = append(durableEvents, info)
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 9999,
+	}
+
+	err = d.Set([]byte("k1"), []byte("v1"), wo)
+	require.NoError(t, err)
+
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	ev := durableEvents[0]
+	mu.Unlock()
+
+	require.Equal(t, uint64(9999), ev.CorrelationID)
+	require.Equal(t, uint32(1), ev.KeyCount)
+	require.Greater(t, ev.BatchSize, 0)
+	require.Greater(t, ev.JobID, 0)
+	require.Greater(t, ev.SeqNum, base.SeqNum(0))
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.NoError(t, ev.Err)
+}
+
+func TestBatchDurableNonSyncAndDisableWAL(t *testing.T) {
+	var durableCount atomic.Int32
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableCount.Add(1)
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+
+	// Non-sync commit should not trigger BatchDurable
+	err = d.Set([]byte("k1"), []byte("v1"), NoSync)
+	require.NoError(t, err)
+	require.Equal(t, int32(0), durableCount.Load())
+
+	require.NoError(t, d.Close())
+
+	// DisableWAL should not trigger BatchDurable
+	optsWAL := &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableCount.Add(1)
+			},
+		},
+	}
+
+	d2, err := Open("", optsWAL)
+	require.NoError(t, err)
+
+	_ = d2.Set([]byte("k1"), []byte("v1"), Sync)
+	require.Equal(t, int32(0), durableCount.Load())
+
+	require.NoError(t, d2.Close())
+}
+
+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	opts := &Options{
+		FS: vfs.NewMem(),
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Before any commit, WaitForDurability(0) should block until a commit happens.
+	var zeroUnblocked atomic.Bool
+	go func() {
+		err := d.WaitForDurability(0)
+		if err == nil {
+			zeroUnblocked.Store(true)
+		}
+	}()
+
+	time.Sleep(10 * time.Millisecond)
+	require.False(t, zeroUnblocked.Load())
+
+	// Perform a sync commit
+	err = d.Set([]byte("k1"), []byte("v1"), Sync)
+	require.NoError(t, err)
+
+	require.Eventually(t, func() bool {
+		return zeroUnblocked.Load()
+	}, 1*time.Second, 5*time.Millisecond)
+
+	// Now WaitForDurability(0) should succeed immediately
+	require.NoError(t, d.WaitForDurability(0))
+
+	highestSeq, err := d.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, highestSeq, base.SeqNum(0))
+
+	// WaitForDurability for current highestSeq should succeed immediately
+	require.NoError(t, d.WaitForDurability(highestSeq))
+
+	// WaitForDurabilityBatch with empty / nil slice returns nil immediately
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+
+	// WaitForDurabilityBatch with slice containing durable seqnums succeeds immediately
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{0, highestSeq}))
+
+	// WaitForDurability with future seqnum should block until commit
+	futureSeq := highestSeq + 100
+	var futureUnblocked atomic.Bool
+	go func() {
+		err := d.WaitForDurability(futureSeq)
+		if err == nil {
+			futureUnblocked.Store(true)
+		}
+	}()
+
+	time.Sleep(10 * time.Millisecond)
+	require.False(t, futureUnblocked.Load())
+
+	// Commit more data
+	for i := 0; i < 200; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	require.Eventually(t, func() bool {
+		return futureUnblocked.Load()
+	}, 1*time.Second, 5*time.Millisecond)
+}
