+func TestDurabilityNotify(t *testing.T) {
+	opts := &Options{
+		FS: vfs.NewMem(),
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Pre-commit notify on 0 should deliver nil after first commit
+	ch0 := d.DurabilityNotify(0)
+
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+
+	err0 := <-ch0
+	require.NoError(t, err0)
+
+	highestSeq, _ := d.DurableState()
+	// Post-commit notify on already durable seqnum delivers nil immediately
+	chAlready := d.DurabilityNotify(highestSeq)
+	errAlready := <-chAlready
+	require.NoError(t, errAlready)
+}
