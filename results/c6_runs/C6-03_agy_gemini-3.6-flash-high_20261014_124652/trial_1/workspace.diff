+func TestDurabilityStatsAndMetrics(t *testing.T) {
+	// Case 1: BatchDurable IS configured
+	optsWithBD := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {},
+		},
+	}
+
+	d1, err := Open("", optsWithBD)
+	require.NoError(t, err)
+
+	stats0 := d1.DurabilityStats()
+	require.Equal(t, uint64(0), stats0.TotalDurableCommits)
+	require.Equal(t, base.SeqNum(0), stats0.HighestDurableSeqNum)
+
+	require.NoError(t, d1.Set([]byte("k1"), []byte("v1"), Sync))
+
+	stats1 := d1.DurabilityStats()
+	require.Equal(t, uint64(1), stats1.TotalDurableCommits)
+	require.Greater(t, stats1.HighestDurableSeqNum, base.SeqNum(0))
+	require.Greater(t, stats1.CumulativeSyncDuration, time.Duration(0))
+
+	m1 := d1.Metrics()
+	require.Equal(t, uint64(1), m1.DurableCommitCount)
+	require.Greater(t, m1.DurableCommitDuration, time.Duration(0))
+
+	require.NoError(t, d1.Close())
+
+	// Case 2: BatchDurable IS NOT configured
+	optsNoBD := &Options{
+		FS: vfs.NewMem(),
+	}
+
+	d2, err := Open("", optsNoBD)
+	require.NoError(t, err)
+
+	require.NoError(t, d2.Set([]byte("k1"), []byte("v1"), Sync))
+
+	stats2 := d2.DurabilityStats()
+	require.Equal(t, uint64(1), stats2.TotalDurableCommits) // DurabilityStats tracked regardless
+
+	m2 := d2.Metrics()
+	require.Equal(t, uint64(0), m2.DurableCommitCount)      // Metrics NOT accumulated without BatchDurable
+	require.Equal(t, time.Duration(0), m2.DurableCommitDuration)
+
+	require.NoError(t, d2.Close())
+}
