--- /dev/null
+++ b/durability.go
@@ -0,0 +1,443 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats holds a snapshot of durability statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type jobDurabilityStatus struct {
+	done bool
+	err  error
+}
+
+type notifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityState struct {
+	mu                   sync.Mutex
+	wakeCh               chan struct{}
+	closed               bool
+	closedErr            error
+	highestDurableSeqNum base.SeqNum
+	firstErr             error
+	totalDurableCommits  uint64
+	totalFailedCommits   uint64
+	cumulativeSyncDur    time.Duration
+	maxSyncDuration      time.Duration
+	pendingWaiters       atomic.Int64
+	highestSeenJobID     int
+	lowestRetainedJobID  int
+	jobStatus            map[int]jobDurabilityStatus
+	notifySubs           map[uint64]*notifySub
+	nextSubID            uint64
+	maxNotifySubs        int
+}
+
+func (ds *durabilityState) init() {
+	ds.mu.Lock()
+	defer ds.mu.Unlock()
+	ds.wakeCh = make(chan struct{})
+	ds.jobStatus = make(map[int]jobDurabilityStatus)
+	ds.notifySubs = make(map[uint64]*notifySub)
+	ds.maxNotifySubs = 4096
+}
+
+func (ds *durabilityState) close(err error) {
+	ds.mu.Lock()
+	defer ds.mu.Unlock()
+	ds.closed = true
+	if err == nil {
+		err = ErrClosed
+	}
+	ds.closedErr = err
+
+	for id, sub := range ds.notifySubs {
+		sub.ch <- err
+		delete(ds.notifySubs, id)
+	}
+
+	if ds.wakeCh != nil {
+		close(ds.wakeCh)
+		ds.wakeCh = nil
+	}
+}
+
+func (ds *durabilityState) registerJobID(jobID int) {
+	if jobID <= 0 {
+		return
+	}
+	ds.mu.Lock()
+	defer ds.mu.Unlock()
+	if ds.lowestRetainedJobID == 0 {
+		ds.lowestRetainedJobID = jobID
+	}
+	if jobID > ds.highestSeenJobID {
+		ds.highestSeenJobID = jobID
+	}
+	ds.jobStatus[jobID] = jobDurabilityStatus{
+		done: false,
+		err:  nil,
+	}
+}
+
+// WaitForDurability blocks until seqNum is durable.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until seqNum is durable or ctx is canceled.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	waited := false
+	defer func() {
+		if waited {
+			d.durability.pendingWaiters.Add(-1)
+		}
+	}()
+
+	for {
+		d.durability.mu.Lock()
+		if d.durability.closed {
+			err := d.durability.closedErr
+			d.durability.mu.Unlock()
+			return err
+		}
+		if d.durability.firstErr != nil {
+			err := d.durability.firstErr
+			d.durability.mu.Unlock()
+			return err
+		}
+		if seqNum == 0 {
+			if d.durability.totalDurableCommits+d.durability.totalFailedCommits > 0 {
+				d.durability.mu.Unlock()
+				return nil
+			}
+		} else if seqNum <= d.durability.highestDurableSeqNum {
+			d.durability.mu.Unlock()
+			return nil
+		}
+		ch := d.durability.wakeCh
+		d.durability.mu.Unlock()
+
+		if !waited {
+			d.durability.pendingWaiters.Add(1)
+			waited = true
+		}
+
+		select {
+		case <-ch:
+		case <-ctx.Done():
+			d.durability.mu.Lock()
+			if d.durability.closed {
+				err := d.durability.closedErr
+				d.durability.mu.Unlock()
+				return err
+			}
+			if d.durability.firstErr != nil {
+				err := d.durability.firstErr
+				d.durability.mu.Unlock()
+				return err
+			}
+			if seqNum == 0 {
+				if d.durability.totalDurableCommits+d.durability.totalFailedCommits > 0 {
+					d.durability.mu.Unlock()
+					return nil
+				}
+			} else if seqNum <= d.durability.highestDurableSeqNum {
+				d.durability.mu.Unlock()
+				return nil
+			}
+			d.durability.mu.Unlock()
+			return ctx.Err()
+		}
+	}
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is durable.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums is durable or ctx is canceled.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the batch associated with jobID is durable.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the batch associated with jobID is durable or ctx is canceled.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	waited := false
+	defer func() {
+		if waited {
+			d.durability.pendingWaiters.Add(-1)
+		}
+	}()
+
+	for {
+		d.durability.mu.Lock()
+		if d.durability.closed {
+			err := d.durability.closedErr
+			d.durability.mu.Unlock()
+			return err
+		}
+		if d.durability.firstErr != nil {
+			err := d.durability.firstErr
+			d.durability.mu.Unlock()
+			return err
+		}
+		if jobID <= 0 || jobID > d.durability.highestSeenJobID {
+			d.durability.mu.Unlock()
+			return errors.Errorf("unknown job ID: %d", jobID)
+		}
+		if jobID < d.durability.lowestRetainedJobID {
+			d.durability.mu.Unlock()
+			return errors.Errorf("expired job ID: %d", jobID)
+		}
+		status, exists := d.durability.jobStatus[jobID]
+		if !exists {
+			d.durability.mu.Unlock()
+			return errors.Errorf("expired job ID: %d", jobID)
+		}
+		if status.done {
+			err := status.err
+			d.durability.mu.Unlock()
+			return err
+		}
+		ch := d.durability.wakeCh
+		d.durability.mu.Unlock()
+
+		if !waited {
+			d.durability.pendingWaiters.Add(1)
+			waited = true
+		}
+
+		select {
+		case <-ch:
+		case <-ctx.Done():
+			d.durability.mu.Lock()
+			if d.durability.closed {
+				err := d.durability.closedErr
+				d.durability.mu.Unlock()
+				return err
+			}
+			if d.durability.firstErr != nil {
+				err := d.durability.firstErr
+				d.durability.mu.Unlock()
+				return err
+			}
+			if jobID <= 0 || jobID > d.durability.highestSeenJobID {
+				d.durability.mu.Unlock()
+				return errors.Errorf("unknown job ID: %d", jobID)
+			}
+			if jobID < d.durability.lowestRetainedJobID {
+				d.durability.mu.Unlock()
+				return errors.Errorf("expired job ID: %d", jobID)
+			}
+			if status, ok := d.durability.jobStatus[jobID]; ok && status.done {
+				err := status.err
+				d.durability.mu.Unlock()
+				return err
+			}
+			d.durability.mu.Unlock()
+			return ctx.Err()
+		}
+	}
+}
+
+// DurableState returns the highest durable sequence number and the first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return d.durability.highestDurableSeqNum, d.durability.firstErr
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil on success
+// or a non-nil error on WAL sync failure or DB close.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	if d.durability.closed {
+		ch <- d.durability.closedErr
+		return ch
+	}
+	if d.durability.firstErr != nil {
+		ch <- d.durability.firstErr
+		return ch
+	}
+	if seqNum == 0 {
+		if d.durability.totalDurableCommits+d.durability.totalFailedCommits > 0 {
+			ch <- nil
+			return ch
+		}
+	} else if seqNum <= d.durability.highestDurableSeqNum {
+		ch <- nil
+		return ch
+	}
+
+	if len(d.durability.notifySubs) >= d.durability.maxNotifySubs {
+		ch <- errors.New("pebble: excess durability notify subscriptions")
+		return ch
+	}
+
+	subID := d.durability.nextSubID
+	d.durability.nextSubID++
+	d.durability.notifySubs[subID] = &notifySub{
+		seqNum: seqNum,
+		ch:     ch,
+	}
+	return ch
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.durability.highestDurableSeqNum,
+		FirstErr:               d.durability.firstErr,
+		PendingWaiters:         d.durability.pendingWaiters.Load(),
+		TotalDurableCommits:    d.durability.totalDurableCommits,
+		TotalFailedCommits:     d.durability.totalFailedCommits,
+		CumulativeSyncDuration: d.durability.cumulativeSyncDur,
+		MaxSyncDuration:        d.durability.maxSyncDuration,
+	}
+}
+
+func (d *DB) onBatchDurable(b *Batch) {
+	if !b.syncWAL {
+		return
+	}
+	if !b.durableHandled.CompareAndSwap(false, true) {
+		return
+	}
+
+	applyDuration := b.commitApplyDuration
+	if applyDuration <= 0 && b.commitErr == nil {
+		applyDuration = 1 * time.Nanosecond
+	}
+	syncDuration := b.commitSyncDuration
+	if syncDuration <= 0 && b.commitErr == nil {
+		syncDuration = 1 * time.Nanosecond
+	}
+
+	batchHighestSeqNum := b.SeqNum()
+	if count := b.Count(); count > 0 {
+		batchHighestSeqNum += base.SeqNum(count - 1)
+	}
+
+	info := BatchDurableInfo{
+		JobID:         b.commitJobID,
+		SeqNum:        b.SeqNum(),
+		Err:           b.commitErr,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: b.commitCorrelationID,
+		BatchSize:     len(b.data),
+		KeyCount:      uint32(b.Count()),
+	}
+
+	if d.opts.EventListener.BatchDurable != nil {
+		d.opts.EventListener.BatchDurable(info)
+	}
+
+	if d.batchDurableConfigured {
+		d.durableCommitCount.Add(1)
+		d.durableCommitDuration.Add(int64(syncDuration))
+	}
+
+	d.durability.mu.Lock()
+	if b.commitErr == nil {
+		d.durability.totalDurableCommits++
+		d.durability.cumulativeSyncDur += syncDuration
+		if syncDuration > d.durability.maxSyncDuration {
+			d.durability.maxSyncDuration = syncDuration
+		}
+		if batchHighestSeqNum > d.durability.highestDurableSeqNum {
+			d.durability.highestDurableSeqNum = batchHighestSeqNum
+		}
+	} else {
+		d.durability.totalFailedCommits++
+		if d.durability.firstErr == nil {
+			d.durability.firstErr = b.commitErr
+		}
+	}
+
+	if b.commitJobID > 0 {
+		d.durability.jobStatus[b.commitJobID] = jobDurabilityStatus{
+			done: true,
+			err:  b.commitErr,
+		}
+		const maxRetainedJobs = 10000
+		for len(d.durability.jobStatus) > maxRetainedJobs {
+			delete(d.durability.jobStatus, d.durability.lowestRetainedJobID)
+			d.durability.lowestRetainedJobID++
+		}
+	}
+
+	for id, sub := range d.durability.notifySubs {
+		if d.durability.firstErr != nil {
+			sub.ch <- d.durability.firstErr
+			delete(d.durability.notifySubs, id)
+		} else if (sub.seqNum == 0 && d.durability.totalDurableCommits+d.durability.totalFailedCommits > 0) ||
+			(sub.seqNum > 0 && sub.seqNum <= d.durability.highestDurableSeqNum) {
+			sub.ch <- nil
+			delete(d.durability.notifySubs, id)
+		}
+	}
+
+	if d.durability.wakeCh != nil {
+		close(d.durability.wakeCh)
+		d.durability.wakeCh = make(chan struct{})
+	}
+
+	d.durability.mu.Unlock()
+}
