+func TestWaitForJobDurability(t *testing.T) {
+	var jobID int
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				jobID = info.JobID
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Never seen job ID and 0 job ID return unknown error
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(99999)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Perform a commit
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+
+	mu.Lock()
+	capturedJobID := jobID
+	mu.Unlock()
+
+	require.Greater(t, capturedJobID, 0)
+
+	// Waiting for capturedJobID should succeed immediately
+	require.NoError(t, d.WaitForJobDurability(capturedJobID))
+	require.NoError(t, d.WaitForJobDurabilityContext(context.Background(), capturedJobID))
+}
