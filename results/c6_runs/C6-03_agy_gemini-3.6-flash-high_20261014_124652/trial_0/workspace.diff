+func TestDurabilityNotifySubscriptionLimit(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("test_db_sub_limit", &Options{FS: memFS})
+	require.NoError(t, err)
+	defer d.Close()
+
+	d.durability.mu.Lock()
+	d.durability.maxSubscriptions = 2
+	d.durability.mu.Unlock()
+
+	ch1 := d.DurabilityNotify(100)
+	ch2 := d.DurabilityNotify(100)
+	ch3 := d.DurabilityNotify(100) // excess caller
+
+	select {
+	case err3 := <-ch3:
+		require.Error(t, err3)
+		require.True(t, strings.Contains(err3.Error(), "excess"), "expected 'excess' in: %v", err3)
+	default:
+		t.Fatal("expected excess subscription channel to be pre-filled with error")
+	}
+
+	_ = ch1
+	_ = ch2
+}
