+func TestWaitForJobDurabilityUnknownAndExpired(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("test_db_job_errs", &Options{FS: memFS})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Zero and never-seen IDs get "unknown"
+	errZero := d.WaitForJobDurability(0)
+	require.Error(t, errZero)
+	require.True(t, strings.Contains(errZero.Error(), "unknown"), "expected 'unknown' in: %v", errZero)
+
+	errUnseen := d.WaitForJobDurability(999999)
+	require.Error(t, errUnseen)
+	require.True(t, strings.Contains(errUnseen.Error(), "unknown"), "expected 'unknown' in: %v", errUnseen)
+
+	// Simulate expired job by setting minRetainedJobID higher than an assigned job
+	d.durability.mu.Lock()
+	d.durability.maxAssignedJobID = 100
+	d.durability.minRetainedJobID = 50
+	d.durability.mu.Unlock()
+
+	errExpired := d.WaitForJobDurability(20)
+	require.Error(t, errExpired)
+	require.True(t, strings.Contains(errExpired.Error(), "expired"), "expected 'expired' in: %v", errExpired)
+}
