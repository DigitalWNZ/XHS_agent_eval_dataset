+func TestMetricsOnlyAccumulateWhenBatchDurableConfigured(t *testing.T) {
+	memFS := vfs.NewMem()
+
+	// Open DB WITHOUT BatchDurable configured
+	d1, err := Open("test_db_no_bd", &Options{FS: memFS})
+	require.NoError(t, err)
+
+	err = d1.Set([]byte("k"), []byte("v"), Sync)
+	require.NoError(t, err)
+
+	m1 := d1.Metrics()
+	require.Equal(t, uint64(0), m1.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m1.DurableCommitDuration)
+	d1.Close()
+
+	// Open DB WITH BatchDurable configured
+	opts2 := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {},
+		},
+	}
+	d2, err := Open("test_db_with_bd", opts2)
+	require.NoError(t, err)
+
+	err = d2.Set([]byte("k"), []byte("v"), Sync)
+	require.NoError(t, err)
+
+	m2 := d2.Metrics()
+	require.Equal(t, uint64(1), m2.DurableCommitCount)
+	require.Greater(t, m2.DurableCommitDuration, time.Duration(0))
+	d2.Close()
+}
