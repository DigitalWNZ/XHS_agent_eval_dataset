+
+func TestBatchDurableCallbackAndWaitAPIs(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				durableEvents = append(durableEvents, info)
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("test_db", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Initial stats should be zero
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(0), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+
+	metrics := d.Metrics()
+	require.Equal(t, uint64(0), metrics.DurableCommitCount)
+	require.Equal(t, time.Duration(0), metrics.DurableCommitDuration)
+
+	// Perform a Sync write with CommitCorrelationID
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 12345,
+	}
+	err = d.Set([]byte("key1"), []byte("val1"), wo)
+	require.NoError(t, err)
+
+	// Check BatchDurable event fired
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	ev := durableEvents[0]
+	mu.Unlock()
+
+	require.Greater(t, ev.JobID, 0)
+	require.Greater(t, ev.SeqNum, uint64(0))
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(12345), ev.CorrelationID)
+	require.Greater(t, ev.BatchSize, 0)
+	require.Equal(t, uint32(1), ev.KeyCount)
+
+	// Verify DurabilityStats
+	stats = d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.GreaterOrEqual(t, stats.HighestDurableSeqNum, ev.SeqNum)
+
+	// Verify Metrics
+	metrics = d.Metrics()
+	require.Equal(t, uint64(1), metrics.DurableCommitCount)
+	require.Greater(t, metrics.DurableCommitDuration, time.Duration(0))
+
+	// Verify WaitForDurability
+	require.NoError(t, d.WaitForDurability(ev.SeqNum))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), ev.SeqNum))
+
+	// Verify WaitForDurability zero succeeds after commit
+	require.NoError(t, d.WaitForDurability(0))
+
+	// Verify WaitForDurabilityBatch
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{ev.SeqNum}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{ev.SeqNum}))
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+
+	// Verify WaitForJobDurability
+	require.NoError(t, d.WaitForJobDurability(ev.JobID))
+	require.NoError(t, d.WaitForJobDurabilityContext(context.Background(), ev.JobID))
+
+	// Verify DurableState
+	highestSeq, errState := d.DurableState()
+	require.NoError(t, errState)
+	require.GreaterOrEqual(t, highestSeq, ev.SeqNum)
+
+	// Verify DurabilityNotify
+	ch := d.DurabilityNotify(ev.SeqNum)
+	require.NoError(t, <-ch)
+}
