+func TestNonSyncCommitsDoNotTriggerBatchDurable(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				durableEvents = append(durableEvents, info)
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("test_db_nosync", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Perform a NoSync write
+	err = d.Set([]byte("key1"), []byte("val1"), NoSync)
+	require.NoError(t, err)
+
+	// Non-sync commit must NOT trigger BatchDurable
+	mu.Lock()
+	require.Len(t, durableEvents, 0)
+	mu.Unlock()
+}
+
+func TestDisableWALBehavior(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS:         memFS,
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				durableEvents = append(durableEvents, info)
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("test_db_disable_wal", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Write without WAL
+	err = d.Set([]byte("key1"), []byte("val1"), NoSync)
+	require.NoError(t, err)
+
+	// Must never trigger BatchDurable
+	mu.Lock()
+	require.Len(t, durableEvents, 0)
+	mu.Unlock()
+
+	// Wait APIs and DurabilityNotify return nil immediately when DisableWAL is true
+	require.NoError(t, d.WaitForDurability(100))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), 100))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{100, 200}))
+	require.NoError(t, d.WaitForJobDurability(123))
+
+	ch := d.DurabilityNotify(100)
+	require.NoError(t, <-ch)
+}
