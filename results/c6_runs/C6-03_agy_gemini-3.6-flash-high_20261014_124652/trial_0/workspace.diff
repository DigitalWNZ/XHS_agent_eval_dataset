+func TestUnblockWaitersOnDBClose(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("test_db_close_wait", &Options{FS: memFS})
+	require.NoError(t, err)
+
+	var wg sync.WaitGroup
+	var errWait error
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		// Wait for a high seqnum that will not be reached
+		errWait = d.WaitForDurability(999999)
+	}()
+
+	// Give goroutine time to enter wait
+	time.Sleep(20 * time.Millisecond)
+
+	require.NoError(t, d.Close())
+	wg.Wait()
+
+	require.Error(t, errWait)
+	require.True(t, errors.Is(errWait, ErrClosed))
+}
