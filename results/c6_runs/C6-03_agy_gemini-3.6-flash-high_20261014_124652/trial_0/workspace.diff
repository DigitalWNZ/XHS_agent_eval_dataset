new file mode 100644
index 00000000..20effcfd
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,475 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats contains statistics and state related to durability.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilitySubscription struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityManager struct {
+	mu                     sync.Mutex
+	stateChanged           chan struct{}
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	closed                 bool
+	closeErr               error
+	pendingWaiters         atomic.Int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	batchDurableConfigured    bool
+	metricsDurableCommitCount uint64
+	metricsDurableCommitDuration time.Duration
+
+	// Job ID tracking
+	maxAssignedJobID int
+	minRetainedJobID int
+	jobResults       map[int]error
+	activeJobs       map[int]chan error
+
+	// Subscriptions for DurabilityNotify
+	subscriptions    []durabilitySubscription
+	maxSubscriptions int
+}
+
+const (
+	jobRetentionCapacity       = 10000
+	maxDurabilitySubscriptions = 1000
+)
+
+func newDurabilityManager(batchDurableConfigured bool) *durabilityManager {
+	m := &durabilityManager{
+		batchDurableConfigured: batchDurableConfigured,
+		stateChanged:           make(chan struct{}),
+		jobResults:             make(map[int]error),
+		activeJobs:             make(map[int]chan error),
+		maxSubscriptions:       maxDurabilitySubscriptions,
+		minRetainedJobID:       1,
+	}
+	return m
+}
+
+func (m *durabilityManager) registerJob(jobID int) {
+	if jobID <= 0 {
+		return
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if jobID > m.maxAssignedJobID {
+		m.maxAssignedJobID = jobID
+	}
+	ch := make(chan error, 1)
+	m.activeJobs[jobID] = ch
+}
+
+func (m *durabilityManager) onBatchDurable(d *DB, b *Batch) {
+	if b == nil {
+		return
+	}
+
+	info := BatchDurableInfo{
+		JobID:         b.jobID,
+		SeqNum:        b.SeqNum(),
+		Err:           b.commitErr,
+		ApplyDuration: b.applyDuration,
+		SyncDuration:  b.syncDuration,
+		CorrelationID: b.commitCorrelationID,
+		BatchSize:     len(b.Repr()),
+		KeyCount:      uint32(b.Count()),
+	}
+
+	if info.Err == nil {
+		if info.ApplyDuration <= 0 {
+			info.ApplyDuration = time.Nanosecond
+		}
+		if info.SyncDuration <= 0 {
+			info.SyncDuration = time.Nanosecond
+		}
+	}
+
+	var durableSeq base.SeqNum
+	if info.KeyCount > 0 {
+		durableSeq = info.SeqNum + base.SeqNum(info.KeyCount) - 1
+	} else {
+		durableSeq = info.SeqNum
+	}
+
+	m.mu.Lock()
+
+	if info.Err == nil {
+		if durableSeq > m.highestDurableSeqNum {
+			m.highestDurableSeqNum = durableSeq
+		}
+		m.totalDurableCommits++
+		if m.batchDurableConfigured {
+			m.metricsDurableCommitCount++
+			m.metricsDurableCommitDuration += info.SyncDuration
+		}
+	} else {
+		m.totalFailedCommits++
+		if m.firstErr == nil {
+			m.firstErr = info.Err
+		}
+	}
+
+	m.cumulativeSyncDuration += info.SyncDuration
+	if info.SyncDuration > m.maxSyncDuration {
+		m.maxSyncDuration = info.SyncDuration
+	}
+
+	// Update job tracking
+	if info.JobID > 0 {
+		m.jobResults[info.JobID] = info.Err
+		if ch, ok := m.activeJobs[info.JobID]; ok {
+			ch <- info.Err
+			delete(m.activeJobs, info.JobID)
+		}
+		for len(m.jobResults) > jobRetentionCapacity {
+			delete(m.jobResults, m.minRetainedJobID)
+			m.minRetainedJobID++
+		}
+	}
+
+	// Notify subscriptions
+	var remainingSubs []durabilitySubscription
+	for _, sub := range m.subscriptions {
+		notified := false
+		if m.firstErr != nil || info.Err != nil {
+			errToSend := info.Err
+			if errToSend == nil {
+				errToSend = m.firstErr
+			}
+			sub.ch <- errToSend
+			notified = true
+		} else if sub.seqNum == 0 && (m.totalDurableCommits+m.totalFailedCommits > 0) {
+			sub.ch <- nil
+			notified = true
+		} else if sub.seqNum > 0 && m.highestDurableSeqNum >= sub.seqNum {
+			sub.ch <- nil
+			notified = true
+		}
+		if !notified {
+			remainingSubs = append(remainingSubs, sub)
+		}
+	}
+	m.subscriptions = remainingSubs
+
+	// Wake up waiters
+	oldChanged := m.stateChanged
+	m.stateChanged = make(chan struct{})
+	close(oldChanged)
+
+	m.mu.Unlock()
+
+	// Invoke EventListener.BatchDurable outside lock
+	if d != nil && d.opts != nil && d.opts.EventListener.BatchDurable != nil {
+		d.opts.EventListener.BatchDurable(info)
+	}
+}
+
+func (m *durabilityManager) close(closeErr error) {
+	if closeErr == nil {
+		closeErr = ErrClosed
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.closed {
+		return
+	}
+	m.closed = true
+	m.closeErr = closeErr
+	if m.firstErr == nil {
+		m.firstErr = closeErr
+	}
+
+	for _, sub := range m.subscriptions {
+		sub.ch <- closeErr
+	}
+	m.subscriptions = nil
+
+	for jobID, ch := range m.activeJobs {
+		ch <- closeErr
+		m.jobResults[jobID] = closeErr
+	}
+	m.activeJobs = make(map[int]chan error)
+
+	oldChanged := m.stateChanged
+	m.stateChanged = make(chan struct{})
+	close(oldChanged)
+}
+
+// WaitForDurability blocks until sequence number is durable.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until sequence number is durable or context is done.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	var ctxDone <-chan struct{}
+	if ctx != nil {
+		ctxDone = ctx.Done()
+	}
+
+	d.durability.mu.Lock()
+	for {
+		// Durability/close errors take precedence over context cancellation
+		if d.durability.firstErr != nil {
+			d.durability.mu.Unlock()
+			return d.durability.firstErr
+		}
+		if d.durability.closed {
+			d.durability.mu.Unlock()
+			if d.durability.closeErr != nil {
+				return d.durability.closeErr
+			}
+			return ErrClosed
+		}
+
+		if seqNum == 0 {
+			if d.durability.totalDurableCommits+d.durability.totalFailedCommits > 0 {
+				d.durability.mu.Unlock()
+				return nil
+			}
+		} else if d.durability.highestDurableSeqNum >= seqNum {
+			d.durability.mu.Unlock()
+			return nil
+		}
+
+		ch := d.durability.stateChanged
+		d.durability.mu.Unlock()
+
+		if ctxDone != nil {
+			d.durability.pendingWaiters.Add(1)
+			select {
+			case <-ch:
+				d.durability.pendingWaiters.Add(-1)
+				d.durability.mu.Lock()
+				continue
+			case <-ctxDone:
+				d.durability.pendingWaiters.Add(-1)
+				d.durability.mu.Lock()
+				if d.durability.firstErr != nil {
+					err := d.durability.firstErr
+					d.durability.mu.Unlock()
+					return err
+				}
+				if d.durability.closed {
+					err := d.durability.closeErr
+					d.durability.mu.Unlock()
+					if err != nil {
+						return err
+					}
+					return ErrClosed
+				}
+				d.durability.mu.Unlock()
+				return ctx.Err()
+			}
+		} else {
+			d.durability.pendingWaiters.Add(1)
+			<-ch
+			d.durability.pendingWaiters.Add(-1)
+			d.durability.mu.Lock()
+		}
+	}
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in a slice is durable.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in a slice is durable.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability waits by callback job ID.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext waits by callback job ID or until context is done.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	var ctxDone <-chan struct{}
+	if ctx != nil {
+		ctxDone = ctx.Done()
+	}
+
+	d.durability.mu.Lock()
+	for {
+		// Durability/close errors take precedence over context cancellation
+		if d.durability.firstErr != nil {
+			d.durability.mu.Unlock()
+			return d.durability.firstErr
+		}
+		if d.durability.closed {
+			d.durability.mu.Unlock()
+			if d.durability.closeErr != nil {
+				return d.durability.closeErr
+			}
+			return ErrClosed
+		}
+
+		if jobID <= 0 || jobID > d.durability.maxAssignedJobID {
+			d.durability.mu.Unlock()
+			return errors.Errorf("unknown job ID %d", jobID)
+		}
+		if jobID < d.durability.minRetainedJobID {
+			d.durability.mu.Unlock()
+			return errors.Errorf("job ID %d expired", jobID)
+		}
+
+		if err, completed := d.durability.jobResults[jobID]; completed {
+			d.durability.mu.Unlock()
+			return err
+		}
+
+		ch := d.durability.stateChanged
+		d.durability.mu.Unlock()
+
+		if ctxDone != nil {
+			d.durability.pendingWaiters.Add(1)
+			select {
+			case <-ch:
+				d.durability.pendingWaiters.Add(-1)
+				d.durability.mu.Lock()
+				continue
+			case <-ctxDone:
+				d.durability.pendingWaiters.Add(-1)
+				d.durability.mu.Lock()
+				if d.durability.firstErr != nil {
+					err := d.durability.firstErr
+					d.durability.mu.Unlock()
+					return err
+				}
+				if d.durability.closed {
+					err := d.durability.closeErr
+					d.durability.mu.Unlock()
+					if err != nil {
+						return err
+					}
+					return ErrClosed
+				}
+				d.durability.mu.Unlock()
+				return ctx.Err()
+			}
+		} else {
+			d.durability.pendingWaiters.Add(1)
+			<-ch
+			d.durability.pendingWaiters.Add(-1)
+			d.durability.mu.Lock()
+		}
+	}
+}
+
+// DurableState returns the highest durable sequence number and first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return d.durability.highestDurableSeqNum, d.durability.firstErr
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	if d.durability.firstErr != nil {
+		ch <- d.durability.firstErr
+		return ch
+	}
+	if d.durability.closed {
+		if d.durability.closeErr != nil {
+			ch <- d.durability.closeErr
+		} else {
+			ch <- ErrClosed
+		}
+		return ch
+	}
+
+	if seqNum == 0 {
+		if d.durability.totalDurableCommits+d.durability.totalFailedCommits > 0 {
+			ch <- nil
+			return ch
+		}
+	} else if d.durability.highestDurableSeqNum >= seqNum {
+		ch <- nil
+		return ch
+	}
+
+	if len(d.durability.subscriptions) >= d.durability.maxSubscriptions {
+		ch <- errors.New("pebble: excess durability subscriptions")
+		return ch
+	}
+
+	d.durability.subscriptions = append(d.durability.subscriptions, durabilitySubscription{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.durability.highestDurableSeqNum,
+		FirstErr:               d.durability.firstErr,
+		PendingWaiters:         d.durability.pendingWaiters.Load(),
+		TotalDurableCommits:    d.durability.totalDurableCommits,
+		TotalFailedCommits:     d.durability.totalFailedCommits,
+		CumulativeSyncDuration: d.durability.cumulativeSyncDuration,
+		MaxSyncDuration:        d.durability.maxSyncDuration,
+	}
+}
