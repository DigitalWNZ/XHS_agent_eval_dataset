+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import {
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  isPersisterRestoreResult,
+} from '..'
+import type { QueryCache, QueryFunctionContext, QueryState } from '..'
+
+describe('persisterRestoreResult', () => {
+  let queryClient: QueryClient
+  let queryCache: QueryCache
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    queryClient = new QueryClient()
+    queryCache = queryClient.getQueryCache()
+    queryClient.mount()
+  })
+
+  afterEach(() => {
+    queryClient.clear()
+    vi.useRealTimers()
+  })
+
+  test('createPersisterRestoreResult should create a recognizable restore result marker', () => {
+    const state: QueryState<string, Error> = {
+      data: 'cached-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('fail'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2000,
+      fetchFailureCount: 2,
+      fetchFailureReason: new Error('fail'),
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: true,
+      status: 'error',
+    }
+
+    const result = createPersisterRestoreResult({
+      data: 'cached-data',
+      state,
+    })
+
+    expect(isPersisterRestoreResult(result)).toBe(true)
+    expect(result.data).toBe('cached-data')
+    expect(result.state).toBe(state)
+  })
+
+  test('prefetchQuery should adopt restored state without calling onSuccess or onSettled', async () => {
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+    const onError = vi.fn()
+
+    const client = new QueryClient({
+      queryCache: queryCache,
+    })
+    queryCache.config.onSuccess = onSuccess
+    queryCache.config.onSettled = onSettled
+    queryCache.config.onError = onError
+
+    const restoredError = new Error('persisted refetch error')
+    const restoredState: QueryState<string, Error> = {
+      data: 'persisted data',
+      dataUpdateCount: 2,
+      dataUpdatedAt: 5000,
+      error: restoredError,
+      errorUpdateCount: 1,
+      errorUpdatedAt: 6000,
+      fetchFailureCount: 3,
+      fetchFailureReason: restoredError,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: true,
+      status: 'error',
+    }
+
+    const persister = vi.fn(() =>
+      Promise.resolve(
+        createPersisterRestoreResult({
+          data: 'persisted data',
+          state: restoredState,
+        }),
+      ),
+    )
+
+    const queryFn = vi.fn(() => Promise.resolve('fresh data'))
+
+    await client.prefetchQuery({
+      queryKey: ['prefetch-test'],
+      queryFn,
+      persister,
+    })
+
+    expect(persister).toHaveBeenCalledTimes(1)
+    expect(queryFn).not.toHaveBeenCalled()
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+    expect(onError).not.toHaveBeenCalled()
+
+    const query = queryCache.find({ queryKey: ['prefetch-test'] })!
+    expect(query).toBeDefined()
+    expect(query.state.data).toBe('persisted data')
+    expect(query.state.status).toBe('error')
+    expect(query.state.error).toBe(restoredError)
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.fetchFailureCount).toBe(3)
+    expect(query.state.dataUpdatedAt).toBe(5000)
+    expect(query.state.errorUpdatedAt).toBe(6000)
+    expect(query.state.isInvalidated).toBe(true)
+  })
+
+  test('query observer should expose isRefetchError and retain all metadata when persister restores', async () => {
+    const restoredError = new Error('persisted error')
+    const restoredState: QueryState<string, Error> = {
+      data: 'cached-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: restoredError,
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2000,
+      fetchFailureCount: 4,
+      fetchFailureReason: restoredError,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'error',
+    }
+
+    const persister = vi.fn(() =>
+      Promise.resolve(
+        createPersisterRestoreResult({
+          data: 'cached-data',
+          state: restoredState,
+        }),
+      ),
+    )
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: ['observer-test'],
+      queryFn: () => Promise.resolve('fresh'),
+      persister,
+      staleTime: Infinity,
+    })
+
+    const results: Array<any> = []
+    const unsubscribe = observer.subscribe((res) => {
+      results.push(res)
+    })
+
+    await vi.advanceTimersByTimeAsync(10)
+
+    const currentResult = observer.getCurrentResult()
+    expect(currentResult.data).toBe('cached-data')
+    expect(currentResult.status).toBe('error')
+    expect(currentResult.error).toBe(restoredError)
+    expect(currentResult.isRefetchError).toBe(true)
+    expect(currentResult.failureCount).toBe(4)
+    expect(currentResult.failureReason).toBe(restoredError)
+    expect(currentResult.dataUpdatedAt).toBe(1000)
+    expect(currentResult.errorUpdatedAt).toBe(2000)
+    expect(currentResult.fetchStatus).toBe('idle')
+
+    unsubscribe()
+  })
+
+  test('persister restore should preserve infinite query pagination state', async () => {
+    const initialPages = ['page 1', 'page 2']
+    const initialPageParams = [1, 2]
+
+    const restoredState: QueryState<
+      { pages: Array<string>; pageParams: Array<number> },
+      Error
+    > = {
+      data: { pages: initialPages, pageParams: initialPageParams },
+      dataUpdateCount: 2,
+      dataUpdatedAt: 5000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'success',
+    }
+
+    const persister = vi.fn(() =>
+      Promise.resolve(
+        createPersisterRestoreResult({
+          data: { pages: initialPages, pageParams: initialPageParams },
+          state: restoredState,
+        }),
+      ),
+    )
+
+    const queryFn = vi.fn(({ pageParam }: QueryFunctionContext<any, number>) =>
+      Promise.resolve(`page ${pageParam}`),
+    )
+
+    const options = {
+      queryKey: ['infinite-test'],
+      queryFn,
+      initialPageParam: 1,
+      getNextPageParam: (
+        _lastPage: string,
+        _allPages: Array<string>,
+        lastPageParam: number,
+      ) => lastPageParam + 1,
+      persister: persister as any,
+    }
+
+    await queryClient.prefetchInfiniteQuery(options)
+
+    const query = queryCache.find({ queryKey: ['infinite-test'] })!
+    expect(query).toBeDefined()
+    expect(query.state.data).toEqual({
+      pages: ['page 1', 'page 2'],
+      pageParams: [1, 2],
+    })
+    expect(query.state.fetchStatus).toBe('idle')
+  })
+})
