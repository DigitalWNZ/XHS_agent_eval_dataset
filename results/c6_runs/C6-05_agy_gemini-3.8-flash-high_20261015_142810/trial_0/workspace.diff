+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct {
+    unsigned int *d;
+    int len;
+    int cap;
+} BigInt;
+
+static void init_bi(BigInt *b, unsigned int val) {
+    b->cap = 16;
+    b->d = (unsigned int *)malloc(b->cap * sizeof(unsigned int));
+    b->d[0] = val;
+    b->len = 1;
+}
+
+static void add_bi(const BigInt *a, const BigInt *b, BigInt *res) {
+    int max_len = (a->len > b->len ? a->len : b->len);
+    unsigned long long carry = 0;
+    int i = 0;
+    if (res->cap < max_len + 2) {
+        res->cap = (max_len + 2) * 2;
+        res->d = (unsigned int *)realloc(res->d, res->cap * sizeof(unsigned int));
+    }
+    while (i < a->len || i < b->len || carry) {
+        unsigned long long sum = carry;
+        if (i < a->len) sum += a->d[i];
+        if (i < b->len) sum += b->d[i];
+        res->d[i] = (unsigned int)(sum % 1000000000ULL);
+        carry = sum / 1000000000ULL;
+        i++;
+    }
+    res->len = i;
+}
+
+int main(int argc, char *argv[]) {
+    long n;
+    long i;
+    int j;
+    BigInt a, b, next, tmp;
+    if (argc < 2) return 1;
+    n = atol(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    init_bi(&a, 0);
+    init_bi(&b, 1);
+    init_bi(&next, 0);
+    for (i = 0; i < n; i++) {
+        add_bi(&a, &b, &next);
+        tmp = a;
+        a = b;
+        b = next;
+        next = tmp;
+    }
