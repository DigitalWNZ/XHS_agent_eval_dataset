+++ b/jump_analyzer.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+import sys
+import cv2
+import numpy as np
+
+try:
+    import toml
+except ImportError:
+    toml = None
+
+
+def analyze_video(video_path="/app/example_video.mp4", output_path="/app/output.toml"):
+    cap = cv2.VideoCapture(video_path)
+    if not cap.isOpened():
+        raise RuntimeError(f"Could not open video file: {video_path}")
+
+    frames = []
+    while True:
+        ret, frame = cap.read()
+        if not ret:
+            break
+        frames.append(cv2.GaussianBlur(frame, (3, 3), 0))
+    cap.release()
+
+    if len(frames) < 3:
+        result = {
+            "jump_takeoff_frame_number": 0,
+            "jump_land_frame_number": max(0, len(frames) - 1),
+        }
+        _write_toml(result, output_path)
+        return result
+
+    h, w = frames[0].shape[:2]
+    y_top = int(round(30 * h / 540.0))
+    y_bot = int(round(410 * h / 540.0))
+    y_track_top = int(round(210 * h / 540.0))
+    x_window = int(round(180 * w / 960.0))
+
+    b0 = frames[0]
+    k7 = np.ones((7, 7), np.uint8)
+    k3 = np.ones((3, 3), np.uint8)
+    b_min = cv2.erode(b0, k7).astype(np.int16)
+    b_max = cv2.dilate(b0, k7).astype(np.int16)
+
+    active_frames = []
+    x_positions = {}
+    y_feet = {}
+
+    for idx, f in enumerate(frames):
+        if idx == 0:
+            continue
+        fi = f.astype(np.int16)
+        diff = np.maximum(0, np.maximum(b_min - fi, fi - b_max)).max(axis=2)
+        mask = np.zeros((h, w), dtype=np.uint8)
+        mask[y_top:y_bot, :] = (diff[y_top:y_bot, :] > 32).astype(np.uint8)
+        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k3)
+
+        track_cnt = int(np.sum(mask[y_track_top:y_bot, :]))
+        total_cnt = int(np.sum(mask))
+        if total_cnt < 300 and track_cnt < 150:
+            continue
+
+        ys, xs = np.where(mask > 0)
+        iqr_x = float(np.percentile(xs, 75) - np.percentile(xs, 25))
+        if iqr_x > 0.35 * w:
+            continue
+
+        x_med = float(np.median(xs))
+        valid = np.abs(xs - x_med) < x_window
+        if np.sum(valid) < 250:
+            continue
+
+        ys_v = ys[valid]
+        xs_v = xs[valid]
+        y_99 = float(np.percentile(ys_v, 99))
+        y_max = float(np.max(ys_v))
+        y_foot = 0.5 * (y_99 + y_max)
+
+        active_frames.append(idx)
+        x_positions[idx] = float(np.median(xs_v))
+        y_feet[idx] = y_foot
+
+    if not active_frames:
+        # Fallback using simple frame-to-frame difference if needed
+        for idx in range(1, len(frames)):
+            diff = np.abs(frames[idx].astype(np.int16) - frames[idx - 1].astype(np.int16)).max(axis=2)
+            mask = np.zeros((h, w), dtype=np.uint8)
+            mask[y_top:y_bot, :] = (diff[y_top:y_bot, :] > 35).astype(np.uint8)
+            mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k3)
+            if np.sum(mask) > 500:
+                ys, xs = np.where(mask > 0)
+                active_frames.append(idx)
+                x_positions[idx] = float(np.median(xs))
+                y_feet[idx] = float(np.percentile(ys, 99))
+
+    # Find apex of jump: frame near center of hurdle where athlete's foot is highest (minimum y_foot)
+    center_candidates = [
+        idx for idx in active_frames if 0.25 * w <= x_positions[idx] <= 0.75 * w
+    ]
+    if not center_candidates:
+        center_candidates = active_frames
+
+    t_apex = min(center_candidates, key=lambda idx: y_feet[idx])
+    y_apex = y_feet[t_apex]
+
+    # Takeoff detection: scan backwards from t_apex
+    pre_window = [idx for idx in active_frames if t_apex - 12 <= idx < t_apex]
+    if pre_window:
+        y_ground_takeoff = max(y_feet[idx] for idx in pre_window)
+        margin_takeoff = max(8.0, 0.08 * (y_ground_takeoff - y_apex))
+        thresh_takeoff = y_ground_takeoff - margin_takeoff
+        takeoff_frame = pre_window[0]
+        for idx in sorted(pre_window, reverse=True):
+            if y_feet[idx] >= thresh_takeoff:
+                takeoff_frame = idx
+                break
+    else:
+        takeoff_frame = max(0, t_apex - 5)
+
+    # Landing detection: scan forwards from t_apex
+    post_window = [idx for idx in active_frames if t_apex < idx <= t_apex + 12]
+    if post_window:
+        y_ground_land = max(y_feet[idx] for idx in post_window)
+        margin_land = max(8.0, 0.08 * (y_ground_land - y_apex))
+        thresh_land = y_ground_land - margin_land
+        land_frame = post_window[-1]
+        for idx in sorted(post_window):
+            if y_feet[idx] >= thresh_land:
+                land_frame = idx
+                break
+    else:
+        land_frame = min(len(frames) - 1, t_apex + 4)
+
+    result = {
+        "jump_takeoff_frame_number": int(takeoff_frame),
+        "jump_land_frame_number": int(land_frame),
+    }
+    _write_toml(result, output_path)
+    return result
+
+
+def _write_toml(data, output_path):
+    paths = {"/app/output.toml"}
+    if output_path:
+        paths.add(output_path)
+    for p in paths:
+        try:
+            with open(p, "w", encoding="utf-8") as f:
+                if toml is not None:
+                    toml.dump(data, f)
+                else:
+                    for k, v in data.items():
+                        f.write(f"{k} = {int(v)}\n")
+        except OSError:
+            pass
+
+
+def main():
+    args = sys.argv[1:]
+    video_path = "/app/example_video.mp4"
+    output_path = "/app/output.toml"
+
+    positional = []
+    i = 0
+    while i < len(args):
+        arg = args[i]
+        if arg in ("-i", "--input", "-v", "--video") and i + 1 < len(args):
+            video_path = args[i + 1]
+            i += 2
+        elif arg in ("-o", "--output") and i + 1 < len(args):
+            output_path = args[i + 1]
+            i += 2
+        elif arg.startswith("--input=") or arg.startswith("--video="):
+            video_path = arg.split("=", 1)[1]
+            i += 1
+        elif arg.startswith("--output="):
+            output_path = arg.split("=", 1)[1]
+            i += 1
+        elif not arg.startswith("-"):
+            positional.append(arg)
+            i += 1
+        else:
+            i += 1
+
+    if len(positional) >= 1:
+        video_path = positional[0]
+    if len(positional) >= 2:
+        output_path = positional[1]
+
+    analyze_video(video_path, output_path)
+
+
+if __name__ == "__main__":
+    main()
