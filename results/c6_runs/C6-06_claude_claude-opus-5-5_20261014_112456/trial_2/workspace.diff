+MTEB: Massive Text Embedding Benchmark
diff --git a/run_emb.py b/run_emb.py
new file mode 100644
--- /dev/null
+++ b/run_emb.py
@@ -0,0 +1,11 @@
+import mteb, numpy as np
+m = mteb.get_model("BAAI/bge-small-zh-v1.5", revision="7999e1d3359715c523056ef9478215996d62a620")
+docs = [l.rstrip("\n") for l in open("/app/data.txt", encoding="utf-8")]
+docs = [d for d in docs if d.strip()]
+q = m.encode(["terminal-bench"], task_name="SciFact", prompt_type=mteb.encoder_interface.PromptType.query)
+d = m.encode(docs, task_name="SciFact", prompt_type=mteb.encoder_interface.PromptType.passage)
+q = q/np.linalg.norm(q,axis=1,keepdims=True); d = d/np.linalg.norm(d,axis=1,keepdims=True)
+s = (d@q.T).ravel()
+o = np.argsort(-s)
+for i in o[:7]: print(round(float(s[i]),4), docs[i])
+open("/app/result.txt","w").write(docs[o[4]])
