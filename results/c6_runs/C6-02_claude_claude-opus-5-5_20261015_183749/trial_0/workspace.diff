--- /dev/null
+++ b/durability.go
@@ -0,0 +1,462 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"container/heap"
+	"context"
+	"reflect"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/redact"
+)
+
+const (
+	// durabilityJobRetention is the number of most recent BatchDurable job IDs
+	// whose outcome is retained for WaitForJobDurability.
+	durabilityJobRetention = 1024
+	// maxDurabilitySubscriptions bounds the number of outstanding
+	// DurabilityNotify channels.
+	maxDurabilitySubscriptions = 1024
+)
+
+var (
+	// ErrDurabilityJobExpired is returned by WaitForJobDurability when the job
+	// ID is older than the retention window.
+	ErrDurabilityJobExpired = errors.New("pebble: durability job expired")
+	// ErrDurabilityJobUnknown is returned by WaitForJobDurability when the job
+	// ID was never assigned.
+	ErrDurabilityJobUnknown = errors.New("pebble: unknown durability job")
+	// ErrTooManyDurabilitySubscriptions is delivered on the channel returned by
+	// DurabilityNotify when too many subscriptions are outstanding.
+	ErrTooManyDurabilitySubscriptions = errors.New("pebble: too many outstanding durability subscriptions")
+)
+
+// BatchDurableInfo contains the info for a BatchDurable event.
+type BatchDurableInfo struct {
+	// JobID is a unique identifier for this durability event, usable with
+	// DB.WaitForJobDurability.
+	JobID int
+	// SeqNum is the sequence number of the first operation in the batch.
+	SeqNum base.SeqNum
+	// Err is the error, if any, encountered while committing or syncing the
+	// batch.
+	Err error
+	// ApplyDuration is the time spent applying the batch to the memtable.
+	ApplyDuration time.Duration
+	// SyncDuration is the time between the batch being written to the WAL and
+	// the WAL sync completing.
+	SyncDuration time.Duration
+	// CorrelationID is WriteOptions.CommitCorrelationID.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch in bytes.
+	BatchSize int
+	// KeyCount is the number of operations in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error (seq %d): %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable (seq %d, %d keys, %d bytes); apply %.3fs, sync %.3fs",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.KeyCount),
+		redact.Safe(i.BatchSize), redact.Safe(i.ApplyDuration.Seconds()),
+		redact.Safe(i.SyncDuration.Seconds()))
+}
+
+// noopBatchDurable is installed by EventListener.EnsureDefaults when
+// BatchDurable is unset. It is a named function so that the DB can detect
+// whether a BatchDurable callback was actually configured.
+func noopBatchDurable(BatchDurableInfo) {}
+
+func isNoopBatchDurable(fn func(BatchDurableInfo)) bool {
+	return fn == nil ||
+		reflect.ValueOf(fn).Pointer() == reflect.ValueOf(noopBatchDurable).Pointer()
+}
+
+// DurabilityStats is a snapshot of the DB's commit durability state.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number known to be durable.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first error encountered by a sync commit.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in a
+	// durability wait API.
+	PendingWaiters int64
+	// TotalDurableCommits is the number of successful sync commits.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the number of failed sync commits.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the sum of the sync durations of successful
+	// sync commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the maximum sync duration of a successful sync commit.
+	MaxSyncDuration time.Duration
+}
+
+// batchDurableState is per-batch state used to report a BatchDurable event.
+type batchDurableState struct {
+	// pending is set when an ApplyNoSyncWait commit must report its BatchDurable
+	// event from Batch.SyncWait.
+	pending       bool
+	db            *DB
+	correlationID uint64
+	batchSize     int
+	applyDuration time.Duration
+	syncDuration  time.Duration
+	syncStart     crtime.Mono
+}
+
+type durabilityJob struct {
+	id  int
+	err error
+}
+
+type durabilitySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilitySubHeap []durabilitySub
+
+func (h durabilitySubHeap) Len() int           { return len(h) }
+func (h durabilitySubHeap) Less(i, j int) bool { return h[i].seqNum < h[j].seqNum }
+func (h durabilitySubHeap) Swap(i, j int)      { h[i], h[j] = h[j], h[i] }
+func (h *durabilitySubHeap) Push(x any)        { *h = append(*h, x.(durabilitySub)) }
+func (h *durabilitySubHeap) Pop() any {
+	old := *h
+	n := len(old)
+	x := old[n-1]
+	old[n-1] = durabilitySub{}
+	*h = old[:n-1]
+	return x
+}
+
+// durabilityTracker tracks the highest durable sequence number, as established
+// by completed sync commits, and wakes goroutines waiting for durability.
+type durabilityTracker struct {
+	mu struct {
+		sync.Mutex
+		durable  base.SeqNum
+		firstErr error
+		closeErr error
+		// changed is closed (and reset to nil) whenever the state changes.
+		changed chan struct{}
+		subs    durabilitySubHeap
+		lastJob int
+		jobs    [durabilityJobRetention]durabilityJob
+
+		pendingWaiters   int64
+		durableCommits   uint64
+		failedCommits    uint64
+		cumSyncDuration  time.Duration
+		maxSyncDuration  time.Duration
+		metricsCount     uint64
+		metricsSyncTotal time.Duration
+	}
+}
+
+func (t *durabilityTracker) changedLocked() chan struct{} {
+	if t.mu.changed == nil {
+		t.mu.changed = make(chan struct{})
+	}
+	return t.mu.changed
+}
+
+// stateLocked returns (done, err) for seqNum given the current state.
+func (t *durabilityTracker) stateLocked(seqNum base.SeqNum) (bool, error) {
+	if seqNum <= t.mu.durable {
+		return true, nil
+	}
+	if t.mu.firstErr != nil {
+		return true, t.mu.firstErr
+	}
+	if t.mu.closeErr != nil {
+		return true, t.mu.closeErr
+	}
+	return false, nil
+}
+
+func (t *durabilityTracker) wait(ctx context.Context, seqNum base.SeqNum) error {
+	blocked := false
+	defer func() {
+		if blocked {
+			t.mu.Lock()
+			t.mu.pendingWaiters--
+			t.mu.Unlock()
+		}
+	}()
+	for {
+		t.mu.Lock()
+		if done, err := t.stateLocked(seqNum); done {
+			t.mu.Unlock()
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+		ch := t.changedLocked()
+		if !blocked {
+			blocked = true
+			t.mu.pendingWaiters++
+		}
+		t.mu.Unlock()
+		select {
+		case <-ch:
+		case <-ctx.Done():
+		}
+	}
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if done, err := t.stateLocked(seqNum); done {
+		ch <- err
+		return ch
+	}
+	if len(t.mu.subs) >= maxDurabilitySubscriptions {
+		ch <- ErrTooManyDurabilitySubscriptions
+		return ch
+	}
+	heap.Push(&t.mu.subs, durabilitySub{seqNum: seqNum, ch: ch})
+	return ch
+}
+
+func (t *durabilityTracker) waitJob(jobID int) error {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if jobID <= 0 || jobID > t.mu.lastJob {
+		return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", errors.Safe(jobID))
+	}
+	if jobID <= t.mu.lastJob-durabilityJobRetention {
+		return errors.Wrapf(ErrDurabilityJobExpired, "job %d", errors.Safe(jobID))
+	}
+	j := &t.mu.jobs[jobID%durabilityJobRetention]
+	if j.id != jobID {
+		return errors.AssertionFailedf("pebble: durability job %d not retained", errors.Safe(jobID))
+	}
+	return j.err
+}
+
+// pendingWake holds the waiters to be released after the BatchDurable
+// callback has been invoked.
+type pendingWake struct {
+	changed chan struct{}
+	subs    []durabilitySub
+	err     error
+}
+
+func (w *pendingWake) release() {
+	if w.changed != nil {
+		close(w.changed)
+	}
+	for _, s := range w.subs {
+		s.ch <- w.err
+	}
+}
+
+// takeWakeLocked collects the waiters that must be woken given the current
+// state. If err is non-nil, all subscriptions are released with err.
+func (t *durabilityTracker) takeWakeLocked(err error) pendingWake {
+	w := pendingWake{changed: t.mu.changed, err: err}
+	t.mu.changed = nil
+	if err != nil {
+		w.subs = t.mu.subs
+		t.mu.subs = nil
+		return w
+	}
+	for len(t.mu.subs) > 0 && t.mu.subs[0].seqNum <= t.mu.durable {
+		w.subs = append(w.subs, heap.Pop(&t.mu.subs).(durabilitySub))
+	}
+	return w
+}
+
+// record records the outcome of a sync commit covering sequence numbers
+// [seqNum, seqNum+count), returning the assigned job ID and the waiters to wake.
+func (t *durabilityTracker) record(
+	seqNum base.SeqNum, count uint32, err error, syncDuration time.Duration, collectMetrics bool,
+) (int, pendingWake) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.mu.lastJob++
+	jobID := t.mu.lastJob
+	t.mu.jobs[jobID%durabilityJobRetention] = durabilityJob{id: jobID, err: err}
+	if err != nil {
+		t.mu.failedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		return jobID, t.takeWakeLocked(t.mu.firstErr)
+	}
+	t.mu.durableCommits++
+	t.mu.cumSyncDuration += syncDuration
+	t.mu.maxSyncDuration = max(t.mu.maxSyncDuration, syncDuration)
+	if collectMetrics {
+		t.mu.metricsCount++
+		t.mu.metricsSyncTotal += syncDuration
+	}
+	last := seqNum
+	if count > 0 {
+		last = seqNum + base.SeqNum(count) - 1
+	}
+	t.mu.durable = max(t.mu.durable, last)
+	return jobID, t.takeWakeLocked(nil)
+}
+
+func (t *durabilityTracker) close(err error) {
+	t.mu.Lock()
+	if t.mu.closeErr == nil {
+		t.mu.closeErr = err
+	}
+	w := t.takeWakeLocked(err)
+	t.mu.Unlock()
+	w.release()
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.durable, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.durable,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.mu.pendingWaiters,
+		TotalDurableCommits:    t.mu.durableCommits,
+		TotalFailedCommits:     t.mu.failedCommits,
+		CumulativeSyncDuration: t.mu.cumSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metrics() (uint64, time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.metricsCount, t.mu.metricsSyncTotal
+}
+
+// reportBatchDurable records the outcome of a sync commit of b and invokes the
+// BatchDurable event listener. Waiters are released after the listener
+// returns.
+func (d *DB) reportBatchDurable(b *Batch, err error) {
+	s := &b.durable
+	info := BatchDurableInfo{
+		SeqNum:        b.SeqNum(),
+		Err:           err,
+		ApplyDuration: s.applyDuration,
+		SyncDuration:  s.syncDuration,
+		CorrelationID: s.correlationID,
+		BatchSize:     s.batchSize,
+		KeyCount:      b.Count(),
+	}
+	if err == nil {
+		// Durations are measured, but guard against a coarse clock reporting
+		// zero for a successful commit.
+		info.ApplyDuration = max(info.ApplyDuration, 1)
+		info.SyncDuration = max(info.SyncDuration, 1)
+	}
+	var w pendingWake
+	info.JobID, w = d.durability.record(info.SeqNum, info.KeyCount, err, info.SyncDuration, d.batchDurableConfigured)
+	d.opts.EventListener.BatchDurable(info)
+	w.release()
+}
+
+// WaitForDurability blocks until seqNum is durable, a sync commit fails, or
+// the DB is closed. A seqNum of zero succeeds immediately. If the WAL is
+// disabled, WaitForDurability returns nil immediately.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability, but also returns if ctx
+// is done. Durability and close errors take precedence over ctx errors.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.wait(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable. An empty slice returns nil.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch, but also
+// returns if ctx is done.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 || d.opts.DisableWAL {
+		return nil
+	}
+	// Durability is established for a prefix of the sequence number space, so
+	// waiting for the maximum is sufficient.
+	var maxSeqNum base.SeqNum
+	for _, s := range seqNums {
+		maxSeqNum = max(maxSeqNum, s)
+	}
+	return d.durability.wait(ctx, maxSeqNum)
+}
+
+// WaitForJobDurability returns the outcome of the BatchDurable event with the
+// given job ID. Job IDs that have fallen out of the retention window return
+// an error wrapping ErrDurabilityJobExpired; job IDs that were never assigned
+// return an error wrapping ErrDurabilityJobUnknown.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability, but accepts a
+// context. Since job IDs are only assigned once a sync commit has completed,
+// it never blocks.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitJob(jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// error encountered by a sync commit.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a channel that receives nil once seqNum is durable,
+// or a non-nil error if a sync commit fails or the DB is closed. The channel is
+// buffered and receives exactly one value. If too many subscriptions are
+// outstanding, the channel is pre-filled with ErrTooManyDurabilitySubscriptions.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.notify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of the durability state.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
