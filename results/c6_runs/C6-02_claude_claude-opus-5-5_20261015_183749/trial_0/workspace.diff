+// teeBatchDurable returns a BatchDurable callback forwarding to a and b. If
+// neither is configured, the no-op callback is returned so that the DB can
+// tell that no BatchDurable callback is configured.
+func teeBatchDurable(a, b func(BatchDurableInfo)) func(BatchDurableInfo) {
+	switch {
+	case isNoopBatchDurable(a) && isNoopBatchDurable(b):
+		return noopBatchDurable
+	case isNoopBatchDurable(a):
+		return b
+	case isNoopBatchDurable(b):
+		return a
+	}
+	return func(info BatchDurableInfo) {
+		a(info)
+		b(info)
+	}
+}
