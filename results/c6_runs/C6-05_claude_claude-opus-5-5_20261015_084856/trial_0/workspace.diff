+/* Big decimal numbers stored little-endian, one digit per byte. */
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long n = atol(argv[1]);
+    size_t cap = (size_t)(n * 0.21) + 16;
+    unsigned char *a = calloc(cap, 1), *b = calloc(cap, 1), *t;
+    size_t len = 1;
+    b[0] = 1;
+    for (long i = 0; i < n; i++) {
+        int carry = 0;
+        for (size_t j = 0; j < len; j++) {
+            int s = a[j] + b[j] + carry;
+            a[j] = s % 10;
+            carry = s / 10;
+        }
+        if (carry) a[len++] = carry;
+        t = a; a = b; b = t;
+    }
+    size_t k = len;
+    while (k > 1 && a[k - 1] == 0) k--;
+    char *out = malloc(k + 1);
+    for (size_t j = 0; j < k; j++) out[j] = '0' + a[k - 1 - j];
+    out[k] = 0;
+    puts(out);
+    return 0;
