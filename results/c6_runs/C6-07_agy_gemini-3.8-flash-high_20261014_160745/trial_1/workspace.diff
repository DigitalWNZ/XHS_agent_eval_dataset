+            PIXFMT_YUV420P => yuv2yuv.convert_yuv422p_to_yuv420p,
+            else => null,
+        },
+        PIXFMT_YUV444P => switch (dst_fmt) {
+            PIXFMT_RGB24 => yuv2rgb.convert_yuv444p_to_rgb24,
+            PIXFMT_BGR24 => yuv2rgb.convert_yuv444p_to_bgr24,
+            PIXFMT_YUV420P => yuv2yuv.convert_yuv444p_to_yuv420p,
