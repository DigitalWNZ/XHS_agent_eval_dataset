+++ b/swscale-impl/src/gray.zig
@@ -0,0 +1,183 @@
+// gray.zig — Grayscale format conversions.
+const std = @import("std");
+
+pub fn convert_yuv420p_to_gray8(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const d_row = d_ptr + y * d_stride;
+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            inline for (0..8) |i| {
+                const y_val = @as(i32, s_row[x + i]);
+                d_row[x + i] = @as(u8, @intCast(std.math.clamp(((y_val - 16) * 76309 + 32768) >> 16, 0, 255)));
+            }
+        }
+        while (x < w) : (x += 1) {
+            const y_val = @as(i32, s_row[x]);
+            d_row[x] = @as(u8, @intCast(std.math.clamp(((y_val - 16) * 76309 + 32768) >> 16, 0, 255)));
+        }
+    }
+    return 0;
+}
+
+pub fn convert_gray8_to_yuv420p(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_y = dst_data[0] orelse return -1;
+    const d_u = dst_data[1] orelse return -1;
+    const d_v = dst_data[2] orelse return -1;
+
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const dy_stride = @as(usize, @intCast(dst_stride[0]));
+    const du_stride = @as(usize, @intCast(dst_stride[1]));
+    const dv_stride = @as(usize, @intCast(dst_stride[2]));
+
+    // Full range to limited range: Y = (val * 219 + 128) / 255 + 16
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const dy_row = d_y + y * dy_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const val = @as(u32, s_row[x]);
+            dy_row[x] = @as(u8, @intCast((val * 219 + 128) / 255 + 16));
+        }
+    }
+
+    // Chroma is filled with 128
+    const cw = w / 2;
+    const ch = h / 2;
+    for (0..ch) |y| {
+        @memset(d_u[y * du_stride .. y * du_stride + cw], 128);
+        @memset(d_v[y * dv_stride .. y * dv_stride + cw], 128);
+    }
+    return 0;
+}
+
+pub fn convert_gray8_to_rgb24(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const d_row = d_ptr + y * d_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const v = s_row[x];
+            d_row[x * 3 + 0] = v;
+            d_row[x * 3 + 1] = v;
+            d_row[x * 3 + 2] = v;
+        }
+    }
+    return 0;
+}
+
+pub fn convert_gray8_to_rgba(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const d_row = d_ptr + y * d_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const v = s_row[x];
+            d_row[x * 4 + 0] = v;
+            d_row[x * 4 + 1] = v;
+            d_row[x * 4 + 2] = v;
+            d_row[x * 4 + 3] = 255;
+        }
+    }
+    return 0;
+}
+
+pub fn convert_rgb24_to_gray8(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const d_row = d_ptr + y * d_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const r = @as(i32, s_row[x * 3 + 0]);
+            const g = @as(i32, s_row[x * 3 + 1]);
+            const b = @as(i32, s_row[x * 3 + 2]);
+            const gray = (19595 * r + 38469 * g + 7472 * b + 32768) >> 16;
+            d_row[x] = @as(u8, @intCast(std.math.clamp(gray, 0, 255)));
+        }
+    }
+    return 0;
+}
+
+pub fn convert_rgba_to_gray8(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const d_row = d_ptr + y * d_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const r = @as(i32, s_row[x * 4 + 0]);
+            const g = @as(i32, s_row[x * 4 + 1]);
+            const b = @as(i32, s_row[x * 4 + 2]);
+            const gray = (19595 * r + 38469 * g + 7472 * b + 32768) >> 16;
+            d_row[x] = @as(u8, @intCast(std.math.clamp(gray, 0, 255)));
+        }
+    }
+    return 0;
+}
