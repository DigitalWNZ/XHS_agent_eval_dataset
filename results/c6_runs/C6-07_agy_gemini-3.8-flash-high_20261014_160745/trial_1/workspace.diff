+pub fn convert_rgb24_to_bgr24(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_ptr = src_data[0] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+    const s_stride = @as(usize, @intCast(src_stride[0]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    for (0..h) |y| {
+        const s_row = s_ptr + y * s_stride;
+        const d_row = d_ptr + y * d_stride;
+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            // 8 pixels = 24 bytes
+            const s_bytes: *const [24]u8 = @ptrCast(s_row + x * 3);
+            const d_bytes: *[24]u8 = @ptrCast(d_row + x * 3);
+            inline for (0..8) |i| {
+                d_bytes[i * 3 + 0] = s_bytes[i * 3 + 2];
+                d_bytes[i * 3 + 1] = s_bytes[i * 3 + 1];
+                d_bytes[i * 3 + 2] = s_bytes[i * 3 + 0];
+            }
+        }
+        while (x < w) : (x += 1) {
+            const r = s_row[x * 3 + 0];
+            const g = s_row[x * 3 + 1];
+            const b = s_row[x * 3 + 2];
+            d_row[x * 3 + 0] = b;
+            d_row[x * 3 + 1] = g;
+            d_row[x * 3 + 2] = r;
+        }
+    }
+    return 0;
+}
