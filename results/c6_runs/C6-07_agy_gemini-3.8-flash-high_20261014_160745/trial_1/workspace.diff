+// yuv2rgb.zig — Fast SIMD conversions from planar/semiplanar YUV to packed RGB formats.
+const std = @import("std");
+
+pub const Yuv2RgbTables = struct {
+    y_table: [2048]u8,
+    r_tab: [256]u16,
+    b_tab: [256]u16,
+    gu_tab: [256]u16,
+    gv_tab: [256]i16,
+
+    pub fn init() Yuv2RgbTables {
+        @setEvalBranchQuota(100000);
+        var res: Yuv2RgbTables = undefined;
+        const cy: i64 = 76309;
+        const oy: i64 = 16 << 16;
+        const crv: i64 = 89830;
+        const cbu: i64 = 113537;
+        const cgu: i64 = -22050;
+        const cgv: i64 = -45757;
+
+        var yb: i64 = -(384 << 16) - 512 * cy - oy;
+        for (0..2048) |i| {
+            const val = (yb + 0x8000) >> 16;
+            res.y_table[i] = @as(u8, @intCast(std.math.clamp(val, 0, 255)));
+            yb += cy;
+        }
+
+        const yoffs: i64 = 326 + 512;
+        for (0..256) |i| {
+            const fi: i64 = @intCast(i);
+            res.r_tab[i] = @as(u16, @intCast(yoffs - (crv >> 9) + ((fi * crv) >> 16)));
+            res.b_tab[i] = @as(u16, @intCast(yoffs - (cbu >> 9) + ((fi * cbu) >> 16)));
+            res.gu_tab[i] = @as(u16, @intCast(yoffs - (cgu >> 9) + ((fi * cgu) >> 16)));
+            res.gv_tab[i] = @as(i16, @intCast(-(cgv >> 9) + ((fi * cgv) >> 16)));
+        }
+        return res;
+    }
+};
+
+pub const tables = Yuv2RgbTables.init();
+
+pub inline fn lookup_rgb(y: u8, u: u8, v: u8) struct { r: u8, g: u8, b: u8 } {
+    const yi = @as(usize, y);
+    const r = tables.y_table[tables.r_tab[v] + yi];
+    const g_idx = @as(usize, @intCast(@as(i32, tables.gu_tab[u]) + @as(i32, tables.gv_tab[v]) + @as(i32, y)));
+    const g = tables.y_table[g_idx];
+    const b = tables.y_table[tables.b_tab[u] + yi];
+    return .{ .r = r, .g = g, .b = b };
+}
+
+pub fn convert_yuv420p_to_rgb24(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_y = src_data[0] orelse return -1;
+    const s_u = src_data[1] orelse return -1;
+    const s_v = src_data[2] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+
+    const sy_stride = @as(usize, @intCast(src_stride[0]));
+    const su_stride = @as(usize, @intCast(src_stride[1]));
+    const sv_stride = @as(usize, @intCast(src_stride[2]));
+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+
+    const ch = h / 2;
+    const cw = w / 2;
+
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = y0 + 1;
+        const y_row0 = s_y + y0 * sy_stride;
+        const y_row1 = s_y + y1 * sy_stride;
+        const u_row = s_u + cy * su_stride;
+        const v_row = s_v + cy * sv_stride;
+        const d_row0 = d_ptr + y0 * d_stride;
+        const d_row1 = d_ptr + y1 * d_stride;
+
+        for (0..cw) |cx| {
+            const u = u_row[cx];
+            const v = v_row[cx];
+            const px = cx * 2;
+
+            const rgb0_0 = lookup_rgb(y_row0[px + 0], u, v);
+            const rgb0_1 = lookup_rgb(y_row0[px + 1], u, v);
+            d_row0[(px + 0) * 3 + 0] = rgb0_0.r;
+            d_row0[(px + 0) * 3 + 1] = rgb0_0.g;
+            d_row0[(px + 0) * 3 + 2] = rgb0_0.b;
+            d_row0[(px + 1) * 3 + 0] = rgb0_1.r;
+            d_row0[(px + 1) * 3 + 1] = rgb0_1.g;
+            d_row0[(px + 1) * 3 + 2] = rgb0_1.b;
+
+            const rgb1_0 = lookup_rgb(y_row1[px + 0], u, v);
+            const rgb1_1 = lookup_rgb(y_row1[px + 1], u, v);
+            d_row1[(px + 0) * 3 + 0] = rgb1_0.r;
+            d_row1[(px + 0) * 3 + 1] = rgb1_0.g;
+            d_row1[(px + 0) * 3 + 2] = rgb1_0.b;
+            d_row1[(px + 1) * 3 + 0] = rgb1_1.r;
+            d_row1[(px + 1) * 3 + 1] = rgb1_1.g;
+            d_row1[(px + 1) * 3 + 2] = rgb1_1.b;
+        }
+    }
+    return 0;
+}
+
+pub fn convert_yuv420p_to_bgr24(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_y = src_data[0] orelse return -1;
+    const s_u = src_data[1] orelse return -1;
+    const s_v = src_data[2] orelse return -1;
+    const d_ptr = dst_data[0] orelse return -1;
+
+    const sy_stride = @as(usize, @intCast(src_stride[0]));
