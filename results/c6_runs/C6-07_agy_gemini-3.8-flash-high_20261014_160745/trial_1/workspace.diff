+// yuv2yuv.zig — Conversions between different planar YUV subsamplings.
+const std = @import("std");
+
+pub fn convert_yuv422p_to_yuv420p(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_y = src_data[0] orelse return -1;
+    const s_u = src_data[1] orelse return -1;
+    const s_v = src_data[2] orelse return -1;
+    const d_y = dst_data[0] orelse return -1;
+    const d_u = dst_data[1] orelse return -1;
+    const d_v = dst_data[2] orelse return -1;
+
+    const sy_stride = @as(usize, @intCast(src_stride[0]));
+    const su_stride = @as(usize, @intCast(src_stride[1]));
+    const sv_stride = @as(usize, @intCast(src_stride[2]));
+    const dy_stride = @as(usize, @intCast(dst_stride[0]));
+    const du_stride = @as(usize, @intCast(dst_stride[1]));
+    const dv_stride = @as(usize, @intCast(dst_stride[2]));
+
+    // Copy Y plane
+    for (0..h) |y| {
+        @memcpy(d_y[y * dy_stride .. y * dy_stride + w], s_y[y * sy_stride .. y * sy_stride + w]);
+    }
+
+    const cw = w / 2;
+    const ch = h / 2;
+
+    // Filter chroma U and V with exact 4-tap vertical filter [1, 3, 3, 1] / 8:
+    // Line 0: (4*line0 + 3*line1 + line2 + 4) >> 3
+    // Line dy: (line[2*dy-1] + 3*line[2*dy] + 3*line[2*dy+1] + line[2*dy+2] + 4) >> 3
+    // Line ch-1: (line[h-3] + 3*line[h-2] + 4*line[h-1] + 4) >> 3
+    const filter_plane = struct {
+        fn run(src: [*]const u8, s_str: usize, dst: [*]u8, d_str: usize, width: usize, height: usize) void {
+            const sh = height * 2;
+            for (0..height) |dy| {
+                const d_row = dst + dy * d_str;
+                if (dy == 0) {
+                    const l0 = src + 0 * s_str;
+                    const l1 = src + 1 * s_str;
+                    const l2 = src + 2 * s_str;
+                    for (0..width) |x| {
+                        const val = (64 << 12) + (2048 * (@as(i32, l0[x]) << 7) + 1536 * (@as(i32, l1[x]) << 7) + 512 * (@as(i32, l2[x]) << 7));
+                        d_row[x] = @as(u8, @intCast(std.math.clamp(val >> 19, 0, 255)));
+                    }
+                } else if (dy == height - 1) {
+                    const l0 = src + (sh - 3) * s_str;
+                    const l1 = src + (sh - 2) * s_str;
+                    const l2 = src + (sh - 1) * s_str;
+                    for (0..width) |x| {
+                        const val = (64 << 12) + (512 * (@as(i32, l0[x]) << 7) + 1536 * (@as(i32, l1[x]) << 7) + 2048 * (@as(i32, l2[x]) << 7));
+                        d_row[x] = @as(u8, @intCast(std.math.clamp(val >> 19, 0, 255)));
+                    }
+                } else {
+                    const l0 = src + (2 * dy - 1) * s_str;
+                    const l1 = src + (2 * dy) * s_str;
+                    const l2 = src + (2 * dy + 1) * s_str;
+                    const l3 = src + (2 * dy + 2) * s_str;
+                    for (0..width) |x| {
+                        const val = (64 << 12) + (512 * (@as(i32, l0[x]) << 7) + 1536 * (@as(i32, l1[x]) << 7) + 1536 * (@as(i32, l2[x]) << 7) + 512 * (@as(i32, l3[x]) << 7));
+                        d_row[x] = @as(u8, @intCast(std.math.clamp(val >> 19, 0, 255)));
+                    }
+                }
+            }
+        }
+    }.run;
+
+    filter_plane(s_u, su_stride, d_u, du_stride, cw, ch);
+    filter_plane(s_v, sv_stride, d_v, dv_stride, cw, ch);
+    return 0;
+}
+
+pub fn convert_yuv444p_to_yuv420p(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_y = src_data[0] orelse return -1;
+    const s_u = src_data[1] orelse return -1;
+    const s_v = src_data[2] orelse return -1;
+    const d_y = dst_data[0] orelse return -1;
+    const d_u = dst_data[1] orelse return -1;
+    const d_v = dst_data[2] orelse return -1;
+
+    const sy_stride = @as(usize, @intCast(src_stride[0]));
+    const su_stride = @as(usize, @intCast(src_stride[1]));
+    const sv_stride = @as(usize, @intCast(src_stride[2]));
+    const dy_stride = @as(usize, @intCast(dst_stride[0]));
+    const du_stride = @as(usize, @intCast(dst_stride[1]));
+    const dv_stride = @as(usize, @intCast(dst_stride[2]));
+
+    // Copy Y plane
+    for (0..h) |y| {
+        @memcpy(d_y[y * dy_stride .. y * dy_stride + w], s_y[y * sy_stride .. y * sy_stride + w]);
+    }
+
+    const cw = w / 2;
+    const ch = h / 2;
+
+    const filter_plane = struct {
+        fn run(src: [*]const u8, s_str: usize, dst: [*]u8, d_str: usize, width: usize, height: usize, src_h: usize) void {
+            const allocator = std.heap.c_allocator;
+            const h_lines = allocator.alloc(i32, width * src_h) catch return;
+            defer allocator.free(h_lines);
+
+            for (0..src_h) |y| {
+                const s = src + y * s_str;
+                const h_row = h_lines.ptr + y * width;
+                h_row[0] = @min((@as(i32, s[0]) * 8192 + @as(i32, s[1]) * 6144 + @as(i32, s[2]) * 2048) >> 7, 32767);
+                var x: usize = 1;
+                while (x < width - 1) : (x += 1) {
+                    const pos = 2 * x - 1;
+                    h_row[x] = @min((@as(i32, s[pos]) * 2048 + @as(i32, s[pos + 1]) * 6144 + @as(i32, s[pos + 2]) * 6144 + @as(i32, s[pos + 3]) * 2048) >> 7, 32767);
+                }
+                const pos = 2 * width - 4;
+                h_row[width - 1] = @min((@as(i32, s[pos + 1]) * 2048 + @as(i32, s[pos + 2]) * 6144 + @as(i32, s[pos + 3]) * 8192) >> 7, 32767);
+            }
+
+            for (0..width) |x| {
+                const col = h_lines.ptr + x;
+                dst[0 * d_str + x] = @as(u8, @intCast(std.math.clamp(((64 << 12) + col[0 * width] * 2048 + col[1 * width] * 1536 + col[2 * width] * 512) >> 19, 0, 255)));
+                var y: usize = 1;
+                while (y < height - 1) : (y += 1) {
+                    const pos = 2 * y - 1;
+                    dst[y * d_str + x] = @as(u8, @intCast(std.math.clamp(((64 << 12) + col[pos * width] * 512 + col[(pos + 1) * width] * 1536 + col[(pos + 2) * width] * 1536 + col[(pos + 3) * width] * 512) >> 19, 0, 255)));
+                }
+                const pos = 2 * height - 4;
+                dst[(height - 1) * d_str + x] = @as(u8, @intCast(std.math.clamp(((64 << 12) + col[(pos + 1) * width] * 512 + col[(pos + 2) * width] * 1536 + col[(pos + 3) * width] * 2048) >> 19, 0, 255)));
+            }
+        }
+    }.run;
+
+    filter_plane(s_u, su_stride, d_u, du_stride, cw, ch, h);
+    filter_plane(s_v, sv_stride, d_v, dv_stride, cw, ch, h);
+    return 0;
+}
+
+pub fn convert_yuv420p_to_yuv444p(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int {
+    const s_y = src_data[0] orelse return -1;
+    const s_u = src_data[1] orelse return -1;
+    const s_v = src_data[2] orelse return -1;
+    const d_y = dst_data[0] orelse return -1;
+    const d_u = dst_data[1] orelse return -1;
+    const d_v = dst_data[2] orelse return -1;
+
+    const sy_stride = @as(usize, @intCast(src_stride[0]));
+    const su_stride = @as(usize, @intCast(src_stride[1]));
+    const sv_stride = @as(usize, @intCast(src_stride[2]));
+    const dy_stride = @as(usize, @intCast(dst_stride[0]));
+    const du_stride = @as(usize, @intCast(dst_stride[1]));
+    const dv_stride = @as(usize, @intCast(dst_stride[2]));
+
+    // Copy Y plane
+    for (0..h) |y| {
+        @memcpy(d_y[y * dy_stride .. y * dy_stride + w], s_y[y * sy_stride .. y * sy_stride + w]);
+    }
+
+    const cw = w / 2;
+    const ch = h / 2;
+
+    // Upsample chroma using bilinear interpolation:
+    // Horizontal 2x:
+    // x=0: p0
+    // x=2*i+1: (3*pi + pi+1 + 2) >> 2
+    // x=2*i:   (pi-1 + 3*pi + 2) >> 2
+    // Vertical 2x:
+    // y=0: line0
+    // y=2*j+1: (3*linej + linej+1 + 2) >> 2
+    // y=2*j:   (linej-1 + 3*linej + 2) >> 2
+    const upsample_plane = struct {
+        fn run(src: [*]const u8, s_str: usize, dst: [*]u8, d_str: usize, in_w: usize, in_h: usize) void {
+            const allocator = std.heap.c_allocator;
+            const h_lines = allocator.alloc(u8, in_w * 2 * in_h) catch return;
+            defer allocator.free(h_lines);
+
+            // Horizontal upsample
+            for (0..in_h) |y| {
+                const s_row = src + y * s_str;
+                const h_row = h_lines.ptr + y * (in_w * 2);
+                h_row[0] = s_row[0];
+                for (0..in_w - 1) |x| {
+                    const p0 = @as(i32, s_row[x]);
+                    const p1 = @as(i32, s_row[x + 1]);
+                    h_row[2 * x + 1] = @as(u8, @intCast((3 * p0 + 1 * p1 + 2) >> 2));
+                    h_row[2 * x + 2] = @as(u8, @intCast((1 * p0 + 3 * p1 + 2) >> 2));
+                }
+                const last = s_row[in_w - 1];
+                h_row[2 * in_w - 1] = last;
+            }
+
+            // Vertical upsample
+            const out_w = in_w * 2;
+            for (0..out_w) |x| {
+                dst[0 * d_str + x] = h_lines.ptr[0 * out_w + x];
+            }
+            for (0..in_h - 1) |y| {
+                const l0 = h_lines.ptr + y * out_w;
+                const l1 = h_lines.ptr + (y + 1) * out_w;
+                const d0 = dst + (2 * y + 1) * d_str;
+                const d1 = dst + (2 * y + 2) * d_str;
+                for (0..out_w) |x| {
+                    const p0 = @as(i32, l0[x]);
+                    const p1 = @as(i32, l1[x]);
+                    d0[x] = @as(u8, @intCast((3 * p0 + 1 * p1 + 2) >> 2));
+                    d1[x] = @as(u8, @intCast((1 * p0 + 3 * p1 + 2) >> 2));
+                }
+            }
+            const last_row = h_lines.ptr + (in_h - 1) * out_w;
+            const d_last = dst + (2 * in_h - 1) * d_str;
+            for (0..out_w) |x| {
+                d_last[x] = last_row[x];
+            }
+        }
+    }.run;
+
+    upsample_plane(s_u, su_stride, d_u, du_stride, cw, ch);
+    upsample_plane(s_v, sv_stride, d_v, dv_stride, cw, ch);
+    return 0;
+}
