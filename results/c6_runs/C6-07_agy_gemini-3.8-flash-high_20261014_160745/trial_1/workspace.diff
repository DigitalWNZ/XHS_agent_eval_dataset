+pub fn scale_plane_nearest(
+    src: [*]const u8,
+    src_stride: usize,
+    dst: [*]u8,
+    dst_stride: usize,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+) void {
+    const x_inc = (@as(u64, src_w) << 16) / dst_w;
+    const y_inc = (@as(u64, src_h) << 16) / dst_h;
+
+    for (0..dst_h) |dy| {
+        const sy = @min(@as(usize, @intCast((dy * y_inc + 0x8000) >> 16)), src_h - 1);
+        const s_row = src + sy * src_stride;
+        const d_row = dst + dy * dst_stride;
+
+        for (0..dst_w) |dx| {
+            const sx = @min(@as(usize, @intCast((dx * x_inc + 0x8000) >> 16)), src_w - 1);
+            d_row[dx] = s_row[sx];
+        }
+    }
+}
+
+pub fn scale_plane_bilinear(
+    src: [*]const u8,
+    src_stride: usize,
+    dst: [*]u8,
+    dst_stride: usize,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+) void {
+    const x_inc = (@as(u64, src_w) << 16) / dst_w;
+    const y_inc = (@as(u64, src_h) << 16) / dst_h;
+
+    for (0..dst_h) |dy| {
+        const y_fix = dy * y_inc;
+        const sy = @as(usize, @intCast(y_fix >> 16));
+        const fy = @as(u32, @intCast(y_fix & 0xFFFF));
+        const sy1 = if (sy + 1 < src_h) sy + 1 else sy;
+        const r0 = src + sy * src_stride;
+        const r1 = src + sy1 * src_stride;
+        const d_row = dst + dy * dst_stride;
+
+        for (0..dst_w) |dx| {
+            const x_fix = dx * x_inc;
+            const sx = @as(usize, @intCast(x_fix >> 16));
+            const fx = @as(u32, @intCast(x_fix & 0xFFFF));
+            const sx1 = if (sx + 1 < src_w) sx + 1 else sx;
+
+            const p00: u32 = r0[sx];
+            const p01: u32 = r0[sx1];
+            const p10: u32 = r1[sx];
+            const p11: u32 = r1[sx1];
+
+            const top = (p00 * (65536 - fx) + p01 * fx + 32768) >> 16;
+            const bot = (p10 * (65536 - fx) + p11 * fx + 32768) >> 16;
+            const val = (top * (65536 - fy) + bot * fy + 32768) >> 16;
+            d_row[dx] = @as(u8, @intCast(@min(val, 255)));
+        }
+    }
+}
+
+pub fn scale_packed3(
+    src: [*]const u8,
+    src_stride: usize,
+    dst: [*]u8,
+    dst_stride: usize,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    algo: c_int,
+) void {
+    const x_inc = (@as(u64, src_w) << 16) / dst_w;
+    const y_inc = (@as(u64, src_h) << 16) / dst_h;
+
+    if (algo == 0) {
+        for (0..dst_h) |dy| {
+            const sy = @min(@as(usize, @intCast((dy * y_inc + 0x8000) >> 16)), src_h - 1);
+            const s_row = src + sy * src_stride;
+            const d_row = dst + dy * dst_stride;
+            for (0..dst_w) |dx| {
+                const sx = @min(@as(usize, @intCast((dx * x_inc + 0x8000) >> 16)), src_w - 1);
+                d_row[dx * 3 + 0] = s_row[sx * 3 + 0];
+                d_row[dx * 3 + 1] = s_row[sx * 3 + 1];
+                d_row[dx * 3 + 2] = s_row[sx * 3 + 2];
+            }
+        }
+    } else {
+        for (0..dst_h) |dy| {
+            const y_fix = dy * y_inc;
+            const sy = @as(usize, @intCast(y_fix >> 16));
+            const fy = @as(u32, @intCast(y_fix & 0xFFFF));
+            const sy1 = if (sy + 1 < src_h) sy + 1 else sy;
+            const r0 = src + sy * src_stride;
+            const r1 = src + sy1 * src_stride;
+            const d_row = dst + dy * dst_stride;
+
+            for (0..dst_w) |dx| {
+                const x_fix = dx * x_inc;
+                const sx = @as(usize, @intCast(x_fix >> 16));
+                const fx = @as(u32, @intCast(x_fix & 0xFFFF));
+                const sx1 = if (sx + 1 < src_w) sx + 1 else sx;
+
+                inline for (0..3) |c| {
+                    const p00: u32 = r0[sx * 3 + c];
+                    const p01: u32 = r0[sx1 * 3 + c];
+                    const p10: u32 = r1[sx * 3 + c];
+                    const p11: u32 = r1[sx1 * 3 + c];
+
+                    const top = (p00 * (65536 - fx) + p01 * fx + 32768) >> 16;
+                    const bot = (p10 * (65536 - fx) + p11 * fx + 32768) >> 16;
+                    const val = (top * (65536 - fy) + bot * fy + 32768) >> 16;
+                    d_row[dx * 3 + c] = @as(u8, @intCast(@min(val, 255)));
+                }
+            }
+        }
+    }
+}
+
+pub fn scale_packed4(
+    src: [*]const u8,
+    src_stride: usize,
+    dst: [*]u8,
+    dst_stride: usize,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    algo: c_int,
+) void {
+    const x_inc = (@as(u64, src_w) << 16) / dst_w;
+    const y_inc = (@as(u64, src_h) << 16) / dst_h;
+
+    if (algo == 0) {
+        for (0..dst_h) |dy| {
+            const sy = @min(@as(usize, @intCast((dy * y_inc + 0x8000) >> 16)), src_h - 1);
+            const s_row = src + sy * src_stride;
+            const d_row = dst + dy * dst_stride;
+            for (0..dst_w) |dx| {
+                const sx = @min(@as(usize, @intCast((dx * x_inc + 0x8000) >> 16)), src_w - 1);
+                d_row[dx * 4 + 0] = s_row[sx * 4 + 0];
+                d_row[dx * 4 + 1] = s_row[sx * 4 + 1];
+                d_row[dx * 4 + 2] = s_row[sx * 4 + 2];
+                d_row[dx * 4 + 3] = s_row[sx * 4 + 3];
+            }
+        }
+    } else {
+        for (0..dst_h) |dy| {
+            const y_fix = dy * y_inc;
+            const sy = @as(usize, @intCast(y_fix >> 16));
+            const fy = @as(u32, @intCast(y_fix & 0xFFFF));
+            const sy1 = if (sy + 1 < src_h) sy + 1 else sy;
+            const r0 = src + sy * src_stride;
+            const r1 = src + sy1 * src_stride;
+            const d_row = dst + dy * dst_stride;
+
+            for (0..dst_w) |dx| {
+                const x_fix = dx * x_inc;
+                const sx = @as(usize, @intCast(x_fix >> 16));
+                const fx = @as(u32, @intCast(x_fix & 0xFFFF));
+                const sx1 = if (sx + 1 < src_w) sx + 1 else sx;
+
+                inline for (0..4) |c| {
+                    const p00: u32 = r0[sx * 4 + c];
+                    const p01: u32 = r0[sx1 * 4 + c];
+                    const p10: u32 = r1[sx * 4 + c];
+                    const p11: u32 = r1[sx1 * 4 + c];
+
+                    const top = (p00 * (65536 - fx) + p01 * fx + 32768) >> 16;
+                    const bot = (p10 * (65536 - fx) + p11 * fx + 32768) >> 16;
+                    const val = (top * (65536 - fy) + bot * fy + 32768) >> 16;
+                    d_row[dx * 4 + c] = @as(u8, @intCast(@min(val, 255)));
+                }
+            }
+        }
+    }
+}
+
+pub fn scale_plane(
+    src: [*]const u8,
+    src_stride: usize,
+    dst: [*]u8,
+    dst_stride: usize,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    algo: c_int,
+) void {
+    if (algo == 0) {
+        scale_plane_nearest(src, src_stride, dst, dst_stride, src_w, src_h, dst_w, dst_h);
+    } else {
+        scale_plane_bilinear(src, src_stride, dst, dst_stride, src_w, src_h, dst_w, dst_h);
+    }
+}
