+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            // 8 pixels = 32 bytes
+            const V = @Vector(32, u8);
+            const v: V = @as(*const [32]u8, @ptrCast(s_row + x * 4)).*;
+            // Swap bytes 0 and 2, 4 and 6, etc.
+            const mask: [32]i32 = .{
+                2, 1, 0, 3,  6, 5, 4, 7,
+                10, 9, 8, 11, 14, 13, 12, 15,
+                18, 17, 16, 19, 22, 21, 20, 23,
+                26, 25, 24, 27, 30, 29, 28, 31,
