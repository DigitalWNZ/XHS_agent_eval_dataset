+const scale = @import("scale.zig");
+
+pub const PIXFMT_YUV420P = types.PIXFMT_YUV420P;
+pub const PIXFMT_YUV422P = types.PIXFMT_YUV422P;
+pub const PIXFMT_YUV444P = types.PIXFMT_YUV444P;
+pub const PIXFMT_NV12 = types.PIXFMT_NV12;
+pub const PIXFMT_NV21 = types.PIXFMT_NV21;
+pub const PIXFMT_RGB24 = types.PIXFMT_RGB24;
+pub const PIXFMT_BGR24 = types.PIXFMT_BGR24;
+pub const PIXFMT_RGBA = types.PIXFMT_RGBA;
+pub const PIXFMT_BGRA = types.PIXFMT_BGRA;
+pub const PIXFMT_GRAY8 = types.PIXFMT_GRAY8;
+
+pub const ALGO_NEAREST = types.ALGO_NEAREST;
+pub const ALGO_BILINEAR = types.ALGO_BILINEAR;
+pub const ALGO_BICUBIC = types.ALGO_BICUBIC;
+
+pub const SameSizeFn = *const fn (
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+) c_int;
+
+const SwsContext = struct {
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+    same_size_fn: ?SameSizeFn,
+    is_same_copy: bool,
+};
+
+fn copy_same_format(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    w: usize,
+    h: usize,
+    fmt: c_int,
+) c_int {
+    switch (fmt) {
+        PIXFMT_GRAY8 => {
+            const s = src_data[0] orelse return -1;
+            const d = dst_data[0] orelse return -1;
+            const ss = @as(usize, @intCast(src_stride[0]));
+            const ds = @as(usize, @intCast(dst_stride[0]));
+            for (0..h) |y| {
+                @memcpy(d[y * ds .. y * ds + w], s[y * ss .. y * ss + w]);
+            }
+        },
+        PIXFMT_RGB24, PIXFMT_BGR24 => {
+            const s = src_data[0] orelse return -1;
+            const d = dst_data[0] orelse return -1;
+            const ss = @as(usize, @intCast(src_stride[0]));
+            const ds = @as(usize, @intCast(dst_stride[0]));
+            const row_bytes = w * 3;
+            for (0..h) |y| {
+                @memcpy(d[y * ds .. y * ds + row_bytes], s[y * ss .. y * ss + row_bytes]);
+            }
+        },
+        PIXFMT_RGBA, PIXFMT_BGRA => {
+            const s = src_data[0] orelse return -1;
+            const d = dst_data[0] orelse return -1;
+            const ss = @as(usize, @intCast(src_stride[0]));
+            const ds = @as(usize, @intCast(dst_stride[0]));
+            const row_bytes = w * 4;
+            for (0..h) |y| {
+                @memcpy(d[y * ds .. y * ds + row_bytes], s[y * ss .. y * ss + row_bytes]);
+            }
+        },
+        PIXFMT_NV12, PIXFMT_NV21 => {
+            const sy = src_data[0] orelse return -1;
+            const dy = dst_data[0] orelse return -1;
+            const sys = @as(usize, @intCast(src_stride[0]));
+            const dys = @as(usize, @intCast(dst_stride[0]));
+            for (0..h) |y| {
+                @memcpy(dy[y * dys .. y * dys + w], sy[y * sys .. y * sys + w]);
+            }
+            const suv = src_data[1] orelse return -1;
+            const duv = dst_data[1] orelse return -1;
+            const suvs = @as(usize, @intCast(src_stride[1]));
+            const duvs = @as(usize, @intCast(dst_stride[1]));
+            for (0..h / 2) |y| {
+                @memcpy(duv[y * duvs .. y * duvs + w], suv[y * suvs .. y * suvs + w]);
+            }
+        },
+        PIXFMT_YUV420P => {
+            const sy = src_data[0] orelse return -1;
+            const dy = dst_data[0] orelse return -1;
+            const sys = @as(usize, @intCast(src_stride[0]));
+            const dys = @as(usize, @intCast(dst_stride[0]));
+            for (0..h) |y| {
+                @memcpy(dy[y * dys .. y * dys + w], sy[y * sys .. y * sys + w]);
+            }
+            const cw = w / 2;
+            const ch = h / 2;
+            for (1..3) |p| {
+                const s = src_data[p] orelse return -1;
+                const d = dst_data[p] orelse return -1;
+                const ss = @as(usize, @intCast(src_stride[p]));
+                const ds = @as(usize, @intCast(dst_stride[p]));
+                for (0..ch) |y| {
+                    @memcpy(d[y * ds .. y * ds + cw], s[y * ss .. y * ss + cw]);
+                }
+            }
+        },
+        PIXFMT_YUV422P => {
+            const sy = src_data[0] orelse return -1;
+            const dy = dst_data[0] orelse return -1;
+            const sys = @as(usize, @intCast(src_stride[0]));
+            const dys = @as(usize, @intCast(dst_stride[0]));
+            for (0..h) |y| {
+                @memcpy(dy[y * dys .. y * dys + w], sy[y * sys .. y * sys + w]);
+            }
+            const cw = w / 2;
+            for (1..3) |p| {
+                const s = src_data[p] orelse return -1;
+                const d = dst_data[p] orelse return -1;
+                const ss = @as(usize, @intCast(src_stride[p]));
+                const ds = @as(usize, @intCast(dst_stride[p]));
+                for (0..h) |y| {
+                    @memcpy(d[y * ds .. y * ds + cw], s[y * ss .. y * ss + cw]);
+                }
+            }
+        },
+        PIXFMT_YUV444P => {
+            for (0..3) |p| {
+                const s = src_data[p] orelse return -1;
+                const d = dst_data[p] orelse return -1;
+                const ss = @as(usize, @intCast(src_stride[p]));
+                const ds = @as(usize, @intCast(dst_stride[p]));
+                for (0..h) |y| {
+                    @memcpy(d[y * ds .. y * ds + w], s[y * ss .. y * ss + w]);
+                }
+            }
+        },
+        else => return -1,
+    }
+    return 0;
+}
+
+fn get_same_size_fn(src_fmt: c_int, dst_fmt: c_int) ?SameSizeFn {
+    if (src_fmt == dst_fmt) return null;
+    return switch (src_fmt) {
+        PIXFMT_YUV420P => switch (dst_fmt) {
+            PIXFMT_RGB24 => yuv2rgb.convert_yuv420p_to_rgb24,
+            PIXFMT_BGR24 => yuv2rgb.convert_yuv420p_to_bgr24,
+            PIXFMT_RGBA => yuv2rgb.convert_yuv420p_to_rgba,
+            PIXFMT_BGRA => yuv2rgb.convert_yuv420p_to_bgra,
+            PIXFMT_GRAY8 => gray.convert_yuv420p_to_gray8,
+            PIXFMT_NV12 => nv_yuv.convert_yuv420p_to_nv12,
+            PIXFMT_YUV444P => yuv2yuv.convert_yuv420p_to_yuv444p,
+            else => null,
+        },
+        PIXFMT_YUV422P => switch (dst_fmt) {
+            PIXFMT_RGB24 => yuv2rgb.convert_yuv422p_to_rgb24,
