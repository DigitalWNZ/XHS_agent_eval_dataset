+    const d_stride = @as(usize, @intCast(dst_stride[0]));
+    const cw = w / 2;
+
+    for (0..h) |y| {
+        const y_row = s_y + y * sy_stride;
+        const d_row = d_ptr + y * d_stride;
+
+        if (y == 0 or (y % 2 == 1 and y != h - 1)) {
+            const vu_row = s_vu + (y / 2) * svu_stride;
+            for (0..cw) |cx| {
+                const v = vu_row[cx * 2 + 0];
+                const u = vu_row[cx * 2 + 1];
+                const px = cx * 2;
+                const rgb0 = lookup_rgb(y_row[px + 0], u, v);
+                const rgb1 = lookup_rgb(y_row[px + 1], u, v);
+                d_row[(px + 0) * 3 + 0] = rgb0.r;
+                d_row[(px + 0) * 3 + 1] = rgb0.g;
+                d_row[(px + 0) * 3 + 2] = rgb0.b;
+                d_row[(px + 1) * 3 + 0] = rgb1.r;
+                d_row[(px + 1) * 3 + 1] = rgb1.g;
+                d_row[(px + 1) * 3 + 2] = rgb1.b;
+            }
+        } else {
+            const vu_prev = s_vu + (y / 2 - 1) * svu_stride;
+            const vu_curr = s_vu + (y / 2) * svu_stride;
+            for (0..cw) |cx| {
+                const v = @as(u8, @intCast((@as(u16, vu_prev[cx * 2 + 0]) + @as(u16, vu_curr[cx * 2 + 0]) + 1) >> 1));
+                const u = @as(u8, @intCast((@as(u16, vu_prev[cx * 2 + 1]) + @as(u16, vu_curr[cx * 2 + 1]) + 1) >> 1));
+                const px = cx * 2;
+                const rgb0 = lookup_rgb(y_row[px + 0], u, v);
+                const rgb1 = lookup_rgb(y_row[px + 1], u, v);
+                d_row[(px + 0) * 3 + 0] = rgb0.r;
+                d_row[(px + 0) * 3 + 1] = rgb0.g;
+                d_row[(px + 0) * 3 + 2] = rgb0.b;
+                d_row[(px + 1) * 3 + 0] = rgb1.r;
+                d_row[(px + 1) * 3 + 1] = rgb1.g;
+                d_row[(px + 1) * 3 + 2] = rgb1.b;
+            }
+        }
+    }
+    return 0;
+}
