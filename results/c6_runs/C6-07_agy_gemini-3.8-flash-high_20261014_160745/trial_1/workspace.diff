+            const swapped = @shuffle(u8, v, undefined, mask);
+            @as(*[32]u8, @ptrCast(d_row + x * 4)).* = swapped;
+        }
+        while (x < w) : (x += 1) {
+            const r = s_row[x * 4 + 0];
+            const g = s_row[x * 4 + 1];
+            const b = s_row[x * 4 + 2];
+            const a = s_row[x * 4 + 3];
+            d_row[x * 4 + 0] = b;
+            d_row[x * 4 + 1] = g;
+            d_row[x * 4 + 2] = r;
+            d_row[x * 4 + 3] = a;
