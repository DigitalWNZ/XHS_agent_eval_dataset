+++ b/swscale-impl/src/types.zig
@@ -0,0 +1,71 @@
+const std = @import("std");
+
+pub const PIXFMT_YUV420P = 0;
+pub const PIXFMT_YUV422P = 1;
+pub const PIXFMT_YUV444P = 2;
+pub const PIXFMT_NV12 = 3;
+pub const PIXFMT_NV21 = 4;
+pub const PIXFMT_RGB24 = 5;
+pub const PIXFMT_BGR24 = 6;
+pub const PIXFMT_RGBA = 7;
+pub const PIXFMT_BGRA = 8;
+pub const PIXFMT_GRAY8 = 9;
+
+pub const ALGO_NEAREST = 0;
+pub const ALGO_BILINEAR = 1;
+pub const ALGO_BICUBIC = 2;
+
+pub const ProcessFn = *const fn (
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int;
+
+pub const SwsContext = struct {
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+
+    process_fn: ProcessFn,
+
+    // Filter data for scaler
+    h_lum_pos: ?[]i32 = null,
+    h_lum_filt: ?[]i16 = null,
+    h_lum_size: usize = 0,
+
+    v_lum_pos: ?[]i32 = null,
+    v_lum_filt: ?[]i16 = null,
+    v_lum_size: usize = 0,
+
+    h_chr_pos: ?[]i32 = null,
+    h_chr_filt: ?[]i16 = null,
+    h_chr_size: usize = 0,
+
+    v_chr_pos: ?[]i32 = null,
+    v_chr_filt: ?[]i16 = null,
+    v_chr_size: usize = 0,
+
+    chr_src_w: c_int = 0,
