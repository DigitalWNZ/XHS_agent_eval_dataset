diff --git a/inspect_bench.py b/inspect_bench.py
new file mode 100644
--- /dev/null
+++ b/inspect_bench.py
@@ -0,0 +1,14 @@
+import workloads, subprocess, re
+
+for wl in workloads.benchmark_workloads():
+    cmd = ["valgrind", "--tool=callgrind", "--callgrind-out-file=/tmp/cg.out", "/app/driver", "/app/libswscale_public_baseline.so",
+           str(wl["src_fmt"]), str(wl["dst_fmt"]), str(wl["src_w"]), str(wl["src_h"]), str(wl["dst_w"]), str(wl["dst_h"]), str(wl["algo"]), "1"]
+    subprocess.run(cmd, capture_output=True)
+    out = subprocess.check_output(["callgrind_annotate", "/tmp/cg.out"]).decode()
+    fns = []
+    for line in out.splitlines():
+        if "libswscale_public_baseline.so" in line:
+            m = re.search(r":(\S+)\s+\[", line)
+            if m:
+                fns.append(m.group(1))
+    print(f"{wl['key']}: {wl['label']} -> {fns[:4]}")
diff --git a/inspect_scales.py b/inspect_scales.py
new file mode 100644
--- /dev/null
+++ b/inspect_scales.py
@@ -0,0 +1,11 @@
+import workloads, ctypes
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int]*7
+
+for wl in workloads.correctness_workloads()[42:]:
+    ctx = lib.swscale_create(wl["src_w"], wl["src_h"], wl["src_fmt"], wl["dst_w"], wl["dst_h"], wl["dst_fmt"], wl["algo"])
+    inner = ctypes.cast(ctx, ctypes.POINTER(ctypes.c_void_p))[0]
+    ints = (ctypes.c_int32 * 4).from_address(inner + 3560)
+    print(f"{wl['key']}: {wl['label']} -> hL={ints[0]}, hC={ints[1]}, vL={ints[2]}, vC={ints[3]}")
