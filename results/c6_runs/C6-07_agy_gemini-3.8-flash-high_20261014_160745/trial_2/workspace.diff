+
+    const w: usize = @intCast(ctx.src_w);
+    const h: usize = @intCast(ctx.src_h);
+    const sy_stride: usize = @intCast(src_stride[0]);
+    const suv_stride: usize = @intCast(src_stride[1]);
+    const d_stride: usize = @intCast(dst_stride[0]);
+
+    var y: usize = 0;
+    while (y < h) : (y += 2) {
+        const y0_row = src_y + y * sy_stride;
+        const y1_row = src_y + (y + 1) * sy_stride;
+        const uv_row = src_uv + (y / 2) * suv_stride;
+        const d0_row = dst + y * d_stride;
+        const d1_row = dst + (y + 1) * d_stride;
+
+        var x: usize = 0;
+        while (x < w) : (x += 2) {
+            const u = uv_row[(x / 2) * 2 + 0];
+            const v = uv_row[(x / 2) * 2 + 1];
+            const rv = GLOBAL_TABLES.rV_tab[v];
+            const gu_gv = GLOBAL_TABLES.gU_tab[u] + GLOBAL_TABLES.gV_tab[v];
+            const bu = GLOBAL_TABLES.bU_tab[u];
+
+            inline for (.{ .{ y0_row, d0_row, 0 }, .{ y0_row, d0_row, 1 }, .{ y1_row, d1_row, 0 }, .{ y1_row, d1_row, 1 } }) |pair| {
+                const yr = pair[0];
+                const dr = pair[1];
+                const ox = pair[2];
+                const y_val: usize = yr[x + ox];
+                dr[(x + ox) * 4 + 0] = GLOBAL_TABLES.ytab[@intCast(500 + @as(i32, @intCast(y_val)) + bu)];
+                dr[(x + ox) * 4 + 1] = GLOBAL_TABLES.ytab[@intCast(500 + @as(i32, @intCast(y_val)) + gu_gv)];
+                dr[(x + ox) * 4 + 2] = GLOBAL_TABLES.ytab[@intCast(500 + @as(i32, @intCast(y_val)) + rv)];
+                dr[(x + ox) * 4 + 3] = 255;
+            }
+        }
+    }
+    return 0;
