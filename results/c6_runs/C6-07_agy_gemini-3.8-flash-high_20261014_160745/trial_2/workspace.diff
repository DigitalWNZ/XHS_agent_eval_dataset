+    var cy: usize = 0;
+    while (cy < ch) : (cy += 1) {
+        const du_row = dst_u + cy * du_stride;
+        const dv_row = dst_v + cy * dv_stride;
+        @memset(du_row[0..cw], 128);
+        @memset(dv_row[0..cw], 128);
+    }
+    return 0;
