+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,390 @@
+const std = @import("std");
+const types = @import("types.zig");
+const tables = @import("tables.zig");
+const unscaled_rgb = @import("unscaled_rgb.zig");
+const unscaled_yuv = @import("unscaled_yuv.zig");
+const unscaled_colorspace = @import("unscaled_colorspace.zig");
+const scaler = @import("scaler.zig");
+
+const SwsContext = types.SwsContext;
+
+fn is_packed_rgb(fmt: c_int) bool {
+    return switch (fmt) {
+        types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA => true,
+        else => false,
+    };
+}
+
+fn is_planar_yuv(fmt: c_int) bool {
+    return switch (fmt) {
+        types.PIXFMT_YUV420P, types.PIXFMT_YUV422P, types.PIXFMT_YUV444P, types.PIXFMT_GRAY8 => true,
+        else => false,
+    };
+}
+
+fn same_format_process(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const w: usize = @intCast(ctx.src_w);
+    const h: usize = @intCast(ctx.src_h);
+    switch (ctx.src_fmt) {
+        types.PIXFMT_RGB24, types.PIXFMT_BGR24 => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w * 3, h);
+        },
+        types.PIXFMT_RGBA, types.PIXFMT_BGRA => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w * 4, h);
+        },
+        types.PIXFMT_GRAY8 => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+        },
+        types.PIXFMT_NV12, types.PIXFMT_NV21 => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            unscaled_rgb.copy_plane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), w, h / 2);
+        },
+        types.PIXFMT_YUV420P => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            unscaled_rgb.copy_plane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), w / 2, h / 2);
+            unscaled_rgb.copy_plane(src_data[2].?, @intCast(src_stride[2]), dst_data[2].?, @intCast(dst_stride[2]), w / 2, h / 2);
+        },
+        types.PIXFMT_YUV422P => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            unscaled_rgb.copy_plane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), w / 2, h);
+            unscaled_rgb.copy_plane(src_data[2].?, @intCast(src_stride[2]), dst_data[2].?, @intCast(dst_stride[2]), w / 2, h);
+        },
+        types.PIXFMT_YUV444P => {
+            unscaled_rgb.copy_plane(src_data[0].?, @intCast(src_stride[0]), dst_data[0].?, @intCast(dst_stride[0]), w, h);
+            unscaled_rgb.copy_plane(src_data[1].?, @intCast(src_stride[1]), dst_data[1].?, @intCast(dst_stride[1]), w, h);
+            unscaled_rgb.copy_plane(src_data[2].?, @intCast(src_stride[2]), dst_data[2].?, @intCast(dst_stride[2]), w, h);
+        },
+        else => return -1,
+    }
+    return 0;
+}
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    const allocator = std.heap.c_allocator;
+    const ctx = allocator.create(SwsContext) catch return null;
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .allocator = allocator,
+        .process_fn = same_format_process,
+    };
+
+    // 1. Same-size conversions
+    if (src_w == dst_w and src_h == dst_h) {
+        if (src_fmt == dst_fmt) {
+            ctx.process_fn = same_format_process;
+            return @ptrCast(ctx);
+        }
+
+        // Packed RGB <-> Packed RGB
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_BGRA) {
+            ctx.process_fn = unscaled_rgb.rgb24_to_bgra_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_BGR24) {
+            ctx.process_fn = unscaled_rgb.rgb24_to_bgr24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_RGBA) {
+            ctx.process_fn = unscaled_rgb.rgb24_to_rgba_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGR24 and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_rgb.rgb24_to_bgr24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGR24 and dst_fmt == types.PIXFMT_RGBA) {
+            ctx.process_fn = unscaled_rgb.bgr24_to_rgba_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGBA and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_rgb.rgba_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGBA and dst_fmt == types.PIXFMT_BGRA) {
+            ctx.process_fn = unscaled_rgb.rgba_to_bgra_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGRA and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_rgb.bgra_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGRA and dst_fmt == types.PIXFMT_RGBA) {
+            ctx.process_fn = unscaled_rgb.rgba_to_bgra_process;
+            return @ptrCast(ctx);
+        }
+
+        // YUV420P -> Packed RGB
+        if (src_fmt == types.PIXFMT_YUV420P and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_colorspace.yuv420p_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_YUV420P and dst_fmt == types.PIXFMT_BGR24) {
+            ctx.process_fn = unscaled_colorspace.yuv420p_to_bgr24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_YUV420P and dst_fmt == types.PIXFMT_RGBA) {
+            ctx.process_fn = unscaled_colorspace.yuv420p_to_rgba_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_YUV420P and dst_fmt == types.PIXFMT_BGRA) {
+            ctx.process_fn = unscaled_colorspace.yuv420p_to_bgra_process;
+            return @ptrCast(ctx);
+        }
+
+        // YUV422P -> Packed RGB
+        if (src_fmt == types.PIXFMT_YUV422P and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_colorspace.yuv422p_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_YUV422P and dst_fmt == types.PIXFMT_RGBA) {
+            ctx.process_fn = unscaled_colorspace.yuv422p_to_rgba_process;
+            return @ptrCast(ctx);
+        }
+
+        // YUV444P -> Packed RGB
+        if (src_fmt == types.PIXFMT_YUV444P and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_colorspace.yuv444p_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_YUV444P and dst_fmt == types.PIXFMT_BGR24) {
+            ctx.process_fn = unscaled_colorspace.yuv444p_to_bgr24_process;
+            return @ptrCast(ctx);
+        }
+
+        // Packed RGB -> YUV420P / YUV422P / NV12 / NV21
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_colorspace.rgb24_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_YUV422P) {
+            ctx.process_fn = unscaled_colorspace.rgb24_to_yuv422p_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_NV12) {
+            ctx.process_fn = unscaled_colorspace.rgb24_to_nv12_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_NV21) {
+            ctx.process_fn = unscaled_colorspace.rgb24_to_nv21_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGR24 and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_colorspace.bgr24_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGR24 and dst_fmt == types.PIXFMT_NV21) {
+            ctx.process_fn = unscaled_colorspace.bgr24_to_nv21_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGBA and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_colorspace.rgba_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_BGRA and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_colorspace.bgra_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+
+        // NV12 / NV21 <-> YUV420P
+        if (src_fmt == types.PIXFMT_YUV420P and dst_fmt == types.PIXFMT_NV12) {
+            ctx.process_fn = unscaled_yuv.yuv420p_to_nv12_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_NV12 and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_yuv.nv12_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_NV21 and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_yuv.nv21_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+
+        // NV12 / NV21 -> RGB
+        if (src_fmt == types.PIXFMT_NV12 and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_colorspace.nv12_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_NV12 and dst_fmt == types.PIXFMT_BGRA) {
+            ctx.process_fn = unscaled_colorspace.nv12_to_bgra_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_NV21 and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_colorspace.nv21_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+
+        // Grayscale conversions
+        if (src_fmt == types.PIXFMT_RGB24 and dst_fmt == types.PIXFMT_GRAY8) {
+            ctx.process_fn = unscaled_colorspace.rgb24_to_gray8_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_RGBA and dst_fmt == types.PIXFMT_GRAY8) {
+            ctx.process_fn = unscaled_colorspace.rgba_to_gray8_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_YUV420P and dst_fmt == types.PIXFMT_GRAY8) {
+            ctx.process_fn = unscaled_colorspace.yuv420p_to_gray8_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_GRAY8 and dst_fmt == types.PIXFMT_RGB24) {
+            ctx.process_fn = unscaled_colorspace.gray8_to_rgb24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_GRAY8 and dst_fmt == types.PIXFMT_RGBA) {
+            ctx.process_fn = unscaled_colorspace.gray8_to_rgba_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_GRAY8 and dst_fmt == types.PIXFMT_BGR24) {
+            ctx.process_fn = unscaled_colorspace.gray8_to_bgr24_process;
+            return @ptrCast(ctx);
+        }
+        if (src_fmt == types.PIXFMT_GRAY8 and dst_fmt == types.PIXFMT_YUV420P) {
+            ctx.process_fn = unscaled_colorspace.gray8_to_yuv420p_process;
+            return @ptrCast(ctx);
+        }
+    }
+
+    // 2. Scaling Setup
+    // Initialize horizontal and vertical filters
+    const hl = tables.initFilter(allocator, src_w, dst_w, algo, false) catch {
+        allocator.destroy(ctx);
+        return null;
+    };
+    ctx.h_lum_pos = hl.pos;
+    ctx.h_lum_filt = hl.filter;
+    ctx.h_lum_size = hl.filter_size;
+
+    const vl = tables.initFilter(allocator, src_h, dst_h, algo, true) catch {
+        ctx.deinit();
+        allocator.destroy(ctx);
+        return null;
+    };
+    ctx.v_lum_pos = vl.pos;
+    ctx.v_lum_filt = vl.filter;
+    ctx.v_lum_size = vl.filter_size;
+
+    // Chroma dimensions
+    const is_src_420 = (src_fmt == types.PIXFMT_YUV420P);
+    const is_src_422 = (src_fmt == types.PIXFMT_YUV422P);
+    const is_src_444 = (src_fmt == types.PIXFMT_YUV444P);
+    const is_src_gray = (src_fmt == types.PIXFMT_GRAY8);
+
+    const is_dst_420 = (dst_fmt == types.PIXFMT_YUV420P);
+    const is_dst_422 = (dst_fmt == types.PIXFMT_YUV422P);
+    const is_dst_444 = (dst_fmt == types.PIXFMT_YUV444P);
+    const is_dst_gray = (dst_fmt == types.PIXFMT_GRAY8);
+
+    var chr_sw = src_w;
+    var chr_sh = src_h;
+    if (is_src_420) {
+        chr_sw = @divTrunc(src_w, 2);
+        chr_sh = @divTrunc(src_h, 2);
+    } else if (is_src_422) {
+        chr_sw = @divTrunc(src_w, 2);
+        chr_sh = src_h;
+    } else if (is_src_444 or is_src_gray) {
+        chr_sw = src_w;
+        chr_sh = src_h;
+    } else { // RGB
+        if (dst_w < src_w) {
+            chr_sw = @divTrunc(src_w, 2);
+        } else {
+            chr_sw = src_w;
+        }
+        chr_sh = src_h;
+    }
+
+    var chr_dw = dst_w;
+    var chr_dh = dst_h;
+    if (is_dst_420) {
+        chr_dw = @divTrunc(dst_w, 2);
+        chr_dh = @divTrunc(dst_h, 2);
+    } else if (is_dst_422) {
+        chr_dw = @divTrunc(dst_w, 2);
+        chr_dh = dst_h;
+    } else if (is_dst_444 or is_dst_gray) {
+        chr_dw = dst_w;
+        chr_dh = dst_h;
+    } else { // RGB
+        chr_dw = dst_w;
+        chr_dh = dst_h;
+    }
+
+    ctx.chr_src_w = chr_sw;
+    ctx.chr_src_h = chr_sh;
+    ctx.chr_dst_w = chr_dw;
+    ctx.chr_dst_h = chr_dh;
+
+    const hc = tables.initFilter(allocator, chr_sw, chr_dw, algo, false) catch {
+        ctx.deinit();
+        allocator.destroy(ctx);
+        return null;
+    };
+    ctx.h_chr_pos = hc.pos;
+    ctx.h_chr_filt = hc.filter;
+    ctx.h_chr_size = hc.filter_size;
+
+    const vc = tables.initFilter(allocator, chr_sh, chr_dh, algo, true) catch {
+        ctx.deinit();
+        allocator.destroy(ctx);
+        return null;
+    };
+    ctx.v_chr_pos = vc.pos;
+    ctx.v_chr_filt = vc.filter;
+    ctx.v_chr_size = vc.filter_size;
+
+    // Dispatch scaling function
+    if (is_packed_rgb(src_fmt) and is_packed_rgb(dst_fmt)) {
+        ctx.process_fn = scaler.scale_rgb_to_rgb_process;
+    } else if (is_planar_yuv(src_fmt) and is_packed_rgb(dst_fmt)) {
+        ctx.process_fn = scaler.scale_yuv_to_rgb_process;
+    } else if (is_packed_rgb(src_fmt) and is_planar_yuv(dst_fmt)) {
+        ctx.process_fn = scaler.scale_rgb_to_yuv_process;
+    } else if (is_planar_yuv(src_fmt) and is_planar_yuv(dst_fmt)) {
+        ctx.process_fn = scaler.scale_yuv_to_yuv_process;
+    } else {
+        // Fallback to same format or RGB
+        ctx.process_fn = same_format_process;
+    }
+
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+    return ctx.process_fn(ctx, src_data, src_stride, dst_data, dst_stride);
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        ctx.deinit();
+        ctx.allocator.destroy(ctx);
+    }
+}
diff --git a/swscale-impl/src/scaler.zig b/swscale-impl/src/scaler.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/scaler.zig
@@ -0,0 +1,540 @@
+const std = @import("std");
+const types = @import("types.zig");
+const tables = @import("tables.zig");
+const SwsContext = types.SwsContext;
+const GLOBAL_TABLES = tables.GLOBAL_TABLES;
+
+pub fn scale_planar_plane(
+    src: [*]const u8,
+    src_w: usize,
+    src_h: usize,
+    src_stride: usize,
+    dst: [*]u8,
+    dst_w: usize,
+    dst_h: usize,
+    dst_stride: usize,
+    h_pos: []const i32,
+    h_filt: []const i16,
+    h_size: usize,
+    v_pos: []const i32,
+    v_filt: []const i16,
+    v_size: usize,
+    allocator: std.mem.Allocator,
+) !void {
+    if (src_w == dst_w and src_h == dst_h) {
+        for (0..dst_h) |y| {
+            @memcpy(dst[y * dst_stride ..][0..dst_w], src[y * src_stride ..][0..src_w]);
+        }
+        return;
+    }
+
+    if (h_size == 1 and v_size == 1) { // Nearest neighbor fast path
+        for (0..dst_h) |y| {
+            const sy: usize = @intCast(v_pos[y]);
+            const s_row = src + sy * src_stride;
+            const d_row = dst + y * dst_stride;
+            for (0..dst_w) |x| {
+                const sx: usize = @intCast(h_pos[x]);
+                d_row[x] = s_row[sx];
+            }
+        }
+        return;
+    }
+
+    // Allocate horizontal intermediate buffer (16-bit)
+    const h_buf = try allocator.alloc(i16, src_h * dst_w);
+    defer allocator.free(h_buf);
+
+    // 1. Horizontal filter: hScale8To15
+    for (0..src_h) |y| {
+        const s_row = src + y * src_stride;
+        const h_row = h_buf[y * dst_w .. (y + 1) * dst_w];
+
+        var x: usize = 0;
+        while (x < dst_w) : (x += 1) {
+            const pos: usize = @intCast(h_pos[x]);
+            const filt = h_filt[x * h_size .. (x + 1) * h_size];
+            var val: i32 = 0;
+            for (0..h_size) |j| {
+                val += @as(i32, s_row[pos + j]) * @as(i32, filt[j]);
+            }
+            h_row[x] = @intCast(std.math.clamp(val >> 7, 0, 32767));
+        }
+    }
+
+    // 2. Vertical filter: yuv2planeX_8_c
+    for (0..dst_h) |y| {
+        const pos: usize = @intCast(v_pos[y]);
+        const filt = v_filt[y * v_size .. (y + 1) * v_size];
+        const d_row = dst + y * dst_stride;
+
+        var x: usize = 0;
+        // Vectorize across x with @Vector(16, i32)
+        while (x + 16 <= dst_w) : (x += 16) {
+            var acc: @Vector(16, i32) = @splat(1 << 18);
+            for (0..v_size) |j| {
+                const h_line = h_buf[(pos + j) * dst_w + x ..][0..16];
+                var h_vec: @Vector(16, i32) = undefined;
+                inline for (0..16) |k| {
+                    h_vec[k] = h_line[k];
+                }
+                const f_coeff: @Vector(16, i32) = @splat(filt[j]);
+                acc += h_vec * f_coeff;
+            }
+            const shifted = acc >> @splat(19);
+            for (0..16) |k| {
+                d_row[x + k] = @intCast(std.math.clamp(shifted[k], 0, 255));
+            }
+        }
+
+        while (x < dst_w) : (x += 1) {
+            var val: i32 = 1 << 18;
+            for (0..v_size) |j| {
+                val += @as(i32, h_buf[(pos + j) * dst_w + x]) * @as(i32, filt[j]);
+            }
+            d_row[x] = @intCast(std.math.clamp(val >> 19, 0, 255));
+        }
+    }
+}
+
+pub fn scale_rgb_to_rgb_process(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const src = src_data[0] orelse return -1;
+    const dst = dst_data[0] orelse return -1;
+    const sw: usize = @intCast(ctx.src_w);
+    const sh: usize = @intCast(ctx.src_h);
+    const dw: usize = @intCast(ctx.dst_w);
+    const dh: usize = @intCast(ctx.dst_h);
+
+    const s_stride: usize = @intCast(src_stride[0]);
+    const d_stride: usize = @intCast(dst_stride[0]);
+
+    const is_src_bgr = (ctx.src_fmt == types.PIXFMT_BGR24 or ctx.src_fmt == types.PIXFMT_BGRA);
+    const is_dst_bgr = (ctx.dst_fmt == types.PIXFMT_BGR24 or ctx.dst_fmt == types.PIXFMT_BGRA);
+    const src_bpp: usize = if (ctx.src_fmt == types.PIXFMT_RGBA or ctx.src_fmt == types.PIXFMT_BGRA) 4 else 3;
+    const dst_bpp: usize = if (ctx.dst_fmt == types.PIXFMT_RGBA or ctx.dst_fmt == types.PIXFMT_BGRA) 4 else 3;
+
+    // Check if nearest
+    if (ctx.algo == types.ALGO_NEAREST) {
+        const hl_pos = ctx.h_lum_pos orelse return -1;
+        const vl_pos = ctx.v_lum_pos orelse return -1;
+        for (0..dh) |y| {
+            const sy: usize = @intCast(vl_pos[y]);
+            const s_row = src + sy * s_stride;
+            const d_row = dst + y * d_stride;
+            for (0..dw) |x| {
+                const sx: usize = @intCast(hl_pos[x]);
+                const r = if (is_src_bgr) s_row[sx * src_bpp + 2] else s_row[sx * src_bpp + 0];
+                const g = s_row[sx * src_bpp + 1];
+                const b = if (is_src_bgr) s_row[sx * src_bpp + 0] else s_row[sx * src_bpp + 2];
+                const a = if (src_bpp == 4) s_row[sx * src_bpp + 3] else 255;
+
+                if (is_dst_bgr) {
+                    d_row[x * dst_bpp + 0] = b;
+                    d_row[x * dst_bpp + 1] = g;
+                    d_row[x * dst_bpp + 2] = r;
+                } else {
+                    d_row[x * dst_bpp + 0] = r;
+                    d_row[x * dst_bpp + 1] = g;
+                    d_row[x * dst_bpp + 2] = b;
+                }
+                if (dst_bpp == 4) d_row[x * dst_bpp + 3] = a;
+            }
+        }
+        return 0;
+    }
+
+    // Allocate intermediate 16-bit YUV
+    const y_16 = ctx.allocator.alloc(i16, sw * sh) catch return -1;
+    defer ctx.allocator.free(y_16);
+    const u_16 = ctx.allocator.alloc(i16, sw * sh) catch return -1;
+    defer ctx.allocator.free(u_16);
+    const v_16 = ctx.allocator.alloc(i16, sw * sh) catch return -1;
+    defer ctx.allocator.free(v_16);
+
+    for (0..sh) |y| {
+        const s_row = src + y * s_stride;
+        const y_row = y_16[y * sw .. (y + 1) * sw];
+        const u_row = u_16[y * sw .. (y + 1) * sw];
+        const v_row = v_16[y * sw .. (y + 1) * sw];
+
+        for (0..sw) |x| {
+            const r: i32 = if (is_src_bgr) s_row[x * src_bpp + 2] else s_row[x * src_bpp + 0];
+            const g: i32 = s_row[x * src_bpp + 1];
+            const b: i32 = if (is_src_bgr) s_row[x * src_bpp + 0] else s_row[x * src_bpp + 2];
+
+            y_row[x] = @intCast((8414 * r + 16519 * g + 3208 * b + 524544) >> 9);
+            u_row[x] = @intCast((-4865 * r - 9528 * g + 14392 * b + 4194560) >> 9);
+            v_row[x] = @intCast((14392 * r - 12061 * g - 2332 * b + 4194560) >> 9);
+        }
+    }
+
+    // Horizontal filter for Y, U, V
+    const h_y = ctx.allocator.alloc(i16, dw * sh) catch return -1;
+    defer ctx.allocator.free(h_y);
+    const h_u = ctx.allocator.alloc(i16, dw * sh) catch return -1;
+    defer ctx.allocator.free(h_u);
+    const h_v = ctx.allocator.alloc(i16, dw * sh) catch return -1;
+    defer ctx.allocator.free(h_v);
+
+    const hl_pos = ctx.h_lum_pos orelse return -1;
+    const hl_filt = ctx.h_lum_filt orelse return -1;
+    const hl_size = ctx.h_lum_size;
+
+    for (0..sh) |y| {
+        const y_in = y_16[y * sw .. (y + 1) * sw];
+        const u_in = u_16[y * sw .. (y + 1) * sw];
+        const v_in = v_16[y * sw .. (y + 1) * sw];
+
+        const y_out = h_y[y * dw .. (y + 1) * dw];
+        const u_out = h_u[y * dw .. (y + 1) * dw];
+        const v_out = h_v[y * dw .. (y + 1) * dw];
+
+        for (0..dw) |x| {
+            const pos: usize = @intCast(hl_pos[x]);
+            const filt = hl_filt[x * hl_size .. (x + 1) * hl_size];
+
+            var vy: i32 = 0;
+            var vu: i32 = 0;
+            var vv: i32 = 0;
+            for (0..hl_size) |j| {
+                const c: i32 = filt[j];
+                vy += @as(i32, y_in[pos + j]) * c;
+                vu += @as(i32, u_in[pos + j]) * c;
+                vv += @as(i32, v_in[pos + j]) * c;
+            }
+            y_out[x] = @intCast(std.math.clamp(vy >> 13, 0, 32767));
+            u_out[x] = @intCast(std.math.clamp(vu >> 13, 0, 32767));
+            v_out[x] = @intCast(std.math.clamp(vv >> 13, 0, 32767));
+        }
+    }
+
+    // Vertical filter + output conversion to RGB
+    const vl_pos = ctx.v_lum_pos orelse return -1;
+    const vl_filt = ctx.v_lum_filt orelse return -1;
+    const vl_size = ctx.v_lum_size;
+
+    for (0..dh) |y| {
+        const pos: usize = @intCast(vl_pos[y]);
+        const filt = vl_filt[y * vl_size .. (y + 1) * vl_size];
+        const d_row = dst + y * d_stride;
+
+        for (0..dw) |x| {
+            var vy: i32 = 1 << 18;
+            var vu: i32 = 1 << 18;
+            var vv: i32 = 1 << 18;
+            for (0..vl_size) |j| {
+                const c: i32 = filt[j];
+                vy += @as(i32, h_y[(pos + j) * dw + x]) * c;
+                vu += @as(i32, h_u[(pos + j) * dw + x]) * c;
+                vv += @as(i32, h_v[(pos + j) * dw + x]) * c;
+            }
+            const Y = vy >> 19;
+            const U = vu >> 19;
+            const V = vv >> 19;
+
+            const u_idx: usize = @intCast(std.math.clamp(U, 0, 255));
+            const v_idx: usize = @intCast(std.math.clamp(V, 0, 255));
+
+            const rv = GLOBAL_TABLES.rV_tab[v_idx];
+            const gu_gv = GLOBAL_TABLES.gU_tab[u_idx] + GLOBAL_TABLES.gV_tab[v_idx];
+            const bu = GLOBAL_TABLES.bU_tab[u_idx];
+
+            const y_clamped = std.math.clamp(Y, 0, 255);
+            const r = GLOBAL_TABLES.ytab[@intCast(std.math.clamp(500 + y_clamped + rv, 0, 1023))];
+            const g = GLOBAL_TABLES.ytab[@intCast(std.math.clamp(500 + y_clamped + gu_gv, 0, 1023))];
+            const b = GLOBAL_TABLES.ytab[@intCast(std.math.clamp(500 + y_clamped + bu, 0, 1023))];
+
+            if (is_dst_bgr) {
+                d_row[x * dst_bpp + 0] = b;
+                d_row[x * dst_bpp + 1] = g;
+                d_row[x * dst_bpp + 2] = r;
+            } else {
+                d_row[x * dst_bpp + 0] = r;
+                d_row[x * dst_bpp + 1] = g;
+                d_row[x * dst_bpp + 2] = b;
+            }
+            if (dst_bpp == 4) d_row[x * dst_bpp + 3] = 255;
+        }
+    }
+
+    return 0;
+}
+
+pub fn scale_yuv_to_rgb_process(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const src_y = src_data[0] orelse return -1;
+    const src_u = src_data[1] orelse return -1;
+    const src_v = src_data[2] orelse return -1;
+    const dst = dst_data[0] orelse return -1;
+
+    const sw: usize = @intCast(ctx.src_w);
+    const sh: usize = @intCast(ctx.src_h);
+    const dw: usize = @intCast(ctx.dst_w);
+    const dh: usize = @intCast(ctx.dst_h);
+
+    const is_src_422 = (ctx.src_fmt == types.PIXFMT_YUV422P);
+    const is_src_444 = (ctx.src_fmt == types.PIXFMT_YUV444P);
+    const chr_sw = if (is_src_444) sw else sw / 2;
+    const chr_sh = if (is_src_444 or is_src_422) sh else sh / 2;
+
+    const sy_stride: usize = @intCast(src_stride[0]);
+    const su_stride: usize = @intCast(src_stride[1]);
+    const sv_stride: usize = @intCast(src_stride[2]);
+    const d_stride: usize = @intCast(dst_stride[0]);
+
+    // Scale Y to dw x dh
+    const scaled_y = ctx.allocator.alloc(u8, dw * dh) catch return -1;
+    defer ctx.allocator.free(scaled_y);
+    scale_planar_plane(
+        src_y, sw, sh, sy_stride,
+        scaled_y.ptr, dw, dh, dw,
+        ctx.h_lum_pos.?, ctx.h_lum_filt.?, ctx.h_lum_size,
+        ctx.v_lum_pos.?, ctx.v_lum_filt.?, ctx.v_lum_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    // Scale U to dw x dh
+    const scaled_u = ctx.allocator.alloc(u8, dw * dh) catch return -1;
+    defer ctx.allocator.free(scaled_u);
+    const hc_pos = ctx.h_chr_pos orelse ctx.h_lum_pos.?;
+    const hc_filt = ctx.h_chr_filt orelse ctx.h_lum_filt.?;
+    const hc_size = if (ctx.h_chr_pos != null) ctx.h_chr_size else ctx.h_lum_size;
+    const vc_pos = ctx.v_chr_pos orelse ctx.v_lum_pos.?;
+    const vc_filt = ctx.v_chr_filt orelse ctx.v_lum_filt.?;
+    const vc_size = if (ctx.v_chr_pos != null) ctx.v_chr_size else ctx.v_lum_size;
+
+    scale_planar_plane(
+        src_u, chr_sw, chr_sh, su_stride,
+        scaled_u.ptr, dw, dh, dw,
+        hc_pos, hc_filt, hc_size,
+        vc_pos, vc_filt, vc_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    // Scale V to dw x dh
+    const scaled_v = ctx.allocator.alloc(u8, dw * dh) catch return -1;
+    defer ctx.allocator.free(scaled_v);
+    scale_planar_plane(
+        src_v, chr_sw, chr_sh, sv_stride,
+        scaled_v.ptr, dw, dh, dw,
+        hc_pos, hc_filt, hc_size,
+        vc_pos, vc_filt, vc_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    // Convert scaled Y, U, V to RGB24 / RGBA / BGR24 / BGRA
+    const is_dst_bgr = (ctx.dst_fmt == types.PIXFMT_BGR24 or ctx.dst_fmt == types.PIXFMT_BGRA);
+    const dst_bpp: usize = if (ctx.dst_fmt == types.PIXFMT_RGBA or ctx.dst_fmt == types.PIXFMT_BGRA) 4 else 3;
+
+    for (0..dh) |y| {
+        const y_row = scaled_y[y * dw .. (y + 1) * dw];
+        const u_row = scaled_u[y * dw .. (y + 1) * dw];
+        const v_row = scaled_v[y * dw .. (y + 1) * dw];
+        const d_row = dst + y * d_stride;
+
+        for (0..dw) |x| {
+            const u = u_row[x];
+            const v = v_row[x];
+            const rv = GLOBAL_TABLES.rV_tab[v];
+            const gu_gv = GLOBAL_TABLES.gU_tab[u] + GLOBAL_TABLES.gV_tab[v];
+            const bu = GLOBAL_TABLES.bU_tab[u];
+
+            const y_val: i32 = y_row[x];
+            const r = GLOBAL_TABLES.ytab[@intCast(std.math.clamp(500 + y_val + rv, 0, 1023))];
+            const g = GLOBAL_TABLES.ytab[@intCast(std.math.clamp(500 + y_val + gu_gv, 0, 1023))];
+            const b = GLOBAL_TABLES.ytab[@intCast(std.math.clamp(500 + y_val + bu, 0, 1023))];
+
+            if (is_dst_bgr) {
+                d_row[x * dst_bpp + 0] = b;
+                d_row[x * dst_bpp + 1] = g;
+                d_row[x * dst_bpp + 2] = r;
+            } else {
+                d_row[x * dst_bpp + 0] = r;
+                d_row[x * dst_bpp + 1] = g;
+                d_row[x * dst_bpp + 2] = b;
+            }
+            if (dst_bpp == 4) d_row[x * dst_bpp + 3] = 255;
+        }
+    }
+    return 0;
+}
+
+pub fn scale_rgb_to_yuv_process(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const sw: usize = @intCast(ctx.src_w);
+    const sh: usize = @intCast(ctx.src_h);
+    const dw: usize = @intCast(ctx.dst_w);
+    const dh: usize = @intCast(ctx.dst_h);
+
+    const s_stride: usize = @intCast(src_stride[0]);
+    const dy_stride: usize = @intCast(dst_stride[0]);
+    const du_stride: usize = @intCast(dst_stride[1]);
+    const dv_stride: usize = @intCast(dst_stride[2]);
+
+    // 1. Convert src RGB to planar YUV (src_w x src_h)
+    const y_plane = ctx.allocator.alloc(u8, sw * sh) catch return -1;
+    defer ctx.allocator.free(y_plane);
+    const u_plane = ctx.allocator.alloc(u8, sw * sh) catch return -1;
+    defer ctx.allocator.free(u_plane);
+    const v_plane = ctx.allocator.alloc(u8, sw * sh) catch return -1;
+    defer ctx.allocator.free(v_plane);
+
+    const src = src_data[0] orelse return -1;
+    const is_bgr = (ctx.src_fmt == types.PIXFMT_BGR24 or ctx.src_fmt == types.PIXFMT_BGRA);
+    const bpp: usize = if (ctx.src_fmt == types.PIXFMT_RGBA or ctx.src_fmt == types.PIXFMT_BGRA) 4 else 3;
+
+    for (0..sh) |y| {
+        const s_row = src + y * s_stride;
+        const y_row = y_plane[y * sw .. (y + 1) * sw];
+        const u_row = u_plane[y * sw .. (y + 1) * sw];
+        const v_row = v_plane[y * sw .. (y + 1) * sw];
+
+        for (0..sw) |x| {
+            const r: i32 = if (is_bgr) s_row[x * bpp + 2] else s_row[x * bpp + 0];
+            const g: i32 = s_row[x * bpp + 1];
+            const b: i32 = if (is_bgr) s_row[x * bpp + 0] else s_row[x * bpp + 2];
+
+            const y_val = ((8414 * r + 16519 * g + 3208 * b + 524544) >> 9);
+            y_row[x] = @intCast(std.math.clamp((y_val * 2 + 64) >> 7, 0, 255));
+            const u_val = (-4865 * r - 9528 * g + 14392 * b + 4194560) >> 9;
+            u_row[x] = @intCast(std.math.clamp((u_val * 2 + 64) >> 7, 0, 255));
+            const v_val = (14392 * r - 12061 * g - 2332 * b + 4194560) >> 9;
+            v_row[x] = @intCast(std.math.clamp((v_val * 2 + 64) >> 7, 0, 255));
+        }
+    }
+
+    // 2. Scale Y plane to dw x dh
+    const dst_y = dst_data[0] orelse return -1;
+    scale_planar_plane(
+        y_plane.ptr, sw, sh, sw,
+        dst_y, dw, dh, dy_stride,
+        ctx.h_lum_pos.?, ctx.h_lum_filt.?, ctx.h_lum_size,
+        ctx.v_lum_pos.?, ctx.v_lum_filt.?, ctx.v_lum_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    // 3. Scale U and V planes to chr_dst_w x chr_dst_h
+    const cdw: usize = @intCast(ctx.chr_dst_w);
+    const cdh: usize = @intCast(ctx.chr_dst_h);
+    const dst_u = dst_data[1] orelse return -1;
+    const dst_v = dst_data[2] orelse return -1;
+
+    const hc_pos = ctx.h_chr_pos orelse ctx.h_lum_pos.?;
+    const hc_filt = ctx.h_chr_filt orelse ctx.h_lum_filt.?;
+    const hc_size = if (ctx.h_chr_pos != null) ctx.h_chr_size else ctx.h_lum_size;
+    const vc_pos = ctx.v_chr_pos orelse ctx.v_lum_pos.?;
+    const vc_filt = ctx.v_chr_filt orelse ctx.v_lum_filt.?;
+    const vc_size = if (ctx.v_chr_pos != null) ctx.v_chr_size else ctx.v_lum_size;
+
+    scale_planar_plane(
+        u_plane.ptr, sw, sh, sw,
+        dst_u, cdw, cdh, du_stride,
+        hc_pos, hc_filt, hc_size,
+        vc_pos, vc_filt, vc_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    scale_planar_plane(
+        v_plane.ptr, sw, sh, sw,
+        dst_v, cdw, cdh, dv_stride,
+        hc_pos, hc_filt, hc_size,
+        vc_pos, vc_filt, vc_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    return 0;
+}
+
+pub fn scale_yuv_to_yuv_process(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const sw: usize = @intCast(ctx.src_w);
+    const sh: usize = @intCast(ctx.src_h);
+    const dw: usize = @intCast(ctx.dst_w);
+    const dh: usize = @intCast(ctx.dst_h);
+
+    const is_src_422 = (ctx.src_fmt == types.PIXFMT_YUV422P);
+    const is_src_444 = (ctx.src_fmt == types.PIXFMT_YUV444P);
+    const is_src_gray = (ctx.src_fmt == types.PIXFMT_GRAY8);
+
+    const is_dst_422 = (ctx.dst_fmt == types.PIXFMT_YUV422P);
+    const is_dst_444 = (ctx.dst_fmt == types.PIXFMT_YUV444P);
+    const is_dst_gray = (ctx.dst_fmt == types.PIXFMT_GRAY8);
+
+    const c_sw = if (is_src_gray or is_src_444) sw else sw / 2;
+    const c_sh = if (is_src_gray or is_src_444 or is_src_422) sh else sh / 2;
+
+    const c_dw = if (is_dst_gray or is_dst_444) dw else dw / 2;
+    const c_dh = if (is_dst_gray or is_dst_444 or is_dst_422) dh else dh / 2;
+
+    const sy = src_data[0] orelse return -1;
+    const dy = dst_data[0] orelse return -1;
+    const sy_stride: usize = @intCast(src_stride[0]);
+    const dy_stride: usize = @intCast(dst_stride[0]);
+
+    // Scale Y plane
+    scale_planar_plane(
+        sy, sw, sh, sy_stride,
+        dy, dw, dh, dy_stride,
+        ctx.h_lum_pos.?, ctx.h_lum_filt.?, ctx.h_lum_size,
+        ctx.v_lum_pos.?, ctx.v_lum_filt.?, ctx.v_lum_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    if (is_dst_gray) return 0;
+
+    // Scale U and V planes
+    const su = src_data[1] orelse return -1;
+    const sv = src_data[2] orelse return -1;
+    const du = dst_data[1] orelse return -1;
+    const dv = dst_data[2] orelse return -1;
+    const su_stride: usize = @intCast(src_stride[1]);
+    const sv_stride: usize = @intCast(src_stride[2]);
+    const du_stride: usize = @intCast(dst_stride[1]);
+    const dv_stride: usize = @intCast(dst_stride[2]);
+
+    const hc_pos = ctx.h_chr_pos orelse ctx.h_lum_pos.?;
+    const hc_filt = ctx.h_chr_filt orelse ctx.h_lum_filt.?;
+    const hc_size = if (ctx.h_chr_pos != null) ctx.h_chr_size else ctx.h_lum_size;
+    const vc_pos = ctx.v_chr_pos orelse ctx.v_lum_pos.?;
+    const vc_filt = ctx.v_chr_filt orelse ctx.v_lum_filt.?;
+    const vc_size = if (ctx.v_chr_pos != null) ctx.v_chr_size else ctx.v_lum_size;
+
+    scale_planar_plane(
+        su, c_sw, c_sh, su_stride,
+        du, c_dw, c_dh, du_stride,
+        hc_pos, hc_filt, hc_size,
+        vc_pos, vc_filt, vc_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    scale_planar_plane(
+        sv, c_sw, c_sh, sv_stride,
+        dv, c_dw, c_dh, dv_stride,
+        hc_pos, hc_filt, hc_size,
+        vc_pos, vc_filt, vc_size,
+        ctx.allocator,
+    ) catch return -1;
+
+    return 0;
+}
diff --git a/swscale-impl/src/tables.zig b/swscale-impl/src/tables.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/tables.zig
@@ -0,0 +1,262 @@
+const std = @import("std");
+
+pub const Yuv2RgbTables = struct {
+    rV_tab: [256]i32,
+    gU_tab: [256]i32,
+    gV_tab: [256]i32,
+    bU_tab: [256]i32,
+    ytab: [1024]u8,
+
+    pub fn init() Yuv2RgbTables {
+        @setEvalBranchQuota(100000);
+        var t: Yuv2RgbTables = undefined;
+        const inc_r: i32 = @divTrunc(104597 * 219, 255);
+        const inc_b: i32 = @divTrunc(132201 * 219, 255);
+        const inc_gu: i32 = @divTrunc(-25675 * 219, 255);
+        const inc_gv: i32 = @divTrunc(-53279 * 219, 255);
+
+        for (0..256) |i| {
+            const v: i32 = @intCast(i);
+            t.rV_tab[i] = (v * inc_r >> 16) - (inc_r >> 9);
+            t.bU_tab[i] = (v * inc_b >> 16) - (inc_b >> 9);
+            t.gU_tab[i] = (v * inc_gu >> 16) - (inc_gu >> 9);
+            t.gV_tab[i] = (v * inc_gv >> 16) - (inc_gv >> 9);
+        }
+
+        const cy: i32 = @divTrunc(65536 * 255, 219);
+        const oy: i32 = 16 << 16;
+        for (0..1024) |idx| {
+            const j: i32 = @as(i32, @intCast(idx)) - 500;
+            const yb: i64 = -@as(i64, 384 << 16) - oy + @as(i64, 326 + j) * cy;
+            const val = (yb + 0x8000) >> 16;
+            t.ytab[idx] = @intCast(std.math.clamp(val, 0, 255));
+        }
+        return t;
+    }
+};
+
+pub const GLOBAL_TABLES: Yuv2RgbTables = Yuv2RgbTables.init();
+
+// RGB -> YUV coefficients
+pub const RY: i32 = 8414;
+pub const GY: i32 = 16519;
+pub const BY: i32 = 3208;
+pub const RU: i32 = -4865;
+pub const GU: i32 = -9528;
+pub const BU: i32 = 14392;
+pub const RV: i32 = 14392;
+pub const GV: i32 = -12061;
+pub const BV: i32 = -2332;
+
+pub const FilterData = struct {
+    pos: []i32,
+    filter: []i16,
+    filter_size: usize,
+};
+
+pub fn initFilter(
+    allocator: std.mem.Allocator,
+    src_w: c_int,
+    dst_w: c_int,
+    algo: c_int,
+    is_vertical: bool,
+) !FilterData {
+    const one: i64 = if (is_vertical) 1 << 12 else 1 << 14;
+    const dst_w_usize: usize = @intCast(dst_w);
+
+    var filter_pos = try allocator.alloc(i32, dst_w_usize + 4);
+    errdefer allocator.free(filter_pos);
+
+    if (src_w == dst_w) {
+        const filter = try allocator.alloc(i16, dst_w_usize);
+        for (0..dst_w_usize) |i| {
+            filter_pos[i] = @intCast(i);
+            filter[i] = @intCast(one);
+        }
+        filter_pos[dst_w_usize] = filter_pos[dst_w_usize - 1];
+        filter_pos[dst_w_usize + 1] = filter_pos[dst_w_usize - 1];
+        filter_pos[dst_w_usize + 2] = filter_pos[dst_w_usize - 1];
+        return .{ .pos = filter_pos, .filter = filter, .filter_size = 1 };
+    }
+
+    const x_inc: i64 = @divTrunc(@as(i64, src_w) << 16, @as(i64, dst_w));
+
+    if (algo == 0) { // Point / Nearest
+        const filter = try allocator.alloc(i16, dst_w_usize);
+        var x_dst_in_src: i64 = 0;
+        for (0..dst_w_usize) |i| {
+            const xx: i32 = @intCast((x_dst_in_src + (1 << 15)) >> 16);
+            filter_pos[i] = xx;
+            filter[i] = @intCast(one);
+            x_dst_in_src += x_inc;
+        }
+        filter_pos[dst_w_usize] = filter_pos[dst_w_usize - 1];
+        filter_pos[dst_w_usize + 1] = filter_pos[dst_w_usize - 1];
+        filter_pos[dst_w_usize + 2] = filter_pos[dst_w_usize - 1];
+        return .{ .pos = filter_pos, .filter = filter, .filter_size = 1 };
+    }
+
+    const size_factor: i64 = if (algo == 2) 4 else 2;
+    var filter_size: i64 = if (x_inc <= 1 << 16)
+        1 + size_factor
+    else
+        1 + @divTrunc(size_factor * @as(i64, src_w) + @as(i64, dst_w) - 1, @as(i64, dst_w));
+
+    if (filter_size > @as(i64, src_w) - 2) filter_size = @as(i64, src_w) - 2;
+    if (filter_size < 1) filter_size = 1;
+
+    const ratio: u32 = @intCast(@max(@divTrunc(src_w, dst_w), 1));
+    const log2_val: u32 = if (ratio > 0) std.math.log2_int(u32, ratio) else 0;
+    const shift_val: i32 = 54 - @as(i32, @intCast(@min(log2_val, 8)));
+    const shift_bits: u6 = @intCast(shift_val);
+    const fone: i64 = @as(i64, 1) << shift_bits;
+
+    const fsize: usize = @intCast(filter_size);
+    var filter_raw = try allocator.alloc(i64, dst_w_usize * fsize);
+    defer allocator.free(filter_raw);
+
+    const dst_pos: i64 = 128;
+    const src_pos: i64 = 128;
+    var x_dst_in_src: i64 = ((dst_pos * x_inc) >> 7) - ((src_pos * 0x10000) >> 7);
+
+    for (0..dst_w_usize) |i| {
+        var xx: i32 = @intCast(@divTrunc(x_dst_in_src - (filter_size - 2) * (1 << 16), 1 << 17));
+        filter_pos[i] = xx;
+        for (0..fsize) |j| {
+            const diff: i64 = @as(i64, @intCast(@abs(@as(i64, xx) * (1 << 17) - x_dst_in_src)));
+            var d: i64 = diff << 13;
+            if (x_inc > 1 << 16) {
+                d = @divTrunc(d * @as(i64, dst_w), @as(i64, src_w));
+            }
+
+            var coeff: i64 = 0;
+            if (algo == 2) { // Bicubic
+                const B: i64 = 0;
+                const C: i64 = 10066329; // 0.6 * (1 << 24)
+                if (d < (1 << 31)) {
+                    const dd: i64 = (d * d) >> 30;
+                    const ddd: i64 = (dd * d) >> 30;
+                    if (d < (1 << 30)) {
+                        coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                            (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                            (6 * (1 << 24) - 2 * B) * (1 << 30);
+                    } else {
+                        coeff = (-B - 6 * C) * ddd +
+                            (6 * B + 30 * C) * dd +
+                            (-12 * B - 48 * C) * d +
+                            (8 * B + 24 * C) * (1 << 30);
+                    }
+                }
+                coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+            } else { // Bilinear
+                coeff = (1 << 30) - d;
+                if (coeff < 0) coeff = 0;
+                coeff = coeff * (fone >> 30);
+            }
+            filter_raw[i * fsize + j] = coeff;
+            xx += 1;
+        }
+        x_dst_in_src += 2 * x_inc;
+    }
+
+    // MinFilterSize reduction
+    const cut_off_limit: i64 = @divTrunc(fone * 2, 1000); // 0.002 * fone
+    var min_filter_size: usize = 0;
+    var i_idx: usize = dst_w_usize;
+    while (i_idx > 0) {
+        i_idx -= 1;
+        var min_sz: usize = fsize;
+        var cut_off: i64 = 0;
+        for (0..fsize) |_| {
+            cut_off += @as(i64, @intCast(@abs(filter_raw[i_idx * fsize])));
+            if (cut_off > cut_off_limit) break;
+            if (i_idx < dst_w_usize - 1 and filter_pos[i_idx] >= filter_pos[i_idx + 1]) break;
+            for (1..fsize) |k| {
+                filter_raw[i_idx * fsize + k - 1] = filter_raw[i_idx * fsize + k];
+            }
+            filter_raw[i_idx * fsize + fsize - 1] = 0;
+            filter_pos[i_idx] += 1;
+        }
+        cut_off = 0;
+        var j_rev: usize = fsize - 1;
+        while (j_rev > 0) : (j_rev -= 1) {
+            cut_off += @as(i64, @intCast(@abs(filter_raw[i_idx * fsize + j_rev])));
+            if (cut_off > cut_off_limit) break;
+            min_sz -= 1;
+        }
+        if (min_sz > min_filter_size) min_filter_size = min_sz;
+    }
+
+    const red_fsize: usize = min_filter_size;
+    var filter_red = try allocator.alloc(i64, dst_w_usize * red_fsize);
+    defer allocator.free(filter_red);
+
+    for (0..dst_w_usize) |i| {
+        for (0..red_fsize) |j| {
+            filter_red[i * red_fsize + j] = filter_raw[i * fsize + j];
+        }
+    }
+
+    // Border handling
+    for (0..dst_w_usize) |i| {
+        if (filter_pos[i] < 0) {
+            for (1..red_fsize) |j| {
+                const left = @max(filter_pos[i] + @as(i32, @intCast(j)), 0);
+                filter_red[i * red_fsize + @as(usize, @intCast(left))] += filter_red[i * red_fsize + j];
+                filter_red[i * red_fsize + j] = 0;
+            }
+            filter_pos[i] = 0;
+        }
+        if (filter_pos[i] + @as(i32, @intCast(red_fsize)) > src_w) {
+            const shift: i32 = filter_pos[i] + @min(@as(i32, @intCast(red_fsize)) - src_w, 0);
+            var acc: i64 = 0;
+            var j: usize = red_fsize;
+            while (j > 0) {
+                j -= 1;
+                if (filter_pos[i] + @as(i32, @intCast(j)) >= src_w) {
+                    acc += filter_red[i * red_fsize + j];
+                    filter_red[i * red_fsize + j] = 0;
+                }
+            }
+            j = red_fsize;
+            while (j > 0) {
+                j -= 1;
+                if (@as(i32, @intCast(j)) < shift) {
+                    filter_red[i * red_fsize + j] = 0;
+                } else {
+                    filter_red[i * red_fsize + j] = filter_red[i * red_fsize + @as(usize, @intCast(@as(i32, @intCast(j)) - shift))];
+                }
+            }
+            filter_pos[i] -= shift;
+            const target_idx: usize = @intCast(src_w - 1 - filter_pos[i]);
+            filter_red[i * red_fsize + target_idx] += acc;
+        }
+    }
+
+    // Normalization with ROUNDED_DIV
+    var filter = try allocator.alloc(i16, dst_w_usize * red_fsize);
+    for (0..dst_w_usize) |i| {
+        var sum: i64 = 0;
+        for (0..red_fsize) |j| {
+            sum += filter_red[i * red_fsize + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+
+        var err: i64 = 0;
+        for (0..red_fsize) |j| {
+            const v = filter_red[i * red_fsize + j] + err;
+            const half = sum >> 1;
+            const num = if (v >= 0) v + half else v - half;
+            const int_v: i32 = @intCast(@divTrunc(num, sum));
+            filter[i * red_fsize + j] = @intCast(int_v);
+            err = v - @as(i64, int_v) * sum;
+        }
+    }
+
+    filter_pos[dst_w_usize] = filter_pos[dst_w_usize - 1];
+    filter_pos[dst_w_usize + 1] = filter_pos[dst_w_usize - 1];
+    filter_pos[dst_w_usize + 2] = filter_pos[dst_w_usize - 1];
+
+    return .{ .pos = filter_pos, .filter = filter, .filter_size = red_fsize };
+}
