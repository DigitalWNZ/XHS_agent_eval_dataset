+import { describe, expect, test, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  isPersisterRestoreResult,
+  reconcileQueryState,
+} from '../index'
+import type { QueryState } from '../index'
+
+describe('persister restore utilities', () => {
+  test('createPersisterRestoreResult creates a valid restore result marker', () => {
+    const state: QueryState<string, Error> = {
+      data: 'cached-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'success',
+    }
+
+    const result = createPersisterRestoreResult({
+      data: 'cached-data',
+      state,
+    })
+
+    expect(result.data).toBe('cached-data')
+    expect(result.state).toBe(state)
+    expect(isPersisterRestoreResult(result)).toBe(true)
+  })
+
+  test('createPersisterRestoreResult defaults data to state.data if data is omitted', () => {
+    const state: QueryState<string, Error> = {
+      data: 'state-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'success',
+    }
+
+    const result = createPersisterRestoreResult({ state })
+
+    expect(result.data).toBe('state-data')
+    expect(isPersisterRestoreResult(result)).toBe(true)
+  })
+
+  test('reconcileQueryState merges live newer data with persisted newer error metadata', () => {
+    const liveState: QueryState<string, Error> = {
+      data: 'live-newer-data',
+      dataUpdateCount: 2,
+      dataUpdatedAt: 2000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'success',
+    }
+
+    const persistedError = new Error('persisted-newer-error')
+    const persistedState: QueryState<string, Error> = {
+      data: 'persisted-older-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: persistedError,
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2500,
+      fetchFailureCount: 3,
+      fetchFailureReason: persistedError,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'error',
+    }
+
+    const reconciled = reconcileQueryState(liveState, persistedState)
+
+    expect(reconciled.data).toBe('live-newer-data')
+    expect(reconciled.dataUpdatedAt).toBe(2000)
+    expect(reconciled.error).toBe(persistedError)
+    expect(reconciled.errorUpdatedAt).toBe(2500)
+    expect(reconciled.fetchFailureCount).toBe(3)
+    expect(reconciled.status).toBe('error')
+    expect(reconciled.fetchStatus).toBe('idle')
+  })
+
+  test('reconcileQueryState merges persisted newer data with live newer error metadata (inverse rule)', () => {
+    const liveError = new Error('live-newer-error')
+    const liveState: QueryState<string, Error> = {
+      data: 'live-older-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: liveError,
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2500,
+      fetchFailureCount: 2,
+      fetchFailureReason: liveError,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'error',
+    }
+
+    const persistedState: QueryState<string, Error> = {
+      data: 'persisted-newer-data',
+      dataUpdateCount: 2,
+      dataUpdatedAt: 3000,
+      error: new Error('persisted-older-error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 1500,
+      fetchFailureCount: 1,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: false,
+      status: 'success',
+    }
+
+    const reconciled = reconcileQueryState(liveState, persistedState)
+
+    expect(reconciled.data).toBe('persisted-newer-data')
+    expect(reconciled.dataUpdatedAt).toBe(3000)
+    expect(reconciled.error).toBe(liveError)
+    expect(reconciled.errorUpdatedAt).toBe(2500)
+    expect(reconciled.fetchFailureCount).toBe(2)
+    expect(reconciled.status).toBe('error')
+    expect(reconciled.fetchStatus).toBe('idle')
+  })
+
+  test('query execution adopts restored state without triggering fetch success callbacks', async () => {
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+
+    const queryClient = new QueryClient({
+      queryCache: new QueryCache({
+        onSuccess,
+        onSettled,
+      }),
+    })
+
+    const restoredError = new Error('refetch-failed')
+    const restoredState: QueryState<string, Error> = {
+      data: 'persisted-data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: restoredError,
+      errorUpdateCount: 1,
+      errorUpdatedAt: 1500,
+      fetchFailureCount: 4,
+      fetchFailureReason: restoredError,
+      fetchMeta: null,
+      fetchStatus: 'idle',
+      isInvalidated: true,
+      status: 'error',
+    }
+
+    const persister = vi.fn().mockResolvedValue(
+      createPersisterRestoreResult({
+        data: 'persisted-data',
+        state: restoredState,
+      }),
+    )
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: ['test-restore'],
+      queryFn: () => Promise.resolve('fresh-data'),
+      persister,
+    })
+
+    await observer.refetch()
+
+    const result = observer.getCurrentResult()
+
+    expect(persister).toHaveBeenCalledTimes(1)
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+
+    expect(result.data).toBe('persisted-data')
+    expect(result.error).toBe(restoredError)
+    expect(result.status).toBe('error')
+    expect(result.fetchStatus).toBe('idle')
+    expect(result.isRefetchError).toBe(true)
+    expect(result.failureCount).toBe(4)
+    expect(result.dataUpdatedAt).toBe(1000)
+    expect(result.errorUpdatedAt).toBe(1500)
+    expect(result.isStale).toBe(true)
+  })
+})
