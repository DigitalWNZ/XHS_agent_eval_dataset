--- /dev/null
+++ b/packages/query-core/src/__tests__/persisterRestore.test.tsx
@@ -0,0 +1,305 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  hydrate,
+  isPersisterRestoreResult,
+} from '..'
+import { queryKey } from '@tanstack/query-test-utils'
+
+describe('createPersisterRestoreResult & query restoration', () => {
+  it('should create a valid persister restore result marker', () => {
+    const result = createPersisterRestoreResult({
+      data: 'test-data',
+      state: {
+        dataUpdatedAt: 1000,
+        status: 'success',
+      },
+    })
+
+    expect(isPersisterRestoreResult(result)).toBe(true)
+    expect(result.data).toBe('test-data')
+    expect(result.state?.dataUpdatedAt).toBe(1000)
+  })
+
+  it('should adopt restored state without triggering success callbacks or altering idle status', async () => {
+    const onSuccessSpy = vi.fn()
+    const onSettledSpy = vi.fn()
+    const queryCache = new QueryCache({
+      onSuccess: onSuccessSpy,
+      onSettled: onSettledSpy,
+    })
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+
+    const error = new Error('persisted-error')
+    const restoredState = {
+      data: 'restored-data',
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 1,
+      error,
+      errorUpdatedAt: 1050,
+      errorUpdateCount: 1,
+      fetchFailureCount: 2,
+      fetchFailureReason: error,
+      isInvalidated: true,
+      status: 'error' as const,
+    }
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => 'fetched-data',
+      persister: () =>
+        Promise.resolve(
+          createPersisterRestoreResult({
+            data: 'restored-data',
+            state: restoredState,
+          }),
+        ),
+    })
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query).toBeDefined()
+    expect(query.state.data).toBe('restored-data')
+    expect(query.state.error).toBe(error)
+    expect(query.state.dataUpdatedAt).toBe(1000)
+    expect(query.state.errorUpdatedAt).toBe(1050)
+    expect(query.state.fetchFailureCount).toBe(2)
+    expect(query.state.isInvalidated).toBe(true)
+    expect(query.state.status).toBe('error')
+    expect(query.state.fetchStatus).toBe('idle')
+
+    // Callbacks must NOT be triggered on restore
+    expect(onSuccessSpy).not.toHaveBeenCalled()
+    expect(onSettledSpy).not.toHaveBeenCalled()
+
+    // Observer should reflect refetch error state
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      staleTime: Infinity,
+    })
+    const result = observer.getCurrentResult()
+
+    expect(result.data).toBe('restored-data')
+    expect(result.error).toBe(error)
+    expect(result.status).toBe('error')
+    expect(result.isRefetchError).toBe(true)
+    expect(result.failureCount).toBe(2)
+    expect(result.dataUpdatedAt).toBe(1000)
+    expect(result.errorUpdatedAt).toBe(1050)
+  })
+
+  it('should preserve infinite query pagination state during restoration', async () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+
+    const infiniteData = {
+      pages: ['page 1', 'page 2'],
+      pageParams: [undefined as string | undefined, 'cursor-2'],
+    }
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: (): typeof infiniteData => ({ pages: [], pageParams: [] }),
+      persister: () =>
+        Promise.resolve(
+          createPersisterRestoreResult({
+            data: infiniteData,
+            state: {
+              data: infiniteData,
+              dataUpdatedAt: 2000,
+              status: 'success',
+            },
+          }),
+        ),
+    })
+
+    const query = queryCache.find({ queryKey: key })!
+    const data = query.state.data as typeof infiniteData
+    expect(data).toEqual(infiniteData)
+    expect(data.pages).toEqual(['page 1', 'page 2'])
+    expect(data.pageParams).toEqual([undefined, 'cursor-2'])
+  })
+
+  it('should preserve failure count and timestamp metadata during bulk restoration and observer mount', () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key1 = queryKey()
+    const key2 = queryKey()
+
+    const error1 = new Error('err1')
+    const error2 = new Error('err2')
+
+    hydrate(queryClient, {
+      queries: [
+        {
+          queryKey: key1,
+          queryHash: JSON.stringify(key1),
+          state: {
+            data: 'bulk-data-1',
+            dataUpdatedAt: 1000,
+            dataUpdateCount: 1,
+            error: error1,
+            errorUpdatedAt: 1100,
+            errorUpdateCount: 1,
+            fetchFailureCount: 3,
+            fetchFailureReason: error1,
+            fetchMeta: null,
+            fetchStatus: 'idle' as const,
+            isInvalidated: false,
+            status: 'error' as const,
+          },
+        },
+        {
+          queryKey: key2,
+          queryHash: JSON.stringify(key2),
+          state: {
+            data: 'bulk-data-2',
+            dataUpdatedAt: 2000,
+            dataUpdateCount: 2,
+            error: error2,
+            errorUpdatedAt: 2100,
+            errorUpdateCount: 2,
+            fetchFailureCount: 5,
+            fetchFailureReason: error2,
+            fetchMeta: null,
+            fetchStatus: 'idle' as const,
+            isInvalidated: false,
+            status: 'error' as const,
+          },
+        },
+      ],
+    })
+
+    const observer1 = new QueryObserver(queryClient, { queryKey: key1, staleTime: Infinity })
+    const res1 = observer1.getCurrentResult()
+    expect(res1.data).toBe('bulk-data-1')
+    expect(res1.error).toBe(error1)
+    expect(res1.failureCount).toBe(3)
+    expect(res1.dataUpdatedAt).toBe(1000)
+    expect(res1.errorUpdatedAt).toBe(1100)
+    expect(res1.isRefetchError).toBe(true)
+
+    const observer2 = new QueryObserver(queryClient, { queryKey: key2, staleTime: Infinity })
+    const res2 = observer2.getCurrentResult()
+    expect(res2.data).toBe('bulk-data-2')
+    expect(res2.error).toBe(error2)
+    expect(res2.failureCount).toBe(5)
+    expect(res2.dataUpdatedAt).toBe(2000)
+    expect(res2.errorUpdatedAt).toBe(2100)
+    expect(res2.isRefetchError).toBe(true)
+  })
+
+  it('should reconcile live cache and persisted snapshot independently for data and error freshness', () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+
+    // 1. Existing live cache has newer data (updatedAt = 3000), no error (updatedAt = 0)
+    queryClient.setQueryData(key, 'newer-live-data', { updatedAt: 3000 })
+
+    const persistedError = new Error('persisted-newer-error')
+
+    // 2. Persisted snapshot has older data (updatedAt = 1000) but newer error metadata (updatedAt = 2000)
+    hydrate(queryClient, {
+      queries: [
+        {
+          queryKey: key,
+          queryHash: JSON.stringify(key),
+          state: {
+            data: 'older-persisted-data',
+            dataUpdatedAt: 1000,
+            dataUpdateCount: 1,
+            error: persistedError,
+            errorUpdatedAt: 2000,
+            errorUpdateCount: 1,
+            fetchFailureCount: 2,
+            fetchFailureReason: persistedError,
+            fetchMeta: null,
+            fetchStatus: 'idle' as const,
+            isInvalidated: false,
+            status: 'error' as const,
+          },
+        },
+      ],
+    })
+
+    const query = queryCache.find({ queryKey: key })!
+    expect(query.state.data).toBe('newer-live-data') // Kept newer live data
+    expect(query.state.dataUpdatedAt).toBe(3000)
+    expect(query.state.error).toBe(persistedError) // Adopted newer error
+    expect(query.state.errorUpdatedAt).toBe(2000)
+    expect(query.state.status).toBe('error')
+
+    const observer = new QueryObserver(queryClient, { queryKey: key, staleTime: Infinity })
+    const res = observer.getCurrentResult()
+    expect(res.data).toBe('newer-live-data')
+    expect(res.error).toBe(persistedError)
+    expect(res.isRefetchError).toBe(true)
+  })
+
+  it('should reconcile inverse rule: keep newer persisted data and newer live cache error', () => {
+    const queryCache = new QueryCache()
+    const queryClient = new QueryClient({ queryCache })
+    const key = queryKey()
+
+    // Setup live cache with older data (updatedAt = 1000) and newer error (updatedAt = 3000)
+    const liveError = new Error('live-newer-error')
+    const query = queryCache.build(queryClient, {
+      queryKey: key,
+      queryHash: JSON.stringify(key),
+    })
+    query.setState({
+      data: 'older-live-data',
+      dataUpdatedAt: 1000,
+      dataUpdateCount: 1,
+      error: liveError,
+      errorUpdatedAt: 3000,
+      errorUpdateCount: 1,
+      fetchFailureCount: 1,
+      fetchFailureReason: liveError,
+      fetchStatus: 'idle',
+      status: 'error',
+    })
+
+    // Hydrate snapshot with newer data (updatedAt = 2000) and older error (updatedAt = 500)
+    const persistedError = new Error('older-persisted-error')
+    hydrate(queryClient, {
+      queries: [
+        {
+          queryKey: key,
+          queryHash: JSON.stringify(key),
+          state: {
+            data: 'newer-persisted-data',
+            dataUpdatedAt: 2000,
+            dataUpdateCount: 2,
+            error: persistedError,
+            errorUpdatedAt: 500,
+            errorUpdateCount: 1,
+            fetchFailureCount: 1,
+            fetchFailureReason: persistedError,
+            fetchMeta: null,
+            fetchStatus: 'idle' as const,
+            isInvalidated: false,
+            status: 'error' as const,
+          },
+        },
+      ],
+    })
+
+    expect(query.state.data).toBe('newer-persisted-data') // Adopted newer persisted data
+    expect(query.state.dataUpdatedAt).toBe(2000)
+    expect(query.state.error).toBe(liveError) // Kept newer live error
+    expect(query.state.errorUpdatedAt).toBe(3000)
+    expect(query.state.status).toBe('error')
+
+    const observer = new QueryObserver(queryClient, { queryKey: key, staleTime: Infinity })
+    const res = observer.getCurrentResult()
+    expect(res.data).toBe('newer-persisted-data')
+    expect(res.error).toBe(liveError)
+    expect(res.isRefetchError).toBe(true)
+  })
+})
