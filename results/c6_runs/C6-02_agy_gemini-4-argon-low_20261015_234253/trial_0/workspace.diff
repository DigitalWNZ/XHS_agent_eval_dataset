diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..a26a5f5a
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,531 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxDurableJobRetention is the maximum number of recent durable job outcomes
+	// retained for WaitForJobDurability queries.
+	maxDurableJobRetention = 4096
+
+	// maxDurabilityNotifySubs is the maximum number of concurrently active
+	// DurabilityNotify channel subscriptions.
+	maxDurabilityNotifySubs = 1024
+)
+
+// DurabilityStats holds a point-in-time snapshot of commit durability metrics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durableJobEntry struct {
+	jobID  int
+	seqNum base.SeqNum
+	err    error
+	done   bool
+	doneCh chan struct{}
+}
+
+type seqWaiter struct {
+	seqNum base.SeqNum
+	ch     chan error
+	isSub  bool
+}
+
+type durabilityTracker struct {
+	disableWAL   bool
+	batchDurable bool // true if EventListener.BatchDurable was user-configured
+
+	nextJobID      atomic.Int64
+	pendingWaiters atomic.Int64
+
+	mu struct {
+		sync.Mutex
+
+		highestDurableSeqNum   base.SeqNum
+		hasAnyDurableCommit    bool
+		firstErr               error
+		closedErr              error
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		// Tracked jobs.
+		minRetainedJobID int
+		maxAssignedJobID int
+		jobs             map[int]*durableJobEntry
+		completedJobIDs  []int // ring/queue of completed job IDs for bounded retention
+
+		// Waiters waiting on sequence numbers (or 0 for any commit).
+		waiters   map[*seqWaiter]struct{}
+		activeSub int
+	}
+}
+
+func (t *durabilityTracker) init(disableWAL bool, batchDurableConfigured bool) {
+	t.disableWAL = disableWAL
+	t.batchDurable = batchDurableConfigured
+	t.mu.jobs = make(map[int]*durableJobEntry)
+	t.mu.waiters = make(map[*seqWaiter]struct{})
+}
+
+func (t *durabilityTracker) assignJobID(seqNum base.SeqNum) int {
+	jobID := int(t.nextJobID.Add(1))
+	t.mu.Lock()
+	if t.mu.minRetainedJobID == 0 {
+		t.mu.minRetainedJobID = jobID
+	}
+	if jobID > t.mu.maxAssignedJobID {
+		t.mu.maxAssignedJobID = jobID
+	}
+	t.mu.jobs[jobID] = &durableJobEntry{
+		jobID:  jobID,
+		seqNum: seqNum,
+		doneCh: make(chan struct{}),
+	}
+	t.mu.Unlock()
+	return jobID
+}
+
+func (t *durabilityTracker) recordCommitOutcome(
+	jobID int, endSeqNum base.SeqNum, syncDuration time.Duration, err error,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err != nil {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+	} else {
+		t.mu.totalDurableCommits++
+		t.mu.hasAnyDurableCommit = true
+		if endSeqNum > t.mu.highestDurableSeqNum {
+			t.mu.highestDurableSeqNum = endSeqNum
+		}
+		t.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.mu.maxSyncDuration {
+			t.mu.maxSyncDuration = syncDuration
+		}
+	}
+
+	if jobID > 0 {
+		entry, ok := t.mu.jobs[jobID]
+		if !ok {
+			entry = &durableJobEntry{
+				jobID:  jobID,
+				seqNum: endSeqNum,
+				doneCh: make(chan struct{}),
+			}
+			t.mu.jobs[jobID] = entry
+			if t.mu.minRetainedJobID == 0 || jobID < t.mu.minRetainedJobID {
+				t.mu.minRetainedJobID = jobID
+			}
+			if jobID > t.mu.maxAssignedJobID {
+				t.mu.maxAssignedJobID = jobID
+			}
+		}
+		if !entry.done {
+			entry.seqNum = endSeqNum
+			entry.err = err
+			entry.done = true
+			close(entry.doneCh)
+			t.mu.completedJobIDs = append(t.mu.completedJobIDs, jobID)
+			for len(t.mu.completedJobIDs) > maxDurableJobRetention {
+				evictID := t.mu.completedJobIDs[0]
+				t.mu.completedJobIDs = t.mu.completedJobIDs[1:]
+				delete(t.mu.jobs, evictID)
+				if evictID >= t.mu.minRetainedJobID {
+					t.mu.minRetainedJobID = evictID + 1
+				}
+			}
+		}
+	}
+
+	t.notifyWaitersLocked()
+}
+
+func (t *durabilityTracker) recordNonSyncCommit() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.mu.hasAnyDurableCommit {
+		t.mu.hasAnyDurableCommit = true
+		t.notifyWaitersLocked()
+	}
+}
+
+func (t *durabilityTracker) close(err error) {
+	if err == nil {
+		err = ErrClosed
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closedErr == nil {
+		t.mu.closedErr = err
+	}
+	// Unblock any in-flight job entries that haven't finished yet.
+	for _, entry := range t.mu.jobs {
+		if !entry.done {
+			entry.err = t.mu.closedErr
+			entry.done = true
+			close(entry.doneCh)
+		}
+	}
+	t.notifyWaitersLocked()
+}
+
+func (t *durabilityTracker) notifyWaitersLocked() {
+	terminalErr := t.mu.firstErr
+	if terminalErr == nil {
+		terminalErr = t.mu.closedErr
+	}
+	for w := range t.mu.waiters {
+		if terminalErr != nil {
+			w.ch <- terminalErr
+			close(w.ch)
+			if w.isSub {
+				t.mu.activeSub--
+			}
+			delete(t.mu.waiters, w)
+			continue
+		}
+		satisfied := false
+		if w.seqNum == 0 {
+			satisfied = t.mu.hasAnyDurableCommit || t.mu.highestDurableSeqNum > 0
+		} else {
+			satisfied = t.mu.highestDurableSeqNum >= w.seqNum
+		}
+		if satisfied {
+			w.ch <- nil
+			close(w.ch)
+			if w.isSub {
+				t.mu.activeSub--
+			}
+			delete(t.mu.waiters, w)
+		}
+	}
+}
+
+func (t *durabilityTracker) checkSeqImmediateLocked(seqNum base.SeqNum) (done bool, err error) {
+	if t.mu.firstErr != nil {
+		return true, t.mu.firstErr
+	}
+	if t.mu.closedErr != nil {
+		return true, t.mu.closedErr
+	}
+	if seqNum == 0 {
+		if t.mu.hasAnyDurableCommit || t.mu.highestDurableSeqNum > 0 {
+			return true, nil
+		}
+		return false, nil
+	}
+	if t.mu.highestDurableSeqNum >= seqNum {
+		return true, nil
+	}
+	return false, nil
+}
+
+func (t *durabilityTracker) waitForSeq(ctx context.Context, seqNum base.SeqNum) error {
+	if t.disableWAL {
+		return nil
+	}
+
+	t.mu.Lock()
+	if done, err := t.checkSeqImmediateLocked(seqNum); done {
+		t.mu.Unlock()
+		return err
+	}
+	if ctx != nil {
+		if err := ctx.Err(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     make(chan error, 1),
+	}
+	t.mu.waiters[w] = struct{}{}
+	t.pendingWaiters.Add(1)
+	t.mu.Unlock()
+
+	defer t.pendingWaiters.Add(-1)
+
+	if ctx == nil {
+		return <-w.ch
+	}
+
+	select {
+	case err := <-w.ch:
+		return err
+	case <-ctx.Done():
+		t.mu.Lock()
+		// Re-check terminal durability/close error or satisfaction before returning context error,
+		// because durability/close errors take precedence over context cancellation.
+		if _, stillWaiting := t.mu.waiters[w]; stillWaiting {
+			delete(t.mu.waiters, w)
+			if done, err := t.checkSeqImmediateLocked(seqNum); done && err != nil {
+				t.mu.Unlock()
+				return err
+			}
+			t.mu.Unlock()
+			return ctx.Err()
+		}
+		t.mu.Unlock()
+		err := <-w.ch
+		if err != nil {
+			return err
+		}
+		return nil
+	}
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	if t.disableWAL {
+		return nil
+	}
+
+	t.mu.Lock()
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closedErr != nil {
+		err := t.mu.closedErr
+		t.mu.Unlock()
+		return err
+	}
+
+	if jobID <= 0 || jobID > t.mu.maxAssignedJobID {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: unknown durability job ID %d", errors.Safe(jobID))
+	}
+	if t.mu.minRetainedJobID > 0 && jobID < t.mu.minRetainedJobID {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: durability job ID %d has expired", errors.Safe(jobID))
+	}
+	entry, ok := t.mu.jobs[jobID]
+	if !ok {
+		t.mu.Unlock()
+		if t.mu.minRetainedJobID > 0 && jobID < t.mu.maxAssignedJobID {
+			return errors.Errorf("pebble: durability job ID %d has expired", errors.Safe(jobID))
+		}
+		return errors.Errorf("pebble: unknown durability job ID %d", errors.Safe(jobID))
+	}
+	if entry.done {
+		err := entry.err
+		if err == nil && t.mu.firstErr != nil {
+			err = t.mu.firstErr
+		}
+		if err == nil && t.mu.closedErr != nil {
+			err = t.mu.closedErr
+		}
+		t.mu.Unlock()
+		return err
+	}
+
+	if ctx != nil {
+		if err := ctx.Err(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+	}
+
+	doneCh := entry.doneCh
+	t.pendingWaiters.Add(1)
+	t.mu.Unlock()
+
+	defer t.pendingWaiters.Add(-1)
+
+	if ctx == nil {
+		<-doneCh
+	} else {
+		select {
+		case <-doneCh:
+		case <-ctx.Done():
+			t.mu.Lock()
+			if t.mu.firstErr != nil {
+				err := t.mu.firstErr
+				t.mu.Unlock()
+				return err
+			}
+			if t.mu.closedErr != nil {
+				err := t.mu.closedErr
+				t.mu.Unlock()
+				return err
+			}
+			if entry.done && entry.err != nil {
+				err := entry.err
+				t.mu.Unlock()
+				return err
+			}
+			t.mu.Unlock()
+			return ctx.Err()
+		}
+	}
+
+	t.mu.Lock()
+	err := entry.err
+	if err == nil && t.mu.firstErr != nil {
+		err = t.mu.firstErr
+	}
+	if err == nil && t.mu.closedErr != nil {
+		err = t.mu.closedErr
+	}
+	t.mu.Unlock()
+	return err
+}
+
+func (t *durabilityTracker) notifyChan(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if t.disableWAL {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if done, err := t.checkSeqImmediateLocked(seqNum); done {
+		ch <- err
+		close(ch)
+		return ch
+	}
+
+	if t.mu.activeSub >= maxDurabilityNotifySubs {
+		ch <- errors.New("pebble: maximum outstanding DurabilityNotify subscriptions exceeded")
+		close(ch)
+		return ch
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     ch,
+		isSub:  true,
+	}
+	t.mu.activeSub++
+	t.mu.waiters[w] = struct{}{}
+	return ch
+}
+
+func (t *durabilityTracker) durableState() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeqNum, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeqNum,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.pendingWaiters.Load(),
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk. A sequence number of zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(nil, seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk or the context is cancelled. Durability and DB close errors
+// take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.waitForSeq(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(nil, seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk or the context is cancelled. A nil or empty slice returns
+// nil immediately. Durability and DB close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	if d.durability.disableWAL {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	hasZero := false
+	for _, s := range seqNums {
+		if s == 0 {
+			hasZero = true
+		} else if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	if maxSeq > 0 {
+		return d.durability.waitForSeq(ctx, maxSeq)
+	}
+	if hasZero {
+		return d.durability.waitForSeq(ctx, 0)
+	}
+	return nil
+}
+
+// WaitForJobDurability blocks until the Sync commit identified by jobID is
+// durable on disk.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(nil, jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the Sync commit identified by jobID
+// is durable on disk or the context is cancelled. Durability and DB close
+// errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched WAL sync error, if any.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a receive-only channel (buffered with capacity 1)
+// that delivers nil once seqNum is durable, or a non-nil error if WAL sync
+// fails, the DB closes, or the subscription limit is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.notifyChan(seqNum)
+}
+
+// DurabilityStats returns a point-in-time snapshot of durability tracking
+// statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
