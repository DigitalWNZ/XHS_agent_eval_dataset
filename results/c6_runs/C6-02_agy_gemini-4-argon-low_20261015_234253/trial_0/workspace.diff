+func TestBatchDurableBasicAndMetrics(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Initial DurabilityStats and Metrics must be zero.
+	stats := d.DurabilityStats()
+	require.Equal(t, DurabilityStats{}, stats)
+	seq, firstErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, firstErr)
+	m := d.Metrics()
+	require.Equal(t, uint64(0), m.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m.DurableCommitDuration)
+
+	// Non-sync commit must NOT fire BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync"), []byte("val"), NoSync))
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Sync commit with single key and CorrelationID.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	expectedSize1 := b1.Len()
+	require.NoError(t, d.Apply(b1, &WriteOptions{Sync: true, CommitCorrelationID: 42}))
+	b1Seq := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev1 := events[0]
+	mu.Unlock()
+
+	require.Greater(t, ev1.JobID, 0)
+	require.Equal(t, b1Seq, ev1.SeqNum)
+	require.NoError(t, ev1.Err)
+	require.Greater(t, ev1.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev1.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev1.CorrelationID)
+	require.Equal(t, expectedSize1, ev1.BatchSize)
+	require.Equal(t, uint32(1), ev1.KeyCount)
+
+	// Multi-key Sync commit.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b2.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, b2.Delete([]byte("k1"), nil))
+	expectedSize2 := b2.Len()
+	require.NoError(t, d.Apply(b2, &WriteOptions{Sync: true, CommitCorrelationID: 99}))
+	b2EndSeq := b2.SeqNum() + base.SeqNum(b2.Count()) - 1
+	require.NoError(t, b2.Close())
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Greater(t, ev2.JobID, ev1.JobID)
+	require.Equal(t, b2EndSeq, ev2.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(99), ev2.CorrelationID)
+	require.Equal(t, expectedSize2, ev2.BatchSize)
+	require.Equal(t, uint32(3), ev2.KeyCount)
+
+	// Check DurabilityStats and Metrics.
+	stats = d.DurabilityStats()
+	require.Equal(t, b2EndSeq, stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(2), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, ev1.SyncDuration+ev2.SyncDuration, stats.CumulativeSyncDuration)
+	require.Equal(t, max(ev1.SyncDuration, ev2.SyncDuration), stats.MaxSyncDuration)
+
+	m = d.Metrics()
+	require.Equal(t, uint64(2), m.DurableCommitCount)
+	require.Equal(t, stats.CumulativeSyncDuration, m.DurableCommitDuration)
+
+	// ApplyNoSyncWait + SyncWait.
+	b3 := d.NewBatch()
+	require.NoError(t, b3.Set([]byte("k4"), []byte("v4"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b3, &WriteOptions{Sync: true, CommitCorrelationID: 777}))
+	require.NoError(t, b3.SyncWait())
+	b3Seq := b3.SeqNum()
+	require.NoError(t, b3.Close())
+
+	mu.Lock()
+	require.Len(t, events, 3)
+	ev3 := events[2]
+	mu.Unlock()
+	require.Equal(t, b3Seq, ev3.SeqNum)
+	require.Equal(t, uint64(777), ev3.CorrelationID)
+	require.Greater(t, ev3.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev3.SyncDuration, time.Duration(0))
+}
