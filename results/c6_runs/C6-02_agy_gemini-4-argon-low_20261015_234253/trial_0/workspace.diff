+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	bfs := &blockingSyncFS{
+		FS:        vfs.NewMem(),
+		syncCh:    make(chan struct{}),
+		enteredCh: make(chan struct{}),
+	}
+	d, err := Open("", &Options{
+		FS:     bfs,
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// WaitForDurabilityBatch with nil or empty slice returns nil immediately.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commit, then succeeds after any commit.
+	waitZeroDone := make(chan error, 1)
+	go func() {
+		waitZeroDone <- d.WaitForDurability(0)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, time.Second, time.Millisecond)
+
+	// A non-sync commit satisfies WaitForDurability(0).
+	require.NoError(t, d.Set([]byte("k0"), []byte("v0"), NoSync))
+	require.NoError(t, <-waitZeroDone)
+	require.NoError(t, d.WaitForDurability(0))
+
+	// Now block WAL sync and test blocking WaitForDurability / WaitForDurabilityBatch / DurabilityNotify.
+	bfs.blockSync.Store(true)
+
+	commitDone := make(chan error, 1)
+	go func() {
+		b := d.NewBatch()
+		_ = b.Set([]byte("k1"), []byte("v1"), nil)
+		_ = b.Set([]byte("k2"), []byte("v2"), nil)
+		err := d.Apply(b, Sync)
+		_ = b.Close()
+		commitDone <- err
+	}()
+
+	<-bfs.enteredCh
+
+	// SeqNums for k1, k2 should be 11, 12 (sinceSeqNumStart=10, k0=10).
+	targetSeq := base.SeqNum(12)
+	notifyCh := d.DurabilityNotify(targetSeq)
+
+	waitSeqDone := make(chan error, 1)
+	go func() {
+		waitSeqDone <- d.WaitForDurability(targetSeq)
+	}()
+
+	waitBatchDone := make(chan error, 1)
+	go func() {
+		waitBatchDone <- d.WaitForDurabilityBatch([]base.SeqNum{11, targetSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, time.Second, time.Millisecond)
+
+	// Unblock WAL sync.
+	bfs.blockSync.Store(false)
+	close(bfs.syncCh)
+
+	require.NoError(t, <-commitDone)
+	require.NoError(t, <-waitSeqDone)
+	require.NoError(t, <-waitBatchDone)
+	require.NoError(t, <-notifyCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Test context cancellation while waiting for an uncommitted sequence number.
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	err = d.WaitForDurabilityContext(ctx, targetSeq+1000)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
