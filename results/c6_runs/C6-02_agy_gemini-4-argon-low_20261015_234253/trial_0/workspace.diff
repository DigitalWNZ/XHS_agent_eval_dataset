+func TestDurabilityWALSyncErrorAndPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var failSync atomic.Bool
+	inj := errorfs.InjectorFunc(func(op errorfs.Op) error {
+		if (op.Kind == errorfs.OpFileSync || op.Kind == errorfs.OpFileSyncData || op.Kind == errorfs.OpFileSyncTo) &&
+			strings.HasSuffix(op.Path, ".log") && failSync.Load() {
+			return errorfs.ErrInjected
+		}
+		return nil
+	})
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	d, err := Open("", &Options{
+		FS:     errorfs.Wrap(vfs.NewMem(), inj),
+		Logger: noopFatalLogger{},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// First sync commit succeeds.
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), Sync))
+	seq1, err := d.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, seq1, base.SeqNum(0))
+
+	// Register a notification subscription before failure.
+	notifyCh := d.DurabilityNotify(seq1 + 100)
+
+	// Enable sync error injection.
+	failSync.Store(true)
+	err = d.Set([]byte("b"), []byte("2"), Sync)
+	require.ErrorIs(t, err, errorfs.ErrInjected)
+
+	// BatchDurable must have fired on failure too.
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEv := events[1]
+	mu.Unlock()
+	require.ErrorIs(t, failEv.Err, errorfs.ErrInjected)
+
+	// DurableState and DurabilityStats reflect the latched error and preserve HighestDurableSeqNum.
+	seq2, latchedErr := d.DurableState()
+	require.Equal(t, seq1, seq2)
+	require.ErrorIs(t, latchedErr, errorfs.ErrInjected)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, errorfs.ErrInjected)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+
+	// Subscription channel receives the WAL sync error.
+	require.ErrorIs(t, <-notifyCh, errorfs.ErrInjected)
+
+	// Durability error takes precedence over a cancelled context!
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	require.ErrorIs(t, d.WaitForDurabilityContext(cancelledCtx, seq1), errorfs.ErrInjected)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{seq1}), errorfs.ErrInjected)
