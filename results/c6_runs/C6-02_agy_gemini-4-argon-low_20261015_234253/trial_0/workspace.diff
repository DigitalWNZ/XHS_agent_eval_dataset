+func TestWaitForJobDurabilityAndRetention(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var lastJobID atomic.Int64
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID.Store(int64(info.JobID))
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Zero and never-seen job IDs must return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Commit more than maxDurableJobRetention batches so early job IDs expire.
+	totalCommits := maxDurableJobRetention + 100
+	for i := 0; i < totalCommits; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("k%d", i)), []byte("v"), Sync))
+	}
+
+	latestID := int(lastJobID.Load())
+	require.Equal(t, totalCommits, latestID)
+
+	// Recent job ID within retention window succeeds.
+	require.NoError(t, d.WaitForJobDurability(latestID))
+	require.NoError(t, d.WaitForJobDurability(latestID-maxDurableJobRetention+1))
+
+	// Evicted job ID outside retention window returns "expired" error.
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+
+	// Never-seen future job ID still returns "unknown" error.
+	err = d.WaitForJobDurability(latestID + 10)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+}
