+type blockingSyncFS struct {
+	vfs.FS
+	blockSync atomic.Bool
+	syncCh    chan struct{}
+	enteredCh chan struct{}
+	once      sync.Once
+}
+
+type blockingSyncFile struct {
+	vfs.File
+	fs *blockingSyncFS
+}
+
+func (fs *blockingSyncFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	if strings.HasSuffix(name, ".log") {
+		return &blockingSyncFile{File: f, fs: fs}, nil
+	}
+	return f, nil
+}
+
+func (f *blockingSyncFile) Sync() error {
+	if f.fs.blockSync.Load() {
+		f.fs.once.Do(func() {
+			close(f.fs.enteredCh)
+		})
+		<-f.fs.syncCh
+	}
+	return f.File.Sync()
+}
+
+func (f *blockingSyncFile) SyncData() error {
+	return f.Sync()
+}
+
+func (f *blockingSyncFile) SyncTo(length int64) (bool, error) {
+	if err := f.Sync(); err != nil {
+		return false, err
+	}
+	return true, nil
+}
