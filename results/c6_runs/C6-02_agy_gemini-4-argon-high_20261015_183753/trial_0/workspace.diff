+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	blockSync := make(chan struct{})
+	syncEntered := make(chan struct{})
+	var blockOnce sync.Once
+	var enableBlock atomic.Bool
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if enableBlock.Load() {
+				blockOnce.Do(func() {
+					close(syncEntered)
+				})
+				<-blockSync
+			}
+			return nil
+		},
+	}
+
+	var mu sync.Mutex
+	var jobIDs []int
+	d, err := Open("", &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				jobIDs = append(jobIDs, info.JobID)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Zero, negative, and never-seen job IDs must return an error containing "unknown".
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Start a Sync commit whose WAL sync blocks so we can wait on the in-flight job ID (1).
+	enableBlock.Store(true)
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- d.Set([]byte("k1"), []byte("v1"), Sync)
+	}()
+	<-syncEntered
+
+	jobWaitDone := make(chan error, 1)
+	go func() {
+		jobWaitDone <- d.WaitForJobDurability(1)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	enableBlock.Store(false)
+	close(blockSync)
+
+	require.NoError(t, <-commitDone)
+	require.NoError(t, <-jobWaitDone)
+	require.NoError(t, d.WaitForJobDurability(1))
+
+	// Commit enough Sync batches to push job 1 outside the retention window.
+	for i := 0; i < durabilityJobRetentionWindow+10; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	// Job 1 is now expired.
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+
+	// Recent job ID is still valid.
+	mu.Lock()
+	latestJobID := jobIDs[len(jobIDs)-1]
+	mu.Unlock()
+	require.NoError(t, d.WaitForJobDurability(latestJobID))
+
+	// Future never-seen job ID still returns "unknown".
+	err = d.WaitForJobDurability(latestJobID + 100)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+}
