+func TestDurabilityDisableWAL(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var callbackCount atomic.Int32
+	d, err := Open("", &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				callbackCount.Add(1)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), NoSync))
+	require.Equal(t, int32(0), callbackCount.Load())
+
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	// All wait APIs and DurabilityNotify return nil immediately when DisableWAL is true.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(999))
+	require.NoError(t, d.WaitForDurabilityContext(cancelledCtx, 999))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{1, 2, 999}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{1, 2, 999}))
+	require.NoError(t, d.WaitForJobDurability(0))
+	require.NoError(t, d.WaitForJobDurability(999))
+	require.NoError(t, d.WaitForJobDurabilityContext(cancelledCtx, 999))
+
+	ch := d.DurabilityNotify(999)
+	require.Len(t, ch, 1)
+	require.NoError(t, <-ch)
+}
