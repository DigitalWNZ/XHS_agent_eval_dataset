+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	getEvents := func() []BatchDurableInfo {
+		mu.Lock()
+		defer mu.Unlock()
+		cp := make([]BatchDurableInfo, len(events))
+		copy(cp, events)
+		return cp
+	}
+
+	// Non-sync commits must never trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync1"), []byte("val1"), NoSync))
+	bNoSync := d.NewBatch()
+	require.NoError(t, bNoSync.Set([]byte("nosync2"), []byte("val2"), nil))
+	require.NoError(t, bNoSync.Commit(NoSync))
+	require.NoError(t, bNoSync.Close())
+	require.Empty(t, getEvents())
+
+	// Empty Sync batch must not trigger BatchDurable.
+	emptyBatch := d.NewBatch()
+	require.NoError(t, d.Apply(emptyBatch, Sync))
+	require.NoError(t, emptyBatch.Close())
+	require.Empty(t, getEvents())
+
+	// 1. Direct DB.Set with Sync and CommitCorrelationID.
+	wo1 := &WriteOptions{Sync: true, CommitCorrelationID: 42}
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), wo1))
+
+	ev := getEvents()
+	require.Len(t, ev, 1)
+	require.Greater(t, ev[0].JobID, 0)
+	require.GreaterOrEqual(t, ev[0].SeqNum, base.SeqNumStart)
+	require.NoError(t, ev[0].Err)
+	require.Greater(t, ev[0].ApplyDuration, time.Duration(0))
+	require.Greater(t, ev[0].SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev[0].CorrelationID)
+	require.Greater(t, ev[0].BatchSize, 0)
+	require.Equal(t, uint32(1), ev[0].KeyCount)
+
+	// 2. Multi-key Batch commit with Sync.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, b.Delete([]byte("k1"), nil))
+	expectedSize := len(b.Repr())
+	expectedCount := b.Count()
+	wo2 := &WriteOptions{Sync: true, CommitCorrelationID: 99}
+	require.NoError(t, d.Apply(b, wo2))
+	expectedSeqNum := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	ev = getEvents()
+	require.Len(t, ev, 2)
+	require.Greater(t, ev[1].JobID, ev[0].JobID)
+	require.Equal(t, expectedSeqNum, ev[1].SeqNum)
+	require.NoError(t, ev[1].Err)
+	require.Greater(t, ev[1].ApplyDuration, time.Duration(0))
+	require.Greater(t, ev[1].SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(99), ev[1].CorrelationID)
+	require.Equal(t, expectedSize, ev[1].BatchSize)
+	require.Equal(t, expectedCount, ev[1].KeyCount)
+	require.Equal(t, uint32(3), ev[1].KeyCount)
+
+	// 3. ApplyNoSyncWait + SyncWait fires BatchDurable exactly once.
+	bAsync := d.NewBatch()
+	require.NoError(t, bAsync.Set([]byte("k4"), []byte("v4"), nil))
+	asyncSize := len(bAsync.Repr())
+	wo3 := &WriteOptions{Sync: true, CommitCorrelationID: 777}
+	require.NoError(t, d.ApplyNoSyncWait(bAsync, wo3))
+	require.NoError(t, bAsync.SyncWait())
+	asyncSeqNum := bAsync.SeqNum()
+	require.NoError(t, bAsync.Close())
+
+	ev = getEvents()
+	require.Len(t, ev, 3)
+	require.Greater(t, ev[2].JobID, ev[1].JobID)
+	require.Equal(t, asyncSeqNum, ev[2].SeqNum)
+	require.NoError(t, ev[2].Err)
+	require.Greater(t, ev[2].ApplyDuration, time.Duration(0))
+	require.Greater(t, ev[2].SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(777), ev[2].CorrelationID)
+	require.Equal(t, asyncSize, ev[2].BatchSize)
+	require.Equal(t, uint32(1), ev[2].KeyCount)
+}
