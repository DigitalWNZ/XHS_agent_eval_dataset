+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Subscribe for seqNum 0 before any commit.
+	ch0 := d.DurabilityNotify(0)
+	select {
+	case err := <-ch0:
+		t.Fatalf("expected ch0 to block before first commit, got %v", err)
+	default:
+	}
+
+	// Perform first Sync commit.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("a"), []byte("1"), nil))
+	require.NoError(t, b.Commit(Sync))
+	seq1 := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	// ch0 should now deliver nil.
+	require.NoError(t, <-ch0)
+
+	// Already durable seqNum returns a pre-filled channel with nil immediately.
+	chDone := d.DurabilityNotify(seq1)
+	require.Len(t, chDone, 1)
+	require.NoError(t, <-chDone)
+
+	// Bound on outstanding subscriptions: fill up maxDurabilityNotifySubscriptions.
+	futureSeq := seq1 + 1000
+	subs := make([]<-chan error, 0, maxDurabilityNotifySubscriptions)
+	for i := 0; i < maxDurabilityNotifySubscriptions; i++ {
+		ch := d.DurabilityNotify(futureSeq)
+		select {
+		case err := <-ch:
+			t.Fatalf("unexpected immediate resolution at %d: %v", i, err)
+		default:
+		}
+		subs = append(subs, ch)
+	}
+
+	// Excess caller gets a pre-filled channel with an immediate non-nil error.
+	excessCh := d.DurabilityNotify(futureSeq)
+	require.Len(t, excessCh, 1)
+	require.Error(t, <-excessCh)
+
+	// Closing the DB resolves all outstanding subscription channels with an error.
+	require.NoError(t, d.Close())
+	d = nil
+	for i, ch := range subs {
+		require.Error(t, <-ch, "sub %d should receive error on close", i)
+	}
+}
