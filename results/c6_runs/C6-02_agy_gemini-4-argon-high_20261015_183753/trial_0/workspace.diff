+func TestBatchDurableCallbackOnFailure(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var failSync atomic.Bool
+	injectedErr := errors.New("injected wal sync failure")
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if failSync.Load() {
+				return injectedErr
+			}
+			return nil
+		},
+	}
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+	opts := &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// First commit succeeds.
+	require.NoError(t, d.Set([]byte("ok"), []byte("val"), &WriteOptions{Sync: true, CommitCorrelationID: 1}))
+
+	// Enable WAL sync failure and commit.
+	failSync.Store(true)
+	err = d.Set([]byte("fail"), []byte("val"), &WriteOptions{Sync: true, CommitCorrelationID: 2})
+	require.ErrorIs(t, err, injectedErr)
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEvent := events[1]
+	mu.Unlock()
+
+	require.Greater(t, failEvent.JobID, events[0].JobID)
+	require.Greater(t, failEvent.SeqNum, events[0].SeqNum)
+	require.ErrorIs(t, failEvent.Err, injectedErr)
+	require.Equal(t, uint64(2), failEvent.CorrelationID)
+	require.Greater(t, failEvent.BatchSize, 0)
+	require.Equal(t, uint32(1), failEvent.KeyCount)
+}
