+func TestDurabilityErrorAndClosePrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var failSync atomic.Bool
+	syncErr := errors.New("disk on fire")
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if failSync.Load() {
+				return syncErr
+			}
+			return nil
+		},
+	}
+
+	d, err := Open("", &Options{FS: fs})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// Successful commit 1.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, b1.Commit(Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	// Start a waiter and a notify subscription for future seqNum before the failure.
+	waitErrCh := make(chan error, 1)
+	go func() {
+		waitErrCh <- d.WaitForDurability(seq1 + 50)
+	}()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	notifyCh := d.DurabilityNotify(seq1 + 50)
+
+	// Trigger WAL sync failure.
+	failSync.Store(true)
+	err = d.Set([]byte("k2"), []byte("v2"), Sync)
+	require.ErrorIs(t, err, syncErr)
+
+	// Waiter and notify subscriber must unblock with syncErr.
+	require.ErrorIs(t, <-waitErrCh, syncErr)
+	require.ErrorIs(t, <-notifyCh, syncErr)
+
+	// DurableState and DurabilityStats reflect highest durable seqNum from commit 1 and latched FirstErr.
+	gotSeq, gotErr := d.DurableState()
+	require.Equal(t, seq1, gotSeq)
+	require.ErrorIs(t, gotErr, syncErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, syncErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Greater(t, stats.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+
+	// Durability error takes precedence over an already-cancelled context!
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(cancelledCtx, seq1+100)
+	require.ErrorIs(t, err, syncErr)
+
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{seq1 + 100})
+	require.ErrorIs(t, err, syncErr)
+
+	err = d.WaitForJobDurabilityContext(cancelledCtx, 2)
+	require.ErrorIs(t, err, syncErr)
+}
