+func TestDurabilityCallbackReentrancyAndLargeBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var d *DB
+	var callbackChecked atomic.Bool
+	opts := &Options{
+		FS:           vfs.NewMem(),
+		MemTableSize: 4096,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				if d != nil && info.Err == nil {
+					require.NoError(t, d.WaitForJobDurability(info.JobID))
+					require.NoError(t, d.WaitForDurability(info.SeqNum))
+					seq, err := d.DurableState()
+					require.NoError(t, err)
+					require.GreaterOrEqual(t, seq, info.SeqNum)
+					callbackChecked.Store(true)
+				}
+			},
+		},
+	}
+	var err error
+	d, err = Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Commit a large batch that exceeds largeBatchThreshold (flushable batch).
+	largeBatch := d.NewBatch()
+	largeVal := make([]byte, 3000)
+	require.NoError(t, largeBatch.Set([]byte("large-key"), largeVal, nil))
+	expectedSize := len(largeBatch.Repr())
+	require.NoError(t, d.Apply(largeBatch, &WriteOptions{Sync: true, CommitCorrelationID: 555}))
+	require.GreaterOrEqual(t, largeBatch.SeqNum(), base.SeqNumStart)
+	require.NoError(t, largeBatch.Close())
+	require.True(t, callbackChecked.Load())
+
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Greater(t, expectedSize, 3000)
+}
