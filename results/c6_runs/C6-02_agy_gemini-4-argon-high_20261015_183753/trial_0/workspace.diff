diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..0961c2db
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,563 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// durabilityJobRetentionWindow bounds the number of recent Sync commit job
+	// IDs retained for WaitForJobDurability queries.
+	durabilityJobRetentionWindow = 128
+
+	// maxDurabilityNotifySubscriptions bounds the number of concurrent
+	// unresolved DurabilityNotify subscriptions.
+	maxDurabilityNotifySubscriptions = 128
+)
+
+var (
+	// ErrJobExpired is returned by WaitForJobDurability when a job ID has fallen
+	// outside the bounded retention window.
+	ErrJobExpired = errors.New("pebble: durability job ID expired")
+
+	// ErrJobUnknown is returned by WaitForJobDurability when a job ID is zero,
+	// negative, or has never been seen.
+	ErrJobUnknown = errors.New("pebble: unknown durability job ID")
+
+	// ErrTooManyDurabilitySubscriptions is delivered on the channel returned by
+	// DurabilityNotify when the bound on outstanding subscriptions is exceeded.
+	ErrTooManyDurabilitySubscriptions = errors.New("pebble: too many outstanding durability notify subscriptions")
+)
+
+// DurabilityStats holds a point-in-time snapshot of durability tracking state
+// and statistics for a DB.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJobEntry struct {
+	jobID int
+	done  bool
+	err   error
+}
+
+type durabilityWaiter struct {
+	seqNum base.SeqNum
+	jobID  int
+	isJob  bool
+	active bool
+	ch     chan struct{}
+}
+
+type durabilityNotifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityTracker struct {
+	mu sync.Mutex
+
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	closedErr              error
+	pendingWaiters         int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	metricsCommitCount    uint64
+	metricsCommitDuration time.Duration
+
+	maxJobID int
+	jobs     [durabilityJobRetentionWindow]durabilityJobEntry
+
+	waiters    []*durabilityWaiter
+	notifySubs []durabilityNotifySub
+}
+
+func (t *durabilityTracker) startJob() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	t.maxJobID++
+	jobID := t.maxJobID
+	t.jobs[jobID%durabilityJobRetentionWindow] = durabilityJobEntry{
+		jobID: jobID,
+		done:  false,
+		err:   nil,
+	}
+	// If any waiter was waiting on a job that just got evicted by the retention
+	// window, wake it up so it can observe the expiration.
+	t.wakeWaitersLocked()
+	return jobID
+}
+
+func (t *durabilityTracker) completeJob(info BatchDurableInfo, recordMetrics bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if info.JobID > 0 {
+		slot := &t.jobs[info.JobID%durabilityJobRetentionWindow]
+		if slot.jobID == info.JobID {
+			slot.done = true
+			slot.err = info.Err
+		}
+	}
+
+	if info.Err != nil {
+		t.totalFailedCommits++
+		if t.firstErr == nil {
+			t.firstErr = info.Err
+		}
+	} else {
+		t.totalDurableCommits++
+		if info.SeqNum > t.highestDurableSeqNum {
+			t.highestDurableSeqNum = info.SeqNum
+		}
+		t.cumulativeSyncDuration += info.SyncDuration
+		if info.SyncDuration > t.maxSyncDuration {
+			t.maxSyncDuration = info.SyncDuration
+		}
+		if recordMetrics {
+			t.metricsCommitCount++
+			t.metricsCommitDuration += info.SyncDuration
+		}
+	}
+
+	t.wakeWaitersLocked()
+	t.notifySubscribersLocked()
+}
+
+func (t *durabilityTracker) close(err error) {
+	if err == nil {
+		err = ErrClosed
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if t.closedErr == nil {
+		t.closedErr = err
+	}
+	t.wakeWaitersLocked()
+	t.notifySubscribersLocked()
+}
+
+func (t *durabilityTracker) errLocked() error {
+	if t.firstErr != nil {
+		return t.firstErr
+	}
+	return t.closedErr
+}
+
+func (t *durabilityTracker) isDurableLocked(seqNum base.SeqNum) bool {
+	return t.highestDurableSeqNum > 0 && t.highestDurableSeqNum >= seqNum
+}
+
+func (t *durabilityTracker) minRetainedJobIDLocked() int {
+	minID := t.maxJobID - durabilityJobRetentionWindow + 1
+	if minID < 1 {
+		return 1
+	}
+	return minID
+}
+
+func (t *durabilityTracker) wakeWaitersLocked() {
+	if len(t.waiters) == 0 {
+		return
+	}
+	hasErr := t.errLocked() != nil
+	minRetained := t.minRetainedJobIDLocked()
+
+	n := 0
+	for _, w := range t.waiters {
+		ready := hasErr
+		if !ready {
+			if w.isJob {
+				if w.jobID < minRetained {
+					ready = true
+				} else {
+					slot := &t.jobs[w.jobID%durabilityJobRetentionWindow]
+					if slot.jobID == w.jobID && slot.done {
+						ready = true
+					}
+				}
+			} else if t.isDurableLocked(w.seqNum) {
+				ready = true
+			}
+		}
+		if ready {
+			if w.active {
+				w.active = false
+				t.pendingWaiters--
+				close(w.ch)
+			}
+		} else {
+			t.waiters[n] = w
+			n++
+		}
+	}
+	for i := n; i < len(t.waiters); i++ {
+		t.waiters[i] = nil
+	}
+	t.waiters = t.waiters[:n]
+}
+
+func (t *durabilityTracker) removeWaiterLocked(target *durabilityWaiter) {
+	for i, w := range t.waiters {
+		if w == target {
+			copy(t.waiters[i:], t.waiters[i+1:])
+			t.waiters[len(t.waiters)-1] = nil
+			t.waiters = t.waiters[:len(t.waiters)-1]
+			return
+		}
+	}
+}
+
+func (t *durabilityTracker) notifySubscribersLocked() {
+	if len(t.notifySubs) == 0 {
+		return
+	}
+	if err := t.errLocked(); err != nil {
+		for _, sub := range t.notifySubs {
+			sub.ch <- err
+		}
+		clear(t.notifySubs)
+		t.notifySubs = t.notifySubs[:0]
+		return
+	}
+
+	n := 0
+	for _, sub := range t.notifySubs {
+		if t.isDurableLocked(sub.seqNum) {
+			sub.ch <- nil
+		} else {
+			t.notifySubs[n] = sub
+			n++
+		}
+	}
+	clear(t.notifySubs[n:])
+	t.notifySubs = t.notifySubs[:n]
+}
+
+func (t *durabilityTracker) durableState() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.highestDurableSeqNum, t.firstErr
+}
+
+func (t *durabilityTracker) durabilityStats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.highestDurableSeqNum,
+		FirstErr:               t.firstErr,
+		PendingWaiters:         t.pendingWaiters,
+		TotalDurableCommits:    t.totalDurableCommits,
+		TotalFailedCommits:     t.totalFailedCommits,
+		CumulativeSyncDuration: t.cumulativeSyncDuration,
+		MaxSyncDuration:        t.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metrics() (uint64, time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.metricsCommitCount, t.metricsCommitDuration
+}
+
+func (t *durabilityTracker) waitForDurabilityContext(
+	ctx context.Context, seqNum base.SeqNum,
+) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t.mu.Lock()
+	if err := t.errLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if t.isDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+
+	w := &durabilityWaiter{
+		seqNum: seqNum,
+		isJob:  false,
+		active: true,
+		ch:     make(chan struct{}),
+	}
+	t.waiters = append(t.waiters, w)
+	t.pendingWaiters++
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	if w.active {
+		w.active = false
+		t.pendingWaiters--
+		t.removeWaiterLocked(w)
+	}
+	err := t.errLocked()
+	durable := t.isDurableLocked(seqNum)
+	t.mu.Unlock()
+
+	if err != nil {
+		return err
+	}
+	if durable {
+		return nil
+	}
+	return ctx.Err()
+}
+
+func (t *durabilityTracker) waitForDurabilityBatchContext(
+	ctx context.Context, seqNums []base.SeqNum,
+) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t.mu.Lock()
+	if err := t.errLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if len(seqNums) == 0 {
+		t.mu.Unlock()
+		return nil
+	}
+	t.mu.Unlock()
+
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return t.waitForDurabilityContext(ctx, maxSeq)
+}
+
+func (t *durabilityTracker) waitForJobDurabilityContext(
+	ctx context.Context, jobID int,
+) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t.mu.Lock()
+	if err := t.errLocked(); err != nil {
+		// If jobID is valid and failed with its own error, return it; otherwise
+		// return the latched durability/close error.
+		if jobID > 0 && jobID <= t.maxJobID && jobID >= t.minRetainedJobIDLocked() {
+			slot := &t.jobs[jobID%durabilityJobRetentionWindow]
+			if slot.jobID == jobID && slot.done && slot.err != nil {
+				jobErr := slot.err
+				t.mu.Unlock()
+				return jobErr
+			}
+		}
+		if t.closedErr != nil || (jobID > 0 && jobID <= t.maxJobID && jobID >= t.minRetainedJobIDLocked()) {
+			t.mu.Unlock()
+			return err
+		}
+	}
+	if jobID <= 0 || jobID > t.maxJobID {
+		t.mu.Unlock()
+		return errors.Wrapf(ErrJobUnknown, "job %d", jobID)
+	}
+	if jobID < t.minRetainedJobIDLocked() {
+		t.mu.Unlock()
+		return errors.Wrapf(ErrJobExpired, "job %d", jobID)
+	}
+	slot := &t.jobs[jobID%durabilityJobRetentionWindow]
+	if slot.jobID == jobID && slot.done {
+		err := slot.err
+		if err == nil {
+			err = t.errLocked()
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if err := t.errLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+
+	w := &durabilityWaiter{
+		jobID:  jobID,
+		isJob:  true,
+		active: true,
+		ch:     make(chan struct{}),
+	}
+	t.waiters = append(t.waiters, w)
+	t.pendingWaiters++
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	if w.active {
+		w.active = false
+		t.pendingWaiters--
+		t.removeWaiterLocked(w)
+	}
+	err := t.errLocked()
+	var jobDone bool
+	var jobErr error
+	var jobExpired bool
+	if jobID < t.minRetainedJobIDLocked() {
+		jobExpired = true
+	} else {
+		s := &t.jobs[jobID%durabilityJobRetentionWindow]
+		if s.jobID == jobID && s.done {
+			jobDone = true
+			jobErr = s.err
+		}
+	}
+	t.mu.Unlock()
+
+	if jobErr != nil {
+		return jobErr
+	}
+	if err != nil {
+		return err
+	}
+	if jobExpired {
+		return errors.Wrapf(ErrJobExpired, "job %d", jobID)
+	}
+	if jobDone {
+		return nil
+	}
+	return ctx.Err()
+}
+
+func (t *durabilityTracker) durabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err := t.errLocked(); err != nil {
+		ch <- err
+		return ch
+	}
+	if t.isDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(t.notifySubs) >= maxDurabilityNotifySubscriptions {
+		ch <- ErrTooManyDurabilitySubscriptions
+		return ch
+	}
+
+	t.notifySubs = append(t.notifySubs, durabilityNotifySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk. Passing zero succeeds after any durable commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk or the context is cancelled. Durability and close errors
+// take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForDurabilityContext(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk or the context is cancelled. A nil or empty slice returns
+// nil immediately. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForDurabilityBatchContext(ctx, seqNums)
+}
+
+// WaitForJobDurability blocks until the Sync commit identified by jobID (from
+// BatchDurableInfo.JobID) is durable on disk.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the Sync commit identified by jobID
+// (from BatchDurableInfo.JobID) is durable on disk or the context is
+// cancelled. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForJobDurabilityContext(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched WAL sync error, if any.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seqNum
+// becomes durable, or a non-nil error on WAL sync failure, DB close, or when
+// the bound on outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.durabilityNotify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability state and statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.durabilityStats()
+}
