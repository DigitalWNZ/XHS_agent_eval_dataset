+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	// Open DB WITHOUT BatchDurable configured to verify all DB methods work regardless.
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Initial DurabilityStats and DurableState before any commits.
+	stats := d.DurabilityStats()
+	require.Equal(t, DurabilityStats{}, stats)
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+
+	// WaitForDurabilityBatch with nil or empty slice returns nil immediately even before any commit.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commit and succeeds after the first Sync commit.
+	zeroErrCh := make(chan error, 1)
+	go func() {
+		zeroErrCh <- d.WaitForDurability(0)
+	}()
+
+	// Wait until the goroutine is registered in PendingWaiters.
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	// NoSync commit does not unblock WaitForDurability(0).
+	bNoSync := d.NewBatch()
+	require.NoError(t, bNoSync.Set([]byte("ns"), []byte("v"), nil))
+	require.NoError(t, bNoSync.Commit(NoSync))
+	noSyncSeq := bNoSync.SeqNum()
+	require.NoError(t, bNoSync.Close())
+
+	select {
+	case err := <-zeroErrCh:
+		t.Fatalf("WaitForDurability(0) unblocked on NoSync commit: %v", err)
+	case <-time.After(10 * time.Millisecond):
+	}
+
+	// Now perform a Sync commit.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("s1"), []byte("v1"), nil))
+	require.NoError(t, b1.Commit(Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	require.NoError(t, <-zeroErrCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Already durable seqNums (0, noSyncSeq, seq1) succeed immediately.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(noSyncSeq))
+	require.NoError(t, d.WaitForDurability(seq1))
+
+	// Wait for future sequence numbers via WaitForDurability and WaitForDurabilityBatch.
+	targetSeq := seq1 + 2
+	waitCh1 := make(chan error, 1)
+	waitCh2 := make(chan error, 1)
+	go func() {
+		waitCh1 <- d.WaitForDurability(targetSeq)
+	}()
+	go func() {
+		waitCh2 <- d.WaitForDurabilityBatch([]base.SeqNum{seq1, targetSeq - 1, targetSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, time.Millisecond)
+
+	// Commit seq1 + 1 (not yet targetSeq).
+	require.NoError(t, d.Set([]byte("s2"), []byte("v2"), Sync))
+	select {
+	case err := <-waitCh1:
+		t.Fatalf("WaitForDurability unblocked early: %v", err)
+	default:
+	}
+
+	// Commit seq1 + 2 (reaches targetSeq).
+	require.NoError(t, d.Set([]byte("s3"), []byte("v3"), Sync))
+	require.NoError(t, <-waitCh1)
+	require.NoError(t, <-waitCh2)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Context cancellation when waiting for a future sequence number.
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	err = d.WaitForDurabilityContext(ctx, targetSeq+100)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
