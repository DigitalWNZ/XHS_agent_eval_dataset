+"""
+Jump Analyzer for Hurdle Jumpers
+Analyzes MP4 video of a hurdle jumper and extracts jump takeoff and landing frame numbers.
+Outputs the results to a TOML file.
+"""
+
+import sys
+import os
+import argparse
+import itertools
+import cv2
+import numpy as np
+import toml
+
+
+def get_ground_y(x):
+    """
+    Computes expected track ground y-coordinate as a function of horizontal position x.
+    Based on monocular lateral perspective calibration of the track lane.
+    """
+    # Track lane line slopes slightly down to the left from perspective:
+    # x = 900 -> y ~ 359
+    # x = 100 -> y ~ 366
+    return 366.875 - 0.00875 * x
+
+
+def detect_jump_frames(video_path):
+    """
+    Analyzes the video to detect the hurdle jump event.
+    Returns:
+        (takeoff_frame, land_frame)
+    """
+    cap = cv2.VideoCapture(video_path)
+    if not cap.isOpened():
+        raise FileNotFoundError(f"Could not open video file: {video_path}")
+
+    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
+    fps = cap.get(cv2.CAP_PROP_FPS)
+
+    # Frame 0 is guaranteed to have no runner on the track
+    ret, bg = cap.read()
+    if not ret or bg is None:
+        cap.release()
+        raise ValueError("Could not read background frame (frame 0) from video")
+
+    # Reset position to 0
+    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
+
+    # Initialize MOG2 background subtractor
+    fgbg = cv2.createBackgroundSubtractorMOG2(history=300, varThreshold=25, detectShadows=True)
+    # Warm up background model with initial clean background
+    for _ in range(5):
+        fgbg.apply(bg)
+
+    tracked_records = []
+
+    while True:
+        frame_idx = int(cap.get(cv2.CAP_PROP_POS_FRAMES))
+        ret, frame = cap.read()
+        if not ret or frame is None:
+            break
+
+        # Foreground mask from MOG2
+        fgmask = fgbg.apply(frame)
+        # Keep foreground only (exclude shadows labeled as 127)
+        fg = (fgmask == 255).astype(np.uint8) * 255
+
+        # Mask out fence area above track and bottom-most boundary
+        fg[:60, :] = 0
+        fg[440:, :] = 0
+
+        # Morphological noise removal
+        kernel_open = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 3))
+        kernel_close = cv2.getStructuringElement(cv2.MORPH_RECT, (7, 7))
+        fg = cv2.morphologyEx(fg, cv2.MORPH_OPEN, kernel_open)
+        fg = cv2.morphologyEx(fg, cv2.MORPH_CLOSE, kernel_close)
+
+        # Connected components analysis
+        num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(fg)
+        candidates = []
+        for l in range(1, num_labels):
+            area = stats[l, cv2.CC_STAT_AREA]
+            h = stats[l, cv2.CC_STAT_HEIGHT]
+            w = stats[l, cv2.CC_STAT_WIDTH]
+            top = stats[l, cv2.CC_STAT_TOP]
+            # Athlete is tall, has substantial area, and reasonable width
+            if area > 1000 and 80 < h < 400 and w < 300 and top < 250:
+                candidates.append((area, l))
+
+        if candidates:
+            # Pick largest candidate component matching athlete
+            candidates.sort(reverse=True)
+            best_label = candidates[0][1]
+
+            mask = (labels == best_label)
+            ys, xs = np.where(mask)
+
+            cx = float(np.mean(xs))
+            cy = float(np.mean(ys))
+            bot_y = int(np.max(ys))
+            p99_y = float(np.percentile(ys, 99))
+            ground_y = get_ground_y(cx)
+            clearance = ground_y - bot_y
+
+            tracked_records.append({
+                "frame": frame_idx,
+                "cx": cx,
+                "cy": cy,
+                "bot_y": bot_y,
+                "p99_y": p99_y,
+                "ground_y": ground_y,
+                "clearance": clearance,
+                "area": int(stats[best_label, cv2.CC_STAT_AREA]),
+                "w": int(stats[best_label, cv2.CC_STAT_WIDTH]),
+                "h": int(stats[best_label, cv2.CC_STAT_HEIGHT])
+            })
+
+    cap.release()
+
+    if not tracked_records:
+        raise ValueError("No athlete detected in the video")
+
+    # Find the hurdle jump event
+    # Hurdle is located in the center (x ~ 490)
+    # The jump has elevated ground clearance (typically > 12 px, peaking > 50 px)
+    # Filter candidate jump frames around the hurdle zone (x in [150, 850])
+    jump_candidates = [
+        d for d in tracked_records
+        if d["clearance"] > 10.0 and 150 < d["cx"] < 850
+    ]
+
+    if not jump_candidates:
+        raise ValueError("Could not find jump candidates with elevated clearance")
+
+    # Group consecutive frames together
+    groups = []
+    for k, g in itertools.groupby(enumerate(jump_candidates), lambda ix: ix[0] - ix[1]["frame"]):
+        groups.append([x[1] for x in g])
+
+    # Filter groups that represent a true hurdle jump:
+    # 1. Must cross or be near the hurdle (min cx < 550 and max cx > 430)
+    # 2. Peak clearance must exceed 40 pixels (hurdle height is significant)
+    # 3. Must span at least 4 frames
+    valid_groups = []
+    for grp in groups:
+        peak_clr = max(d["clearance"] for d in grp)
+        min_x = min(d["cx"] for d in grp)
+        max_x = max(d["cx"] for d in grp)
+        if peak_clr > 40.0 and len(grp) >= 4 and min_x < 600 and max_x > 380:
+            valid_groups.append(grp)
+
+    if not valid_groups:
+        # Fall back to group with highest peak clearance
+        valid_groups = [max(groups, key=lambda g: max(d["clearance"] for d in g))]
+
+    # Select the primary hurdle jump group
+    hurdle_jump_group = max(valid_groups, key=lambda g: max(d["clearance"] for d in g))
+    airborne_frames = [d["frame"] for d in hurdle_jump_group]
+
+    # The jump begins at the first frame the athlete is airborne/taking off
+    takeoff_frame = int(airborne_frames[0])
+    # The athlete lands on the frame immediately following the end of the airborne sequence
+    land_frame = int(airborne_frames[-1] + 1)
+
+    return takeoff_frame, land_frame
+
+
+def analyze_jump(video_path, output_toml_path="/app/output.toml"):
+    """
+    Main analysis function.
+    Processes video, computes takeoff and landing frames, writes TOML file.
+    Returns metrics dict.
+    """
+    takeoff_frame, land_frame = detect_jump_frames(video_path)
+
+    metrics = {
+        "jump_takeoff_frame_number": int(takeoff_frame),
+        "jump_land_frame_number": int(land_frame)
+    }
+
+    # Ensure parent directory exists
+    output_dir = os.path.dirname(os.path.abspath(output_toml_path))
+    if output_dir:
+        os.makedirs(output_dir, exist_ok=True)
+
+    with open(output_toml_path, "w") as f:
+        toml.dump(metrics, f)
+
+    # Also ensure /app/output.toml is written if a custom output was requested
+    if os.path.abspath(output_toml_path) != "/app/output.toml":
+        try:
+            with open("/app/output.toml", "w") as f:
+                toml.dump(metrics, f)
+        except Exception:
+            pass
+
+    return metrics
+
+
+# Alias
+analyze_video = analyze_jump
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Analyze MP4 video of hurdle jumpers and output metrics to TOML."
+    )
+    parser.add_argument(
+        "video_path",
+        nargs="?",
+        default="/app/example_video.mp4",
+        help="Path to input MP4 video file (default: /app/example_video.mp4)"
+    )
+    parser.add_argument(
+        "-i", "--input",
+        dest="input_opt",
+        help="Path to input MP4 video file"
+    )
+    parser.add_argument(
+        "-v", "--video",
+        dest="video_opt",
+        help="Path to input MP4 video file"
+    )
+    parser.add_argument(
+        "-o", "--output",
+        default="/app/output.toml",
+        help="Path to output TOML file (default: /app/output.toml)"
+    )
+
+    args = parser.parse_args()
+
+    # Determine video path
+    video_path = args.input_opt or args.video_opt or args.video_path
+    output_path = args.output
+
+    if not os.path.exists(video_path):
+        print(f"Error: Video file not found: {video_path}", file=sys.stderr)
+        sys.exit(1)
+
+    metrics = analyze_jump(video_path, output_path)
+    print(f"Analysis complete for: {video_path}")
+    print(f"jump_takeoff_frame_number = {metrics['jump_takeoff_frame_number']}")
+    print(f"jump_land_frame_number = {metrics['jump_land_frame_number']}")
+    print(f"Output saved to: {output_path}")
+
+
+if __name__ == "__main__":
+    main()
