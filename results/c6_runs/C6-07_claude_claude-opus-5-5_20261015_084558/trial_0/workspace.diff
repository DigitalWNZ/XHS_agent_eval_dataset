+)
+
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  readonly [persisterRestoreResultSymbol]: true
+  data: TData | undefined
+  state: QueryState<TData, TError>
+}
+
+/**
+ * Creates a value that can be returned from a `persister` to signal that a
+ * persisted query snapshot was restored instead of freshly fetched.
+ * The provided `state` will be adopted as the query state.
+ */
+export function createPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>({
+  data,
+  state,
+}: {
+  data: TData | undefined
+  state: QueryState<TData, TError>
+}): PersisterRestoreResult<TData, TError> {
+  return { [persisterRestoreResultSymbol]: true, data, state }
+}
+
+export function isPersisterRestoreResult(
+  value: unknown,
+): value is PersisterRestoreResult<any, any> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as any)[persisterRestoreResultSymbol] === true
+  )
+}
