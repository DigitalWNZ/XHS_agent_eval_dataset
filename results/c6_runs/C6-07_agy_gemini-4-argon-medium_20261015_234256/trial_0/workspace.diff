+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  [PERSISTER_RESTORE_RESULT_SYMBOL]: true
+  data: TData
+  state: Partial<QueryState<any, TError>>
