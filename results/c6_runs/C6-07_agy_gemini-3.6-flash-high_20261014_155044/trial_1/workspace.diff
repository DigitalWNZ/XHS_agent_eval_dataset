+        @memcpy(dy[0..w], sy[0..w]);
+    }
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = @min(y0 + 1, h - 1);
+        const su0 = src_u + y0 * src_u_stride;
+        const su1 = src_u + y1 * src_u_stride;
+        const sv0 = src_v + y0 * src_v_stride;
+        const sv1 = src_v + y1 * src_v_stride;
+        const du = dst_u + cy * dst_u_stride;
+        const dv = dst_v + cy * dst_v_stride;
+        for (0..cw) |cx| {
+            const x0 = cx * 2;
+            const x1 = @min(x0 + 1, w - 1);
+            const u_sum: u32 = @as(u32, su0[x0]) + su0[x1] + su1[x0] + su1[x1];
+            const v_sum: u32 = @as(u32, sv0[x0]) + sv0[x1] + sv1[x0] + sv1[x1];
+            du[cx] = @truncate((u_sum + 2) >> 2);
+            dv[cx] = @truncate((v_sum + 2) >> 2);
+        }
+    }
+}
+
+pub fn yuv422p_to_yuv420p(
+    src_y: [*]const u8, src_y_stride: usize,
+    src_u: [*]const u8, src_u_stride: usize,
+    src_v: [*]const u8, src_v_stride: usize,
+    dst_y: [*]u8, dst_y_stride: usize,
+    dst_u: [*]u8, dst_u_stride: usize,
+    dst_v: [*]u8, dst_v_stride: usize,
+    w: usize, h: usize,
+) void {
+    for (0..h) |y| {
+        const sy = src_y + y * src_y_stride;
+        const dy = dst_y + y * dst_y_stride;
+        @memcpy(dy[0..w], sy[0..w]);
+    }
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = @min(y0 + 1, h - 1);
+        const su0 = src_u + y0 * src_u_stride;
+        const su1 = src_u + y1 * src_u_stride;
+        const sv0 = src_v + y0 * src_v_stride;
+        const sv1 = src_v + y1 * src_v_stride;
+        const du = dst_u + cy * dst_u_stride;
+        const dv = dst_v + cy * dst_v_stride;
+        for (0..cw) |cx| {
+            du[cx] = @truncate((@as(u32, su0[cx]) + su1[cx] + 1) >> 1);
+            dv[cx] = @truncate((@as(u32, sv0[cx]) + sv1[cx] + 1) >> 1);
+        }
+    }
+}
