+mse_r = np.mean((dst_rgb[:, :, 0].astype(float) - r_calc.astype(float))**2)
+mse_g = np.mean((dst_rgb[:, :, 1].astype(float) - g_calc.astype(float))**2)
+mse_b = np.mean((dst_rgb[:, :, 2].astype(float) - b_calc.astype(float))**2)
+
+print(f"MSE: R={mse_r:.4f}, G={mse_g:.4f}, B={mse_b:.4f}")
