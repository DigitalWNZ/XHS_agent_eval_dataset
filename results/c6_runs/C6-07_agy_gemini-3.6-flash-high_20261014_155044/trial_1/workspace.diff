+import sys
+import ctypes
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int] * 7
+lib.swscale_process.restype = ctypes.c_int
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+lib.swscale_destroy.argtypes = [ctypes.c_void_p]
+
+w, h = 16, 16
+ctx = lib.swscale_create(w, h, workloads.RGB24, w, h, workloads.GRAY8, workloads.BILINEAR)
+
+# Generate test RGB values
+r_vals = [0, 255, 100, 200, 50]
+g_vals = [0, 255, 150, 100, 100]
+b_vals = [0, 255, 200, 50, 200]
+
+rgb = np.zeros((h, w, 3), dtype=np.uint8)
+for i in range(5):
+    rgb[0, i] = [r_vals[i], g_vals[i], b_vals[i]]
+
+dst = np.zeros((h, w), dtype=np.uint8)
+src_ptrs = (ctypes.c_char_p * 4)(rgb.ctypes.data, None, None, None)
+src_strides = (ctypes.c_int * 4)(w * 3, 0, 0, 0)
+dst_ptrs = (ctypes.c_char_p * 4)(dst.ctypes.data, None, None, None)
+dst_strides = (ctypes.c_int * 4)(w, 0, 0, 0)
+
+lib.swscale_process(ctx, src_ptrs, src_strides, dst_ptrs, dst_strides)
+lib.swscale_destroy(ctx)
+
+print("RGB24 -> GRAY8 baseline output:")
+for i in range(5):
+    r, g, b = rgb[0, i]
+    gray = dst[0, i]
+    # Test formula:
+    # FFmpeg RGB -> Y (limited range Rec.601):
+    # Y = ((16839*R + 33059*G + 6418*B + 32768) >> 16) + 16
+    # Or full range:
+    # Y = (19595*R + 38470*G + 7471*B + 32768) >> 16
+    y_lim = ((16839*int(r) + 33059*int(g) + 6418*int(b) + 32768) >> 16) + 16
+    y_full = (19595*int(r) + 38470*int(g) + 7471*int(b) + 32768) >> 16
+    print(f"R={r:3d}, G={g:3d}, B={b:3d} => Baseline GRAY={gray:3d} | y_lim={y_lim:3d}, y_full={y_full:3d}")
