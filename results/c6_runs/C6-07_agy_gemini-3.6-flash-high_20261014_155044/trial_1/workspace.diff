+import sys
+import ctypes
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int] * 7
+lib.swscale_process.restype = ctypes.c_int
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+lib.swscale_destroy.argtypes = [ctypes.c_void_p]
+
+w, h = 64, 64
+ctx = lib.swscale_create(w, h, workloads.RGB24, w, h, workloads.YUV444P, workloads.BILINEAR)
+
+np.random.seed(123)
+rgb = np.random.randint(0, 256, (h, w, 3), dtype=np.uint8)
+
+dst_y = np.zeros((h, w), dtype=np.uint8)
+dst_u = np.zeros((h, w), dtype=np.uint8)
+dst_v = np.zeros((h, w), dtype=np.uint8)
+
+src_ptrs = (ctypes.c_char_p * 4)(rgb.ctypes.data, None, None, None)
+src_strides = (ctypes.c_int * 4)(w * 3, 0, 0, 0)
+dst_ptrs = (ctypes.c_char_p * 4)(dst_y.ctypes.data, dst_u.ctypes.data, dst_v.ctypes.data, None)
+dst_strides = (ctypes.c_int * 4)(w, w, w, 0)
+
+lib.swscale_process(ctx, src_ptrs, src_strides, dst_ptrs, dst_strides)
+lib.swscale_destroy(ctx)
+
+r = rgb[:, :, 0].astype(np.int32)
+g = rgb[:, :, 1].astype(np.int32)
+b = rgb[:, :, 2].astype(np.int32)
+
+# FFmpeg C template formula in input.c:
+# y = (ry*r + gy*g + by*b + (33 << (SHIFT-1))) >> SHIFT (with SHIFT=15 or 16)
+ry, gy, by = 8419, 16530, 3209
+ru, gu, bu = -4859, -9514, 14382
+rv, gv, bv = 14382, -12049, -2330
+
+y_calc = (((ry*r + gy*g + by*b + (1 << 14)) >> 15) + 16).clip(0, 255).astype(np.uint8)
+u_calc = (((ru*r + gu*g + bu*b + (1 << 14)) >> 15) + 128).clip(0, 255).astype(np.uint8)
+v_calc = (((rv*r + gv*g + bv*b + (1 << 14)) >> 15) + 128).clip(0, 255).astype(np.uint8)
+
+diff_y = np.max(np.abs(dst_y.astype(int) - y_calc.astype(int)))
+diff_u = np.max(np.abs(dst_u.astype(int) - u_calc.astype(int)))
+diff_v = np.max(np.abs(dst_v.astype(int) - v_calc.astype(int)))
+
+print("Exact diffs with input.c coeffs:")
+print("Y max diff:", diff_y)
+print("U max diff:", diff_u)
+print("V max diff:", diff_v)
+
