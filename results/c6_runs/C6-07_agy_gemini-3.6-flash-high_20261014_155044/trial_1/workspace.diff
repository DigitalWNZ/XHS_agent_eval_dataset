diff --git a/swscale-impl/test_planar_scale.py b/swscale-impl/test_planar_scale.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/test_planar_scale.py
@@ -0,0 +1,174 @@
+import sys
+import ctypes
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int] * 7
+lib.swscale_process.restype = ctypes.c_int
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+lib.swscale_destroy.argtypes = [ctypes.c_void_p]
+
+def init_filter(src_len, dst_len, flags, is_vert):
+    one = 4096 if is_vert else 16384
+    x_inc = int((src_len * 65536) // dst_len)
+    
+    if flags == workloads.NEAREST:
+        filter_size = 1
+        pos = np.zeros(dst_len, dtype=int)
+        weights = np.ones((dst_len, 1), dtype=np.int32) * one
+        x_dst_in_src = (x_inc >> 1)
+        for i in range(dst_len):
+            xx = int(x_dst_in_src >> 16)
+            pos[i] = max(0, min(src_len - 1, xx))
+            x_dst_in_src += x_inc
+        return pos, weights, filter_size
+
+    size_factor = 4 if flags == workloads.BICUBIC else 2
+    if x_inc <= 65536:
+        filter_size = 1 + size_factor
+    else:
+        filter_size = 1 + (size_factor * src_len + dst_len - 1) // dst_len
+        
+    filter_size = min(filter_size, src_len)
+    filter_size = max(filter_size, 1)
+    
+    pos = np.zeros(dst_len, dtype=int)
+    raw_filter = np.zeros((dst_len, filter_size), dtype=np.int64)
+    
+    fone = 1 << 14
+    # Exact FFmpeg initial xDstInSrc for srcPos=0, dstPos=0:
+    x_dst_in_src = 0
+    
+    for i in range(dst_len):
+        xx = (x_dst_in_src - (filter_size - 2) * (1 << 16)) // (1 << 17)
+        pos[i] = xx
+        
+        for j in range(filter_size):
+            d = abs((xx * (1 << 17)) - x_dst_in_src) << 13
+            if x_inc > 65536:
+                d = (d * dst_len) // src_len
+            floatd = d * (1.0 / (1 << 30))
+            
+            if flags == workloads.BICUBIC:
+                B, C = 0.0, 0.6
+                if floatd >= 2.0:
+                    coeff = 0.0
+                elif floatd < 1.0:
+                    coeff = (12 - 9*B - 6*C) * (floatd**3) + (-18 + 12*B + 6*C) * (floatd**2) + (6 - 2*B)
+                    coeff /= 6.0
+                else:
+                    coeff = (-B - 6*C) * (floatd**3) + (6*B + 30*C) * (floatd**2) + (-12*B - 48*C) * floatd + (8*B + 24*C)
+                    coeff /= 6.0
+            else: # BILINEAR
+                coeff = max(0.0, 1.0 - floatd)
+                
+            raw_filter[i, j] = int(coeff * fone)
+            xx += 1
+            
+        x_dst_in_src += 2 * x_inc
+
+    # Fix borders
+    for i in range(dst_len):
+        if pos[i] < 0:
+            for j in range(1, filter_size):
+                left = max(j + pos[i], 0)
+                raw_filter[i, left] += raw_filter[i, j]
+                raw_filter[i, j] = 0
+            pos[i] = 0
+            
+        if pos[i] + filter_size > src_len:
+            shift = pos[i] + min(filter_size - src_len, 0)
+            acc = 0
+            for j in range(filter_size - 1, -1, -1):
+                if pos[i] + j >= src_len:
+                    acc += raw_filter[i, j]
+                    raw_filter[i, j] = 0
+            for j in range(filter_size - 1, -1, -1):
+                if j < shift:
+                    raw_filter[i, j] = 0
+                else:
+                    raw_filter[i, j] = raw_filter[i, j - shift]
+            pos[i] -= shift
+            last_idx = min(filter_size - 1, src_len - 1 - pos[i])
+            raw_filter[i, last_idx] += acc
+
+    # Normalize & store
+    out_weights = np.zeros((dst_len, filter_size), dtype=np.int16)
+    for i in range(dst_len):
+        sum_v = np.sum(raw_filter[i])
+        sum_v = (sum_v + one // 2) // one
+        if sum_v == 0:
+            sum_v = 1
+        error = 0
+        for j in range(filter_size):
+            v = raw_filter[i, j] + error
+            int_v = (v + sum_v // 2) // sum_v if v >= 0 else (v - sum_v // 2) // sum_v
+            out_weights[i, j] = int_v
+            error = v - int_v * sum_v
+
+    return pos, out_weights, filter_size
+
+def scale_plane_single(src_plane, dst_w, dst_h, algo):
+    src_h, src_w = src_plane.shape
+    h_pos, h_weights, h_size = init_filter(src_w, dst_w, algo, is_vert=False)
+    v_pos, v_weights, v_size = init_filter(src_h, dst_h, algo, is_vert=True)
+    
+    tmp = np.zeros((src_h, dst_w), dtype=np.int32)
+    for x in range(dst_w):
+        start_x = h_pos[x]
+        for j in range(h_size):
+            sx = start_x + j
+            w_val = h_weights[x, j]
+            tmp[:, x] += src_plane[:, sx].astype(np.int32) * w_val
+            
+    calc_out = np.zeros((dst_h, dst_w), dtype=np.int32)
+    for y in range(dst_h):
+        start_y = v_pos[y]
+        for j in range(v_size):
+            sy = start_y + j
+            w_val = v_weights[y, j]
+            calc_out[y, :] += tmp[sy, :] * w_val
+            
+    return np.clip((calc_out + (1 << 25)) >> 26, 0, 255).astype(np.uint8)
+
+# Test RGB24 1280x720 -> 640x360 BILINEAR
+sw, sh = 1280, 720
+dw, dh = 640, 360
+algo = workloads.BILINEAR
+
+ctx = lib.swscale_create(sw, sh, workloads.RGB24, dw, dh, workloads.RGB24, algo)
+np.random.seed(42)
+rgb_in = np.random.randint(0, 256, (sh, sw, 3), dtype=np.uint8)
+ref_out = np.zeros((dh, dw, 3), dtype=np.uint8)
+
+src_ptrs = (ctypes.c_char_p * 4)(rgb_in.ctypes.data, None, None, None)
+src_strides = (ctypes.c_int * 4)(sw * 3, 0, 0, 0)
+dst_ptrs = (ctypes.c_char_p * 4)(ref_out.ctypes.data, None, None, None)
+dst_strides = (ctypes.c_int * 4)(dw * 3, 0, 0, 0)
+
+lib.swscale_process(ctx, src_ptrs, src_strides, dst_ptrs, dst_strides)
+lib.swscale_destroy(ctx)
+
+# Unpack planes R, G, B
+r_scaled = scale_plane_single(rgb_in[:, :, 0], dw, dh, algo)
+g_scaled = scale_plane_single(rgb_in[:, :, 1], dw, dh, algo)
+b_scaled = scale_plane_single(rgb_in[:, :, 2], dw, dh, algo)
+
+calc_rgb = np.stack([r_scaled, g_scaled, b_scaled], axis=-1)
+
+mse = np.mean((ref_out.astype(float) - calc_rgb.astype(float))**2)
+psnr_val = 10 * np.log10(255**2 / mse) if mse > 0 else 100.0
+
+diff = np.max(np.abs(ref_out.astype(int) - calc_rgb.astype(int)))
+
+print(f"Planar-based RGB24 scaling PSNR: {psnr_val:.2f} dB (MSE: {mse:.4f}, Max diff: {diff})")
