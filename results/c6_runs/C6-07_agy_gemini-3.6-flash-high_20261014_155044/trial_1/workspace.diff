+inline fn rgbToYuvPixel(r: u8, g: u8, b: u8) [3]u8 {
+    const rf: i32 = r;
+    const gf: i32 = g;
+    const bf: i32 = b;
+
+    const y: i32 = ((8414 * rf + 16519 * gf + 3208 * bf + 16384) >> 15) + 16;
+    const u: i32 = ((-4865 * rf - 9528 * gf + 14392 * bf + 16384) >> 15) + 128;
+    const v: i32 = ((14392 * rf - 12061 * gf - 2332 * bf + 16384) >> 15) + 128;
+
+    return .{
+        @intCast(std.math.clamp(y, 0, 255)),
+        @intCast(std.math.clamp(u, 0, 255)),
+        @intCast(std.math.clamp(v, 0, 255)),
+    };
+}
