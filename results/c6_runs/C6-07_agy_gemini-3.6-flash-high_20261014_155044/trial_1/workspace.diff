+
+def run_conversion(src_fmt, dst_fmt, sw, sh, dw, dh, algo, src_planes):
+    ctx = lib.swscale_create(sw, sh, src_fmt, dw, dh, dst_fmt, algo)
+    
+    # Prepare dst planes
+    dst_sizes = workloads.plane_sizes(dst_fmt, dw, dh)
+    dst_bufs = [np.zeros(size, dtype=np.uint8) for size in dst_sizes]
+    
+    src_ptrs = (ctypes.c_char_p * 4)()
+    src_strides = (ctypes.c_int * 4)()
+    for i, p in enumerate(src_planes):
+        src_ptrs[i] = p.ctypes.data
+        src_strides[i] = workloads.plane_row_bytes(src_fmt, sw, i)
+        
+    dst_ptrs = (ctypes.c_char_p * 4)()
+    dst_strides = (ctypes.c_int * 4)()
+    for i, b in enumerate(dst_bufs):
+        dst_ptrs[i] = b.ctypes.data
+        dst_strides[i] = workloads.plane_row_bytes(dst_fmt, dw, i)
+        
+    res = lib.swscale_process(ctx, src_ptrs, src_strides, dst_ptrs, dst_strides)
+    lib.swscale_destroy(ctx)
+    return res, dst_bufs
+
+# 1. YUV420P -> RGB24 (4x4)
+y = np.full((4, 4), 100, dtype=np.uint8)
+u = np.full((2, 2), 150, dtype=np.uint8)
+v = np.full((2, 2), 200, dtype=np.uint8)
+res, dst_bufs = run_conversion(workloads.YUV420P, workloads.RGB24, 4, 4, 4, 4, workloads.BILINEAR, [y, u, v])
+print("1. YUV420P(Y=100,U=150,V=200) -> RGB24:")
+rgb_out = dst_bufs[0].reshape((4, 4, 3))
+print("   RGB pixel[0,0]:", rgb_out[0, 0])
+
+# 2. RGB24(100, 150, 200) -> YUV420P
+rgb_in = np.zeros((4, 4, 3), dtype=np.uint8)
+rgb_in[:, :, 0] = 100 # R
+rgb_in[:, :, 1] = 150 # G
+rgb_in[:, :, 2] = 200 # B
+res, dst_bufs = run_conversion(workloads.RGB24, workloads.YUV420P, 4, 4, 4, 4, workloads.BILINEAR, [rgb_in])
+print("2. RGB24(R=100,G=150,B=200) -> YUV420P:")
+print("   Y:", dst_bufs[0].reshape((4, 4))[0, 0])
+print("   U:", dst_bufs[1].reshape((2, 2))[0, 0])
+print("   V:", dst_bufs[2].reshape((2, 2))[0, 0])
+
+# 3. RGB24(100, 150, 200) -> GRAY8
+res, dst_bufs = run_conversion(workloads.RGB24, workloads.GRAY8, 4, 4, 4, 4, workloads.BILINEAR, [rgb_in])
+print("3. RGB24(100,150,200) -> GRAY8:")
+print("   GRAY:", dst_bufs[0].reshape((4, 4))[0, 0])
+
+# 4. RGB24 4x4 -> 2x2 Scaling (BILINEAR)
+grid = np.arange(16, dtype=np.uint8).reshape((4, 4))
+grid_rgb = np.stack([grid*10, grid*10, grid*10], axis=-1)
+res, dst_bufs = run_conversion(workloads.RGB24, workloads.RGB24, 4, 4, 2, 2, workloads.BILINEAR, [grid_rgb])
+print("4. RGB24 4x4 -> 2x2 BILINEAR:")
+print("   Out:\n", dst_bufs[0].reshape((2, 2, 3))[:, :, 0])
+
+# 5. RGB24 4x4 -> 2x2 Scaling (NEAREST)
+res, dst_bufs = run_conversion(workloads.RGB24, workloads.RGB24, 4, 4, 2, 2, workloads.NEAREST, [grid_rgb])
+print("5. RGB24 4x4 -> 2x2 NEAREST:")
+print("   Out:\n", dst_bufs[0].reshape((2, 2, 3))[:, :, 0])
+
