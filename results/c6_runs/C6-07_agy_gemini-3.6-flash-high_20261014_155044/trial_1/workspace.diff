+    dst_v: [*]u8, dst_v_stride: usize,
+    w: usize, h: usize,
+) void {
+    for (0..h) |y_idx| {
+        const s_row = src_rgb + y_idx * src_stride;
+        const dy = dst_y + y_idx * dst_y_stride;
+        for (0..w) |x_idx| {
+            const s_off = x_idx * 3;
+            const yuv = rgbToYuvPixel(s_row[s_off + 0], s_row[s_off + 1], s_row[s_off + 2]);
+            dy[x_idx] = yuv[0];
+        }
+    }
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = @min(y0 + 1, h - 1);
+        const s_row0 = src_rgb + y0 * src_stride;
+        const s_row1 = src_rgb + y1 * src_stride;
+        const du = dst_u + cy * dst_u_stride;
+        const dv = dst_v + cy * dst_v_stride;
+        for (0..cw) |cx| {
+            const x0 = cx * 2;
+            const x1 = @min(x0 + 1, w - 1);
