--- /dev/null
+++ b/swscale-impl/get_baseline_context.c
@@ -0,0 +1,32 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define SWS_MAX_FILTER_SIZE 256
+#define HAVE_BIGENDIAN 0
+#define ARCH_X86 1
+#define ARCH_X86_64 1
+
+#include "/reference/ffmpeg-src/libswscale/swscale.h"
+#include "/reference/ffmpeg-src/libswscale/swscale_internal.h"
+
+void *swscale_create(int src_w, int src_h, int src_fmt,
+                     int dst_w, int dst_h, int dst_fmt,
+                     int algo);
+
+int main() {
+    void *ctx = swscale_create(1280, 720, 5, 640, 360, 5, 1);
+    printf("ctx: %p\n", ctx);
+    fflush(stdout);
+    if (!ctx) return 1;
+    SwsContext *c = (SwsContext *)ctx;
+    printf("hLumFilterSize: %d, vLumFilterSize: %d\n", c->hLumFilterSize, c->vLumFilterSize);
+    fflush(stdout);
+    printf("hLumFilterPos[0..4]: %d %d %d %d %d\n",
+           c->hLumFilterPos[0], c->hLumFilterPos[1], c->hLumFilterPos[2], c->hLumFilterPos[3], c->hLumFilterPos[4]);
+    fflush(stdout);
+    printf("hLumFilter[0..4]: %d %d %d %d %d\n",
+           c->hLumFilter[0], c->hLumFilter[1], c->hLumFilter[2], c->hLumFilter[3], c->hLumFilter[4]);
+    fflush(stdout);
+    return 0;
+}
