+++ b/swscale-impl/test_vert_avg.py
@@ -0,0 +1,81 @@
+import sys
+import ctypes
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int] * 7
+lib.swscale_process.restype = ctypes.c_int
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+lib.swscale_destroy.argtypes = [ctypes.c_void_p]
+
+w, h = 64, 64
+ctx = lib.swscale_create(w, h, workloads.YUV420P, w, h, workloads.RGB24, workloads.BILINEAR)
+
+np.random.seed(42)
+y = np.random.randint(0, 256, (h, w), dtype=np.uint8)
+u = np.random.randint(0, 256, (h//2, w//2), dtype=np.uint8)
+v = np.random.randint(0, 256, (h//2, w//2), dtype=np.uint8)
+
+dst_ref = np.zeros((h, w, 3), dtype=np.uint8)
+
+src_ptrs = (ctypes.c_char_p * 4)(y.ctypes.data, u.ctypes.data, v.ctypes.data, None)
+src_strides = (ctypes.c_int * 4)(w, w//2, w//2, 0)
+dst_ptrs = (ctypes.c_char_p * 4)(dst_ref.ctypes.data, None, None, None)
+dst_strides = (ctypes.c_int * 4)(w * 3, 0, 0, 0)
+
+lib.swscale_process(ctx, src_ptrs, src_strides, dst_ptrs, dst_strides)
+lib.swscale_destroy(ctx)
+
+# Construct U and V with vertical averaging on odd rows
+u_up = np.zeros((h, w), dtype=np.uint8)
+v_up = np.zeros((h, w), dtype=np.uint8)
+
+for row in range(h):
+    cy0 = row // 2
+    cy1 = min((row + 1) // 2, h//2 - 1)
+    if row % 2 == 0:
+        # Even row
+        u_row = u[cy0]
+        v_row = v[cy0]
+    else:
+        # Odd row: average of cy0 and cy1
+        u_row = ((u[cy0].astype(int) + u[cy1].astype(int) + 1) // 2).astype(np.uint8)
+        v_row = ((v[cy0].astype(int) + v[cy1].astype(int) + 1) // 2).astype(np.uint8)
+        
+    for col in range(w):
+        cx = col // 2
+        u_up[row, col] = u_row[cx]
+        v_up[row, col] = v_row[cx]
+
+# Apply yuv2rgb
+y_f = y.astype(np.int32)
+u_f = u_up.astype(np.int32) - 128
+v_f = v_up.astype(np.int32) - 128
+
+y_adj = (y_f - 16) * 76284
+
+r_calc = np.clip((y_adj + 104597 * v_f + 32768) >> 16, 0, 255).astype(np.uint8)
+g_calc = np.clip((y_adj - 25675 * u_f - 53279 * v_f + 32768) >> 16, 0, 255).astype(np.uint8)
+b_calc = np.clip((y_adj + 132201 * u_f + 32768) >> 16, 0, 255).astype(np.uint8)
+
+calc_rgb = np.stack([r_calc, g_calc, b_calc], axis=-1)
+
+mse = np.mean((dst_ref.astype(float) - calc_rgb.astype(float))**2)
+psnr_val = 10 * np.log10(255**2 / mse) if mse > 0 else 100.0
+
+diff_r = np.max(np.abs(dst_ref[:, :, 0].astype(int) - r_calc.astype(int)))
+diff_g = np.max(np.abs(dst_ref[:, :, 1].astype(int) - g_calc.astype(int)))
+diff_b = np.max(np.abs(dst_ref[:, :, 2].astype(int) - b_calc.astype(int)))
+
+print(f"YUV420P -> RGB24 FFmpeg Vertical Averaging: MSE={mse:.4f}, PSNR={psnr_val:.2f} dB")
+print(f"Max diffs: R={diff_r}, G={diff_g}, B={diff_b}")
