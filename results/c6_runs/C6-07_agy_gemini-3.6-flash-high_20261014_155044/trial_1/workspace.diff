+++ b/swscale-impl/test_scale_accuracy.py
@@ -0,0 +1,78 @@
+import sys
+import ctypes
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int] * 7
+lib.swscale_process.restype = ctypes.c_int
+lib.swscale_process.argtypes = [
+    ctypes.c_void_p,
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+lib.swscale_destroy.argtypes = [ctypes.c_void_p]
+
+# Test RGB24 640x480 -> 320x240 BILINEAR
+sw, sh = 640, 480
+dw, dh = 320, 240
+ctx = lib.swscale_create(sw, sh, workloads.RGB24, dw, dh, workloads.RGB24, workloads.BILINEAR)
+
+np.random.seed(42)
+rgb = np.random.randint(0, 256, (sh, sw, 3), dtype=np.uint8)
+dst_ref = np.zeros((dh, dw, 3), dtype=np.uint8)
+
+src_ptrs = (ctypes.c_char_p * 4)(rgb.ctypes.data, None, None, None)
+src_strides = (ctypes.c_int * 4)(sw * 3, 0, 0, 0)
+dst_ptrs = (ctypes.c_char_p * 4)(dst_ref.ctypes.data, None, None, None)
+dst_strides = (ctypes.c_int * 4)(dw * 3, 0, 0, 0)
+
+lib.swscale_process(ctx, src_ptrs, src_strides, dst_ptrs, dst_strides)
+lib.swscale_destroy(ctx)
+
+# Implement Bilinear scaling in Python
+def bilinear_scale(src, dw, dh):
+    sh, sw, ch = src.shape
+    dst = np.zeros((dh, dw, ch), dtype=np.float64)
+    x_ratio = sw / dw
+    y_ratio = sh / dh
+    
+    for y in range(dh):
+        cy = (y + 0.5) * y_ratio - 0.5
+        y0 = int(np.floor(cy))
+        y1 = y0 + 1
+        fy = cy - y0
+        
+        y0_c = max(0, min(sh - 1, y0))
+        y1_c = max(0, min(sh - 1, y1))
+        
+        for x in range(dw):
+            cx = (x + 0.5) * x_ratio - 0.5
+            x0 = int(np.floor(cx))
+            x1 = x0 + 1
+            fx = cx - x0
+            
+            x0_c = max(0, min(sw - 1, x0))
+            x1_c = max(0, min(sw - 1, x1))
+            
+            p00 = src[y0_c, x0_c].astype(float)
+            p01 = src[y0_c, x1_c].astype(float)
+            p10 = src[y1_c, x0_c].astype(float)
+            p11 = src[y1_c, x1_c].astype(float)
+            
+            val = (1 - fy) * ((1 - fx) * p00 + fx * p01) + fy * ((1 - fx) * p10 + fx * p11)
+            dst[y, x] = np.clip(np.round(val), 0, 255)
+            
+    return dst.astype(np.uint8)
+
+dst_py = bilinear_scale(rgb, dw, dh)
+
+mse = np.mean((dst_ref.astype(float) - dst_py.astype(float))**2)
+psnr_val = 10 * np.log10(255**2 / mse) if mse > 0 else 100.0
+
+print(f"Bilinear scaling MSE: {mse:.4f}, PSNR: {psnr_val:.2f} dB")
