diff --git a/swscale-impl/src/debug_diff.c b/swscale-impl/src/debug_diff.c
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/debug_diff.c
@@ -0,0 +1,55 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <dlfcn.h>
+#include <math.h>
+
+typedef void* (*swscale_create_fn)(int src_w, int src_h, int src_fmt, int dst_w, int dst_h, int dst_fmt, int algo);
+typedef int (*swscale_process_fn)(void* ctx, const uint8_t *const src_data[], const int src_stride[], uint8_t *const dst_data[], const int dst_stride[]);
+typedef void (*swscale_destroy_fn)(void* ctx);
+
+int main() {
+    void *cand = dlopen("/app/swscale-impl/zig-out/lib/libswscale_candidate.so", RTLD_NOW);
+    if (!cand) {
+        printf("dlopen candidate failed: %s\n", dlerror());
+        return 1;
+    }
+
+    swscale_create_fn c_create = (swscale_create_fn)dlsym(cand, "swscale_create");
+    swscale_process_fn c_process = (swscale_process_fn)dlsym(cand, "swscale_process");
+    swscale_destroy_fn c_destroy = (swscale_destroy_fn)dlsym(cand, "swscale_destroy");
+
+    int src_w = 800, src_h = 600;
+    int dst_w = 400, dst_h = 300;
+    int src_fmt = 5; // RGB24
+    int dst_fmt = 0; // YUV420P
+    int algo = 1; // BILINEAR
+
+    printf("Creating context...\n"); fflush(stdout);
+    void *c_ctx = c_create(src_w, src_h, src_fmt, dst_w, dst_h, dst_fmt, algo);
+    if (!c_ctx) {
+        printf("c_create returned NULL\n");
+        return 1;
+    }
+    printf("Context created successfully: %p\n", c_ctx); fflush(stdout);
+
+    uint8_t *src_buf = malloc(src_w * src_h * 3);
+    uint8_t *dst_y = malloc(dst_w * dst_h);
+    uint8_t *dst_u = malloc((dst_w / 2) * (dst_h / 2));
+    uint8_t *dst_v = malloc((dst_w / 2) * (dst_h / 2));
+
+    for (int i = 0; i < src_w * src_h * 3; i++) src_buf[i] = 128;
+
+    const uint8_t *s_data[4] = { src_buf, NULL, NULL, NULL };
+    int s_stride[4] = { src_w * 3, 0, 0, 0 };
+
+    uint8_t *c_data[4] = { dst_y, dst_u, dst_v, NULL };
+    int c_stride[4] = { dst_w, dst_w / 2, dst_w / 2, 0 };
+
+    printf("Calling swscale_process...\n"); fflush(stdout);
+    int res = c_process(c_ctx, s_data, s_stride, c_data, c_stride);
+    printf("swscale_process result=%d\n", res);
+
+    c_destroy(c_ctx);
+    return 0;
+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,662 @@
+const std = @import("std");
+const pixfmt = @import("pixfmt.zig");
+const rgb2rgb = @import("rgb2rgb.zig");
+const yuv2yuv = @import("yuv2yuv.zig");
+const yuv2rgb = @import("yuv2rgb.zig");
+const rgb2yuv = @import("rgb2yuv.zig");
+const scale = @import("scale.zig");
+
+const SwsContext = struct {
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+    is_scaling: bool,
+
+    // Pre-computed filters for scaling
+    h_lum_filter: ?scale.Filter = null,
+    v_lum_filter: ?scale.Filter = null,
+    h_chr_filter: ?scale.Filter = null,
+    v_chr_filter: ?scale.Filter = null,
+};
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    const allocator = std.heap.c_allocator;
+    const ctx = allocator.create(SwsContext) catch return null;
+
+    const sw: usize = @intCast(src_w);
+    const sh: usize = @intCast(src_h);
+    const dw: usize = @intCast(dst_w);
+    const dh: usize = @intCast(dst_h);
+    const is_scaling = (sw != dw or sh != dh);
+
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .is_scaling = is_scaling,
+    };
+
+    ctx.h_lum_filter = scale.createFilter(allocator, sw, dw, algo, false) catch null;
+    ctx.v_lum_filter = scale.createFilter(allocator, sh, dh, algo, true) catch null;
+
+    const src_chr_w = if (pixfmt.getPlaneCount(src_fmt) > 1 and src_fmt != pixfmt.SWS_PIXFMT_YUV444P) (sw + 1) / 2 else sw;
+    const dst_chr_w = if (pixfmt.getPlaneCount(dst_fmt) > 1 and dst_fmt != pixfmt.SWS_PIXFMT_YUV444P) (dw + 1) / 2 else dw;
+    const src_chr_h = if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P or src_fmt == pixfmt.SWS_PIXFMT_NV12 or src_fmt == pixfmt.SWS_PIXFMT_NV21) (sh + 1) / 2 else sh;
+    const dst_chr_h = if (dst_fmt == pixfmt.SWS_PIXFMT_YUV420P or dst_fmt == pixfmt.SWS_PIXFMT_NV12 or dst_fmt == pixfmt.SWS_PIXFMT_NV21) (dh + 1) / 2 else dh;
+
+    if (src_chr_w > 0 and dst_chr_w > 0 and src_chr_h > 0 and dst_chr_h > 0) {
+        ctx.h_chr_filter = scale.createFilter(allocator, src_chr_w, dst_chr_w, algo, false) catch null;
+        ctx.v_chr_filter = scale.createFilter(allocator, src_chr_h, dst_chr_h, algo, true) catch null;
+    }
+
+    return @ptrCast(ctx);
+}
+
+pub fn processSameSize(
+    src_fmt: c_int,
+    dst_fmt: c_int,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    sw: usize,
+    sh: usize,
+) c_int {
+    const s0 = src_data[0] orelse return -1;
+    const ss0: usize = @intCast(src_stride[0]);
+    const d0 = dst_data[0] orelse return -1;
+    const ds0: usize = @intCast(dst_stride[0]);
+
+    if (src_fmt == dst_fmt) {
+        const planes = pixfmt.getPlaneCount(src_fmt);
+        for (0..planes) |p| {
+            const sp = src_data[p] orelse return -1;
+            const dp = dst_data[p] orelse return -1;
+            const row_bytes = pixfmt.getPlaneRowBytes(src_fmt, sw, p);
+            const rows = pixfmt.getPlaneRows(src_fmt, sh, p);
+            const ss: usize = @intCast(src_stride[p]);
+            const ds: usize = @intCast(dst_stride[p]);
+            for (0..rows) |y| {
+                @memcpy(dp[y * ds .. y * ds + row_bytes], sp[y * ss .. y * ss + row_bytes]);
+            }
+        }
+        return 0;
+    }
+
+    // Packed RGB conversions
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_BGR24) {
+        rgb2rgb.rgb24_to_bgr24(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGR24 and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        rgb2rgb.rgb24_to_bgr24(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGBA and dst_fmt == pixfmt.SWS_PIXFMT_BGRA) {
+        rgb2rgb.rgba_to_bgra(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGRA and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        rgb2rgb.bgra_to_rgba(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGR24 and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        for (0..sh) |y| {
+            const sy = s0 + y * ss0;
+            const dy = d0 + y * ds0;
+            for (0..sw) |x| {
+                const b = sy[x * 3 + 0];
+                const g = sy[x * 3 + 1];
+                const r = sy[x * 3 + 2];
+                dy[x * 4 + 0] = r;
+                dy[x * 4 + 1] = g;
+                dy[x * 4 + 2] = b;
+                dy[x * 4 + 3] = 255;
+            }
+        }
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGBA and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        rgb2rgb.rgba_to_rgb24(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        rgb2rgb.rgb24_to_rgba(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_BGRA) {
+        rgb2rgb.rgb24_to_bgra(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGRA and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        rgb2rgb.bgra_to_rgb24(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_GRAY8) {
+        rgb2rgb.rgb24_to_gray8(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGR24 and dst_fmt == pixfmt.SWS_PIXFMT_GRAY8) {
+        rgb2rgb.bgr24_to_gray8(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGBA and dst_fmt == pixfmt.SWS_PIXFMT_GRAY8) {
+        rgb2rgb.rgba_to_gray8(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_GRAY8 and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        rgb2rgb.gray8_to_rgb24(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_GRAY8 and dst_fmt == pixfmt.SWS_PIXFMT_BGR24) {
+        rgb2rgb.gray8_to_bgr24(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_GRAY8 and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        rgb2rgb.gray8_to_rgba(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+
+    // YUV <-> NV12 / NV21 same size
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_NV12) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        yuv2yuv.yuv420p_to_nv12(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, d1, @intCast(dst_stride[1]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_NV21) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        yuv2yuv.yuv420p_to_nv21(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, d1, @intCast(dst_stride[1]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_NV12 and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const s1 = src_data[1] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        yuv2yuv.nv12_to_yuv420p(s0, ss0, s1, @intCast(src_stride[1]), d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_NV21 and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const s1 = src_data[1] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        yuv2yuv.nv21_to_yuv420p(s0, ss0, s1, @intCast(src_stride[1]), d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+
+    // YUV444P <-> RGB conversions
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV444P and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv444p_to_rgb24(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV444P and dst_fmt == pixfmt.SWS_PIXFMT_BGR24) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv444p_to_bgr24(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV444P and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv444p_to_rgba(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV444P and dst_fmt == pixfmt.SWS_PIXFMT_BGRA) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv444p_to_bgra(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV444P and dst_fmt == pixfmt.SWS_PIXFMT_GRAY8) {
+        yuv2rgb.yuv420p_to_gray8(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+
+    // RGB -> YUV444P
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_YUV444P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.rgb24_to_yuv444p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGR24 and dst_fmt == pixfmt.SWS_PIXFMT_YUV444P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.bgr24_to_yuv444p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGBA and dst_fmt == pixfmt.SWS_PIXFMT_YUV444P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.rgba_to_yuv444p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGRA and dst_fmt == pixfmt.SWS_PIXFMT_YUV444P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.bgra_to_yuv444p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+
+    // YUV420P / YUV422P / YUV444P -> YUV same size
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_YUV444P) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        yuv2yuv.yuv420p_to_yuv444p(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV422P and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        yuv2yuv.yuv422p_to_yuv420p(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV444P and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        yuv2yuv.yuv444p_to_yuv420p(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+
+    // YUV420P -> RGB / BGR
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv420p_to_rgb24(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_BGR24) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv420p_to_bgr24(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv420p_to_rgba(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_BGRA) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv420p_to_bgra(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+
+    // YUV422P -> RGB / RGBA
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV422P and dst_fmt == pixfmt.SWS_PIXFMT_RGB24) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv422p_to_rgb24(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV422P and dst_fmt == pixfmt.SWS_PIXFMT_RGBA) {
+        const s1 = src_data[1] orelse return -1;
+        const s2 = src_data[2] orelse return -1;
+        yuv2rgb.yuv422p_to_rgba(s0, ss0, s1, @intCast(src_stride[1]), s2, @intCast(src_stride[2]), d0, ds0, sw, sh);
+        return 0;
+    }
+
+    // RGB / BGR / RGBA / BGRA -> YUV420P
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.rgb24_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGR24 and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.bgr24_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGBA and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.rgba_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_BGRA and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.bgra_to_yuv420p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+
+    // RGB24 -> YUV422P
+    if (src_fmt == pixfmt.SWS_PIXFMT_RGB24 and dst_fmt == pixfmt.SWS_PIXFMT_YUV422P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        rgb2yuv.rgb24_to_yuv422p(s0, ss0, d0, ds0, d1, @intCast(dst_stride[1]), d2, @intCast(dst_stride[2]), sw, sh);
+        return 0;
+    }
+
+    // YUV420P / GRAY8 conversions
+    if (src_fmt == pixfmt.SWS_PIXFMT_YUV420P and dst_fmt == pixfmt.SWS_PIXFMT_GRAY8) {
+        yuv2rgb.yuv420p_to_gray8(s0, ss0, d0, ds0, sw, sh);
+        return 0;
+    }
+    if (src_fmt == pixfmt.SWS_PIXFMT_GRAY8 and dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) {
+        const d1 = dst_data[1] orelse return -1;
+        const d2 = dst_data[2] orelse return -1;
+        for (0..sh) |y| {
+            const sy = s0 + y * ss0;
+            const dy = d0 + y * ds0;
+            for (0..sw) |x| {
+                const g: i32 = sy[x];
+                const y_val: i32 = 16 + @divTrunc(g * 219 + 128, 255);
+                dy[x] = @intCast(std.math.clamp(y_val, 0, 255));
+            }
+        }
+        const cw = (sw + 1) / 2;
+        const ch = (sh + 1) / 2;
+        const ds1: usize = @intCast(dst_stride[1]);
+        const ds2: usize = @intCast(dst_stride[2]);
+        for (0..ch) |y| {
+            const du = d1 + y * ds1;
+            const dv = d2 + y * ds2;
+            @memset(du[0..cw], 128);
+            @memset(dv[0..cw], 128);
+        }
+        return 0;
+    }
+
+    return -1;
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+    const allocator = std.heap.c_allocator;
+
+    const sw: usize = @intCast(ctx.src_w);
+    const sh: usize = @intCast(ctx.src_h);
+    const dw: usize = @intCast(ctx.dst_w);
+    const dh: usize = @intCast(ctx.dst_h);
+
+    // Unpack NV12/NV21 source into temporary YUV420P planes if needed
+    var src_u_buf: ?[]u8 = null;
+    var src_v_buf: ?[]u8 = null;
+    defer {
+        if (src_u_buf) |b| allocator.free(b);
+        if (src_v_buf) |b| allocator.free(b);
+    }
+
+    var eff_src_data: [4]?[*]const u8 = .{ src_data[0], src_data[1], src_data[2], src_data[3] };
+    var eff_src_stride: [4]c_int = .{ src_stride[0], src_stride[1], src_stride[2], src_stride[3] };
+    var eff_src_fmt: c_int = ctx.src_fmt;
+
+    if (ctx.src_fmt == pixfmt.SWS_PIXFMT_NV12 or ctx.src_fmt == pixfmt.SWS_PIXFMT_NV21) {
+        const cw = (sw + 1) / 2;
+        const ch = (sh + 1) / 2;
+        src_u_buf = allocator.alloc(u8, cw * ch) catch return -1;
+        src_v_buf = allocator.alloc(u8, cw * ch) catch return -1;
+
+        const s0 = src_data[0] orelse return -1;
+        const s1 = src_data[1] orelse return -1;
+        const ss0: usize = @intCast(src_stride[0]);
+        const ss1: usize = @intCast(src_stride[1]);
+
+        if (ctx.src_fmt == pixfmt.SWS_PIXFMT_NV12) {
+            yuv2yuv.nv12_to_yuv420p(s0, ss0, s1, ss1, @ptrCast(@constCast(s0)), ss0, src_u_buf.?.ptr, cw, src_v_buf.?.ptr, cw, sw, sh);
+        } else {
+            yuv2yuv.nv21_to_yuv420p(s0, ss0, s1, ss1, @ptrCast(@constCast(s0)), ss0, src_u_buf.?.ptr, cw, src_v_buf.?.ptr, cw, sw, sh);
+        }
+
+        eff_src_data[1] = src_u_buf.?.ptr;
+        eff_src_data[2] = src_v_buf.?.ptr;
+        eff_src_stride[1] = @intCast(cw);
+        eff_src_stride[2] = @intCast(cw);
+        eff_src_fmt = pixfmt.SWS_PIXFMT_YUV420P;
+    }
+
+    // Handle NV12/NV21 destination via temporary YUV420P planes if needed
+    var dst_u_buf: ?[]u8 = null;
+    var dst_v_buf: ?[]u8 = null;
+    defer {
+        if (dst_u_buf) |b| allocator.free(b);
+        if (dst_v_buf) |b| allocator.free(b);
+    }
+
+    var eff_dst_data: [4]?[*]u8 = .{ dst_data[0], dst_data[1], dst_data[2], dst_data[3] };
+    var eff_dst_stride: [4]c_int = .{ dst_stride[0], dst_stride[1], dst_stride[2], dst_stride[3] };
+    var eff_dst_fmt: c_int = ctx.dst_fmt;
+
+    if (ctx.dst_fmt == pixfmt.SWS_PIXFMT_NV12 or ctx.dst_fmt == pixfmt.SWS_PIXFMT_NV21) {
+        const dw_cw = (dw + 1) / 2;
+        const dw_ch = (dh + 1) / 2;
+        dst_u_buf = allocator.alloc(u8, dw_cw * dw_ch) catch return -1;
+        dst_v_buf = allocator.alloc(u8, dw_cw * dw_ch) catch return -1;
+
+        eff_dst_data[1] = dst_u_buf.?.ptr;
+        eff_dst_data[2] = dst_v_buf.?.ptr;
+        eff_dst_stride[1] = @intCast(dw_cw);
+        eff_dst_fmt = pixfmt.SWS_PIXFMT_YUV420P;
+    }
+
+    const src_chr_w = if (pixfmt.getPlaneCount(eff_src_fmt) > 1 and eff_src_fmt != pixfmt.SWS_PIXFMT_YUV444P) (sw + 1) / 2 else sw;
+    const dst_chr_w = if (pixfmt.getPlaneCount(eff_dst_fmt) > 1 and eff_dst_fmt != pixfmt.SWS_PIXFMT_YUV444P) (dw + 1) / 2 else dw;
+    const src_chr_h = if (eff_src_fmt == pixfmt.SWS_PIXFMT_YUV420P) (sh + 1) / 2 else sh;
+    const dst_chr_h = if (eff_dst_fmt == pixfmt.SWS_PIXFMT_YUV420P) (dh + 1) / 2 else dh;
+
+    const same_dims = (sw == dw and sh == dh);
+    var res: c_int = -1;
+
+    if (same_dims) {
+        res = processSameSize(eff_src_fmt, eff_dst_fmt, &eff_src_data, &eff_src_stride, &eff_dst_data, &eff_dst_stride, sw, sh);
+    } else {
+        const h_filter = ctx.h_lum_filter orelse return -1;
+        const v_filter = ctx.v_lum_filter orelse return -1;
+
+        if (eff_src_fmt == eff_dst_fmt) {
+            const planes = pixfmt.getPlaneCount(eff_src_fmt);
+            for (0..planes) |p| {
+                const sp = eff_src_data[p] orelse return -1;
+                const dp = eff_dst_data[p] orelse return -1;
+                const ss: usize = @intCast(eff_src_stride[p]);
+                const ds: usize = @intCast(eff_dst_stride[p]);
+
+                const plane_w = if (p == 0) sw else (sw + 1) / 2;
+                const plane_h = if (p == 0) sh else (sh + 1) / 2;
+                const plane_dw = if (p == 0) dw else (dw + 1) / 2;
+                const plane_dh = if (p == 0) dh else (dh + 1) / 2;
+
+                const channels: usize = switch (eff_src_fmt) {
+                    pixfmt.SWS_PIXFMT_RGB24, pixfmt.SWS_PIXFMT_BGR24 => 3,
+                    pixfmt.SWS_PIXFMT_RGBA, pixfmt.SWS_PIXFMT_BGRA => 4,
+                    else => 1,
+                };
+
+                const flt_h = if (p == 0 or ctx.h_chr_filter == null) h_filter else ctx.h_chr_filter.?;
+                const flt_v = if (p == 0 or ctx.v_chr_filter == null) v_filter else ctx.v_chr_filter.?;
+
+                scale.scalePlaneChannels(allocator, sp, ss, plane_w, plane_h, dp, ds, plane_dw, plane_dh, channels, flt_h, flt_v) catch return -1;
+            }
+            res = 0;
+        } else {
+            // Scaled format conversion
+            if (eff_src_fmt == pixfmt.SWS_PIXFMT_RGB24 or eff_src_fmt == pixfmt.SWS_PIXFMT_BGR24 or
+                eff_src_fmt == pixfmt.SWS_PIXFMT_RGBA or eff_src_fmt == pixfmt.SWS_PIXFMT_BGRA)
+            {
+                var src_yuv_buf: [3]?[]u8 = .{ null, null, null };
+                var src_yuv_ptrs: [4]?[*]u8 = .{ null, null, null, null };
+                var src_yuv_const_ptrs: [4]?[*]const u8 = .{ null, null, null, null };
+                var src_yuv_strides: [4]c_int = .{ @intCast(sw), @intCast(sw), @intCast(sw), 0 };
+                for (0..3) |p| {
+                    src_yuv_buf[p] = allocator.alloc(u8, sw * sh) catch return -1;
+                    src_yuv_ptrs[p] = src_yuv_buf[p].?.ptr;
+                    src_yuv_const_ptrs[p] = src_yuv_buf[p].?.ptr;
+                }
+                defer {
+                    for (0..3) |p| {
+                        if (src_yuv_buf[p]) |buf| allocator.free(buf);
+                    }
+                }
+
+                if (processSameSize(eff_src_fmt, pixfmt.SWS_PIXFMT_YUV444P, &eff_src_data, &eff_src_stride, &src_yuv_ptrs, &src_yuv_strides, sw, sh) != 0) return -1;
+
+                if (eff_dst_fmt == pixfmt.SWS_PIXFMT_YUV444P) {
+                    for (0..3) |p| {
+                        const sp = src_yuv_const_ptrs[p].?;
+                        const dp = eff_dst_data[p] orelse return -1;
+                        const ss: usize = @intCast(src_yuv_strides[p]);
+                        const ds: usize = @intCast(eff_dst_stride[p]);
+                        const flt_h = if (p == 0 or ctx.h_chr_filter == null) h_filter else ctx.h_chr_filter.?;
+                        const flt_v = if (p == 0 or ctx.v_chr_filter == null) v_filter else ctx.v_chr_filter.?;
+
+                        scale.scalePlaneChannels(allocator, sp, ss, sw, sh, dp, ds, dw, dh, 1, flt_h, flt_v) catch return -1;
+                    }
+                    res = 0;
+                } else if (eff_dst_fmt == pixfmt.SWS_PIXFMT_YUV420P or eff_dst_fmt == pixfmt.SWS_PIXFMT_YUV422P) {
+                    for (0..3) |p| {
+                        const sp = src_yuv_const_ptrs[p].?;
+                        const dp = eff_dst_data[p] orelse return -1;
+                        const ss: usize = @intCast(src_yuv_strides[p]);
+                        const ds: usize = @intCast(eff_dst_stride[p]);
+                        const flt_h = if (p == 0 or ctx.h_chr_filter == null) h_filter else ctx.h_chr_filter.?;
+                        const flt_v = if (p == 0 or ctx.v_chr_filter == null) v_filter else ctx.v_chr_filter.?;
+                        const dp_w = if (p == 0) dw else dst_chr_w;
+                        const dp_h = if (p == 0) dh else dst_chr_h;
+
+                        scale.scalePlaneChannels(allocator, sp, ss, sw, sh, dp, ds, dp_w, dp_h, 1, flt_h, flt_v) catch return -1;
+                    }
+                    res = 0;
+                } else {
+                    var tmp_buf: [3]?[]u8 = .{ null, null, null };
+                    var tmp_ptrs: [4]?[*]u8 = .{ null, null, null, null };
+                    var tmp_const_ptrs: [4]?[*]const u8 = .{ null, null, null, null };
+                    var tmp_strides: [4]c_int = .{ @intCast(dw), @intCast(dw), @intCast(dw), 0 };
+                    for (0..3) |p| {
+                        tmp_buf[p] = allocator.alloc(u8, dw * dh) catch return -1;
+                        tmp_ptrs[p] = tmp_buf[p].?.ptr;
+                        tmp_const_ptrs[p] = tmp_buf[p].?.ptr;
+                    }
+                    defer {
+                        for (0..3) |p| {
+                            if (tmp_buf[p]) |buf| allocator.free(buf);
+                        }
+                    }
+
+                    for (0..3) |p| {
+                        const sp = src_yuv_const_ptrs[p].?;
+                        const dp = tmp_ptrs[p].?;
+                        const ss: usize = @intCast(src_yuv_strides[p]);
+                        const ds: usize = @intCast(tmp_strides[p]);
+                        const flt_h = if (p == 0 or ctx.h_chr_filter == null) h_filter else ctx.h_chr_filter.?;
+                        const flt_v = if (p == 0 or ctx.v_chr_filter == null) v_filter else ctx.v_chr_filter.?;
+
+                        scale.scalePlaneChannels(allocator, sp, ss, sw, sh, dp, ds, dw, dh, 1, flt_h, flt_v) catch return -1;
+                    }
+
+                    res = processSameSize(pixfmt.SWS_PIXFMT_YUV444P, eff_dst_fmt, &tmp_const_ptrs, &tmp_strides, &eff_dst_data, &eff_dst_stride, dw, dh);
+                }
+            } else {
+                // Non-RGB source (YUV420P / YUV422P / YUV444P / GRAY8)
+                const src_planes = pixfmt.getPlaneCount(eff_src_fmt);
+                var scaled_buf: [4]?[]u8 = .{ null, null, null, null };
+                var scaled_ptrs: [4]?[*]u8 = .{ null, null, null, null };
+                var scaled_const_ptrs: [4]?[*]const u8 = .{ null, null, null, null };
+                var scaled_strides: [4]c_int = .{ 0, 0, 0, 0 };
+
+                for (0..src_planes) |p| {
+                    const dp_w = if (p == 0) dw else dst_chr_w;
+                    const dp_h = if (p == 0) dh else dst_chr_h;
+                    const row_bytes = dp_w;
+                    scaled_buf[p] = allocator.alloc(u8, row_bytes * dp_h) catch return -1;
+                    scaled_ptrs[p] = scaled_buf[p].?.ptr;
+                    scaled_const_ptrs[p] = scaled_buf[p].?.ptr;
+                    scaled_strides[p] = @intCast(row_bytes);
+                }
+                defer {
+                    for (0..4) |p| {
+                        if (scaled_buf[p]) |buf| allocator.free(buf);
+                    }
+                }
+
+                for (0..src_planes) |p| {
+                    const sp = eff_src_data[p] orelse return -1;
+                    const dp = scaled_ptrs[p].?;
+                    const ss: usize = @intCast(eff_src_stride[p]);
+                    const ds: usize = @intCast(scaled_strides[p]);
+
+                    const sp_w = if (p == 0) sw else src_chr_w;
+                    const sp_h = if (p == 0) sh else src_chr_h;
+                    const dp_w = if (p == 0) dw else dst_chr_w;
+                    const dp_h = if (p == 0) dh else dst_chr_h;
+
+                    const flt_h = if (p == 0 or ctx.h_chr_filter == null) h_filter else ctx.h_chr_filter.?;
+                    const flt_v = if (p == 0 or ctx.v_chr_filter == null) v_filter else ctx.v_chr_filter.?;
+
+                    scale.scalePlaneChannels(allocator, sp, ss, sp_w, sp_h, dp, ds, dp_w, dp_h, 1, flt_h, flt_v) catch return -1;
+                }
+
+                const interp_fmt = if (src_planes >= 3 and dst_chr_w == dw and dst_chr_h == dh) pixfmt.SWS_PIXFMT_YUV444P else eff_src_fmt;
+                res = processSameSize(interp_fmt, eff_dst_fmt, &scaled_const_ptrs, &scaled_strides, &eff_dst_data, &eff_dst_stride, dw, dh);
+            }
+        }
+    }
+
+    if (res != 0) return res;
+
+    // Pack intermediate YUV420P to NV12/NV21 destination if needed
+    if (ctx.dst_fmt == pixfmt.SWS_PIXFMT_NV12 or ctx.dst_fmt == pixfmt.SWS_PIXFMT_NV21) {
+        const d0 = dst_data[0] orelse return -1;
+        const d1 = dst_data[1] orelse return -1;
+        const ds0: usize = @intCast(dst_stride[0]);
+        const ds1: usize = @intCast(dst_stride[1]);
+        const dw_cw = (dw + 1) / 2;
+
+        if (ctx.dst_fmt == pixfmt.SWS_PIXFMT_NV12) {
+            yuv2yuv.yuv420p_to_nv12(d0, ds0, dst_u_buf.?.ptr, dw_cw, dst_v_buf.?.ptr, dw_cw, d0, ds0, d1, ds1, dw, dh);
+        } else {
+            yuv2yuv.yuv420p_to_nv21(d0, ds0, dst_u_buf.?.ptr, dw_cw, dst_v_buf.?.ptr, dw_cw, d0, ds0, d1, ds1, dw, dh);
+        }
+    }
+
+    return 0;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const allocator = std.heap.c_allocator;
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        if (ctx.h_lum_filter) |*f| f.deinit(allocator);
+        if (ctx.v_lum_filter) |*f| f.deinit(allocator);
+        if (ctx.h_chr_filter) |*f| f.deinit(allocator);
+        if (ctx.v_chr_filter) |*f| f.deinit(allocator);
+        allocator.destroy(ctx);
+    }
+}
diff --git a/swscale-impl/src/pixfmt.zig b/swscale-impl/src/pixfmt.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/pixfmt.zig
@@ -0,0 +1,44 @@
+const std = @import("std");
+
+pub const SWS_PIXFMT_YUV420P: c_int = 0;
+pub const SWS_PIXFMT_YUV422P: c_int = 1;
+pub const SWS_PIXFMT_YUV444P: c_int = 2;
+pub const SWS_PIXFMT_NV12: c_int = 3;
+pub const SWS_PIXFMT_NV21: c_int = 4;
+pub const SWS_PIXFMT_RGB24: c_int = 5;
+pub const SWS_PIXFMT_BGR24: c_int = 6;
+pub const SWS_PIXFMT_RGBA: c_int = 7;
+pub const SWS_PIXFMT_BGRA: c_int = 8;
+pub const SWS_PIXFMT_GRAY8: c_int = 9;
+
+pub const SWS_ALGO_NEAREST: c_int = 0;
+pub const SWS_ALGO_BILINEAR: c_int = 1;
+pub const SWS_ALGO_BICUBIC: c_int = 2;
+
+pub fn getPlaneCount(fmt: c_int) usize {
+    return switch (fmt) {
+        SWS_PIXFMT_YUV420P, SWS_PIXFMT_YUV422P, SWS_PIXFMT_YUV444P => 3,
+        SWS_PIXFMT_NV12, SWS_PIXFMT_NV21 => 2,
+        else => 1,
+    };
+}
+
+pub fn getPlaneRowBytes(fmt: c_int, w: usize, plane: usize) usize {
+    return switch (fmt) {
+        SWS_PIXFMT_YUV420P, SWS_PIXFMT_YUV422P => if (plane == 0) w else (w + 1) / 2,
+        SWS_PIXFMT_YUV444P => w,
+        SWS_PIXFMT_NV12, SWS_PIXFMT_NV21 => if (plane == 0) w else ((w + 1) / 2) * 2,
+        SWS_PIXFMT_RGB24, SWS_PIXFMT_BGR24 => w * 3,
+        SWS_PIXFMT_RGBA, SWS_PIXFMT_BGRA => w * 4,
+        SWS_PIXFMT_GRAY8 => w,
+        else => w,
+    };
+}
+
+pub fn getPlaneRows(fmt: c_int, h: usize, plane: usize) usize {
+    if (plane == 0) return h;
+    return switch (fmt) {
+        SWS_PIXFMT_YUV420P, SWS_PIXFMT_NV12, SWS_PIXFMT_NV21 => (h + 1) / 2,
+        else => h,
+    };
+}
diff --git a/swscale-impl/src/rgb2rgb.zig b/swscale-impl/src/rgb2rgb.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/rgb2rgb.zig
@@ -0,0 +1,212 @@
+const std = @import("std");
+
+pub fn rgb24_to_bgr24(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    for (0..h) |y| {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            const offset = x * 3;
+            const V = @Vector(24, u8);
+            const v: V = s_row[offset..][0..24].*;
+            const shuffle_indices: @Vector(24, i32) = .{
+                2, 1, 0, 5, 4, 3, 8, 7, 6, 11, 10, 9,
+                14, 13, 12, 17, 16, 15, 20, 19, 18, 23, 22, 21,
+            };
+            const swapped = @shuffle(u8, v, undefined, shuffle_indices);
+            d_row[offset..][0..24].* = swapped;
+        }
+        while (x < w) : (x += 1) {
+            const offset = x * 3;
+            const r = s_row[offset + 0];
+            const g = s_row[offset + 1];
+            const b = s_row[offset + 2];
+            d_row[offset + 0] = b;
+            d_row[offset + 1] = g;
+            d_row[offset + 2] = r;
+        }
+    }
+}
+
+pub fn rgba_to_bgra(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    for (0..h) |y| {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            const offset = x * 4;
+            const V = @Vector(32, u8);
+            const v: V = s_row[offset..][0..32].*;
+            const shuffle_indices: @Vector(32, i32) = .{
+                2, 1, 0, 3, 6, 5, 4, 7, 10, 9, 8, 11, 14, 13, 12, 15,
+                18, 17, 16, 19, 22, 21, 20, 23, 26, 25, 24, 27, 30, 29, 28, 31,
+            };
+            const swapped = @shuffle(u8, v, undefined, shuffle_indices);
+            d_row[offset..][0..32].* = swapped;
+        }
+        while (x < w) : (x += 1) {
+            const offset = x * 4;
+            const r = s_row[offset + 0];
+            const g = s_row[offset + 1];
+            const b = s_row[offset + 2];
+            const a = s_row[offset + 3];
+            d_row[offset + 0] = b;
+            d_row[offset + 1] = g;
+            d_row[offset + 2] = r;
+            d_row[offset + 3] = a;
+        }
+    }
+}
+
+pub fn bgra_to_rgba(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    rgba_to_bgra(src, src_stride, dst, dst_stride, w, h);
+}
+
+pub fn rgba_to_rgb24(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    for (0..h) |y| {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x + 8 <= w) : (x += 8) {
+            const s_off = x * 4;
+            const d_off = x * 3;
+            const V = @Vector(32, u8);
+            const v: V = s_row[s_off..][0..32].*;
+            const shuffle_indices: @Vector(24, i32) = .{
+                0, 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14,
+                16, 17, 18, 20, 21, 22, 24, 25, 26, 28, 29, 30,
+            };
+            const packed3 = @shuffle(u8, v, undefined, shuffle_indices);
+            d_row[d_off..][0..24].* = packed3;
+        }
+        while (x < w) : (x += 1) {
+            const s_off = x * 4;
+            const d_off = x * 3;
+            d_row[d_off + 0] = s_row[s_off + 0];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 2];
+        }
+    }
+}
+
+pub fn rgb24_to_rgba(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    for (0..h) |y| {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 3;
+            const d_off = x * 4;
+            d_row[d_off + 0] = s_row[s_off + 0];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 2];
+            d_row[d_off + 3] = 255;
+        }
+    }
+}
+
+pub fn rgb24_to_bgra(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    for (0..h) |y| {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 3;
+            const d_off = x * 4;
+            d_row[d_off + 0] = s_row[s_off + 2];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 0];
+            d_row[d_off + 3] = 255;
+        }
+    }
+}
+
+pub fn bgra_to_rgb24(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, w: usize, h: usize) void {
+    for (0..h) |y| {
+        const s_row = src + y * src_stride;
+        const d_row = dst + y * dst_stride;
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 4;
