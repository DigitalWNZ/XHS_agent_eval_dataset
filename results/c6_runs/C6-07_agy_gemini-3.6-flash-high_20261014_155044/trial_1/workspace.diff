+pub fn rgb24_to_nv21(
+    src_rgb: [*]const u8, src_stride: usize,
+    dst_y: [*]u8, dst_y_stride: usize,
+    dst_uv: [*]u8, dst_uv_stride: usize,
+    w: usize, h: usize,
+) void {
+    for (0..h) |y_idx| {
+        const s_row = src_rgb + y_idx * src_stride;
+        const dy = dst_y + y_idx * dst_y_stride;
+        for (0..w) |x_idx| {
+            const s_off = x_idx * 3;
+            const yuv = rgbToYuvPixel(s_row[s_off + 0], s_row[s_off + 1], s_row[s_off + 2]);
+            dy[x_idx] = yuv[0];
+        }
+    }
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = @min(y0 + 1, h - 1);
+        const s_row0 = src_rgb + y0 * src_stride;
+        const s_row1 = src_rgb + y1 * src_stride;
+        const duv = dst_uv + cy * dst_uv_stride;
+        for (0..cw) |cx| {
+            const x0 = cx * 2;
+            const x1 = @min(x0 + 1, w - 1);
+
+            const yuv00 = rgbToYuvPixel(s_row0[x0 * 3 + 0], s_row0[x0 * 3 + 1], s_row0[x0 * 3 + 2]);
+            const yuv01 = rgbToYuvPixel(s_row0[x1 * 3 + 0], s_row0[x1 * 3 + 1], s_row0[x1 * 3 + 2]);
+            const yuv10 = rgbToYuvPixel(s_row1[x0 * 3 + 0], s_row1[x0 * 3 + 1], s_row1[x0 * 3 + 2]);
+            const yuv11 = rgbToYuvPixel(s_row1[x1 * 3 + 0], s_row1[x1 * 3 + 1], s_row1[x1 * 3 + 2]);
+
+            const u_sum: u32 = @as(u32, yuv00[1]) + yuv01[1] + yuv10[1] + yuv11[1];
+            const v_sum: u32 = @as(u32, yuv00[2]) + yuv01[2] + yuv10[2] + yuv11[2];
+
+            duv[cx * 2 + 0] = @truncate((v_sum + 2) >> 2);
+            duv[cx * 2 + 1] = @truncate((u_sum + 2) >> 2);
+        }
+    }
+}
+
+pub fn bgr24_to_nv21(
+    src_rgb: [*]const u8, src_stride: usize,
+    dst_y: [*]u8, dst_y_stride: usize,
+    dst_uv: [*]u8, dst_uv_stride: usize,
+    w: usize, h: usize,
+) void {
+    for (0..h) |y_idx| {
+        const s_row = src_rgb + y_idx * src_stride;
+        const dy = dst_y + y_idx * dst_y_stride;
+        for (0..w) |x_idx| {
+            const s_off = x_idx * 3;
+            const yuv = rgbToYuvPixel(s_row[s_off + 2], s_row[s_off + 1], s_row[s_off + 0]);
+            dy[x_idx] = yuv[0];
+        }
+    }
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = @min(y0 + 1, h - 1);
+        const s_row0 = src_rgb + y0 * src_stride;
+        const s_row1 = src_rgb + y1 * src_stride;
+        const duv = dst_uv + cy * dst_uv_stride;
+        for (0..cw) |cx| {
+            const x0 = cx * 2;
+            const x1 = @min(x0 + 1, w - 1);
+
+            const yuv00 = rgbToYuvPixel(s_row0[x0 * 3 + 2], s_row0[x0 * 3 + 1], s_row0[x0 * 3 + 0]);
+            const yuv01 = rgbToYuvPixel(s_row0[x1 * 3 + 2], s_row0[x1 * 3 + 1], s_row0[x1 * 3 + 0]);
+            const yuv10 = rgbToYuvPixel(s_row1[x0 * 3 + 2], s_row1[x0 * 3 + 1], s_row1[x0 * 3 + 0]);
+            const yuv11 = rgbToYuvPixel(s_row1[x1 * 3 + 2], s_row1[x1 * 3 + 1], s_row1[x1 * 3 + 0]);
+
+            const u_sum: u32 = @as(u32, yuv00[1]) + yuv01[1] + yuv10[1] + yuv11[1];
+            const v_sum: u32 = @as(u32, yuv00[2]) + yuv01[2] + yuv10[2] + yuv11[2];
+
+            duv[cx * 2 + 0] = @truncate((v_sum + 2) >> 2);
+            duv[cx * 2 + 1] = @truncate((u_sum + 2) >> 2);
+        }
+    }
+}
diff --git a/swscale-impl/src/scale.zig b/swscale-impl/src/scale.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/scale.zig
@@ -0,0 +1,336 @@
+const std = @import("std");
+const pixfmt = @import("pixfmt.zig");
+
+pub const Filter = struct {
+    pos: []i32,
+    weights: []i16,
+    filter_size: usize,
+    dst_len: usize,
+
+    pub fn deinit(self: *Filter, allocator: std.mem.Allocator) void {
+        allocator.free(self.pos);
+        allocator.free(self.weights);
+    }
+};
+
+pub fn createFilter(allocator: std.mem.Allocator, src_len: usize, dst_len: usize, algo: c_int, is_vert: bool) !Filter {
+    const one: i64 = if (is_vert) 4096 else 16384;
+    const x_inc: i64 = @divTrunc((@as(i64, @intCast(src_len)) << 16) + @as(i64, @intCast(dst_len >> 1)), @as(i64, @intCast(dst_len)));
+
+    // 1:1 unscaled
+    if (src_len == dst_len) {
+        const pos = try allocator.alloc(i32, dst_len);
+        const weights = try allocator.alloc(i16, dst_len);
+        for (0..dst_len) |i| {
+            pos[i] = @intCast(i);
+            weights[i] = @intCast(one);
+        }
+        return Filter{
+            .pos = pos,
+            .weights = weights,
+            .filter_size = 1,
+            .dst_len = dst_len,
+        };
+    }
+
+    if (algo == pixfmt.SWS_ALGO_NEAREST) {
+        const pos = try allocator.alloc(i32, dst_len);
+        const weights = try allocator.alloc(i16, dst_len);
+
+        const x_inc_i64: i64 = x_inc;
+        for (0..dst_len) |i| {
+            const xx = @divTrunc(@as(i64, @intCast(i)) * x_inc_i64 + 32768, 65536);
+            pos[i] = std.math.clamp(@as(i32, @intCast(xx)), 0, @as(i32, @intCast(src_len - 1)));
+            weights[i] = @intCast(one);
+        }
+
+        return Filter{
+            .pos = pos,
+            .weights = weights,
+            .filter_size = 1,
+            .dst_len = dst_len,
+        };
+    }
+
+    const size_factor: usize = if (algo == pixfmt.SWS_ALGO_BICUBIC) 4 else 2;
+    var filter_size: usize = if (x_inc <= 65536)
+        1 + size_factor
+    else
+        1 + (size_factor * src_len + dst_len - 1) / dst_len;
+
+    if (filter_size > src_len) filter_size = src_len;
+    if (filter_size < 1) filter_size = 1;
+
+    const pos = try allocator.alloc(i32, dst_len);
+    const weights = try allocator.alloc(i16, dst_len * filter_size);
+    const raw_filter = try allocator.alloc(i64, dst_len * filter_size);
+    defer allocator.free(raw_filter);
+    @memset(raw_filter, 0);
+
+    const fone: i64 = 1 << 14;
+    var x_dst_in_src: i64 = x_inc - 65536;
+
+    for (0..dst_len) |i| {
+        var xx: i64 = @divTrunc(x_dst_in_src - @as(i64, @intCast(filter_size - 2)) * 65536, 131072);
+        pos[i] = @intCast(xx);
+
+        for (0..filter_size) |j| {
+            var d: i64 = @intCast(@abs((xx * 131072) - x_dst_in_src));
+            if (x_inc > 65536) {
+                d = @divTrunc(d * @as(i64, @intCast(dst_len)), @as(i64, @intCast(src_len)));
+            }
+
+            const floatd: f64 = @as(f64, @floatFromInt(d)) * (1.0 / 131072.0);
+
+            var coeff: i64 = 0;
+            if (algo == pixfmt.SWS_ALGO_BICUBIC) {
+                var float_c: f64 = 0.0;
+                if (floatd < 1.0) {
+                    float_c = (8.4 * floatd * floatd * floatd - 14.4 * floatd * floatd + 6.0) / 6.0;
+                } else if (floatd < 2.0) {
+                    float_c = (-3.6 * floatd * floatd * floatd + 18.0 * floatd * floatd - 28.8 * floatd + 14.4) / 6.0;
+                }
+                coeff = @intFromFloat(float_c * @as(f64, @floatFromInt(fone)));
+            } else {
+                const float_c: f64 = @max(0.0, 1.0 - floatd);
+                coeff = @intFromFloat(float_c * @as(f64, @floatFromInt(fone)));
+            }
+
+            raw_filter[i * filter_size + j] = coeff;
+            xx += 1;
+        }
+
+        x_dst_in_src += 2 * x_inc;
+    }
+
+    // Fix borders
+    for (0..dst_len) |i| {
+        if (pos[i] < 0) {
+            for (1..filter_size) |j| {
+                const left_idx = @as(usize, @intCast(@max(@as(i32, @intCast(j)) + pos[i], 0)));
+                raw_filter[i * filter_size + left_idx] += raw_filter[i * filter_size + j];
+                raw_filter[i * filter_size + j] = 0;
+            }
+            pos[i] = 0;
+        }
+
+        if (pos[i] + @as(i32, @intCast(filter_size)) > @as(i32, @intCast(src_len))) {
+            const shift: i32 = pos[i] + @min(@as(i32, @intCast(filter_size)) - @as(i32, @intCast(src_len)), 0);
+            var acc: i64 = 0;
+
+            var j: usize = filter_size;
+            while (j > 0) {
+                j -= 1;
+                if (pos[i] + @as(i32, @intCast(j)) >= @as(i32, @intCast(src_len))) {
+                    acc += raw_filter[i * filter_size + j];
+                    raw_filter[i * filter_size + j] = 0;
+                }
+            }
+
+            j = filter_size;
+            while (j > 0) {
+                j -= 1;
+                if (@as(i32, @intCast(j)) < shift) {
+                    raw_filter[i * filter_size + j] = 0;
+                } else {
+                    const src_j = @as(usize, @intCast(@as(i32, @intCast(j)) - shift));
+                    raw_filter[i * filter_size + j] = raw_filter[i * filter_size + src_j];
+                }
+            }
+
+            pos[i] -= shift;
+            const last_idx = @as(usize, @intCast(@min(@as(i32, @intCast(filter_size - 1)), @as(i32, @intCast(src_len - 1)) - pos[i])));
+            raw_filter[i * filter_size + last_idx] += acc;
+        }
+    }
+
+    // Quantize with error diffusion to target sum 'one'
+    for (0..dst_len) |i| {
+        var raw_sum: i64 = 0;
+        for (0..filter_size) |j| {
+            raw_sum += raw_filter[i * filter_size + j];
+        }
+        if (raw_sum == 0) raw_sum = 1;
+
+        var error_val: i64 = 0;
+        for (0..filter_size) |j| {
+            const v = raw_filter[i * filter_size + j] * one + error_val;
+            const int_v = if (v >= 0)
+                @divTrunc(v + @divTrunc(raw_sum, 2), raw_sum)
+            else
+                @divTrunc(v - @divTrunc(raw_sum, 2), raw_sum);
+
+            weights[i * filter_size + j] = @intCast(int_v);
+            error_val = v - int_v * raw_sum;
+        }
+    }
+
+    return Filter{
+        .pos = pos,
+        .weights = weights,
+        .filter_size = filter_size,
+        .dst_len = dst_len,
+    };
+}
+
+pub fn scalePlaneChannels(
+    allocator: std.mem.Allocator,
+    src: [*]const u8, src_stride: usize, src_w: usize, src_h: usize,
+    dst: [*]u8, dst_stride: usize, dst_w: usize, dst_h: usize,
+    channels: usize,
+    h_filter: Filter, v_filter: Filter,
+) !void {
+    // 2-pass scaling supporting arbitrary number of channels (1, 2, 3, 4)
+    const tmp = try allocator.alloc(i32, src_h * dst_w * channels);
+    defer allocator.free(tmp);
+
+    // Pass 1: Horizontal scaling (8-bit -> 15-bit intermediate, div 128)
+    const h_size = h_filter.filter_size;
+    if (channels == 1 and h_size == 2) {
+        for (0..src_h) |y| {
+            const s_row = src + y * src_stride;
+            const tmp_row = tmp[y * dst_w .. (y + 1) * dst_w];
+
+            var x: usize = 0;
+            const VLen = 16;
+            while (x + VLen <= dst_w) : (x += VLen) {
+                const pos_vec: @Vector(VLen, i32) = h_filter.pos[x..][0..VLen].*;
+                var acc_v: @Vector(VLen, i32) = @splat(0);
+
+                for (0..2) |j| {
+                    var s_vec: @Vector(VLen, i32) = undefined;
+                    inline for (0..VLen) |k| {
+                        const sx = @min(@as(usize, @intCast(pos_vec[k])) + j, src_w - 1);
+                        s_vec[k] = s_row[sx];
+                    }
+                    var w_vec: @Vector(VLen, i32) = undefined;
+                    inline for (0..VLen) |k| {
+                        w_vec[k] = h_filter.weights[(x + k) * 2 + j];
+                    }
+                    acc_v += s_vec * w_vec;
+                }
+                tmp_row[x..][0..VLen].* = @divTrunc(acc_v, @as(@Vector(VLen, i32), @splat(128)));
+            }
+            while (x < dst_w) : (x += 1) {
+                const start_x = @as(usize, @intCast(h_filter.pos[x]));
+                var acc: i32 = 0;
+                for (0..2) |j| {
+                    const sx = @min(start_x + j, src_w - 1);
+                    const w_val: i32 = h_filter.weights[x * 2 + j];
+                    acc += @as(i32, s_row[sx]) * w_val;
+                }
+                tmp_row[x] = @divTrunc(acc, 128);
+            }
+        }
+    } else if (channels == 3) {
+        for (0..src_h) |y| {
+            const s_row = src + y * src_stride;
+            const tmp_row = tmp[y * dst_w * 3 .. (y + 1) * dst_w * 3];
+
+            for (0..dst_w) |x| {
+                const start_x = @as(usize, @intCast(h_filter.pos[x]));
+                var acc_v: @Vector(3, i32) = @splat(0);
+                for (0..h_size) |j| {
+                    const sx = @min(start_x + j, src_w - 1);
+                    const w_val: i32 = h_filter.weights[x * h_size + j];
+                    const w_v: @Vector(3, i32) = @splat(w_val);
+                    const pix: @Vector(3, i32) = .{
+                        s_row[sx * 3 + 0],
+                        s_row[sx * 3 + 1],
+                        s_row[sx * 3 + 2],
+                    };
+                    acc_v += pix * w_v;
+                }
+                const tmp_rgb = @divTrunc(acc_v, @as(@Vector(3, i32), @splat(128)));
+                tmp_row[x * 3 + 0] = tmp_rgb[0];
+                tmp_row[x * 3 + 1] = tmp_rgb[1];
+                tmp_row[x * 3 + 2] = tmp_rgb[2];
+            }
+        }
+    } else if (channels == 4) {
+        for (0..src_h) |y| {
+            const s_row = src + y * src_stride;
+            const tmp_row = tmp[y * dst_w * 4 .. (y + 1) * dst_w * 4];
+
+            for (0..dst_w) |x| {
+                const start_x = @as(usize, @intCast(h_filter.pos[x]));
+                var acc_v: @Vector(4, i32) = @splat(0);
+                for (0..h_size) |j| {
+                    const sx = @min(start_x + j, src_w - 1);
+                    const w_val: i32 = h_filter.weights[x * h_size + j];
+                    const w_v: @Vector(4, i32) = @splat(w_val);
+                    const pix: @Vector(4, i32) = .{
+                        s_row[sx * 4 + 0],
+                        s_row[sx * 4 + 1],
+                        s_row[sx * 4 + 2],
+                        s_row[sx * 4 + 3],
+                    };
+                    acc_v += pix * w_v;
+                }
+                const tmp_rgba = @divTrunc(acc_v, @as(@Vector(4, i32), @splat(128)));
+                tmp_row[x * 4 + 0] = tmp_rgba[0];
+                tmp_row[x * 4 + 1] = tmp_rgba[1];
+                tmp_row[x * 4 + 2] = tmp_rgba[2];
+                tmp_row[x * 4 + 3] = tmp_rgba[3];
+            }
+        }
+    } else {
+        for (0..src_h) |y| {
+            const s_row = src + y * src_stride;
+            const tmp_row = tmp[y * dst_w * channels .. (y + 1) * dst_w * channels];
+
+            for (0..dst_w) |x| {
+                const start_x = @as(usize, @intCast(h_filter.pos[x]));
+                for (0..channels) |c| {
+                    var acc: i32 = 0;
+                    for (0..h_size) |j| {
+                        const sx = @min(start_x + j, src_w - 1);
+                        const w_val: i32 = h_filter.weights[x * h_size + j];
+                        acc += @as(i32, s_row[sx * channels + c]) * w_val;
+                    }
+                    tmp_row[x * channels + c] = @divTrunc(acc, 128);
+                }
+            }
+        }
+    }
+
+    // Pass 2: Vertical scaling (15-bit * 12-bit -> 8-bit, div 524288)
+    const total_cols = dst_w * channels;
+    const v_size = v_filter.filter_size;
+
+    for (0..dst_h) |y| {
+        const d_row = dst + y * dst_stride;
+        const start_y = @as(usize, @intCast(v_filter.pos[y]));
+
+        var col: usize = 0;
+        const VLen = 16;
+        while (col + VLen <= total_cols) : (col += VLen) {
+            var acc_v: @Vector(VLen, i64) = @splat(0);
+            for (0..v_size) |j| {
+                const sy = @min(start_y + j, src_h - 1);
+                const w_val: i64 = v_filter.weights[y * v_size + j];
+                const w_vec: @Vector(VLen, i64) = @splat(w_val);
+                const tmp_slice = tmp[sy * total_cols + col ..][0..VLen];
+                const tmp_v32: @Vector(VLen, i32) = tmp_slice.*;
+                const tmp_v64: @Vector(VLen, i64) = tmp_v32;
+                acc_v += tmp_v64 * w_vec;
+            }
+            const offset_v: @Vector(VLen, i64) = @splat(1 << 18);
+            const val_v = @divTrunc(acc_v + offset_v, @as(@Vector(VLen, i64), @splat(1 << 19)));
+            const clamped = std.math.clamp(val_v, @as(@Vector(VLen, i64), @splat(0)), @as(@Vector(VLen, i64), @splat(255)));
+            const u8_v: @Vector(VLen, u8) = @intCast(clamped);
+            d_row[col..][0..VLen].* = u8_v;
+        }
+
+        while (col < total_cols) : (col += 1) {
+            var acc: i64 = 0;
+            for (0..v_size) |j| {
+                const sy = @min(start_y + j, src_h - 1);
+                const w_val: i64 = v_filter.weights[y * v_size + j];
+                acc += @as(i64, tmp[sy * total_cols + col]) * w_val;
+            }
+            const val = @divTrunc(acc + (1 << 18), 1 << 19);
+            d_row[col] = @intCast(std.math.clamp(val, 0, 255));
+        }
+    }
+}
