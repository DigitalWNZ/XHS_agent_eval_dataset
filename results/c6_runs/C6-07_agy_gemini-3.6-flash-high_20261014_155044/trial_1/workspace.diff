diff --git a/swscale-impl/src/yuv2rgb.zig b/swscale-impl/src/yuv2rgb.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/yuv2rgb.zig
@@ -0,0 +1,376 @@
+const std = @import("std");
+
+inline fn yuvToRgbPixel(y: u8, u: u8, v: u8) [3]u8 {
+    const y_f: i32 = @as(i32, y);
+    const u_f: i32 = @as(i32, u) - 128;
+    const v_f: i32 = @as(i32, v) - 128;
+
+    const y_adj: i32 = (y_f - 16) * 76309;
+
+    const r_raw: i32 = (y_adj + 104597 * v_f + 32768) >> 16;
+    const g_raw: i32 = (y_adj - 25675 * u_f - 53279 * v_f + 32768) >> 16;
+    const b_raw: i32 = (y_adj + 132201 * u_f + 32768) >> 16;
+
+    return .{
+        @intCast(std.math.clamp(r_raw, 0, 255)),
+        @intCast(std.math.clamp(g_raw, 0, 255)),
+        @intCast(std.math.clamp(b_raw, 0, 255)),
+    };
+}
+
+inline fn yuvToRgbPixel_table(y: u8, u: u8, v: u8) [3]u8 {
+    const y_i: i32 = y;
+    const u_i: i32 = @as(i32, u) - 128;
+    const v_i: i32 = @as(i32, v) - 128;
+
+    const r_idx = y_i + ((v_i * 89859) >> 16);
+    const g_idx = y_i + ((u_i * -22040 + v_i * -45738) >> 16);
+    const b_idx = y_i + ((u_i * 113525) >> 16);
+
+    const r_val = ((r_idx - 16) * 76309 + 32768) >> 16;
+    const g_val = ((g_idx - 16) * 76309 + 32768) >> 16;
