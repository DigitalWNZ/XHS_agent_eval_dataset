diff --git a/swscale-impl/build.zig b/swscale-impl/build.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/build.zig
@@ -0,0 +1,28 @@
+const std = @import("std");
+
+pub fn build(b: *std.Build) void {
+    const target = b.standardTargetOptions(.{
+        .default_target = .{
+            .cpu_arch = .x86_64,
+            .os_tag = .linux,
+            .abi = .gnu,
+            .cpu_model = .{ .explicit = &std.Target.x86.cpu.x86_64_v3 },
+        },
+    });
+    const optimize = b.standardOptimizeOption(.{});
+
+    const lib = b.addSharedLibrary(.{
+        .name = "swscale_candidate",
+        .root_source_file = b.path("src/main.zig"),
+        .target = target,
+        .optimize = optimize,
+    });
+    // The library exports a C ABI (and the stub uses std.heap.c_allocator) — link libc.
+    lib.linkLibC();
+
+    // With -Doptimize=ReleaseFast, Zig defaults to baseline x86_64 (SSE2).
+    // To target AVX2 for SIMD, use: zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3
+    // Or use @Vector with portable SIMD — Zig auto-selects the best backend.
+
+    b.installArtifact(lib);
+}
diff --git a/swscale-impl/dump_baseline_filters.py b/swscale-impl/dump_baseline_filters.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/dump_baseline_filters.py
@@ -0,0 +1,30 @@
+import sys
+import ctypes
+import numpy as np
+
+sys.path.insert(0, "/app")
+import workloads
+
+lib = ctypes.CDLL("/app/libswscale_public_baseline.so")
+lib.swscale_create.restype = ctypes.c_void_p
+lib.swscale_create.argtypes = [ctypes.c_int] * 7
+
+sw, sh = 8, 4
+dw, dh = 4, 2
+algo = workloads.BILINEAR
+
+ctx_ptr = lib.swscale_create(sw, sh, workloads.RGB24, dw, dh, workloads.RGB24, algo)
+print("ctx_ptr:", hex(ctx_ptr))
+
+# Let's inspect memory around ctx_ptr to find hLumFilter and vLumFilter pointers
+# In SwsContext:
+# hLumFilter is int16_t*
+# hLumFilterPos is int32_t*
+# hLumFilterSize is int
+
+# Let's read memory as 64-bit integers:
+arr = (ctypes.c_int64 * 200).from_address(ctx_ptr)
+for i in range(100):
+    val = arr[i]
+    if val > 0x10000 and val < 0x7fffffffffff:
+        print(f"Offset {i*8} (0x{i*8:x}): ptr=0x{val:x}")
diff --git a/swscale-impl/get_baseline_context.c b/swscale-impl/get_baseline_context.c
