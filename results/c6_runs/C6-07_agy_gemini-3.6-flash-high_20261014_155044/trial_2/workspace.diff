+const std = @import("std");
+const types = @import("types.zig");
+const clampU8 = types.clampU8;
+
+pub fn rgb24_to_bgr24(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x + 32 <= w) : (x += 32) {
+            var i: usize = 0;
+            while (i < 32) : (i += 1) {
+                const off = (x + i) * 3;
+                const r = s_row[off + 0];
+                const g = s_row[off + 1];
+                const b = s_row[off + 2];
+                d_row[off + 0] = b;
+                d_row[off + 1] = g;
+                d_row[off + 2] = r;
+            }
+        }
+        while (x < w) : (x += 1) {
+            const off = x * 3;
+            const r = s_row[off + 0];
+            const g = s_row[off + 1];
+            const b = s_row[off + 2];
+            d_row[off + 0] = b;
+            d_row[off + 1] = g;
+            d_row[off + 2] = r;
+        }
+    }
+}
+
+pub fn rgb24_to_rgba(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 3;
+            const d_off = x * 4;
+            d_row[d_off + 0] = s_row[s_off + 0];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 2];
+            d_row[d_off + 3] = 255;
+        }
+    }
+}
+
+pub fn rgb24_to_bgra(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 3;
+            const d_off = x * 4;
+            d_row[d_off + 0] = s_row[s_off + 2];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 0];
+            d_row[d_off + 3] = 255;
+        }
+    }
+}
+
+pub fn bgr24_to_rgba(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
