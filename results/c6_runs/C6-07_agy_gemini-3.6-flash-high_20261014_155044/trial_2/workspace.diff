+        const off_rV: i32 = -@as(i32, @intCast(crv >> 9));
+        const off_bU: i32 = -@as(i32, @intCast(cbu >> 9));
+        const off_gU: i32 = -@as(i32, @intCast(cgu >> 9));
+        const off_gV: i32 = -@as(i32, @intCast(cgv >> 9));
