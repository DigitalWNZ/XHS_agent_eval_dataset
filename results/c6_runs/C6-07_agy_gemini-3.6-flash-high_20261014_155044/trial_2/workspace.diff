+                const dvu = (dst_data[1] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[1]))];
+                rgb2yuv.bgr24_to_nv21(s, sst, dy, @intCast(dst_stride[0]), dvu, @intCast(dst_stride[1]), w, h);
+                return 0;
+            },
+            else => {},
+        }
+    }
+
+    // RGBA source
+    if (src_fmt == types.PIXFMT_RGBA) {
+        const s = (src_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(src_stride[0]))];
+        const sst: usize = @intCast(src_stride[0]);
+
+        switch (dst_fmt) {
+            types.PIXFMT_RGB24 => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.rgba_to_rgb24(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_BGRA => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.rgba_to_bgra(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_GRAY8 => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.rgba_to_gray8(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_YUV420P => {
+                const dy = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                const du = (dst_data[1] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[1]))];
+                const dv = (dst_data[2] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[2]))];
+                rgb2yuv.rgba_to_yuv420p(s, sst, dy, @intCast(dst_stride[0]), du, @intCast(dst_stride[1]), dv, @intCast(dst_stride[2]), w, h);
+                return 0;
+            },
+            else => {},
+        }
+    }
+
+    // BGRA source
+    if (src_fmt == types.PIXFMT_BGRA) {
+        const s = (src_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(src_stride[0]))];
+        const sst: usize = @intCast(src_stride[0]);
+
+        switch (dst_fmt) {
+            types.PIXFMT_RGB24 => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.bgra_to_rgb24(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_RGBA => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.rgba_to_bgra(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_YUV420P => {
+                const dy = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                const du = (dst_data[1] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[1]))];
+                const dv = (dst_data[2] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[2]))];
+                rgb2yuv.bgra_to_yuv420p(s, sst, dy, @intCast(dst_stride[0]), du, @intCast(dst_stride[1]), dv, @intCast(dst_stride[2]), w, h);
+                return 0;
+            },
+            else => {},
+        }
+    }
+
+    // GRAY8 source
+    if (src_fmt == types.PIXFMT_GRAY8) {
+        const s = (src_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(src_stride[0]))];
+        const sst: usize = @intCast(src_stride[0]);
+
+        switch (dst_fmt) {
+            types.PIXFMT_RGB24, types.PIXFMT_BGR24 => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.gray8_to_rgb24(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_RGBA => {
+                const d = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                rgb2rgb.gray8_to_rgba(s, sst, d, @intCast(dst_stride[0]), w, h);
+                return 0;
+            },
+            types.PIXFMT_YUV420P => {
+                const dy = (dst_data[0] orelse return -1)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+                const du = (dst_data[1] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[1]))];
+                const dv = (dst_data[2] orelse return -1)[0 .. ((h + 1) / 2) * @as(usize, @intCast(dst_stride[2]))];
+                rgb2rgb.gray8_to_yuv420p(s, sst, dy, @intCast(dst_stride[0]), du, @intCast(dst_stride[1]), dv, @intCast(dst_stride[2]), w, h);
+                return 0;
+            },
+            else => {},
+        }
+    }
+
+    return -1;
+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,62 @@
+const std = @import("std");
+const types = @import("types.zig");
+const context = @import("context.zig");
+const convert = @import("convert.zig");
+const scale = @import("scale.zig");
+const SwsContext = context.SwsContext;
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+    const ctx = SwsContext.init(
+        std.heap.c_allocator,
+        @intCast(src_w),
+        @intCast(src_h),
+        src_fmt,
+        @intCast(dst_w),
+        @intCast(dst_h),
+        dst_fmt,
+        algo,
+    ) catch return null;
+    return @ptrCast(ctx);
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+
+    if (ctx.src_w == ctx.dst_w and ctx.src_h == ctx.dst_h) {
+        const res = convert.convert_same_size(
+            ctx.src_fmt,
+            ctx.dst_fmt,
+            src_data,
+            src_stride,
+            dst_data,
+            dst_stride,
+            ctx.src_w,
+            ctx.src_h,
+        );
+        if (res == 0) return 0;
+    }
+
+    return scale.scale_process(ctx, src_data, src_stride, dst_data, dst_stride);
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        ctx.deinit(std.heap.c_allocator);
+    }
+}
