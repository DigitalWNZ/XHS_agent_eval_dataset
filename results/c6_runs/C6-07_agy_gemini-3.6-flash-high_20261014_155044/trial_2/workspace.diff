+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+int main() {
+    int src_w = 720, src_h = 576;
+    int dst_w = 360, dst_h = 288;
+
+    uint8_t *src = malloc(src_w * src_h * 3);
+    for (int i=0; i<src_w*src_h*3; i++) src[i] = (i * 13) & 0xff;
+
+    const uint8_t *src_data[4] = {src, NULL, NULL, NULL};
+    int src_stride[4] = {src_w * 3, 0, 0, 0};
+
+    uint8_t *ref = malloc(dst_w * dst_h * 3);
+    uint8_t *ref_data[4] = {ref, NULL, NULL, NULL};
+    int dst_stride[4] = {dst_w * 3, 0, 0, 0};
+
+    // algo = 0 (NEAREST)
+    void *ctx = swscale_create(src_w, src_h, 5, dst_w, dst_h, 5, 0);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    uint8_t *cand = malloc(dst_w * dst_h * 3);
+    uint32_t xInc = (src_w << 16) / dst_w;
+    uint32_t yInc = (src_h << 16) / dst_h;
+
+    for (int y = 0; y < dst_h; y++) {
+        int sy = (y * yInc + 0x8000) >> 16;
+        if (sy >= src_h) sy = src_h - 1;
+        const uint8_t *s_row = src + sy * src_w * 3;
+        uint8_t *d_row = cand + y * dst_w * 3;
+        for (int x = 0; x < dst_w; x++) {
+            int sx = (x * xInc + 0x8000) >> 16;
+            if (sx >= src_w) sx = src_w - 1;
+            d_row[x*3 + 0] = s_row[sx*3 + 0];
+            d_row[x*3 + 1] = s_row[sx*3 + 1];
+            d_row[x*3 + 2] = s_row[sx*3 + 2];
+        }
+    }
+
+    int diffs = 0;
+    for (int i = 0; i < dst_w * dst_h * 3; i++) {
+        if (cand[i] != ref[i]) diffs++;
+    }
+
+    printf("Nearest neighbor 720x576 -> 360x288 diffs = %d / %d\n", diffs, dst_w * dst_h * 3);
+    return 0;
+}
