+            d_row[d_off + 0] = s_row[s_off + 0];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 2];
+            d_row[d_off + 3] = 255;
+        }
+    }
+}
+
+pub fn rgba_to_rgb24(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 4;
+            const d_off = x * 3;
+            d_row[d_off + 0] = s_row[s_off + 0];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 2];
+        }
+    }
+}
+
+pub fn rgba_to_bgra(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    const shuffle_mask: @Vector(16, i32) = .{ 2, 1, 0, 3, 6, 5, 4, 7, 10, 9, 8, 11, 14, 13, 12, 15 };
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x + 4 <= w) : (x += 4) {
+            const v: @Vector(16, u8) = s_row[x * 4 ..][0..16].*;
+            const swapped = @shuffle(u8, v, undefined, shuffle_mask);
+            d_row[x * 4 ..][0..16].* = swapped;
+        }
+        while (x < w) : (x += 1) {
+            const off = x * 4;
+            const r = s_row[off + 0];
+            const g = s_row[off + 1];
+            const b = s_row[off + 2];
+            const a = s_row[off + 3];
+            d_row[off + 0] = b;
+            d_row[off + 1] = g;
+            d_row[off + 2] = r;
+            d_row[off + 3] = a;
+        }
+    }
+}
+
+pub fn bgra_to_rgb24(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
