+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include "/app/swscale_api.h"
+
+int main() {
+    int src_w = 1280, src_h = 720;
+    int dst_w = 640, dst_h = 360;
+
+    uint8_t *src_y = malloc(src_w * src_h);
+    for (int y = 0; y < src_h; y++) {
+        for (int x = 0; x < src_w; x++) {
+            src_y[y * src_w + x] = (x * 3 + y * 7) & 0xff;
+        }
+    }
+
+    const uint8_t *src_data[4] = {src_y, NULL, NULL, NULL};
+    int src_stride[4] = {src_w, 0, 0, 0};
+
+    uint8_t *ref_y = malloc(dst_w * dst_h);
+    uint8_t *ref_data[4] = {ref_y, NULL, NULL, NULL};
+    int dst_stride[4] = {dst_w, 0, 0, 0};
+
+    void *ref_ctx = swscale_create(src_w, src_h, 9, dst_w, dst_h, 9, 1);
+    swscale_process(ref_ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ref_ctx);
+
+    printf("Ref[0..9]: ");
+    for (int i=0; i<10; i++) printf("%d ", ref_y[i]);
+    printf("\n");
+
+    for (int add_off = 0; add_off <= 0x800000; add_off += 0x80000) {
+        int diffs = 0;
+        for (int dy = 0; dy < dst_h; dy++) {
+            int sy0 = dy * 2;
+            int sy1 = dy * 2 + 1;
+            const uint8_t *s0 = src_y + sy0 * src_w;
+            const uint8_t *s1 = src_y + sy1 * src_w;
+            uint8_t *d = ref_y + dy * dst_w;
+
+            for (int dx = 0; dx < dst_w; dx++) {
+                int sx0 = dx * 2;
+                int sx1 = dx * 2 + 1;
+
+                int64_t h_sum0 = (int64_t)s0[sx0] * 2048 + (int64_t)s0[sx1] * 2048;
+                int64_t h_sum1 = (int64_t)s1[sx0] * 2048 + (int64_t)s1[sx1] * 2048;
+
+                int64_t tmp = h_sum0 * 2048 + h_sum1 * 2048;
+                int val = (tmp + (1 << 23) + add_off) >> 24;
+                if (val != d[dx]) diffs++;
+            }
+        }
+        printf("Offset +0x%x: diffs = %d / %d\n", add_off, diffs, dst_w * dst_h);
+    }
+
+    return 0;
+}
