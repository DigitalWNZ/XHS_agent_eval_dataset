+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+int main() {
+    int src_w = 1280, src_h = 720;
+    int dst_w = 640, dst_h = 360;
+
+    uint8_t *src_y = malloc(src_w * src_h);
+    for (int y = 0; y < src_h; y++) {
+        for (int x = 0; x < src_w; x++) {
+            src_y[y * src_w + x] = (x * 3 + y * 7) & 0xff;
+        }
+    }
+
+    const uint8_t *src_data[4] = {src_y, NULL, NULL, NULL};
+    int src_stride[4] = {src_w, 0, 0, 0};
+
+    uint8_t *ref_y = malloc(dst_w * dst_h);
+    uint8_t *ref_data[4] = {ref_y, NULL, NULL, NULL};
+    int dst_stride[4] = {dst_w, 0, 0, 0};
+
+    // SWS_PIXFMT_GRAY8 = 9, SWS_ALGO_BILINEAR = 1
+    void *ctx = swscale_create(src_w, src_h, 9, dst_w, dst_h, 9, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    // Multi-tap Bilinear downscaling filter (as in FFmpeg initFilter else-branch)
+    int filterSize = 1 + (src_w + dst_w - 1) / dst_w; // 3 for 2:1
+    int xInc = (src_w << 16) / dst_w;
+    int yInc = (src_h << 16) / dst_h;
+
+    int32_t *h_pos = malloc(dst_w * sizeof(int32_t));
+    int16_t *h_w = malloc(dst_w * filterSize * sizeof(int16_t));
+
+    for (int i = 0; i < dst_w; i++) {
+        int64_t xDstInSrc = (i * (int64_t)xInc) + (xInc >> 1);
+        int xx = (xDstInSrc - (filterSize - 2) * (1LL << 16)) / (1 << 17);
+        if (xx < 0) xx = 0;
+        if (xx + filterSize > src_w) xx = src_w - filterSize;
+        h_pos[i] = xx;
+
+        double sum_f = 0.0;
+        double float_w[10];
+        for (int j = 0; j < filterSize; j++) {
+            int64_t d = (xx + j) * (1LL << 17) - xDstInSrc;
+            if (d < 0) d = -d;
+            double floatd = (double)d / (1LL << 17);
+            floatd = floatd * dst_w / src_w;
+            double w = 1.0 - floatd;
+            if (w < 0) w = 0;
+            float_w[j] = w;
+            sum_f += w;
+        }
+
+        int w_sum = 0;
+        for (int j = 0; j < filterSize; j++) {
+            int16_t nw = (int16_t)round((float_w[j] / sum_f) * 4096.0);
+            h_w[i * filterSize + j] = nw;
+            w_sum += nw;
+        }
+        h_w[i * filterSize + filterSize / 2] += (4096 - w_sum);
+    }
+
+    int32_t *v_pos = malloc(dst_h * sizeof(int32_t));
+    int16_t *v_w = malloc(dst_h * filterSize * sizeof(int16_t));
+
+    for (int i = 0; i < dst_h; i++) {
+        int64_t yDstInSrc = (i * (int64_t)yInc) + (yInc >> 1);
+        int yy = (yDstInSrc - (filterSize - 2) * (1LL << 16)) / (1 << 17);
+        if (yy < 0) yy = 0;
+        if (yy + filterSize > src_h) yy = src_h - filterSize;
+        v_pos[i] = yy;
+
+        double sum_f = 0.0;
+        double float_w[10];
+        for (int j = 0; j < filterSize; j++) {
+            int64_t d = (yy + j) * (1LL << 17) - yDstInSrc;
+            if (d < 0) d = -d;
+            double floatd = (double)d / (1LL << 17);
+            floatd = floatd * dst_h / src_h;
+            double w = 1.0 - floatd;
+            if (w < 0) w = 0;
+            float_w[j] = w;
+            sum_f += w;
+        }
+
+        int w_sum = 0;
+        for (int j = 0; j < filterSize; j++) {
+            int16_t nw = (int16_t)round((float_w[j] / sum_f) * 4096.0);
+            v_w[i * filterSize + j] = nw;
+            w_sum += nw;
+        }
+        v_w[i * filterSize + filterSize / 2] += (4096 - w_sum);
+    }
+
+    uint8_t *cand_y = malloc(dst_w * dst_h);
+    for (int dy = 0; dy < dst_h; dy++) {
+        int vp = v_pos[dy];
+        uint8_t *d = cand_y + dy * dst_w;
+
+        for (int dx = 0; dx < dst_w; dx++) {
+            int hp = h_pos[dx];
+            int64_t tmp = 0;
+            for (int j = 0; j < filterSize; j++) {
+                int sy = vp + j;
+                const uint8_t *s_line = src_y + sy * src_w;
+                int64_t h_sum = 0;
+                for (int k = 0; k < filterSize; k++) {
+                    int sx = hp + k;
+                    h_sum += (int64_t)s_line[sx] * h_w[dx * filterSize + k];
+                }
+                tmp += h_sum * v_w[dy * filterSize + j];
+            }
+            int val = (tmp + (1 << 23)) >> 24;
+            if (val < 0) val = 0;
+            if (val > 255) val = 255;
+            d[dx] = val;
+        }
+    }
+
+    int diff_y = 0;
+    for (int i = 0; i < dst_w * dst_h; i++) {
+        if (cand_y[i] != ref_y[i]) diff_y++;
+    }
+
+    printf("Multi-tap Bilinear downscaling diffs = %d / %d\n", diff_y, dst_w * dst_h);
+    return 0;
+}
