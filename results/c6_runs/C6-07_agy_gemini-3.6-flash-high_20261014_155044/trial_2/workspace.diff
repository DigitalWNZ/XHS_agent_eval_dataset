new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_scale_chroma.c
@@ -0,0 +1,84 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+// Simple bilinear 2x upsampler
+void bilinear_2x_upsample(const uint8_t *src, int src_st, int src_w, int src_h, uint8_t *dst, int dst_st) {
+    for (int dy = 0; dy < src_h * 2; dy++) {
+        // sample pos in src coordinates: (dy + 0.5) / 2.0 - 0.5 = dy / 2.0 - 0.25 ?
+        // Or SWS bilinear filter coordinates
+        float sy = (dy + 0.5f) * 0.5f - 0.5f;
+        int y0 = (int)floorf(sy);
+        int y1 = y0 + 1;
+        float wy = sy - y0;
+        if (y0 < 0) { y0 = 0; y1 = 0; wy = 0; }
+        if (y1 >= src_h) { y1 = src_h - 1; }
+
+        const uint8_t *r0 = src + y0 * src_st;
+        const uint8_t *r1 = src + y1 * src_st;
+        uint8_t *d = dst + dy * dst_st;
+
+        for (int dx = 0; dx < src_w * 2; dx++) {
+            float sx = (dx + 0.5f) * 0.5f - 0.5f;
+            int x0 = (int)floorf(sx);
+            int x1 = x0 + 1;
+            float wx = sx - x0;
+            if (x0 < 0) { x0 = 0; x1 = 0; wx = 0; }
+            if (x1 >= src_w) { x1 = src_w - 1; }
+
+            float p00 = r0[x0], p01 = r0[x1];
+            float p10 = r1[x0], p11 = r1[x1];
+
+            float val = p00 * (1.0f - wx) * (1.0f - wy) +
+                        p01 * wx * (1.0f - wy) +
+                        p10 * (1.0f - wx) * wy +
+                        p11 * wx * wy;
+
+            d[dx] = (uint8_t)(val + 0.5f);
+        }
+    }
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *src_y = malloc(w * h);
+    uint8_t *src_u = malloc((w/2) * (h/2));
+    uint8_t *src_v = malloc((w/2) * (h/2));
+    for (int i=0; i<w*h; i++) src_y[i] = i & 0xff;
+    for (int i=0; i<(w/2)*(h/2); i++) {
+        src_u[i] = (i * 3) & 0xff;
+        src_v[i] = (i * 7) & 0xff;
+    }
+
+    const uint8_t *src_data[4] = {src_y, src_u, src_v, NULL};
+    int src_stride[4] = {w, w/2, w/2, 0};
+
+    uint8_t *ref_y = malloc(w * h);
+    uint8_t *ref_u = malloc(w * h);
+    uint8_t *ref_v = malloc(w * h);
+    uint8_t *ref_data[4] = {ref_y, ref_u, ref_v, NULL};
+    int dst_stride[4] = {w, w, w, 0};
+
+    // SWS_PIXFMT_YUV420P = 0, SWS_PIXFMT_YUV444P = 2
+    void *ctx = swscale_create(w, h, 0, w, h, 2, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    uint8_t *cand_u = malloc(w * h);
+    uint8_t *cand_v = malloc(w * h);
+
+    bilinear_2x_upsample(src_u, w/2, w/2, h/2, cand_u, w);
+    bilinear_2x_upsample(src_v, w/2, w/2, h/2, cand_v, w);
+
+    double mse_u = 0, mse_v = 0;
+    for (int i = 0; i < w * h; i++) { double d = (double)cand_u[i] - ref_u[i]; mse_u += d * d; }
+    for (int i = 0; i < w * h; i++) { double d = (double)cand_v[i] - ref_v[i]; mse_v += d * d; }
+
+    double total_mse = (mse_u + mse_v) / (w * h * 2);
+    double psnr = 10 * log10(255.0 * 255.0 / total_mse);
+
+    printf("Bilinear 2x upsample PSNR against baseline = %.2f dB\n", psnr);
+    return 0;
+}
