+#include "/app/swscale_api.h"
+
+void test_rgb24_yuv420(const uint8_t *src, int src_st, uint8_t *dst_y, int y_st, uint8_t *dst_u, int u_st, uint8_t *dst_v, int v_st, int w, int h) {
+    int32_t ry = 8412, gy = 16508, by = 3212;
+    int32_t ru = -4866, gu = -9522, bu = 14387;
+    int32_t rv = 14387, gv = -12056, bv = -2331;
+
+    for (int y = 0; y < h; y += 2) {
+        const uint8_t *src1 = src + y * src_st;
+        const uint8_t *src2 = src + (y + 1) * src_st;
+        uint8_t *ydst1 = dst_y + y * y_st;
+        uint8_t *ydst2 = dst_y + (y + 1) * y_st;
+        uint8_t *udst = dst_u + (y / 2) * u_st;
+        uint8_t *vdst = dst_v + (y / 2) * v_st;
+
+        for (int i = 0; i < w / 2; i++) {
+            // RGB24: byte 0=R, byte 1=G, byte 2=B
+            unsigned int r11 = src1[6 * i + 0], g11 = src1[6 * i + 1], b11 = src1[6 * i + 2];
+            unsigned int r12 = src1[6 * i + 3], g12 = src1[6 * i + 4], b12 = src1[6 * i + 5];
+            unsigned int r21 = src2[6 * i + 0], g21 = src2[6 * i + 1], b21 = src2[6 * i + 2];
+            unsigned int r22 = src2[6 * i + 3], g22 = src2[6 * i + 4], b22 = src2[6 * i + 5];
+
+            ydst1[2 * i + 0] = ((ry * r11 + gy * g11 + by * b11) >> 15) + 16;
+            ydst1[2 * i + 1] = ((ry * r12 + gy * g12 + by * b12) >> 15) + 16;
+            ydst2[2 * i + 0] = ((ry * r21 + gy * g21 + by * b21) >> 15) + 16;
+            ydst2[2 * i + 1] = ((ry * r22 + gy * g22 + by * b22) >> 15) + 16;
+
+            unsigned int rx = (r11 + r12 + r21 + r22) >> 2;
+            unsigned int gx = (g11 + g12 + g21 + g22) >> 2;
+            unsigned int bx = (b11 + b12 + b21 + b22) >> 2;
+
+            udst[i] = ((ru * rx + gu * gx + bu * bx) >> 15) + 128;
+            vdst[i] = ((rv * rx + gv * gx + bv * bx) >> 15) + 128;
+        }
+    }
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *src_rgb = malloc(w * h * 3);
+    for (int i=0; i<w*h*3; i++) src_rgb[i] = (i * 17) & 0xff;
+
+    const uint8_t *src_data[4] = {src_rgb, NULL, NULL, NULL};
+    int src_stride[4] = {w*3, 0, 0, 0};
+
+    uint8_t *ref_y = malloc(w * h);
+    uint8_t *ref_u = malloc((w/2) * (h/2));
+    uint8_t *ref_v = malloc((w/2) * (h/2));
+    uint8_t *ref_data[4] = {ref_y, ref_u, ref_v, NULL};
+    int dst_stride[4] = {w, w/2, w/2, 0};
+
+    // SWS_PIXFMT_RGB24 = 5, SWS_PIXFMT_YUV420P = 0
+    void *ctx = swscale_create(w, h, 5, w, h, 0, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    uint8_t *cand_y = malloc(w * h);
+    uint8_t *cand_u = malloc((w/2) * (h/2));
+    uint8_t *cand_v = malloc((w/2) * (h/2));
+
+    test_rgb24_yuv420(src_rgb, w*3, cand_y, w, cand_u, w/2, cand_v, w/2, w, h);
+
+    int diff_y=0, diff_u=0, diff_v=0;
+    for (int i=0; i<w*h; i++) if (cand_y[i] != ref_y[i]) diff_y++;
+    for (int i=0; i<(w/2)*(h/2); i++) if (cand_u[i] != ref_u[i]) diff_u++;
+    for (int i=0; i<(w/2)*(h/2); i++) if (cand_v[i] != ref_v[i]) diff_v++;
+
+    printf("RGB24->YUV420P Diffs: Y=%d / %d, U=%d / %d, V=%d / %d\n", diff_y, w*h, diff_u, (w/2)*(h/2), diff_v, (w/2)*(h/2));
+    return 0;
+}
