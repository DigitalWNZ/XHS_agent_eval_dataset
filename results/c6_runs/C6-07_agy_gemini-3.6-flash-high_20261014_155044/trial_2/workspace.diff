+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+static inline uint8_t clampU8(int v) {
+    return v < 0 ? 0 : (v > 255 ? 255 : v);
+}
+
+static inline uint8_t rgb_to_y(int r, int g, int b) {
+    int y16 = (8412 * r + 16508 * g + 3212 * b + 524544) >> 8;
+    return clampU8((y16 + 64) >> 7);
+}
+
+void cand_rgb24_to_yuv420p(const uint8_t *src_rgb, int src_stride,
+                           uint8_t *dst_y, int dst_ystride,
+                           uint8_t *dst_u, int dst_ustride,
+                           uint8_t *dst_v, int dst_vstride,
+                           int w, int h) {
+    for (int y = 0; y < h; y += 2) {
+        const uint8_t *s_row0 = src_rgb + (y + 0) * src_stride;
+        const uint8_t *s_row1 = src_rgb + (y + 1) * src_stride;
+        uint8_t *d_yrow0 = dst_y + (y + 0) * dst_ystride;
+        uint8_t *d_yrow1 = dst_y + (y + 1) * dst_ystride;
+        uint8_t *d_urow = dst_u + (y / 2) * dst_ustride;
+        uint8_t *d_vrow = dst_v + (y / 2) * dst_vstride;
+
+        for (int x = 0; x < w; x += 2) {
+            int r00 = s_row0[(x + 0) * 3 + 0], g00 = s_row0[(x + 0) * 3 + 1], b00 = s_row0[(x + 0) * 3 + 2];
+            int r01 = s_row0[(x + 1) * 3 + 0], g01 = s_row0[(x + 1) * 3 + 1], b01 = s_row0[(x + 1) * 3 + 2];
+            int r10 = s_row1[(x + 0) * 3 + 0], g10 = s_row1[(x + 0) * 3 + 1], b10 = s_row1[(x + 0) * 3 + 2];
+            int r11 = s_row1[(x + 1) * 3 + 0], g11 = s_row1[(x + 1) * 3 + 1], b11 = s_row1[(x + 1) * 3 + 2];
+
+            d_yrow0[x + 0] = rgb_to_y(r00, g00, b00);
+            d_yrow0[x + 1] = rgb_to_y(r01, g01, b01);
+            d_yrow1[x + 0] = rgb_to_y(r10, g10, b10);
+            d_yrow1[x + 1] = rgb_to_y(r11, g11, b11);
+
+            int r_sum = r00 + r01 + r10 + r11;
+            int g_sum = g00 + g01 + g10 + g11;
+            int b_sum = b00 + b01 + b10 + b11;
+
+            int u16_val = (-4866 * r_sum - 9522 * g_sum + 14387 * b_sum + 16778240) >> 10;
+            int v16_val = (14387 * r_sum - 12056 * g_sum - 2331 * b_sum + 16778240) >> 10;
+
+            d_urow[x / 2] = clampU8((u16_val + 64) >> 7);
+            d_vrow[x / 2] = clampU8((v16_val + 64) >> 7);
+        }
+    }
+}
+
+int main() {
+    int w = 640, h = 480;
+    uint8_t *src = malloc(w * h * 3);
+    // Fill with pattern like perf-check
+    for (int y = 0; y < h; y++) {
+        for (int x = 0; x < w; x++) {
+            src[(y * w + x) * 3 + 0] = (x + y) & 0xff;
+            src[(y * w + x) * 3 + 1] = (x * 2 + y) & 0xff;
+            src[(y * w + x) * 3 + 2] = (x + y * 3) & 0xff;
+        }
+    }
+
+    const uint8_t *src_data[4] = {src, NULL, NULL, NULL};
+    int src_stride[4] = {w * 3, 0, 0, 0};
+
+    uint8_t *ref_y = malloc(w * h);
+    uint8_t *ref_u = malloc((w/2) * (h/2));
+    uint8_t *ref_v = malloc((w/2) * (h/2));
+    uint8_t *ref_data[4] = {ref_y, ref_u, ref_v, NULL};
+    int dst_stride[4] = {w, w/2, w/2, 0};
+
+    // SWS_PIXFMT_RGB24 = 5, SWS_PIXFMT_YUV420P = 0
+    void *ctx = swscale_create(w, h, 5, w, h, 0, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    uint8_t *cand_y = malloc(w * h);
+    uint8_t *cand_u = malloc((w/2) * (h/2));
+    uint8_t *cand_v = malloc((w/2) * (h/2));
+
+    cand_rgb24_to_yuv420p(src, w * 3, cand_y, w, cand_u, w/2, cand_v, w/2, w, h);
+
+    double mse_y = 0, mse_u = 0, mse_v = 0;
+    for (int i = 0; i < w * h; i++) { double d = (double)cand_y[i] - ref_y[i]; mse_y += d * d; }
+    for (int i = 0; i < (w/2) * (h/2); i++) { double d = (double)cand_u[i] - ref_u[i]; mse_u += d * d; }
+    for (int i = 0; i < (w/2) * (h/2); i++) { double d = (double)cand_v[i] - ref_v[i]; mse_v += d * d; }
+
+    double total_mse = (mse_y + mse_u + mse_v) / (w * h + (w/2) * (h/2) * 2);
+    double psnr = 10 * log10(255.0 * 255.0 / total_mse);
+
+    printf("RGB24->YUV420P PSNR = %.2f dB\n", psnr);
+    return 0;
+}
