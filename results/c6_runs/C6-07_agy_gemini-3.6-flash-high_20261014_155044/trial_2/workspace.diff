diff --git a/swscale-impl/scratch/test_math.py b/swscale-impl/scratch/test_math.py
new file mode 100644
--- /dev/null
+++ b/swscale-impl/scratch/test_math.py
@@ -0,0 +1,27 @@
+def convert(r00, g00, b00, r01, g01, b01, r10, g10, b10, r11, g11, b11):
+    y00_16 = (8412 * r00 + 16508 * g00 + 3212 * b00 + 524544) >> 8
+    y00 = (y00_16 + 64) >> 7
+    
+    r_sum = r00 + r01 + r10 + r11
+    g_sum = g00 + g01 + g10 + g11
+    b_sum = b00 + b01 + b10 + b11
+    
+    u16 = (-4866 * r_sum - 9522 * g_sum + 14387 * b_sum + 16778240) >> 10
+    u = (u16 + 64) >> 7
+    
+    v16 = (14387 * r_sum - 12056 * g_sum - 2331 * b_sum + 16778240) >> 10
+    v = (v16 + 64) >> 7
+    return y00, u, v
+
+tests = [
+    ("Red", 255, 0, 0, 81, 90, 240),
+    ("Green", 0, 255, 0, 145, 54, 34),
+    ("Blue", 0, 0, 255, 41, 240, 110),
+    ("White", 255, 255, 255, 235, 128, 128),
+    ("Black", 0, 0, 0, 16, 128, 128),
+    ("Gray", 128, 128, 128, 126, 128, 128),
+]
+
+for name, r, g, b, ref_y, ref_u, ref_v in tests:
+    y, u, v = convert(r, g, b, r, g, b, r, g, b, r, g, b)
+    print(f"{name:5s} Calc: Y={y:3d}, U={u:3d}, V={v:3d} | Ref: Y={ref_y:3d}, U={ref_u:3d}, V={ref_v:3d}")
