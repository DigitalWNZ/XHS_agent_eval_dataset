--- /dev/null
+++ b/swscale-impl/src/chroma.zig
@@ -0,0 +1,201 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+pub fn copy_plane(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        @memcpy(dst[y * dst_stride ..][0..w], src[y * src_stride ..][0..w]);
+    }
+}
+
+pub fn yuv420p_to_nv12(
+    src_y: []const u8, src_ystride: usize,
+    src_u: []const u8, src_ustride: usize,
+    src_v: []const u8, src_vstride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_uv: []u8, dst_uvstride: usize,
+    w: usize, h: usize,
+) void {
+    copy_plane(src_y, src_ystride, dst_y, dst_ystride, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const u_row = src_u[y * src_ustride ..];
+        const v_row = src_v[y * src_vstride ..];
+        const uv_row = dst_uv[y * dst_uvstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            uv_row[x * 2 + 0] = u_row[x];
+            uv_row[x * 2 + 1] = v_row[x];
+        }
+    }
+}
+
+pub fn nv12_to_yuv420p(
+    src_y: []const u8, src_ystride: usize,
+    src_uv: []const u8, src_uvstride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    copy_plane(src_y, src_ystride, dst_y, dst_ystride, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const uv_row = src_uv[y * src_uvstride ..];
+        const u_row = dst_u[y * dst_ustride ..];
+        const v_row = dst_v[y * dst_vstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            u_row[x] = uv_row[x * 2 + 0];
+            v_row[x] = uv_row[x * 2 + 1];
+        }
+    }
+}
+
+pub fn deinterleave_uv(
+    src_uv: []const u8, src_uvstride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    cw: usize, ch: usize,
+) void {
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const uv_row = src_uv[y * src_uvstride ..];
+        const u_row = dst_u[y * dst_ustride ..];
+        const v_row = dst_v[y * dst_vstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            u_row[x] = uv_row[x * 2 + 0];
+            v_row[x] = uv_row[x * 2 + 1];
+        }
+    }
+}
+
+pub fn deinterleave_vu(
+    src_vu: []const u8, src_vustride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    cw: usize, ch: usize,
+) void {
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const vu_row = src_vu[y * src_vustride ..];
+        const u_row = dst_u[y * dst_ustride ..];
+        const v_row = dst_v[y * dst_vstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            v_row[x] = vu_row[x * 2 + 0];
+            u_row[x] = vu_row[x * 2 + 1];
+        }
+    }
+}
+
+pub fn nv21_to_yuv420p(
+    src_y: []const u8, src_ystride: usize,
+    src_vu: []const u8, src_vustride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    copy_plane(src_y, src_ystride, dst_y, dst_ystride, w, h);
+    deinterleave_vu(src_vu, src_vustride, dst_u, dst_ustride, dst_v, dst_vstride, (w + 1) / 2, (h + 1) / 2);
+}
+
+pub fn yuv422p_to_yuv420p(
+    src_y: []const u8, src_ystride: usize,
+    src_u: []const u8, src_ustride: usize,
+    src_v: []const u8, src_vstride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    copy_plane(src_y, src_ystride, dst_y, dst_ystride, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const u_in0 = src_u[(2 * y + 0) * src_ustride ..];
+        const u_in1 = src_u[(2 * y + 1) * src_ustride ..];
+        const v_in0 = src_v[(2 * y + 0) * src_vstride ..];
+        const v_in1 = src_v[(2 * y + 1) * src_vstride ..];
+        const u_out = dst_u[y * dst_ustride ..];
+        const v_out = dst_v[y * dst_vstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            u_out[x] = @intCast((@as(u16, u_in0[x]) + @as(u16, u_in1[x]) + 1) >> 1);
+            v_out[x] = @intCast((@as(u16, v_in0[x]) + @as(u16, v_in1[x]) + 1) >> 1);
+        }
+    }
+}
+
+pub fn yuv444p_to_yuv420p(
+    src_y: []const u8, src_ystride: usize,
+    src_u: []const u8, src_ustride: usize,
+    src_v: []const u8, src_vstride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    copy_plane(src_y, src_ystride, dst_y, dst_ystride, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const u_in0 = src_u[(2 * y + 0) * src_ustride ..];
+        const u_in1 = src_u[(2 * y + 1) * src_ustride ..];
+        const v_in0 = src_v[(2 * y + 0) * src_vstride ..];
+        const v_in1 = src_v[(2 * y + 1) * src_vstride ..];
+        const u_out = dst_u[y * dst_ustride ..];
+        const v_out = dst_v[y * dst_vstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            const u_sum = @as(u32, u_in0[2 * x]) + u_in0[2 * x + 1] + u_in1[2 * x] + u_in1[2 * x + 1];
+            const v_sum = @as(u32, v_in0[2 * x]) + v_in0[2 * x + 1] + v_in1[2 * x] + v_in1[2 * x + 1];
+            u_out[x] = @intCast((u_sum + 2) >> 2);
+            v_out[x] = @intCast((v_sum + 2) >> 2);
+        }
+    }
+}
+
+pub fn yuv420p_to_yuv444p(
+    src_y: []const u8, src_ystride: usize,
+    src_u: []const u8, src_ustride: usize,
+    src_v: []const u8, src_vstride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    copy_plane(src_y, src_ystride, dst_y, dst_ystride, w, h);
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var y: usize = 0;
+    while (y < ch) : (y += 1) {
+        const u_in = src_u[y * src_ustride ..];
+        const v_in = src_v[y * src_vstride ..];
+        const u_out0 = dst_u[(2 * y + 0) * dst_ustride ..];
+        const u_out1 = dst_u[(2 * y + 1) * dst_ustride ..];
+        const v_out0 = dst_v[(2 * y + 0) * dst_vstride ..];
+        const v_out1 = dst_v[(2 * y + 1) * dst_vstride ..];
+        var x: usize = 0;
+        while (x < cw) : (x += 1) {
+            const u_val = u_in[x];
+            const v_val = v_in[x];
+            u_out0[2 * x + 0] = u_val;
+            u_out0[2 * x + 1] = u_val;
+            u_out1[2 * x + 0] = u_val;
+            u_out1[2 * x + 1] = u_val;
+            v_out0[2 * x + 0] = v_val;
+            v_out0[2 * x + 1] = v_val;
+            v_out1[2 * x + 0] = v_val;
+            v_out1[2 * x + 1] = v_val;
+        }
+    }
+}
