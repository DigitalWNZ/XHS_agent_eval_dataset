+    // SWS_PIXFMT_YUV444P = 2, SWS_PIXFMT_YUV420P = 0
+    void *ctx = swscale_create(w, h, 2, w, h, 0, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    // Test cand yuv444p_to_yuv420p formula
+    uint8_t *cand_u = malloc((w/2) * (h/2));
+    for (int y=0; y<h/2; y++) {
+        const uint8_t *u0 = src_u + (2*y) * w;
+        const uint8_t *u1 = src_u + (2*y + 1) * w;
+        uint8_t *du = cand_u + y * (w/2);
+        for (int x=0; x<w/2; x++) {
+            int sum = u0[2*x] + u0[2*x+1] + u1[2*x] + u1[2*x+1];
+            du[x] = (sum + 2) >> 2;
+        }
+    }
+
+    int diff_u = 0;
+    for (int i=0; i<(w/2)*(h/2); i++) {
+        if (cand_u[i] != ref_u[i]) diff_u++;
+    }
+
+    printf("yuv444p->yuv420p U diffs: cand (sum+2)/4 vs ref = %d / %d\n", diff_u, (w/2)*(h/2));
+    if (diff_u > 0) {
+        printf("Ref U row 0: "); for (int i=0; i<10; i++) printf("%d ", ref_u[i]); printf("\n");
+        printf("Cand U row 0: "); for (int i=0; i<10; i++) printf("%d ", cand_u[i]); printf("\n");
+    }
+
+    return 0;
+}
