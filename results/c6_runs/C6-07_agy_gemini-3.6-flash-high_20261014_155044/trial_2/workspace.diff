+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 4;
+            const r = @as(i32, s_row[s_off + 0]);
+            const g = @as(i32, s_row[s_off + 1]);
+            const b = @as(i32, s_row[s_off + 2]);
+            d_row[x] = clampU8((19595 * r + 38470 * g + 7471 * b + 32768) >> 16);
