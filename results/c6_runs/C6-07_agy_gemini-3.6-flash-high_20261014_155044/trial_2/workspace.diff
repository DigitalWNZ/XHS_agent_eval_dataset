+const std = @import("std");
+const types = @import("types.zig");
+const scale = @import("scale.zig");
+
+pub const SwsContext = struct {
+    src_w: usize,
+    src_h: usize,
+    src_fmt: c_int,
+    dst_w: usize,
+    dst_h: usize,
+    dst_fmt: c_int,
+    algo: c_int,
+
+    h_lum_filter: scale.ScaleFilter,
+    v_lum_filter: scale.ScaleFilter,
+    h_chr_filter: scale.ScaleFilter,
+    v_chr_filter: scale.ScaleFilter,
+
+    pub fn init(
+        allocator: std.mem.Allocator,
+        src_w: usize, src_h: usize, src_fmt: c_int,
+        dst_w: usize, dst_h: usize, dst_fmt: c_int,
+        algo: c_int,
+    ) !*SwsContext {
+        const ctx = try allocator.create(SwsContext);
+        errdefer allocator.destroy(ctx);
+
+        const src_chr_w = getChromaW(src_w, src_fmt);
+        const src_chr_h = getChromaH(src_h, src_fmt);
+        const dst_chr_w = getChromaW(dst_w, dst_fmt);
+        const dst_chr_h = getChromaH(dst_h, dst_fmt);
+
+        const h_lum = try scale.ScaleFilter.init(allocator, src_w, dst_w, algo);
+        errdefer h_lum.deinit(allocator);
+
+        const v_lum = try scale.ScaleFilter.init(allocator, src_h, dst_h, algo);
+        errdefer v_lum.deinit(allocator);
+
+        const h_chr = try scale.ScaleFilter.init(allocator, src_chr_w, dst_chr_w, algo);
+        errdefer h_chr.deinit(allocator);
+
+        const v_chr = try scale.ScaleFilter.init(allocator, src_chr_h, dst_chr_h, algo);
+        errdefer v_chr.deinit(allocator);
+
+        ctx.* = .{
+            .src_w = src_w,
+            .src_h = src_h,
+            .src_fmt = src_fmt,
+            .dst_w = dst_w,
+            .dst_h = dst_h,
+            .dst_fmt = dst_fmt,
+            .algo = algo,
+            .h_lum_filter = h_lum,
+            .v_lum_filter = v_lum,
+            .h_chr_filter = h_chr,
+            .v_chr_filter = v_chr,
+        };
+
+        return ctx;
+    }
+
+    pub fn deinit(self: *SwsContext, allocator: std.mem.Allocator) void {
+        self.h_lum_filter.deinit(allocator);
+        self.v_lum_filter.deinit(allocator);
+        self.h_chr_filter.deinit(allocator);
+        self.v_chr_filter.deinit(allocator);
+        allocator.destroy(self);
+    }
+};
+
+fn getChromaW(w: usize, fmt: c_int) usize {
+    return switch (fmt) {
+        types.PIXFMT_YUV420P, types.PIXFMT_YUV422P, types.PIXFMT_NV12, types.PIXFMT_NV21 => (w + 1) / 2,
+        else => w,
+    };
+}
+
+fn getChromaH(h: usize, fmt: c_int) usize {
+    return switch (fmt) {
+        types.PIXFMT_YUV420P, types.PIXFMT_NV12, types.PIXFMT_NV21 => (h + 1) / 2,
+        else => h,
+    };
+}
