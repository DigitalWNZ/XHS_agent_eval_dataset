+        while (x < w) : (x += 1) {
+            const s_off = x * 4;
+            const d_off = x * 3;
+            d_row[d_off + 0] = s_row[s_off + 2];
+            d_row[d_off + 1] = s_row[s_off + 1];
+            d_row[d_off + 2] = s_row[s_off + 0];
+        }
+    }
+}
+
+pub fn gray8_to_rgb24(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const val = s_row[x];
+            const d_off = x * 3;
+            d_row[d_off + 0] = val;
+            d_row[d_off + 1] = val;
+            d_row[d_off + 2] = val;
+        }
+    }
+}
+
+pub fn gray8_to_rgba(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const val = s_row[x];
+            const d_off = x * 4;
+            d_row[d_off + 0] = val;
+            d_row[d_off + 1] = val;
+            d_row[d_off + 2] = val;
+            d_row[d_off + 3] = 255;
+        }
+    }
+}
+
+pub fn gray8_to_yuv420p(
+    src_gray: []const u8, src_stride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src_gray[y * src_stride ..];
+        const d_yrow = dst_y[y * dst_ystride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const g = @as(i32, s_row[x]);
+            d_yrow[x] = clampU8(((28132 * g) >> 15) + 16);
+        }
+    }
+    const cw = (w + 1) / 2;
+    const ch = (h + 1) / 2;
+    var cy: usize = 0;
+    while (cy < ch) : (cy += 1) {
+        @memset(dst_u[cy * dst_ustride ..][0..cw], 128);
+        @memset(dst_v[cy * dst_vstride ..][0..cw], 128);
+    }
+}
+
+pub fn rgb24_to_gray8(src: []const u8, src_stride: usize, dst: []u8, dst_stride: usize, w: usize, h: usize) void {
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const s_row = src[y * src_stride ..];
+        const d_row = dst[y * dst_stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const s_off = x * 3;
+            const r = @as(i32, s_row[s_off + 0]);
+            const g = @as(i32, s_row[s_off + 1]);
+            const b = @as(i32, s_row[s_off + 2]);
+            d_row[x] = clampU8((19595 * r + 38470 * g + 7471 * b + 32768) >> 16);
+        }
+    }
+}
