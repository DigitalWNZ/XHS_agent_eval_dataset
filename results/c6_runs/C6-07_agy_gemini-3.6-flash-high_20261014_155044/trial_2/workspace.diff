+
+typedef void* (*create_fn_t)(int, int, int, int, int, int, int);
+typedef int (*process_fn_t)(void*, const uint8_t *const[4], const int[4], uint8_t *const[4], const int[4]);
+typedef void (*destroy_fn_t)(void*);
+
+int main() {
+    void* handle = dlopen("/app/swscale-impl/zig-out/lib/libswscale_candidate.so", RTLD_NOW);
+    if (!handle) return 1;
+
+    create_fn_t create_fn = (create_fn_t)dlsym(handle, "swscale_create");
+    process_fn_t process_fn = (process_fn_t)dlsym(handle, "swscale_process");
+    destroy_fn_t destroy_fn = (destroy_fn_t)dlsym(handle, "swscale_destroy");
+
+    int w = 2, h = 2;
+    void* ctx = create_fn(w, h, SWS_PIXFMT_BGR24, w, h, SWS_PIXFMT_YUV420P, SWS_ALGO_BILINEAR);
+
+    uint8_t bgr[12] = {
+        0, 0, 255,    0, 255, 0,
+        255, 0, 0,    255, 255, 255
+    };
+    const uint8_t* src_data[4] = { bgr, NULL, NULL, NULL };
+    int src_stride[4] = { 6, 0, 0, 0 };
+
+    uint8_t y_plane[4] = {0};
+    uint8_t u_plane[1] = {0};
+    uint8_t v_plane[1] = {0};
+
+    uint8_t* dst_data[4] = { y_plane, u_plane, v_plane, NULL };
+    int dst_stride[4] = { 2, 1, 1, 0 };
+
+    process_fn(ctx, src_data, src_stride, dst_data, dst_stride);
+
+    printf("Candidate output for 2x2 BGR24 -> YUV420P:\n");
+    printf("Y: %d %d %d %d\n", y_plane[0], y_plane[1], y_plane[2], y_plane[3]);
+    printf("U: %d\n", u_plane[0]);
+    printf("V: %d\n", v_plane[0]);
+
+    destroy_fn(ctx);
+    dlclose(handle);
+    return 0;
+}
