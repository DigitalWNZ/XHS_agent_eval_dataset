--- /dev/null
+++ b/swscale-impl/scratch/test_rgb24_exact3.c
@@ -0,0 +1,83 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+static inline uint8_t clampU8(int v) {
+    return v < 0 ? 0 : (v > 255 ? 255 : v);
+}
+
+void test_exact(const uint8_t *src, int src_st, uint8_t *dst_y, int y_st, uint8_t *dst_u, int u_st, uint8_t *dst_v, int v_st, int w, int h) {
+    // Coefficients from FFmpeg c->input_rgb2yuv_table for SWS_CS_DEFAULT
+    // RY=8412, GY=16508, BY=3212
+    // RU=-4866, GU=-9522, BU=14387
+    // RV=14387, GV=-12056, BV=-2331
+    int32_t ry = 8412, gy = 16508, by = 3212;
+    int32_t ru = -4866, gu = -9522, bu = 14387;
+    int32_t rv = 14387, gv = -12056, bv = -2331;
+
+    for (int y = 0; y < h; y += 2) {
+        const uint8_t *src1 = src + y * src_st;
+        const uint8_t *src2 = src + (y + 1) * src_st;
+        uint8_t *ydst1 = dst_y + y * y_st;
+        uint8_t *ydst2 = dst_y + (y + 1) * y_st;
+        uint8_t *udst = dst_u + (y / 2) * u_st;
+        uint8_t *vdst = dst_v + (y / 2) * v_st;
+
+        for (int i = 0; i < w / 2; i++) {
+            unsigned int r11 = src1[6 * i + 0], g11 = src1[6 * i + 1], b11 = src1[6 * i + 2];
+            unsigned int r12 = src1[6 * i + 3], g12 = src1[6 * i + 4], b12 = src1[6 * i + 5];
+            unsigned int r21 = src2[6 * i + 0], g21 = src2[6 * i + 1], b21 = src2[6 * i + 2];
+            unsigned int r22 = src2[6 * i + 3], g22 = src2[6 * i + 4], b22 = src2[6 * i + 5];
+
+            ydst1[2 * i + 0] = clampU8((((ry * r11 + gy * g11 + by * b11 + 524544) >> 8) + 64) >> 7);
+            ydst1[2 * i + 1] = clampU8((((ry * r12 + gy * g12 + by * b12 + 524544) >> 8) + 64) >> 7);
