+++ b/swscale-impl/scratch/test_yuv_bilinear.c
@@ -0,0 +1,112 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+int main() {
+    int src_w = 1280, src_h = 720;
+    int dst_w = 640, dst_h = 360;
+
+    uint8_t *src_y = malloc(src_w * src_h);
+    uint8_t *src_u = malloc((src_w/2) * (src_h/2));
+    uint8_t *src_v = malloc((src_w/2) * (src_h/2));
+    for (int i=0; i<src_w*src_h; i++) src_y[i] = i & 0xff;
+    for (int i=0; i<(src_w/2)*(src_h/2); i++) {
+        src_u[i] = (i * 3) & 0xff;
+        src_v[i] = (i * 7) & 0xff;
+    }
+
+    const uint8_t *src_data[4] = {src_y, src_u, src_v, NULL};
+    int src_stride[4] = {src_w, src_w/2, src_w/2, 0};
+
+    uint8_t *ref_y = malloc(dst_w * dst_h);
+    uint8_t *ref_u = malloc((dst_w/2) * (dst_h/2));
+    uint8_t *ref_v = malloc((dst_w/2) * (dst_h/2));
+    uint8_t *ref_data[4] = {ref_y, ref_u, ref_v, NULL};
+    int dst_stride[4] = {dst_w, dst_w/2, dst_w/2, 0};
+
+    // SWS_PIXFMT_YUV420P = 0
+    void *ctx = swscale_create(src_w, src_h, 0, dst_w, dst_h, 0, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    // Filter computation
+    int filterSize = 2;
+    int xInc = (src_w << 16) / dst_w;
+    int yInc = (src_h << 16) / dst_h;
+
+    int32_t *h_pos = malloc(dst_w * sizeof(int32_t));
+    int16_t *h_w = malloc(dst_w * 2 * sizeof(int16_t));
+    int64_t xDstInSrc = (xInc >> 1) - (1 << 15);
+    for (int i = 0; i < dst_w; i++) {
+        int xx = (xDstInSrc - ((filterSize - 1) << 15) + (1 << 15)) >> 16;
+        h_pos[i] = xx;
+        for (int j = 0; j < filterSize; j++) {
+            int64_t diff = (int64_t)(xx + j) * (1 << 16) - xDstInSrc;
+            if (diff < 0) diff = -diff;
+            int64_t coeff = 4096 - (diff * 4096 >> 16);
+            if (coeff < 0) coeff = 0;
+            h_w[i * 2 + j] = coeff;
+        }
+        xDstInSrc += xInc;
+    }
+
+    int32_t *v_pos = malloc(dst_h * sizeof(int32_t));
+    int16_t *v_w = malloc(dst_h * 2 * sizeof(int16_t));
+    int64_t yDstInSrc = (yInc >> 1) - (1 << 15);
+    for (int i = 0; i < dst_h; i++) {
+        int yy = (yDstInSrc - ((filterSize - 1) << 15) + (1 << 15)) >> 16;
+        v_pos[i] = yy;
+        for (int j = 0; j < filterSize; j++) {
+            int64_t diff = (int64_t)(yy + j) * (1 << 16) - yDstInSrc;
+            if (diff < 0) diff = -diff;
+            int64_t coeff = 4096 - (diff * 4096 >> 16);
+            if (coeff < 0) coeff = 0;
+            v_w[i * 2 + j] = coeff;
+        }
+        yDstInSrc += yInc;
+    }
+
+    uint8_t *cand_y = malloc(dst_w * dst_h);
+    for (int dy = 0; dy < dst_h; dy++) {
+        int vp = v_pos[dy];
+        int vw0 = v_w[dy * 2 + 0];
+        int vw1 = v_w[dy * 2 + 1];
+
+        int sy0 = vp < 0 ? 0 : (vp >= src_h ? src_h - 1 : vp);
+        int sy1 = (vp + 1) < 0 ? 0 : ((vp + 1) >= src_h ? src_h - 1 : vp + 1);
+
+        const uint8_t *s0 = src_y + sy0 * src_w;
+        const uint8_t *s1 = src_y + sy1 * src_w;
+        uint8_t *d = cand_y + dy * dst_w;
+
+        for (int dx = 0; dx < dst_w; dx++) {
+            int hp = h_pos[dx];
+            int hw0 = h_w[dx * 2 + 0];
+            int hw1 = h_w[dx * 2 + 1];
+
+            int sx0 = hp < 0 ? 0 : (hp >= src_w ? src_w - 1 : hp);
+            int sx1 = (hp + 1) < 0 ? 0 : ((hp + 1) >= src_w ? src_w - 1 : hp + 1);
+
+            int64_t p00 = s0[sx0];
+            int64_t p01 = s0[sx1];
+            int64_t p10 = s1[sx0];
+            int64_t p11 = s1[sx1];
+
+            int64_t total = (p00 * hw0 + p01 * hw1) * vw0 + (p10 * hw0 + p11 * hw1) * vw1;
+            int val = (total + (1 << 23)) >> 24;
+            if (val < 0) val = 0;
+            if (val > 255) val = 255;
+            d[dx] = val;
+        }
+    }
+
+    int diff_y = 0;
+    for (int i = 0; i < dst_w * dst_h; i++) {
+        if (cand_y[i] != ref_y[i]) diff_y++;
+    }
+
+    printf("2-tap Bilinear YUV420P 2:1 downscale Y diffs = %d / %d\n", diff_y, dst_w * dst_h);
+    return 0;
+}
