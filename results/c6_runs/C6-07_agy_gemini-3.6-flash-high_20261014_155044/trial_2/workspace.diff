+        for (int x=0; x<w; x++) {
+            src_y[y * w + x] = (x + y) & 0xff;
+        }
+    }
+    for (int y=0; y<h/2; y++) {
+        for (int x=0; x<w/2; x++) {
+            src_uv[y * w + x * 2 + 0] = (x * 3 + y * 5) & 0xff; // U
+            src_uv[y * w + x * 2 + 1] = (x * 7 + y * 2) & 0xff; // V
+        }
+    }
+
+    const uint8_t *src_data[4] = {src_y, src_uv, NULL, NULL};
+    int src_stride[4] = {w, w, 0, 0};
+
+    uint8_t *ref_rgb = malloc(w * h * 3);
+    uint8_t *ref_data[4] = {ref_rgb, NULL, NULL, NULL};
+    int dst_stride[4] = {w * 3, 0, 0, 0};
+
+    void *ref_ctx = swscale_create(w, h, 3, w, h, 5, 1);
+    swscale_process(ref_ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ref_ctx);
+
+    void *cand_lib = dlopen("/app/swscale-impl/zig-out/lib/libswscale_candidate.so", RTLD_NOW);
+    void *(*c_create)(int, int, int, int, int, int, int) = dlsym(cand_lib, "swscale_create");
+    int (*c_process)(void*, const uint8_t* const[4], const int[4], uint8_t* const[4], const int[4]) = dlsym(cand_lib, "swscale_process");
+    void (*c_destroy)(void*) = dlsym(cand_lib, "swscale_destroy");
+
+    uint8_t *cand_rgb = malloc(w * h * 3);
+    uint8_t *cand_data[4] = {cand_rgb, NULL, NULL, NULL};
+
+    void *cand_ctx = c_create(w, h, 3, w, h, 5, 1);
+    c_process(cand_ctx, src_data, src_stride, cand_data, dst_stride);
+    c_destroy(cand_ctx);
+
+    int count = 0;
+    for (int y=0; y<h; y++) {
+        for (int x=0; x<w; x++) {
+            int idx = (y * w + x) * 3;
+            if (cand_rgb[idx] != ref_rgb[idx] || cand_rgb[idx+1] != ref_rgb[idx+1] || cand_rgb[idx+2] != ref_rgb[idx+2]) {
+                if (count < 10) {
+                    printf("Pixel (x=%d, y=%d): Cand=[%d,%d,%d], Ref=[%d,%d,%d]\n",
+                           x, y, cand_rgb[idx], cand_rgb[idx+1], cand_rgb[idx+2],
+                           ref_rgb[idx], ref_rgb[idx+1], ref_rgb[idx+2]);
+                }
+                count++;
+            }
+        }
+    }
+    printf("Total diff pixels = %d / %d\n", count, w*h);
+
+    return 0;
+}
