+            }
+        } else if (algo == types.ALGO_BILINEAR and xInc <= (1 << 16)) { // BILINEAR UPSCALE
+            var xDstInSrc: i64 = (xInc >> 1) - (1 << 15);
+            var x: usize = 0;
+            while (x < dst_size) : (x += 1) {
+                var p: i32 = @intCast(xDstInSrc >> 16);
+                if (p < 0) p = 0;
+                if (p >= src_size - 1) p = @intCast(src_size - 2);
+                pos[x] = p;
+
+                const diff: i64 = if (xDstInSrc < 0) 0 else xDstInSrc - (@as(i64, p) << 16);
+                const frac: i64 = @min(0x10000, @max(0, diff));
+                const w1: i16 = @intCast(((0x10000 - frac) * 4096 + 0x8000) >> 16);
+                const w2: i16 = 4096 - w1;
+                weights[x * 2 + 0] = w1;
+                weights[x * 2 + 1] = w2;
+                xDstInSrc += xInc;
+            }
+        } else if (algo == types.ALGO_BILINEAR) { // BILINEAR DOWNSCALE
+            var xDstInSrc: i64 = 0;
+            var x: usize = 0;
+            while (x < dst_size) : (x += 1) {
+                var xx: i32 = @intCast(@divTrunc(xDstInSrc - @as(i64, @intCast(filter_size - 2)) * 65536, 131072));
+                if (xx < 0) xx = 0;
+                if (xx + @as(i32, @intCast(filter_size)) > src_size) xx = @intCast(src_size - filter_size);
+                pos[x] = xx;
+
+                var sum_raw: i64 = 0;
+                var k: usize = 0;
+                while (k < filter_size) : (k += 1) {
+                    const px: i64 = xx + @as(i32, @intCast(k));
+                    const diff_val: i64 = @intCast(@abs(px * 131072 - xDstInSrc));
+                    var d: i64 = diff_val << 13;
+                    d = @divTrunc(d * @as(i64, @intCast(dst_size)), @as(i64, @intCast(src_size)));
+                    const coeff: i64 = if (d < (1 << 30)) (1 << 30) - d else 0;
+                    sum_raw += coeff;
+                }
+
+                var k2: usize = 0;
+                var w_sum: i32 = 0;
+                while (k2 < filter_size) : (k2 += 1) {
+                    const px: i64 = xx + @as(i32, @intCast(k2));
+                    const diff_val: i64 = @intCast(@abs(px * 131072 - xDstInSrc));
+                    var d: i64 = diff_val << 13;
+                    d = @divTrunc(d * @as(i64, @intCast(dst_size)), @as(i64, @intCast(src_size)));
+                    const coeff: i64 = if (d < (1 << 30)) (1 << 30) - d else 0;
+                    const w_val: i16 = if (sum_raw > 0) @intCast(@divTrunc(coeff * 4096 + (sum_raw >> 1), sum_raw)) else 0;
+                    weights[x * filter_size + k2] = w_val;
+                    w_sum += w_val;
+                }
+                weights[x * filter_size + (filter_size / 2)] += @intCast(4096 - w_sum);
+                xDstInSrc += 2 * xInc;
+            }
+        } else { // BICUBIC
+            var x: usize = 0;
+            while (x < dst_size) : (x += 1) {
+                const S: f64 = @as(f64, @floatFromInt(src_size)) / @as(f64, @floatFromInt(dst_size));
+                const src_x_f: f64 = (@as(f64, @floatFromInt(x)) + 0.5) * S - 0.5;
+                var p: i32 = @intFromFloat(@floor(src_x_f - @as(f64, @floatFromInt(filter_size / 2 - 1))));
+                if (p < 0) p = 0;
+                if (p + @as(i32, @intCast(filter_size)) > src_size) p = @intCast(src_size - filter_size);
+                pos[x] = p;
+
+                var sum_f: f64 = 0.0;
+                var k: usize = 0;
+                while (k < filter_size) : (k += 1) {
+                    const px_f: f64 = @as(f64, @floatFromInt(p + @as(i32, @intCast(k))));
+                    const d: f64 = @abs(px_f - src_x_f);
+                    const w = bicubicWeight(d);
+                    sum_f += w;
+                }
+                var k2: usize = 0;
+                var w_sum: i32 = 0;
+                while (k2 < filter_size) : (k2 += 1) {
+                    const px_f: f64 = @as(f64, @floatFromInt(p + @as(i32, @intCast(k2))));
+                    const d: f64 = @abs(px_f - src_x_f);
+                    const w_val: i16 = @intFromFloat(@round((bicubicWeight(d) / sum_f) * 4096.0));
+                    weights[x * filter_size + k2] = w_val;
+                    w_sum += w_val;
+                }
+                weights[x * filter_size + (filter_size / 2)] += @intCast(4096 - w_sum);
+            }
+        }
+
+        return .{
+            .pos = pos,
+            .weights = weights,
+            .filter_size = filter_size,
+        };
+    }
+
+    pub fn deinit(self: ScaleFilter, allocator: std.mem.Allocator) void {
+        allocator.free(self.pos);
+        allocator.free(self.weights);
+    }
+};
+
+fn bicubicWeight(d: f64) f64 {
+    const a: f64 = -0.5;
+    if (d <= 1.0) {
+        return (a + 2.0) * d * d * d - (a + 3.0) * d * d + 1.0;
+    } else if (d < 2.0) {
+        return a * d * d * d - 5.0 * a * d * d + 8.0 * a * d - 4.0 * a;
+    } else {
+        return 0.0;
+    }
+}
+
+pub fn scale_plane(
+    src: []const u8, src_stride: usize, src_w: usize, src_h: usize,
+    dst: []u8, dst_stride: usize, dst_w: usize, dst_h: usize,
+    h_filter: ScaleFilter, v_filter: ScaleFilter,
+    allocator: std.mem.Allocator,
+) !void {
+    const h_fsize = h_filter.filter_size;
+    const v_fsize = v_filter.filter_size;
+
+    const h_buf = try allocator.alloc(i32, src_h * dst_w);
+    defer allocator.free(h_buf);
+
+    var sy: usize = 0;
+    while (sy < src_h) : (sy += 1) {
+        const src_row = src[sy * src_stride ..];
+        const h_row = h_buf[sy * dst_w ..];
+        var x_dst: usize = 0;
+        while (x_dst < dst_w) : (x_dst += 1) {
+            const h_p = h_filter.pos[x_dst];
+            const h_w = h_filter.weights[x_dst * h_fsize ..][0..h_fsize];
+            var h_sum: i64 = 0;
+            var k: usize = 0;
+            while (k < h_fsize) : (k += 1) {
+                const sx: usize = @intCast(@max(0, @min(@as(i32, @intCast(src_w - 1)), h_p + @as(i32, @intCast(k)))));
+                h_sum += @as(i64, src_row[sx]) * @as(i64, h_w[k]);
+            }
+            h_row[x_dst] = @intCast((h_sum + (1 << 11)) >> 12);
+        }
+    }
+
+    var y_dst: usize = 0;
+    while (y_dst < dst_h) : (y_dst += 1) {
+        const v_p = v_filter.pos[y_dst];
+        const v_w = v_filter.weights[y_dst * v_fsize ..][0..v_fsize];
+        const dst_row = dst[y_dst * dst_stride ..][0..dst_w];
+
+        var x_dst: usize = 0;
+        while (x_dst < dst_w) : (x_dst += 1) {
+            var v_sum: i64 = 0;
+            var j: usize = 0;
+            while (j < v_fsize) : (j += 1) {
+                const sy_p: usize = @intCast(@max(0, @min(@as(i32, @intCast(src_h - 1)), v_p + @as(i32, @intCast(j)))));
+                const h_val = h_buf[sy_p * dst_w + x_dst];
+                v_sum += @as(i64, h_val) * @as(i64, v_w[j]);
+            }
+            dst_row[x_dst] = clampU8(@intCast((v_sum + (1 << 18)) >> 19));
+        }
+    }
+}
+
+pub fn scale_process(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const allocator = std.heap.c_allocator;
+
+    const is_src_rgb = isRGB(ctx.src_fmt);
+    const is_dst_rgb = isRGB(ctx.dst_fmt);
+
+    if (is_src_rgb and is_dst_rgb) {
+        const src_r = allocator.alloc(u8, ctx.src_w * ctx.src_h) catch return -1;
+        defer allocator.free(src_r);
+        const src_g = allocator.alloc(u8, ctx.src_w * ctx.src_h) catch return -1;
+        defer allocator.free(src_g);
+        const src_b = allocator.alloc(u8, ctx.src_w * ctx.src_h) catch return -1;
+        defer allocator.free(src_b);
+        const src_a = allocator.alloc(u8, ctx.src_w * ctx.src_h) catch return -1;
+        defer allocator.free(src_a);
+
+        extract_rgb(src_data[0] orelse return -1, @intCast(src_stride[0]), ctx.src_w, ctx.src_h, ctx.src_fmt, src_r, src_g, src_b, src_a);
+
+        const dst_r = allocator.alloc(u8, ctx.dst_w * ctx.dst_h) catch return -1;
+        defer allocator.free(dst_r);
+        const dst_g = allocator.alloc(u8, ctx.dst_w * ctx.dst_h) catch return -1;
+        defer allocator.free(dst_g);
+        const dst_b = allocator.alloc(u8, ctx.dst_w * ctx.dst_h) catch return -1;
+        defer allocator.free(dst_b);
+        const dst_a = allocator.alloc(u8, ctx.dst_w * ctx.dst_h) catch return -1;
+        defer allocator.free(dst_a);
+
+        scale_plane(src_r, ctx.src_w, ctx.src_w, ctx.src_h, dst_r, ctx.dst_w, ctx.dst_w, ctx.dst_h, ctx.h_lum_filter, ctx.v_lum_filter, allocator) catch return -1;
+        scale_plane(src_g, ctx.src_w, ctx.src_w, ctx.src_h, dst_g, ctx.dst_w, ctx.dst_w, ctx.dst_h, ctx.h_lum_filter, ctx.v_lum_filter, allocator) catch return -1;
+        scale_plane(src_b, ctx.src_w, ctx.src_w, ctx.src_h, dst_b, ctx.dst_w, ctx.dst_w, ctx.dst_h, ctx.h_lum_filter, ctx.v_lum_filter, allocator) catch return -1;
+        scale_plane(src_a, ctx.src_w, ctx.src_w, ctx.src_h, dst_a, ctx.dst_w, ctx.dst_w, ctx.dst_h, ctx.h_lum_filter, ctx.v_lum_filter, allocator) catch return -1;
+
+        pack_rgb(dst_r, dst_g, dst_b, dst_a, dst_data[0] orelse return -1, @intCast(dst_stride[0]), ctx.dst_w, ctx.dst_h, ctx.dst_fmt);
+        return 0;
+    }
+
+    if (ctx.src_fmt == types.PIXFMT_GRAY8 and ctx.dst_fmt == types.PIXFMT_GRAY8) {
+        const s_ptr = src_data[0] orelse return -1;
+        const d_ptr = dst_data[0] orelse return -1;
+        scale_plane(s_ptr[0 .. ctx.src_h * @as(usize, @intCast(src_stride[0]))], @intCast(src_stride[0]), ctx.src_w, ctx.src_h, d_ptr[0 .. ctx.dst_h * @as(usize, @intCast(dst_stride[0]))], @intCast(dst_stride[0]), ctx.dst_w, ctx.dst_h, ctx.h_lum_filter, ctx.v_lum_filter, allocator) catch return -1;
+        return 0;
+    }
+
+    // Direct planar YUV scaling using natural plane sizes
+    const src_chr_w = types.planeWidth(ctx.src_fmt, ctx.src_w, 1);
+    const src_chr_h = types.planeRows(ctx.src_fmt, ctx.src_h, 1);
+    const dst_chr_w = types.planeWidth(ctx.dst_fmt, ctx.dst_w, 1);
+    const dst_chr_h = types.planeRows(ctx.dst_fmt, ctx.dst_h, 1);
+
+    // Extract / convert src planes
+    const sy_buf = allocator.alloc(u8, ctx.src_w * ctx.src_h) catch return -1;
+    defer allocator.free(sy_buf);
+    const su_buf = allocator.alloc(u8, src_chr_w * src_chr_h) catch return -1;
+    defer allocator.free(su_buf);
+    const sv_buf = allocator.alloc(u8, src_chr_w * src_chr_h) catch return -1;
+    defer allocator.free(sv_buf);
+
+    if (is_src_rgb) {
+        const src_ptr = src_data[0] orelse return -1;
+        const s_st: usize = @intCast(src_stride[0]);
+        if (ctx.src_fmt == types.PIXFMT_RGB24) {
+            if (src_chr_w == ctx.src_w and src_chr_h == ctx.src_h) {
+                rgb2yuv.rgb24_to_yuv444p(src_ptr[0 .. ctx.src_h * s_st], s_st, sy_buf, ctx.src_w, su_buf, ctx.src_w, sv_buf, ctx.src_w, ctx.src_w, ctx.src_h);
+            } else if (src_chr_w == (ctx.src_w + 1) / 2 and src_chr_h == (ctx.src_h + 1) / 2) {
+                rgb2yuv.rgb24_to_yuv420p(src_ptr[0 .. ctx.src_h * s_st], s_st, sy_buf, ctx.src_w, su_buf, src_chr_w, sv_buf, src_chr_w, ctx.src_w, ctx.src_h);
+            }
+        } else if (ctx.src_fmt == types.PIXFMT_BGR24) {
+            if (src_chr_w == (ctx.src_w + 1) / 2 and src_chr_h == (ctx.src_h + 1) / 2) {
+                rgb2yuv.bgr24_to_yuv420p(src_ptr[0 .. ctx.src_h * s_st], s_st, sy_buf, ctx.src_w, su_buf, src_chr_w, sv_buf, src_chr_w, ctx.src_w, ctx.src_h);
+            }
+        } else if (ctx.src_fmt == types.PIXFMT_RGBA) {
+            if (src_chr_w == (ctx.src_w + 1) / 2 and src_chr_h == (ctx.src_h + 1) / 2) {
+                rgb2yuv.rgba_to_yuv420p(src_ptr[0 .. ctx.src_h * s_st], s_st, sy_buf, ctx.src_w, su_buf, src_chr_w, sv_buf, src_chr_w, ctx.src_w, ctx.src_h);
+            }
+        } else if (ctx.src_fmt == types.PIXFMT_BGRA) {
+            if (src_chr_w == (ctx.src_w + 1) / 2 and src_chr_h == (ctx.src_h + 1) / 2) {
+                rgb2yuv.bgra_to_yuv420p(src_ptr[0 .. ctx.src_h * s_st], s_st, sy_buf, ctx.src_w, su_buf, src_chr_w, sv_buf, src_chr_w, ctx.src_w, ctx.src_h);
+            }
+        }
+    } else {
+        extract_yuv_src_native(ctx, src_data, src_stride, sy_buf, su_buf, sv_buf);
+    }
+
+    const dy_buf = allocator.alloc(u8, ctx.dst_w * ctx.dst_h) catch return -1;
+    defer allocator.free(dy_buf);
+    const du_buf = allocator.alloc(u8, dst_chr_w * dst_chr_h) catch return -1;
+    defer allocator.free(du_buf);
+    const dv_buf = allocator.alloc(u8, dst_chr_w * dst_chr_h) catch return -1;
+    defer allocator.free(dv_buf);
+
+    scale_plane(sy_buf, ctx.src_w, ctx.src_w, ctx.src_h, dy_buf, ctx.dst_w, ctx.dst_w, ctx.dst_h, ctx.h_lum_filter, ctx.v_lum_filter, allocator) catch return -1;
+    scale_plane(su_buf, src_chr_w, src_chr_w, src_chr_h, du_buf, dst_chr_w, dst_chr_w, dst_chr_h, ctx.h_chr_filter, ctx.v_chr_filter, allocator) catch return -1;
+    scale_plane(sv_buf, src_chr_w, src_chr_w, src_chr_h, dv_buf, dst_chr_w, dst_chr_w, dst_chr_h, ctx.h_chr_filter, ctx.v_chr_filter, allocator) catch return -1;
+
+    if (is_dst_rgb) {
+        const dst_ptr = dst_data[0] orelse return -1;
+        const d_st: usize = @intCast(dst_stride[0]);
+
+        if (ctx.dst_fmt == types.PIXFMT_RGB24) {
+            yuv2rgb.yuv420p_to_rgb24(dy_buf, ctx.dst_w, du_buf, dst_chr_w, dv_buf, dst_chr_w, dst_ptr[0 .. ctx.dst_h * d_st], d_st, ctx.dst_w, ctx.dst_h);
+        } else if (ctx.dst_fmt == types.PIXFMT_BGR24) {
+            yuv2rgb.yuv420p_to_bgr24(dy_buf, ctx.dst_w, du_buf, dst_chr_w, dv_buf, dst_chr_w, dst_ptr[0 .. ctx.dst_h * d_st], d_st, ctx.dst_w, ctx.dst_h);
+        }
+        return 0;
+    }
+
+    write_yuv_dst_native(ctx, dst_data, dst_stride, dy_buf, du_buf, dv_buf);
+    return 0;
+}
+
+fn isRGB(fmt: c_int) bool {
+    return switch (fmt) {
+        types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA => true,
+        else => false,
+    };
+}
+
+fn extract_rgb(src: [*]const u8, stride: usize, w: usize, h: usize, fmt: c_int, r: []u8, g: []u8, b: []u8, a: []u8) void {
+    const bpp: usize = if (fmt == types.PIXFMT_RGBA or fmt == types.PIXFMT_BGRA) 4 else 3;
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const row = src[y * stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const idx = x * bpp;
+            const px_idx = y * w + x;
+            if (fmt == types.PIXFMT_RGB24) {
+                r[px_idx] = row[idx + 0];
+                g[px_idx] = row[idx + 1];
+                b[px_idx] = row[idx + 2];
+                a[px_idx] = 255;
+            } else if (fmt == types.PIXFMT_BGR24) {
+                b[px_idx] = row[idx + 0];
+                g[px_idx] = row[idx + 1];
+                r[px_idx] = row[idx + 2];
+                a[px_idx] = 255;
+            } else if (fmt == types.PIXFMT_RGBA) {
+                r[px_idx] = row[idx + 0];
+                g[px_idx] = row[idx + 1];
+                b[px_idx] = row[idx + 2];
+                a[px_idx] = row[idx + 3];
+            } else if (fmt == types.PIXFMT_BGRA) {
+                b[px_idx] = row[idx + 0];
+                g[px_idx] = row[idx + 1];
+                r[px_idx] = row[idx + 2];
+                a[px_idx] = row[idx + 3];
+            }
+        }
+    }
+}
+
+fn pack_rgb(r: []const u8, g: []const u8, b: []const u8, a: []const u8, dst: [*]u8, stride: usize, w: usize, h: usize, fmt: c_int) void {
+    const bpp: usize = if (fmt == types.PIXFMT_RGBA or fmt == types.PIXFMT_BGRA) 4 else 3;
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const row = dst[y * stride ..];
+        var x: usize = 0;
+        while (x < w) : (x += 1) {
+            const idx = x * bpp;
+            const px_idx = y * w + x;
+            if (fmt == types.PIXFMT_RGB24) {
+                row[idx + 0] = r[px_idx];
+                row[idx + 1] = g[px_idx];
+                row[idx + 2] = b[px_idx];
+            } else if (fmt == types.PIXFMT_BGR24) {
+                row[idx + 0] = b[px_idx];
+                row[idx + 1] = g[px_idx];
+                row[idx + 2] = r[px_idx];
+            } else if (fmt == types.PIXFMT_RGBA) {
+                row[idx + 0] = r[px_idx];
+                row[idx + 1] = g[px_idx];
+                row[idx + 2] = b[px_idx];
+                row[idx + 3] = a[px_idx];
+            } else if (fmt == types.PIXFMT_BGRA) {
+                row[idx + 0] = b[px_idx];
+                row[idx + 1] = g[px_idx];
+                row[idx + 2] = r[px_idx];
+                row[idx + 3] = a[px_idx];
+            }
+        }
+    }
+}
+
+fn extract_yuv_src_native(ctx: *SwsContext, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int, y_buf: []u8, u_buf: []u8, v_buf: []u8) void {
+    const w = ctx.src_w;
+    const h = ctx.src_h;
+    const cw = types.planeWidth(ctx.src_fmt, w, 1);
+    const ch = types.planeRows(ctx.src_fmt, h, 1);
+
+    const sy = (src_data[0] orelse return)[0 .. h * @as(usize, @intCast(src_stride[0]))];
+    chroma.copy_plane(sy, @intCast(src_stride[0]), y_buf, w, w, h);
+
+    if (ctx.src_fmt == types.PIXFMT_YUV420P or ctx.src_fmt == types.PIXFMT_YUV422P or ctx.src_fmt == types.PIXFMT_YUV444P) {
+        const su = (src_data[1] orelse return)[0 .. ch * @as(usize, @intCast(src_stride[1]))];
+        const sv = (src_data[2] orelse return)[0 .. ch * @as(usize, @intCast(src_stride[2]))];
+        chroma.copy_plane(su, @intCast(src_stride[1]), u_buf, cw, cw, ch);
+        chroma.copy_plane(sv, @intCast(src_stride[2]), v_buf, cw, cw, ch);
+    }
+}
+
+fn write_yuv_dst_native(ctx: *SwsContext, dst_data: [*]const ?[*]u8, dst_stride: [*]const c_int, y_buf: []const u8, u_buf: []const u8, v_buf: []const u8) void {
+    const w = ctx.dst_w;
+    const h = ctx.dst_h;
+    const cw = types.planeWidth(ctx.dst_fmt, w, 1);
+    const ch = types.planeRows(ctx.dst_fmt, h, 1);
+
+    const dy = (dst_data[0] orelse return)[0 .. h * @as(usize, @intCast(dst_stride[0]))];
+    chroma.copy_plane(y_buf, w, dy, @intCast(dst_stride[0]), w, h);
+
+    if (ctx.dst_fmt == types.PIXFMT_YUV420P or ctx.dst_fmt == types.PIXFMT_YUV422P or ctx.dst_fmt == types.PIXFMT_YUV444P) {
+        const du = (dst_data[1] orelse return)[0 .. ch * @as(usize, @intCast(dst_stride[1]))];
+        const dv = (dst_data[2] orelse return)[0 .. ch * @as(usize, @intCast(dst_stride[2]))];
+        chroma.copy_plane(u_buf, cw, du, @intCast(dst_stride[1]), cw, ch);
+        chroma.copy_plane(v_buf, cw, dv, @intCast(dst_stride[2]), cw, ch);
+    }
+}
