+const std = @import("std");
+
+pub const PIXFMT_YUV420P: c_int = 0;
+pub const PIXFMT_YUV422P: c_int = 1;
+pub const PIXFMT_YUV444P: c_int = 2;
+pub const PIXFMT_NV12: c_int = 3;
+pub const PIXFMT_NV21: c_int = 4;
+pub const PIXFMT_RGB24: c_int = 5;
+pub const PIXFMT_BGR24: c_int = 6;
+pub const PIXFMT_RGBA: c_int = 7;
+pub const PIXFMT_BGRA: c_int = 8;
+pub const PIXFMT_GRAY8: c_int = 9;
+
