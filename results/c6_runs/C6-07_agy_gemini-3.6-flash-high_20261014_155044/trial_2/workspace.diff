+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <math.h>
+#include "/app/swscale_api.h"
+
+int main() {
+    int src_w = 1280, src_h = 720;
+    int dst_w = 640, dst_h = 360;
+
+    uint8_t *src = malloc(src_w * src_h * 3);
+    for (int y = 0; y < src_h; y++) {
+        for (int x = 0; x < src_w; x++) {
+            src[(y * src_w + x) * 3 + 0] = (x + y) & 0xff;
+            src[(y * src_w + x) * 3 + 1] = (x * 2 + y) & 0xff;
+            src[(y * src_w + x) * 3 + 2] = (x + y * 3) & 0xff;
+        }
+    }
+
+    const uint8_t *src_data[4] = {src, NULL, NULL, NULL};
+    int src_stride[4] = {src_w * 3, 0, 0, 0};
+
+    uint8_t *ref = malloc(dst_w * dst_h * 3);
+    uint8_t *ref_data[4] = {ref, NULL, NULL, NULL};
+    int dst_stride[4] = {dst_w * 3, 0, 0, 0};
+
+    // SWS_ALGO_BILINEAR = 1
+    void *ctx = swscale_create(src_w, src_h, 5, dst_w, dst_h, 5, 1);
+    swscale_process(ctx, src_data, src_stride, ref_data, dst_stride);
+    swscale_destroy(ctx);
+
+    // Compute candidate using FFmpeg 2-tap bilinear formula
+    int filterSize = 2;
+    int xInc = (src_w << 16) / dst_w;
+    int yInc = (src_h << 16) / dst_h;
+
+    int32_t *h_pos = malloc(dst_w * sizeof(int32_t));
+    int16_t *h_w = malloc(dst_w * 2 * sizeof(int16_t));
+
+    int64_t xDstInSrc = (xInc >> 1) - (1 << 15);
+    for (int i = 0; i < dst_w; i++) {
+        int xx = (xDstInSrc - ((filterSize - 1) << 15) + (1 << 15)) >> 16;
+        h_pos[i] = xx;
+        for (int j = 0; j < filterSize; j++) {
+            int64_t diff = (int64_t)(xx + j) * (1 << 16) - xDstInSrc;
+            if (diff < 0) diff = -diff;
+            int64_t coeff = 4096 - (diff * 4096 >> 16);
+            if (coeff < 0) coeff = 0;
+            h_w[i * 2 + j] = coeff;
+        }
+        xDstInSrc += xInc;
+    }
+
+    int32_t *v_pos = malloc(dst_h * sizeof(int32_t));
+    int16_t *v_w = malloc(dst_h * 2 * sizeof(int16_t));
+
+    int64_t yDstInSrc = (yInc >> 1) - (1 << 15);
+    for (int i = 0; i < dst_h; i++) {
+        int yy = (yDstInSrc - ((filterSize - 1) << 15) + (1 << 15)) >> 16;
+        v_pos[i] = yy;
+        for (int j = 0; j < filterSize; j++) {
+            int64_t diff = (int64_t)(yy + j) * (1 << 16) - yDstInSrc;
+            if (diff < 0) diff = -diff;
+            int64_t coeff = 4096 - (diff * 4096 >> 16);
+            if (coeff < 0) coeff = 0;
+            v_w[i * 2 + j] = coeff;
+        }
+        yDstInSrc += yInc;
+    }
+
+    uint8_t *cand = malloc(dst_w * dst_h * 3);
+    for (int dy = 0; dy < dst_h; dy++) {
+        int vp = v_pos[dy];
+        int vw0 = v_w[dy * 2 + 0];
+        int vw1 = v_w[dy * 2 + 1];
+
+        int sy0 = vp < 0 ? 0 : (vp >= src_h ? src_h - 1 : vp);
+        int sy1 = (vp + 1) < 0 ? 0 : ((vp + 1) >= src_h ? src_h - 1 : vp + 1);
+
+        const uint8_t *s0 = src + sy0 * src_w * 3;
+        const uint8_t *s1 = src + sy1 * src_w * 3;
+        uint8_t *d = cand + dy * dst_w * 3;
+
+        for (int dx = 0; dx < dst_w; dx++) {
+            int hp = h_pos[dx];
+            int hw0 = h_w[dx * 2 + 0];
+            int hw1 = h_w[dx * 2 + 1];
+
+            int sx0 = hp < 0 ? 0 : (hp >= src_w ? src_w - 1 : hp);
+            int sx1 = (hp + 1) < 0 ? 0 : ((hp + 1) >= src_w ? src_w - 1 : hp + 1);
+
+            for (int c = 0; c < 3; c++) {
+                int64_t p00 = s0[sx0 * 3 + c];
+                int64_t p01 = s0[sx1 * 3 + c];
+                int64_t p10 = s1[sx0 * 3 + c];
+                int64_t p11 = s1[sx1 * 3 + c];
+
+                int64_t h_sum0 = p00 * hw0 + p01 * hw1;
+                int64_t h_sum1 = p10 * hw0 + p11 * hw1;
+
+                int64_t total = h_sum0 * vw0 + h_sum1 * vw1;
+                int val = (total + (1 << 23)) >> 24;
+                if (val < 0) val = 0;
+                if (val > 255) val = 255;
+                d[dx * 3 + c] = val;
+            }
+        }
+    }
+
+    int diffs = 0;
+    for (int i = 0; i < dst_w * dst_h * 3; i++) {
+        if (cand[i] != ref[i]) diffs++;
+    }
+
+    printf("2-tap Bilinear downscale 1280x720 -> 640x360 diffs = %d / %d\n", diffs, dst_w * dst_h * 3);
+    return 0;
+}
