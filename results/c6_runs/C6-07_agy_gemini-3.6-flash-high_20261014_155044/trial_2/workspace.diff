+pub fn planeCount(fmt: c_int) usize {
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_YUV422P, PIXFMT_YUV444P => 3,
+        PIXFMT_NV12, PIXFMT_NV21 => 2,
+        else => 1,
+    };
+}
+
+pub fn planeWidth(fmt: c_int, w: usize, plane: usize) usize {
+    if (plane == 0) return w;
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_YUV422P, PIXFMT_NV12, PIXFMT_NV21 => (w + 1) / 2,
+        else => w,
+    };
+}
+
+pub fn planeRowBytes(fmt: c_int, w: usize, plane: usize) usize {
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_YUV422P => if (plane == 0) w else (w + 1) / 2,
+        PIXFMT_YUV444P => w,
+        PIXFMT_NV12, PIXFMT_NV21 => if (plane == 0) w else ((w + 1) / 2) * 2,
+        PIXFMT_RGB24, PIXFMT_BGR24 => w * 3,
+        PIXFMT_RGBA, PIXFMT_BGRA => w * 4,
+        PIXFMT_GRAY8 => w,
+        else => w,
+    };
+}
+
+pub fn planeRows(fmt: c_int, h: usize, plane: usize) usize {
+    if (plane == 0) return h;
+    return switch (fmt) {
+        PIXFMT_YUV420P, PIXFMT_NV12, PIXFMT_NV21 => (h + 1) / 2,
+        else => h,
+    };
+}
+
+pub inline fn clampU8(val: i32) u8 {
+    if (val < 0) return 0;
+    if (val > 255) return 255;
+    return @intCast(val);
+}
