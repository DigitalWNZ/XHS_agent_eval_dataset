diff --git a/swscale-impl/src/rgb2yuv.zig b/swscale-impl/src/rgb2yuv.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/rgb2yuv.zig
@@ -0,0 +1,444 @@
+const std = @import("std");
+const types = @import("types.zig");
+const clampU8 = types.clampU8;
+
+pub inline fn rgb_to_y(r: i32, g: i32, b: i32) u8 {
+    const y16 = (8412 * r + 16508 * g + 3212 * b + 524288) >> 8;
+    return clampU8((y16 + 64) >> 7);
+}
+
+pub inline fn rgb_to_u(r: i32, g: i32, b: i32) u8 {
+    const u16_val = (-4866 * r - 9522 * g + 14387 * b + 8388608) >> 8;
+    return clampU8((u16_val + 64) >> 7);
+}
+
+pub inline fn rgb_to_v(r: i32, g: i32, b: i32) u8 {
+    const v16_val = (14387 * r - 12056 * g - 2331 * b + 8388608) >> 8;
+    return clampU8((v16_val + 64) >> 7);
+}
+
+pub fn rgb24_to_yuv420p(
+    src_rgb: []const u8, src_stride: usize,
+    dst_y: []u8, dst_ystride: usize,
+    dst_u: []u8, dst_ustride: usize,
+    dst_v: []u8, dst_vstride: usize,
+    w: usize, h: usize,
+) void {
+    var y: usize = 0;
+    while (y < h) : (y += 2) {
+        const s_row0 = src_rgb[(y + 0) * src_stride ..];
+        const s_row1 = src_rgb[(y + 1) * src_stride ..];
+        const d_yrow0 = dst_y[(y + 0) * dst_ystride ..];
+        const d_yrow1 = dst_y[(y + 1) * dst_ystride ..];
+        const d_urow = dst_u[(y / 2) * dst_ustride ..];
+        const d_vrow = dst_v[(y / 2) * dst_vstride ..];
+
+        var x: usize = 0;
+        while (x < w) : (x += 2) {
+            const r00: i32 = s_row0[(x + 0) * 3 + 0];
+            const g00: i32 = s_row0[(x + 0) * 3 + 1];
+            const b00: i32 = s_row0[(x + 0) * 3 + 2];
+
+            const r01: i32 = s_row0[(x + 1) * 3 + 0];
+            const g01: i32 = s_row0[(x + 1) * 3 + 1];
+            const b01: i32 = s_row0[(x + 1) * 3 + 2];
+
+            const r10: i32 = s_row1[(x + 0) * 3 + 0];
+            const g10: i32 = s_row1[(x + 0) * 3 + 1];
+            const b10: i32 = s_row1[(x + 0) * 3 + 2];
+
+            const r11: i32 = s_row1[(x + 1) * 3 + 0];
+            const g11: i32 = s_row1[(x + 1) * 3 + 1];
+            const b11: i32 = s_row1[(x + 1) * 3 + 2];
+
+            d_yrow0[x + 0] = rgb_to_y(r00, g00, b00);
+            d_yrow0[x + 1] = rgb_to_y(r01, g01, b01);
+            d_yrow1[x + 0] = rgb_to_y(r10, g10, b10);
+            d_yrow1[x + 1] = rgb_to_y(r11, g11, b11);
+
+            const r_sum = r00 + r01 + r10 + r11;
+            const g_sum = g00 + g01 + g10 + g11;
+            const b_sum = b00 + b01 + b10 + b11;
