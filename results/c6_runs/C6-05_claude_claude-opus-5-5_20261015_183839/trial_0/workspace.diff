+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Big integers stored as little-endian base-1e9 limbs. */
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long n = atol(argv[1]);
+    size_t cap = (size_t)(n / 43 + 2);
+    unsigned int *a = calloc(cap, sizeof *a), *b = calloc(cap, sizeof *b);
+    size_t len = 1;
+    a[0] = 0; b[0] = 1;
+    for (long i = 0; i < n; i++) {
+        /* (a, b) = (b, a + b): store a + b into a, then swap */
+        unsigned int carry = 0;
+        for (size_t j = 0; j < len; j++) {
+            unsigned int s = a[j] + b[j] + carry;
+            carry = s >= 1000000000u;
+            a[j] = carry ? s - 1000000000u : s;
+        }
+        if (carry) { a[len] = 1; len++; }
+        unsigned int *t = a; a = b; b = t;
+    }
+    size_t top = len - 1;
+    while (top > 0 && a[top] == 0) top--;
+    printf("%u", a[top]);
+    for (size_t j = top; j-- > 0;) printf("%09u", a[j]);
+    printf("\n");
+    return 0;
+}
