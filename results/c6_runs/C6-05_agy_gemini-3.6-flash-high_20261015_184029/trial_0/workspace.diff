+import subprocess
+import sys
+
+# C implementation test
+c_code = """
+#include <stdio.h>
+#include <stdlib.h>
+
+#define BASE 1000000000
+
+void print_fib(int n) {
+    if (n <= 0) {
+        printf("0\\n");
+        return;
+    }
+    if (n == 1) {
+        printf("1\\n");
+        return;
+    }
+    int max_len = (n / 4) + 10;
+    unsigned int *a = (unsigned int *)calloc(max_len, sizeof(unsigned int));
+    unsigned int *b = (unsigned int *)calloc(max_len, sizeof(unsigned int));
+    unsigned int *c = (unsigned int *)calloc(max_len, sizeof(unsigned int));
+    
+    a[0] = 0;
+    b[0] = 1;
+    int len_a = 1, len_b = 1;
+    
+    for (int i = 2; i <= n; i++) {
+        unsigned int carry = 0;
+        int max_l = (len_a > len_b) ? len_a : len_b;
+        int len_c = 0;
+        for (int j = 0; j < max_l || carry; j++) {
+            unsigned long long sum = carry;
+            if (j < len_a) sum += a[j];
+            if (j < len_b) sum += b[j];
+            c[j] = sum % BASE;
+            carry = sum / BASE;
+            len_c = j + 1;
+        }
+        for (int j = 0; j < len_b; j++) a[j] = b[j];
+        len_a = len_b;
+        for (int j = 0; j < len_c; j++) b[j] = c[j];
+        len_b = len_c;
+    }
+    
+    printf("%u", b[len_b - 1]);
+    for (int j = len_b - 2; j >= 0; j--) {
+        printf("%09u", b[j]);
+    }
+    printf("\\n");
+    
+    free(a); free(b); free(c);
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) return 0;
+    int n = atoi(argv[1]);
+    print_fib(n);
+    return 0;
+}
+"""
+
+with open("/tmp/c_fib.c", "w") as f:
+    f.write(c_code)
+
+subprocess.run(["gcc", "-O3", "/tmp/c_fib.c", "-o", "/tmp/c_fib"], check=True)
+
+def py_fib(n):
+    if n <= 0: return 0
+    a, b = 0, 1
+    for _ in range(n):
+        a, b = b, a + b
+    return a
+
+for n in [0, 1, 2, 3, 4, 5, 10, 93, 100, 1000, 5000]:
+    py_val = str(py_fib(n))
+    c_res = subprocess.run(["/tmp/c_fib", str(n)], capture_output=True, text=True, check=True)
+    c_val = c_res.stdout.strip()
+    if py_val == c_val:
+        print(f"N={n}: MATCH (len={len(py_val)})")
+    else:
+        print(f"N={n}: MISMATCH!\n  Py: {py_val[:30]}...\n  C : {c_val[:30]}...")
+
