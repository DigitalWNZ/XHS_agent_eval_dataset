+import subprocess
+import sys
+
+def test_combination(line2, line7):
+    code = f"""#if 0
+{line2}
+#endif
+
+#include <stdio.h>
+
+int main() {{
+    printf("C output\\n");
+    return 0;
+}}
+
+#if 0
+{line7}
+#endif
+
+import sys
+print("Python output")
+"""
+    with open("/tmp/test.c", "w") as f:
+        f.write(code)
+
+    res_py = subprocess.run([sys.executable, "/tmp/test.c"], capture_output=True, text=True)
+    res_c = subprocess.run(["gcc", "-Wall", "-Wextra", "/tmp/test.c", "-o", "/tmp/testc"], capture_output=True, text=True)
+    if res_c.returncode == 0:
+        res_exec = subprocess.run(["/tmp/testc"], capture_output=True, text=True)
+        c_out = res_exec.stdout.strip()
+    else:
+        c_out = "BUILD FAILED"
+
+    print(f"L2: {repr(line2):10} L7: {repr(line7):10} | Py RC: {res_py.returncode} PyOut: {repr(res_py.stdout.strip())} | C RC: {res_c.returncode} COut: {repr(c_out)} CErr: {repr(res_c.stderr.strip())}")
+
+for l2 in ['"""', '""""', '""" ""', '"" """', 'r"""', '"""#']:
+    for l7 in ['"""', '""""', '""" ""', '"" """', 'r"""', '"""#']:
+        test_combination(l2, l7)
