+#if 0
+r""""
+#endif
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define BASE 1000000000
+
+static void print_fib(int n) {
+    if (n <= 0) {
+        printf("0\n");
+        return;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return;
+    }
+    int max_len = (n / 4) + 10;
+    unsigned int *a = (unsigned int *)calloc((size_t)max_len, sizeof(unsigned int));
+    unsigned int *b = (unsigned int *)calloc((size_t)max_len, sizeof(unsigned int));
+    unsigned int *c = (unsigned int *)calloc((size_t)max_len, sizeof(unsigned int));
+    if (!a || !b || !c) {
+        free(a); free(b); free(c);
+        return;
+    }
+    
+    a[0] = 0;
+    b[0] = 1;
+    int len_a = 1, len_b = 1;
+    
+    for (int i = 2; i <= n; i++) {
+        unsigned int carry = 0;
+        int max_l = (len_a > len_b) ? len_a : len_b;
+        int len_c = 0;
+        for (int j = 0; j < max_l || carry; j++) {
+            unsigned long long sum = carry;
+            if (j < len_a) sum += (unsigned long long)a[j];
+            if (j < len_b) sum += (unsigned long long)b[j];
+            c[j] = (unsigned int)(sum % BASE);
+            carry = (unsigned int)(sum / BASE);
+            len_c = j + 1;
+        }
+        for (int j = 0; j < len_b; j++) a[j] = b[j];
+        len_a = len_b;
+        for (int j = 0; j < len_c; j++) b[j] = c[j];
+        len_b = len_c;
+    }
+    
+    printf("%u", b[len_b - 1]);
+    for (int j = len_b - 2; j >= 0; j--) {
+        printf("%09u", b[j]);
+    }
+    printf("\n");
+    
+    free(a); free(b); free(c);
+}
+
+int main(int argc, char *argv[]) {
+    if (argc > 1) {
+        print_fib(atoi(argv[1]));
+    }
+    return 0;
+}
+
