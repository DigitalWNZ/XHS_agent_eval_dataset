+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var lastJobID int
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			lastJobID = info.JobID
+		},
+	}
+
+	mem := vfs.NewMem()
+	db, err := Open("", &Options{
+		FS:                           mem,
+		Logger:                       testutils.Logger{T: t},
+		EventListener:                &listener,
+		DurabilityJobRetentionWindow: 10,
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// Zero and negative IDs
+	err = db.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = db.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Never seen ID
+	err = db.WaitForJobDurability(9999)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Commit 1st batch
+	require.NoError(t, db.Set([]byte("k1"), []byte("v1"), Sync))
+	job1 := lastJobID
+	require.NoError(t, db.WaitForJobDurability(job1))
+
+	// Commit 15 more batches to push job1 outside the retention window (size 10)
+	for i := 2; i <= 16; i++ {
+		require.NoError(t, db.Set([]byte(fmt.Sprintf("k%d", i)), []byte("val"), Sync))
+	}
+	job16 := lastJobID
+
+	// job1 should now be expired
+	err = db.WaitForJobDurability(job1)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobExpired))
+	require.Contains(t, strings.ToLower(err.Error()), "expired")
+
+	// job16 is within retention window
+	require.NoError(t, db.WaitForJobDurability(job16))
+}
