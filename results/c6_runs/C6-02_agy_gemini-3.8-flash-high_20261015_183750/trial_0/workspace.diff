+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	mem := vfs.NewMem()
+	db, err := Open("", &Options{
+		FS:                         mem,
+		Logger:                     testutils.Logger{T: t},
+		DurabilityMaxSubscriptions: 2,
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// 1. Notify for future sequence number
+	ch := db.DurabilityNotify(1)
+	require.NoError(t, db.Set([]byte("k"), []byte("v"), Sync))
+	select {
+	case err := <-ch:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for durability notify")
+	}
+
+	// 2. Notify for already durable sequence number returns pre-filled channel
+	seq, _ := db.DurableState()
+	ch2 := db.DurabilityNotify(seq)
+	select {
+	case err := <-ch2:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel to be immediately readable")
+	}
+
+	// 3. Exceeding max subscriptions returns pre-filled error channel
+	futureSeq := seq + 1000
+	sub1 := db.DurabilityNotify(futureSeq)
+	sub2 := db.DurabilityNotify(futureSeq)
+	require.NotNil(t, sub1)
+	require.NotNil(t, sub2)
+
+	// 3rd subscription exceeds bound (max 2)
+	sub3 := db.DurabilityNotify(futureSeq)
+	select {
+	case err := <-sub3:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrDurabilityTooManySubscriptions))
+	default:
+		t.Fatal("expected excess subscription channel to be immediately pre-filled with error")
+	}
+}
