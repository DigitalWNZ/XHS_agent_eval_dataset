diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..8902fe11
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,590 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+var (
+	// ErrJobExpired is returned by WaitForJobDurability when waiting for a job
+	// that has fallen outside the bounded retention window.
+	ErrJobExpired = errors.New("pebble: durability job expired")
+
+	// ErrJobUnknown is returned by WaitForJobDurability when waiting for a job
+	// ID that was never seen or is zero.
+	ErrJobUnknown = errors.New("pebble: durability job unknown")
+
+	// ErrDurabilityTooManySubscriptions is returned by DurabilityNotify when
+	// the number of active subscriptions exceeds the configured bound.
+	ErrDurabilityTooManySubscriptions = errors.New("pebble: too many durability notify subscriptions")
+)
+
+// DurabilityStats is a snapshot of durability statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type jobState struct {
+	done   bool
+	err    error
+	doneCh chan struct{}
+}
+
+type durabilityWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+}
+
+type durabilitySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durableCommitTask struct {
+	jobID         int
+	seqNum        base.SeqNum
+	batchSize     int
+	keyCount      uint32
+	correlationID uint64
+
+	syncStart     crtime.Mono
+	applyDuration time.Duration
+	appliedErr    error
+
+	walWG       sync.WaitGroup
+	walErr      error
+	appliedWG   sync.WaitGroup
+	userSyncWG  *sync.WaitGroup
+	userSyncErr *error
+}
+
+type durabilityManager struct {
+	mu sync.Mutex
+
+	highestDurableSeqNum base.SeqNum
+	firstErr             error
+
+	pendingWaiters int64
+
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	maxSeenJobID      int
+	maxEvictedJobID   int
+	jobRetentionLimit int
+	jobs              map[int]*jobState
+	jobOrder          []int
+
+	waiters       []*durabilityWaiter
+	subscriptions []durabilitySub
+
+	maxSubscriptions int
+
+	closed    bool
+	closedErr error
+}
+
+func (dm *durabilityManager) init(opts *Options) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	dm.jobRetentionLimit = 1024
+	if opts != nil && opts.DurabilityJobRetentionWindow > 0 {
+		dm.jobRetentionLimit = opts.DurabilityJobRetentionWindow
+	}
+	dm.maxSubscriptions = 4096
+	if opts != nil && opts.DurabilityMaxSubscriptions > 0 {
+		dm.maxSubscriptions = opts.DurabilityMaxSubscriptions
+	}
+	dm.jobs = make(map[int]*jobState)
+	dm.jobOrder = make([]int, 0, dm.jobRetentionLimit)
+	dm.maxSeenJobID = 0
+	dm.maxEvictedJobID = 0
+}
+
+func (dm *durabilityManager) registerJob(jobID int) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	if jobID > dm.maxSeenJobID {
+		dm.maxSeenJobID = jobID
+	}
+	job := &jobState{
+		doneCh: make(chan struct{}),
+	}
+	dm.jobs[jobID] = job
+	dm.jobOrder = append(dm.jobOrder, jobID)
+
+	for len(dm.jobOrder) > dm.jobRetentionLimit {
+		evictedID := dm.jobOrder[0]
+		dm.jobOrder = dm.jobOrder[1:]
+		delete(dm.jobs, evictedID)
+		if evictedID > dm.maxEvictedJobID {
+			dm.maxEvictedJobID = evictedID
+		}
+	}
+}
+
+func (dm *durabilityManager) onCommitDurable(
+	jobID int,
+	seqNum base.SeqNum,
+	keyCount uint32,
+	syncDuration time.Duration,
+	commitErr error,
+) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	if commitErr != nil {
+		dm.totalFailedCommits++
+		if dm.firstErr == nil {
+			dm.firstErr = commitErr
+		}
+	} else {
+		dm.totalDurableCommits++
+		highestInBatch := seqNum
+		if keyCount > 0 {
+			highestInBatch = seqNum + base.SeqNum(keyCount-1)
+		}
+		if highestInBatch > dm.highestDurableSeqNum {
+			dm.highestDurableSeqNum = highestInBatch
+		}
+	}
+	dm.cumulativeSyncDuration += syncDuration
+	if syncDuration > dm.maxSyncDuration {
+		dm.maxSyncDuration = syncDuration
+	}
+
+	if job, ok := dm.jobs[jobID]; ok {
+		job.done = true
+		job.err = commitErr
+		close(job.doneCh)
+	}
+
+	// Notify subscriptions
+	if commitErr != nil {
+		for _, sub := range dm.subscriptions {
+			sub.ch <- commitErr
+		}
+		dm.subscriptions = dm.subscriptions[:0]
+	} else {
+		remaining := dm.subscriptions[:0]
+		for _, sub := range dm.subscriptions {
+			if (sub.seqNum == 0 && dm.totalDurableCommits > 0) || (sub.seqNum > 0 && sub.seqNum <= dm.highestDurableSeqNum) {
+				sub.ch <- nil
+			} else {
+				remaining = append(remaining, sub)
+			}
+		}
+		dm.subscriptions = remaining
+	}
+
+	// Wake up waiters
+	if commitErr != nil {
+		for _, w := range dm.waiters {
+			close(w.ch)
+		}
+		dm.waiters = dm.waiters[:0]
+	} else {
+		remainingWaiters := dm.waiters[:0]
+		for _, w := range dm.waiters {
+			if (w.seqNum == 0 && dm.totalDurableCommits > 0) || (w.seqNum > 0 && w.seqNum <= dm.highestDurableSeqNum) {
+				close(w.ch)
+			} else {
+				remainingWaiters = append(remainingWaiters, w)
+			}
+		}
+		dm.waiters = remainingWaiters
+	}
+}
+
+func (dm *durabilityManager) close(closeErr error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	dm.closed = true
+	if dm.closedErr == nil {
+		dm.closedErr = closeErr
+	}
+
+	for _, job := range dm.jobs {
+		if !job.done {
+			job.done = true
+			job.err = closeErr
+			close(job.doneCh)
+		}
+	}
+
+	for _, sub := range dm.subscriptions {
+		sub.ch <- closeErr
+	}
+	dm.subscriptions = dm.subscriptions[:0]
+
+	for _, w := range dm.waiters {
+		close(w.ch)
+	}
+	dm.waiters = dm.waiters[:0]
+}
+
+func (d *DB) durabilityLoop() {
+	defer close(d.durabilityDone)
+
+	for task := range d.durabilityQueue {
+		task.walWG.Wait()
+		task.appliedWG.Wait()
+
+		syncDur := task.syncStart.Elapsed()
+		applyDur := task.applyDuration
+		finalErr := firstError(task.walErr, task.appliedErr)
+
+		if finalErr == nil {
+			if syncDur <= 0 {
+				syncDur = time.Nanosecond
+			}
+			if applyDur <= 0 {
+				applyDur = time.Nanosecond
+			}
+		}
+
+		// 1. Update DurabilityManager state, stats, waiters, subscriptions
+		d.durability.onCommitDurable(task.jobID, task.seqNum, task.keyCount, syncDur, finalErr)
+
+		// 2. Unblock user committer
+		if task.userSyncErr != nil {
+			*task.userSyncErr = finalErr
+		}
+		if task.userSyncWG != nil {
+			task.userSyncWG.Done()
+		}
+
+		// 3. If BatchDurable is configured, update metrics and call callback
+		if d.batchDurableConfigured {
+			if finalErr == nil {
+				d.durableMetrics.durableCommitCount.Add(1)
+				d.durableMetrics.durableCommitDuration.Add(int64(syncDur))
+			}
+
+			if d.opts.EventListener.BatchDurable != nil {
+				info := BatchDurableInfo{
+					JobID:         task.jobID,
+					SeqNum:        task.seqNum,
+					Err:           finalErr,
+					ApplyDuration: applyDur,
+					SyncDuration:  syncDur,
+					CorrelationID: task.correlationID,
+					BatchSize:     task.batchSize,
+					KeyCount:      task.keyCount,
+				}
+				d.opts.EventListener.BatchDurable(info)
+			}
+		}
+	}
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+// A sequence number of zero succeeds after any commit becomes durable.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable
+// or the context is cancelled. Durability and close errors take precedence
+// over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	d.durability.mu.Lock()
+	if d.durability.firstErr != nil {
+		err := d.durability.firstErr
+		d.durability.mu.Unlock()
+		return err
+	}
+	if d.durability.closed {
+		err := d.durability.closedErr
+		d.durability.mu.Unlock()
+		return err
+	}
+	if (seqNum == 0 && d.durability.totalDurableCommits > 0) ||
+		(seqNum > 0 && d.durability.highestDurableSeqNum >= seqNum) {
+		d.durability.mu.Unlock()
+		return nil
+	}
+
+	if ctx != nil && ctx.Err() != nil {
+		d.durability.mu.Unlock()
+		return ctx.Err()
+	}
+
+	ch := make(chan struct{})
+	waiter := &durabilityWaiter{
+		seqNum: seqNum,
+		ch:     ch,
+	}
+	d.durability.waiters = append(d.durability.waiters, waiter)
+	d.durability.pendingWaiters++
+	d.durability.mu.Unlock()
+
+	var doneCh <-chan struct{}
+	if ctx != nil {
+		doneCh = ctx.Done()
+	}
+
+	select {
+	case <-ch:
+		d.durability.mu.Lock()
+		d.durability.pendingWaiters--
+		firstErr := d.durability.firstErr
+		closed := d.durability.closed
+		closedErr := d.durability.closedErr
+		d.durability.mu.Unlock()
+
+		if firstErr != nil {
+			return firstErr
+		}
+		if closed {
+			return closedErr
+		}
+		return nil
+
+	case <-doneCh:
+		d.durability.mu.Lock()
+		d.durability.pendingWaiters--
+		for i, w := range d.durability.waiters {
+			if w == waiter {
+				d.durability.waiters = append(d.durability.waiters[:i], d.durability.waiters[i+1:]...)
+				break
+			}
+		}
+
+		firstErr := d.durability.firstErr
+		closed := d.durability.closed
+		closedErr := d.durability.closedErr
+		durable := (seqNum == 0 && d.durability.totalDurableCommits > 0) ||
+			(seqNum > 0 && d.durability.highestDurableSeqNum >= seqNum)
+		d.durability.mu.Unlock()
+
+		if firstErr != nil {
+			return firstErr
+		}
+		if closed {
+			return closedErr
+		}
+		if durable {
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in the slice is
+// durable. Passing a nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in the
+// slice is durable or the context is cancelled.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the callback job ID has finished.
+// Jobs outside the bounded retention window return an expired error.
+// Never-seen and zero job IDs return an unknown error.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the callback job ID has finished
+// or context is cancelled. Durability and close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	d.durability.mu.Lock()
+
+	if jobID <= 0 || jobID > d.durability.maxSeenJobID {
+		d.durability.mu.Unlock()
+		return errors.Wrapf(ErrJobUnknown, "job %d unknown", jobID)
+	}
+
+	if jobID <= d.durability.maxEvictedJobID {
+		d.durability.mu.Unlock()
+		return errors.Wrapf(ErrJobExpired, "job %d expired", jobID)
+	}
+
+	job, ok := d.durability.jobs[jobID]
+	if !ok {
+		d.durability.mu.Unlock()
+		return errors.Wrapf(ErrJobUnknown, "job %d unknown", jobID)
+	}
+
+	if job.done {
+		err := job.err
+		closed := d.durability.closed
+		closedErr := d.durability.closedErr
+		d.durability.mu.Unlock()
+		if err != nil {
+			return err
+		}
+		if closed {
+			return closedErr
+		}
+		return nil
+	}
+
+	if d.durability.closed {
+		err := d.durability.closedErr
+		d.durability.mu.Unlock()
+		return err
+	}
+
+	if ctx != nil && ctx.Err() != nil {
+		d.durability.mu.Unlock()
+		return ctx.Err()
+	}
+
+	doneCh := job.doneCh
+	d.durability.pendingWaiters++
+	d.durability.mu.Unlock()
+
+	var ctxDoneCh <-chan struct{}
+	if ctx != nil {
+		ctxDoneCh = ctx.Done()
+	}
+
+	select {
+	case <-doneCh:
+		d.durability.mu.Lock()
+		d.durability.pendingWaiters--
+		jobErr := job.err
+		closed := d.durability.closed
+		closedErr := d.durability.closedErr
+		d.durability.mu.Unlock()
+
+		if jobErr != nil {
+			return jobErr
+		}
+		if closed {
+			return closedErr
+		}
+		return nil
+
+	case <-ctxDoneCh:
+		d.durability.mu.Lock()
+		d.durability.pendingWaiters--
+		jobDone := job.done
+		jobErr := job.err
+		closed := d.durability.closed
+		closedErr := d.durability.closedErr
+		d.durability.mu.Unlock()
+
+		if jobDone && jobErr != nil {
+			return jobErr
+		}
+		if closed {
+			return closedErr
+		}
+		if jobDone {
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched WAL sync error (if any).
+func (d *DB) DurableState() (base.SeqNum, error) {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return d.durability.highestDurableSeqNum, d.durability.firstErr
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil
+// on durability success or a non-nil error on WAL sync failure or DB close.
+// Outstanding subscriptions are bounded; excess callers receive a pre-filled
+// channel with an immediate non-nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	if d.durability.firstErr != nil {
+		ch <- d.durability.firstErr
+		return ch
+	}
+	if d.durability.closed {
+		ch <- d.durability.closedErr
+		return ch
+	}
+	if (seqNum == 0 && d.durability.totalDurableCommits > 0) ||
+		(seqNum > 0 && d.durability.highestDurableSeqNum >= seqNum) {
+		ch <- nil
+		return ch
+	}
+
+	if len(d.durability.subscriptions) >= d.durability.maxSubscriptions {
+		ch <- ErrDurabilityTooManySubscriptions
+		return ch
+	}
+
+	d.durability.subscriptions = append(d.durability.subscriptions, durabilitySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.durability.highestDurableSeqNum,
+		FirstErr:               d.durability.firstErr,
+		PendingWaiters:         d.durability.pendingWaiters,
+		TotalDurableCommits:    d.durability.totalDurableCommits,
+		TotalFailedCommits:     d.durability.totalFailedCommits,
+		CumulativeSyncDuration: d.durability.cumulativeSyncDuration,
+		MaxSyncDuration:        d.durability.maxSyncDuration,
+	}
+}
