+func TestWaitForDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	mem := vfs.NewMem()
+	db, err := Open("", &Options{
+		FS:     mem,
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// 1. WaitForDurability(0) blocks until first commit
+	var wg sync.WaitGroup
+	var zeroWaiterDone atomic.Bool
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		err := db.WaitForDurability(0)
+		require.NoError(t, err)
+		zeroWaiterDone.Store(true)
+	}()
+
+	// Wait until goroutine is blocked
+	for db.DurabilityStats().PendingWaiters != 1 {
+		time.Sleep(time.Millisecond)
+	}
+	require.False(t, zeroWaiterDone.Load())
+
+	// Commit batch
+	require.NoError(t, db.Set([]byte("k0"), []byte("v0"), Sync))
+	wg.Wait()
+	require.True(t, zeroWaiterDone.Load())
+
+	// Subsequent WaitForDurability(0) succeeds immediately
+	require.NoError(t, db.WaitForDurability(0))
+	require.Equal(t, int64(0), db.DurabilityStats().PendingWaiters)
+
+	// 2. WaitForDurability with specific sequence number
+	seq, _ := db.DurableState()
+	// Waiting for already durable sequence number succeeds immediately
+	require.NoError(t, db.WaitForDurability(seq))
+
+	// Waiting for a future sequence number blocks
+	futureSeq := seq + 100
+	var futureDone atomic.Bool
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		err := db.WaitForDurability(futureSeq)
+		require.NoError(t, err)
+		futureDone.Store(true)
+	}()
+
+	for db.DurabilityStats().PendingWaiters != 1 {
+		time.Sleep(time.Millisecond)
+	}
+	require.False(t, futureDone.Load())
+
+	// Create batches to reach futureSeq
+	for {
+		require.NoError(t, db.Set([]byte("kx"), []byte("vx"), Sync))
+		s, _ := db.DurableState()
+		if s >= futureSeq {
+			break
+		}
+	}
+
+	wg.Wait()
+	require.True(t, futureDone.Load())
+	require.Equal(t, int64(0), db.DurabilityStats().PendingWaiters)
+}
