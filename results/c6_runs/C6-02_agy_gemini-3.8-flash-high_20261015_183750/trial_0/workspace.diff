+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var callbacks []BatchDurableInfo
+
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			callbacks = append(callbacks, info)
+			mu.Unlock()
+		},
+	}
+
+	mem := vfs.NewMem()
+	opts := &Options{
+		FS:            mem,
+		Logger:        testutils.Logger{T: t},
+		EventListener: &listener,
+	}
+	db, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// Perform a sync commit with CorrelationID.
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}
+	b := db.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, db.Apply(b, wo))
+	require.NoError(t, b.Close())
+
+	mu.Lock()
+	require.Len(t, callbacks, 1)
+	info := callbacks[0]
+	mu.Unlock()
+
+	require.Greater(t, info.JobID, 0)
+	require.Greater(t, info.SeqNum, base.SeqNum(0))
+	require.NoError(t, info.Err)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), info.CorrelationID)
+	require.Greater(t, info.BatchSize, 0)
+	require.Equal(t, uint32(1), info.KeyCount)
+
+	// String and SafeFormat checks
+	str := info.String()
+	require.Contains(t, str, "batch durable seq=")
+	require.Contains(t, str, fmt.Sprintf("JOB %d", info.JobID))
+
+	// Verify Metrics
+	m := db.Metrics()
+	require.Equal(t, uint64(1), m.DurableCommitCount)
+	require.Greater(t, m.DurableCommitDuration, time.Duration(0))
+}
