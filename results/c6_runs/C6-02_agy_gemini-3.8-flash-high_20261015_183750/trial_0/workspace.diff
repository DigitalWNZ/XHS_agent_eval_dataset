+func TestContextCancellationPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	mem := vfs.NewMem()
+	db, err := Open("", &Options{
+		FS:     mem,
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	require.NoError(t, db.Set([]byte("k"), []byte("v"), Sync))
+	seq, _ := db.DurableState()
+
+	// 1. Context already cancelled, but sequence is already durable: durability succeeds (returns nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.NoError(t, db.WaitForDurabilityContext(ctx, seq))
+
+	// 2. Context cancelled before future seqnum is durable: returns ctx.Err()
+	ctx2, cancel2 := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel2()
+	err = db.WaitForDurabilityContext(ctx2, seq+1000)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, context.DeadlineExceeded))
+}
