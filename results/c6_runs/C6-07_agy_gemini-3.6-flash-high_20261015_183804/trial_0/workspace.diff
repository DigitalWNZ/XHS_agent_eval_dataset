+import { describe, expect, test, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  hydrate,
+  isPersisterRestoreResult,
+  reconcileQueryState,
+} from '../index'
+import type { QueryState } from '../index'
+
+describe('createPersisterRestoreResult & query restoration', () => {
+  test('createPersisterRestoreResult creates a valid restore result marker', () => {
+    const state: QueryState<string, Error> = {
+      data: 'cached data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('refetch error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2000,
+      fetchFailureCount: 2,
+      fetchFailureReason: new Error('refetch error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const restoreResult = createPersisterRestoreResult({
+      data: 'cached data',
+      state,
+    })
+
+    expect(isPersisterRestoreResult(restoreResult)).toBe(true)
+    expect(restoreResult.data).toBe('cached data')
+    expect(restoreResult.state).toBe(state)
+  })
+
+  test('query adopts state when persister returns createPersisterRestoreResult and does not trigger onSuccess/onSettled callbacks', async () => {
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+
+    const queryCache = new QueryCache({
+      onSuccess,
+      onSettled,
+    })
+
+    const queryClient = new QueryClient({ queryCache })
+
+    const state: QueryState<string, Error> = {
+      data: 'persisted data',
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: new Error('persisted error'),
+      errorUpdateCount: 1,
+      errorUpdatedAt: 2000,
+      fetchFailureCount: 3,
+      fetchFailureReason: new Error('persisted error'),
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    const persister = vi.fn().mockResolvedValue(
+      createPersisterRestoreResult({
+        data: 'persisted data',
+        state,
+      }),
+    )
+
+    const result = await queryClient.fetchQuery({
+      queryKey: ['persistedKey'],
+      queryFn: () => Promise.resolve('fresh data'),
+      persister,
+    })
+
+    expect(result).toBe('persisted data')
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+
+    const query = queryClient.getQueryCache().find({ queryKey: ['persistedKey'] })!
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('error')
+    expect(query.state.data).toBe('persisted data')
+    expect(query.state.error?.message).toBe('persisted error')
+    expect(query.state.fetchFailureCount).toBe(3)
+    expect(query.state.dataUpdatedAt).toBe(1000)
+    expect(query.state.errorUpdatedAt).toBe(2000)
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: ['persistedKey'],
+      queryFn: () => Promise.resolve('fresh data'),
+    })
+    const obsResult = observer.getCurrentResult()
+
+    expect(obsResult.isRefetchError).toBe(true)
+    expect(obsResult.failureCount).toBe(3)
+    expect(obsResult.dataUpdatedAt).toBe(1000)
+    expect(obsResult.errorUpdatedAt).toBe(2000)
+  })
+
+  test('infinite query pagination state (pageParams) survives restoration', async () => {
+    const queryClient = new QueryClient()
+
+    const infiniteState: QueryState<any, any> = {
+      data: {
+        pages: ['page 1', 'page 2'],
+        pageParams: [1, 2],
+      },
+      dataUpdateCount: 1,
+      dataUpdatedAt: 1000,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'success',
+      fetchStatus: 'idle',
+    }
+
+    const persister = vi.fn().mockResolvedValue(
+      createPersisterRestoreResult({
+        data: infiniteState.data,
+        state: infiniteState,
+      }),
+    )
+
+    await queryClient.fetchInfiniteQuery({
+      queryKey: ['infiniteKey'],
+      queryFn: () => Promise.resolve('data'),
+      initialPageParam: 1,
+      getNextPageParam: () => 2,
+      persister,
+    })
+
+    const query = queryClient.getQueryCache().find({ queryKey: ['infiniteKey'] })!
+    expect(query.state.data).toEqual({
+      pages: ['page 1', 'page 2'],
+      pageParams: [1, 2],
+    })
+  })
+
+  describe('reconcileQueryState (reconciling persisted snapshots with live cache)', () => {
+    test('merges live cache newer data with persisted snapshot newer error state', () => {
+      const liveState: QueryState<string, Error> = {
+        data: 'live newer data',
+        dataUpdateCount: 2,
+        dataUpdatedAt: 5000,
+        error: null,
+        errorUpdateCount: 0,
+        errorUpdatedAt: 0,
+        fetchFailureCount: 0,
+        fetchFailureReason: null,
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'success',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string, Error> = {
+        data: 'old persisted data',
+        dataUpdateCount: 1,
+        dataUpdatedAt: 1000,
+        error: new Error('newer persisted error'),
+        errorUpdateCount: 1,
+        errorUpdatedAt: 3000,
+        fetchFailureCount: 2,
+        fetchFailureReason: new Error('newer persisted error'),
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const merged = reconcileQueryState(liveState, persistedState)
+
+      expect(merged.data).toBe('live newer data')
+      expect(merged.dataUpdatedAt).toBe(5000)
+      expect(merged.error?.message).toBe('newer persisted error')
+      expect(merged.errorUpdatedAt).toBe(3000)
+      expect(merged.fetchFailureCount).toBe(2)
+      expect(merged.status).toBe('error')
+    })
+
+    test('merges persisted snapshot newer data with live cache newer error state', () => {
+      const liveState: QueryState<string, Error> = {
+        data: undefined,
+        dataUpdateCount: 0,
+        dataUpdatedAt: 0,
+        error: new Error('newer live error'),
+        errorUpdateCount: 1,
+        errorUpdatedAt: 5000,
+        fetchFailureCount: 4,
+        fetchFailureReason: new Error('newer live error'),
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const persistedState: QueryState<string, Error> = {
+        data: 'newer persisted data',
+        dataUpdateCount: 1,
+        dataUpdatedAt: 3000,
+        error: new Error('old persisted error'),
+        errorUpdateCount: 1,
+        errorUpdatedAt: 1000,
+        fetchFailureCount: 1,
+        fetchFailureReason: new Error('old persisted error'),
+        fetchMeta: null,
+        isInvalidated: false,
+        status: 'error',
+        fetchStatus: 'idle',
+      }
+
+      const merged = reconcileQueryState(liveState, persistedState)
+
+      expect(merged.data).toBe('newer persisted data')
+      expect(merged.dataUpdatedAt).toBe(3000)
+      expect(merged.error?.message).toBe('newer live error')
+      expect(merged.errorUpdatedAt).toBe(5000)
+      expect(merged.fetchFailureCount).toBe(4)
+      expect(merged.status).toBe('error')
+    })
+
+    test('hydration uses independent reconciliation when restoring over an existing query', () => {
+      const queryClient = new QueryClient()
+
+      queryClient.setQueryData(['reconcileKey'], 'live fresh data', {
+        updatedAt: 5000,
+      })
+
+      const dehydratedState = {
+        mutations: [],
+        queries: [
+          {
+            queryHash: '["reconcileKey"]',
+            queryKey: ['reconcileKey'],
+            state: {
+              data: 'old data',
+              dataUpdatedAt: 1000,
+              dataUpdateCount: 1,
+              error: new Error('newer persisted error'),
+              errorUpdatedAt: 4000,
+              errorUpdateCount: 1,
+              fetchFailureCount: 2,
+              fetchFailureReason: new Error('newer persisted error'),
+              isInvalidated: false,
+              status: 'error',
+              fetchStatus: 'idle',
+            },
+          },
+        ],
+      }
+
+      hydrate(queryClient, dehydratedState)
+
+      const query = queryClient.getQueryCache().find({ queryKey: ['reconcileKey'] })!
+      expect(query.state.data).toBe('live fresh data')
+      expect(query.state.dataUpdatedAt).toBe(5000)
+      expect(query.state.error?.message).toBe('newer persisted error')
+      expect(query.state.errorUpdatedAt).toBe(4000)
+      expect(query.state.fetchFailureCount).toBe(2)
+      expect(query.state.status).toBe('error')
+
+      const observer = new QueryObserver(queryClient, {
+        queryKey: ['reconcileKey'],
+      })
+      const result = observer.getCurrentResult()
+      expect(result.data).toBe('live fresh data')
+      expect(result.error?.message).toBe('newer persisted error')
+      expect(result.isRefetchError).toBe(true)
+      expect(result.failureCount).toBe(2)
+    })
+  })
+})
