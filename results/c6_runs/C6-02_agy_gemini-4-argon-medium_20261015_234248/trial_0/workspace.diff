+// controllableSyncFS wraps a vfs.FS to allow blocking or failing Sync calls on
+// WAL (.log) files.
+type controllableSyncFS struct {
+	vfs.FS
+	mu       sync.Mutex
+	blockCh  chan struct{}
+	entered  chan struct{}
+	syncErr  error
+	syncDelay time.Duration
+}
+
+type controllableSyncFile struct {
+	vfs.File
+	fs    *controllableSyncFS
+	isWAL bool
+}
+
+func (fs *controllableSyncFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	return &controllableSyncFile{
+		File:  f,
+		fs:    fs,
+		isWAL: strings.HasSuffix(name, ".log"),
+	}, nil
+}
+
+func (f *controllableSyncFile) Sync() error {
+	if !f.isWAL {
+		return f.File.Sync()
+	}
+	f.fs.mu.Lock()
+	blockCh := f.fs.blockCh
+	entered := f.fs.entered
+	syncErr := f.fs.syncErr
+	delay := f.fs.syncDelay
+	f.fs.mu.Unlock()
+
+	if entered != nil {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+	}
+	if blockCh != nil {
+		<-blockCh
+	}
+	if delay > 0 {
+		time.Sleep(delay)
+	}
+	f.fs.mu.Lock()
+	if syncErr == nil {
+		syncErr = f.fs.syncErr
+	}
+	f.fs.mu.Unlock()
+	if syncErr != nil {
+		return syncErr
+	}
+	return f.File.Sync()
+}
+
+func (f *controllableSyncFile) SyncData() error {
+	return f.Sync()
+}
