+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	cfs := &controllableSyncFS{
+		FS:        vfs.NewMem(),
+		syncDelay: 2 * time.Millisecond,
+	}
+	d, err := Open("", &Options{
+		FS: cfs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// Initial state before any commits.
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+
+	// Non-sync commit must never trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync-k"), []byte("nosync-v"), NoSync))
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Sync commit with CorrelationID and multiple keys.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, b.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b.Delete([]byte("k1"), nil))
+	expectedSize := len(b.Repr())
+	expectedCount := b.Count()
+	require.Equal(t, uint32(3), expectedCount)
+
+	require.NoError(t, d.Apply(b, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 424242,
+	}))
+	expectedSeq := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev := events[0]
+	mu.Unlock()
+
+	require.Greater(t, ev.JobID, 0)
+	require.Equal(t, expectedSeq, ev.SeqNum)
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(424242), ev.CorrelationID)
+	require.Equal(t, expectedSize, ev.BatchSize)
+	require.Equal(t, expectedCount, ev.KeyCount)
+
+	// ApplyNoSyncWait + SyncWait also triggers BatchDurable once.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k3"), []byte("v3"), nil))
+	expectedSize2 := len(b2.Repr())
+	require.NoError(t, d.ApplyNoSyncWait(b2, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 99,
+	}))
+	require.NoError(t, b2.SyncWait())
+	expectedSeq2 := b2.SeqNum()
+	require.NoError(t, b2.Close())
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Greater(t, ev2.JobID, ev.JobID)
+	require.Equal(t, expectedSeq2, ev2.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(99), ev2.CorrelationID)
+	require.Equal(t, expectedSize2, ev2.BatchSize)
+	require.Equal(t, uint32(1), ev2.KeyCount)
+
+	// Check Metrics and DurabilityStats.
+	stats := d.DurabilityStats()
+	require.Equal(t, expectedSeq2, stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(2), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, ev.SyncDuration+ev2.SyncDuration, stats.CumulativeSyncDuration)
+	require.Equal(t, max(ev.SyncDuration, ev2.SyncDuration), stats.MaxSyncDuration)
+
+	m := d.Metrics()
+	require.Equal(t, uint64(2), m.DurableCommitCount)
+	require.Equal(t, stats.CumulativeSyncDuration, m.DurableCommitDuration)
+}
