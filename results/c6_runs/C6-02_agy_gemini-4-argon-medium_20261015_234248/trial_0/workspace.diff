diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..1e992158
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,625 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	defaultJobRetentionWindow        = 64
+	maxDurabilityNotifySubscriptions = 64
+)
+
+var (
+	// ErrJobIDUnknown is returned when waiting on a never-seen or non-positive job ID.
+	ErrJobIDUnknown = errors.New("pebble: unknown durability job ID")
+	// ErrJobIDExpired is returned when waiting on a job ID that has fallen outside
+	// the bounded retention window.
+	ErrJobIDExpired = errors.New("pebble: durability job ID has expired")
+	// ErrDurabilitySubscriptionLimit is returned on DurabilityNotify channels when
+	// the bound on outstanding subscriptions is exceeded.
+	ErrDurabilitySubscriptionLimit = errors.New("pebble: durability notification subscription limit exceeded")
+)
+
+// DurabilityStats holds a point-in-time snapshot of commit durability state and metrics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityWaiter struct {
+	seqNum   base.SeqNum
+	waitAny  bool
+	jobID    int
+	done     chan error
+	resolved bool
+	err      error
+}
+
+type durabilityNotifySub struct {
+	seqNum  base.SeqNum
+	waitAny bool
+	ch      chan error
+}
+
+type durabilityTracker struct {
+	mu struct {
+		sync.Mutex
+		highestDurableSeqNum        base.SeqNum
+		hasAnyCommit                bool
+		firstErr                    error
+		closeErr                    error
+		pendingWaiters              int64
+		totalDurableCommits         uint64
+		totalFailedCommits          uint64
+		cumulativeSyncDuration      time.Duration
+		maxSyncDuration             time.Duration
+		metricDurableCommitCount    uint64
+		metricDurableCommitDuration time.Duration
+
+		highestJobID           int
+		retentionWindow        int
+		inFlightJobs           map[int]struct{}
+		completedJobs          map[int]error
+		completedJobOrder      []int
+		waiters                []*durabilityWaiter
+		maxNotifySubscriptions int
+		notifySubs             []*durabilityNotifySub
+	}
+}
+
+func (t *durabilityTracker) init() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.ensureInitLocked()
+}
+
+func (t *durabilityTracker) ensureInitLocked() {
+	if t.mu.retentionWindow <= 0 {
+		t.mu.retentionWindow = defaultJobRetentionWindow
+	}
+	if t.mu.maxNotifySubscriptions <= 0 {
+		t.mu.maxNotifySubscriptions = maxDurabilityNotifySubscriptions
+	}
+	if t.mu.inFlightJobs == nil {
+		t.mu.inFlightJobs = make(map[int]struct{})
+	}
+	if t.mu.completedJobs == nil {
+		t.mu.completedJobs = make(map[int]error)
+	}
+}
+
+func (t *durabilityTracker) errLocked() error {
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr
+	}
+	return t.mu.closeErr
+}
+
+func (t *durabilityTracker) beginSyncJob() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.ensureInitLocked()
+	t.mu.highestJobID++
+	jobID := t.mu.highestJobID
+	t.mu.inFlightJobs[jobID] = struct{}{}
+	return jobID
+}
+
+func (t *durabilityTracker) recordNonSyncCommit() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.ensureInitLocked()
+	t.mu.hasAnyCommit = true
+	t.wakeSatisfiedLocked()
+}
+
+func (t *durabilityTracker) completeSyncCommit(
+	jobID int,
+	seqNum base.SeqNum,
+	syncDuration time.Duration,
+	err error,
+	batchDurableConfigured bool,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.ensureInitLocked()
+
+	if jobID > 0 {
+		delete(t.mu.inFlightJobs, jobID)
+		if _, exists := t.mu.completedJobs[jobID]; !exists {
+			t.mu.completedJobOrder = append(t.mu.completedJobOrder, jobID)
+		}
+		t.mu.completedJobs[jobID] = err
+		for len(t.mu.completedJobOrder) > t.mu.retentionWindow {
+			evicted := t.mu.completedJobOrder[0]
+			t.mu.completedJobOrder = t.mu.completedJobOrder[1:]
+			delete(t.mu.completedJobs, evicted)
+		}
+	}
+
+	if err == nil {
+		t.mu.hasAnyCommit = true
+		if seqNum > t.mu.highestDurableSeqNum {
+			t.mu.highestDurableSeqNum = seqNum
+		}
+		t.mu.totalDurableCommits++
+		t.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.mu.maxSyncDuration {
+			t.mu.maxSyncDuration = syncDuration
+		}
+		if batchDurableConfigured {
+			t.mu.metricDurableCommitCount++
+			t.mu.metricDurableCommitDuration += syncDuration
+		}
+		t.wakeSatisfiedLocked()
+	} else {
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		t.mu.totalFailedCommits++
+		t.wakeAllWithErrorLocked(t.mu.firstErr, jobID, err)
+	}
+}
+
+func (t *durabilityTracker) close(err error) {
+	if err == nil {
+		err = ErrClosed
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.ensureInitLocked()
+	if t.mu.closeErr == nil {
+		t.mu.closeErr = err
+	}
+	wakeErr := t.errLocked()
+	t.wakeAllWithErrorLocked(wakeErr, 0, wakeErr)
+}
+
+func (t *durabilityTracker) isSeqSatisfiedLocked(seqNum base.SeqNum, waitAny bool) bool {
+	if waitAny || seqNum == 0 {
+		return t.mu.hasAnyCommit || t.mu.highestDurableSeqNum > 0
+	}
+	return t.mu.highestDurableSeqNum >= seqNum
+}
+
+func (t *durabilityTracker) wakeSatisfiedLocked() {
+	if err := t.errLocked(); err != nil {
+		t.wakeAllWithErrorLocked(err, 0, err)
+		return
+	}
+
+	remainingWaiters := t.mu.waiters[:0]
+	for _, w := range t.mu.waiters {
+		var satisfied bool
+		var wErr error
+		if w.jobID > 0 {
+			if jobErr, ok := t.mu.completedJobs[w.jobID]; ok {
+				satisfied = true
+				wErr = jobErr
+			} else if _, inFlight := t.mu.inFlightJobs[w.jobID]; !inFlight {
+				satisfied = true
+				wErr = errors.Wrapf(ErrJobIDExpired, "job %d", errors.Safe(w.jobID))
+			}
+		} else if t.isSeqSatisfiedLocked(w.seqNum, w.waitAny) {
+			satisfied = true
+		}
+
+		if satisfied {
+			w.resolved = true
+			w.err = wErr
+			t.mu.pendingWaiters--
+			w.done <- wErr
+			close(w.done)
+		} else {
+			remainingWaiters = append(remainingWaiters, w)
+		}
+	}
+	for i := len(remainingWaiters); i < len(t.mu.waiters); i++ {
+		t.mu.waiters[i] = nil
+	}
+	t.mu.waiters = remainingWaiters
+
+	remainingSubs := t.mu.notifySubs[:0]
+	for _, sub := range t.mu.notifySubs {
+		if t.isSeqSatisfiedLocked(sub.seqNum, sub.waitAny) {
+			sub.ch <- nil
+			close(sub.ch)
+		} else {
+			remainingSubs = append(remainingSubs, sub)
+		}
+	}
+	for i := len(remainingSubs); i < len(t.mu.notifySubs); i++ {
+		t.mu.notifySubs[i] = nil
+	}
+	t.mu.notifySubs = remainingSubs
+}
+
+func (t *durabilityTracker) wakeAllWithErrorLocked(defaultErr error, failedJobID int, failedJobErr error) {
+	for i, w := range t.mu.waiters {
+		wErr := defaultErr
+		if failedJobID > 0 && w.jobID == failedJobID && failedJobErr != nil {
+			wErr = failedJobErr
+		}
+		w.resolved = true
+		w.err = wErr
+		t.mu.pendingWaiters--
+		w.done <- wErr
+		close(w.done)
+		t.mu.waiters[i] = nil
+	}
+	t.mu.waiters = t.mu.waiters[:0]
+
+	for i, sub := range t.mu.notifySubs {
+		sub.ch <- defaultErr
+		close(sub.ch)
+		t.mu.notifySubs[i] = nil
+	}
+	t.mu.notifySubs = t.mu.notifySubs[:0]
+}
+
+func (t *durabilityTracker) removeWaiterLocked(target *durabilityWaiter) {
+	for i, w := range t.mu.waiters {
+		if w == target {
+			last := len(t.mu.waiters) - 1
+			t.mu.waiters[i] = t.mu.waiters[last]
+			t.mu.waiters[last] = nil
+			t.mu.waiters = t.mu.waiters[:last]
+			t.mu.pendingWaiters--
+			return
+		}
+	}
+}
+
+func (t *durabilityTracker) blockOnWaiter(ctx context.Context, w *durabilityWaiter) error {
+	var ctxDone <-chan struct{}
+	if ctx != nil {
+		ctxDone = ctx.Done()
+	}
+	select {
+	case err := <-w.done:
+		return err
+	case <-ctxDone:
+		t.mu.Lock()
+		defer t.mu.Unlock()
+		if w.resolved {
+			if w.err != nil {
+				return w.err
+			}
+			if err := t.errLocked(); err != nil {
+				return err
+			}
+			return nil
+		}
+		t.removeWaiterLocked(w)
+		if err := t.errLocked(); err != nil {
+			return err
+		}
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) waitForSeq(ctx context.Context, seqNum base.SeqNum) error {
+	t.mu.Lock()
+	t.ensureInitLocked()
+	if err := t.errLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if ctx != nil && ctx.Err() != nil {
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+	waitAny := seqNum == 0
+	if t.isSeqSatisfiedLocked(seqNum, waitAny) {
+		t.mu.Unlock()
+		return nil
+	}
+	w := &durabilityWaiter{
+		seqNum:  seqNum,
+		waitAny: waitAny,
+		done:    make(chan error, 1),
+	}
+	t.mu.waiters = append(t.mu.waiters, w)
+	t.mu.pendingWaiters++
+	t.mu.Unlock()
+
+	return t.blockOnWaiter(ctx, w)
+}
+
+func (t *durabilityTracker) waitForSeqBatch(ctx context.Context, seqNums []base.SeqNum) error {
+	t.mu.Lock()
+	t.ensureInitLocked()
+	if err := t.errLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if len(seqNums) == 0 {
+		t.mu.Unlock()
+		return nil
+	}
+	if ctx != nil && ctx.Err() != nil {
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	waitAny := maxSeq == 0
+	if t.isSeqSatisfiedLocked(maxSeq, waitAny) {
+		t.mu.Unlock()
+		return nil
+	}
+	w := &durabilityWaiter{
+		seqNum:  maxSeq,
+		waitAny: waitAny,
+		done:    make(chan error, 1),
+	}
+	t.mu.waiters = append(t.mu.waiters, w)
+	t.mu.pendingWaiters++
+	t.mu.Unlock()
+
+	return t.blockOnWaiter(ctx, w)
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	t.mu.Lock()
+	t.ensureInitLocked()
+	if t.mu.closeErr != nil {
+		err := t.errLocked()
+		t.mu.Unlock()
+		return err
+	}
+	if jobID <= 0 || jobID > t.mu.highestJobID {
+		if t.mu.firstErr != nil && ctx != nil && ctx.Err() != nil {
+			err := t.mu.firstErr
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return errors.Wrapf(ErrJobIDUnknown, "job %d", errors.Safe(jobID))
+	}
+	if jobErr, ok := t.mu.completedJobs[jobID]; ok {
+		if jobErr != nil {
+			t.mu.Unlock()
+			return jobErr
+		}
+		if t.mu.firstErr != nil {
+			err := t.mu.firstErr
+			t.mu.Unlock()
+			return err
+		}
+		if ctx != nil && ctx.Err() != nil {
+			t.mu.Unlock()
+			return ctx.Err()
+		}
+		t.mu.Unlock()
+		return nil
+	}
+	if _, inFlight := t.mu.inFlightJobs[jobID]; !inFlight {
+		if t.mu.firstErr != nil && ctx != nil && ctx.Err() != nil {
+			err := t.mu.firstErr
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return errors.Wrapf(ErrJobIDExpired, "job %d", errors.Safe(jobID))
+	}
+	if err := t.errLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if ctx != nil && ctx.Err() != nil {
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+	w := &durabilityWaiter{
+		jobID: jobID,
+		done:  make(chan error, 1),
+	}
+	t.mu.waiters = append(t.mu.waiters, w)
+	t.mu.pendingWaiters++
+	t.mu.Unlock()
+
+	return t.blockOnWaiter(ctx, w)
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum, disableWAL bool) <-chan error {
+	ch := make(chan error, 1)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.ensureInitLocked()
+
+	if err := t.errLocked(); err != nil {
+		ch <- err
+		close(ch)
+		return ch
+	}
+	if disableWAL {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+	waitAny := seqNum == 0
+	if t.isSeqSatisfiedLocked(seqNum, waitAny) {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+	if len(t.mu.notifySubs) >= t.mu.maxNotifySubscriptions {
+		ch <- ErrDurabilitySubscriptionLimit
+		close(ch)
+		return ch
+	}
+	t.mu.notifySubs = append(t.mu.notifySubs, &durabilityNotifySub{
+		seqNum:  seqNum,
+		waitAny: waitAny,
+		ch:      ch,
+	})
+	return ch
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeqNum, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeqNum,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.mu.pendingWaiters,
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metricTotals() (uint64, time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.metricDurableCommitCount, t.mu.metricDurableCommitDuration
+}
+
+func (d *DB) completeSyncCommit(b *Batch, syncDuration time.Duration, err error) {
+	if b.syncCompleted || d.opts.DisableWAL {
+		return
+	}
+	b.syncCompleted = true
+
+	applyDuration := b.applyDuration
+	if err == nil {
+		if applyDuration <= 0 {
+			applyDuration = time.Nanosecond
+		}
+		if syncDuration <= 0 {
+			syncDuration = time.Nanosecond
+		}
+	}
+
+	d.durability.completeSyncCommit(
+		b.jobID,
+		b.committedSeqNum,
+		syncDuration,
+		err,
+		d.batchDurableConfigured,
+	)
+
+	if d.batchDurableConfigured {
+		d.opts.EventListener.BatchDurable(BatchDurableInfo{
+			JobID:         b.jobID,
+			SeqNum:        b.committedSeqNum,
+			Err:           err,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: b.correlationID,
+			BatchSize:     b.committedBatchSize,
+			KeyCount:      b.committedKeyCount,
+		})
+	}
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on disk.
+// A sequence number of zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is durable
+// on disk or the context is cancelled. Durability and close errors take precedence
+// over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		d.durability.mu.Lock()
+		err := d.durability.errLocked()
+		d.durability.mu.Unlock()
+		if err != nil {
+			return err
+		}
+		return nil
+	}
+	return d.durability.waitForSeq(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is durable
+// on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums is
+// durable on disk or the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		d.durability.mu.Lock()
+		err := d.durability.errLocked()
+		d.durability.mu.Unlock()
+		if err != nil {
+			return err
+		}
+		return nil
+	}
+	return d.durability.waitForSeqBatch(ctx, seqNums)
+}
+
+// WaitForJobDurability blocks until the Sync commit with the given callback job ID
+// is durable. Jobs outside the bounded retention window return an "expired" error;
+// never-seen and zero/negative job IDs return an "unknown" error.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the Sync commit with the given callback
+// job ID is durable or the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		d.durability.mu.Lock()
+		err := d.durability.errLocked()
+		d.durability.mu.Unlock()
+		if err != nil {
+			return err
+		}
+		return nil
+	}
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first latched
+// WAL sync error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seqNum
+// becomes durable, or a non-nil error on WAL sync failure, DB close, or when
+// the bound on outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.notify(seqNum, d.opts.DisableWAL)
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
