+func TestWaitForJobDurabilityAndRetention(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	cfs := &controllableSyncFS{
+		FS: vfs.NewMem(),
+	}
+	var lastJobID atomic.Int64
+	d, err := Open("", &Options{
+		FS: cfs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID.Store(int64(info.JobID))
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// Zero, negative, and never-seen job IDs return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(9999)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Test waiting on an in-flight job ID.
+	cfs.mu.Lock()
+	cfs.blockCh = make(chan struct{})
+	cfs.entered = make(chan struct{}, 1)
+	cfs.mu.Unlock()
+
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- d.Set([]byte("inflight"), []byte("val"), Sync)
+	}()
+
+	<-cfs.entered
+	jobWaitDone := make(chan error, 1)
+	go func() {
+		jobWaitDone <- d.WaitForJobDurability(1)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	cfs.mu.Lock()
+	close(cfs.blockCh)
+	cfs.blockCh = nil
+	cfs.entered = nil
+	cfs.mu.Unlock()
+
+	require.NoError(t, <-commitDone)
+	require.NoError(t, <-jobWaitDone)
+	require.Equal(t, int64(1), lastJobID.Load())
+
+	// Job 1 is still in the retention window, so waiting again succeeds immediately.
+	require.NoError(t, d.WaitForJobDurability(1))
+
+	// Perform enough Sync commits to evict job 1 from the bounded retention window.
+	for i := 0; i < defaultJobRetentionWindow+10; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("k-%d", i)), []byte("v"), Sync))
+	}
+
+	// Job 1 must now return an "expired" error.
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "expired")
+
+	// The most recent job ID is within the retention window and succeeds.
+	recentID := int(lastJobID.Load())
+	require.NoError(t, d.WaitForJobDurability(recentID))
+
+	// A future job ID beyond recentID still returns "unknown".
+	err = d.WaitForJobDurability(recentID + 100)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+}
+
+func TestDurabilityNotifyAndSubscriptionBound(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seq1 := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	// Already-durable sequence number returns a pre-filled channel with nil.
+	chReady := d.DurabilityNotify(seq1)
+	select {
+	case err := <-chReady:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel for already-durable seqNum")
+	}
+
+	// Subscribe up to the bound for a future sequence number.
+	futureSeq := seq1 + 10
+	subs := make([]<-chan error, 0, maxDurabilityNotifySubscriptions)
+	for i := 0; i < maxDurabilityNotifySubscriptions; i++ {
+		subs = append(subs, d.DurabilityNotify(futureSeq))
+	}
+
+	// Excess caller gets a pre-filled channel with an immediate non-nil error.
+	excessCh := d.DurabilityNotify(futureSeq)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected excess subscription channel to be pre-filled with error")
+	}
+
+	// Advance durability to futureSeq; all subscribed channels should deliver nil.
+	for i := 0; i < 12; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("k-%d", i)), []byte("v"), Sync))
+	}
+	for _, sub := range subs {
+		require.NoError(t, <-sub)
+	}
+
+	// After outstanding subscriptions resolve, new subscriptions are accepted again.
+	nextFuture := futureSeq + 50
+	newSub := d.DurabilityNotify(nextFuture)
+	select {
+	case err := <-newSub:
+		t.Fatalf("expected new subscription to remain pending, got %v", err)
+	default:
+	}
+}
+
+func TestDurabilityWALSyncFailureAndErrorPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	cfs := &controllableSyncFS{
+		FS: vfs.NewMem(),
+	}
+	var callbackInfos []BatchDurableInfo
+	var cbMu sync.Mutex
+
+	d, err := Open("", &Options{
+		FS: cfs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				cbMu.Lock()
+				callbackInfos = append(callbackInfos, info)
+				cbMu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// First Sync commit succeeds.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, &WriteOptions{Sync: true, CommitCorrelationID: 11}))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	// Set up a waiter and a notify subscription for a future sequence number.
+	futureSeq := seq1 + 5
+	waitErrCh := make(chan error, 1)
+	go func() {
+		waitErrCh <- d.WaitForDurability(futureSeq)
+	}()
+	notifyCh := d.DurabilityNotify(futureSeq)
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Inject a WAL sync failure on the next Sync commit.
+	injectedErr := errorfs.ErrInjected
+	cfs.mu.Lock()
+	cfs.syncErr = injectedErr
+	cfs.mu.Unlock()
+
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k2"), []byte("v2"), nil))
+	commitErr := d.Apply(b2, &WriteOptions{Sync: true, CommitCorrelationID: 22})
+	require.ErrorIs(t, commitErr, injectedErr)
+
+	// Blocked waiter and notify channel must unblock with the WAL sync error.
+	require.ErrorIs(t, <-waitErrCh, injectedErr)
+	require.ErrorIs(t, <-notifyCh, injectedErr)
+
+	// BatchDurable must have fired for the failed commit as well.
+	cbMu.Lock()
+	require.Len(t, callbackInfos, 2)
+	failedInfo := callbackInfos[1]
+	cbMu.Unlock()
+	require.ErrorIs(t, failedInfo.Err, injectedErr)
+	require.Equal(t, uint64(22), failedInfo.CorrelationID)
+	require.Equal(t, uint32(1), failedInfo.KeyCount)
+
+	// DurableState and DurabilityStats reflect the first latched error and keeping seq1.
+	durableSeq, latchedErr := d.DurableState()
+	require.Equal(t, seq1, durableSeq)
+	require.ErrorIs(t, latchedErr, injectedErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+
+	// Durability error takes precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	require.ErrorIs(t, d.WaitForDurabilityContext(cancelledCtx, seq1), injectedErr)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{seq1}), injectedErr)
+	require.ErrorIs(t, d.WaitForJobDurabilityContext(cancelledCtx, failedInfo.JobID), injectedErr)
+
+	// Clear syncErr before closing so Close doesn't fail unexpectedly in defer.
+	cfs.mu.Lock()
+	cfs.syncErr = nil
+	cfs.mu.Unlock()
+}
+
+func TestDurabilityWaitersUnblockOnCloseAndPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+	})
+	require.NoError(t, err)
+
+	waitErrCh := make(chan error, 1)
+	batchWaitErrCh := make(chan error, 1)
+	notifyCh := d.DurabilityNotify(100)
+
+	go func() {
+		waitErrCh <- d.WaitForDurability(100)
+	}()
+	go func() {
+		batchWaitErrCh <- d.WaitForDurabilityBatch([]base.SeqNum{100, 200})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, 5*time.Millisecond)
+
+	require.NoError(t, d.Close())
+
+	require.Error(t, <-waitErrCh)
+	require.Error(t, <-batchWaitErrCh)
+	require.Error(t, <-notifyCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Close error takes precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(cancelledCtx, 100)
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{100})
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+
+	err = d.WaitForJobDurabilityContext(cancelledCtx, 1)
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+}
