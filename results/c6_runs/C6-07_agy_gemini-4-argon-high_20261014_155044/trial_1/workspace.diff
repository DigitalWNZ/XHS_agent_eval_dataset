--- /dev/null
+++ b/swscale-impl/src/filter.zig
@@ -0,0 +1,252 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+pub const FilterData = struct {
+    filter: []i16,
+    filter_pos: []i32,
+    filter_size: usize,
+
+    pub fn deinit(self: *FilterData, allocator: std.mem.Allocator) void {
+        allocator.free(self.filter);
+        allocator.free(self.filter_pos);
+    }
+};
+
+fn avLog2(v: u32) u32 {
+    if (v == 0) return 0;
+    return 31 - @clz(v);
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    if (a > 0) {
+        return @divTrunc(a + (b >> 1), b);
+    } else {
+        return @divTrunc(a - (b >> 1), b);
+    }
+}
+
+pub fn initFilter(
+    allocator: std.mem.Allocator,
+    x_inc: i32,
+    src_w: i32,
+    dst_w: i32,
+    one: i32,
+    algo: types.Algo,
+) !FilterData {
+    const dst_w_u: usize = @intCast(dst_w);
+    var filter_pos = try allocator.alloc(i32, dst_w_u + 3);
+    errdefer allocator.free(filter_pos);
+
+    const ratio: u32 = @intCast(@divTrunc(src_w, dst_w));
+    const shift: u6 = 54 - @as(u6, @intCast(@min(avLog2(ratio), 8)));
+    const fone: i64 = @as(i64, 1) << shift;
+
+    const src_pos: i64 = 128;
+    const dst_pos: i64 = 128;
+
+    var filter_size: usize = 1;
+    var filter2: []i64 = undefined;
+
+    if (@abs(x_inc - 0x10000) < 10) {
+        filter_size = 1;
+        filter2 = try allocator.alloc(i64, dst_w_u * filter_size);
+        for (0..dst_w_u) |i| {
+            filter2[i] = fone;
+            filter_pos[i] = @intCast(i);
+        }
+    } else if (algo == .nearest) {
+        filter_size = 1;
+        filter2 = try allocator.alloc(i64, dst_w_u * filter_size);
+        var x_dst_in_src: i64 = ((dst_pos * @as(i64, x_inc)) >> 8) - ((src_pos * 0x8000) >> 7);
+        for (0..dst_w_u) |i| {
+            const xx: i32 = @intCast((x_dst_in_src + (1 << 15)) >> 16);
+            filter_pos[i] = xx;
+            filter2[i] = fone;
+            x_dst_in_src += x_inc;
+        }
+    } else {
+        const size_factor: i32 = if (algo == .bicubic) 4 else 2;
+        var fs_i32: i32 = if (x_inc <= (1 << 16))
+            1 + size_factor
+        else
+            1 + @divTrunc(size_factor * src_w + dst_w - 1, dst_w);
+
+        fs_i32 = @min(fs_i32, src_w - 2);
+        fs_i32 = @max(fs_i32, 1);
+        filter_size = @intCast(fs_i32);
+
+        filter2 = try allocator.alloc(i64, dst_w_u * filter_size);
+        var x_dst_in_src: i64 = ((dst_pos * @as(i64, x_inc)) >> 7) - ((src_pos * 0x10000) >> 7);
+        const c_bicubic: i64 = 10066329; // (int64_t)(0.6 * (1 << 24))
+        const fone_div: i64 = @divTrunc(@as(i64, 1) << 54, fone);
+
+        for (0..dst_w_u) |i| {
+            var xx: i32 = @intCast(@divTrunc(x_dst_in_src - @as(i64, fs_i32 - 2) * (1 << 16), 1 << 17));
+            filter_pos[i] = xx;
+            for (0..filter_size) |j| {
+                const diff: i64 = @intCast(@abs((@as(i64, xx) * (1 << 17)) - x_dst_in_src));
+                var d: i64 = diff << 13;
+                if (x_inc > (1 << 16)) {
+                    d = @divTrunc(d * dst_w, src_w);
+                }
+                var coeff: i64 = 0;
+                if (algo == .bicubic) {
+                    if (d >= (@as(i64, 1) << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (@as(i64, 1) << 30)) {
+                            coeff = (12 * (1 << 24) - 6 * c_bicubic) * ddd +
+                                (-18 * (1 << 24) + 6 * c_bicubic) * dd +
+                                (6 * (1 << 24)) * (1 << 30);
+                        } else {
+                            coeff = (-6 * c_bicubic) * ddd +
+                                (30 * c_bicubic) * dd +
+                                (-48 * c_bicubic) * d +
+                                (24 * c_bicubic) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, fone_div);
+                } else {
+                    coeff = (@as(i64, 1) << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= (fone >> 30);
+                }
+                filter2[i * filter_size + j] = coeff;
+                xx += 1;
+            }
+            x_dst_in_src += 2 * @as(i64, x_inc);
+        }
+    }
+    defer allocator.free(filter2);
+
+    const filter2_size = filter_size;
+    var min_filter_size: usize = 0;
+    const cutoff_limit: f64 = 0.002 * @as(f64, @floatFromInt(fone));
+
+    var i_rev: isize = @as(isize, @intCast(dst_w_u)) - 1;
+    while (i_rev >= 0) : (i_rev -= 1) {
+        const i: usize = @intCast(i_rev);
+        var min: usize = filter2_size;
+        var cut_off: i64 = 0;
+
+        for (0..filter2_size) |_| {
+            cut_off += @intCast(@abs(filter2[i * filter2_size]));
+            if (@as(f64, @floatFromInt(cut_off)) > cutoff_limit) break;
+            if (i < dst_w_u - 1 and filter_pos[i] >= filter_pos[i + 1]) break;
+
+            for (1..filter2_size) |k| {
+                filter2[i * filter2_size + k - 1] = filter2[i * filter2_size + k];
+            }
+            filter2[i * filter2_size + filter2_size - 1] = 0;
+            filter_pos[i] += 1;
+        }
+
+        cut_off = 0;
+        var j_rev: usize = filter2_size - 1;
+        while (j_rev > 0) : (j_rev -= 1) {
+            cut_off += @intCast(@abs(filter2[i * filter2_size + j_rev]));
+            if (@as(f64, @floatFromInt(cut_off)) > cutoff_limit) break;
+            min -= 1;
+        }
+
+        if (min > min_filter_size) min_filter_size = min;
+    }
+
+    if (min_filter_size == 0) min_filter_size = 1;
+    filter_size = min_filter_size;
+
+    var filter = try allocator.alloc(i64, dst_w_u * filter_size);
+    defer allocator.free(filter);
+
+    for (0..dst_w_u) |i| {
+        for (0..filter_size) |j| {
+            if (j >= filter2_size) {
+                filter[i * filter_size + j] = 0;
+            } else {
+                filter[i * filter_size + j] = filter2[i * filter2_size + j];
+            }
+        }
+    }
+
+    const fs_i32_final: i32 = @intCast(filter_size);
+    for (0..dst_w_u) |i| {
+        if (filter_pos[i] < 0) {
+            for (1..filter_size) |j| {
+                const j_i32: i32 = @intCast(j);
+                const left: usize = @intCast(@max(j_i32 + filter_pos[i], 0));
+                filter[i * filter_size + left] += filter[i * filter_size + j];
+                filter[i * filter_size + j] = 0;
+            }
+            filter_pos[i] = 0;
+        }
+
+        if (filter_pos[i] + fs_i32_final > src_w) {
+            const shift_amt: i32 = filter_pos[i] + @min(fs_i32_final - src_w, 0);
+            var acc: i64 = 0;
+
+            var j_rev: isize = @as(isize, @intCast(filter_size)) - 1;
+            while (j_rev >= 0) : (j_rev -= 1) {
+                const j: usize = @intCast(j_rev);
+                const j_i32: i32 = @intCast(j);
+                if (filter_pos[i] + j_i32 >= src_w) {
+                    acc += filter[i * filter_size + j];
+                    filter[i * filter_size + j] = 0;
+                }
+            }
+
+            j_rev = @as(isize, @intCast(filter_size)) - 1;
+            while (j_rev >= 0) : (j_rev -= 1) {
+                const j: usize = @intCast(j_rev);
+                const j_i32: i32 = @intCast(j);
+                if (j_i32 < shift_amt) {
+                    filter[i * filter_size + j] = 0;
+                } else {
+                    const src_idx: usize = @intCast(j_i32 - shift_amt);
+                    filter[i * filter_size + j] = filter[i * filter_size + src_idx];
+                }
+            }
+
+            filter_pos[i] -= shift_amt;
+            const last_valid: usize = @intCast(src_w - 1 - filter_pos[i]);
+            filter[i * filter_size + last_valid] += acc;
+        }
+    }
+
+    var out_filter = try allocator.alloc(i16, filter_size * (dst_w_u + 3));
+    @memset(out_filter, 0);
+
+    const one_i64: i64 = one;
+    for (0..dst_w_u) |i| {
+        var error_val: i64 = 0;
+        var sum: i64 = 0;
+        for (0..filter_size) |j| {
+            sum += filter[i * filter_size + j];
+        }
+        sum = @divTrunc(sum + @divTrunc(one_i64, 2), one_i64);
+        if (sum == 0) sum = 1;
+        for (0..filter_size) |j| {
+            const v: i64 = filter[i * filter_size + j] + error_val;
+            const int_v: i64 = roundedDiv(v, sum);
+            out_filter[i * filter_size + j] = @intCast(int_v);
+            error_val = v - int_v * sum;
+        }
+    }
+
+    filter_pos[dst_w_u + 0] = filter_pos[dst_w_u - 1];
+    filter_pos[dst_w_u + 1] = filter_pos[dst_w_u - 1];
+    filter_pos[dst_w_u + 2] = filter_pos[dst_w_u - 1];
+    for (0..filter_size) |j| {
+        const k = (dst_w_u - 1) * filter_size + j;
+        out_filter[k + 1 * filter_size] = out_filter[k];
+        out_filter[k + 2 * filter_size] = out_filter[k];
+        out_filter[k + 3 * filter_size] = out_filter[k];
+    }
+
+    return FilterData{
+        .filter = out_filter,
+        .filter_pos = filter_pos,
+        .filter_size = filter_size,
+    };
+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,116 @@
+const std = @import("std");
+const types = @import("types.zig");
+const unscaled = @import("unscaled.zig");
+const scaler = @import("scaler.zig");
+
+const PixFmt = types.PixFmt;
+const Algo = types.Algo;
+
+const SwsContext = struct {
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt: PixFmt,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt: PixFmt,
+    algo: Algo,
+    is_unscaled_special: bool,
+    tables: types.Yuv2RgbTables,
+    scaler_ctx: ?scaler.ScalerContext,
+};
+
+export fn swscale_create(
+    src_w: c_int,
+    src_h: c_int,
+    src_fmt_raw: c_int,
+    dst_w: c_int,
+    dst_h: c_int,
+    dst_fmt_raw: c_int,
+    algo_raw: c_int,
+) ?*SwsContext {
+    if (src_w <= 0 or src_h <= 0 or dst_w <= 0 or dst_h <= 0) return null;
+    if (src_fmt_raw < 0 or src_fmt_raw > 9) return null;
+    if (dst_fmt_raw < 0 or dst_fmt_raw > 9) return null;
+    if (algo_raw < 0 or algo_raw > 2) return null;
+
+    const src_fmt: PixFmt = @enumFromInt(src_fmt_raw);
+    const dst_fmt: PixFmt = @enumFromInt(dst_fmt_raw);
+    const algo: Algo = @enumFromInt(algo_raw);
+
+    const allocator = std.heap.c_allocator;
+    const ctx = allocator.create(SwsContext) catch return null;
+
+    const is_same_dim = (src_w == dst_w and src_h == dst_h);
+    const is_unscaled_special = is_same_dim and unscaled.canHandleUnscaled(src_fmt, dst_fmt, src_w, src_h);
+
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .is_unscaled_special = is_unscaled_special,
+        .tables = types.Yuv2RgbTables.init(),
+        .scaler_ctx = null,
+    };
+
+    if (!is_unscaled_special) {
+        ctx.scaler_ctx = scaler.ScalerContext.init(
+            allocator,
+            src_w,
+            src_h,
+            src_fmt,
+            dst_w,
+            dst_h,
+            dst_fmt,
+            algo,
+        ) catch {
+            allocator.destroy(ctx);
+            return null;
+        };
+    }
+
+    return ctx;
+}
+
+export fn swscale_process(
+    ctx_opt: ?*SwsContext,
+    src: [*]const [*]const u8,
+    src_stride: [*]const c_int,
+    dst: [*]const [*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx = ctx_opt orelse return -1;
+
+    if (ctx.is_unscaled_special) {
+        unscaled.processUnscaled(
+            ctx.src_fmt,
+            ctx.dst_fmt,
+            ctx.src_w,
+            ctx.src_h,
+            src,
+            src_stride,
+            dst,
+            dst_stride,
+            &ctx.tables,
+        );
+        return 0;
+    }
+
+    if (ctx.scaler_ctx) |*sc| {
+        sc.process(src, src_stride, dst, dst_stride, &ctx.tables);
+        return 0;
+    }
+
+    return -1;
+}
+
+export fn swscale_destroy(ctx_opt: ?*SwsContext) void {
+    const ctx = ctx_opt orelse return;
+    if (ctx.scaler_ctx) |*sc| {
+        sc.deinit();
+    }
+    std.heap.c_allocator.destroy(ctx);
+}
diff --git a/swscale-impl/src/scaler.zig b/swscale-impl/src/scaler.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/scaler.zig
@@ -0,0 +1,927 @@
+const std = @import("std");
+const types = @import("types.zig");
+const filter = @import("filter.zig");
+const PixFmt = types.PixFmt;
+const Algo = types.Algo;
+
+pub const ScalerContext = struct {
+    allocator: std.mem.Allocator,
+    src_w: i32,
+    src_h: i32,
+    dst_w: i32,
+    dst_h: i32,
+    chr_src_w: i32,
+    chr_src_h: i32,
+    chr_dst_w: i32,
+    chr_dst_h: i32,
+    chr_src_h_sub: u3,
+    chr_src_v_sub: u3,
+    chr_dst_h_sub: u3,
+    chr_dst_v_sub: u3,
+    src_fmt: PixFmt,
+    dst_fmt: PixFmt,
+    algo: Algo,
+    full_chr_h_int: bool,
+    needs_hcscale: bool,
+    need_alpha: bool,
+
+    h_lum: filter.FilterData,
+    h_chr: filter.FilterData,
+    v_lum: filter.FilterData,
+    v_chr: filter.FilterData,
+
+    conv_lum_buf: []u16,
+    conv_alp_buf: []u16,
+    conv_u_buf: []u16,
+    conv_v_buf: []u16,
+    nv_u_buf: []u8,
+    nv_v_buf: []u8,
+
+    lum_stride: usize,
+    chr_stride: usize,
+    lum_cap: usize,
+    chr_cap: usize,
+    lum_ring: []i16,
+    alp_ring: []i16,
+    chr_u_ring: []i16,
+    chr_v_ring: []i16,
+    lum_tags: []i32,
+    chr_tags: []i32,
+
+    lum_src_ptrs: [][*]const i16,
+    alp_src_ptrs: [][*]const i16,
+    chr_u_src_ptrs: [][*]const i16,
+    chr_v_src_ptrs: [][*]const i16,
+
+    pub fn init(
+        allocator: std.mem.Allocator,
+        src_w: i32,
+        src_h: i32,
+        src_fmt: PixFmt,
+        dst_w: i32,
+        dst_h: i32,
+        dst_fmt: PixFmt,
+        algo: Algo,
+    ) !ScalerContext {
+        const lum_x_inc: i32 = @intCast(@divTrunc((@as(i64, src_w) << 16) + (dst_w >> 1), dst_w));
+        const lum_y_inc: i32 = @intCast(@divTrunc((@as(i64, src_h) << 16) + (dst_h >> 1), dst_h));
+
+        var chr_src_sub = src_fmt.chromaSubSample();
+        var chr_dst_sub = dst_fmt.chromaSubSample();
+
+        var full_chr_h_int = false;
+        if (dst_fmt.isAnyRGB()) {
+            if ((dst_w & 1) != 0) full_chr_h_int = true;
+            if (chr_src_sub.h == 0 and chr_src_sub.v == 0) full_chr_h_int = true;
+        }
+        if (dst_fmt.isAnyRGB() and !full_chr_h_int) {
+            chr_dst_sub.h = 1;
+        }
+        if (src_fmt.isAnyRGB() and ((dst_w >> chr_dst_sub.h) <= (src_w >> 1))) {
+            chr_src_sub.h = 1;
+        }
+
+        const chr_src_w: i32 = (src_w + (@as(i32, 1) << chr_src_sub.h) - 1) >> chr_src_sub.h;
+        const chr_src_h: i32 = (src_h + (@as(i32, 1) << chr_src_sub.v) - 1) >> chr_src_sub.v;
+        const chr_dst_w: i32 = (dst_w + (@as(i32, 1) << chr_dst_sub.h) - 1) >> chr_dst_sub.h;
+        const chr_dst_h: i32 = (dst_h + (@as(i32, 1) << chr_dst_sub.v) - 1) >> chr_dst_sub.v;
+
+        const chr_x_inc: i32 = @intCast(@divTrunc((@as(i64, chr_src_w) << 16) + (chr_dst_w >> 1), chr_dst_w));
+        const chr_y_inc: i32 = @intCast(@divTrunc((@as(i64, chr_src_h) << 16) + (chr_dst_h >> 1), chr_dst_h));
+
+        var h_lum = try filter.initFilter(allocator, lum_x_inc, src_w, dst_w, 1 << 14, algo);
+        errdefer h_lum.deinit(allocator);
+        var h_chr = try filter.initFilter(allocator, chr_x_inc, chr_src_w, chr_dst_w, 1 << 14, algo);
+        errdefer h_chr.deinit(allocator);
+        var v_lum = try filter.initFilter(allocator, lum_y_inc, src_h, dst_h, 1 << 12, algo);
+        errdefer v_lum.deinit(allocator);
+        var v_chr = try filter.initFilter(allocator, chr_y_inc, chr_src_h, chr_dst_h, 1 << 12, algo);
+        errdefer v_chr.deinit(allocator);
+
+        const needs_hcscale = !(src_fmt.isGray() or dst_fmt.isGray());
+        const need_alpha = src_fmt.isAlpha() and dst_fmt.isAlpha();
+
+        const src_w_u: usize = @intCast(src_w);
+        const chr_src_w_u: usize = @intCast(chr_src_w);
+        const dst_w_u: usize = @intCast(dst_w);
+        const chr_dst_w_u: usize = @intCast(chr_dst_w);
+
+        const conv_lum_buf = try allocator.alloc(u16, src_w_u + 16);
+        errdefer allocator.free(conv_lum_buf);
+        const conv_alp_buf = try allocator.alloc(u16, if (need_alpha) src_w_u + 16 else 1);
+        errdefer allocator.free(conv_alp_buf);
+        const conv_u_buf = try allocator.alloc(u16, chr_src_w_u + 16);
+        errdefer allocator.free(conv_u_buf);
+        const conv_v_buf = try allocator.alloc(u16, chr_src_w_u + 16);
+        errdefer allocator.free(conv_v_buf);
+        const nv_u_buf = try allocator.alloc(u8, if (src_fmt.isSemiPlanar()) chr_src_w_u + 16 else 1);
+        errdefer allocator.free(nv_u_buf);
+        const nv_v_buf = try allocator.alloc(u8, if (src_fmt.isSemiPlanar()) chr_src_w_u + 16 else 1);
+        errdefer allocator.free(nv_v_buf);
+
+        const lum_stride: usize = (dst_w_u + 15) & ~@as(usize, 15);
+        const chr_stride: usize = (chr_dst_w_u + 15) & ~@as(usize, 15);
+        const lum_cap: usize = v_lum.filter_size + 2;
+        const chr_cap: usize = v_chr.filter_size + 2;
+
+        const lum_ring = try allocator.alloc(i16, lum_cap * lum_stride);
+        errdefer allocator.free(lum_ring);
+        @memset(lum_ring, 1 << 14);
+
+        const alp_ring = try allocator.alloc(i16, if (need_alpha) lum_cap * lum_stride else 1);
+        errdefer allocator.free(alp_ring);
+        @memset(alp_ring, 1 << 14);
+
+        const chr_u_ring = try allocator.alloc(i16, chr_cap * chr_stride);
+        errdefer allocator.free(chr_u_ring);
+        @memset(chr_u_ring, 1 << 14);
+
+        const chr_v_ring = try allocator.alloc(i16, chr_cap * chr_stride);
+        errdefer allocator.free(chr_v_ring);
+        @memset(chr_v_ring, 1 << 14);
+
+        const lum_tags = try allocator.alloc(i32, lum_cap);
+        errdefer allocator.free(lum_tags);
+        const chr_tags = try allocator.alloc(i32, chr_cap);
+        errdefer allocator.free(chr_tags);
+
+        const lum_ptr_len = @max(v_lum.filter_size, 2);
+        const chr_ptr_len = @max(v_chr.filter_size, 2);
+
+        const lum_src_ptrs = try allocator.alloc([*]const i16, lum_ptr_len);
+        errdefer allocator.free(lum_src_ptrs);
+        const alp_src_ptrs = try allocator.alloc([*]const i16, lum_ptr_len);
+        errdefer allocator.free(alp_src_ptrs);
+        const chr_u_src_ptrs = try allocator.alloc([*]const i16, chr_ptr_len);
+        errdefer allocator.free(chr_u_src_ptrs);
+        const chr_v_src_ptrs = try allocator.alloc([*]const i16, chr_ptr_len);
+        errdefer allocator.free(chr_v_src_ptrs);
+
+        return ScalerContext{
+            .allocator = allocator,
+            .src_w = src_w,
+            .src_h = src_h,
+            .dst_w = dst_w,
+            .dst_h = dst_h,
+            .chr_src_w = chr_src_w,
+            .chr_src_h = chr_src_h,
+            .chr_dst_w = chr_dst_w,
+            .chr_dst_h = chr_dst_h,
+            .chr_src_h_sub = chr_src_sub.h,
+            .chr_src_v_sub = chr_src_sub.v,
+            .chr_dst_h_sub = chr_dst_sub.h,
+            .chr_dst_v_sub = chr_dst_sub.v,
+            .src_fmt = src_fmt,
+            .dst_fmt = dst_fmt,
+            .algo = algo,
+            .full_chr_h_int = full_chr_h_int,
+            .needs_hcscale = needs_hcscale,
+            .need_alpha = need_alpha,
+            .h_lum = h_lum,
+            .h_chr = h_chr,
+            .v_lum = v_lum,
+            .v_chr = v_chr,
+            .conv_lum_buf = conv_lum_buf,
+            .conv_alp_buf = conv_alp_buf,
+            .conv_u_buf = conv_u_buf,
+            .conv_v_buf = conv_v_buf,
+            .nv_u_buf = nv_u_buf,
+            .nv_v_buf = nv_v_buf,
+            .lum_stride = lum_stride,
+            .chr_stride = chr_stride,
+            .lum_cap = lum_cap,
+            .chr_cap = chr_cap,
+            .lum_ring = lum_ring,
+            .alp_ring = alp_ring,
+            .chr_u_ring = chr_u_ring,
+            .chr_v_ring = chr_v_ring,
+            .lum_tags = lum_tags,
+            .chr_tags = chr_tags,
+            .lum_src_ptrs = lum_src_ptrs,
+            .alp_src_ptrs = alp_src_ptrs,
+            .chr_u_src_ptrs = chr_u_src_ptrs,
+            .chr_v_src_ptrs = chr_v_src_ptrs,
+        };
+    }
+
+    pub fn deinit(self: *ScalerContext) void {
+        self.h_lum.deinit(self.allocator);
+        self.h_chr.deinit(self.allocator);
+        self.v_lum.deinit(self.allocator);
+        self.v_chr.deinit(self.allocator);
+        self.allocator.free(self.conv_lum_buf);
+        self.allocator.free(self.conv_alp_buf);
+        self.allocator.free(self.conv_u_buf);
+        self.allocator.free(self.conv_v_buf);
+        self.allocator.free(self.nv_u_buf);
+        self.allocator.free(self.nv_v_buf);
+        self.allocator.free(self.lum_ring);
+        self.allocator.free(self.alp_ring);
+        self.allocator.free(self.chr_u_ring);
+        self.allocator.free(self.chr_v_ring);
+        self.allocator.free(self.lum_tags);
+        self.allocator.free(self.chr_tags);
+        self.allocator.free(self.lum_src_ptrs);
+        self.allocator.free(self.alp_src_ptrs);
+        self.allocator.free(self.chr_u_src_ptrs);
+        self.allocator.free(self.chr_v_src_ptrs);
+    }
+
+    fn convertAndScaleLumRow(
+        self: *ScalerContext,
+        src_y: usize,
+        src: [*]const [*]const u8,
+        src_stride: [*]const c_int,
+        dst_lum: [*]i16,
+        dst_alp: [*]i16,
+    ) void {
+        const src_w_u: usize = @intCast(self.src_w);
+        const dst_w_u: usize = @intCast(self.dst_w);
+        const s0_stride: usize = @intCast(src_stride[0]);
+        const s_row = src[0] + src_y * s0_stride;
+
+        if (self.src_fmt.isAnyRGB()) {
+            const step: usize = if (self.src_fmt == .rgb24 or self.src_fmt == .bgr24) 3 else 4;
+            const r_idx: usize = if (self.src_fmt == .rgb24 or self.src_fmt == .rgba) 0 else 2;
+            const b_idx: usize = if (self.src_fmt == .rgb24 or self.src_fmt == .rgba) 2 else 0;
+            const bias: i32 = (32 << 14) + (1 << 8);
+            for (0..src_w_u) |x| {
+                const r: i32 = s_row[x * step + r_idx];
+                const g: i32 = s_row[x * step + 1];
+                const b: i32 = s_row[x * step + b_idx];
+                self.conv_lum_buf[x] = @intCast((types.RY * r + types.GY * g + types.BY * b + bias) >> 9);
+            }
+            hScale16To15(dst_lum, dst_w_u, self.conv_lum_buf.ptr, self.h_lum.filter.ptr, self.h_lum.filter_pos.ptr, self.h_lum.filter_size);
+
+            if (self.need_alpha) {
+                for (0..src_w_u) |x| {
+                    const a: u16 = s_row[x * 4 + 3];
+                    self.conv_alp_buf[x] = (a << 6) | (a >> 2);
+                }
+                hScale16To15(dst_alp, dst_w_u, self.conv_alp_buf.ptr, self.h_lum.filter.ptr, self.h_lum.filter_pos.ptr, self.h_lum.filter_size);
+            }
+        } else {
+            hScale8To15(dst_lum, dst_w_u, s_row, self.h_lum.filter.ptr, self.h_lum.filter_pos.ptr, self.h_lum.filter_size);
+        }
+    }
+
+    fn convertAndScaleChrRow(
+        self: *ScalerContext,
+        chr_src_y: usize,
+        src: [*]const [*]const u8,
+        src_stride: [*]const c_int,
+        dst_u: [*]i16,
+        dst_v: [*]i16,
+    ) void {
+        const chr_src_w_u: usize = @intCast(self.chr_src_w);
+        const chr_dst_w_u: usize = @intCast(self.chr_dst_w);
+
+        if (self.src_fmt.isAnyRGB()) {
+            const s0_stride: usize = @intCast(src_stride[0]);
+            const s_row = src[0] + (chr_src_y << self.chr_src_v_sub) * s0_stride;
+            const step: usize = if (self.src_fmt == .rgb24 or self.src_fmt == .bgr24) 3 else 4;
+            const r_idx: usize = if (self.src_fmt == .rgb24 or self.src_fmt == .rgba) 0 else 2;
+            const b_idx: usize = if (self.src_fmt == .rgb24 or self.src_fmt == .rgba) 2 else 0;
+
+            if (self.chr_src_h_sub != 0) {
+                const bias: i32 = (256 << 15) + (1 << 9);
+                const step2 = step * 2;
+                for (0..chr_src_w_u) |x| {
+                    const base = x * step2;
+                    const r: i32 = @as(i32, s_row[base + r_idx]) + @as(i32, s_row[base + step + r_idx]);
+                    const g: i32 = @as(i32, s_row[base + 1]) + @as(i32, s_row[base + step + 1]);
+                    const b: i32 = @as(i32, s_row[base + b_idx]) + @as(i32, s_row[base + step + b_idx]);
+                    self.conv_u_buf[x] = @intCast((types.RU * r + types.GU * g + types.BU * b + bias) >> 10);
+                    self.conv_v_buf[x] = @intCast((types.RV * r + types.GV * g + types.BV * b + bias) >> 10);
+                }
+            } else {
+                const bias: i32 = (256 << 14) + (1 << 8);
+                for (0..chr_src_w_u) |x| {
+                    const base = x * step;
+                    const r: i32 = s_row[base + r_idx];
+                    const g: i32 = s_row[base + 1];
+                    const b: i32 = s_row[base + b_idx];
+                    self.conv_u_buf[x] = @intCast((types.RU * r + types.GU * g + types.BU * b + bias) >> 9);
+                    self.conv_v_buf[x] = @intCast((types.RV * r + types.GV * g + types.BV * b + bias) >> 9);
+                }
+            }
+            hScale16To15(dst_u, chr_dst_w_u, self.conv_u_buf.ptr, self.h_chr.filter.ptr, self.h_chr.filter_pos.ptr, self.h_chr.filter_size);
+            hScale16To15(dst_v, chr_dst_w_u, self.conv_v_buf.ptr, self.h_chr.filter.ptr, self.h_chr.filter_pos.ptr, self.h_chr.filter_size);
+        } else if (self.src_fmt.isSemiPlanar()) {
+            const s1_stride: usize = @intCast(src_stride[1]);
+            const s_row = src[1] + chr_src_y * s1_stride;
+            if (self.src_fmt == .nv12) {
+                for (0..chr_src_w_u) |x| {
+                    self.nv_u_buf[x] = s_row[2 * x + 0];
+                    self.nv_v_buf[x] = s_row[2 * x + 1];
+                }
+            } else {
+                for (0..chr_src_w_u) |x| {
+                    self.nv_v_buf[x] = s_row[2 * x + 0];
+                    self.nv_u_buf[x] = s_row[2 * x + 1];
+                }
+            }
+            hScale8To15(dst_u, chr_dst_w_u, self.nv_u_buf.ptr, self.h_chr.filter.ptr, self.h_chr.filter_pos.ptr, self.h_chr.filter_size);
+            hScale8To15(dst_v, chr_dst_w_u, self.nv_v_buf.ptr, self.h_chr.filter.ptr, self.h_chr.filter_pos.ptr, self.h_chr.filter_size);
+        } else {
+            const s1_stride: usize = @intCast(src_stride[1]);
+            const s2_stride: usize = @intCast(src_stride[2]);
+            const u_row = src[1] + chr_src_y * s1_stride;
+            const v_row = src[2] + chr_src_y * s2_stride;
+            hScale8To15(dst_u, chr_dst_w_u, u_row, self.h_chr.filter.ptr, self.h_chr.filter_pos.ptr, self.h_chr.filter_size);
+            hScale8To15(dst_v, chr_dst_w_u, v_row, self.h_chr.filter.ptr, self.h_chr.filter_pos.ptr, self.h_chr.filter_size);
+        }
+    }
+
+    pub fn process(
+        self: *ScalerContext,
+        src: [*]const [*]const u8,
+        src_stride: [*]const c_int,
+        dst: [*]const [*]u8,
+        dst_stride: [*]const c_int,
+        tables: *const types.Yuv2RgbTables,
+    ) void {
+        @memset(self.lum_tags, -1);
+        @memset(self.chr_tags, -1);
+
+        const dst_w_u: usize = @intCast(self.dst_w);
+        const dst_h_u: usize = @intCast(self.dst_h);
+        const chr_dst_w_u: usize = @intCast(self.chr_dst_w);
+        const v_lum_fsize = self.v_lum.filter_size;
+        const v_chr_fsize = self.v_chr.filter_size;
+        const v_lum_fsize_i32: i32 = @intCast(v_lum_fsize);
+        const v_chr_fsize_i32: i32 = @intCast(v_chr_fsize);
+
+        if (!self.needs_hcscale) {
+            for (0..self.chr_u_src_ptrs.len) |j| {
+                self.chr_u_src_ptrs[j] = self.chr_u_ring.ptr;
+                self.chr_v_src_ptrs[j] = self.chr_v_ring.ptr;
+            }
+        } else {
+            self.chr_u_src_ptrs[0] = self.chr_u_ring.ptr;
+            self.chr_v_src_ptrs[0] = self.chr_v_ring.ptr;
+            if (self.chr_u_src_ptrs.len > 1) {
+                self.chr_u_src_ptrs[1] = self.chr_u_ring.ptr;
+                self.chr_v_src_ptrs[1] = self.chr_v_ring.ptr;
+            }
+        }
+
+        const d0_stride: usize = @intCast(dst_stride[0]);
+        const chr_skip_mask: usize = (@as(usize, 1) << self.chr_dst_v_sub) - 1;
+
+        for (0..dst_h_u) |dst_y| {
+            const chr_dst_y = dst_y >> self.chr_dst_v_sub;
+            const first_lum_src_y: i32 = @max(1 - v_lum_fsize_i32, self.v_lum.filter_pos[dst_y]);
+
+            for (0..v_lum_fsize) |j| {
+                const j_i32: i32 = @intCast(j);
+                const sy: i32 = std.math.clamp(first_lum_src_y + j_i32, 0, self.src_h - 1);
+                const sy_u: usize = @intCast(sy);
+                const slot: usize = sy_u % self.lum_cap;
+                if (self.lum_tags[slot] != sy) {
+                    const dst_lum = self.lum_ring.ptr + slot * self.lum_stride;
+                    const dst_alp = if (self.need_alpha) self.alp_ring.ptr + slot * self.lum_stride else self.alp_ring.ptr;
+                    self.convertAndScaleLumRow(sy_u, src, src_stride, dst_lum, dst_alp);
+                    self.lum_tags[slot] = sy;
+                }
+                self.lum_src_ptrs[j] = self.lum_ring.ptr + slot * self.lum_stride;
+                if (self.need_alpha) {
+                    self.alp_src_ptrs[j] = self.alp_ring.ptr + slot * self.lum_stride;
+                }
+            }
+
+            if (self.needs_hcscale and (dst_y & chr_skip_mask) == 0) {
+                const first_chr_src_y: i32 = @max(1 - v_chr_fsize_i32, self.v_chr.filter_pos[chr_dst_y]);
+                for (0..v_chr_fsize) |j| {
+                    const j_i32: i32 = @intCast(j);
+                    const cy: i32 = std.math.clamp(first_chr_src_y + j_i32, 0, self.chr_src_h - 1);
+                    const cy_u: usize = @intCast(cy);
+                    const slot: usize = cy_u % self.chr_cap;
+                    if (self.chr_tags[slot] != cy) {
+                        const dst_u = self.chr_u_ring.ptr + slot * self.chr_stride;
+                        const dst_v = self.chr_v_ring.ptr + slot * self.chr_stride;
+                        self.convertAndScaleChrRow(cy_u, src, src_stride, dst_u, dst_v);
+                        self.chr_tags[slot] = cy;
+                    }
+                    self.chr_u_src_ptrs[j] = self.chr_u_ring.ptr + slot * self.chr_stride;
+                    self.chr_v_src_ptrs[j] = self.chr_v_ring.ptr + slot * self.chr_stride;
+                }
+            }
+
+            const lum_filter = self.v_lum.filter.ptr + dst_y * v_lum_fsize;
+            const chr_filter = self.v_chr.filter.ptr + chr_dst_y * v_chr_fsize;
+
+            if (self.dst_fmt.isPlanarYUV() or self.dst_fmt.isGray()) {
+                const d_y = dst[0] + dst_y * d0_stride;
+                if (v_lum_fsize == 1) {
+                    yuv2plane1_8(self.lum_src_ptrs[0], d_y, dst_w_u);
+                } else {
+                    yuv2planeX_8(lum_filter, v_lum_fsize, self.lum_src_ptrs.ptr, d_y, dst_w_u);
+                }
+
+                if (!self.dst_fmt.isGray() and (dst_y & chr_skip_mask) == 0) {
+                    const d1_stride: usize = @intCast(dst_stride[1]);
+                    const d_u = dst[1] + chr_dst_y * d1_stride;
+                    if (self.dst_fmt.isSemiPlanar()) {
+                        yuv2nv12cX(self.dst_fmt == .nv21, chr_filter, v_chr_fsize, self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, d_u, chr_dst_w_u);
+                    } else {
+                        const d2_stride: usize = @intCast(dst_stride[2]);
+                        const d_v = dst[2] + chr_dst_y * d2_stride;
+                        if (v_chr_fsize == 1) {
+                            yuv2plane1_8(self.chr_u_src_ptrs[0], d_u, chr_dst_w_u);
+                            yuv2plane1_8(self.chr_v_src_ptrs[0], d_v, chr_dst_w_u);
+                        } else {
+                            yuv2planeX_8(chr_filter, v_chr_fsize, self.chr_u_src_ptrs.ptr, d_u, chr_dst_w_u);
+                            yuv2planeX_8(chr_filter, v_chr_fsize, self.chr_v_src_ptrs.ptr, d_v, chr_dst_w_u);
+                        }
+                    }
+                }
+            } else {
+                const d_rgb = dst[0] + dst_y * d0_stride;
+                const use_1 = (v_lum_fsize == 1 and v_chr_fsize == 1) or
+                    (v_lum_fsize == 1 and v_chr_fsize == 2 and
+                    (@as(i32, chr_filter[0]) + @as(i32, chr_filter[1]) == 4096) and
+                    chr_filter[1] >= 0 and chr_filter[1] <= 4096);
+                const use_2 = !use_1 and (v_lum_fsize == 2 and v_chr_fsize == 2 and
+                    (@as(i32, lum_filter[0]) + @as(i32, lum_filter[1]) == 4096) and
+                    lum_filter[1] >= 0 and lum_filter[1] <= 4096 and
+                    (@as(i32, chr_filter[0]) + @as(i32, chr_filter[1]) == 4096) and
+                    chr_filter[1] >= 0 and chr_filter[1] <= 4096);
+
+                if (self.full_chr_h_int) {
+                    if (use_1) {
+                        const uvalpha: i32 = if (v_chr_fsize == 1) 0 else chr_filter[1];
+                        yuv2rgbFull1(self.dst_fmt, self.need_alpha, self.lum_src_ptrs[0], self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, self.alp_src_ptrs[0], d_rgb, dst_w_u, uvalpha);
+                    } else if (use_2) {
+                        yuv2rgbFull2(self.dst_fmt, self.need_alpha, self.lum_src_ptrs.ptr, self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, self.alp_src_ptrs.ptr, d_rgb, dst_w_u, lum_filter[1], chr_filter[1]);
+                    } else {
+                        yuv2rgbFullX(self.dst_fmt, self.need_alpha, lum_filter, self.lum_src_ptrs.ptr, v_lum_fsize, chr_filter, self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, v_chr_fsize, self.alp_src_ptrs.ptr, d_rgb, dst_w_u);
+                    }
+                } else {
+                    if (use_1) {
+                        const uvalpha: i32 = if (v_chr_fsize == 1) 0 else chr_filter[1];
+                        yuv2rgb1(self.dst_fmt, self.need_alpha, self.lum_src_ptrs[0], self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, self.alp_src_ptrs[0], d_rgb, dst_w_u, uvalpha, tables);
+                    } else if (use_2) {
+                        yuv2rgb2(self.dst_fmt, self.need_alpha, self.lum_src_ptrs.ptr, self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, self.alp_src_ptrs.ptr, d_rgb, dst_w_u, lum_filter[1], chr_filter[1], tables);
+                    } else {
+                        yuv2rgbX(self.dst_fmt, self.need_alpha, lum_filter, self.lum_src_ptrs.ptr, v_lum_fsize, chr_filter, self.chr_u_src_ptrs.ptr, self.chr_v_src_ptrs.ptr, v_chr_fsize, self.alp_src_ptrs.ptr, d_rgb, dst_w_u, tables);
+                    }
+                }
+            }
+        }
+    }
+};
+
+fn hScale8To15(
+    dst: [*]i16,
+    dst_w: usize,
+    src: [*]const u8,
+    filter_coeffs: [*]const i16,
+    filter_pos: [*]const i32,
+    filter_size: usize,
+) void {
+    for (0..dst_w) |i| {
+        const src_pos: usize = @intCast(filter_pos[i]);
+        var val: i32 = 0;
+        for (0..filter_size) |j| {
+            val += @as(i32, src[src_pos + j]) * @as(i32, filter_coeffs[i * filter_size + j]);
+        }
+        dst[i] = @intCast(@min(val >> 7, (1 << 15) - 1));
+    }
+}
+
+fn hScale16To15(
+    dst: [*]i16,
+    dst_w: usize,
+    src: [*]const u16,
+    filter_coeffs: [*]const i16,
+    filter_pos: [*]const i32,
+    filter_size: usize,
+) void {
+    for (0..dst_w) |i| {
+        const src_pos: usize = @intCast(filter_pos[i]);
+        var val: i32 = 0;
+        for (0..filter_size) |j| {
+            val += @as(i32, src[src_pos + j]) * @as(i32, filter_coeffs[i * filter_size + j]);
+        }
+        dst[i] = @intCast(@min(val >> 13, (1 << 15) - 1));
+    }
+}
+
+fn yuv2plane1_8(src: [*]const i16, dst: [*]u8, dst_w: usize) void {
+    for (0..dst_w) |i| {
+        const val: i32 = (@as(i32, src[i]) + 64) >> 7;
+        dst[i] = types.clipU8(val);
+    }
+}
+
+fn yuv2planeX_8(
+    filter_coeffs: [*]const i16,
+    filter_size: usize,
+    src: [*]const [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+) void {
+    for (0..dst_w) |i| {
+        var val: i32 = 64 << 12;
+        for (0..filter_size) |j| {
+            val += @as(i32, src[j][i]) * @as(i32, filter_coeffs[j]);
+        }
+        dst[i] = types.clipU8(val >> 19);
+    }
+}
+
+fn yuv2nv12cX(
+    swapped: bool,
+    chr_filter: [*]const i16,
+    chr_filter_size: usize,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    dst: [*]u8,
+    chr_dst_w: usize,
+) void {
+    if (!swapped) {
+        for (0..chr_dst_w) |i| {
+            var u: i32 = 64 << 12;
+            var v: i32 = 64 << 12;
+            for (0..chr_filter_size) |j| {
+                const c: i32 = chr_filter[j];
+                u += @as(i32, chr_u_src[j][i]) * c;
+                v += @as(i32, chr_v_src[j][i]) * c;
+            }
+            dst[2 * i + 0] = types.clipU8(u >> 19);
+            dst[2 * i + 1] = types.clipU8(v >> 19);
+        }
+    } else {
+        for (0..chr_dst_w) |i| {
+            var u: i32 = 64 << 12;
+            var v: i32 = 64 << 12;
+            for (0..chr_filter_size) |j| {
+                const c: i32 = chr_filter[j];
+                u += @as(i32, chr_u_src[j][i]) * c;
+                v += @as(i32, chr_v_src[j][i]) * c;
+            }
+            dst[2 * i + 0] = types.clipU8(v >> 19);
+            dst[2 * i + 1] = types.clipU8(u >> 19);
+        }
+    }
+}
+
+inline fn writeRgbFullPixel(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    dp: [*]u8,
+    y_in: i32,
+    u_in: i32,
+    v_in: i32,
+    a_in: u8,
+) void {
+    const y_val: i32 = (y_in - types.YUV2RGB_Y_OFFSET) * types.YUV2RGB_Y_COEFF + (1 << 21);
+    var r: i32 = y_val + v_in * types.YUV2RGB_V2R_COEFF;
+    var g: i32 = y_val + v_in * types.YUV2RGB_V2G_COEFF + u_in * types.YUV2RGB_U2G_COEFF;
+    var b: i32 = y_val + u_in * types.YUV2RGB_U2B_COEFF;
+
+    if (((r | g | b) & @as(i32, @bitCast(@as(u32, 0xC0000000)))) != 0) {
+        r = types.clipUintp2_30(r);
+        g = types.clipUintp2_30(g);
+        b = types.clipUintp2_30(b);
+    }
+
+    const r8: u8 = @intCast(r >> 22);
+    const g8: u8 = @intCast(g >> 22);
+    const b8: u8 = @intCast(b >> 22);
+
+    switch (dst_fmt) {
+        .rgb24 => {
+            dp[0] = r8;
+            dp[1] = g8;
+            dp[2] = b8;
+        },
+        .bgr24 => {
+            dp[0] = b8;
+            dp[1] = g8;
+            dp[2] = r8;
+        },
+        .rgba => {
+            dp[0] = r8;
+            dp[1] = g8;
+            dp[2] = b8;
+            dp[3] = if (has_alpha) a_in else 255;
+        },
+        .bgra => {
+            dp[0] = b8;
+            dp[1] = g8;
+            dp[2] = r8;
+            dp[3] = if (has_alpha) a_in else 255;
+        },
+        else => unreachable,
+    }
+}
+
+fn yuv2rgbFullX(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    lum_filter: [*]const i16,
+    lum_src: [*]const [*]const i16,
+    lum_fsize: usize,
+    chr_filter: [*]const i16,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    chr_fsize: usize,
+    alp_src: [*]const [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+) void {
+    const step: usize = if (dst_fmt == .rgb24 or dst_fmt == .bgr24) 3 else 4;
+    for (0..dst_w) |i| {
+        var y_val: i32 = 1 << 9;
+        var u_val: i32 = (1 << 9) - (128 << 19);
+        var v_val: i32 = (1 << 9) - (128 << 19);
+        for (0..lum_fsize) |j| {
+            y_val += @as(i32, lum_src[j][i]) * @as(i32, lum_filter[j]);
+        }
+        for (0..chr_fsize) |j| {
+            const c: i32 = chr_filter[j];
+            u_val += @as(i32, chr_u_src[j][i]) * c;
+            v_val += @as(i32, chr_v_src[j][i]) * c;
+        }
+        y_val >>= 10;
+        u_val >>= 10;
+        v_val >>= 10;
+        var a8: u8 = 255;
+        if (has_alpha) {
+            var a_val: i32 = 1 << 18;
+            for (0..lum_fsize) |j| {
+                a_val += @as(i32, alp_src[j][i]) * @as(i32, lum_filter[j]);
+            }
+            a_val >>= 19;
+            a8 = types.clipU8(a_val);
+        }
+        writeRgbFullPixel(dst_fmt, has_alpha, dst + i * step, y_val, u_val, v_val, a8);
+    }
+}
+
+fn yuv2rgbFull2(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    lum_src: [*]const [*]const i16,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    alp_src: [*]const [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+    yalpha: i32,
+    uvalpha: i32,
+) void {
+    const step: usize = if (dst_fmt == .rgb24 or dst_fmt == .bgr24) 3 else 4;
+    const yalpha1: i32 = 4096 - yalpha;
+    const uvalpha1: i32 = 4096 - uvalpha;
+    const buf0 = lum_src[0];
+    const buf1 = lum_src[1];
+    const ubuf0 = chr_u_src[0];
+    const ubuf1 = chr_u_src[1];
+    const vbuf0 = chr_v_src[0];
+    const vbuf1 = chr_v_src[1];
+
+    for (0..dst_w) |i| {
+        const y_val: i32 = (@as(i32, buf0[i]) * yalpha1 + @as(i32, buf1[i]) * yalpha) >> 10;
+        const u_val: i32 = (@as(i32, ubuf0[i]) * uvalpha1 + @as(i32, ubuf1[i]) * uvalpha - (128 << 19)) >> 10;
+        const v_val: i32 = (@as(i32, vbuf0[i]) * uvalpha1 + @as(i32, vbuf1[i]) * uvalpha - (128 << 19)) >> 10;
+        var a8: u8 = 255;
+        if (has_alpha) {
+            const a_val: i32 = (@as(i32, alp_src[0][i]) * yalpha1 + @as(i32, alp_src[1][i]) * yalpha + (1 << 18)) >> 19;
+            a8 = types.clipU8(a_val);
+        }
+        writeRgbFullPixel(dst_fmt, has_alpha, dst + i * step, y_val, u_val, v_val, a8);
+    }
+}
+
+fn yuv2rgbFull1(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    buf0: [*]const i16,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    abuf0: [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+    uvalpha: i32,
+) void {
+    const step: usize = if (dst_fmt == .rgb24 or dst_fmt == .bgr24) 3 else 4;
+    const ubuf0 = chr_u_src[0];
+    const vbuf0 = chr_v_src[0];
+
+    if (uvalpha < 2048) {
+        for (0..dst_w) |i| {
+            const y_val: i32 = @as(i32, buf0[i]) * 4;
+            const u_val: i32 = (@as(i32, ubuf0[i]) - (128 << 7)) * 4;
+            const v_val: i32 = (@as(i32, vbuf0[i]) - (128 << 7)) * 4;
+            var a8: u8 = 255;
+            if (has_alpha) {
+                a8 = types.clipU8((@as(i32, abuf0[i]) + 64) >> 7);
+            }
+            writeRgbFullPixel(dst_fmt, has_alpha, dst + i * step, y_val, u_val, v_val, a8);
+        }
+    } else {
+        const ubuf1 = chr_u_src[1];
+        const vbuf1 = chr_v_src[1];
+        for (0..dst_w) |i| {
+            const y_val: i32 = @as(i32, buf0[i]) * 4;
+            const u_val: i32 = (@as(i32, ubuf0[i]) + @as(i32, ubuf1[i]) - (128 << 8)) * 2;
+            const v_val: i32 = (@as(i32, vbuf0[i]) + @as(i32, vbuf1[i]) - (128 << 8)) * 2;
+            var a8: u8 = 255;
+            if (has_alpha) {
+                a8 = types.clipU8((@as(i32, abuf0[i]) + 64) >> 7);
+            }
+            writeRgbFullPixel(dst_fmt, has_alpha, dst + i * step, y_val, u_val, v_val, a8);
+        }
+    }
+}
+
+inline fn writeRgbSubPair(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    dst: [*]u8,
+    i: usize,
+    y1: i32,
+    y2: i32,
+    u: i32,
+    v: i32,
+    a1: u8,
+    a2: u8,
+    tables: *const types.Yuv2RgbTables,
+) void {
+    const dst_step: usize = if (dst_fmt == .rgb24 or dst_fmt == .bgr24) 3 else 4;
+    const dst_r_idx: usize = if (dst_fmt == .rgb24 or dst_fmt == .rgba) 0 else 2;
+    const dst_b_idx: usize = if (dst_fmt == .rgb24 or dst_fmt == .rgba) 2 else 0;
+    const has_dst_a = (dst_step == 4);
+
+    const u_idx: usize = @intCast(u + @as(i32, @intCast(types.YUVRGB_TABLE_HEADROOM)));
+    const v_idx: usize = @intCast(v + @as(i32, @intCast(types.YUVRGB_TABLE_HEADROOM)));
+    const off_r: isize = tables.off_r[v_idx];
+    const off_g: isize = @as(isize, tables.off_gU[u_idx]) + @as(isize, tables.off_gV[v_idx]);
+    const off_b: isize = tables.off_b[u_idx];
+
+    const y1_isize: isize = @intCast(y1);
+    const y2_isize: isize = @intCast(y2);
+
+    const r1 = tables.y_table[@intCast(types.YOFFS + y1_isize + off_r)];
+    const g1 = tables.y_table[@intCast(types.YOFFS + y1_isize + off_g)];
+    const b1 = tables.y_table[@intCast(types.YOFFS + y1_isize + off_b)];
+
+    const r2 = tables.y_table[@intCast(types.YOFFS + y2_isize + off_r)];
+    const g2 = tables.y_table[@intCast(types.YOFFS + y2_isize + off_g)];
+    const b2 = tables.y_table[@intCast(types.YOFFS + y2_isize + off_b)];
+
+    const dp0 = dst + (2 * i) * dst_step;
+    const dp1 = dp0 + dst_step;
+
+    dp0[dst_r_idx] = r1;
+    dp0[1] = g1;
+    dp0[dst_b_idx] = b1;
+    if (has_dst_a) dp0[3] = if (has_alpha) a1 else 255;
+
+    dp1[dst_r_idx] = r2;
+    dp1[1] = g2;
+    dp1[dst_b_idx] = b2;
+    if (has_dst_a) dp1[3] = if (has_alpha) a2 else 255;
+}
+
+fn yuv2rgbX(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    lum_filter: [*]const i16,
+    lum_src: [*]const [*]const i16,
+    lum_fsize: usize,
+    chr_filter: [*]const i16,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    chr_fsize: usize,
+    alp_src: [*]const [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+    tables: *const types.Yuv2RgbTables,
+) void {
+    const pairs = (dst_w + 1) >> 1;
+    for (0..pairs) |i| {
+        var y1: i32 = 1 << 18;
+        var y2: i32 = 1 << 18;
+        var u: i32 = 1 << 18;
+        var v: i32 = 1 << 18;
+        for (0..lum_fsize) |j| {
+            const c: i32 = lum_filter[j];
+            y1 += @as(i32, lum_src[j][2 * i + 0]) * c;
+            y2 += @as(i32, lum_src[j][2 * i + 1]) * c;
+        }
+        for (0..chr_fsize) |j| {
+            const c: i32 = chr_filter[j];
+            u += @as(i32, chr_u_src[j][i]) * c;
+            v += @as(i32, chr_v_src[j][i]) * c;
+        }
+        y1 >>= 19;
+        y2 >>= 19;
+        u >>= 19;
+        v >>= 19;
+        var a1: u8 = 255;
+        var a2: u8 = 255;
+        if (has_alpha) {
+            var av1: i32 = 1 << 18;
+            var av2: i32 = 1 << 18;
+            for (0..lum_fsize) |j| {
+                const c: i32 = lum_filter[j];
+                av1 += @as(i32, alp_src[j][2 * i + 0]) * c;
+                av2 += @as(i32, alp_src[j][2 * i + 1]) * c;
+            }
+            a1 = types.clipU8(av1 >> 19);
+            a2 = types.clipU8(av2 >> 19);
+        }
+        writeRgbSubPair(dst_fmt, has_alpha, dst, i, y1, y2, u, v, a1, a2, tables);
+    }
+}
+
+fn yuv2rgb2(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    lum_src: [*]const [*]const i16,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    alp_src: [*]const [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+    yalpha: i32,
+    uvalpha: i32,
+    tables: *const types.Yuv2RgbTables,
+) void {
+    const yalpha1: i32 = 4096 - yalpha;
+    const uvalpha1: i32 = 4096 - uvalpha;
+    const buf0 = lum_src[0];
+    const buf1 = lum_src[1];
+    const ubuf0 = chr_u_src[0];
+    const ubuf1 = chr_u_src[1];
+    const vbuf0 = chr_v_src[0];
+    const vbuf1 = chr_v_src[1];
+    const pairs = (dst_w + 1) >> 1;
+
+    for (0..pairs) |i| {
+        const y1: i32 = (@as(i32, buf0[2 * i + 0]) * yalpha1 + @as(i32, buf1[2 * i + 0]) * yalpha) >> 19;
+        const y2: i32 = (@as(i32, buf0[2 * i + 1]) * yalpha1 + @as(i32, buf1[2 * i + 1]) * yalpha) >> 19;
+        const u: i32 = (@as(i32, ubuf0[i]) * uvalpha1 + @as(i32, ubuf1[i]) * uvalpha) >> 19;
+        const v: i32 = (@as(i32, vbuf0[i]) * uvalpha1 + @as(i32, vbuf1[i]) * uvalpha) >> 19;
+        var a1: u8 = 255;
+        var a2: u8 = 255;
+        if (has_alpha) {
+            a1 = types.clipU8((@as(i32, alp_src[0][2 * i + 0]) * yalpha1 + @as(i32, alp_src[1][2 * i + 0]) * yalpha) >> 19);
+            a2 = types.clipU8((@as(i32, alp_src[0][2 * i + 1]) * yalpha1 + @as(i32, alp_src[1][2 * i + 1]) * yalpha) >> 19);
+        }
+        writeRgbSubPair(dst_fmt, has_alpha, dst, i, y1, y2, u, v, a1, a2, tables);
+    }
+}
+
+fn yuv2rgb1(
+    dst_fmt: PixFmt,
+    has_alpha: bool,
+    buf0: [*]const i16,
+    chr_u_src: [*]const [*]const i16,
+    chr_v_src: [*]const [*]const i16,
+    abuf0: [*]const i16,
+    dst: [*]u8,
+    dst_w: usize,
+    uvalpha: i32,
+    tables: *const types.Yuv2RgbTables,
+) void {
+    const ubuf0 = chr_u_src[0];
+    const vbuf0 = chr_v_src[0];
+    const pairs = (dst_w + 1) >> 1;
+
+    if (uvalpha < 2048) {
+        for (0..pairs) |i| {
+            const y1: i32 = (@as(i32, buf0[2 * i + 0]) + 64) >> 7;
+            const y2: i32 = (@as(i32, buf0[2 * i + 1]) + 64) >> 7;
+            const u: i32 = (@as(i32, ubuf0[i]) + 64) >> 7;
+            const v: i32 = (@as(i32, vbuf0[i]) + 64) >> 7;
+            var a1: u8 = 255;
+            var a2: u8 = 255;
+            if (has_alpha) {
+                a1 = types.clipU8((@as(i32, abuf0[2 * i + 0]) * 255 + 16384) >> 15);
+                a2 = types.clipU8((@as(i32, abuf0[2 * i + 1]) * 255 + 16384) >> 15);
+            }
+            writeRgbSubPair(dst_fmt, has_alpha, dst, i, y1, y2, u, v, a1, a2, tables);
+        }
+    } else {
+        const ubuf1 = chr_u_src[1];
+        const vbuf1 = chr_v_src[1];
+        for (0..pairs) |i| {
+            const y1: i32 = (@as(i32, buf0[2 * i + 0]) + 64) >> 7;
+            const y2: i32 = (@as(i32, buf0[2 * i + 1]) + 64) >> 7;
+            const u: i32 = (@as(i32, ubuf0[i]) + @as(i32, ubuf1[i]) + 128) >> 8;
+            const v: i32 = (@as(i32, vbuf0[i]) + @as(i32, vbuf1[i]) + 128) >> 8;
+            var a1: u8 = 255;
+            var a2: u8 = 255;
+            if (has_alpha) {
+                a1 = types.clipU8((@as(i32, abuf0[2 * i + 0]) + 64) >> 7);
+                a2 = types.clipU8((@as(i32, abuf0[2 * i + 1]) + 64) >> 7);
+            }
+            writeRgbSubPair(dst_fmt, has_alpha, dst, i, y1, y2, u, v, a1, a2, tables);
+        }
+    }
+}
diff --git a/swscale-impl/src/types.zig b/swscale-impl/src/types.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/types.zig
@@ -0,0 +1,150 @@
+const std = @import("std");
+
+pub const PixFmt = enum(c_int) {
+    yuv420p = 0,
+    yuv422p = 1,
+    yuv444p = 2,
+    nv12 = 3,
+    nv21 = 4,
+    rgb24 = 5,
+    bgr24 = 6,
+    rgba = 7,
+    bgra = 8,
+    gray8 = 9,
+
+    pub fn isAnyRGB(self: PixFmt) bool {
+        return switch (self) {
+            .rgb24, .bgr24, .rgba, .bgra => true,
+            else => false,
+        };
+    }
+
+    pub fn isPlanarYUV(self: PixFmt) bool {
+        return switch (self) {
+            .yuv420p, .yuv422p, .yuv444p, .nv12, .nv21 => true,
+            else => false,
+        };
+    }
+
+    pub fn isSemiPlanar(self: PixFmt) bool {
+        return switch (self) {
+            .nv12, .nv21 => true,
+            else => false,
+        };
+    }
+
+    pub fn isGray(self: PixFmt) bool {
+        return self == .gray8;
+    }
+
+    pub fn isAlpha(self: PixFmt) bool {
+        return switch (self) {
+            .rgba, .bgra => true,
+            else => false,
+        };
+    }
+
+    pub fn chromaSubSample(self: PixFmt) struct { h: u3, v: u3 } {
+        return switch (self) {
+            .yuv420p, .nv12, .nv21 => .{ .h = 1, .v = 1 },
+            .yuv422p => .{ .h = 1, .v = 0 },
+            .yuv444p, .rgb24, .bgr24, .rgba, .bgra, .gray8 => .{ .h = 0, .v = 0 },
+        };
+    }
+};
+
+pub const Algo = enum(c_int) {
+    nearest = 0,
+    bilinear = 1,
+    bicubic = 2,
+};
+
+pub const RY: i32 = 8414;
+pub const GY: i32 = 16519;
+pub const BY: i32 = 3208;
+pub const RU: i32 = -4865;
+pub const GU: i32 = -9528;
+pub const BU: i32 = 14393;
+pub const RV: i32 = 14393;
+pub const GV: i32 = -12046;
+pub const BV: i32 = -2347;
+
+pub const YUV2RGB_Y_COEFF: i32 = 9539;
+pub const YUV2RGB_Y_OFFSET: i32 = 8192;
+pub const YUV2RGB_V2R_COEFF: i32 = 13075;
+pub const YUV2RGB_V2G_COEFF: i32 = -6660;
+pub const YUV2RGB_U2G_COEFF: i32 = -3209;
+pub const YUV2RGB_U2B_COEFF: i32 = 16525;
+
+pub const YUVRGB_TABLE_HEADROOM: usize = 512;
+pub const YUVRGB_TABLE_LUMA_HEADROOM: usize = 512;
+pub const TABLE_PLANE_SIZE: usize = 1024 + 2 * YUVRGB_TABLE_LUMA_HEADROOM;
+pub const YOFFS: isize = 326 + @as(isize, YUVRGB_TABLE_LUMA_HEADROOM);
+
+pub const Yuv2RgbTables = struct {
+    y_table: [TABLE_PLANE_SIZE]u8,
+    off_r: [256 + 2 * YUVRGB_TABLE_HEADROOM]i16,
+    off_gU: [256 + 2 * YUVRGB_TABLE_HEADROOM]i16,
+    off_gV: [256 + 2 * YUVRGB_TABLE_HEADROOM]i16,
+    off_b: [256 + 2 * YUVRGB_TABLE_HEADROOM]i16,
+
+    pub fn init() Yuv2RgbTables {
+        var t: Yuv2RgbTables = undefined;
+        const cy: i64 = (65536 * 255) / 219; // 76309
+        const oy: i64 = 16 << 16;
+        const crv_raw: i64 = 104597;
+        const cbu_raw: i64 = 132201;
+        const cgu_raw: i64 = -25675;
+        const cgv_raw: i64 = -53279;
+
+        const crv: i64 = @divTrunc((crv_raw << 16) + 0x8000, cy);
+        const cbu: i64 = @divTrunc((cbu_raw << 16) + 0x8000, cy);
+        const cgu: i64 = @divTrunc((cgu_raw << 16) + 0x8000, cy);
+        const cgv: i64 = @divTrunc((cgv_raw << 16) + 0x8000, cy);
+
+        var yb: i64 = -(384 << 16) - @as(i64, YUVRGB_TABLE_LUMA_HEADROOM) * cy - oy;
+        for (0..TABLE_PLANE_SIZE) |i| {
+            t.y_table[i] = clipU8(@intCast((yb + 0x8000) >> 16));
+            yb += cy;
+        }
+
+        const off_r_base: i64 = -(crv >> 9);
+        const off_gU_base: i64 = -(cgu >> 9);
+        const off_b_base: i64 = -(cbu >> 9);
+        const off_gV_base: i64 = -(cgv >> 9);
+
+        var r_cb: i64 = (off_r_base << 16) + 0x8000;
+        var gU_cb: i64 = (off_gU_base << 16) + 0x8000;
+        var b_cb: i64 = (off_b_base << 16) + 0x8000;
+
+        for (0..(256 + 2 * YUVRGB_TABLE_HEADROOM)) |i| {
+            const idx_signed: i32 = @as(i32, @intCast(i)) - @as(i32, @intCast(YUVRGB_TABLE_HEADROOM));
+            t.off_r[i] = @intCast(r_cb >> 16);
+            t.off_gU[i] = @intCast(gU_cb >> 16);
+            t.off_b[i] = @intCast(b_cb >> 16);
+            if (idx_signed >= 0 and idx_signed < 255) {
+                r_cb += crv;
+                gU_cb += cgu;
+                b_cb += cbu;
+            }
+            const clamped_v: i64 = @intCast(clipU8(idx_signed));
+            t.off_gV[i] = @intCast(off_gV_base + ((clamped_v * cgv) >> 16));
+        }
+
+        return t;
+    }
+};
+
+pub inline fn clipU8(a: i32) u8 {
+    if ((a & (~@as(i32, 0xFF))) != 0) {
+        return @intCast((~a) >> 31);
+    }
+    return @intCast(a);
+}
+
+pub inline fn clipUintp2_30(a: i32) i32 {
+    if ((a & (~@as(i32, (1 << 30) - 1))) != 0) {
+        return ((~a) >> 31) & ((1 << 30) - 1);
+    }
+    return a;
+}
diff --git a/swscale-impl/src/unscaled.zig b/swscale-impl/src/unscaled.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/unscaled.zig
@@ -0,0 +1,360 @@
+const std = @import("std");
+const types = @import("types.zig");
+const PixFmt = types.PixFmt;
+
+pub fn canHandleUnscaled(src_fmt: PixFmt, dst_fmt: PixFmt, w: i32, h: i32) bool {
+    if (src_fmt == dst_fmt) return true;
+    if (src_fmt.isPlanarYUV() and dst_fmt == .gray8) return true;
+    if (src_fmt == .gray8 and dst_fmt.isPlanarYUV()) return true;
+    if (src_fmt == .yuv420p and (dst_fmt == .nv12 or dst_fmt == .nv21)) return true;
+    if ((src_fmt == .nv12 or src_fmt == .nv21) and dst_fmt == .yuv420p) return true;
+    if (src_fmt.isAnyRGB() and dst_fmt.isAnyRGB()) return true;
+    if (src_fmt == .bgr24 and dst_fmt == .yuv420p and (w & 1) == 0) return true;
+    if ((src_fmt == .yuv420p or src_fmt == .yuv422p) and dst_fmt.isAnyRGB() and (h & 1) == 0) return true;
+    return false;
+}
+
+fn copyPlane(src: [*]const u8, src_stride: usize, dst: [*]u8, dst_stride: usize, byte_w: usize, h: usize) void {
+    if (src_stride == byte_w and dst_stride == byte_w) {
+        @memcpy(dst[0 .. byte_w * h], src[0 .. byte_w * h]);
+        return;
+    }
+    for (0..h) |y| {
+        const s = src + y * src_stride;
+        const d = dst + y * dst_stride;
+        @memcpy(d[0..byte_w], s[0..byte_w]);
+    }
+}
+
+fn fillPlane(dst: [*]u8, dst_stride: usize, byte_w: usize, h: usize, val: u8) void {
+    if (dst_stride == byte_w) {
+        @memset(dst[0 .. byte_w * h], val);
+        return;
+    }
+    for (0..h) |y| {
+        const d = dst + y * dst_stride;
+        @memset(d[0..byte_w], val);
+    }
+}
+
+pub fn processUnscaled(
+    src_fmt: PixFmt,
+    dst_fmt: PixFmt,
+    w_i32: i32,
+    h_i32: i32,
+    src: [*]const [*]const u8,
+    src_stride: [*]const c_int,
+    dst: [*]const [*]u8,
+    dst_stride: [*]const c_int,
+    tables: *const types.Yuv2RgbTables,
+) void {
+    const w: usize = @intCast(w_i32);
+    const h: usize = @intCast(h_i32);
+    const cw: usize = (w + 1) >> 1;
+    const ch: usize = (h + 1) >> 1;
+
+    if (src_fmt == dst_fmt) {
+        switch (src_fmt) {
+            .yuv420p => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+                copyPlane(src[1], @intCast(src_stride[1]), dst[1], @intCast(dst_stride[1]), cw, ch);
+                copyPlane(src[2], @intCast(src_stride[2]), dst[2], @intCast(dst_stride[2]), cw, ch);
+            },
+            .yuv422p => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+                copyPlane(src[1], @intCast(src_stride[1]), dst[1], @intCast(dst_stride[1]), cw, h);
+                copyPlane(src[2], @intCast(src_stride[2]), dst[2], @intCast(dst_stride[2]), cw, h);
+            },
+            .yuv444p => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+                copyPlane(src[1], @intCast(src_stride[1]), dst[1], @intCast(dst_stride[1]), w, h);
+                copyPlane(src[2], @intCast(src_stride[2]), dst[2], @intCast(dst_stride[2]), w, h);
+            },
+            .nv12, .nv21 => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+                copyPlane(src[1], @intCast(src_stride[1]), dst[1], @intCast(dst_stride[1]), cw * 2, ch);
+            },
+            .rgb24, .bgr24 => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w * 3, h);
+            },
+            .rgba, .bgra => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w * 4, h);
+            },
+            .gray8 => {
+                copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+            },
+        }
+        return;
+    }
+
+    if (src_fmt.isPlanarYUV() and dst_fmt == .gray8) {
+        copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+        return;
+    }
+
+    if (src_fmt == .gray8 and dst_fmt.isPlanarYUV()) {
+        copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+        switch (dst_fmt) {
+            .yuv420p => {
+                fillPlane(dst[1], @intCast(dst_stride[1]), cw, ch, 128);
+                fillPlane(dst[2], @intCast(dst_stride[2]), cw, ch, 128);
+            },
+            .yuv422p => {
+                fillPlane(dst[1], @intCast(dst_stride[1]), cw, h, 128);
+                fillPlane(dst[2], @intCast(dst_stride[2]), cw, h, 128);
+            },
+            .yuv444p => {
+                fillPlane(dst[1], @intCast(dst_stride[1]), w, h, 128);
+                fillPlane(dst[2], @intCast(dst_stride[2]), w, h, 128);
+            },
+            .nv12, .nv21 => {
+                fillPlane(dst[1], @intCast(dst_stride[1]), cw * 2, ch, 128);
+            },
+            else => unreachable,
+        }
+        return;
+    }
+
+    if (src_fmt == .yuv420p and (dst_fmt == .nv12 or dst_fmt == .nv21)) {
+        copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+        const s1_stride: usize = @intCast(src_stride[1]);
+        const s2_stride: usize = @intCast(src_stride[2]);
+        const d1_stride: usize = @intCast(dst_stride[1]);
+        const u_plane = if (dst_fmt == .nv12) src[1] else src[2];
+        const v_plane = if (dst_fmt == .nv12) src[2] else src[1];
+        const u_stride = if (dst_fmt == .nv12) s1_stride else s2_stride;
+        const v_stride = if (dst_fmt == .nv12) s2_stride else s1_stride;
+
+        for (0..ch) |y| {
+            const u_row = u_plane + y * u_stride;
+            const v_row = v_plane + y * v_stride;
+            const d_row = dst[1] + y * d1_stride;
+            for (0..cw) |x| {
+                d_row[2 * x + 0] = u_row[x];
+                d_row[2 * x + 1] = v_row[x];
+            }
+        }
+        return;
+    }
+
+    if ((src_fmt == .nv12 or src_fmt == .nv21) and dst_fmt == .yuv420p) {
+        copyPlane(src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), w, h);
+        const s1_stride: usize = @intCast(src_stride[1]);
+        const d1_stride: usize = @intCast(dst_stride[1]);
+        const d2_stride: usize = @intCast(dst_stride[2]);
+        const dst_first = if (src_fmt == .nv12) dst[1] else dst[2];
+        const dst_second = if (src_fmt == .nv12) dst[2] else dst[1];
+        const stride_first = if (src_fmt == .nv12) d1_stride else d2_stride;
+        const stride_second = if (src_fmt == .nv12) d2_stride else d1_stride;
+
+        for (0..ch) |y| {
+            const s_row = src[1] + y * s1_stride;
+            const d_a = dst_first + y * stride_first;
+            const d_b = dst_second + y * stride_second;
+            for (0..cw) |x| {
+                d_a[x] = s_row[2 * x + 0];
+                d_b[x] = s_row[2 * x + 1];
+            }
+        }
+        return;
+    }
+
+    if (src_fmt.isAnyRGB() and dst_fmt.isAnyRGB()) {
+        convertRgbToRgb(src_fmt, dst_fmt, w, h, src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]));
+        return;
+    }
+
+    if (src_fmt == .bgr24 and dst_fmt == .yuv420p and (w & 1) == 0) {
+        bgr24ToYv12(w, h, src[0], @intCast(src_stride[0]), dst[0], @intCast(dst_stride[0]), dst[1], @intCast(dst_stride[1]), dst[2], @intCast(dst_stride[2]));
+        return;
+    }
+
+    if ((src_fmt == .yuv420p or src_fmt == .yuv422p) and dst_fmt.isAnyRGB() and (h & 1) == 0) {
+        yuvToRgbUnscaled(src_fmt, dst_fmt, w, h, src, src_stride, dst[0], @intCast(dst_stride[0]), tables);
+        return;
+    }
+}
+
+fn convertRgbToRgb(
+    src_fmt: PixFmt,
+    dst_fmt: PixFmt,
+    w: usize,
+    h: usize,
+    src_base: [*]const u8,
+    src_stride: usize,
+    dst_base: [*]u8,
+    dst_stride: usize,
+) void {
+    const src_step: usize = if (src_fmt == .rgb24 or src_fmt == .bgr24) 3 else 4;
+    const dst_step: usize = if (dst_fmt == .rgb24 or dst_fmt == .bgr24) 3 else 4;
+    const src_r_idx: usize = if (src_fmt == .rgb24 or src_fmt == .rgba) 0 else 2;
+    const src_b_idx: usize = if (src_fmt == .rgb24 or src_fmt == .rgba) 2 else 0;
+    const dst_r_idx: usize = if (dst_fmt == .rgb24 or dst_fmt == .rgba) 0 else 2;
+    const dst_b_idx: usize = if (dst_fmt == .rgb24 or dst_fmt == .rgba) 2 else 0;
+    const has_src_a = (src_step == 4);
+    const has_dst_a = (dst_step == 4);
+
+    for (0..h) |y| {
+        const s_row = src_base + y * src_stride;
+        const d_row = dst_base + y * dst_stride;
+        for (0..w) |x| {
+            const sp = s_row + x * src_step;
+            const dp = d_row + x * dst_step;
+            const r = sp[src_r_idx];
+            const g = sp[1];
+            const b = sp[src_b_idx];
+            dp[dst_r_idx] = r;
+            dp[1] = g;
+            dp[dst_b_idx] = b;
+            if (has_dst_a) {
+                dp[3] = if (has_src_a) sp[3] else 255;
