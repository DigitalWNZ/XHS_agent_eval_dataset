+fn bgr24ToYv12(
+    w: usize,
+    h: usize,
+    src_base: [*]const u8,
+    src_stride: usize,
+    lum_base: [*]u8,
+    lum_stride: usize,
+    u_base: [*]u8,
+    u_stride: usize,
+    v_base: [*]u8,
+    v_stride: usize,
+) void {
+    const cw = w >> 1;
+    const ch = h >> 1;
+    for (0..ch) |cy| {
+        const y0 = cy * 2;
+        const y1 = y0 + 1;
+        const s0 = src_base + y0 * src_stride;
+        const s1 = src_base + y1 * src_stride;
+        const d_y0 = lum_base + y0 * lum_stride;
+        const d_y1 = lum_base + y1 * lum_stride;
+        const d_u = u_base + cy * u_stride;
+        const d_v = v_base + cy * v_stride;
+
+        for (0..cw) |cx| {
+            const b00: i32 = s0[6 * cx + 0];
+            const g00: i32 = s0[6 * cx + 1];
+            const r00: i32 = s0[6 * cx + 2];
+            const b01: i32 = s0[6 * cx + 3];
+            const g01: i32 = s0[6 * cx + 4];
+            const r01: i32 = s0[6 * cx + 5];
+
+            const b10: i32 = s1[6 * cx + 0];
+            const g10: i32 = s1[6 * cx + 1];
+            const r10: i32 = s1[6 * cx + 2];
+            const b11: i32 = s1[6 * cx + 3];
+            const g11: i32 = s1[6 * cx + 4];
+            const r11: i32 = s1[6 * cx + 5];
+
+            d_y0[2 * cx + 0] = @intCast(((types.RY * r00 + types.GY * g00 + types.BY * b00) >> 15) + 16);
+            d_y0[2 * cx + 1] = @intCast(((types.RY * r01 + types.GY * g01 + types.BY * b01) >> 15) + 16);
+            d_y1[2 * cx + 0] = @intCast(((types.RY * r10 + types.GY * g10 + types.BY * b10) >> 15) + 16);
+            d_y1[2 * cx + 1] = @intCast(((types.RY * r11 + types.GY * g11 + types.BY * b11) >> 15) + 16);
+
+            const bx = (b00 + b01 + b10 + b11) >> 2;
+            const gx = (g00 + g01 + g10 + g11) >> 2;
+            const rx = (r00 + r01 + r10 + r11) >> 2;
+
+            d_u[cx] = @intCast(((types.RU * rx + types.GU * gx + types.BU * bx) >> 15) + 128);
+            d_v[cx] = @intCast(((types.RV * rx + types.GV * gx + types.BV * bx) >> 15) + 128);
+        }
+    }
+    if ((h & 1) != 0) {
+        const y_last = h - 1;
+        const s_last = src_base + y_last * src_stride;
+        const d_last = lum_base + y_last * lum_stride;
+        for (0..w) |x| {
+            const b: i32 = s_last[3 * x + 0];
+            const g: i32 = s_last[3 * x + 1];
+            const r: i32 = s_last[3 * x + 2];
+            d_last[x] = @intCast(((types.RY * r + types.GY * g + types.BY * b) >> 15) + 16);
+        }
+    }
+}
