+fn yuvToRgbUnscaled(
+    src_fmt: PixFmt,
+    dst_fmt: PixFmt,
+    w: usize,
+    h: usize,
+    src: [*]const [*]const u8,
+    src_stride: [*]const c_int,
+    dst_base: [*]u8,
+    dst_stride: usize,
+    tables: *const types.Yuv2RgbTables,
+) void {
+    const s0_stride: usize = @intCast(src_stride[0]);
+    const s1_stride: usize = @intCast(src_stride[1]);
+    const s2_stride: usize = @intCast(src_stride[2]);
+    const is_422 = (src_fmt == .yuv422p);
+    const dst_step: usize = if (dst_fmt == .rgb24 or dst_fmt == .bgr24) 3 else 4;
+    const dst_r_idx: usize = if (dst_fmt == .rgb24 or dst_fmt == .rgba) 0 else 2;
+    const dst_b_idx: usize = if (dst_fmt == .rgb24 or dst_fmt == .rgba) 2 else 0;
+    const has_alpha = (dst_step == 4);
+
+    for (0..h) |y| {
+        const chr_y = if (is_422) y else (y >> 1);
+        const y_row = src[0] + y * s0_stride;
+        const u_row = src[1] + chr_y * s1_stride;
+        const v_row = src[2] + chr_y * s2_stride;
+        const d_row = dst_base + y * dst_stride;
+
+        const pairs = w >> 1;
+        for (0..pairs) |i| {
+            const u: usize = @as(usize, u_row[i]) + types.YUVRGB_TABLE_HEADROOM;
+            const v: usize = @as(usize, v_row[i]) + types.YUVRGB_TABLE_HEADROOM;
+            const off_r: isize = tables.off_r[v];
+            const off_g: isize = @as(isize, tables.off_gU[u]) + @as(isize, tables.off_gV[v]);
+            const off_b: isize = tables.off_b[u];
+
+            const y0: isize = @intCast(y_row[2 * i + 0]);
+            const y1: isize = @intCast(y_row[2 * i + 1]);
+
+            const r0 = tables.y_table[@intCast(types.YOFFS + y0 + off_r)];
+            const g0 = tables.y_table[@intCast(types.YOFFS + y0 + off_g)];
+            const b0 = tables.y_table[@intCast(types.YOFFS + y0 + off_b)];
+
+            const r1 = tables.y_table[@intCast(types.YOFFS + y1 + off_r)];
+            const g1 = tables.y_table[@intCast(types.YOFFS + y1 + off_g)];
+            const b1 = tables.y_table[@intCast(types.YOFFS + y1 + off_b)];
+
+            const dp0 = d_row + (2 * i) * dst_step;
+            const dp1 = dp0 + dst_step;
+
+            dp0[dst_r_idx] = r0;
+            dp0[1] = g0;
+            dp0[dst_b_idx] = b0;
+            if (has_alpha) dp0[3] = 255;
+
+            dp1[dst_r_idx] = r1;
+            dp1[1] = g1;
+            dp1[dst_b_idx] = b1;
+            if (has_alpha) dp1[3] = 255;
+        }
+        if ((w & 1) != 0) {
+            const i = pairs;
+            const u: usize = @as(usize, u_row[i]) + types.YUVRGB_TABLE_HEADROOM;
+            const v: usize = @as(usize, v_row[i]) + types.YUVRGB_TABLE_HEADROOM;
+            const off_r: isize = tables.off_r[v];
+            const off_g: isize = @as(isize, tables.off_gU[u]) + @as(isize, tables.off_gV[v]);
+            const off_b: isize = tables.off_b[u];
+
+            const y0: isize = @intCast(y_row[2 * i]);
+            const r0 = tables.y_table[@intCast(types.YOFFS + y0 + off_r)];
+            const g0 = tables.y_table[@intCast(types.YOFFS + y0 + off_g)];
+            const b0 = tables.y_table[@intCast(types.YOFFS + y0 + off_b)];
+
+            const dp0 = d_row + (2 * i) * dst_step;
+            dp0[dst_r_idx] = r0;
+            dp0[1] = g0;
+            dp0[dst_b_idx] = b0;
+            if (has_alpha) dp0[3] = 255;
+        }
+    }
