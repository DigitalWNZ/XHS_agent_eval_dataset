+// ── General Unscaled Packed RGB -> YUV (YUV444P, YUV422P, YUV420P, NV12, NV21)
+
+pub inline fn rgbToYVec16(r: V16u8, g: V16u8, b: V16u8) V16u8 {
+    const r16: V16u16 = r;
+    const g16: V16u16 = g;
+    const b16: V16u16 = b;
+    const y16: V16u16 = (mulhuwU8Sh8(r16, 16828) + mulhuwU8Sh8(g16, 33038) + mulhuwU8Sh8(b16, 6416) + @as(V16u16, @splat(4227))) >> @splat(8);
+    return @truncate(y16);
+}
+
+pub inline fn rgbToYScalar(r: i32, g: i32, b: i32) u8 {
+    return @intCast((8414 * r + 16519 * g + 3208 * b + 540928) >> 15);
+}
+
+pub fn rgbToYuv444p(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst_y: [*]u8,
+    dst_y_stride: c_int,
+    dst_u: [*]u8,
+    dst_u_stride: c_int,
+    dst_v: [*]u8,
+    dst_v_stride: c_int,
+    width: usize,
+    height: usize,
+    comptime src_fmt: c_int,
+) void {
+    const step = types.rgbStep(src_fmt);
+    const is_bgr = types.isBGROrder(src_fmt);
+
+    for (0..height) |y| {
+        const s_row = getRowPtrConst(src, src_stride, y);
+        const y_row = getRowPtrMut(dst_y, dst_y_stride, y);
+        const u_row = getRowPtrMut(dst_u, dst_u_stride, y);
+        const v_row = getRowPtrMut(dst_v, dst_v_stride, y);
+
+        var x: usize = 0;
+        while (x + 16 <= width) : (x += 16) {
+            const rgb = if (step == 3)
+                loadRgb24x16(s_row + x * 3, is_bgr)
+            else blk: {
+                const rgba = loadRgba32x16(s_row + x * 4, is_bgr);
+                break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+            };
+            const r16: V16u16 = rgb.r;
+            const g16: V16u16 = rgb.g;
+            const b16: V16u16 = rgb.b;
+
+            const y16: V16u16 = (mulhuwU8Sh8(r16, 16828) + mulhuwU8Sh8(g16, 33038) + mulhuwU8Sh8(b16, 6416) + @as(V16u16, @splat(4227))) >> @splat(8);
+            const u16_v: V16u16 = (mulhuwU8Sh8(b16, 28786) + @as(V16u16, @splat(32898)) - mulhuwU8Sh8(r16, 9730) - mulhuwU8Sh8(g16, 19056)) >> @splat(8);
+            const v16_v: V16u16 = (mulhuwU8Sh8(r16, 28786) + @as(V16u16, @splat(32898)) - mulhuwU8Sh8(g16, 24122) - mulhuwU8Sh8(b16, 4664)) >> @splat(8);
+
+            y_row[x..][0..16].* = @as(V16u8, @truncate(y16));
+            u_row[x..][0..16].* = @as(V16u8, @truncate(u16_v));
+            v_row[x..][0..16].* = @as(V16u8, @truncate(v16_v));
+        }
+
+        while (x < width) : (x += 1) {
+            const c0 = s_row[x * step + 0];
+            const c1 = s_row[x * step + 1];
+            const c2 = s_row[x * step + 2];
+            const r: i32 = if (is_bgr) c2 else c0;
+            const g: i32 = c1;
+            const b: i32 = if (is_bgr) c0 else c2;
+            y_row[x] = rgbToYScalar(r, g, b);
+            const u_14: i32 = (-4865 * r - 9528 * g + 14393 * b + 2097408) >> 9;
+            const v_14: i32 = (14393 * r - 12061 * g - 2332 * b + 2097408) >> 9;
+            u_row[x] = @intCast((u_14 + 32) >> 6);
+            v_row[x] = @intCast((v_14 + 32) >> 6);
+        }
+    }
+}
+
+pub inline fn computeRowYAndUV14(
+    s_row: [*]const u8,
+    y_row: [*]u8,
+    u14_row: [*]u16,
+    v14_row: [*]u16,
+    width: usize,
+    comptime src_fmt: c_int,
+) void {
+    const step = types.rgbStep(src_fmt);
+    const is_bgr = types.isBGROrder(src_fmt);
+    const shuf_even = [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) };
+    const shuf_odd = [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) };
+
+    var x: usize = 0;
+    while (x + 32 <= width) : (x += 32) {
+        const rgb_lo = if (step == 3)
+            loadRgb24x16(s_row + x * 3, is_bgr)
+        else blk: {
+            const rgba = loadRgba32x16(s_row + x * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+        const rgb_hi = if (step == 3)
+            loadRgb24x16(s_row + (x + 16) * 3, is_bgr)
+        else blk: {
+            const rgba = loadRgba32x16(s_row + (x + 16) * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+
+        y_row[x..][0..16].* = rgbToYVec16(rgb_lo.r, rgb_lo.g, rgb_lo.b);
+        y_row[x + 16 ..][0..16].* = rgbToYVec16(rgb_hi.r, rgb_hi.g, rgb_hi.b);
+
+        const r_even: V16u16 = @shuffle(u8, rgb_lo.r, rgb_hi.r, shuf_even);
+        const r_odd: V16u16 = @shuffle(u8, rgb_lo.r, rgb_hi.r, shuf_odd);
+        const rc: V16u16 = r_even + r_odd;
+
+        const g_even: V16u16 = @shuffle(u8, rgb_lo.g, rgb_hi.g, shuf_even);
+        const g_odd: V16u16 = @shuffle(u8, rgb_lo.g, rgb_hi.g, shuf_odd);
+        const gc: V16u16 = g_even + g_odd;
+
+        const b_even: V16u16 = @shuffle(u8, rgb_lo.b, rgb_hi.b, shuf_even);
+        const b_odd: V16u16 = @shuffle(u8, rgb_lo.b, rgb_hi.b, shuf_odd);
+        const bc: V16u16 = b_even + b_odd;
+
+        const cx = x >> 1;
+        u14_row[cx..][0..16].* = (mulhuwU9Sh7(bc, 28786) + @as(V16u16, @splat(32770)) - mulhuwU9Sh7(rc, 9730) - mulhuwU9Sh7(gc, 19056)) >> @splat(2);
+        v14_row[cx..][0..16].* = (mulhuwU9Sh7(rc, 28786) + @as(V16u16, @splat(32770)) - mulhuwU9Sh7(gc, 24122) - mulhuwU9Sh7(bc, 4664)) >> @splat(2);
+    }
+
+    while (x < width) : (x += 2) {
+        const c0_0 = s_row[x * step + 0];
+        const c0_1 = s_row[x * step + 1];
+        const c0_2 = s_row[x * step + 2];
+        const r0: i32 = if (is_bgr) c0_2 else c0_0;
+        const g0: i32 = c0_1;
+        const b0: i32 = if (is_bgr) c0_0 else c0_2;
+        y_row[x] = rgbToYScalar(r0, g0, b0);
+
+        var r1: i32 = r0;
+        var g1: i32 = g0;
+        var b1: i32 = b0;
+        if (x + 1 < width) {
+            const c1_0 = s_row[(x + 1) * step + 0];
+            const c1_1 = s_row[(x + 1) * step + 1];
+            const c1_2 = s_row[(x + 1) * step + 2];
+            r1 = if (is_bgr) c1_2 else c1_0;
+            g1 = c1_1;
+            b1 = if (is_bgr) c1_0 else c1_2;
+            y_row[x + 1] = rgbToYScalar(r1, g1, b1);
+        }
+
+        const rc = r0 + r1;
+        const gc = g0 + g1;
+        const bc = b0 + b1;
+        const cx = x >> 1;
+        u14_row[cx] = @intCast((-4865 * rc - 9528 * gc + 14393 * bc + 8389120) >> 10);
+        v14_row[cx] = @intCast((14393 * rc - 12061 * gc - 2332 * bc + 8389120) >> 10);
+    }
+}
+
+pub fn rgbToYuv422p(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst_y: [*]u8,
+    dst_y_stride: c_int,
+    dst_u: [*]u8,
+    dst_u_stride: c_int,
+    dst_v: [*]u8,
+    dst_v_stride: c_int,
+    width: usize,
+    height: usize,
+    u14_buf: []u16,
+    v14_buf: []u16,
+    comptime src_fmt: c_int,
+) void {
+    const chr_w = (width + 1) >> 1;
+    for (0..height) |y| {
+        const s_row = getRowPtrConst(src, src_stride, y);
+        const y_row = getRowPtrMut(dst_y, dst_y_stride, y);
+        const u_row = getRowPtrMut(dst_u, dst_u_stride, y);
+        const v_row = getRowPtrMut(dst_v, dst_v_stride, y);
+
+        computeRowYAndUV14(s_row, y_row, u14_buf.ptr, v14_buf.ptr, width, src_fmt);
+
+        var cx: usize = 0;
+        while (cx + 16 <= chr_w) : (cx += 16) {
+            const u_14: V16u16 = u14_buf[cx..][0..16].*;
+            const v_14: V16u16 = v14_buf[cx..][0..16].*;
+            u_row[cx..][0..16].* = @as(V16u8, @truncate((u_14 + @as(V16u16, @splat(32))) >> @splat(6)));
+            v_row[cx..][0..16].* = @as(V16u8, @truncate((v_14 + @as(V16u16, @splat(32))) >> @splat(6)));
+        }
+        while (cx < chr_w) : (cx += 1) {
+            u_row[cx] = @intCast((u14_buf[cx] + 32) >> 6);
+            v_row[cx] = @intCast((v14_buf[cx] + 32) >> 6);
+        }
+    }
+}
+
+pub fn rgbToYuv420OrNv(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    width: usize,
+    height: usize,
+    u14_ring: []u16, // 4 * chr_w_aligned
+    v14_ring: []u16, // 4 * chr_w_aligned
+    chr_stride: usize,
+    comptime src_fmt: c_int,
+    comptime dst_fmt: c_int,
+) void {
+    const dst_y = dst_data[0].?;
+    const dst_y_stride = dst_stride[0];
+    const chr_w = (width + 1) >> 1;
+    const chr_h = height >> 1;
+
+    const shuf_lo = [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) };
+    const shuf_hi = [16]i32{ 8, ~@as(i32, 8), 9, ~@as(i32, 9), 10, ~@as(i32, 10), 11, ~@as(i32, 11), 12, ~@as(i32, 12), 13, ~@as(i32, 13), 14, ~@as(i32, 14), 15, ~@as(i32, 15) };
+
+    var next_src_y: usize = 0;
+    for (0..chr_h) |cy| {
+        const max_needed = @min(2 * cy + 2, height - 1);
+        while (next_src_y <= max_needed) : (next_src_y += 1) {
+            const slot = next_src_y & 3;
+            computeRowYAndUV14(
+                getRowPtrConst(src, src_stride, next_src_y),
+                getRowPtrMut(dst_y, dst_y_stride, next_src_y),
+                u14_ring[slot * chr_stride ..].ptr,
+                v14_ring[slot * chr_stride ..].ptr,
+                width,
+                src_fmt,
+            );
+        }
+
+        const idx0: usize = if (cy == 0) 0 else (2 * cy - 1) & 3;
+        const idx1: usize = (2 * cy) & 3;
+        const idx2: usize = (2 * cy + 1) & 3;
+        const idx3: usize = (@min(2 * cy + 2, height - 1)) & 3;
+
+        const u_0 = u14_ring[idx0 * chr_stride ..];
+        const u_1 = u14_ring[idx1 * chr_stride ..];
+        const u_2 = u14_ring[idx2 * chr_stride ..];
+        const u_3 = u14_ring[idx3 * chr_stride ..];
+
+        const v_0 = v14_ring[idx0 * chr_stride ..];
+        const v_1 = v14_ring[idx1 * chr_stride ..];
+        const v_2 = v14_ring[idx2 * chr_stride ..];
+        const v_3 = v14_ring[idx3 * chr_stride ..];
+
+        if (dst_fmt == types.PIXFMT_YUV420P) {
+            const u_out = getRowPtrMut(dst_data[1].?, dst_stride[1], cy);
+            const v_out = getRowPtrMut(dst_data[2].?, dst_stride[2], cy);
+            var cx: usize = 0;
+            while (cx + 16 <= chr_w) : (cx += 16) {
+                const ua: V16u16 = @as(V16u16, u_0[cx..][0..16].*) + @as(V16u16, u_3[cx..][0..16].*);
+                const ub: V16u16 = @as(V16u16, u_1[cx..][0..16].*) + @as(V16u16, u_2[cx..][0..16].*);
+                const u_res: V16u8 = @truncate(((ua >> @splat(1)) + ub + (ub >> @splat(1)) + @as(V16u16, @splat(128))) >> @splat(8));
+
+                const va: V16u16 = @as(V16u16, v_0[cx..][0..16].*) + @as(V16u16, v_3[cx..][0..16].*);
+                const vb: V16u16 = @as(V16u16, v_1[cx..][0..16].*) + @as(V16u16, v_2[cx..][0..16].*);
+                const v_res: V16u8 = @truncate(((va >> @splat(1)) + vb + (vb >> @splat(1)) + @as(V16u16, @splat(128))) >> @splat(8));
+
+                u_out[cx..][0..16].* = u_res;
+                v_out[cx..][0..16].* = v_res;
+            }
+            while (cx < chr_w) : (cx += 1) {
+                const ua: u32 = @as(u32, u_0[cx]) + @as(u32, u_3[cx]);
+                const ub: u32 = @as(u32, u_1[cx]) + @as(u32, u_2[cx]);
+                u_out[cx] = @intCast(((ua >> 1) + ub + (ub >> 1) + 128) >> 8);
+
+                const va: u32 = @as(u32, v_0[cx]) + @as(u32, v_3[cx]);
+                const vb: u32 = @as(u32, v_1[cx]) + @as(u32, v_2[cx]);
+                v_out[cx] = @intCast(((va >> 1) + vb + (vb >> 1) + 128) >> 8);
+            }
+        } else {
+            const is_nv21 = (dst_fmt == types.PIXFMT_NV21);
+            const uv_out = getRowPtrMut(dst_data[1].?, dst_stride[1], cy);
+            var cx: usize = 0;
+            while (cx + 16 <= chr_w) : (cx += 16) {
+                const ua: V16u16 = @as(V16u16, u_0[cx..][0..16].*) + @as(V16u16, u_3[cx..][0..16].*);
+                const ub: V16u16 = @as(V16u16, u_1[cx..][0..16].*) + @as(V16u16, u_2[cx..][0..16].*);
+                const u_res: V16u8 = @truncate(((ua >> @splat(1)) + ub + (ub >> @splat(1)) + @as(V16u16, @splat(128))) >> @splat(8));
+
+                const va: V16u16 = @as(V16u16, v_0[cx..][0..16].*) + @as(V16u16, v_3[cx..][0..16].*);
+                const vb: V16u16 = @as(V16u16, v_1[cx..][0..16].*) + @as(V16u16, v_2[cx..][0..16].*);
+                const v_res: V16u8 = @truncate(((va >> @splat(1)) + vb + (vb >> @splat(1)) + @as(V16u16, @splat(128))) >> @splat(8));
+
+                const first = if (is_nv21) v_res else u_res;
+                const second = if (is_nv21) u_res else v_res;
+                uv_out[cx * 2 ..][0..16].* = @shuffle(u8, first, second, shuf_lo);
+                uv_out[cx * 2 + 16 ..][0..16].* = @shuffle(u8, first, second, shuf_hi);
+            }
+            while (cx < chr_w) : (cx += 1) {
+                const ua: u32 = @as(u32, u_0[cx]) + @as(u32, u_3[cx]);
+                const ub: u32 = @as(u32, u_1[cx]) + @as(u32, u_2[cx]);
+                const u_b: u8 = @intCast(((ua >> 1) + ub + (ub >> 1) + 128) >> 8);
+
+                const va: u32 = @as(u32, v_0[cx]) + @as(u32, v_3[cx]);
+                const vb: u32 = @as(u32, v_1[cx]) + @as(u32, v_2[cx]);
+                const v_b: u8 = @intCast(((va >> 1) + vb + (vb >> 1) + 128) >> 8);
+
+                uv_out[cx * 2 + 0] = if (is_nv21) v_b else u_b;
+                uv_out[cx * 2 + 1] = if (is_nv21) u_b else v_b;
+            }
+        }
+    }
+}
