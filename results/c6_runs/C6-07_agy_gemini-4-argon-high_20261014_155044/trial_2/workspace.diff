+// ── Fast Pure-16-bit SIMD YUV -> RGB Helpers ────────────────────────────────
+
+pub inline fn evalYuvTableChannelVec(y16: V16i16, off16: V16i16) V16u8 {
+    const idx = y16 + off16;
+    const clamped: V16u16 = @intCast(@max(@min(idx, @as(V16i16, @splat(237))), @as(V16i16, @splat(17))) - @as(V16i16, @splat(17)));
+    const hi: V16u16 = (mulhuwU8Sh8(clamped, 10773) + @as(V16u16, @splat(226))) >> @splat(8);
+    const res_i16: V16i16 = @as(V16i16, @intCast(clamped)) - @as(V16i16, @splat(1)) + @as(V16i16, @intCast(hi));
+    return clipI16ToU8Vec(res_i16);
+}
+
+pub inline fn evalYuvTableChannelScalar(y_val: i32, off_val: i32) u8 {
+    const idx = y_val + off_val;
+    const zc: u16 = @intCast(@max(@min(idx, 237), 17) - 17);
+    const hi: i32 = @intCast((mulhuwScalar(zc << 8, 10773) + 226) >> 8);
+    const res: i32 = @as(i32, zc) - 1 + hi;
+    return clipU8(res);
+}
+
+pub inline fn computeChromaOffsetsScalar(u_val: u8, v_val: u8) struct { r: i32, g: i32, b: i32 } {
+    const u16_val: u16 = u_val;
+    const v16_val: u16 = v_val;
+    const off_r: i32 = @as(i32, v16_val) + @as(i32, mulhuwScalar(v16_val << 8, 24294) >> 8) - 175;
+    const off_b: i32 = @as(i32, u16_val) + @as(i32, mulhuwScalar(u16_val << 8, 48001) >> 8) - 221;
+    const off_g: i32 = @as(i32, (mulhuwScalar(u16_val << 8, 43487) >> 8) + (mulhuwScalar(v16_val << 8, 19780) >> 8)) - @as(i32, u16_val + v16_val) + 134;
+    return .{ .r = off_r, .g = off_g, .b = off_b };
+}
+
+pub inline fn computeChromaOffsetsVec16(u16_vec: V16u16, v16_vec: V16u16) struct { r: V16i16, g: V16i16, b: V16i16 } {
+    const off_r: V16i16 = @as(V16i16, @intCast(v16_vec + (mulhuwU8Sh8(v16_vec, 24294) >> @splat(8)))) - @as(V16i16, @splat(175));
+    const off_b: V16i16 = @as(V16i16, @intCast(u16_vec + ((u16_vec * @as(V16u16, @splat(187)) + (u16_vec >> @splat(1))) >> @splat(8)))) - @as(V16i16, @splat(221));
+    const gu: V16u16 = mulhuwU8Sh8(u16_vec, 43487) >> @splat(8);
+    const gv: V16u16 = mulhuwU8Sh8(v16_vec, 19780) >> @splat(8);
+    const off_g: V16i16 = @as(V16i16, @intCast(gu + gv)) - @as(V16i16, @intCast(u16_vec + v16_vec)) + @as(V16i16, @splat(134));
+    return .{ .r = off_r, .g = off_g, .b = off_b };
+}
+
+pub inline fn computeChromaOffsets6Vec16(u16_vec: V16u16, v16_vec: V16u16) struct { r: V16i16, g: V16i16, b: V16i16 } {
+    const offs = computeChromaOffsetsVec16(u16_vec, v16_vec);
+    const c74: V16i16 = @splat(74);
+    const bias: V16i16 = @splat(1272);
+    return .{
+        .r = offs.r * c74 + (offs.r >> @splat(1)) - bias,
+        .g = offs.g * c74 + (offs.g >> @splat(1)) - bias,
+        .b = offs.b * c74 + (offs.b >> @splat(1)) - bias,
+    };
+}
+
+pub inline fn scaleLuma6Vec16(y16: V16i16) V16i16 {
+    return y16 * @as(V16i16, @splat(74)) + (y16 >> @splat(1));
+}
+
+pub inline fn evalYuv6ChannelVec(ys: V16i16, os: V16i16) V16u8 {
+    return clipI16ToU8Vec((ys +| os) >> @splat(6));
+}
