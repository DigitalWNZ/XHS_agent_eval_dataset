+// ── YUV444P -> Packed RGB (yuv2rgb_write_full) ──────────────────────────────
+
+pub fn yuv444pToRgb(
+    src_y: [*]const u8,
+    src_y_stride: c_int,
+    src_u: [*]const u8,
+    src_u_stride: c_int,
+    src_v: [*]const u8,
+    src_v_stride: c_int,
+    dst: [*]u8,
+    dst_stride: c_int,
+    width: usize,
+    height: usize,
+    comptime dst_fmt: c_int,
+) void {
+    const step = types.rgbStep(dst_fmt);
+    const max_30: @Vector(16, i32) = @splat((1 << 30) - 1);
+    const zero_32: @Vector(16, i32) = @splat(0);
+
+    for (0..height) |y| {
+        const y_row = getRowPtrConst(src_y, src_y_stride, y);
+        const u_row = getRowPtrConst(src_u, src_u_stride, y);
+        const v_row = getRowPtrConst(src_v, src_v_stride, y);
+        const d_row = getRowPtrMut(dst, dst_stride, y);
+
+        var x: usize = 0;
+        while (x + 16 <= width) : (x += 16) {
+            const y8: V16u8 = y_row[x..][0..16].*;
+            const u8_v: V16u8 = u_row[x..][0..16].*;
+            const v8_v: V16u8 = v_row[x..][0..16].*;
+
+            const y32: @Vector(16, i32) = @intCast(y8);
+            const u32_v: @Vector(16, i32) = @intCast(u8_v);
+            const v32_v: @Vector(16, i32) = @intCast(v8_v);
+
+            const y_val = ((y32 << @splat(9)) - @as(@Vector(16, i32), @splat(8192))) * @as(@Vector(16, i32), @splat(9539)) + @as(@Vector(16, i32), @splat(1 << 21));
+            const u_val = (u32_v - @as(@Vector(16, i32), @splat(128))) << @splat(9);
+            const v_val = (v32_v - @as(@Vector(16, i32), @splat(128))) << @splat(9);
+
+            const R30 = @max(@min(y_val + v_val * @as(@Vector(16, i32), @splat(13075)), max_30), zero_32);
+            const G30 = @max(@min(y_val + v_val * @as(@Vector(16, i32), @splat(-6660)) + u_val * @as(@Vector(16, i32), @splat(-3209)), max_30), zero_32);
+            const B30 = @max(@min(y_val + u_val * @as(@Vector(16, i32), @splat(16525)), max_30), zero_32);
+
+            const r8: V16u8 = @truncate(@as(V16u32, @intCast(R30 >> @splat(22))));
+            const g8: V16u8 = @truncate(@as(V16u32, @intCast(G30 >> @splat(22))));
+            const b8: V16u8 = @truncate(@as(V16u32, @intCast(B30 >> @splat(22))));
+
+            storeRgbx16(d_row + x * step, r8, g8, b8, dst_fmt);
+        }
+
+        while (x < width) : (x += 1) {
+            const y_val: i32 = ((@as(i32, y_row[x]) << 9) - 8192) * 9539 + (1 << 21);
+            const u_val: i32 = (@as(i32, u_row[x]) - 128) << 9;
+            const v_val: i32 = (@as(i32, v_row[x]) - 128) << 9;
+            const R30 = @max(@min(y_val + v_val * 13075, (1 << 30) - 1), 0);
+            const G30 = @max(@min(y_val + v_val * (-6660) + u_val * (-3209), (1 << 30) - 1), 0);
+            const B30 = @max(@min(y_val + u_val * 16525, (1 << 30) - 1), 0);
+            storeRgbScalar(d_row, x, @intCast(R30 >> 22), @intCast(G30 >> 22), @intCast(B30 >> 22), 255, dst_fmt);
+        }
+    }
