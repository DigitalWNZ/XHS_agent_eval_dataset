+pub fn yuv420pToNv(
+    src_y: [*]const u8,
+    src_y_stride: c_int,
+    src_u: [*]const u8,
+    src_u_stride: c_int,
+    src_v: [*]const u8,
+    src_v_stride: c_int,
+    dst_y: [*]u8,
+    dst_y_stride: c_int,
+    dst_uv: [*]u8,
+    dst_uv_stride: c_int,
+    width: usize,
+    height: usize,
+    comptime is_nv21: bool,
+) void {
+    copyPlane(src_y, src_y_stride, dst_y, dst_y_stride, width, height);
+    const chr_w = width >> 1;
+    const chr_h = height >> 1;
+
+    const shuf_lo = [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) };
+    const shuf_hi = [16]i32{ 8, ~@as(i32, 8), 9, ~@as(i32, 9), 10, ~@as(i32, 10), 11, ~@as(i32, 11), 12, ~@as(i32, 12), 13, ~@as(i32, 13), 14, ~@as(i32, 14), 15, ~@as(i32, 15) };
+
+    for (0..chr_h) |y| {
+        const u_row = getRowPtrConst(src_u, src_u_stride, y);
+        const v_row = getRowPtrConst(src_v, src_v_stride, y);
+        const uv_row = getRowPtrMut(dst_uv, dst_uv_stride, y);
+        var x: usize = 0;
+        while (x + 16 <= chr_w) : (x += 16) {
+            const u_vec: V16u8 = u_row[x..][0..16].*;
+            const v_vec: V16u8 = v_row[x..][0..16].*;
+            const first = if (is_nv21) v_vec else u_vec;
+            const second = if (is_nv21) u_vec else v_vec;
+            uv_row[x * 2 ..][0..16].* = @shuffle(u8, first, second, shuf_lo);
+            uv_row[x * 2 + 16 ..][0..16].* = @shuffle(u8, first, second, shuf_hi);
+        }
+        while (x < chr_w) : (x += 1) {
+            uv_row[x * 2 + 0] = if (is_nv21) v_row[x] else u_row[x];
+            uv_row[x * 2 + 1] = if (is_nv21) u_row[x] else v_row[x];
+        }
+    }
+}
