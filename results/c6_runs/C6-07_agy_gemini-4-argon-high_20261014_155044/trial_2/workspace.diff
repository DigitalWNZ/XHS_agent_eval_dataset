+    for (0..chr_h) |y| {
+        const uv_row = getRowPtrConst(src_uv, src_uv_stride, y);
+        const u_row = getRowPtrMut(dst_u, dst_u_stride, y);
+        const v_row = getRowPtrMut(dst_v, dst_v_stride, y);
+        var x: usize = 0;
+        while (x + 16 <= chr_w) : (x += 16) {
+            const lo: V16u8 = uv_row[x * 2 ..][0..16].*;
+            const hi: V16u8 = uv_row[x * 2 + 16 ..][0..16].*;
+            const first = @shuffle(u8, lo, hi, shuf_even);
+            const second = @shuffle(u8, lo, hi, shuf_odd);
+            u_row[x..][0..16].* = if (is_nv21) second else first;
+            v_row[x..][0..16].* = if (is_nv21) first else second;
+        }
+        while (x < chr_w) : (x += 1) {
+            const c0 = uv_row[x * 2 + 0];
+            const c1 = uv_row[x * 2 + 1];
