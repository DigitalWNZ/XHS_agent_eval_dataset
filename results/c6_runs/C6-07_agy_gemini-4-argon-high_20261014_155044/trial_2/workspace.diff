+        types.PIXFMT_RGBA => scaleYuvToRgbImpl(src_data, src_stride, dst_data[0].?, dst_stride[0], src_w, src_h, dst_w, dst_h, src_fmt, cdims, h_lum_flt, v_lum_flt, h_chr_flt, v_chr_flt, u_deint, v_deint, lum_ring, chr_u_ring, chr_v_ring, lum_ring_stride, lum_ring_slots, chr_ring_stride, chr_ring_slots, types.PIXFMT_RGBA),
