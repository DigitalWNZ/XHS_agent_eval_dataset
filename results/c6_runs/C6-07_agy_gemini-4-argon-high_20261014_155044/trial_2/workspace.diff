+                        y_hi32 += @as(V8i32, lum_ptrs[j][x_off + 8 ..][0..8].*) * w_vec;
+                    }
+                    const y_lo16: @Vector(8, i16) = @truncate(y_lo32 >> @splat(19));
+                    const y_hi16: @Vector(8, i16) = @truncate(y_hi32 >> @splat(19));
+                    const y16_vec: V16i16 = @shuffle(i16, y_lo16, y_hi16, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
