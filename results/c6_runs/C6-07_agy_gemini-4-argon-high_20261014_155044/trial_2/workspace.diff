+pub fn rgbToGray(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst: [*]u8,
+    dst_stride: c_int,
+    width: usize,
+    height: usize,
+    comptime src_fmt: c_int,
+) void {
+    const step = types.rgbStep(src_fmt);
+    const is_bgr = types.isBGROrder(src_fmt);
+    for (0..height) |y| {
+        const s_row = getRowPtrConst(src, src_stride, y);
+        const d_row = getRowPtrMut(dst, dst_stride, y);
+        var x: usize = 0;
+        while (x + 16 <= width) : (x += 16) {
+            const rgb = if (step == 3)
+                loadRgb24x16(s_row + x * 3, is_bgr)
+            else blk: {
+                const rgba = loadRgba32x16(s_row + x * 4, is_bgr);
+                break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+            };
+            const r16: V16u16 = rgb.r;
+            const g16: V16u16 = rgb.g;
+            const b16: V16u16 = rgb.b;
+            const sum16: V16u16 = mulhuwU8Sh8(r16, 16828) + mulhuwU8Sh8(g16, 33038) + mulhuwU8Sh8(b16, 6416) + @as(V16u16, @splat(4098));
+            const y15_16: V16u16 = @min((sum16 >> @splat(2)) << @splat(1), @as(V16u16, @splat(30189)));
+            const y15: V16u32 = y15_16;
+            const prod: V16u32 = y15 * @as(V16u32, @splat(19077));
+            const num: @Vector(16, i32) = @as(@Vector(16, i32), @bitCast(prod)) - @as(@Vector(16, i32), @splat(39057361));
+            const scaled: @Vector(16, i32) = num >> @splat(14);
+            const out_i32: @Vector(16, i32) = (scaled + @as(@Vector(16, i32), @splat(64))) >> @splat(7);
+            const clamped: V16u32 = @intCast(@max(@min(out_i32, @as(@Vector(16, i32), @splat(255))), @as(@Vector(16, i32), @splat(0))));
+            d_row[x..][0..16].* = @as(V16u8, @truncate(clamped));
+        }
+        while (x < width) : (x += 1) {
+            const c0 = s_row[x * step + 0];
+            const c1 = s_row[x * step + 1];
+            const c2 = s_row[x * step + 2];
+            const r: i32 = if (is_bgr) c2 else c0;
+            const g: i32 = c1;
+            const b: i32 = if (is_bgr) c0 else c2;
+            const y14: i32 = (8414 * r + 16519 * g + 3208 * b + 524544) >> 9;
+            const y15: i32 = @min(y14 << 1, 30189);
+            const scaled: i32 = (y15 * 19077 - 39057361) >> 14;
+            d_row[x] = clipU8((scaled + 64) >> 7);
+        }
+    }
+}
