+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
+            var acc: V8i32 = @splat(0);
+            const wt_base = weights_t[i * fsize ..];
+            var j: usize = 0;
+            while (j + 2 <= fsize) : (j += 2) {
+                var s_u32: V8u32 = undefined;
+                inline for (0..8) |k| {
+                    const p: usize = @as(usize, @intCast(pos[i + k])) + j;
+                    s_u32[k] = @bitCast(src[p..][0..2].*);
+                }
+                const s0: V8i32 = @bitCast(s_u32 & mask16);
+                const s1: V8i32 = @bitCast(s_u32 >> @splat(16));
