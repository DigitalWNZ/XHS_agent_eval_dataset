+            const slot = next_chr_sy % chr_ring_slots;
+            const u_slot = chr_u_ring[slot * chr_ring_stride ..].ptr;
+            const v_slot = chr_v_ring[slot * chr_ring_stride ..].ptr;
+            if (types.isPlanarYUV(src_fmt)) {
