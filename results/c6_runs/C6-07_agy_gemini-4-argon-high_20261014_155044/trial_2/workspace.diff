+            const p: usize = @intCast(pos[i]);
+            const val: i32 = (@as(i32, src[p]) * @as(i32, weights[i])) >> 13;
+            dst[i] = @intCast(@min(val, 32767));
+        }
+    } else if (fsize == 2) {
+        const mask16: V8u32 = @splat(0xFFFF);
+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
