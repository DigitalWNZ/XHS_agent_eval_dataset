+pub fn hScale8To15(src: [*]const u8, dst: [*]i16, flt: *const Filter) void {
+    const dst_len = flt.dst_len;
+    const fsize = flt.size;
+    const pos = flt.pos;
+    const weights = flt.weights;
+    const weights_t = flt.weights_t;
+
+    if (fsize == 1) {
+        var i: usize = 0;
+        while (i + 16 <= dst_len) : (i += 16) {
+            var s_vec: V16i32 = undefined;
+            inline for (0..16) |k| {
+                s_vec[k] = src[@intCast(pos[i + k])];
+            }
+            const w_vec: V16i32 = @as(V16i16, weights[i..][0..16].*);
+            const res: V16i32 = @min((s_vec * w_vec) >> @splat(7), @as(V16i32, @splat(32767)));
+            dst[i..][0..16].* = @as(V16i16, @truncate(res));
+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const val: i32 = (@as(i32, src[p]) * @as(i32, weights[i])) >> 7;
+            dst[i] = @intCast(@min(val, 32767));
+        }
+    } else if (fsize == 2) {
+        const mask8: V8u16 = @splat(0xFF);
+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
+            var s_u16: V8u16 = undefined;
+            inline for (0..8) |k| {
+                const p: usize = @intCast(pos[i + k]);
+                s_u16[k] = @bitCast(src[p..][0..2].*);
+            }
+            const s0: V8i32 = @intCast(s_u16 & mask8);
+            const s1: V8i32 = @intCast(s_u16 >> @splat(8));
+            const w0: V8i32 = weights_t[i * 2 + 0 ..][0..8].*;
+            const w1: V8i32 = weights_t[i * 2 + 8 ..][0..8].*;
+            const res: V8i32 = @min((s0 * w0 + s1 * w1) >> @splat(7), @as(V8i32, @splat(32767)));
+            dst[i..][0..8].* = @as(V8i16, @truncate(res));
+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const w = weights[i * 2 ..];
+            const val: i32 = (@as(i32, src[p]) * @as(i32, w[0]) + @as(i32, src[p + 1]) * @as(i32, w[1])) >> 7;
+            dst[i] = @intCast(@min(val, 32767));
+        }
+    } else if (fsize == 4) {
+        const mask8: V8u32 = @splat(0xFF);
+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
+            var s_u32: V8u32 = undefined;
+            inline for (0..8) |k| {
+                const p: usize = @intCast(pos[i + k]);
+                s_u32[k] = @bitCast(src[p..][0..4].*);
+            }
+            const s0: V8i32 = @bitCast(s_u32 & mask8);
+            const s1: V8i32 = @bitCast((s_u32 >> @splat(8)) & mask8);
+            const s2: V8i32 = @bitCast((s_u32 >> @splat(16)) & mask8);
+            const s3: V8i32 = @bitCast(s_u32 >> @splat(24));
+
+            const wt = weights_t[i * 4 ..];
+            const w0: V8i32 = wt[0..8].*;
+            const w1: V8i32 = wt[8..16].*;
+            const w2: V8i32 = wt[16..24].*;
+            const w3: V8i32 = wt[24..32].*;
+            const res: V8i32 = @min((s0 * w0 + s1 * w1 + s2 * w2 + s3 * w3) >> @splat(7), @as(V8i32, @splat(32767)));
+            dst[i..][0..8].* = @as(V8i16, @truncate(res));
+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const w = weights[i * 4 ..];
+            const val: i32 = (@as(i32, src[p + 0]) * @as(i32, w[0]) +
+                @as(i32, src[p + 1]) * @as(i32, w[1]) +
+                @as(i32, src[p + 2]) * @as(i32, w[2]) +
+                @as(i32, src[p + 3]) * @as(i32, w[3])) >> 7;
+            dst[i] = @intCast(@min(val, 32767));
+        }
+    } else {
+        const mask32: V8u32 = @splat(0xFF);
+        const mask16: V8u16 = @splat(0xFF);
+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
+            var acc: V8i32 = @splat(0);
+            const wt_base = weights_t[i * fsize ..];
+            var j: usize = 0;
+            while (j + 4 <= fsize) : (j += 4) {
+                var s_u32: V8u32 = undefined;
+                inline for (0..8) |k| {
+                    const p: usize = @as(usize, @intCast(pos[i + k])) + j;
+                    s_u32[k] = @bitCast(src[p..][0..4].*);
+                }
+                const s0: V8i32 = @bitCast(s_u32 & mask32);
+                const s1: V8i32 = @bitCast((s_u32 >> @splat(8)) & mask32);
+                const s2: V8i32 = @bitCast((s_u32 >> @splat(16)) & mask32);
+                const s3: V8i32 = @bitCast(s_u32 >> @splat(24));
+                const wt = wt_base[j * 8 ..];
+                acc += s0 * @as(V8i32, wt[0..8].*) +
+                    s1 * @as(V8i32, wt[8..16].*) +
+                    s2 * @as(V8i32, wt[16..24].*) +
+                    s3 * @as(V8i32, wt[24..32].*);
+            }
+            while (j + 2 <= fsize) : (j += 2) {
+                var s_u16: V8u16 = undefined;
+                inline for (0..8) |k| {
+                    const p: usize = @as(usize, @intCast(pos[i + k])) + j;
+                    s_u16[k] = @bitCast(src[p..][0..2].*);
+                }
+                const s0: V8i32 = @intCast(s_u16 & mask16);
+                const s1: V8i32 = @intCast(s_u16 >> @splat(8));
+                const wt = wt_base[j * 8 ..];
+                acc += s0 * @as(V8i32, wt[0..8].*) + s1 * @as(V8i32, wt[8..16].*);
+            }
+            while (j < fsize) : (j += 1) {
+                var s0: V8i32 = undefined;
+                inline for (0..8) |k| {
+                    s0[k] = src[@as(usize, @intCast(pos[i + k])) + j];
+                }
+                acc += s0 * @as(V8i32, wt_base[j * 8 ..][0..8].*);
+            }
+            const res: V8i32 = @min(acc >> @splat(7), @as(V8i32, @splat(32767)));
+            dst[i..][0..8].* = @as(V8i16, @truncate(res));
+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const w = weights[i * fsize ..];
+            var val: i32 = 0;
+            var j: usize = 0;
+            while (j + 4 <= fsize) : (j += 4) {
+                val += @as(i32, src[p + j + 0]) * @as(i32, w[j + 0]) +
+                    @as(i32, src[p + j + 1]) * @as(i32, w[j + 1]) +
+                    @as(i32, src[p + j + 2]) * @as(i32, w[j + 2]) +
+                    @as(i32, src[p + j + 3]) * @as(i32, w[j + 3]);
+            }
+            while (j < fsize) : (j += 1) {
+                val += @as(i32, src[p + j]) * @as(i32, w[j]);
+            }
+            dst[i] = @intCast(@min(val >> 7, 32767));
+        }
+    }
