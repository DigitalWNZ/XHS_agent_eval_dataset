+// ── Vertical Scaling Kernels ────────────────────────────────────────────────
+
+pub inline fn vScale15To8Vec16(rows: []const [*]const i16, weights: []const i16, x: usize) V16u8 {
+    const fsize = weights.len;
+    if (fsize == 1 and weights[0] == 4096) {
+        const r0: V16i16 = rows[0][x..][0..16].*;
+        const out16: V16i16 = (r0 + @as(V16i16, @splat(64))) >> @splat(7);
+        return types.clipI16ToU8Vec(out16);
+    }
+    var acc_lo: V8i32 = @splat(1 << 18);
+    var acc_hi: V8i32 = @splat(1 << 18);
+    for (0..fsize) |j| {
+        const w_vec: V8i32 = @splat(@as(i32, weights[j]));
+        const r_lo: V8i32 = rows[j][x..][0..8].*;
+        const r_hi: V8i32 = rows[j][x + 8 ..][0..8].*;
+        acc_lo += r_lo * w_vec;
+        acc_hi += r_hi * w_vec;
+    }
+    const s_lo: V8i32 = @max(@min(acc_lo >> @splat(19), @as(V8i32, @splat(255))), @as(V8i32, @splat(0)));
+    const s_hi: V8i32 = @max(@min(acc_hi >> @splat(19), @as(V8i32, @splat(255))), @as(V8i32, @splat(0)));
+    const u8_lo: @Vector(8, u8) = @truncate(@as(@Vector(8, u32), @intCast(s_lo)));
+    const u8_hi: @Vector(8, u8) = @truncate(@as(@Vector(8, u32), @intCast(s_hi)));
+    return @shuffle(u8, u8_lo, u8_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+}
+
+pub fn vScale15To8Row(rows: []const [*]const i16, weights: []const i16, dst: [*]u8, width: usize) void {
+    const fsize = weights.len;
+    var x: usize = 0;
+    while (x + 16 <= width) : (x += 16) {
+        dst[x..][0..16].* = vScale15To8Vec16(rows, weights, x);
+    }
+    while (x < width) : (x += 1) {
+        var acc: i32 = 1 << 18;
+        for (0..fsize) |j| {
+            acc += @as(i32, rows[j][x]) * @as(i32, weights[j]);
+        }
+        dst[x] = clipU8(acc >> 19);
+    }
+}
+
+pub fn vScale15ToNvRow(
+    u_rows: []const [*]const i16,
+    v_rows: []const [*]const i16,
+    weights: []const i16,
+    dst_uv: [*]u8,
+    chr_w: usize,
+    comptime is_nv21: bool,
+) void {
+    const fsize = weights.len;
+    const shuf_lo = [16]i32{ 0, ~@as(i32, 0), 1, ~@as(i32, 1), 2, ~@as(i32, 2), 3, ~@as(i32, 3), 4, ~@as(i32, 4), 5, ~@as(i32, 5), 6, ~@as(i32, 6), 7, ~@as(i32, 7) };
+    const shuf_hi = [16]i32{ 8, ~@as(i32, 8), 9, ~@as(i32, 9), 10, ~@as(i32, 10), 11, ~@as(i32, 11), 12, ~@as(i32, 12), 13, ~@as(i32, 13), 14, ~@as(i32, 14), 15, ~@as(i32, 15) };
+
+    var x: usize = 0;
+    while (x + 16 <= chr_w) : (x += 16) {
+        const u8_vec = vScale15To8Vec16(u_rows, weights, x);
+        const v8_vec = vScale15To8Vec16(v_rows, weights, x);
+        const first = if (is_nv21) v8_vec else u8_vec;
+        const second = if (is_nv21) u8_vec else v8_vec;
+        dst_uv[x * 2 ..][0..16].* = @shuffle(u8, first, second, shuf_lo);
+        dst_uv[x * 2 + 16 ..][0..16].* = @shuffle(u8, first, second, shuf_hi);
+    }
+    while (x < chr_w) : (x += 1) {
+        var u_acc: i32 = 1 << 18;
+        var v_acc: i32 = 1 << 18;
+        for (0..fsize) |j| {
+            u_acc += @as(i32, u_rows[j][x]) * @as(i32, weights[j]);
+            v_acc += @as(i32, v_rows[j][x]) * @as(i32, weights[j]);
+        }
+        const u_b = clipU8(u_acc >> 19);
+        const v_b = clipU8(v_acc >> 19);
+        dst_uv[x * 2 + 0] = if (is_nv21) v_b else u_b;
+        dst_uv[x * 2 + 1] = if (is_nv21) u_b else v_b;
+    }
+}
+
+// ── Fast Path 1: Direct Packed RGB -> Packed RGB Scaling (chrSrcH == 0) ─────
+
+fn hScaleRgb3Row(
+    r_src: [*]const u8,
+    g_src: [*]const u8,
+    b_src: [*]const u8,
+    r_dst: [*]i16,
+    g_dst: [*]i16,
+    b_dst: [*]i16,
+    flt: *const Filter,
+) void {
+    const dst_len = flt.dst_len;
+    const fsize = flt.size;
+    const pos = flt.pos;
+    const weights = flt.weights;
+    const weights_t = flt.weights_t;
+
+    if (fsize == 2) {
+        const mask8: V8u16 = @splat(0xFF);
+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
+            var r_u16: V8u16 = undefined;
+            var g_u16: V8u16 = undefined;
+            var b_u16: V8u16 = undefined;
+            inline for (0..8) |k| {
+                const p: usize = @intCast(pos[i + k]);
+                r_u16[k] = @bitCast(r_src[p..][0..2].*);
+                g_u16[k] = @bitCast(g_src[p..][0..2].*);
+                b_u16[k] = @bitCast(b_src[p..][0..2].*);
+            }
+            const r0: V8i32 = @intCast(r_u16 & mask8);
+            const r1: V8i32 = @intCast(r_u16 >> @splat(8));
+            const g0: V8i32 = @intCast(g_u16 & mask8);
+            const g1: V8i32 = @intCast(g_u16 >> @splat(8));
+            const b0: V8i32 = @intCast(b_u16 & mask8);
+            const b1: V8i32 = @intCast(b_u16 >> @splat(8));
+
+            const w0: V8i32 = weights_t[i * 2 + 0 ..][0..8].*;
+            const w1: V8i32 = weights_t[i * 2 + 8 ..][0..8].*;
+            r_dst[i..][0..8].* = @as(V8i16, @truncate((r0 * w0 + r1 * w1) >> @splat(7)));
+            g_dst[i..][0..8].* = @as(V8i16, @truncate((g0 * w0 + g1 * w1) >> @splat(7)));
+            b_dst[i..][0..8].* = @as(V8i16, @truncate((b0 * w0 + b1 * w1) >> @splat(7)));
+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const w0: i32 = weights[i * 2 + 0];
+            const w1: i32 = weights[i * 2 + 1];
+            r_dst[i] = @intCast((@as(i32, r_src[p]) * w0 + @as(i32, r_src[p + 1]) * w1) >> 7);
+            g_dst[i] = @intCast((@as(i32, g_src[p]) * w0 + @as(i32, g_src[p + 1]) * w1) >> 7);
+            b_dst[i] = @intCast((@as(i32, b_src[p]) * w0 + @as(i32, b_src[p + 1]) * w1) >> 7);
+        }
+    } else if (fsize == 4) {
+        const mask8: V8u32 = @splat(0xFF);
+        const max15: V8i32 = @splat(32767);
+        var i: usize = 0;
+        while (i + 8 <= dst_len) : (i += 8) {
+            var r_u32: V8u32 = undefined;
+            var g_u32: V8u32 = undefined;
+            var b_u32: V8u32 = undefined;
+            inline for (0..8) |k| {
+                const p: usize = @intCast(pos[i + k]);
+                r_u32[k] = @bitCast(r_src[p..][0..4].*);
+                g_u32[k] = @bitCast(g_src[p..][0..4].*);
+                b_u32[k] = @bitCast(b_src[p..][0..4].*);
+            }
+            const r0: V8i32 = @bitCast(r_u32 & mask8);
+            const r1: V8i32 = @bitCast((r_u32 >> @splat(8)) & mask8);
+            const r2: V8i32 = @bitCast((r_u32 >> @splat(16)) & mask8);
+            const r3: V8i32 = @bitCast(r_u32 >> @splat(24));
+
+            const g0: V8i32 = @bitCast(g_u32 & mask8);
+            const g1: V8i32 = @bitCast((g_u32 >> @splat(8)) & mask8);
+            const g2: V8i32 = @bitCast((g_u32 >> @splat(16)) & mask8);
+            const g3: V8i32 = @bitCast(g_u32 >> @splat(24));
+
+            const b0: V8i32 = @bitCast(b_u32 & mask8);
+            const b1: V8i32 = @bitCast((b_u32 >> @splat(8)) & mask8);
+            const b2: V8i32 = @bitCast((b_u32 >> @splat(16)) & mask8);
+            const b3: V8i32 = @bitCast(b_u32 >> @splat(24));
+
+            const wt = weights_t[i * 4 ..];
+            const w0: V8i32 = wt[0..8].*;
+            const w1: V8i32 = wt[8..16].*;
+            const w2: V8i32 = wt[16..24].*;
+            const w3: V8i32 = wt[24..32].*;
+
+            r_dst[i..][0..8].* = @as(V8i16, @truncate(@min((r0 * w0 + r1 * w1 + r2 * w2 + r3 * w3) >> @splat(7), max15)));
+            g_dst[i..][0..8].* = @as(V8i16, @truncate(@min((g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3) >> @splat(7), max15)));
+            b_dst[i..][0..8].* = @as(V8i16, @truncate(@min((b0 * w0 + b1 * w1 + b2 * w2 + b3 * w3) >> @splat(7), max15)));
+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const w = weights[i * 4 ..];
+            const vr: i32 = (@as(i32, r_src[p + 0]) * @as(i32, w[0]) + @as(i32, r_src[p + 1]) * @as(i32, w[1]) + @as(i32, r_src[p + 2]) * @as(i32, w[2]) + @as(i32, r_src[p + 3]) * @as(i32, w[3])) >> 7;
+            const vg: i32 = (@as(i32, g_src[p + 0]) * @as(i32, w[0]) + @as(i32, g_src[p + 1]) * @as(i32, w[1]) + @as(i32, g_src[p + 2]) * @as(i32, w[2]) + @as(i32, g_src[p + 3]) * @as(i32, w[3])) >> 7;
+            const vb: i32 = (@as(i32, b_src[p + 0]) * @as(i32, w[0]) + @as(i32, b_src[p + 1]) * @as(i32, w[1]) + @as(i32, b_src[p + 2]) * @as(i32, w[2]) + @as(i32, b_src[p + 3]) * @as(i32, w[3])) >> 7;
+            r_dst[i] = @intCast(@min(vr, 32767));
+            g_dst[i] = @intCast(@min(vg, 32767));
+            b_dst[i] = @intCast(@min(vb, 32767));
+        }
+    } else {
+        hScale8To15(r_src, r_dst, flt);
+        hScale8To15(g_src, g_dst, flt);
+        hScale8To15(b_src, b_dst, flt);
+    }
+}
+
+fn unpackRgbRowImpl(
+    s_row: [*]const u8,
+    r_src: [*]u8,
+    g_src: [*]u8,
+    b_src: [*]u8,
+    a_src: [*]u8,
+    src_w: usize,
+    comptime src_fmt: c_int,
+    need_alpha: bool,
+) void {
+    const src_step = types.rgbStep(src_fmt);
+    const src_bgr = types.isBGROrder(src_fmt);
+    var x: usize = 0;
+    while (x + 16 <= src_w) : (x += 16) {
+        if (src_step == 3) {
+            const rgb = unscaled.loadRgb24x16(s_row + x * 3, src_bgr);
+            r_src[x..][0..16].* = rgb.r;
+            g_src[x..][0..16].* = rgb.g;
+            b_src[x..][0..16].* = rgb.b;
+        } else {
+            const rgba = unscaled.loadRgba32x16(s_row + x * 4, src_bgr);
+            r_src[x..][0..16].* = rgba.r;
+            g_src[x..][0..16].* = rgba.g;
+            b_src[x..][0..16].* = rgba.b;
+            if (need_alpha) a_src[x..][0..16].* = rgba.a;
+        }
+    }
+    while (x < src_w) : (x += 1) {
+        const c0 = s_row[x * src_step + 0];
+        const c1 = s_row[x * src_step + 1];
+        const c2 = s_row[x * src_step + 2];
+        r_src[x] = if (src_bgr) c2 else c0;
+        g_src[x] = c1;
+        b_src[x] = if (src_bgr) c0 else c2;
+        if (need_alpha) a_src[x] = s_row[x * 4 + 3];
+    }
+}
+
+pub fn scaleRgbDirect(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst: [*]u8,
+    dst_stride: c_int,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    h_flt: *const Filter,
+    v_flt: *const Filter,
+    scratch_u8: []u8, // 4 * src_w_aligned
+    ring_i16: []i16, // 4 * ring_slots * dst_w_aligned
+    ring_stride: usize,
+    ring_slots: usize,
+    src_fmt: c_int,
+    dst_fmt: c_int,
+) void {
+    const src_step = types.rgbStep(src_fmt);
+    const dst_step = types.rgbStep(dst_fmt);
+    const src_bgr = types.isBGROrder(src_fmt);
+    const need_alpha = (src_step == 4 and dst_step == 4);
+
+    // Fast path for NEAREST (h_flt.size == 1 and v_flt.size == 1)
+    if (h_flt.size == 1 and v_flt.size == 1 and h_flt.weights[0] == 16384 and v_flt.weights[0] == 4096) {
+        const h_pos = h_flt.pos;
+        const v_pos = v_flt.pos;
+        for (0..dst_h) |dy| {
+            const sy: usize = @intCast(v_pos[dy]);
+            const s_row = getRowPtrConst(src, src_stride, sy);
+            const d_row = getRowPtrMut(dst, dst_stride, dy);
+            if (src_fmt == dst_fmt and src_step == 4) {
+                const s32: [*]const u32 = @ptrCast(@alignCast(s_row));
+                const d32: [*]u32 = @ptrCast(@alignCast(d_row));
+                for (0..dst_w) |dx| {
+                    d32[dx] = s32[@intCast(h_pos[dx])];
+                }
+            } else if (src_fmt == dst_fmt and src_step == 3) {
+                for (0..dst_w) |dx| {
+                    const sx: usize = @intCast(h_pos[dx]);
+                    d_row[dx * 3 + 0] = s_row[sx * 3 + 0];
+                    d_row[dx * 3 + 1] = s_row[sx * 3 + 1];
+                    d_row[dx * 3 + 2] = s_row[sx * 3 + 2];
+                }
+            } else {
+                inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |d_c| {
+                    if (dst_fmt == d_c) {
+                        for (0..dst_w) |dx| {
+                            const sx: usize = @intCast(h_pos[dx]);
+                            const c0 = s_row[sx * src_step + 0];
+                            const c1 = s_row[sx * src_step + 1];
+                            const c2 = s_row[sx * src_step + 2];
+                            const a: u8 = if (src_step == 4) s_row[sx * 4 + 3] else 255;
+                            const r = if (src_bgr) c2 else c0;
+                            const g = c1;
+                            const b = if (src_bgr) c0 else c2;
+                            unscaled.storeRgbScalar(d_row, dx, r, g, b, a, d_c);
+                        }
+                    }
+                }
+            }
+        }
+        return;
+    }
+
+    const src_aligned = (src_w + 31) & ~@as(usize, 31);
+    const r_src = scratch_u8[0 * src_aligned ..].ptr;
+    const g_src = scratch_u8[1 * src_aligned ..].ptr;
+    const b_src = scratch_u8[2 * src_aligned ..].ptr;
+    const a_src = scratch_u8[3 * src_aligned ..].ptr;
+
+    const chan_ring_len = ring_slots * ring_stride;
+    const r_ring = ring_i16[0 * chan_ring_len ..];
+    const g_ring = ring_i16[1 * chan_ring_len ..];
+    const b_ring = ring_i16[2 * chan_ring_len ..];
+    const a_ring = ring_i16[3 * chan_ring_len ..];
+
+    const v_fsize = v_flt.size;
+    var r_ptrs: [32][*]const i16 = undefined;
+    var g_ptrs: [32][*]const i16 = undefined;
+    var b_ptrs: [32][*]const i16 = undefined;
+    var a_ptrs: [32][*]const i16 = undefined;
+
+    var next_src_y: usize = 0;
+    for (0..dst_h) |dy| {
+        const first_sy: usize = @intCast(v_flt.pos[dy]);
+        const end_sy: usize = @min(first_sy + v_fsize, src_h);
+
+        while (next_src_y < end_sy) : (next_src_y += 1) {
+            const s_row = getRowPtrConst(src, src_stride, next_src_y);
+            switch (src_fmt) {
+                types.PIXFMT_RGB24 => unpackRgbRowImpl(s_row, r_src, g_src, b_src, a_src, src_w, types.PIXFMT_RGB24, need_alpha),
+                types.PIXFMT_BGR24 => unpackRgbRowImpl(s_row, r_src, g_src, b_src, a_src, src_w, types.PIXFMT_BGR24, need_alpha),
+                types.PIXFMT_RGBA => unpackRgbRowImpl(s_row, r_src, g_src, b_src, a_src, src_w, types.PIXFMT_RGBA, need_alpha),
+                types.PIXFMT_BGRA => unpackRgbRowImpl(s_row, r_src, g_src, b_src, a_src, src_w, types.PIXFMT_BGRA, need_alpha),
+                else => unreachable,
+            }
+
+            const slot = next_src_y % ring_slots;
+            const offset = slot * ring_stride;
+            hScaleRgb3Row(r_src, g_src, b_src, r_ring[offset..].ptr, g_ring[offset..].ptr, b_ring[offset..].ptr, h_flt);
+            if (need_alpha) {
+                hScale8To15(a_src, a_ring[offset..].ptr, h_flt);
+            }
+        }
+
+        for (0..v_fsize) |j| {
+            const sy = @min(first_sy + j, src_h - 1);
+            const slot = sy % ring_slots;
+            const offset = slot * ring_stride;
+            r_ptrs[j] = r_ring[offset..].ptr;
+            g_ptrs[j] = g_ring[offset..].ptr;
+            b_ptrs[j] = b_ring[offset..].ptr;
+            if (need_alpha) a_ptrs[j] = a_ring[offset..].ptr;
+        }
+
+        const vw = v_flt.weights[dy * v_fsize ..][0..v_fsize];
+        const d_row = getRowPtrMut(dst, dst_stride, dy);
+
+        inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |d_c| {
+            if (dst_fmt == d_c) {
+                const d_bgr = types.isBGROrder(d_c);
+                const d_step = types.rgbStep(d_c);
+                var x: usize = 0;
+                while (x + 16 <= dst_w) : (x += 16) {
+                    const r8 = vScale15To8Vec16(r_ptrs[0..v_fsize], vw, x);
+                    const g8 = vScale15To8Vec16(g_ptrs[0..v_fsize], vw, x);
+                    const b8 = vScale15To8Vec16(b_ptrs[0..v_fsize], vw, x);
+                    if (need_alpha and d_step == 4) {
+                        const a8 = vScale15To8Vec16(a_ptrs[0..v_fsize], vw, x);
+                        unscaled.storeRgba32x16(d_row + x * 4, r8, g8, b8, a8, d_bgr);
+                    } else {
+                        unscaled.storeRgbx16(d_row + x * d_step, r8, g8, b8, d_c);
+                    }
+                }
+                while (x < dst_w) : (x += 1) {
+                    var r_acc: i32 = 1 << 18;
+                    var g_acc: i32 = 1 << 18;
+                    var b_acc: i32 = 1 << 18;
+                    var a_acc: i32 = 1 << 18;
+                    for (0..v_fsize) |j| {
+                        const w: i32 = vw[j];
+                        r_acc += @as(i32, r_ptrs[j][x]) * w;
+                        g_acc += @as(i32, g_ptrs[j][x]) * w;
+                        b_acc += @as(i32, b_ptrs[j][x]) * w;
+                        if (need_alpha) a_acc += @as(i32, a_ptrs[j][x]) * w;
+                    }
+                    const r_b = clipU8(r_acc >> 19);
+                    const g_b = clipU8(g_acc >> 19);
+                    const b_b = clipU8(b_acc >> 19);
+                    const a_b: u8 = if (need_alpha) clipU8(a_acc >> 19) else 255;
+                    unscaled.storeRgbScalar(d_row, x, r_b, g_b, b_b, a_b, d_c);
+                }
+            }
+        }
+    }
+}
