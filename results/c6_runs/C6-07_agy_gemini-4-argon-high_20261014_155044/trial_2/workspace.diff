+            );
+            storeRgbx16(
+                d_row + (x + 16) * step,
+                evalYuv6ChannelVec(y_hi, off_r_hi),
+                evalYuv6ChannelVec(y_hi, off_g_hi),
+                evalYuv6ChannelVec(y_hi, off_b_hi),
+                dst_fmt,
+            );
+        }
