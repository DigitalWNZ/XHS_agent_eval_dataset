+            storeRgbx16(
+                d_row + x * step,
+                evalYuv6ChannelVec(y_lo, off_r_lo),
+                evalYuv6ChannelVec(y_lo, off_g_lo),
+                evalYuv6ChannelVec(y_lo, off_b_lo),
