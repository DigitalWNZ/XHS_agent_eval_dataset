+pub fn computeRowUV14Half(s_row: [*]const u8, u14_out: [*]u16, v14_out: [*]u16, width: usize, comptime src_fmt: c_int) void {
+    const step = types.rgbStep(src_fmt);
+    const is_bgr = types.isBGROrder(src_fmt);
+    const shuf_even = [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) };
+    const shuf_odd = [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) };
+
+    var x: usize = 0;
+    while (x + 32 <= width) : (x += 32) {
+        const rgb_lo = if (step == 3)
+            unscaled.loadRgb24x16(s_row + x * 3, is_bgr)
+        else blk: {
+            const rgba = unscaled.loadRgba32x16(s_row + x * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+        const rgb_hi = if (step == 3)
+            unscaled.loadRgb24x16(s_row + (x + 16) * 3, is_bgr)
+        else blk: {
+            const rgba = unscaled.loadRgba32x16(s_row + (x + 16) * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+
+        const r_even: V16u16 = @shuffle(u8, rgb_lo.r, rgb_hi.r, shuf_even);
+        const r_odd: V16u16 = @shuffle(u8, rgb_lo.r, rgb_hi.r, shuf_odd);
+        const rc: V16u16 = r_even + r_odd;
+
+        const g_even: V16u16 = @shuffle(u8, rgb_lo.g, rgb_hi.g, shuf_even);
+        const g_odd: V16u16 = @shuffle(u8, rgb_lo.g, rgb_hi.g, shuf_odd);
+        const gc: V16u16 = g_even + g_odd;
+
+        const b_even: V16u16 = @shuffle(u8, rgb_lo.b, rgb_hi.b, shuf_even);
+        const b_odd: V16u16 = @shuffle(u8, rgb_lo.b, rgb_hi.b, shuf_odd);
+        const bc: V16u16 = b_even + b_odd;
+
+        const cx = x >> 1;
+        u14_out[cx..][0..16].* = (mulhuwU9Sh7(bc, 28786) + @as(V16u16, @splat(32770)) - mulhuwU9Sh7(rc, 9730) - mulhuwU9Sh7(gc, 19056)) >> @splat(2);
+        v14_out[cx..][0..16].* = (mulhuwU9Sh7(rc, 28786) + @as(V16u16, @splat(32770)) - mulhuwU9Sh7(gc, 24122) - mulhuwU9Sh7(bc, 4664)) >> @splat(2);
+    }
+
+    while (x < width) : (x += 2) {
+        const c0_0 = s_row[x * step + 0];
+        const c0_1 = s_row[x * step + 1];
+        const c0_2 = s_row[x * step + 2];
+        const r0: i32 = if (is_bgr) c0_2 else c0_0;
+        const g0: i32 = c0_1;
+        const b0: i32 = if (is_bgr) c0_0 else c0_2;
+
+        var r1: i32 = r0;
+        var g1: i32 = g0;
+        var b1: i32 = b0;
+        if (x + 1 < width) {
+            const c1_0 = s_row[(x + 1) * step + 0];
+            const c1_1 = s_row[(x + 1) * step + 1];
+            const c1_2 = s_row[(x + 1) * step + 2];
+            r1 = if (is_bgr) c1_2 else c1_0;
+            g1 = c1_1;
+            b1 = if (is_bgr) c1_0 else c1_2;
+        }
+        const rc = r0 + r1;
+        const gc = g0 + g1;
+        const bc = b0 + b1;
+        const cx = x >> 1;
+        u14_out[cx] = @intCast((-4865 * rc - 9528 * gc + 14393 * bc + 8389120) >> 10);
+        v14_out[cx] = @intCast((14393 * rc - 12061 * gc - 2332 * bc + 8389120) >> 10);
+    }
+}
+
+pub fn computeRowYUV14Half(s_row: [*]const u8, y14_out: [*]u16, u14_out: [*]u16, v14_out: [*]u16, width: usize, comptime src_fmt: c_int) void {
+    const step = types.rgbStep(src_fmt);
+    const is_bgr = types.isBGROrder(src_fmt);
+    const shuf_even = [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) };
+    const shuf_odd = [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) };
+
+    var x: usize = 0;
+    while (x + 32 <= width) : (x += 32) {
+        const rgb_lo = if (step == 3)
+            unscaled.loadRgb24x16(s_row + x * 3, is_bgr)
+        else blk: {
+            const rgba = unscaled.loadRgba32x16(s_row + x * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+        const rgb_hi = if (step == 3)
+            unscaled.loadRgb24x16(s_row + (x + 16) * 3, is_bgr)
+        else blk: {
+            const rgba = unscaled.loadRgba32x16(s_row + (x + 16) * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+
+        y14_out[x..][0..16].* = (mulhuwU8Sh8(rgb_lo.r, 16828) + mulhuwU8Sh8(rgb_lo.g, 33038) + mulhuwU8Sh8(rgb_lo.b, 6416) + @as(V16u16, @splat(4098))) >> @splat(2);
+        y14_out[x + 16 ..][0..16].* = (mulhuwU8Sh8(rgb_hi.r, 16828) + mulhuwU8Sh8(rgb_hi.g, 33038) + mulhuwU8Sh8(rgb_hi.b, 6416) + @as(V16u16, @splat(4098))) >> @splat(2);
+
+        const r_even: V16u16 = @shuffle(u8, rgb_lo.r, rgb_hi.r, shuf_even);
+        const r_odd: V16u16 = @shuffle(u8, rgb_lo.r, rgb_hi.r, shuf_odd);
+        const rc: V16u16 = r_even + r_odd;
+
+        const g_even: V16u16 = @shuffle(u8, rgb_lo.g, rgb_hi.g, shuf_even);
+        const g_odd: V16u16 = @shuffle(u8, rgb_lo.g, rgb_hi.g, shuf_odd);
+        const gc: V16u16 = g_even + g_odd;
+
+        const b_even: V16u16 = @shuffle(u8, rgb_lo.b, rgb_hi.b, shuf_even);
+        const b_odd: V16u16 = @shuffle(u8, rgb_lo.b, rgb_hi.b, shuf_odd);
+        const bc: V16u16 = b_even + b_odd;
+
+        const cx = x >> 1;
+        u14_out[cx..][0..16].* = (mulhuwU9Sh7(bc, 28786) + @as(V16u16, @splat(32770)) - mulhuwU9Sh7(rc, 9730) - mulhuwU9Sh7(gc, 19056)) >> @splat(2);
+        v14_out[cx..][0..16].* = (mulhuwU9Sh7(rc, 28786) + @as(V16u16, @splat(32770)) - mulhuwU9Sh7(gc, 24122) - mulhuwU9Sh7(bc, 4664)) >> @splat(2);
+    }
+
+    while (x < width) : (x += 2) {
+        const c0_0 = s_row[x * step + 0];
+        const c0_1 = s_row[x * step + 1];
+        const c0_2 = s_row[x * step + 2];
+        const r0: i32 = if (is_bgr) c0_2 else c0_0;
+        const g0: i32 = c0_1;
+        const b0: i32 = if (is_bgr) c0_0 else c0_2;
+        y14_out[x] = @intCast((8414 * r0 + 16519 * g0 + 3208 * b0 + 524544) >> 9);
+
+        var r1: i32 = r0;
+        var g1: i32 = g0;
+        var b1: i32 = b0;
+        if (x + 1 < width) {
+            const c1_0 = s_row[(x + 1) * step + 0];
+            const c1_1 = s_row[(x + 1) * step + 1];
+            const c1_2 = s_row[(x + 1) * step + 2];
+            r1 = if (is_bgr) c1_2 else c1_0;
+            g1 = c1_1;
+            b1 = if (is_bgr) c1_0 else c1_2;
+            y14_out[x + 1] = @intCast((8414 * r1 + 16519 * g1 + 3208 * b1 + 524544) >> 9);
+        }
+        const rc = r0 + r1;
+        const gc = g0 + g1;
+        const bc = b0 + b1;
+        const cx = x >> 1;
+        u14_out[cx] = @intCast((-4865 * rc - 9528 * gc + 14393 * bc + 8389120) >> 10);
+        v14_out[cx] = @intCast((14393 * rc - 12061 * gc - 2332 * bc + 8389120) >> 10);
+    }
+}
+
+// ── Fast Path 2: Vertical-First RGB -> RGB Downscale (chrSrcH == 1) ─────────
+
+inline fn evalHorizAlpha(rgb_row_ptr: [*]const u8, h_flt: *const Filter, x: usize) u8 {
+    const fsize = h_flt.size;
+    const p: usize = @intCast(h_flt.pos[x]);
+    if (fsize == 1 and h_flt.weights[x] == 16384) {
+        return rgb_row_ptr[p * 4 + 3];
+    }
+    var acc: i32 = 1 << 13;
+    const w = h_flt.weights[x * fsize ..];
+    for (0..fsize) |j| {
+        acc += @as(i32, rgb_row_ptr[(p + j) * 4 + 3]) * @as(i32, w[j]);
+    }
+    return clipU8(acc >> 14);
+}
+
+pub fn scaleRgbDown2x(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst: [*]u8,
+    dst_stride: c_int,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    h_lum_flt: *const Filter,
+    h_chr_flt: *const Filter,
+    v_lum_flt: *const Filter,
+    tmp_rgb_row: []u8,
+    y14_buf: []u16,
+    u14_buf: []u16,
+    v14_buf: []u16,
+    y15_buf: []i16,
+    u15_buf: []i16,
+    v15_buf: []i16,
+    src_fmt: c_int,
+    dst_fmt: c_int,
+) void {
+    const src_step = types.rgbStep(src_fmt);
+    const dst_step = types.rgbStep(dst_fmt);
+    const need_alpha = (src_step == 4 and dst_step == 4);
+    const row_bytes = src_w * src_step;
+    const v_fsize = v_lum_flt.size;
+    const max_30: V16i32 = @splat((1 << 30) - 1);
+    const zero_32: V16i32 = @splat(0);
+
+    var src_ptrs: [32][*]const u8 = undefined;
+
+    for (0..dst_h) |dy| {
+        const first_sy: usize = @intCast(v_lum_flt.pos[dy]);
+        const vw = v_lum_flt.weights[dy * v_fsize ..][0..v_fsize];
+
+        const rgb_row_ptr: [*]const u8 = if (v_fsize == 1 and vw[0] == 4096)
+            getRowPtrConst(src, src_stride, @min(first_sy, src_h - 1))
+        else blk: {
+            for (0..v_fsize) |j| {
+                src_ptrs[j] = getRowPtrConst(src, src_stride, @min(first_sy + j, src_h - 1));
+            }
+            var b_idx: usize = 0;
+            while (b_idx + 16 <= row_bytes) : (b_idx += 16) {
+                var acc_lo: V8i32 = @splat(2048);
+                var acc_hi: V8i32 = @splat(2048);
+                for (0..v_fsize) |j| {
+                    const w_vec: V8i32 = @splat(@as(i32, vw[j]));
+                    const s16: V16u8 = src_ptrs[j][b_idx..][0..16].*;
+                    const s_lo: V8i32 = @intCast(@as(@Vector(8, u8), @shuffle(u8, s16, undefined, [8]i32{ 0, 1, 2, 3, 4, 5, 6, 7 })));
+                    const s_hi: V8i32 = @intCast(@as(@Vector(8, u8), @shuffle(u8, s16, undefined, [8]i32{ 8, 9, 10, 11, 12, 13, 14, 15 })));
+                    acc_lo += s_lo * w_vec;
+                    acc_hi += s_hi * w_vec;
+                }
+                const c_lo: V8i32 = @max(@min(acc_lo >> @splat(12), @as(V8i32, @splat(255))), @as(V8i32, @splat(0)));
+                const c_hi: V8i32 = @max(@min(acc_hi >> @splat(12), @as(V8i32, @splat(255))), @as(V8i32, @splat(0)));
+                const u8_lo: @Vector(8, u8) = @truncate(@as(@Vector(8, u32), @intCast(c_lo)));
+                const u8_hi: @Vector(8, u8) = @truncate(@as(@Vector(8, u32), @intCast(c_hi)));
+                tmp_rgb_row[b_idx..][0..16].* = @shuffle(u8, u8_lo, u8_hi, [16]i32{ 0, 1, 2, 3, 4, 5, 6, 7, ~@as(i32, 0), ~@as(i32, 1), ~@as(i32, 2), ~@as(i32, 3), ~@as(i32, 4), ~@as(i32, 5), ~@as(i32, 6), ~@as(i32, 7) });
+            }
+            while (b_idx < row_bytes) : (b_idx += 1) {
+                var acc: i32 = 2048;
+                for (0..v_fsize) |j| {
+                    acc += @as(i32, src_ptrs[j][b_idx]) * @as(i32, vw[j]);
+                }
+                tmp_rgb_row[b_idx] = clipU8(acc >> 12);
+            }
+            break :blk tmp_rgb_row.ptr;
+        };
+
+        switch (src_fmt) {
+            types.PIXFMT_RGB24 => computeRowYUV14Half(rgb_row_ptr, y14_buf.ptr, u14_buf.ptr, v14_buf.ptr, src_w, types.PIXFMT_RGB24),
+            types.PIXFMT_BGR24 => computeRowYUV14Half(rgb_row_ptr, y14_buf.ptr, u14_buf.ptr, v14_buf.ptr, src_w, types.PIXFMT_BGR24),
+            types.PIXFMT_RGBA => computeRowYUV14Half(rgb_row_ptr, y14_buf.ptr, u14_buf.ptr, v14_buf.ptr, src_w, types.PIXFMT_RGBA),
+            types.PIXFMT_BGRA => computeRowYUV14Half(rgb_row_ptr, y14_buf.ptr, u14_buf.ptr, v14_buf.ptr, src_w, types.PIXFMT_BGRA),
+            else => unreachable,
+        }
+
+        hScale14To15(y14_buf.ptr, y15_buf.ptr, h_lum_flt);
+        hScale14To15(u14_buf.ptr, u15_buf.ptr, h_chr_flt);
+        hScale14To15(v14_buf.ptr, v15_buf.ptr, h_chr_flt);
+
+        const d_row = getRowPtrMut(dst, dst_stride, dy);
+        inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |d_c| {
+            if (dst_fmt == d_c) {
+                const d_bgr = types.isBGROrder(d_c);
+                const d_step = types.rgbStep(d_c);
+                var x: usize = 0;
+                while (x + 16 <= dst_w) : (x += 16) {
+                    const y15_v: V16i32 = @as(V16i16, y15_buf[x..][0..16].*);
+                    const u15_v: V16i32 = @as(V16i16, u15_buf[x..][0..16].*);
+                    const v15_v: V16i32 = @as(V16i16, v15_buf[x..][0..16].*);
+
+                    const Y = ((y15_v << @splat(2)) - @as(V16i32, @splat(8192))) * @as(V16i32, @splat(9539)) + @as(V16i32, @splat(1 << 21));
+                    const U = (u15_v << @splat(2)) - @as(V16i32, @splat(128 << 9));
+                    const V = (v15_v << @splat(2)) - @as(V16i32, @splat(128 << 9));
+
+                    const R30 = @max(@min(Y + V * @as(V16i32, @splat(13075)), max_30), zero_32);
+                    const G30 = @max(@min(Y + V * @as(V16i32, @splat(-6660)) + U * @as(V16i32, @splat(-3209)), max_30), zero_32);
+                    const B30 = @max(@min(Y + U * @as(V16i32, @splat(16525)), max_30), zero_32);
+
+                    const r8: V16u8 = @truncate(@as(V16u32, @intCast(R30 >> @splat(22))));
+                    const g8: V16u8 = @truncate(@as(V16u32, @intCast(G30 >> @splat(22))));
+                    const b8: V16u8 = @truncate(@as(V16u32, @intCast(B30 >> @splat(22))));
+
+                    if (need_alpha and d_step == 4) {
+                        var a8: V16u8 = undefined;
+                        inline for (0..16) |k| {
+                            a8[k] = evalHorizAlpha(rgb_row_ptr, h_lum_flt, x + k);
+                        }
+                        unscaled.storeRgba32x16(d_row + x * 4, r8, g8, b8, a8, d_bgr);
+                    } else {
+                        unscaled.storeRgbx16(d_row + x * d_step, r8, g8, b8, d_c);
+                    }
+                }
+                while (x < dst_w) : (x += 1) {
+                    const Y: i32 = ((@as(i32, y15_buf[x]) << 2) - 8192) * 9539 + (1 << 21);
+                    const U: i32 = (@as(i32, u15_buf[x]) << 2) - (128 << 9);
+                    const V: i32 = (@as(i32, v15_buf[x]) << 2) - (128 << 9);
+                    const R30 = @max(@min(Y + V * 13075, (1 << 30) - 1), 0);
+                    const G30 = @max(@min(Y + V * (-6660) + U * (-3209), (1 << 30) - 1), 0);
+                    const B30 = @max(@min(Y + U * 16525, (1 << 30) - 1), 0);
+                    const a_b: u8 = if (need_alpha) evalHorizAlpha(rgb_row_ptr, h_lum_flt, x) else 255;
+                    unscaled.storeRgbScalar(d_row, x, @intCast(R30 >> 22), @intCast(G30 >> 22), @intCast(B30 >> 22), a_b, d_c);
+                }
+            }
+        }
+    }
+}
+
+// ── Fast Path 3: General YUV / RGB / GRAY8 Scaling Pipeline ─────────────────
+
+fn deinterleaveNvRow(uv_row: [*]const u8, u_out: [*]u8, v_out: [*]u8, chr_w: usize, is_nv21: bool) void {
+    const shuf_even = [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) };
+    const shuf_odd = [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) };
+    var x: usize = 0;
+    while (x + 16 <= chr_w) : (x += 16) {
+        const lo: V16u8 = uv_row[x * 2 ..][0..16].*;
+        const hi: V16u8 = uv_row[x * 2 + 16 ..][0..16].*;
+        const c0 = @shuffle(u8, lo, hi, shuf_even);
+        const c1 = @shuffle(u8, lo, hi, shuf_odd);
+        u_out[x..][0..16].* = if (is_nv21) c1 else c0;
+        v_out[x..][0..16].* = if (is_nv21) c0 else c1;
+    }
+    while (x < chr_w) : (x += 1) {
+        const c0 = uv_row[x * 2 + 0];
+        const c1 = uv_row[x * 2 + 1];
+        u_out[x] = if (is_nv21) c1 else c0;
+        v_out[x] = if (is_nv21) c0 else c1;
+    }
+}
+
+pub fn scaleGeneral(
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    src_w: usize,
+    src_h: usize,
+    dst_w: usize,
+    dst_h: usize,
+    src_fmt: c_int,
+    dst_fmt: c_int,
+    cdims: filter_mod.ChromaDims,
+    h_lum_flt: *const Filter,
+    v_lum_flt: *const Filter,
+    h_chr_flt: *const Filter,
+    v_chr_flt: *const Filter,
+    scratch_u8: []u8,
+    scratch_u16: []u16,
+    lum_ring: []i16,
+    chr_u_ring: []i16,
+    chr_v_ring: []i16,
+    lum_ring_stride: usize,
+    lum_ring_slots: usize,
+    chr_ring_stride: usize,
+    chr_ring_slots: usize,
+) void {
+    const is_same_size_yuv = (src_w == dst_w and src_h == dst_h and types.isAnyYUV(src_fmt) and types.isAnyYUV(dst_fmt));
+    const need_chroma = (dst_fmt != types.PIXFMT_GRAY8 and src_fmt != types.PIXFMT_GRAY8);
+
+    if (is_same_size_yuv) {
+        unscaled.copyPlane(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], src_w, src_h);
+    }
+
+    const src_aligned = (src_w + 31) & ~@as(usize, 31);
+    const u_deint = scratch_u8[0 * src_aligned ..].ptr;
+    const v_deint = scratch_u8[1 * src_aligned ..].ptr;
+    const y14_buf = scratch_u16[0 * src_aligned ..].ptr;
+    const u14_buf = scratch_u16[1 * src_aligned ..].ptr;
+    const v14_buf = scratch_u16[2 * src_aligned ..].ptr;
+
+    const v_lum_fsize = v_lum_flt.size;
+    const v_chr_fsize = v_chr_flt.size;
+
+    var lum_ptrs: [32][*]const i16 = undefined;
+    var chr_u_ptrs: [32][*]const i16 = undefined;
+    var chr_v_ptrs: [32][*]const i16 = undefined;
+
+    // 1. If output is planar/semi-planar YUV or GRAY8, scale Luma and Chroma planes
+    if (!types.isRGB(dst_fmt)) {
+        // Fast fused path for Packed RGB -> Subsampled YUV (chrSrcHSubSample == 1): unpack RGB rows once!
+        if (types.isRGB(src_fmt) and need_chroma and cdims.chrSrcHSubSample == 1 and !is_same_size_yuv) {
+            var next_sy: usize = 0;
+            for (0..dst_h) |dy| {
+                const first_lum_sy: usize = @intCast(v_lum_flt.pos[dy]);
+                const end_lum_sy: usize = @min(first_lum_sy + v_lum_fsize, src_h);
+
+                const do_chr = (cdims.chrDstVSubSample == 0) or ((dy & 1) == 0);
+                const cdy = dy >> cdims.chrDstVSubSample;
+                const first_chr_sy: usize = if (do_chr and cdy < cdims.chrDstH) @intCast(v_chr_flt.pos[cdy]) else 0;
+                const end_chr_sy: usize = if (do_chr and cdy < cdims.chrDstH) @min(first_chr_sy + v_chr_fsize, cdims.chrSrcH) else 0;
+                const target_sy = @max(end_lum_sy, end_chr_sy);
+
+                while (next_sy < target_sy) : (next_sy += 1) {
+                    const lum_slot = lum_ring[(next_sy % lum_ring_slots) * lum_ring_stride ..].ptr;
+                    const chr_slot_idx = (next_sy % chr_ring_slots) * chr_ring_stride;
+                    const u_slot = chr_u_ring[chr_slot_idx..].ptr;
+                    const v_slot = chr_v_ring[chr_slot_idx..].ptr;
+                    const s_row = getRowPtrConst(src_data[0].?, src_stride[0], next_sy);
+                    switch (src_fmt) {
+                        types.PIXFMT_RGB24 => computeRowYUV14Half(s_row, y14_buf, u14_buf, v14_buf, src_w, types.PIXFMT_RGB24),
+                        types.PIXFMT_BGR24 => computeRowYUV14Half(s_row, y14_buf, u14_buf, v14_buf, src_w, types.PIXFMT_BGR24),
+                        types.PIXFMT_RGBA => computeRowYUV14Half(s_row, y14_buf, u14_buf, v14_buf, src_w, types.PIXFMT_RGBA),
+                        types.PIXFMT_BGRA => computeRowYUV14Half(s_row, y14_buf, u14_buf, v14_buf, src_w, types.PIXFMT_BGRA),
+                        else => unreachable,
+                    }
+                    hScale14To15(y14_buf, lum_slot, h_lum_flt);
+                    hScale14To15(u14_buf, u_slot, h_chr_flt);
+                    hScale14To15(v14_buf, v_slot, h_chr_flt);
+                }
+
+                for (0..v_lum_fsize) |j| {
+                    const sy = @min(first_lum_sy + j, src_h - 1);
+                    lum_ptrs[j] = lum_ring[(sy % lum_ring_slots) * lum_ring_stride ..].ptr;
+                }
+                const vw = v_lum_flt.weights[dy * v_lum_fsize ..][0..v_lum_fsize];
+                const d_row = getRowPtrMut(dst_data[0].?, dst_stride[0], dy);
+                vScale15To8Row(lum_ptrs[0..v_lum_fsize], vw, d_row, dst_w);
+
+                if (do_chr and cdy < cdims.chrDstH) {
+                    for (0..v_chr_fsize) |j| {
+                        const cy = @min(first_chr_sy + j, cdims.chrSrcH - 1);
+                        const offset = (cy % chr_ring_slots) * chr_ring_stride;
+                        chr_u_ptrs[j] = chr_u_ring[offset..].ptr;
+                        chr_v_ptrs[j] = chr_v_ring[offset..].ptr;
+                    }
+                    const cw = v_chr_flt.weights[cdy * v_chr_fsize ..][0..v_chr_fsize];
+                    if (types.isPlanarYUV(dst_fmt)) {
+                        const u_dst = getRowPtrMut(dst_data[1].?, dst_stride[1], cdy);
+                        const v_dst = getRowPtrMut(dst_data[2].?, dst_stride[2], cdy);
