+pub fn nv12SwapNv21(
+    src_y: [*]const u8,
+    src_y_stride: c_int,
+    src_uv: [*]const u8,
+    src_uv_stride: c_int,
+    dst_y: [*]u8,
+    dst_y_stride: c_int,
+    dst_uv: [*]u8,
+    dst_uv_stride: c_int,
+    width: usize,
+    height: usize,
+) void {
+    copyPlane(src_y, src_y_stride, dst_y, dst_y_stride, width, height);
+    const chr_bytes = width;
+    const chr_h = height >> 1;
+    const shuf = V32u8{
+        1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14,
+        17, 16, 19, 18, 21, 20, 23, 22, 25, 24, 27, 26, 29, 28, 31, 30,
+    };
+    for (0..chr_h) |y| {
+        const s_row = getRowPtrConst(src_uv, src_uv_stride, y);
+        const d_row = getRowPtrMut(dst_uv, dst_uv_stride, y);
+        var x: usize = 0;
+        while (x + 32 <= chr_bytes) : (x += 32) {
+            const v: V32u8 = s_row[x..][0..32].*;
+            d_row[x..][0..32].* = @shuffle(u8, v, undefined, shuf);
+        }
+        while (x + 2 <= chr_bytes) : (x += 2) {
+            d_row[x] = s_row[x + 1];
+            d_row[x + 1] = s_row[x];
+        }
+    }
