+pub fn computeRowUV14Full(s_row: [*]const u8, u14_out: [*]u16, v14_out: [*]u16, width: usize, comptime src_fmt: c_int) void {
+    const step = types.rgbStep(src_fmt);
+    const is_bgr = types.isBGROrder(src_fmt);
+    var x: usize = 0;
+    while (x + 16 <= width) : (x += 16) {
+        const rgb = if (step == 3)
+            unscaled.loadRgb24x16(s_row + x * 3, is_bgr)
+        else blk: {
+            const rgba = unscaled.loadRgba32x16(s_row + x * 4, is_bgr);
+            break :blk .{ .r = rgba.r, .g = rgba.g, .b = rgba.b };
+        };
+        u14_out[x..][0..16].* = (mulhuwU8Sh8(rgb.b, 28786) + @as(V16u16, @splat(16386)) - mulhuwU8Sh8(rgb.r, 9730) - mulhuwU8Sh8(rgb.g, 19056)) >> @splat(2);
+        v14_out[x..][0..16].* = (mulhuwU8Sh8(rgb.r, 28786) + @as(V16u16, @splat(16386)) - mulhuwU8Sh8(rgb.g, 24122) - mulhuwU8Sh8(rgb.b, 4664)) >> @splat(2);
+    }
+    while (x < width) : (x += 1) {
+        const c0 = s_row[x * step + 0];
+        const c1 = s_row[x * step + 1];
+        const c2 = s_row[x * step + 2];
+        const r: i32 = if (is_bgr) c2 else c0;
+        const g: i32 = c1;
+        const b: i32 = if (is_bgr) c0 else c2;
+        u14_out[x] = @intCast((-4865 * r - 9528 * g + 14393 * b + 2097408) >> 9);
+        v14_out[x] = @intCast((14393 * r - 12061 * g - 2332 * b + 2097408) >> 9);
+    }
+}
