--- /dev/null
+++ b/swscale-impl/src/filter.zig
@@ -0,0 +1,295 @@
+const std = @import("std");
+const types = @import("types.zig");
+
+pub const Filter = struct {
+    pos: []i32,
+    weights: []i16,
+    weights_t: []i16,
+    size: usize,
+    dst_len: usize,
+
+    pub fn deinit(self: *Filter, allocator: std.mem.Allocator) void {
+        allocator.free(self.pos);
+        allocator.free(self.weights);
+        allocator.free(self.weights_t);
+    }
+};
+
+fn avLog2(x: u32) u5 {
+    if (x == 0) return 0;
+    return @intCast(31 - @clz(x));
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    if (a >= 0) {
+        return @divTrunc(a + (b >> 1), b);
+    } else {
+        return @divTrunc(a - (b >> 1), b);
+    }
+}
+
+pub fn initFilter(
+    allocator: std.mem.Allocator,
+    src_w_in: usize,
+    dst_w_in: usize,
+    algo: c_int,
+    one: i64,
+    src_pos: i64,
+    dst_pos: i64,
+) !Filter {
+    const srcW: i64 = @intCast(src_w_in);
+    const dstW: i64 = @intCast(dst_w_in);
+    const xInc: i64 = @divTrunc((srcW << 16) + (dstW >> 1), dstW);
+    const ratio: u32 = @intCast(@divTrunc(srcW, dstW));
+    const shift_amt: u6 = @intCast(@as(u32, 54) - @min(@as(u32, avLog2(ratio)), 8));
+    const fone: i64 = @as(i64, 1) << shift_amt;
+
+    var filterSize: usize = 1;
+    const fPos = try allocator.alloc(i32, dst_w_in);
+    errdefer allocator.free(fPos);
+
+    var flt: []i64 = undefined;
+
+    if (@abs(xInc - 0x10000) < 10 and src_pos == dst_pos) {
+        filterSize = 1;
+        flt = try allocator.alloc(i64, dst_w_in);
+        for (0..dst_w_in) |i| {
+            fPos[i] = @intCast(i);
+            flt[i] = fone;
+        }
+    } else if (algo == types.ALGO_NEAREST) {
+        filterSize = 1;
+        flt = try allocator.alloc(i64, dst_w_in);
+        var xDstInSrc: i64 = ((dst_pos * xInc) >> 8) - ((src_pos * 0x8000) >> 7);
+        for (0..dst_w_in) |i| {
+            fPos[i] = @intCast((xDstInSrc + (1 << 15)) >> 16);
+            flt[i] = fone;
+            xDstInSrc += xInc;
+        }
+    } else {
+        const sizeFactor: i64 = if (algo == types.ALGO_BILINEAR) 2 else 4;
+        var fs_i64: i64 = if (xInc <= (1 << 16))
+            1 + sizeFactor
+        else
+            1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW);
+        fs_i64 = @max(1, @min(fs_i64, srcW - 2));
+        filterSize = @intCast(fs_i64);
+
+        flt = try allocator.alloc(i64, dst_w_in * filterSize);
+        @memset(flt, 0);
+
+        var xDstInSrc: i64 = ((dst_pos * xInc) >> 7) - ((src_pos * 0x10000) >> 7);
+        for (0..dst_w_in) |i| {
+            var xx: i64 = @divTrunc(xDstInSrc - (fs_i64 - 2) * (1 << 16), 1 << 17);
+            fPos[i] = @intCast(xx);
+            for (0..filterSize) |j| {
+                var d: i64 = @as(i64, @intCast(@abs((xx * (1 << 17)) - xDstInSrc))) << 13;
+                if (xInc > (1 << 16)) {
+                    d = @divTrunc(d * dstW, srcW);
+                }
+                var coeff: i64 = 0;
+                if (algo == types.ALGO_BICUBIC) {
+                    const B: i64 = 0;
+                    const C: i64 = 10066329; // int(0.6 * (1 << 24))
+                    if (d >= (@as(i64, 1) << 31)) {
+                        coeff = 0;
+                    } else {
+                        const dd: i64 = (d * d) >> 30;
+                        const ddd: i64 = (dd * d) >> 30;
+                        if (d < (@as(i64, 1) << 30)) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    const div_factor: i64 = @divTrunc(@as(i64, 1) << 54, fone);
+                    coeff = @divTrunc(coeff, div_factor);
+                } else {
+                    coeff = (@as(i64, 1) << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= (fone >> 30);
+                }
+                flt[i * filterSize + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * xInc;
+        }
+    }
+    defer allocator.free(flt);
+
+    const filter2Size = filterSize;
+    var filter2 = try allocator.alloc(i64, dst_w_in * filter2Size);
+    defer allocator.free(filter2);
+    @memcpy(filter2, flt);
+
+    var minFilterSize: usize = 0;
+    const cutoff_limit: i64 = @intFromFloat(0.002 * @as(f64, @floatFromInt(fone)));
+
+    var i_rev: isize = @as(isize, @intCast(dst_w_in)) - 1;
+    while (i_rev >= 0) : (i_rev -= 1) {
+        const i: usize = @intCast(i_rev);
+        var mn: usize = filter2Size;
+        var cutOff: i64 = 0;
+        for (0..filter2Size) |_| {
+            cutOff += @intCast(@abs(filter2[i * filter2Size]));
+            if (cutOff > cutoff_limit) break;
+            if (i < dst_w_in - 1 and fPos[i] >= fPos[i + 1]) break;
+            for (1..filter2Size) |k| {
+                filter2[i * filter2Size + k - 1] = filter2[i * filter2Size + k];
+            }
+            filter2[i * filter2Size + filter2Size - 1] = 0;
+            fPos[i] += 1;
+        }
+        cutOff = 0;
+        var j_rev: usize = filter2Size - 1;
+        while (j_rev > 0) : (j_rev -= 1) {
+            cutOff += @intCast(@abs(filter2[i * filter2Size + j_rev]));
+            if (cutOff > cutoff_limit) break;
+            mn -= 1;
+        }
+        if (mn > minFilterSize) minFilterSize = mn;
+    }
+
+    filterSize = @max(minFilterSize, 1);
+    var flt_reduced = try allocator.alloc(i64, dst_w_in * filterSize);
+    defer allocator.free(flt_reduced);
+    for (0..dst_w_in) |i| {
+        for (0..filterSize) |j| {
+            flt_reduced[i * filterSize + j] = filter2[i * filter2Size + j];
+        }
+    }
+
+    const fs_i32: i32 = @intCast(filterSize);
+    const srcW_i32: i32 = @intCast(src_w_in);
+    for (0..dst_w_in) |i| {
+        if (fPos[i] < 0) {
+            for (1..filterSize) |j| {
+                const j_i32: i32 = @intCast(j);
+                const left: usize = @intCast(@max(j_i32 + fPos[i], 0));
+                flt_reduced[i * filterSize + left] += flt_reduced[i * filterSize + j];
+                flt_reduced[i * filterSize + j] = 0;
+            }
+            fPos[i] = 0;
+        }
+        if (fPos[i] + fs_i32 > srcW_i32) {
+            const shift: usize = @intCast(fPos[i] + @min(fs_i32 - srcW_i32, 0));
+            var acc: i64 = 0;
+            var j_rev: isize = @as(isize, @intCast(filterSize)) - 1;
+            while (j_rev >= 0) : (j_rev -= 1) {
+                const j: usize = @intCast(j_rev);
+                if (fPos[i] + @as(i32, @intCast(j)) >= srcW_i32) {
+                    acc += flt_reduced[i * filterSize + j];
+                    flt_reduced[i * filterSize + j] = 0;
+                }
+            }
+            j_rev = @as(isize, @intCast(filterSize)) - 1;
+            while (j_rev >= 0) : (j_rev -= 1) {
+                const j: usize = @intCast(j_rev);
+                if (j < shift) {
+                    flt_reduced[i * filterSize + j] = 0;
+                } else {
+                    flt_reduced[i * filterSize + j] = flt_reduced[i * filterSize + j - shift];
+                }
+            }
+            fPos[i] -= @intCast(shift);
+            const last_idx: usize = @intCast(srcW_i32 - 1 - fPos[i]);
+            flt_reduced[i * filterSize + last_idx] += acc;
+        }
+    }
+
+    const outFilter = try allocator.alloc(i16, dst_w_in * filterSize);
+    errdefer allocator.free(outFilter);
+    for (0..dst_w_in) |i| {
+        var err: i64 = 0;
+        var s: i64 = 0;
+        for (0..filterSize) |j| {
+            s += flt_reduced[i * filterSize + j];
+        }
+        s = @divTrunc(s + @divTrunc(one, 2), one);
+        if (s == 0) s = 1;
+        for (0..filterSize) |j| {
+            const v: i64 = flt_reduced[i * filterSize + j] + err;
+            const intV: i64 = roundedDiv(v, s);
+            outFilter[i * filterSize + j] = @intCast(intV);
+            err = v - intV * s;
+        }
+    }
+
+    const dst_aligned = (dst_w_in + 7) & ~@as(usize, 7);
+    const outFilterT = try allocator.alloc(i16, dst_aligned * filterSize);
+    var b: usize = 0;
+    while (b < dst_aligned) : (b += 8) {
+        for (0..filterSize) |j| {
+            for (0..8) |k| {
+                outFilterT[b * filterSize + j * 8 + k] = if (b + k < dst_w_in)
+                    outFilter[(b + k) * filterSize + j]
+                else
+                    0;
+            }
+        }
+    }
+
+    return Filter{
+        .pos = fPos,
+        .weights = outFilter,
+        .weights_t = outFilterT,
+        .size = filterSize,
+        .dst_len = dst_w_in,
+    };
+}
+
+pub const ChromaDims = struct {
+    chrSrcHSubSample: u3,
+    chrSrcVSubSample: u3,
+    chrDstHSubSample: u3,
+    chrDstVSubSample: u3,
+    chrSrcW: usize,
+    chrSrcH: usize,
+    chrDstW: usize,
+    chrDstH: usize,
+};
+
+pub fn computeChromaDims(src_fmt: c_int, dst_fmt: c_int, src_w: usize, src_h: usize, dst_w: usize, dst_h: usize) ChromaDims {
+    const src_sub = types.formatSubSample(src_fmt);
+    const dst_sub = types.formatSubSample(dst_fmt);
+
+    var chrSrcH = src_sub.h;
+    const chrSrcV = src_sub.v;
+    var chrDstH = dst_sub.h;
+    const chrDstV = dst_sub.v;
+
+    if (types.isRGB(dst_fmt)) {
+        var full_chr_h_int = false;
+        if ((dst_w & 1) != 0 or (chrSrcH == 0 and chrSrcV == 0)) {
+            full_chr_h_int = true;
+        }
+        if (!full_chr_h_int) {
+            chrDstH = 1;
+        }
+    }
+
+    if (types.isRGB(src_fmt) and ((dst_w >> chrDstH) <= (src_w >> 1))) {
+        chrSrcH = 1;
+    }
+
+    const chrSrcW = (src_w + (@as(usize, 1) << chrSrcH) - 1) >> chrSrcH;
+    const chrSrcH_dim = (src_h + (@as(usize, 1) << chrSrcV) - 1) >> chrSrcV;
+    const chrDstW = (dst_w + (@as(usize, 1) << chrDstH) - 1) >> chrDstH;
+    const chrDstH_dim = (dst_h + (@as(usize, 1) << chrDstV) - 1) >> chrDstV;
+
+    return .{
+        .chrSrcHSubSample = chrSrcH,
+        .chrSrcVSubSample = chrSrcV,
+        .chrDstHSubSample = chrDstH,
+        .chrDstVSubSample = chrDstV,
+        .chrSrcW = chrSrcW,
+        .chrSrcH = chrSrcH_dim,
+        .chrDstW = chrDstW,
+        .chrDstH = chrDstH_dim,
+    };
+}
diff --git a/swscale-impl/src/main.zig b/swscale-impl/src/main.zig
new file mode 100644
--- /dev/null
+++ b/swscale-impl/src/main.zig
@@ -0,0 +1,407 @@
+const std = @import("std");
+const types = @import("types.zig");
+const filter_mod = @import("filter.zig");
+const unscaled = @import("unscaled.zig");
+const scaled = @import("scaled.zig");
+
+const Filter = filter_mod.Filter;
+
+const SwsContext = struct {
+    src_w: usize,
+    src_h: usize,
+    src_fmt: c_int,
+    dst_w: usize,
+    dst_h: usize,
+    dst_fmt: c_int,
+    algo: c_int,
+
+    has_filters: bool,
+    cdims: filter_mod.ChromaDims,
+    h_lum_flt: Filter,
+    v_lum_flt: Filter,
+    h_chr_flt: Filter,
+    v_chr_flt: Filter,
+
+    lum_ring_stride: usize,
+    lum_ring_slots: usize,
+    chr_ring_stride: usize,
+    chr_ring_slots: usize,
+
+    scratch_u8: []u8,
+    scratch_u16: []u16,
+    lum_ring: []i16,
+    chr_u_ring: []i16,
+    chr_v_ring: []i16,
+};
+
+fn isPureUnscaled(src_fmt: c_int, dst_fmt: c_int, src_w: usize, src_h: usize, dst_w: usize, dst_h: usize) bool {
+    if (src_w != dst_w or src_h != dst_h) return false;
+    if (types.isAnyYUV(src_fmt) and types.isAnyYUV(dst_fmt)) {
+        const s_sub = types.formatSubSample(src_fmt);
+        const d_sub = types.formatSubSample(dst_fmt);
+        return (s_sub.h == d_sub.h and s_sub.v == d_sub.v);
+    }
+    return true;
+}
+
+export fn swscale_create(
+    src_w_c: c_int,
+    src_h_c: c_int,
+    src_fmt: c_int,
+    dst_w_c: c_int,
+    dst_h_c: c_int,
+    dst_fmt: c_int,
+    algo: c_int,
+) ?*anyopaque {
+    if (src_w_c <= 0 or src_h_c <= 0 or dst_w_c <= 0 or dst_h_c <= 0) return null;
+    if (src_fmt < 0 or src_fmt > 9 or dst_fmt < 0 or dst_fmt > 9) return null;
+    if (algo < 0 or algo > 2) return null;
+
+    const allocator = std.heap.c_allocator;
+    const src_w: usize = @intCast(src_w_c);
+    const src_h: usize = @intCast(src_h_c);
+    const dst_w: usize = @intCast(dst_w_c);
+    const dst_h: usize = @intCast(dst_h_c);
+
+    const ctx = allocator.create(SwsContext) catch return null;
+    errdefer allocator.destroy(ctx);
+
+    const cdims = filter_mod.computeChromaDims(src_fmt, dst_fmt, src_w, src_h, dst_w, dst_h);
+    const pure_unscaled = isPureUnscaled(src_fmt, dst_fmt, src_w, src_h, dst_w, dst_h);
+
+    ctx.* = .{
+        .src_w = src_w,
+        .src_h = src_h,
+        .src_fmt = src_fmt,
+        .dst_w = dst_w,
+        .dst_h = dst_h,
+        .dst_fmt = dst_fmt,
+        .algo = algo,
+        .has_filters = !pure_unscaled,
+        .cdims = cdims,
+        .h_lum_flt = undefined,
+        .v_lum_flt = undefined,
+        .h_chr_flt = undefined,
+        .v_chr_flt = undefined,
+        .lum_ring_stride = 0,
+        .lum_ring_slots = 0,
+        .chr_ring_stride = 0,
+        .chr_ring_slots = 0,
+        .scratch_u8 = &[_]u8{},
+        .scratch_u16 = &[_]u16{},
+        .lum_ring = &[_]i16{},
+        .chr_u_ring = &[_]i16{},
+        .chr_v_ring = &[_]i16{},
+    };
+
+    if (pure_unscaled) {
+        if (types.isRGB(src_fmt) and types.isAnyYUV(dst_fmt) and dst_fmt != types.PIXFMT_YUV444P) {
+            const chr_stride = (((src_w + 1) >> 1) + 31) & ~@as(usize, 31);
+            ctx.chr_ring_stride = chr_stride;
+            ctx.scratch_u16 = allocator.alloc(u16, 8 * chr_stride) catch return null;
+        }
+        return @ptrCast(ctx);
+    }
+
+    ctx.h_lum_flt = filter_mod.initFilter(allocator, src_w, dst_w, algo, 1 << 14, 128, 128) catch return null;
+    errdefer ctx.h_lum_flt.deinit(allocator);
+
+    ctx.v_lum_flt = filter_mod.initFilter(allocator, src_h, dst_h, algo, 1 << 12, 128, 128) catch return null;
+    errdefer ctx.v_lum_flt.deinit(allocator);
+
+    ctx.h_chr_flt = filter_mod.initFilter(allocator, cdims.chrSrcW, cdims.chrDstW, algo, 1 << 14, 128, 128) catch return null;
+    errdefer ctx.h_chr_flt.deinit(allocator);
+
+    ctx.v_chr_flt = filter_mod.initFilter(allocator, cdims.chrSrcH, cdims.chrDstH, algo, 1 << 12, 128, 128) catch return null;
+    errdefer ctx.v_chr_flt.deinit(allocator);
+
+    const src_aligned = (src_w + 31) & ~@as(usize, 31);
+    const dst_aligned = (dst_w + 31) & ~@as(usize, 31);
+    const chr_dst_aligned = (cdims.chrDstW + 31) & ~@as(usize, 31);
+
+    const max_v_span = (src_h / @max(cdims.chrDstH, 1)) + ctx.v_lum_flt.size + ctx.v_chr_flt.size + 8;
+    const min_slots: usize = if (types.isRGB(src_fmt) and types.isAnyYUV(dst_fmt)) max_v_span else 4;
+    ctx.lum_ring_stride = dst_aligned;
+    ctx.lum_ring_slots = @max(ctx.v_lum_flt.size + 2, min_slots);
+    ctx.chr_ring_stride = chr_dst_aligned;
+    ctx.chr_ring_slots = @max(ctx.v_chr_flt.size + 2, min_slots);
+
+    ctx.scratch_u8 = allocator.alloc(u8, 4 * src_aligned) catch return null;
+    errdefer allocator.free(ctx.scratch_u8);
+
+    ctx.scratch_u16 = allocator.alloc(u16, 3 * src_aligned) catch return null;
+    errdefer allocator.free(ctx.scratch_u16);
+
+    ctx.lum_ring = allocator.alloc(i16, 4 * ctx.lum_ring_slots * ctx.lum_ring_stride) catch return null;
+    errdefer allocator.free(ctx.lum_ring);
+
+    ctx.chr_u_ring = allocator.alloc(i16, ctx.chr_ring_slots * ctx.chr_ring_stride) catch return null;
+    errdefer allocator.free(ctx.chr_u_ring);
+
+    ctx.chr_v_ring = allocator.alloc(i16, ctx.chr_ring_slots * ctx.chr_ring_stride) catch return null;
+    errdefer allocator.free(ctx.chr_v_ring);
+
+    return @ptrCast(ctx);
+}
+
+fn processUnscaled(
+    ctx: *SwsContext,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const w = ctx.src_w;
+    const h = ctx.src_h;
+    const sf = ctx.src_fmt;
+    const df = ctx.dst_fmt;
+
+    // 1. Same format copy
+    if (sf == df) {
+        if (types.isRGB(sf)) {
+            unscaled.copyPlane(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w * types.rgbStep(sf), h);
+            return 0;
+        } else if (sf == types.PIXFMT_GRAY8) {
+            unscaled.copyPlane(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w, h);
+            return 0;
+        } else if (types.isPlanarYUV(sf)) {
+            const sub = types.formatSubSample(sf);
+            const cw = (w + (@as(usize, 1) << sub.h) - 1) >> sub.h;
+            const ch = (h + (@as(usize, 1) << sub.v) - 1) >> sub.v;
+            unscaled.copyPlane(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w, h);
+            unscaled.copyPlane(src_data[1].?, src_stride[1], dst_data[1].?, dst_stride[1], cw, ch);
+            unscaled.copyPlane(src_data[2].?, src_stride[2], dst_data[2].?, dst_stride[2], cw, ch);
+            return 0;
+        } else if (types.isSemiPlanarYUV(sf)) {
+            const cw = (w + 1) >> 1;
+            const ch = (h + 1) >> 1;
+            unscaled.copyPlane(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w, h);
+            unscaled.copyPlane(src_data[1].?, src_stride[1], dst_data[1].?, dst_stride[1], cw * 2, ch);
+            return 0;
+        }
+    }
+
+    // 2. Packed RGB <-> Packed RGB
+    if (types.isRGB(sf) and types.isRGB(df)) {
+        const s0 = src_data[0].?;
+        const ss0 = src_stride[0];
+        const d0 = dst_data[0].?;
+        const ds0 = dst_stride[0];
+        inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |s_c| {
+            if (sf == s_c) {
+                inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |d_c| {
+                    if (df == d_c) {
+                        unscaled.convertRgbToRgb(s0, ss0, d0, ds0, w, h, s_c, d_c);
+                        return 0;
+                    }
+                }
+            }
+        }
+    }
+
+    // 3. GRAY8 conversions
+    if (sf == types.PIXFMT_GRAY8) {
+        if (types.isRGB(df)) {
+            inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |d_c| {
+                if (df == d_c) {
+                    unscaled.grayToRgb(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w, h, d_c);
+                    return 0;
+                }
+            }
+        } else if (types.isAnyYUV(df)) {
+            unscaled.grayToYuv(src_data[0].?, src_stride[0], dst_data, dst_stride, w, h, df);
+            return 0;
+        }
+    }
+    if (df == types.PIXFMT_GRAY8) {
+        if (types.isAnyYUV(sf)) {
+            unscaled.yuvToGray(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w, h);
+            return 0;
+        } else if (types.isRGB(sf)) {
+            inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |s_c| {
+                if (sf == s_c) {
+                    unscaled.rgbToGray(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], w, h, s_c);
+                    return 0;
+                }
+            }
+        }
+    }
+
+    // 4. Planar / Semi-Planar YUV420 rearrangements
+    if (sf == types.PIXFMT_YUV420P and (df == types.PIXFMT_NV12 or df == types.PIXFMT_NV21)) {
+        if (df == types.PIXFMT_NV21) {
+            unscaled.yuv420pToNv(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], src_data[2].?, src_stride[2], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], w, h, true);
+        } else {
+            unscaled.yuv420pToNv(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], src_data[2].?, src_stride[2], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], w, h, false);
+        }
+        return 0;
+    }
+    if ((sf == types.PIXFMT_NV12 or sf == types.PIXFMT_NV21) and df == types.PIXFMT_YUV420P) {
+        if (sf == types.PIXFMT_NV21) {
+            unscaled.nvToYuv420p(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], dst_data[2].?, dst_stride[2], w, h, true);
+        } else {
+            unscaled.nvToYuv420p(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], dst_data[2].?, dst_stride[2], w, h, false);
+        }
+        return 0;
+    }
+    if ((sf == types.PIXFMT_NV12 and df == types.PIXFMT_NV21) or (sf == types.PIXFMT_NV21 and df == types.PIXFMT_NV12)) {
+        unscaled.nv12SwapNv21(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], w, h);
+        return 0;
+    }
+
+    // 5. YUV -> Packed RGB
+    if (types.isAnyYUV(sf) and types.isRGB(df)) {
+        inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |d_c| {
+            if (df == d_c) {
+                switch (sf) {
+                    types.PIXFMT_YUV420P => unscaled.yuv420pToRgb(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], src_data[2].?, src_stride[2], dst_data[0].?, dst_stride[0], w, h, d_c),
+                    types.PIXFMT_YUV422P => unscaled.yuv422pToRgb(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], src_data[2].?, src_stride[2], dst_data[0].?, dst_stride[0], w, h, d_c),
+                    types.PIXFMT_YUV444P => unscaled.yuv444pToRgb(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], src_data[2].?, src_stride[2], dst_data[0].?, dst_stride[0], w, h, d_c),
+                    types.PIXFMT_NV12 => unscaled.nvToRgb(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], dst_data[0].?, dst_stride[0], w, h, false, d_c),
+                    types.PIXFMT_NV21 => unscaled.nvToRgb(src_data[0].?, src_stride[0], src_data[1].?, src_stride[1], dst_data[0].?, dst_stride[0], w, h, true, d_c),
+                    else => unreachable,
+                }
+                return 0;
+            }
+        }
+    }
+
+    // 6. Packed RGB -> YUV
+    if (types.isRGB(sf) and types.isAnyYUV(df)) {
+        if (sf == types.PIXFMT_BGR24 and df == types.PIXFMT_YUV420P) {
+            unscaled.bgr24ToYuv420pSpecial(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], dst_data[2].?, dst_stride[2], w, h);
+            return 0;
+        }
+        const cs = ctx.chr_ring_stride;
+        inline for ([_]c_int{ types.PIXFMT_RGB24, types.PIXFMT_BGR24, types.PIXFMT_RGBA, types.PIXFMT_BGRA }) |s_c| {
+            if (sf == s_c) {
+                switch (df) {
+                    types.PIXFMT_YUV444P => unscaled.rgbToYuv444p(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], dst_data[2].?, dst_stride[2], w, h, s_c),
+                    types.PIXFMT_YUV422P => unscaled.rgbToYuv422p(src_data[0].?, src_stride[0], dst_data[0].?, dst_stride[0], dst_data[1].?, dst_stride[1], dst_data[2].?, dst_stride[2], w, h, ctx.scratch_u16[0..cs], ctx.scratch_u16[cs .. 2 * cs], s_c),
+                    types.PIXFMT_YUV420P => unscaled.rgbToYuv420OrNv(src_data[0].?, src_stride[0], dst_data, dst_stride, w, h, ctx.scratch_u16[0 .. 4 * cs], ctx.scratch_u16[4 * cs .. 8 * cs], cs, s_c, types.PIXFMT_YUV420P),
+                    types.PIXFMT_NV12 => unscaled.rgbToYuv420OrNv(src_data[0].?, src_stride[0], dst_data, dst_stride, w, h, ctx.scratch_u16[0 .. 4 * cs], ctx.scratch_u16[4 * cs .. 8 * cs], cs, s_c, types.PIXFMT_NV12),
+                    types.PIXFMT_NV21 => unscaled.rgbToYuv420OrNv(src_data[0].?, src_stride[0], dst_data, dst_stride, w, h, ctx.scratch_u16[0 .. 4 * cs], ctx.scratch_u16[4 * cs .. 8 * cs], cs, s_c, types.PIXFMT_NV21),
+                    else => unreachable,
+                }
+                return 0;
+            }
+        }
+    }
+
+    return -1;
+}
+
+export fn swscale_process(
+    handle: ?*anyopaque,
+    src_data: [*]const ?[*]const u8,
+    src_stride: [*]const c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+) c_int {
+    const ctx: *SwsContext = @ptrCast(@alignCast(handle orelse return -1));
+
+    if (!ctx.has_filters) {
+        return processUnscaled(ctx, src_data, src_stride, dst_data, dst_stride);
+    }
+
+    const sf = ctx.src_fmt;
+    const df = ctx.dst_fmt;
+
+    // Scaled Packed RGB -> Packed RGB fast paths
+    if (types.isRGB(sf) and types.isRGB(df)) {
+        const src_aligned = (ctx.src_w + 31) & ~@as(usize, 31);
+        const dst_aligned = ctx.lum_ring_stride;
+        if (ctx.cdims.chrSrcHSubSample == 0 and ctx.cdims.chrDstHSubSample == 0) {
+            scaled.scaleRgbDirect(
+                src_data[0].?,
+                src_stride[0],
+                dst_data[0].?,
+                dst_stride[0],
+                ctx.src_w,
+                ctx.src_h,
+                ctx.dst_w,
+                ctx.dst_h,
+                &ctx.h_lum_flt,
+                &ctx.v_lum_flt,
+                ctx.scratch_u8,
+                ctx.lum_ring,
+                ctx.lum_ring_stride,
+                ctx.lum_ring_slots,
+                sf,
+                df,
+            );
+        } else {
+            scaled.scaleRgbDown2x(
+                src_data[0].?,
+                src_stride[0],
+                dst_data[0].?,
+                dst_stride[0],
+                ctx.src_w,
+                ctx.src_h,
+                ctx.dst_w,
+                ctx.dst_h,
+                &ctx.h_lum_flt,
+                &ctx.h_chr_flt,
+                &ctx.v_lum_flt,
+                ctx.scratch_u8,
+                ctx.scratch_u16[0 * src_aligned .. 1 * src_aligned],
+                ctx.scratch_u16[1 * src_aligned .. 2 * src_aligned],
+                ctx.scratch_u16[2 * src_aligned .. 3 * src_aligned],
+                ctx.lum_ring[0 * dst_aligned .. 1 * dst_aligned],
+                ctx.lum_ring[1 * dst_aligned .. 2 * dst_aligned],
+                ctx.lum_ring[2 * dst_aligned .. 3 * dst_aligned],
+                sf,
+                df,
+            );
+        }
+        return 0;
+    }
+
+    // General scaled path (YUV<->YUV, YUV->RGB, RGB->YUV, GRAY8->GRAY8)
+    scaled.scaleGeneral(
+        src_data,
+        src_stride,
+        dst_data,
+        dst_stride,
+        ctx.src_w,
+        ctx.src_h,
+        ctx.dst_w,
+        ctx.dst_h,
+        sf,
+        df,
+        ctx.cdims,
+        &ctx.h_lum_flt,
+        &ctx.v_lum_flt,
+        &ctx.h_chr_flt,
+        &ctx.v_chr_flt,
+        ctx.scratch_u8,
+        ctx.scratch_u16,
+        ctx.lum_ring,
+        ctx.chr_u_ring,
+        ctx.chr_v_ring,
+        ctx.lum_ring_stride,
+        ctx.lum_ring_slots,
+        ctx.chr_ring_stride,
+        ctx.chr_ring_slots,
+    );
+    return 0;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |ptr| {
+        const allocator = std.heap.c_allocator;
+        const ctx: *SwsContext = @ptrCast(@alignCast(ptr));
+        if (ctx.has_filters) {
+            ctx.h_lum_flt.deinit(allocator);
+            ctx.v_lum_flt.deinit(allocator);
+            ctx.h_chr_flt.deinit(allocator);
+            ctx.v_chr_flt.deinit(allocator);
+        }
+        if (ctx.scratch_u8.len > 0) allocator.free(ctx.scratch_u8);
+        if (ctx.scratch_u16.len > 0) allocator.free(ctx.scratch_u16);
+        if (ctx.lum_ring.len > 0) allocator.free(ctx.lum_ring);
+        if (ctx.chr_u_ring.len > 0) allocator.free(ctx.chr_u_ring);
+        if (ctx.chr_v_ring.len > 0) allocator.free(ctx.chr_v_ring);
+        allocator.destroy(ctx);
+    }
+}
