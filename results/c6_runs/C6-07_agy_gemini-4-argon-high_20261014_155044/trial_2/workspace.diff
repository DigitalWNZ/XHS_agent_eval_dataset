+    dst_v: [*]u8,
+    dst_v_stride: c_int,
+    width: usize,
+    height: usize,
+    comptime is_nv21: bool,
+) void {
+    copyPlane(src_y, src_y_stride, dst_y, dst_y_stride, width, height);
+    const chr_w = width >> 1;
+    const chr_h = height >> 1;
+
+    const shuf_even = [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) };
+    const shuf_odd = [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) };
