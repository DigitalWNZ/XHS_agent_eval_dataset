+                    unscaled.storeRgbx16(
+                        d_row + x_off * step,
+                        unscaled.evalYuv6ChannelVec(ys, or_v),
+                        unscaled.evalYuv6ChannelVec(ys, og_v),
+                        unscaled.evalYuv6ChannelVec(ys, ob_v),
+                        dst_fmt,
+                    );
+                }
+            }
+
+            while (x < dst_w) : (x += 2) {
+                const cx = x >> 1;
+                var u_acc: i32 = round_val;
+                var v_acc: i32 = round_val;
+                for (0..v_chr_fsize) |j| {
