+pub fn grayToYuv(
+    src_y: [*]const u8,
+    src_y_stride: c_int,
+    dst_data: [*]const ?[*]u8,
+    dst_stride: [*]const c_int,
+    width: usize,
+    height: usize,
+    dst_fmt: c_int,
+) void {
+    const dst_y = dst_data[0].?;
+    const dst_y_stride = dst_stride[0];
+
+    for (0..height) |y| {
+        const s_row = getRowPtrConst(src_y, src_y_stride, y);
+        const d_row = getRowPtrMut(dst_y, dst_y_stride, y);
+        var x: usize = 0;
+        while (x + 16 <= width) : (x += 16) {
+            const y_u8: V16u8 = s_row[x..][0..16].*;
+            const y15: V16u32 = @as(V16u32, y_u8) << @splat(7);
+            const scaled: V16u32 = (y15 * @as(V16u32, @splat(14071)) + @as(V16u32, @splat(33561947))) >> @splat(14);
+            const out_u32: V16u32 = (scaled + @as(V16u32, @splat(64))) >> @splat(7);
+            const clamped: V16u32 = @min(out_u32, @as(V16u32, @splat(255)));
+            d_row[x..][0..16].* = @as(V16u8, @truncate(clamped));
+        }
+        while (x < width) : (x += 1) {
+            const y15: i32 = @as(i32, s_row[x]) << 7;
+            const scaled: i32 = (y15 * 14071 + 33561947) >> 14;
+            d_row[x] = clipU8((scaled + 64) >> 7);
+        }
+    }
+
+    const sub = types.formatSubSample(dst_fmt);
+    const chr_w = (width + (@as(usize, 1) << sub.h) - 1) >> sub.h;
+    const chr_h = (height + (@as(usize, 1) << sub.v) - 1) >> sub.v;
+    if (types.isPlanarYUV(dst_fmt)) {
+        fillPlane(dst_data[1].?, dst_stride[1], chr_w, chr_h, 128);
+        fillPlane(dst_data[2].?, dst_stride[2], chr_w, chr_h, 128);
+    } else if (types.isSemiPlanarYUV(dst_fmt)) {
+        fillPlane(dst_data[1].?, dst_stride[1], chr_w * 2, chr_h, 128);
+    }
+}
