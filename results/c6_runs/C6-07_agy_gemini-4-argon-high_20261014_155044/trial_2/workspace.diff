+pub fn hScale14To15(src: [*]const u16, dst: [*]i16, flt: *const Filter) void {
+    const dst_len = flt.dst_len;
+    const fsize = flt.size;
+    const pos = flt.pos;
+    const weights = flt.weights;
+    const weights_t = flt.weights_t;
+
+    if (fsize == 1) {
+        if (dst_len > 0 and weights[0] == 16384) {
+            for (0..dst_len) |i| {
+                dst[i] = @intCast(@min(@as(u32, src[@intCast(pos[i])]) << 1, 32767));
