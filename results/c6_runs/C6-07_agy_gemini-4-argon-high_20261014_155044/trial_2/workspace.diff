+        }
+        while (i < dst_len) : (i += 1) {
+            const p: usize = @intCast(pos[i]);
+            const w = weights[i * 2 ..];
+            const val: i32 = (@as(i32, src[p]) * @as(i32, w[0]) + @as(i32, src[p + 1]) * @as(i32, w[1])) >> 13;
