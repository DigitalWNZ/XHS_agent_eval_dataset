+pub fn grayToRgb(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst: [*]u8,
+    dst_stride: c_int,
+    width: usize,
+    height: usize,
+    comptime dst_fmt: c_int,
+) void {
+    const step = types.rgbStep(dst_fmt);
+    for (0..height) |y| {
+        const s_row = getRowPtrConst(src, src_stride, y);
+        const d_row = getRowPtrMut(dst, dst_stride, y);
+        var x: usize = 0;
+        while (x + 16 <= width) : (x += 16) {
+            const v: V16u8 = s_row[x..][0..16].*;
+            storeRgbx16(d_row + x * step, v, v, v, dst_fmt);
+        }
+        while (x < width) : (x += 1) {
+            const v = s_row[x];
+            storeRgbScalar(d_row, x, v, v, v, 255, dst_fmt);
+        }
+    }
+}
