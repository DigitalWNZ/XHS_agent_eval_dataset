+        while (x < width) : (x += 2) {
+            const cx = x >> 1;
+            const offs = computeChromaOffsetsScalar(u_row[cx], v_row[cx]);
+            const yv0: i32 = y_row[x];
+            storeRgbScalar(
+                d_row,
+                x,
+                evalYuvTableChannelScalar(yv0, offs.r),
+                evalYuvTableChannelScalar(yv0, offs.g),
+                evalYuvTableChannelScalar(yv0, offs.b),
+                255,
+                dst_fmt,
+            );
+            if (x + 1 < width) {
+                const yv1: i32 = y_row[x + 1];
+                storeRgbScalar(
+                    d_row,
+                    x + 1,
+                    evalYuvTableChannelScalar(yv1, offs.r),
+                    evalYuvTableChannelScalar(yv1, offs.g),
+                    evalYuvTableChannelScalar(yv1, offs.b),
+                    255,
+                    dst_fmt,
