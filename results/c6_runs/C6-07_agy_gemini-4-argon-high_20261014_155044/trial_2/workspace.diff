+pub fn bgr24ToYuv420pSpecial(
+    src: [*]const u8,
+    src_stride: c_int,
+    dst_y: [*]u8,
+    dst_y_stride: c_int,
+    dst_u: [*]u8,
+    dst_u_stride: c_int,
+    dst_v: [*]u8,
+    dst_v_stride: c_int,
+    width: usize,
+    height: usize,
+) void {
+    const shuf_even = [16]i32{ 0, 2, 4, 6, 8, 10, 12, 14, ~@as(i32, 0), ~@as(i32, 2), ~@as(i32, 4), ~@as(i32, 6), ~@as(i32, 8), ~@as(i32, 10), ~@as(i32, 12), ~@as(i32, 14) };
+    const shuf_odd = [16]i32{ 1, 3, 5, 7, 9, 11, 13, 15, ~@as(i32, 1), ~@as(i32, 3), ~@as(i32, 5), ~@as(i32, 7), ~@as(i32, 9), ~@as(i32, 11), ~@as(i32, 13), ~@as(i32, 15) };
+
+    var y: usize = 0;
+    while (y + 2 <= height) : (y += 2) {
+        const s_row0 = getRowPtrConst(src, src_stride, y);
+        const s_row1 = getRowPtrConst(src, src_stride, y + 1);
+        const y_row0 = getRowPtrMut(dst_y, dst_y_stride, y);
+        const y_row1 = getRowPtrMut(dst_y, dst_y_stride, y + 1);
+        const u_row = getRowPtrMut(dst_u, dst_u_stride, y >> 1);
+        const v_row = getRowPtrMut(dst_v, dst_v_stride, y >> 1);
+
+        var x: usize = 0;
+        while (x + 32 <= width) : (x += 32) {
+            const rgb0_lo = loadRgb24x16(s_row0 + x * 3, true);
+            const rgb0_hi = loadRgb24x16(s_row0 + (x + 16) * 3, true);
+            const rgb1_lo = loadRgb24x16(s_row1 + x * 3, true);
+            const rgb1_hi = loadRgb24x16(s_row1 + (x + 16) * 3, true);
+
+            // Y = ((8414*R + 16519*G + 3208*B) >> 15) + 16
+            // Note: mulhuw(r<<8, 16828) + mulhuw(g<<8, 33038) + mulhuw(b<<8, 6416) == (8414*r + 16519*g + 3208*b) >> 7
+            // Shifting right by 8 + 16 is 100% bit-exact!
+            y_row0[x..][0..16].* = @as(V16u8, @truncate(((mulhuwU8Sh8(rgb0_lo.r, 16828) + mulhuwU8Sh8(rgb0_lo.g, 33038) + mulhuwU8Sh8(rgb0_lo.b, 6416)) >> @splat(8)) + @as(V16u16, @splat(16))));
+            y_row0[x + 16 ..][0..16].* = @as(V16u8, @truncate(((mulhuwU8Sh8(rgb0_hi.r, 16828) + mulhuwU8Sh8(rgb0_hi.g, 33038) + mulhuwU8Sh8(rgb0_hi.b, 6416)) >> @splat(8)) + @as(V16u16, @splat(16))));
+            y_row1[x..][0..16].* = @as(V16u8, @truncate(((mulhuwU8Sh8(rgb1_lo.r, 16828) + mulhuwU8Sh8(rgb1_lo.g, 33038) + mulhuwU8Sh8(rgb1_lo.b, 6416)) >> @splat(8)) + @as(V16u16, @splat(16))));
+            y_row1[x + 16 ..][0..16].* = @as(V16u8, @truncate(((mulhuwU8Sh8(rgb1_hi.r, 16828) + mulhuwU8Sh8(rgb1_hi.g, 33038) + mulhuwU8Sh8(rgb1_hi.b, 6416)) >> @splat(8)) + @as(V16u16, @splat(16))));
+
+            const r0_even: V16u16 = @shuffle(u8, rgb0_lo.r, rgb0_hi.r, shuf_even);
+            const r0_odd: V16u16 = @shuffle(u8, rgb0_lo.r, rgb0_hi.r, shuf_odd);
+            const r1_even: V16u16 = @shuffle(u8, rgb1_lo.r, rgb1_hi.r, shuf_even);
+            const r1_odd: V16u16 = @shuffle(u8, rgb1_lo.r, rgb1_hi.r, shuf_odd);
+            const rx: V16u16 = (r0_even + r0_odd + r1_even + r1_odd) >> @splat(2);
+
+            const g0_even: V16u16 = @shuffle(u8, rgb0_lo.g, rgb0_hi.g, shuf_even);
+            const g0_odd: V16u16 = @shuffle(u8, rgb0_lo.g, rgb0_hi.g, shuf_odd);
+            const g1_even: V16u16 = @shuffle(u8, rgb1_lo.g, rgb1_hi.g, shuf_even);
+            const g1_odd: V16u16 = @shuffle(u8, rgb1_lo.g, rgb1_hi.g, shuf_odd);
+            const gx: V16u16 = (g0_even + g0_odd + g1_even + g1_odd) >> @splat(2);
+
+            const b0_even: V16u16 = @shuffle(u8, rgb0_lo.b, rgb0_hi.b, shuf_even);
+            const b0_odd: V16u16 = @shuffle(u8, rgb0_lo.b, rgb0_hi.b, shuf_odd);
+            const b1_even: V16u16 = @shuffle(u8, rgb1_lo.b, rgb1_hi.b, shuf_even);
+            const b1_odd: V16u16 = @shuffle(u8, rgb1_lo.b, rgb1_hi.b, shuf_odd);
+            const bx: V16u16 = (b0_even + b0_odd + b1_even + b1_odd) >> @splat(2);
+
+            const u16_v: V16u16 = ((mulhuwU8Sh8(bx, 28786) + @as(V16u16, @splat(32768)) - mulhuwU8Sh8(rx, 9730) - mulhuwU8Sh8(gx, 19056)) >> @splat(8));
+            const v16_v: V16u16 = ((mulhuwU8Sh8(rx, 28786) + @as(V16u16, @splat(32768)) - mulhuwU8Sh8(gx, 24122) - mulhuwU8Sh8(bx, 4664)) >> @splat(8));
+
+            const cx = x >> 1;
+            u_row[cx..][0..16].* = @as(V16u8, @truncate(u16_v));
+            v_row[cx..][0..16].* = @as(V16u8, @truncate(v16_v));
+        }
+
+        while (x < width) : (x += 2) {
+            const b00: i32 = s_row0[x * 3 + 0];
+            const g00: i32 = s_row0[x * 3 + 1];
+            const r00: i32 = s_row0[x * 3 + 2];
+            const b01: i32 = s_row0[(x + 1) * 3 + 0];
+            const g01: i32 = s_row0[(x + 1) * 3 + 1];
+            const r01: i32 = s_row0[(x + 1) * 3 + 2];
+            const b10: i32 = s_row1[x * 3 + 0];
+            const g10: i32 = s_row1[x * 3 + 1];
+            const r10: i32 = s_row1[x * 3 + 2];
+            const b11: i32 = s_row1[(x + 1) * 3 + 0];
+            const g11: i32 = s_row1[(x + 1) * 3 + 1];
+            const r11: i32 = s_row1[(x + 1) * 3 + 2];
+
+            y_row0[x] = @intCast(((8414 * r00 + 16519 * g00 + 3208 * b00) >> 15) + 16);
+            y_row0[x + 1] = @intCast(((8414 * r01 + 16519 * g01 + 3208 * b01) >> 15) + 16);
+            y_row1[x] = @intCast(((8414 * r10 + 16519 * g10 + 3208 * b10) >> 15) + 16);
+            y_row1[x + 1] = @intCast(((8414 * r11 + 16519 * g11 + 3208 * b11) >> 15) + 16);
+
+            const rx = (r00 + r01 + r10 + r11) >> 2;
+            const gx = (g00 + g01 + g10 + g11) >> 2;
+            const bx = (b00 + b01 + b10 + b11) >> 2;
+            const cx = x >> 1;
+            u_row[cx] = @intCast(((-4865 * rx - 9528 * gx + 14393 * bx) >> 15) + 128);
+            v_row[cx] = @intCast(((14393 * rx - 12061 * gx - 2332 * bx) >> 15) + 128);
+        }
+    }
