+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define BASE 1000000000U
+
+typedef struct {
+    uint32_t *d;
+    int len;
+    int cap;
+} BigInt;
+
+static void init_bigint(BigInt *n, int cap) {
+    n->cap = cap < 4 ? 4 : cap;
+    n->d = (uint32_t *)calloc((size_t)n->cap, sizeof(uint32_t));
+    n->len = 1;
+}
+
+static void free_bigint(BigInt *n) {
+    free(n->d);
+}
+
+static void add_bigint(const BigInt *a, const BigInt *b, BigInt *res) {
+    int max_len = a->len > b->len ? a->len : b->len;
+    if (res->cap < max_len + 1) {
+        res->cap = (max_len + 1) * 2;
+        res->d = (uint32_t *)realloc(res->d, (size_t)res->cap * sizeof(uint32_t));
+    }
+    uint32_t carry = 0;
+    int i = 0;
+    for (; i < max_len || carry; i++) {
+        uint64_t sum = carry;
+        if (i < a->len) sum += a->d[i];
+        if (i < b->len) sum += b->d[i];
+        if (sum >= BASE) {
+            res->d[i] = (uint32_t)(sum - BASE);
+            carry = 1;
+        } else {
+            res->d[i] = (uint32_t)sum;
+            carry = 0;
+        }
+    }
+    res->len = i;
+}
+
+static void print_bigint(const BigInt *n) {
+    if (n->len == 0) {
+        printf("0\n");
+        return;
+    }
+    printf("%u", n->d[n->len - 1]);
+    for (int i = n->len - 2; i >= 0; i--) {
+        printf("%09u", n->d[i]);
+    }
+    printf("\n");
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) return 1;
+    long long n = atoll(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return 0;
+    }
+    BigInt a, b, c;
+    init_bigint(&a, 16);
+    init_bigint(&b, 16);
+    init_bigint(&c, 16);
+    a.d[0] = 0; a.len = 1;
+    b.d[0] = 1; b.len = 1;
+    for (long long i = 2; i <= n; i++) {
+        add_bigint(&a, &b, &c);
+        BigInt tmp = a;
+        a = b;
+        b = c;
+        c = tmp;
+    }
+    print_bigint(&b);
+    free_bigint(&a);
+    free_bigint(&b);
+    free_bigint(&c);
+    return 0;
+}
