diff --git a/bak/final_src/fast.zig b/bak/final_src/fast.zig
new file mode 100644
--- /dev/null
+++ b/bak/final_src/fast.zig
@@ -0,0 +1,1164 @@
+// fast.zig — SIMD fast paths. Each hook returns false when it does not apply,
+// letting the exact scalar code in main.zig run instead.
+const std = @import("std");
+const m = @import("main.zig");
+const Ctx = m.Ctx;
+const Filter = m.Filter;
+
+pub fn setup(c: *Ctx) void {
+    if (c.hasFilters) {
+        c.identL = isIdentity(&c.hLum, @intCast(c.dstW), 1 << 14);
+        c.identC = isIdentity(&c.hChr, @intCast(c.chrDstW), 1 << 14);
+        if (!c.identL) c.padL = makePad(&c.hLum, @intCast(c.dstW));
+        if (!c.identC) c.padC = makePad(&c.hChr, @intCast(c.chrDstW));
+        if (!c.identL) c.grpL = makeGroups(&c.hLum, @intCast(c.dstW), &c.padL);
+        if (!c.identC) c.grpC = makeGroups(&c.hChr, @intCast(c.chrDstW), &c.padC);
+        c.wide = std.heap.c_allocator.alloc(u16, @as(usize, @intCast(c.srcW)) + 64) catch &.{};
+        if (c.wide.len == 0) {
+            c.padL = .{};
+            c.padC = .{};
+        }
+    }
+}
+
+pub fn genericFused(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int, dst: [*]const ?[*]u8, ds: [*]const c_int) bool {
+    _ = c;
+    _ = src;
+    _ = ss;
+    _ = dst;
+    _ = ds;
+    return false;
+}
+
+pub fn interleave(d: [*]u8, a: [*]const u8, b: [*]const u8, n: usize) void {
+    for (0..n) |i| {
+        d[2 * i] = a[i];
+        d[2 * i + 1] = b[i];
+    }
+}
+pub fn deinterleave(a: [*]u8, b: [*]u8, s: [*]const u8, n: usize) void {
+    for (0..n) |i| {
+        a[i] = s[2 * i];
+        b[i] = s[2 * i + 1];
+    }
+}
+
+// ── vector helpers ──────────────────────────────────────────────────────────
+pub const V16u16 = @Vector(16, u16);
+pub const V16i16 = @Vector(16, i16);
+pub const V16i32 = @Vector(16, i32);
+pub const V32u8 = @Vector(32, u8);
+pub const V16u8 = @Vector(16, u8);
+
+inline fn spl16(x: i16) V16i16 {
+    return @splat(x);
+}
+
+// (v * X) >> 16 (floor) for 0 <= v < 32768, any X: X = q*65536 + rem, rem in [-32768, 32768)
+const MulC = struct { q: V16i16, rem: V16i16 };
+fn mulConst(X: i64) MulC {
+    var q: i64 = X >> 16;
+    var rem: i64 = X - q * 65536;
+    if (rem >= 32768) {
+        rem -= 65536;
+        q += 1;
+    }
+    return .{ .q = @splat(@intCast(q)), .rem = @splat(@intCast(rem)) };
+}
+inline fn mulShift16(v: V16i16, mc: MulC) V16i16 {
+    return mulhiS(v, mc.rem) +% v *% mc.q;
+}
+
+inline fn mulhiU(a: V16u16, b: V16u16) V16u16 {
+    const wa: @Vector(16, u32) = a;
+    const wb: @Vector(16, u32) = b;
+    return @truncate((wa * wb) >> @splat(16));
+}
+
+inline fn mulhiS(a: V16i16, b: V16i16) V16i16 {
+    const wa: V16i32 = a;
+    const wb: V16i32 = b;
+    return @truncate((wa * wb) >> @splat(16));
+}
+
+inline fn lumaCurve(k: V16i16) V16i16 {
+    const cst: V16i16 = @splat(10773);
+    const hi = mulhiS(k, cst);
+    const lo: V16u16 = @bitCast(k *% cst);
+    const r: V16i16 = @bitCast(lo >> @splat(15));
+    return k -% spl16(400) +% hi +% r;
+}
+
+// same curve in the x32 domain: k32 = 32*k, k in [0, 860] -> (signed) value before saturation
+inline fn curve32(k32: V16i16) V16i16 {
+    const mm = mulhiS(k32, spl16(10773));
+    return (k32 +% mm -% spl16(12784)) >> @splat(5);
+}
+
+inline fn curveK(k: V16i16) V16i16 {
+    const kc: V16i16 = @max(@min(k, spl16(860)), spl16(0));
+    return curve32(kc << @splat(5));
+}
+
+inline fn packU8u(a: V16u16, b: V16u16) V32u8 {
+    const v: @Vector(32, u16) = std.simd.join(a, b);
+    return @truncate(@min(v, @as(@Vector(32, u16), @splat(255))));
+}
+
+inline fn packU8(a: V16i16, b: V16i16) V32u8 {
+    const v: @Vector(32, i16) = std.simd.join(a, b);
+    const cl: @Vector(32, i16) = @max(@min(v, @as(@Vector(32, i16), @splat(255))), @as(@Vector(32, i16), @splat(0)));
+    return @truncate(@as(@Vector(32, u16), @bitCast(cl)));
+}
+
+inline fn widen(v: V32u8) [2]V16i16 {
+    const lo: V16u8 = std.simd.extract(v, 0, 16);
+    const hi: V16u8 = std.simd.extract(v, 16, 16);
+    return .{ @intCast(lo), @intCast(hi) };
+}
+
+fn rgbMask() @Vector(96, i32) {
+    var mk: [96]i32 = undefined;
+    for (0..32) |p| {
+        mk[3 * p] = @intCast(2 * p);
+        mk[3 * p + 1] = @intCast(2 * p + 1);
+        mk[3 * p + 2] = ~@as(i32, @intCast(p));
+    }
+    return mk;
+}
+fn pairMask() @Vector(64, i32) {
+    var mk: [64]i32 = undefined;
+    for (0..32) |p| {
+        mk[2 * p] = @intCast(p);
+        mk[2 * p + 1] = ~@as(i32, @intCast(p));
+    }
+    return mk;
+}
+fn quadMask() @Vector(128, i32) {
+    var mk: [128]i32 = undefined;
+    for (0..32) |p| {
+        mk[4 * p] = @intCast(2 * p);
+        mk[4 * p + 1] = @intCast(2 * p + 1);
+        mk[4 * p + 2] = ~@as(i32, @intCast(2 * p));
+        mk[4 * p + 3] = ~@as(i32, @intCast(2 * p + 1));
+    }
+    return mk;
+}
+
+// store 32 pixels given channel vectors in output byte order c0,c1,c2(,c3)
+pub inline fn store3(d: [*]u8, c0: V32u8, c1: V32u8, c2: V32u8) void {
+    const p01: @Vector(64, u8) = @shuffle(u8, c0, c1, pairMask());
+    const out: @Vector(96, u8) = @shuffle(u8, p01, c2, rgbMask());
+    d[0..96].* = out;
+}
+pub inline fn store4(d: [*]u8, c0: V32u8, c1: V32u8, c2: V32u8, c3: V32u8) void {
+    const p01: @Vector(64, u8) = @shuffle(u8, c0, c1, pairMask());
+    const p23: @Vector(64, u8) = @shuffle(u8, c2, c3, pairMask());
+    const out: @Vector(128, u8) = @shuffle(u8, p01, p23, quadMask());
+    d[0..128].* = out;
+}
+
+fn dupLoMask() @Vector(16, i32) {
+    var mk: [16]i32 = undefined;
+    for (0..16) |i| mk[i] = @intCast(i / 2);
+    return mk;
+}
+fn dupHiMask() @Vector(16, i32) {
+    var mk: [16]i32 = undefined;
+    for (0..16) |i| mk[i] = @intCast(8 + i / 2);
+    return mk;
+}
+
+pub fn yuv2rgbRow2(c: *Ctx, d: [*]u8, d2: [*]u8, py: [*]const u8, py2: [*]const u8, pu: [*]const u8, pv: [*]const u8, w: usize) bool {
+    if (c.tabs.full) return false;
+    return switch (c.dstF) {
+        m.RGB24 => yuv2rgbT(m.RGB24, 2, c, d, d2, py, py2, pu, pv, w),
+        m.BGR24 => yuv2rgbT(m.BGR24, 2, c, d, d2, py, py2, pu, pv, w),
+        m.RGBA => yuv2rgbT(m.RGBA, 2, c, d, d2, py, py2, pu, pv, w),
+        else => yuv2rgbT(m.BGRA, 2, c, d, d2, py, py2, pu, pv, w),
+    };
+}
+
+pub fn yuv2rgbRow(c: *Ctx, d: [*]u8, py: [*]const u8, pu: [*]const u8, pv: [*]const u8, w: usize) bool {
+    if (c.tabs.full) return false;
+    return switch (c.dstF) {
+        m.RGB24 => yuv2rgbT(m.RGB24, 1, c, d, d, py, py, pu, pv, w),
+        m.BGR24 => yuv2rgbT(m.BGR24, 1, c, d, d, py, py, pu, pv, w),
+        m.RGBA => yuv2rgbT(m.RGBA, 1, c, d, d, py, py, pu, pv, w),
+        else => yuv2rgbT(m.BGRA, 1, c, d, d, py, py, pu, pv, w),
+    };
+}
+
+fn yuv2rgbT(comptime f: i32, comptime nrows: usize, c: *Ctx, d1: [*]u8, d2: [*]u8, py1: [*]const u8, py2: [*]const u8, pu: [*]const u8, pv: [*]const u8, w: usize) bool {
+    const t = &c.tabs;
+    const bpp = m.rgbBpp(f);
+    const nblk = w / 32;
+    const mcr = mulConst(t.crv);
+    const mcgu = mulConst(t.cgu);
+    const mcgv = mulConst(t.cgv);
+    const mcb = mulConst(t.cbu);
+    const rvc: i16 = @intCast(326 - (t.crv >> 9));
+    const guc: i16 = @intCast(326 - (t.cgu >> 9) - (t.cgv >> 9));
+    const buc: i16 = @intCast(326 - (t.cbu >> 9));
+    for (0..nblk) |b| {
+        const u: V16i16 = @intCast(@as(V16u8, pu[b * 16 ..][0..16].*));
+        const v: V16i16 = @intCast(@as(V16u8, pv[b * 16 ..][0..16].*));
+        const kr = mulShift16(v, mcr) +% spl16(rvc);
+        const kg = mulShift16(u, mcgu) +% mulShift16(v, mcgv) +% spl16(guc);
+        const kb = mulShift16(u, mcb) +% spl16(buc);
+        const kr6 = kr << @splat(5);
+        const kg6 = kg << @splat(5);
+        const kb6 = kb << @splat(5);
+        const krl = @shuffle(i16, kr6, undefined, dupLoMask());
+        const krh = @shuffle(i16, kr6, undefined, dupHiMask());
+        const kgl = @shuffle(i16, kg6, undefined, dupLoMask());
+        const kgh = @shuffle(i16, kg6, undefined, dupHiMask());
+        const kbl = @shuffle(i16, kb6, undefined, dupLoMask());
+        const kbh = @shuffle(i16, kb6, undefined, dupHiMask());
+        inline for (0..nrows) |row| {
+            const py = if (row == 0) py1 else py2;
+            const d = if (row == 0) d1 else d2;
+            const yb8: V32u8 = py[b * 32 ..][0..32].*;
+            const y0: V16i16 = @as(V16i16, @intCast(@as(V16u8, std.simd.extract(yb8, 0, 16)))) << @splat(5);
+            const y1: V16i16 = @as(V16i16, @intCast(@as(V16u8, std.simd.extract(yb8, 16, 16)))) << @splat(5);
+            const R = packU8(curve32(y0 +% krl), curve32(y1 +% krh));
+            const G = packU8(curve32(y0 +% kgl), curve32(y1 +% kgh));
+            const B = packU8(curve32(y0 +% kbl), curve32(y1 +% kbh));
+            const o = d + b * 32 * bpp;
+            switch (f) {
+                m.RGB24 => {
+                    store3h(o, std.simd.extract(R, 0, 16), std.simd.extract(G, 0, 16), std.simd.extract(B, 0, 16));
+                    store3h(o + 48, std.simd.extract(R, 16, 16), std.simd.extract(G, 16, 16), std.simd.extract(B, 16, 16));
+                },
+                m.BGR24 => {
+                    store3h(o, std.simd.extract(B, 0, 16), std.simd.extract(G, 0, 16), std.simd.extract(R, 0, 16));
+                    store3h(o + 48, std.simd.extract(B, 16, 16), std.simd.extract(G, 16, 16), std.simd.extract(R, 16, 16));
+                },
+                m.RGBA => store4(o, R, G, B, @splat(255)),
+                else => store4(o, B, G, R, @splat(255)),
+            }
+        }
+    }
+    // scalar tail
+    var i: usize = nblk * 16;
+    while (i < w / 2) : (i += 1) {
+        const U = pu[i];
+        const V = pv[i];
+        const ro = t.rv[V];
+        const go = t.gu[U] + t.gv[V];
+        const bo = t.bu[U];
+        inline for (0..nrows) |row| {
+            const py = if (row == 0) py1 else py2;
+            const d = if (row == 0) d1 else d2;
+            inline for (0..2) |k| {
+                const Y: i32 = py[2 * i + k];
+                const o = d + (2 * i + k) * bpp;
+                o[m.rOff(f)] = t.ytab[@intCast(ro + Y)];
+                o[1] = t.ytab[@intCast(go + Y)];
+                o[m.bOff(f)] = t.ytab[@intCast(bo + Y)];
+                if (bpp == 4) o[3] = 255;
+            }
+        }
+    }
+    return true;
+}
+
+fn shufMask(comptime n: usize, comptime sb: usize, comptime db: usize, comptime so: [4]i32) @Vector(n * db, i32) {
+    var mk: [n * db]i32 = undefined;
+    for (0..n) |p| {
+        for (0..db) |k| {
+            const s = so[k];
+            mk[p * db + k] = if (s < 0) -1 else @as(i32, @intCast(p * sb)) + s;
+        }
+    }
+    return mk;
+}
+
+fn lane34Mask(comptime so: [4]i32) @Vector(32, i32) {
+    var mk: [32]i32 = undefined;
+    for (0..2) |l| {
+        for (0..4) |p| {
+            for (0..4) |k| {
+                mk[l * 16 + p * 4 + k] = if (so[k] < 0) -1 else @intCast(l * 16 + p * 3 + @as(usize, @intCast(so[k])));
+            }
+        }
+    }
+    return mk;
+}
+
+// 3-byte -> 4-byte pixels: 8 pixels per step from two overlapping 16-byte loads (in-lane byte shuffle)
+fn conv34(comptime so: [4]i32, d: [*]u8, s: [*]const u8, w: usize) void {
+    const ff: V32u8 = @splat(255);
+    var i: usize = 0;
+    while ((i + 8) * 3 + 4 <= w * 3) : (i += 8) {
+        const lo: V16u8 = s[i * 3 ..][0..16].*;
+        const hi: V16u8 = s[i * 3 + 12 ..][0..16].*;
+        const v: V32u8 = std.simd.join(lo, hi);
+        const out: V32u8 = @shuffle(u8, v, ff, lane34Mask(so));
+        d[i * 4 ..][0..32].* = out;
+    }
+    while (i < w) : (i += 1) {
+        for (0..4) |k| {
+            const sidx = so[k];
+            d[i * 4 + k] = if (sidx < 0) 255 else s[i * 3 + @as(usize, @intCast(sidx))];
+        }
+    }
+}
+
+fn convRows(comptime sb: usize, comptime db: usize, comptime so: [4]i32, d: [*]u8, s: [*]const u8, w: usize) void {
+    const N = 32;
+    const nblk = w / N;
+    const ff: @Vector(N * sb, u8) = @splat(255);
+    for (0..nblk) |b| {
+        const sv: @Vector(N * sb, u8) = s[b * N * sb ..][0 .. N * sb].*;
+        const out: @Vector(N * db, u8) = @shuffle(u8, sv, ff, shufMask(N, sb, db, so));
+        d[b * N * db ..][0 .. N * db].* = out;
+    }
+    for (nblk * N..w) |i| {
+        for (0..db) |k| {
+            const sidx = so[k];
+            d[i * db + k] = if (sidx < 0) 255 else s[i * sb + @as(usize, @intCast(sidx))];
+        }
+    }
+}
+
+pub fn rgb2rgbRow(c: *Ctx, d: [*]u8, s: [*]const u8, w: usize) bool {
+    const sf = c.srcF;
+    const df = c.dstF;
+    // source byte index for each destination byte; -1 = constant 255 (index into ff vector is ~0 -> use -1)
+    const A: i32 = -1;
+    switch (sf) {
+        m.RGB24 => switch (df) {
+            m.BGR24 => convRows(3, 3, .{ 2, 1, 0, 0 }, d, s, w),
+            m.RGBA => conv34(.{ 0, 1, 2, A }, d, s, w),
+            m.BGRA => conv34(.{ 2, 1, 0, A }, d, s, w),
+            else => return false,
+        },
+        m.BGR24 => switch (df) {
+            m.RGB24 => convRows(3, 3, .{ 2, 1, 0, 0 }, d, s, w),
+            m.RGBA => conv34(.{ 2, 1, 0, A }, d, s, w),
+            m.BGRA => conv34(.{ 0, 1, 2, A }, d, s, w),
+            else => return false,
+        },
+        m.RGBA => switch (df) {
+            m.RGB24 => convRows(4, 3, .{ 0, 1, 2, 0 }, d, s, w),
+            m.BGR24 => convRows(4, 3, .{ 2, 1, 0, 0 }, d, s, w),
+            m.BGRA => convRows(4, 4, .{ 2, 1, 0, 3 }, d, s, w),
+            else => return false,
+        },
+        m.BGRA => switch (df) {
+            m.RGB24 => convRows(4, 3, .{ 2, 1, 0, 0 }, d, s, w),
+            m.BGR24 => convRows(4, 3, .{ 0, 1, 2, 0 }, d, s, w),
+            m.RGBA => convRows(4, 4, .{ 2, 1, 0, 3 }, d, s, w),
+            else => return false,
+        },
+        else => return false,
+    }
+    return true;
+}
+
+// ── generic pipeline kernels ────────────────────────────────────────────────
+const V8i32 = @Vector(8, i32);
+
+inline fn ld16(p: [*]const i16) V16i32 {
+    const v: V16i16 = p[0..16].*;
+    return v;
+}
+
+inline fn ldv(p: [*]const i16) V16i16 {
+    return p[0..16].*;
+}
+
+inline fn maddRows(a: V16i16, b: V16i16, ca: i32, cb: i32) V16i32 {
+    const pa: @Vector(32, i16) = @shuffle(i16, a, b, pair16Mask());
+    var cc: @Vector(32, i16) = undefined;
+    inline for (0..16) |k| {
+        cc[2 * k] = @intCast(ca);
+        cc[2 * k + 1] = @intCast(cb);
+    }
+    const p: @Vector(32, i32) = @as(@Vector(32, i32), pa) * @as(@Vector(32, i32), cc);
+    return @shuffle(i32, p, undefined, evenMask16()) + @shuffle(i32, p, undefined, oddMask16());
+}
+fn evenMask16() @Vector(16, i32) {
+    var mk: [16]i32 = undefined;
+    for (0..16) |i| mk[i] = @intCast(2 * i);
+    return mk;
+}
+fn oddMask16() @Vector(16, i32) {
+    var mk: [16]i32 = undefined;
+    for (0..16) |i| mk[i] = @intCast(2 * i + 1);
+    return mk;
+}
+
+inline fn vsum(rows: []const [*]const i16, coef: []const i16, i: usize, init: i32) V16i32 {
+    var acc: V16i32 = @splat(init);
+    for (rows, 0..) |r, j| acc +%= ld16(r + i) *% @as(V16i32, @splat(@as(i32, coef[j])));
+    return acc;
+}
+
+inline fn toU8(v: V16i32) V16u8 {
+    const cl: V16i32 = @max(@min(v, @as(V16i32, @splat(255))), @as(V16i32, @splat(0)));
+    return @truncate(@as(@Vector(16, u32), @bitCast(cl)));
+}
+
+pub fn planeRow(c: *Ctx, d: [*]u8, w: usize, rows: []const [*]const i16, coef: []const i16) bool {
+    _ = c;
+    var i: usize = 0;
+    if (rows.len == 1) {
+        const r = rows[0];
+        while (i + 16 <= w) : (i += 16) {
+            d[i..][0..16].* = toU8((ld16(r + i) +% @as(V16i32, @splat(64))) >> @splat(7));
+        }
+        while (i < w) : (i += 1) d[i] = @intCast(std.math.clamp((@as(i32, r[i]) + 64) >> 7, 0, 255));
+        return true;
+    }
+    while (i + 16 <= w) : (i += 16) {
+        d[i..][0..16].* = toU8(vsum(rows, coef, i, 64 << 12) >> @splat(19));
+    }
+    while (i < w) : (i += 1) {
+        var val: i32 = 64 << 12;
+        for (rows, 0..) |r, j| val += @as(i32, r[i]) * coef[j];
+        d[i] = @intCast(std.math.clamp(val >> 19, 0, 255));
+    }
+    return true;
+}
+
+fn pair16Mask() @Vector(32, i32) {
+    var mk: [32]i32 = undefined;
+    for (0..16) |p| {
+        mk[2 * p] = @intCast(p);
+        mk[2 * p + 1] = ~@as(i32, @intCast(p));
+    }
+    return mk;
+}
+
+pub fn nvRow(c: *Ctx, d: [*]u8, w: usize, ru: []const [*]const i16, rv: []const [*]const i16, coef: []const i16) bool {
+    const swap = c.dstF == m.NV21;
+    var i: usize = 0;
+    while (i + 16 <= w) : (i += 16) {
+        const u = toU8(vsum(ru, coef, i, 64 << 12) >> @splat(19));
+        const v = toU8(vsum(rv, coef, i, 64 << 12) >> @splat(19));
+        const out: V32u8 = if (swap) @shuffle(u8, v, u, pair16Mask()) else @shuffle(u8, u, v, pair16Mask());
+        d[2 * i ..][0..32].* = out;
+    }
+    while (i < w) : (i += 1) {
+        var u: i32 = 64 << 12;
+        var v: i32 = 64 << 12;
+        for (0..coef.len) |j| {
+            u += @as(i32, ru[j][i]) * coef[j];
+            v += @as(i32, rv[j][i]) * coef[j];
+        }
+        d[2 * i + @intFromBool(swap)] = @intCast(std.math.clamp(u >> 19, 0, 255));
+        d[2 * i + @intFromBool(!swap)] = @intCast(std.math.clamp(v >> 19, 0, 255));
+    }
+    return true;
+}
+
+// ── RGB input conversion ──
+fn chanMask(comptime n: usize, comptime bpp: usize, comptime off: usize, comptime step: usize) @Vector(n, i32) {
+    var mk: [n]i32 = undefined;
+    for (0..n) |p| mk[p] = @intCast(p * step * bpp + off);
+    return mk;
+}
+
+inline fn loadChan(comptime bpp: usize, comptime off: usize, comptime step: usize, s: [*]const u8) V16i32 {
+    const v: @Vector(16 * bpp * step, u8) = s[0 .. 16 * bpp * step].*;
+    const ch: V16u8 = @shuffle(u8, v, undefined, chanMask(16, bpp, off, step));
+    return ch;
+}
+
+fn yLine(comptime bpp: usize, comptime ro: usize, comptime bo: usize, d: [*]u16, s: [*]const u8, w: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= w) : (i += 16) {
+        const r = loadChan(bpp, ro, 1, s + i * bpp);
+        const g = loadChan(bpp, 1, 1, s + i * bpp);
+        const b = loadChan(bpp, bo, 1, s + i * bpp);
+        const y = (r * @as(V16i32, @splat(m.RY)) + g * @as(V16i32, @splat(m.GY)) + b * @as(V16i32, @splat(m.BY)) + @as(V16i32, @splat((32 << 14) + (1 << 8)))) >> @splat(9);
+        d[i..][0..16].* = @as(V16u16, @truncate(@as(@Vector(16, u32), @bitCast(y))));
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = s[i * bpp + ro];
+        const g: i32 = s[i * bpp + 1];
+        const b: i32 = s[i * bpp + bo];
+        d[i] = @intCast((m.RY * r + m.GY * g + m.BY * b + (32 << 14) + (1 << 8)) >> 9);
+    }
+}
+
+fn uvLine(comptime bpp: usize, comptime ro: usize, comptime bo: usize, comptime half: bool, du: [*]u16, dv: [*]u16, s: [*]const u8, w: usize) void {
+    const step: usize = if (half) 2 else 1;
+    const sh: u5 = if (half) 10 else 9;
+    const K: i32 = if (half) (256 << 15) + (1 << 9) else (256 << 14) + (1 << 8);
+    var i: usize = 0;
+    while (i + 16 <= w) : (i += 16) {
+        const base = s + i * bpp * step;
+        var r = loadChan(bpp, ro, step, base);
+        var g = loadChan(bpp, 1, step, base);
+        var b = loadChan(bpp, bo, step, base);
+        if (half) {
+            r += loadChan(bpp, ro + bpp, step, base);
+            g += loadChan(bpp, 1 + bpp, step, base);
+            b += loadChan(bpp, bo + bpp, step, base);
+        }
+        const u = (r * @as(V16i32, @splat(m.RU)) + g * @as(V16i32, @splat(m.GU)) + b * @as(V16i32, @splat(m.BU)) + @as(V16i32, @splat(K))) >> @splat(sh);
+        const v = (r * @as(V16i32, @splat(m.RV)) + g * @as(V16i32, @splat(m.GV)) + b * @as(V16i32, @splat(m.BV)) + @as(V16i32, @splat(K))) >> @splat(sh);
+        du[i..][0..16].* = @as(V16u16, @truncate(@as(@Vector(16, u32), @bitCast(u))));
+        dv[i..][0..16].* = @as(V16u16, @truncate(@as(@Vector(16, u32), @bitCast(v))));
+    }
+    while (i < w) : (i += 1) {
+        var r: i32 = s[i * step * bpp + ro];
+        var g: i32 = s[i * step * bpp + 1];
+        var b: i32 = s[i * step * bpp + bo];
+        if (half) {
+            r += s[(2 * i + 1) * bpp + ro];
+            g += s[(2 * i + 1) * bpp + 1];
+            b += s[(2 * i + 1) * bpp + bo];
+        }
+        du[i] = @intCast((m.RU * r + m.GU * g + m.BU * b + K) >> sh);
+        dv[i] = @intCast((m.RV * r + m.GV * g + m.BV * b + K) >> sh);
+    }
+}
+
+// in-lane variant for 3-byte pixels: each 128-bit lane holds 4 pixels (12 bytes);
+// pshufb builds (r,g) and (b,0) 16-bit pairs, pmaddwd applies the coefficients.
+fn laneRG(comptime ro: usize, comptime bo: usize, comptime which: u8) @Vector(32, i32) {
+    var mk: [32]i32 = undefined;
+    for (0..2) |l| {
+        for (0..4) |p| {
+            const base: i32 = @intCast(l * 16 + p * 3);
+            if (which == 0) {
+                mk[l * 16 + p * 4 + 0] = base + @as(i32, @intCast(ro));
+                mk[l * 16 + p * 4 + 1] = -1;
+                mk[l * 16 + p * 4 + 2] = base + 1;
+                mk[l * 16 + p * 4 + 3] = -1;
+            } else {
+                mk[l * 16 + p * 4 + 0] = base + @as(i32, @intCast(bo));
+                mk[l * 16 + p * 4 + 1] = -1;
+                mk[l * 16 + p * 4 + 2] = -1;
+                mk[l * 16 + p * 4 + 3] = -1;
+            }
+        }
+    }
+    return mk;
+}
+
+fn yLine3(comptime ro: usize, comptime bo: usize, d: [*]u16, s: [*]const u8, w: usize) void {
+    const z: V32u8 = @splat(0);
+    const crg = comptime blk: {
+        var t: [16]i16 = undefined;
+        for (0..8) |k| {
+            t[2 * k] = m.RY;
+            t[2 * k + 1] = m.GY;
+        }
+        break :blk t;
+    };
+    const cb = comptime blk: {
+        var t: [16]i16 = undefined;
+        for (0..8) |k| {
+            t[2 * k] = m.BY;
+            t[2 * k + 1] = 0;
+        }
+        break :blk t;
+    };
+    var i: usize = 0;
+    while ((i + 8) * 3 + 4 <= w * 3) : (i += 8) {
+        const lo: V16u8 = s[i * 3 ..][0..16].*;
+        const hi: V16u8 = s[i * 3 + 12 ..][0..16].*;
+        const v: V32u8 = std.simd.join(lo, hi);
+        const rg: V16i16 = @bitCast(@shuffle(u8, v, z, laneRG(ro, bo, 0)));
+        const bz: V16i16 = @bitCast(@shuffle(u8, v, z, laneRG(ro, bo, 1)));
+        const y = (madd16(rg, crg) + madd16(bz, cb) + @as(V8i32, @splat((32 << 14) + (1 << 8)))) >> @splat(9);
+        d[i..][0..8].* = @as(@Vector(8, u16), @intCast(y));
+    }
+    while (i < w) : (i += 1) {
+        const r: i32 = s[i * 3 + ro];
+        const g: i32 = s[i * 3 + 1];
+        const b: i32 = s[i * 3 + bo];
+        d[i] = @intCast((m.RY * r + m.GY * g + m.BY * b + (32 << 14) + (1 << 8)) >> 9);
+    }
+}
+
+pub fn rgbToYLine(c: *Ctx, d: [*]u16, s: [*]const u8, w: usize) bool {
+    switch (c.srcF) {
+        m.RGB24 => yLine3(0, 2, d, s, w),
+        m.BGR24 => yLine3(2, 0, d, s, w),
+        m.RGBA => yLine(4, 0, 2, d, s, w),
+        else => yLine(4, 2, 0, d, s, w),
+    }
+    return true;
+}
+pub fn rgbToUVLine(c: *Ctx, du: [*]u16, dv: [*]u16, s: [*]const u8, w: usize) bool {
+    switch (c.srcF) {
+        m.RGB24 => uvLine(3, 0, 2, false, du, dv, s, w),
+        m.BGR24 => uvLine(3, 2, 0, false, du, dv, s, w),
+        m.RGBA => uvLine(4, 0, 2, false, du, dv, s, w),
+        else => uvLine(4, 2, 0, false, du, dv, s, w),
+    }
+    return true;
+}
+pub fn rgbToUVHalfLine(c: *Ctx, du: [*]u16, dv: [*]u16, s: [*]const u8, w: usize) bool {
+    switch (c.srcF) {
+        m.RGB24 => uvLine(3, 0, 2, true, du, dv, s, w),
+        m.BGR24 => uvLine(3, 2, 0, true, du, dv, s, w),
+        m.RGBA => uvLine(4, 0, 2, true, du, dv, s, w),
+        else => uvLine(4, 2, 0, true, du, dv, s, w),
+    }
+    return true;
+}
+
+// ── horizontal scaling ──
+fn isIdentity(f: *const Filter, w: usize, one: i16) bool {
+    if (f.size != 1) return false;
+    for (0..w) |i| {
+        if (f.pos[i] != @as(i32, @intCast(i)) or f.coef[i] != one) return false;
+    }
+    return true;
+}
+
+fn hScaleT(comptime T: type, comptime fs: usize, comptime sh: u5, d: []i16, w: usize, s: [*]const T, f: *const Filter) void {
+    const pos = f.pos.ptr;
+    const co = f.coef.ptr;
+    for (0..w) |i| {
+        const p: usize = @intCast(pos[i]);
+        var val: i32 = 0;
+        inline for (0..fs) |j| val += @as(i32, s[p + j]) * co[i * fs + j];
+        d[i] = @intCast(@min(val >> sh, 32767));
+    }
+}
+
+fn hScaleAny(comptime T: type, comptime sh: u5, d: []i16, w: usize, s: [*]const T, f: *const Filter) void {
+    switch (f.size) {
+        1 => hScaleT(T, 1, sh, d, w, s, f),
+        2 => hScaleT(T, 2, sh, d, w, s, f),
+        3 => hScaleT(T, 3, sh, d, w, s, f),
+        4 => hScaleT(T, 4, sh, d, w, s, f),
+        5 => hScaleT(T, 5, sh, d, w, s, f),
+        6 => hScaleT(T, 6, sh, d, w, s, f),
+        7 => hScaleT(T, 7, sh, d, w, s, f),
+        8 => hScaleT(T, 8, sh, d, w, s, f),
+        else => {
+            const fs = f.size;
+            for (0..w) |i| {
+                const p: usize = @intCast(f.pos[i]);
+                var val: i32 = 0;
+                for (0..fs) |j| val += @as(i32, s[p + j]) * f.coef[i * fs + j];
+                d[i] = @intCast(@min(val >> sh, 32767));
+            }
+        },
+    }
+}
+
+pub const PadFilter = struct {
+    fsP: usize = 0,
+    coef: []i16 = &.{},
+};
+
+pub fn makePad(f: *const Filter, w: usize) PadFilter {
+    const fsP: usize = if (f.size <= 2) 2 else if (f.size <= 4) 4 else if (f.size <= 8) 8 else return .{};
+    const co = std.heap.c_allocator.alloc(i16, (w + 16) * fsP) catch return .{};
+    @memset(co, 0);
+    for (0..w) |i| {
+        for (0..f.size) |j| co[i * fsP + j] = f.coef[i * f.size + j];
+    }
+    return .{ .fsP = fsP, .coef = co };
+}
+
+inline fn madd16(a: V16i16, b: V16i16) V8i32 {
+    const p: V16i32 = @as(V16i32, a) * @as(V16i32, b);
+    const ev = @shuffle(i32, p, undefined, [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 });
+    const od = @shuffle(i32, p, undefined, [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 });
+    return ev + od;
+}
+
+fn hScaleVec(comptime fsP: usize, comptime sh: u5, d: []i16, w: usize, s: [*]const u16, posn: [*]const i32, co: [*]const i16) usize {
+    // volatile: keep the per-output position loads scalar (cheaper than vector extracts)
+    const pos: [*]const volatile i32 = @ptrCast(posn);
+    const sb: [*]const u8 = @ptrCast(s);
+    var i: usize = 0;
+    while (i + 8 <= w) : (i += 8) {
+        var acc: V8i32 = @splat(0);
+        if (fsP == 2) {
+            var v: @Vector(8, u32) = undefined;
+            inline for (0..8) |k| v[k] = std.mem.readInt(u32, sb[@as(usize, @intCast(pos[i + k])) * 2 ..][0..4], .little);
+            acc = madd16(@bitCast(v), co[i * 2 ..][0..16].*);
+        } else if (fsP == 8) {
+            var mm: [8]@Vector(4, i32) = undefined;
+            inline for (0..8) |k| {
+                const p: usize = @intCast(pos[i + k]);
+                const v: @Vector(8, i16) = @bitCast(@as(@Vector(16, u8), sb[p * 2 ..][0..16].*));
+                const cv: @Vector(8, i16) = co[(i + k) * 8 ..][0..8].*;
+                const pr: @Vector(8, i32) = @as(@Vector(8, i32), v) * @as(@Vector(8, i32), cv);
+                mm[k] = @shuffle(i32, pr, undefined, [4]i32{ 0, 2, 4, 6 }) + @shuffle(i32, pr, undefined, [4]i32{ 1, 3, 5, 7 });
+            }
+            var sm: [4]@Vector(4, i32) = undefined;
+            inline for (0..4) |q| {
+                sm[q] = @shuffle(i32, mm[2 * q], mm[2 * q + 1], [4]i32{ 0, 2, ~@as(i32, 0), ~@as(i32, 2) }) +
+                    @shuffle(i32, mm[2 * q], mm[2 * q + 1], [4]i32{ 1, 3, ~@as(i32, 1), ~@as(i32, 3) });
+            }
+            const t0 = @shuffle(i32, sm[0], sm[1], [4]i32{ 0, 2, ~@as(i32, 0), ~@as(i32, 2) }) +
+                @shuffle(i32, sm[0], sm[1], [4]i32{ 1, 3, ~@as(i32, 1), ~@as(i32, 3) });
+            const t1 = @shuffle(i32, sm[2], sm[3], [4]i32{ 0, 2, ~@as(i32, 0), ~@as(i32, 2) }) +
+                @shuffle(i32, sm[2], sm[3], [4]i32{ 1, 3, ~@as(i32, 1), ~@as(i32, 3) });
+            acc = std.simd.join(t0, t1);
+        } else {
+            inline for (0..fsP / 4) |q| {
+                var lo: @Vector(4, u64) = undefined;
+                var hi: @Vector(4, u64) = undefined;
+                inline for (0..4) |k| {
+                    lo[k] = std.mem.readInt(u64, sb[(@as(usize, @intCast(pos[i + k])) + q * 4) * 2 ..][0..8], .little);
+                    hi[k] = std.mem.readInt(u64, sb[(@as(usize, @intCast(pos[i + 4 + k])) + q * 4) * 2 ..][0..8], .little);
+                }
+                // per output: 4 taps -> two pair sums; lanes ordered output-major
+                const cl: V16i16 = blk: {
+                    var t: [16]i16 = undefined;
+                    inline for (0..4) |k| inline for (0..4) |j| {
+                        t[k * 4 + j] = co[(i + k) * fsP + q * 4 + j];
+                    };
+                    break :blk t;
+                };
+                const chh: V16i16 = blk: {
+                    var t: [16]i16 = undefined;
+                    inline for (0..4) |k| inline for (0..4) |j| {
+                        t[k * 4 + j] = co[(i + 4 + k) * fsP + q * 4 + j];
+                    };
+                    break :blk t;
+                };
+                const pl = madd16(@bitCast(lo), cl); // 8 lanes: out0a,out0b,out1a,...
+                const ph = madd16(@bitCast(hi), chh);
+                const both: V16i32 = std.simd.join(pl, ph);
+                const ev = @shuffle(i32, both, undefined, [8]i32{ 0, 2, 4, 6, 8, 10, 12, 14 });
+                const od = @shuffle(i32, both, undefined, [8]i32{ 1, 3, 5, 7, 9, 11, 13, 15 });
+                acc += ev + od;
+            }
+        }
+        const r = @min(acc >> @splat(sh), @as(V8i32, @splat(32767)));
+        d[i..][0..8].* = @as(@Vector(8, i16), @intCast(r));
+    }
+    return i;
+}
+
+// Per-group pattern kernels for 2-tap filters: kind 1 = stride 2, 2 = rel [0,0,1,1,..], 3 = rel [0,1,1,2,..]
+pub const GroupFilter = struct {
+    kind: []u8 = &.{},
+};
+
+pub fn makeGroups(f: *const Filter, w: usize, pf: *const PadFilter) GroupFilter {
+    if (pf.fsP != 2 or w < 8) return .{};
+    const ng = w / 8;
+    const kind = std.heap.c_allocator.alloc(u8, ng) catch return .{};
+    var any = false;
+    const pa = [8]i32{ 0, 0, 1, 1, 2, 2, 3, 3 };
+    const pb = [8]i32{ 0, 1, 1, 2, 2, 3, 3, 4 };
+    for (0..ng) |g| {
+        var k1 = true;
+        var k2 = true;
+        var k3 = true;
+        for (0..8) |k| {
+            const rel = f.pos[g * 8 + k] - f.pos[g * 8];
+            if (rel != 2 * @as(i32, @intCast(k))) k1 = false;
+            if (rel != pa[k]) k2 = false;
+            if (rel != pb[k]) k3 = false;
+        }
+        kind[g] = if (k1) 1 else if (k2) 2 else if (k3) 3 else 0;
+        if (kind[g] != 0) any = true;
+    }
+    if (!any) {
+        std.heap.c_allocator.free(kind);
+        return .{};
+    }
+    return .{ .kind = kind };
+}
+
+inline fn ld8u32(p: [*]const u16) @Vector(8, u32) {
+    const b: [*]const u8 = @ptrCast(p);
+    return @bitCast(@as(V32u8, b[0..32].*));
+}
+
+fn hScaleGroups2(comptime sh: u5, d: []i16, s: [*]const u16, posn: [*]const i32, co: [*]const i16, gf: *const GroupFilter) void {
+    const pos: [*]const volatile i32 = @ptrCast(posn);
+    const sb: [*]const u8 = @ptrCast(s);
+    for (gf.kind, 0..) |kd, g| {
+        const i = g * 8;
+        const p0: usize = @intCast(pos[i]);
+        var v: @Vector(8, u32) = undefined;
+        if (kd == 1) {
+            v = ld8u32(s + p0);
+        } else if (kd == 2) {
+            const w0 = ld8u32(s + p0);
+            const w1 = ld8u32(s + p0 + 1);
+            v = @shuffle(u32, w0, w1, [8]i32{ 0, 0, ~@as(i32, 0), ~@as(i32, 0), 1, 1, ~@as(i32, 1), ~@as(i32, 1) });
+        } else if (kd == 3) {
+            const w0 = ld8u32(s + p0);
+            const w1 = ld8u32(s + p0 + 1);
+            v = @shuffle(u32, w0, w1, [8]i32{ 0, ~@as(i32, 0), ~@as(i32, 0), 1, 1, ~@as(i32, 1), ~@as(i32, 1), 2 });
+        } else {
+            inline for (0..8) |k| v[k] = std.mem.readInt(u32, sb[@as(usize, @intCast(pos[i + k])) * 2 ..][0..4], .little);
+        }
+        const acc = madd16(@bitCast(v), co[i * 2 ..][0..16].*);
+        const r = @min(acc >> @splat(sh), @as(V8i32, @splat(32767)));
+        d[i..][0..8].* = @as(@Vector(8, i16), @intCast(r));
+    }
+}
+
+fn hScaleDispatch(c: *Ctx, comptime sh: u5, d: []i16, w: usize, s: [*]const u16, f: *const Filter) bool {
+    const pf = if (f == &c.hLum) &c.padL else &c.padC;
+    if (pf.fsP == 0) return false;
+    const gf = if (f == &c.hLum) &c.grpL else &c.grpC;
+    if (gf.kind.len != 0) {
+        hScaleGroups2(sh, d, s, f.pos.ptr, pf.coef.ptr, gf);
+        const fs = f.size;
+        for (gf.kind.len * 8..w) |i| {
+            const p: usize = @intCast(f.pos[i]);
+            var val: i32 = 0;
+            for (0..fs) |j| val += @as(i32, s[p + j]) * f.coef[i * fs + j];
+            d[i] = @intCast(@min(val >> sh, 32767));
+        }
+        return true;
+    }
+    const done = switch (pf.fsP) {
+        2 => hScaleVec(2, sh, d, w, s, f.pos.ptr, pf.coef.ptr),
+        4 => hScaleVec(4, sh, d, w, s, f.pos.ptr, pf.coef.ptr),
+        else => hScaleVec(8, sh, d, w, s, f.pos.ptr, pf.coef.ptr),
+    };
+    const fs = f.size;
+    for (done..w) |i| {
+        const p: usize = @intCast(f.pos[i]);
+        var val: i32 = 0;
+        for (0..fs) |j| val += @as(i32, s[p + j]) * f.coef[i * fs + j];
+        d[i] = @intCast(@min(val >> sh, 32767));
+    }
+    return true;
+}
+
+pub fn hScale16Row(c: *Ctx, d: []i16, w: usize, s: [*]const u16, f: *const Filter) bool {
+    const ident = if (f == &c.hLum) c.identL else c.identC;
+    if (ident) {
+        var i: usize = 0;
+        while (i + 16 <= w) : (i += 16) {
+            const v: V16u16 = s[i..][0..16].*;
+            const x: V16i32 = @intCast(v);
+            const y: V16i32 = @min(x * @as(V16i32, @splat(2)), @as(V16i32, @splat(32767)));
+            d[i..][0..16].* = @as(V16i16, @intCast(y));
+        }
+        while (i < w) : (i += 1) d[i] = @intCast(@min(@as(i32, s[i]) * 2, 32767));
+        return true;
+    }
+    if (hScaleDispatch(c, 13, d, w, s, f)) return true;
+    hScaleAny(u16, 13, d, w, s, f);
+    return true;
+}
+pub fn hScale8Row(c: *Ctx, d: []i16, w: usize, s: [*]const u8, f: *const Filter) bool {
+    const ident = if (f == &c.hLum) c.identL else c.identC;
+    if (ident) {
+        var i: usize = 0;
+        while (i + 16 <= w) : (i += 16) {
+            const v: V16u8 = s[i..][0..16].*;
+            const x: V16i16 = @intCast(v);
+            d[i..][0..16].* = x << @splat(7);
+        }
+        while (i < w) : (i += 1) d[i] = @as(i16, s[i]) << 7;
+        return true;
+    }
+    const pf = if (f == &c.hLum) &c.padL else &c.padC;
+    if (pf.fsP != 0) {
+        // widen the source row into a slack-padded u16 buffer, then use the vector kernel
+        const sw: usize = @intCast(if (f == &c.hLum) c.srcW else c.chrSrcW);
+        const wb = c.wide.ptr;
+        var i: usize = 0;
+        while (i + 16 <= sw) : (i += 16) wb[i..][0..16].* = @as(V16u16, s[i..][0..16].*);
+        while (i < sw) : (i += 1) wb[i] = s[i];
+        @memset(c.wide[sw .. sw + 16], 0);
+        if (hScaleDispatch(c, 7, d, w, wb, f)) return true;
+    }
+    hScaleAny(u8, 7, d, w, s, f);
+    return true;
+}
+
+// ── packed RGB output ──
+inline fn storePix(comptime f: i32, d: [*]u8, r: V16u8, g: V16u8, b: V16u8, a: V16u8) void {
+    switch (f) {
+        m.RGB24 => store3h(d, r, g, b),
+        m.BGR24 => store3h(d, b, g, r),
+        m.RGBA => store4h(d, r, g, b, a),
+        else => store4h(d, b, g, r, a),
+    }
+}
+fn rgb16Mask() @Vector(48, i32) {
+    var mk: [48]i32 = undefined;
+    for (0..16) |p| {
+        mk[3 * p] = @intCast(2 * p);
+        mk[3 * p + 1] = @intCast(2 * p + 1);
+        mk[3 * p + 2] = ~@as(i32, @intCast(p));
+    }
+    return mk;
+}
+fn quad16Mask() @Vector(64, i32) {
+    var mk: [64]i32 = undefined;
+    for (0..16) |p| {
+        mk[4 * p] = @intCast(2 * p);
+        mk[4 * p + 1] = @intCast(2 * p + 1);
+        mk[4 * p + 2] = ~@as(i32, @intCast(2 * p));
+        mk[4 * p + 3] = ~@as(i32, @intCast(2 * p + 1));
+    }
+    return mk;
+}
+inline fn store3h(d: [*]u8, c0: V16u8, c1: V16u8, c2: V16u8) void {
+    const p01: V32u8 = @shuffle(u8, c0, c1, pair16Mask());
+    const out: @Vector(48, u8) = @shuffle(u8, p01, c2, rgb16Mask());
+    d[0..48].* = out;
+}
+inline fn store4h(d: [*]u8, c0: V16u8, c1: V16u8, c2: V16u8, c3: V16u8) void {
+    const p01: V32u8 = @shuffle(u8, c0, c1, pair16Mask());
+    const p23: V32u8 = @shuffle(u8, c2, c3, pair16Mask());
+    const out: @Vector(64, u8) = @shuffle(u8, p01, p23, quad16Mask());
+    d[0..64].* = out;
+}
+
+fn fullRowT(comptime f: i32, c: *Ctx, d: [*]u8, w: usize, kind: u8, yalpha: i32, uvalpha: i32,
+    lr: []const [*]const i16, cu: []const [*]const i16, cv: []const [*]const i16, ar: []const [*]const i16,
+    lco: []const i16, cco: []const i16, alpha: bool) usize {
+    const t = &c.tabs;
+    const bpp = m.rgbBpp(f);
+    var i: usize = 0;
+    const yoff: V16i32 = @splat(t.y_off);
+    const yc: V16i32 = @splat(t.y_coeff);
+    const v2r: V16i32 = @splat(t.v2r);
+    const v2g: V16i32 = @splat(t.v2g);
+    const u2g: V16i32 = @splat(t.u2g);
+    const u2b: V16i32 = @splat(t.u2b);
+    const lim: V16i32 = @splat((1 << 30) - 1);
+    const zero: V16i32 = @splat(0);
+    while (i + 16 <= w) : (i += 16) {
+        var Y: V16i32 = undefined;
+        var U: V16i32 = undefined;
+        var V: V16i32 = undefined;
+        var A: V16i32 = @splat(255);
+        if (kind == 1) {
+            Y = ld16(lr[0] + i) << @splat(2);
+            if (uvalpha < 2048) {
+                U = (ld16(cu[0] + i) - @as(V16i32, @splat(128 << 7))) << @splat(2);
+                V = (ld16(cv[0] + i) - @as(V16i32, @splat(128 << 7))) << @splat(2);
+            } else {
+                U = (ld16(cu[0] + i) + ld16(cu[1] + i) - @as(V16i32, @splat(128 << 8))) << @splat(1);
+                V = (ld16(cv[0] + i) + ld16(cv[1] + i) - @as(V16i32, @splat(128 << 8))) << @splat(1);
+            }
+            if (alpha) A = (ld16(ar[0] + i) + @as(V16i32, @splat(64))) >> @splat(7);
+        } else if (kind == 2) {
+            const ya: V16i32 = @splat(yalpha);
+            const ya1: V16i32 = @splat(4096 - yalpha);
+            Y = maddRows(ldv(lr[0] + i), ldv(lr[1] + i), 4096 - yalpha, yalpha) >> @splat(10);
+            U = (maddRows(ldv(cu[0] + i), ldv(cu[1] + i), 4096 - uvalpha, uvalpha) - @as(V16i32, @splat(128 << 19))) >> @splat(10);
+            V = (maddRows(ldv(cv[0] + i), ldv(cv[1] + i), 4096 - uvalpha, uvalpha) - @as(V16i32, @splat(128 << 19))) >> @splat(10);
+            if (alpha) A = (ld16(ar[0] + i) * ya1 + ld16(ar[1] + i) * ya + @as(V16i32, @splat(1 << 18))) >> @splat(19);
+        } else {
+            Y = vsum(lr, lco, i, 1 << 9) >> @splat(10);
+            U = vsum(cu, cco, i, (1 << 9) - (128 << 19)) >> @splat(10);
+            V = vsum(cv, cco, i, (1 << 9) - (128 << 19)) >> @splat(10);
+            if (alpha) A = vsum(ar, lco, i, 1 << 18) >> @splat(19);
+        }
+        const Yp = (Y -% yoff) *% yc +% @as(V16i32, @splat(1 << 21));
+        const R = @max(@min(Yp +% V *% v2r, lim), zero) >> @splat(22);
+        const G = @max(@min(Yp +% V *% v2g +% U *% u2g, lim), zero) >> @splat(22);
+        const B = @max(@min(Yp +% U *% u2b, lim), zero) >> @splat(22);
+        storePix(f, d + i * bpp, toU8(R), toU8(G), toU8(B), toU8(A));
+    }
+    return i;
+}
+
+inline fn narrow(v: V16i32) V16i16 {
+    return @truncate(v);
+}
+
+fn halfRowT(comptime f: i32, c: *Ctx, d: [*]u8, w: usize, kind: u8, yalpha: i32, uvalpha: i32,
+    lr: []const [*]const i16, cu: []const [*]const i16, cv: []const [*]const i16,
+    lco: []const i16, cco: []const i16) usize {
+    const t = &c.tabs;
+    const bpp = m.rgbBpp(f);
+    const mcr = mulConst(t.crv);
+    const mcgu = mulConst(t.cgu);
+    const mcgv = mulConst(t.cgv);
+    const mcb = mulConst(t.cbu);
+    const rvc: i16 = @intCast(326 - (t.crv >> 9));
+    const guc: i16 = @intCast(326 - (t.cgu >> 9) - (t.cgv >> 9));
+    const buc: i16 = @intCast(326 - (t.cbu >> 9));
+    const c255: V16i32 = @splat(255);
+    const c0: V16i32 = @splat(0);
+    var p: usize = 0; // pair index
+    while (2 * p + 32 <= w) : (p += 16) {
+        var y0: V16i32 = undefined;
+        var y1: V16i32 = undefined;
+        var U: V16i32 = undefined;
+        var V: V16i32 = undefined;
+        const li = 2 * p;
+        if (kind == 1) {
+            y0 = (ld16(lr[0] + li) + @as(V16i32, @splat(64))) >> @splat(7);
+            y1 = (ld16(lr[0] + li + 16) + @as(V16i32, @splat(64))) >> @splat(7);
+            if (uvalpha < 2048) {
+                U = (ld16(cu[0] + p) + @as(V16i32, @splat(64))) >> @splat(7);
+                V = (ld16(cv[0] + p) + @as(V16i32, @splat(64))) >> @splat(7);
+            } else {
+                U = (ld16(cu[0] + p) + ld16(cu[1] + p) + @as(V16i32, @splat(128))) >> @splat(8);
+                V = (ld16(cv[0] + p) + ld16(cv[1] + p) + @as(V16i32, @splat(128))) >> @splat(8);
+            }
+        } else if (kind == 2) {
+            const ya: V16i32 = @splat(yalpha);
+            const ya1: V16i32 = @splat(4096 - yalpha);
+            const ua: V16i32 = @splat(uvalpha);
+            const ua1: V16i32 = @splat(4096 - uvalpha);
+            y0 = (ld16(lr[0] + li) * ya1 + ld16(lr[1] + li) * ya) >> @splat(19);
+            y1 = (ld16(lr[0] + li + 16) * ya1 + ld16(lr[1] + li + 16) * ya) >> @splat(19);
+            U = (ld16(cu[0] + p) * ua1 + ld16(cu[1] + p) * ua) >> @splat(19);
+            V = (ld16(cv[0] + p) * ua1 + ld16(cv[1] + p) * ua) >> @splat(19);
+        } else {
+            y0 = vsum(lr, lco, li, 1 << 18) >> @splat(19);
+            y1 = vsum(lr, lco, li + 16, 1 << 18) >> @splat(19);
+            U = vsum(cu, cco, p, 1 << 18) >> @splat(19);
+            V = vsum(cv, cco, p, 1 << 18) >> @splat(19);
+        }
+        const u = narrow(@max(@min(U, c255), c0));
+        const v = narrow(@max(@min(V, c255), c0));
+        const kr = mulShift16(v, mcr) +% spl16(rvc);
+        const kg = mulShift16(u, mcgu) +% mulShift16(v, mcgv) +% spl16(guc);
+        const kb = mulShift16(u, mcb) +% spl16(buc);
+        const ya = narrow(y0);
+        const yb = narrow(y1);
+        const R = packU8(curveK(ya +% @shuffle(i16, kr, undefined, dupLoMask())), curveK(yb +% @shuffle(i16, kr, undefined, dupHiMask())));
+        const G = packU8(curveK(ya +% @shuffle(i16, kg, undefined, dupLoMask())), curveK(yb +% @shuffle(i16, kg, undefined, dupHiMask())));
+        const B = packU8(curveK(ya +% @shuffle(i16, kb, undefined, dupLoMask())), curveK(yb +% @shuffle(i16, kb, undefined, dupHiMask())));
+        const o = d + 2 * p * bpp;
+        switch (f) {
+            m.RGB24 => {
+                store3h(o, std.simd.extract(R, 0, 16), std.simd.extract(G, 0, 16), std.simd.extract(B, 0, 16));
+                store3h(o + 48, std.simd.extract(R, 16, 16), std.simd.extract(G, 16, 16), std.simd.extract(B, 16, 16));
+            },
+            m.BGR24 => {
+                store3h(o, std.simd.extract(B, 0, 16), std.simd.extract(G, 0, 16), std.simd.extract(R, 0, 16));
+                store3h(o + 48, std.simd.extract(B, 16, 16), std.simd.extract(G, 16, 16), std.simd.extract(R, 16, 16));
+            },
+            m.RGBA => store4(o, R, G, B, @splat(255)),
+            else => store4(o, B, G, R, @splat(255)),
+        }
+    }
+    return 2 * p;
+}
+
+fn halfRow(c: *Ctx, d: [*]u8, dstY: usize, kind: u8, yalpha: i32, uvalpha: i32) bool {
+    const dw: usize = @intCast(c.dstW);
+    if (dw < 32 or (dw & 1) != 0 or c.tabs.full) return false;
+    const lf = &c.vLum;
+    const cf = &c.vChr;
+    const cy = dstY >> c.chrDstVSub;
+    const lpos: usize = @intCast(lf.pos[dstY]);
+    const cpos: usize = @intCast(cf.pos[cy]);
+    const lfs = lf.size;
+    const cfs = cf.size;
+    if (lfs > 64 or cfs > 64) return false;
+    const lco = lf.coef[dstY * lfs .. dstY * lfs + lfs];
+    const cco = cf.coef[cy * cfs .. cy * cfs + cfs];
+    var lr: [64][*]const i16 = undefined;
+    var cu: [64][*]const i16 = undefined;
+    var cv: [64][*]const i16 = undefined;
+    for (0..lfs) |j| lr[j] = c.lumBuf.ptr + (lpos + j) * c.lumStride;
+    for (0..cfs) |j| {
+        cu[j] = c.chrUBuf.ptr + (cpos + j) * c.chrStride;
+        cv[j] = c.chrVBuf.ptr + (cpos + j) * c.chrStride;
+    }
+    var off: usize = 0;
+    while (true) {
+        const rem = dw - off;
+        const n = if (rem >= 32) rem - rem % 32 else 32;
+        const st = if (rem >= 32) off else dw - 32;
+        var lr2: [64][*]const i16 = undefined;
+        var cu2: [64][*]const i16 = undefined;
+        var cv2: [64][*]const i16 = undefined;
+        for (0..lfs) |j| lr2[j] = lr[j] + st;
+        for (0..cfs) |j| {
+            cu2[j] = cu[j] + st / 2;
+            cv2[j] = cv[j] + st / 2;
+        }
+        const args = .{ c, d + st * m.rgbBpp(c.dstF), n, kind, yalpha, uvalpha, lr2[0..lfs], cu2[0..cfs], cv2[0..cfs], lco, cco };
+        _ = switch (c.dstF) {
+            m.RGB24 => @call(.auto, halfRowT, .{m.RGB24} ++ args),
+            m.BGR24 => @call(.auto, halfRowT, .{m.BGR24} ++ args),
+            m.RGBA => @call(.auto, halfRowT, .{m.RGBA} ++ args),
+            else => @call(.auto, halfRowT, .{m.BGRA} ++ args),
+        };
+        if (rem >= 32 and rem % 32 != 0) {
+            off += n;
+            continue;
+        }
+        break;
+    }
+    return true;
+}
+
+pub fn packedRow(c: *Ctx, d: [*]u8, dstY: usize, kind: u8, yalpha: i32, uvalpha: i32) bool {
+    if (!c.fullChrOut) return halfRow(c, d, dstY, kind, yalpha, uvalpha);
+    const dw: usize = @intCast(c.dstW);
+    if (dw < 16) return false;
+    const lf = &c.vLum;
+    const cf = &c.vChr;
+    const cy = dstY >> c.chrDstVSub;
+    const lpos: usize = @intCast(lf.pos[dstY]);
+    const cpos: usize = @intCast(cf.pos[cy]);
+    const lfs = lf.size;
+    const cfs = cf.size;
+    if (lfs > 64 or cfs > 64) return false;
+    const lco = lf.coef[dstY * lfs .. dstY * lfs + lfs];
+    const cco = cf.coef[cy * cfs .. cy * cfs + cfs];
+    var lr: [64][*]const i16 = undefined;
+    var ar: [64][*]const i16 = undefined;
+    var cu: [64][*]const i16 = undefined;
+    var cv: [64][*]const i16 = undefined;
+    for (0..lfs) |j| {
+        lr[j] = c.lumBuf.ptr + (lpos + j) * c.lumStride;
+        if (c.needAlpha) ar[j] = c.alpBuf.ptr + (lpos + j) * c.lumStride;
+    }
+    for (0..cfs) |j| {
+        cu[j] = if (c.needsHc) c.chrUBuf.ptr + (cpos + j) * c.chrStride else c.chrUBuf.ptr;
+        cv[j] = if (c.needsHc) c.chrVBuf.ptr + (cpos + j) * c.chrStride else c.chrVBuf.ptr;
+    }
+    const args = .{ c, d, dw, kind, yalpha, uvalpha, lr[0..lfs], cu[0..cfs], cv[0..cfs], ar[0..lfs], lco, cco, c.needAlpha };
+    const done = switch (c.dstF) {
+        m.RGB24 => @call(.auto, fullRowT, .{m.RGB24} ++ args),
+        m.BGR24 => @call(.auto, fullRowT, .{m.BGR24} ++ args),
+        m.RGBA => @call(.auto, fullRowT, .{m.RGBA} ++ args),
+        else => @call(.auto, fullRowT, .{m.BGRA} ++ args),
+    };
+    // finish the tail with the scalar writer: redo the last 16 pixels fully vectorized
+    if (done < dw) {
+        const bpp = m.rgbBpp(c.dstF);
+        const back = dw - 16;
+        // recompute last 16 pixels by offsetting all row pointers
+        var lr2: [64][*]const i16 = undefined;
+        var ar2: [64][*]const i16 = undefined;
+        var cu2: [64][*]const i16 = undefined;
+        var cv2: [64][*]const i16 = undefined;
+        for (0..lfs) |j| {
+            lr2[j] = lr[j] + back;
+            if (c.needAlpha) ar2[j] = ar[j] + back;
+        }
+        for (0..cfs) |j| {
+            cu2[j] = cu[j] + back;
+            cv2[j] = cv[j] + back;
+        }
+        const args2 = .{ c, d + back * bpp, @as(usize, 16), kind, yalpha, uvalpha, lr2[0..lfs], cu2[0..cfs], cv2[0..cfs], ar2[0..lfs], lco, cco, c.needAlpha };
+        _ = switch (c.dstF) {
+            m.RGB24 => @call(.auto, fullRowT, .{m.RGB24} ++ args2),
+            m.BGR24 => @call(.auto, fullRowT, .{m.BGR24} ++ args2),
+            m.RGBA => @call(.auto, fullRowT, .{m.RGBA} ++ args2),
+            else => @call(.auto, fullRowT, .{m.BGRA} ++ args2),
+        };
+    }
+    return true;
+}
+
+pub fn dbl(d: []i16, s: [*]const u16, w: usize) void {
+    var i: usize = 0;
+    while (i + 16 <= w) : (i += 16) {
+        const v: V16u16 = s[i..][0..16].*;
+        const x: V16i32 = @intCast(v);
+        const y: V16i32 = @min(x * @as(V16i32, @splat(2)), @as(V16i32, @splat(32767)));
+        d[i..][0..16].* = @as(V16i16, @intCast(y));
+    }
+    while (i < w) : (i += 1) d[i] = @intCast(@min(@as(i32, s[i]) * 2, 32767));
+}
diff --git a/bak/final_src/main.zig b/bak/final_src/main.zig
new file mode 100644
--- /dev/null
+++ b/bak/final_src/main.zig
@@ -0,0 +1,1184 @@
+// main.zig — swscale candidate: pixel-format conversion and scaling.
+//
+// The generic path mirrors FFmpeg's scalar pipeline (input conversion ->
+// horizontal filter into 15-bit intermediates -> vertical filter / output),
+// integer-exact, so results track the reference.  Same-size special cases
+// mirror FFmpeg's unscaled converters.  Hot paths use @Vector SIMD (fast.zig).
+
+const std = @import("std");
+const fast = @import("fast.zig");
+const alloc = std.heap.c_allocator;
+
+pub const YUV420P = 0;
+pub const YUV422P = 1;
+pub const YUV444P = 2;
+pub const NV12 = 3;
+pub const NV21 = 4;
+pub const RGB24 = 5;
+pub const BGR24 = 6;
+pub const RGBA = 7;
+pub const BGRA = 8;
+pub const GRAY8 = 9;
+
+const ALGO_NEAREST = 0;
+const ALGO_BILINEAR = 1;
+const ALGO_BICUBIC = 2;
+
+pub fn isRGB(f: i32) bool {
+    return f >= RGB24 and f <= BGRA;
+}
+fn isGray(f: i32) bool {
+    return f == GRAY8;
+}
+fn isPlanarYUV(f: i32) bool {
+    return f <= NV21;
+}
+fn isSemiPlanar(f: i32) bool {
+    return f == NV12 or f == NV21;
+}
+fn hasAlpha(f: i32) bool {
+    return f == RGBA or f == BGRA;
+}
+pub fn rgbBpp(f: i32) usize {
+    return if (f == RGB24 or f == BGR24) 3 else 4;
+}
+// byte offsets of R, G, B within a packed pixel
+pub fn rOff(f: i32) usize {
+    return if (f == RGB24 or f == RGBA) 0 else 2;
+}
+pub fn bOff(f: i32) usize {
+    return if (f == RGB24 or f == RGBA) 2 else 0;
+}
+fn hsub(f: i32) u5 {
+    return switch (f) {
+        YUV420P, YUV422P, NV12, NV21 => 1,
+        else => 0,
+    };
+}
+fn vsub(f: i32) u5 {
+    return switch (f) {
+        YUV420P, NV12, NV21 => 1,
+        else => 0,
+    };
+}
+fn ceilShift(x: i32, s: u5) i32 {
+    return -((-x) >> s);
+}
+
+// ── rgb->yuv coefficients (FFmpeg default BT.601 table, RGB2YUV_SHIFT 15) ──
+pub const RY: i32 = @intFromFloat(0.299 * 219.0 / 255.0 * 32768.0 + 0.5);
+pub const GY: i32 = @intFromFloat(0.587 * 219.0 / 255.0 * 32768.0 + 0.5);
+pub const BY: i32 = @intFromFloat(0.114 * 219.0 / 255.0 * 32768.0 + 0.5);
+pub const RU: i32 = -@as(i32, @intFromFloat(0.169 * 224.0 / 255.0 * 32768.0 + 0.5));
+pub const GU: i32 = -@as(i32, @intFromFloat(0.331 * 224.0 / 255.0 * 32768.0 + 0.5));
+pub const BU: i32 = @intFromFloat(0.500 * 224.0 / 255.0 * 32768.0 + 0.5);
+pub const RV: i32 = @intFromFloat(0.500 * 224.0 / 255.0 * 32768.0 + 0.5);
+pub const GV: i32 = -@as(i32, @intFromFloat(0.419 * 224.0 / 255.0 * 32768.0 + 0.5));
+pub const BV: i32 = -@as(i32, @intFromFloat(0.081 * 224.0 / 255.0 * 32768.0 + 0.5));
+
+// ── filters ─────────────────────────────────────────────────────────────────
+pub const Filter = struct {
+    size: usize,
+    pos: []i32,
+    coef: []i16,
+};
+
+fn av_log2(v: i32) i32 {
+    if (v <= 0) return 0;
+    return 31 - @as(i32, @clz(@as(u32, @intCast(v))));
+}
+
+fn roundedDiv(a: i64, b: i64) i64 {
+    return if (a >= 0) @divTrunc(a + (b >> 1), b) else @divTrunc(a - (b >> 1), b);
+}
+
+fn absI64(x: i64) i64 {
+    return if (x < 0) -x else x;
+}
+
+fn initFilter(xInc: i32, srcW: i32, dstW: i32, one: i64, algo: i32, srcPos: i32, dstPos: i32) !Filter {
+    const dW: usize = @intCast(dstW);
+    const fone: i64 = @as(i64, 1) << @intCast(54 - @min(av_log2(@divTrunc(srcW, dstW)), 8));
+    var pos = try alloc.alloc(i32, dW);
+    var filterSize: usize = 1;
+    var filter: []i64 = undefined;
+
+    const xi: i64 = xInc;
+    if (@abs(xInc - 0x10000) < 10 and srcPos == dstPos) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, dW);
+        for (0..dW) |i| {
+            filter[i] = fone;
+            pos[i] = @intCast(i);
+        }
+    } else if (algo == ALGO_NEAREST) {
+        filterSize = 1;
+        filter = try alloc.alloc(i64, dW);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * xi) >> 8) - ((@as(i64, srcPos) * 0x8000) >> 7);
+        for (0..dW) |i| {
+            const xx: i64 = (xDstInSrc + (1 << 15)) >> 16;
+            pos[i] = @intCast(xx);
+            filter[i] = fone;
+            xDstInSrc += xi;
+        }
+    } else {
+        const sizeFactor: i32 = if (algo == ALGO_BICUBIC) 4 else 2;
+        var fs: i32 = undefined;
+        if (xInc <= 1 << 16) {
+            fs = 1 + sizeFactor;
+        } else {
+            fs = 1 + @divTrunc(sizeFactor * srcW + dstW - 1, dstW);
+        }
+        fs = @min(fs, srcW - 2);
+        fs = @max(fs, 1);
+        filterSize = @intCast(fs);
+        filter = try alloc.alloc(i64, dW * filterSize);
+        var xDstInSrc: i64 = ((@as(i64, dstPos) * xi) >> 7) - ((@as(i64, srcPos) * 0x10000) >> 7);
+        const B: i64 = 0;
+        const C: i64 = @intFromFloat(0.6 * @as(f64, 1 << 24));
+        for (0..dW) |i| {
+            var xx: i64 = @divTrunc(xDstInSrc - @as(i64, fs - 2) * (1 << 16), 1 << 17);
+            pos[i] = @intCast(xx);
+            for (0..filterSize) |j| {
+                var d: i64 = absI64(xx * (1 << 17) - xDstInSrc) << 13;
+                if (xInc > 1 << 16) d = @divTrunc(d * dstW, srcW);
+                var coeff: i64 = 0;
+                if (algo == ALGO_BICUBIC) {
+                    if (d >= @as(i64, 1) << 31) {
+                        coeff = 0;
+                    } else {
+                        const dd = (d * d) >> 30;
+                        const ddd = (dd * d) >> 30;
+                        if (d < @as(i64, 1) << 30) {
+                            coeff = (12 * (1 << 24) - 9 * B - 6 * C) * ddd +
+                                (-18 * (1 << 24) + 12 * B + 6 * C) * dd +
+                                (6 * (1 << 24) - 2 * B) * (1 << 30);
+                        } else {
+                            coeff = (-B - 6 * C) * ddd +
+                                (6 * B + 30 * C) * dd +
+                                (-12 * B - 48 * C) * d +
+                                (8 * B + 24 * C) * (1 << 30);
+                        }
+                    }
+                    coeff = @divTrunc(coeff, @divTrunc(@as(i64, 1) << 54, fone));
+                } else {
+                    coeff = (1 << 30) - d;
+                    if (coeff < 0) coeff = 0;
+                    coeff *= fone >> 30;
+                }
+                filter[i * filterSize + j] = coeff;
+                xx += 1;
+            }
+            xDstInSrc += 2 * xi;
+        }
+    }
+
+    // reduce filter size (step 1)
+    const f2s = filterSize;
+    const filter2 = filter;
+    var minFilterSize: usize = 0;
+    const cutLimit: f64 = 0.002 * @as(f64, @floatFromInt(fone));
+    var ii: isize = @as(isize, @intCast(dW)) - 1;
+    while (ii >= 0) : (ii -= 1) {
+        const i: usize = @intCast(ii);
+        var min: usize = f2s;
+        var cutOff: i64 = 0;
+        var j: usize = 0;
+        while (j < f2s) : (j += 1) {
+            cutOff += absI64(filter2[i * f2s]);
+            if (@as(f64, @floatFromInt(cutOff)) > cutLimit) break;
+            if (i < dW - 1 and pos[i] >= pos[i + 1]) break;
+            var k: usize = 1;
+            while (k < f2s) : (k += 1) filter2[i * f2s + k - 1] = filter2[i * f2s + k];
+            filter2[i * f2s + k - 1] = 0;
+            pos[i] += 1;
+        }
+        cutOff = 0;
+        var jj: usize = f2s - 1;
+        while (jj > 0) : (jj -= 1) {
+            cutOff += absI64(filter2[i * f2s + jj]);
+            if (@as(f64, @floatFromInt(cutOff)) > cutLimit) break;
+            min -= 1;
+        }
+        if (min > minFilterSize) minFilterSize = min;
+    }
+    filterSize = minFilterSize;
+    var flt = try alloc.alloc(i64, dW * filterSize);
+    defer alloc.free(flt);
+    for (0..dW) |i| {
+        for (0..filterSize) |j| {
+            flt[i * filterSize + j] = if (j >= f2s) 0 else filter2[i * f2s + j];
+        }
+    }
+    alloc.free(filter2);
+
+    // fix borders
+    const fsI: i32 = @intCast(filterSize);
+    for (0..dW) |i| {
+        const row = flt[i * filterSize .. (i + 1) * filterSize];
+        if (pos[i] < 0) {
+            var j: usize = 1;
+            while (j < filterSize) : (j += 1) {
+                const left: usize = @intCast(@max(@as(i32, @intCast(j)) + pos[i], 0));
+                row[left] += row[j];
+                row[j] = 0;
+            }
+            pos[i] = 0;
+        }
+        if (pos[i] + fsI > srcW) {
+            const shift: i32 = pos[i] + @min(fsI - srcW, 0);
+            var acc: i64 = 0;
+            var j: isize = @as(isize, @intCast(filterSize)) - 1;
+            while (j >= 0) : (j -= 1) {
+                const ju: usize = @intCast(j);
+                if (pos[i] + @as(i32, @intCast(j)) >= srcW) {
+                    acc += row[ju];
+                    row[ju] = 0;
+                }
+            }
+            j = @as(isize, @intCast(filterSize)) - 1;
+            while (j >= 0) : (j -= 1) {
+                const ju: usize = @intCast(j);
+                if (j < shift) {
+                    row[ju] = 0;
+                } else {
+                    row[ju] = row[@intCast(j - shift)];
+                }
+            }
+            pos[i] -= shift;
+            row[@intCast(srcW - 1 - pos[i])] += acc;
+        }
+    }
+
+    // normalize
+    var coef = try alloc.alloc(i16, dW * filterSize);
+    for (0..dW) |i| {
+        var err: i64 = 0;
+        var sum: i64 = 0;
+        for (0..filterSize) |j| sum += flt[i * filterSize + j];
+        sum = @divTrunc(sum + @divTrunc(one, 2), one);
+        if (sum == 0) sum = 1;
+        for (0..filterSize) |j| {
+            const v = flt[i * filterSize + j] + err;
+            const intV = roundedDiv(v, sum);
+            coef[i * filterSize + j] = @intCast(intV);
+            err = v - intV * sum;
+        }
+    }
+    _ = &coef;
+    _ = &pos;
+    return .{ .size = filterSize, .pos = pos, .coef = coef };
+}
+
+fn freeFilter(f: *Filter) void {
+    alloc.free(f.pos);
+    alloc.free(f.coef);
+}
+
+// ── yuv->rgb tables ──────────────────────────────────────────────────────────
+pub const RgbTables = struct {
+    ytab: [2048]u8,
+    rv: [256]i32,
+    gu: [256]i32,
+    gv: [256]i32,
+    bu: [256]i32,
+    // full-chroma output coefficients
+    y_off: i32,
+    y_coeff: i32,
+    v2r: i32,
+    v2g: i32,
+    u2g: i32,
+    u2b: i32,
+    // scaled chroma coefficients (used by the SIMD table emulation)
+    crv: i64 = 0,
+    cbu: i64 = 0,
+    cgu: i64 = 0,
+    cgv: i64 = 0,
+    full: bool = false,
+};
+
+fn roundToInt16(f: i64) i32 {
+    const r: i64 = (f + (1 << 15)) >> 16;
+    if (r < -0x7FFF) return -32768;
+    if (r > 0x7FFF) return 0x7FFF;
+    return @intCast(r);
+}
+
+fn initRgbTables(t: *RgbTables, fullRange: bool) void {
+    var crv: i64 = 104597;
+    var cbu: i64 = 132201;
+    var cgu: i64 = -25675;
+    var cgv: i64 = -53279;
+    var cy: i64 = 1 << 16;
+    var oy: i64 = 0;
+    if (!fullRange) {
+        cy = @divTrunc(cy * 255, 219);
+        oy = 16 << 16;
+    } else {
+        crv = @divTrunc(crv * 224, 255);
+        cbu = @divTrunc(cbu * 224, 255);
+        cgu = @divTrunc(cgu * 224, 255);
+        cgv = @divTrunc(cgv * 224, 255);
+    }
+    t.y_coeff = roundToInt16(cy * (1 << 13));
+    t.y_off = roundToInt16(oy * (1 << 9));
+    t.v2r = roundToInt16(crv * (1 << 13));
+    t.v2g = roundToInt16(cgv * (1 << 13));
+    t.u2g = roundToInt16(cgu * (1 << 13));
+    t.u2b = roundToInt16(cbu * (1 << 13));
+    crv = @divTrunc(crv * (1 << 16) + 0x8000, cy);
+    cbu = @divTrunc(cbu * (1 << 16) + 0x8000, cy);
+    cgu = @divTrunc(cgu * (1 << 16) + 0x8000, cy);
+    cgv = @divTrunc(cgv * (1 << 16) + 0x8000, cy);
+    t.crv = crv;
+    t.cbu = cbu;
+    t.cgu = cgu;
+    t.cgv = cgv;
+    t.full = fullRange;
+    var yb: i64 = -(384 << 16) - 512 * cy - oy;
+    for (0..2048) |i| {
+        const v = (yb + 0x8000) >> 16;
+        t.ytab[i] = @intCast(std.math.clamp(v, 0, 255));
+        yb += cy;
+    }
+    const yoffs: i64 = (if (fullRange) @as(i64, 384) else 326) + 512;
+    for (0..256) |i| {
+        const c: i64 = @intCast(i);
+        t.rv[i] = @intCast(yoffs + ((c * crv) >> 16) - (crv >> 9));
+        t.gu[i] = @intCast(yoffs + ((c * cgu) >> 16) - (cgu >> 9));
+        t.gv[i] = @intCast(((c * cgv) >> 16) - (cgv >> 9));
+        t.bu[i] = @intCast(yoffs + ((c * cbu) >> 16) - (cbu >> 9));
+    }
+}
+
+inline fn clipU8(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+inline fn clipIdx(v: i32) usize {
+    return @intCast(std.math.clamp(v, 0, 2047));
+}
+
+// ── context ─────────────────────────────────────────────────────────────────
+const Mode = enum { generic, yuv2rgb, rgb2rgb, p2nv, nv2p, bgr24yv12 };
+
+pub const Ctx = struct {
+    srcW: i32,
+    srcH: i32,
+    srcF: i32,
+    dstW: i32,
+    dstH: i32,
+    dstF: i32,
+    algo: i32,
+    mode: Mode,
+    tabs: RgbTables,
+
+    // generic
+    fullChrOut: bool = false,
+    chrSrcHSub: u5 = 0,
+    chrSrcVSub: u5 = 0,
+    chrDstHSub: u5 = 0,
+    chrDstVSub: u5 = 0,
+    chrSrcW: i32 = 0,
+    chrSrcH: i32 = 0,
+    chrDstW: i32 = 0,
+    chrDstH: i32 = 0,
+    needsHc: bool = false,
+    needAlpha: bool = false,
+    lumRange: i32 = 0, // 0 none, 1 to jpeg, 2 from jpeg
+    hLum: Filter = undefined,
+    hChr: Filter = undefined,
+    vLum: Filter = undefined,
+    vChr: Filter = undefined,
+    lumBuf: []i16 = &.{},
+    alpBuf: []i16 = &.{},
+    chrUBuf: []i16 = &.{},
+    chrVBuf: []i16 = &.{},
+    tmp0: []u16 = &.{},
+    tmp1: []u16 = &.{},
+    tmp2: []u16 = &.{},
+    tmpB0: []u8 = &.{},
+    tmpB1: []u8 = &.{},
+    lumStride: usize = 0,
+    chrStride: usize = 0,
+    hasFilters: bool = false,
+    fastId: i32 = 0,
+    identL: bool = false,
+    identC: bool = false,
+    padL: fast.PadFilter = .{},
+    padC: fast.PadFilter = .{},
+    grpL: fast.GroupFilter = .{},
+    grpC: fast.GroupFilter = .{},
+    wide: []u16 = &.{},
+    lumNeed: []bool = &.{},
+    nearL: bool = false,
+    nearC: bool = false,
+    gath: []u8 = &.{},
+    chrNeed: []bool = &.{},
+};
+
+fn createCtx(srcW: i32, srcH: i32, srcF: i32, dstW: i32, dstH: i32, dstF: i32, algo: i32) !*Ctx {
+    if (srcF < 0 or srcF > 9 or dstF < 0 or dstF > 9 or algo < 0 or algo > 2) return error.Bad;
+    if (srcW < 1 or srcH < 1 or dstW < 1 or dstH < 1) return error.Bad;
+    const c = try alloc.create(Ctx);
+    c.* = .{ .srcW = srcW, .srcH = srcH, .srcF = srcF, .dstW = dstW, .dstH = dstH, .dstF = dstF, .algo = algo, .mode = .generic, .tabs = undefined };
+
+    const srcRange: bool = isGray(srcF);
+    const dstRange: bool = isGray(dstF);
+    initRgbTables(&c.tabs, srcRange);
+
+    const unscaled = srcW == dstW and srcH == dstH;
+    if (unscaled and (srcRange == dstRange or isRGB(dstF))) {
+        if (srcF == YUV420P and (dstF == NV12 or dstF == NV21)) c.mode = .p2nv;
+        if (dstF == YUV420P and (srcF == NV12 or srcF == NV21)) c.mode = .nv2p;
+        if ((srcF == YUV420P or srcF == YUV422P) and isRGB(dstF) and (dstH & 1) == 0) c.mode = .yuv2rgb;
+        if (srcF == BGR24 and dstF == YUV420P and (dstW & 1) == 0) c.mode = .bgr24yv12;
+        if (isRGB(srcF) and isRGB(dstF)) c.mode = .rgb2rgb;
+        if (srcF == dstF and !isRGB(srcF)) c.mode = .rgb2rgb; // plain copy (not in contract)
+    }
+    if (c.mode != .generic) {
+        fast.setup(c);
+        return c;
+    }
+    try initGeneric(c);
+    fast.setup(c);
+    return c;
+}
+
+fn initGeneric(c: *Ctx) !void {
+    const srcW = c.srcW;
+    const srcH = c.srcH;
+    const dstW = c.dstW;
+    const dstH = c.dstH;
+    const srcF = c.srcF;
+    const dstF = c.dstF;
+    var full = false;
+    const lumXInc: i32 = @intCast(@divTrunc((@as(i64, srcW) << 16) + (dstW >> 1), dstW));
+    const lumYInc: i32 = @intCast(@divTrunc((@as(i64, srcH) << 16) + (dstH >> 1), dstH));
+    c.chrSrcHSub = hsub(srcF);
+    c.chrSrcVSub = vsub(srcF);
+    c.chrDstHSub = hsub(dstF);
+    c.chrDstVSub = vsub(dstF);
+    if (isRGB(dstF)) {
+        if ((dstW & 1) != 0) full = true;
+        if (c.chrSrcHSub == 0 and c.chrSrcVSub == 0) full = true;
+        if (!full) c.chrDstHSub = 1;
+    }
+    if (isRGB(srcF) and ((dstW >> c.chrDstHSub) <= (srcW >> 1))) c.chrSrcHSub = 1;
+    c.fullChrOut = full;
+    c.chrSrcW = ceilShift(srcW, c.chrSrcHSub);
+    c.chrSrcH = ceilShift(srcH, c.chrSrcVSub);
+    c.chrDstW = ceilShift(dstW, c.chrDstHSub);
+    c.chrDstH = ceilShift(dstH, c.chrDstVSub);
+    const chrXInc: i32 = @intCast(@divTrunc((@as(i64, c.chrSrcW) << 16) + (c.chrDstW >> 1), c.chrDstW));
+    const chrYInc: i32 = @intCast(@divTrunc((@as(i64, c.chrSrcH) << 16) + (c.chrDstH >> 1), c.chrDstH));
+    c.needsHc = !(isGray(srcF) or isGray(dstF));
+    c.needAlpha = hasAlpha(srcF) and hasAlpha(dstF);
+    const srcRange = isGray(srcF);
+    const dstRange = isGray(dstF);
+    if (srcRange != dstRange and !isRGB(dstF)) {
+        c.lumRange = if (srcRange) 2 else 1;
+    }
+
+    c.hLum = try initFilter(lumXInc, srcW, dstW, 1 << 14, c.algo, 128, 128);
+    c.hChr = try initFilter(chrXInc, c.chrSrcW, c.chrDstW, 1 << 14, c.algo, 128, 128);
+    c.vLum = try initFilter(lumYInc, srcH, dstH, 1 << 12, c.algo, 128, 128);
+    c.vChr = try initFilter(chrYInc, c.chrSrcH, c.chrDstH, 1 << 12, c.algo, 128, 128);
+    c.hasFilters = true;
+    if (isRGB(srcF)) {
+        const nl = c.hLum.size == 1 and allOne(&c.hLum, @intCast(dstW));
+        const nc = c.hChr.size == 1 and allOne(&c.hChr, @intCast(c.chrDstW));
+        // only worth it when sampling fewer pixels than the row holds
+        c.nearL = nl and dstW < srcW;
+        c.nearC = nc and c.chrDstW < c.chrSrcW;
+        if (c.nearL or c.nearC) c.gath = try alloc.alloc(u8, @as(usize, @intCast(@max(dstW, c.chrDstW))) * 8 + 64);
+    }
+    c.lumNeed = try alloc.alloc(bool, @intCast(srcH));
+    c.chrNeed = try alloc.alloc(bool, @intCast(c.chrSrcH));
+    @memset(c.lumNeed, false);
+    @memset(c.chrNeed, false);
+    for (0..@as(usize, @intCast(dstH))) |y| {
+        const p: usize = @intCast(c.vLum.pos[y]);
+        for (0..c.vLum.size) |j| c.lumNeed[p + j] = true;
+    }
+    for (0..@as(usize, @intCast(c.chrDstH))) |y| {
+        const p: usize = @intCast(c.vChr.pos[y]);
+        for (0..c.vChr.size) |j| c.chrNeed[p + j] = true;
+    }
+
+    c.lumStride = (@as(usize, @intCast(dstW)) + 31) & ~@as(usize, 15);
+    c.chrStride = (@as(usize, @intCast(c.chrDstW)) + 31) & ~@as(usize, 15);
+    const sh: usize = @intCast(srcH);
+    const csh: usize = @intCast(c.chrSrcH);
+    c.lumBuf = try alloc.alloc(i16, c.lumStride * sh);
+    if (c.needAlpha) c.alpBuf = try alloc.alloc(i16, c.lumStride * sh);
+    if (c.needsHc) {
+        c.chrUBuf = try alloc.alloc(i16, c.chrStride * csh);
+        c.chrVBuf = try alloc.alloc(i16, c.chrStride * csh);
+    } else {
+        c.chrUBuf = try alloc.alloc(i16, c.chrStride);
+        c.chrVBuf = try alloc.alloc(i16, c.chrStride);
+        @memset(c.chrUBuf, 1 << 14);
+        @memset(c.chrVBuf, 1 << 14);
+    }
+    const sw: usize = @intCast(srcW);
+    c.tmp0 = try alloc.alloc(u16, sw + 64);
+    c.tmp1 = try alloc.alloc(u16, sw + 64);
+    c.tmp2 = try alloc.alloc(u16, sw + 64);
+    c.tmpB0 = try alloc.alloc(u8, sw + 64);
+    c.tmpB1 = try alloc.alloc(u8, sw + 64);
+}
+
+fn gatherPix(comptime n: usize, d: [*]u8, s: [*]const u8, pos: [*]const i32, w: usize) void {
+    // wide copies (whole u32/u64) for all but the last sample, which may sit at the end of the buffer
+    const W = if (n <= 4) 4 else 8;
+    const T = if (W == 4) u32 else u64;
+    if (w == 0) return;
+    for (0..w - 1) |i| {
+        const p: usize = @intCast(pos[i]);
+        std.mem.writeInt(T, d[i * n ..][0..W], std.mem.readInt(T, s[p * n ..][0..W], .little), .little);
+    }
+    const p: usize = @intCast(pos[w - 1]);
+    d[(w - 1) * n ..][0..n].* = s[p * n ..][0..n].*;
+}
+
+fn allOne(f: *const Filter, w: usize) bool {
+    for (0..w) |i| if (f.coef[i] != 1 << 14) return false;
+    return true;
+}
+
+fn destroyCtx(c: *Ctx) void {
+    if (c.hasFilters) {
+        freeFilter(&c.hLum);
+        freeFilter(&c.hChr);
+        freeFilter(&c.vLum);
+        freeFilter(&c.vChr);
+    }
+    if (c.lumBuf.len > 0) alloc.free(c.lumBuf);
+    if (c.alpBuf.len > 0) alloc.free(c.alpBuf);
+    if (c.chrUBuf.len > 0) alloc.free(c.chrUBuf);
+    if (c.chrVBuf.len > 0) alloc.free(c.chrVBuf);
+    if (c.tmp0.len > 0) alloc.free(c.tmp0);
+    if (c.tmp1.len > 0) alloc.free(c.tmp1);
+    if (c.tmp2.len > 0) alloc.free(c.tmp2);
+    if (c.tmpB0.len > 0) alloc.free(c.tmpB0);
+    if (c.tmpB1.len > 0) alloc.free(c.tmpB1);
+    if (c.padL.coef.len > 0) alloc.free(c.padL.coef);
+    if (c.padC.coef.len > 0) alloc.free(c.padC.coef);
+    if (c.wide.len > 0) alloc.free(c.wide);
+    if (c.lumNeed.len > 0) alloc.free(c.lumNeed);
+    if (c.chrNeed.len > 0) alloc.free(c.chrNeed);
+    if (c.gath.len > 0) alloc.free(c.gath);
+    if (c.grpL.kind.len > 0) alloc.free(c.grpL.kind);
+    if (c.grpC.kind.len > 0) alloc.free(c.grpC.kind);
+    alloc.destroy(c);
+}
+
+// ── generic pipeline: scalar reference kernels ─────────────────────────────
+pub fn hScale8(dst: []i16, dstW: usize, src: [*]const u8, f: *const Filter) void {
+    const fs = f.size;
+    for (0..dstW) |i| {
+        const p: usize = @intCast(f.pos[i]);
+        var val: i32 = 0;
+        for (0..fs) |j| val += @as(i32, src[p + j]) * f.coef[i * fs + j];
+        dst[i] = @intCast(@min(val >> 7, 32767));
+    }
+}
+
+pub fn hScale16(dst: []i16, dstW: usize, src: [*]const u16, f: *const Filter) void {
+    const fs = f.size;
+    for (0..dstW) |i| {
+        const p: usize = @intCast(f.pos[i]);
+        var val: i32 = 0;
+        for (0..fs) |j| val += @as(i32, src[p + j]) * f.coef[i * fs + j];
+        dst[i] = @intCast(@min(val >> 13, 32767));
+    }
+}
+
+pub fn rgbToY(dst: [*]u16, src: [*]const u8, w: usize, f: i32) void {
+    const bpp = rgbBpp(f);
+    const ro = rOff(f);
+    const bo = bOff(f);
+    for (0..w) |i| {
+        const r: i32 = src[i * bpp + ro];
+        const g: i32 = src[i * bpp + 1];
+        const b: i32 = src[i * bpp + bo];
+        dst[i] = @intCast((RY * r + GY * g + BY * b + (32 << 14) + (1 << 8)) >> 9);
+    }
+}
+
+pub fn rgbToUV(du: [*]u16, dv: [*]u16, src: [*]const u8, w: usize, f: i32) void {
+    const bpp = rgbBpp(f);
+    const ro = rOff(f);
+    const bo = bOff(f);
+    for (0..w) |i| {
+        const r: i32 = src[i * bpp + ro];
+        const g: i32 = src[i * bpp + 1];
+        const b: i32 = src[i * bpp + bo];
+        du[i] = @intCast((RU * r + GU * g + BU * b + (256 << 14) + (1 << 8)) >> 9);
+        dv[i] = @intCast((RV * r + GV * g + BV * b + (256 << 14) + (1 << 8)) >> 9);
+    }
+}
+
+pub fn rgbToUVHalf(du: [*]u16, dv: [*]u16, src: [*]const u8, w: usize, f: i32) void {
+    const bpp = rgbBpp(f);
+    const ro = rOff(f);
+    const bo = bOff(f);
+    for (0..w) |i| {
+        const r: i32 = @as(i32, src[2 * i * bpp + ro]) + src[(2 * i + 1) * bpp + ro];
+        const g: i32 = @as(i32, src[2 * i * bpp + 1]) + src[(2 * i + 1) * bpp + 1];
+        const b: i32 = @as(i32, src[2 * i * bpp + bo]) + src[(2 * i + 1) * bpp + bo];
+        du[i] = @intCast((RU * r + GU * g + BU * b + (256 << 15) + (1 << 9)) >> 10);
+        dv[i] = @intCast((RV * r + GV * g + BV * b + (256 << 15) + (1 << 9)) >> 10);
+    }
+}
+
+fn lumRangeConv(row: []i16, w: usize, mode: i32) void {
+    if (mode == 1) {
+        for (row[0..w]) |*v| {
+            const x: i32 = @min(@as(i32, v.*), 30189);
+            v.* = @intCast((x * 19077 - 39057361) >> 14);
+        }
+    } else if (mode == 2) {
+        for (row[0..w]) |*v| {
+            const x: i32 = v.*;
+            v.* = @intCast((x * 14071 + 33561947) >> 14);
+        }
+    }
+}
+
+// Horizontal stage for the whole frame.
+fn genericHorizontal(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int) void {
+    const sw: usize = @intCast(c.srcW);
+    const dw: usize = @intCast(c.dstW);
+    const sh: usize = @intCast(c.srcH);
+    const s0 = src[0].?;
+    const st0: isize = ss[0];
+    // luma (+alpha)
+    for (0..sh) |y| {
+        if (!c.lumNeed[y]) continue;
+        const line = s0 + @as(usize, @intCast(@as(isize, @intCast(y)) * st0));
+        const out = c.lumBuf[y * c.lumStride ..];
+        if (isRGB(c.srcF) and c.nearL) {
+            // point sampling: convert only the sampled pixels
+            const bpp = rgbBpp(c.srcF);
+            if (bpp == 3) gatherPix(3, c.gath.ptr, line, c.hLum.pos.ptr, dw) else gatherPix(4, c.gath.ptr, line, c.hLum.pos.ptr, dw);
+            _ = fast.rgbToYLine(c, c.tmp0.ptr, c.gath.ptr, dw);
+            fast.dbl(out, c.tmp0.ptr, dw);
+            if (c.needAlpha) {
+                for (0..dw) |i| {
+                    const a: i32 = c.gath[i * bpp + 3];
+                    c.alpBuf[y * c.lumStride + i] = @intCast(@min(((a << 6) | (a >> 2)) * 2, 32767));
+                }
+            }
+        } else if (isRGB(c.srcF)) {
+            if (!fast.rgbToYLine(c, c.tmp0.ptr, line, sw)) rgbToY(c.tmp0.ptr, line, sw, c.srcF);
+            if (!fast.hScale16Row(c, out, dw, c.tmp0.ptr, &c.hLum)) hScale16(out, dw, c.tmp0.ptr, &c.hLum);
+            if (c.needAlpha) {
+                for (0..sw) |i| {
+                    const a: u16 = line[i * 4 + 3];
+                    c.tmp1[i] = (a << 6) | (a >> 2);
+                }
+                const ao = c.alpBuf[y * c.lumStride ..];
+                if (!fast.hScale16Row(c, ao, dw, c.tmp1.ptr, &c.hLum)) hScale16(ao, dw, c.tmp1.ptr, &c.hLum);
+            }
+        } else {
+            if (!fast.hScale8Row(c, out, dw, line, &c.hLum)) hScale8(out, dw, line, &c.hLum);
+        }
+        if (c.lumRange != 0) lumRangeConv(out, dw, c.lumRange);
+    }
+    if (!c.needsHc) return;
+    const csw: usize = @intCast(c.chrSrcW);
+    const cdw: usize = @intCast(c.chrDstW);
+    const csh: usize = @intCast(c.chrSrcH);
+    for (0..csh) |y| {
+        if (!c.chrNeed[y]) continue;
+        const ou = c.chrUBuf[y * c.chrStride ..];
+        const ov = c.chrVBuf[y * c.chrStride ..];
+        if (isRGB(c.srcF)) {
+            const line = s0 + @as(usize, @intCast(@as(isize, @intCast(y << c.chrSrcVSub)) * st0));
+            if (c.nearC) {
+                const bpp = rgbBpp(c.srcF);
+                const span: usize = if (c.chrSrcHSub == 1) 2 * bpp else bpp;
+                switch (span) {
+                    3 => gatherPix(3, c.gath.ptr, line, c.hChr.pos.ptr, cdw),
+                    4 => gatherPix(4, c.gath.ptr, line, c.hChr.pos.ptr, cdw),
+                    6 => gatherPix(6, c.gath.ptr, line, c.hChr.pos.ptr, cdw),
+                    else => gatherPix(8, c.gath.ptr, line, c.hChr.pos.ptr, cdw),
+                }
+                if (c.chrSrcHSub == 1) {
+                    _ = fast.rgbToUVHalfLine(c, c.tmp1.ptr, c.tmp2.ptr, c.gath.ptr, cdw);
+                } else {
+                    _ = fast.rgbToUVLine(c, c.tmp1.ptr, c.tmp2.ptr, c.gath.ptr, cdw);
+                }
+                fast.dbl(ou, c.tmp1.ptr, cdw);
+                fast.dbl(ov, c.tmp2.ptr, cdw);
+                continue;
+            }
+            if (c.chrSrcHSub == 1) {
+                if (!fast.rgbToUVHalfLine(c, c.tmp1.ptr, c.tmp2.ptr, line, csw)) rgbToUVHalf(c.tmp1.ptr, c.tmp2.ptr, line, csw, c.srcF);
+            } else {
+                if (!fast.rgbToUVLine(c, c.tmp1.ptr, c.tmp2.ptr, line, csw)) rgbToUV(c.tmp1.ptr, c.tmp2.ptr, line, csw, c.srcF);
+            }
+            if (!fast.hScale16Row(c, ou, cdw, c.tmp1.ptr, &c.hChr)) hScale16(ou, cdw, c.tmp1.ptr, &c.hChr);
+            if (!fast.hScale16Row(c, ov, cdw, c.tmp2.ptr, &c.hChr)) hScale16(ov, cdw, c.tmp2.ptr, &c.hChr);
+        } else if (isSemiPlanar(c.srcF)) {
+            const line = src[1].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[1]));
+            const pu = if (c.srcF == NV12) c.tmpB0 else c.tmpB1;
+            const pv = if (c.srcF == NV12) c.tmpB1 else c.tmpB0;
+            for (0..csw) |i| {
+                pu[i] = line[2 * i];
+                pv[i] = line[2 * i + 1];
+            }
+            if (!fast.hScale8Row(c, ou, cdw, c.tmpB0.ptr, &c.hChr)) hScale8(ou, cdw, c.tmpB0.ptr, &c.hChr);
+            if (!fast.hScale8Row(c, ov, cdw, c.tmpB1.ptr, &c.hChr)) hScale8(ov, cdw, c.tmpB1.ptr, &c.hChr);
+        } else {
+            const lu = src[1].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[1]));
+            const lv = src[2].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[2]));
+            if (!fast.hScale8Row(c, ou, cdw, lu, &c.hChr)) hScale8(ou, cdw, lu, &c.hChr);
+            if (!fast.hScale8Row(c, ov, cdw, lv, &c.hChr)) hScale8(ov, cdw, lv, &c.hChr);
+        }
+    }
+}
+
+inline fn lumRow(c: *Ctx, y: usize) [*]const i16 {
+    return c.lumBuf.ptr + y * c.lumStride;
+}
+inline fn alpRow(c: *Ctx, y: usize) [*]const i16 {
+    return c.alpBuf.ptr + y * c.lumStride;
+}
+inline fn chrURow(c: *Ctx, y: usize) [*]const i16 {
+    return if (c.needsHc) c.chrUBuf.ptr + y * c.chrStride else c.chrUBuf.ptr;
+}
+inline fn chrVRow(c: *Ctx, y: usize) [*]const i16 {
+    return if (c.needsHc) c.chrVBuf.ptr + y * c.chrStride else c.chrVBuf.ptr;
+}
+
+pub fn planeX(dst: [*]u8, w: usize, rows: []const [*]const i16, coef: []const i16) void {
+    if (rows.len == 1) {
+        const s = rows[0];
+        for (0..w) |i| dst[i] = clipU8((@as(i32, s[i]) + 64) >> 7);
+        return;
+    }
+    for (0..w) |i| {
+        var val: i32 = 64 << 12;
+        for (rows, 0..) |r, j| val += @as(i32, r[i]) * coef[j];
+        dst[i] = clipU8(val >> 19);
+    }
+}
+
+inline fn writeFull(c: *Ctx, d: [*]u8, Yin: i32, U: i32, V: i32, A: i32, f: i32) void {
+    const t = &c.tabs;
+    var Y: i32 = Yin - t.y_off;
+    Y = Y *% t.y_coeff;
+    Y +%= 1 << 21;
+    const yu: u32 = @bitCast(Y);
+    var R: i32 = @bitCast(yu +% @as(u32, @bitCast(V *% t.v2r)));
+    var G: i32 = @bitCast(yu +% @as(u32, @bitCast(V *% t.v2g)) +% @as(u32, @bitCast(U *% t.u2g)));
+    var B: i32 = @bitCast(yu +% @as(u32, @bitCast(U *% t.u2b)));
+    if (((R | G | B) & @as(i32, @bitCast(@as(u32, 0xC0000000)))) != 0) {
+        R = std.math.clamp(R, 0, (1 << 30) - 1);
+        G = std.math.clamp(G, 0, (1 << 30) - 1);
+        B = std.math.clamp(B, 0, (1 << 30) - 1);
+    }
+    d[rOff(f)] = @intCast(R >> 22);
+    d[1] = @intCast(G >> 22);
+    d[bOff(f)] = @intCast(B >> 22);
+    if (rgbBpp(f) == 4) d[3] = @intCast(A);
+}
+
+inline fn writeHalf(c: *Ctx, d: [*]u8, Y1: i32, Y2: i32, U: i32, V: i32, f: i32) void {
+    const t = &c.tabs;
+    const cu: usize = clipU8(U);
+    const cv: usize = clipU8(V);
+    const ro = t.rv[cv];
+    const go = t.gu[cu] + t.gv[cv];
+    const bo = t.bu[cu];
+    const bpp = rgbBpp(f);
+    d[rOff(f)] = t.ytab[clipIdx(ro + Y1)];
+    d[1] = t.ytab[clipIdx(go + Y1)];
+    d[bOff(f)] = t.ytab[clipIdx(bo + Y1)];
+    d[bpp + rOff(f)] = t.ytab[clipIdx(ro + Y2)];
+    d[bpp + 1] = t.ytab[clipIdx(go + Y2)];
+    d[bpp + bOff(f)] = t.ytab[clipIdx(bo + Y2)];
+    if (bpp == 4) {
+        d[3] = 255;
+        d[7] = 255;
+    }
+}
+
+fn packedRow(c: *Ctx, dst: [*]u8, dstY: usize) void {
+    const f = c.dstF;
+    const dw: usize = @intCast(c.dstW);
+    const lf = &c.vLum;
+    const cf = &c.vChr;
+    const cy = dstY >> c.chrDstVSub;
+    const lpos: usize = @intCast(lf.pos[dstY]);
+    const cpos: usize = @intCast(cf.pos[cy]);
+    const lfs = lf.size;
+    const cfs = cf.size;
+    const lco = lf.coef[dstY * lfs .. dstY * lfs + lfs];
+    const cco = cf.coef[cy * cfs .. cy * cfs + cfs];
+    const bpp = rgbBpp(f);
+    const alpha = c.needAlpha;
+
+    var kind: u8 = 3; // 1: packed1, 2: packed2, 3: X
+    var uvalpha: i32 = 0;
+    var yalpha: i32 = 0;
+    if (lfs == 1 and cfs == 1) {
+        kind = 1;
+    } else if (lfs == 1 and cfs == 2 and @as(i32, cco[1]) + cco[0] == 4096 and @as(u16, @bitCast(cco[1])) <= 4096) {
+        kind = 1;
+        uvalpha = cco[1];
+    } else if (lfs == 2 and cfs == 2 and @as(i32, lco[1]) + lco[0] == 4096 and @as(u16, @bitCast(lco[1])) <= 4096 and
+        @as(i32, cco[1]) + cco[0] == 4096 and @as(u16, @bitCast(cco[1])) <= 4096)
+    {
+        kind = 2;
+        yalpha = lco[1];
+        uvalpha = cco[1];
+    }
+    if (fast.packedRow(c, dst, dstY, kind, yalpha, uvalpha)) return;
+
+    var lrows: [64][*]const i16 = undefined;
+    var crowsU: [64][*]const i16 = undefined;
+    var crowsV: [64][*]const i16 = undefined;
+    var arows: [64][*]const i16 = undefined;
+    for (0..lfs) |j| {
+        lrows[j] = lumRow(c, lpos + j);
+        if (alpha) arows[j] = alpRow(c, lpos + j);
+    }
+    for (0..cfs) |j| {
+        crowsU[j] = chrURow(c, cpos + j);
+        crowsV[j] = chrVRow(c, cpos + j);
+    }
+
+    if (c.fullChrOut) {
+        for (0..dw) |i| {
+            var Y: i32 = 0;
+            var U: i32 = 0;
+            var V: i32 = 0;
+            var A: i32 = 255;
+            if (kind == 1) {
+                Y = @as(i32, lrows[0][i]) * 4;
+                if (uvalpha < 2048) {
+                    U = (@as(i32, crowsU[0][i]) - (128 << 7)) * 4;
+                    V = (@as(i32, crowsV[0][i]) - (128 << 7)) * 4;
+                } else {
+                    U = (@as(i32, crowsU[0][i]) + crowsU[1][i] - (128 << 8)) * 2;
+                    V = (@as(i32, crowsV[0][i]) + crowsV[1][i] - (128 << 8)) * 2;
+                }
+                if (alpha) {
+                    A = (@as(i32, arows[0][i]) + 64) >> 7;
+                    if ((A & 0x100) != 0) A = clipU8(A);
+                }
+            } else if (kind == 2) {
+                const ya1 = 4096 - yalpha;
+                const ua1 = 4096 - uvalpha;
+                Y = (@as(i32, lrows[0][i]) * ya1 + @as(i32, lrows[1][i]) * yalpha) >> 10;
+                U = (@as(i32, crowsU[0][i]) * ua1 + @as(i32, crowsU[1][i]) * uvalpha - (128 << 19)) >> 10;
+                V = (@as(i32, crowsV[0][i]) * ua1 + @as(i32, crowsV[1][i]) * uvalpha - (128 << 19)) >> 10;
+                if (alpha) {
+                    A = (@as(i32, arows[0][i]) * ya1 + @as(i32, arows[1][i]) * yalpha + (1 << 18)) >> 19;
+                    if ((A & 0x100) != 0) A = clipU8(A);
+                }
+            } else {
+                Y = 1 << 9;
+                U = (1 << 9) - (128 << 19);
+                V = (1 << 9) - (128 << 19);
+                for (0..lfs) |j| Y += @as(i32, lrows[j][i]) * lco[j];
+                for (0..cfs) |j| {
+                    U += @as(i32, crowsU[j][i]) * cco[j];
+                    V += @as(i32, crowsV[j][i]) * cco[j];
+                }
+                Y >>= 10;
+                U >>= 10;
+                V >>= 10;
+                if (alpha) {
+                    A = 1 << 18;
+                    for (0..lfs) |j| A += @as(i32, arows[j][i]) * lco[j];
+                    A >>= 19;
+                    if ((A & 0x100) != 0) A = clipU8(A);
+                }
+            }
+            writeFull(c, dst + i * bpp, Y, U, V, A, f);
+        }
+    } else {
+        const pairs = (dw + 1) >> 1;
+        for (0..pairs) |i| {
+            var Y1: i32 = 0;
+            var Y2: i32 = 0;
+            var U: i32 = 0;
+            var V: i32 = 0;
+            if (kind == 1) {
+                Y1 = (@as(i32, lrows[0][2 * i]) + 64) >> 7;
+                Y2 = (@as(i32, lrows[0][2 * i + 1]) + 64) >> 7;
+                if (uvalpha < 2048) {
+                    U = (@as(i32, crowsU[0][i]) + 64) >> 7;
+                    V = (@as(i32, crowsV[0][i]) + 64) >> 7;
+                } else {
+                    U = (@as(i32, crowsU[0][i]) + crowsU[1][i] + 128) >> 8;
+                    V = (@as(i32, crowsV[0][i]) + crowsV[1][i] + 128) >> 8;
+                }
+            } else if (kind == 2) {
+                const ya1 = 4096 - yalpha;
+                const ua1 = 4096 - uvalpha;
+                Y1 = (@as(i32, lrows[0][2 * i]) * ya1 + @as(i32, lrows[1][2 * i]) * yalpha) >> 19;
+                Y2 = (@as(i32, lrows[0][2 * i + 1]) * ya1 + @as(i32, lrows[1][2 * i + 1]) * yalpha) >> 19;
+                U = (@as(i32, crowsU[0][i]) * ua1 + @as(i32, crowsU[1][i]) * uvalpha) >> 19;
+                V = (@as(i32, crowsV[0][i]) * ua1 + @as(i32, crowsV[1][i]) * uvalpha) >> 19;
+            } else {
+                Y1 = 1 << 18;
+                Y2 = 1 << 18;
+                U = 1 << 18;
+                V = 1 << 18;
+                for (0..lfs) |j| {
+                    Y1 += @as(i32, lrows[j][2 * i]) * lco[j];
+                    Y2 += @as(i32, lrows[j][2 * i + 1]) * lco[j];
+                }
+                for (0..cfs) |j| {
+                    U += @as(i32, crowsU[j][i]) * cco[j];
+                    V += @as(i32, crowsV[j][i]) * cco[j];
+                }
+                Y1 >>= 19;
+                Y2 >>= 19;
+                U >>= 19;
+                V >>= 19;
+            }
+            writeHalf(c, dst + i * 2 * bpp, Y1, Y2, U, V, f);
+        }
+    }
+}
+
+fn genericVertical(c: *Ctx, dst: [*]const ?[*]u8, ds: [*]const c_int) void {
+    const dh: usize = @intCast(c.dstH);
+    const dw: usize = @intCast(c.dstW);
+    var rows: [64][*]const i16 = undefined;
+    var rows2: [64][*]const i16 = undefined;
+    for (0..dh) |y| {
+        const d0 = dst[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[0]));
+        if (isRGB(c.dstF)) {
+            packedRow(c, d0, y);
+            continue;
+        }
+        // luma
+        const lf = &c.vLum;
+        const lp: usize = @intCast(lf.pos[y]);
+        for (0..lf.size) |j| rows[j] = lumRow(c, lp + j);
+        const lco = lf.coef[y * lf.size .. (y + 1) * lf.size];
+        if (!fast.planeRow(c, d0, dw, rows[0..lf.size], lco)) planeX(d0, dw, rows[0..lf.size], lco);
+        if (isGray(c.dstF)) continue;
+        const mask: usize = (@as(usize, 1) << c.chrDstVSub) - 1;
+        if ((y & mask) != 0) continue;
+        const cy = y >> c.chrDstVSub;
+        const cf = &c.vChr;
+        const cp: usize = @intCast(cf.pos[cy]);
+        for (0..cf.size) |j| {
+            rows[j] = chrURow(c, cp + j);
+            rows2[j] = chrVRow(c, cp + j);
+        }
+        const cco = cf.coef[cy * cf.size .. (cy + 1) * cf.size];
+        const cdw: usize = @intCast(c.chrDstW);
+        if (isSemiPlanar(c.dstF)) {
+            const d1 = dst[1].? + @as(usize, @intCast(@as(isize, @intCast(cy)) * ds[1]));
+            if (!fast.nvRow(c, d1, cdw, rows[0..cf.size], rows2[0..cf.size], cco)) {
+                const swap = c.dstF == NV21;
+                for (0..cdw) |i| {
+                    var u: i32 = 64 << 12;
+                    var v: i32 = 64 << 12;
+                    for (0..cf.size) |j| {
+                        u += @as(i32, rows[j][i]) * cco[j];
+                        v += @as(i32, rows2[j][i]) * cco[j];
+                    }
+                    d1[2 * i + @intFromBool(swap)] = clipU8(u >> 19);
+                    d1[2 * i + @intFromBool(!swap)] = clipU8(v >> 19);
+                }
+            }
+        } else {
+            const d1 = dst[1].? + @as(usize, @intCast(@as(isize, @intCast(cy)) * ds[1]));
+            const d2 = dst[2].? + @as(usize, @intCast(@as(isize, @intCast(cy)) * ds[2]));
+            // FFmpeg uses yuv2plane1 only for filter size 1; X with coef otherwise
+            if (!fast.planeRow(c, d1, cdw, rows[0..cf.size], cco)) planeX(d1, cdw, rows[0..cf.size], cco);
+            if (!fast.planeRow(c, d2, cdw, rows2[0..cf.size], cco)) planeX(d2, cdw, rows2[0..cf.size], cco);
+        }
+    }
+}
+
+// ── unscaled special converters ──────────────────────────────────────────────
+fn yuv2rgbUnscaled(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int, dst: [*]const ?[*]u8, ds: [*]const c_int) void {
+    const w: usize = @intCast(c.dstW);
+    const h: usize = @intCast(c.dstH);
+    const is422 = c.srcF == YUV422P;
+    const f = c.dstF;
+    const bpp = rgbBpp(f);
+    const t = &c.tabs;
+    var y: usize = 0;
+    while (y < h) : (y += 1) {
+        const py = src[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[0]));
+        const cyy: usize = if (is422) y else y >> 1;
+        const pu = src[1].? + @as(usize, @intCast(@as(isize, @intCast(cyy)) * ss[1]));
+        const pv = src[2].? + @as(usize, @intCast(@as(isize, @intCast(cyy)) * ss[2]));
+        const d = dst[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[0]));
+        if (!is422 and y + 1 < h and (y & 1) == 0) {
+            if (fast.yuv2rgbRow2(c, d, d + @as(usize, @intCast(ds[0])), py, py + @as(usize, @intCast(ss[0])), pu, pv, w)) {
+                y += 1;
+                continue;
+            }
+        }
+        if (fast.yuv2rgbRow(c, d, py, pu, pv, w)) continue;
+        for (0..w / 2) |i| {
+            const U = pu[i];
+            const V = pv[i];
+            const ro = t.rv[V];
+            const go = t.gu[U] + t.gv[V];
+            const bo = t.bu[U];
+            inline for (0..2) |k| {
+                const Y: i32 = py[2 * i + k];
+                const o = d + (2 * i + k) * bpp;
+                o[rOff(f)] = t.ytab[@intCast(ro + Y)];
+                o[1] = t.ytab[@intCast(go + Y)];
+                o[bOff(f)] = t.ytab[@intCast(bo + Y)];
+                if (bpp == 4) o[3] = 255;
+            }
+        }
+    }
+}
+
+fn rgb2rgbUnscaled(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int, dst: [*]const ?[*]u8, ds: [*]const c_int) void {
+    const w: usize = @intCast(c.dstW);
+    const h: usize = @intCast(c.dstH);
+    if (!isRGB(c.srcF)) {
+        // same planar format copy
+        const np: usize = if (c.srcF == GRAY8) 1 else if (isSemiPlanar(c.srcF)) 2 else 3;
+        for (0..np) |p| {
+            const rows = if (p == 0) h else @as(usize, @intCast(ceilShift(c.srcH, vsub(c.srcF))));
+            const rb = if (p == 0) w else if (isSemiPlanar(c.srcF)) 2 * @as(usize, @intCast(ceilShift(c.srcW, 1))) else @as(usize, @intCast(ceilShift(c.srcW, hsub(c.srcF))));
+            for (0..rows) |y| {
+                const s = src[p].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[p]));
+                const d = dst[p].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[p]));
+                @memcpy(d[0..rb], s[0..rb]);
+            }
+        }
+        return;
+    }
+    const sf = c.srcF;
+    const df = c.dstF;
+    const sb = rgbBpp(sf);
+    const db = rgbBpp(df);
+    for (0..h) |y| {
+        const s = src[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[0]));
+        const d = dst[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[0]));
+        if (fast.rgb2rgbRow(c, d, s, w)) continue;
+        for (0..w) |i| {
+            const r = s[i * sb + rOff(sf)];
+            const g = s[i * sb + 1];
+            const b = s[i * sb + bOff(sf)];
+            d[i * db + rOff(df)] = r;
+            d[i * db + 1] = g;
+            d[i * db + bOff(df)] = b;
+            if (db == 4) d[i * db + 3] = if (sb == 4) s[i * sb + 3] else 255;
+        }
+    }
+}
+
+fn p2nvUnscaled(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int, dst: [*]const ?[*]u8, ds: [*]const c_int) void {
+    const w: usize = @intCast(c.srcW);
+    const h: usize = @intCast(c.srcH);
+    for (0..h) |y| {
+        const s = src[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[0]));
+        const d = dst[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[0]));
+        @memcpy(d[0..w], s[0..w]);
+    }
+    const cw: usize = (w + 1) / 2;
+    const ch: usize = (h + 1) / 2;
+    const swap = c.dstF == NV21;
+    for (0..ch) |y| {
+        const u = src[1].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[1]));
+        const v = src[2].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[2]));
+        const d = dst[1].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[1]));
+        if (swap) fast.interleave(d, v, u, cw) else fast.interleave(d, u, v, cw);
+    }
+}
+
+fn nv2pUnscaled(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int, dst: [*]const ?[*]u8, ds: [*]const c_int) void {
+    const w: usize = @intCast(c.srcW);
+    const h: usize = @intCast(c.srcH);
+    for (0..h) |y| {
+        const s = src[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[0]));
+        const d = dst[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[0]));
+        @memcpy(d[0..w], s[0..w]);
+    }
+    const cw: usize = (w + 1) / 2;
+    const ch: usize = (h + 1) / 2;
+    const swap = c.srcF == NV21;
+    for (0..ch) |y| {
+        const s = src[1].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[1]));
+        const u = dst[1].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[1]));
+        const v = dst[2].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[2]));
+        if (swap) fast.deinterleave(v, u, s, cw) else fast.deinterleave(u, v, s, cw);
+    }
+}
+
+fn bgr24yv12Unscaled(c: *Ctx, src: [*]const ?[*]const u8, ss: [*]const c_int, dst: [*]const ?[*]u8, ds: [*]const c_int) void {
+    const w: usize = @intCast(c.srcW);
+    const h: usize = @intCast(c.srcH);
+    const cw = w >> 1;
+    var y: usize = 0;
+    while (y + 1 < h) : (y += 2) {
+        const s1 = src[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ss[0]));
+        const s2 = s1 + @as(usize, @intCast(ss[0]));
+        const y1 = dst[0].? + @as(usize, @intCast(@as(isize, @intCast(y)) * ds[0]));
+        const y2 = y1 + @as(usize, @intCast(ds[0]));
+        const ud = dst[1].? + @as(usize, @intCast(@as(isize, @intCast(y >> 1)) * ds[1]));
+        const vd = dst[2].? + @as(usize, @intCast(@as(isize, @intCast(y >> 1)) * ds[2]));
+        for (0..cw) |i| {
+            const b11: i32 = s1[6 * i + 0];
+            const g11: i32 = s1[6 * i + 1];
+            const r11: i32 = s1[6 * i + 2];
+            const b12: i32 = s1[6 * i + 3];
+            const g12: i32 = s1[6 * i + 4];
+            const r12: i32 = s1[6 * i + 5];
+            const b21: i32 = s2[6 * i + 0];
+            const g21: i32 = s2[6 * i + 1];
+            const r21: i32 = s2[6 * i + 2];
+            const b22: i32 = s2[6 * i + 3];
+            const g22: i32 = s2[6 * i + 4];
+            const r22: i32 = s2[6 * i + 5];
+            y1[2 * i] = @truncate(@as(u32, @bitCast(((RY * r11 + GY * g11 + BY * b11) >> 15) + 16)));
+            y1[2 * i + 1] = @truncate(@as(u32, @bitCast(((RY * r12 + GY * g12 + BY * b12) >> 15) + 16)));
+            y2[2 * i] = @truncate(@as(u32, @bitCast(((RY * r21 + GY * g21 + BY * b21) >> 15) + 16)));
+            y2[2 * i + 1] = @truncate(@as(u32, @bitCast(((RY * r22 + GY * g22 + BY * b22) >> 15) + 16)));
+            const bx = (b11 + b12 + b21 + b22) >> 2;
+            const gx = (g11 + g12 + g21 + g22) >> 2;
+            const rx = (r11 + r12 + r21 + r22) >> 2;
+            ud[i] = @truncate(@as(u32, @bitCast(((RU * rx + GU * gx + BU * bx) >> 15) + 128)));
+            vd[i] = @truncate(@as(u32, @bitCast(((RV * rx + GV * gx + BV * bx) >> 15) + 128)));
+        }
+    }
+}
+
+// ── exports ─────────────────────────────────────────────────────────────────
+export fn swscale_create(src_w: c_int, src_h: c_int, src_fmt: c_int, dst_w: c_int, dst_h: c_int, dst_fmt: c_int, algo: c_int) ?*anyopaque {
+    const c = createCtx(src_w, src_h, src_fmt, dst_w, dst_h, dst_fmt, algo) catch return null;
+    return @ptrCast(c);
+}
+
+export fn swscale_process(handle: ?*anyopaque, src_data: [*]const ?[*]const u8, src_stride: [*]const c_int, dst_data: [*]const ?[*]u8, dst_stride: [*]const c_int) c_int {
+    const c: *Ctx = @ptrCast(@alignCast(handle orelse return -1));
+    switch (c.mode) {
+        .yuv2rgb => yuv2rgbUnscaled(c, src_data, src_stride, dst_data, dst_stride),
+        .rgb2rgb => rgb2rgbUnscaled(c, src_data, src_stride, dst_data, dst_stride),
+        .p2nv => p2nvUnscaled(c, src_data, src_stride, dst_data, dst_stride),
+        .nv2p => nv2pUnscaled(c, src_data, src_stride, dst_data, dst_stride),
+        .bgr24yv12 => bgr24yv12Unscaled(c, src_data, src_stride, dst_data, dst_stride),
+        .generic => {
+            if (!fast.genericFused(c, src_data, src_stride, dst_data, dst_stride)) {
+                genericHorizontal(c, src_data, src_stride);
+                genericVertical(c, dst_data, dst_stride);
+            }
+        },
+    }
+    return 0;
+}
+
+export fn swscale_destroy(handle: ?*anyopaque) void {
+    if (handle) |p| destroyCtx(@ptrCast(@alignCast(p)));
+}
