+#!/usr/bin/env python3
+"""Profile one workload: per-opcode weighted cost of ONE conversion (diff of 3-iter and 1-iter runs)."""
+import sys
+sys.path.insert(0, "/app"); sys.path.insert(0, "/app/performance")
+import performance, workloads, insn_pricing
+lib = "/app/swscale-impl/zig-out/lib/libswscale_candidate.so"
+key = sys.argv[1]
+wl = [w for w in workloads.benchmark_workloads() + workloads.correctness_workloads() if w["key"] == key][0]
+r1 = performance.measure(workloads.driver_argv("/app/driver", lib, wl, 1), lib)
+r3 = performance.measure(workloads.driver_argv("/app/driver", lib, wl, 3), lib)
+print(key, wl["label"], "work/iter=%.0f" % ((r3["work"] - r1["work"]) / 2))
+h = {k: (r3["hist"].get(k, 0) - r1["hist"].get(k, 0)) / 2 for k in r3["hist"]}
+rows = sorted(((insn_pricing.insn_cost(mn, mem) or 1.0) * n, mn, mem, n) for (mn, mem), n in h.items())[::-1]
+for c, mn, mem, n in rows[:int(sys.argv[2]) if len(sys.argv) > 2 else 25]:
+    print("%14.0f %10d %s%s" % (c, n, mn, " [mem]" if mem else ""))
