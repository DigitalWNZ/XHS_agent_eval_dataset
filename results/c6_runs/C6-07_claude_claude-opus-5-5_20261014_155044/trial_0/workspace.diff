@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Check the contract format pairs/algorithms at other frame sizes against the reference."""
+import os, sys, subprocess, random, tempfile
+sys.path.insert(0, "/app")
+import workloads as W
+lib = "/app/swscale-impl/zig-out/lib/libswscale_candidate.so"
+base = "/app/libswscale_public_baseline.so"
+tmp = tempfile.mkdtemp()
+def frame(l, wl, name):
+    out = os.path.join(tmp, name)
+    p = subprocess.run(W.driver_argv("/app/driver", l, wl, 1, out), capture_output=True)
+    return open(out, "rb").read() if p.returncode == 0 and os.path.exists(out) else None
+random.seed(int(sys.argv[1]) if len(sys.argv) > 1 else 1)
+bad = 0; n = 0
+cfgs = []
+for (s, d) in W._PAIRS:
+    for (w, h) in [(2, 2), (18, 6), (34, 10), (66, 34), (130, 18)]:
+        cfgs.append((s, d, w, h, w, h, W.BILINEAR))
+for (s, d, sw, sh, dw, dh, a) in W._SCALES:
+    for k in range(3):
+        f = random.choice([0.37, 0.5, 0.66, 1.5, 2.0, 2.7])
+        nsw = random.randrange(8, 200) * 2; nsh = random.randrange(4, 100) * 2
+        ndw = max(2, int(nsw * f) // 2 * 2); ndh = max(2, int(nsh * f) // 2 * 2)
+        cfgs.append((s, d, nsw, nsh, ndw, ndh, a))
+    cfgs.append((s, d, sw, sh, dw, dh, (a + 1) % 3))
+for cfg in cfgs:
+    wl = W._wl("x", *cfg)
+    r = frame(base, wl, "r"); c = frame(lib, wl, "c"); n += 1
+    if r is None:
+        continue
+    g = W.grade(r, c or b"", wl["dst_fmt"], wl["dst_w"], wl["dst_h"], wl["scaling"]) if c else {"status": "fail", "min_psnr": 0}
+    if g["status"] != "pass":
+        bad += 1
+        print("FAIL", wl["label"], g.get("min_psnr"))
+print(f"{n - bad}/{n} ok")
