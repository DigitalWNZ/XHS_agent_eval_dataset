+function isInfiniteDataShape(
+  value: unknown,
+): value is { pages: Array<unknown>; pageParams?: Array<unknown> } {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    'pages' in value &&
+    Array.isArray((value as { pages: unknown }).pages)
+  )
+}
+
+function resolveRestoredData<TData>(
+  data: TData | undefined,
+  stateData: unknown,
+): TData | undefined {
+  const rawData = (data !== undefined ? data : stateData) as TData | undefined
+  if (isInfiniteDataShape(rawData) || isInfiniteDataShape(stateData)) {
+    const primary = isInfiniteDataShape(rawData)
+      ? rawData
+      : (stateData as { pages: Array<unknown>; pageParams?: Array<unknown> })
+    const secondary = isInfiniteDataShape(stateData) ? stateData : undefined
+    const pages =
+      Array.isArray(primary.pages) && primary.pages.length > 0
+        ? primary.pages
+        : Array.isArray(secondary?.pages)
+          ? secondary.pages
+          : Array.isArray(primary.pages)
+            ? primary.pages
+            : []
+    const pageParams =
+      Array.isArray(primary.pageParams) && primary.pageParams.length > 0
+        ? primary.pageParams
+        : Array.isArray(secondary?.pageParams)
+          ? secondary.pageParams
+          : Array.isArray(primary.pageParams)
+            ? primary.pageParams
+            : []
+
+    return {
+      ...(secondary ?? {}),
+      ...primary,
+      pages,
+      pageParams,
+    } as TData
+  }
+  return rawData
+}
+
+export function createRestoredQueryState<
+  TQueryFnData = unknown,
+  TError = DefaultError,
+  TData = TQueryFnData,
+  TQueryKey extends QueryKey = QueryKey,
+>(
+  currentState: QueryState<TData, TError>,
+  restored: {
+    data: TData | undefined
+    state: PersisterRestoreState<TData, TError>
+  },
+  options?: QueryOptions<TQueryFnData, TError, TData, TQueryKey>,
+): QueryState<TData, TError> {
+  const { state } = restored
+  const resolvedData = resolveRestoredData<TData>(restored.data, state.data)
+  const data =
+    resolvedData !== undefined && options
+      ? replaceData(currentState.data, resolvedData, options)
+      : resolvedData
+
+  const error =
+    state.error !== undefined
+      ? state.error
+      : state.status === 'error'
+        ? (state.fetchFailureReason ?? null)
+        : null
+  const hasData = data !== undefined
+  const status: QueryStatus =
+    state.status === 'error' || (state.status === undefined && error !== null)
+      ? 'error'
+      : hasData
+        ? 'success'
+        : (state.status ?? 'pending')
+
+  return {
+    data,
+    dataUpdateCount: state.dataUpdateCount ?? (hasData ? 1 : 0),
+    dataUpdatedAt:
+      state.dataUpdatedAt ?? (hasData ? currentState.dataUpdatedAt : 0),
+    error,
+    errorUpdateCount: state.errorUpdateCount ?? (error !== null ? 1 : 0),
+    errorUpdatedAt: state.errorUpdatedAt ?? 0,
+    fetchFailureCount: state.fetchFailureCount ?? 0,
+    fetchFailureReason:
+      state.fetchFailureReason !== undefined ? state.fetchFailureReason : error,
+    fetchMeta: state.fetchMeta ?? null,
+    isInvalidated: state.isInvalidated ?? false,
+    status,
+    fetchStatus: 'idle',
+  }
+}
