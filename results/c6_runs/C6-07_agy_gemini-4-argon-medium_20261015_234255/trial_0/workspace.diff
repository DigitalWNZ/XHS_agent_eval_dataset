+    persistedState.error !== null ||
+    liveErrorUpdatedAt > 0 ||
+    persistedErrorUpdatedAt > 0 ||
+    liveState.status === 'error' ||
+    persistedState.status === 'error'
+
+  let errorSource: QueryState<TData, TError>
+  if (!hasAnyError) {
+    errorSource = dataSource
+  } else if (persistedErrorUpdatedAt > liveErrorUpdatedAt) {
+    errorSource = persistedState
+  } else if (liveErrorUpdatedAt > persistedErrorUpdatedAt) {
+    errorSource = liveState
+  } else if (persistedState.error !== null) {
