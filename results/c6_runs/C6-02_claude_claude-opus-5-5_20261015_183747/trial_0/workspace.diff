+// BatchDurableInfo contains the info for a BatchDurable event.
+type BatchDurableInfo struct {
+	// JobID is the ID of the durability job. It may be passed to
+	// DB.WaitForJobDurability. Durability job IDs are allocated independently of
+	// the job IDs used by other events.
+	JobID int
+	// SeqNum is the sequence number of the batch (i.e., the sequence number of
+	// its first key).
+	SeqNum base.SeqNum
+	// Err is the error encountered while committing or syncing the batch, if
+	// any.
+	Err error
+	// ApplyDuration is the wall-clock time spent applying the batch to the
+	// memtable.
+	ApplyDuration time.Duration
+	// SyncDuration is the wall-clock time between the batch being written to
+	// the WAL and the WAL sync covering it being acknowledged.
+	SyncDuration time.Duration
+	// CorrelationID is the WriteOptions.CommitCorrelationID the batch was
+	// committed with.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch in bytes.
+	BatchSize int
+	// KeyCount is the number of keys in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[DURABLE JOB %d] batch seqnum=%d durability error: %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), i.Err)
+		return
+	}
+	w.Printf("[DURABLE JOB %d] batch seqnum=%d (%s, %d keys) durable; apply %.3fs, sync %.3fs",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum),
+		redact.Safe(humanize.Bytes.Uint64(uint64(i.BatchSize))), redact.Safe(i.KeyCount),
+		redact.Safe(i.ApplyDuration.Seconds()), redact.Safe(i.SyncDuration.Seconds()))
+}
+
+// noopBatchDurable is the default BatchDurable handler. It is a named function
+// (rather than a closure) so that DB can detect whether a BatchDurable handler
+// was actually configured.
+func noopBatchDurable(BatchDurableInfo) {}
+
+// batchDurableConfigured returns true if f is a BatchDurable handler other
+// than the default no-op.
+func batchDurableConfigured(f func(BatchDurableInfo)) bool {
+	return f != nil && reflect.ValueOf(f).Pointer() != reflect.ValueOf(noopBatchDurable).Pointer()
+}
