+func TestDurabilityWithoutListener(t *testing.T) {
+	d := openDurabilityTestDB(t, nil, false)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+
+	err := d.WaitForJobDurability(0)
+	require.True(t, errors.Is(err, ErrDurabilityJobUnknown))
+	require.Contains(t, err.Error(), "unknown")
+	require.True(t, errors.Is(d.WaitForJobDurability(1), ErrDurabilityJobUnknown))
+
+	var seqNums []base.SeqNum
+	for i := 0; i < durabilityJobRetention+10; i++ {
+		b := d.NewBatch()
+		require.NoError(t, b.Set([]byte(fmt.Sprint(i)), nil, nil))
+		require.NoError(t, b.Commit(Sync))
+		seqNums = append(seqNums, b.SeqNum())
+		require.NoError(t, b.Close())
+	}
+	require.NoError(t, d.WaitForDurabilityBatch(seqNums))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), seqNums))
+	err = d.WaitForJobDurability(1)
+	require.True(t, errors.Is(err, ErrDurabilityJobExpired))
+	require.Contains(t, err.Error(), "expired")
+	require.NoError(t, d.WaitForJobDurability(durabilityJobRetention+10))
+	require.NoError(t, d.WaitForJobDurabilityContext(context.Background(), 11))
+	require.True(t, errors.Is(d.WaitForJobDurability(durabilityJobRetention+11), ErrDurabilityJobUnknown))
+
+	// Metrics are only accumulated when BatchDurable is configured.
+	m := d.Metrics()
+	require.Zero(t, m.DurableCommitCount)
+	require.Zero(t, m.DurableCommitDuration)
+	require.Equal(t, uint64(durabilityJobRetention+10), d.DurabilityStats().TotalDurableCommits)
+}
