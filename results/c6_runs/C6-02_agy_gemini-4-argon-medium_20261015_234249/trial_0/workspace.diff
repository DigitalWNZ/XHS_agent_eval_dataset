--- /dev/null
+++ b/durability.go
@@ -0,0 +1,534 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	durabilityJobRetentionWindow     = 64
+	maxDurabilityNotifySubscriptions = 64
+)
+
+var (
+	// ErrDurabilityJobExpired is returned when waiting for a durability job ID
+	// that has aged out of the bounded retention window.
+	ErrDurabilityJobExpired = errors.New("pebble: durability job ID expired")
+	// ErrDurabilityJobUnknown is returned when waiting for a zero, negative, or
+	// never-seen durability job ID.
+	ErrDurabilityJobUnknown = errors.New("pebble: durability job ID unknown")
+	// ErrDurabilityNotifyLimitExceeded is returned via DurabilityNotify when the
+	// number of outstanding subscriptions exceeds the bound.
+	ErrDurabilityNotifyLimitExceeded = errors.New("pebble: durability notify subscription limit exceeded")
+)
+
+// DurabilityStats is a point-in-time snapshot of WAL sync durability state and
+// statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilitySeqWaiter struct {
+	targetSeq base.SeqNum
+	ch        chan struct{}
+	removed   bool
+}
+
+type durabilityJobState struct {
+	jobID int
+	done  bool
+	err   error
+}
+
+type durabilityJobWaiter struct {
+	jobID   int
+	job     *durabilityJobState
+	ch      chan struct{}
+	removed bool
+}
+
+type durabilityNotifySub struct {
+	targetSeq base.SeqNum
+	ch        chan error
+}
+
+type durabilityTracker struct {
+	mu                     sync.Mutex
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	closed                 bool
+	pendingWaiters         int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+	metricCommitCount      uint64
+	metricCommitDuration   time.Duration
+
+	nextJobID  int
+	jobs       map[int]*durabilityJobState
+	jobOrder   []int
+	jobWaiters []*durabilityJobWaiter
+	seqWaiters []*durabilitySeqWaiter
+	notifySubs []*durabilityNotifySub
+}
+
+func (t *durabilityTracker) registerJob() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.nextJobID++
+	jobID := t.nextJobID
+	if t.jobs == nil {
+		t.jobs = make(map[int]*durabilityJobState, durabilityJobRetentionWindow+1)
+	}
+	t.jobs[jobID] = &durabilityJobState{
+		jobID: jobID,
+	}
+	t.jobOrder = append(t.jobOrder, jobID)
+	t.evictOldJobsLocked()
+	return jobID
+}
+
+func (t *durabilityTracker) evictOldJobsLocked() {
+	for len(t.jobOrder) > durabilityJobRetentionWindow {
+		oldestID := t.jobOrder[0]
+		oldest := t.jobs[oldestID]
+		if oldest != nil && !oldest.done {
+			break
+		}
+		delete(t.jobs, oldestID)
+		t.jobOrder = t.jobOrder[1:]
+	}
+}
+
+func (t *durabilityTracker) recordCommit(
+	jobID int,
+	seqNum base.SeqNum,
+	err error,
+	syncDuration time.Duration,
+	accumulateMetrics bool,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if job, ok := t.jobs[jobID]; ok {
+		job.done = true
+		job.err = err
+	}
+	t.evictOldJobsLocked()
+
+	if err == nil {
+		t.totalDurableCommits++
+		if seqNum > t.highestDurableSeqNum {
+			t.highestDurableSeqNum = seqNum
+		}
+		t.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.maxSyncDuration {
+			t.maxSyncDuration = syncDuration
+		}
+		if accumulateMetrics {
+			t.metricCommitCount++
+			t.metricCommitDuration += syncDuration
+		}
+	} else {
+		t.totalFailedCommits++
+		if t.firstErr == nil {
+			t.firstErr = err
+		}
+	}
+}
+
+func (t *durabilityTracker) notifyWaiters() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err := t.errOrClosedLocked(); err != nil {
+		t.wakeAllOnErrorLocked(err)
+		return
+	}
+
+	// Wake any jobWaiters whose job is now done.
+	remainingJobWaiters := t.jobWaiters[:0]
+	for _, jw := range t.jobWaiters {
+		if jw.job.done {
+			if !jw.removed {
+				jw.removed = true
+				t.pendingWaiters--
+				close(jw.ch)
+			}
+		} else {
+			remainingJobWaiters = append(remainingJobWaiters, jw)
+		}
+	}
+	t.jobWaiters = remainingJobWaiters
+
+	if t.totalDurableCommits > 0 {
+		// Wake any seqWaiters whose targetSeq <= t.highestDurableSeqNum.
+		remainingSeqWaiters := t.seqWaiters[:0]
+		for _, sw := range t.seqWaiters {
+			if sw.targetSeq <= t.highestDurableSeqNum {
+				if !sw.removed {
+					sw.removed = true
+					t.pendingWaiters--
+					close(sw.ch)
+				}
+			} else {
+				remainingSeqWaiters = append(remainingSeqWaiters, sw)
+			}
+		}
+		t.seqWaiters = remainingSeqWaiters
+
+		// Resolve any notifySubs whose targetSeq <= t.highestDurableSeqNum.
+		remainingSubs := t.notifySubs[:0]
+		for _, sub := range t.notifySubs {
+			if sub.targetSeq <= t.highestDurableSeqNum {
+				sub.ch <- nil
+			} else {
+				remainingSubs = append(remainingSubs, sub)
+			}
+		}
+		t.notifySubs = remainingSubs
+	}
+}
+
+func (t *durabilityTracker) wakeAllOnErrorLocked(err error) {
+	for _, jw := range t.jobWaiters {
+		if !jw.removed {
+			jw.removed = true
+			t.pendingWaiters--
+			close(jw.ch)
+		}
+	}
+	t.jobWaiters = nil
+
+	for _, sw := range t.seqWaiters {
+		if !sw.removed {
+			sw.removed = true
+			t.pendingWaiters--
+			close(sw.ch)
+		}
+	}
+	t.seqWaiters = nil
+
+	for _, sub := range t.notifySubs {
+		sub.ch <- err
+	}
+	t.notifySubs = nil
+}
+
+func (t *durabilityTracker) close() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	t.closed = true
+	err := t.firstErr
+	if err == nil {
+		err = ErrClosed
+	}
+	t.wakeAllOnErrorLocked(err)
+}
+
+func (t *durabilityTracker) isSeqDurableLocked(seqNum base.SeqNum) bool {
+	return t.totalDurableCommits > 0 && seqNum <= t.highestDurableSeqNum
+}
+
+func (t *durabilityTracker) errOrClosedLocked() error {
+	if t.firstErr != nil {
+		return t.firstErr
+	}
+	if t.closed {
+		return ErrClosed
+	}
+	return nil
+}
+
+func (t *durabilityTracker) waitForSeq(ctx context.Context, seqNum base.SeqNum) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	t.mu.Lock()
+	if err := t.errOrClosedLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+	sw := &durabilitySeqWaiter{
+		targetSeq: seqNum,
+		ch:        make(chan struct{}),
+	}
+	t.seqWaiters = append(t.seqWaiters, sw)
+	t.pendingWaiters++
+	t.mu.Unlock()
+
+	select {
+	case <-sw.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !sw.removed {
+		sw.removed = true
+		t.pendingWaiters--
+		for i, w := range t.seqWaiters {
+			if w == sw {
+				t.seqWaiters = append(t.seqWaiters[:i], t.seqWaiters[i+1:]...)
+				break
+			}
+		}
+	}
+	if err := t.errOrClosedLocked(); err != nil {
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		return nil
+	}
+	return ctx.Err()
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	t.mu.Lock()
+	if err := t.errOrClosedLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if jobID <= 0 || jobID > t.nextJobID {
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", jobID)
+	}
+	job, ok := t.jobs[jobID]
+	if !ok {
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobExpired, "job %d", jobID)
+	}
+	if job.done && job.err != nil {
+		t.mu.Unlock()
+		return job.err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if job.done {
+		t.mu.Unlock()
+		return nil
+	}
+	jw := &durabilityJobWaiter{
+		jobID: jobID,
+		job:   job,
+		ch:    make(chan struct{}),
+	}
+	t.jobWaiters = append(t.jobWaiters, jw)
+	t.pendingWaiters++
+	t.mu.Unlock()
+
+	select {
+	case <-jw.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !jw.removed {
+		jw.removed = true
+		t.pendingWaiters--
+		for i, w := range t.jobWaiters {
+			if w == jw {
+				t.jobWaiters = append(t.jobWaiters[:i], t.jobWaiters[i+1:]...)
+				break
+			}
+		}
+	}
+	if job.err != nil {
+		return job.err
+	}
+	if err := t.errOrClosedLocked(); err != nil {
+		return err
+	}
+	if job.done {
+		return nil
+	}
+	return ctx.Err()
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.highestDurableSeqNum, t.firstErr
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err := t.errOrClosedLocked(); err != nil {
+		ch <- err
+		return ch
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(t.notifySubs) >= maxDurabilityNotifySubscriptions {
+		ch <- ErrDurabilityNotifyLimitExceeded
+		return ch
+	}
+	t.notifySubs = append(t.notifySubs, &durabilityNotifySub{
+		targetSeq: seqNum,
+		ch:        ch,
+	})
+	return ch
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.highestDurableSeqNum,
+		FirstErr:               t.firstErr,
+		PendingWaiters:         t.pendingWaiters,
+		TotalDurableCommits:    t.totalDurableCommits,
+		TotalFailedCommits:     t.totalFailedCommits,
+		CumulativeSyncDuration: t.cumulativeSyncDuration,
+		MaxSyncDuration:        t.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metrics() (uint64, time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.metricCommitCount, t.metricCommitDuration
+}
+
+func (d *DB) completeSyncCommit(
+	jobID int,
+	seqNum base.SeqNum,
+	err error,
+	applyDuration time.Duration,
+	syncDuration time.Duration,
+	correlationID uint64,
+	batchSize int,
+	keyCount uint32,
+) {
+	accumulate := d.batchDurableConfigured || isBatchDurableConfigured(d.opts.EventListener.BatchDurable)
+	d.durability.recordCommit(jobID, seqNum, err, syncDuration, accumulate)
+	defer d.durability.notifyWaiters()
+	d.opts.EventListener.BatchDurable(BatchDurableInfo{
+		JobID:         jobID,
+		SeqNum:        seqNum,
+		Err:           err,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: correlationID,
+		BatchSize:     batchSize,
+		KeyCount:      keyCount,
+	})
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk. A sequence number of zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk or ctx is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForSeq(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk or ctx is cancelled. A nil or empty slice returns nil
+// immediately. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if len(seqNums) == 0 {
+		return nil
+	}
+	maxSeq := seqNums[0]
+	for _, s := range seqNums[1:] {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.durability.waitForSeq(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the sync commit job identified by jobID is
+// durable on disk.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the sync commit job identified by
+// jobID is durable on disk or ctx is cancelled. Durability and close errors
+// take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched durability error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seqNum
+// becomes durable, or a non-nil error on WAL sync failure, DB close, or when
+// outstanding subscriptions exceed the bound.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.notify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability state and statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
