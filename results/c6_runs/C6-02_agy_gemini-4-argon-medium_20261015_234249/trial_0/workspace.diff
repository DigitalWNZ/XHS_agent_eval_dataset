+func TestDurabilityErrorAndClosePrecedence(t *testing.T) {
+	t.Run("wal-sync-error", func(t *testing.T) {
+		bfs := &blockingSyncFS{
+			FS:      vfs.NewMem(),
+			entered: make(chan struct{}, 1),
+			release: make(chan struct{}),
+		}
+		var callbackInfo BatchDurableInfo
+		var callbackCount atomic.Int32
+		db, err := Open("", &Options{
+			FS: bfs,
+			EventListener: &EventListener{
+				BatchDurable: func(info BatchDurableInfo) {
+					callbackInfo = info
+					callbackCount.Add(1)
+				},
+			},
+		})
+		require.NoError(t, err)
+		defer func() {
+			_ = db.Close()
+		}()
+
+		// First sync commit succeeds.
+		require.NoError(t, db.Set([]byte("ok"), []byte("1"), Sync))
+		goodSeq, stateErr := db.DurableState()
+		require.Greater(t, goodSeq, base.SeqNum(0))
+		require.NoError(t, stateErr)
+
+		// Second sync commit blocks and fails with injected error.
+		injectedErr := errors.New("injected disk sync failure")
+		bfs.mu.Lock()
+		bfs.blockWAL = true
+		bfs.syncErr = injectedErr
+		bfs.mu.Unlock()
+
+		commitDone := make(chan error, 1)
+		go func() {
+			commitDone <- db.Set([]byte("fail"), []byte("2"), Sync)
+		}()
+		<-bfs.entered
+
+		// Register waiters for seq, batch, job, and notify while commit 2 is in-flight.
+		seqWaitCh := make(chan error, 1)
+		batchWaitCh := make(chan error, 1)
+		jobWaitCh := make(chan error, 1)
+		notifyCh := db.DurabilityNotify(goodSeq + 10)
+
+		go func() { seqWaitCh <- db.WaitForDurability(goodSeq + 10) }()
+		go func() { batchWaitCh <- db.WaitForDurabilityBatch([]base.SeqNum{goodSeq + 10}) }()
+		go func() { jobWaitCh <- db.WaitForJobDurability(2) }()
+
+		require.Eventually(t, func() bool {
+			return db.DurabilityStats().PendingWaiters == 3
+		}, 2*time.Second, time.Millisecond)
+
+		bfs.mu.Lock()
+		bfs.blockWAL = false
+		close(bfs.release)
+		bfs.mu.Unlock()
+
+		require.ErrorIs(t, <-commitDone, injectedErr)
+		require.ErrorIs(t, <-seqWaitCh, injectedErr)
+		require.ErrorIs(t, <-batchWaitCh, injectedErr)
+		require.ErrorIs(t, <-jobWaitCh, injectedErr)
+		require.ErrorIs(t, <-notifyCh, injectedErr)
+
+		require.Equal(t, int32(2), callbackCount.Load())
+		require.ErrorIs(t, callbackInfo.Err, injectedErr)
+
+		// DurableState and DurabilityStats latch FirstErr.
+		seqAfter, errAfter := db.DurableState()
+		require.Equal(t, goodSeq, seqAfter)
+		require.ErrorIs(t, errAfter, injectedErr)
+
+		stats := db.DurabilityStats()
+		require.Equal(t, goodSeq, stats.HighestDurableSeqNum)
+		require.ErrorIs(t, stats.FirstErr, injectedErr)
+		require.Equal(t, uint64(1), stats.TotalDurableCommits)
+		require.Equal(t, uint64(1), stats.TotalFailedCommits)
+		require.Equal(t, int64(0), stats.PendingWaiters)
+
+		// Durability errors take precedence over context cancellation.
+		cancelledCtx, cancel := context.WithCancel(context.Background())
+		cancel()
+		require.ErrorIs(t, db.WaitForDurabilityContext(cancelledCtx, goodSeq), injectedErr)
+		require.ErrorIs(t, db.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{goodSeq}), injectedErr)
+		require.ErrorIs(t, db.WaitForJobDurabilityContext(cancelledCtx, 1), injectedErr)
+	})
+
+	t.Run("db-close-unblocks-waiters", func(t *testing.T) {
+		db, err := Open("", &Options{FS: vfs.NewMem()})
+		require.NoError(t, err)
+
+		seqWaitCh := make(chan error, 1)
+		batchWaitCh := make(chan error, 1)
+		notifyCh := db.DurabilityNotify(100)
+
+		go func() { seqWaitCh <- db.WaitForDurability(100) }()
+		go func() { batchWaitCh <- db.WaitForDurabilityBatch([]base.SeqNum{100}) }()
+
+		require.Eventually(t, func() bool {
+			return db.DurabilityStats().PendingWaiters == 2
+		}, 2*time.Second, time.Millisecond)
+
+		require.NoError(t, db.Close())
+
+		require.Error(t, <-seqWaitCh)
+		require.Error(t, <-batchWaitCh)
+		require.Error(t, <-notifyCh)
+		require.Equal(t, int64(0), db.DurabilityStats().PendingWaiters)
+
+		// Close errors take precedence over context cancellation.
+		cancelledCtx, cancel := context.WithCancel(context.Background())
+		cancel()
+		err = db.WaitForDurabilityContext(cancelledCtx, 100)
+		require.Error(t, err)
+		require.NotErrorIs(t, err, context.Canceled)
+
+		err = db.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{100})
+		require.Error(t, err)
+		require.NotErrorIs(t, err, context.Canceled)
+
+		err = db.WaitForJobDurabilityContext(cancelledCtx, 1)
+		require.Error(t, err)
+		require.NotErrorIs(t, err, context.Canceled)
+	})
+}
+
+func TestDurabilityConcurrent(t *testing.T) {
+	var cbCount atomic.Uint64
+	db, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				cbCount.Add(1)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	const numWriters = 4
+	const commitsPerWriter = 15
+	var wg sync.WaitGroup
+	for w := 0; w < numWriters; w++ {
+		wg.Add(1)
+		go func(writerID int) {
+			defer wg.Done()
+			for i := 0; i < commitsPerWriter; i++ {
+				b := db.NewBatch()
+				require.NoError(t, b.Set([]byte("key"), []byte("val"), nil))
+				require.NoError(t, db.Apply(b, &WriteOptions{
+					Sync:                true,
+					CommitCorrelationID: uint64(writerID*1000 + i),
+				}))
+				seq := b.SeqNum()
+				require.NoError(t, b.Close())
+				require.NoError(t, db.WaitForDurability(seq))
+				ch := db.DurabilityNotify(seq)
+				require.NoError(t, <-ch)
+			}
+		}(w)
+	}
+	wg.Wait()
+
+	expectedTotal := uint64(numWriters * commitsPerWriter)
+	require.Equal(t, expectedTotal, cbCount.Load())
+
+	stats := db.DurabilityStats()
+	require.Equal(t, expectedTotal, stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Greater(t, stats.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+	require.LessOrEqual(t, stats.MaxSyncDuration, stats.CumulativeSyncDuration)
+
+	m := db.Metrics()
+	require.Equal(t, expectedTotal, m.DurableCommitCount)
+	require.Equal(t, stats.CumulativeSyncDuration, m.DurableCommitDuration)
+}
