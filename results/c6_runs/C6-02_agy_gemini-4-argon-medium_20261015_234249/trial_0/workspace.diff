+func TestDurabilityNotify(t *testing.T) {
+	db, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// Bound outstanding subscriptions.
+	subs := make([]<-chan error, maxDurabilityNotifySubscriptions)
+	for i := 0; i < maxDurabilityNotifySubscriptions; i++ {
+		subs[i] = db.DurabilityNotify(base.SeqNum(100 + i))
+	}
+
+	// Excess subscription immediately gets a pre-filled channel with non-nil error.
+	excessCh := db.DurabilityNotify(9999)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected immediate error on excess DurabilityNotify subscription")
+	}
+
+	// Perform sync commits until seqNum >= 200 to resolve all subscriptions.
+	for {
+		b := db.NewBatch()
+		for j := 0; j < 20; j++ {
+			require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+		}
+		require.NoError(t, db.Apply(b, Sync))
+		seq := b.SeqNum()
+		require.NoError(t, b.Close())
+		if seq >= 200 {
+			break
+		}
+	}
+
+	for i, ch := range subs {
+		select {
+		case err := <-ch:
+			require.NoError(t, err, "subscription %d failed", i)
+		case <-time.After(time.Second):
+			t.Fatalf("subscription %d did not resolve", i)
+		}
+	}
+
+	// Already-durable sequence number returns pre-filled nil channel immediately.
+	durableSeq, _ := db.DurableState()
+	ch := db.DurabilityNotify(durableSeq)
+	select {
+	case err := <-ch:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel for already durable seqNum")
+	}
+}
