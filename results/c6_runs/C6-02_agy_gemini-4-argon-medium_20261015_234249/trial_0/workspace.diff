+func TestWaitForJobDurability(t *testing.T) {
+	bfs := &blockingSyncFS{
+		FS:      vfs.NewMem(),
+		entered: make(chan struct{}, 1),
+		release: make(chan struct{}),
+	}
+	var lastJobID atomic.Int64
+	opts := &Options{
+		FS: bfs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID.Store(int64(info.JobID))
+			},
+		},
+	}
+	db, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// Zero, negative, and never-seen job IDs return an "unknown" error.
+	err = db.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = db.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = db.WaitForJobDurability(9999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Test blocking on an in-flight job ID.
+	bfs.mu.Lock()
+	bfs.blockWAL = true
+	bfs.mu.Unlock()
+
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- db.Set([]byte("inflight"), []byte("val"), Sync)
+	}()
+	<-bfs.entered
+
+	jobWaitDone := make(chan error, 1)
+	go func() {
+		jobWaitDone <- db.WaitForJobDurability(1)
+	}()
+	require.Eventually(t, func() bool {
+		return db.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	// Also test context cancellation while job 1 is still blocked.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancelWaitDone := make(chan error, 1)
+	go func() {
+		cancelWaitDone <- db.WaitForJobDurabilityContext(ctx, 1)
+	}()
+	require.Eventually(t, func() bool {
+		return db.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, time.Millisecond)
+	cancel()
+	require.ErrorIs(t, <-cancelWaitDone, context.Canceled)
+	require.Eventually(t, func() bool {
+		return db.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	// Release WAL sync and verify job 1 completes.
+	bfs.mu.Lock()
+	bfs.blockWAL = false
+	close(bfs.release)
+	bfs.mu.Unlock()
+
+	require.NoError(t, <-commitDone)
+	require.NoError(t, <-jobWaitDone)
+	require.NoError(t, db.WaitForJobDurability(1))
+
+	// Commit enough jobs to exceed the bounded retention window and expire job 1.
+	for i := 0; i < durabilityJobRetentionWindow+10; i++ {
+		require.NoError(t, db.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	err = db.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+
+	recentJob := int(lastJobID.Load())
+	require.NoError(t, db.WaitForJobDurability(recentJob))
+}
