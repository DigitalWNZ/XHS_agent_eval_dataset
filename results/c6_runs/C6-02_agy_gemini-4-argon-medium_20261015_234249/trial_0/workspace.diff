+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	db, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, db.Close())
+	}()
+
+	// Initial state and stats are zero before any commits.
+	seq, stateErr := db.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+	require.Equal(t, DurabilityStats{}, db.DurabilityStats())
+
+	// WaitForDurabilityBatch with nil or empty slice returns nil immediately.
+	require.NoError(t, db.WaitForDurabilityBatch(nil))
+	require.NoError(t, db.WaitForDurabilityBatch([]base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commit and succeeds after the first commit.
+	waitZeroDone := make(chan error, 1)
+	go func() {
+		waitZeroDone <- db.WaitForDurability(0)
+	}()
+
+	require.Eventually(t, func() bool {
+		return db.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	b1 := db.NewBatch()
+	require.NoError(t, b1.Set([]byte("a"), []byte("1"), nil))
+	require.NoError(t, db.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	require.NoError(t, <-waitZeroDone)
+	require.Equal(t, int64(0), db.DurabilityStats().PendingWaiters)
+
+	// After a commit, WaitForDurability(0) and WaitForDurability(seq1) succeed immediately.
+	require.NoError(t, db.WaitForDurability(0))
+	require.NoError(t, db.WaitForDurability(seq1))
+
+	// WaitForDurabilityBatch waits until all sequence numbers in the slice are durable.
+	targetSeq := seq1 + 2
+	batchWaitDone := make(chan error, 1)
+	go func() {
+		batchWaitDone <- db.WaitForDurabilityBatch([]base.SeqNum{seq1, targetSeq, seq1 + 1})
+	}()
+
+	require.Eventually(t, func() bool {
+		return db.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	// Commit seq1 + 1 (not enough to unblock targetSeq).
+	require.NoError(t, db.Set([]byte("b"), []byte("2"), Sync))
+	select {
+	case err := <-batchWaitDone:
+		t.Fatalf("unexpected early wakeup: %v", err)
+	case <-time.After(10 * time.Millisecond):
+	}
+
+	// Commit seq1 + 2 (targetSeq), which should unblock WaitForDurabilityBatch.
+	require.NoError(t, db.Set([]byte("c"), []byte("3"), Sync))
+	require.NoError(t, <-batchWaitDone)
+	require.Equal(t, int64(0), db.DurabilityStats().PendingWaiters)
+
+	// Context cancellation unblocks waiter and decrements PendingWaiters.
+	ctx, cancel := context.WithCancel(context.Background())
+	ctxWaitDone := make(chan error, 1)
+	go func() {
+		ctxWaitDone <- db.WaitForDurabilityContext(ctx, targetSeq+100)
+	}()
+	require.Eventually(t, func() bool {
+		return db.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+	cancel()
+	require.ErrorIs(t, <-ctxWaitDone, context.Canceled)
+	require.Equal(t, int64(0), db.DurabilityStats().PendingWaiters)
+}
