+    fetchFailureReason: errorSource.fetchFailureReason,
+    isInvalidated:
+      dataSource.isInvalidated || (error != null && errorSource.isInvalidated),
+    status:
+      error != null ? 'error' : data !== undefined ? 'success' : 'pending',
+    fetchStatus: current.fetchStatus,
+    fetchMeta: current.fetchMeta,
+  } satisfies QueryState
+}
