@@ -0,0 +1,342 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import { queryKey } from '@tanstack/query-test-utils'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  isPersisterRestoreResult,
+  reconcileQueryState,
+} from '..'
+import type { QueryState } from '..'
+
+describe('persister', () => {
+  let queryClient: QueryClient
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    queryClient = new QueryClient()
+    queryClient.mount()
+  })
+
+  afterEach(() => {
+    queryClient.clear()
+    vi.useRealTimers()
+  })
+
+  describe('createPersisterRestoreResult', () => {
+    test('creates a restore result marker with data and state', () => {
+      const state: Partial<QueryState<string, Error>> = {
+        data: 'cached-data',
+        status: 'success',
+        dataUpdatedAt: 1234,
+      }
+      const result = createPersisterRestoreResult({
+        data: 'custom-data',
+        state,
+      })
+
+      expect(result.data).toBe('custom-data')
+      expect(result.state).toBe(state)
+      expect(isPersisterRestoreResult(result)).toBe(true)
+    })
+
+    test('defaults data from state.data if data is not explicitly provided', () => {
+      const state: Partial<QueryState<string, Error>> = {
+        data: 'state-data',
+        status: 'success',
+      }
+      const result = createPersisterRestoreResult({ state })
+
+      expect(result.data).toBe('state-data')
+      expect(isPersisterRestoreResult(result)).toBe(true)
+    })
+
+    test('isPersisterRestoreResult returns false for non-restore results', () => {
+      expect(isPersisterRestoreResult(null)).toBe(false)
+      expect(isPersisterRestoreResult(undefined)).toBe(false)
+      expect(isPersisterRestoreResult('data')).toBe(false)
+      expect(isPersisterRestoreResult(123)).toBe(false)
+      expect(isPersisterRestoreResult({ data: 'foo' })).toBe(false)
+      expect(isPersisterRestoreResult({ data: 'foo', state: {} })).toBe(false)
+    })
+  })
+
+  describe('reconcileQueryState', () => {
+    const baseLiveState: QueryState<string, Error> = {
+      data: undefined,
+      dataUpdateCount: 0,
+      dataUpdatedAt: 0,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'pending',
+      fetchStatus: 'idle',
+    }
+
+    test('adopts persisted snapshot when live cache is empty', () => {
+      const error = new Error('persisted error')
+      const persistedState: Partial<QueryState<string, Error>> = {
+        data: 'persisted-data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 2,
+        error,
+        errorUpdatedAt: 1100,
+        errorUpdateCount: 1,
+        fetchFailureCount: 3,
+        fetchFailureReason: error,
+        isInvalidated: true,
+        status: 'error',
+      }
+
+      const reconciled = reconcileQueryState(baseLiveState, persistedState)
+
+      expect(reconciled.data).toBe('persisted-data')
+      expect(reconciled.dataUpdatedAt).toBe(1000)
+      expect(reconciled.dataUpdateCount).toBe(2)
+      expect(reconciled.error).toBe(error)
+      expect(reconciled.errorUpdatedAt).toBe(1100)
+      expect(reconciled.errorUpdateCount).toBe(1)
+      expect(reconciled.fetchFailureCount).toBe(3)
+      expect(reconciled.fetchFailureReason).toBe(error)
+      expect(reconciled.isInvalidated).toBe(true)
+      expect(reconciled.status).toBe('error')
+      expect(reconciled.fetchStatus).toBe('idle')
+    })
+
+    test('keeps live data when live has newer data, but adopts persisted error when persisted has newer error', () => {
+      const liveError = new Error('old live error')
+      const persistedError = new Error('newer persisted error')
+
+      const liveState: QueryState<string, Error> = {
+        ...baseLiveState,
+        data: 'live-newer-data',
+        dataUpdatedAt: 2000,
+        dataUpdateCount: 3,
+        error: liveError,
+        errorUpdatedAt: 1000,
+        errorUpdateCount: 1,
+        fetchFailureCount: 1,
+        fetchFailureReason: liveError,
+        status: 'error',
+      }
+
+      const persistedState: Partial<QueryState<string, Error>> = {
+        data: 'persisted-older-data',
+        dataUpdatedAt: 1500,
+        dataUpdateCount: 2,
+        error: persistedError,
+        errorUpdatedAt: 2500, // Newer error!
+        errorUpdateCount: 2,
+        fetchFailureCount: 4,
+        fetchFailureReason: persistedError,
+        status: 'error',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      // Newer data from live should be preserved
+      expect(reconciled.data).toBe('live-newer-data')
+      expect(reconciled.dataUpdatedAt).toBe(2000)
+      expect(reconciled.dataUpdateCount).toBe(3)
+
+      // Newer error from persisted should be adopted
+      expect(reconciled.error).toBe(persistedError)
+      expect(reconciled.errorUpdatedAt).toBe(2500)
+      expect(reconciled.errorUpdateCount).toBe(2)
+      expect(reconciled.fetchFailureCount).toBe(4)
+      expect(reconciled.fetchFailureReason).toBe(persistedError)
+      expect(reconciled.status).toBe('error')
+      expect(reconciled.fetchStatus).toBe('idle')
+    })
+
+    test('keeps live error when live has newer error, but adopts persisted data when persisted has newer data', () => {
+      const liveError = new Error('newer live error')
+      const persistedError = new Error('older persisted error')
+
+      const liveState: QueryState<string, Error> = {
+        ...baseLiveState,
+        data: 'live-older-data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 1,
+        error: liveError,
+        errorUpdatedAt: 2500, // Newer error!
+        errorUpdateCount: 2,
+        fetchFailureCount: 3,
+        fetchFailureReason: liveError,
+        status: 'error',
+      }
+
+      const persistedState: Partial<QueryState<string, Error>> = {
+        data: 'persisted-newer-data',
+        dataUpdatedAt: 2000, // Newer data!
+        dataUpdateCount: 2,
+        error: persistedError,
+        errorUpdatedAt: 1500,
+        errorUpdateCount: 1,
+        fetchFailureCount: 1,
+        fetchFailureReason: persistedError,
+        status: 'error',
+      }
+
+      const reconciled = reconcileQueryState(liveState, persistedState)
+
+      // Newer data from persisted should be adopted
+      expect(reconciled.data).toBe('persisted-newer-data')
+      expect(reconciled.dataUpdatedAt).toBe(2000)
+      expect(reconciled.dataUpdateCount).toBe(2)
+
+      // Newer error from live should be kept
+      expect(reconciled.error).toBe(liveError)
+      expect(reconciled.errorUpdatedAt).toBe(2500)
+      expect(reconciled.errorUpdateCount).toBe(2)
+      expect(reconciled.fetchFailureCount).toBe(3)
+      expect(reconciled.fetchFailureReason).toBe(liveError)
+      expect(reconciled.status).toBe('error')
+      expect(reconciled.fetchStatus).toBe('idle')
+    })
+
+    test('preserves isInvalidated if either side is invalidated', () => {
+      const liveInvalidated: QueryState<string, Error> = {
+        ...baseLiveState,
+        isInvalidated: true,
+      }
+      expect(reconcileQueryState(liveInvalidated, {}).isInvalidated).toBe(true)
+
+      const persistedInvalidated: Partial<QueryState<string, Error>> = {
+        isInvalidated: true,
+      }
+      expect(
+        reconcileQueryState(baseLiveState, persistedInvalidated).isInvalidated,
+      ).toBe(true)
+
+      expect(reconcileQueryState(baseLiveState, {}).isInvalidated).toBe(false)
+    })
+  })
+
+  describe('Query.fetch with persister restore', () => {
+    test('adopts provided state without triggering onSuccess or onSettled callbacks', async () => {
+      const onSuccessSpy = vi.fn()
+      const onSettledSpy = vi.fn()
+
+      const client = new QueryClient({
+        queryCache: new QueryCache({
+          onSuccess: onSuccessSpy,
+          onSettled: onSettledSpy,
+        }),
+      })
+
+      const key = queryKey()
+      const error = new Error('refetch failure')
+      const persistedState: Partial<QueryState<string, Error>> = {
+        data: 'cached data',
+        dataUpdatedAt: 1000,
+        dataUpdateCount: 1,
+        error,
+        errorUpdatedAt: 1500,
+        errorUpdateCount: 1,
+        fetchFailureCount: 2,
+        fetchFailureReason: error,
+        status: 'error',
+        isInvalidated: true,
+      }
+
+      await client.prefetchQuery({
+        queryKey: key,
+        queryFn: () => 'fresh data',
+        persister: () =>
+          createPersisterRestoreResult({
+            data: 'cached data',
+            state: persistedState,
+          }),
+      })
+
+      const query = client.getQueryCache().find({ queryKey: key })!
+      expect(query.state.data).toBe('cached data')
+      expect(query.state.status).toBe('error')
+      expect(query.state.error).toBe(error)
+      expect(query.state.fetchFailureCount).toBe(2)
+      expect(query.state.dataUpdatedAt).toBe(1000)
+      expect(query.state.errorUpdatedAt).toBe(1500)
+      expect(query.state.isInvalidated).toBe(true)
+      expect(query.state.fetchStatus).toBe('idle')
+
+      // Ensure onSuccess and onSettled were NOT called on restore
+      expect(onSuccessSpy).not.toHaveBeenCalled()
+      expect(onSettledSpy).not.toHaveBeenCalled()
+    })
+
+    test('restored refetch-error state exposes isRefetchError on observer', async () => {
+      const key = queryKey()
+      const error = new Error('background failure')
+      const persistedState: Partial<QueryState<string, Error>> = {
+        data: 'previous data',
+        dataUpdatedAt: 1000,
+        error,
+        errorUpdatedAt: 2000,
+        fetchFailureCount: 3,
+        fetchFailureReason: error,
+        status: 'error',
+      }
+
+      await queryClient.prefetchQuery({
+        queryKey: key,
+        queryFn: () => 'new data',
+        persister: () =>
+          createPersisterRestoreResult({
+            data: 'previous data',
+            state: persistedState,
+          }),
+      })
+
+      const observer = new QueryObserver(queryClient, {
+        queryKey: key,
+        staleTime: Infinity,
+      })
+
+      const result = observer.getCurrentResult()
+      expect(result.data).toBe('previous data')
+      expect(result.error).toBe(error)
+      expect(result.status).toBe('error')
+      expect(result.isError).toBe(true)
+      expect(result.isRefetchError).toBe(true)
+      expect(result.failureCount).toBe(3)
+      expect(result.failureReason).toBe(error)
+      expect(result.dataUpdatedAt).toBe(1000)
+      expect(result.errorUpdatedAt).toBe(2000)
+      expect(result.fetchStatus).toBe('idle')
+    })
+
+    test('infinite query pagination state survives restoration', async () => {
+      const key = queryKey()
+      const pages = ['page 1', 'page 2', 'page 3']
+      const pageParams = [1, 2, 3]
+
+      await queryClient.prefetchInfiniteQuery({
+        queryKey: key,
+        queryFn: () => 'fetched page',
+        initialPageParam: 1,
+        getNextPageParam: () => 4,
+        persister: () =>
+          createPersisterRestoreResult({
+            data: { pages, pageParams },
+            state: {
+              data: { pages, pageParams },
+              dataUpdatedAt: 5000,
+              status: 'success',
+            },
+          }),
+      })
+
+      const query = queryClient.getQueryCache().find({ queryKey: key })!
+      expect(query.state.data).toEqual({ pages, pageParams })
+      expect(query.state.dataUpdatedAt).toBe(5000)
+      expect(query.state.fetchStatus).toBe('idle')
+      expect(query.state.status).toBe('success')
+    })
+  })
+})
