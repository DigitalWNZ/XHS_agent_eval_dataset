+# /*
+'''
+# */
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static void fib_c(int n) {
+    if (n <= 0) {
+        printf("0\n");
+        return;
+    }
+    if (n == 1) {
+        printf("1\n");
+        return;
+    }
+
+    int max_limbs = (n / 20) + 10;
+    unsigned int *a = (unsigned int *)calloc(max_limbs, sizeof(unsigned int));
+    unsigned int *b = (unsigned int *)calloc(max_limbs, sizeof(unsigned int));
+    unsigned int *c = (unsigned int *)calloc(max_limbs, sizeof(unsigned int));
+
+    if (!a || !b || !c) {
+        free(a); free(b); free(c);
+        return;
+    }
+
+    a[0] = 0;
+    b[0] = 1;
+    int len_a = 1;
+    int len_b = 1;
+    int len_c = 1;
+
+    for (int i = 2; i <= n; i++) {
+        unsigned long long carry = 0;
+        int max_len = (len_a > len_b) ? len_a : len_b;
+        for (int j = 0; j < max_len || carry; j++) {
+            unsigned long long sum = carry;
+            if (j < len_a) sum += a[j];
+            if (j < len_b) sum += b[j];
+            c[j] = (unsigned int)(sum % 1000000000ULL);
+            carry = sum / 1000000000ULL;
+            if (j >= max_len) max_len = j + 1;
+        }
+        len_c = max_len;
+
+        unsigned int *tmp = a;
+        a = b;
+        len_a = len_b;
+        b = c;
+        len_b = len_c;
+        c = tmp;
+    }
+
+    printf("%u", b[len_b - 1]);
+    for (int i = len_b - 2; i >= 0; i--) {
+        printf("%09u", b[i]);
+    }
+    printf("\n");
+
+    free(a);
+    free(b);
+    free(c);
+}
+
+int main(int argc, char *argv[]) {
+    int n = (argc > 1) ? atoi(argv[1]) : 0;
+    fib_c(n);
+    return 0;
+}
+
