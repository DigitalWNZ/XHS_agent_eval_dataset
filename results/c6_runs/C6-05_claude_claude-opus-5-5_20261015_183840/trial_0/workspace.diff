+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Big-number Fibonacci; numbers stored as base-1e9 limbs, little-endian. */
+typedef unsigned int limb;
+#define BASE 1000000000u
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    long n = strtol(argv[1], NULL, 10);
+    if (n < 0) return 1;
+    size_t cap = (size_t)(n / 43) + 2; /* ~0.209 decimal digits per index */
+    limb *a = calloc(cap, sizeof(limb));
+    limb *b = calloc(cap, sizeof(limb));
+    if (!a || !b) return 1;
+    size_t len = 1;
+    a[0] = 0; b[0] = 1;
+    for (long i = 0; i < n; i++) {
+        /* a, b = b, a + b  -> compute a = a + b, then swap */
+        unsigned int carry = 0;
+        for (size_t j = 0; j < len; j++) {
+            unsigned int s = a[j] + b[j] + carry;
+            if (s >= BASE) { s -= BASE; carry = 1; } else carry = 0;
+            a[j] = s;
+        }
+        if (carry) { a[len] = carry; b[len] = 0; len++; }
+        limb *t = a; a = b; b = t;
+    }
+    size_t k = len;
+    while (k > 1 && a[k - 1] == 0) k--;
+    printf("%u", a[k - 1]);
+    for (size_t j = k - 1; j-- > 0;) printf("%09u", a[j]);
+    printf("\n");
+    free(a); free(b);
+    return 0;
+}
