+// BatchDurableInfo contains the info for a BatchDurable event.
+type BatchDurableInfo struct {
+	// JobID is the ID of the durability job. It can be passed to
+	// DB.WaitForJobDurability.
+	JobID int
+	// SeqNum is the base sequence number of the committed batch.
+	SeqNum base.SeqNum
+	// Err is set if the batch failed to commit or the WAL sync failed.
+	Err error
+	// ApplyDuration is the time spent applying the batch to the memtable.
+	ApplyDuration time.Duration
+	// SyncDuration is the time spent waiting for the WAL sync to complete,
+	// measured from when the batch was written to the WAL.
+	SyncDuration time.Duration
+	// CorrelationID is the WriteOptions.CommitCorrelationID provided when
+	// committing the batch.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch in bytes.
+	BatchSize int
+	// KeyCount is the number of keys in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error (seqnum=%d correlation=%d): %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.CorrelationID), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable (seqnum=%d correlation=%d size=%s keys=%d apply=%.3fs sync=%.3fs)",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.CorrelationID),
+		redact.Safe(humanize.Bytes.Uint64(uint64(i.BatchSize))), redact.Safe(i.KeyCount),
+		redact.Safe(i.ApplyDuration.Seconds()), redact.Safe(i.SyncDuration.Seconds()))
+}
+
+// nopBatchDurable is the default BatchDurable callback. It is used as a
+// sentinel to determine whether a BatchDurable callback has been configured.
+func nopBatchDurable(BatchDurableInfo) {}
+
+// isNopBatchDurable returns true if fn is nil or the default no-op
+// BatchDurable callback.
+func isNopBatchDurable(fn func(BatchDurableInfo)) bool {
+	return fn == nil || reflect.ValueOf(fn).Pointer() == reflect.ValueOf(nopBatchDurable).Pointer()
+}
