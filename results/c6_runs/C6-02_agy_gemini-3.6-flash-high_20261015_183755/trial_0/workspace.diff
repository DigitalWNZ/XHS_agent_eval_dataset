+func TestWaitForJobDurability(t *testing.T) {
+	memFS := vfs.NewMem()
+	var lastJobID int
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID = info.JobID
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Never-seen and zero job IDs return error containing "unknown"
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(-1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Commit a batch to get a valid job ID
+	err = d.Set([]byte("k1"), []byte("v1"), &WriteOptions{Sync: true})
+	require.NoError(t, err)
+	require.Greater(t, lastJobID, 0)
+	firstJobID := lastJobID
+
+	// WaitForJobDurability on completed job ID succeeds
+	err = d.WaitForJobDurability(firstJobID)
+	require.NoError(t, err)
+
+	// Expired job ID test: allocate more than maxJobRetention jobs
+	for i := 0; i < maxJobRetention+10; i++ {
+		_ = d.Set([]byte(fmt.Sprintf("k-%d", i)), []byte("v"), &WriteOptions{Sync: true})
+	}
+
+	err = d.WaitForJobDurability(firstJobID)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+}
