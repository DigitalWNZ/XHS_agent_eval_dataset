diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..d389e4b1
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,415 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats provides a snapshot of WAL durability statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type jobStatus struct {
+	seqNum base.SeqNum
+	done   chan struct{}
+	err    error
+}
+
+type durabilitySubscription struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityManager struct {
+	mu struct {
+		sync.Mutex
+		closed                 bool
+		closeErr               error
+		firstErr               error
+		highestDurableSeqNum   base.SeqNum
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+		anyCommitDone          bool
+
+		subscriptions []durabilitySubscription
+		waiters       []chan struct{}
+
+		minJobID  int
+		nextJobID int
+		jobMap    map[int]*jobStatus
+	}
+
+	pendingWaiters atomic.Int64
+
+	batchDurableConfigured bool
+	durableCommitCount     atomic.Uint64
+	durableCommitDuration  atomic.Int64
+}
+
+const (
+	maxSubscriptions = 10000
+	maxJobRetention  = 10000
+)
+
+func newDurabilityManager(batchDurableConfigured bool) *durabilityManager {
+	m := &durabilityManager{
+		batchDurableConfigured: batchDurableConfigured,
+	}
+	m.mu.jobMap = make(map[int]*jobStatus)
+	m.mu.minJobID = 1
+	m.mu.nextJobID = 1
+	return m
+}
+
+func (m *durabilityManager) allocJobID(id int) {
+	if id <= 0 {
+		return
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	status := &jobStatus{
+		done: make(chan struct{}),
+	}
+	m.mu.jobMap[id] = status
+	if id >= m.mu.nextJobID {
+		m.mu.nextJobID = id + 1
+	}
+
+	for len(m.mu.jobMap) > maxJobRetention {
+		delete(m.mu.jobMap, m.mu.minJobID)
+		m.mu.minJobID++
+	}
+}
+
+func (m *durabilityManager) updateJobSeqNum(id int, seqNum base.SeqNum) {
+	if id <= 0 {
+		return
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if status, ok := m.mu.jobMap[id]; ok {
+		status.seqNum = seqNum
+	}
+}
+
+func (m *durabilityManager) registerNotifyLocked() chan struct{} {
+	ch := make(chan struct{})
+	m.mu.waiters = append(m.mu.waiters, ch)
+	return ch
+}
+
+func (m *durabilityManager) notifyWaitersLocked() {
+	for _, ch := range m.mu.waiters {
+		close(ch)
+	}
+	m.mu.waiters = nil
+}
+
+func (m *durabilityManager) onBatchDurable(info BatchDurableInfo, batchDurableFn func(BatchDurableInfo)) {
+	if batchDurableFn != nil {
+		batchDurableFn(info)
+	}
+
+	if m.batchDurableConfigured {
+		m.durableCommitCount.Add(1)
+		if info.SyncDuration > 0 {
+			m.durableCommitDuration.Add(int64(info.SyncDuration))
+		}
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	m.mu.anyCommitDone = true
+
+	if info.Err != nil {
+		m.mu.totalFailedCommits++
+		if m.mu.firstErr == nil {
+			m.mu.firstErr = info.Err
+		}
+	} else {
+		m.mu.totalDurableCommits++
+		if info.SeqNum > m.mu.highestDurableSeqNum {
+			m.mu.highestDurableSeqNum = info.SeqNum
+		}
+		m.mu.cumulativeSyncDuration += info.SyncDuration
+		if info.SyncDuration > m.mu.maxSyncDuration {
+			m.mu.maxSyncDuration = info.SyncDuration
+		}
+	}
+
+	if status, ok := m.mu.jobMap[info.JobID]; ok {
+		status.err = info.Err
+		select {
+		case <-status.done:
+		default:
+			close(status.done)
+		}
+	}
+
+	if len(m.mu.subscriptions) > 0 {
+		var remaining []durabilitySubscription
+		for _, sub := range m.mu.subscriptions {
+			if m.mu.closed || m.mu.firstErr != nil {
+				err := m.mu.firstErr
+				if err == nil {
+					err = m.mu.closeErr
+				}
+				sub.ch <- err
+			} else if sub.seqNum == 0 || sub.seqNum <= m.mu.highestDurableSeqNum {
+				sub.ch <- info.Err
+			} else {
+				remaining = append(remaining, sub)
+			}
+		}
+		m.mu.subscriptions = remaining
+	}
+
+	m.notifyWaitersLocked()
+}
+
+func (m *durabilityManager) close(err error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	m.mu.closed = true
+	if err != nil && m.mu.firstErr == nil {
+		m.mu.firstErr = err
+	}
+	if err == nil {
+		err = ErrClosed
+	}
+	m.mu.closeErr = err
+
+	for _, sub := range m.mu.subscriptions {
+		sub.ch <- m.mu.firstErr
+	}
+	m.mu.subscriptions = nil
+
+	for _, status := range m.mu.jobMap {
+		select {
+		case <-status.done:
+		default:
+			status.err = m.mu.firstErr
+			close(status.done)
+		}
+	}
+
+	m.notifyWaitersLocked()
+}
+
+func (m *durabilityManager) DurableState() (base.SeqNum, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.mu.highestDurableSeqNum, m.mu.firstErr
+}
+
+func (m *durabilityManager) DurabilityStats() DurabilityStats {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	return DurabilityStats{
+		HighestDurableSeqNum:   m.mu.highestDurableSeqNum,
+		FirstErr:               m.mu.firstErr,
+		PendingWaiters:         m.pendingWaiters.Load(),
+		TotalDurableCommits:    m.mu.totalDurableCommits,
+		TotalFailedCommits:     m.mu.totalFailedCommits,
+		CumulativeSyncDuration: m.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        m.mu.maxSyncDuration,
+	}
+}
+
+func (m *durabilityManager) DurabilityNotify(disableWAL bool, seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if disableWAL {
+		ch <- nil
+		return ch
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.mu.closed || m.mu.firstErr != nil {
+		err := m.mu.firstErr
+		if err == nil {
+			err = m.mu.closeErr
+		}
+		ch <- err
+		return ch
+	}
+
+	if seqNum == 0 && m.mu.anyCommitDone {
+		ch <- nil
+		return ch
+	}
+
+	if seqNum > 0 && seqNum <= m.mu.highestDurableSeqNum {
+		ch <- nil
+		return ch
+	}
+
+	if len(m.mu.subscriptions) >= maxSubscriptions {
+		ch <- errors.New("durability notify subscription limit exceeded")
+		return ch
+	}
+
+	m.mu.subscriptions = append(m.mu.subscriptions, durabilitySubscription{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (m *durabilityManager) WaitForDurabilityContext(ctx context.Context, disableWAL bool, seqNum base.SeqNum) error {
+	if disableWAL {
+		return nil
+	}
+
+	m.pendingWaiters.Add(1)
+	defer m.pendingWaiters.Add(-1)
+
+	checkSatisfied := func() (bool, error) {
+		if m.mu.closed || m.mu.firstErr != nil {
+			err := m.mu.firstErr
+			if err == nil {
+				err = m.mu.closeErr
+			}
+			return true, err
+		}
+		if seqNum == 0 && m.mu.anyCommitDone {
+			return true, nil
+		}
+		if seqNum > 0 && seqNum <= m.mu.highestDurableSeqNum {
+			return true, nil
+		}
+		return false, nil
+	}
+
+	m.mu.Lock()
+	for {
+		done, err := checkSatisfied()
+		if done {
+			m.mu.Unlock()
+			return err
+		}
+
+		notifyCh := m.registerNotifyLocked()
+		m.mu.Unlock()
+
+		select {
+		case <-notifyCh:
+			m.mu.Lock()
+		case <-ctx.Done():
+			m.mu.Lock()
+			done, err := checkSatisfied()
+			m.mu.Unlock()
+			if done {
+				return err
+			}
+			return ctx.Err()
+		}
+	}
+}
+
+func (m *durabilityManager) WaitForDurabilityBatchContext(ctx context.Context, disableWAL bool, seqNums []base.SeqNum) error {
+	if disableWAL || len(seqNums) == 0 {
+		return nil
+	}
+
+	var maxSeq base.SeqNum
+	hasZero := false
+	for _, seq := range seqNums {
+		if seq == 0 {
+			hasZero = true
+		}
+		if seq > maxSeq {
+			maxSeq = seq
+		}
+	}
+
+	if maxSeq == 0 && hasZero {
+		return m.WaitForDurabilityContext(ctx, disableWAL, 0)
+	}
+
+	return m.WaitForDurabilityContext(ctx, disableWAL, maxSeq)
+}
+
+func (m *durabilityManager) WaitForJobDurabilityContext(ctx context.Context, disableWAL bool, jobID int) error {
+	if disableWAL {
+		return nil
+	}
+
+	m.pendingWaiters.Add(1)
+	defer m.pendingWaiters.Add(-1)
+
+	checkJob := func() (done bool, err error) {
+		if m.mu.closed || m.mu.firstErr != nil {
+			err := m.mu.firstErr
+			if err == nil {
+				err = m.mu.closeErr
+			}
+			return true, err
+		}
+		if jobID <= 0 || jobID >= m.mu.nextJobID {
+			return true, errors.Errorf("job %d is unknown", jobID)
+		}
+		if jobID < m.mu.minJobID {
+			return true, errors.Errorf("job %d is expired", jobID)
+		}
+		status, ok := m.mu.jobMap[jobID]
+		if !ok {
+			return true, errors.Errorf("job %d is expired", jobID)
+		}
+		select {
+		case <-status.done:
+			return true, status.err
+		default:
+			return false, nil
+		}
+	}
+
+	m.mu.Lock()
+	for {
+		done, err := checkJob()
+		if done {
+			m.mu.Unlock()
+			return err
+		}
+
+		notifyCh := m.registerNotifyLocked()
+		m.mu.Unlock()
+
+		select {
+		case <-notifyCh:
+			m.mu.Lock()
+		case <-ctx.Done():
+			m.mu.Lock()
+			done, err := checkJob()
+			m.mu.Unlock()
+			if done {
+				return err
+			}
+			return ctx.Err()
+		}
+	}
+}
