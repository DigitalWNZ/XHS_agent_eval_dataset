+func TestDurabilityUnblockOnClose(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("", &Options{FS: memFS})
+	require.NoError(t, err)
+
+	notifyCh := d.DurabilityNotify(999999)
+
+	doneCh := make(chan error, 1)
+	go func() {
+		doneCh <- d.WaitForDurability(999999)
+	}()
+
+	// Wait briefly so goroutine blocks in WaitForDurability
+	time.Sleep(10 * time.Millisecond)
+
+	err = d.Close()
+	require.NoError(t, err)
+
+	waitErr := <-doneCh
+	require.Error(t, waitErr)
+
+	notifyErr := <-notifyCh
+	require.Error(t, notifyErr)
+}
+
+func TestDurabilityContextPrecedence(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("", &Options{FS: memFS})
+	require.NoError(t, err)
+
+	err = d.Close()
+	require.NoError(t, err)
+
+	// Context is canceled already
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	// Close error must take precedence over context cancellation
+	err = d.WaitForDurabilityContext(ctx, 100)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrClosed) || errors.Is(err, errors.Cause(ErrClosed)))
+}
