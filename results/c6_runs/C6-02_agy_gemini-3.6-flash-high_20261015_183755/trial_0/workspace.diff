@@ -0,0 +1,325 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/pebble/vfs"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBatchDurableCallback(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableEvents = append(durableEvents, info)
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Sync commit with CommitCorrelationID.
+	woSync := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}
+	err = d.Set([]byte("key1"), []byte("val1"), woSync)
+	require.NoError(t, err)
+
+	require.Len(t, durableEvents, 1)
+	ev := durableEvents[0]
+	require.Greater(t, ev.JobID, 0)
+	require.Greater(t, ev.SeqNum, base.SeqNum(0))
+	require.Nil(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev.CorrelationID)
+	require.Greater(t, ev.BatchSize, 0)
+	require.Equal(t, uint32(1), ev.KeyCount)
+
+	// 2. Non-sync commit must NOT fire BatchDurable.
+	woNoSync := &WriteOptions{Sync: false}
+	err = d.Set([]byte("key2"), []byte("val2"), woNoSync)
+	require.NoError(t, err)
+
+	require.Len(t, durableEvents, 1) // still 1
+
+	// 3. TeeEventListener verification.
+	var teeEvents []BatchDurableInfo
+	teeListener := TeeEventListener(
+		EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				teeEvents = append(teeEvents, info)
+			},
+		},
+		EventListener{},
+	)
+	teeListener.BatchDurable(ev)
+	require.Len(t, teeEvents, 1)
+	require.Equal(t, ev.SeqNum, teeEvents[0].SeqNum)
+}
+
+func TestBatchDurableDisableWAL(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+
+	opts := &Options{
+		FS:         memFS,
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableEvents = append(durableEvents, info)
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	err = d.Set([]byte("key1"), []byte("val1"), &WriteOptions{Sync: false})
+	require.NoError(t, err)
+	require.Len(t, durableEvents, 0)
+}
+
+func TestWaitForDurability(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("", &Options{FS: memFS})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Initial DurableState
+	seq, err := d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(0), seq)
+
+	// Set a key with Sync: true
+	err = d.Set([]byte("k1"), []byte("v1"), &WriteOptions{Sync: true})
+	require.NoError(t, err)
+
+	durableSeq, err := d.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, durableSeq, base.SeqNum(0))
+
+	// WaitForDurability on durable sequence number
+	err = d.WaitForDurability(durableSeq)
+	require.NoError(t, err)
+
+	// WaitForDurability with seqNum = 0 succeeds after any commit
+	err = d.WaitForDurability(0)
+	require.NoError(t, err)
+
+	// WaitForDurabilityBatch
+	err = d.WaitForDurabilityBatch(nil)
+	require.NoError(t, err)
+
+	err = d.WaitForDurabilityBatch([]base.SeqNum{})
+	require.NoError(t, err)
+
+	err = d.WaitForDurabilityBatch([]base.SeqNum{0, durableSeq})
+	require.NoError(t, err)
+}
