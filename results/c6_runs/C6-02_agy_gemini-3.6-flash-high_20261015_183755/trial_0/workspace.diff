+func TestDurabilityStatsAndMetrics(t *testing.T) {
+	memFS := vfs.NewMem()
+
+	// Case 1: BatchDurable configured -> metrics accumulated
+	var events []BatchDurableInfo
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				events = append(events, info)
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+
+	stats0 := d.DurabilityStats()
+	require.Equal(t, base.SeqNum(0), stats0.HighestDurableSeqNum)
+	require.Nil(t, stats0.FirstErr)
+	require.Equal(t, int64(0), stats0.PendingWaiters)
+	require.Equal(t, uint64(0), stats0.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats0.TotalFailedCommits)
+
+	err = d.Set([]byte("k1"), []byte("v1"), &WriteOptions{Sync: true})
+	require.NoError(t, err)
+
+	stats1 := d.DurabilityStats()
+	require.Greater(t, stats1.HighestDurableSeqNum, base.SeqNum(0))
+	require.Equal(t, uint64(1), stats1.TotalDurableCommits)
+	require.Greater(t, stats1.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats1.MaxSyncDuration, time.Duration(0))
+
+	m1 := d.Metrics()
+	require.Equal(t, uint64(1), m1.DurableCommitCount)
+	require.Greater(t, m1.DurableCommitDuration, time.Duration(0))
+
+	_ = d.Close()
+
+	// Case 2: BatchDurable NOT configured -> stats updated, but metrics not accumulated
+	d2, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d2.Close()
+
+	err = d2.Set([]byte("k2"), []byte("v2"), &WriteOptions{Sync: true})
+	require.NoError(t, err)
+
+	stats2 := d2.DurabilityStats()
+	require.Equal(t, uint64(1), stats2.TotalDurableCommits)
+
+	m2 := d2.Metrics()
+	require.Equal(t, uint64(0), m2.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m2.DurableCommitDuration)
+}
