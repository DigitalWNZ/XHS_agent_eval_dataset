@@ -0,0 +1,37 @@
+import mteb
+from mteb.encoder_interface import PromptType
+import numpy as np
+
+# Load model via mteb package
+model_id = "BAAI/bge-small-zh-v1.5"
+revision = "7999e1d3359715c523056ef9478215996d62a620"
+mteb_model = mteb.get_model(model_id, revision=revision)
+
+# Load data documents
+with open("/app/data.txt", "r", encoding="utf-8") as f:
+    docs = [line.strip() for line in f if line.strip()]
+
+query = "terminal-bench"
+
+# Encode query with mteb query prompt and documents with passage prompt
+q_emb = mteb_model.encode([query], task_name="T2Retrieval", prompt_type=PromptType.query)
+d_embs = mteb_model.encode(docs, task_name="T2Retrieval", prompt_type=PromptType.passage)
+
+# Compute cosine similarity
+similarities = (q_emb @ d_embs.T)[0]
+
+# Rank documents by cosine similarity descending
+ranked_indices = np.argsort(-similarities)
+
+print("Rankings:")
+for rank, idx in enumerate(ranked_indices, 1):
+    print(f"{rank:2d}: line {idx+1:2d} (sim={similarities[idx]:.5f}): {docs[idx]}")
+
+fifth_doc = docs[ranked_indices[4]]
+print(f"\n5th document: {fifth_doc}")
+
+# Write to /app/result.txt
+with open("/app/result.txt", "w", encoding="utf-8") as f:
+    f.write(fifth_doc + "\n")
+
+print("Successfully wrote result to /app/result.txt")
