+type syncFailFS struct {
+	vfs.FS
+	failSync atomic.Bool
+}
+
+func (fs *syncFailFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	return &syncFailFile{File: f, fs: fs, name: name}, nil
+}
+
+type syncFailFile struct {
+	vfs.File
+	fs   *syncFailFS
+	name string
+}
+
+func (f *syncFailFile) Sync() error {
+	if f.fs.failSync.Load() && strings.HasSuffix(f.name, ".log") {
+		return errors.New("injected sync failure")
+	}
+	return f.File.Sync()
+}
+
+func (f *syncFailFile) SyncData() error {
+	if f.fs.failSync.Load() && strings.HasSuffix(f.name, ".log") {
+		return errors.New("injected sync failure")
+	}
+	return f.File.SyncData()
+}
