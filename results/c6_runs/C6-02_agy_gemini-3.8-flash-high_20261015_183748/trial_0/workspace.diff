+func TestDurabilitySyncFailure(t *testing.T) {
+	fs := &syncFailFS{FS: vfs.NewMem()}
+	var lastInfo atomic.Pointer[BatchDurableInfo]
+	var durableCalls atomic.Int64
+
+	opts := &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableCalls.Add(1)
+				lastInfo.Store(&info)
+			},
+		},
+	}
+
+	d, err := Open("testdb_sync_fail", opts)
+	require.NoError(t, err)
+
+	// First commit succeeds.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	require.Equal(t, int64(1), durableCalls.Load())
+	require.NoError(t, lastInfo.Load().Err)
+
+	// Subscribe to a future sequence number and launch a waiter.
+	futureSeq := lastInfo.Load().SeqNum + 50
+	ch := d.DurabilityNotify(futureSeq)
+
+	waiterErrCh := make(chan error, 1)
+	go func() {
+		waiterErrCh <- d.WaitForDurability(futureSeq)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Enable failure for WAL sync.
+	fs.failSync.Store(true)
+
+	// Next sync write should fail.
+	failedJobErr := d.Set([]byte("k2"), []byte("v2"), Sync)
+	require.Error(t, failedJobErr)
+	require.True(t, strings.Contains(failedJobErr.Error(), "injected sync failure"))
+
+	// BatchDurable must fire even on failure!
+	require.Equal(t, int64(2), durableCalls.Load())
+	info := lastInfo.Load()
+	require.NotNil(t, info)
+	require.Error(t, info.Err)
+	require.True(t, strings.Contains(info.Err.Error(), "injected sync failure"))
+	failedJobID := info.JobID
+
+	// WaitForJobDurability on the failed job returns the failure error.
+	jobErr := d.WaitForJobDurability(failedJobID)
+	require.Error(t, jobErr)
+	require.True(t, strings.Contains(jobErr.Error(), "injected sync failure"))
+
+	// Blocked waiter should unblock with the sync error.
+	select {
+	case err := <-waiterErrCh:
+		require.Error(t, err)
+		require.True(t, strings.Contains(err.Error(), "injected sync failure"))
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurability did not unblock on sync failure")
+	}
+
+	// Notification channel should deliver the sync error.
+	select {
+	case err := <-ch:
+		require.Error(t, err)
+		require.True(t, strings.Contains(err.Error(), "injected sync failure"))
+	case <-time.After(2 * time.Second):
+		t.Fatal("DurabilityNotify channel did not deliver on sync failure")
+	}
+
+	// Check DurableState and DurabilityStats.
+	_, latchedErr := d.DurableState()
+	require.Error(t, latchedErr)
+	require.True(t, strings.Contains(latchedErr.Error(), "injected sync failure"))
+
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Error(t, stats.FirstErr)
+	require.True(t, strings.Contains(stats.FirstErr.Error(), "injected sync failure"))
+
+	// Clean up. Note: DB may fail Close because WAL sync fails if failSync is still on.
+	fs.failSync.Store(false)
+	_ = d.Close()
+}
