+func TestDurabilityDBCloseUnblocksWaiters(t *testing.T) {
+	d, err := Open("testdb_close_unblock", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	targetSeq := base.SeqNum(1000)
+
+	var wg sync.WaitGroup
+	wg.Add(3)
+
+	go func() {
+		defer wg.Done()
+		err := d.WaitForDurability(targetSeq)
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrClosed))
+	}()
+
+	go func() {
+		defer wg.Done()
+		err := d.WaitForDurabilityBatch([]base.SeqNum{targetSeq})
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrClosed))
+	}()
+
+	ch := d.DurabilityNotify(targetSeq)
+	go func() {
+		defer wg.Done()
+		err := <-ch
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrClosed))
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, 5*time.Millisecond)
+
+	require.NoError(t, d.Close())
+	wg.Wait()
+}
