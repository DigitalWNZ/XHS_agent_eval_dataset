+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	s2, _ := d.DurableState()
+
+	// Already durable sequence numbers in slice return nil immediately.
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{s1, s2, 0}))
+
+	// Future slice waits until all are durable.
+	futureSeq := s2 + 3
+	unblocked := make(chan struct{})
+	go func() {
+		require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{s1, futureSeq, 0}))
+		close(unblocked)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	for {
+		curr, _ := d.DurableState()
+		if curr >= futureSeq {
+			break
+		}
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	select {
+	case <-unblocked:
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurabilityBatch did not unblock")
+	}
+}
