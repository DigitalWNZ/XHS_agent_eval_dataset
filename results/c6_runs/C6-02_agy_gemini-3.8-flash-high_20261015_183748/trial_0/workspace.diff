+func TestWaitForDurabilityBatch(t *testing.T) {
+	d, err := Open("testdb_batch_wait", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Empty and nil slice returns nil immediately.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
