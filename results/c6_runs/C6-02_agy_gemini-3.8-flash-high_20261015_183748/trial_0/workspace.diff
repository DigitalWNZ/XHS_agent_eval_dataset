+func TestWaitForDurability(t *testing.T) {
+	d, err := Open("testdb_wait", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. WaitForDurability(0) blocks before any commit.
+	zeroUnblocked := make(chan struct{})
+	go func() {
+		require.NoError(t, d.WaitForDurability(0))
+		close(zeroUnblocked)
+	}()
+
+	// Ensure the goroutine is waiting.
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Commit a write to satisfy zero waiter.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	select {
+	case <-zeroUnblocked:
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurability(0) did not unblock after commit")
+	}
+
+	// Now that at least one commit happened, WaitForDurability(0) succeeds immediately.
+	require.NoError(t, d.WaitForDurability(0))
+
+	// 2. Wait for a future sequence number.
+	highestSeq, _ := d.DurableState()
+	targetSeq := highestSeq + 5
+
+	seqUnblocked := make(chan struct{})
+	go func() {
+		require.NoError(t, d.WaitForDurability(targetSeq))
+		close(seqUnblocked)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Commit multiple writes until targetSeq is durable.
+	for {
+		curr, _ := d.DurableState()
+		if curr >= targetSeq {
+			break
+		}
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	select {
+	case <-seqUnblocked:
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurability did not unblock after reaching target seqnum")
+	}
+
+	// Sequence number is now durable, calling it should return immediately.
+	require.NoError(t, d.WaitForDurability(targetSeq))
+}
