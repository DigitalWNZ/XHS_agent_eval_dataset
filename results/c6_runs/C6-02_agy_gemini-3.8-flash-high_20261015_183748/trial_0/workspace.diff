diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..f89b28d2
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,594 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// ErrJobExpired is returned when waiting for a job ID that is outside the
+// bounded retention window.
+var ErrJobExpired = errors.New("pebble: job durability tracking expired")
+
+// ErrJobUnknown is returned when waiting for a job ID that was never seen or
+// is zero.
+var ErrJobUnknown = errors.New("pebble: unknown job ID")
+
+// ErrTooManySubscriptions is returned when outstanding durability subscriptions
+// exceed the bounded limit.
+var ErrTooManySubscriptions = errors.New("pebble: too many durability subscriptions")
+
+const (
+	defaultJobRetentionWindow = 1024
+	defaultMaxSubscriptions   = 4096
+)
+
+// DurabilityStats provides a snapshot of WAL durability statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type syncCommitTracker struct {
+	jobID         int
+	seqNum        base.SeqNum
+	correlationID uint64
+	batchSize     int
+	keyCount      uint32
+	applyDuration time.Duration
+	syncStartTime crtime.Mono
+	fired         atomic.Bool
+}
+
+type durabilitySeqWaiter struct {
+	seqNum    base.SeqNum
+	done      chan struct{}
+	err       error
+	completed bool
+}
+
+type durabilityJobWaiter struct {
+	done      chan struct{}
+	err       error
+	completed bool
+}
+
+type durabilitySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityManager struct {
+	db *DB
+	mu sync.Mutex
+
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	pendingWaiters atomic.Int64
+
+	nextJobID atomic.Int64
+
+	seqWaiters []*durabilitySeqWaiter
+
+	jobRetentionCap  int
+	maxSeenJobID     int
+	minRetainedJobID int
+	retainedJobs     map[int]error
+	retainedJobOrder []int
+	pendingJobs      map[int]*durabilityJobWaiter
+
+	maxSubscriptions int
+	subscriptions    []*durabilitySub
+}
+
+func newDurabilityManager(d *DB) *durabilityManager {
+	return &durabilityManager{
+		db:               d,
+		jobRetentionCap:  defaultJobRetentionWindow,
+		retainedJobs:     make(map[int]error),
+		pendingJobs:      make(map[int]*durabilityJobWaiter),
+		maxSubscriptions: defaultMaxSubscriptions,
+	}
+}
+
+func (dm *durabilityManager) newJobID() int {
+	id := int(dm.nextJobID.Add(1))
+	dm.registerJob(id)
+	return id
+}
+
+func (dm *durabilityManager) registerJob(jobID int) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	if jobID > dm.maxSeenJobID {
+		dm.maxSeenJobID = jobID
+	}
+	dm.pendingJobs[jobID] = &durabilityJobWaiter{
+		done: make(chan struct{}),
+	}
+}
+
+func (dm *durabilityManager) finishJob(jobID int, err error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	if waiter, ok := dm.pendingJobs[jobID]; ok {
+		waiter.err = err
+		waiter.completed = true
+		close(waiter.done)
+		delete(dm.pendingJobs, jobID)
+	}
+
+	dm.retainedJobs[jobID] = err
+	dm.retainedJobOrder = append(dm.retainedJobOrder, jobID)
+
+	for len(dm.retainedJobOrder) > dm.jobRetentionCap {
+		evicted := dm.retainedJobOrder[0]
+		dm.retainedJobOrder = dm.retainedJobOrder[1:]
+		delete(dm.retainedJobs, evicted)
+		if evicted >= dm.minRetainedJobID {
+			dm.minRetainedJobID = evicted + 1
+		}
+	}
+}
+
+func (dm *durabilityManager) onCommitDurable(info BatchDurableInfo) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	jobID := info.JobID
+	if waiter, ok := dm.pendingJobs[jobID]; ok {
+		waiter.err = info.Err
+		waiter.completed = true
+		close(waiter.done)
+		delete(dm.pendingJobs, jobID)
+	}
+
+	dm.retainedJobs[jobID] = info.Err
+	dm.retainedJobOrder = append(dm.retainedJobOrder, jobID)
+	for len(dm.retainedJobOrder) > dm.jobRetentionCap {
+		evicted := dm.retainedJobOrder[0]
+		dm.retainedJobOrder = dm.retainedJobOrder[1:]
+		delete(dm.retainedJobs, evicted)
+		if evicted >= dm.minRetainedJobID {
+			dm.minRetainedJobID = evicted + 1
+		}
+	}
+
+	if info.Err != nil {
+		dm.totalFailedCommits++
+		if dm.firstErr == nil {
+			dm.firstErr = info.Err
+		}
+		// Wake up all pending sequence waiters and notify subscribers with the error.
+		for _, w := range dm.seqWaiters {
+			w.err = info.Err
+			w.completed = true
+			close(w.done)
+		}
+		dm.seqWaiters = nil
+
+		for _, sub := range dm.subscriptions {
+			sub.ch <- info.Err
+			close(sub.ch)
+		}
+		dm.subscriptions = nil
+		return
+	}
+
+	dm.totalDurableCommits++
+	var highestSeq base.SeqNum
+	if info.KeyCount > 0 {
+		highestSeq = info.SeqNum + base.SeqNum(info.KeyCount-1)
+	} else {
+		highestSeq = info.SeqNum
+	}
+	if highestSeq > dm.highestDurableSeqNum {
+		dm.highestDurableSeqNum = highestSeq
+	}
+	dm.cumulativeSyncDuration += info.SyncDuration
+	if info.SyncDuration > dm.maxSyncDuration {
+		dm.maxSyncDuration = info.SyncDuration
+	}
+
+	// Wake up seq waiters that are satisfied.
+	activeWaiters := dm.seqWaiters[:0]
+	for _, w := range dm.seqWaiters {
+		if (w.seqNum == 0 && dm.totalDurableCommits > 0) || (w.seqNum > 0 && dm.highestDurableSeqNum >= w.seqNum) {
+			w.err = nil
+			w.completed = true
+			close(w.done)
+		} else {
+			activeWaiters = append(activeWaiters, w)
+		}
+	}
+	dm.seqWaiters = activeWaiters
+
+	// Notify subscriptions that are satisfied.
+	activeSubs := dm.subscriptions[:0]
+	for _, sub := range dm.subscriptions {
+		if (sub.seqNum == 0 && dm.totalDurableCommits > 0) || (sub.seqNum > 0 && dm.highestDurableSeqNum >= sub.seqNum) {
+			sub.ch <- nil
+			close(sub.ch)
+		} else {
+			activeSubs = append(activeSubs, sub)
+		}
+	}
+	dm.subscriptions = activeSubs
+}
+
+func (dm *durabilityManager) close(closeErr error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	err := closeErr
+	if dm.firstErr != nil {
+		err = dm.firstErr
+	} else {
+		dm.firstErr = closeErr
+	}
+
+	for _, j := range dm.pendingJobs {
+		j.err = err
+		j.completed = true
+		close(j.done)
+	}
+	dm.pendingJobs = make(map[int]*durabilityJobWaiter)
+
+	for _, w := range dm.seqWaiters {
+		w.err = err
+		w.completed = true
+		close(w.done)
+	}
+	dm.seqWaiters = nil
+
+	for _, sub := range dm.subscriptions {
+		sub.ch <- err
+		close(sub.ch)
+	}
+	dm.subscriptions = nil
+}
+
+func (dm *durabilityManager) removeSeqWaiterLocked(w *durabilitySeqWaiter) {
+	for i, waiter := range dm.seqWaiters {
+		if waiter == w {
+			copy(dm.seqWaiters[i:], dm.seqWaiters[i+1:])
+			dm.seqWaiters[len(dm.seqWaiters)-1] = nil
+			dm.seqWaiters = dm.seqWaiters[:len(dm.seqWaiters)-1]
+			break
+		}
+	}
+}
+
+func (dm *durabilityManager) isClosedLocked() bool {
+	return dm.db.closed.Load() != nil
+}
+
+func (dm *durabilityManager) waitForDurability(ctx context.Context, seqNum base.SeqNum) error {
+	if dm.db.opts.DisableWAL {
+		return nil
+	}
+
+	dm.mu.Lock()
+	// Durability / close errors take precedence over context cancellation.
+	if (seqNum == 0 && dm.totalDurableCommits > 0) || (seqNum > 0 && dm.highestDurableSeqNum >= seqNum) {
+		dm.mu.Unlock()
+		return nil
+	}
+	if dm.firstErr != nil {
+		err := dm.firstErr
+		dm.mu.Unlock()
+		return err
+	}
+	if dm.isClosedLocked() {
+		dm.mu.Unlock()
+		return ErrClosed
+	}
+
+	if err := ctx.Err(); err != nil {
+		dm.mu.Unlock()
+		return err
+	}
+
+	waiter := &durabilitySeqWaiter{
+		seqNum: seqNum,
+		done:   make(chan struct{}),
+	}
+	dm.seqWaiters = append(dm.seqWaiters, waiter)
+	dm.pendingWaiters.Add(1)
+	defer dm.pendingWaiters.Add(-1)
+	dm.mu.Unlock()
+
+	select {
+	case <-waiter.done:
+		return waiter.err
+	case <-ctx.Done():
+		dm.mu.Lock()
+		defer dm.mu.Unlock()
+		if waiter.completed {
+			return waiter.err
+		}
+		if (seqNum == 0 && dm.totalDurableCommits > 0) || (seqNum > 0 && dm.highestDurableSeqNum >= seqNum) {
+			dm.removeSeqWaiterLocked(waiter)
+			return nil
+		}
+		if dm.firstErr != nil {
+			dm.removeSeqWaiterLocked(waiter)
+			return dm.firstErr
+		}
+		if dm.isClosedLocked() {
+			dm.removeSeqWaiterLocked(waiter)
+			return ErrClosed
+		}
+		dm.removeSeqWaiterLocked(waiter)
+		return ctx.Err()
+	}
+}
+
+func (dm *durabilityManager) waitForJobDurability(ctx context.Context, jobID int) error {
+	if dm.db.opts.DisableWAL {
+		return nil
+	}
+
+	if jobID <= 0 {
+		return ErrJobUnknown
+	}
+
+	dm.mu.Lock()
+	// Check if already completed and in retention window.
+	if err, ok := dm.retainedJobs[jobID]; ok {
+		dm.mu.Unlock()
+		return err
+	}
+
+	// If job ID is older than retention window, it is expired.
+	if dm.minRetainedJobID > 0 && jobID < dm.minRetainedJobID {
+		dm.mu.Unlock()
+		return ErrJobExpired
+	}
+
+	// Check if currently pending.
+	waiter, ok := dm.pendingJobs[jobID]
+	if !ok {
+		// Not pending and not in retention window.
+		dm.mu.Unlock()
+		return ErrJobUnknown
+	}
+
+	if dm.firstErr != nil {
+		err := dm.firstErr
+		dm.mu.Unlock()
+		return err
+	}
+	if dm.isClosedLocked() {
+		dm.mu.Unlock()
+		return ErrClosed
+	}
+
+	if err := ctx.Err(); err != nil {
+		dm.mu.Unlock()
+		return err
+	}
+
+	dm.pendingWaiters.Add(1)
+	defer dm.pendingWaiters.Add(-1)
+	dm.mu.Unlock()
+
+	select {
+	case <-waiter.done:
+		return waiter.err
+	case <-ctx.Done():
+		dm.mu.Lock()
+		defer dm.mu.Unlock()
+		if waiter.completed {
+			return waiter.err
+		}
+		if err, ok := dm.retainedJobs[jobID]; ok {
+			return err
+		}
+		if dm.firstErr != nil {
+			return dm.firstErr
+		}
+		if dm.isClosedLocked() {
+			return ErrClosed
+		}
+		return ctx.Err()
+	}
+}
+
+func (dm *durabilityManager) durabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if dm.db.opts.DisableWAL {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	if dm.firstErr != nil {
+		ch <- dm.firstErr
+		close(ch)
+		return ch
+	}
+	if dm.isClosedLocked() {
+		ch <- ErrClosed
+		close(ch)
+		return ch
+	}
+	if (seqNum == 0 && dm.totalDurableCommits > 0) || (seqNum > 0 && dm.highestDurableSeqNum >= seqNum) {
+		ch <- nil
+		close(ch)
+		return ch
+	}
+
+	if len(dm.subscriptions) >= dm.maxSubscriptions {
+		ch <- ErrTooManySubscriptions
+		close(ch)
+		return ch
+	}
+
+	dm.subscriptions = append(dm.subscriptions, &durabilitySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (dm *durabilityManager) durableState() (base.SeqNum, error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	return dm.highestDurableSeqNum, dm.firstErr
+}
+
+func (dm *durabilityManager) durabilityStats() DurabilityStats {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   dm.highestDurableSeqNum,
+		FirstErr:               dm.firstErr,
+		PendingWaiters:         dm.pendingWaiters.Load(),
+		TotalDurableCommits:    dm.totalDurableCommits,
+		TotalFailedCommits:     dm.totalFailedCommits,
+		CumulativeSyncDuration: dm.cumulativeSyncDuration,
+		MaxSyncDuration:        dm.maxSyncDuration,
+	}
+}
+
+// WaitForDurability blocks until a sequence number is durable. A sequence
+// number of zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.durabilityMgr.waitForDurability(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until a sequence number is durable or the
+// context is cancelled. Durability and close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durabilityMgr.waitForDurability(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in a slice is
+// durable. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in a slice is
+// durable or the context is cancelled. A nil or empty slice returns nil
+// immediately. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	var hasZero bool
+	for _, s := range seqNums {
+		if s == 0 {
+			hasZero = true
+		} else if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	if maxSeq > 0 {
+		return d.WaitForDurabilityContext(ctx, maxSeq)
+	}
+	if hasZero {
+		return d.WaitForDurabilityContext(ctx, 0)
+	}
+	return nil
+}
+
+// WaitForJobDurability waits for a commit to become durable by callback job ID.
+// Jobs outside a bounded retention window get a distinguishable "expired" error.
+// Never-seen and zero IDs get an "unknown" error.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.durabilityMgr.waitForJobDurability(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext waits for a commit to become durable by callback
+// job ID or until the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durabilityMgr.waitForJobDurability(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first latched
+// error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durabilityMgr.durableState()
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil on
+// success or a non-nil error on WAL sync failure or DB close. Outstanding
+// subscriptions are bounded; excess callers get a pre-filled channel with an
+// immediate non-nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durabilityMgr.durabilityNotify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability statistics. All fields start
+// at their zero values before any commits. PendingWaiters reflects the number
+// of goroutines currently blocked in wait APIs.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durabilityMgr.durabilityStats()
+}
+
+func (d *DB) onSyncCommitComplete(batch *Batch, commitErr error) {
+	tracker := batch.syncCommit
+	if tracker == nil || !tracker.fired.CompareAndSwap(false, true) {
+		return
+	}
+
+	syncDuration := tracker.syncStartTime.Elapsed()
+	applyDuration := tracker.applyDuration
+	if commitErr == nil {
+		if applyDuration <= 0 {
+			applyDuration = time.Nanosecond
+		}
+		if syncDuration <= 0 {
+			syncDuration = time.Nanosecond
+		}
+	}
+
+	info := BatchDurableInfo{
+		JobID:         tracker.jobID,
+		SeqNum:        tracker.seqNum,
+		Err:           commitErr,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: tracker.correlationID,
+		BatchSize:     tracker.batchSize,
+		KeyCount:      tracker.keyCount,
+	}
+
+	d.durabilityMgr.onCommitDurable(info)
+
+	if d.batchDurableConfigured && commitErr == nil {
+		d.durableCommitCount.Add(1)
+		d.durableCommitDuration.Add(int64(syncDuration))
+	}
+
+	d.opts.EventListener.BatchDurable(info)
+}
