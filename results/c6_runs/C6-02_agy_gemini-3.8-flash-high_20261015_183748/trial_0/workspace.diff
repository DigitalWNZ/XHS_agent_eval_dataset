+func TestBatchDurableCallback(t *testing.T) {
+	mem := vfs.NewMem()
+	var durableCount atomic.Int64
+	var lastInfo atomic.Pointer[BatchDurableInfo]
+
+	opts := &Options{
+		FS: mem,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableCount.Add(1)
+				lastInfo.Store(&info)
+			},
+		},
+	}
+
+	d, err := Open("testdb", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Successful Sync commit.
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), wo))
+
+	require.Equal(t, int64(1), durableCount.Load())
+	info := lastInfo.Load()
+	require.NotNil(t, info)
+	require.Greater(t, info.JobID, 0)
+	require.Greater(t, info.SeqNum, base.SeqNum(0))
+	require.NoError(t, info.Err)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), info.CorrelationID)
+	require.Greater(t, info.BatchSize, 0)
+	require.Equal(t, uint32(1), info.KeyCount)
+
+	// 2. Non-sync commit must never trigger callback.
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), NoSync))
+	require.Equal(t, int64(1), durableCount.Load())
+
+	// 3. Multi-key batch commit.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, b.Set([]byte("k4"), []byte("v4"), nil))
+	require.NoError(t, b.Delete([]byte("k1"), nil))
+	bwo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 99,
+	}
+	require.NoError(t, b.Commit(bwo))
+
+	require.Equal(t, int64(2), durableCount.Load())
+	info = lastInfo.Load()
+	require.Equal(t, uint32(3), info.KeyCount)
+	require.Equal(t, uint64(99), info.CorrelationID)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+
+	// 4. Metrics accumulated when BatchDurable is configured.
+	m := d.Metrics()
+	require.Equal(t, uint64(2), m.DurableCommitCount)
+	require.Greater(t, m.DurableCommitDuration, time.Duration(0))
