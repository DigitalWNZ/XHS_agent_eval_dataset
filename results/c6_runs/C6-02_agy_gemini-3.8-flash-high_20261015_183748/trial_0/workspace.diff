+func TestWaitForJobDurability(t *testing.T) {
+	var jobID int
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				jobID = info.JobID
+			},
+		},
+	}
+	d, err := Open("testdb_jobs", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Zero and negative IDs get an unknown error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.True(t, strings.Contains(err.Error(), "unknown"))
+
+	err = d.WaitForJobDurability(-1)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.True(t, strings.Contains(err.Error(), "unknown"))
+
+	// 2. Never-seen IDs get an unknown error.
+	err = d.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.True(t, strings.Contains(err.Error(), "unknown"))
+
+	// 3. Commit a sync write and wait by its job ID.
+	require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	require.Greater(t, jobID, 0)
+	require.NoError(t, d.WaitForJobDurability(jobID))
+
+	// 4. Test bounded retention expiration.
+	firstJobID := jobID
+	// The default retention window is 1024 jobs. Commit 1050 more sync writes to evict firstJobID.
+	for i := 0; i < 1050; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	err = d.WaitForJobDurability(firstJobID)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobExpired))
+	require.True(t, strings.Contains(err.Error(), "expired"))
+
+	// Latest job ID is still within retention window.
+	require.NoError(t, d.WaitForJobDurability(jobID))
+}
