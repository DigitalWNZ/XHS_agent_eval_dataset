+func TestDurabilityNotify(t *testing.T) {
+	d, err := Open("testdb_notify", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d.Close()
+
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	s1, _ := d.DurableState()
+
+	// Already durable sequence number returns pre-filled channel with nil.
+	ch := d.DurabilityNotify(s1)
+	require.NoError(t, <-ch)
+
+	// Future sequence number waits until durable.
+	futureSeq := s1 + 2
+	chFuture := d.DurabilityNotify(futureSeq)
+
+	go func() {
+		for {
+			curr, _ := d.DurableState()
+			if curr >= futureSeq {
+				break
+			}
+			_ = d.Set([]byte("k"), []byte("v"), Sync)
+		}
+	}()
+
+	select {
+	case err := <-chFuture:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("DurabilityNotify channel did not deliver")
+	}
+
+	// Test subscription bounds.
+	var subs []<-chan error
+	// defaultMaxSubscriptions is 4096.
+	for i := 0; i < 4096; i++ {
+		subs = append(subs, d.DurabilityNotify(base.SeqNum(9999999)))
+	}
+	// Excess caller gets pre-filled channel with immediate non-nil error.
+	excessCh := d.DurabilityNotify(base.SeqNum(9999999))
+	excessErr := <-excessCh
+	require.Error(t, excessErr)
+	require.True(t, errors.Is(excessErr, ErrTooManySubscriptions))
+}
+
+func TestDurabilityContextPrecedence(t *testing.T) {
+	d, err := Open("testdb_ctx", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	s1, _ := d.DurableState()
+
+	// 1. Context already cancelled, but sequence number is already durable:
+	// Durability takes precedence!
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.NoError(t, d.WaitForDurabilityContext(canceledCtx, s1))
+	require.NoError(t, d.WaitForDurabilityContext(canceledCtx, 0))
+	require.NoError(t, d.WaitForDurabilityBatchContext(canceledCtx, []base.SeqNum{s1, 0}))
+
+	// 2. Context cancelled and seqnum is not durable:
+	require.Equal(t, context.Canceled, d.WaitForDurabilityContext(canceledCtx, s1+100))
+
+	// 3. Close the DB. Durability/close errors take precedence over cancellation.
+	require.NoError(t, d.Close())
+
+	err = d.WaitForDurabilityContext(canceledCtx, s1+100)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrClosed))
+
+	// Job 1 was already durable before close, so durability takes precedence.
+	require.NoError(t, d.WaitForJobDurabilityContext(canceledCtx, 1))
+}
