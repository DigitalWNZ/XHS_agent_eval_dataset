+
+#define BASE 1000000000U
+#define MAX_LIMBS 50000
+
+typedef struct {
+    uint32_t limbs[MAX_LIMBS];
+    int len;
+} BigInt;
+
+static void bigint_init_int(BigInt *num, uint32_t val) {
+    num->len = 1;
+    num->limbs[0] = val;
+}
+
+static void bigint_add(const BigInt *a, const BigInt *b, BigInt *res) {
+    uint64_t carry = 0;
+    int max_len = (a->len > b->len) ? a->len : b->len;
+    int i = 0;
+    for (; i < max_len || carry; i++) {
+        uint64_t sum = carry;
+        if (i < a->len) sum += a->limbs[i];
+        if (i < b->len) sum += b->limbs[i];
+        res->limbs[i] = (uint32_t)(sum % BASE);
+        carry = sum / BASE;
+    }
+    res->len = i;
+}
+
+static void bigint_print(const BigInt *num) {
+    printf("%u", num->limbs[num->len - 1]);
+    for (int i = num->len - 2; i >= 0; i--) {
+        printf("%09u", num->limbs[i]);
+    }
+    printf("\n");
+}
+
+static void print_fib(long long n) {
+    if (n <= 0) {
+        printf("0\n");
+        return;
+    }
+    BigInt *a = (BigInt *)malloc(sizeof(BigInt));
+    BigInt *b = (BigInt *)malloc(sizeof(BigInt));
+    BigInt *temp = (BigInt *)malloc(sizeof(BigInt));
+    if (!a || !b || !temp) {
+        fprintf(stderr, "Memory allocation failed\n");
+        exit(1);
+    }
+    bigint_init_int(a, 0);
+    bigint_init_int(b, 1);
+
+    for (long long i = 0; i < n; i++) {
+        bigint_add(a, b, temp);
+        BigInt *t = a;
+        a = b;
+        b = temp;
+        temp = t;
+    }
+    bigint_print(a);
+    free(a);
+    free(b);
+    free(temp);
+}
+
+int main(int argc, char *argv[]) {
+    if (argc < 2) {
+        return 0;
+    }
