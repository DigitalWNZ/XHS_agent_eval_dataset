+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() { _ = d.Close() }()
+
+	// Subscribe to sequence number 0 before any commit.
+	ch0 := d.DurabilityNotify(0)
+	select {
+	case err := <-ch0:
+		t.Fatalf("unexpected immediate notification before commit: %v", err)
+	default:
+	}
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seq1 := b.SeqNum()
+	_ = b.Close()
+
+	// ch0 should now receive nil.
+	require.NoError(t, <-ch0)
+
+	// Already-durable seqNum returns a pre-filled channel with nil.
+	chReady := d.DurabilityNotify(seq1)
+	require.Len(t, chReady, 1)
+	require.NoError(t, <-chReady)
+
+	// Bound outstanding subscriptions.
+	futureSeq := seq1 + 1000
+	subs := make([]<-chan error, 0, maxDurabilityNotifySubscriptions)
+	for i := 0; i < maxDurabilityNotifySubscriptions; i++ {
+		sub := d.DurabilityNotify(futureSeq)
+		require.Len(t, sub, 0)
+		subs = append(subs, sub)
+	}
+
+	// Excess subscription gets a pre-filled channel with a non-nil error.
+	excess := d.DurabilityNotify(futureSeq)
+	require.Len(t, excess, 1)
+	require.Error(t, <-excess)
+}
