+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() { _ = d.Close() }()
+
+	// Initial state before any commits.
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+
+	// WaitForDurabilityBatch with nil or empty slice returns nil immediately.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commit and succeeds after the first commit.
+	zeroDone := make(chan error, 1)
+	go func() {
+		zeroDone <- d.WaitForDurability(0)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	_ = b1.Close()
+
+	require.NoError(t, <-zeroDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(seq1))
+
+	// Wait for future sequence numbers via WaitForDurability and WaitForDurabilityBatch.
+	targetSeq := seq1 + 2
+	batchDone := make(chan error, 1)
+	go func() {
+		batchDone <- d.WaitForDurabilityBatch([]base.SeqNum{seq1, targetSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Commit seq1+1 (not yet targetSeq).
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	select {
+	case err := <-batchDone:
+		t.Fatalf("WaitForDurabilityBatch returned early: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+
+	// Commit seq1+2 (reaches targetSeq).
+	require.NoError(t, d.Set([]byte("k3"), []byte("v3"), Sync))
+	require.NoError(t, <-batchDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
