diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..6117b02a
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,552 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxRetainedDurabilityJobs bounds the number of recent sync commit jobs
+	// retained for WaitForJobDurability lookups.
+	maxRetainedDurabilityJobs = 256
+
+	// maxDurabilityNotifySubscriptions bounds the number of outstanding
+	// DurabilityNotify channel subscriptions.
+	maxDurabilityNotifySubscriptions = 256
+)
+
+var (
+	errDurabilityUnknownJob = errors.New("pebble: unknown durability job ID")
+	errDurabilityExpiredJob = errors.New("pebble: expired durability job ID")
+	errDurabilityMaxNotify  = errors.New("pebble: maximum durability notify subscriptions exceeded")
+)
+
+// DurabilityStats holds a snapshot of batch durability tracking statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJobState struct {
+	jobID  int
+	seqNum base.SeqNum
+	done   bool
+	err    error
+}
+
+type seqWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+	err    error
+}
+
+type jobWaiter struct {
+	jobID int
+	ch    chan struct{}
+	err   error
+}
+
+type notifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityTracker struct {
+	disableWAL bool
+
+	mu struct {
+		sync.Mutex
+		closed                 bool
+		closeErr               error
+		highestDurableSeq      base.SeqNum
+		firstErr               error
+		pendingWaiters         int64
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		// Metrics fields accumulated only when EventListener.BatchDurable is configured.
+		metricDurableCount    uint64
+		metricDurableDuration time.Duration
+
+		nextJobID int
+		minJobID  int
+		jobs      map[int]*durabilityJobState
+		jobOrder  []int
+
+		seqWaiters map[*seqWaiter]struct{}
+		jobWaiters map[*jobWaiter]struct{}
+		notifySubs []*notifySub
+	}
+}
+
+func (t *durabilityTracker) init(disableWAL bool) {
+	t.disableWAL = disableWAL
+	t.mu.jobs = make(map[int]*durabilityJobState)
+	t.mu.seqWaiters = make(map[*seqWaiter]struct{})
+	t.mu.jobWaiters = make(map[*jobWaiter]struct{})
+}
+
+// registerJob allocates a new job ID for a Sync commit and records it as
+// in-flight.
+func (t *durabilityTracker) registerJob(seqNum base.SeqNum) int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	t.mu.nextJobID++
+	jobID := t.mu.nextJobID
+	if t.mu.minJobID == 0 {
+		t.mu.minJobID = jobID
+	}
+	t.mu.jobs[jobID] = &durabilityJobState{
+		jobID:  jobID,
+		seqNum: seqNum,
+	}
+	t.mu.jobOrder = append(t.mu.jobOrder, jobID)
+	for len(t.mu.jobOrder) > maxRetainedDurabilityJobs {
+		evictID := t.mu.jobOrder[0]
+		t.mu.jobOrder = t.mu.jobOrder[1:]
+		delete(t.mu.jobs, evictID)
+		if len(t.mu.jobOrder) > 0 {
+			t.mu.minJobID = t.mu.jobOrder[0]
+		} else {
+			t.mu.minJobID = jobID + 1
+		}
+	}
+	return jobID
+}
+
+func (t *durabilityTracker) isSeqDurableLocked(seqNum base.SeqNum) bool {
+	return t.mu.totalDurableCommits > 0 && t.mu.highestDurableSeq >= seqNum
+}
+
+// completeJob updates durability state when a Sync commit finishes its WAL sync.
+func (t *durabilityTracker) completeJob(
+	jobID int,
+	seqNum base.SeqNum,
+	syncDuration time.Duration,
+	err error,
+	batchDurableConfigured bool,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if job, ok := t.mu.jobs[jobID]; ok {
+		job.done = true
+		job.err = err
+	}
+
+	if err != nil {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		for w := range t.mu.seqWaiters {
+			w.err = t.mu.firstErr
+			close(w.ch)
+			delete(t.mu.seqWaiters, w)
+		}
+		for w := range t.mu.jobWaiters {
+			w.err = t.mu.firstErr
+			close(w.ch)
+			delete(t.mu.jobWaiters, w)
+		}
+		for _, sub := range t.mu.notifySubs {
+			sub.ch <- t.mu.firstErr
+		}
+		t.mu.notifySubs = nil
+		return
+	}
+
+	t.mu.totalDurableCommits++
+	t.mu.cumulativeSyncDuration += syncDuration
+	if syncDuration > t.mu.maxSyncDuration {
+		t.mu.maxSyncDuration = syncDuration
+	}
+	if batchDurableConfigured {
+		t.mu.metricDurableCount++
+		t.mu.metricDurableDuration += syncDuration
+	}
+	if seqNum > t.mu.highestDurableSeq {
+		t.mu.highestDurableSeq = seqNum
+	}
+
+	for w := range t.mu.seqWaiters {
+		if t.isSeqDurableLocked(w.seqNum) {
+			close(w.ch)
+			delete(t.mu.seqWaiters, w)
+		}
+	}
+	for w := range t.mu.jobWaiters {
+		if w.jobID == jobID {
+			close(w.ch)
+			delete(t.mu.jobWaiters, w)
+		} else if j, ok := t.mu.jobs[w.jobID]; ok && j.done {
+			w.err = j.err
+			close(w.ch)
+			delete(t.mu.jobWaiters, w)
+		}
+	}
+
+	remaining := t.mu.notifySubs[:0]
+	for _, sub := range t.mu.notifySubs {
+		if t.isSeqDurableLocked(sub.seqNum) {
+			sub.ch <- nil
+		} else {
+			remaining = append(remaining, sub)
+		}
+	}
+	t.mu.notifySubs = remaining
+}
+
+func (t *durabilityTracker) close(closeErr error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if t.mu.closed {
+		return
+	}
+	t.mu.closed = true
+	if closeErr == nil {
+		closeErr = ErrClosed
+	}
+	t.mu.closeErr = closeErr
+
+	wakeErr := t.mu.firstErr
+	if wakeErr == nil {
+		wakeErr = closeErr
+	}
+
+	for w := range t.mu.seqWaiters {
+		w.err = wakeErr
+		close(w.ch)
+		delete(t.mu.seqWaiters, w)
+	}
+	for w := range t.mu.jobWaiters {
+		w.err = wakeErr
+		close(w.ch)
+		delete(t.mu.jobWaiters, w)
+	}
+	for _, sub := range t.mu.notifySubs {
+		sub.ch <- wakeErr
+	}
+	t.mu.notifySubs = nil
+}
+
+func (t *durabilityTracker) waitForSeq(ctx context.Context, seqNum base.SeqNum) error {
+	t.mu.Lock()
+	if t.mu.closed {
+		err := t.mu.firstErr
+		if err == nil {
+			err = t.mu.closeErr
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if t.disableWAL {
+		t.mu.Unlock()
+		return nil
+	}
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     make(chan struct{}),
+	}
+	t.mu.seqWaiters[w] = struct{}{}
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	delete(t.mu.seqWaiters, w)
+	if w.err != nil {
+		err := w.err
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closed {
+		err := t.mu.closeErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+	err := ctx.Err()
+	t.mu.Unlock()
+	return err
+}
+
+func (t *durabilityTracker) waitForSeqBatch(ctx context.Context, seqNums []base.SeqNum) error {
+	t.mu.Lock()
+	if t.mu.closed {
+		err := t.mu.firstErr
+		if err == nil {
+			err = t.mu.closeErr
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if t.disableWAL {
+		t.mu.Unlock()
+		return nil
+	}
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if len(seqNums) == 0 {
+		t.mu.Unlock()
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	t.mu.Unlock()
+	return t.waitForSeq(ctx, maxSeq)
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	t.mu.Lock()
+	if t.mu.closed {
+		err := t.mu.firstErr
+		if err == nil {
+			err = t.mu.closeErr
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if t.disableWAL {
+		t.mu.Unlock()
+		return nil
+	}
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if jobID <= 0 || jobID > t.mu.nextJobID {
+		t.mu.Unlock()
+		return errors.Wrapf(errDurabilityUnknownJob, "job %d", errors.Safe(jobID))
+	}
+	job, ok := t.mu.jobs[jobID]
+	if !ok {
+		t.mu.Unlock()
+		return errors.Wrapf(errDurabilityExpiredJob, "job %d", errors.Safe(jobID))
+	}
+	if job.done && job.err != nil {
+		err := job.err
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if job.done {
+		t.mu.Unlock()
+		return nil
+	}
+
+	w := &jobWaiter{
+		jobID: jobID,
+		ch:    make(chan struct{}),
+	}
+	t.mu.jobWaiters[w] = struct{}{}
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	delete(t.mu.jobWaiters, w)
+	if w.err != nil {
+		err := w.err
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closed {
+		err := t.mu.closeErr
+		t.mu.Unlock()
+		return err
+	}
+	if j, ok := t.mu.jobs[jobID]; ok && j.done {
+		err := j.err
+		t.mu.Unlock()
+		return err
+	}
+	err := ctx.Err()
+	t.mu.Unlock()
+	return err
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if t.mu.closed {
+		err := t.mu.firstErr
+		if err == nil {
+			err = t.mu.closeErr
+		}
+		ch <- err
+		return ch
+	}
+	if t.disableWAL {
+		ch <- nil
+		return ch
+	}
+	if t.mu.firstErr != nil {
+		ch <- t.mu.firstErr
+		return ch
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(t.mu.notifySubs) >= maxDurabilityNotifySubscriptions {
+		ch <- errDurabilityMaxNotify
+		return ch
+	}
+	t.mu.notifySubs = append(t.mu.notifySubs, &notifySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeq, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeq,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         int64(len(t.mu.seqWaiters) + len(t.mu.jobWaiters)),
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metrics() (uint64, time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.metricDurableCount, t.mu.metricDurableDuration
+}
+
+// WaitForDurability blocks until the given sequence number is durably synced to
+// the WAL. A zero sequence number succeeds after any durable commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.durability.waitForSeq(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durably
+// synced to the WAL or the context is cancelled. Durability and close errors
+// take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.waitForSeq(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durably synced to the WAL. A nil or empty slice returns nil.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.durability.waitForSeqBatch(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durably synced to the WAL or the context is cancelled. A nil or empty
+// slice returns nil. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	return d.durability.waitForSeqBatch(ctx, seqNums)
+}
+
+// WaitForJobDurability blocks until the Sync commit identified by jobID has
+// durably synced to the WAL.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.durability.waitForJob(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the Sync commit identified by jobID
+// has durably synced to the WAL or the context is cancelled. Durability and
+// close errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched durability error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seqNum
+// becomes durable, or a non-nil error on WAL sync failure, DB close, or when
+// the maximum number of outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.notify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability statistics for the DB.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
