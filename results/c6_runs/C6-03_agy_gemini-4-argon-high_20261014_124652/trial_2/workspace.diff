+func TestWaitForJobDurabilityRetentionAndErrors(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var lastJobID atomic.Int64
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID.Store(int64(info.JobID))
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() { _ = d.Close() }()
+
+	// Zero, negative, and never-seen job IDs must return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Commit more than maxRetainedDurabilityJobs batches.
+	totalCommits := maxRetainedDurabilityJobs + 10
+	for i := 0; i < totalCommits; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	require.Equal(t, int64(totalCommits), lastJobID.Load())
+
+	// Recent job IDs within the window succeed.
+	require.NoError(t, d.WaitForJobDurability(totalCommits))
+	require.NoError(t, d.WaitForJobDurability(totalCommits-maxRetainedDurabilityJobs+1))
+
+	// Evicted job IDs outside the retention window return an "expired" error.
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+
+	// Never-seen future job ID still returns "unknown".
+	err = d.WaitForJobDurability(totalCommits + 100)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+}
