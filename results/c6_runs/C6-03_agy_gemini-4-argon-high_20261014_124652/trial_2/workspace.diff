+	}
+	w.Printf("[JOB %d] batch durable: seq=%s keys=%d size=%d",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.KeyCount), redact.Safe(i.BatchSize))
+}
