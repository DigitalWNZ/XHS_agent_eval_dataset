+// gatingFS wraps a vfs.FS and allows intercepting/blocking/failing WAL file Sync calls.
+type gatingFS struct {
+	vfs.FS
+	mu       sync.Mutex
+	syncGate chan struct{}
+	syncHit  chan struct{}
+	syncErr  error
+}
+
+type gatingFile struct {
+	vfs.File
+	fs *gatingFS
+}
+
+func (fs *gatingFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	return &gatingFile{File: f, fs: fs}, nil
+}
+
+func (f *gatingFile) Sync() error {
+	f.fs.mu.Lock()
+	gate := f.fs.syncGate
+	hit := f.fs.syncHit
+	syncErr := f.fs.syncErr
+	f.fs.mu.Unlock()
+
+	if hit != nil {
+		select {
+		case hit <- struct{}{}:
+		default:
+		}
+	}
+	if gate != nil {
+		<-gate
+	}
+	if syncErr != nil {
+		f.fs.mu.Lock()
+		err := f.fs.syncErr
+		f.fs.mu.Unlock()
+		if err != nil {
+			return err
+		}
+	}
+	return f.File.Sync()
+}
+
+func (f *gatingFile) SyncData() error {
+	return f.Sync()
+}
