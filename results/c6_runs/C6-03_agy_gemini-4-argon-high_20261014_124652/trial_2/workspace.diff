+func TestDurabilityWALSyncErrorAndPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	gfs := &gatingFS{
+		FS: vfs.NewMem(),
+	}
+	var callbackInfo BatchDurableInfo
+	var callbackCount atomic.Int32
+
+	d, err := Open("", &Options{
+		FS: gfs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				callbackInfo = info
+				callbackCount.Add(1)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() { _ = d.Close() }()
+
+	// First commit succeeds.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), &WriteOptions{Sync: true, CommitCorrelationID: 7}))
+	require.Equal(t, int32(1), callbackCount.Load())
+	require.NoError(t, callbackInfo.Err)
+	firstDurableSeq, stateErr := d.DurableState()
+	require.NoError(t, stateErr)
+	require.Greater(t, firstDurableSeq, base.SeqNum(0))
+
+	// Set up a waiter and a notify subscription for a future sequence number.
+	waitDone := make(chan error, 1)
+	go func() {
+		waitDone <- d.WaitForDurability(firstDurableSeq + 10)
+	}()
+	notifyCh := d.DurabilityNotify(firstDurableSeq + 10)
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Gate and fail the next WAL sync.
+	injectedErr := errors.New("injected WAL sync failure")
+	gfs.mu.Lock()
+	gfs.syncErr = injectedErr
+	gfs.mu.Unlock()
+
+	err = d.Set([]byte("k2"), []byte("v2"), &WriteOptions{Sync: true, CommitCorrelationID: 88})
+	require.ErrorIs(t, err, injectedErr)
+
+	// BatchDurable must have fired with the error.
+	require.Equal(t, int32(2), callbackCount.Load())
+	require.ErrorIs(t, callbackInfo.Err, injectedErr)
+	require.Equal(t, uint64(88), callbackInfo.CorrelationID)
+
+	// Waiters and notify subscriptions must unblock with the error.
+	require.ErrorIs(t, <-waitDone, injectedErr)
+	require.ErrorIs(t, <-notifyCh, injectedErr)
+
+	// DurableState and DurabilityStats reflect the latched error and unchanged HighestDurableSeqNum.
+	seqAfterErr, latchedErr := d.DurableState()
+	require.Equal(t, firstDurableSeq, seqAfterErr)
+	require.ErrorIs(t, latchedErr, injectedErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, firstDurableSeq, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+
+	// Durability error takes precedence over cancelled context.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, d.WaitForDurabilityContext(cancelledCtx, firstDurableSeq), injectedErr)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{firstDurableSeq}), injectedErr)
+	require.ErrorIs(t, d.WaitForJobDurabilityContext(cancelledCtx, callbackInfo.JobID), injectedErr)
+}
+
