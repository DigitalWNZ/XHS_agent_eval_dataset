+func TestDurabilityUnblockOnClose(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	waitErrCh := make(chan error, 1)
+	batchErrCh := make(chan error, 1)
+	go func() {
+		waitErrCh <- d.WaitForDurability(500)
+	}()
+	go func() {
+		batchErrCh <- d.WaitForDurabilityBatch([]base.SeqNum{500, 600})
+	}()
+	notifyCh := d.DurabilityNotify(500)
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, 5*time.Millisecond)
+
+	require.NoError(t, d.Close())
+
+	require.Error(t, <-waitErrCh)
+	require.Error(t, <-batchErrCh)
+	require.Error(t, <-notifyCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Close error takes precedence over cancelled context.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = d.WaitForDurabilityContext(cancelledCtx, 1)
+	require.ErrorIs(t, err, ErrClosed)
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{1})
+	require.ErrorIs(t, err, ErrClosed)
+	err = d.WaitForJobDurabilityContext(cancelledCtx, 1)
+	require.ErrorIs(t, err, ErrClosed)
+}
+
+func TestWaitForJobDurabilityInFlightAndContext(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	gfs := &gatingFS{
+		FS: vfs.NewMem(),
+	}
+	d, err := Open("", &Options{FS: gfs})
+	require.NoError(t, err)
+	defer func() { _ = d.Close() }()
+
+	// Gate the next WAL sync.
+	gate := make(chan struct{})
+	hit := make(chan struct{}, 1)
+	gfs.mu.Lock()
+	gfs.syncGate = gate
+	gfs.syncHit = hit
+	gfs.mu.Unlock()
+
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- d.Set([]byte("k1"), []byte("v1"), Sync)
+	}()
+
+	// Wait until WAL sync is in progress (job 1 is registered and in-flight).
+	<-hit
+
+	// Context cancellation on an in-flight job waiter.
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	err = d.WaitForJobDurabilityContext(ctx, 1)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Block in WaitForJobDurability(1) until gate is released.
+	jobWaitDone := make(chan error, 1)
+	go func() {
+		jobWaitDone <- d.WaitForJobDurability(1)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 5*time.Millisecond)
+
+	// Release WAL sync.
+	close(gate)
+	require.NoError(t, <-commitDone)
+	require.NoError(t, <-jobWaitDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
