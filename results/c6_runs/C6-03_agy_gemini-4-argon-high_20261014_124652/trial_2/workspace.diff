+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() { _ = d.Close() }()
+
+	// Non-sync commit must not trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync"), []byte("val"), NoSync))
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Sync commit via Set with CommitCorrelationID.
+	wopts := &WriteOptions{Sync: true, CommitCorrelationID: 42}
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), wopts))
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev1 := events[0]
+	mu.Unlock()
+
+	require.Equal(t, 1, ev1.JobID)
+	require.Greater(t, ev1.SeqNum, base.SeqNum(0))
+	require.NoError(t, ev1.Err)
+	require.Greater(t, ev1.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev1.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev1.CorrelationID)
+	require.Greater(t, ev1.BatchSize, 0)
+	require.Equal(t, uint32(1), ev1.KeyCount)
+
+	// Multi-key batch commit via Apply.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, b.Delete([]byte("k1"), nil))
+	expectedSize := len(b.Repr())
+	require.NoError(t, d.Apply(b, &WriteOptions{Sync: true, CommitCorrelationID: 99}))
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Equal(t, 2, ev2.JobID)
+	require.Equal(t, b.SeqNum(), ev2.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(99), ev2.CorrelationID)
+	require.Equal(t, expectedSize, ev2.BatchSize)
+	require.Equal(t, uint32(3), ev2.KeyCount)
+	_ = b.Close()
+
+	// ApplyNoSyncWait + SyncWait.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k4"), []byte("v4"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b2, &WriteOptions{Sync: true, CommitCorrelationID: 123}))
+	require.NoError(t, b2.SyncWait())
+
+	mu.Lock()
+	require.Len(t, events, 3)
+	ev3 := events[2]
+	mu.Unlock()
+
+	require.Equal(t, 3, ev3.JobID)
+	require.Equal(t, b2.SeqNum(), ev3.SeqNum)
+	require.NoError(t, ev3.Err)
+	require.Greater(t, ev3.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev3.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(123), ev3.CorrelationID)
+	require.Equal(t, uint32(1), ev3.KeyCount)
+	_ = b2.Close()
+}
