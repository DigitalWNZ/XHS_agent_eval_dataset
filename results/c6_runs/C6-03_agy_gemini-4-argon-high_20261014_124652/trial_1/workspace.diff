+func TestBatchDurableCallbackBasic(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Commit a 1-key batch with CorrelationID.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	expectedSize1 := len(b1.Repr())
+	require.NoError(t, d.Apply(b1, &WriteOptions{Sync: true, CommitCorrelationID: 101}))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	// Commit a 3-key batch with CorrelationID.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b2.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, b2.Delete([]byte("k1"), nil))
+	expectedSize2 := len(b2.Repr())
+	require.NoError(t, d.Apply(b2, &WriteOptions{Sync: true, CommitCorrelationID: 202}))
+	seq2 := b2.SeqNum()
+	require.NoError(t, b2.Close())
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	e1, e2 := events[0], events[1]
+	mu.Unlock()
+
+	require.Greater(t, e1.JobID, 0)
+	require.Equal(t, seq1, e1.SeqNum)
+	require.NoError(t, e1.Err)
+	require.Greater(t, e1.ApplyDuration, time.Duration(0))
+	require.Greater(t, e1.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(101), e1.CorrelationID)
+	require.Equal(t, expectedSize1, e1.BatchSize)
+	require.Equal(t, uint32(1), e1.KeyCount)
+
+	require.Greater(t, e2.JobID, e1.JobID)
+	require.Equal(t, seq2, e2.SeqNum)
+	require.NoError(t, e2.Err)
+	require.Greater(t, e2.ApplyDuration, time.Duration(0))
+	require.Greater(t, e2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(202), e2.CorrelationID)
+	require.Equal(t, expectedSize2, e2.BatchSize)
+	require.Equal(t, uint32(3), e2.KeyCount)
+}
