+	require.Equal(t, time.Duration(0), mNoCallback.DurableCommitDuration)
+	require.NoError(t, dNoCallback.Close())
+
+	// 2. With BatchDurable configured, Metrics.DurableCommit* ARE accumulated.
+	var callbackSyncDur time.Duration
+	dWithCallback, err := Open("", &Options{
+		FS: &syncHookFS{
+			FS: vfs.NewMem(),
+			onWALSync: func() error {
+				time.Sleep(2 * time.Millisecond)
+				return nil
+			},
+		},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				callbackSyncDur += info.SyncDuration
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, dWithCallback.Close())
+	}()
+
+	require.NoError(t, dWithCallback.Set([]byte("a"), []byte("1"), Sync))
+	require.NoError(t, dWithCallback.Set([]byte("b"), []byte("2"), Sync))
+	require.NoError(t, dWithCallback.Set([]byte("c"), []byte("3"), NoSync))
+
+	st2 := dWithCallback.DurabilityStats()
+	require.Equal(t, uint64(2), st2.TotalDurableCommits)
+	require.Equal(t, callbackSyncDur, st2.CumulativeSyncDuration)
+	require.GreaterOrEqual(t, st2.CumulativeSyncDuration, st2.MaxSyncDuration)
+	require.Greater(t, st2.MaxSyncDuration, time.Duration(0))
+
+	mWithCallback := dWithCallback.Metrics()
+	require.Equal(t, uint64(2), mWithCallback.DurableCommitCount)
+	require.Equal(t, callbackSyncDur, mWithCallback.DurableCommitDuration)
+}
