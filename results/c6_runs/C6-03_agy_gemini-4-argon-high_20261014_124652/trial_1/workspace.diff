+func TestDurabilityCloseUnblocksWaitersAndPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	blockSync := make(chan struct{})
+	syncEntered := make(chan struct{})
+	var once sync.Once
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			once.Do(func() {
+				close(syncEntered)
+			})
+			<-blockSync
+			return nil
+		},
+	}
+
+	d, err := Open("", &Options{FS: fs})
+	require.NoError(t, err)
+
+	// Start an in-flight Sync commit that blocks in WAL Sync.
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- d.Set([]byte("k1"), []byte("v1"), Sync)
+	}()
+	<-syncEntered
+
+	// Start goroutines blocked in WaitForDurability, WaitForDurabilityBatch, and WaitForJobDurability(1).
+	w1 := make(chan error, 1)
+	w2 := make(chan error, 1)
+	w3 := make(chan error, 1)
+	notifyCh := d.DurabilityNotify(100)
+
+	go func() { w1 <- d.WaitForDurability(100) }()
+	go func() { w2 <- d.WaitForDurabilityBatch([]base.SeqNum{100, 200}) }()
+	go func() { w3 <- d.WaitForJobDurability(1) }()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 3
+	}, time.Second, time.Millisecond)
+
+	// Unblock WAL sync so Close() can finish, and immediately close DB (seq 100 is still not reached).
+	close(blockSync)
+	require.NoError(t, <-commitDone)
+
+	// WaitForJobDurability(1) should have succeeded when commit 1 finished.
+	require.NoError(t, <-w3)
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, time.Second, time.Millisecond)
+
+	// Now close the DB while w1, w2, and notifyCh are still waiting for seq 100.
+	require.NoError(t, d.Close())
+
+	require.Error(t, <-w1)
+	require.Error(t, <-w2)
+	require.Error(t, <-notifyCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Close error takes precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = d.WaitForDurabilityContext(cancelledCtx, 10)
+	require.ErrorIs(t, err, ErrClosed)
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{10})
+	require.ErrorIs(t, err, ErrClosed)
+	err = d.WaitForJobDurabilityContext(cancelledCtx, 1)
+	require.ErrorIs(t, err, ErrClosed)
+}
