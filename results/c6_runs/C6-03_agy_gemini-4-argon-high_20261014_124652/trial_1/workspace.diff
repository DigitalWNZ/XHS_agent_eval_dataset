+	require.Equal(t, base.SeqNum(0), seq0)
+	require.NoError(t, err0)
+
+	require.NoError(t, dNoCallback.Set([]byte("a"), []byte("1"), Sync))
+	st1 := dNoCallback.DurabilityStats()
+	require.Greater(t, st1.HighestDurableSeqNum, base.SeqNum(0))
+	require.NoError(t, st1.FirstErr)
