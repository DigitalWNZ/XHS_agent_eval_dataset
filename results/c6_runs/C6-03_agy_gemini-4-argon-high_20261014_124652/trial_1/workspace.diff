+	require.NoError(t, d.Apply(b, NoSync))
+	require.NoError(t, b.Close())
+	require.Equal(t, int32(0), count.Load())
+	require.NoError(t, d.Close())
+
+	// DisableWAL must never trigger BatchDurable and wait APIs / DurabilityNotify return nil immediately.
+	optsDisableWAL := &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				count.Add(1)
+			},
+		},
+	}
+	d2, err := Open("", optsDisableWAL)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d2.Close())
+	}()
+
+	require.NoError(t, d2.Set([]byte("a"), []byte("1"), NoSync))
+	require.Equal(t, int32(0), count.Load())
+
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	require.NoError(t, d2.WaitForDurability(0))
+	require.NoError(t, d2.WaitForDurability(9999))
+	require.NoError(t, d2.WaitForDurabilityContext(cancelledCtx, 9999))
+	require.NoError(t, d2.WaitForDurabilityBatch([]base.SeqNum{1, 2, 9999}))
+	require.NoError(t, d2.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{1, 2, 9999}))
+	require.NoError(t, d2.WaitForJobDurability(0))
+	require.NoError(t, d2.WaitForJobDurability(9999))
+	require.NoError(t, d2.WaitForJobDurabilityContext(cancelledCtx, 9999))
+
+	ch := d2.DurabilityNotify(9999)
+	select {
+	case notifyErr := <-ch:
+		require.NoError(t, notifyErr)
+	default:
+		t.Fatal("expected pre-filled channel when DisableWAL is true")
+	}
+}
