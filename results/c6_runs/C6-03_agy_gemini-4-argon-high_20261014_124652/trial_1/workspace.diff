+func TestWaitForJobDurabilityAndRetention(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var jobIDs []int
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				jobIDs = append(jobIDs, info.JobID)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Zero, negative, and never-seen job IDs must return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Perform enough commits to exceed maxRetainedDurabilityJobs.
+	totalCommits := maxRetainedDurabilityJobs + 50
+	for i := 0; i < totalCommits; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+		if i == 0 {
+			// Immediately after the first commit, job 1 is retained.
+			require.NoError(t, d.WaitForJobDurability(1))
+		}
+	}
+
+	mu.Lock()
+	require.Len(t, jobIDs, totalCommits)
+	firstJob := jobIDs[0]
+	lastJob := jobIDs[len(jobIDs)-1]
+	mu.Unlock()
+
+	// First job should now be expired.
+	err = d.WaitForJobDurability(firstJob)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "expired")
+
+	// Recent job should still succeed.
+	require.NoError(t, d.WaitForJobDurability(lastJob))
+
+	// Never-seen future job ID still gets "unknown".
+	err = d.WaitForJobDurability(lastJob + 100)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+}
