+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, time.Second, time.Millisecond)
+
+	// Enable sync failure and perform a Sync commit.
+	failSync.Store(true)
+	err = d.Set([]byte("k2"), []byte("v2"), Sync)
+	require.ErrorIs(t, err, injectedErr)
+
+	// Waiter and notify subscription must unblock with the injected error.
+	require.ErrorIs(t, <-waitErrCh, injectedErr)
+	require.ErrorIs(t, <-notifyCh, injectedErr)
+
+	// Callback must have fired for the failed commit too.
+	mu.Lock()
+	require.Len(t, events, 2)
+	failedEvent := events[1]
+	mu.Unlock()
+	require.ErrorIs(t, failedEvent.Err, injectedErr)
+
+	// DurableState and DurabilityStats reflect highest durable seqNum from b1 and latched FirstErr.
+	stateSeq, stateErr := d.DurableState()
+	require.Equal(t, seq1, stateSeq)
+	require.ErrorIs(t, stateErr, injectedErr)
+
+	st := d.DurabilityStats()
+	require.Equal(t, seq1, st.HighestDurableSeqNum)
+	require.ErrorIs(t, st.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), st.TotalDurableCommits)
+	require.Equal(t, uint64(1), st.TotalFailedCommits)
+
+	// Durability error takes precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	require.ErrorIs(t, d.WaitForDurabilityContext(cancelledCtx, seq1), injectedErr)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{seq1}), injectedErr)
+	require.ErrorIs(t, d.WaitForJobDurabilityContext(cancelledCtx, failedEvent.JobID), injectedErr)
+}
