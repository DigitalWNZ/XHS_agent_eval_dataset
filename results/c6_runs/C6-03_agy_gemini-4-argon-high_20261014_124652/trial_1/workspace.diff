diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..f83de490
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,625 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	maxRetainedDurabilityJobs      = 256
+	maxDurabilityNotifySubscribers = 256
+)
+
+// DurabilityStats holds a point-in-time snapshot of WAL sync durability
+// statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type seqWaiter struct {
+	seqNum  base.SeqNum
+	ch      chan struct{}
+	counted bool
+}
+
+type jobWaiter struct {
+	counted bool
+}
+
+type notifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityJobState struct {
+	done     bool
+	err      error
+	closedCh bool
+	doneCh   chan struct{}
+	waiters  map[*jobWaiter]struct{}
+}
+
+type durabilityTracker struct {
+	mu                     sync.Mutex
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	pendingWaiters         int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+	durableCommitCount     uint64
+	durableCommitDuration  time.Duration
+
+	nextJobID           int
+	oldestRetainedJobID int
+	jobs                map[int]*durabilityJobState
+
+	seqWaiters map[*seqWaiter]struct{}
+	notifySubs map[*notifySub]struct{}
+
+	closed  bool
+	closeCh chan struct{}
+}
+
+func (t *durabilityTracker) init() {
+	t.oldestRetainedJobID = 1
+	t.jobs = make(map[int]*durabilityJobState)
+	t.seqWaiters = make(map[*seqWaiter]struct{})
+	t.notifySubs = make(map[*notifySub]struct{})
+	t.closeCh = make(chan struct{})
+}
+
+func (t *durabilityTracker) isSeqDurableLocked(seqNum base.SeqNum) bool {
+	return t.highestDurableSeqNum > 0 && seqNum <= t.highestDurableSeqNum
+}
+
+func (t *durabilityTracker) registerJob() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.nextJobID++
+	jobID := t.nextJobID
+	t.jobs[jobID] = &durabilityJobState{
+		doneCh: make(chan struct{}),
+	}
+	return jobID
+}
+
+func (t *durabilityTracker) recordCompletion(
+	jobID int,
+	seqNum base.SeqNum,
+	err error,
+	syncDuration time.Duration,
+	accumulateMetrics bool,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if jobID > 0 {
+		job, ok := t.jobs[jobID]
+		if !ok {
+			job = &durabilityJobState{
+				doneCh: make(chan struct{}),
+			}
+			t.jobs[jobID] = job
+		}
+		job.done = true
+		job.err = err
+
+		for len(t.jobs) > maxRetainedDurabilityJobs && t.oldestRetainedJobID <= t.nextJobID {
+			oldest, exists := t.jobs[t.oldestRetainedJobID]
+			if exists && !oldest.done {
+				break
+			}
+			delete(t.jobs, t.oldestRetainedJobID)
+			t.oldestRetainedJobID++
+		}
+	}
+
+	if err == nil {
+		if seqNum > t.highestDurableSeqNum {
+			t.highestDurableSeqNum = seqNum
+		}
+		t.totalDurableCommits++
+		t.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.maxSyncDuration {
+			t.maxSyncDuration = syncDuration
+		}
+		if accumulateMetrics {
+			t.durableCommitCount++
+			t.durableCommitDuration += syncDuration
+		}
+	} else {
+		if t.firstErr == nil {
+			t.firstErr = err
+		}
+		t.totalFailedCommits++
+	}
+}
+
+func (t *durabilityTracker) notifyCompletion(jobID int) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if jobID > 0 {
+		if job, ok := t.jobs[jobID]; ok {
+			for jw := range job.waiters {
+				if jw.counted {
+					jw.counted = false
+					t.pendingWaiters--
+				}
+				delete(job.waiters, jw)
+			}
+			if !job.closedCh {
+				job.closedCh = true
+				close(job.doneCh)
+			}
+		}
+	}
+
+	t.wakeLocked()
+}
+
+func (t *durabilityTracker) close() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	t.closed = true
+	close(t.closeCh)
+	t.wakeLocked()
+}
+
+func (t *durabilityTracker) wakeLocked() {
+	if t.closed {
+		for w := range t.seqWaiters {
+			if w.counted {
+				w.counted = false
+				t.pendingWaiters--
+			}
+			close(w.ch)
+			delete(t.seqWaiters, w)
+		}
+		for sub := range t.notifySubs {
+			sub.ch <- ErrClosed
+			close(sub.ch)
+			delete(t.notifySubs, sub)
+		}
+		for _, job := range t.jobs {
+			for jw := range job.waiters {
+				if jw.counted {
+					jw.counted = false
+					t.pendingWaiters--
+				}
+				delete(job.waiters, jw)
+			}
+			if !job.closedCh {
+				job.closedCh = true
+				close(job.doneCh)
+			}
+		}
+		return
+	}
+
+	if t.firstErr != nil {
+		for w := range t.seqWaiters {
+			if w.counted {
+				w.counted = false
+				t.pendingWaiters--
+			}
+			close(w.ch)
+			delete(t.seqWaiters, w)
+		}
+		for sub := range t.notifySubs {
+			sub.ch <- t.firstErr
+			close(sub.ch)
+			delete(t.notifySubs, sub)
+		}
+		for _, job := range t.jobs {
+			for jw := range job.waiters {
+				if jw.counted {
+					jw.counted = false
+					t.pendingWaiters--
+				}
+				delete(job.waiters, jw)
+			}
+			if !job.closedCh {
+				job.closedCh = true
+				close(job.doneCh)
+			}
+		}
+		return
+	}
+
+	if t.highestDurableSeqNum > 0 {
+		for w := range t.seqWaiters {
+			if w.seqNum <= t.highestDurableSeqNum {
+				if w.counted {
+					w.counted = false
+					t.pendingWaiters--
+				}
+				close(w.ch)
+				delete(t.seqWaiters, w)
+			}
+		}
+		for sub := range t.notifySubs {
+			if sub.seqNum <= t.highestDurableSeqNum {
+				sub.ch <- nil
+				close(sub.ch)
+				delete(t.notifySubs, sub)
+			}
+		}
+	}
+}
+
+func (t *durabilityTracker) errorIfClosedOrFailed() error {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return ErrClosed
+	}
+	return t.firstErr
+}
+
+func (t *durabilityTracker) waitForSeq(ctx context.Context, seqNum base.SeqNum) error {
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		return ErrClosed
+	}
+	if t.firstErr != nil {
+		err := t.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if ctx != nil && ctx.Err() != nil {
+		err := ctx.Err()
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+
+	w := &seqWaiter{
+		seqNum:  seqNum,
+		ch:      make(chan struct{}),
+		counted: true,
+	}
+	t.seqWaiters[w] = struct{}{}
+	t.pendingWaiters++
+	closeCh := t.closeCh
+	t.mu.Unlock()
+
+	var ctxDone <-chan struct{}
+	if ctx != nil {
+		ctxDone = ctx.Done()
+	}
+	select {
+	case <-w.ch:
+	case <-closeCh:
+	case <-ctxDone:
+	}
+
+	t.mu.Lock()
+	if w.counted {
+		w.counted = false
+		t.pendingWaiters--
+	}
+	delete(t.seqWaiters, w)
+	if t.closed {
+		t.mu.Unlock()
+		return ErrClosed
+	}
+	if t.firstErr != nil {
+		err := t.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+	t.mu.Unlock()
+	if ctx != nil {
+		return ctx.Err()
+	}
+	return nil
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		return ErrClosed
+	}
+	if ctx != nil && ctx.Err() != nil {
+		if t.firstErr != nil {
+			err := t.firstErr
+			t.mu.Unlock()
+			return err
+		}
+		err := ctx.Err()
+		t.mu.Unlock()
+		return err
+	}
+	if jobID <= 0 || jobID > t.nextJobID {
+		t.mu.Unlock()
+		return errors.Newf("pebble: unknown durability job ID %d", errors.Safe(jobID))
+	}
+	if jobID < t.oldestRetainedJobID {
+		t.mu.Unlock()
+		return errors.Newf("pebble: expired durability job ID %d", errors.Safe(jobID))
+	}
+	job, ok := t.jobs[jobID]
+	if !ok {
+		t.mu.Unlock()
+		return errors.Newf("pebble: expired durability job ID %d", errors.Safe(jobID))
+	}
+	if t.firstErr != nil {
+		err := job.err
+		if err == nil {
+			err = t.firstErr
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if job.done {
+		err := job.err
+		t.mu.Unlock()
+		return err
+	}
+
+	jw := &jobWaiter{counted: true}
+	if job.waiters == nil {
+		job.waiters = make(map[*jobWaiter]struct{})
+	}
+	job.waiters[jw] = struct{}{}
+	t.pendingWaiters++
+	doneCh := job.doneCh
+	closeCh := t.closeCh
+	t.mu.Unlock()
+
+	var ctxDone <-chan struct{}
+	if ctx != nil {
+		ctxDone = ctx.Done()
+	}
+	select {
+	case <-doneCh:
+	case <-closeCh:
+	case <-ctxDone:
+	}
+
+	t.mu.Lock()
+	if jw.counted {
+		jw.counted = false
+		t.pendingWaiters--
+	}
+	delete(job.waiters, jw)
+	if t.closed {
+		t.mu.Unlock()
+		return ErrClosed
+	}
+	if job.done && job.err != nil {
+		err := job.err
+		t.mu.Unlock()
+		return err
+	}
+	if t.firstErr != nil {
+		err := t.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if job.done {
+		t.mu.Unlock()
+		return nil
+	}
+	t.mu.Unlock()
+	if ctx != nil {
+		return ctx.Err()
+	}
+	return nil
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		ch <- ErrClosed
+		close(ch)
+		return ch
+	}
+	if t.firstErr != nil {
+		err := t.firstErr
+		t.mu.Unlock()
+		ch <- err
+		close(ch)
+		return ch
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		ch <- nil
+		close(ch)
+		return ch
+	}
+	if len(t.notifySubs) >= maxDurabilityNotifySubscribers {
+		t.mu.Unlock()
+		ch <- errors.New("pebble: durability notify subscription limit exceeded")
+		close(ch)
+		return ch
+	}
+	sub := &notifySub{
+		seqNum: seqNum,
+		ch:     ch,
+	}
+	t.notifySubs[sub] = struct{}{}
+	t.mu.Unlock()
+	return ch
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.highestDurableSeqNum, t.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.highestDurableSeqNum,
+		FirstErr:               t.firstErr,
+		PendingWaiters:         t.pendingWaiters,
+		TotalDurableCommits:    t.totalDurableCommits,
+		TotalFailedCommits:     t.totalFailedCommits,
+		CumulativeSyncDuration: t.cumulativeSyncDuration,
+		MaxSyncDuration:        t.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metrics() (uint64, time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.durableCommitCount, t.durableCommitDuration
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk. A sequence number of zero succeeds after any commit becomes durable.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk or the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForSeq(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk or the context is cancelled. A nil or empty slice returns
+// nil immediately. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if len(seqNums) == 0 {
+		if ctx != nil && ctx.Err() != nil {
+			if err := d.durability.errorIfClosedOrFailed(); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	maxSeq := seqNums[0]
+	for _, s := range seqNums[1:] {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.durability.waitForSeq(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the commit identified by the callback job
+// ID is durable on disk.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the commit identified by the
+// callback job ID is durable on disk or the context is cancelled. Durability
+// and close errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched WAL sync error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when
+// seqNum is durable, or a non-nil error on WAL sync failure, DB close, or if
+// the subscription limit is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		close(ch)
+		return ch
+	}
+	return d.durability.notify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of current durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
+
+func (d *DB) completeBatchDurability(b *Batch, syncErr error) {
+	if b.durableReported || b.durabilityJobID == 0 {
+		return
+	}
+	b.durableReported = true
+
+	applyDur := b.applyDuration
+	syncDur := b.syncDuration
+	if syncErr == nil {
+		if applyDur <= 0 {
+			applyDur = time.Nanosecond
+		}
+		if syncDur <= 0 {
+			syncDur = time.Nanosecond
+		}
+	}
+
+	configured := d.batchDurableConfigured ||
+		(d.opts.EventListener != nil && isBatchDurableConfigured(d.opts.EventListener.BatchDurable))
+
+	d.durability.recordCompletion(b.durabilityJobID, b.committedSeqNum, syncErr, syncDur, configured)
+	defer d.durability.notifyCompletion(b.durabilityJobID)
+
+	if configured && d.opts.EventListener != nil && d.opts.EventListener.BatchDurable != nil {
+		d.opts.EventListener.BatchDurable(BatchDurableInfo{
+			JobID:         b.durabilityJobID,
+			SeqNum:        b.committedSeqNum,
+			Err:           syncErr,
+			ApplyDuration: applyDur,
+			SyncDuration:  syncDur,
+			CorrelationID: b.commitCorrelationID,
+			BatchSize:     b.committedBatchSize,
+			KeyCount:      b.Count(),
+		})
+	}
+}
