+	require.Equal(t, uint64(1), st1.TotalDurableCommits)
+	require.Equal(t, uint64(0), st1.TotalFailedCommits)
+	require.Greater(t, st1.CumulativeSyncDuration, time.Duration(0))
+	require.Equal(t, st1.CumulativeSyncDuration, st1.MaxSyncDuration)
