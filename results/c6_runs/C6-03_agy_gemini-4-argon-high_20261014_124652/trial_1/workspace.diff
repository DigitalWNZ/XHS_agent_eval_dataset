+func TestBatchDurableTeeEventListener(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events1, events2 []BatchDurableInfo
+
+	l1 := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			events1 = append(events1, info)
+			mu.Unlock()
+		},
+	}
+	l2 := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			events2 = append(events2, info)
+			mu.Unlock()
+		},
+	}
+	tee := TeeEventListener(l1, l2)
+
+	d, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		EventListener: &tee,
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	require.NoError(t, d.Set([]byte("k"), []byte("v"), &WriteOptions{Sync: true, CommitCorrelationID: 555}))
+
+	mu.Lock()
+	require.Len(t, events1, 1)
+	require.Len(t, events2, 1)
+	require.Equal(t, events1[0], events2[0])
+	require.Equal(t, uint64(555), events1[0].CorrelationID)
+	mu.Unlock()
+
+	m := d.Metrics()
+	require.Equal(t, uint64(1), m.DurableCommitCount)
+	require.Greater(t, m.DurableCommitDuration, time.Duration(0))
+}
