+func TestDurabilityNotifyAndSubscriptionBound(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Subscribe up to the limit for a future sequence number.
+	futureSeq := base.SeqNum(1000)
+	subs := make([]<-chan error, 0, maxDurabilityNotifySubscribers)
+	for i := 0; i < maxDurabilityNotifySubscribers; i++ {
+		ch := d.DurabilityNotify(futureSeq)
+		select {
+		case err := <-ch:
+			t.Fatalf("unexpected immediate notification on sub %d: %v", i, err)
+		default:
+		}
+		subs = append(subs, ch)
+	}
+
+	// Excess caller must get a pre-filled channel with an immediate non-nil error.
+	excessCh := d.DurabilityNotify(futureSeq)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected excess subscription to return pre-filled error channel immediately")
+	}
+
+	// Commit a batch and check that pre-filled channel for already-durable seqNum returns nil.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seq := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	doneCh := d.DurabilityNotify(seq)
+	select {
+	case err := <-doneCh:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected already-durable seqNum to return pre-filled channel")
+	}
+}
