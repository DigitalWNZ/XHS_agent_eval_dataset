+type slowSyncFile struct {
+	vfs.File
+	syncDelay time.Duration
+	onSync    func()
+}
+
+func (f *slowSyncFile) Sync() error {
+	if f.onSync != nil {
+		f.onSync()
+	}
+	if f.syncDelay > 0 {
+		time.Sleep(f.syncDelay)
+	}
+	return f.File.Sync()
+}
+
+func (f *slowSyncFile) SyncData() error {
+	if f.onSync != nil {
+		f.onSync()
+	}
+	if f.syncDelay > 0 {
+		time.Sleep(f.syncDelay)
+	}
+	return f.File.SyncData()
+}
+
+type slowSyncFS struct {
+	vfs.FS
+	syncDelay atomic.Int64
+	onSync    func()
+}
+
+func (fs *slowSyncFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	return &slowSyncFile{
+		File:      f,
+		syncDelay: time.Duration(fs.syncDelay.Load()),
+		onSync:    fs.onSync,
+	}, nil
+}
