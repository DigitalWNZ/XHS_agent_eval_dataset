+func TestWaitForJobDurabilityAndRetention(t *testing.T) {
+	var mu sync.Mutex
+	var jobIDs []int
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				jobIDs = append(jobIDs, info.JobID)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Zero, negative, and never-seen job IDs return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Commit one batch and verify its job ID succeeds.
+	require.NoError(t, d.Set([]byte("k0"), []byte("v0"), Sync))
+	mu.Lock()
+	require.Len(t, jobIDs, 1)
+	firstJobID := jobIDs[0]
+	mu.Unlock()
+
+	require.NoError(t, d.WaitForJobDurability(firstJobID))
+
+	// Never-seen ID higher than current maxJobID still gets "unknown".
+	err = d.WaitForJobDurability(firstJobID + 100)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Commit enough batches to push firstJobID outside the bounded retention window.
+	for i := 0; i < maxRetainedDurabilityJobs+10; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	mu.Lock()
+	lastJobID := jobIDs[len(jobIDs)-1]
+	mu.Unlock()
+
+	// Recent job succeeds.
+	require.NoError(t, d.WaitForJobDurability(lastJobID))
+
+	// Evicted job returns an "expired" error.
+	err = d.WaitForJobDurability(firstJobID)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+}
