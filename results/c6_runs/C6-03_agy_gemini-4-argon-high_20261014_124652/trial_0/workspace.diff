+
+	m2 := d2.Metrics()
+	s2 := d2.DurabilityStats()
+	require.Equal(t, uint64(2), m2.DurableCommitCount)
+	require.Equal(t, callbackSyncSum, m2.DurableCommitDuration)
+	require.Equal(t, s2.CumulativeSyncDuration, m2.DurableCommitDuration)
+	require.GreaterOrEqual(t, s2.MaxSyncDuration, 2*time.Millisecond)
+	require.NoError(t, d2.Close())
+}
