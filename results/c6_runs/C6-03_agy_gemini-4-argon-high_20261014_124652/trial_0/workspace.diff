+func TestDurabilityNotifyAndSubscriptionBound(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seq1 := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	// Already durable sequence number returns a pre-filled channel with nil.
+	ch := d.DurabilityNotify(seq1)
+	select {
+	case err := <-ch:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel for already durable seqNum")
+	}
+
+	// Fill up outstanding subscriptions up to the bound.
+	futureSeq := seq1 + 10
+	subs := make([]<-chan error, 0, maxDurabilityNotifySubs)
+	for i := 0; i < maxDurabilityNotifySubs; i++ {
+		subCh := d.DurabilityNotify(futureSeq)
+		select {
+		case err := <-subCh:
+			t.Fatalf("unexpected immediate resolution at %d: %v", i, err)
+		default:
+		}
+		subs = append(subs, subCh)
+	}
+
+	// Excess caller gets a pre-filled channel with a non-nil error.
+	excessCh := d.DurabilityNotify(futureSeq)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected pre-filled error channel when subscription bound exceeded")
+	}
+
+	// Advance durability past futureSeq and verify all subscriptions receive nil.
+	for i := 0; i < 10; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+	for i, subCh := range subs {
+		select {
+		case err := <-subCh:
+			require.NoError(t, err, "sub %d failed", i)
+		case <-time.After(2 * time.Second):
+			t.Fatalf("sub %d timed out", i)
+		}
+	}
+}
+
+func TestWALSyncErrorPropagationAndPrecedence(t *testing.T) {
+	injectedErr := errors.New("injected WAL sync failure")
+	var failSync atomic.Bool
+
+	fs := errorfs.Wrap(vfs.NewMem(), errorfs.InjectorFunc(func(op errorfs.Op) error {
+		if (op.Kind == errorfs.OpFileSync || op.Kind == errorfs.OpFileSyncData) && failSync.Load() {
+			return injectedErr
+		}
+		return nil
+	}))
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	d, err := Open("", &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// Successful commit first.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("ok"), []byte("1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	// Subscribe to future sequence number before failure.
+	notifyCh := d.DurabilityNotify(seq1 + 5)
+
+	// Enable sync failure and perform a Sync commit.
+	failSync.Store(true)
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("fail"), []byte("2"), nil))
+	err = d.Apply(b2, &WriteOptions{Sync: true, CommitCorrelationID: 99})
+	require.ErrorIs(t, err, injectedErr)
+	_ = b2.Close()
+
+	// Callback must have fired for the failed Sync commit with Err set.
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEvent := events[1]
+	mu.Unlock()
+	require.ErrorIs(t, failEvent.Err, injectedErr)
+	require.Equal(t, uint64(99), failEvent.CorrelationID)
+	require.Equal(t, uint32(1), failEvent.KeyCount)
+
+	// DurableState and DurabilityStats reflect highest durable seqNum from b1 and latched error from b2.
+	durableSeq, stateErr := d.DurableState()
+	require.Equal(t, seq1, durableSeq)
+	require.ErrorIs(t, stateErr, injectedErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+
+	// DurabilityNotify receives the error.
+	select {
+	case nErr := <-notifyCh:
+		require.ErrorIs(t, nErr, injectedErr)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for DurabilityNotify error")
+	}
+
+	// Durability errors take precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(cancelledCtx, seq1)
+	require.ErrorIs(t, err, injectedErr)
+
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{seq1})
+	require.ErrorIs(t, err, injectedErr)
+
+	err = d.WaitForJobDurabilityContext(cancelledCtx, failEvent.JobID)
+	require.ErrorIs(t, err, injectedErr)
+}
+
+func TestDBCloseUnblocksWaitersAndPrecedence(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	waitSeqErr := make(chan error, 1)
+	waitBatchErr := make(chan error, 1)
+	notifyCh := d.DurabilityNotify(100)
+
+	go func() {
+		waitSeqErr <- d.WaitForDurability(100)
+	}()
+	go func() {
+		waitBatchErr <- d.WaitForDurabilityBatch([]base.SeqNum{100, 200})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, time.Millisecond)
+
+	require.NoError(t, d.Close())
+
+	require.Error(t, <-waitSeqErr)
+	require.Error(t, <-waitBatchErr)
+	select {
+	case nErr := <-notifyCh:
+		require.Error(t, nErr)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for DurabilityNotify on close")
+	}
+
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Close error takes precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(cancelledCtx, 0)
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{1})
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+
+	err = d.WaitForJobDurabilityContext(cancelledCtx, 1)
+	require.Error(t, err)
+	require.NotErrorIs(t, err, context.Canceled)
+}
