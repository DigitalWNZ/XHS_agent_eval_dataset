+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// WaitForDurabilityBatch with nil or empty slice returns nil immediately, even before any commits.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commits, then succeeds after the first Sync commit.
+	zeroWaitDone := make(chan error, 1)
+	go func() {
+		zeroWaitDone <- d.WaitForDurability(0)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("a"), []byte("1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	require.NoError(t, <-zeroWaitDone)
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(seq1))
+
+	// Wait for future sequence numbers via WaitForDurability and WaitForDurabilityBatch.
+	targetSeq := seq1 + 2
+	wait1Done := make(chan error, 1)
+	waitBatchDone := make(chan error, 1)
+	go func() {
+		wait1Done <- d.WaitForDurability(targetSeq)
+	}()
+	go func() {
+		waitBatchDone <- d.WaitForDurabilityBatch([]base.SeqNum{0, seq1, targetSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2
+	}, 2*time.Second, time.Millisecond)
+
+	// Commit seq1 + 1 (not enough to unblock targetSeq).
+	require.NoError(t, d.Set([]byte("b"), []byte("2"), Sync))
+	select {
+	case <-wait1Done:
+		t.Fatal("should not unblock before targetSeq is durable")
+	default:
+	}
+
+	// Commit seq1 + 2 (unblocks both).
+	require.NoError(t, d.Set([]byte("c"), []byte("3"), Sync))
+	require.NoError(t, <-wait1Done)
+	require.NoError(t, <-waitBatchDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
