+func TestDisableWALDurability(t *testing.T) {
+	var called atomic.Bool
+	d, err := Open("", &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				called.Store(true)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	require.NoError(t, d.Set([]byte("k"), []byte("v"), NoSync))
+	require.False(t, called.Load())
+
+	// When DisableWAL is true, wait APIs and DurabilityNotify return nil immediately.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(99999))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), 99999))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{1, 100, 99999}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{1, 100}))
+	require.NoError(t, d.WaitForJobDurability(0))
+	require.NoError(t, d.WaitForJobDurability(999))
+	require.NoError(t, d.WaitForJobDurabilityContext(context.Background(), 999))
+
+	ch := d.DurabilityNotify(99999)
+	select {
+	case notifyErr := <-ch:
+		require.NoError(t, notifyErr)
+	default:
+		t.Fatal("expected DurabilityNotify channel to be pre-filled when DisableWAL is true")
+	}
+}
