diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..a77d1d61
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,649 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxRetainedDurabilityJobs bounds the retention window of completed
+	// durability job IDs for WaitForJobDurability queries.
+	maxRetainedDurabilityJobs = 64
+
+	// maxDurabilityNotifySubs bounds the number of concurrent unresolved
+	// DurabilityNotify subscriptions.
+	maxDurabilityNotifySubs = 64
+)
+
+// DurabilityStats holds a point-in-time snapshot of batch durability state and
+// statistics for a DB.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJobState struct {
+	jobID         int
+	seqNum        base.SeqNum
+	correlationID uint64
+	batchSize     int
+	keyCount      uint32
+	applyDuration time.Duration
+	syncStart     crtime.Mono
+	fsyncWait     sync.WaitGroup
+	commitErr     error
+
+	completeOnce sync.Once
+	completedCh  chan struct{}
+	done         bool
+	err          error
+	ch           chan struct{}
+}
+
+func (j *durabilityJobState) complete(
+	d *DB, applyDuration, syncDuration time.Duration, err error,
+) {
+	j.completeOnce.Do(func() {
+		defer close(j.completedCh)
+		if err == nil {
+			if applyDuration <= 0 {
+				applyDuration = time.Nanosecond
+			}
+			if syncDuration <= 0 {
+				syncDuration = time.Nanosecond
+			}
+		} else {
+			if applyDuration < 0 {
+				applyDuration = 0
+			}
+			if syncDuration < 0 {
+				syncDuration = 0
+			}
+		}
+		d.durability.recordCompletion(d, j, applyDuration, syncDuration, err)
+		if d.opts != nil && d.opts.EventListener != nil && !d.opts.DisableWAL {
+			d.opts.EventListener.BatchDurable(BatchDurableInfo{
+				JobID:         j.jobID,
+				SeqNum:        j.seqNum,
+				Err:           err,
+				ApplyDuration: applyDuration,
+				SyncDuration:  syncDuration,
+				CorrelationID: j.correlationID,
+				BatchSize:     j.batchSize,
+				KeyCount:      j.keyCount,
+			})
+		}
+	})
+	<-j.completedCh
+}
+
+type seqDurabilityWaiter struct {
+	targetSeqNum base.SeqNum
+	ch           chan struct{}
+	signaled     bool
+}
+
+type durabilityNotifySub struct {
+	targetSeqNum base.SeqNum
+	ch           chan error
+}
+
+type durabilityTracker struct {
+	mu struct {
+		sync.Mutex
+		highestDurableSeqNum   base.SeqNum
+		firstErr               error
+		closed                 bool
+		closeErr               error
+		closeCh                chan struct{}
+		pendingWaiters         int64
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		maxJobID         int
+		minRetainedJobID int
+		jobs             map[int]*durabilityJobState
+
+		seqWaiters []*seqDurabilityWaiter
+		notifySubs []*durabilityNotifySub
+	}
+
+	metricCommitCount    atomic.Uint64
+	metricCommitDuration atomic.Int64
+
+	asyncMu      sync.Mutex
+	asyncCond    *sync.Cond
+	asyncQueue   []*durabilityJobState
+	asyncRunning bool
+	asyncStop    bool
+	asyncWG      sync.WaitGroup
+}
+
+func (t *durabilityTracker) init() {
+	t.mu.closeCh = make(chan struct{})
+	t.mu.jobs = make(map[int]*durabilityJobState)
+	t.asyncCond = sync.NewCond(&t.asyncMu)
+}
+
+func isSeqNumDurable(target, highestDurable base.SeqNum) bool {
+	return highestDurable > 0 && highestDurable >= target
+}
+
+func (t *durabilityTracker) registerJob(
+	seqNum base.SeqNum, correlationID uint64, batchSize int, keyCount uint32,
+) *durabilityJobState {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.jobs == nil {
+		t.mu.jobs = make(map[int]*durabilityJobState)
+	}
+	if t.mu.closeCh == nil {
+		t.mu.closeCh = make(chan struct{})
+	}
+	t.mu.maxJobID++
+	jobID := t.mu.maxJobID
+	if t.mu.minRetainedJobID == 0 {
+		t.mu.minRetainedJobID = 1
+	}
+	job := &durabilityJobState{
+		jobID:         jobID,
+		seqNum:        seqNum,
+		correlationID: correlationID,
+		batchSize:     batchSize,
+		keyCount:      keyCount,
+		completedCh:   make(chan struct{}),
+		ch:            make(chan struct{}),
+	}
+	t.mu.jobs[jobID] = job
+	return job
+}
+
+func (t *durabilityTracker) recordCompletion(
+	d *DB, job *durabilityJobState, applyDuration, syncDuration time.Duration, err error,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	job.applyDuration = applyDuration
+	if !job.done {
+		job.done = true
+		job.err = err
+		close(job.ch)
+	}
+
+	if err == nil {
+		if job.seqNum > t.mu.highestDurableSeqNum {
+			t.mu.highestDurableSeqNum = job.seqNum
+		}
+		t.mu.totalDurableCommits++
+		t.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.mu.maxSyncDuration {
+			t.mu.maxSyncDuration = syncDuration
+		}
+		if d != nil && d.isBatchDurableConfigured() {
+			t.metricCommitCount.Add(1)
+			t.metricCommitDuration.Add(int64(syncDuration))
+		}
+	} else {
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		t.mu.totalFailedCommits++
+	}
+
+	// Evict oldest completed jobs beyond the bounded retention window.
+	for t.mu.maxJobID-t.mu.minRetainedJobID+1 > maxRetainedDurabilityJobs {
+		evictID := t.mu.minRetainedJobID
+		evictJob := t.mu.jobs[evictID]
+		if evictJob != nil && !evictJob.done {
+			break
+		}
+		delete(t.mu.jobs, evictID)
+		t.mu.minRetainedJobID++
+	}
+
+	t.notifyWaitersLocked()
+}
+
+func (t *durabilityTracker) notifyWaitersLocked() {
+	if t.mu.firstErr != nil || t.mu.closed {
+		err := t.mu.firstErr
+		if err == nil {
+			err = t.mu.closeErr
+		}
+		for _, w := range t.mu.seqWaiters {
+			if !w.signaled {
+				w.signaled = true
+				close(w.ch)
+			}
+		}
+		t.mu.seqWaiters = nil
+
+		for _, sub := range t.mu.notifySubs {
+			sub.ch <- err
+		}
+		t.mu.notifySubs = nil
+		return
+	}
+
+	highest := t.mu.highestDurableSeqNum
+	if highest == 0 {
+		return
+	}
+
+	n := 0
+	for _, w := range t.mu.seqWaiters {
+		if isSeqNumDurable(w.targetSeqNum, highest) {
+			if !w.signaled {
+				w.signaled = true
+				close(w.ch)
+			}
+		} else {
+			t.mu.seqWaiters[n] = w
+			n++
+		}
+	}
+	for i := n; i < len(t.mu.seqWaiters); i++ {
+		t.mu.seqWaiters[i] = nil
+	}
+	t.mu.seqWaiters = t.mu.seqWaiters[:n]
+
+	m := 0
+	for _, sub := range t.mu.notifySubs {
+		if isSeqNumDurable(sub.targetSeqNum, highest) {
+			sub.ch <- nil
+		} else {
+			t.mu.notifySubs[m] = sub
+			m++
+		}
+	}
+	for i := m; i < len(t.mu.notifySubs); i++ {
+		t.mu.notifySubs[i] = nil
+	}
+	t.mu.notifySubs = t.mu.notifySubs[:m]
+}
+
+func (t *durabilityTracker) removeSeqWaiterLocked(target *seqDurabilityWaiter) {
+	for i, w := range t.mu.seqWaiters {
+		if w == target {
+			last := len(t.mu.seqWaiters) - 1
+			t.mu.seqWaiters[i] = t.mu.seqWaiters[last]
+			t.mu.seqWaiters[last] = nil
+			t.mu.seqWaiters = t.mu.seqWaiters[:last]
+			return
+		}
+	}
+}
+
+func (t *durabilityTracker) close(closeErr error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closed {
+		return
+	}
+	t.mu.closed = true
+	if closeErr == nil {
+		closeErr = ErrClosed
+	}
+	t.mu.closeErr = closeErr
+	if t.mu.closeCh != nil {
+		close(t.mu.closeCh)
+	}
+	t.notifyWaitersLocked()
+}
+
+func (t *durabilityTracker) enqueueAsyncJob(d *DB, job *durabilityJobState) {
+	t.asyncMu.Lock()
+	if t.asyncCond == nil {
+		t.asyncCond = sync.NewCond(&t.asyncMu)
+	}
+	if t.asyncStop {
+		t.asyncMu.Unlock()
+		return
+	}
+	t.asyncQueue = append(t.asyncQueue, job)
+	if !t.asyncRunning {
+		t.asyncRunning = true
+		t.asyncWG.Add(1)
+		go t.runAsyncWorker(d)
+	}
+	t.asyncCond.Signal()
+	t.asyncMu.Unlock()
+}
+
+func (t *durabilityTracker) runAsyncWorker(d *DB) {
+	defer t.asyncWG.Done()
+	for {
+		t.asyncMu.Lock()
+		for len(t.asyncQueue) == 0 && !t.asyncStop {
+			t.asyncCond.Wait()
+		}
+		if len(t.asyncQueue) == 0 && t.asyncStop {
+			t.asyncRunning = false
+			t.asyncMu.Unlock()
+			return
+		}
+		job := t.asyncQueue[0]
+		t.asyncQueue[0] = nil
+		t.asyncQueue = t.asyncQueue[1:]
+		t.asyncMu.Unlock()
+
+		job.fsyncWait.Wait()
+		syncDuration := job.syncStart.Elapsed()
+		job.complete(d, job.applyDuration, syncDuration, job.commitErr)
+	}
+}
+
+func (t *durabilityTracker) stopAsyncWorker() {
+	t.asyncMu.Lock()
+	if t.asyncCond == nil {
+		t.asyncMu.Unlock()
+		return
+	}
+	t.asyncStop = true
+	t.asyncCond.Broadcast()
+	t.asyncMu.Unlock()
+	t.asyncWG.Wait()
+}
+
+func (d *DB) isBatchDurableConfigured() bool {
+	if d.batchDurableConfigured {
+		return true
+	}
+	return d.opts != nil && d.opts.EventListener != nil && !isDefaultBatchDurable(d.opts.EventListener.BatchDurable)
+}
+
+// WaitForDurability blocks until the given sequence number is durable on disk.
+// A sequence number of zero succeeds after any commit becomes durable.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable on
+// disk or ctx is cancelled. Durability and DB close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t := &d.durability
+	t.mu.Lock()
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closed {
+		err := t.mu.closeErr
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if isSeqNumDurable(seqNum, t.mu.highestDurableSeqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+
+	w := &seqDurabilityWaiter{
+		targetSeqNum: seqNum,
+		ch:           make(chan struct{}),
+	}
+	t.mu.seqWaiters = append(t.mu.seqWaiters, w)
+	t.mu.pendingWaiters++
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.mu.pendingWaiters--
+	t.removeSeqWaiterLocked(w)
+
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr
+	}
+	if t.mu.closed {
+		return t.mu.closeErr
+	}
+	if isSeqNumDurable(seqNum, t.mu.highestDurableSeqNum) {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return nil
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk or ctx is cancelled. A nil or empty slice returns nil.
+// Durability and DB close errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t := &d.durability
+	t.mu.Lock()
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.closed {
+		err := t.mu.closeErr
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if len(seqNums) == 0 {
+		t.mu.Unlock()
+		return nil
+	}
+	t.mu.Unlock()
+
+	maxSeq := seqNums[0]
+	for _, s := range seqNums[1:] {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the Sync commit identified by callback
+// jobID is durable. Jobs outside the bounded retention window return an
+// "expired" error; never-seen and zero IDs return an "unknown" error.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the Sync commit identified by
+// callback jobID is durable or ctx is cancelled. Durability and DB close errors
+// take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	t := &d.durability
+	t.mu.Lock()
+	if t.mu.closed {
+		err := t.mu.closeErr
+		if t.mu.firstErr != nil {
+			err = t.mu.firstErr
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.firstErr != nil && ctx.Err() != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if jobID <= 0 || jobID > t.mu.maxJobID {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: unknown durability job ID %d", errors.Safe(jobID))
+	}
+	if jobID < t.mu.minRetainedJobID {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: expired durability job ID %d", errors.Safe(jobID))
+	}
+	job := t.mu.jobs[jobID]
+	if job == nil {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: expired durability job ID %d", errors.Safe(jobID))
+	}
+	if job.done && job.err != nil {
+		err := job.err
+		t.mu.Unlock()
+		return err
+	}
+	if t.mu.firstErr != nil {
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if job.done {
+		t.mu.Unlock()
+		return nil
+	}
+
+	jobCh := job.ch
+	closeCh := t.mu.closeCh
+	t.mu.pendingWaiters++
+	t.mu.Unlock()
+
+	select {
+	case <-jobCh:
+	case <-closeCh:
+	case <-ctx.Done():
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.mu.pendingWaiters--
+
+	if job.done && job.err != nil {
+		return job.err
+	}
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr
+	}
+	if t.mu.closed {
+		return t.mu.closeErr
+	}
+	if job.done {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return nil
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched durability error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return d.durability.mu.highestDurableSeqNum, d.durability.mu.firstErr
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seqNum
+// becomes durable, or a non-nil error on WAL sync failure, DB close, or when
+// the bound on outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+
+	t := &d.durability
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if t.mu.firstErr != nil {
+		ch <- t.mu.firstErr
+		return ch
+	}
+	if t.mu.closed {
+		ch <- t.mu.closeErr
+		return ch
+	}
+	if isSeqNumDurable(seqNum, t.mu.highestDurableSeqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(t.mu.notifySubs) >= maxDurabilityNotifySubs {
+		ch <- errors.New("pebble: durability notify subscription limit exceeded")
+		return ch
+	}
+
+	t.mu.notifySubs = append(t.mu.notifySubs, &durabilityNotifySub{
+		targetSeqNum: seqNum,
+		ch:           ch,
+	})
+	return ch
+}
+
+// DurabilityStats returns a snapshot of the database's durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.durability.mu.highestDurableSeqNum,
+		FirstErr:               d.durability.mu.firstErr,
+		PendingWaiters:         d.durability.mu.pendingWaiters,
+		TotalDurableCommits:    d.durability.mu.totalDurableCommits,
+		TotalFailedCommits:     d.durability.mu.totalFailedCommits,
+		CumulativeSyncDuration: d.durability.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        d.durability.mu.maxSyncDuration,
+	}
+}
