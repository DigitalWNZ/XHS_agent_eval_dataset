+// syncGateFile wraps a vfs.File to allow tests to block, delay, or fail Sync calls.
+type syncGateFS struct {
+	vfs.FS
+	gateMu    sync.Mutex
+	blockCh   chan struct{}
+	enteredCh chan struct{}
+	delay     time.Duration
+	syncErr   error
+}
+
+type syncGateFile struct {
+	vfs.File
+	fs    *syncGateFS
+	isWAL bool
+}
+
+func (fs *syncGateFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	return &syncGateFile{
+		File:  f,
+		fs:    fs,
+		isWAL: strings.HasSuffix(name, ".log"),
+	}, nil
+}
+
+func (fs *syncGateFS) ReuseForWrite(
+	oldname, newname string, category vfs.DiskWriteCategory,
+) (vfs.File, error) {
+	f, err := fs.FS.ReuseForWrite(oldname, newname, category)
+	if err != nil {
+		return nil, err
+	}
+	return &syncGateFile{
+		File:  f,
+		fs:    fs,
+		isWAL: strings.HasSuffix(newname, ".log"),
+	}, nil
+}
+
+func (f *syncGateFile) Sync() error {
+	if f.isWAL {
+		f.fs.gateMu.Lock()
+		blockCh := f.fs.blockCh
+		enteredCh := f.fs.enteredCh
+		delay := f.fs.delay
+		syncErr := f.fs.syncErr
+		f.fs.gateMu.Unlock()
+
+		if enteredCh != nil {
+			select {
+			case enteredCh <- struct{}{}:
+			default:
+			}
+		}
+		if blockCh != nil {
+			<-blockCh
+		}
+		if delay > 0 {
+			time.Sleep(delay)
+		}
+		if syncErr != nil {
+			return syncErr
+		}
+		f.fs.gateMu.Lock()
+		syncErr = f.fs.syncErr
+		f.fs.gateMu.Unlock()
+		if syncErr != nil {
+			return syncErr
+		}
+	}
+	return f.File.Sync()
+}
+
+func (f *syncGateFile) SyncData() error {
+	return f.Sync()
+}
