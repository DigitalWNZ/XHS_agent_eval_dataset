+func TestDurabilityContextCancellation(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+
+	err = d.WaitForDurabilityContext(ctx, 500)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	ctx2, cancel2 := context.WithCancel(context.Background())
+	cancel2()
+	err = d.WaitForDurabilityBatchContext(ctx2, []base.SeqNum{500})
+	require.ErrorIs(t, err, context.Canceled)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
