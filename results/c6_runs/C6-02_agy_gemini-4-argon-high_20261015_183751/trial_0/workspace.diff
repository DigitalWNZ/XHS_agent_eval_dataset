+func TestDurabilityDisableWAL(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var called atomic.Bool
+	d, err := Open("", &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				called.Store(true)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	require.NoError(t, d.Set([]byte("k"), []byte("v"), NoSync))
+	require.False(t, called.Load())
+
+	// Wait APIs and DurabilityNotify must return nil immediately when DisableWAL is true.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(9999))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{100, 200}))
+	require.NoError(t, d.WaitForJobDurability(0))
+	require.NoError(t, d.WaitForJobDurability(999))
+
+	ch := d.DurabilityNotify(9999)
+	select {
+	case notifyErr := <-ch:
+		require.NoError(t, notifyErr)
+	default:
+		t.Fatal("expected DurabilityNotify to return pre-filled nil channel when DisableWAL is true")
+	}
+}
