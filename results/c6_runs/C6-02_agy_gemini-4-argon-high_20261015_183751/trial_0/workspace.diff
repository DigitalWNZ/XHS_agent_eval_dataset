+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	fs := &syncGateFS{FS: vfs.NewMem(), delay: 2 * time.Millisecond}
+	opts := &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Initial stats and state should be zero.
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+	stats := d.DurabilityStats()
+	require.Equal(t, DurabilityStats{}, stats)
+
+	// Non-sync commits must NOT trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync1"), []byte("val1"), NoSync))
+	bNoSync := d.NewBatch()
+	require.NoError(t, bNoSync.Set([]byte("nosync2"), []byte("val2"), nil))
+	require.NoError(t, bNoSync.Commit(NoSync))
+	require.NoError(t, bNoSync.Close())
+
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Commit a multi-key batch with Sync and CommitCorrelationID.
+	bSync := d.NewBatch()
+	require.NoError(t, bSync.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, bSync.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, bSync.Delete([]byte("k3"), nil))
+	expectedSize := len(bSync.Repr())
+	expectedCount := bSync.Count()
+	require.Equal(t, uint32(3), expectedCount)
+
+	writeOpts := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 424242,
+	}
+	require.NoError(t, d.Apply(bSync, writeOpts))
+	expectedSeqNum := bSync.SeqNum()
+	require.NoError(t, bSync.Close())
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev := events[0]
+	mu.Unlock()
+
+	require.Equal(t, 1, ev.JobID)
+	require.Equal(t, expectedSeqNum, ev.SeqNum)
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.GreaterOrEqual(t, ev.SyncDuration, 2*time.Millisecond)
+	require.Equal(t, uint64(424242), ev.CorrelationID)
+	require.Equal(t, expectedSize, ev.BatchSize)
+	require.Equal(t, uint32(3), ev.KeyCount)
+
+	// ApplyNoSyncWait + SyncWait should also trigger BatchDurable exactly once.
+	bAsync := d.NewBatch()
+	require.NoError(t, bAsync.Set([]byte("async_k"), []byte("async_v"), nil))
+	asyncSize := len(bAsync.Repr())
+	require.NoError(t, d.ApplyNoSyncWait(bAsync, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 999,
+	}))
+	asyncSeq := bAsync.SeqNum()
+	require.NoError(t, bAsync.SyncWait())
+	require.NoError(t, bAsync.Close())
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Equal(t, 2, ev2.JobID)
+	require.Equal(t, asyncSeq, ev2.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(999), ev2.CorrelationID)
+	require.Equal(t, asyncSize, ev2.BatchSize)
+	require.Equal(t, uint32(1), ev2.KeyCount)
+
+	// Verify Metrics are populated when BatchDurable is configured.
+	m := d.Metrics()
+	require.Equal(t, uint64(2), m.DurableCommitCount)
+	require.Equal(t, ev.SyncDuration+ev2.SyncDuration, m.DurableCommitDuration)
+
+	// Verify DurabilityStats.
+	stats = d.DurabilityStats()
+	require.Equal(t, asyncSeq, stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(2), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, ev.SyncDuration+ev2.SyncDuration, stats.CumulativeSyncDuration)
+	require.Equal(t, max(ev.SyncDuration, ev2.SyncDuration), stats.MaxSyncDuration)
+}
