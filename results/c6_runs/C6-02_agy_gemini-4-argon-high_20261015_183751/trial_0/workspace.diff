diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..85bf7b19
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,506 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxRetainedDurabilityJobs bounds the number of completed Sync commit jobs
+	// retained for WaitForJobDurability queries.
+	maxRetainedDurabilityJobs = 64
+
+	// maxDurabilityNotifySubscribers bounds the number of concurrent unresolved
+	// DurabilityNotify channel subscriptions.
+	maxDurabilityNotifySubscribers = 64
+)
+
+var (
+	// ErrJobExpired is returned by WaitForJobDurability when the job ID has
+	// fallen outside the bounded retention window.
+	ErrJobExpired = errors.New("pebble: durability job ID expired")
+
+	// ErrJobUnknown is returned by WaitForJobDurability when the job ID is zero,
+	// negative, or has never been seen.
+	ErrJobUnknown = errors.New("pebble: unknown durability job ID")
+
+	// ErrTooManyDurabilitySubscribers is delivered on the channel returned by
+	// DurabilityNotify when the bound on outstanding subscriptions is exceeded.
+	ErrTooManyDurabilitySubscribers = errors.New("pebble: too many outstanding durability notify subscriptions")
+)
+
+// DurabilityStats holds a point-in-time snapshot of commit durability state and
+// statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJob struct {
+	jobID int
+	done  bool
+	err   error
+}
+
+type durabilitySubscriber struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type asyncSyncState struct {
+	fsyncWait sync.WaitGroup
+	commitErr error
+	done      chan struct{}
+}
+
+type durabilityTracker struct {
+	mu                     sync.Mutex
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	closedErr              error
+	pendingWaiters         int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+	metricsCommitCount     uint64
+	metricsCommitDuration  time.Duration
+	nextJobID              int
+	minRetainedJobID       int
+	jobs                   map[int]*durabilityJob
+	subscribers            []*durabilitySubscriber
+	broadcastCh            chan struct{}
+}
+
+func newDurabilityTracker() *durabilityTracker {
+	return &durabilityTracker{
+		jobs:        make(map[int]*durabilityJob),
+		broadcastCh: make(chan struct{}),
+	}
+}
+
+func (t *durabilityTracker) notifyWaitersLocked() {
+	close(t.broadcastCh)
+	t.broadcastCh = make(chan struct{})
+}
+
+func (t *durabilityTracker) closeOrDurabilityErrLocked() error {
+	if t.firstErr != nil {
+		return t.firstErr
+	}
+	return t.closedErr
+}
+
+func (t *durabilityTracker) closeOrDurabilityErr() error {
+	t.mu.Lock()
+	err := t.closeOrDurabilityErrLocked()
+	t.mu.Unlock()
+	return err
+}
+
+func (t *durabilityTracker) isDurableLocked(seqNum base.SeqNum) bool {
+	return t.totalDurableCommits > 0 && seqNum <= t.highestDurableSeqNum
+}
+
+func (t *durabilityTracker) startJob() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.nextJobID++
+	id := t.nextJobID
+	if t.minRetainedJobID == 0 {
+		t.minRetainedJobID = 1
+	}
+	t.jobs[id] = &durabilityJob{jobID: id}
+	return id
+}
+
+func (t *durabilityTracker) completeJob(
+	jobID int,
+	seqNum base.SeqNum,
+	err error,
+	syncDuration time.Duration,
+	batchDurableConfigured bool,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if job, ok := t.jobs[jobID]; ok {
+		job.done = true
+		job.err = err
+	}
+	for t.minRetainedJobID > 0 && t.nextJobID-t.minRetainedJobID+1 > maxRetainedDurabilityJobs {
+		evictJob := t.jobs[t.minRetainedJobID]
+		if evictJob != nil && !evictJob.done {
+			break
+		}
+		delete(t.jobs, t.minRetainedJobID)
+		t.minRetainedJobID++
+	}
+
+	if err != nil {
+		t.totalFailedCommits++
+		if t.firstErr == nil {
+			t.firstErr = err
+		}
+		for _, sub := range t.subscribers {
+			sub.ch <- t.firstErr
+		}
+		t.subscribers = nil
+	} else {
+		t.totalDurableCommits++
+		if seqNum > t.highestDurableSeqNum {
+			t.highestDurableSeqNum = seqNum
+		}
+		t.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.maxSyncDuration {
+			t.maxSyncDuration = syncDuration
+		}
+		if batchDurableConfigured {
+			t.metricsCommitCount++
+			t.metricsCommitDuration += syncDuration
+		}
+		if t.totalDurableCommits > 0 && len(t.subscribers) > 0 {
+			remaining := t.subscribers[:0]
+			for _, sub := range t.subscribers {
+				if sub.seqNum <= t.highestDurableSeqNum {
+					sub.ch <- nil
+				} else {
+					remaining = append(remaining, sub)
+				}
+			}
+			for i := len(remaining); i < len(t.subscribers); i++ {
+				t.subscribers[i] = nil
+			}
+			t.subscribers = remaining
+		}
+	}
+
+	t.notifyWaitersLocked()
+}
+
+func (t *durabilityTracker) close(err error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closedErr != nil {
+		return
+	}
+	if err == nil {
+		err = ErrClosed
+	}
+	t.closedErr = err
+	notifyErr := t.firstErr
+	if notifyErr == nil {
+		notifyErr = t.closedErr
+	}
+	for _, sub := range t.subscribers {
+		sub.ch <- notifyErr
+	}
+	t.subscribers = nil
+	t.notifyWaitersLocked()
+}
+
+func (t *durabilityTracker) waitWithContext(
+	ctx context.Context, checkLocked func() (done bool, err error),
+) error {
+	t.mu.Lock()
+	done, err := checkLocked()
+	if done && err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if ctx != nil {
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			t.mu.Unlock()
+			return ctxErr
+		}
+	}
+	if done {
+		t.mu.Unlock()
+		return nil
+	}
+
+	t.pendingWaiters++
+	for {
+		ch := t.broadcastCh
+		t.mu.Unlock()
+
+		var ctxCancelled bool
+		if ctx != nil {
+			select {
+			case <-ch:
+			case <-ctx.Done():
+				ctxCancelled = true
+			}
+		} else {
+			<-ch
+		}
+
+		t.mu.Lock()
+		done, err = checkLocked()
+		if done && err != nil {
+			t.pendingWaiters--
+			t.mu.Unlock()
+			return err
+		}
+		if ctxCancelled {
+			t.pendingWaiters--
+			err = t.closeOrDurabilityErrLocked()
+			t.mu.Unlock()
+			if err != nil {
+				return err
+			}
+			return ctx.Err()
+		}
+		if done {
+			t.pendingWaiters--
+			t.mu.Unlock()
+			return nil
+		}
+	}
+}
+
+func (t *durabilityTracker) waitForSeqNum(ctx context.Context, seqNum base.SeqNum) error {
+	return t.waitWithContext(ctx, func() (bool, error) {
+		if err := t.closeOrDurabilityErrLocked(); err != nil {
+			return true, err
+		}
+		if t.isDurableLocked(seqNum) {
+			return true, nil
+		}
+		return false, nil
+	})
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	var targetJob *durabilityJob
+	return t.waitWithContext(ctx, func() (bool, error) {
+		if t.closedErr != nil {
+			if t.firstErr != nil {
+				return true, t.firstErr
+			}
+			return true, t.closedErr
+		}
+		if targetJob == nil {
+			if jobID <= 0 || jobID > t.nextJobID {
+				return true, ErrJobUnknown
+			}
+			if jobID < t.minRetainedJobID {
+				return true, ErrJobExpired
+			}
+			job, ok := t.jobs[jobID]
+			if !ok {
+				return true, ErrJobExpired
+			}
+			targetJob = job
+		}
+		if targetJob.done {
+			if targetJob.err != nil {
+				return true, targetJob.err
+			}
+			if t.firstErr != nil {
+				return true, t.firstErr
+			}
+			return true, nil
+		}
+		if t.firstErr != nil {
+			return true, t.firstErr
+		}
+		return false, nil
+	})
+}
+
+func (t *durabilityTracker) subscribe(seqNum base.SeqNum, ch chan error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err := t.closeOrDurabilityErrLocked(); err != nil {
+		ch <- err
+		return
+	}
+	if t.isDurableLocked(seqNum) {
+		ch <- nil
+		return
+	}
+	if len(t.subscribers) >= maxDurabilityNotifySubscribers {
+		ch <- ErrTooManyDurabilitySubscribers
+		return
+	}
+	t.subscribers = append(t.subscribers, &durabilitySubscriber{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+}
+
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	seq := t.highestDurableSeqNum
+	err := t.firstErr
+	t.mu.Unlock()
+	return seq, err
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	s := DurabilityStats{
+		HighestDurableSeqNum:   t.highestDurableSeqNum,
+		FirstErr:               t.firstErr,
+		PendingWaiters:         t.pendingWaiters,
+		TotalDurableCommits:    t.totalDurableCommits,
+		TotalFailedCommits:     t.totalFailedCommits,
+		CumulativeSyncDuration: t.cumulativeSyncDuration,
+		MaxSyncDuration:        t.maxSyncDuration,
+	}
+	t.mu.Unlock()
+	return s
+}
+
+func (t *durabilityTracker) metrics() (uint64, time.Duration) {
+	t.mu.Lock()
+	count := t.metricsCommitCount
+	dur := t.metricsCommitDuration
+	t.mu.Unlock()
+	return count, dur
+}
+
+func (d *DB) completeSyncCommit(
+	jobID int,
+	seqNum base.SeqNum,
+	err error,
+	applyDuration time.Duration,
+	syncDuration time.Duration,
+	correlationID uint64,
+	batchSize int,
+	keyCount uint32,
+) {
+	if applyDuration <= 0 {
+		applyDuration = time.Nanosecond
+	}
+	if syncDuration <= 0 {
+		syncDuration = time.Nanosecond
+	}
+	var batchDurableFn func(BatchDurableInfo)
+	if d.opts.EventListener != nil {
+		batchDurableFn = d.opts.EventListener.BatchDurable
+	}
+	configured := isBatchDurableConfigured(batchDurableFn)
+	d.durability.completeJob(jobID, seqNum, err, syncDuration, configured)
+	if batchDurableFn != nil {
+		batchDurableFn(BatchDurableInfo{
+			JobID:         jobID,
+			SeqNum:        seqNum,
+			Err:           err,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: correlationID,
+			BatchSize:     batchSize,
+			KeyCount:      keyCount,
+		})
+	}
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk. A sequence number of zero succeeds after any durable commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(nil, seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk or the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if err := d.durability.closeOrDurabilityErr(); err != nil {
+		return err
+	}
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForSeqNum(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(nil, seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable or the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if err := d.durability.closeOrDurabilityErr(); err != nil {
+		return err
+	}
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.durability.waitForSeqNum(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the Sync commit identified by jobID is
+// durable.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(nil, jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the Sync commit identified by jobID
+// is durable or the context is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if err := d.durability.closeOrDurabilityErr(); err != nil {
+		return err
+	}
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched durability error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seqNum
+// becomes durable, or a non-nil error on WAL sync failure, DB close, or if the
+// bound on outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if err := d.durability.closeOrDurabilityErr(); err != nil {
+		ch <- err
+		return ch
+	}
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+	d.durability.subscribe(seqNum, ch)
+	return ch
+}
+
+// DurabilityStats returns a snapshot of durability state and commit metrics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
