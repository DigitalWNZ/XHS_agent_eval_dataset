+func TestWaitForDurabilityAndPendingWaiters(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	fs := &syncGateFS{FS: vfs.NewMem()}
+	d, err := Open("", &Options{FS: fs})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Block WAL syncs so we can observe waiters blocking and PendingWaiters.
+	blockCh := make(chan struct{})
+	enteredCh := make(chan struct{}, 1)
+	fs.gateMu.Lock()
+	fs.blockCh = blockCh
+	fs.enteredCh = enteredCh
+	fs.gateMu.Unlock()
+
+	const numWaiters = 4
+	errCh := make(chan error, numWaiters)
+
+	// Waiter 1: WaitForDurability(0) before any commit.
+	go func() {
+		errCh <- d.WaitForDurability(0)
+	}()
+	// Waiter 2: WaitForDurability(10).
+	go func() {
+		errCh <- d.WaitForDurability(10)
+	}()
+	// Waiter 3: WaitForDurabilityBatch([]base.SeqNum{0, 10}).
+	go func() {
+		errCh <- d.WaitForDurabilityBatch([]base.SeqNum{0, 10})
+	}()
+
+	// Wait until the 3 waiters are registered in PendingWaiters.
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 3
+	}, 2*time.Second, time.Millisecond)
+
+	// Start a Sync commit in the background; it will block in WAL Sync.
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- d.Set([]byte("k1"), []byte("v1"), Sync)
+	}()
+
+	// Wait for the WAL sync to reach the gate.
+	<-enteredCh
+
+	// Waiter 4: WaitForJobDurability(1) while job 1 is in flight.
+	go func() {
+		errCh <- d.WaitForJobDurability(1)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 4
+	}, 2*time.Second, time.Millisecond)
+
+	// Also register a DurabilityNotify subscription.
+	notifyCh := d.DurabilityNotify(10)
+	select {
+	case <-notifyCh:
+		t.Fatal("expected notifyCh not to be ready yet")
+	default:
+	}
+
+	// Release the WAL sync gate.
+	close(blockCh)
+
+	require.NoError(t, <-commitDone)
+	for i := 0; i < numWaiters; i++ {
+		require.NoError(t, <-errCh)
+	}
+	require.NoError(t, <-notifyCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Nil and empty slices in WaitForDurabilityBatch return nil immediately.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+}
