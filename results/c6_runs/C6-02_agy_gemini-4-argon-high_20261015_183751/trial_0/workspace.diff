+func TestDurabilityNotifyBounds(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	var chans []<-chan error
+	for i := 0; i < maxDurabilityNotifySubscribers; i++ {
+		ch := d.DurabilityNotify(base.SeqNum(100 + i))
+		select {
+		case err := <-ch:
+			t.Fatalf("unexpected immediate resolution at %d: %v", i, err)
+		default:
+		}
+		chans = append(chans, ch)
+	}
+
+	// Excess subscriber must immediately get a pre-filled channel with non-nil error.
+	excessCh := d.DurabilityNotify(base.SeqNum(9999))
+	select {
+	case excessErr := <-excessCh:
+		require.Error(t, excessErr)
+	default:
+		t.Fatal("expected excess DurabilityNotify channel to be pre-filled with error")
+	}
+
+	// Resolve existing subscriptions by committing up to sequence number.
+	for i := 0; i < 200; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+	for _, ch := range chans {
+		require.NoError(t, <-ch)
+	}
+
+	// Already durable sequence number returns pre-filled nil channel immediately.
+	seq, _ := d.DurableState()
+	readyCh := d.DurabilityNotify(seq)
+	select {
+	case readyErr := <-readyCh:
+		require.NoError(t, readyErr)
+	default:
+		t.Fatal("expected already-durable DurabilityNotify channel to be pre-filled")
+	}
+}
