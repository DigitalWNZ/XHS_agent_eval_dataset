+func TestWaitForJobDurabilityUnknownAndExpired(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var jobIDs []int
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				jobIDs = append(jobIDs, info.JobID)
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, d.Close())
+	}()
+
+	// Zero, negative, and never-seen job IDs must return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Perform enough Sync commits to exceed the retention window.
+	totalCommits := maxRetainedDurabilityJobs + 20
+	for i := 0; i < totalCommits; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+	require.Len(t, jobIDs, totalCommits)
+
+	// Early jobs outside the retention window must return an "expired" error.
+	expiredErr := d.WaitForJobDurability(jobIDs[0])
+	require.Error(t, expiredErr)
+	require.Contains(t, strings.ToLower(expiredErr.Error()), "expired")
+	require.NotEqual(t, err.Error(), expiredErr.Error())
+
+	// Recent jobs within the retention window must succeed.
+	lastJobID := jobIDs[len(jobIDs)-1]
+	require.NoError(t, d.WaitForJobDurability(lastJobID))
+
+	// Never-seen future job ID must still return "unknown".
+	futureErr := d.WaitForJobDurability(lastJobID + 100)
+	require.Error(t, futureErr)
+	require.Contains(t, strings.ToLower(futureErr.Error()), "unknown")
+}
