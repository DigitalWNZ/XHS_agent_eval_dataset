+func TestDurabilityWALSyncFailureAndErrorPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	fs := &syncGateFS{FS: vfs.NewMem()}
+	d, err := Open("", &Options{
+		FS:     fs,
+		Logger: base.NoopLoggerAndTracer{},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	// First commit succeeds.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	// Register a waiter and a subscriber for a future sequence number before injecting failure.
+	waitErrCh := make(chan error, 1)
+	go func() {
+		waitErrCh <- d.WaitForDurability(seq1 + 10)
+	}()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	notifyCh := d.DurabilityNotify(seq1 + 10)
+
+	// Inject WAL sync error.
+	injectedErr := errors.New("injected wal sync failure")
+	fs.gateMu.Lock()
+	fs.syncErr = injectedErr
+	fs.gateMu.Unlock()
+
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k2"), []byte("v2"), nil))
+	commitErr := d.Apply(b2, &WriteOptions{Sync: true, CommitCorrelationID: 77})
+	require.ErrorIs(t, commitErr, injectedErr)
+
+	// BatchDurable must have fired with the error.
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEv := events[1]
+	mu.Unlock()
+	require.ErrorIs(t, failEv.Err, injectedErr)
+	require.Equal(t, uint64(77), failEv.CorrelationID)
+
+	// Waiter and subscriber must unblock with the error.
+	require.ErrorIs(t, <-waitErrCh, injectedErr)
+	require.ErrorIs(t, <-notifyCh, injectedErr)
+
+	// DurableState must retain seq1 and latch the first error.
+	gotSeq, gotErr := d.DurableState()
+	require.Equal(t, seq1, gotSeq)
+	require.ErrorIs(t, gotErr, injectedErr)
+
+	// DurabilityStats must reflect 1 durable commit and 1 failed commit.
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+
+	// Durability error must take precedence over context cancellation.
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, d.WaitForDurabilityContext(cancelledCtx, seq1), injectedErr)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{seq1}), injectedErr)
+	require.ErrorIs(t, d.WaitForJobDurabilityContext(cancelledCtx, 1), injectedErr)
+}
