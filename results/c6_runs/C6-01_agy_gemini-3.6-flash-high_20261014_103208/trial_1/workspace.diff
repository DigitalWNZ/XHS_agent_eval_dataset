+import re
+
+def clean_css_content(css_text: str) -> str:
+    # 1. Remove properties with javascript: in url(...)
+    css_text = re.sub(
+        r'[a-zA-Z0-9_-]+\s*:\s*[^;}]*url\s*\(\s*(?:"[^"]*javascript:[^"]*"|\'[^\']*javascript:[^\']*\x27|[^\)]*javascript:[^\)]*)\s*\)\s*;?',
+        '',
+        css_text,
+        flags=re.IGNORECASE
+    )
+    # 2. Remove properties with expression(...)
+    css_text = re.sub(
+        r'[a-zA-Z0-9_-]+\s*:\s*expression\s*\((?:[^()]*|\([^()]*\))*\)\s*;?',
+        '',
+        css_text,
+        flags=re.IGNORECASE
+    )
+    # 3. Remove -moz-binding and behavior
+    css_text = re.sub(
+        r'(?:-moz-binding|behavior)\s*:[^;}"\']+\s*;?',
+        '',
+        css_text,
+        flags=re.IGNORECASE
+    )
+    # Clean up double semicolons or spacing
+    css_text = re.sub(r';\s*;', ';', css_text)
+    return css_text.strip()
+
+sample1 = "color: red; background: url('javascript:alert(1)'); margin: 10px;"
+sample2 = "body { background: url(\"javascript:alert(1)\"); font-size: 14px; }"
+sample3 = "p { width: expression(alert(1)); }"
+
+print("Sample 1:", repr(clean_css_content(sample1)))
+print("Sample 2:", repr(clean_css_content(sample2)))
+print("Sample 3:", repr(clean_css_content(sample3)))
diff --git a/scratch/test_edge_cases.py b/scratch/test_edge_cases.py
new file mode 100644
