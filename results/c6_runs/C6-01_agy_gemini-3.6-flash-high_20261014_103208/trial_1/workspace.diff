@@ -0,0 +1,154 @@
+import os
+import subprocess
+import tempfile
+import sys
+
+TEST_CASES = [
+    {
+        "name": "Basic Script Removal & Formatting Preservation",
+        "input": """<!DOCTYPE html>
+<html>
+  <head>
+    <title>Test Page</title>
+    <script type="text/javascript">
+      alert('xss');
+    </script>
+  </head>
+  <body class="main-body" id="b1">
+    <h1 class="header">Hello World</h1>
+    <p>This is a test paragraph.</p>
+  </body>
+</html>""",
+        "expected": """<!DOCTYPE html>
+<html>
+  <head>
+    <title>Test Page</title>
+    
+  </head>
+  <body class="main-body" id="b1">
+    <h1 class="header">Hello World</h1>
+    <p>This is a test paragraph.</p>
+  </body>
+</html>"""
+    },
+    {
+        "name": "Event Handler Removal",
+        "input": """<button class="btn" onclick="alert(1)" id="btn1">Click me</button>
+<img src="pic.jpg" onerror='alert(2)' alt="Picture" />
+<body onload=alert(3) onmouseover="hover()"></body>""",
+        "expected": """<button class="btn" id="btn1">Click me</button>
+<img src="pic.jpg" alt="Picture" />
+<body></body>"""
+    },
+    {
+        "name": "Javascript Protocol Removal",
+        "input": """<a href="javascript:alert(1)" class="link">Link 1</a>
+<a href="  javascript:alert(2)  " id="l2">Link 2</a>
+<a href="java&#x0A;script:alert(3)">Link 3</a>
+<a href="javascript&colon;alert(4)">Link 4</a>
+<a href="https://example.com" class="safe">Safe Link</a>""",
+        "expected": """<a class="link">Link 1</a>
+<a id="l2">Link 2</a>
+<a>Link 3</a>
+<a>Link 4</a>
+<a href="https://example.com" class="safe">Safe Link</a>"""
+    },
+    {
+        "name": "Table and Structure Preservation",
+        "input": """<table class="table-striped" border="1" cellpadding="5">
+  <thead>
+    <tr>
+      <th scope="col">ID</th>
+      <th scope="col">Name</th>
+    </tr>
+  </thead>
+  <tbody>
+    <tr id="row-1">
+      <td>1</td>
+      <td>Alice <script>alert('a')</script></td>
+    </tr>
+    <tr id="row-2" onclick="selectRow(2)">
+      <td>2</td>
+      <td>Bob</td>
+    </tr>
+  </tbody>
+</table>""",
+        "expected": """<table class="table-striped" border="1" cellpadding="5">
+  <thead>
+    <tr>
+      <th scope="col">ID</th>
+      <th scope="col">Name</th>
+    </tr>
+  </thead>
+  <tbody>
+    <tr id="row-1">
+      <td>1</td>
+      <td>Alice </td>
+    </tr>
+    <tr id="row-2">
+      <td>2</td>
+      <td>Bob</td>
+    </tr>
+  </tbody>
+</table>"""
+    },
+    {
+        "name": "CSS / Style Injection Removal",
+        "input": """<div style="color: red; background: url('javascript:alert(1)'); margin: 10px;">Box</div>
+<style>
+  body { background: url("javascript:alert(1)"); font-size: 14px; }
+  p { width: expression(alert(1)); }
+</style>""",
+        "expected": """<div style="color: red; margin: 10px;">Box</div>
+<style>
+  body { font-size: 14px; }
+  p { }
+</style>"""
+    },
+    {
+        "name": "Non-event 'on' Attributes (e.g., 'one', 'only')",
+        "input": """<div one="value1" only="value2" onclick="alert(1)">Test</div>""",
+        "expected": """<div one="value1" only="value2">Test</div>"""
+    }
+]
+
+def run_tests():
+    passed = 0
+    failed = 0
+
+    for i, tc in enumerate(TEST_CASES, 1):
+        with tempfile.NamedTemporaryFile(mode='w+', delete=False, suffix='.html') as f:
+            f.write(tc["input"])
+            tmp_path = f.name
+
+        try:
+            res = subprocess.run([sys.executable, "/app/filter.py", tmp_path], capture_output=True, text=True)
+            if res.returncode != 0:
+                print(f"FAILED [{i}] {tc['name']} - Process returned non-zero code {res.returncode}")
+                print(res.stderr)
+                failed += 1
+                continue
+
+            with open(tmp_path, 'r', encoding='utf-8') as f:
+                output = f.read()
+
+            if output == tc["expected"]:
+                print(f"PASSED [{i}] {tc['name']}")
+                passed += 1
+            else:
+                print(f"FAILED [{i}] {tc['name']}")
+                print("--- EXPECTED ---")
+                print(repr(tc["expected"]))
+                print("--- ACTUAL ---")
+                print(repr(output))
+                failed += 1
+        finally:
+            if os.path.exists(tmp_path):
+                os.remove(tmp_path)
+
+    print(f"\nTotal: {len(TEST_CASES)} | Passed: {passed} | Failed: {failed}")
+    if failed > 0:
+        sys.exit(1)
+
+if __name__ == "__main__":
+    run_tests()
