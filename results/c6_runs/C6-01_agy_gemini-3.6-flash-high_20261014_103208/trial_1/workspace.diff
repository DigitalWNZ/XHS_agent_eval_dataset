+++ b/scratch/test_edge_cases.py
@@ -0,0 +1,84 @@
+import subprocess
+import sys
+import tempfile
+
+EDGE_CASES = [
+    {
+        "name": "Multi-line attributes",
+        "input": '<a\n  href="javascript:alert(1)"\n  class="link">Link</a>',
+        "expected": '<a\n  \n  class="link">Link</a>'
+    },
+    {
+        "name": "Namespaced & hyphenated attributes",
+        "input": '<a xml:lang="en" data-test-id="123" aria-label="btn" xlink:href="javascript:alert(1)">Link</a>',
+        "expected": '<a xml:lang="en" data-test-id="123" aria-label="btn">Link</a>'
+    },
+    {
+        "name": "Slash separator tag <script/src=...>",
+        "input": '<script/src="http://example.com/a.js"></script><p>Text</p>',
+        "expected": '<p>Text</p>'
+    },
+    {
+        "name": "Script with comments inside",
+        "input": '<script><!-- alert(1); --></script><p>Text</p>',
+        "expected": '<p>Text</p>'
+    },
+    {
+        "name": "Script with line breaks inside opening tag",
+        "input": '<script\ntype="text/javascript"\n>alert(1)</script><p>Text</p>',
+        "expected": '<p>Text</p>'
+    },
+    {
+        "name": "Mixed case script tag <ScRiPt>",
+        "input": '<ScRiPt>alert(1)</sCrIpT><p>Text</p>',
+        "expected": '<p>Text</p>'
+    },
+    {
+        "name": "Dangerous URIs in img/iframe/form/object/embed",
+        "input": '<img src="javascript:alert(1)" />\n<iframe src="javascript:alert(2)"></iframe>\n<form action="javascript:alert(3)"></form>\n<object data="javascript:alert(4)"></object>\n<embed src="javascript:alert(5)" />',
+        "expected": '<img />\n<iframe></iframe>\n<form></form>\n<object></object>\n<embed />'
+    },
+    {
+        "name": "Unclosed script at EOF",
+        "input": '<div><script>alert(1);',
+        "expected": '<div>'
+    }
+]
+
+def run_edge_tests():
+    passed = 0
+    failed = 0
+
+    for i, tc in enumerate(EDGE_CASES, 1):
+        with tempfile.NamedTemporaryFile(mode='w+', delete=False, suffix='.html') as f:
+            f.write(tc["input"])
+            tmp_path = f.name
+
+        try:
+            res = subprocess.run([sys.executable, "/app/filter.py", tmp_path], capture_output=True, text=True)
+            if res.returncode != 0:
+                print(f"FAILED [{i}] {tc['name']} - Non-zero exit {res.returncode}")
+                print(res.stderr)
+                failed += 1
+                continue
+
+            with open(tmp_path, 'r', encoding='utf-8') as f:
+                output = f.read()
+
+            if output == tc["expected"]:
+                print(f"PASSED [{i}] {tc['name']}")
+                passed += 1
+            else:
+                print(f"FAILED [{i}] {tc['name']}")
+                print("--- EXPECTED ---")
+                print(repr(tc["expected"]))
+                print("--- ACTUAL ---")
+                print(repr(output))
+                failed += 1
+        finally:
+            pass
+
+    print(f"\nTotal: {len(EDGE_CASES)} | Passed: {passed} | Failed: {failed}")
+
+if __name__ == "__main__":
+    run_edge_tests()
