@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+import sys
+import cv2
+import numpy as np
+import toml
+
+
+def analyze_jump(video_path: str, output_path: str = "/app/output.toml") -> dict:
+    cap = cv2.VideoCapture(video_path)
+    if not cap.isOpened():
+        raise ValueError(f"Could not open video file: {video_path}")
+
+    ret, first_frame = cap.read()
+    if not ret or first_frame is None:
+        cap.release()
+        raise ValueError(f"Could not read first frame from: {video_path}")
+
+    h, w = first_frame.shape[:2]
+    f0 = first_frame.astype(np.float32)
+    g0 = cv2.cvtColor(first_frame, cv2.COLOR_BGR2GRAY).astype(np.float32)
+
+    k3 = np.ones((3, 3), np.uint8)
+    f0_min = cv2.erode(f0, k3)
+    f0_max = cv2.dilate(f0, k3)
+
+    ref_y_start = int(h * 0.70)
+    roi_y_top = int(h * 0.28)
+    roi_y_bottom = int(h * 0.77)
+
+    f0_roi_min = f0_min[roi_y_top:roi_y_bottom, :]
+    f0_roi_max = f0_max[roi_y_top:roi_y_bottom, :]
+    f0_ref = f0[ref_y_start:, :]
+    g0_ref = g0[ref_y_start:, :]
+
+    y_max_by_frame = {}
+    x_med_by_frame = {}
+
+    frame_idx = 0
+    while True:
+        ret, frame = cap.read()
+        if not ret or frame is None:
+            break
+        frame_idx += 1
+
+        # Quick check on unaligned ROI to skip clearly empty frames
+        f_roi_raw = frame[roi_y_top:roi_y_bottom, :].astype(np.float32)
+        quick_diff = np.maximum(
+            0.0, np.maximum(f0_roi_min - f_roi_raw, f_roi_raw - f0_roi_max)
+        ).max(axis=2)
+        if np.count_nonzero(quick_diff > 30.0) < 150:
+            continue
+
+        gi_ref = cv2.cvtColor(frame[ref_y_start:, :], cv2.COLOR_BGR2GRAY).astype(np.float32)
+        shift, _ = cv2.phaseCorrelate(g0_ref, gi_ref)
+        dx = float(np.clip(shift[0], -5.0, 5.0))
+        dy = float(np.clip(shift[1], -5.0, 5.0))
+
+        M = np.float32([[1.0, 0.0, -dx], [0.0, 1.0, -dy]])
+        aligned = cv2.warpAffine(
+            frame.astype(np.float32), M, (w, h), borderMode=cv2.BORDER_REPLICATE
+        )
+
+        offset = np.mean(aligned[ref_y_start:, :] - f0_ref, axis=(0, 1))
+        aligned_roi = aligned[roi_y_top:roi_y_bottom, :] - offset
+
+        diff = np.maximum(
+            0.0, np.maximum(f0_roi_min - aligned_roi, aligned_roi - f0_roi_max)
+        ).max(axis=2)
+        mask = (diff > 22.0).astype(np.uint8)
+        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k3)
+
+        num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask)
+        clean_mask = np.zeros_like(mask)
+        for lbl in range(1, num_labels):
+            if stats[lbl, cv2.CC_STAT_AREA] >= 25:
+                clean_mask[labels == lbl] = 1
+
+        ys, xs = np.where(clean_mask > 0)
+        if len(ys) >= 300:
+            x_med = float(np.median(xs))
+            in_runner_x = np.abs(xs - x_med) <= int(w * 0.19)
+            ys_r = ys[in_runner_x]
+            if len(ys_r) >= 100:
+                y_max_by_frame[frame_idx] = int(ys_r.max() + roi_y_top)
+                x_med_by_frame[frame_idx] = x_med
+
+    cap.release()
+
+    if not y_max_by_frame:
+        raise RuntimeError("No runner detected in video.")
+
+    valid_frames = sorted(y_max_by_frame.keys())
+
+    # Identify the peak of the hurdle jump (minimum y_max near the central hurdle region)
+    center_candidates = [
+        f for f in valid_frames if (w * 0.25) <= x_med_by_frame[f] <= (w * 0.75)
+    ]
+    if not center_candidates:
+        center_candidates = valid_frames[1:-1] if len(valid_frames) > 2 else valid_frames
+
+    peak_frame = min(center_candidates, key=lambda f: y_max_by_frame[f])
+
+    # Takeoff detection: find the stance plateau before peak_frame and pick the last ground contact frame
+    pre_candidates = [f for f in valid_frames if (peak_frame - 15) <= f < peak_frame]
+    if not pre_candidates:
+        pre_candidates = [f for f in valid_frames if f < peak_frame]
+
+    if pre_candidates:
+        takeoff_ground_y = max(y_max_by_frame[f] for f in pre_candidates)
+        ground_pre = [
+            f for f in pre_candidates if y_max_by_frame[f] >= takeoff_ground_y - 5
+        ]
+        takeoff_frame = max(ground_pre) if ground_pre else pre_candidates[-1]
+    else:
+        takeoff_frame = max(0, peak_frame - 5)
+
+    # Landing detection: find the stance plateau after peak_frame and pick the first ground contact frame
+    post_candidates = [f for f in valid_frames if peak_frame < f <= (peak_frame + 15)]
+    if not post_candidates:
+        post_candidates = [f for f in valid_frames if f > peak_frame]
+
+    if post_candidates:
+        land_ground_y = max(y_max_by_frame[f] for f in post_candidates)
+        ground_post = [
+            f for f in post_candidates if y_max_by_frame[f] >= land_ground_y - 5
+        ]
+        land_frame = min(ground_post) if ground_post else post_candidates[0]
+    else:
+        land_frame = peak_frame + 4
+
+    result = {
+        "jump_takeoff_frame_number": int(takeoff_frame),
+        "jump_land_frame_number": int(land_frame),
+    }
+
+    output_paths = {"/app/output.toml"}
+    if output_path:
+        output_paths.add(output_path)
+
+    for path in output_paths:
+        try:
+            with open(path, "w", encoding="utf-8") as f:
+                toml.dump(result, f)
+        except OSError:
+            pass
+
+    return result
+
+
+def main(argv=None):
+    if argv is None:
+        argv = sys.argv[1:]
+
+    video_path = "/app/example_video.mp4"
+    output_path = "/app/output.toml"
+
+    positional = []
+    i = 0
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-i", "--input", "-v", "--video", "-f", "--file") and i + 1 < len(argv):
+            video_path = argv[i + 1]
+            i += 2
+        elif arg in ("-o", "--output") and i + 1 < len(argv):
+            output_path = argv[i + 1]
+            i += 2
+        elif arg.startswith("--input=") or arg.startswith("--video=") or arg.startswith("--file="):
+            video_path = arg.split("=", 1)[1]
+            i += 1
+        elif arg.startswith("--output="):
+            output_path = arg.split("=", 1)[1]
+            i += 1
+        elif not arg.startswith("-"):
+            positional.append(arg)
+            i += 1
+        else:
+            i += 1
+
+    if len(positional) >= 1:
+        video_path = positional[0]
+    if len(positional) >= 2:
+        output_path = positional[1]
+
+    return analyze_jump(video_path, output_path)
+
+
+if __name__ == "__main__":
+    main()
