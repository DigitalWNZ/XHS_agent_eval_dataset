+import { Expect } from 'type-tests/utils.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const employees = pgTable('employees', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	department: text('department').notNull(),
+	salary: integer('salary').notNull(),
+	bonus: integer('bonus'),
+});
+
+const result = await db
+	.select({
+		rn: rowNumber().over({ partitionBy: employees.department, orderBy: employees.salary }),
+		rk: rank().over('w'),
+		dr: denseRank().over(),
+		nt: ntile(4).over(),
+		pr: percentRank().over(),
+		cd: cumeDist().over(),
+		lagNullable: lag(employees.salary).over(),
+		lagWithOffsetNullable: lag(employees.salary, 2).over(),
+		lagWithDefaultNonNull: lag(employees.salary, 2, 0).over(),
+		lagNullableColWithDefault: lag(employees.bonus, 1, 0).over(),
+		leadNullable: lead(employees.name).over(),
+		leadWithOffsetNullable: lead(employees.name, 1).over(),
+		leadWithDefaultNonNull: lead(employees.name, 1, 'N/A').over(),
+		leadNullableColWithDefault: lead(employees.bonus, 1, 0).over(),
+		fv: firstValue(employees.salary).over({
+			frame: rows({ from: unboundedPreceding, to: currentRow }),
+		}),
+		lv: lastValue(employees.name).over({
+			frame: range({ from: preceding(1), to: following(1) }),
+		}),
+		nv: nthValue(employees.salary, 2).over({
+			frame: rows({ from: unboundedPreceding, to: unboundedFollowing }),
+		}),
+		sumVal: windowSum(employees.salary).over(),
+		avgVal: windowAvg(employees.salary).over(),
+		minVal: windowMin(employees.salary).over(),
+		maxVal: windowMax(employees.name).over(),
+		cntAll: windowCount().over(),
+		cntCol: windowCount(employees.bonus).over(),
+	})
+	.from(employees)
+	.window('w', {
+		partitionBy: employees.department,
+		orderBy: employees.salary,
+	});
+
+Expect<
+	Equal<
+		{
+			rn: number;
+			rk: number;
+			dr: number;
+			nt: number;
+			pr: number;
+			cd: number;
+			lagNullable: number | null;
+			lagWithOffsetNullable: number | null;
+			lagWithDefaultNonNull: number;
+			lagNullableColWithDefault: number;
+			leadNullable: string | null;
+			leadWithOffsetNullable: string | null;
+			leadWithDefaultNonNull: string;
+			leadNullableColWithDefault: number;
+			fv: number | null;
+			lv: string | null;
+			nv: number | null;
+			sumVal: string | null;
+			avgVal: string | null;
+			minVal: number | null;
+			maxVal: string | null;
+			cntAll: number;
+			cntCol: number;
+		}[],
+		typeof result
+	>
+>;
