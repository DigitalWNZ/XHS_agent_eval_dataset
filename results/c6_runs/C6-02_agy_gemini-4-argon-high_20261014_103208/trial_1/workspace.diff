+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { Equal, ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import {
+	type DriverValueDecoder,
+	type Name,
+	noopDecoder,
+	SQL,
+	sql,
+	type SQLChunk,
+	type SQLWrapper,
+} from '../sql.ts';
+
+export type WindowBoundaryKind =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+const BOUNDARY_ORDER: Record<WindowBoundaryKind, number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly kind: WindowBoundaryKind,
+		readonly offset?: number,
+	) {}
+
+	getSQL(): SQL {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return sql`unbounded preceding`;
+			}
+			case 'preceding': {
+				return sql`${sql.raw(String(this.offset))} preceding`;
+			}
+			case 'currentRow': {
+				return sql`current row`;
+			}
+			case 'following': {
+				return sql`${sql.raw(String(this.offset))} following`;
+			}
+			case 'unboundedFollowing': {
+				return sql`unbounded following`;
+			}
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary('unboundedPreceding');
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary('currentRow');
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary('unboundedFollowing');
+
+export function preceding(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() requires a non-negative integer argument, received ${offset}`);
+	}
+	return new WindowFrameBoundary('preceding', offset);
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() requires a non-negative integer argument, received ${offset}`);
+	}
+	return new WindowFrameBoundary('following', offset);
+}
+
+export type WindowFrameMode = 'rows' | 'range';
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+function validateFrameSpec(spec: WindowFrameSpec): void {
+	const { from, to } = spec;
+	const fromOrder = BOUNDARY_ORDER[from.kind];
+	const toOrder = BOUNDARY_ORDER[to.kind];
+
+	if (fromOrder > toOrder) {
+		throw new Error(
+			'Invalid window frame: "from" boundary cannot be ordered after "to" boundary',
+		);
+	}
+
+	if (
+		from.kind === 'preceding'
+		&& to.kind === 'preceding'
+		&& from.offset !== undefined
+		&& to.offset !== undefined
+		&& from.offset < to.offset
+	) {
+		throw new Error(
+			'Invalid window frame: "from" boundary cannot be ordered after "to" boundary',
+		);
+	}
+
+	if (
+		from.kind === 'following'
+		&& to.kind === 'following'
+		&& from.offset !== undefined
+		&& to.offset !== undefined
+		&& from.offset > to.offset
+	) {
+		throw new Error(
+			'Invalid window frame: "from" boundary cannot be ordered after "to" boundary',
+		);
+	}
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		readonly from: WindowFrameBoundary,
+		readonly to: WindowFrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(this.mode)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	validateFrameSpec(spec);
+	return new WindowFrame('rows', spec.from, spec.to);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	validateFrameSpec(spec);
+	return new WindowFrame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export type WindowOverSpec = WindowSpec;
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not be whitespace-only');
+	}
+}
+
+export function buildWindowSpec(spec?: WindowOverSpec): SQL {
+	if (!spec) {
+		return sql`()`;
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionByArray = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByArray.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderByArray = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByArray.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		parts.push(spec.frame.getSQL());
+	}
+
+	if (parts.length === 0) {
+		return sql`()`;
+	}
+
+	return sql`(${sql.join(parts, sql` `)})`;
+}
+
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder:
+			| DriverValueDecoder<T, any>
+			| DriverValueDecoder<T, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(spec?: WindowOverSpec | string): SQL<T> {
+		let overClause: SQL | Name;
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			overClause = sql.identifier(spec);
+		} else {
+			overClause = buildWindowSpec(spec);
+		}
+		return sql`${this.fnSql} over ${overClause}`.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type GetWindowExprData<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+export type StripNull<T> = Equal<T, unknown> extends true ? unknown : Exclude<T, null | undefined>;
+
+type GetWindowMinMaxData<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? Equal<U, unknown> extends true ? string : U
+	: T extends SQL.Aliased<infer U> ? Equal<U, unknown> extends true ? string : U
+	: string;
+
+function extractDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`, Number);
+}
+
+export function ntile(buckets: number): WindowFunctionBuilder<number> {
+	if (typeof buckets !== 'number' || !Number.isInteger(buckets) || buckets < 1) {
+		throw new Error(`ntile() requires a positive integer argument, received ${buckets}`);
+	}
+	return new WindowFunctionBuilder(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`cume_dist()`, Number);
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<GetWindowExprData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: StripNull<GetWindowExprData<T>> | SQLWrapper,
+): WindowFunctionBuilder<StripNull<GetWindowExprData<T>>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	let fnSql: SQL;
+	if (defaultValue !== undefined) {
+		const offsetChunk: SQLChunk = offset === undefined ? sql.raw('1') : sql.raw(String(offset));
+		const defaultChunk: SQLChunk = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: bindIfParam(defaultValue, expression);
+		fnSql = sql`lag(${expression}, ${offsetChunk}, ${defaultChunk})`;
+	} else if (offset === undefined) {
+		fnSql = sql`lag(${expression})`;
+	} else {
+		fnSql = sql`lag(${expression}, ${sql.raw(String(offset))})`;
+	}
+	return new WindowFunctionBuilder(fnSql, extractDecoder(expression));
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<GetWindowExprData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: StripNull<GetWindowExprData<T>> | SQLWrapper,
+): WindowFunctionBuilder<StripNull<GetWindowExprData<T>>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	let fnSql: SQL;
+	if (defaultValue !== undefined) {
+		const offsetChunk: SQLChunk = offset === undefined ? sql.raw('1') : sql.raw(String(offset));
+		const defaultChunk: SQLChunk = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue))
+			: bindIfParam(defaultValue, expression);
+		fnSql = sql`lead(${expression}, ${offsetChunk}, ${defaultChunk})`;
+	} else if (offset === undefined) {
+		fnSql = sql`lead(${expression})`;
+	} else {
+		fnSql = sql`lead(${expression}, ${sql.raw(String(offset))})`;
+	}
+	return new WindowFunctionBuilder(fnSql, extractDecoder(expression));
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetWindowExprData<T> | null> {
+	return new WindowFunctionBuilder(sql`first_value(${expression})`, extractDecoder(expression));
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetWindowExprData<T> | null> {
+	return new WindowFunctionBuilder(sql`last_value(${expression})`, extractDecoder(expression));
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<GetWindowExprData<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() requires a positive integer argument, received ${n}`);
+	}
+	return new WindowFunctionBuilder(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		extractDecoder(expression),
+	);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetWindowMinMaxData<T> | null> {
+	return new WindowFunctionBuilder<GetWindowMinMaxData<T> | null>(
+		sql`min(${expression})`,
+		(is(expression, Column) ? expression : String) as any,
+	);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<GetWindowMinMaxData<T> | null> {
+	return new WindowFunctionBuilder<GetWindowMinMaxData<T> | null>(
+		sql`max(${expression})`,
+		(is(expression, Column) ? expression : String) as any,
+	);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(
+		sql`count(${expression ?? sql.raw('*')})`,
+		Number,
+	);
+}
