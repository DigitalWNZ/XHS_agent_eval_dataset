new file mode 100644
index 00000000..c790262c
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,361 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { type DriverValueDecoder, noopDecoder, SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export type WindowFrameBoundaryType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+const boundaryOrder: Record<WindowFrameBoundaryType, number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly type: WindowFrameBoundaryType,
+		readonly offset?: number,
+	) {}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		switch (this.type) {
+			case 'unboundedPreceding': {
+				return sql.raw('unbounded preceding');
+			}
+			case 'preceding': {
+				return sql.raw(`${this.offset} preceding`);
+			}
+			case 'currentRow': {
+				return sql.raw('current row');
+			}
+			case 'following': {
+				return sql.raw(`${this.offset} following`);
+			}
+			case 'unboundedFollowing': {
+				return sql.raw('unbounded following');
+			}
+		}
+	}
+}
+
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary('unboundedPreceding');
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary('currentRow');
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary('unboundedFollowing');
+
+function validateFrameOffset(fnName: string, offset: number): void {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`${fnName}() requires a non-negative integer argument, received ${offset}`);
+	}
+}
+
+export function preceding(offset: number): WindowFrameBoundary {
+	validateFrameOffset('preceding', offset);
+	return new WindowFrameBoundary('preceding', offset);
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	validateFrameOffset('following', offset);
+	return new WindowFrameBoundary('following', offset);
+}
+
+export type WindowFrameMode = 'rows' | 'range';
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+function validateFrameBounds(from: WindowFrameBoundary, to: WindowFrameBoundary): void {
+	const fromOrder = boundaryOrder[from.type];
+	const toOrder = boundaryOrder[to.type];
+	if (
+		fromOrder > toOrder
+		|| (from.type === 'preceding' && to.type === 'preceding' && from.offset! < to.offset!)
+		|| (from.type === 'following' && to.type === 'following' && from.offset! > to.offset!)
+	) {
+		throw new Error('Invalid window frame: "from" boundary cannot be ordered after "to" boundary');
+	}
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	readonly from: WindowFrameBoundary;
+	readonly to: WindowFrameBoundary;
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		spec: WindowFrameSpec,
+	) {
+		validateFrameBounds(spec.from, spec.to);
+		this.from = spec.from;
+		this.to = spec.to;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(this.mode)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return new WindowFrame('rows', spec);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return new WindowFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot be whitespace-only');
+	}
+}
+
+export function buildWindowSpec(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitions = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitions.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitions, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orders = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orders.length > 0) {
+			parts.push(sql`order by ${sql.join(orders, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		parts.push(spec.frame.getSQL());
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder:
+			| DriverValueDecoder<any, any>
+			| DriverValueDecoder<any, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		if (typeof spec === 'string') {
+			validateWindowName(spec);
+			return sql`${this.fnSql} over ${sql.identifier(spec)}`.mapWith(this.decoder) as SQL<T>;
+		}
+
+		return sql`${this.fnSql} over (${buildWindowSpec(spec)})`.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type GetWindowValueType<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> | SQL.Aliased<infer U> ? U
+	: unknown;
+
+function validatePositiveInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 1) {
+		throw new Error(`${fnName}() requires a positive integer argument, received ${value}`);
+	}
+}
+
+function getExpressionDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return noopDecoder;
+}
+
+function formatPositionalArg(arg: unknown): SQLChunk {
+	if (typeof arg === 'number') {
+		return sql.raw(String(arg));
+	}
+	if (arg === null) {
+		return sql.raw('null');
+	}
+	return arg as SQLChunk;
+}
+
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+export function ntile(buckets: number): WindowFunction<number> {
+	validatePositiveInteger('ntile', buckets);
+	return new WindowFunction(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowValueType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<GetWindowValueType<T>> | SQLWrapper,
+): WindowFunction<NonNullable<GetWindowValueType<T>>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: GetWindowValueType<T> | SQLWrapper | null,
+): WindowFunction<GetWindowValueType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const args: SQLChunk[] = [expression];
+	if (defaultValue !== undefined) {
+		args.push(formatPositionalArg(offset ?? 1), formatPositionalArg(defaultValue));
+	} else if (offset !== undefined) {
+		args.push(formatPositionalArg(offset));
+	}
+	return new WindowFunction(sql`lag(${sql.join(args, sql`, `)})`, getExpressionDecoder(expression));
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<GetWindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<GetWindowValueType<T>> | SQLWrapper,
+): WindowFunction<NonNullable<GetWindowValueType<T>>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: GetWindowValueType<T> | SQLWrapper | null,
+): WindowFunction<GetWindowValueType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	const args: SQLChunk[] = [expression];
+	if (defaultValue !== undefined) {
+		args.push(formatPositionalArg(offset ?? 1), formatPositionalArg(defaultValue));
+	} else if (offset !== undefined) {
+		args.push(formatPositionalArg(offset));
+	}
+	return new WindowFunction(sql`lead(${sql.join(args, sql`, `)})`, getExpressionDecoder(expression));
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowValueType<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, getExpressionDecoder(expression));
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowValueType<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, getExpressionDecoder(expression));
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<GetWindowValueType<T> | null> {
+	validatePositiveInteger('nthValue', n);
+	return new WindowFunction(sql`nth_value(${expression}, ${sql.raw(String(n))})`, getExpressionDecoder(expression));
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<
+	(T extends AnyColumn ? T['_']['data'] : T extends SQL<infer U> | SQL.Aliased<infer U> ? U : string) | null
+> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : String);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<
+	(T extends AnyColumn ? T['_']['data'] : T extends SQL<infer U> | SQL.Aliased<infer U> ? U : string) | null
+> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : String);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression || sql.raw('*')})`, Number);
+}
