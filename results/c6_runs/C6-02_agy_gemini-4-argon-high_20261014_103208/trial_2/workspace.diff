new file mode 100644
index 00000000..6221132b
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,416 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import {
+	type DriverValueDecoder,
+	isSQLWrapper,
+	noopDecoder,
+	SQL,
+	sql,
+	type SQLChunk,
+	type SQLWrapper,
+} from '../sql.ts';
+
+export type WindowFrameBoundaryType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly type: WindowFrameBoundaryType,
+		readonly offset?: number,
+	) {}
+
+	/** @internal */
+	getOrderPosition(): { category: number; sub: number } {
+		switch (this.type) {
+			case 'unboundedPreceding': {
+				return { category: 0, sub: 0 };
+			}
+			case 'preceding': {
+				return { category: 1, sub: -(this.offset ?? 0) };
+			}
+			case 'currentRow': {
+				return { category: 2, sub: 0 };
+			}
+			case 'following': {
+				return { category: 3, sub: this.offset ?? 0 };
+			}
+			case 'unboundedFollowing': {
+				return { category: 4, sub: 0 };
+			}
+		}
+	}
+
+	getSQL(): SQL {
+		switch (this.type) {
+			case 'unboundedPreceding': {
+				return sql`unbounded preceding`;
+			}
+			case 'preceding': {
+				return sql`${sql.raw(String(this.offset))} preceding`;
+			}
+			case 'currentRow': {
+				return sql`current row`;
+			}
+			case 'following': {
+				return sql`${sql.raw(String(this.offset))} following`;
+			}
+			case 'unboundedFollowing': {
+				return sql`unbounded following`;
+			}
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding = new WindowFrameBoundary('unboundedPreceding');
+export const currentRow = new WindowFrameBoundary('currentRow');
+export const unboundedFollowing = new WindowFrameBoundary('unboundedFollowing');
+
+export function preceding(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() requires a non-negative integer, received ${offset}`);
+	}
+	return new WindowFrameBoundary('preceding', offset === 0 ? 0 : offset);
+}
+
+export function following(offset: number): WindowFrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() requires a non-negative integer, received ${offset}`);
+	}
+	return new WindowFrameBoundary('following', offset === 0 ? 0 : offset);
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+}
+
+export type WindowFrameMode = 'rows' | 'range';
+
+function validateFrameBounds(mode: WindowFrameMode, spec: WindowFrameSpec): void {
+	const { from, to } = spec;
+	const fromPos = from.getOrderPosition();
+	const toPos = to.getOrderPosition();
+
+	if (
+		from.type === 'unboundedFollowing'
+		|| to.type === 'unboundedPreceding'
+		|| fromPos.category > toPos.category
+		|| (fromPos.category === toPos.category && fromPos.sub > toPos.sub)
+	) {
+		throw new Error(
+			`${mode}(): "from" boundary cannot be ordered after "to" boundary`,
+		);
+	}
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: WindowFrameMode,
+		readonly from: WindowFrameBoundary,
+		readonly to: WindowFrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		return sql`${sql.raw(this.mode)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	validateFrameBounds('rows', spec);
+	return new WindowFrame('rows', spec.from, spec.to);
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	validateFrameBounds('range', spec);
+	return new WindowFrame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	orderBy?: ValueOrArray<AnyColumn | SQL | SQL.Aliased | SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot contain only whitespace');
+	}
+}
+
+export function buildWindowSpec(spec?: WindowSpec): SQL {
+	if (!spec) {
+		return sql`()`;
+	}
+
+	const clauses: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionByArray = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByArray.length > 0) {
+			clauses.push(sql`partition by ${sql.join(partitionByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderByArray = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByArray.length > 0) {
+			clauses.push(sql`order by ${sql.join(orderByArray, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		clauses.push(spec.frame.getSQL());
+	}
+
+	if (clauses.length === 0) {
+		return sql`()`;
+	}
+
+	return sql`(${sql.join(clauses, sql` `)})`;
+}
+
+export function buildWindowClause(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	const definitions = windows.map(({ name, spec }) => sql`${sql.identifier(name)} as ${buildWindowSpec(spec)}`);
+	return sql` window ${sql.join(definitions, sql`, `)}`;
+}
+
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare _: {
+		type: T;
+	};
+
+	constructor(
+		private readonly fnSql: SQL,
+		private readonly decoder:
+			| DriverValueDecoder<any, any>
+			| DriverValueDecoder<any, any>['mapFromDriverValue'] = noopDecoder,
+	) {}
+
+	over(specOrName?: WindowSpec | string): SQL<T> {
+		if (typeof specOrName === 'string') {
+			validateWindowName(specOrName);
+			return sql`${this.fnSql} over ${sql.identifier(specOrName)}`.mapWith(this.decoder) as SQL<T>;
+		}
+		return sql`${this.fnSql} over ${buildWindowSpec(specOrName)}`.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+export type WindowExpressionData<T extends SQLWrapper, TFallback = unknown> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? unknown extends U ? TFallback : U
+	: T extends SQL.Aliased<infer U> ? unknown extends U ? TFallback : U
+	: TFallback;
+
+function getExpressionDecoder(
+	expression: SQLWrapper,
+	fallback: DriverValueDecoder<any, any> | DriverValueDecoder<any, any>['mapFromDriverValue'] = noopDecoder,
+): DriverValueDecoder<any, any> | DriverValueDecoder<any, any>['mapFromDriverValue'] {
+	if (is(expression, Column)) {
+		return expression;
+	}
+	if (is(expression, SQL)) {
+		return expression.decoder;
+	}
+	if (is(expression, SQL.Aliased)) {
+		return expression.sql.decoder;
+	}
+	return fallback;
+}
+
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+export function ntile(buckets: number): WindowFunction<number> {
+	if (typeof buckets !== 'number' || !Number.isInteger(buckets) || buckets < 1) {
+		throw new Error(`ntile() requires a positive integer, received ${buckets}`);
+	}
+	return new WindowFunction(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+function buildOffsetFunctionSql(
+	fnName: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): SQL {
+	if (defaultValue !== undefined) {
+		const normalizedOffset = offset === 0 ? 0 : (offset ?? 1);
+		const offsetSql = sql.raw(String(normalizedOffset));
+		const defaultChunk: SQLChunk = typeof defaultValue === 'number'
+			? sql.raw(String(defaultValue === 0 ? 0 : defaultValue))
+			: defaultValue === null
+			? sql.raw('null')
+			: isSQLWrapper(defaultValue)
+			? defaultValue
+			: bindIfParam(defaultValue, expression);
+		return sql`${sql.raw(fnName)}(${expression}, ${offsetSql}, ${defaultChunk})`;
+	}
+	if (offset !== undefined) {
+		const normalizedOffset = offset === 0 ? 0 : offset;
+		return sql`${sql.raw(fnName)}(${expression}, ${sql.raw(String(normalizedOffset))})`;
+	}
+	return sql`${sql.raw(fnName)}(${expression})`;
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<WindowExpressionData<T> | null>;
+export function lag<
+	T extends SQLWrapper,
+	TDefault extends WindowExpressionData<T> | SQLWrapper | null | undefined,
+>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	undefined extends TDefault ? WindowExpressionData<T> | null
+		: null extends TDefault ? WindowExpressionData<T> | null
+		: Exclude<WindowExpressionData<T>, null>
+>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	return new WindowFunction(
+		buildOffsetFunctionSql('lag', expression, offset, defaultValue),
+		getExpressionDecoder(expression),
+	);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<WindowExpressionData<T> | null>;
+export function lead<
+	T extends SQLWrapper,
+	TDefault extends WindowExpressionData<T> | SQLWrapper | null | undefined,
+>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	undefined extends TDefault ? WindowExpressionData<T> | null
+		: null extends TDefault ? WindowExpressionData<T> | null
+		: Exclude<WindowExpressionData<T>, null>
+>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunction<any> {
+	return new WindowFunction(
+		buildOffsetFunctionSql('lead', expression, offset, defaultValue),
+		getExpressionDecoder(expression),
+	);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<WindowExpressionData<T> | null> {
+	return new WindowFunction(
+		sql`first_value(${expression})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<WindowExpressionData<T> | null> {
+	return new WindowFunction(
+		sql`last_value(${expression})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<WindowExpressionData<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n < 1) {
+		throw new Error(`nthValue() requires a positive integer, received ${n}`);
+	}
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`,
+		getExpressionDecoder(expression),
+	);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<WindowExpressionData<T, string> | null> {
+	return new WindowFunction(
+		sql`min(${expression})`,
+		getExpressionDecoder(expression, String),
+	);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<WindowExpressionData<T, string> | null> {
+	return new WindowFunction(
+		sql`max(${expression})`,
+		getExpressionDecoder(expression, String),
+	);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression || sql.raw('*')})`, Number);
+}
