@@ -0,0 +1,31 @@
+import asyncio
+import inspect
+from typing import Callable, Awaitable, List
+
+async def run_tasks(tasks: List[Callable[[], Awaitable[None]]], max_concurrent: int) -> None:
+    """
+    Run a list of async tasks with a maximum concurrency limit.
+
+    :param tasks: List of zero-argument callables that return an awaitable (or awaitable objects).
+    :param max_concurrent: Maximum number of tasks that can run concurrently.
+    """
+    if max_concurrent <= 0:
+        raise ValueError("max_concurrent must be greater than 0")
+    if not tasks:
+        return
+
+    it = iter(tasks)
+
+    async def worker() -> None:
+        for item in it:
+            if inspect.isawaitable(item):
+                await item
+            elif callable(item):
+                res = item()
+                if inspect.isawaitable(res):
+                    await res
+
+    num_workers = min(max_concurrent, len(tasks))
+    async with asyncio.TaskGroup() as tg:
+        for _ in range(num_workers):
+            tg.create_task(worker())
