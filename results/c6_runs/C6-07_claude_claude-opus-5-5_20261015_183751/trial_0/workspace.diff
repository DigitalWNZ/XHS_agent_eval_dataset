+/**
+ * Merges a persisted query state into an existing one.
+ * Data freshness and error freshness are reconciled independently,
+ * so newer data is never discarded in favour of a newer error (and vice versa).
+ */
+function mergeQueryStates(
+  existingState: QueryState,
+  persistedState: QueryState,
+): Partial<QueryState> {
+  const dataState =
+    persistedState.data !== undefined &&
+    (existingState.data === undefined ||
+      persistedState.dataUpdatedAt > existingState.dataUpdatedAt)
+      ? persistedState
+      : existingState
+  const errorState =
+    persistedState.errorUpdatedAt > existingState.errorUpdatedAt
+      ? persistedState
+      : existingState
+
+  const hasError = errorState.error != null && errorState.status === 'error'
+  const status = hasError
+    ? 'error'
+    : dataState.data !== undefined
+      ? 'success'
+      : existingState.status
+
+  return {
+    data: dataState.data,
+    dataUpdatedAt: dataState.dataUpdatedAt,
+    dataUpdateCount: Math.max(
+      existingState.dataUpdateCount,
+      persistedState.dataUpdateCount,
+    ),
+    error: hasError ? errorState.error : null,
+    errorUpdatedAt: errorState.errorUpdatedAt,
+    errorUpdateCount: Math.max(
+      existingState.errorUpdateCount,
+      persistedState.errorUpdateCount,
+    ),
+    fetchFailureCount: errorState.fetchFailureCount,
+    fetchFailureReason: errorState.fetchFailureReason,
+    isInvalidated: dataState.isInvalidated || hasError,
+    status,
+  }
+}
