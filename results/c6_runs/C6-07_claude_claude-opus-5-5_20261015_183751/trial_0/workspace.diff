+export const persisterRestoreResultKey: unique symbol = Symbol(
+  'tanstack-query-persister-restore',
+)
+
+export interface PersisterRestoreResult<TData = unknown, TError = unknown> {
+  readonly [persisterRestoreResultKey]: true
+  data: TData | undefined
+  state: Partial<QueryState<TData, TError>>
+}
+
+/**
+ * Creates a value that can be returned from a `persister` to signal that a
+ * persisted query snapshot was restored instead of freshly fetched.
+ * The provided `state` will be adopted as the query state as-is,
+ * instead of being converted into a regular successful fetch.
+ */
+export function createPersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+>(snapshot: {
+  data: TData | undefined
+  state: Partial<QueryState<TData, TError>>
+}): PersisterRestoreResult<TData, TError> {
+  return {
+    [persisterRestoreResultKey]: true,
+    data: snapshot.data,
+    state: snapshot.state,
+  }
+}
+
+export function isPersisterRestoreResult(
+  value: unknown,
+): value is PersisterRestoreResult<unknown, unknown> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as any)[persisterRestoreResultKey] === true
+  )
+}
