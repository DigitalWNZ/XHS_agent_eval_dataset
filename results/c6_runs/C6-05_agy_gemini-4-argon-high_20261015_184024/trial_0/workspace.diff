+int main(int argc, char **argv) {
+    if (argc < 2) return 1;
+    int n = atoi(argv[1]);
+    if (n <= 0) {
+        printf("0\n");
+        return 0;
+    }
+    int cap = n + 2;
+    unsigned char *a = (unsigned char *)calloc(cap, 1);
+    unsigned char *b = (unsigned char *)calloc(cap, 1);
+    a[0] = 0;
+    b[0] = 1;
+    int len = 1;
+    for (int i = 1; i < n; i++) {
+        int carry = 0;
+        for (int j = 0; j < len; j++) {
+            int sum = a[j] + b[j] + carry;
+            a[j] = b[j];
+            b[j] = sum % 10;
+            carry = sum / 10;
+        }
+        if (carry) {
+            b[len++] = carry;
+        }
+    }
+    for (int j = len - 1; j >= 0; j--) {
+        putchar('0' + b[j]);
+    }
+    putchar('\n');
+    free(a);
+    free(b);
+    return 0;
+}
