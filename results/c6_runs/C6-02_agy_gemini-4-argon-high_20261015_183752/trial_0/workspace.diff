+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Before any commits, stats are all zero.
+	initStats := d.DurabilityStats()
+	require.Equal(t, DurabilityStats{}, initStats)
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+
+	// WaitForDurabilityBatch on nil or empty slice returns nil immediately.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commits, and succeeds after the first Sync commit.
+	waitZeroErr := make(chan error, 1)
+	go func() {
+		waitZeroErr <- d.WaitForDurability(0)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	require.NoError(t, <-waitZeroErr)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Waiting on an already-durable seqNum or 0 returns immediately.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(seq1))
+
+	// Non-sync commits allocate sequence numbers that are not yet durable.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, d.Apply(b2, NoSync))
+	seq2 := b2.SeqNum()
+	require.NoError(t, b2.Close())
+
+	b3 := d.NewBatch()
+	require.NoError(t, b3.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, d.Apply(b3, NoSync))
+	seq3 := b3.SeqNum()
+	require.NoError(t, b3.Close())
+
+	batchWaitErr := make(chan error, 1)
+	go func() {
+		batchWaitErr <- d.WaitForDurabilityBatch([]base.SeqNum{seq1, seq2, seq3})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+
+	// Now perform a Sync commit; it makes seq2 and seq3 durable as well.
+	require.NoError(t, d.Set([]byte("k4"), []byte("v4"), Sync))
+	require.NoError(t, <-batchWaitErr)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
