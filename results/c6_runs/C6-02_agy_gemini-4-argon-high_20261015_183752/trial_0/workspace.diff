+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Subscribe to seqNum 0 before any commit.
+	ch0 := d.DurabilityNotify(0)
+	select {
+	case <-ch0:
+		t.Fatal("expected ch0 not to be ready before any commit")
+	default:
+	}
+
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+
+	require.NoError(t, <-ch0)
+
+	// Already durable seqNum returns a pre-filled channel with nil.
+	chAlready := d.DurabilityNotify(seq1)
+	require.Equal(t, 1, len(chAlready))
+	require.NoError(t, <-chAlready)
+
+	// Bound on outstanding subscriptions: fill up maxDurabilityNotifySubscriptions.
+	futureSeq := seq1 + 1000
+	subs := make([]<-chan error, 0, maxDurabilityNotifySubscriptions)
+	for i := 0; i < maxDurabilityNotifySubscriptions; i++ {
+		ch := d.DurabilityNotify(futureSeq)
+		require.Equal(t, 0, len(ch))
+		subs = append(subs, ch)
+	}
+
+	// Excess caller gets a pre-filled channel with an immediate non-nil error.
+	excessCh := d.DurabilityNotify(futureSeq)
+	require.Equal(t, 1, len(excessCh))
+	require.Error(t, <-excessCh)
+
+	// Closing the DB delivers a non-nil error to all outstanding subscriptions.
+	require.NoError(t, d.Close())
+	d = nil
+	for _, ch := range subs {
+		require.Error(t, <-ch)
+	}
+}
+
+func TestDurabilityContextAndErrorPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var failSync atomic.Bool
+	injectedErr := errors.New("injected sync error")
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if failSync.Load() {
+				return injectedErr
+			}
+			return nil
+		},
+	}
+
+	d, err := Open("", &Options{FS: fs})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// Context cancellation when no durability/close error exists returns ctx.Err().
+	ctx, cancel := context.WithCancel(context.Background())
+	waitErrCh := make(chan error, 1)
+	go func() {
+		waitErrCh <- d.WaitForDurabilityContext(ctx, 500)
+	}()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, time.Millisecond)
+	cancel()
+	require.ErrorIs(t, <-waitErrCh, context.Canceled)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Now trigger a WAL sync error and verify it takes precedence over a cancelled context.
+	failSync.Store(true)
+	err = d.Set([]byte("k"), []byte("v"), Sync)
+	require.ErrorIs(t, err, injectedErr)
+
+	cancelledCtx, cancel2 := context.WithCancel(context.Background())
+	cancel2()
+
+	err = d.WaitForDurabilityContext(cancelledCtx, 10)
+	require.ErrorIs(t, err, injectedErr)
+
+	err = d.WaitForDurabilityBatchContext(cancelledCtx, []base.SeqNum{10})
+	require.ErrorIs(t, err, injectedErr)
+
+	err = d.WaitForJobDurabilityContext(cancelledCtx, 1)
+	require.ErrorIs(t, err, injectedErr)
+}
+
+func TestDurabilityDisableWALAndClose(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	// 1. DisableWAL: wait APIs and DurabilityNotify return nil immediately, BatchDurable never fires.
+	var callbackFired atomic.Bool
+	dNoWAL, err := Open("", &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				callbackFired.Store(true)
+			},
+		},
+	})
+	require.NoError(t, err)
+	require.NoError(t, dNoWAL.Set([]byte("k1"), []byte("v1"), NoSync))
+	require.False(t, callbackFired.Load())
+
+	require.NoError(t, dNoWAL.WaitForDurability(0))
+	require.NoError(t, dNoWAL.WaitForDurability(9999))
+	require.NoError(t, dNoWAL.WaitForDurabilityBatch([]base.SeqNum{1, 2, 9999}))
+	require.NoError(t, dNoWAL.WaitForJobDurability(0))
+	require.NoError(t, dNoWAL.WaitForJobDurability(123))
+	notifyCh := dNoWAL.DurabilityNotify(9999)
+	require.Equal(t, 1, len(notifyCh))
+	require.NoError(t, <-notifyCh)
+	require.NoError(t, dNoWAL.Close())
+
+	// 2. DB Close unblocks all blocked waiters with error.
+	syncEntered := make(chan struct{})
+	releaseSync := make(chan struct{})
+	var syncOnce sync.Once
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			syncOnce.Do(func() {
+				close(syncEntered)
+				<-releaseSync
+			})
+			return nil
+		},
+	}
+
+	dClose, err := Open("", &Options{FS: fs})
+	require.NoError(t, err)
+
+	// Start an ApplyNoSyncWait so jobID 1 is in-flight while we block WAL sync.
+	b := dClose.NewBatch()
+	require.NoError(t, b.Set([]byte("a"), []byte("b"), nil))
+	require.NoError(t, dClose.ApplyNoSyncWait(b, Sync))
+	<-syncEntered
+
+	seqWaitCh := make(chan error, 1)
+	batchWaitCh := make(chan error, 1)
+	jobWaitCh := make(chan error, 1)
+	notifySub := dClose.DurabilityNotify(b.SeqNum() + 100)
+
+	go func() {
+		seqWaitCh <- dClose.WaitForDurability(b.SeqNum() + 100)
+	}()
+	go func() {
+		batchWaitCh <- dClose.WaitForDurabilityBatch([]base.SeqNum{b.SeqNum() + 100})
+	}()
+	go func() {
+		jobWaitCh <- dClose.WaitForJobDurability(1)
+	}()
+
+	require.Eventually(t, func() bool {
+		return dClose.DurabilityStats().PendingWaiters == 3
+	}, 2*time.Second, time.Millisecond)
+
+	closeDone := make(chan error, 1)
+	go func() {
+		close(releaseSync)
+		_ = b.SyncWait()
+		_ = b.Close()
+		closeDone <- dClose.Close()
+	}()
+
+	require.Error(t, <-seqWaitCh)
+	require.Error(t, <-batchWaitCh)
+	require.Error(t, <-notifySub)
+	require.NoError(t, <-closeDone)
+	// jobWaitCh either completed when releaseSync was closed or returned ErrClosed;
+	// verify that a new WaitForJobDurability after Close returns an error and take
+	// precedence over context cancellation.
+	<-jobWaitCh
+
+	cancelledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, dClose.WaitForDurabilityContext(cancelledCtx, 0), ErrClosed)
+	require.ErrorIs(t, dClose.WaitForJobDurabilityContext(cancelledCtx, 1), ErrClosed)
+}
+
+func TestDurabilityStatsAndConcurrentWaiters(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var syncDelay atomic.Int64
+	var syncErr atomic.Pointer[error]
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if d := time.Duration(syncDelay.Load()); d > 0 {
+				time.Sleep(d)
+			}
+			if ep := syncErr.Load(); ep != nil && *ep != nil {
+				return *ep
+			}
+			return nil
+		},
+	}
+
+	d, err := Open("", &Options{FS: fs})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// Commit 1 with ~5ms sync delay.
+	syncDelay.Store(int64(5 * time.Millisecond))
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	stats1 := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats1.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats1.TotalFailedCommits)
+	require.Greater(t, stats1.CumulativeSyncDuration, time.Duration(0))
+	require.Equal(t, stats1.CumulativeSyncDuration, stats1.MaxSyncDuration)
+
+	// Commit 2 with ~20ms sync delay.
+	syncDelay.Store(int64(20 * time.Millisecond))
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	stats2 := d.DurabilityStats()
+	require.Equal(t, uint64(2), stats2.TotalDurableCommits)
+	require.Greater(t, stats2.CumulativeSyncDuration, stats1.CumulativeSyncDuration)
+	require.Greater(t, stats2.MaxSyncDuration, stats1.MaxSyncDuration)
+	require.Less(t, stats2.MaxSyncDuration, stats2.CumulativeSyncDuration)
+	syncDelay.Store(0)
+
+	// Concurrent writers and waiters.
+	const numWorkers = 8
+	var wg sync.WaitGroup
+	for w := 0; w < numWorkers; w++ {
+		wg.Add(2)
+		go func(id int) {
+			defer wg.Done()
+			b := d.NewBatch()
+			_ = b.Set([]byte("cw"), []byte("val"), nil)
+			if err := d.Apply(b, &WriteOptions{Sync: true, CommitCorrelationID: uint64(id + 1)}); err == nil {
+				seq := b.SeqNum()
+				_ = d.WaitForDurability(seq)
+			}
+			_ = b.Close()
+		}(w)
+		go func() {
+			defer wg.Done()
+			seq, _ := d.DurableState()
+			ch := d.DurabilityNotify(seq)
+			_ = <-ch
+		}()
+	}
+	wg.Wait()
+
+	statsAfter := d.DurabilityStats()
+	require.Equal(t, uint64(2+numWorkers), statsAfter.TotalDurableCommits)
+	require.Equal(t, int64(0), statsAfter.PendingWaiters)
+
+	// Verify FirstErr latches the first error across multiple failures.
+	errFirst := errors.New("first sync error")
+	errSecond := errors.New("second sync error")
+	syncErr.Store(&errFirst)
+	require.ErrorIs(t, d.Set([]byte("f1"), []byte("v"), Sync), errFirst)
+
+	syncErr.Store(&errSecond)
+	require.Error(t, d.Set([]byte("f2"), []byte("v"), Sync))
+
+	_, latched := d.DurableState()
+	require.ErrorIs(t, latched, errFirst)
+	finalStats := d.DurabilityStats()
+	require.ErrorIs(t, finalStats.FirstErr, errFirst)
+	require.Equal(t, uint64(2), finalStats.TotalFailedCommits)
+}
