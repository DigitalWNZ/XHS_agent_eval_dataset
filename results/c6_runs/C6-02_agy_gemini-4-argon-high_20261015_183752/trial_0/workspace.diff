+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var jobIDs []int
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				jobIDs = append(jobIDs, info.JobID)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Zero, negative, and never-seen job IDs return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	err = d.WaitForJobDurability(9999)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Perform enough Sync commits to exceed the bounded retention window.
+	totalCommits := maxRetainedDurabilityJobs + 20
+	for i := 0; i < totalCommits; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	mu.Lock()
+	require.Len(t, jobIDs, totalCommits)
+	firstJobID := jobIDs[0]
+	recentJobID := jobIDs[len(jobIDs)-1]
+	mu.Unlock()
+
+	// Evicted job ID gets an "expired" error.
+	err = d.WaitForJobDurability(firstJobID)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "expired")
+
+	// Recent job ID within the retention window succeeds.
+	require.NoError(t, d.WaitForJobDurability(recentJobID))
+
+	// Never-seen future job ID still gets an "unknown" error.
+	err = d.WaitForJobDurability(recentJobID + 100)
+	require.Error(t, err)
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+}
