index 00000000..74cb47cf
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,763 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxRetainedDurabilityJobs bounds the number of completed durability job
+	// records kept for WaitForJobDurability before older IDs expire.
+	maxRetainedDurabilityJobs = 128
+
+	// maxDurabilityNotifySubscriptions bounds the number of concurrently active
+	// DurabilityNotify channel subscriptions.
+	maxDurabilityNotifySubscriptions = 128
+)
+
+var (
+	// ErrDurabilityJobUnknown is returned when waiting on a zero, negative, or
+	// never-seen durability job ID.
+	ErrDurabilityJobUnknown = errors.New("pebble: unknown durability job ID")
+
+	// ErrDurabilityJobExpired is returned when waiting on a durability job ID
+	// that has been evicted from the bounded retention window.
+	ErrDurabilityJobExpired = errors.New("pebble: durability job ID has expired")
+
+	// ErrDurabilityNotifyLimitExceeded is delivered on the channel returned by
+	// DurabilityNotify when the bound on outstanding subscriptions is exceeded.
+	ErrDurabilityNotifyLimitExceeded = errors.New("pebble: durability notify subscription limit exceeded")
+)
+
+// DurabilityStats holds a point-in-time snapshot of durability tracking metrics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilitySeqWaiter struct {
+	targetSeqNum base.SeqNum
+	ch           chan struct{}
+	err          error
+	removed      bool
+}
+
+type durabilityJobWaiter struct {
+	jobID   int
+	ch      chan struct{}
+	err     error
+	removed bool
+}
+
+type durabilityJobState struct {
+	jobID   int
+	done    bool
+	err     error
+	waiters []*durabilityJobWaiter
+}
+
+type durabilityNotifySub struct {
+	targetSeqNum base.SeqNum
+	ch           chan error
+}
+
+type pendingAsyncSyncCommit struct {
+	db            *DB
+	batch         *Batch
+	jobID         int
+	seqNum        base.SeqNum
+	correlationID uint64
+	batchSize     int
+	keyCount      uint32
+	applyDuration time.Duration
+	startTime     crtime.Mono
+
+	mu          sync.Mutex
+	watchDoneCh chan struct{}
+	completed   bool
+}
+
+var globalAsyncSyncBatches struct {
+	sync.Mutex
+	m map[*Batch]*pendingAsyncSyncCommit
+}
+
+type durabilityTracker struct {
+	mu struct {
+		sync.Mutex
+
+		highestDurableSeqNum   base.SeqNum
+		firstErr               error
+		closeErr               error
+		pendingWaiters         int64
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		// Accumulated only when EventListener.BatchDurable is configured.
+		metricCommitCount    uint64
+		metricCommitDuration time.Duration
+
+		nextJobID         int
+		jobs              map[int]*durabilityJobState
+		completedJobOrder []int
+
+		seqWaiters []*durabilitySeqWaiter
+		notifySubs []*durabilityNotifySub
+
+		// Used only when ApplyNoSyncWait is called, keyed by *Batch.
+		asyncBatches map[*Batch]*pendingAsyncSyncCommit
+	}
+}
+
+func (t *durabilityTracker) init() {
+	t.mu.jobs = make(map[int]*durabilityJobState)
+}
+
+func (t *durabilityTracker) isSeqDurableLocked(seqNum base.SeqNum) bool {
+	if t.mu.highestDurableSeqNum == 0 && t.mu.totalDurableCommits == 0 {
+		return false
+	}
+	return t.mu.highestDurableSeqNum >= seqNum
+}
+
+func (t *durabilityTracker) activeErrLocked() error {
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr
+	}
+	return t.mu.closeErr
+}
+
+func (t *durabilityTracker) beginJob() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.jobs == nil {
+		t.mu.jobs = make(map[int]*durabilityJobState)
+	}
+	t.mu.nextJobID++
+	jobID := t.mu.nextJobID
+	t.mu.jobs[jobID] = &durabilityJobState{
+		jobID: jobID,
+	}
+	return jobID
+}
+
+func (t *durabilityTracker) registerAsyncBatch(b *Batch, info *pendingAsyncSyncCommit) {
+	t.mu.Lock()
+	if t.mu.asyncBatches == nil {
+		t.mu.asyncBatches = make(map[*Batch]*pendingAsyncSyncCommit)
+	}
+	t.mu.asyncBatches[b] = info
+	t.mu.Unlock()
+
+	globalAsyncSyncBatches.Lock()
+	if globalAsyncSyncBatches.m == nil {
+		globalAsyncSyncBatches.m = make(map[*Batch]*pendingAsyncSyncCommit)
+	}
+	globalAsyncSyncBatches.m[b] = info
+	globalAsyncSyncBatches.Unlock()
+}
+
+func (t *durabilityTracker) startAsyncWatchersLocked() {
+	for _, p := range t.mu.asyncBatches {
+		p.mu.Lock()
+		if !p.completed && p.watchDoneCh == nil {
+			p.watchDoneCh = make(chan struct{})
+			go func(p *pendingAsyncSyncCommit) {
+				p.batch.fsyncWait.Wait()
+				elapsed := p.startTime.Elapsed()
+				commitErr := p.batch.commitErr
+				close(p.watchDoneCh)
+				p.mu.Lock()
+				p.completeLocked(elapsed, commitErr)
+				p.mu.Unlock()
+			}(p)
+		}
+		p.mu.Unlock()
+	}
+}
+
+func (p *pendingAsyncSyncCommit) completeLocked(waitDuration time.Duration, commitErr error) {
+	if p.completed {
+		return
+	}
+	p.completed = true
+
+	p.db.durability.mu.Lock()
+	delete(p.db.durability.mu.asyncBatches, p.batch)
+	p.db.durability.mu.Unlock()
+
+	globalAsyncSyncBatches.Lock()
+	delete(globalAsyncSyncBatches.m, p.batch)
+	globalAsyncSyncBatches.Unlock()
+
+	syncDuration := waitDuration
+	if syncDuration <= 0 {
+		syncDuration = time.Nanosecond
+	}
+	p.db.completeSyncCommit(
+		p.jobID,
+		p.seqNum,
+		commitErr,
+		p.applyDuration,
+		syncDuration,
+		p.correlationID,
+		p.batchSize,
+		p.keyCount,
+	)
+}
+
+func completeAsyncSyncBatch(b *Batch, waitDuration time.Duration) {
+	globalAsyncSyncBatches.Lock()
+	p, ok := globalAsyncSyncBatches.m[b]
+	globalAsyncSyncBatches.Unlock()
+	if !ok {
+		return
+	}
+	p.mu.Lock()
+	if p.watchDoneCh != nil {
+		ch := p.watchDoneCh
+		p.mu.Unlock()
+		<-ch
+		p.mu.Lock()
+	}
+	p.completeLocked(waitDuration, b.commitErr)
+	p.mu.Unlock()
+}
+
+func (t *durabilityTracker) recordCompletionAndDetach(
+	jobID int,
+	seqNum base.SeqNum,
+	commitErr error,
+	syncDuration time.Duration,
+	hasCallback bool,
+) (
+	seqWaiters []*durabilitySeqWaiter,
+	jobWaiters []*durabilityJobWaiter,
+	notifySubs []*durabilityNotifySub,
+	notifyErr error,
+) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if commitErr == nil {
+		t.mu.totalDurableCommits++
+		if seqNum > t.mu.highestDurableSeqNum {
+			t.mu.highestDurableSeqNum = seqNum
+		}
+	} else {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = commitErr
+		}
+	}
+	t.mu.cumulativeSyncDuration += syncDuration
+	if syncDuration > t.mu.maxSyncDuration {
+		t.mu.maxSyncDuration = syncDuration
+	}
+	if hasCallback {
+		t.mu.metricCommitCount++
+		t.mu.metricCommitDuration += syncDuration
+	}
+
+	if job, ok := t.mu.jobs[jobID]; ok {
+		job.done = true
+		if commitErr != nil {
+			job.err = commitErr
+		}
+	}
+
+	seqWaiters, jobWaiters, notifySubs = t.detachSatisfiedLocked()
+	notifyErr = t.activeErrLocked()
+
+	if _, ok := t.mu.jobs[jobID]; ok {
+		t.mu.completedJobOrder = append(t.mu.completedJobOrder, jobID)
+		for len(t.mu.completedJobOrder) > maxRetainedDurabilityJobs {
+			evictID := t.mu.completedJobOrder[0]
+			t.mu.completedJobOrder = t.mu.completedJobOrder[1:]
+			delete(t.mu.jobs, evictID)
+		}
+	}
+
+	return seqWaiters, jobWaiters, notifySubs, notifyErr
+}
+
+func (t *durabilityTracker) detachSatisfiedLocked() (
+	seqWaiters []*durabilitySeqWaiter,
+	jobWaiters []*durabilityJobWaiter,
+	notifySubs []*durabilityNotifySub,
+) {
+	activeErr := t.activeErrLocked()
+	if activeErr != nil {
+		if len(t.mu.seqWaiters) > 0 {
+			seqWaiters = t.mu.seqWaiters
+			t.mu.seqWaiters = nil
+			for _, w := range seqWaiters {
+				if !w.removed {
+					w.removed = true
+					t.mu.pendingWaiters--
+				}
+				w.err = activeErr
+			}
+		}
+		for _, job := range t.mu.jobs {
+			if len(job.waiters) > 0 {
+				for _, w := range job.waiters {
+					if !w.removed {
+						w.removed = true
+						t.mu.pendingWaiters--
+					}
+					if job.err != nil {
+						w.err = job.err
+					} else {
+						w.err = activeErr
+					}
+					jobWaiters = append(jobWaiters, w)
+				}
+				job.waiters = nil
+			}
+		}
+		if len(t.mu.notifySubs) > 0 {
+			notifySubs = t.mu.notifySubs
+			t.mu.notifySubs = nil
+		}
+		return seqWaiters, jobWaiters, notifySubs
+	}
+
+	if len(t.mu.seqWaiters) > 0 {
+		remaining := t.mu.seqWaiters[:0]
+		for _, w := range t.mu.seqWaiters {
+			if t.isSeqDurableLocked(w.targetSeqNum) {
+				if !w.removed {
+					w.removed = true
+					t.mu.pendingWaiters--
+				}
+				seqWaiters = append(seqWaiters, w)
+			} else {
+				remaining = append(remaining, w)
+			}
+		}
+		for i := len(remaining); i < len(t.mu.seqWaiters); i++ {
+			t.mu.seqWaiters[i] = nil
+		}
+		t.mu.seqWaiters = remaining
+	}
+
+	for _, job := range t.mu.jobs {
+		if job.done && len(job.waiters) > 0 {
+			for _, w := range job.waiters {
+				if !w.removed {
+					w.removed = true
+					t.mu.pendingWaiters--
+				}
+				w.err = job.err
+				jobWaiters = append(jobWaiters, w)
+			}
+			job.waiters = nil
+		}
+	}
+
+	if len(t.mu.notifySubs) > 0 {
+		remaining := t.mu.notifySubs[:0]
+		for _, sub := range t.mu.notifySubs {
+			if t.isSeqDurableLocked(sub.targetSeqNum) {
+				notifySubs = append(notifySubs, sub)
+			} else {
+				remaining = append(remaining, sub)
+			}
+		}
+		for i := len(remaining); i < len(t.mu.notifySubs); i++ {
+			t.mu.notifySubs[i] = nil
+		}
+		t.mu.notifySubs = remaining
+	}
+
+	return seqWaiters, jobWaiters, notifySubs
+}
+
+func wakeDetached(
+	seqWaiters []*durabilitySeqWaiter,
+	jobWaiters []*durabilityJobWaiter,
+	notifySubs []*durabilityNotifySub,
+	notifyErr error,
+) {
+	for _, w := range seqWaiters {
+		close(w.ch)
+	}
+	for _, w := range jobWaiters {
+		close(w.ch)
+	}
+	for _, sub := range notifySubs {
+		sub.ch <- notifyErr
+	}
+}
+
+func (t *durabilityTracker) close(err error) {
+	t.mu.Lock()
+	if t.mu.closeErr == nil {
+		t.mu.closeErr = err
+	}
+	seqWaiters, jobWaiters, notifySubs := t.detachSatisfiedLocked()
+	notifyErr := t.activeErrLocked()
+	t.mu.Unlock()
+
+	wakeDetached(seqWaiters, jobWaiters, notifySubs, notifyErr)
+}
+
+func (t *durabilityTracker) waitForSeq(
+	ctx context.Context, seqNum base.SeqNum, disableWAL bool,
+) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	t.mu.Lock()
+	if err := t.activeErrLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if disableWAL {
+		t.mu.Unlock()
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+
+	w := &durabilitySeqWaiter{
+		targetSeqNum: seqNum,
+		ch:           make(chan struct{}),
+	}
+	t.mu.seqWaiters = append(t.mu.seqWaiters, w)
+	t.mu.pendingWaiters++
+	t.startAsyncWatchersLocked()
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+		t.mu.Lock()
+		err := w.err
+		if err == nil {
+			err = t.activeErrLocked()
+		}
+		t.mu.Unlock()
+		return err
+	case <-ctx.Done():
+		t.mu.Lock()
+		if !w.removed {
+			w.removed = true
+			t.mu.pendingWaiters--
+			for i, sw := range t.mu.seqWaiters {
+				if sw == w {
+					t.mu.seqWaiters = append(t.mu.seqWaiters[:i], t.mu.seqWaiters[i+1:]...)
+					break
+				}
+			}
+		}
+		// Durability/close errors take precedence over context cancellation.
+		if w.err != nil {
+			err := w.err
+			t.mu.Unlock()
+			return err
+		}
+		if err := t.activeErrLocked(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) waitForSeqBatch(
+	ctx context.Context, seqNums []base.SeqNum, disableWAL bool,
+) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	t.mu.Lock()
+	if err := t.activeErrLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if disableWAL {
+		t.mu.Unlock()
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if len(seqNums) == 0 {
+		t.mu.Unlock()
+		return nil
+	}
+	t.mu.Unlock()
+
+	maxSeq := seqNums[0]
+	for _, s := range seqNums[1:] {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return t.waitForSeq(ctx, maxSeq, disableWAL)
+}
+
+func (t *durabilityTracker) waitForJob(
+	ctx context.Context, jobID int, disableWAL bool,
+) error {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	t.mu.Lock()
+	if t.mu.closeErr != nil {
+		err := t.activeErrLocked()
+		t.mu.Unlock()
+		return err
+	}
+	if disableWAL {
+		t.mu.Unlock()
+		return nil
+	}
+	if jobID <= 0 || jobID > t.mu.nextJobID {
+		if t.mu.firstErr != nil && ctx.Err() != nil {
+			err := t.mu.firstErr
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", errors.Safe(jobID))
+	}
+	job, ok := t.mu.jobs[jobID]
+	if !ok {
+		if t.mu.firstErr != nil && ctx.Err() != nil {
+			err := t.mu.firstErr
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobExpired, "job %d", errors.Safe(jobID))
+	}
+	if job.err != nil {
+		err := job.err
+		t.mu.Unlock()
+		return err
+	}
+	if err := t.activeErrLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if job.done {
+		t.mu.Unlock()
+		return nil
+	}
+
+	w := &durabilityJobWaiter{
+		jobID: jobID,
+		ch:    make(chan struct{}),
+	}
+	job.waiters = append(job.waiters, w)
+	t.mu.pendingWaiters++
+	t.startAsyncWatchersLocked()
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+		t.mu.Lock()
+		err := w.err
+		if err == nil {
+			err = t.activeErrLocked()
+		}
+		t.mu.Unlock()
+		return err
+	case <-ctx.Done():
+		t.mu.Lock()
+		if !w.removed {
+			w.removed = true
+			t.mu.pendingWaiters--
+			if j, exists := t.mu.jobs[jobID]; exists {
+				for i, jw := range j.waiters {
+					if jw == w {
+						j.waiters = append(j.waiters[:i], j.waiters[i+1:]...)
+						break
+					}
+				}
+			}
+		}
+		// Durability/close errors take precedence over context cancellation.
+		if w.err != nil {
+			err := w.err
+			t.mu.Unlock()
+			return err
+		}
+		if err := t.activeErrLocked(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) durableState() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeqNum, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeqNum,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.mu.pendingWaiters,
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+func (t *durabilityTracker) metricSnapshot() (count uint64, duration time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.metricCommitCount, t.mu.metricCommitDuration
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum, disableWAL bool) <-chan error {
+	ch := make(chan error, 1)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err := t.activeErrLocked(); err != nil {
+		ch <- err
+		return ch
+	}
+	if disableWAL || t.isSeqDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(t.mu.notifySubs) >= maxDurabilityNotifySubscriptions {
+		ch <- ErrDurabilityNotifyLimitExceeded
+		return ch
+	}
+	t.mu.notifySubs = append(t.mu.notifySubs, &durabilityNotifySub{
+		targetSeqNum: seqNum,
+		ch:           ch,
+	})
+	t.startAsyncWatchersLocked()
+	return ch
+}
+
+func (d *DB) completeSyncCommit(
+	jobID int,
+	seqNum base.SeqNum,
+	commitErr error,
+	applyDuration time.Duration,
+	syncDuration time.Duration,
+	correlationID uint64,
+	batchSize int,
+	keyCount uint32,
+) {
+	hasCallback := d.opts.EventListener != nil && isBatchDurableConfigured(d.opts.EventListener.BatchDurable)
+
+	seqWaiters, jobWaiters, notifySubs, notifyErr := d.durability.recordCompletionAndDetach(
+		jobID, seqNum, commitErr, syncDuration, hasCallback,
+	)
+
+	if hasCallback {
+		d.opts.EventListener.BatchDurable(BatchDurableInfo{
+			JobID:         jobID,
+			SeqNum:        seqNum,
+			Err:           commitErr,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: correlationID,
+			BatchSize:     batchSize,
+			KeyCount:      keyCount,
+		})
+	}
+
+	wakeDetached(seqWaiters, jobWaiters, notifySubs, notifyErr)
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk. A sequence number of zero succeeds after any durable commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk or ctx is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.waitForSeq(ctx, seqNum, d.opts.DisableWAL)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk or ctx is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	return d.durability.waitForSeqBatch(ctx, seqNums, d.opts.DisableWAL)
+}
+
+// WaitForJobDurability blocks until the sync commit identified by jobID is
+// durable on disk.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the sync commit identified by jobID
+// is durable on disk or ctx is cancelled. Durability and close errors take
+// precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durability.waitForJob(ctx, jobID, d.opts.DisableWAL)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched durability error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil
+// when seqNum becomes durable, or a non-nil error on WAL sync failure, DB
+// close, or if the bound on outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.notify(seqNum, d.opts.DisableWAL)
+}
+
+// DurabilityStats returns a snapshot of durability tracking metrics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
