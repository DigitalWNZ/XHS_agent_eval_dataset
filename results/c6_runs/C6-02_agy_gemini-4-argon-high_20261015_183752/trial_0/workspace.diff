+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var syncDelay atomic.Int64
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if d := time.Duration(syncDelay.Load()); d > 0 {
+				time.Sleep(d)
+			}
+			return nil
+		},
+	}
+
+	opts := &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Non-sync commits must never trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync1"), []byte("v1"), NoSync))
+	require.NoError(t, d.Set([]byte("nosync2"), []byte("v2"), &WriteOptions{Sync: false}))
+	bNoSync := d.NewBatch()
+	require.NoError(t, bNoSync.Set([]byte("nosync3"), []byte("v3"), nil))
+	require.NoError(t, d.Apply(bNoSync, NoSync))
+	require.NoError(t, bNoSync.Close())
+
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Sync commit with correlation ID and measured wall-clock delay.
+	syncDelay.Store(int64(15 * time.Millisecond))
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("val1"), nil))
+	require.NoError(t, b1.Set([]byte("k2"), []byte("val2"), nil))
+	expectedSize1 := len(b1.Repr())
+	expectedCount1 := b1.Count()
+	require.Equal(t, uint32(2), expectedCount1)
+
+	wOpts1 := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 424242,
+	}
+	require.NoError(t, d.Apply(b1, wOpts1))
+	expectedSeq1 := b1.SeqNum()
+	require.NoError(t, b1.Close())
+	syncDelay.Store(0)
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev1 := events[0]
+	mu.Unlock()
+
+	require.Greater(t, ev1.JobID, 0)
+	require.Equal(t, expectedSeq1, ev1.SeqNum)
+	require.NoError(t, ev1.Err)
+	require.Greater(t, ev1.ApplyDuration, time.Duration(0))
+	require.GreaterOrEqual(t, ev1.SyncDuration, 10*time.Millisecond)
+	require.Equal(t, uint64(424242), ev1.CorrelationID)
+	require.Equal(t, expectedSize1, ev1.BatchSize)
+	require.Equal(t, uint32(2), ev1.KeyCount)
+
+	// Second Sync commit via d.Set.
+	wOpts2 := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 99,
+	}
+	require.NoError(t, d.Set([]byte("k3"), []byte("val3"), wOpts2))
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Greater(t, ev2.JobID, ev1.JobID)
+	require.Greater(t, ev2.SeqNum, ev1.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(99), ev2.CorrelationID)
+	require.Greater(t, ev2.BatchSize, 0)
+	require.Equal(t, uint32(1), ev2.KeyCount)
+
+	// ApplyNoSyncWait + SyncWait must also fire BatchDurable once.
+	bAsync := d.NewBatch()
+	require.NoError(t, bAsync.Set([]byte("k4"), []byte("val4"), nil))
+	expectedAsyncSize := len(bAsync.Repr())
+	require.NoError(t, d.ApplyNoSyncWait(bAsync, &WriteOptions{Sync: true, CommitCorrelationID: 777}))
+	require.NoError(t, bAsync.SyncWait())
+	expectedAsyncSeq := bAsync.SeqNum()
+	require.NoError(t, bAsync.Close())
+
+	mu.Lock()
+	require.Len(t, events, 3)
+	ev3 := events[2]
+	mu.Unlock()
+
+	require.Greater(t, ev3.JobID, ev2.JobID)
+	require.Equal(t, expectedAsyncSeq, ev3.SeqNum)
+	require.NoError(t, ev3.Err)
+	require.Greater(t, ev3.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev3.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(777), ev3.CorrelationID)
+	require.Equal(t, expectedAsyncSize, ev3.BatchSize)
+	require.Equal(t, uint32(1), ev3.KeyCount)
+}
