+func TestBatchDurableOnSyncFailure(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var failSync atomic.Bool
+	injectedErr := errors.New("injected WAL sync failure")
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	fs := &syncHookFS{
+		FS: vfs.NewMem(),
+		onWALSync: func() error {
+			if failSync.Load() {
+				return injectedErr
+			}
+			return nil
+		},
+	}
+
+	d, err := Open("", &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		_ = d.Close()
+	}()
+
+	require.NoError(t, d.Set([]byte("ok"), []byte("val"), Sync))
+	seq1, err1 := d.DurableState()
+	require.NoError(t, err1)
+	require.Greater(t, seq1, base.SeqNum(0))
+
+	failSync.Store(true)
+	err = d.Set([]byte("fail"), []byte("val"), &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 1234,
+	})
+	require.ErrorIs(t, err, injectedErr)
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEv := events[1]
+	mu.Unlock()
+
+	require.ErrorIs(t, failEv.Err, injectedErr)
+	require.Equal(t, uint64(1234), failEv.CorrelationID)
+	require.Equal(t, uint32(1), failEv.KeyCount)
+	require.Greater(t, failEv.BatchSize, 0)
+	require.Greater(t, failEv.JobID, events[0].JobID)
+
+	// DurableState retains HighestDurableSeqNum from last successful commit and latches FirstErr.
+	seqAfter, latchedErr := d.DurableState()
+	require.Equal(t, seq1, seqAfter)
+	require.ErrorIs(t, latchedErr, injectedErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+}
