+// syncHookFS wraps a vfs.FS and intercepts File.Sync on WAL (.log) files.
+type syncHookFS struct {
+	vfs.FS
+	onWALSync func() error
+}
+
+type syncHookFile struct {
+	vfs.File
+	onSync func() error
+}
+
+func (fs *syncHookFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	if strings.HasSuffix(name, ".log") {
+		return &syncHookFile{File: f, onSync: fs.onWALSync}, nil
+	}
+	return f, nil
+}
+
+func (f *syncHookFile) Sync() error {
+	if f.onSync != nil {
+		if err := f.onSync(); err != nil {
+			return err
+		}
+	}
+	return f.File.Sync()
+}
