+func TestDurabilityNotify(t *testing.T) {
+	opts := &Options{
+		FS: vfs.NewMem(),
+	}
+	opts.Experimental.MaxDurabilitySubscriptions = 2
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Commit once to advance sequence number.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	curSeq, _ := d.DurableState()
+
+	// Notify for already durable seqnum returns pre-filled channel with nil.
+	ch := d.DurabilityNotify(curSeq)
+	select {
+	case err := <-ch:
+		require.NoError(t, err)
+	default:
+		t.Fatal("channel was not pre-filled")
+	}
+
+	// Notify for future sequence numbers.
+	futureSeq := curSeq + 50
+	ch1 := d.DurabilityNotify(futureSeq)
+	ch2 := d.DurabilityNotify(futureSeq + 1)
+
+	// 3rd subscription exceeds bound of 2 -> immediate error.
+	chExcess := d.DurabilityNotify(futureSeq + 2)
+	select {
+	case err := <-chExcess:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrTooManySubscriptions))
+	default:
+		t.Fatal("excess subscription channel was not pre-filled with error")
+	}
+
+	// Advance commits past futureSeq.
+	for {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+		s, _ := d.DurableState()
+		if s >= futureSeq+1 {
+			break
+		}
+	}
+
+	// ch1 and ch2 should receive nil.
+	require.NoError(t, <-ch1)
+	require.NoError(t, <-ch2)
+
+	// Since subscriptions completed, new subscription should succeed.
+	chNew := d.DurabilityNotify(curSeq)
+	require.NoError(t, <-chNew)
+}
