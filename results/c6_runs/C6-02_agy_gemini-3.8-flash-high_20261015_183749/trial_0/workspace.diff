+func TestDurabilityCloseUnblocksWaiters(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	seqErrCh := make(chan error, 1)
+	go func() {
+		seqErrCh <- d.WaitForDurability(9999)
+	}()
+
+	notifyCh := d.DurabilityNotify(9999)
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 10*time.Millisecond)
+
+	require.NoError(t, d.Close())
+
+	// seqWaiter should unblock with ErrClosed.
+	select {
+	case err := <-seqErrCh:
+		require.Equal(t, ErrClosed, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurability did not unblock on DB close")
+	}
+
+	// DurabilityNotify channel should deliver ErrClosed.
+	select {
+	case err := <-notifyCh:
+		require.Equal(t, ErrClosed, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("DurabilityNotify channel did not deliver on DB close")
+	}
+
+	// Subsequent calls return ErrClosed.
+	require.Equal(t, ErrClosed, d.WaitForDurability(10))
+	require.Equal(t, ErrClosed, d.WaitForDurabilityBatch([]base.SeqNum{10}))
+	require.Equal(t, ErrClosed, <-d.DurabilityNotify(10))
+}
