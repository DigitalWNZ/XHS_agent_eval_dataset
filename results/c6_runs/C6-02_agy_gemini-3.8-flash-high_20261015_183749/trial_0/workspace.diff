+type mockFatalLogger struct {
+	base.Logger
+}
+
+func (l *mockFatalLogger) Fatalf(format string, args ...interface{}) {
+	panic(fmt.Sprintf(format, args...))
+}
+
+func TestBatchDurableOnSyncFailure(t *testing.T) {
+	memFS := vfs.NewMem()
+	faultFS := &syncFailFS{FS: memFS}
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS:     faultFS,
+		Logger: &mockFatalLogger{Logger: base.DefaultLogger},
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				events = append(events, info)
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// First commit succeeds.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	require.NoError(t, events[0].Err)
+	mu.Unlock()
+
+	// Inject WAL sync failure.
+	faultFS.failSync.Store(true)
+
+	// Second commit fails due to sync error.
+	func() {
+		defer func() {
+			_ = recover()
+		}()
+		_ = d.Set([]byte("k2"), []byte("v2"), Sync)
+	}()
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Equal(t, 2, ev2.JobID)
+	require.Error(t, ev2.Err)
+	require.Contains(t, ev2.Err.Error(), "injected sync error")
+
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Error(t, stats.FirstErr)
+	require.Contains(t, stats.FirstErr.Error(), "injected sync error")
+}
