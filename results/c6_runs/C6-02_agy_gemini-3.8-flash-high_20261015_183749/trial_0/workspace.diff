diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..5335b569
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,671 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityStats contains a snapshot of durability statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+var (
+	// ErrJobExpired is returned by WaitForJobDurability when a job ID has fallen
+	// outside the bounded retention window.
+	ErrJobExpired = errors.New("pebble: job expired")
+
+	// ErrJobUnknown is returned by WaitForJobDurability when a job ID has never been
+	// seen or is zero.
+	ErrJobUnknown = errors.New("pebble: unknown job ID")
+
+	// ErrTooManySubscriptions is returned on a pre-filled channel by DurabilityNotify
+	// when the number of outstanding subscriptions exceeds the limit.
+	ErrTooManySubscriptions = errors.New("pebble: excess durability subscriptions")
+)
+
+const (
+	defaultMaxDurabilitySubscriptions = 1024
+	defaultJobRetentionWindow         = 1024
+)
+
+type durabilitySubscription struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type seqWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+}
+
+type jobWaiter struct {
+	jobID int
+	ch    chan error
+}
+
+type durableCommitEntry struct {
+	jobID         int
+	seqNum        base.SeqNum
+	keyCount      uint32
+	batchSize     int
+	correlationID uint64
+	applyDuration time.Duration
+	syncStartTime time.Time
+	syncDuration  time.Duration
+	err           error
+
+	appliedOnce sync.Once
+	appliedChan chan struct{}
+
+	done atomic.Bool
+
+	originalSyncWG  *sync.WaitGroup
+	originalSyncErr *error
+	completed       chan struct{}
+}
+
+func newDurableCommitEntry(
+	b *Batch,
+	batchSize int,
+	syncWG *sync.WaitGroup,
+	syncErr *error,
+	jobID int,
+	correlationID uint64,
+) *durableCommitEntry {
+	return &durableCommitEntry{
+		jobID:           jobID,
+		seqNum:          b.SeqNum(),
+		keyCount:        uint32(b.Count()),
+		batchSize:       batchSize,
+		correlationID:   correlationID,
+		syncStartTime:   time.Now(),
+		appliedChan:     make(chan struct{}),
+		originalSyncWG:  syncWG,
+		originalSyncErr: syncErr,
+		completed:       make(chan struct{}),
+	}
+}
+
+func (e *durableCommitEntry) markApplied(err error) {
+	e.appliedOnce.Do(func() {
+		if err != nil && e.err == nil {
+			e.err = err
+		}
+		close(e.appliedChan)
+	})
+}
+
+type durabilityManager struct {
+	db *DB
+
+	mu sync.Mutex
+
+	batchDurableConfigured bool
+	closed                 bool
+
+	highestDurableSeqNum base.SeqNum
+	firstErr             error
+
+	pendingWaiters atomic.Int64
+
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	durableCommitCount    atomic.Uint64
+	durableCommitDuration atomic.Int64 // nanoseconds
+
+	nextJobID            int
+	latestAllocatedJobID int
+	oldestRetainedJobID  int
+	completedJobs        map[int]error
+	maxRetentionJobs     int
+
+	jobWaiters []*jobWaiter
+	seqWaiters []*seqWaiter
+
+	subscriptions    []*durabilitySubscription
+	maxSubscriptions int
+
+	pendingQueue []*durableCommitEntry
+	draining     bool
+}
+
+func (dm *durabilityManager) init(db *DB, batchDurableConfigured bool) {
+	dm.db = db
+	dm.batchDurableConfigured = batchDurableConfigured
+	dm.nextJobID = 1
+	dm.oldestRetainedJobID = 1
+	dm.completedJobs = make(map[int]error)
+	dm.maxRetentionJobs = defaultJobRetentionWindow
+	dm.maxSubscriptions = defaultMaxDurabilitySubscriptions
+	if db != nil && db.opts != nil {
+		if db.opts.Experimental.DurabilityJobRetentionWindow > 0 {
+			dm.maxRetentionJobs = db.opts.Experimental.DurabilityJobRetentionWindow
+		}
+		if db.opts.Experimental.MaxDurabilitySubscriptions > 0 {
+			dm.maxSubscriptions = db.opts.Experimental.MaxDurabilitySubscriptions
+		}
+	}
+}
+
+func (dm *durabilityManager) enqueueSyncCommit(
+	b *Batch, batchSize int, syncWG *sync.WaitGroup, syncErr *error,
+) *durableCommitEntry {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	jobID := dm.nextJobID
+	dm.nextJobID++
+	dm.latestAllocatedJobID = jobID
+
+	correlationID := b.commitCorrelationID
+
+	entry := newDurableCommitEntry(b, batchSize, syncWG, syncErr, jobID, correlationID)
+	dm.pendingQueue = append(dm.pendingQueue, entry)
+	return entry
+}
+
+func (dm *durabilityManager) watchSync(
+	walWG *sync.WaitGroup, walErr *error, entry *durableCommitEntry,
+) {
+	walWG.Wait()
+	syncDuration := time.Since(entry.syncStartTime)
+
+	<-entry.appliedChan
+
+	dm.mu.Lock()
+	if entry.syncDuration == 0 {
+		entry.syncDuration = syncDuration
+	}
+	if *walErr != nil && entry.err == nil {
+		entry.err = *walErr
+	}
+	if entry.err == nil && entry.syncDuration <= 0 {
+		entry.syncDuration = time.Nanosecond
+	}
+	entry.done.Store(true)
+	dm.mu.Unlock()
+
+	dm.drain()
+}
+
+func (dm *durabilityManager) drain() {
+	dm.mu.Lock()
+	if dm.draining {
+		dm.mu.Unlock()
+		return
+	}
+	dm.draining = true
+
+	for {
+		if len(dm.pendingQueue) == 0 || !dm.pendingQueue[0].done.Load() {
+			dm.draining = false
+			dm.mu.Unlock()
+			return
+		}
+
+		head := dm.pendingQueue[0]
+		dm.pendingQueue = dm.pendingQueue[1:]
+
+		// Update sequence number and statistics.
+		highestInBatch := head.seqNum
+		if head.keyCount > 0 {
+			highestInBatch += base.SeqNum(head.keyCount - 1)
+		}
+
+		if head.err == nil {
+			if highestInBatch > dm.highestDurableSeqNum {
+				dm.highestDurableSeqNum = highestInBatch
+			}
+			dm.totalDurableCommits++
+			dm.cumulativeSyncDuration += head.syncDuration
+			if head.syncDuration > dm.maxSyncDuration {
+				dm.maxSyncDuration = head.syncDuration
+			}
+			if dm.batchDurableConfigured {
+				dm.durableCommitCount.Add(1)
+				dm.durableCommitDuration.Add(int64(head.syncDuration))
+			}
+		} else {
+			dm.totalFailedCommits++
+			if dm.firstErr == nil {
+				dm.firstErr = head.err
+			}
+		}
+
+		// Record completed job.
+		if dm.completedJobs == nil {
+			dm.completedJobs = make(map[int]error)
+		}
+		dm.completedJobs[head.jobID] = head.err
+		if len(dm.completedJobs) > dm.maxRetentionJobs {
+			newOldest := head.jobID - dm.maxRetentionJobs + 1
+			for id := dm.oldestRetainedJobID; id < newOldest; id++ {
+				delete(dm.completedJobs, id)
+			}
+			dm.oldestRetainedJobID = newOldest
+		}
+
+		// Collect job waiters to wake up.
+		var remainingJobWaiters []*jobWaiter
+		var jobWaitersToWake []*jobWaiter
+		for _, w := range dm.jobWaiters {
+			if w.jobID == head.jobID {
+				jobWaitersToWake = append(jobWaitersToWake, w)
+			} else {
+				remainingJobWaiters = append(remainingJobWaiters, w)
+			}
+		}
+		dm.jobWaiters = remainingJobWaiters
+
+		// Collect sequence number waiters to wake up.
+		var remainingSeqWaiters []*seqWaiter
+		var seqWaitersToWake []*seqWaiter
+		for _, w := range dm.seqWaiters {
+			if dm.isDurableLocked(w.seqNum) || dm.firstErr != nil || dm.closed {
+				seqWaitersToWake = append(seqWaitersToWake, w)
+			} else {
+				remainingSeqWaiters = append(remainingSeqWaiters, w)
+			}
+		}
+		dm.seqWaiters = remainingSeqWaiters
+
+		// Collect durability subscriptions to deliver.
+		var remainingSubs []*durabilitySubscription
+		type subDelivery struct {
+			ch  chan error
+			err error
+		}
+		var subsToDeliver []subDelivery
+		for _, sub := range dm.subscriptions {
+			if dm.firstErr != nil {
+				subsToDeliver = append(subsToDeliver, subDelivery{ch: sub.ch, err: dm.firstErr})
+			} else if dm.closed {
+				subsToDeliver = append(subsToDeliver, subDelivery{ch: sub.ch, err: ErrClosed})
+			} else if dm.isDurableLocked(sub.seqNum) {
+				subsToDeliver = append(subsToDeliver, subDelivery{ch: sub.ch, err: nil})
+			} else {
+				remainingSubs = append(remainingSubs, sub)
+			}
+		}
+		dm.subscriptions = remainingSubs
+
+		applyDur := head.applyDuration
+		if head.err == nil && applyDur <= 0 {
+			applyDur = time.Nanosecond
+		}
+		syncDur := head.syncDuration
+		if head.err == nil && syncDur <= 0 {
+			syncDur = time.Nanosecond
+		}
+		info := BatchDurableInfo{
+			JobID:         head.jobID,
+			SeqNum:        head.seqNum,
+			Err:           head.err,
+			ApplyDuration: applyDur,
+			SyncDuration:  syncDur,
+			CorrelationID: head.correlationID,
+			BatchSize:     head.batchSize,
+			KeyCount:      head.keyCount,
+		}
+
+		dm.mu.Unlock()
+
+		// Outside lock:
+		for _, w := range jobWaitersToWake {
+			w.ch <- head.err
+		}
+		for _, w := range seqWaitersToWake {
+			select {
+			case w.ch <- struct{}{}:
+			default:
+			}
+		}
+		for _, s := range subsToDeliver {
+			s.ch <- s.err
+		}
+		if dm.db != nil && dm.db.opts != nil && dm.db.opts.EventListener != nil &&
+			isBatchDurableConfigured(dm.db.opts.EventListener.BatchDurable) {
+			dm.db.opts.EventListener.BatchDurable(info)
+		}
+		close(head.completed)
+		if head.originalSyncErr != nil {
+			*head.originalSyncErr = head.err
+		}
+		head.originalSyncWG.Done()
+
+		dm.mu.Lock()
+	}
+}
+
+func (dm *durabilityManager) isDurableLocked(seqNum base.SeqNum) bool {
+	if seqNum == 0 {
+		return dm.totalDurableCommits > 0
+	}
+	return dm.highestDurableSeqNum >= seqNum
+}
+
+func (dm *durabilityManager) onClose(err error) {
+	dm.mu.Lock()
+	dm.closed = true
+	if dm.firstErr == nil {
+		dm.firstErr = err
+	}
+
+	for _, w := range dm.jobWaiters {
+		w.ch <- err
+	}
+	dm.jobWaiters = nil
+
+	for _, w := range dm.seqWaiters {
+		select {
+		case w.ch <- struct{}{}:
+		default:
+		}
+	}
+	dm.seqWaiters = nil
+
+	for _, sub := range dm.subscriptions {
+		sub.ch <- err
+	}
+	dm.subscriptions = nil
+
+	for _, entry := range dm.pendingQueue {
+		entry.err = err
+		entry.markApplied(err)
+		entry.done.Store(true)
+	}
+
+	dm.mu.Unlock()
+
+	dm.drain()
+}
+
+func (dm *durabilityManager) removeSeqWaiterLocked(target *seqWaiter) {
+	for i, w := range dm.seqWaiters {
+		if w == target {
+			dm.seqWaiters = append(dm.seqWaiters[:i], dm.seqWaiters[i+1:]...)
+			return
+		}
+	}
+}
+
+func (dm *durabilityManager) removeJobWaiterLocked(target *jobWaiter) {
+	for i, w := range dm.jobWaiters {
+		if w == target {
+			dm.jobWaiters = append(dm.jobWaiters[:i], dm.jobWaiters[i+1:]...)
+			return
+		}
+	}
+}
+
+func (dm *durabilityManager) waitForDurability(ctx context.Context, seqNum base.SeqNum) error {
+	dm.mu.Lock()
+	if dm.firstErr != nil {
+		err := dm.firstErr
+		dm.mu.Unlock()
+		return err
+	}
+	if dm.closed {
+		dm.mu.Unlock()
+		return ErrClosed
+	}
+	if dm.isDurableLocked(seqNum) {
+		dm.mu.Unlock()
+		return nil
+	}
+	if ctx.Err() != nil {
+		dm.mu.Unlock()
+		return ctx.Err()
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     make(chan struct{}, 1),
+	}
+	dm.seqWaiters = append(dm.seqWaiters, w)
+	dm.pendingWaiters.Add(1)
+	dm.mu.Unlock()
+
+	defer dm.pendingWaiters.Add(-1)
+
+	select {
+	case <-w.ch:
+		dm.mu.Lock()
+		defer dm.mu.Unlock()
+		if dm.firstErr != nil {
+			return dm.firstErr
+		}
+		if dm.closed {
+			return ErrClosed
+		}
+		if dm.isDurableLocked(seqNum) {
+			return nil
+		}
+		return ErrClosed
+	case <-ctx.Done():
+		dm.mu.Lock()
+		defer dm.mu.Unlock()
+		dm.removeSeqWaiterLocked(w)
+		if dm.firstErr != nil {
+			return dm.firstErr
+		}
+		if dm.closed {
+			return ErrClosed
+		}
+		return ctx.Err()
+	}
+}
+
+func (dm *durabilityManager) waitForJobDurability(ctx context.Context, jobID int) error {
+	dm.mu.Lock()
+	if dm.firstErr != nil {
+		err := dm.firstErr
+		dm.mu.Unlock()
+		return err
+	}
+	if dm.closed {
+		dm.mu.Unlock()
+		return ErrClosed
+	}
+	if jobID <= 0 || jobID > dm.latestAllocatedJobID {
+		dm.mu.Unlock()
+		return errors.Wrapf(ErrJobUnknown, "job ID %d unknown", jobID)
+	}
+	if jobID < dm.oldestRetainedJobID {
+		dm.mu.Unlock()
+		return errors.Wrapf(ErrJobExpired, "job ID %d expired", jobID)
+	}
+	if err, ok := dm.completedJobs[jobID]; ok {
+		dm.mu.Unlock()
+		return err
+	}
+	if ctx.Err() != nil {
+		dm.mu.Unlock()
+		return ctx.Err()
+	}
+
+	w := &jobWaiter{
+		jobID: jobID,
+		ch:    make(chan error, 1),
+	}
+	dm.jobWaiters = append(dm.jobWaiters, w)
+	dm.pendingWaiters.Add(1)
+	dm.mu.Unlock()
+
+	defer dm.pendingWaiters.Add(-1)
+
+	select {
+	case err := <-w.ch:
+		return err
+	case <-ctx.Done():
+		dm.mu.Lock()
+		defer dm.mu.Unlock()
+		dm.removeJobWaiterLocked(w)
+		if jobErr, ok := dm.completedJobs[jobID]; ok && jobErr != nil {
+			return jobErr
+		}
+		if dm.firstErr != nil {
+			return dm.firstErr
+		}
+		if dm.closed {
+			return ErrClosed
+		}
+		return ctx.Err()
+	}
+}
+
+func (dm *durabilityManager) notify(seqNum base.SeqNum, ch chan error) <-chan error {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	if dm.firstErr != nil {
+		ch <- dm.firstErr
+		return ch
+	}
+	if dm.closed {
+		ch <- ErrClosed
+		return ch
+	}
+	if dm.isDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(dm.subscriptions) >= dm.maxSubscriptions {
+		ch <- ErrTooManySubscriptions
+		return ch
+	}
+
+	dm.subscriptions = append(dm.subscriptions, &durabilitySubscription{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (dm *durabilityManager) state() (base.SeqNum, error) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	firstErr := dm.firstErr
+	if firstErr == nil && dm.closed {
+		firstErr = ErrClosed
+	}
+	return dm.highestDurableSeqNum, firstErr
+}
+
+func (dm *durabilityManager) stats() DurabilityStats {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+	firstErr := dm.firstErr
+	if firstErr == nil && dm.closed {
+		firstErr = ErrClosed
+	}
+	return DurabilityStats{
+		HighestDurableSeqNum:   dm.highestDurableSeqNum,
+		FirstErr:               firstErr,
+		PendingWaiters:         dm.pendingWaiters.Load(),
+		TotalDurableCommits:    dm.totalDurableCommits,
+		TotalFailedCommits:     dm.totalFailedCommits,
+		CumulativeSyncDuration: dm.cumulativeSyncDuration,
+		MaxSyncDuration:        dm.maxSyncDuration,
+	}
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+// A sequence number of zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable
+// or the context is cancelled. Durability and close errors take precedence
+// over context cancellation. A sequence number of zero succeeds after any commit.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForDurability(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in the slice is
+// durable. Nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in the slice
+// is durable or the context is cancelled. Nil or empty slice returns nil immediately.
+// Durability and close errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	if d.opts.DisableWAL {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the batch durable callback job with jobID
+// has completed durability. Jobs outside a bounded retention window return
+// ErrJobExpired (message contains "expired"). Never-seen and zero job IDs return
+// ErrJobUnknown (message contains "unknown").
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the batch durable callback job with
+// jobID has completed durability or the context is cancelled. Durability and close
+// errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitForJobDurability(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil on
+// success or a non-nil error on WAL sync failure or DB close. Outstanding subscriptions
+// are bounded; excess callers get a pre-filled channel with an immediate non-nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+	return d.durability.notify(seqNum, ch)
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
