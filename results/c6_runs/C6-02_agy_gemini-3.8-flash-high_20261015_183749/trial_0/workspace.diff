+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), NoSync))
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), &WriteOptions{Sync: false, CommitCorrelationID: 100}))
+	require.Equal(t, int32(0), eventCount.Load())
