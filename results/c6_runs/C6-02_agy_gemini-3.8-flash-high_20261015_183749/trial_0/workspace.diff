+func TestDurabilityMetrics(t *testing.T) {
+	// DB without BatchDurable configured: metrics should NOT accumulate.
+	d1, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	require.NoError(t, d1.Set([]byte("k1"), []byte("v1"), Sync))
+	require.NoError(t, d1.Set([]byte("k2"), []byte("v2"), Sync))
+
+	m1 := d1.Metrics()
+	require.Equal(t, uint64(0), m1.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m1.DurableCommitDuration)
+	require.Equal(t, uint64(2), d1.DurabilityStats().TotalDurableCommits)
+	require.NoError(t, d1.Close())
+
+	// DB with BatchDurable configured: metrics SHOULD accumulate.
+	opts2 := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {},
+		},
+	}
+	d2, err := Open("", opts2)
+	require.NoError(t, err)
+	defer d2.Close()
+
+	require.NoError(t, d2.Set([]byte("k1"), []byte("v1"), Sync))
+	require.NoError(t, d2.Set([]byte("k2"), []byte("v2"), Sync))
+	require.NoError(t, d2.Set([]byte("k3"), []byte("v3"), Sync))
+
+	m2 := d2.Metrics()
+	require.Equal(t, uint64(3), m2.DurableCommitCount)
+	require.Greater(t, m2.DurableCommitDuration, time.Duration(0))
+	require.Equal(t, uint64(3), d2.DurabilityStats().TotalDurableCommits)
+}
