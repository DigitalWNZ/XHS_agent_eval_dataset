+	ev1 := events1[0]
+	mu1.Unlock()
+
+	mu2.Lock()
+	require.Len(t, events2, 1)
+	ev2 := events2[0]
+	mu2.Unlock()
+
+	require.Equal(t, ev1.JobID, ev2.JobID)
+	require.Equal(t, ev1.SeqNum, ev2.SeqNum)
