+func TestTeeEventListenerBatchDurable(t *testing.T) {
+	var mu1, mu2 sync.Mutex
+	var events1, events2 []BatchDurableInfo
+
+	l1 := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu1.Lock()
+			defer mu1.Unlock()
+			events1 = append(events1, info)
+		},
+	}
+	l2 := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu2.Lock()
+			defer mu2.Unlock()
+			events2 = append(events2, info)
+		},
+	}
+	tee := TeeEventListener(l1, l2)
+
+	opts := &Options{
+		FS:            vfs.NewMem(),
+		EventListener: &tee,
+	}
