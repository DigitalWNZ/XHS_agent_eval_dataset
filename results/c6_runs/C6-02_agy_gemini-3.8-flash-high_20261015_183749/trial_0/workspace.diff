+func TestWaitForJobDurability(t *testing.T) {
+	opts := &Options{
+		FS: vfs.NewMem(),
+	}
+	opts.Experimental.DurabilityJobRetentionWindow = 3
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Zero and negative IDs return unknown error containing "unknown".
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	require.True(t, errors.Is(err, ErrJobUnknown))
+
+	err = d.WaitForJobDurability(-1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	require.True(t, errors.Is(err, ErrJobUnknown))
+
+	// Never-seen IDs return unknown error containing "unknown".
+	err = d.WaitForJobDurability(100)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	require.True(t, errors.Is(err, ErrJobUnknown))
+
+	// Commit 5 sync batches (job IDs 1, 2, 3, 4, 5).
+	for i := 1; i <= 5; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("k%d", i)), []byte("val"), Sync))
+	}
+
+	// Jobs within retention window (window size 3 -> retained: 3, 4, 5).
+	require.NoError(t, d.WaitForJobDurability(5))
+	require.NoError(t, d.WaitForJobDurability(4))
+	require.NoError(t, d.WaitForJobDurability(3))
+
+	// Job 1 and 2 outside retention window return expired error containing "expired".
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+	require.True(t, errors.Is(err, ErrJobExpired))
+
+	err = d.WaitForJobDurability(2)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+	require.True(t, errors.Is(err, ErrJobExpired))
+}
