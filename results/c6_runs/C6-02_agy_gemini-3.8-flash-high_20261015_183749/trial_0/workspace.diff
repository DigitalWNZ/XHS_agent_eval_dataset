+func TestBatchDurableCallback(t *testing.T) {
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				events = append(events, info)
+			},
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// 1. Commit a sync batch with 2 keys and CorrelationID.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, b1.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b1.Commit(&WriteOptions{Sync: true, CommitCorrelationID: 12345}))
+	b1Seq := b1.SeqNum()
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev1 := events[0]
+	mu.Unlock()
+
+	require.Equal(t, 1, ev1.JobID)
+	require.Equal(t, b1Seq, ev1.SeqNum)
+	require.NoError(t, ev1.Err)
+	require.Greater(t, ev1.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev1.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(12345), ev1.CorrelationID)
+	require.Greater(t, ev1.BatchSize, 0)
+	require.Equal(t, uint32(2), ev1.KeyCount)
+	require.NotEmpty(t, ev1.String())
+
+	// 2. Commit a second sync batch with 1 key and different CorrelationID.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k3"), []byte("v3"), nil))
+	require.NoError(t, b2.Commit(&WriteOptions{Sync: true, CommitCorrelationID: 67890}))
+	b2Seq := b2.SeqNum()
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Equal(t, 2, ev2.JobID)
+	require.Equal(t, b2Seq, ev2.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(67890), ev2.CorrelationID)
+	require.Greater(t, ev2.BatchSize, 0)
+	require.Equal(t, uint32(1), ev2.KeyCount)
+}
