+func TestContextCancellationPrecedence(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	// 1. Normal context cancellation while DB is open.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = d.WaitForDurabilityContext(ctx, 9999)
+	require.Equal(t, context.Canceled, err)
+
+	// 2. Durability/close errors take precedence over context cancellation.
+	require.NoError(t, d.Close())
+	ctx2, cancel2 := context.WithCancel(context.Background())
+	cancel2()
+	err = d.WaitForDurabilityContext(ctx2, 9999)
+	require.Equal(t, ErrClosed, err)
+
+	err = d.WaitForDurabilityBatchContext(ctx2, []base.SeqNum{9999})
+	require.Equal(t, ErrClosed, err)
+
+	err = d.WaitForJobDurabilityContext(ctx2, 1)
+	require.Equal(t, ErrClosed, err)
+}
