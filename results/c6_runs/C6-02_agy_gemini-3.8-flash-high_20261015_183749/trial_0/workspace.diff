+func TestWaitForDurability(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Initial stats: all zero values.
+	stats0 := d.DurabilityStats()
+	require.Equal(t, base.SeqNum(0), stats0.HighestDurableSeqNum)
+	require.NoError(t, stats0.FirstErr)
+	require.Equal(t, int64(0), stats0.PendingWaiters)
+	require.Equal(t, uint64(0), stats0.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats0.TotalFailedCommits)
+	require.Equal(t, time.Duration(0), stats0.CumulativeSyncDuration)
+	require.Equal(t, time.Duration(0), stats0.MaxSyncDuration)
+
+	// WaitForDurability(0) before any commit blocks until any commit happens.
+	zeroDone := make(chan error, 1)
+	go func() {
+		zeroDone <- d.WaitForDurability(0)
+	}()
+
+	// Wait for goroutine to block in wait API.
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 10*time.Millisecond)
+
+	// Commit a sync batch.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("foo"), []byte("bar"), nil))
+	seq := b.SeqNum()
+	require.NoError(t, b.Commit(Sync))
+
+	// Waiter for seq 0 should unblock with nil.
+	select {
+	case err := <-zeroDone:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for WaitForDurability(0)")
+	}
+
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+	require.Equal(t, uint64(1), d.DurabilityStats().TotalDurableCommits)
+	require.GreaterOrEqual(t, d.DurabilityStats().HighestDurableSeqNum, seq)
+
+	// Calling WaitForDurability for already durable seqnum returns nil immediately.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(seq))
+
+	// Wait for a future sequence number.
+	futureSeq := seq + 100
+	futureDone := make(chan error, 1)
+	go func() {
+		futureDone <- d.WaitForDurability(futureSeq)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 2*time.Second, 10*time.Millisecond)
+
+	// Advance commits past futureSeq.
+	for {
+		b2 := d.NewBatch()
+		require.NoError(t, b2.Set([]byte("k"), []byte("v"), nil))
+		require.NoError(t, b2.Commit(Sync))
+		curSeq, _ := d.DurableState()
+		if curSeq >= futureSeq {
+			break
+		}
+	}
+
+	select {
+	case err := <-futureDone:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for future WaitForDurability")
+	}
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
+
+func TestWaitForDurabilityBatch(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
