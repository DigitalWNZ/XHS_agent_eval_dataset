--- /dev/null
+++ b/run.py
@@ -0,0 +1,58 @@
+import asyncio
+from typing import Awaitable, Callable
+
+
+async def run_tasks(
+    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int
+) -> None:
+    """Run ``tasks`` with at most ``max_concurrent`` running at once.
+
+    If run_tasks is cancelled (e.g. Ctrl+C under ``asyncio.run``), every
+    running task is cancelled and awaited so its cleanup code (``finally``,
+    ``async with`` exits, ``except CancelledError``) runs to completion before
+    the cancellation propagates. Tasks that have not started are never started.
+
+    If a task raises, the remaining tasks still run; the first exception is
+    re-raised once everything has finished.
+    """
+    if max_concurrent < 1:
+        raise ValueError("max_concurrent must be >= 1")
+
+    queue = iter(list(tasks))
+    errors: list[BaseException] = []
+
+    async def worker() -> None:
+        for job in queue:
+            try:
+                await job()
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:
+                errors.append(exc)
+
+    workers = [
+        asyncio.create_task(worker())
+        for _ in range(min(max_concurrent, len(tasks)))
+    ]
+    if not workers:
+        return
+
+    try:
+        await asyncio.gather(*workers)
+    except BaseException:
+        # Cancelled (or interrupted): make sure every worker is cancelled and
+        # that its cleanup finishes before we propagate, even if we receive
+        # further cancellations while waiting.
+        for w in workers:
+            w.cancel()
+        while True:
+            try:
+                await asyncio.shield(asyncio.wait(workers))
+                break
+            except asyncio.CancelledError:
+                if all(w.done() for w in workers):
+                    break
+        raise
+
+    if errors:
+        raise errors[0]
