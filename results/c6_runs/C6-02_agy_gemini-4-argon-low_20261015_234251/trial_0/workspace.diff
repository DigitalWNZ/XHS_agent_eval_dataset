+func TestDurabilityErrorAndPrecedenceOverContext(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	fs := newBlockingSyncFS(vfs.NewMem())
+	var events []BatchDurableInfo
+	var mu sync.Mutex
+
+	d, err := Open("", &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// First commit succeeds.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	seq1, err := d.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, seq1, base.SeqNum(0))
+
+	// Register a waiter and notify subscription for the next seqNum.
+	nextSeq := seq1 + 1
+	notifyCh := d.DurabilityNotify(nextSeq)
+	waiterDone := make(chan error, 1)
+	go func() {
+		waiterDone <- d.WaitForDurability(nextSeq)
+	}()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Inject a WAL sync failure on the second commit.
+	injectedErr := errors.New("disk sync failure")
+	fs.mu.Lock()
+	fs.syncErr = injectedErr
+	fs.mu.Unlock()
+
+	err = d.Set([]byte("k2"), []byte("v2"), Sync)
+	require.ErrorIs(t, err, injectedErr)
+
+	// Waiter and notify channel must receive the sync error.
+	require.ErrorIs(t, <-waiterDone, injectedErr)
+	require.ErrorIs(t, <-notifyCh, injectedErr)
+
+	// BatchDurable must have fired twice (once for success, once for failure).
+	mu.Lock()
+	require.Len(t, events, 2)
+	failEvent := events[1]
+	mu.Unlock()
+
+	require.Equal(t, 2, failEvent.JobID)
+	require.Equal(t, nextSeq, failEvent.SeqNum)
+	require.ErrorIs(t, failEvent.Err, injectedErr)
+
+	// DurableState and DurabilityStats reflect the latched error.
+	durSeq, durErr := d.DurableState()
+	require.Equal(t, seq1, durSeq)
+	require.ErrorIs(t, durErr, injectedErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, seq1, stats.HighestDurableSeqNum)
+	require.ErrorIs(t, stats.FirstErr, injectedErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+
+	// Durability errors take precedence over context cancellation!
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	require.ErrorIs(t, d.WaitForDurabilityContext(canceledCtx, nextSeq), injectedErr)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(canceledCtx, []base.SeqNum{nextSeq}), injectedErr)
+	require.ErrorIs(t, d.WaitForJobDurabilityContext(canceledCtx, 2), injectedErr)
+}
