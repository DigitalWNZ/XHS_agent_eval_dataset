+// blockingSyncFS wraps a vfs.FS and allows tests to intercept and block WAL
+// Sync/SyncData operations.
+type blockingSyncFS struct {
+	vfs.FS
+	mu          sync.Mutex
+	blockWAL    bool
+	syncEntered chan struct{}
+	syncRelease chan struct{}
+	syncErr     error
+}
+
+func newBlockingSyncFS(inner vfs.FS) *blockingSyncFS {
+	return &blockingSyncFS{
+		FS:          inner,
+		syncEntered: make(chan struct{}, 16),
+		syncRelease: make(chan struct{}),
+	}
+}
+
+func (fs *blockingSyncFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	if strings.HasSuffix(name, ".log") {
+		return &blockingSyncFile{File: f, fs: fs}, nil
+	}
+	return f, nil
+}
+
+func (fs *blockingSyncFS) ReuseForWrite(
+	oldname, newname string, category vfs.DiskWriteCategory,
+) (vfs.File, error) {
+	f, err := fs.FS.ReuseForWrite(oldname, newname, category)
+	if err != nil {
+		return nil, err
+	}
+	if strings.HasSuffix(newname, ".log") {
+		return &blockingSyncFile{File: f, fs: fs}, nil
+	}
+	return f, nil
+}
+
+type blockingSyncFile struct {
+	vfs.File
+	fs *blockingSyncFS
+}
+
+func (f *blockingSyncFile) interceptSync() (bool, error) {
+	f.fs.mu.Lock()
+	block := f.fs.blockWAL
+	rel := f.fs.syncRelease
+	syncErr := f.fs.syncErr
+	f.fs.mu.Unlock()
+
+	if block {
+		select {
+		case f.fs.syncEntered <- struct{}{}:
+		default:
+		}
+		<-rel
+		f.fs.mu.Lock()
+		syncErr = f.fs.syncErr
+		f.fs.mu.Unlock()
+	}
+	if syncErr != nil {
+		return true, syncErr
+	}
+	return false, nil
+}
+
+func (f *blockingSyncFile) Sync() error {
+	if handled, err := f.interceptSync(); handled {
+		return err
+	}
+	return f.File.Sync()
+}
+
+func (f *blockingSyncFile) SyncData() error {
+	if handled, err := f.interceptSync(); handled {
+		return err
+	}
+	return f.File.SyncData()
+}
