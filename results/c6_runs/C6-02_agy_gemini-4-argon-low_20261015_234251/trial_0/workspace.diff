--- /dev/null
+++ b/durability.go
@@ -0,0 +1,605 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// maxRetainedDurabilityJobs is the capacity of the ring buffer retaining
+	// recent sync commit job outcomes for WaitForJobDurability.
+	maxRetainedDurabilityJobs = 4096
+
+	// maxDurabilityNotifySubs is the maximum number of concurrent outstanding
+	// DurabilityNotify channel subscriptions.
+	maxDurabilityNotifySubs = 1024
+)
+
+var (
+	// ErrDurabilityJobUnknown is returned by WaitForJobDurability when a job ID
+	// is zero, negative, or has never been assigned.
+	ErrDurabilityJobUnknown = errors.New("pebble: durability job ID is unknown")
+
+	// ErrDurabilityJobExpired is returned by WaitForJobDurability when a job ID
+	// has aged out of the bounded retention window.
+	ErrDurabilityJobExpired = errors.New("pebble: durability job ID has expired")
+
+	// ErrDurabilityNotifyLimitExceeded is delivered on the channel returned by
+	// DurabilityNotify when the bound on outstanding subscriptions is exceeded.
+	ErrDurabilityNotifyLimitExceeded = errors.New("pebble: durability notify subscription limit exceeded")
+)
+
+// DurabilityStats holds a point-in-time snapshot of durability tracking
+// statistics for the DB.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJobState uint8
+
+const (
+	durabilityJobUnused durabilityJobState = iota
+	durabilityJobPending
+	durabilityJobDone
+)
+
+type durabilityJobSlot struct {
+	jobID    int
+	state    durabilityJobState
+	err      error
+	done     chan struct{}
+	waiters  int64
+}
+
+type seqWaiter struct {
+	seqNum    base.SeqNum
+	ch        chan struct{}
+	unblocked bool
+}
+
+type notifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityTracker struct {
+	disableWAL             bool
+	batchDurableConfigured atomic.Bool
+
+	nextJobID      atomic.Int64
+	pendingWaiters atomic.Int64
+
+	// Metrics accumulated only when BatchDurable is configured.
+	metricCommitCount    atomic.Uint64
+	metricCommitDuration atomic.Int64
+
+	mu struct {
+		sync.Mutex
+
+		closed                 bool
+		closeErr               error
+		firstErr               error
+		highestDurableSeqNum   base.SeqNum
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		// Ring buffer of recent job states.
+		jobs             [maxRetainedDurabilityJobs]durabilityJobSlot
+		maxAssignedJobID int
+
+		// Waiters blocked on WaitForDurability*
+		seqWaiters []*seqWaiter
+
+		// Outstanding DurabilityNotify subscriptions (bounded by maxDurabilityNotifySubs).
+		notifySubs []*notifySub
+	}
+}
+
+func (t *durabilityTracker) init(disableWAL bool, batchDurableConfigured bool) {
+	t.disableWAL = disableWAL
+	t.batchDurableConfigured.Store(batchDurableConfigured)
+}
+
+func (t *durabilityTracker) setBatchDurableConfigured(configured bool) {
+	if configured {
+		t.batchDurableConfigured.Store(true)
+	}
+}
+
+// registerJob assigns a new JobID for a sync commit and records it as pending
+// in the retention window.
+func (t *durabilityTracker) registerJob() int {
+	jobID := int(t.nextJobID.Add(1))
+	t.mu.Lock()
+	if jobID > t.mu.maxAssignedJobID {
+		t.mu.maxAssignedJobID = jobID
+	}
+	idx := jobID % maxRetainedDurabilityJobs
+	old := &t.mu.jobs[idx]
+	// If an old pending job is somehow being evicted, unblock its waiters.
+	if old.state == durabilityJobPending && old.done != nil {
+		old.state = durabilityJobDone
+		old.err = ErrDurabilityJobExpired
+		if old.waiters > 0 {
+			t.pendingWaiters.Add(-old.waiters)
+			old.waiters = 0
+		}
+		close(old.done)
+	}
+	*old = durabilityJobSlot{
+		jobID: jobID,
+		state: durabilityJobPending,
+	}
+	t.mu.Unlock()
+	return jobID
+}
+
+// recordCompletion updates the durability tracker after a sync commit's WAL
+// sync completes (either in Commit or in Batch.SyncWait) and invokes the
+// EventListener.BatchDurable callback.
+func (t *durabilityTracker) recordCompletion(info BatchDurableInfo, callback func(BatchDurableInfo)) {
+	t.mu.Lock()
+	if info.Err != nil {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = info.Err
+		}
+	} else {
+		t.mu.totalDurableCommits++
+		if info.SeqNum > t.mu.highestDurableSeqNum {
+			t.mu.highestDurableSeqNum = info.SeqNum
+		}
+		t.mu.cumulativeSyncDuration += info.SyncDuration
+		if info.SyncDuration > t.mu.maxSyncDuration {
+			t.mu.maxSyncDuration = info.SyncDuration
+		}
+	}
+
+	if t.batchDurableConfigured.Load() {
+		t.metricCommitCount.Add(1)
+		t.metricCommitDuration.Add(int64(info.SyncDuration))
+	}
+
+	// Update job slot if still within retention window.
+	if info.JobID > 0 {
+		if info.JobID > t.mu.maxAssignedJobID {
+			t.mu.maxAssignedJobID = info.JobID
+		}
+		idx := info.JobID % maxRetainedDurabilityJobs
+		slot := &t.mu.jobs[idx]
+		if slot.jobID == info.JobID {
+			slot.state = durabilityJobDone
+			slot.err = info.Err
+			if slot.waiters > 0 {
+				t.pendingWaiters.Add(-slot.waiters)
+				slot.waiters = 0
+			}
+			if slot.done != nil {
+				close(slot.done)
+				slot.done = nil
+			}
+		} else if info.JobID > slot.jobID {
+			if slot.state == durabilityJobPending && slot.done != nil {
+				slot.state = durabilityJobDone
+				slot.err = ErrDurabilityJobExpired
+				if slot.waiters > 0 {
+					t.pendingWaiters.Add(-slot.waiters)
+					slot.waiters = 0
+				}
+				close(slot.done)
+			}
+			*slot = durabilityJobSlot{
+				jobID: info.JobID,
+				state: durabilityJobDone,
+				err:   info.Err,
+			}
+		}
+	}
+
+	t.wakeWaitersLocked()
+	t.mu.Unlock()
+
+	if callback != nil {
+		callback(info)
+	}
+}
+
+func (t *durabilityTracker) close(closeErr error) {
+	if closeErr == nil {
+		closeErr = ErrClosed
+	}
+	t.mu.Lock()
+	if t.mu.closed {
+		t.mu.Unlock()
+		return
+	}
+	t.mu.closed = true
+	t.mu.closeErr = closeErr
+
+	// Unblock any pending job waiters.
+	for i := range t.mu.jobs {
+		slot := &t.mu.jobs[i]
+		if slot.state == durabilityJobPending && slot.done != nil {
+			if slot.waiters > 0 {
+				t.pendingWaiters.Add(-slot.waiters)
+				slot.waiters = 0
+			}
+			close(slot.done)
+			slot.done = nil
+		}
+	}
+
+	t.wakeWaitersLocked()
+	t.mu.Unlock()
+}
+
+func (t *durabilityTracker) isSeqDurableLocked(seqNum base.SeqNum) bool {
+	if seqNum == 0 {
+		return t.mu.totalDurableCommits > 0 || t.mu.highestDurableSeqNum > 0
+	}
+	return t.mu.highestDurableSeqNum >= seqNum
+}
+
+func (t *durabilityTracker) fatalErrLocked() error {
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr
+	}
+	if t.mu.closed {
+		return t.mu.closeErr
+	}
+	return nil
+}
+
+func (t *durabilityTracker) wakeWaitersLocked() {
+	fatalErr := t.fatalErrLocked()
+
+	// Wake seqWaiters.
+	if fatalErr != nil {
+		for _, w := range t.mu.seqWaiters {
+			if !w.unblocked {
+				w.unblocked = true
+				t.pendingWaiters.Add(-1)
+				close(w.ch)
+			}
+		}
+		t.mu.seqWaiters = t.mu.seqWaiters[:0]
+	} else {
+		n := 0
+		for _, w := range t.mu.seqWaiters {
+			if t.isSeqDurableLocked(w.seqNum) {
+				if !w.unblocked {
+					w.unblocked = true
+					t.pendingWaiters.Add(-1)
+					close(w.ch)
+				}
+			} else {
+				t.mu.seqWaiters[n] = w
+				n++
+			}
+		}
+		for i := n; i < len(t.mu.seqWaiters); i++ {
+			t.mu.seqWaiters[i] = nil
+		}
+		t.mu.seqWaiters = t.mu.seqWaiters[:n]
+	}
+
+	// Wake notifySubs.
+	if fatalErr != nil {
+		for _, sub := range t.mu.notifySubs {
+			sub.ch <- fatalErr
+		}
+		t.mu.notifySubs = t.mu.notifySubs[:0]
+	} else {
+		n := 0
+		for _, sub := range t.mu.notifySubs {
+			if t.isSeqDurableLocked(sub.seqNum) {
+				sub.ch <- nil
+			} else {
+				t.mu.notifySubs[n] = sub
+				n++
+			}
+		}
+		for i := n; i < len(t.mu.notifySubs); i++ {
+			t.mu.notifySubs[i] = nil
+		}
+		t.mu.notifySubs = t.mu.notifySubs[:n]
+	}
+}
+
+func (t *durabilityTracker) removeSeqWaiterLocked(target *seqWaiter) {
+	if !target.unblocked {
+		target.unblocked = true
+		t.pendingWaiters.Add(-1)
+	}
+	for i, w := range t.mu.seqWaiters {
+		if w == target {
+			last := len(t.mu.seqWaiters) - 1
+			t.mu.seqWaiters[i] = t.mu.seqWaiters[last]
+			t.mu.seqWaiters[last] = nil
+			t.mu.seqWaiters = t.mu.seqWaiters[:last]
+			return
+		}
+	}
+}
+
+func (t *durabilityTracker) waitForSeq(ctx context.Context, seqNum base.SeqNum) error {
+	if t.disableWAL {
+		return nil
+	}
+
+	t.mu.Lock()
+	if err := t.fatalErrLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		t.mu.Unlock()
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     make(chan struct{}),
+	}
+	t.mu.seqWaiters = append(t.mu.seqWaiters, w)
+	t.pendingWaiters.Add(1)
+	t.mu.Unlock()
+
+	select {
+	case <-w.ch:
+		t.mu.Lock()
+		err := t.fatalErrLocked()
+		t.mu.Unlock()
+		return err
+	case <-ctx.Done():
+		t.mu.Lock()
+		t.removeSeqWaiterLocked(w)
+		// Durability/close errors take precedence over context cancellation.
+		if err := t.fatalErrLocked(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+		if t.isSeqDurableLocked(seqNum) {
+			t.mu.Unlock()
+			return nil
+		}
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) waitForJob(ctx context.Context, jobID int) error {
+	if t.disableWAL {
+		return nil
+	}
+
+	t.mu.Lock()
+	if err := t.fatalErrLocked(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if jobID <= 0 || jobID > t.mu.maxAssignedJobID {
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", errors.Safe(jobID))
+	}
+	oldestRetained := t.mu.maxAssignedJobID - maxRetainedDurabilityJobs + 1
+	if jobID < oldestRetained {
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobExpired, "job %d (oldest retained %d)", errors.Safe(jobID), errors.Safe(oldestRetained))
+	}
+	idx := jobID % maxRetainedDurabilityJobs
+	slot := &t.mu.jobs[idx]
+	if slot.jobID != jobID || slot.state == durabilityJobUnused {
+		if slot.jobID > jobID {
+			t.mu.Unlock()
+			return errors.Wrapf(ErrDurabilityJobExpired, "job %d", errors.Safe(jobID))
+		}
+		t.mu.Unlock()
+		return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", errors.Safe(jobID))
+	}
+	if slot.state == durabilityJobDone {
+		err := slot.err
+		if err == nil {
+			err = t.fatalErrLocked()
+		}
+		t.mu.Unlock()
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	if slot.done == nil {
+		slot.done = make(chan struct{})
+	}
+	doneCh := slot.done
+	slot.waiters++
+	t.pendingWaiters.Add(1)
+	t.mu.Unlock()
+
+	select {
+	case <-doneCh:
+		t.mu.Lock()
+		slot := &t.mu.jobs[idx]
+		if slot.jobID == jobID && slot.waiters > 0 {
+			slot.waiters--
+			t.pendingWaiters.Add(-1)
+		}
+		if err := t.fatalErrLocked(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+		if slot.jobID != jobID {
+			t.mu.Unlock()
+			return errors.Wrapf(ErrDurabilityJobExpired, "job %d", errors.Safe(jobID))
+		}
+		err := slot.err
+		t.mu.Unlock()
+		return err
+	case <-ctx.Done():
+		t.mu.Lock()
+		slot := &t.mu.jobs[idx]
+		if slot.jobID == jobID && slot.waiters > 0 {
+			slot.waiters--
+			t.pendingWaiters.Add(-1)
+		}
+		// Durability/close errors take precedence over context cancellation.
+		if err := t.fatalErrLocked(); err != nil {
+			t.mu.Unlock()
+			return err
+		}
+		if slot.jobID == jobID && slot.state == durabilityJobDone {
+			err := slot.err
+			t.mu.Unlock()
+			return err
+		}
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+}
+
+func (t *durabilityTracker) notify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if t.disableWAL {
+		ch <- nil
+		return ch
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if err := t.fatalErrLocked(); err != nil {
+		ch <- err
+		return ch
+	}
+	if t.isSeqDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(t.mu.notifySubs) >= maxDurabilityNotifySubs {
+		ch <- ErrDurabilityNotifyLimitExceeded
+		return ch
+	}
+	t.mu.notifySubs = append(t.mu.notifySubs, &notifySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+func (t *durabilityTracker) durableState() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeqNum, t.mu.firstErr
+}
+
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeqNum,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.pendingWaiters.Load(),
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+// WaitForDurability blocks until the specified sequence number is durable on
+// disk, or returns an error if a WAL sync fails or the DB is closed. A sequence
+// number of zero succeeds after any durable commit. When DisableWAL is true,
+// WaitForDurability returns nil immediately.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the specified sequence number is
+// durable on disk, the context is cancelled, a WAL sync fails, or the DB is
+// closed. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.waitForSeq(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable on disk. A nil or empty slice returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in seqNums
+// is durable on disk, the context is cancelled, a WAL sync fails, or the DB is
+// closed. A nil or empty slice returns nil immediately. Durability and close
+// errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	if d.opts.DisableWAL {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.durability.waitForSeq(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the sync commit identified by jobID is
+// durable on disk. Jobs outside the bounded retention window return an
+// "expired" error; never-seen and zero IDs return an "unknown" error.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the sync commit identified by jobID
+// is durable on disk, the context is cancelled, a WAL sync fails, or the DB is
+// closed. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durability.waitForJob(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched WAL sync error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when
+// seqNum becomes durable, or a non-nil error on WAL sync failure, DB close, or
+// when the bound on outstanding subscriptions is exceeded.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.notify(seqNum)
+}
+
+// DurabilityStats returns a point-in-time snapshot of durability tracking
+// statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
