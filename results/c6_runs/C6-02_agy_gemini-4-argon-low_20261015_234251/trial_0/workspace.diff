+func (b *Batch) completeDurability(syncDuration time.Duration, err error) {
+	if !b.syncWAL || b.durableRecorded || b.durableJobID <= 0 {
+		return
+	}
+	b.durableRecorded = true
+	db := b.db
+	if db == nil {
+		return
+	}
+	if syncDuration <= 0 {
+		syncDuration = time.Nanosecond
+	}
+	applyDuration := b.applyDuration
+	if applyDuration <= 0 {
+		applyDuration = time.Nanosecond
+	}
+	info := BatchDurableInfo{
+		JobID:         b.durableJobID,
+		SeqNum:        b.durableSeqNum,
+		Err:           err,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: b.commitCorrelationID,
+		BatchSize:     b.durableBatchSize,
+		KeyCount:      b.durableKeyCount,
+	}
+	var cb func(BatchDurableInfo)
+	if db.opts != nil && db.opts.EventListener != nil {
+		cb = db.opts.EventListener.BatchDurable
+	}
+	db.durability.recordCompletion(info, cb)
+}
