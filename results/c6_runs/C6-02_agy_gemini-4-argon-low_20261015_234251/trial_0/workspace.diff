+func TestDurabilityWaitersUnblockOnCloseAndClosePrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+	})
+	require.NoError(t, err)
+
+	const numWaiters = 5
+	waitErrs := make(chan error, numWaiters)
+	for i := 0; i < numWaiters; i++ {
+		go func(idx int) {
+			waitErrs <- d.WaitForDurability(base.SeqNum(100 + idx))
+		}(i)
+	}
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == numWaiters
+	}, 5*time.Second, time.Millisecond)
+
+	require.NoError(t, d.Close())
+
+	for i := 0; i < numWaiters; i++ {
+		err := <-waitErrs
+		require.Error(t, err)
+	}
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Close error takes precedence over cancelled context.
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err = d.WaitForDurabilityContext(canceledCtx, 100)
+	require.ErrorIs(t, err, ErrClosed)
+
+	err = d.WaitForDurabilityBatchContext(canceledCtx, []base.SeqNum{100})
+	require.ErrorIs(t, err, ErrClosed)
+
+	err = d.WaitForJobDurabilityContext(canceledCtx, 1)
+	require.ErrorIs(t, err, ErrClosed)
+}
