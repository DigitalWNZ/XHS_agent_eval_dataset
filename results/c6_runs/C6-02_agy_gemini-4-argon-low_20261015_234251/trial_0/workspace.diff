+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	fs := newBlockingSyncFS(vfs.NewMem())
+	var lastJobID atomic.Int64
+
+	d, err := Open("", &Options{
+		FS: fs,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID.Store(int64(info.JobID))
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Zero, negative, and never-seen IDs return an "unknown" error.
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(-5)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	err = d.WaitForJobDurability(999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	// Block WAL sync to test waiting on an in-flight job.
+	fs.mu.Lock()
+	fs.blockWAL = true
+	fs.syncRelease = make(chan struct{})
+	fs.mu.Unlock()
+
+	commitDone := make(chan error, 1)
+	go func() {
+		commitDone <- d.Set([]byte("in-flight"), []byte("val"), Sync)
+	}()
+
+	<-fs.syncEntered
+
+	// Job 1 is now in-flight. WaitForJobDurability(1) should block until WAL sync completes.
+	jobWaitDone := make(chan error, 1)
+	go func() {
+		jobWaitDone <- d.WaitForJobDurability(1)
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Release the WAL sync.
+	fs.mu.Lock()
+	fs.blockWAL = false
+	close(fs.syncRelease)
+	fs.mu.Unlock()
+
+	require.NoError(t, <-commitDone)
+	require.NoError(t, <-jobWaitDone)
+	require.Equal(t, int64(1), lastJobID.Load())
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// Waiting on already-completed job 1 succeeds immediately.
+	require.NoError(t, d.WaitForJobDurability(1))
+
+	// Advance past the retention window so job 1 expires.
+	for i := 0; i < maxRetainedDurabilityJobs+10; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	// Job 1 is now expired.
+	err = d.WaitForJobDurability(1)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+
+	// Recent job still succeeds.
+	recentJob := int(lastJobID.Load())
+	require.NoError(t, d.WaitForJobDurability(recentJob))
+
+	// Never-seen job ID > recentJob returns "unknown".
+	err = d.WaitForJobDurability(recentJob + 100)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+}
