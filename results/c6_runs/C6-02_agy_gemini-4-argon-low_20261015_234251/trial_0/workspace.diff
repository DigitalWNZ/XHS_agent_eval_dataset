+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Commit one batch so seq 10 is durable.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seq1 := b.SeqNum()
+	_ = b.Close()
+
+	// Already durable seqNum returns pre-filled channel with nil.
+	chDone := d.DurabilityNotify(seq1)
+	select {
+	case err := <-chDone:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel for already durable seqNum")
+	}
+
+	// Subscribe up to the bound for a future seqNum.
+	futureSeq := seq1 + 100
+	subs := make([]<-chan error, maxDurabilityNotifySubs)
+	for i := 0; i < maxDurabilityNotifySubs; i++ {
+		subs[i] = d.DurabilityNotify(futureSeq)
+	}
+
+	// Excess caller gets a pre-filled channel with an immediate non-nil error.
+	excessCh := d.DurabilityNotify(futureSeq)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected pre-filled error channel when subscription limit exceeded")
+	}
+
+	// Close DB and verify all outstanding notify channels receive a non-nil error.
+	require.NoError(t, d.Close())
+	d = nil
+
+	for i, ch := range subs {
+		select {
+		case err := <-ch:
+			require.Error(t, err, "sub %d should receive error on close", i)
+		case <-time.After(time.Second):
+			t.Fatalf("sub %d did not receive error on close", i)
+		}
+	}
+}
