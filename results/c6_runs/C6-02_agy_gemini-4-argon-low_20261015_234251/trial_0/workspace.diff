+func TestBatchDurableCallbackBasic(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				events = append(events, info)
+				mu.Unlock()
+			},
+		},
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Initial state before any commits.
+	seq, stateErr := d.DurableState()
+	require.Equal(t, base.SeqNum(0), seq)
+	require.NoError(t, stateErr)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, DurabilityStats{}, stats)
+
+	m := d.Metrics()
+	require.Equal(t, uint64(0), m.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m.DurableCommitDuration)
+
+	// Non-sync commits must NOT trigger BatchDurable.
+	require.NoError(t, d.Set([]byte("nosync1"), []byte("val1"), NoSync))
+	bNoSync := d.NewBatch()
+	require.NoError(t, bNoSync.Set([]byte("nosync2"), []byte("val2"), nil))
+	require.NoError(t, d.Apply(bNoSync, NoSync))
+	_ = bNoSync.Close()
+
+	mu.Lock()
+	require.Empty(t, events)
+	mu.Unlock()
+
+	// Sync commit with CorrelationID and multiple keys.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, b.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, b.Delete([]byte("k3"), nil))
+	expectedSize := b.Len()
+	expectedCount := b.Count()
+	require.Equal(t, uint32(3), expectedCount)
+
+	writeOpts := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 424242,
+	}
+	require.NoError(t, d.Apply(b, writeOpts))
+	batchSeq := b.SeqNum()
+	_ = b.Close()
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	info := events[0]
+	mu.Unlock()
+
+	require.Greater(t, info.JobID, 0)
+	require.Equal(t, batchSeq, info.SeqNum)
+	require.NoError(t, info.Err)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(424242), info.CorrelationID)
+	require.Equal(t, expectedSize, info.BatchSize)
+	require.Equal(t, expectedCount, info.KeyCount)
+
+	// Second Sync commit via ApplyNoSyncWait + SyncWait.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k4"), []byte("v4"), nil))
+	expectedSize2 := b2.Len()
+	require.NoError(t, d.ApplyNoSyncWait(b2, &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 99,
+	}))
+	require.NoError(t, b2.SyncWait())
+	// Calling SyncWait a second time must not fire BatchDurable again.
+	require.NoError(t, b2.SyncWait())
+	batchSeq2 := b2.SeqNum()
+	_ = b2.Close()
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	info2 := events[1]
+	mu.Unlock()
+
+	require.Greater(t, info2.JobID, info.JobID)
+	require.Equal(t, batchSeq2, info2.SeqNum)
+	require.NoError(t, info2.Err)
+	require.Greater(t, info2.ApplyDuration, time.Duration(0))
+	require.Greater(t, info2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(99), info2.CorrelationID)
+	require.Equal(t, expectedSize2, info2.BatchSize)
+	require.Equal(t, uint32(1), info2.KeyCount)
+
+	// Check DurableState, DurabilityStats, and Metrics.
+	seq, stateErr = d.DurableState()
+	require.Equal(t, batchSeq2, seq)
+	require.NoError(t, stateErr)
+
+	stats = d.DurabilityStats()
+	require.Equal(t, batchSeq2, stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(2), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, info.SyncDuration+info2.SyncDuration, stats.CumulativeSyncDuration)
+	require.Equal(t, max(info.SyncDuration, info2.SyncDuration), stats.MaxSyncDuration)
+
+	m = d.Metrics()
+	require.Equal(t, uint64(2), m.DurableCommitCount)
+	require.Equal(t, info.SyncDuration+info2.SyncDuration, m.DurableCommitDuration)
+}
