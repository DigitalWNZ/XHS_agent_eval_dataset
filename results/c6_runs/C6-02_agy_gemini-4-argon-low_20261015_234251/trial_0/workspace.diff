+func TestWaitForDurabilityAndBatch(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+	})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			require.NoError(t, d.Close())
+		}
+	}()
+
+	// Nil and empty slices return nil immediately even before any commits.
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), nil))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{}))
+
+	// WaitForDurability(0) blocks before any commits, then succeeds after any commit.
+	waitZeroDone := make(chan error, 1)
+	go func() {
+		waitZeroDone <- d.WaitForDurability(0)
+	}()
+
+	// Wait until PendingWaiters reflects the blocked goroutine.
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Perform first Sync commit.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, d.Apply(b1, Sync))
+	seq1 := b1.SeqNum()
+	_ = b1.Close()
+
+	require.NoError(t, <-waitZeroDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+
+	// WaitForDurability(0) and WaitForDurability(seq1) now succeed immediately.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(seq1))
+
+	// WaitForDurabilityBatch waiting on a future seqNum.
+	futureSeq := seq1 + 2
+	batchWaitDone := make(chan error, 1)
+	go func() {
+		batchWaitDone <- d.WaitForDurabilityBatch([]base.SeqNum{seq1, futureSeq})
+	}()
+
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+
+	// Commit seq1 + 1 (not enough to satisfy futureSeq).
+	require.NoError(t, d.Set([]byte("k2"), []byte("v2"), Sync))
+	select {
+	case err := <-batchWaitDone:
+		t.Fatalf("unexpected early completion: %v", err)
+	case <-time.After(10 * time.Millisecond):
+	}
+
+	// Commit seq1 + 2 (satisfies futureSeq).
+	require.NoError(t, d.Set([]byte("k3"), []byte("v3"), Sync))
+	require.NoError(t, <-batchWaitDone)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
