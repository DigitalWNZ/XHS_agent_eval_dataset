+			.orderBy(gelUsers.id);
+		expect(gelQ.toSQL().sql).toBe(
+			'select row_number() over "w1" from "users" window "w1" as (partition by "users"."department"), "w2" as (order by "users"."salary") order by "users"."id"',
+		);
+	});
+
+	describe('Constraints', () => {
+		it('Numeric positional arguments must never become bound query parameters, even when zero', () => {
