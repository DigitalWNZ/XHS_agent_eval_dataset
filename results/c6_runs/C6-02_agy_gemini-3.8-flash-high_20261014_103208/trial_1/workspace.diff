diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..b7ea14c1
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,377 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { SelectionProxyHandler } from '~/selection-proxy.ts';
+import { isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+import type { ValueOrArray } from '~/utils.ts';
+
+export type GetExpressionType<T> = T extends Column
+	? T['_']['data']
+	: T extends SQL<infer U>
+	? U
+	: T extends SQL.Aliased<infer U>
+	? U
+	: T extends SQLWrapper
+	? unknown
+	: T;
+
+export interface FrameBoundary extends SQLWrapper {
+	readonly offset: number;
+	readonly sqlChunk: SQL;
+}
+
+export class FrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'FrameBoundary';
+
+	constructor(
+		readonly offset: number,
+		readonly sqlChunk: SQL,
+	) {}
+
+	getSQL(): SQL {
+		return this.sqlChunk;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export const unboundedPreceding: FrameBoundary = new FrameBoundary(-Infinity, sql`unbounded preceding`);
+export const currentRow: FrameBoundary = new FrameBoundary(0, sql`current row`);
+export const unboundedFollowing: FrameBoundary = new FrameBoundary(Infinity, sql`unbounded following`);
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding: expected a non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundary(-offset, sql`${sql.raw(String(offset))} preceding`);
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following: expected a non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundary(offset, sql`${sql.raw(String(offset))} following`);
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class FrameBuilder implements SQLWrapper {
+	static readonly [entityKind]: string = 'FrameBuilder';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly spec: FrameSpec,
+	) {
+		if (!spec || !spec.from) {
+			throw new Error('Frame specification must include a "from" boundary');
+		}
+		if (spec.to !== undefined && spec.from.offset > spec.to.offset) {
+			throw new Error('Frame "from" boundary cannot be ordered after "to" boundary');
+		}
+		if (spec.to === undefined && spec.from.offset > 0) {
+			throw new Error('Frame "from" boundary cannot be ordered after "to" boundary');
+		}
+	}
+
+	getSQL(): SQL {
+		if (this.spec.to !== undefined) {
+			return sql`${sql.raw(this.type)} between ${this.spec.from} and ${this.spec.to}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.spec.from}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+export function rows(spec: FrameSpec): FrameBuilder {
+	return new FrameBuilder('rows', spec);
+}
+
+export function range(spec: FrameSpec): FrameBuilder {
+	return new FrameBuilder('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<SQL | SQLWrapper>;
+	orderBy?: ValueOrArray<SQL | SQLWrapper>;
+	frame?: SQL | SQLWrapper;
+}
+
+export function compileWindowSpec(spec: WindowSpec): SQL {
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionByList = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionByList.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderByList = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderByList.length > 0) {
+			parts.push(sql`order by ${sql.join(orderByList, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		const frameSql = isSQLWrapper(spec.frame) ? spec.frame.getSQL() : (spec.frame as any);
+		parts.push(frameSql);
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export class WindowBuilder<TValue> {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	constructor(private readonly sqlChunk: SQL<TValue>) {}
+
+	over(windowOrSpec?: WindowSpec | string | SQL): SQL<TValue> {
+		let overClause: SQL;
+
+		if (windowOrSpec === undefined) {
+			overClause = sql`over ()`;
+		} else if (typeof windowOrSpec === 'string') {
+			if (windowOrSpec.length === 0) {
+				throw new Error('Window name must be non-empty');
+			}
+			if (windowOrSpec.trim().length === 0) {
+				throw new Error('Window name cannot be whitespace-only');
+			}
+			overClause = sql`over ${sql.identifier(windowOrSpec)}`;
+		} else if (is(windowOrSpec, SQL)) {
+			overClause = sql`over (${windowOrSpec})`;
+		} else {
+			const specSql = compileWindowSpec(windowOrSpec);
+			if (specSql.queryChunks.length === 0) {
+				overClause = sql`over ()`;
+			} else {
+				overClause = sql`over (${specSql})`;
+			}
+		}
+
+		const result = sql`${this.sqlChunk} ${overClause}`;
+		result.decoder = this.sqlChunk.decoder;
+		return result as SQL<TValue>;
+	}
+}
+
+// --- Ranking helpers ---
+
+export function rowNumber(): WindowBuilder<number> {
+	return new WindowBuilder(sql`row_number()`.mapWith(Number));
+}
+
+export function rank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`rank()`.mapWith(Number));
+}
+
+export function denseRank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`dense_rank()`.mapWith(Number));
+}
+
+export function ntile(n: number, ..._rest: unknown[]): WindowBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile: expected a positive integer, received ${n}`);
+	}
+	return new WindowBuilder(sql`ntile(${sql.raw(String(n))})`.mapWith(Number));
+}
+
+export function percentRank(): WindowBuilder<number> {
+	return new WindowBuilder(sql`percent_rank()`.mapWith(Number));
+}
+
+export function cumeDist(): WindowBuilder<number> {
+	return new WindowBuilder(sql`cume_dist()`.mapWith(Number));
+}
+
+// --- Offset helpers ---
+
+export function lag<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | SQLWrapper | undefined,
+	defaultValue: TDefault,
+	...rest: unknown[]
+): WindowBuilder<Exclude<GetExpressionType<T>, null> | TDefault>;
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number | SQLWrapper,
+	...rest: unknown[]
+): WindowBuilder<GetExpressionType<T> | null>;
+
+export function lag(
+	expression: SQLWrapper,
+	offset?: number | SQLWrapper,
+	defaultValue?: unknown,
+	..._rest: unknown[]
+): WindowBuilder<any> {
+	let chunk: SQL;
+
+	if (offset !== undefined && defaultValue !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+		const defaultSql = typeof defaultValue === 'number' ? sql.raw(String(defaultValue)) : defaultValue;
+		chunk = sql`lag(${expression}, ${offsetSql}, ${defaultSql})`;
+	} else if (offset !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+		chunk = sql`lag(${expression}, ${offsetSql})`;
+	} else if (defaultValue !== undefined) {
+		const defaultSql = typeof defaultValue === 'number' ? sql.raw(String(defaultValue)) : defaultValue;
+		chunk = sql`lag(${expression}, 1, ${defaultSql})`;
+	} else {
+		chunk = sql`lag(${expression})`;
+	}
+
+	if (is(expression, Column)) {
+		chunk.decoder = expression;
+	}
+
+	return new WindowBuilder(chunk);
+}
+
+export function lead<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | SQLWrapper | undefined,
+	defaultValue: TDefault,
+	...rest: unknown[]
+): WindowBuilder<Exclude<GetExpressionType<T>, null> | TDefault>;
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number | SQLWrapper,
+	...rest: unknown[]
+): WindowBuilder<GetExpressionType<T> | null>;
+
+export function lead(
+	expression: SQLWrapper,
+	offset?: number | SQLWrapper,
+	defaultValue?: unknown,
+	..._rest: unknown[]
+): WindowBuilder<any> {
+	let chunk: SQL;
+
+	if (offset !== undefined && defaultValue !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+		const defaultSql = typeof defaultValue === 'number' ? sql.raw(String(defaultValue)) : defaultValue;
+		chunk = sql`lead(${expression}, ${offsetSql}, ${defaultSql})`;
+	} else if (offset !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+		chunk = sql`lead(${expression}, ${offsetSql})`;
+	} else if (defaultValue !== undefined) {
+		const defaultSql = typeof defaultValue === 'number' ? sql.raw(String(defaultValue)) : defaultValue;
+		chunk = sql`lead(${expression}, 1, ${defaultSql})`;
+	} else {
+		chunk = sql`lead(${expression})`;
+	}
+
+	if (is(expression, Column)) {
+		chunk.decoder = expression;
+	}
+
+	return new WindowBuilder(chunk);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+	..._rest: unknown[]
+): WindowBuilder<GetExpressionType<T> | null> {
+	const chunk = sql`first_value(${expression})`;
+	if (is(expression, Column)) {
+		chunk.decoder = expression;
+	}
+	return new WindowBuilder(chunk as any);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+	..._rest: unknown[]
+): WindowBuilder<GetExpressionType<T> | null> {
+	const chunk = sql`last_value(${expression})`;
+	if (is(expression, Column)) {
+		chunk.decoder = expression;
+	}
+	return new WindowBuilder(chunk as any);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+	..._rest: unknown[]
+): WindowBuilder<GetExpressionType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue: expected a positive integer, received ${n}`);
+	}
+	const chunk = sql`nth_value(${expression}, ${sql.raw(String(n))})`;
+	if (is(expression, Column)) {
+		chunk.decoder = expression;
+	}
+	return new WindowBuilder(chunk as any);
+}
+
+// --- Aggregates ---
+
+export function windowSum(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`sum(${expression})`.mapWith(String));
+}
+
+export function windowAvg(expression: SQLWrapper): WindowBuilder<string | null> {
+	return new WindowBuilder(sql`avg(${expression})`.mapWith(String));
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<GetExpressionType<T> | null> {
+	const chunk = sql`min(${expression})`;
+	chunk.decoder = is(expression, Column) ? expression : (String as any);
+	return new WindowBuilder(chunk as any);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<GetExpressionType<T> | null> {
+	const chunk = sql`max(${expression})`;
+	chunk.decoder = is(expression, Column) ? expression : (String as any);
+	return new WindowBuilder(chunk as any);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowBuilder<number> {
+	const expr = expression ? sql`count(${expression})` : sql`count(*)`;
+	return new WindowBuilder(expr.mapWith(Number));
+}
+
+export function buildWindowClause(
+	windows: { name: string; spec: WindowSpec | SQL | ((aliases: any) => WindowSpec | SQL) }[] | undefined,
+	fields: Record<string, unknown>,
+): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	const windowList: SQL[] = [];
+	for (const { name, spec } of windows) {
+		const resolvedSpec = typeof spec === 'function'
+			? spec(
+				new Proxy(
+					fields,
+					new SelectionProxyHandler({ sqlAliasedBehavior: 'alias', sqlBehavior: 'sql' }),
+				),
+			)
+			: spec;
+
+		const innerSpecSql = is(resolvedSpec, SQL) ? resolvedSpec : compileWindowSpec(resolvedSpec);
+		windowList.push(sql`${sql.identifier(name)} as (${innerSpecSql})`);
+	}
+
+	return sql` window ${sql.join(windowList, sql`, `)}`;
+}
