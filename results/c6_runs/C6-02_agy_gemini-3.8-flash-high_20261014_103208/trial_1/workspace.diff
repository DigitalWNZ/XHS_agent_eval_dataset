+			expect(() => dbPg.select().from(pgUsers).window('   ', {})).toThrowError(/whitespace/);
+			expect(() => dbPg.select().from(pgUsers).window('\t\n', {})).toThrowError(/whitespace/);
+		});
+
+		it('rows() and range() must reject a spec where the from boundary is ordered after the to boundary referencing "from"', () => {
+			expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+			expect(() => rows({ from: following(5), to: following(2) })).toThrowError(/from/);
+			expect(() => rows({ from: unboundedFollowing, to: currentRow })).toThrowError(/from/);
