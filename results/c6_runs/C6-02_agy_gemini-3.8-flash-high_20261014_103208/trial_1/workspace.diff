+import { Expect } from 'type-tests/utils.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import { firstValue, lag, lastValue, lead, nthValue } from '~/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const users = pgTable('users', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	nullableName: text('nullable_name'),
+	salary: integer('salary').notNull(),
+	nullableSalary: integer('nullable_salary'),
+});
+
+const query1 = await db.select({
+	fv: firstValue(users.name).over(),
+	lv: lastValue(users.name).over(),
+	nv: nthValue(users.name, 2).over(),
+	lagWithoutDefault: lag(users.name).over(),
+	lagWithOffsetOnly: lag(users.name, 1).over(),
+	leadWithoutDefault: lead(users.name).over(),
+	leadWithOffsetOnly: lead(users.name, 1).over(),
+}).from(users);
+
+Expect<
+	Equal<
+		{
+			fv: string | null;
+			lv: string | null;
+			nv: string | null;
+			lagWithoutDefault: string | null;
+			lagWithOffsetOnly: string | null;
+			leadWithoutDefault: string | null;
+			leadWithOffsetOnly: string | null;
+		}[],
+		typeof query1
+	>
+>;
+
+const query2 = await db.select({
+	lagWithDefault: lag(users.name, 1, 'default').over(),
+	leadWithDefault: lead(users.name, 1, 'default').over(),
+	lagNullableWithDefault: lag(users.nullableName, 1, 'default').over(),
+	leadNullableWithDefault: lead(users.nullableName, 1, 'default').over(),
+	lagNumWithDefault: lag(users.nullableSalary, 1, 0).over(),
+	leadNumWithDefault: lead(users.nullableSalary, 1, 0).over(),
+}).from(users);
+
+Expect<
+	Equal<
+		{
+			lagWithDefault: string;
+			leadWithDefault: string;
+			lagNullableWithDefault: string;
+			leadNullableWithDefault: string;
+			lagNumWithDefault: number;
+			leadNumWithDefault: number;
+		}[],
+		typeof query2
+	>
+>;
