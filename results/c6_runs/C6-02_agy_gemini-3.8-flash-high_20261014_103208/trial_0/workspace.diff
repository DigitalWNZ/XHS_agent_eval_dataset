+		expect(q2.params).toEqual([]);
+
+		const q3 = pgDialect.sqlToQuery(ntile(1).over());
+		expect(q3.sql).toBe('ntile(1) over ()');
+		expect(q3.params).toEqual([]);
+
+		const q4 = pgDialect.sqlToQuery(nthValue(usersPg.salary, 1).over());
+		expect(q4.sql).toBe('nth_value("users"."salary", 1) over ()');
+		expect(q4.params).toEqual([]);
+
+		const q5 = pgDialect.sqlToQuery(
+			rowNumber().over({
+				frame: rows({ from: preceding(0), to: following(0) }),
+			}),
+		);
+		expect(q5.sql).toBe('row_number() over (rows between 0 preceding and 0 following)');
+		expect(q5.params).toEqual([]);
+	});
+
+	it('Constraint 2: ntile and nthValue must reject non-positive integer arguments with an error message that includes the JavaScript function name and the received value', () => {
+		expect(() => ntile(0)).toThrowError(/ntile.*0/);
+		expect(() => ntile(-2)).toThrowError(/ntile.*-2/);
+		expect(() => nthValue(usersPg.salary, 0)).toThrowError(/nthValue.*0/);
+		expect(() => nthValue(usersPg.salary, -5)).toThrowError(/nthValue.*-5/);
+	});
+
+	it('Constraint 3: The .window() method on query builders must reject empty names with an error containing "non-empty", and reject whitespace-only names with an error containing "whitespace"', () => {
+		const qb = new PgQueryBuilder().select().from(usersPg);
+		expect(() => qb.window('', {})).toThrowError(/non-empty/);
+		expect(() => qb.window('   ', {})).toThrowError(/whitespace/);
+		expect(() => qb.window('\t\n ', {})).toThrowError(/whitespace/);
+	});
+
+	it('Constraint 4: The rows() and range() frame constructors must reject a spec where the from boundary is ordered after the to boundary; the error must reference "from"', () => {
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+		expect(() => rows({ from: following(2), to: following(1) })).toThrowError(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: currentRow })).toThrowError(/from/);
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrowError(/from/);
+		expect(() => rows({ from: preceding(1), to: preceding(5) })).toThrowError(/from/);
+
+		expect(() => range({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+		expect(() => range({ from: following(5), to: currentRow })).toThrowError(/from/);
+
+		// Valid ordering must not throw
+		expect(() => rows({ from: unboundedPreceding, to: currentRow })).not.toThrow();
+		expect(() => rows({ from: preceding(5), to: preceding(2) })).not.toThrow();
+		expect(() => rows({ from: currentRow, to: currentRow })).not.toThrow();
+		expect(() => rows({ from: preceding(1), to: following(1) })).not.toThrow();
+		expect(() => rows({ from: currentRow, to: unboundedFollowing })).not.toThrow();
+		expect(() => rows({ from: unboundedPreceding, to: unboundedFollowing })).not.toThrow();
+	});
+
+	it('Constraint 5: The preceding() and following() frame boundary helpers must reject negative and non-integer numeric arguments; the error message must reference the helper name', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(1.5)).toThrowError(/preceding/);
+		expect(() => preceding(NaN)).toThrowError(/preceding/);
+		expect(() => preceding(Infinity)).toThrowError(/preceding/);
+
+		expect(() => following(-1)).toThrowError(/following/);
+		expect(() => following(2.7)).toThrowError(/following/);
+		expect(() => following(NaN)).toThrowError(/following/);
+		expect(() => following(Infinity)).toThrowError(/following/);
+
+		// 0 and positive integers are valid
+		expect(() => preceding(0)).not.toThrow();
+		expect(() => preceding(5)).not.toThrow();
+		expect(() => following(0)).not.toThrow();
+		expect(() => following(10)).not.toThrow();
+	});
+
+	it('Constraint 6: windowCount() without an argument emits count(*)', () => {
+		const q = pgDialect.sqlToQuery(windowCount().over());
+		expect(q.sql).toBe('count(*) over ()');
+
+		const qCol = pgDialect.sqlToQuery(windowCount(usersPg.id).over());
+		expect(qCol.sql).toBe('count("users"."id") over ()');
+	});
+
+	it('Full frame specification compiles properly', () => {
+		const q1 = pgDialect.sqlToQuery(
+			windowSum(usersPg.salary).over({
+				partitionBy: [usersPg.department],
+				orderBy: [asc(usersPg.salary)],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+		);
+		expect(q1.sql).toBe(
+			'sum("users"."salary") over (partition by "users"."department" order by "users"."salary" asc rows between unbounded preceding and current row)',
+		);
+
+		const q2 = pgDialect.sqlToQuery(
+			windowAvg(usersPg.salary).over({
+				partitionBy: usersPg.department,
+				orderBy: desc(usersPg.salary),
+				frame: range({ from: preceding(10), to: following(5) }),
+			}),
+		);
+		expect(q2.sql).toBe(
+			'avg("users"."salary") over (partition by "users"."department" order by "users"."salary" desc range between 10 preceding and 5 following)',
+		);
+	});
+});
diff --git a/drizzle-orm/type-tests/pg/window.ts b/drizzle-orm/type-tests/pg/window.ts
