+++ b/drizzle-orm/type-tests/pg/window.ts
@@ -0,0 +1,102 @@
+import { Expect } from 'type-tests/utils.ts';
+import {
+	cumeDist,
+	denseRank,
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	rank,
+	rowNumber,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const users = pgTable('users', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+// Value-access functions are typed nullable without default
+const qNullable = await db
+	.select({
+		firstVal: firstValue(users.salary).over(),
+		lastVal: lastValue(users.salary).over(),
+		nthVal: nthValue(users.salary, 2).over(),
+		lagVal: lag(users.salary).over(),
+		lagValWithOffset: lag(users.salary, 1).over(),
+		leadVal: lead(users.salary).over(),
+		leadValWithOffset: lead(users.salary, 1).over(),
+	})
+	.from(users);
+
+Expect<
+	Equal<
+		{
+			firstVal: number | null;
+			lastVal: number | null;
+			nthVal: number | null;
+			lagVal: number | null;
+			lagValWithOffset: number | null;
+			leadVal: number | null;
+			leadValWithOffset: number | null;
+		}[],
+		typeof qNullable
+	>
+>;
+
+// lag and lead strip null when a default value is provided
+const qNonNull = await db
+	.select({
+		lagWithDefault: lag(users.salary, 1, 0).over(),
+		lagWithDefaultNoOffset: lag(users.salary, undefined, 0).over(),
+		leadWithDefault: lead(users.salary, 1, 0).over(),
+		leadWithDefaultNoOffset: lead(users.salary, undefined, 0).over(),
+		rowNum: rowNumber().over(),
+		rankVal: rank().over(),
+		denseRankVal: denseRank().over(),
+		ntileVal: ntile(4).over(),
+		percentRankVal: percentRank().over(),
+		cumeDistVal: cumeDist().over(),
+		countVal: windowCount().over(),
+		countColVal: windowCount(users.id).over(),
+		sumVal: windowSum(users.salary).over(),
+		avgVal: windowAvg(users.salary).over(),
+		minVal: windowMin(users.salary).over(),
+		maxVal: windowMax(users.salary).over(),
+	})
+	.from(users);
+
+Expect<
+	Equal<
+		{
+			lagWithDefault: number;
+			lagWithDefaultNoOffset: number;
+			leadWithDefault: number;
+			leadWithDefaultNoOffset: number;
+			rowNum: number;
+			rankVal: number;
+			denseRankVal: number;
+			ntileVal: number;
+			percentRankVal: number;
+			cumeDistVal: number;
+			countVal: number;
+			countColVal: number;
+			sumVal: string | null;
+			avgVal: string | null;
+			minVal: number | null;
+			maxVal: number | null;
+		}[],
+		typeof qNonNull
+	>
+>;
