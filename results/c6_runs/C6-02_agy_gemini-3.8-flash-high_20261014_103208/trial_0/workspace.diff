--- /dev/null
+++ b/drizzle-orm/src/sql/expressions/window.ts
@@ -0,0 +1,291 @@
+import { Column, type GetColumnData } from '~/column.ts';
+import { entityKind } from '~/entity.ts';
+import { type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type SelectedFieldType<T> = T extends Column ? GetColumnData<T, 'raw'>
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: any;
+
+export interface FrameBoundary extends SQLWrapper {
+	readonly offset: number;
+	getSQL(): SQL;
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly from: FrameBoundary,
+		readonly to?: FrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		if (this.to) {
+			return sql`${sql.raw(this.type)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.from.getSQL()}`;
+	}
+}
+
+export const unboundedPreceding: FrameBoundary = {
+	offset: -Infinity,
+	getSQL: () => sql.raw('unbounded preceding'),
+};
+
+export const currentRow: FrameBoundary = {
+	offset: 0,
+	getSQL: () => sql.raw('current row'),
+};
+
+export const unboundedFollowing: FrameBoundary = {
+	offset: Infinity,
+	getSQL: () => sql.raw('unbounded following'),
+};
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() argument must be a non-negative integer, received ${offset}`);
+	}
+	return {
+		offset: -offset,
+		getSQL: () => sql.raw(`${offset} preceding`),
+	};
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() argument must be a non-negative integer, received ${offset}`);
+	}
+	return {
+		offset: offset,
+		getSQL: () => sql.raw(`${offset} following`),
+	};
+}
+
+export function rows(spec: FrameSpec): WindowFrame {
+	if (!spec || !spec.from) {
+		throw new Error('Frame specification must include a "from" boundary');
+	}
+	if (spec.to && spec.from.offset > spec.to.offset) {
+		throw new Error('Frame "from" boundary must be ordered before or equal to "to" boundary in rows()');
+	}
+	return new WindowFrame('rows', spec.from, spec.to);
+}
+
+export function range(spec: FrameSpec): WindowFrame {
+	if (!spec || !spec.from) {
+		throw new Error('Frame specification must include a "from" boundary');
+	}
+	if (spec.to && spec.from.offset > spec.to.offset) {
+		throw new Error('Frame "from" boundary must be ordered before or equal to "to" boundary in range()');
+	}
+	return new WindowFrame('range', spec.from, spec.to);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+export function buildWindowSpec(spec: WindowSpec): SQL {
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const partitionBy = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionBy.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orderBy = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderBy.length > 0) {
+			parts.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		parts.push(spec.frame.getSQL());
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	constructor(protected sqlFn: SQL) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		if (typeof spec === 'string') {
+			if (spec.length === 0) {
+				throw new Error('Window name must be non-empty');
+			}
+			if (spec.trim().length === 0) {
+				throw new Error('Window name must not contain only whitespace');
+			}
+			return sql`${this.sqlFn} over ${sql.identifier(spec)}`;
+		}
+
+		if (!spec) {
+			return sql`${this.sqlFn} over ()`;
+		}
+
+		const inner = buildWindowSpec(spec);
+		if (inner.queryChunks.length === 0) {
+			return sql`${this.sqlFn} over ()`;
+		}
+
+		return sql`${this.sqlFn} over (${inner})`;
+	}
+}
+
+export { WindowFunctionBuilder as WindowBuilder };
+
+// Ranking helpers
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`);
+}
+
+export function ntile(n: number): WindowFunctionBuilder<number> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile() received non-positive integer: ${n}`);
+	}
+	return new WindowFunctionBuilder(sql`ntile(${sql.raw(n.toString())})`);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`percent_rank()`);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`cume_dist()`);
+}
+
+// Offset helpers
+export function lag<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SelectedFieldType<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+): WindowFunctionBuilder<SelectedFieldType<T> | null>;
+export function lag<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunctionBuilder<NonNullable<SelectedFieldType<T>>>;
+export function lag<T extends SQLWrapper, TDefault = undefined>(
+	expression: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<TDefault extends undefined ? SelectedFieldType<T> | null : NonNullable<SelectedFieldType<T>>> {
+	let fnSql: SQL;
+	if (defaultValue !== undefined) {
+		const offsetSql = offset !== undefined
+			? (typeof offset === 'number' ? sql.raw(offset.toString()) : offset)
+			: sql.raw('1');
+		fnSql = sql`lag(${expression}, ${offsetSql}, ${defaultValue})`;
+	} else if (offset !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(offset.toString()) : offset;
+		fnSql = sql`lag(${expression}, ${offsetSql})`;
+	} else {
+		fnSql = sql`lag(${expression})`;
+	}
+	return new WindowFunctionBuilder(fnSql);
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SelectedFieldType<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+): WindowFunctionBuilder<SelectedFieldType<T> | null>;
+export function lead<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunctionBuilder<NonNullable<SelectedFieldType<T>>>;
+export function lead<T extends SQLWrapper, TDefault = undefined>(
+	expression: T,
+	offset?: number,
+	defaultValue?: TDefault,
+): WindowFunctionBuilder<TDefault extends undefined ? SelectedFieldType<T> | null : NonNullable<SelectedFieldType<T>>> {
+	let fnSql: SQL;
+	if (defaultValue !== undefined) {
+		const offsetSql = offset !== undefined
+			? (typeof offset === 'number' ? sql.raw(offset.toString()) : offset)
+			: sql.raw('1');
+		fnSql = sql`lead(${expression}, ${offsetSql}, ${defaultValue})`;
+	} else if (offset !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(offset.toString()) : offset;
+		fnSql = sql`lead(${expression}, ${offsetSql})`;
+	} else {
+		fnSql = sql`lead(${expression})`;
+	}
+	return new WindowFunctionBuilder(fnSql);
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SelectedFieldType<T> | null> {
+	return new WindowFunctionBuilder(sql`first_value(${expression})`);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SelectedFieldType<T> | null> {
+	return new WindowFunctionBuilder(sql`last_value(${expression})`);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<SelectedFieldType<T> | null> {
+	if (typeof n !== 'number' || !Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue() received non-positive integer: ${n}`);
+	}
+	return new WindowFunctionBuilder(sql`nth_value(${expression}, ${sql.raw(n.toString())})`);
+}
+
+// Aggregate helpers
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SelectedFieldType<T> | null> {
+	return new WindowFunctionBuilder(sql`min(${expression})`);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<SelectedFieldType<T> | null> {
+	return new WindowFunctionBuilder(sql`max(${expression})`);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(expression ? sql`count(${expression})` : sql`count(*)`);
+}
