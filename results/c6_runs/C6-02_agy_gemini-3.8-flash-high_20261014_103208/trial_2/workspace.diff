+describe('Window functions: Complex specs and frame queries', () => {
+	const qb = new PgQueryBuilder();
+
+	test('window with partitionBy, orderBy, and rows frame', () => {
+		const query = qb
+			.select({
+				runningTotal: windowSum(users.salary).over({
+					partitionBy: users.dept,
+					orderBy: asc(users.salary),
