+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type GetColumnOrSqlDataType<T, TFallback = unknown> = T extends Column ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: T extends SQLWrapper ? TFallback
+	: T;
+
+export class FrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'FrameBoundary';
+
+	constructor(
+		readonly type: 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing',
+		readonly order: number,
+		readonly sqlChunk: SQL,
+		readonly offset?: number,
+	) {}
+
+	getSQL(): SQL {
+		return this.sqlChunk;
+	}
+}
+
+export const unboundedPreceding = new FrameBoundary('unboundedPreceding', -Infinity, sql`unbounded preceding`);
+export const currentRow = new FrameBoundary('currentRow', 0, sql`current row`);
+export const unboundedFollowing = new FrameBoundary('unboundedFollowing', Infinity, sql`unbounded following`);
+
+export function preceding(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding: expected non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundary('preceding', -offset, sql`${sql.raw(String(offset))} preceding`, offset);
+}
+
+export function following(offset: number): FrameBoundary {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following: expected non-negative integer, received ${offset}`);
+	}
+	return new FrameBoundary('following', offset, sql`${sql.raw(String(offset))} following`, offset);
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to?: FrameBoundary;
+}
+
+function validateFrame(type: 'rows' | 'range', spec: FrameSpec): void {
+	if (!spec || !spec.from) {
+		throw new Error(`${type}: specification must include a 'from' boundary`);
+	}
+	if (spec.to !== undefined) {
+		const fromOrder = typeof spec.from === 'object' && 'order' in spec.from ? spec.from.order : 0;
+		const toOrder = typeof spec.to === 'object' && 'order' in spec.to ? spec.to.order : 0;
+		if (fromOrder > toOrder) {
+			throw new Error(`${type}: 'from' boundary cannot be ordered after 'to' boundary`);
+		}
+	}
+}
+
+export class Frame implements SQLWrapper {
+	static readonly [entityKind]: string = 'Frame';
+
+	constructor(
+		readonly type: 'rows' | 'range',
+		readonly spec: FrameSpec,
+	) {}
+
+	getSQL(): SQL {
+		if (this.spec.to !== undefined) {
+			return sql`${sql.raw(this.type)} between ${this.spec.from.getSQL()} and ${this.spec.to.getSQL()}`;
+		}
+		return sql`${sql.raw(this.type)} ${this.spec.from.getSQL()}`;
+	}
+}
+
+export function rows(spec: FrameSpec): Frame {
+	validateFrame('rows', spec);
+	return new Frame('rows', spec);
+}
+
+export function range(spec: FrameSpec): Frame {
+	validateFrame('range', spec);
+	return new Frame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: AnyColumn | SQL | SQL.Aliased | SQLWrapper | (AnyColumn | SQL | SQL.Aliased | SQLWrapper)[];
+	orderBy?: AnyColumn | SQL | SQL.Aliased | SQLWrapper | (AnyColumn | SQL | SQL.Aliased | SQLWrapper)[];
+	frame?: Frame | SQLWrapper;
+}
+
+export function buildWindowSpecSql(spec?: WindowSpec | SQLWrapper | string): SQL {
+	if (!spec) {
+		return sql.empty();
+	}
+	if (typeof spec === 'string') {
+		return sql`${sql.identifier(spec)}`;
+	}
+	if (isSQLWrapper(spec)) {
+		return spec.getSQL();
+	}
+	const chunks: SQL[] = [];
+
+	if (spec.partitionBy) {
+		const parts = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		const filteredParts = parts.filter((p) => p !== undefined && p !== null);
+		if (filteredParts.length > 0) {
+			chunks.push(sql`partition by ${sql.join(filteredParts, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy) {
+		const orders = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		const filteredOrders = orders.filter((o) => o !== undefined && o !== null);
+		if (filteredOrders.length > 0) {
+			chunks.push(sql`order by ${sql.join(filteredOrders, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame) {
+		chunks.push(spec.frame.getSQL());
+	}
+
+	if (chunks.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+export class WindowBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowBuilder';
+
+	constructor(protected readonly sqlFn: SQL) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		let overClause: SQL;
+		if (typeof spec === 'string') {
+			if (spec.length === 0) {
+				throw new Error('Window name must be a non-empty string');
+			}
+			if (spec.trim().length === 0) {
+				throw new Error('Window name cannot be whitespace-only');
+			}
+			overClause = sql`over ${sql.identifier(spec)}`;
+		} else if (!spec) {
+			overClause = sql`over ()`;
+		} else {
+			const specSql = buildWindowSpecSql(spec);
+			if (specSql.queryChunks.length === 0) {
+				overClause = sql`over ()`;
+			} else {
+				overClause = sql`over (${specSql})`;
+			}
+		}
+
+		const result = sql<T>`${this.sqlFn} ${overClause}`;
+		result.decoder = this.sqlFn.decoder as any;
+		return result;
+	}
+}
+
+// Ranking helpers
+export function rowNumber(): WindowBuilder<SQL<number>> {
+	const sqlFn = sql`row_number()`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
+
+export function rank(): WindowBuilder<SQL<number>> {
+	const sqlFn = sql`rank()`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
+
+export function denseRank(): WindowBuilder<SQL<number>> {
+	const sqlFn = sql`dense_rank()`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
+
+export function ntile(n: number | SQLWrapper): WindowBuilder<SQL<number>> {
+	if (typeof n === 'number') {
+		if (!Number.isInteger(n) || n <= 0) {
+			throw new Error(`ntile: expected positive integer, received ${n}`);
+		}
+	} else if (!isSQLWrapper(n)) {
+		throw new Error(`ntile: expected positive integer, received ${n}`);
+	}
+	const nSql = typeof n === 'number' ? sql.raw(String(n)) : n;
+	const sqlFn = sql`ntile(${nSql})`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
+
+export function percentRank(): WindowBuilder<SQL<number>> {
+	const sqlFn = sql`percent_rank()`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
+
+export function cumeDist(): WindowBuilder<SQL<number>> {
+	const sqlFn = sql`cume_dist()`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
+
+// Offset helpers
+export function firstValue<T extends SQLWrapper>(
+	value: T,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>> {
+	const sqlFn = sql`first_value(${value})`.mapWith(is(value, Column) ? value : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+export function lastValue<T extends SQLWrapper>(
+	value: T,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>> {
+	const sqlFn = sql`last_value(${value})`.mapWith(is(value, Column) ? value : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+export function nthValue<T extends SQLWrapper>(
+	value: T,
+	n: number | SQLWrapper,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>> {
+	if (typeof n === 'number') {
+		if (!Number.isInteger(n) || n <= 0) {
+			throw new Error(`nthValue: expected positive integer, received ${n}`);
+		}
+	} else if (!isSQLWrapper(n)) {
+		throw new Error(`nthValue: expected positive integer, received ${n}`);
+	}
+	const nSql = typeof n === 'number' ? sql.raw(String(n)) : n;
+	const sqlFn = sql`nth_value(${value}, ${nSql})`.mapWith(is(value, Column) ? value : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+export function lag<T extends SQLWrapper>(
+	value: T,
+	offset?: number | SQLWrapper,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>>;
+export function lag<T extends SQLWrapper, TDefault = GetColumnOrSqlDataType<T>>(
+	value: T,
+	offset: number | SQLWrapper | undefined,
+	defaultValue: TDefault | SQLWrapper,
+): WindowBuilder<SQL<Exclude<GetColumnOrSqlDataType<T>, null> | GetColumnOrSqlDataType<TDefault>>>;
+export function lag(
+	value: SQLWrapper,
+	offset?: number | SQLWrapper,
+	defaultValue?: unknown,
+): WindowBuilder<any> {
+	let sqlFn: SQL;
+	if (defaultValue !== undefined) {
+		const offsetSql = offset !== undefined
+			? (typeof offset === 'number' ? sql.raw(String(offset)) : offset)
+			: sql.raw('1');
+		sqlFn = sql`lag(${value}, ${offsetSql}, ${defaultValue as any})`;
+	} else if (offset !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+		sqlFn = sql`lag(${value}, ${offsetSql})`;
+	} else {
+		sqlFn = sql`lag(${value})`;
+	}
+	sqlFn.mapWith(is(value, Column) ? value : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+export function lead<T extends SQLWrapper>(
+	value: T,
+	offset?: number | SQLWrapper,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>>;
+export function lead<T extends SQLWrapper, TDefault = GetColumnOrSqlDataType<T>>(
+	value: T,
+	offset: number | SQLWrapper | undefined,
+	defaultValue: TDefault | SQLWrapper,
+): WindowBuilder<SQL<Exclude<GetColumnOrSqlDataType<T>, null> | GetColumnOrSqlDataType<TDefault>>>;
+export function lead(
+	value: SQLWrapper,
+	offset?: number | SQLWrapper,
+	defaultValue?: unknown,
+): WindowBuilder<any> {
+	let sqlFn: SQL;
+	if (defaultValue !== undefined) {
+		const offsetSql = offset !== undefined
+			? (typeof offset === 'number' ? sql.raw(String(offset)) : offset)
+			: sql.raw('1');
+		sqlFn = sql`lead(${value}, ${offsetSql}, ${defaultValue as any})`;
+	} else if (offset !== undefined) {
+		const offsetSql = typeof offset === 'number' ? sql.raw(String(offset)) : offset;
+		sqlFn = sql`lead(${value}, ${offsetSql})`;
+	} else {
+		sqlFn = sql`lead(${value})`;
+	}
+	sqlFn.mapWith(is(value, Column) ? value : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+// Aggregate helpers
+export function windowSum(expression: SQLWrapper): WindowBuilder<SQL<string | null>> {
+	const sqlFn = sql`sum(${expression})`.mapWith(String);
+	return new WindowBuilder(sqlFn);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowBuilder<SQL<string | null>> {
+	const sqlFn = sql`avg(${expression})`.mapWith(String);
+	return new WindowBuilder(sqlFn);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>> {
+	const sqlFn = sql`min(${expression})`.mapWith(is(expression, Column) ? expression : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowBuilder<SQL<GetColumnOrSqlDataType<T> | null>> {
+	const sqlFn = sql`max(${expression})`.mapWith(is(expression, Column) ? expression : (String as any));
+	return new WindowBuilder(sqlFn);
+}
+
+export function windowCount(expression?: SQLWrapper): WindowBuilder<SQL<number>> {
+	const sqlFn = sql`count(${expression || sql.raw('*')})`.mapWith(Number);
+	return new WindowBuilder(sqlFn);
+}
