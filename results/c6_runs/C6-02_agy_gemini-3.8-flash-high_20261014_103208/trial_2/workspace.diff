+describe('Window functions: Constraints testing', () => {
+	const qb = new PgQueryBuilder();
+
+	test('Numeric positional arguments must never become bound query parameters, even when zero', () => {
+		// lag with offset 0
+		const q1 = qb.select({ val: lag(users.salary, 0).over() }).from(users).toSQL();
+		expect(q1.sql).toContain('lag("users"."salary", 0) over ()');
+		expect(q1.params).toEqual([]);
+
+		// lead with offset 0
+		const q2 = qb.select({ val: lead(users.salary, 0).over() }).from(users).toSQL();
+		expect(q2.sql).toContain('lead("users"."salary", 0) over ()');
+		expect(q2.params).toEqual([]);
+
+		// ntile
+		const q3 = qb.select({ val: ntile(4).over() }).from(users).toSQL();
+		expect(q3.sql).toContain('ntile(4) over ()');
+		expect(q3.params).toEqual([]);
+
+		// nthValue
+		const q4 = qb.select({ val: nthValue(users.salary, 2).over() }).from(users).toSQL();
+		expect(q4.sql).toContain('nth_value("users"."salary", 2) over ()');
+		expect(q4.params).toEqual([]);
+
+		// preceding(0) and following(0)
+		const q5 = qb
+			.select({
+				val: windowSum(users.salary).over({
+					frame: rows({ from: preceding(0), to: following(0) }),
+				}),
+			})
+			.from(users)
+			.toSQL();
+		expect(q5.sql).toContain('rows between 0 preceding and 0 following');
+		expect(q5.params).toEqual([]);
+	});
+
+	test('ntile rejects non-positive integer arguments with error message containing JS name and received value', () => {
+		expect(() => ntile(0)).toThrowError(/ntile.*0/);
+		expect(() => ntile(-2)).toThrowError(/ntile.*-2/);
+		expect(() => ntile(1.5)).toThrowError(/ntile.*1.5/);
+	});
+
+	test('nthValue rejects non-positive integer arguments with error message containing JS name and received value', () => {
+		expect(() => nthValue(users.salary, 0)).toThrowError(/nthValue.*0/);
+		expect(() => nthValue(users.salary, -1)).toThrowError(/nthValue.*-1/);
+		expect(() => nthValue(users.salary, 2.5)).toThrowError(/nthValue.*2.5/);
+	});
+
+	test('.window() rejects empty names with error containing "non-empty"', () => {
+		expect(() => qb.select().from(users).window('', {})).toThrowError(/non-empty/);
+	});
+
+	test('.window() rejects whitespace-only names with error containing "whitespace"', () => {
+		expect(() => qb.select().from(users).window('   ', {})).toThrowError(/whitespace/);
+		expect(() => qb.select().from(users).window('\t\n', {})).toThrowError(/whitespace/);
+	});
+
+	test('rows() and range() reject when from is ordered after to; error references "from"', () => {
+		expect(() =>
+			rows({
+				from: unboundedFollowing,
+				to: currentRow,
+			})
+		).toThrowError(/from/);
+
+		expect(() =>
+			range({
+				from: following(5),
+				to: following(2),
+			})
+		).toThrowError(/from/);
+
+		expect(() =>
+			rows({
+				from: preceding(2),
+				to: preceding(5),
+			})
+		).toThrowError(/from/);
+
+		expect(() =>
+			rows({
+				from: currentRow,
+				to: preceding(1),
+			})
+		).toThrowError(/from/);
+	});
+
+	test('preceding() and following() reject negative and non-integer arguments; error references helper name', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(2.5)).toThrowError(/preceding/);
+		expect(() => following(-1)).toThrowError(/following/);
+		expect(() => following(1.7)).toThrowError(/following/);
+
+		// Non-negative integer is accepted
+		expect(() => preceding(0)).not.toThrow();
+		expect(() => preceding(3)).not.toThrow();
+		expect(() => following(0)).not.toThrow();
+		expect(() => following(3)).not.toThrow();
+	});
+
+	test('windowCount() without argument emits count(*)', () => {
+		const q = qb.select({ count: windowCount().over() }).from(users).toSQL();
+		expect(q.sql).toBe('select count(*) over () from "users"');
+	});
+});
