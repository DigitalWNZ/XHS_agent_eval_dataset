diff --git a/drizzle-orm/tests/window/window.test.ts b/drizzle-orm/tests/window/window.test.ts
new file mode 100644
index 00000000..cf0323d4
--- /dev/null
+++ b/drizzle-orm/tests/window/window.test.ts
@@ -0,0 +1,99 @@
+import { expect, expectTypeOf, test } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import {
+	asc,
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int as myInt, mysqlTable } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { PgDialect } from '~/pg-core/dialect.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import type { SQL } from '~/sql/sql.ts';
+import { integer as sqliteInt, sqliteTable } from '~/sqlite-core/index.ts';
+
+const emp = pgTable('emp', {
+	id: integer('id').primaryKey(),
+	dept: text('dept').notNull(),
+	salary: integer('salary').notNull(),
+});
+const dialect = new PgDialect();
+const db = pgDrizzle.mock();
+
+test('names and over', () => {
+	const q = db.select({
+		a: rowNumber().over(),
+		b: rank().over({ partitionBy: emp.dept, orderBy: desc(emp.salary) }),
+		c: denseRank().over('w'),
+		d: ntile(4).over({}),
+		e: percentRank().over(),
+		f: cumeDist().over(),
+		g: lag(emp.salary).over(),
+		h: lead(emp.salary, 0, 0).over(),
+		i: firstValue(emp.salary).over(),
+		j: lastValue(emp.salary).over(),
+		k: nthValue(emp.salary, 2).over(),
+		l: windowSum(emp.salary).over({
+			orderBy: [asc(emp.id)],
+			frame: rows({ from: unboundedPreceding, to: currentRow }),
+		}),
+		m: windowAvg(emp.salary).over({ frame: range({ from: preceding(0), to: following(2) }) }),
+		n: windowMin(emp.salary).over(),
+		o: windowMax(emp.salary).over({ frame: rows({ from: currentRow, to: unboundedFollowing }) }),
+		p: windowCount().over(),
+		q: windowCount(emp.id).over('w'),
+	}).from(emp).window('w', { partitionBy: [emp.dept] }).orderBy(emp.id).toSQL();
+	console.log(q.sql);
+	expect(q.params).toEqual([]);
+	expect(q.sql).toContain('row_number() over ()');
+	expect(q.sql).toContain('dense_rank() over "w"');
+	expect(q.sql).toContain('lead("emp"."salary", 0, 0) over ()');
+	expect(q.sql).toContain('count(*) over ()');
+	expect(q.sql).toContain(' window "w" as (partition by "emp"."dept") order by "emp"."id"');
+	expectTypeOf(lag(emp.salary).over()).toEqualTypeOf<SQL<number | null>>();
+	expectTypeOf(lag(emp.salary, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+	void dialect;
+});
+
+test('errors', () => {
+	expect(() => ntile(0)).toThrow(/ntile.*0/);
+	expect(() => nthValue(emp.id, 1.5)).toThrow(/nthValue.*1\.5/);
+	expect(() => db.select().from(emp).window('', {})).toThrow(/non-empty/);
+	expect(() => db.select().from(emp).window('  ', {})).toThrow(/whitespace/);
+	expect(() => rows({ from: currentRow, to: preceding(1) })).toThrow(/from/);
+	expect(() => range({ from: following(3), to: following(1) })).toThrow(/from/);
+	expect(() => preceding(-1)).toThrow(/preceding/);
+	expect(() => following(0.5)).toThrow(/following/);
+});
+
+test('other dialects', () => {
+	const m = mysqlTable('t', { id: myInt('id') });
+	const s = sqliteTable('t', { id: sqliteInt('id') });
+	const mq = mysqlDrizzle.mock().select({ r: rank().over('w') }).from(m).window('w', { orderBy: m.id }).toSQL();
+	expect(mq.sql).toBe('select rank() over `w` from `t` window `w` as (order by `t`.`id`)');
+	const sq = sqliteDrizzle.mock().select({ r: rank().over('w') }).from(s).window('w', { orderBy: s.id }).toSQL();
+	expect(sq.sql).toBe('select rank() over "w" from "t" window "w" as (order by "t"."id")');
+});
