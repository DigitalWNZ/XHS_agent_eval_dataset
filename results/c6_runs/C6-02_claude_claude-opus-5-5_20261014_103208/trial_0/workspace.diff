new file mode 100644
index 00000000..c3f96ace
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,428 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, isSQLWrapper, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+type InferWindowData<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+const frameBoundaryKind = Symbol.for('drizzle:WindowFrameBoundaryKind');
+
+/**
+ * A boundary of a window frame, built with {@link unboundedPreceding}, {@link currentRow},
+ * {@link unboundedFollowing}, {@link preceding} or {@link following}.
+ */
+export interface WindowFrameBoundary {
+	readonly [frameBoundaryKind]: 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing';
+	readonly offset?: number | SQLWrapper;
+	readonly sql: SQL;
+}
+
+export interface WindowFrameBoundarySpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly mode: 'rows' | 'range',
+		readonly from: WindowFrameBoundary,
+		readonly to: WindowFrameBoundary | undefined,
+	) {}
+
+	getSQL(): SQL {
+		if (this.to === undefined) {
+			return sql`${sql.raw(this.mode)} ${this.from.sql}`;
+		}
+		return sql`${sql.raw(this.mode)} between ${this.from.sql} and ${this.to.sql}`;
+	}
+}
+
+export const unboundedPreceding: WindowFrameBoundary = Object.freeze({
+	[frameBoundaryKind]: 'unboundedPreceding' as const,
+	sql: sql.raw('unbounded preceding'),
+});
+
+export const currentRow: WindowFrameBoundary = Object.freeze({
+	[frameBoundaryKind]: 'currentRow' as const,
+	sql: sql.raw('current row'),
+});
+
+export const unboundedFollowing: WindowFrameBoundary = Object.freeze({
+	[frameBoundaryKind]: 'unboundedFollowing' as const,
+	sql: sql.raw('unbounded following'),
+});
+
+function frameOffset(fnName: string, offset: number | SQLWrapper): SQLWrapper {
+	if (typeof offset === 'number') {
+		if (!Number.isInteger(offset) || offset < 0) {
+			throw new Error(`${fnName}() expects a non-negative integer, received ${offset}`);
+		}
+		return sql.raw(String(offset));
+	}
+	if (!isSQLWrapper(offset)) {
+		throw new Error(`${fnName}() expects a non-negative integer or SQL expression, received ${String(offset)}`);
+	}
+	return offset;
+}
+
+/**
+ * `<offset> preceding` frame boundary. Numbers are inlined into the query.
+ */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	return Object.freeze({
+		[frameBoundaryKind]: 'preceding' as const,
+		offset,
+		sql: sql`${frameOffset('preceding', offset)} preceding`,
+	});
+}
+
+/**
+ * `<offset> following` frame boundary. Numbers are inlined into the query.
+ */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	return Object.freeze({
+		[frameBoundaryKind]: 'following' as const,
+		offset,
+		sql: sql`${frameOffset('following', offset)} following`,
+	});
+}
+
+function isFrameBoundary(value: unknown): value is WindowFrameBoundary {
+	return typeof value === 'object' && value !== null && frameBoundaryKind in value;
+}
+
+const boundaryRank = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+} as const;
+
+/**
+ * Returns a position usable for ordering two boundaries, or `undefined` if it can't be
+ * determined statically (SQL offsets).
+ */
+function boundaryPosition(boundary: WindowFrameBoundary): number | undefined {
+	const kind = boundary[frameBoundaryKind];
+	if (kind === 'preceding' || kind === 'following') {
+		if (typeof boundary.offset !== 'number') return undefined;
+		return kind === 'preceding' ? -boundary.offset : boundary.offset;
+	}
+	return kind === 'unboundedPreceding' ? -Infinity : kind === 'unboundedFollowing' ? Infinity : 0;
+}
+
+function buildFrame(mode: 'rows' | 'range', spec: WindowFrameBoundarySpec): WindowFrame {
+	if (typeof spec !== 'object' || spec === null || !isFrameBoundary(spec.from)) {
+		throw new Error(`${mode}() expects a "from" frame boundary`);
+	}
+	const { from, to } = spec;
+	if (to !== undefined && !isFrameBoundary(to)) {
+		throw new Error(`${mode}() expects "to" to be a frame boundary`);
+	}
+	if (from[frameBoundaryKind] === 'unboundedFollowing') {
+		throw new Error(`${mode}(): "from" boundary cannot be unboundedFollowing`);
+	}
+	if (to === undefined) {
+		if (from[frameBoundaryKind] === 'following') {
+			throw new Error(`${mode}(): "from" boundary cannot be following() without a "to" boundary`);
+		}
+	} else {
+		if (to[frameBoundaryKind] === 'unboundedPreceding') {
+			throw new Error(`${mode}(): "to" boundary cannot be unboundedPreceding, it must not precede "from"`);
+		}
+		const fromPos = boundaryPosition(from);
+		const toPos = boundaryPosition(to);
+		const outOfOrder = fromPos !== undefined && toPos !== undefined
+			? fromPos > toPos
+			: boundaryRank[from[frameBoundaryKind]] > boundaryRank[to[frameBoundaryKind]];
+		if (outOfOrder) {
+			throw new Error(`${mode}(): "from" boundary must not come after "to" boundary`);
+		}
+	}
+	return new WindowFrame(mode, from, to);
+}
+
+/**
+ * Builds a `rows` window frame.
+ *
+ * @example
+ * ```ts
+ * rows({ from: unboundedPreceding, to: currentRow })
+ * // rows between unbounded preceding and current row
+ * ```
+ */
+export function rows(spec: WindowFrameBoundarySpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/**
+ * Builds a `range` window frame.
+ *
+ * @example
+ * ```ts
+ * range({ from: preceding(1), to: following(1) })
+ * // range between 1 preceding and 1 following
+ * ```
+ */
+export function range(spec: WindowFrameBoundarySpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+function toArray<T>(value: T | T[] | undefined): T[] {
+	if (value === undefined) return [];
+	return Array.isArray(value) ? value : [value];
+}
+
+/** @internal */
+export function validateWindowName(name: unknown, fnName: string): asserts name is string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error(`${fnName}() expects a non-empty window name`);
+	}
+	if (name.trim().length === 0) {
+		throw new Error(`${fnName}() expects a window name that is not only whitespace`);
+	}
+}
+
+/**
+ * Builds the inner part of a window specification (without parentheses).
+ * @internal
+ */
+export function buildWindowSpec(spec: WindowSpec = {}): SQL {
+	const chunks: SQL[] = [];
+	const partitionBy = toArray(spec.partitionBy);
+	if (partitionBy.length > 0) {
+		chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+	const orderBy = toArray(spec.orderBy);
+	if (orderBy.length > 0) {
+		chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+	if (spec.frame !== undefined) {
+		chunks.push(spec.frame.getSQL());
+	}
+	return sql.join(chunks, sql` `);
+}
+
+/** @internal */
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+/** @internal */
+export function buildWindowClause(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+/**
+ * A window function call that must be completed with {@link WindowFunction.over}.
+ */
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: {
+		readonly data: T;
+	};
+
+	constructor(
+		/** @internal */
+		readonly fn: SQL,
+		/** @internal */
+		readonly decoder: DriverValueDecoder<any, any>,
+	) {}
+
+	/**
+	 * Adds the `over` clause, either from an inline window specification or a window name
+	 * defined with `.window(name, spec)` on the select builder.
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		if (typeof spec === 'string') {
+			validateWindowName(spec, 'over');
+			return sql<T>`${this.fn} over ${sql.identifier(spec)}`.mapWith(this.decoder) as SQL<T>;
+		}
+		return sql<T>`${this.fn} over (${buildWindowSpec(spec)})`.mapWith(this.decoder) as SQL<T>;
+	}
+}
+
+const numberDecoder: DriverValueDecoder<number, any> = { mapFromDriverValue: Number };
+const stringDecoder: DriverValueDecoder<string, any> = { mapFromDriverValue: String };
+const noopDecoder: DriverValueDecoder<any, any> = { mapFromDriverValue: (value) => value };
+
+function expressionDecoder(expression: SQLWrapper): DriverValueDecoder<any, any> {
+	if (is(expression, Column)) return expression;
+	if (is(expression, SQL)) return expression.decoder;
+	if (is(expression, SQL.Aliased)) return expression.sql.decoder;
+	return noopDecoder;
+}
+
+function positiveInteger(fnName: string, value: number): SQL {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() expects a positive integer, received ${String(value)}`);
+	}
+	return sql.raw(String(value));
+}
+
+function nonNegativeInteger(fnName: string, value: number): SQL {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${fnName}() expects a non-negative integer offset, received ${String(value)}`);
+	}
+	return sql.raw(String(value));
+}
+
+function defaultValue(value: unknown): unknown {
+	if (typeof value === 'number' && Number.isFinite(value)) {
+		return sql.raw(String(value));
+	}
+	return value;
+}
+
+// Ranking functions
+
+/** `row_number()` - sequential number of the row within its partition, starting at 1. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, numberDecoder);
+}
+
+/** `rank()` - rank of the current row with gaps. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, numberDecoder);
+}
+
+/** `dense_rank()` - rank of the current row without gaps. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, numberDecoder);
+}
+
+/** `ntile(n)` - bucket number ranging from 1 to `buckets`, dividing the partition as equally as possible. */
+export function ntile(buckets: number): WindowFunction<number> {
+	return new WindowFunction(sql`ntile(${positiveInteger('ntile', buckets)})`, numberDecoder);
+}
+
+/** `percent_rank()` - relative rank of the current row: (rank - 1) / (total partition rows - 1). */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, numberDecoder);
+}
+
+/** `cume_dist()` - cumulative distribution of the current row. */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, numberDecoder);
+}
+
+// Value functions
+
+function offsetFunction(
+	fnName: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultVal: unknown,
+): WindowFunction<any> {
+	const args: unknown[] = [expression];
+	if (offset !== undefined || defaultVal !== undefined) {
+		args.push(nonNegativeInteger(fnName, offset ?? 1));
+	}
+	if (defaultVal !== undefined) {
+		args.push(defaultValue(defaultVal));
+	}
+	return new WindowFunction(
+		sql`${sql.raw(fnName)}(${sql.join(args.map((arg) => sql`${arg}`), sql`, `)})`,
+		expressionDecoder(expression),
+	);
+}
+
+/**
+ * `lag(expression, offset, default)` - value of `expression` from the row `offset` rows before the current one.
+ * Returns `null` (or `defaultValue`, if provided) when there is no such row.
+ */
+export function lag<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<InferWindowData<T> | null>;
+export function lag<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	NonNullable<InferWindowData<T>> | (TDefault extends SQLWrapper ? InferWindowData<TDefault> : TDefault)
+>;
+export function lag(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lag', expression, offset, defaultValue);
+}
+
+/**
+ * `lead(expression, offset, default)` - value of `expression` from the row `offset` rows after the current one.
+ * Returns `null` (or `defaultValue`, if provided) when there is no such row.
+ */
+export function lead<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<InferWindowData<T> | null>;
+export function lead<T extends SQLWrapper, TDefault>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: TDefault,
+): WindowFunction<
+	NonNullable<InferWindowData<T>> | (TDefault extends SQLWrapper ? InferWindowData<TDefault> : TDefault)
+>;
+export function lead(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lead', expression, offset, defaultValue);
+}
+
+/** `first_value(expression)` - value of `expression` at the first row of the window frame. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, expressionDecoder(expression));
+}
+
+/** `last_value(expression)` - value of `expression` at the last row of the window frame. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, expressionDecoder(expression));
+}
+
+/** `nth_value(expression, n)` - value of `expression` at the `n`-th (1-based) row of the window frame. */
+export function nthValue<T extends SQLWrapper>(expression: T, n: number): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${positiveInteger('nthValue', n)})`,
+		expressionDecoder(expression),
+	);
+}
+
+// Aggregate functions
+
+/** `sum(expression) over (...)` */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, stringDecoder);
+}
+
+/** `avg(expression) over (...)` */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, stringDecoder);
+}
+
+/** `min(expression) over (...)` */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : stringDecoder);
+}
+
+/** `max(expression) over (...)` */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : stringDecoder);
+}
+
+/** `count(expression) over (...)`, or `count(*) over (...)` when no expression is given. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, numberDecoder);
+}
