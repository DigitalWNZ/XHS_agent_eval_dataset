new file mode 100644
index 00000000..ee7074d5
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,375 @@
+import { Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, SQL, sql, type SQLWrapper } from '../sql.ts';
+
+type InferWindowData<T> = T extends Column ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+/** A single boundary of a window frame (e.g. `unbounded preceding`, `3 following`). */
+export interface WindowFrameBoundary {
+	readonly kind: 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing';
+	readonly offset?: number | SQLWrapper;
+}
+
+/** `unbounded preceding` frame boundary */
+export const unboundedPreceding: WindowFrameBoundary = Object.freeze({ kind: 'unboundedPreceding' as const });
+/** `current row` frame boundary */
+export const currentRow: WindowFrameBoundary = Object.freeze({ kind: 'currentRow' as const });
+/** `unbounded following` frame boundary */
+export const unboundedFollowing: WindowFrameBoundary = Object.freeze({ kind: 'unboundedFollowing' as const });
+
+function assertFrameOffset(fn: string, offset: number | SQLWrapper): void {
+	if (typeof offset === 'number' && (!Number.isInteger(offset) || offset < 0)) {
+		throw new Error(`${fn}() expects a non-negative integer, received ${offset}`);
+	}
+}
+
+/** `<offset> preceding` frame boundary */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertFrameOffset('preceding', offset);
+	return Object.freeze({ kind: 'preceding' as const, offset });
+}
+
+/** `<offset> following` frame boundary */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertFrameOffset('following', offset);
+	return Object.freeze({ kind: 'following' as const, offset });
+}
+
+const boundaryRank: Record<WindowFrameBoundary['kind'], number> = {
+	unboundedPreceding: 0,
+	preceding: 1,
+	currentRow: 2,
+	following: 3,
+	unboundedFollowing: 4,
+};
+
+/** Returns a negative number if `a` comes before `b`, positive if after, 0 if equal or unknown. */
+function compareBoundaries(a: WindowFrameBoundary, b: WindowFrameBoundary): number {
+	const diff = boundaryRank[a.kind] - boundaryRank[b.kind];
+	if (diff !== 0) return diff;
+	if (typeof a.offset !== 'number' || typeof b.offset !== 'number') return 0;
+	// `5 preceding` comes before `2 preceding`; `2 following` comes before `5 following`
+	return a.kind === 'preceding' ? b.offset - a.offset : a.offset - b.offset;
+}
+
+function boundaryToSQL(boundary: WindowFrameBoundary): SQL {
+	switch (boundary.kind) {
+		case 'unboundedPreceding':
+			return sql.raw('unbounded preceding');
+		case 'currentRow':
+			return sql.raw('current row');
+		case 'unboundedFollowing':
+			return sql.raw('unbounded following');
+		case 'preceding':
+		case 'following': {
+			const offset = typeof boundary.offset === 'number' ? sql.raw(String(boundary.offset)) : boundary.offset;
+			return sql`${offset} ${sql.raw(boundary.kind)}`;
+		}
+	}
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(readonly mode: 'rows' | 'range', readonly from: WindowFrameBoundary, readonly to?: WindowFrameBoundary) {}
+
+	getSQL(): SQL {
+		if (this.to === undefined) {
+			return sql`${sql.raw(this.mode)} ${boundaryToSQL(this.from)}`;
+		}
+		return sql`${sql.raw(this.mode)} between ${boundaryToSQL(this.from)} and ${boundaryToSQL(this.to)}`;
+	}
+}
+
+function buildFrame(mode: 'rows' | 'range', spec: WindowFrameSpec): WindowFrame {
+	const { from, to } = spec;
+	if (!from || !(from.kind in boundaryRank)) {
+		throw new Error(`${mode}() expects a valid "from" frame boundary`);
+	}
+	if (from.kind === 'unboundedFollowing') {
+		throw new Error(`${mode}(): "from" boundary cannot be unboundedFollowing`);
+	}
+	if (to !== undefined) {
+		if (!(to.kind in boundaryRank)) {
+			throw new Error(`${mode}() expects a valid "to" frame boundary`);
+		}
+		if (compareBoundaries(from, to) > 0) {
+			throw new Error(`${mode}(): "from" boundary must not come after the "to" boundary`);
+		}
+		if (to.kind === 'unboundedPreceding') {
+			throw new Error(`${mode}(): "to" boundary cannot be unboundedPreceding`);
+		}
+	}
+	return new WindowFrame(mode, from, to);
+}
+
+/**
+ * Builds a `rows` window frame.
+ *
+ * @example
+ * ```ts
+ * windowSum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * })
+ * ```
+ */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/**
+ * Builds a `range` window frame.
+ *
+ * @example
+ * ```ts
+ * windowAvg(prices.value).over({
+ *   orderBy: prices.day,
+ *   frame: range({ from: preceding(3), to: currentRow }),
+ * })
+ * ```
+ */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+/** @internal */
+export function assertWindowName(name: string): void {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not consist only of whitespace');
+	}
+}
+
+/** @internal */
+export function windowSpecToSQL(spec: WindowSpec = {}): SQL {
+	const chunks: SQL[] = [];
+	const toList = (value: SQLWrapper | SQLWrapper[]) => sql.join(Array.isArray(value) ? value : [value], sql`, `);
+	if (spec.partitionBy !== undefined && (!Array.isArray(spec.partitionBy) || spec.partitionBy.length > 0)) {
+		chunks.push(sql`partition by ${toList(spec.partitionBy)}`);
+	}
+	if (spec.orderBy !== undefined && (!Array.isArray(spec.orderBy) || spec.orderBy.length > 0)) {
+		chunks.push(sql`order by ${toList(spec.orderBy)}`);
+	}
+	if (spec.frame) {
+		chunks.push(spec.frame.getSQL());
+	}
+	return sql.join(chunks, sql` `);
+}
+
+/** @internal */
+export function windowDefinitionsToSQL(windows: { name: string; spec: WindowSpec }[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${windowSpecToSQL(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+/**
+ * A window function call that must be completed with {@link WindowFunction.over}.
+ */
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: { readonly type: T };
+
+	constructor(
+		/** @internal */
+		readonly call: SQL,
+		/** @internal */
+		readonly decoder?: DriverValueDecoder<any, any> | ((value: any) => any),
+	) {}
+
+	/**
+	 * Adds an `over` clause, either with an inline window specification or a reference
+	 * to a named window defined with `.window(name, spec)` on the select builder.
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		let overSql: SQL;
+		if (typeof spec === 'string') {
+			assertWindowName(spec);
+			overSql = sql`${this.call} over ${sql.identifier(spec)}`;
+		} else {
+			overSql = sql`${this.call} over (${windowSpecToSQL(spec)})`;
+		}
+		return (this.decoder ? overSql.mapWith(this.decoder as any) : overSql) as SQL<T>;
+	}
+}
+
+function decoderOf(expression: SQLWrapper): DriverValueDecoder<any, any> | undefined {
+	if (is(expression, Column)) return expression;
+	if (is(expression, SQL)) return expression.decoder;
+	if (is(expression, SQL.Aliased)) return expression.sql.decoder;
+	return undefined;
+}
+
+function assertPositiveInteger(fn: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fn}() expects a positive integer, received ${value}`);
+	}
+}
+
+function assertNonNegativeInteger(fn: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${fn}() expects a non-negative integer, received ${value}`);
+	}
+}
+
+/** Renders a numeric positional argument inline so it never becomes a bound parameter. */
+function inlineNumber(value: number): SQL {
+	return sql.raw(String(value));
+}
+
+function valueArg(value: unknown): unknown {
+	if (typeof value === 'number' && Number.isFinite(value)) return inlineNumber(value);
+	return value;
+}
+
+// Ranking functions
+
+/** `row_number()` - number of the current row within its partition, counting from 1. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+/** `rank()` - rank of the current row with gaps. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+/** `dense_rank()` - rank of the current row without gaps. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+/** `ntile(n)` - integer ranging from 1 to `buckets`, dividing the partition as equally as possible. */
+export function ntile(buckets: number): WindowFunction<number> {
+	assertPositiveInteger('ntile', buckets);
+	return new WindowFunction(sql`ntile(${inlineNumber(buckets)})`, Number);
+}
+
+/** `percent_rank()` - relative rank of the current row: (rank - 1) / (total rows - 1). */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+/** `cume_dist()` - cumulative distribution of the current row. */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+// Offset / value functions
+
+function offsetFunction(
+	name: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultValue: unknown,
+): WindowFunction<any> {
+	const args: unknown[] = [expression];
+	if (offset !== undefined) assertNonNegativeInteger(name, offset);
+	if (offset !== undefined || defaultValue !== undefined) {
+		args.push(inlineNumber(offset ?? 1));
+	}
+	if (defaultValue !== undefined) {
+		args.push(valueArg(defaultValue));
+	}
+	return new WindowFunction(
+		sql`${sql.raw(name)}(${sql.join(args.map((arg) => sql`${arg}`), sql`, `)})`,
+		decoderOf(expression),
+	);
+}
+
+/**
+ * `lag(expression, offset, default)` - value of `expression` evaluated at the row `offset` rows
+ * before the current row within the partition. Returns `default` (or null) if there is no such row.
+ */
+export function lag<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<InferWindowData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<InferWindowData<T>> | SQLWrapper,
+): WindowFunction<NonNullable<InferWindowData<T>>>;
+export function lag(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lag', expression, offset, defaultValue);
+}
+
+/**
+ * `lead(expression, offset, default)` - value of `expression` evaluated at the row `offset` rows
+ * after the current row within the partition. Returns `default` (or null) if there is no such row.
+ */
+export function lead<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<InferWindowData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | undefined,
+	defaultValue: NonNullable<InferWindowData<T>> | SQLWrapper,
+): WindowFunction<NonNullable<InferWindowData<T>>>;
+export function lead(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return offsetFunction('lead', expression, offset, defaultValue);
+}
+
+/** `first_value(expression)` - value of `expression` at the first row of the window frame. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, decoderOf(expression));
+}
+
+/** `last_value(expression)` - value of `expression` at the last row of the window frame. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, decoderOf(expression));
+}
+
+/** `nth_value(expression, n)` - value of `expression` at the `n`-th row of the window frame (counting from 1). */
+export function nthValue<T extends SQLWrapper>(expression: T, n: number): WindowFunction<InferWindowData<T> | null> {
+	assertPositiveInteger('nthValue', n);
+	return new WindowFunction(sql`nth_value(${expression}, ${inlineNumber(n)})`, decoderOf(expression));
+}
+
+// Aggregate window functions
+
+/** `sum(expression) over (...)` */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+/** `avg(expression) over (...)` */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+/** `min(expression) over (...)` */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends Column ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `max(expression) over (...)` */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends Column ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `count(expression) over (...)`, or `count(*) over (...)` when no expression is given. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
