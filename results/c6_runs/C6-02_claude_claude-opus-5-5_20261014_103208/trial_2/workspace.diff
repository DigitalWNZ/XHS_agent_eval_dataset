diff --git a/drizzle-orm/tests/window/window.test.ts b/drizzle-orm/tests/window/window.test.ts
new file mode 100644
index 00000000..96b3bd28
--- /dev/null
+++ b/drizzle-orm/tests/window/window.test.ts
@@ -0,0 +1,130 @@
+import { describe, expect, expectTypeOf, it } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	type SQL,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int as myInt, mysqlTable } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { integer, PgDialect, pgTable, text } from '~/pg-core/index.ts';
+import { integer as sqliteInt, sqliteTable } from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').notNull(),
+	dept: text('dept').notNull(),
+	salary: integer('salary'),
+});
+
+const dialect = new PgDialect();
+const q = (s: any) => dialect.sqlToQuery(s);
+
+describe('window functions', () => {
+	it('compiles ranking functions', () => {
+		expect(q(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(q(rank().over({})).sql).toBe('rank() over ()');
+		expect(q(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(q(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(q(cumeDist().over()).sql).toBe('cume_dist() over ()');
+		const n = q(ntile(4).over());
+		expect(n.sql).toBe('ntile(4) over ()');
+		expect(n.params).toEqual([]);
+	});
+
+	it('compiles specs with partition, order and frame', () => {
+		const query = q(
+			windowSum(employees.salary).over({
+				partitionBy: employees.dept,
+				orderBy: [desc(employees.salary), employees.id],
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+		);
+		expect(query.sql).toBe(
+			'sum("employees"."salary") over (partition by "employees"."dept" order by "employees"."salary" desc, "employees"."id" rows between unbounded preceding and current row)',
+		);
+		expect(q(windowAvg(employees.salary).over({ frame: range({ from: preceding(0), to: following(2) }) })))
+			.toEqual({ sql: 'avg("employees"."salary") over (range between 0 preceding and 2 following)', params: [] });
+		expect(q(windowCount().over('w')).sql).toBe('count(*) over "w"');
+		expect(q(windowMin(employees.salary).over()).sql).toBe('min("employees"."salary") over ()');
+		expect(q(windowMax(employees.salary).over()).sql).toBe('max("employees"."salary") over ()');
+	});
+
+	it('compiles offset functions without binding numeric args', () => {
+		expect(q(lag(employees.salary).over()).sql).toBe('lag("employees"."salary") over ()');
+		expect(q(lag(employees.salary, 0).over())).toEqual({ sql: 'lag("employees"."salary", 0) over ()', params: [] });
+		expect(q(lead(employees.salary, 2, 0).over())).toEqual({
+			sql: 'lead("employees"."salary", 2, 0) over ()',
+			params: [],
+		});
+		expect(q(firstValue(employees.salary).over()).sql).toBe('first_value("employees"."salary") over ()');
+		expect(q(lastValue(employees.salary).over()).sql).toBe('last_value("employees"."salary") over ()');
+		expect(q(nthValue(employees.salary, 2).over())).toEqual({
+			sql: 'nth_value("employees"."salary", 2) over ()',
+			params: [],
+		});
+	});
+
+	it('validates arguments', () => {
+		expect(() => ntile(0)).toThrow(/ntile.*0/);
+		expect(() => ntile(1.5)).toThrow(/ntile.*1\.5/);
+		expect(() => nthValue(employees.salary, -1)).toThrow(/nthValue.*-1/);
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => following(1.5)).toThrow(/following/);
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrow(/from/);
+		expect(() => rows({ from: preceding(1), to: preceding(3) })).toThrow(/from/);
+		expect(() => range({ from: following(1), to: currentRow })).toThrow(/from/);
+		expect(() => rows({ from: unboundedPreceding, to: unboundedFollowing })).not.toThrow();
+	});
+
+	it('types', () => {
+		expectTypeOf(lag(employees.salary).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(lag(employees.id, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(firstValue(employees.dept).over()).toEqualTypeOf<SQL<string | null>>();
+		expectTypeOf(rowNumber().over()).toEqualTypeOf<SQL<number>>();
+	});
+
+	it('named windows in pg', () => {
+		const db = pgDrizzle.mock();
+		const query = db.select({ r: rank().over('w') }).from(employees)
+			.window('w', { partitionBy: employees.dept, orderBy: desc(employees.salary) })
+			.orderBy(employees.id).toSQL();
+		expect(query.sql).toBe(
+			'select rank() over "w" from "employees" window "w" as (partition by "employees"."dept" order by "employees"."salary" desc) order by "employees"."id"',
+		);
+		expect(() => db.select().from(employees).window('', {})).toThrow(/non-empty/);
+		expect(() => db.select().from(employees).window('   ', {})).toThrow(/whitespace/);
+	});
+
+	it('named windows in mysql and sqlite', () => {
+		const t = mysqlTable('t', { a: myInt('a') });
+		expect(
+			mysqlDrizzle.mock().select({ r: rowNumber().over('w') }).from(t).window('w', { orderBy: t.a }).toSQL().sql,
+		).toBe('select row_number() over `w` from `t` window `w` as (order by `t`.`a`)');
+		const s = sqliteTable('s', { a: sqliteInt('a') });
+		expect(sqliteDrizzle.mock().select({ r: rowNumber().over('w') }).from(s).window('w', {}).toSQL().sql)
+			.toBe('select row_number() over "w" from "s" window "w" as ()');
+	});
+});
