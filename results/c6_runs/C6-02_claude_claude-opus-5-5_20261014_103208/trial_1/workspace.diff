diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..8eb82734
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,402 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { bindIfParam } from '../expressions/conditions.ts';
+import { type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+type WindowExpressionData<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+type BoundaryKind = 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing';
+
+/**
+ * A single boundary of a window frame (e.g. `unbounded preceding`, `3 following`).
+ *
+ * Use {@link unboundedPreceding}, {@link currentRow}, {@link unboundedFollowing},
+ * {@link preceding} or {@link following} to create one.
+ */
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	constructor(
+		readonly kind: BoundaryKind,
+		readonly offset?: number | SQLWrapper,
+	) {}
+
+	getSQL(): SQL {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return sql.raw('unbounded preceding');
+			}
+			case 'currentRow': {
+				return sql.raw('current row');
+			}
+			case 'unboundedFollowing': {
+				return sql.raw('unbounded following');
+			}
+			default: {
+				const direction = this.kind === 'preceding' ? 'preceding' : 'following';
+				const offset = typeof this.offset === 'number' ? sql.raw(String(this.offset)) : this.offset!;
+				return sql`${offset} ${sql.raw(direction)}`;
+			}
+		}
+	}
+
+	/** @internal Position of the boundary on a number line, or `undefined` if it can't be determined statically. */
+	position(): number | undefined {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return Number.NEGATIVE_INFINITY;
+			}
+			case 'currentRow': {
+				return 0;
+			}
+			case 'unboundedFollowing': {
+				return Number.POSITIVE_INFINITY;
+			}
+			default: {
+				if (typeof this.offset !== 'number') return undefined;
+				return this.kind === 'preceding' ? -this.offset : this.offset;
+			}
+		}
+	}
+}
+
+/** `unbounded preceding` frame boundary. */
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary('unboundedPreceding');
+/** `current row` frame boundary. */
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary('currentRow');
+/** `unbounded following` frame boundary. */
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary('unboundedFollowing');
+
+function assertFrameOffset(fn: string, offset: unknown): void {
+	if (typeof offset === 'number' && (!Number.isInteger(offset) || offset < 0)) {
+		throw new Error(`${fn}() expects a non-negative integer offset, received ${offset}`);
+	}
+}
+
+/**
+ * `<offset> preceding` frame boundary.
+ *
+ * @param offset a non-negative integer, or an SQL expression (e.g. an interval for `range` frames)
+ */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertFrameOffset('preceding', offset);
+	return new WindowFrameBoundary('preceding', offset);
+}
+
+/**
+ * `<offset> following` frame boundary.
+ *
+ * @param offset a non-negative integer, or an SQL expression (e.g. an interval for `range` frames)
+ */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertFrameOffset('following', offset);
+	return new WindowFrameBoundary('following', offset);
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+/** A window frame clause, created with {@link rows} or {@link range}. */
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	constructor(
+		readonly mode: 'rows' | 'range',
+		readonly spec: WindowFrameSpec,
+	) {}
+
+	getSQL(): SQL {
+		const { from, to } = this.spec;
+		if (!to) {
+			return sql`${sql.raw(this.mode)} ${from}`;
+		}
+		return sql`${sql.raw(this.mode)} between ${from} and ${to}`;
+	}
+}
+
+function createFrame(mode: 'rows' | 'range', spec: WindowFrameSpec): WindowFrame {
+	if (!spec || !is(spec.from, WindowFrameBoundary)) {
+		throw new Error(`${mode}() expects a "from" frame boundary`);
+	}
+	if (spec.to !== undefined) {
+		if (!is(spec.to, WindowFrameBoundary)) {
+			throw new Error(`${mode}() expects "to" to be a frame boundary`);
+		}
+		const fromPosition = spec.from.position();
+		const toPosition = spec.to.position();
+		if (fromPosition !== undefined && toPosition !== undefined && fromPosition > toPosition) {
+			throw new Error(`${mode}() frame "from" boundary must not come after the "to" boundary`);
+		}
+	}
+	return new WindowFrame(mode, spec);
+}
+
+/**
+ * Creates a `rows` window frame.
+ *
+ * @example
+ *
+ * ```ts
+ * windowSum(orders.amount).over({
+ * 	orderBy: orders.createdAt,
+ * 	frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * })
+ * ```
+ */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return createFrame('rows', spec);
+}
+
+/**
+ * Creates a `range` window frame.
+ *
+ * @example
+ *
+ * ```ts
+ * windowAvg(prices.value).over({
+ * 	orderBy: prices.day,
+ * 	frame: range({ from: preceding(7), to: currentRow }),
+ * })
+ * ```
+ */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return createFrame('range', spec);
+}
+
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+/** @internal */
+export function assertWindowName(name: unknown): asserts name is string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not be whitespace only');
+	}
+}
+
+/** @internal Builds the contents of a window specification (without the surrounding parentheses). */
+export function buildWindowSpec(spec: WindowSpec | undefined): SQL {
+	const chunks: SQL[] = [];
+	if (spec?.partitionBy !== undefined) {
+		const partitionBy = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionBy.length > 0) {
+			chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+		}
+	}
+	if (spec?.orderBy !== undefined) {
+		const orderBy = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderBy.length > 0) {
+			chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+		}
+	}
+	if (spec?.frame) {
+		chunks.push(spec.frame.getSQL());
+	}
+	return sql.join(chunks, sql` `);
+}
+
+/** @internal Builds a `window` clause from named window definitions. */
+export function buildWindowClause(windows: { name: string; spec: WindowSpec }[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) return undefined;
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+/**
+ * A window function call that must be completed with {@link WindowFunction.over}.
+ */
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: {
+		readonly type: T;
+	};
+
+	constructor(
+		private readonly fn: SQL,
+		private readonly decoder?: Column | ((value: any) => any),
+	) {}
+
+	/**
+	 * Adds an `over` clause to the window function.
+	 *
+	 * @param spec an inline window specification, or the name of a window defined with `.window()`
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		let result: SQL;
+		if (typeof spec === 'string') {
+			assertWindowName(spec);
+			result = sql`${this.fn} over ${sql.identifier(spec)}`;
+		} else {
+			result = sql`${this.fn} over (${buildWindowSpec(spec)})`;
+		}
+		return (this.decoder ? result.mapWith(this.decoder) : result) as SQL<T>;
+	}
+}
+
+function assertPositiveInteger(fn: string, value: unknown): asserts value is number {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fn}() expects a positive integer, received ${value}`);
+	}
+}
+
+function assertInteger(fn: string, value: unknown): asserts value is number {
+	if (typeof value !== 'number' || !Number.isInteger(value)) {
+		throw new Error(`${fn}() expects an integer offset, received ${value}`);
+	}
+}
+
+function valueDecoder(expression: SQLWrapper): Column | undefined {
+	return is(expression, Column) ? expression : undefined;
+}
+
+/** `row_number()` - number of the current row within its partition, counting from 1. */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, Number);
+}
+
+/** `rank()` - rank of the current row, with gaps. */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, Number);
+}
+
+/** `dense_rank()` - rank of the current row, without gaps. */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, Number);
+}
+
+/** `ntile(buckets)` - integer ranging from 1 to `buckets`, dividing the partition as equally as possible. */
+export function ntile(buckets: number): WindowFunction<number> {
+	assertPositiveInteger('ntile', buckets);
+	return new WindowFunction(sql`ntile(${sql.raw(String(buckets))})`, Number);
+}
+
+/** `percent_rank()` - relative rank of the current row: (rank - 1) / (total partition rows - 1). */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, Number);
+}
+
+/** `cume_dist()` - cumulative distribution: (rows preceding or peers with current row) / (total partition rows). */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, Number);
+}
+
+function offsetFunction(name: 'lag' | 'lead', expression: SQLWrapper, args: unknown[]): WindowFunction<any> {
+	const [offset, defaultValue] = args;
+	const chunks: unknown[] = [expression];
+	if (args.length > 0) {
+		assertInteger(name, offset);
+		chunks.push(sql.raw(String(offset)));
+		if (args.length > 1) {
+			chunks.push(bindIfParam(defaultValue, expression));
+		}
+	}
+	return new WindowFunction(
+		sql`${sql.raw(name)}(${sql.join(chunks as SQLWrapper[], sql`, `)})`,
+		valueDecoder(expression),
+	);
+}
+
+/**
+ * `lag(expression, offset, default)` - value of `expression` at the row `offset` rows before the current row
+ * within the partition. Returns `default` (or `null`) if there is no such row.
+ */
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<WindowExpressionData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: WindowExpressionData<T> | SQLWrapper,
+): WindowFunction<NonNullable<WindowExpressionData<T>>>;
+export function lag(expression: SQLWrapper, ...args: unknown[]): WindowFunction<any> {
+	return offsetFunction('lag', expression, args);
+}
+
+/**
+ * `lead(expression, offset, default)` - value of `expression` at the row `offset` rows after the current row
+ * within the partition. Returns `default` (or `null`) if there is no such row.
+ */
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunction<WindowExpressionData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: WindowExpressionData<T> | SQLWrapper,
+): WindowFunction<NonNullable<WindowExpressionData<T>>>;
+export function lead(expression: SQLWrapper, ...args: unknown[]): WindowFunction<any> {
+	return offsetFunction('lead', expression, args);
+}
+
+/** `first_value(expression)` - value of `expression` at the first row of the window frame. */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<WindowExpressionData<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, valueDecoder(expression));
+}
+
+/** `last_value(expression)` - value of `expression` at the last row of the window frame. */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<WindowExpressionData<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, valueDecoder(expression));
+}
+
+/** `nth_value(expression, n)` - value of `expression` at the `n`-th row of the window frame (counting from 1). */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<WindowExpressionData<T> | null> {
+	assertPositiveInteger('nthValue', n);
+	return new WindowFunction(sql`nth_value(${expression}, ${sql.raw(String(n))})`, valueDecoder(expression));
+}
+
+/** `sum(expression)` as a window function. */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, String);
+}
+
+/** `avg(expression)` as a window function. */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, String);
+}
+
+/** `min(expression)` as a window function. */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `max(expression)` as a window function. */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : String);
+}
+
+/** `count(expression)` as a window function. Emits `count(*)` when called without an argument. */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
