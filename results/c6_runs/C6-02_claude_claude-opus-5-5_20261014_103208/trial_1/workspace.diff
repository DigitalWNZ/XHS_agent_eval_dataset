diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..5b55ff35
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,152 @@
+import { describe, expect, expectTypeOf, test } from 'vitest';
+import { drizzle as sqliteDrizzle } from '~/better-sqlite3/index.ts';
+import {
+	asc,
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	type SQL,
+	sql,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int, mysqlTable, varchar } from '~/mysql-core/index.ts';
+import { drizzle as mysqlDrizzle } from '~/mysql2/index.ts';
+import { drizzle as pgDrizzle } from '~/node-postgres/index.ts';
+import { PgDialect } from '~/pg-core/dialect.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { integer as sqliteInteger, sqliteTable } from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	dept: text('dept').notNull(),
+	salary: integer('salary').notNull(),
+	bonus: integer('bonus'),
+});
+
+const dialect = new PgDialect();
+const db = pgDrizzle.mock();
+const q = (s: { getSQL(): any }) => dialect.sqlToQuery(s.getSQL());
+
+describe('window functions', () => {
+	test('names', () => {
+		expect(q(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(q(rank().over()).sql).toBe('rank() over ()');
+		expect(q(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(q(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(q(cumeDist().over()).sql).toBe('cume_dist() over ()');
+		expect(q(ntile(4).over())).toEqual({ sql: 'ntile(4) over ()', params: [] });
+		expect(q(firstValue(employees.salary).over()).sql).toBe('first_value("employees"."salary") over ()');
+		expect(q(lastValue(employees.salary).over()).sql).toBe('last_value("employees"."salary") over ()');
+		expect(q(nthValue(employees.salary, 2).over())).toEqual({
+			sql: 'nth_value("employees"."salary", 2) over ()',
+			params: [],
+		});
+		expect(q(windowSum(employees.salary).over()).sql).toBe('sum("employees"."salary") over ()');
+		expect(q(windowAvg(employees.salary).over()).sql).toBe('avg("employees"."salary") over ()');
+		expect(q(windowMin(employees.salary).over()).sql).toBe('min("employees"."salary") over ()');
+		expect(q(windowMax(employees.salary).over()).sql).toBe('max("employees"."salary") over ()');
+		expect(q(windowCount().over()).sql).toBe('count(*) over ()');
+		expect(q(windowCount(employees.id).over()).sql).toBe('count("employees"."id") over ()');
+	});
+
+	test('lag / lead positional args', () => {
+		expect(q(lag(employees.salary).over())).toEqual({ sql: 'lag("employees"."salary") over ()', params: [] });
+		expect(q(lead(employees.salary, 0).over())).toEqual({ sql: 'lead("employees"."salary", 0) over ()', params: [] });
+		expect(q(lag(employees.salary, 2, 100).over())).toEqual({
+			sql: 'lag("employees"."salary", 2, $1) over ()',
+			params: [100],
+			typings: ['none'],
+		});
+	});
+
+	test('over spec', () => {
+		expect(
+			q(
+				windowSum(employees.salary).over({
+					partitionBy: employees.dept,
+					orderBy: [asc(employees.id), desc(employees.salary)],
+					frame: rows({ from: unboundedPreceding, to: currentRow }),
+				}),
+			),
+		).toEqual({
+			sql:
+				'sum("employees"."salary") over (partition by "employees"."dept" order by "employees"."id" asc, "employees"."salary" desc rows between unbounded preceding and current row)',
+			params: [],
+		});
+		expect(
+			q(
+				windowAvg(employees.salary).over({
+					orderBy: employees.id,
+					frame: range({ from: preceding(0), to: following(3) }),
+				}),
+			)
+				.sql,
+		).toBe('avg("employees"."salary") over (order by "employees"."id" range between 0 preceding and 3 following)');
+		expect(q(rank().over('w')).sql).toBe('rank() over "w"');
+	});
+
+	test('validation', () => {
+		expect(() => ntile(0)).toThrow(/ntile.*0/);
+		expect(() => nthValue(employees.salary, 1.5)).toThrow(/nthValue.*1\.5/);
+		expect(() => preceding(-1)).toThrow(/preceding/);
+		expect(() => following(0.5)).toThrow(/following/);
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrow(/from/);
+		expect(() => range({ from: following(2), to: following(1) })).toThrow(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: unboundedFollowing })).not.toThrow();
+		expect(() => db.select().from(employees).window('', {})).toThrow(/non-empty/);
+		expect(() => db.select().from(employees).window('  ', {})).toThrow(/whitespace/);
+	});
+
+	test('named windows (pg)', () => {
+		const query = db
+			.select({ id: employees.id, r: rank().over('w'), s: windowSum(employees.salary).over('w2') })
+			.from(employees)
+			.window('w', { partitionBy: employees.dept, orderBy: desc(employees.salary) })
+			.window('w2', {})
+			.orderBy(employees.id)
+			.toSQL();
+		expect(query.sql).toBe(
+			'select "id", rank() over "w", sum("employees"."salary") over "w2" from "employees" window "w" as (partition by "employees"."dept" order by "employees"."salary" desc), "w2" as () order by "employees"."id"',
+		);
+	});
+
+	test('named windows (mysql, sqlite)', () => {
+		const m = mysqlTable('m', { id: int('id'), name: varchar('name', { length: 10 }) });
+		expect(
+			mysqlDrizzle.mock().select({ r: rowNumber().over('w') }).from(m).window('w', { orderBy: m.id }).toSQL().sql,
+		).toBe('select row_number() over `w` from `m` window `w` as (order by `m`.`id`)');
+		const s = sqliteTable('s', { id: sqliteInteger('id') });
+		expect(
+			sqliteDrizzle({} as any).select({ r: rowNumber().over('w') }).from(s).window('w', { orderBy: s.id }).toSQL().sql,
+		).toBe('select row_number() over "w" from "s" window "w" as (order by "s"."id")');
+	});
+
+	test('types', () => {
+		expectTypeOf(rowNumber().over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(lag(employees.salary).over()).toEqualTypeOf<SQL<number | null>>();
+		expectTypeOf(lag(employees.bonus, 1, 0).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(lead(employees.salary, 1, sql`0`).over()).toEqualTypeOf<SQL<number>>();
+		expectTypeOf(firstValue(employees.dept).over()).toEqualTypeOf<SQL<string | null>>();
+		expectTypeOf(nthValue(sql<Date>`now()`, 1).over()).toEqualTypeOf<SQL<Date | null>>();
+	});
+});
