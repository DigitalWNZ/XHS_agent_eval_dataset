--- /dev/null
+++ b/jump_analyzer.py
@@ -0,0 +1,234 @@
+#!/usr/bin/env python3
+import cv2
+import numpy as np
+import toml
+
+
+def analyze_video(video_path: str) -> tuple[int, int]:
+    cv2.setNumThreads(2)
+    cap = cv2.VideoCapture(video_path)
+    if not cap.isOpened():
+        raise ValueError(f"Could not open video file: {video_path}")
+
+    fps = cap.get(cv2.CAP_PROP_FPS)
+    if not fps or fps <= 0 or np.isnan(fps):
+        fps = 30.0
+    fps_scale = fps / 30.0
+
+    ret, f0 = cap.read()
+    if not ret or f0 is None:
+        cap.release()
+        raise ValueError(f"Could not read first frame from: {video_path}")
+
+    h, w = f0.shape[:2]
+    sy = h / 540.0
+    sx = w / 960.0
+
+    # Reference patch on the lower track (128x512 power-of-2 dimensions for fast FFT)
+    py0 = int(round(380 * sy))
+    py1 = min(h, py0 + 128)
+    px0 = int(round(220 * sx))
+    px1 = min(w, px0 + 512)
+    f0_patch_gray = cv2.cvtColor(f0[py0:py1, px0:px1], cv2.COLOR_BGR2GRAY).astype(np.float32)
+    f0_patch_mean = np.array(cv2.mean(f0[py0:py1, px0:px1])[:3], dtype=np.float32)
+
+    # Vertical ROI for lower-body / track detection
+    ry0, ry1 = int(round(150 * sy)), int(round(390 * sy))
+    roi_h = ry1 - ry0
+    f0_roi_blur = cv2.GaussianBlur(f0[ry0:ry1, :], (5, 5), 0).astype(np.int32)
+
+    k_size = max(3, int(round(5 * min(sx, sy))) | 1)
+    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k_size, k_size))
+    min_comp_area = max(20, int(round(80 * sx * sy)))
+    min_athlete_area = max(400, int(round(2000 * sx * sy)))
+
+    frame_stats = {}
+    frame_idx = 1
+
+    while True:
+        ret, f = cap.read()
+        if not ret or f is None:
+            break
+
+        patch_bgr = f[py0:py1, px0:px1]
+        patch_gray = cv2.cvtColor(patch_bgr, cv2.COLOR_BGR2GRAY).astype(np.float32)
+        (dx, dy), _ = cv2.phaseCorrelate(f0_patch_gray, patch_gray)
+        max_shift = 15.0 * max(sx, sy)
+        if abs(dx) < max_shift and abs(dy) < max_shift and (abs(dx) > 0.1 or abs(dy) > 0.1):
+            M = np.float32([[1.0, 0.0, -dx], [0.0, 1.0, -dy - ry0]])
+            roi = cv2.warpAffine(f, M, (w, roi_h), borderMode=cv2.BORDER_REPLICATE)
+        else:
+            roi = f[ry0:ry1, :]
+
+        # Compensate for any global exposure / illumination drift
+        illum_shift = np.round(
+            np.array(cv2.mean(patch_bgr)[:3], dtype=np.float32) - f0_patch_mean
+        ).astype(np.int32)
+
+        roi_blur = cv2.GaussianBlur(roi, (5, 5), 0).astype(np.int32) - illum_shift
+        d = roi_blur - f0_roi_blur
+        dist2 = d[:, :, 0] * d[:, :, 0] + d[:, :, 1] * d[:, :, 1] + d[:, :, 2] * d[:, :, 2]
+
+        mask = (dist2 > 1225).astype(np.uint8)
+        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
+
+        num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(mask)
+        if num_labels > 1:
+            valid_Indices = [
+                lbl for lbl in range(1, num_labels)
+                if stats[lbl, cv2.CC_STAT_AREA] >= min_comp_area
+            ]
+            if valid_Indices:
+                # Find dominant horizontal cluster representing the athlete
+                best_lbl = max(valid_Indices, key=lambda lbl: stats[lbl, cv2.CC_STAT_AREA])
+                cx_main = centroids[best_lbl][0]
+                cluster_lbls = [
+                    lbl for lbl in valid_Indices
+                    if abs(centroids[lbl][0] - cx_main) <= 180.0 * sx
+                ]
+                total_area = sum(int(stats[lbl, cv2.CC_STAT_AREA]) for lbl in cluster_lbls)
+                if total_area >= min_athlete_area:
+                    y_max_rel = max(
+                        int(stats[lbl, cv2.CC_STAT_TOP] + stats[lbl, cv2.CC_STAT_HEIGHT])
+                        for lbl in cluster_lbls
+                    )
+                    y_max = ry0 + y_max_rel
+                    cx = sum(
+                        float(centroids[lbl][0]) * int(stats[lbl, cv2.CC_STAT_AREA])
+                        for lbl in cluster_lbls
+                    ) / total_area
+                    cy = ry0 + sum(
+                        float(centroids[lbl][1]) * int(stats[lbl, cv2.CC_STAT_AREA])
+                        for lbl in cluster_lbls
+                    ) / total_area
+                    frame_stats[frame_idx] = {
+                        "area": total_area,
+                        "y_max": y_max,
+                        "cx": cx,
+                        "cy": cy,
+                    }
+
+        frame_idx += 1
+
+    cap.release()
+
+    if not frame_stats:
+        raise RuntimeError("No athlete detected in video")
+
+    active_frames = sorted(frame_stats.keys())
+
+    # Prefer frames where athlete is well inside the horizontal field of view for peak detection
+    interior_frames = [
+        t for t in active_frames
+        if 140.0 * sx <= frame_stats[t]["cx"] <= 820.0 * sx
+        and frame_stats[t]["area"] >= int(round(3000 * sx * sy))
+    ]
+    if not interior_frames:
+        interior_frames = active_frames
+
+    # Find jump apex (minimum y_max, i.e., highest point of lowest foot above the track)
+    t_peak = min(interior_frames, key=lambda t: (frame_stats[t]["y_max"], frame_stats[t]["cy"]))
+
+    # Determine pre-jump ground level and takeoff frame
+    win_pre = max(3, int(round(8 * fps_scale)))
+    pre_candidates = [t for t in active_frames if t_peak - win_pre <= t < t_peak]
+    if not pre_candidates:
+        pre_candidates = [t for t in active_frames if t < t_peak]
+
+    if pre_candidates:
+        y_ground_pre = max(frame_stats[t]["y_max"] for t in pre_candidates)
+        ground_tol = max(4, int(round(6 * sy)))
+        on_ground_pre = [
+            t for t in pre_candidates
+            if frame_stats[t]["y_max"] >= y_ground_pre - ground_tol
+        ]
+        # Last frame on the ground before becoming airborne
+        t_last_ground = max(on_ground_pre)
+        # Check if push-off peak is 1 frame earlier
+        takeoff_frame = int(t_last_ground)
+    else:
+        takeoff_frame = int(max(1, t_peak - int(round(5 * fps_scale))))
+
+    # Determine post-jump ground level and landing frame
+    win_post = max(3, int(round(8 * fps_scale)))
+    post_candidates = [t for t in active_frames if t_peak < t <= t_peak + win_post]
+    if not post_candidates:
+        post_candidates = [t for t in active_frames if t > t_peak]
+
+    if post_candidates:
+        y_ground_post = max(frame_stats[t]["y_max"] for t in post_candidates)
+        ground_tol = max(4, int(round(6 * sy)))
+        on_ground_post = [
+            t for t in post_candidates
+            if frame_stats[t]["y_max"] >= y_ground_post - ground_tol
+        ]
+        # First frame where foot contacts the ground on landing
+        land_frame = int(min(on_ground_post))
+    else:
+        land_frame = int(t_peak + int(round(4 * fps_scale)))
+
+    return takeoff_frame, land_frame
+
+
+def write_output(takeoff_frame: int, land_frame: int, output_path: str = "/app/output.toml") -> None:
+    data = {
+        "jump_takeoff_frame_number": int(takeoff_frame),
+        "jump_land_frame_number": int(land_frame),
+    }
+    with open(output_path, "w") as f:
+        toml.dump(data, f)
+
+
+def main(argv=None) -> None:
+    if argv is None:
+        argv = cv2.sys.argv[1:]
+
+    video_path = None
+    custom_output = None
+
+    i = 0
+    positional = []
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-i", "--input", "-v", "--video", "-f", "--file") and i + 1 < len(argv):
+            video_path = argv[i + 1]
+            i += 2
+        elif arg in ("-o", "--output") and i + 1 < len(argv):
+            custom_output = argv[i + 1]
+            i += 2
+        elif arg.startswith("--") and "=" in arg:
+            k, v = arg.split("=", 1)
+            if k in ("--input", "--video", "--file", "--video_path", "--input_path"):
+                video_path = v
+            elif k in ("--output", "--output_path"):
+                custom_output = v
+            elif v.lower().endswith(".mp4"):
+                video_path = v
+            i += 1
+        elif not arg.startswith("-"):
+            positional.append(arg)
+            i += 1
+        else:
+            i += 1
+
+    if video_path is None:
+        for p in positional:
+            if p.lower().endswith(".mp4") or cv2.os.path.isfile(p):
+                video_path = p
+                break
+        if video_path is None and positional:
+            video_path = positional[0]
+        if custom_output is None and len(positional) >= 2 and positional[1] != video_path:
+            custom_output = positional[1]
+
+    if video_path is None:
+        video_path = "/app/example_video.mp4"
+
+    takeoff_frame, land_frame = analyze_video(video_path)
+    write_output(takeoff_frame, land_frame, "/app/output.toml")
+    if custom_output and custom_output != "/app/output.toml":
+        write_output(takeoff_frame, land_frame, custom_output)
+
+
+if __name__ == "__main__":
+    main()
