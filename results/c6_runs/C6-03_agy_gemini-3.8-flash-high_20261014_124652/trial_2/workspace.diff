+func TestWaitersUnblockOnClose(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	db, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	doneSeq := make(chan error, 1)
+	doneJob := make(chan error, 1)
+
+	// Start a waiter for a future seqnum.
+	go func() {
+		doneSeq <- db.WaitForDurability(1000)
+	}()
+
+	// Start a durability notify.
+	notifyCh := db.DurabilityNotify(1000)
+
+	// Close the DB.
+	require.NoError(t, db.Close())
+
+	// Waiter must unblock with error on close.
+	select {
+	case err := <-doneSeq:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrClosed))
+	case <-time.After(time.Second):
+		t.Fatal("waiter did not unblock on DB close")
+	}
+
+	// Notify channel must deliver error on close.
+	select {
+	case err := <-notifyCh:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrClosed))
+	case <-time.After(time.Second):
+		t.Fatal("notify channel did not deliver on DB close")
+	}
+
+	_ = doneJob
+}
