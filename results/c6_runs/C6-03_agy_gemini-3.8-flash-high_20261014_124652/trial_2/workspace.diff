+func TestContextCancellationPrecedence(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	db, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer db.Close()
+
+	require.NoError(t, db.Set([]byte("k"), []byte("v"), Sync))
+	highest, err := db.DurableState()
+	require.NoError(t, err)
+
+	// Context that is ALREADY cancelled.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	// Since highest is already durable, durability must take precedence over context cancellation!
+	require.NoError(t, db.WaitForDurabilityContext(ctx, highest))
+	require.NoError(t, db.WaitForDurabilityBatchContext(ctx, []base.SeqNum{highest}))
+
+	// For zero seqnum, already durable so succeeds:
+	require.NoError(t, db.WaitForDurabilityContext(ctx, 0))
+
+	// For a job that already completed, durability takes precedence over cancellation:
+	// We get its job ID by doing another sync commit:
+	var lastJobID int
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				lastJobID = info.JobID
+			},
+		},
+	}
+	db2, err := Open("", opts)
+	require.NoError(t, err)
+	defer db2.Close()
+
+	require.NoError(t, db2.Set([]byte("k2"), []byte("v2"), Sync))
+	require.Greater(t, lastJobID, 0)
+	require.NoError(t, db2.WaitForJobDurabilityContext(ctx, lastJobID))
+
+	// For a future seqnum, cancelled context returns ctx.Err().
+	futureCtx, futureCancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer futureCancel()
+	err = db.WaitForDurabilityContext(futureCtx, highest+1000)
+	require.Error(t, err)
+	require.Equal(t, context.DeadlineExceeded, err)
+}
