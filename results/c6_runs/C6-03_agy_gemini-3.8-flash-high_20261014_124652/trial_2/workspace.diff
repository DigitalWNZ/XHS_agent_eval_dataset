+func TestWaitForDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	mem := vfs.NewMem()
+	db, err := Open("", &Options{FS: mem})
+	require.NoError(t, err)
+	defer db.Close()
+
+	// Initially, WaitForDurability(0) blocks until a commit happens.
+	zeroDone := make(chan error, 1)
+	go func() {
+		zeroDone <- db.WaitForDurability(0)
+	}()
+
+	// Verify it's waiting.
+	select {
+	case <-zeroDone:
+		t.Fatal("WaitForDurability(0) should block before any commit")
+	case <-time.After(20 * time.Millisecond):
+	}
+
+	// Commit a write.
+	require.NoError(t, db.Set([]byte("k1"), []byte("v1"), Sync))
+
+	// Now WaitForDurability(0) must unblock with nil.
+	select {
+	case err := <-zeroDone:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for WaitForDurability(0)")
+	}
+
+	// Subsequent WaitForDurability(0) succeeds immediately.
+	require.NoError(t, db.WaitForDurability(0))
+
+	// Get state to know current highest durable seq num.
+	highestSeq, err := db.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, highestSeq, base.SeqNum(0))
+
+	// Waiting on highestSeq or lower returns nil immediately.
+	require.NoError(t, db.WaitForDurability(highestSeq))
+	require.NoError(t, db.WaitForDurability(highestSeq-1))
+
+	// Waiting on a future seq num blocks.
+	futureSeq := highestSeq + 100
+	futureDone := make(chan error, 1)
+	go func() {
+		futureDone <- db.WaitForDurability(futureSeq)
+	}()
+
+	select {
+	case <-futureDone:
+		t.Fatal("future seqnum should block")
+	case <-time.After(20 * time.Millisecond):
+	}
+
+	// Do multiple commits until futureSeq is exceeded.
+	for i := 0; i < 200; i++ {
+		require.NoError(t, db.Set([]byte(fmt.Sprintf("k%d", i)), []byte("val"), Sync))
+	}
+
+	select {
+	case err := <-futureDone:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for future seqnum")
+	}
+}
