new file mode 100644
index 00000000..9f3a939f
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,523 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// ErrJobExpired is returned by WaitForJobDurability when a job is outside the
+// bounded retention window.
+var ErrJobExpired = errors.New("pebble: job durability expired")
+
+// ErrJobUnknown is returned by WaitForJobDurability when a job was never seen
+// or has an invalid/zero ID.
+var ErrJobUnknown = errors.New("pebble: job durability unknown")
+
+// ErrTooManySubscriptions is returned by DurabilityNotify when the bound on
+// outstanding subscriptions is exceeded.
+var ErrTooManySubscriptions = errors.New("pebble: too many durability subscriptions")
+
+const (
+	maxRetainedJobs             = 4096
+	maxExpiredJobs              = 65536
+	maxOutstandingSubscriptions = 4096
+)
+
+// BatchDurableInfo carries information about a durable batch commit.
+type BatchDurableInfo struct {
+	JobID         int
+	SeqNum        base.SeqNum
+	Err           error
+	ApplyDuration time.Duration
+	SyncDuration  time.Duration
+	CorrelationID uint64
+	BatchSize     int
+	KeyCount      uint32
+}
+
+// DurabilityStats contains a point-in-time snapshot of durability statistics.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type jobState struct {
+	done bool
+	err  error
+	ch   chan struct{}
+}
+
+type durabilityWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+}
+
+type durabilitySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityManager struct {
+	mu sync.Mutex
+
+	batchDurableConfigured bool
+	durableCommitCount     uint64
+	durableCommitDuration  time.Duration
+
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	pendingWaiters         int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	closed bool
+
+	nextJobID        int
+	inFlightJobs     map[int]*jobState
+	retainedJobs     map[int]error
+	retainedOrder    []int
+	expiredJobs      map[int]struct{}
+	expiredOrder     []int
+	highestSeenJobID int
+	lowestSeenJobID  int
+
+	waiters       []*durabilityWaiter
+	subscriptions []*durabilitySub
+}
+
+func (dm *durabilityManager) init(batchDurableConfigured bool) {
+	dm.batchDurableConfigured = batchDurableConfigured
+	dm.nextJobID = 0
+	dm.inFlightJobs = make(map[int]*jobState)
+	dm.retainedJobs = make(map[int]error)
+	dm.retainedOrder = make([]int, 0, maxRetainedJobs)
+	dm.expiredJobs = make(map[int]struct{})
+	dm.expiredOrder = make([]int, 0, maxExpiredJobs)
+	dm.waiters = make([]*durabilityWaiter, 0)
+	dm.subscriptions = make([]*durabilitySub, 0)
+}
+
+func (dm *durabilityManager) isDurableLocked(seqNum base.SeqNum) bool {
+	if seqNum == 0 {
+		return dm.totalDurableCommits > 0
+	}
+	return dm.highestDurableSeqNum >= seqNum
+}
+
+func (dm *durabilityManager) allocateJobID() int {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	dm.nextJobID++
+	jobID := dm.nextJobID
+	if dm.lowestSeenJobID == 0 || jobID < dm.lowestSeenJobID {
+		dm.lowestSeenJobID = jobID
+	}
+	if jobID > dm.highestSeenJobID {
+		dm.highestSeenJobID = jobID
+	}
+	dm.inFlightJobs[jobID] = &jobState{
+		ch: make(chan struct{}),
+	}
+	return jobID
+}
+
+func (dm *durabilityManager) completeJobLocked(jobID int, err error) {
+	if js, ok := dm.inFlightJobs[jobID]; ok {
+		js.done = true
+		js.err = err
+		close(js.ch)
+		delete(dm.inFlightJobs, jobID)
+	}
+
+	dm.retainedJobs[jobID] = err
+	dm.retainedOrder = append(dm.retainedOrder, jobID)
+	if len(dm.retainedOrder) > maxRetainedJobs {
+		oldest := dm.retainedOrder[0]
+		dm.retainedOrder = dm.retainedOrder[1:]
+		delete(dm.retainedJobs, oldest)
+
+		dm.expiredJobs[oldest] = struct{}{}
+		dm.expiredOrder = append(dm.expiredOrder, oldest)
+		if len(dm.expiredOrder) > maxExpiredJobs {
+			evicted := dm.expiredOrder[0]
+			dm.expiredOrder = dm.expiredOrder[1:]
+			delete(dm.expiredJobs, evicted)
+		}
+	}
+}
+
+func (dm *durabilityManager) removeWaiter(w *durabilityWaiter) {
+	for i, waiter := range dm.waiters {
+		if waiter == w {
+			dm.waiters = slices.Delete(dm.waiters, i, i+1)
+			return
+		}
+	}
+}
+
+func (dm *durabilityManager) recordBatchDurable(info BatchDurableInfo) {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	if info.Err != nil {
+		dm.totalFailedCommits++
+		if dm.firstErr == nil {
+			dm.firstErr = info.Err
+		}
+	} else {
+		dm.totalDurableCommits++
+		lastSeq := info.SeqNum
+		if info.KeyCount > 0 {
+			lastSeq = info.SeqNum + base.SeqNum(info.KeyCount-1)
+		}
+		if lastSeq > dm.highestDurableSeqNum {
+			dm.highestDurableSeqNum = lastSeq
+		}
+		dm.cumulativeSyncDuration += info.SyncDuration
+		if info.SyncDuration > dm.maxSyncDuration {
+			dm.maxSyncDuration = info.SyncDuration
+		}
+		if dm.batchDurableConfigured {
+			dm.durableCommitCount++
+			dm.durableCommitDuration += info.SyncDuration
+		}
+	}
+
+	dm.completeJobLocked(info.JobID, info.Err)
+
+	// Wake up seqnum waiters.
+	activeWaiters := dm.waiters[:0]
+	for _, w := range dm.waiters {
+		if dm.firstErr != nil || dm.closed || dm.isDurableLocked(w.seqNum) {
+			select {
+			case w.ch <- struct{}{}:
+			default:
+			}
+		} else {
+			activeWaiters = append(activeWaiters, w)
+		}
+	}
+	dm.waiters = activeWaiters
+
+	// Notify subscriptions.
+	activeSubs := dm.subscriptions[:0]
+	for _, sub := range dm.subscriptions {
+		if dm.firstErr != nil {
+			select {
+			case sub.ch <- dm.firstErr:
+			default:
+			}
+		} else if dm.closed {
+			select {
+			case sub.ch <- ErrClosed:
+			default:
+			}
+		} else if dm.isDurableLocked(sub.seqNum) {
+			select {
+			case sub.ch <- nil:
+			default:
+			}
+		} else {
+			activeSubs = append(activeSubs, sub)
+		}
+	}
+	dm.subscriptions = activeSubs
+}
+
+func (dm *durabilityManager) onClose() {
+	dm.mu.Lock()
+	defer dm.mu.Unlock()
+
+	dm.closed = true
+	if dm.firstErr == nil {
+		dm.firstErr = ErrClosed
+	}
+
+	for _, w := range dm.waiters {
+		select {
+		case w.ch <- struct{}{}:
+		default:
+		}
+	}
+	dm.waiters = nil
+
+	for _, js := range dm.inFlightJobs {
+		js.done = true
+		js.err = ErrClosed
+		close(js.ch)
+	}
+	clear(dm.inFlightJobs)
+
+	for _, sub := range dm.subscriptions {
+		select {
+		case sub.ch <- ErrClosed:
+		default:
+		}
+	}
+	dm.subscriptions = nil
+}
+
+func (d *DB) onBatchDurable(info BatchDurableInfo) {
+	d.durability.recordBatchDurable(info)
+	if d.opts.EventListener.BatchDurable != nil {
+		d.opts.EventListener.BatchDurable(info)
+	}
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+// Zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable
+// or until the context is done. Durability and close errors take precedence
+// over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+
+	d.durability.mu.Lock()
+	if d.durability.isDurableLocked(seqNum) {
+		d.durability.mu.Unlock()
+		return nil
+	}
+	if d.durability.firstErr != nil {
+		err := d.durability.firstErr
+		d.durability.mu.Unlock()
+		return err
+	}
+	if d.durability.closed {
+		d.durability.mu.Unlock()
+		return ErrClosed
+	}
+	if ctx != nil && ctx.Err() != nil {
+		d.durability.mu.Unlock()
+		return ctx.Err()
+	}
+
+	atomic.AddInt64(&d.durability.pendingWaiters, 1)
+	defer atomic.AddInt64(&d.durability.pendingWaiters, -1)
+
+	waiterCh := make(chan struct{}, 1)
+	w := &durabilityWaiter{
+		seqNum: seqNum,
+		ch:     waiterCh,
+	}
+	d.durability.waiters = append(d.durability.waiters, w)
+	d.durability.mu.Unlock()
+
+	if ctx == nil || ctx.Done() == nil {
+		<-waiterCh
+	} else {
+		select {
+		case <-waiterCh:
+		case <-ctx.Done():
+		}
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	d.durability.removeWaiter(w)
+
+	if d.durability.isDurableLocked(seqNum) {
+		return nil
+	}
+	if d.durability.firstErr != nil {
+		return d.durability.firstErr
+	}
+	if d.durability.closed {
+		return ErrClosed
+	}
+	return ctx.Err()
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in the slice is durable.
+// Nil or empty returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in the slice
+// is durable or until the context is done. Nil or empty returns nil immediately.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 || d.opts.DisableWAL {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+// WaitForJobDurability blocks until the callback job ID is durable.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the callback job ID is durable or
+// until the context is done. Durability and close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if jobID <= 0 {
+		return ErrJobUnknown
+	}
+
+	d.durability.mu.Lock()
+
+	if err, ok := d.durability.retainedJobs[jobID]; ok {
+		d.durability.mu.Unlock()
+		return err
+	}
+	if _, ok := d.durability.expiredJobs[jobID]; ok {
+		d.durability.mu.Unlock()
+		return ErrJobExpired
+	}
+	js, inFlight := d.durability.inFlightJobs[jobID]
+	if !inFlight {
+		d.durability.mu.Unlock()
+		if jobID <= d.durability.highestSeenJobID {
+			return ErrJobExpired
+		}
+		return ErrJobUnknown
+	}
+
+	if d.durability.closed {
+		d.durability.mu.Unlock()
+		return ErrClosed
+	}
+	if d.durability.firstErr != nil {
+		err := d.durability.firstErr
+		d.durability.mu.Unlock()
+		return err
+	}
+	if ctx != nil && ctx.Err() != nil {
+		d.durability.mu.Unlock()
+		return ctx.Err()
+	}
+
+	atomic.AddInt64(&d.durability.pendingWaiters, 1)
+	defer atomic.AddInt64(&d.durability.pendingWaiters, -1)
+
+	ch := js.ch
+	d.durability.mu.Unlock()
+
+	if ctx == nil || ctx.Done() == nil {
+		<-ch
+	} else {
+		select {
+		case <-ch:
+		case <-ctx.Done():
+		}
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	if js.done {
+		return js.err
+	}
+	if err, ok := d.durability.retainedJobs[jobID]; ok {
+		return err
+	}
+	if _, ok := d.durability.expiredJobs[jobID]; ok {
+		return ErrJobExpired
+	}
+	if d.durability.firstErr != nil {
+		return d.durability.firstErr
+	}
+	if d.durability.closed {
+		return ErrClosed
+	}
+	if ctx != nil && ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if jobID <= d.durability.highestSeenJobID {
+		return ErrJobExpired
+	}
+	return nil
+}
+
+// DurableState returns the highest durable sequence number and first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return d.durability.highestDurableSeqNum, d.durability.firstErr
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil on success
+// or a non-nil error on WAL sync failure or DB close.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	if d.durability.firstErr != nil {
+		ch <- d.durability.firstErr
+		return ch
+	}
+	if d.durability.closed {
+		ch <- ErrClosed
+		return ch
+	}
+	if d.durability.isDurableLocked(seqNum) {
+		ch <- nil
+		return ch
+	}
+	if len(d.durability.subscriptions) >= maxOutstandingSubscriptions {
+		ch <- ErrTooManySubscriptions
+		return ch
+	}
+
+	d.durability.subscriptions = append(d.durability.subscriptions, &durabilitySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+// DurabilityStats returns a point-in-time snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.durability.highestDurableSeqNum,
+		FirstErr:               d.durability.firstErr,
+		PendingWaiters:         atomic.LoadInt64(&d.durability.pendingWaiters),
+		TotalDurableCommits:    d.durability.totalDurableCommits,
+		TotalFailedCommits:     d.durability.totalFailedCommits,
+		CumulativeSyncDuration: d.durability.cumulativeSyncDuration,
+		MaxSyncDuration:        d.durability.maxSyncDuration,
+	}
+}
