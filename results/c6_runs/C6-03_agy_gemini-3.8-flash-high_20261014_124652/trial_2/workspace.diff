+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var jobIDs []int
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			jobIDs = append(jobIDs, info.JobID)
+			mu.Unlock()
+		},
+	}
+
+	db, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		EventListener: &listener,
+	})
+	require.NoError(t, err)
+	defer db.Close()
+
+	// Zero ID returns unknown error.
+	err = db.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Negative ID returns unknown error.
+	err = db.WaitForJobDurability(-1)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Never seen ID returns unknown error.
+	err = db.WaitForJobDurability(999999)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobUnknown))
+	require.Contains(t, strings.ToLower(err.Error()), "unknown")
+
+	// Commit a sync batch.
+	require.NoError(t, db.Set([]byte("k"), []byte("v"), Sync))
+
+	mu.Lock()
+	require.Len(t, jobIDs, 1)
+	jobID1 := jobIDs[0]
+	mu.Unlock()
+
+	// Waiting on completed jobID returns nil.
+	require.NoError(t, db.WaitForJobDurability(jobID1))
+
+	// Push jobs past retention window to test expiration.
+	// We retain up to maxRetainedJobs (4096).
+	const numCommits = 4100
+	for i := 0; i < numCommits; i++ {
+		require.NoError(t, db.Set([]byte(fmt.Sprintf("k%d", i)), []byte("val"), Sync))
+	}
+
+	// jobID1 should now be expired.
+	err = db.WaitForJobDurability(jobID1)
+	require.Error(t, err)
+	require.True(t, errors.Is(err, ErrJobExpired))
+	require.Contains(t, strings.ToLower(err.Error()), "expired")
+	// Make sure expired error is distinguishable from unknown error.
+	require.False(t, errors.Is(err, ErrJobUnknown))
+}
