+func TestBatchDurableOnSyncFailure(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var callbackCalled atomic.Bool
+	var callbackErr error
+	var callbackJobID int
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			callbackCalled.Store(true)
+			callbackErr = info.Err
+			callbackJobID = info.JobID
+		},
+	}
+
+	// Inject error into Sync after DB is opened.
+	var injectSyncError atomic.Bool
+	syncErr := errors.New("injected sync error")
+	inj := errorfs.InjectorFunc(func(op errorfs.Op) error {
+		if injectSyncError.Load() && (op.Kind == errorfs.OpFileSync || op.Kind == errorfs.OpFileSyncData || op.Kind == errorfs.OpFileSyncTo) {
+			return syncErr
+		}
+		return nil
+	})
+	mem := vfs.NewMem()
+	fs := errorfs.Wrap(mem, inj)
+
+	opts := &Options{
+		FS:            fs,
+		EventListener: &listener,
+		Logger:        testPanicLogger{},
+	}
+	db, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		_ = db.Close()
+	}()
+
+	injectSyncError.Store(true)
+
+	func() {
+		defer func() {
+			_ = recover()
+		}()
+		_ = db.Set([]byte("k"), []byte("v"), Sync)
+	}()
+
+	// BatchDurable MUST have fired even on failure!
+	require.True(t, callbackCalled.Load())
+	require.Error(t, callbackErr)
+	require.True(t, errors.Is(callbackErr, syncErr))
+
+	// DurableState must latch the error.
+	_, latchedErr := db.DurableState()
+	require.Error(t, latchedErr)
+	require.True(t, errors.Is(latchedErr, syncErr))
+
+	// DurabilityStats should reflect 1 failed commit.
+	stats := db.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Equal(t, uint64(0), stats.TotalDurableCommits)
+	require.True(t, errors.Is(stats.FirstErr, syncErr))
+
+	// Waiting on the failed job returns the error.
+	jobErr := db.WaitForJobDurability(callbackJobID)
+	require.Error(t, jobErr)
+	require.True(t, errors.Is(jobErr, syncErr))
+
+	// Any DurabilityNotify returns the latched error.
+	notifyCh := db.DurabilityNotify(1)
+	err = <-notifyCh
+	require.Error(t, err)
+	require.True(t, errors.Is(err, syncErr))
+}
