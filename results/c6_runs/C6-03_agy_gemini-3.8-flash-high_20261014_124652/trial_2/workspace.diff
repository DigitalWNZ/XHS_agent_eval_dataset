+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	db, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer db.Close()
+
+	// 1. Notify for future seqnum.
+	ch1 := db.DurabilityNotify(1)
+	require.NoError(t, db.Set([]byte("k"), []byte("v"), Sync))
+	select {
+	case err := <-ch1:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("notify channel not delivered")
+	}
+
+	// 2. Notify for already durable seqnum returns pre-filled channel with nil.
+	highest, _ := db.DurableState()
+	ch2 := db.DurabilityNotify(highest)
+	select {
+	case err := <-ch2:
+		require.NoError(t, err)
+	default:
+		t.Fatal("expected pre-filled channel for already durable seqnum")
+	}
+
+	// 3. Exceed bound on outstanding subscriptions.
+	var excessChs []<-chan error
+	for i := 0; i < maxOutstandingSubscriptions; i++ {
+		excessChs = append(excessChs, db.DurabilityNotify(999999))
+	}
+	// The next one must receive immediate non-nil error.
+	excess := db.DurabilityNotify(999999)
+	select {
+	case err := <-excess:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrTooManySubscriptions))
+	default:
+		t.Fatal("expected pre-filled channel with error for excess subscriptions")
+	}
+}
