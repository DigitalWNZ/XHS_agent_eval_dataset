+func TestBatchDurableCallback(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	var mu sync.Mutex
+	var events []BatchDurableInfo
+
+	listener := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			events = append(events, info)
+			mu.Unlock()
+		},
+	}
+
+	opts := &Options{
+		FS:            vfs.NewMem(),
+		EventListener: &listener,
+	}
+	db, err := Open("", opts)
+	require.NoError(t, err)
+	defer db.Close()
+
+	// 1. Sync commit with CommitCorrelationID.
+	writeOpts := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}
+	require.NoError(t, db.Set([]byte("key1"), []byte("val1"), writeOpts))
+
+	mu.Lock()
+	require.Len(t, events, 1)
+	ev := events[0]
+	mu.Unlock()
+
+	require.Greater(t, ev.JobID, 0)
+	require.Greater(t, ev.SeqNum, base.SeqNum(0))
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev.CorrelationID)
+	require.Greater(t, ev.BatchSize, 0)
+	require.Equal(t, uint32(1), ev.KeyCount)
+
+	// 2. Non-sync commit should NEVER trigger BatchDurable.
+	noSyncOpts := &WriteOptions{Sync: false}
+	require.NoError(t, db.Set([]byte("key2"), []byte("val2"), noSyncOpts))
+	require.NoError(t, db.Set([]byte("key3"), []byte("val3"), NoSync))
+
+	mu.Lock()
+	require.Len(t, events, 1) // still 1
+	mu.Unlock()
+
+	// 3. Batch commit with multiple keys.
+	b := db.NewBatch()
+	require.NoError(t, b.Set([]byte("k4"), []byte("v4"), nil))
+	require.NoError(t, b.Set([]byte("k5"), []byte("v5"), nil))
+	bSize := len(b.Repr())
+	require.NoError(t, b.Commit(&WriteOptions{Sync: true, CommitCorrelationID: 100}))
+
+	mu.Lock()
+	require.Len(t, events, 2)
+	ev2 := events[1]
+	mu.Unlock()
+
+	require.Greater(t, ev2.JobID, ev.JobID)
+	require.Equal(t, uint64(100), ev2.CorrelationID)
+	require.Equal(t, uint32(2), ev2.KeyCount)
+	require.Equal(t, bSize, ev2.BatchSize)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+
+	// 4. ApplyNoSyncWait.
+	b2 := db.NewBatch()
+	require.NoError(t, b2.Set([]byte("k6"), []byte("v6"), nil))
+	require.NoError(t, db.ApplyNoSyncWait(b2, &WriteOptions{Sync: true, CommitCorrelationID: 200}))
+	require.NoError(t, b2.SyncWait())
+	require.NoError(t, b2.Close())
+
+	// Wait briefly for the durability callback if needed.
+	require.Eventually(t, func() bool {
+		mu.Lock()
+		defer mu.Unlock()
+		return len(events) == 3
+	}, time.Second, 5*time.Millisecond)
+
+	mu.Lock()
+	ev3 := events[2]
+	mu.Unlock()
+	require.Equal(t, uint64(200), ev3.CorrelationID)
+	require.NoError(t, ev3.Err)
+	require.Greater(t, ev3.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev3.SyncDuration, time.Duration(0))
+}
