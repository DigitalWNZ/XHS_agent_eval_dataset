+func TestContextCancellationPrecedence(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("", &Options{FS: memFS})
+	require.NoError(t, err)
+
+	// 1. Durability already met: should return nil even with cancelled context!
+	require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	curSeq, _ := d.DurableState()
+
+	ctxCancelled, cancel := context.WithCancel(context.Background())
+	cancel() // cancel immediately
+	require.NoError(t, d.WaitForDurabilityContext(ctxCancelled, curSeq))
+
+	// 2. DB closed: close error takes precedence over cancelled context!
+	futureSeq := curSeq + 10000
+	require.NoError(t, d.Close())
+
+	waitErr := d.WaitForDurabilityContext(ctxCancelled, futureSeq)
+	require.Error(t, waitErr)
+	// Must be the close error (ErrClosed), NOT context.Canceled!
+	require.True(t, errors.Is(waitErr, ErrClosed))
+	require.False(t, errors.Is(waitErr, context.Canceled))
+}
