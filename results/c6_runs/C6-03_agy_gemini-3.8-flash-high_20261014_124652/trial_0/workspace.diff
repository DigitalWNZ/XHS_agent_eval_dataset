+	// DurabilityNotify channel should deliver non-nil error.
+	select {
+	case err := <-notifyCh:
+		require.Error(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("DurabilityNotify channel did not deliver on DB close")
+	}
