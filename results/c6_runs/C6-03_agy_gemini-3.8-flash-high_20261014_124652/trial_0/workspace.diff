+	chFuture := d.DurabilityNotify(futureSeq)
+
+	// Advance seqnum.
+	for i := 0; i < 6; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("k%d", i)), []byte("val"), Sync))
+	}
+
+	select {
+	case err := <-chFuture:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("DurabilityNotify channel did not deliver on durability")
+	}
+
+	// Test subscription bounding: fill subscriptions up to maxSubscriptions.
+	curSeq, _ = d.DurableState()
+	subs := make([]<-chan error, 4096)
+	for i := range subs {
+		subs[i] = d.DurabilityNotify(curSeq + 100)
+	}
+
+	// 4097th should get pre-filled channel with immediate non-nil error.
+	excessCh := d.DurabilityNotify(curSeq + 100)
+	select {
+	case err := <-excessCh:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrTooManySubscriptions))
+	default:
+		t.Fatal("excess subscriber did not receive immediate error")
+	}
+
+	require.NoError(t, d.Close())
+	d = nil
+}
