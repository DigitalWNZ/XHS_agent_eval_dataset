+func TestWaitForJobDurability(t *testing.T) {
+	memFS := vfs.NewMem()
+	var jobIDs []int
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				jobIDs = append(jobIDs, info.JobID)
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// Never-seen and zero IDs get an "unknown" error containing "unknown".
+	errZero := d.WaitForJobDurability(0)
+	require.Error(t, errZero)
+	require.Contains(t, errZero.Error(), "unknown")
+	require.True(t, errors.Is(errZero, ErrJobUnknown))
+
+	errNegative := d.WaitForJobDurability(-10)
+	require.Error(t, errNegative)
+	require.Contains(t, errNegative.Error(), "unknown")
+	require.True(t, errors.Is(errNegative, ErrJobUnknown))
+
+	errNeverSeen := d.WaitForJobDurability(999999)
+	require.Error(t, errNeverSeen)
+	require.Contains(t, errNeverSeen.Error(), "unknown")
+	require.True(t, errors.Is(errNeverSeen, ErrJobUnknown))
+
+	// Commit a job.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	mu.Lock()
+	firstJobID := jobIDs[0]
+	mu.Unlock()
+
+	// Waiting for completed job in retention window succeeds immediately.
+	require.NoError(t, d.WaitForJobDurability(firstJobID))
+
+	// Commit enough jobs to exceed retention window (retentionWindow is 2048).
+	for i := 0; i < 2050; i++ {
+		require.NoError(t, d.Set([]byte("roll"), []byte("val"), Sync))
+	}
+
+	// firstJobID should now be outside bounded retention window and return "expired" error.
+	errExpired := d.WaitForJobDurability(firstJobID)
+	require.Error(t, errExpired)
+	require.Contains(t, errExpired.Error(), "expired")
+	require.True(t, errors.Is(errExpired, ErrJobExpired))
+
+	// Most recently completed job should still be valid.
+	mu.Lock()
+	lastJobID := jobIDs[len(jobIDs)-1]
+	mu.Unlock()
+	require.NoError(t, d.WaitForJobDurability(lastJobID))
+
+	require.NoError(t, d.Close())
+	d = nil
+}
