--- /dev/null
+++ b/durability.go
@@ -0,0 +1,622 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/redact"
+)
+
+var (
+	// ErrJobExpired is returned by WaitForJobDurability when the requested job ID
+	// has fallen outside the bounded retention window.
+	ErrJobExpired = errors.New("pebble: job expired")
+
+	// ErrJobUnknown is returned by WaitForJobDurability when the requested job ID
+	// was never seen or is zero.
+	ErrJobUnknown = errors.New("pebble: unknown job ID")
+
+	// ErrTooManySubscriptions is returned by DurabilityNotify when the maximum
+	// number of outstanding subscriptions is exceeded.
+	ErrTooManySubscriptions = errors.New("pebble: too many durability subscriptions")
+)
+
+// BatchDurableInfo contains information about a sync commit becoming durable.
+type BatchDurableInfo struct {
+	JobID         int
+	SeqNum        base.SeqNum
+	Err           error
+	ApplyDuration time.Duration
+	SyncDuration  time.Duration
+	CorrelationID uint64
+	BatchSize     int
+	KeyCount      uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch %d durable error: %s", redact.Safe(i.JobID), redact.Safe(i.SeqNum), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch %d durable (size %d, keys %d, apply %s, sync %s)",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.BatchSize),
+		redact.Safe(i.KeyCount), redact.Safe(i.ApplyDuration), redact.Safe(i.SyncDuration))
+}
+
+// DurabilityStats contains a snapshot of WAL sync durability metrics and state.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type jobBitset struct {
+	words []uint64
+}
+
+func (b *jobBitset) set(id int) {
+	if id <= 0 {
+		return
+	}
+	wordIdx := id / 64
+	if wordIdx >= len(b.words) {
+		newWords := make([]uint64, wordIdx+1+len(b.words))
+		copy(newWords, b.words)
+		b.words = newWords
+	}
+	b.words[wordIdx] |= 1 << (uint(id) % 64)
+}
+
+func (b *jobBitset) has(id int) bool {
+	if id <= 0 {
+		return false
+	}
+	wordIdx := id / 64
+	if wordIdx >= len(b.words) {
+		return false
+	}
+	return (b.words[wordIdx] & (1 << (uint(id) % 64))) != 0
+}
+
+type jobWait struct {
+	ch chan struct{}
+}
+
+type seqWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+}
+
+type durabilitySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durableRecord struct {
+	jobID         int
+	seqNum        base.SeqNum
+	correlationID uint64
+	batchSize     int
+	keyCount      uint32
+	syncStart     time.Time
+	syncDuration  time.Duration
+	applyDone     chan struct{}
+	applyDuration time.Duration
+	applyErr      error
+
+	syncWG      sync.WaitGroup
+	internalErr error
+
+	userWG  *sync.WaitGroup
+	userErr *error
+	jobWait *jobWait
+}
+
+type durabilityManager struct {
+	db                *DB
+	accumulateMetrics bool
+	queue             chan *durableRecord
+	workerDone        chan struct{}
+
+	pendingWaiters int64
+	nextJobID      atomic.Int64
+
+	metricsCommitCount    atomic.Uint64
+	metricsCommitDuration atomic.Int64
+
+	mu struct {
+		sync.Mutex
+		closed                 bool
+		firstErr               error
+		highestDurableSeqNum   base.SeqNum
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		seenJobs        jobBitset
+		inFlightJobs    map[int]*jobWait
+		retainedJobs    map[int]error
+		retainedOrder   []int
+		retentionWindow int
+
+		waiters          []*seqWaiter
+		subscriptions    []durabilitySub
+		maxSubscriptions int
+	}
+}
+
+func (d *DB) initDurability(accumulateMetrics bool) {
+	m := &durabilityManager{
+		db:                d,
+		accumulateMetrics: accumulateMetrics,
+		queue:             make(chan *durableRecord, 1024),
+		workerDone:        make(chan struct{}),
+	}
+	m.mu.inFlightJobs = make(map[int]*jobWait)
+	m.mu.retainedJobs = make(map[int]error)
+	m.mu.retentionWindow = 2048
+	m.mu.maxSubscriptions = 4096
+	m.nextJobID.Store(1)
+
+	d.durability = m
+	go m.worker()
+}
+
+func (m *durabilityManager) worker() {
+	defer close(m.workerDone)
+
+	for record := range m.queue {
+		record.syncWG.Wait()
+		syncEnd := time.Now()
+		syncDuration := syncEnd.Sub(record.syncStart)
+		if syncDuration <= 0 {
+			syncDuration = time.Nanosecond
+		}
+		record.syncDuration = syncDuration
+
+		// Wait for apply to finish. Defensively select with closedCh so we never hang on close.
+		select {
+		case <-record.applyDone:
+		case <-m.db.closedCh:
+		}
+
+		walErr := record.internalErr
+		finalErr := walErr
+		if finalErr == nil {
+			finalErr = record.applyErr
+		}
+		if record.userErr != nil {
+			*record.userErr = finalErr
+		}
+
+		var lastSeqNum base.SeqNum
+		if record.keyCount > 0 {
+			lastSeqNum = record.seqNum + base.SeqNum(record.keyCount) - 1
+		} else {
+			lastSeqNum = record.seqNum
+		}
+
+		m.mu.Lock()
+		if finalErr != nil {
+			m.mu.totalFailedCommits++
+			if m.mu.firstErr == nil {
+				m.mu.firstErr = finalErr
+			}
+		} else {
+			m.mu.totalDurableCommits++
+			if lastSeqNum > m.mu.highestDurableSeqNum {
+				m.mu.highestDurableSeqNum = lastSeqNum
+			}
+		}
+
+		m.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > m.mu.maxSyncDuration {
+			m.mu.maxSyncDuration = syncDuration
+		}
+
+		if m.accumulateMetrics && finalErr == nil {
+			m.metricsCommitCount.Add(1)
+			m.metricsCommitDuration.Add(int64(syncDuration))
+		}
+
+		delete(m.mu.inFlightJobs, record.jobID)
+		m.mu.retainedJobs[record.jobID] = finalErr
+		m.mu.retainedOrder = append(m.mu.retainedOrder, record.jobID)
+		if record.jobWait != nil {
+			close(record.jobWait.ch)
+		}
+		for len(m.mu.retainedOrder) > m.mu.retentionWindow {
+			oldest := m.mu.retainedOrder[0]
+			m.mu.retainedOrder = m.mu.retainedOrder[1:]
+			delete(m.mu.retainedJobs, oldest)
+		}
+
+		m.wakeWaitersLocked()
+		m.notifySubscriptionsLocked()
+		m.mu.Unlock()
+
+		info := BatchDurableInfo{
+			JobID:         record.jobID,
+			SeqNum:        record.seqNum,
+			Err:           finalErr,
+			ApplyDuration: record.applyDuration,
+			SyncDuration:  record.syncDuration,
+			CorrelationID: record.correlationID,
+			BatchSize:     record.batchSize,
+			KeyCount:      record.keyCount,
+		}
+		m.db.opts.EventListener.BatchDurable(info)
+
+		if record.userWG != nil {
+			record.userWG.Done()
+		}
+	}
+}
+
+func (m *durabilityManager) wakeWaitersLocked() {
+	if m.mu.firstErr != nil {
+		for _, w := range m.mu.waiters {
+			close(w.ch)
+		}
+		m.mu.waiters = nil
+		return
+	}
+
+	remaining := m.mu.waiters[:0]
+	for _, w := range m.mu.waiters {
+		if (w.seqNum == 0 && (m.mu.totalDurableCommits > 0 || m.mu.highestDurableSeqNum > 0)) ||
+			(w.seqNum > 0 && m.mu.highestDurableSeqNum >= w.seqNum) {
+			close(w.ch)
+		} else {
+			remaining = append(remaining, w)
+		}
+	}
+	m.mu.waiters = remaining
+}
+
+func (m *durabilityManager) notifySubscriptionsLocked() {
+	if m.mu.firstErr != nil {
+		for _, sub := range m.mu.subscriptions {
+			sub.ch <- m.mu.firstErr
+		}
+		m.mu.subscriptions = nil
+		return
+	}
+
+	remaining := m.mu.subscriptions[:0]
+	for _, sub := range m.mu.subscriptions {
+		if (sub.seqNum == 0 && (m.mu.totalDurableCommits > 0 || m.mu.highestDurableSeqNum > 0)) ||
+			(sub.seqNum > 0 && m.mu.highestDurableSeqNum >= sub.seqNum) {
+			sub.ch <- nil
+		} else {
+			remaining = append(remaining, sub)
+		}
+	}
+	m.mu.subscriptions = remaining
+}
+
+func (m *durabilityManager) close() {
+	m.mu.Lock()
+	if m.mu.closed {
+		m.mu.Unlock()
+		return
+	}
+	m.mu.closed = true
+	if m.mu.firstErr == nil {
+		m.mu.firstErr = ErrClosed
+	}
+	m.mu.Unlock()
+
+	close(m.queue)
+	<-m.workerDone
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	for id, wait := range m.mu.inFlightJobs {
+		m.mu.retainedJobs[id] = m.mu.firstErr
+		m.mu.retainedOrder = append(m.mu.retainedOrder, id)
+		close(wait.ch)
+	}
+	m.mu.inFlightJobs = make(map[int]*jobWait)
+
+	m.wakeWaitersLocked()
+	m.notifySubscriptionsLocked()
+}
+
+func (m *durabilityManager) newRecord(
+	b *Batch,
+	jobID int,
+	batchSize int,
+	userWG *sync.WaitGroup,
+	userErr *error,
+) *durableRecord {
+	rec := &durableRecord{
+		jobID:         jobID,
+		seqNum:        b.SeqNum(),
+		correlationID: b.commitCorrelationID,
+		batchSize:     batchSize,
+		keyCount:      b.Count(),
+		syncStart:     time.Now(),
+		applyDone:     make(chan struct{}),
+		userWG:        userWG,
+		userErr:       userErr,
+	}
+	rec.syncWG.Add(1)
+
+	m.mu.Lock()
+	m.mu.seenJobs.set(jobID)
+	wait := &jobWait{ch: make(chan struct{})}
+	m.mu.inFlightJobs[jobID] = wait
+	rec.jobWait = wait
+	m.mu.Unlock()
+
+	m.queue <- rec
+	return rec
+}
+
+func (d *DB) prepareSyncRecord(
+	b *Batch,
+	reprLen int,
+	syncWG *sync.WaitGroup,
+	syncErr *error,
+) (*sync.WaitGroup, *error) {
+	if !b.syncCommit || syncWG == nil || d.opts.DisableWAL || d.durability == nil {
+		return syncWG, syncErr
+	}
+	jobID := int(d.durability.nextJobID.Add(1) - 1)
+	record := d.durability.newRecord(b, jobID, reprLen, syncWG, syncErr)
+	b.durableRecord = record
+	return &record.syncWG, &record.internalErr
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+// Zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable,
+// or ctx is done. Durability and close errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if d.durability == nil {
+		return nil
+	}
+
+	d.durability.mu.Lock()
+	if d.durability.mu.firstErr != nil {
+		err := d.durability.mu.firstErr
+		d.durability.mu.Unlock()
+		return err
+	}
+
+	if (seqNum == 0 && (d.durability.mu.totalDurableCommits > 0 || d.durability.mu.highestDurableSeqNum > 0)) ||
+		(seqNum > 0 && d.durability.mu.highestDurableSeqNum >= seqNum) {
+		d.durability.mu.Unlock()
+		return nil
+	}
+
+	if err := ctx.Err(); err != nil {
+		d.durability.mu.Unlock()
+		return err
+	}
+
+	w := &seqWaiter{
+		seqNum: seqNum,
+		ch:     make(chan struct{}),
+	}
+	d.durability.mu.waiters = append(d.durability.mu.waiters, w)
+	d.durability.mu.Unlock()
+
+	atomic.AddInt64(&d.durability.pendingWaiters, 1)
+	defer atomic.AddInt64(&d.durability.pendingWaiters, -1)
+
+	select {
+	case <-w.ch:
+		d.durability.mu.Lock()
+		defer d.durability.mu.Unlock()
+		if d.durability.mu.firstErr != nil {
+			return d.durability.mu.firstErr
+		}
+		return nil
+	case <-ctx.Done():
+		d.durability.mu.Lock()
+		defer d.durability.mu.Unlock()
+		if d.durability.mu.firstErr != nil {
+			return d.durability.mu.firstErr
+		}
+		if (seqNum == 0 && (d.durability.mu.totalDurableCommits > 0 || d.durability.mu.highestDurableSeqNum > 0)) ||
+			(seqNum > 0 && d.durability.mu.highestDurableSeqNum >= seqNum) {
+			return nil
+		}
+		for i, item := range d.durability.mu.waiters {
+			if item == w {
+				d.durability.mu.waiters = append(d.durability.mu.waiters[:i], d.durability.mu.waiters[i+1:]...)
+				break
+			}
+		}
+		return ctx.Err()
+	}
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in the slice is durable.
+// Nil/empty returns nil immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in the slice is durable,
+// or ctx is done. Nil/empty returns nil immediately. Durability and close errors take precedence
+// over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeqNum base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeqNum {
+			maxSeqNum = s
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeqNum)
+}
+
+// WaitForJobDurability blocks until the commit with the given callback job ID is durable.
+// Jobs outside the bounded retention window get an "expired" error; never-seen and zero
+// IDs get an "unknown" error.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the commit with the given callback job ID is durable,
+// or ctx is done. Jobs outside the bounded retention window get an "expired" error; never-seen
+// and zero IDs get an "unknown" error. Durability and close errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if d.durability == nil {
+		return ErrJobUnknown
+	}
+
+	d.durability.mu.Lock()
+	if jobID <= 0 || !d.durability.mu.seenJobs.has(jobID) {
+		d.durability.mu.Unlock()
+		return ErrJobUnknown
+	}
+
+	if err, ok := d.durability.mu.retainedJobs[jobID]; ok {
+		d.durability.mu.Unlock()
+		return err
+	}
+
+	jobWait, inFlight := d.durability.mu.inFlightJobs[jobID]
+	if !inFlight {
+		d.durability.mu.Unlock()
+		return ErrJobExpired
+	}
+
+	if d.durability.mu.firstErr != nil {
+		err := d.durability.mu.firstErr
+		d.durability.mu.Unlock()
+		return err
+	}
+
+	if err := ctx.Err(); err != nil {
+		d.durability.mu.Unlock()
+		return err
+	}
+
+	ch := jobWait.ch
+	d.durability.mu.Unlock()
+
+	atomic.AddInt64(&d.durability.pendingWaiters, 1)
+	defer atomic.AddInt64(&d.durability.pendingWaiters, -1)
+
+	select {
+	case <-ch:
+		d.durability.mu.Lock()
+		defer d.durability.mu.Unlock()
+		if d.durability.mu.firstErr != nil {
+			return d.durability.mu.firstErr
+		}
+		if err, ok := d.durability.mu.retainedJobs[jobID]; ok {
+			return err
+		}
+		return ErrJobExpired
+	case <-ctx.Done():
+		d.durability.mu.Lock()
+		defer d.durability.mu.Unlock()
+		if d.durability.mu.firstErr != nil {
+			return d.durability.mu.firstErr
+		}
+		if err, ok := d.durability.mu.retainedJobs[jobID]; ok {
+			return err
+		}
+		return ctx.Err()
+	}
+}
+
+// DurableState returns the highest durable sequence number and first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	if d.durability == nil {
+		return 0, nil
+	}
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return d.durability.mu.highestDurableSeqNum, d.durability.mu.firstErr
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil on success
+// or a non-nil error on WAL sync failure or DB close.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL || d.durability == nil {
+		ch <- nil
+		return ch
+	}
+
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+
+	if d.durability.mu.firstErr != nil {
+		ch <- d.durability.mu.firstErr
+		return ch
+	}
+
+	if (seqNum == 0 && (d.durability.mu.totalDurableCommits > 0 || d.durability.mu.highestDurableSeqNum > 0)) ||
+		(seqNum > 0 && d.durability.mu.highestDurableSeqNum >= seqNum) {
+		ch <- nil
+		return ch
+	}
+
+	if len(d.durability.mu.subscriptions) >= d.durability.mu.maxSubscriptions {
+		ch <- ErrTooManySubscriptions
+		return ch
+	}
+
+	d.durability.mu.subscriptions = append(d.durability.mu.subscriptions, durabilitySub{
+		seqNum: seqNum,
+		ch:     ch,
+	})
+	return ch
+}
+
+// DurabilityStats returns a snapshot of durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	if d.durability == nil {
+		return DurabilityStats{}
+	}
+	d.durability.mu.Lock()
+	defer d.durability.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.durability.mu.highestDurableSeqNum,
+		FirstErr:               d.durability.mu.firstErr,
+		PendingWaiters:         atomic.LoadInt64(&d.durability.pendingWaiters),
+		TotalDurableCommits:    d.durability.mu.totalDurableCommits,
+		TotalFailedCommits:     d.durability.mu.totalFailedCommits,
+		CumulativeSyncDuration: d.durability.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        d.durability.mu.maxSyncDuration,
+	}
+}
