+func TestBatchDurableCallback(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				durableEvents = append(durableEvents, info)
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// Initial durability stats.
+	stats := d.DurabilityStats()
+	require.Equal(t, base.SeqNum(0), stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(0), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, time.Duration(0), stats.CumulativeSyncDuration)
+	require.Equal(t, time.Duration(0), stats.MaxSyncDuration)
+
+	// Perform a sync write with correlation ID.
+	writeOpts := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 42,
+	}
+	require.NoError(t, d.Set([]byte("key1"), []byte("val1"), writeOpts))
+
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	ev := durableEvents[0]
+	mu.Unlock()
+
+	require.Greater(t, ev.JobID, 0)
+	require.Greater(t, ev.SeqNum, base.SeqNum(0))
+	require.NoError(t, ev.Err)
+	require.Greater(t, ev.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), ev.CorrelationID)
+	require.Greater(t, ev.BatchSize, 0)
+	require.Equal(t, uint32(1), ev.KeyCount)
+
+	// Perform non-sync write. It must NEVER trigger BatchDurable.
+	noSyncOpts := &WriteOptions{Sync: false, CommitCorrelationID: 99}
+	require.NoError(t, d.Set([]byte("key2"), []byte("val2"), noSyncOpts))
+
+	mu.Lock()
+	require.Len(t, durableEvents, 1) // still 1
+	mu.Unlock()
+
+	// Perform multi-key batch commit.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("key3"), []byte("val3"), nil))
+	require.NoError(t, b.Set([]byte("key4"), []byte("val4"), nil))
+	require.NoError(t, b.Delete([]byte("key1"), nil))
+	batchWriteOpts := &WriteOptions{Sync: true, CommitCorrelationID: 100}
+	require.NoError(t, b.Commit(batchWriteOpts))
+	require.NoError(t, b.Close())
+
+	mu.Lock()
+	require.Len(t, durableEvents, 2)
+	ev2 := durableEvents[1]
+	mu.Unlock()
+
+	require.Greater(t, ev2.JobID, ev.JobID)
+	require.Greater(t, ev2.SeqNum, ev.SeqNum)
+	require.NoError(t, ev2.Err)
+	require.Greater(t, ev2.ApplyDuration, time.Duration(0))
+	require.Greater(t, ev2.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(100), ev2.CorrelationID)
+	require.Equal(t, uint32(3), ev2.KeyCount)
+
+	// Verify metrics are accumulated because BatchDurable was configured.
+	metrics := d.Metrics()
+	require.Equal(t, uint64(2), metrics.DurableCommitCount)
+	require.Greater(t, metrics.DurableCommitDuration, time.Duration(0))
+
+	// Verify DurabilityStats.
+	stats = d.DurabilityStats()
+	require.Equal(t, uint64(2), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, metrics.DurableCommitDuration, stats.CumulativeSyncDuration)
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+	require.GreaterOrEqual(t, stats.HighestDurableSeqNum, ev2.SeqNum)
+
+	require.NoError(t, d.Close())
+	d = nil
+}
