+func TestSyncFailure(t *testing.T) {
+	memFS := vfs.NewMem()
+	var syncInjected atomic.Bool
+	syncErrTarget := errors.New("injected sync error")
+
+	// Wrap filesystem with errorfs to inject error on Sync.
+	errorFS := errorfs.Wrap(memFS, errorfs.InjectorFunc(func(op errorfs.Op) error {
+		if syncInjected.Load() && (op.Kind == errorfs.OpFileSync || op.Kind == errorfs.OpFileSyncData || op.Kind == errorfs.OpFileSyncTo) {
+			return syncErrTarget
+		}
+		return nil
+	}))
+
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: errorFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				durableEvents = append(durableEvents, info)
+			},
+		},
+	}
+
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// Normal write first.
+	require.NoError(t, d.Set([]byte("good"), []byte("val"), Sync))
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	require.NoError(t, durableEvents[0].Err)
+	mu.Unlock()
+
+	// Inject error on next sync.
+	syncInjected.Store(true)
+
+	// Commit should fail because WAL sync fails.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("bad"), []byte("val"), nil))
+	commitErr := d.ApplyNoSyncWait(b, Sync)
+	if commitErr == nil {
+		commitErr = b.SyncWait()
+	}
+	require.Error(t, commitErr)
+
+	// BatchDurable MUST have fired even on failure!
+	mu.Lock()
+	require.Len(t, durableEvents, 2)
+	require.Error(t, durableEvents[1].Err)
+	mu.Unlock()
+
+	// TotalFailedCommits should increment.
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Error(t, stats.FirstErr)
+
+	// DurableState should return first latched error.
+	_, latchedErr := d.DurableState()
+	require.Error(t, latchedErr)
+
+	// Wait APIs should unblock with the error.
+	require.Error(t, d.WaitForDurability(1000))
+}
