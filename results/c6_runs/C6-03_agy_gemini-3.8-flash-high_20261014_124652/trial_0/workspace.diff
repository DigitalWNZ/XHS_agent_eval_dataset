+func TestWaitForDurability(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("", &Options{FS: memFS})
+	require.NoError(t, err)
+	defer func() {
+		if d != nil {
+			_ = d.Close()
+		}
+	}()
+
+	// WaitForDurability(0) before any commit should block until a commit happens.
+	zeroDone := make(chan error, 1)
+	go func() {
+		zeroDone <- d.WaitForDurability(0)
+	}()
+
+	// Give the goroutine time to enter wait.
+	time.Sleep(20 * time.Millisecond)
+	require.Equal(t, int64(1), d.DurabilityStats().PendingWaiters)
+
+	// Commit a key.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+
+	select {
+	case err := <-zeroDone:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurability(0) did not unblock after commit")
+	}
+
+	// Now WaitForDurability(0) succeeds immediately.
+	require.NoError(t, d.WaitForDurability(0))
+
+	// DurableState should reflect the durable commit.
+	seq, err := d.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, seq, base.SeqNum(0))
+
+	// Waiting for already-durable sequence number succeeds immediately.
+	require.NoError(t, d.WaitForDurability(seq))
+	require.NoError(t, d.WaitForDurability(seq-1))
+
+	// Waiting for a future sequence number blocks until it's committed.
+	futureSeq := seq + 10
+	futureDone := make(chan error, 1)
+	go func() {
+		futureDone <- d.WaitForDurability(futureSeq)
+	}()
+
+	time.Sleep(20 * time.Millisecond)
+	require.Equal(t, int64(1), d.DurabilityStats().PendingWaiters)
+
+	// Write more keys to advance seqnum past futureSeq.
+	for i := 0; i < 15; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("key%d", i)), []byte("val"), Sync))
+	}
+
+	select {
+	case err := <-futureDone:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("WaitForDurability for future sequence number timed out")
+	}
+
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+	require.NoError(t, d.Close())
+	d = nil
+}
