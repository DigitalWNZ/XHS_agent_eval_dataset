+func TestBatchDurableCallback(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				durableEvents = append(durableEvents, info)
+			},
+		},
+	}
+
+	d, err := Open("test", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Commit a sync batch with CommitCorrelationID.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("key1"), []byte("val1"), nil))
+	require.NoError(t, b.Set([]byte("key2"), []byte("val2"), nil))
+	expectedKeyCount := b.Count()
+	expectedBatchSize := len(b.Repr())
+
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 12345,
+	}
+	require.NoError(t, b.Commit(wo))
+	expectedSeqNum := b.SeqNum()
+
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	event := durableEvents[0]
+	mu.Unlock()
+
+	require.Greater(t, event.JobID, 0)
+	require.Equal(t, expectedSeqNum, event.SeqNum)
+	require.NoError(t, event.Err)
+	require.Greater(t, event.ApplyDuration, time.Duration(0))
+	require.Greater(t, event.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(12345), event.CorrelationID)
+	require.Equal(t, expectedBatchSize, event.BatchSize)
+	require.Equal(t, expectedKeyCount, event.KeyCount)
+	require.NotEmpty(t, event.String())
+}
