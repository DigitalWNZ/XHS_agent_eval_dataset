+func TestContextPrecedence(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("test", &Options{FS: memFS})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Commit a sync batch.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+	require.NoError(t, b.Commit(Sync))
+	seq := b.SeqNum()
+
+	// Context is canceled before calling, but seq is already durable.
+	// Durability takes precedence over context cancellation.
+	ctxCanceled, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	require.NoError(t, d.WaitForDurabilityContext(ctxCanceled, seq))
+	require.NoError(t, d.WaitForDurabilityBatchContext(ctxCanceled, []base.SeqNum{seq}))
+
+	// For an existing durable job, durability takes precedence over context cancellation.
+	require.NoError(t, d.WaitForJobDurabilityContext(ctxCanceled, 1))
+
+	// For a future seqnum, canceled context should return ctx.Err().
+	futureSeq := seq + 1000
+	require.Equal(t, context.Canceled, d.WaitForDurabilityContext(ctxCanceled, futureSeq))
+	require.Equal(t, context.Canceled, d.WaitForDurabilityBatchContext(ctxCanceled, []base.SeqNum{futureSeq}))
+}
