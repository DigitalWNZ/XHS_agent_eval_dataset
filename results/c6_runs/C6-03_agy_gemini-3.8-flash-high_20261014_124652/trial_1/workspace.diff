diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..070882b2
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,668 @@
+// Copyright 2024 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// ErrJobDurabilityExpired is returned by WaitForJobDurability when the job is outside
+// the bounded retention window.
+var ErrJobDurabilityExpired = errors.New("pebble: job durability expired")
+
+// ErrJobDurabilityUnknown is returned by WaitForJobDurability when the job ID has never been
+// seen or is invalid (e.g. zero or negative).
+var ErrJobDurabilityUnknown = errors.New("pebble: job durability unknown")
+
+// ErrDurabilitySubscriptionLimit is returned by DurabilityNotify when the limit on
+// outstanding durability subscriptions has been exceeded.
+var ErrDurabilitySubscriptionLimit = errors.New("pebble: durability subscription limit exceeded")
+
+const (
+	maxRetainedJobs             = 4096
+	maxDurabilitySubscriptions  = 4096
+	durabilityQueueCapacity     = 4096
+)
+
+// DurabilityStats provides a snapshot of WAL durability metrics and state.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJob struct {
+	id        int
+	completed bool
+	err       error
+	done      chan struct{}
+}
+
+type durabilityWaiter struct {
+	seqNum base.SeqNum
+	done   chan struct{}
+}
+
+type durabilitySubscription struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityEntry struct {
+	jobID         int
+	seqNum        base.SeqNum
+	count         uint32
+	batchSize     int
+	correlationID uint64
+	b             *Batch
+	userWG        *sync.WaitGroup
+	userErr       *error
+	walWG         sync.WaitGroup
+	walErr        error
+	syncStart     crtime.Mono
+}
+
+type durabilityManager struct {
+	d *DB
+
+	mu sync.Mutex
+
+	highestDurableSeqNum   base.SeqNum
+	firstErr               error
+	closed                 bool
+	closedErr              error
+	pendingWaiters         atomic.Int64
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	batchDurableConfigured bool
+	durableCommitCount     atomic.Uint64
+	durableCommitDuration  atomic.Int64 // nanoseconds
+
+	nextJobID           int
+	oldestRetainedJobID int
+	retainedJobs        map[int]*durabilityJob
+	retainedJobOrder    []int
+
+	waiters       []*durabilityWaiter
+	subscriptions []*durabilitySubscription
+
+	queue    chan *durabilityEntry
+	workerWG sync.WaitGroup
+}
+
+func newDurabilityManager(d *DB) *durabilityManager {
+	batchDurableConfigured := d.opts.EventListener != nil && !isDefaultBatchDurable(d.opts.EventListener.BatchDurable)
+	return &durabilityManager{
+		d:                      d,
+		batchDurableConfigured: batchDurableConfigured,
+		nextJobID:              1,
+		oldestRetainedJobID:    1,
+		retainedJobs:           make(map[int]*durabilityJob),
+		queue:                  make(chan *durabilityEntry, durabilityQueueCapacity),
+	}
+}
+
+func (m *durabilityManager) start() {
+	m.workerWG.Add(1)
+	go m.worker()
+}
+
+func (m *durabilityManager) newJobID() int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	id := m.nextJobID
+	m.nextJobID++
+
+	job := &durabilityJob{
+		id:   id,
+		done: make(chan struct{}),
+	}
+	m.retainedJobs[id] = job
+	m.retainedJobOrder = append(m.retainedJobOrder, id)
+
+	for len(m.retainedJobOrder) > maxRetainedJobs {
+		oldestID := m.retainedJobOrder[0]
+		oldestJob := m.retainedJobs[oldestID]
+		if oldestJob != nil && !oldestJob.completed {
+			break
+		}
+		m.retainedJobOrder = m.retainedJobOrder[1:]
+		delete(m.retainedJobs, oldestID)
+		m.oldestRetainedJobID = oldestID + 1
+	}
+
+	return id
+}
+
+func (m *durabilityManager) createEntry(b *Batch, userWG *sync.WaitGroup, userErr *error) *durabilityEntry {
+	entry := &durabilityEntry{
+		jobID:         b.commitJobID,
+		seqNum:        b.SeqNum(),
+		count:         b.Count(),
+		batchSize:     len(b.Repr()),
+		correlationID: b.commitCorrelationID,
+		b:             b,
+		userWG:        userWG,
+		userErr:       userErr,
+		syncStart:     crtime.NowMono(),
+	}
+	entry.walWG.Add(1)
+	return entry
+}
+
+func (m *durabilityManager) enqueueEntry(entry *durabilityEntry) {
+	m.queue <- entry
+}
+
+func (m *durabilityManager) worker() {
+	defer m.workerWG.Done()
+
+	for entry := range m.queue {
+		entry.walWG.Wait()
+
+		if entry.walErr == nil {
+			for !entry.b.applied.Load() {
+				runtime.Gosched()
+			}
+		}
+
+		m.processEntry(entry)
+
+		if entry.userWG != nil {
+			entry.userWG.Done()
+		}
+	}
+}
+
+func (m *durabilityManager) processEntry(entry *durabilityEntry) {
+	syncDuration := entry.syncStart.Elapsed()
+	if syncDuration <= 0 {
+		syncDuration = time.Nanosecond
+	}
+	applyDuration := entry.b.applyDuration
+	if applyDuration <= 0 {
+		applyDuration = time.Nanosecond
+	}
+
+	err := entry.walErr
+	if entry.userErr != nil {
+		*entry.userErr = err
+	}
+
+	m.mu.Lock()
+	if err != nil {
+		m.totalFailedCommits++
+		if m.firstErr == nil {
+			m.firstErr = err
+		}
+	} else {
+		m.totalDurableCommits++
+		m.cumulativeSyncDuration += syncDuration
+		if syncDuration > m.maxSyncDuration {
+			m.maxSyncDuration = syncDuration
+		}
+		if m.batchDurableConfigured {
+			m.durableCommitCount.Add(1)
+			m.durableCommitDuration.Add(int64(syncDuration))
+		}
+
+		batchLargestSeqNum := entry.seqNum
+		if entry.count > 0 {
+			batchLargestSeqNum = entry.seqNum + base.SeqNum(entry.count) - 1
+		}
+		if batchLargestSeqNum > m.highestDurableSeqNum {
+			m.highestDurableSeqNum = batchLargestSeqNum
+		}
+	}
+
+	if job, ok := m.retainedJobs[entry.jobID]; ok {
+		job.completed = true
+		job.err = err
+		close(job.done)
+	}
+
+	activeWaiters := m.waiters[:0]
+	for _, w := range m.waiters {
+		if m.firstErr != nil || (w.seqNum == 0 && m.totalDurableCommits > 0) || (w.seqNum > 0 && m.highestDurableSeqNum >= w.seqNum) {
+			close(w.done)
+		} else {
+			activeWaiters = append(activeWaiters, w)
+		}
+	}
+	m.waiters = activeWaiters
+
+	activeSubs := m.subscriptions[:0]
+	for _, sub := range m.subscriptions {
+		if m.firstErr != nil {
+			sub.ch <- m.firstErr
+		} else if (sub.seqNum == 0 && m.totalDurableCommits > 0) || (sub.seqNum > 0 && m.highestDurableSeqNum >= sub.seqNum) {
+			sub.ch <- nil
+		} else {
+			activeSubs = append(activeSubs, sub)
+		}
+	}
+	m.subscriptions = activeSubs
+	m.mu.Unlock()
+
+	info := BatchDurableInfo{
+		JobID:         entry.jobID,
+		SeqNum:        entry.seqNum,
+		Err:           err,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: entry.correlationID,
+		BatchSize:     entry.batchSize,
+		KeyCount:      entry.count,
+	}
+	m.d.opts.EventListener.BatchDurable(info)
+}
+
+func (m *durabilityManager) waitForDurability(ctx context.Context, seqNum base.SeqNum) error {
+	if m.d.opts.DisableWAL {
+		return nil
+	}
+
+	m.mu.Lock()
+	if m.firstErr != nil {
+		m.mu.Unlock()
+		return m.firstErr
+	}
+	if m.closed {
+		m.mu.Unlock()
+		return m.closedErr
+	}
+	if (seqNum == 0 && m.totalDurableCommits > 0) || (seqNum > 0 && m.highestDurableSeqNum >= seqNum) {
+		m.mu.Unlock()
+		return nil
+	}
+
+	if err := ctx.Err(); err != nil {
+		m.mu.Unlock()
+		return err
+	}
+
+	w := &durabilityWaiter{
+		seqNum: seqNum,
+		done:   make(chan struct{}),
+	}
+	m.waiters = append(m.waiters, w)
+	m.pendingWaiters.Add(1)
+	m.mu.Unlock()
+
+	defer m.pendingWaiters.Add(-1)
+
+	select {
+	case <-w.done:
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		if m.firstErr != nil {
+			return m.firstErr
+		}
+		if m.closed {
+			return m.closedErr
+		}
+		if (seqNum == 0 && m.totalDurableCommits > 0) || (seqNum > 0 && m.highestDurableSeqNum >= seqNum) {
+			return nil
+		}
+		return errors.New("pebble: waiter notified without durability or error")
+
+	case <-ctx.Done():
+		select {
+		case <-w.done:
+			m.mu.Lock()
+			defer m.mu.Unlock()
+			if m.firstErr != nil {
+				return m.firstErr
+			}
+			if m.closed {
+				return m.closedErr
+			}
+			if (seqNum == 0 && m.totalDurableCommits > 0) || (seqNum > 0 && m.highestDurableSeqNum >= seqNum) {
+				return nil
+			}
+		default:
+		}
+
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		for i, waiter := range m.waiters {
+			if waiter == w {
+				m.waiters = append(m.waiters[:i], m.waiters[i+1:]...)
+				break
+			}
+		}
+
+		if m.firstErr != nil {
+			return m.firstErr
+		}
+		if m.closed {
+			return m.closedErr
+		}
+		if (seqNum == 0 && m.totalDurableCommits > 0) || (seqNum > 0 && m.highestDurableSeqNum >= seqNum) {
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+func (m *durabilityManager) waitForDurabilityBatch(ctx context.Context, seqNums []base.SeqNum) error {
+	if m.d.opts.DisableWAL || len(seqNums) == 0 {
+		return nil
+	}
+	var maxSeq base.SeqNum
+	for _, s := range seqNums {
+		if s > maxSeq {
+			maxSeq = s
+		}
+	}
+	return m.waitForDurability(ctx, maxSeq)
+}
+
+func (m *durabilityManager) waitForJobDurability(ctx context.Context, jobID int) error {
+	if m.d.opts.DisableWAL {
+		return nil
+	}
+	if jobID <= 0 {
+		return errors.Wrapf(ErrJobDurabilityUnknown, "job ID %d unknown", jobID)
+	}
+
+	m.mu.Lock()
+	if jobID >= m.nextJobID {
+		m.mu.Unlock()
+		return errors.Wrapf(ErrJobDurabilityUnknown, "job ID %d unknown", jobID)
+	}
+
+	if m.firstErr != nil {
+		m.mu.Unlock()
+		return m.firstErr
+	}
+	if m.closed {
+		m.mu.Unlock()
+		return m.closedErr
+	}
+
+	job, ok := m.retainedJobs[jobID]
+	if !ok {
+		if jobID < m.oldestRetainedJobID {
+			m.mu.Unlock()
+			return errors.Wrapf(ErrJobDurabilityExpired, "job ID %d expired", jobID)
+		}
+		m.mu.Unlock()
+		return errors.Wrapf(ErrJobDurabilityUnknown, "job ID %d unknown", jobID)
+	}
+
+	if job.completed {
+		err := job.err
+		m.mu.Unlock()
+		return err
+	}
+
+	if err := ctx.Err(); err != nil {
+		m.mu.Unlock()
+		return err
+	}
+
+	doneChan := job.done
+	m.pendingWaiters.Add(1)
+	m.mu.Unlock()
+
+	defer m.pendingWaiters.Add(-1)
+
+	select {
+	case <-doneChan:
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		if m.firstErr != nil {
+			return m.firstErr
+		}
+		if m.closed {
+			return m.closedErr
+		}
+		if j, ok := m.retainedJobs[jobID]; ok && j.completed {
+			return j.err
+		}
+		if jobID < m.oldestRetainedJobID {
+			return errors.Wrapf(ErrJobDurabilityExpired, "job ID %d expired", jobID)
+		}
+		return errors.Wrapf(ErrJobDurabilityUnknown, "job ID %d unknown", jobID)
+
+	case <-ctx.Done():
+		select {
+		case <-doneChan:
+			m.mu.Lock()
+			defer m.mu.Unlock()
+			if m.firstErr != nil {
+				return m.firstErr
+			}
+			if m.closed {
+				return m.closedErr
+			}
+			if j, ok := m.retainedJobs[jobID]; ok && j.completed {
+				return j.err
+			}
+			if jobID < m.oldestRetainedJobID {
+				return errors.Wrapf(ErrJobDurabilityExpired, "job ID %d expired", jobID)
+			}
+		default:
+		}
+
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		if m.firstErr != nil {
+			return m.firstErr
+		}
+		if m.closed {
+			return m.closedErr
+		}
+		if j, ok := m.retainedJobs[jobID]; ok && j.completed {
+			return j.err
+		}
+		return ctx.Err()
+	}
+}
+
+func (m *durabilityManager) durabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+
+	if m.d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.firstErr != nil {
+		ch <- m.firstErr
+		return ch
+	}
+	if m.closed {
+		ch <- m.closedErr
+		return ch
+	}
+	if (seqNum == 0 && m.totalDurableCommits > 0) || (seqNum > 0 && m.highestDurableSeqNum >= seqNum) {
+		ch <- nil
+		return ch
+	}
+
+	if len(m.subscriptions) >= maxDurabilitySubscriptions {
+		ch <- ErrDurabilitySubscriptionLimit
+		return ch
+	}
+
+	sub := &durabilitySubscription{
+		seqNum: seqNum,
+		ch:     ch,
+	}
+	m.subscriptions = append(m.subscriptions, sub)
+	return ch
+}
+
+func (m *durabilityManager) durableState() (base.SeqNum, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.highestDurableSeqNum, m.firstErr
+}
+
+func (m *durabilityManager) durabilityStats() DurabilityStats {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   m.highestDurableSeqNum,
+		FirstErr:               m.firstErr,
+		PendingWaiters:         m.pendingWaiters.Load(),
+		TotalDurableCommits:    m.totalDurableCommits,
+		TotalFailedCommits:     m.totalFailedCommits,
+		CumulativeSyncDuration: m.cumulativeSyncDuration,
+		MaxSyncDuration:        m.maxSyncDuration,
+	}
+}
+
+func (m *durabilityManager) metricsCommitCount() uint64 {
+	if !m.batchDurableConfigured {
+		return 0
+	}
+	return m.durableCommitCount.Load()
+}
+
+func (m *durabilityManager) metricsCommitDuration() time.Duration {
+	if !m.batchDurableConfigured {
+		return 0
+	}
+	return time.Duration(m.durableCommitDuration.Load())
+}
+
+func (m *durabilityManager) close() {
+	m.mu.Lock()
+	if m.closed {
+		m.mu.Unlock()
+		return
+	}
+	m.closed = true
+	if m.closedErr == nil {
+		m.closedErr = errors.WithStack(ErrClosed)
+	}
+	if m.firstErr == nil {
+		m.firstErr = m.closedErr
+	}
+
+	for _, w := range m.waiters {
+		close(w.done)
+	}
+	m.waiters = nil
+
+	for _, sub := range m.subscriptions {
+		sub.ch <- m.closedErr
+	}
+	m.subscriptions = nil
+
+	for _, job := range m.retainedJobs {
+		if !job.completed {
+			job.completed = true
+			job.err = m.closedErr
+			close(job.done)
+		}
+	}
+	m.mu.Unlock()
+
+	close(m.queue)
+	m.workerWG.Wait()
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+// Sequence number zero succeeds after any commit.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext blocks until the given sequence number is durable or ctx is done.
+// Sequence number zero succeeds after any commit. Durability and close errors take precedence
+// over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.durabilityMgr == nil {
+		return nil
+	}
+	return d.durabilityMgr.waitForDurability(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in a slice is durable.
+// Nil or empty slice returns nil.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext blocks until every sequence number in a slice is durable
+// or ctx is done. Nil or empty slice returns nil. Durability and close errors take precedence
+// over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.durabilityMgr == nil {
+		return nil
+	}
+	return d.durabilityMgr.waitForDurabilityBatch(ctx, seqNums)
+}
+
+// WaitForJobDurability blocks until the callback job with the specified ID completes.
+// Jobs outside the retention window return an error containing "expired".
+// Never-seen and zero IDs return an error containing "unknown".
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext blocks until the callback job completes or ctx is done.
+// Jobs outside the retention window return an error containing "expired".
+// Never-seen and zero IDs return an error containing "unknown".
+// Durability and close errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.durabilityMgr == nil {
+		return nil
+	}
+	return d.durabilityMgr.waitForJobDurability(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first latched error.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	if d.durabilityMgr == nil {
+		return 0, nil
+	}
+	return d.durabilityMgr.durableState()
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil on success
+// or a non-nil error on WAL sync failure or DB close. Outstanding subscriptions are bounded;
+// excess callers receive a pre-filled channel with an immediate non-nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.durabilityMgr == nil {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durabilityMgr.durabilityNotify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of WAL durability metrics and state.
+// All fields start at zero before any commits. PendingWaiters reflects the number
+// of goroutines currently blocked in wait APIs.
+func (d *DB) DurabilityStats() DurabilityStats {
+	if d.durabilityMgr == nil {
+		return DurabilityStats{}
+	}
+	return d.durabilityMgr.durabilityStats()
+}
