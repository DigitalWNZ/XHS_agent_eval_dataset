+func TestWaitForDurability(t *testing.T) {
+	memFS := vfs.NewMem()
+	opts := &Options{FS: memFS}
+
+	d, err := Open("test", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Before any commits, WaitForDurability(0) must block.
+	zeroDone := make(chan error, 1)
+	go func() {
+		zeroDone <- d.WaitForDurability(0)
+	}()
+
+	// Wait briefly to verify it is blocked.
+	time.Sleep(20 * time.Millisecond)
+	select {
+	case <-zeroDone:
+		t.Fatal("WaitForDurability(0) should block before any commit")
+	default:
+	}
+	stats := d.DurabilityStats()
+	require.Equal(t, int64(1), stats.PendingWaiters)
+
+	// Commit a sync batch.
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), Sync))
+
+	// Zero waiter should unblock with nil.
+	select {
+	case err := <-zeroDone:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for WaitForDurability(0) to unblock")
+	}
+
+	// Now WaitForDurability(0) should succeed immediately.
+	require.NoError(t, d.WaitForDurability(0))
+
+	// Write batch 2 and record seqnum.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("b"), []byte("2"), nil))
+	require.NoError(t, b.Commit(Sync))
+	seq := b.SeqNum()
+
+	// Waiting on seq should succeed immediately.
+	require.NoError(t, d.WaitForDurability(seq))
+
+	// Waiting on a future seqnum should block.
+	futureSeq := seq + 10
+	futureDone := make(chan error, 1)
+	go func() {
+		futureDone <- d.WaitForDurability(futureSeq)
+	}()
+
+	time.Sleep(20 * time.Millisecond)
+	select {
+	case <-futureDone:
+		t.Fatal("future waiter should block")
+	default:
+	}
+
+	// Commit more batches up to futureSeq.
+	for {
+		b := d.NewBatch()
+		require.NoError(t, b.Set([]byte("c"), []byte("3"), nil))
+		require.NoError(t, b.Commit(Sync))
+		currSeq := b.SeqNum()
+		if currSeq >= futureSeq {
+			break
+		}
+	}
+
+	select {
+	case err := <-futureDone:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("future waiter timed out")
+	}
+}
