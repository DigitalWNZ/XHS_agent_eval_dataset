+func TestWaitForJobDurability(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableJobs []int
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				durableJobs = append(durableJobs, info.JobID)
+			},
+		},
+	}
+
+	d, err := Open("test", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Zero and negative IDs get an unknown error.
+	err0 := d.WaitForJobDurability(0)
+	require.Error(t, err0)
+	require.True(t, strings.Contains(err0.Error(), "unknown"))
+	require.True(t, errors.Is(err0, ErrJobDurabilityUnknown))
+
+	errNeg := d.WaitForJobDurability(-10)
+	require.Error(t, errNeg)
+	require.True(t, strings.Contains(errNeg.Error(), "unknown"))
+	require.True(t, errors.Is(errNeg, ErrJobDurabilityUnknown))
+
+	// Never-seen future ID gets unknown error.
+	errFuture := d.WaitForJobDurability(999999)
+	require.Error(t, errFuture)
+	require.True(t, strings.Contains(errFuture.Error(), "unknown"))
+	require.True(t, errors.Is(errFuture, ErrJobDurabilityUnknown))
+
+	// Commit a sync batch.
+	require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+
+	mu.Lock()
+	require.Len(t, durableJobs, 1)
+	jobID := durableJobs[0]
+	mu.Unlock()
+
+	// Waiting for already-completed job succeeds immediately.
+	require.NoError(t, d.WaitForJobDurability(jobID))
+
+	// Test bounded retention window expiration:
+	// Commit maxRetainedJobs + 100 batches to force eviction of jobID.
+	for i := 0; i < maxRetainedJobs+100; i++ {
+		require.NoError(t, d.Set([]byte("k"), []byte("v"), Sync))
+	}
+
+	errExpired := d.WaitForJobDurability(jobID)
+	require.Error(t, errExpired)
+	require.True(t, strings.Contains(errExpired.Error(), "expired"))
+	require.True(t, errors.Is(errExpired, ErrJobDurabilityExpired))
+}
