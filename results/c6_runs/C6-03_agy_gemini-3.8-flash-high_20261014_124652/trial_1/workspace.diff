+func TestDurabilityNotify(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("test", &Options{FS: memFS})
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Commit batch 1.
+	b1 := d.NewBatch()
+	require.NoError(t, b1.Set([]byte("k1"), []byte("v1"), nil))
+	require.NoError(t, b1.Commit(Sync))
+	seq1 := b1.SeqNum()
+
+	// Pre-filled channel for already-durable seqnum delivers nil.
+	ch1 := d.DurabilityNotify(seq1)
+	select {
+	case err := <-ch1:
+		require.NoError(t, err)
+	default:
+		t.Fatal("channel should be pre-filled with nil")
+	}
+
+	// Pre-filled channel for seqnum 0 after a commit delivers nil.
+	chZero := d.DurabilityNotify(0)
+	select {
+	case err := <-chZero:
+		require.NoError(t, err)
+	default:
+		t.Fatal("channel for 0 should be pre-filled with nil")
+	}
+
+	// Future seqnum subscription.
+	futureSeq := seq1 + 10
+	chFuture := d.DurabilityNotify(futureSeq)
+	select {
+	case <-chFuture:
+		t.Fatal("future channel should not be ready")
+	default:
+	}
+
+	// Commit up to futureSeq.
+	for {
+		b := d.NewBatch()
+		require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+		require.NoError(t, b.Commit(Sync))
+		s := b.SeqNum()
+		if s >= futureSeq {
+			break
+		}
+	}
+
+	select {
+	case err := <-chFuture:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for durability notification")
+	}
+
+	// Test subscription bound:
+	for i := 0; i < maxDurabilitySubscriptions; i++ {
+		d.DurabilityNotify(base.SeqNum(999999))
+	}
+	// Excess caller gets pre-filled channel with immediate non-nil error.
+	chExcess := d.DurabilityNotify(base.SeqNum(999999))
+	select {
+	case err := <-chExcess:
+		require.Error(t, err)
+		require.True(t, errors.Is(err, ErrDurabilitySubscriptionLimit))
+	default:
+		t.Fatal("excess channel should be pre-filled with error")
+	}
+}
