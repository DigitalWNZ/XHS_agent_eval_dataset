+	require.Equal(t, time.Duration(0), m1.DurableCommitDuration)
+	require.NoError(t, d1.Close())
+
+	// 2. With BatchDurable configured.
+	var durableCount atomic.Int32
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableCount.Add(1)
+			},
+		},
+	}
+	d2, err := Open("test2", opts)
+	require.NoError(t, err)
+
+	for i := 0; i < 5; i++ {
+		require.NoError(t, d2.Set([]byte("k"), []byte("v"), Sync))
+	}
+	require.Equal(t, int32(5), durableCount.Load())
+
+	m2 := d2.Metrics()
+	require.Equal(t, uint64(5), m2.DurableCommitCount)
+	require.Greater(t, m2.DurableCommitDuration, time.Duration(0))
+	require.NoError(t, d2.Close())
+}
