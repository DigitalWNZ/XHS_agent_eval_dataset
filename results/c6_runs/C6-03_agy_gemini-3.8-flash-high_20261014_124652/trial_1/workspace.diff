+func TestApplyNoSyncWaitWithBatchDurable(t *testing.T) {
+	memFS := vfs.NewMem()
+	var durableInfo atomic.Pointer[BatchDurableInfo]
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				durableInfo.Store(&info)
+			},
+		},
+	}
+
+	d, err := Open("test", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+	wo := &WriteOptions{
+		Sync:                true,
+		CommitCorrelationID: 999,
+	}
+
+	require.NoError(t, d.ApplyNoSyncWait(b, wo))
+
+	// Wait for WAL sync via b.SyncWait().
+	require.NoError(t, b.SyncWait())
+
+	// Callback should have fired.
+	info := durableInfo.Load()
+	require.NotNil(t, info)
+	require.Equal(t, uint64(999), info.CorrelationID)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+	require.NoError(t, info.Err)
+}
