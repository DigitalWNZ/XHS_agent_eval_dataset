+func TestCloseUnblocksWaiters(t *testing.T) {
+	memFS := vfs.NewMem()
+	d, err := Open("test", &Options{FS: memFS})
+	require.NoError(t, err)
+
+	futureSeq := base.SeqNum(1000)
+
+	var wg sync.WaitGroup
+	errs := make([]error, 6)
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		errs[0] = d.WaitForDurability(futureSeq)
+	}()
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		errs[1] = d.WaitForDurabilityContext(context.Background(), futureSeq)
+	}()
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		errs[2] = d.WaitForDurabilityBatch([]base.SeqNum{futureSeq})
+	}()
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		errs[3] = d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{futureSeq})
+	}()
+
+	// Allocate a job ID and wait on it.
+	jobID := d.durabilityMgr.newJobID()
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		errs[4] = d.WaitForJobDurability(jobID)
+	}()
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		errs[5] = d.WaitForJobDurabilityContext(context.Background(), jobID)
+	}()
+
+	chNotify := d.DurabilityNotify(futureSeq)
+
+	// Wait for goroutines to block.
+	for {
+		stats := d.DurabilityStats()
+		if stats.PendingWaiters == 6 {
+			break
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	// Close the DB.
+	require.NoError(t, d.Close())
+
+	// Wait for all waiters to unblock.
+	wg.Wait()
+
+	for i := 0; i < 6; i++ {
+		require.Error(t, errs[i], "waiter %d should unblock with error", i)
+	}
+
+	select {
+	case err := <-chNotify:
+		require.Error(t, err, "DurabilityNotify should deliver error on DB close")
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for DurabilityNotify channel on close")
+	}
+}
