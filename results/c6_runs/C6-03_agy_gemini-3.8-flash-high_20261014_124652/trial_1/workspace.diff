+type syncErrorFS struct {
+	vfs.FS
+	failSync atomic.Bool
+}
+
+func (fs *syncErrorFS) Create(name string, category vfs.DiskWriteCategory) (vfs.File, error) {
+	f, err := fs.FS.Create(name, category)
+	if err != nil {
+		return nil, err
+	}
+	return &syncErrorFile{File: f, fs: fs}, nil
+}
+
+type syncErrorFile struct {
+	vfs.File
+	fs *syncErrorFS
+}
+
+func (f *syncErrorFile) Sync() error {
+	if f.fs.failSync.Load() {
+		return errors.New("injected sync error")
+	}
+	return f.File.Sync()
+}
+
+func (f *syncErrorFile) SyncData() error {
+	if f.fs.failSync.Load() {
+		return errors.New("injected sync error")
+	}
+	return f.File.SyncData()
+}
+
+func (f *syncErrorFile) SyncTo(length int64) (fullSync bool, err error) {
+	if f.fs.failSync.Load() {
+		return false, errors.New("injected sync error")
+	}
+	return f.File.SyncTo(length)
+}
+
+func TestWALSyncFailure(t *testing.T) {
+	memFS := &syncErrorFS{FS: vfs.NewMem()}
+	var durableEvents []BatchDurableInfo
+	var mu sync.Mutex
+
+	opts := &Options{
+		FS: memFS,
+		EventListener: &EventListener{
+			BatchDurable: func(info BatchDurableInfo) {
+				mu.Lock()
+				defer mu.Unlock()
+				durableEvents = append(durableEvents, info)
+			},
+		},
+	}
+
+	d, err := Open("test", opts)
+	require.NoError(t, err)
+	defer d.Close()
+
+	// Commit 1 succeeds.
+	require.NoError(t, d.Set([]byte("k1"), []byte("v1"), Sync))
+	mu.Lock()
+	require.Len(t, durableEvents, 1)
+	require.NoError(t, durableEvents[0].Err)
+	mu.Unlock()
+
+	// Enable failure for WAL sync.
+	memFS.failSync.Store(true)
+
+	// Commit 2 fails during WAL sync using ApplyNoSyncWait.
+	b2 := d.NewBatch()
+	require.NoError(t, b2.Set([]byte("k2"), []byte("v2"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b2, Sync))
+
+	syncWaitErr := b2.SyncWait()
+	require.Error(t, syncWaitErr)
+
+	mu.Lock()
+	require.Len(t, durableEvents, 2)
+	failedEvent := durableEvents[1]
+	mu.Unlock()
+
+	require.Error(t, failedEvent.Err)
+	require.Contains(t, failedEvent.Err.Error(), "injected sync error")
+
+	// Verify stats latch the error and count failure.
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Error(t, stats.FirstErr)
+	require.Contains(t, stats.FirstErr.Error(), "injected sync error")
+
+	// Verify DurableState latches the error.
+	_, stateErr := d.DurableState()
+	require.Error(t, stateErr)
+	require.Contains(t, stateErr.Error(), "injected sync error")
+
+	// Verify wait APIs return the latched error.
+	require.Error(t, d.WaitForDurability(1000))
+	require.Error(t, d.WaitForDurabilityBatch([]base.SeqNum{1000}))
+	require.Error(t, d.WaitForJobDurability(failedEvent.JobID))
+	require.Error(t, d.WaitForJobDurabilityContext(context.Background(), failedEvent.JobID))
+
+	// Verify DurabilityNotify returns the latched error.
+	ch := d.DurabilityNotify(1000)
+	select {
+	case err := <-ch:
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "injected sync error")
+	default:
+		t.Fatal("DurabilityNotify should deliver latched error")
+	}
+}
